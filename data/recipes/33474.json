  "ingredients": [
    "4 cloves garlic",
    "1 (14 ounce) can artichoke hearts, drained and chopped",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "1 (10 ounce) container Alfredo-style pasta sauce",
    "1 cup shredded mozzarella cheese",
    "0.5 (8 ounce) package cream cheese, softened",
    "0.33333334326744 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place garlic in a small baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YP1vYMvjHC0XNfTZK3hvy3xD6Cg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/33474-artichoke-spinach-dip-restaurant-style-VAT-step-02-69531687816d45d786bf4c2df999ccc3.jpg"
      ],
      "image": "assets/images/33474/step_01.webp"
    },
    {
      "text": "Bake in the preheated oven until soft, 20 to 30 minutes. Allow to cool enough to handle, then squeeze out softened garlic cloves from skins into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dyaFxE6Jl4p539BnIhn590AfYaY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/33474-artichoke-spinach-dip-restaurant-style-VAT-step-03-7dee83d61df94a0bb419753b55760626.jpg"
      ],
      "image": "assets/images/33474/step_02.webp"
    },
    {
      "text": "Add artichoke hearts, spinach, Alfredo-style pasta sauce, mozzarella cheese, cream cheese, and Parmesan cheese to garlic cloves in the bowl; mix until well combined. Spread into an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Fc983-4x9uvyV-MG1iNNmLu7-08=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/33474-artichoke-spinach-dip-restaurant-style-VAT-step-04-6019bc0a223846eeaf9515d992f34ca8.jpg"
      ],
      "image": "assets/images/33474/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until cheeses are melted and bubbly, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NaoIRrQUPw_6kS-Ujh76mwEde5E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/33474-artichoke-spinach-dip-restaurant-style-VAT-step-05-c9ceeb4bf79c42238e67983d8fff670e.jpg"
      ],
      "image": "assets/images/33474/step_04.webp"
    },
    {
      "text": "Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sK_ANaGz15bWWmfUA1t7dqFjEWw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/33474-artichoke-spinach-dip-restaurant-style-VAT-Beauty-4x3-bc420a7e31a54f91998bfe47e0c85834.jpg"
