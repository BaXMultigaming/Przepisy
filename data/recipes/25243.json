    },
    {
      "text": "Place tomato slices close together in the prepared baking dish. Sprinkle with cheese, bread crumbs, garlic, parsley, salt, pepper, and oregano. Drizzle with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
