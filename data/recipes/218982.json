  "ingredients": [
    "2 cups egg noodles",
    "cooking spray",
    "3 tablespoons butter",
    "0.25 cup chopped onion",
    "0.25 cup chopped celery",
    "0.25 cup chopped carrots",
    "0.25 cup chopped red bell pepper",
    "3 cups cubed cooked pork",
    "2 (10.5 ounce) cans condensed cream of chicken soup",
    "2 cups shredded Cheddar cheese",
    "1 (8 ounce) can whole kernel corn, drained",
    "0.5 cup sour cream, or more to taste",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup dry bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Stir in onion, celery, carrots, and red bell pepper; cook and stir until onion has softened and turned translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in egg noodles, cooked pork, condensed soup, cheese, corn, sour cream, salt, and pepper. Transfer mixture to the prepared baking dish. Sprinkle bread crumbs on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
