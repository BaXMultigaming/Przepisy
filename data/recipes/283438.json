  "ingredients": [
    "5 medium avocados - halved, peeled, and pitted",
    "4 medium Roma tomatoes",
    "2 large cucumbers, ends trimmed",
    "0.25 cup rice wine vinegar",
    "0.25 cup Italian salad dressing",
    "0.75 teaspoon freshly ground black pepper, or to taste",
    "0.5 teaspoon sea salt, or to taste",
    "0.25 teaspoon dried oregano leaves"
