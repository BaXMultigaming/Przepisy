  "ingredients": [
    "2 pounds red potatoes",
    "0.75 cup mayonnaise",
    "0.5 cup sour cream",
    "0.5 cup plain yogurt",
    "0.33333334326744 cup thinly sliced green onion",
    "2 dill pickle spears, chopped, or more to taste",
    "4.5 teaspoons Dijon mustard",
    "4.5 teaspoons prepared horseradish",
    "0.5 teaspoon celery seed",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 cloves garlic, minced",
    "1 dash onion salt",
    "1 dash garlic powder",
    "4 hard-cooked eggs, chopped"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 20 to 30 minutes. Drain and cool slightly. Slice potatoes into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise, sour cream, yogurt, onions, pickles, mustard, horseradish, celery seed, salt, pepper, garlic, onion salt, and garlic powder in a small bowl; mix until combined. Pour dressing over sliced potatoes and toss to coat. Gently stir in eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate for 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
