  "ingredients": [
    "3 pounds Roma (plum) tomatoes, quartered",
    "1 yellow onion, halved and quartered",
    "0.5 cup coarsely chopped red bell pepper",
    "3 tablespoons olive oil",
    "1.5 teaspoons salt",
    "1.5 teaspoons ground black pepper",
    "3 cloves garlic, halved",
    "5 cups low-sodium chicken broth",
    "2 tablespoons chopped fresh basil",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line two 10x15-inch baking pans with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange tomatoes, onion, and bell pepper in a single layer on the prepared baking pans. Drizzle with oil and sprinkle with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 30 minutes. Add garlic; continue roasting until mixture is tender, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring broth to a boil in a large pot over high heat. Reduce heat and simmer, covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, put 1/2 of the tomato mixture in a blender. Cover and pulse 3 times, then blend until smooth, adding hot broth as needed. Pour into the pot with broth. Repeat with remaining 1/2 of the tomato mixture, then stir into the pot until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Simmer soup until heated through, about 5 minutes. Stir in basil and parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
