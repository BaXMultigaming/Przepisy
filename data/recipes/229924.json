  "ingredients": [
    "3 large Granny Smith apples, peeled and sliced",
    "1.5 cups white sugar, divided",
    "2 tablespoons ground cinnamon",
    "2 tablespoons lemon juice",
    "1 teaspoon ground nutmeg",
    "0.25 cup butter, softened",
    "1 egg",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.5 cup milk",
    "2 cups fresh blueberries",
    "0.66666668653488 cup white sugar",
    "0.5 cup all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.33333334326744 cup cold butter"
  ],
  "steps": [
    {
      "text": "Prepare fruit filling: Place apples in a large bowl and toss with 3/4 cup sugar, cinnamon, lemon juice, and nutmeg. Cover and place in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat remaining 3/4 cup sugar and butter in a large bowl until creamy; beat in egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, and salt together in a small bowl. Stir flour mixture into butter mixture, alternating with milk, until fully incorporated. Fold in blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange apples in a single layer in the bottom of the prepared baking dish. Pour blueberry batter over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare topping: Mix sugar, flour, and cinnamon together in a bowl; cut in cold butter until mixture is crumbly. Sprinkle over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of buckle comes out clean, 40 to 45 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
