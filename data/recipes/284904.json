  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "0.33333334326744 cup unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt",
    "1.25 cups brown sugar",
    "0.5 cup unsalted butter, softened",
    "2 large eggs",
    "1 cup buttermilk",
    "1 teaspoon vanilla extract",
    "0.5 cup hot water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cocoa powder, baking soda, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream brown sugar and butter together in a separate large bowl with an electric mixer until light and fluffy. Add eggs, 1 at a time, until well incorporated. Gradually add buttermilk, followed by vanilla extract, and mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour mixture to butter mixture in thirds, alternating with hot water, beginning and ending with the dry ingredients, beating just until combined. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 30 to 35 minutes. Remove baking dish from the oven and transfer to a wire rack to completely cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
