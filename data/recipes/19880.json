  "ingredients": [
    "8 skinless, boneless chicken breast halves",
    "1 cup brown sugar",
    "4 fresh peaches - peeled, pitted, and sliced",
    "2 tablespoons fresh lemon juice",
    "0.125 teaspoon ground ginger",
    "0.125 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in the prepared baking dish; sprinkle with ½ cup brown sugar. Arrange peach slices over chicken; sprinkle with remaining ½ cup brown sugar, lemon juice, ginger, and cloves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, frequently basting with juices, until chicken is cooked through and juices run clear, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
