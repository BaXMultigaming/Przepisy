  "ingredients": [
    "1 large russet potato",
    "1 teaspoon olive oil",
    "3 tablespoons milk",
    "2 tablespoons shredded Cheddar cheese",
    "1 tablespoon salted butter, melted",
    "0.5 teaspoon chopped fresh chives",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat a smoker to 250 degrees F (120 degrees C). Add wood chips according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a fork, pierce holes on all sides of the potato. Brush oil over entire potato.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the potato directly on the smoker rack and cook for 3 hours. Transfer potato to a cutting board and let cool until easily handled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice potato in half. Leaving the shell intact, spoon out flesh and place in a bowl. Add milk, Cheddar cheese, butter, chives, salt, and pepper. Using the back of a spoon, mash potato and stir until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon mixture back into the shells. Return to the smoker for 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
