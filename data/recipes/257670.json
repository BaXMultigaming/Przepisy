  "ingredients": [
    "0.75 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "1 large banana, mashed",
    "0.25 cup white sugar",
    "0.25 cup packed brown sugar",
    "1 egg white",
    "2 tablespoons milk",
    "1 tablespoon canola oil",
    "0.5 teaspoon vanilla extract",
    "0.33333334326744 cup black sesame seeds",
    "0.33333334326744 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, baking powder, cinnamon, nutmeg, and salt together in a bowl. Mix banana, white sugar, brown sugar, egg white, milk, canola oil, and vanilla extract together in a separate bowl; stir into flour mixture just until batter is moistened. Fold sesame seeds and walnuts into batter; pour into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 35 to 40 minutes. Cool in pan before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
