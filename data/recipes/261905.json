  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, melted",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.5 cup all-purpose flour",
    "0.33333334326744 cup unsweetened cocoa powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon baking powder",
    "1 pinch ground cinnamon",
    "1 pinch ground allspice",
    "3 pinches confectioners' sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, butter, eggs, and vanilla extract in a bowl. Beat in flour, cocoa powder, salt, baking powder, cinnamon, and allspice. Spread batter into the prepared pan; it will just barely reach the corners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is dry and edges have started to pull away from the sides of the pan, 20 to 25 minutes. Sprinkle confectioners' sugar on top and cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
