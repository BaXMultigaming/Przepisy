  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup packed brown sugar",
    "1 cup shortening",
    "3 eggs",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "2 cups quick cooking oats",
    "1 cup dates, pitted and chopped",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C) and grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, sift together flour, baking powder, baking soda, and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together shortening and both sugars until light and fluffy, using an electric mixer at medium speed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add eggs, one at a time, beating well after each. Blend in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually add dry ingredients to creamed mixture, mixing well with a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in oats, dates, and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by teaspoonfuls about 2 inches apart on a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 minutes or until lightly browned. Remove from cookie sheets to cool on racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
