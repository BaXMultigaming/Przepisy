  "ingredients": [
    "2 ounces dried thin rice noodles",
    "0.75 cup ground chicken",
    "0.25 cup shrimp - washed, peeled, and cut into small pieces",
    "2 large eggs, beaten",
    "1 carrot, grated",
    "4 wood fungus mushrooms, chopped",
    "2 green onions, chopped",
    "0.5 teaspoon white sugar",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "24 rice paper wrappers",
    "2 cups vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-sQJdwudFWfvWPLpNdu04BB2Sro=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245343_AuthenticVietnameseSpringRolls_ddmf_Step_01_4x3_JD_5503-ecc140d2e544475cad502b522876c7b8.jpg"
      ],
      "image": "assets/images/245343/step_01.webp"
    },
    {
      "text": "Soak rice noodles in cold water until soft, about 20 minutes. Drain well; cut into 2-inch long pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine noodle pieces, chicken, shrimp, eggs, carrot, wood fungus mushrooms, and green onions in a large bowl. Add sugar, salt, and black pepper; stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MYJ96TTrVC8Qe-tzErPPLPKIoVI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245343_AuthenticVietnameseSpringRolls_ddmf_Step_02_4x3_JD_5506-8beb9bc7818342a2835f4183db5ded39.jpg"
      ],
      "image": "assets/images/245343/step_03.webp"
    },
    {
      "text": "Soak 1 rice paper wrapper in a shallow bowl of warm water to soften, about 15 seconds. Place on a damp cloth laid out on a flat surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 tablespoon filling mixture into the center of softened rice paper. Fold the bottom edge into the center, covering filling. Fold in opposing edges and roll up tightly. Repeat with remaining rice paper wrappers, soaking and filling each one individually.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JepH6L16BlXcZLyC3PWysIbtQWk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245343_AuthenticVietnameseSpringRolls_ddmf_Step_03_4x3_JD_5508-faa18f80416b4144b06c59e0c6e18633.jpg"
      ],
      "image": "assets/images/245343/step_05.webp"
    },
    {
      "text": "Heat oil in a wok or large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches of 3 or 4, fry spring rolls in hot oil until crisp and golden brown on both sides, about 5 minutes. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z_TltlZx6hZ4XgDVl9Hq8VwfDSw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245343_AuthenticVietnameseSpringRolls_ddmf_Step_04_4x3_JD_5509-54def05f2e1d460293eee5267d707cd4.jpg"
      ],
      "image": "assets/images/245343/step_07.webp"
    }
