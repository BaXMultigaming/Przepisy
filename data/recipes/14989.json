  "ingredients": [
    "0.5 cup barley",
    "0.5 cup dried split peas",
    "0.5 cup uncooked white rice",
    "0.5 cup dry lentils",
    "2 tablespoons dried minced onion",
    "2 tablespoons dried parsley",
    "2 teaspoons salt",
    "0.5 teaspoon lemon pepper",
    "2 tablespoons beef bouillon granules",
    "0.5 cup uncooked alphabet pasta",
    "1 cup uncooked twist macaroni"
  ],
  "steps": [
    {
      "text": "Layer barley, peas, rice, and lentils in a wide-mouth 1-quart jar. Layer onion, parsley, salt, lemon pepper, bouillon, and alphabet pasta around the edges. Fill the rest of the jar with twist macaroni.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Seal and attach a gift card. The gift card should read: Add contents of jar to 3 quarts of water, 2 stalks of chopped celery, 2 sliced carrots, 1 cup of shredded cabbage (optional) and 2 cups diced tomatoes. Over medium low heat, cover and simmer about 1 hour, or until vegetables are tender.",
      "section": null,
