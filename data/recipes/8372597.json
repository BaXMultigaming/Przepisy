  "ingredients": [
    "1 head lettuce, torn",
    "1 large tomato, sliced",
    "1 large onion, sliced",
    "0.5 cup dill pickle slices",
    "2 tablespoons butter, melted",
    "0.5 round loaf sourdough bread, cubed",
    "0.25 cup olive oil",
    "0.25 cup pickle juice",
    "1 teaspoon mustard",
    "1 teaspoon ketchup",
    "1 teaspoon grill seasoning",
    "1 pound ground beef",
    "1 teaspoon grill seasoning",
    "2 cups shredded American cheese"
  ],
  "steps": [
    {
      "text": "Combine lettuce, tomato, onion, and pickle slices in a large bowl for salad. Set aside",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a large skillet and toss bread cubes in until lightly browned, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil, pickle juice, mustard, ketchup, and grill seasoning in a lidded jar for dressing. Close and shake until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Season ground beef with grill seasoning and add to the hot skillet. Cook and stir until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Add cheese and stir into the beef until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss salad with the dressing just before serving. Put salad on plates and top with ground beef mixture and croutons.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
