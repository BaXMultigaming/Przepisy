  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "1 (12 fluid ounce) can evaporated milk",
    "1.5 cups white sugar",
    "3 eggs",
    "1.5 teaspoons ground cinnamon",
    "1 (18.25 ounce) package yellow cake mix",
    "1 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pumpkin purée, evaporated milk, sugar, eggs, and cinnamon together in a large bowl until smooth. Pour into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle cake mix over pumpkin mixture in the baking pan. Pour melted butter on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 1 hour and 10 minutes.",
