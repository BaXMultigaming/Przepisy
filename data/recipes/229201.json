  "ingredients": [
    "3 eggs",
    "0.5 cup mayonnaise",
    "0.5 cup whole milk",
    "2 tablespoons all-purpose flour",
    "1 teaspoon seafood seasoning (such as Old Bay®)",
    "1 cup shredded Cheddar cheese",
    "0.5 cup chopped fresh parsley",
    "1 cup crabmeat",
    "1 (9 inch) unbaked pie crust",
    "1 pinch seafood seasoning (such as Old Bay®), or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, mayonnaise, milk, flour, and 1 teaspoon Old Bay seasoning together in a bowl until smooth and creamy; stir in Cheddar cheese and parsley. Gently fold in crabmeat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour crabmeat filling into pie crust; sprinkle 1 pinch Old Bay seasoning over quiche.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into center comes out clean and top is lightly browned, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
