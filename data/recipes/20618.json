  "ingredients": [
    "0.33333334326744 cup vegetable oil",
    "1 pound round steak",
    "2 eggs",
    "0.5 cup milk",
    "salt and pepper to taste",
    "1.5 cups all-purpose flour for coating"
  ],
  "steps": [
    {
      "text": "Tenderize steak by pounding with a mallet. Cut into 3 inch long strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine egg, milk, salt and pepper in a shallow dish, whisk until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet over medium heat, heat 1/3 cup oil (or just enough to cover the bottom of the pan).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat steak pieces in flour. Shake off excess. Then dip in the egg mixture and again in flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry the strips in the hot oil until golden brown; about 2 minutes. Transfer to a plate lined with paper towels to absorb oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
