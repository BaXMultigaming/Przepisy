  "ingredients": [
    "0.25 cup soy sauce",
    "0.25 cup lime juice",
    "1 tablespoon garlic paste",
    "1 tablespoon ginger paste",
    "4 (1-inch-thick) pork chops",
    "1 tablespoon garam masala"
  ],
  "steps": [
    {
      "text": "In a bowl, stir together soy sauce, lime juice, garlic, and ginger.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork chops in a glass dish. Pour soy sauce mixture over chops. Cover, and refrigerate 2 to 3 hours, turning occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for direct heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chops on the grill. As they cook, sprinkle with garam masala. Cook about 10 minutes on each side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
