    {
      "text": "Pour salt onto a small plate. Moisten the rim of a glass and press into the salt. Fill the glass with ice cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a_kIqQwJwaDcXjA8g2AB085q8EE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/65037-ClassicBloodyMary-mfs-step2-0112-4x3-6a4a52e8fd47477ea9be5ce1033414ac.jpg"
      ],
      "image": "assets/images/65037/step_02.webp"
    },
    {
      "text": "Fill a cocktail shaker with ice cubes; add vegetable juice cocktail, vodka, Worcestershire sauce, hot pepper sauce, salt, and pepper. Cover and shake until the outside of shaker has frosted, about 20 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
