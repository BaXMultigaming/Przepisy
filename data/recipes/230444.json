  "ingredients": [
    "16 slices bread, crusts removed - divided",
    "16 slices Canadian bacon",
    "16 slices sharp Cheddar cheese",
    "6 large eggs",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 teaspoon dry mustard",
    "0.25 cup minced onion",
    "2 tablespoons diced green bell pepper",
    "2 tablespoons diced red bell pepper",
    "2 teaspoons Worcestershire sauce",
    "1 dash hot sauce",
    "3 cups whole milk",
    "0.5 cup butter, melted",
    "1 cup crushed corn flakes cereal"
  ],
  "steps": [
    {
      "text": "Butter a 9x13-inch baking dish. Cut and fit 8 slices of bread to fit over entire bottom of dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VCWInYFKbfpyacuSsTZXUESyoEM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230444-overnight-christmas-breakfast-casserole-VAT-step-01-5d2b8353b3a0476282b89ca2d9f8488d.jpg"
      ],
      "image": "assets/images/230444/step_01.webp"
    },
    {
      "text": "Cover bread with slices of Canadian bacon and sharp Cheddar cheese. Cut and fit remaining 8 slices of bread to completely cover bacon and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9Oh3pKzwLlksbCajpsjb7iyx5dw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230444-overnight-christmas-breakfast-casserole-VAT-step-02-e8568355b6aa4b3fb9a5328cf7c87b48.jpg"
      ],
      "image": "assets/images/230444/step_02.webp"
    },
    {
      "text": "Whisk eggs with salt and black pepper in a bowl. Whisk dry mustard, onion, diced green and red bell pepper, Worcestershire sauce, and hot sauce into eggs. Whisk in milk until egg mixture is smoothly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/voc0tAj80MMGZyhTQJmDDPE-fng=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230444-overnight-christmas-breakfast-casserole-VAT-step-03-645440e8edbe4ec68b310a1cbc489ff3.jpg"
      ],
      "image": "assets/images/230444/step_03.webp"
    },
    {
      "text": "Pour egg mixture evenly over the casserole. Cover the dish and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7RO3Ab-upUGC0lg4kIhPlVV8PyQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230444-overnight-christmas-breakfast-casserole-VAT-step-04-b176449bd74f4fc1b198f48a95da6517.jpg"
      ],
      "image": "assets/images/230444/step_04.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Remove casserole from refrigerator while the oven preheats. Pour melted butter evenly over the casserole and sprinkle cornflake crumbs over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QsrKD16aQevqAFZkv1VAkVsbHbA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230444-overnight-christmas-breakfast-casserole-VAT-step-05-55ad69b453404f9291d226c1ddb82b61.jpg"
      ],
      "image": "assets/images/230444/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until set and lightly browned, about 1 hour. Let casserole stand for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Oz9T5M4e06Iza8BD-6NMvN6P68o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230444-overnight-christmas-breakfast-casserole-VAT-step-06-2c51c61487cd4fc293420132befb1d65.jpg"
      ],
      "image": "assets/images/230444/step_06.webp"
    }
