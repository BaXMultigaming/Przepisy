  "ingredients": [
    "1 quart vegetable oil for frying",
    "1 cup all-purpose flour",
    "1 cup beer",
    "1 pinch salt",
    "1 pinch ground black pepper",
    "4 onions, peeled and sliced into rings"
  ],
  "steps": [
    {
      "text": "In a large, deep skillet, heat oil to 365 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine flour, beer, salt, and pepper. Mix until smooth. Dredge onion slices in the batter, until evenly coated. Deep fry in the hot oil until golden brown. Drain on paper towels.",
      "section": null,
