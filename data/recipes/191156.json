        "https://www.allrecipes.com/thmb/hqXjztQkOhQRg_w_Cwc46bvbhM4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-191156-restaurant-style-beef-and-broccoli-ddmfs-4x3-hero-d536afcff3174743b884b906c9a89287.jpg"
