  "ingredients": [
    "2 cups water",
    "1 cup brown sugar",
    "3 tablespoons red wine vinegar",
    "2 tablespoons orange zest, or to taste",
    "1 tablespoon soy sauce",
    "0.25 teaspoon ground ginger",
    "0.125 teaspoon sriracha hot sauce",
    "0.125 teaspoon white pepper",
    "1 pinch cayenne pepper",
    "3 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Combine water, brown sugar, vinegar, orange zest, soy sauce, ginger, Sriracha, white pepper, and cayenne pepper in a saucepan over medium heat; cook and stir until sugar is dissolved, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk ½ cup orange sauce and cornstarch together in a small bowl until well blended and orange zest starts to dissolve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase heat; bring sauce to a slow boil, about 5 minutes. Stir cornstarch mixture into sauce, stirring occasionally, until thickened, 3 to 5 minutes. Cool before serving, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
