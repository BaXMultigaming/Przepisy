  "ingredients": [
    "2 (1 pound) loaves frozen bread dough, thawed",
    "1.5 cups shredded sharp Cheddar cheese",
    "1 onion, finely diced",
    "0.25 cup olive oil",
    "1 tablespoon Italian seasoning"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x9-inch square baking pan. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut thawed loaves into 1-inch cubes; toss with cheese, onion, oil, and Italian spices in the prepared pan. Cover the pan lightly with plastic wrap. Let rise in a warm place until doubled in volume, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
