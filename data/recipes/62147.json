  "ingredients": [
    "1 (16 ounce) package dry macaroni",
    "1.5 cups chunky salsa",
    "1 cup mayonnaise",
    "1 (6 ounce) can sliced black olives, drained",
    "0.5 cup finely chopped green bell pepper",
    "1 teaspoon garlic powder",
    "1 teaspoon salt",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes. Rinse under cold running water; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine salsa, mayonnaise, olives, bell pepper, garlic powder, salt, and black pepper in a large bowl; mix well. Stir in pasta until thoroughly coated. Cover and refrigerate before serving, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
