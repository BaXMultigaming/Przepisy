  "ingredients": [
    "1 teaspoon butter, or as needed",
    "0.75 cup freshly grated Parmesan cheese",
    "0.33333334326744 cup butter, softened",
    "0.25 cup mayonnaise",
    "0.25 cup chopped green onion",
    "3 tablespoons lemon juice",
    "2 teaspoons dried dill weed",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "2 dashes hot pepper sauce (such as Tabasco®)",
    "2 pounds cod fillets"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil; lightly coat with 1 teaspoon butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dJPEIzmkoCYV8BhJf8Oxd41gwB0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235059-creamy-parmesan-sauce-for-fish-DDMF-step-1-e2671ef270734f3a92d0263f1247176d.jpg"
      ],
      "image": "assets/images/235059/step_01.webp"
    },
    {
      "text": "Mix together Parmesan, 1/3 cup butter, mayonnaise, green onion, lemon juice, dill, salt, black pepper, and hot sauce in a medium bowl until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/meEmv9A7GFy75_MoBvPy3eBAiPs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235059-creamy-parmesan-sauce-for-fish-DDMF-step-3-4df925ff4023448896ec17267827dbf1.jpg"
      ],
      "image": "assets/images/235059/step_02.webp"
    },
    {
      "text": "Lay cod fillets in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O-5HLXVo4gPzNPoV8jRclBk6aPE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235059-creamy-parmesan-sauce-for-fish-DDMF-step-2-0532bd36b64b43909cb6fea8c6ba19b7.jpg"
      ],
      "image": "assets/images/235059/step_03.webp"
    },
    {
      "text": "Cook under the preheated broiler until fish flakes easily with a fork, 7 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lVADi810wt00eErKyny0hmDeKkA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235059-creamy-parmesan-sauce-for-fish-DDMF-step-4-b904e26745064bad8e4b0603867630f5.jpg"
      ],
      "image": "assets/images/235059/step_04.webp"
    },
    {
      "text": "Gently spread Parmesan mixture over fish; return to the oven and broil until topping is bubbly and lightly browned, about 2 more minutes.",
      "section": null,
      "name": null,
      "url": null,
