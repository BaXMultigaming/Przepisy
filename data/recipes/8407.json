  "ingredients": [
    "2 egg whites",
    "1.5 cups dark brown sugar",
    "0.33329999446869 cup water",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Stir the unbeaten egg whites, sugar and water together in the top of a double boiler. Cook over briskly boiling water, beating with a rotary beater for 7 minutes or until frosting looks fluffy and holds a soft, gentle shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from boiling water, add vanilla extract and continue beating until frosting holds definite peaks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread between layers of cake and then frost the sides and top.",
      "section": null,
