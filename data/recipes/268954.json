  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup oat flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "1 teaspoon cinnamon",
    "1 teaspoon ground ginger",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves",
    "1 stick butter, softened",
    "0.5 cup brown sugar",
    "0.25 cup white sugar",
    "0.5 cup vanilla Greek yogurt",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 cup pumpkin puree",
    "0.75 cup mashed ripe bananas",
    "0.5 cup semisweet chocolate chips",
    "0.5 cup chopped toasted pecans",
    "1 cup vanilla-coconut granola",
    "0.75 cup semisweet chocolate chips",
    "0.5 cup chopped toasted pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk all-purpose flour, oat flour, baking soda, baking powder, salt, cinnamon, ginger, nutmeg, and cloves together in a bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together in a separate bowl with an electric mixer on low speed until moistened; beat in yogurt, eggs, and vanilla extract on medium speed. Beat in pumpkin purée and mashed bananas: fold in ½ cup chocolate chips and ½ cup pecans. Stir flour mixture into batter. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine granola, ¾ cup chocolate chips, and ½ cup pecans in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter among the prepared muffin cups, filling each ⅔ full; sprinkle with granola topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
