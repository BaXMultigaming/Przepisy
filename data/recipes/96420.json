  "ingredients": [
    "1 (3 ounce) package cream cheese",
    "0.5 cup mayonnaise",
    "1 tablespoon horseradish",
    "0.5 teaspoon minced garlic",
    "2 tablespoons minced onion",
    "1 tablespoon lemon juice",
    "0.5 teaspoon hot pepper sauce",
    "1 (8 ounce) can crabmeat, drained",
    "white pepper to taste",
    "4 soft pretzels",
    "2 cups shredded Colby-Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, mayonnaise, and horseradish in a large bowl until smooth. Stir in garlic, onion, lemon juice, and hot pepper sauce. Gently fold in the crabmeat, and season with white pepper to taste. Spoon mixture evenly over the pretzels, and sprinkle each with 1/2 cup shredded cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pretzels in the preheated oven until the cheese is melted and the topping is bubbly, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
