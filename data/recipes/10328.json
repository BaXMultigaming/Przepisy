  "ingredients": [
    "1 cup ground pecans",
    "0.5 cup white sugar",
    "1 tablespoon ground cinnamon",
    "1 (8 ounce) package cream cheese",
    "2 cups all-purpose flour",
    "1 cup butter",
    "2 tablespoons white sugar",
    "0.25 cup all-purpose flour",
    "1 cup apricot preserves"
  ],
  "steps": [
    {
      "text": "To make the filling: Combine pecans, 1/2 cup sugar, and cinnamon in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Soften butter and cream cheese in a large bowl. Add flour and sugar, blend well. Divide dough into four pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll each into a ball and dust each with flour, shake off excess. With a rolling pin, roll each piece between sheets of waxed paper into a 10-inch circle. Stack circles and refrigerate at least one hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread each circle of dough with light layer of apricot jam. Divide nut filling among circles, spread evenly. Cut each circle into 12 pie shaped wedges. Roll wedges from wide edge to point. Place on baking sheets point side down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
