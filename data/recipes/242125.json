  "ingredients": [
    "2 cups white vinegar",
    "0.5 cup brown sugar",
    "0.25 cup white sugar",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon lemon juice",
    "0.5 tablespoon salt",
    "1 teaspoon finely ground black pepper",
    "1 teaspoon finely ground red pepper",
    "0.75 teaspoon hot pepper sauce",
