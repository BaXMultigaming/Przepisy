  "ingredients": [
    "1 cup Italian-seasoned bread crumbs",
    "0.5 cup grated Parmesan cheese",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon garlic powder",
    "1 egg",
    "0.25 cup prepared ranch dressing",
    "1 pound skinless, boneless chicken breasts, cut into 1-inch cubes",
    "0.25 cup ranch dressing"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease an 11x7-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs, Parmesan cheese, salt, black pepper, and garlic powder in a shallow bowl. Beat egg and 1/4 cup ranch dressing in another shallow bowl; toss chicken in egg mixture until coated. Press chicken into bread crumb mixture and transfer to prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until chicken is no long pink in the center and juices run clear, 12 to 15 minutes. Serve with remaining 1/4 cup dressing as dipping sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
