  "ingredients": [
    "1 (12 ounce) package fresh cranberries",
    "1 cup white sugar",
    "1 cup apricot jam",
    "1 cup chopped pecans",
    "1 (8 ounce) package cream cheese"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cranberries with sugar in a 2 quart baking dish with a lid, stirring well to coat all the berries. Bake in the preheated oven, covered, for about 30 minutes, until the cranberries pop and release their liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pcN6D_QT6vE3PQQN9fyaMtauRb0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/96279-cranberry-dip-VAT-step-02-2b07eb60975441f4bd6007fe98d7263d.jpg"
      ],
      "image": "assets/images/96279/step_02.webp"
    },
    {
      "text": "Remove from oven and stir in the apricot jam and pecans. Refrigerate overnight to blend the flavors.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ay9aJcMQ0T9PTCVoW10_U-ohabk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/96279-cranberry-dip-VAT-step-03-805c430a7a88487ea74687dae5d4a72d.jpg"
      ],
      "image": "assets/images/96279/step_03.webp"
    },
    {
      "text": "To serve, allow the cream cheese to come to room temperature, and pour dip over the block of cream cheese on a serving dish. Serve with buttery round crackers or small pretzels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EFVEKksPG434O89hkVLG8WEPDIg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/96279-cranberry-dip-VAT-Beauty-4x3-550053091c1943ae917889bc9c478237.jpg"
      ],
      "image": "assets/images/96279/step_04.webp"
    }
  ],
