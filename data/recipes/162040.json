  "ingredients": [
    "1 cup white sugar",
    "2 tablespoons ground cinnamon",
    "2.5 cups cashews",
    "2 cups frozen raspberries, thawed",
    "0.5 cup red wine vinegar",
    "0.5 cup extra virgin olive oil",
    "3 chopped hearts of romaine",
    "1 (10 ounce) bag fresh baby spinach",
    "3 pears, cored and diced",
    "0.5 cup dried cherries",
    "1 cup feta cheese"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with aluminum foil. Place the sugar and cinnamon into a saucepan. Melt the sugar over medium heat without stirring. Add the cashews, and stir until well coated, then spread out onto the prepared baking sheet to cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree the raspberries, vinegar, and olive oil until smooth; set aside. Toss together the romaine, spinach, pears, cherries, and feta cheese in a large bowl. Toss with half of the raspberry dressing, and sprinkle with candied cashews. Serve with remaining dressing on the side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
