  "ingredients": [
    "0.5 cup white sugar",
    "4 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.75 teaspoon salt",
    "3 cups raisins",
    "1 tablespoon caraway seeds",
    "2 eggs, lightly beaten",
    "1.25 cups buttermilk",
    "1 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch round cast iron skillet or a 9-inch round baking or cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour (reserving 1 tablespoon), sugar, baking powder, baking soda, salt, raisins and caraway seeds in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend eggs, buttermilk and sour cream together in a small bowl; stir into flour mixture until flour is just moistened. Knead dough in bowl about 10 to 12 strokes. Dough will be sticky. Place the dough in the prepared skillet or pan and pat down. Cut a 4x¾ inch deep slit in the top of the bread. Dust with reserved flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 65 to 75 minutes. Let cool and turn bread onto a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
