  "title": "Spaghetti Squash Lasagna",
  "description": "This vegetarian spaghetti squash lasagna has layers of roasted squash, tomato sauce, ricotta, and mozzarella cheese for a comforting low carb meal.",
  "authors": [
    "BJBP"
  ],
  "date_published": "2018-06-08T10:42:49-04:00",
