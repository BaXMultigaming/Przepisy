  "ingredients": [
    "1 teaspoon salt",
    "1 teaspoon crumbled dried sage",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon ground nutmeg",
    "0.125 teaspoon red pepper flakes",
    "1 pinch ground ginger",
    "1 pound ground turkey"
  ],
  "steps": [
    {
      "text": "Stir salt, sage, black pepper, nutmeg, red pepper flakes, and ginger in a small bowl. Place turkey into a separate bowl and thoroughly mix in the spices. Form sausage into patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry the sausage patties in a skillet over medium heat until browned and the meat is no longer pink inside, 3 to 5 minutes per side.",
