  "keywords": [],
  "ingredients": [
    "1 tablespoon butter",
    "4 large eggs",
    "1 cup white sugar",
    "1 cup mashed strawberries",
    "1 cup mashed bananas",
    "1 cup strawberry yogurt",
    "0.5 cup rolled oats",
    "0.5 cup canola oil",
    "0.5 cup applesauce",
    "0.5 teaspoon vanilla extract",
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 8.5x4.5-inch loaf pans and one 5.75x3-inch mini loaf pan with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly beat eggs in a large bowl with an electric mixer. Add sugar, strawberries, bananas, yogurt, oats, oil, applesauce, and vanilla and beat until well combined. Let sit for 5 minutes to soak oats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour, baking soda, cinnamon, salt, and nutmeg to the strawberry-banana mixture, beating just until combined. Stir in walnuts. Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 40 minutes for mini loaf and 1 hour for larger loaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
