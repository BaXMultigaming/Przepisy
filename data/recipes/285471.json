  "ingredients": [
    "2 medium fennel bulbs",
    "3 tablespoons olive oil",
    "3 tablespoons white balsamic vinegar",
    "2 cloves garlic, minced",
    "1 teaspoon ground thyme",
    "0.75 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Trim stalks off the fennel, setting green fronds to the side to later use for garnish, if desired. Trim root ends to create a flat surface; there is no need to remove the core. Slice fennel into 1/4- to 1/3-inch slices and place on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, vinegar, garlic, thyme, salt, and pepper together in a small bowl; brush mixture over fennel slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until fennel is soft and caramelized, 25 to 30 minutes, turning slices over halfway through. Transfer to a serving platter and garnish with green fronds, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
