  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "4 eggs",
    "0.5 cup unsalted butter, melted",
    "1.5 cups low-fat buttermilk",
    "1.5 cups packed brown sugar",
    "2 cups white whole wheat flour",
    "1.5 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1.5 teaspoons salt",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon ground ginger",
    "0.66666668653488 cup raisins",
    "0.66666668653488 cup pumpkin seeds",
    "1 tablespoon raw sugar for sprinkling on top"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour three 7x3-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together pumpkin puree, eggs, butter, buttermilk, and brown sugar in a large bowl until well blended. Combine whole-wheat flour, all-purpose flour, baking soda, salt, cinnamon, nutmeg, cloves, and ginger in a small bowl. Fold flour mixture into pumpkin mixture until just blended. Gently stir in raisins and pumpkin seeds. Pour into prepared pans or muffin cups. Lightly sprinkle tops with raw sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into center comes out clean; about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
