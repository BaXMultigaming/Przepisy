  "ingredients": [
    "1 (8 ounce) can Pillsbury® refrigerated crescent dinner rolls",
    "0.25 cup pizza sauce",
    "0.75 cup shredded mozzarella cheese",
    "0.5 cup sliced pepperoni",
    "1 teaspoon grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Heat oven to 375 degrees F. Unroll dough on cookie sheet and separate into 4 rectangles; press each into 6x4-inch rectangle, firmly pressing perforations to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1 tablespoon pizza sauce on half of each rectangle to within 1 inch of edge. Sprinkle each with 3 tablespoons cheese; top with 6 slices pepperoni. Fold dough diagonally over filling; firmly press edges with fork to seal. Sprinkle each triangle with 1/4 teaspoon grated cheese. With fork, prick top of each to allow steam to escape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 13 to 15 minutes or until deep golden brown. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
