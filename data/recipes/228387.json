  "ingredients": [
    "4 pounds roma (plum) tomatoes, chopped",
    "1 cup butter, cubed",
    "6 cloves garlic, chopped",
    "0.25 cup chopped fresh thyme",
    "2 tablespoons cracked black pepper",
    "2 teaspoons kosher salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper or aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss tomatoes, butter, garlic, and thyme together in a bowl; pour onto prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until tomatoes are slightly charred and have reduced in size, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer tomato mixture to a blender; add black pepper and kosher salt. Blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
