  "ingredients": [
    "2 cups cake flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "2 eggs",
    "1 cup white sugar",
    "0.5 cup canola oil",
    "0.5 cup buttermilk",
    "2 tablespoons lemon juice",
    "1 lemon, zested",
    "1 cup grated zucchini",
    "1 cup powdered sugar",
    "2 tablespoons lemon juice",
    "1 tablespoon milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a bowl until well mixed. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl. Stir in sugar and oil until well blended. Stir in ½ cup buttermilk, 2 tablespoons lemon juice, and lemon zest until well blended. Fold in zucchini until incorporated. Stir in flour mixture until well combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine confectioners' sugar, 2 tablespoons lemon juice, and 1 tablespoon milk in a small bowl until smooth; spoon glaze over bread. Set loaf aside until glaze set ups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
