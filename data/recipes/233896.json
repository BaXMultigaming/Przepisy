  "ingredients": [
    "2 large green tomatoes, sliced 1/3-inch thick",
    "2 teaspoons white sugar",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup milk",
    "2 eggs",
    "1.25 cups all-purpose flour",
    "1 cup butter"
  ],
  "steps": [
    {
      "text": "Season each tomato slice with sugar, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk and eggs together in a bowl. Pour flour into another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently press each tomato slice into flour to coat; shake off excess flour. Dip tomato slices into egg mixture, then press again into flour. Place breaded tomato slices onto a plate while breading the rest; do not stack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1/2 cup butter in a large pan over medium heat. Place tomato slices in melted butter and cook until golden brown on one side, 5 to 7 minutes. Flip and cook on the other side until golden brown. Add more butter as need while frying.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
