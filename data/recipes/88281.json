  "ingredients": [
    "1 pound ground beef sirloin",
    "0.5 cup salsa",
    "0.5 cup Italian seasoned bread crumbs",
    "0.5 cup shredded Cheddar cheese",
    "1 egg, lightly beaten",
    "3 cloves garlic, minced",
    "dried parsley to taste",
    "salt and pepper to taste"
  ],
  "steps": [
    {
