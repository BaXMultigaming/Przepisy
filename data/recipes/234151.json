  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 cup oat bran",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "1 cup white sugar",
    "0.5 cup creamy goat cheese",
    "2 eggs",
    "1 cup grated cooked beets"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 12 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, oat bran, baking powder, baking soda, cinnamon, and ginger in bowl. Whisk sugar, goat cheese, and eggs together in a separate bowl until smooth and creamy; stir flour mixture into goat cheese mixture until flour mixture is completely absorbed into batter. Fold in beets. Spoon batter into the prepared muffins cups, filling 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, about 20 minutes. Cool in the pan for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
