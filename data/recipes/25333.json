        "https://www.allrecipes.com/thmb/BI2hQ6XGOQpbWw0eAM0ijzakMQU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_25333_VeganBlackBeanSoup_Shot1_12700-994159ebbf444afd96bf391ec280a393.jpg"
      ],
      "image": "assets/images/25333/step_01.webp"
    },
    {
      "text": "Heat olive oil in a large pot over medium-high heat. Sauté onion, carrots, celery, and garlic in hot oil for 5 minutes. Season with chili powder, cumin, and black pepper; cook for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a94a1lXemglhvUmCfADJ-DYNX8g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_25333_VeganBlackBeanSoup_Shot2_12713-0329b0d22f2b441fa42bd05a7c031147.jpg"
      ],
      "image": "assets/images/25333/step_02.webp"
    },
    {
      "text": "Stir in vegetable broth, 2 cans beans, and corn. Bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gv5TM9eYM-LBDYV4WmmtaSMTEP4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_25333_VeganBlackBeanSoup_Shot3_12726-f47104bcd7a04b86acb17f89d9d6982b.jpg"
      ],
      "image": "assets/images/25333/step_03.webp"
    },
    {
      "text": "Meanwhile, process remaining 2 cans beans and tomatoes in a food processor or blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jS54WtxuZ5TQERvZatJDgk9PLQk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_25333_VeganBlackBeanSoup_Shot4_12736-a710332916594f13a6a977be0f1bc9e3.jpg"
      ],
      "image": "assets/images/25333/step_04.webp"
    },
    {
      "text": "Stir into boiling soup, reduce heat to medium, and simmer for 15 minutes.",
      "section": null,
      "name": null,
