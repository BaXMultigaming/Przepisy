  "ingredients": [
    "6 large eggs",
    "6 cups cooked turkey meat",
    "1 (16 ounce) jar sweet pickles, chopped",
    "1.5 (10 ounce) jars mustard-mayonnaise blend",
    "0.75 cup mayonnaise"
  ],
  "steps": [
    {
      "text": "Place eggs in a medium saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove from hot water, cool, peel and chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, thoroughly mix eggs, turkey, pickles, mustard-mayonnaise blend, and mayonnaise. Chill in the refrigerator for about 3 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
