  "ingredients": [
    "2 cups confectioners' sugar",
    "0.5 cup milk, or as needed",
    "1.5 teaspoons vanilla extract",
    "2 cups dry roasted salted peanuts, finely chopped",
    "1 pound cake, cut into bize-size cubes"
  ],
  "steps": [
    {
      "text": "Pour confectioners' sugar in a bowl. Gradually add milk, whisking constantly, until mixture has a thin frosting consistency; whisk in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chopped peanuts in a bowl. Line a flat surface or a plate with waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip 1 pound cake cube in frosting and roll cube in peanuts; place on wax paper to dry. Repeat with remaining pound cake pieces.",
      "section": null,
      "name": null,
      "url": null,
