  "title": "The Best Clam Sauce",
  "description": "This clam sauce is made with canned minced clams, clam juice, butter, and white wine simmered until thickened and served warm over linguine pasta.",
  "authors": [
    "Jodie B"
  ],
  "date_published": "2000-01-26T16:31:37-05:00",
