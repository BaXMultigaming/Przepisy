  "ingredients": [
    "cooking spray",
    "8 slices bacon",
    "1 tomato, chopped",
    "0.5 onion, chopped",
    "3 ounces shredded Swiss cheese",
    "0.5 cup mayonnaise",
    "1 teaspoon dried basil",
    "1 (16 ounce) can refrigerated buttermilk biscuit dough"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease 32 mini muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet over medium heat, cook bacon until evenly browned. Drain on paper towels, then crumble into a medium mixing bowl. Mix in tomato, onion, Swiss cheese, mayonnaise, and basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate biscuits into halves horizontally, then cut each piece in half again for 32 pieces. Roll slightly to flatten, then place each piece into a prepared muffin cup. Spoon bacon mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
