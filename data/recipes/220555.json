        "https://www.allrecipes.com/thmb/535qCMBvzsCxLfWAs1zTsgcl7hI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220555-stout-slow-cooker-corned-beef-and-veggies-ddmfs-step-4-0673-3x4-8cea4f17cd754daeb98ceb13d66620e1.jpg"
