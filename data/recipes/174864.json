  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup butter, softened",
    "0.75 cup white sugar",
    "0.75 cup packed brown sugar",
    "1 teaspoon vanilla extract",
    "2 large eggs",
    "2 cups semisweet chocolate chips (such as Nestlé Toll House)",
    "1 cup chopped nuts"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DRkTzm5wj5CHveJKWejEe02H2BU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/174864-OriginalNestleTollHouseChocolateChipCookies-Step1-58b8e0fb4a9548a093c39d2687207e8e.jpg"
      ],
      "image": "assets/images/174864/step_01.webp"
    },
    {
      "text": "Combine flour, baking soda and salt in small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tfZGooEnFNN2njQiCY14bgGIw_o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/174864-OriginalNestleTollHouseChocolateChipCookiesStep2-3155c40e10574ce381a64ba2ea7e51f2.jpg"
      ],
      "image": "assets/images/174864/step_02.webp"
    },
    {
      "text": "Beat butter, white sugar, brown sugar and vanilla in a large mixing bowl until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5jQBrEp5pqpS4e_tapWAigponoI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/174864-OriginalNestleTollHouseChocolateChipCookies-Step3-ff4496c880884610b6cacc5cb722e382.jpg"
      ],
      "image": "assets/images/174864/step_03.webp"
    },
    {
      "text": "Add eggs, one at a time, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ORM1KOSqTNA3om4X7YBrqdKl6uQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/174864-OriginalNestleTollHouseChocolateChipCookies-Step4-2c7ed326e9ea4a3199e5aba414335139.jpg"
      ],
      "image": "assets/images/174864/step_04.webp"
    },
    {
      "text": "Gradually beat in flour mixture. Stir in chocolate morsels and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C8Wlkyz1jABo7YX5RgO0KpSaQ8A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/174864-OriginalNestleTollHouseChocolateChipCookies-Step6-add04fb4ac514ef78de6aaa7e7de5eb2.jpg"
      ],
      "image": "assets/images/174864/step_05.webp"
    },
    {
      "text": "Drop by rounded tablespoon onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i_AwJBVzt3K2bDtAjJgSph_rqzQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/174864-OriginalNestleTollHouseChocolateChipCookies-Step7-1a5ed1c7110c400cb4972040580ae812.jpg"
      ],
      "image": "assets/images/174864/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 9 to 11 minutes, switching racks halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vSqydwOBUBk5kkzs5SYAJ46xiMs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/174864-OriginalNestleTollHouseChocolateChipCookies-Step8-fdd2b169575c405aa10c8ea35e6fffad.jpg"
      ],
      "image": "assets/images/174864/step_07.webp"
    },
    {
      "text": "Cool on the baking sheets for 2 minutes, then transfer to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i92uaLOipayNycWwwaPcd1BWxVQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/174864-OriginalNestleTollHouseChocolateChipCookies-Step9-bea75c666706457caee852cf5c2d727e.jpg"
      ],
      "image": "assets/images/174864/step_08.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z786ICmPzuLwjl6piOnlHYqm4SE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/174864-OriginalNestleTollHouseChocolateChipCookies-4x3-ce1f685176724255b002320030545068.jpg"
      ],
      "image": "assets/images/174864/step_09.webp"
    }
