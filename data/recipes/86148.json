  "ingredients": [
    "1.5 cups dried small pasta shells",
    "3 cups imitation crab or lobster meat",
    "2 stalks celery, finely chopped",
    "0.75 cup black olives",
    "1.5 cups mayonnaise",
    "0.33333334326744 cup Catalina salad dressing",
    "2 teaspoons Worcestershire sauce",
    "1 tablespoon hot sauce",
    "0.25 teaspoon Dijon mustard",
    "1 cup cubed Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta, and cook until al dente, about 8 to 10 minutes. Drain, and place pasta in a large bowl. Stir in crabmeat, celery, and olives. Mix in mayonnaise, Catalina dressing, Worcestershire sauce, hot sauce, and Dijon. Stir in Cheddar cheese, cover, and chill at least 1 hour.",
