  "ingredients": [
    "1 (1 pound) loaf Italian bread",
    "5 tablespoons butter, softened",
    "3 cloves garlic, crushed",
    "2 teaspoons extra virgin olive oil",
    "1 teaspoon dried oregano",
    "salt and pepper to taste",
    "1 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/35OV39oaJEsBVYS7mi8ToIj2Yl0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21060_ToastedGarlicBread-DDMFS-062-step1-f3d1ee7104e0436dbb90aef79db30ae5.jpg"
      ],
      "image": "assets/images/21060/step_01.webp"
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Cut loaf into ten 1-inch slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p56zKrj_oVAqwezt4eugVboiX5k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21060_ToastedGarlicBread-DDMFS-063-step2-83f59a69bb2a49069c9dab75e3ea141d.jpg"
      ],
      "image": "assets/images/21060/step_02.webp"
    },
    {
      "text": "Mix butter, garlic, oil, oregano, salt, and pepper together in a bowl; spread butter mixture on one side of each slice of bread; arrange bread slices, butter-side up, in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XChZtEZqNfSNMJv9rXF69X-DQcA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21060_ToastedGarlicBread-DDMFS-067-step6-c0fcdc4bc0504e95898637b94c2ff843.jpg"
      ],
      "image": "assets/images/21060/step_03.webp"
    },
    {
      "text": "Cook under the preheated broiler until slightly brown, checking frequently so they do not burn, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jc-BGH35DDsGaP_Baq9nJ9axkhY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21060_ToastedGarlicBread-DDMFS-068-step7-c5b49fb0b7b946e9af90389c236d4fee.jpg"
      ],
      "image": "assets/images/21060/step_04.webp"
    },
    {
      "text": "Top bread slices with cheese and return to broiler until cheese is slightly brown and melted, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CJ6UemA1Lqp4vhkcrQI5uVnbYEY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21060_ToastedGarlicBread-DDMFS-069-step8-9d22383a0cab401c8c5472b7bef9ee9b.jpg"
      ],
      "image": "assets/images/21060/step_05.webp"
    },
    {
      "text": "Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6EXUIgj5AB5YLT0ajOtcv3d3-t4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21060_ToastedGarlicBread-DDMFS-074-4x3-4f05bc2c7cfc433e9c4d33e16a5b4e34.jpg"
      ],
      "image": "assets/images/21060/step_06.webp"
    }
