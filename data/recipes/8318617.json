  "ingredients": [
    "1 (2 pound) package frozen pancakes (such as De Wafelbakkers®), cut in half",
    "5 large eggs",
    "1.25 cups heavy cream",
    "0.75 cup milk",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon kosher salt",
    "0.5 cup finely chopped pecans",
    "0.333 cup all-purpose flour",
    "0.25 cup brown sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon kosher salt",
    "0.25 cup cold unsalted butter, cubed"
  ],
  "steps": [
    {
      "text": "Lightly butter a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To prepare the casserole: Prick each pancake half several times with a fork. Place in the prepared baking dish in 2 to 3 long rows, overlapping in a shingled formation.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, heavy cream, milk, vanilla, cinnamon, and salt together in a large bowl. Pour over pancakes. Cover and refrigerate the casserole for 8 hours, to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to bake, preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the streusel topping: Combine pecans, flour, brown sugar, cinnamon, and salt in a medium bowl. Add butter and mix with a fork or your fingers until crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pancakes from the refrigerator and uncover. Sprinkle streusel topping evenly over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and cooked throughout, about 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
