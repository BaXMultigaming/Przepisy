  "ingredients": [
    "1 pound ground turkey",
    "1 (1 ounce) package dry onion soup mix",
    "2 tablespoons steak sauce",
    "cooking spray",
    "4 hamburger buns"
  ],
  "steps": [
    {
      "text": "Mix together ground turkey, onion soup mix, and steak sauce in a large bowl. Shape into 4 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat; lightly coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook patties in the hot skillet until cooked through, about 4 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve patties on hamburger buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
