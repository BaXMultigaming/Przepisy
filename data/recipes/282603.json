  "ingredients": [
    "3 tablespoons aquafaba (liquid from can of chickpeas)",
    "1 tablespoon red bell peppers, peeled and cut into 1/2-inch pieces",
    "1 tablespoon lemon juice",
    "2 teaspoons Dijon mustard (such as Maille®)",
    "0.5 cup avocado oil",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Combine chickpea liquid, whole chickpeas, lemon juice, and mustard in a tall container. Using an immersion blender, blend on high speed until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce speed to low and slowly drizzle in oil until creamy. Season with salt. Cover and refrigerate for up to 1 week.",
      "section": null,
      "name": null,
