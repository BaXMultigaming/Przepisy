  "ingredients": [
    "2 cups all-purpose flour, or more as needed",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon cumin seeds",
    "0.5 teaspoon white sugar",
    "1 cup milk",
    "2 tablespoons oil, divided"
  ],
  "steps": [
    {
      "text": "Combine flour, baking soda, baking powder, cumin seeds, and sugar together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk and 1 tablespoon oil in a small saucepan; heat over medium heat until warm, 3 to 5 minutes. Stir into flour mixture until small clumps form. Knead dough, adding more flour by the tablespoon if needed, until it is soft and smooth. Let dough rest, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 4 equal pieces. Pressed into flat circles on a floured work surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush a large skillet with remaining 1 tablespoon oil; heat over medium-high heat. Cook circles of dough one at a time until golden brown, about 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
