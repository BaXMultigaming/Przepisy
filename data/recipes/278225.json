  "steps": [
    {
      "text": "Heat olive oil in a cast iron skillet over medium-high heat. Add pecans; cook and stir until fragrant, about 5 minutes. Transfer to a small bowl and sprinkle with stevia and chipotle powder; toss until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place kale in a large bowl. Drizzle with olive oil and sprinkle with salt. Massage until leaves begin to soften, about 2 minutes. Add diced apple and spiced pecans. Fold in feta cheese.",
