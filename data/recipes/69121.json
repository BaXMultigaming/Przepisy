  "ingredients": [
    "1 pound Braunschweiger (a liver sausage), pork",
    "0.5 (8 ounce) package cream cheese, softened",
    "1 tablespoon milk",
    "1 tablespoon finely chopped onion",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon chili powder",
    "0.5 teaspoon sugar",
    "0.5 teaspoon minced garlic"
  ],
  "steps": [
    {
      "text": "Mix together sausage, cream cheese, milk, and onion in a medium bowl. Season with Worcestershire sauce, chili powder, sugar, and garlic, and mix until well blended.",
