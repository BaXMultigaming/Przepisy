  "ingredients": [
    "1 cup butter",
    "0.5 cup confectioners' sugar",
    "2.25 cups all-purpose flour",
    "0.75 cup chopped walnuts",
    "0.25 teaspoon salt",
    "1 teaspoon vanilla extract",
    "0.33333334326744 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Combine all ingredients, mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate dough until chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Roll dough into 1-inch balls and bake for 15 minutes in the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once baked, roll while still hot in confectioners' sugar until coated. Let cool. Lightly dust with more confectioners' sugar.",
