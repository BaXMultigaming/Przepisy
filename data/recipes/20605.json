  "title": "Cheese Onion Garlic Bread",
  "description": "Plenty of garlic and melted Italian cheeses taste wonderful on pieces of sliced French bread.",
  "authors": [
    "MARBALET"
  ],
  "date_published": "2000-02-15T17:36:42-05:00",
