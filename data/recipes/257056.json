  "ingredients": [
    "2 cups dried fruit",
    "1.25 cups brewed black tea, cold",
    "cooking spray",
    "2.75 cups self-rising flour, sifted",
    "0.75 cup light brown sugar, or to taste",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Place dried fruit in a bowl and pour in tea; let soak for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a loaf pan with cooking spray and line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat flour, brown sugar, and egg into fruit mixture until batter is well mixed; pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven on the center rack until a skewer inserted into the center comes out clean, 1 1/4 to 1 1/2 hours.",
