  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs for approximately 2 minutes in a medium mixing bowl. Gradually mix in sugar, milk, evaporated milk, melted butter, and vanilla until well combined, then pour into pastry shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
