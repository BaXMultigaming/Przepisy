  "ingredients": [
    "1 prepared 8 inch pie crust",
    "4 eggs",
    "1 cup white sugar",
    "1 cup milk",
    "0.66670000553131 cup evaporated milk",
    "2 tablespoons butter, melted",
    "2 tablespoons vanilla extract",
