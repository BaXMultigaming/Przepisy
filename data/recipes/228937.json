  "ingredients": [
    "0.5 cup butter, melted",
    "1 cup self-rising flour",
    "1 cup white sugar",
    "1 cup milk",
    "1 (28 ounce) can sliced peaches",
    "1 teaspoon almond extract",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place butter in a 9x9-inch baking pan; melt in the preheating oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, sugar, and milk in a large bowl until smooth. Set batter aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Open canned peaches and add almond extract to peaches and juice. Pour peaches and juice over melted butter in the pan. Spoon batter atop peaches without mixing. Sprinkle with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling and top is lightly browned, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
