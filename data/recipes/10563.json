  "ingredients": [
    "0.5 cup butter, softened",
    "1 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "0.25 teaspoon salt",
    "0.5 teaspoon baking soda",
    "2 cups crisp rice cereal",
    "1 cup butterscotch chips"
  ],
  "steps": [
    {
      "text": "In large bowl, cream butter or margarine and sugar until light and fluffy. Add egg and vanilla; beat until well blended. Add flour, salt, and baking soda, mixing well. Stir in cereal and butterscotch chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by heaping tablespoon onto greased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 12-15 minutes, until lightly browned. Remove cookies to cool on racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
