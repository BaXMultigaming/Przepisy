  "ingredients": [
    "cooking spray",
    "3 ripe bananas",
    "0.5 cup white sugar",
    "0.66666668653488 cup cinnamon-flavored applesauce",
    "3 eggs",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "2.25 cups gluten-free all purpose baking flour (such as Krusteazl®)",
    "0.66666668653488 cup chopped dates",
    "0.75 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Spray a 9x9-inch baking dish with cooking spray (do not use a loaf pan).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash bananas in a bowl. Add sugar and applesauce and mix well. Mix in eggs, baking soda, and baking powder. Add flour 2 tablespoons at a time. Fold in dates and walnuts. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 45 to 60 minutes. Cool on a wire rack for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
