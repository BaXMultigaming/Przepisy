  "ingredients": [
    "1 cup water",
    "0.5 cup uncooked quinoa, rinsed and drained",
    "1.5 cups all-purpose flour",
    "1 cup whole wheat flour",
    "0.5 teaspoon salt",
    "1.5 teaspoons ground cinnamon",
    "1.5 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 pinch ground cloves",
    "1 pinch ground nutmeg",
    "1 pinch ground allspice",
    "1 pinch ground ginger",
    "1 pinch cayenne pepper",
    "1.5 cups shredded squash",
    "1.5 cups plain yogurt",
    "0.5 cup brown sugar",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts",
    "2 eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Bring water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender and water is absorbed, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease 18 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all-purpose flour, whole wheat flour, cinnamon, baking powder, baking soda, cloves, nutmeg, allspice, ground ginger, and cayenne pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir squash, yogurt, brown sugar, raisins, walnuts, eggs, and vanilla together in a large bowl. Add flour mixture to squash mixture; stir. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
