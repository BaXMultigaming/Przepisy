  "ingredients": [
    "1 (28 ounce) can stewed tomatoes",
    "1 large onion, chopped",
    "3 large jalapeno peppers, stemmed and chopped",
    "0.5 cup cilantro",
    "2 cloves garlic, peeled",
    "2 teaspoons vinegar",
    "1.5 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Combine tomatoes, onion, jalapeños, cilantro, garlic, vinegar, and salt in a blender; blend until smooth. Store in a quart jar or an airtight container.",
