  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "salt to taste",
    "0.75 cup bread crumbs",
    "0.5 cup Parmesan cheese",
    "1 teaspoon dried basil",
    "0.25 teaspoon ground black pepper",
    "2 tablespoons olive oil",
    "1 tablespoon crushed garlic"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken breasts with a little salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs, Parmesan cheese, basil, and pepper in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil and garlic in a skillet over medium heat until fragrant, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken breasts in the garlic oil, then into the bread crumb-Parmesan mixture. Place chicken in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink in the center and the juices run clear, about 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
