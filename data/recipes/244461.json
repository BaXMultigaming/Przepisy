  "ingredients": [
    "2 cups quick-cooking oats",
    "1 cup dried cranberries",
    "1 cup pecan halves",
    "0.5 cup ground flax seed",
    "0.5 cup milk chocolate chips",
    "0.25 cup wheat germ",
    "1 cup packed light brown sugar",
    "0.5 cup honey",
    "2 tablespoons vegetable oil",
    "0.5 teaspoon salt",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line an 8-inch square baking dish with parchment paper or waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, cranberries, pecans, ground flax seed, chocolate chips, and wheat germ together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar, honey, vegetable oil, and salt together in a large microwave-safe bowl; heat in microwave for 30 seconds. Stir mixture and heat in microwave again until smooth, about 30 seconds more. Stir vanilla extract and cinnamon into brown sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar mixture into oats mixture until evenly mixed and chocolate is melted; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden brown, about 30 minutes. Lift bars out of pan by pulling by the parchment paper; cool for 5 minutes before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
