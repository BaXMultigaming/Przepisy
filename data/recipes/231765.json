  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup packed brown sugar",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons pumpkin pie spice",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "1 cup pumpkin puree",
    "2 eggs",
    "0.25 cup milk",
    "0.25 cup butter, softened",
    "1.5 cups confectioners' sugar",
    "0.25 cup butter, melted",
    "2 tablespoons water",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a donut pan. Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, baking powder, pumpkin pie spice, salt, and baking soda in a bowl; beat in pumpkin purée, eggs, milk, and ¼ cup softened butter with an electric mixer on low speed until batter is just combined. Spoon batter into the prepared donut pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until donuts spring back when gently pressed, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat confectioners' sugar, ¼ cup melted butter, water, and vanilla extract together in a bowl until glaze is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip warm donuts into glaze, allowing any excess glaze to drip back into the bowl. Place glazed donuts onto the prepared baking sheet to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
