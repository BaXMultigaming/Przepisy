  "ingredients": [
    "2 pounds lean ground beef",
    "1 quart water, or amount to cover",
    "2 onions, finely chopped",
    "1 (15 ounce) can tomato sauce",
    "2 tablespoons vinegar",
    "4 cloves garlic, minced",
    "2 teaspoons Worcestershire sauce",
    "0.5 (1 ounce) square unsweetened chocolate",
    "0.25 cup chili powder",
    "1.5 teaspoons salt",
    "1 teaspoon ground cumin",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground cayenne pepper",
    "5 whole cloves",
    "5 whole allspice berries",
    "1 bay leaf"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-0vC3ukyvU1O0CChtxKfP6-3sfU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/206953-authentic-cincinnati-chili-ddmfs-4x3-step-01-1525-59da5341618342978bee7464d7cd053e.jpg"
      ],
      "image": "assets/images/206953/step_01.webp"
    },
    {
      "text": "Place ground beef in a large pan, cover with cold water, and bring to a boil, stirring and breaking up beef with a fork to a fine texture. Slowly boil until meat is thoroughly cooked, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yYovUIPK4xTGccQQZoep80wClM8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/206953-authentic-cincinnati-chili-ddmfs-4x3-step-02-1528-6ea3672365eb45a085239bdfd25fb31d.jpg"
      ],
      "image": "assets/images/206953/step_02.webp"
    },
    {
      "text": "Add onions, tomato sauce, vinegar, garlic, Worcestershire sauce, and chocolate. Stir in chili powder, salt, cumin, cinnamon, and cayenne pepper until well mixed. Add cloves, allspice berries, and bay leaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pYI2dew7343YMqXLDLWRCnb4wgM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/206953-authentic-cincinnati-chili-ddmfs-4x3-step-03-1531-fe1274d39b2a48f696ce159996debc5b.jpg"
      ],
      "image": "assets/images/206953/step_03.webp"
    },
    {
      "text": "Bring to a boil, reduce heat to a simmer, and cook, stirring occasionally, for 3 hours. Add water if necessary to prevent chili from burning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/km3FT5pEBJDlyR4QFtAft0xpH7A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/206953-authentic-cincinnati-chili-ddmfs-4x3-step-04-1543-47e33d88efb647578b288af337d206e0.jpg"
      ],
      "image": "assets/images/206953/step_04.webp"
    }
