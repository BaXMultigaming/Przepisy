  "ingredients": [
    "0.25 cup lemon juice",
    "3 tablespoons olive oil",
    "1 tablespoon balsamic vinegar",
    "1 clove garlic, minced",
    "1 sprig fresh rosemary, minced",
    "4 (4 ounce) salmon fillets",
    "sea salt to taste"
  ],
  "steps": [
    {
      "text": "Whisk lemon juice, oil, vinegar, garlic, and rosemary together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season salmon with salt. Place into a shallow glass dish and pour marinade over top. Cover and refrigerate for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to cook, preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove salmon from marinade and shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until fish is opaque in the center and flakes easily with a fork, about 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
