  "ingredients": [
    "4 tablespoons butter",
    "1 clove garlic, minced",
    "3 (3/4 inch thick) slices French bread, cut into cubes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add garlic; cook and stir until fragrant, about 1 minute. Add bread cubes and toss until coated. Transfer to a rimmed baking sheet and spread in an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, checking frequently to prevent burning, until crisp and dry, about 15 minutes. Let cool before using, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
