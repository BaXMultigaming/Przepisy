  "ingredients": [
    "0.25 cup water",
    "2 tablespoons ground flaxseed",
    "1 cup coconut oil",
    "1 cup white sugar",
    "1 cup brown sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "0.25 cup brewers' yeast",
    "1 teaspoon salt",
    "2 cups oats",
    "1 cup cocoa nibs, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water and flaxseed in a small bowl; set aside to soak, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat coconut oil, white sugar, and brown sugar together in a large bowl with an electric mixer until smooth. Beat in 1 egg until completely blended. Add remaining 1 egg, flaxseed mixture, and vanilla; beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brewer's yeast, and salt in a separate bowl; add to sugar-egg mixture and beat until just incorporated, forming a dough. Fold in oats and cocoa nibs. Roll dough into small balls; arrange on baking sheets and flatten slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
