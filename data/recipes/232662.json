  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, onion, bread crumbs, bell peppers, 1/3 cup ketchup, 1/4 cup pineapple preserves, 1/4 cup brown sugar, egg, Worcestershire sauce, and garlic powder in a food processor; pulse until blended. Transfer to a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir 1/3 cup ketchup, 1/4 cup pineapple preserves, and 1/4 cup brown sugar together in a bowl; pour over meatloaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue baking until meatloaf is no longer pink in center, about 20 minutes more. An instant-read thermometer inserted into center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
