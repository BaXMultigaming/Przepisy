  "ingredients": [
    "2 quarts water",
    "1 (750 milliliter) bottle dark rum",
    "2 cups brown sugar",
    "0.25 cup butter",
    "3 cinnamon sticks",
    "6 whole cloves",
    "1 teaspoon salt",
    "1 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Combine water, rum, brown sugar, butter, cinnamon sticks, cloves, salt, and nutmeg in a slow cooker. Steep on Low until flavors combine, 2 to 6 hours.",
