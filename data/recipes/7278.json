  "ingredients": [
    "0.5 cup butter",
    "0.5 cup light corn syrup",
    "1 cup semisweet chocolate chips",
    "0.5 cup white sugar",
    "3 eggs",
    "1 cup all-purpose flour",
    "1 cup chopped walnuts",
    "1 teaspoon vanilla extract",
    "2 tablespoons butter",
    "1 tablespoon light corn syrup",
    "2 cups sliced fresh strawberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter and flour a 9-inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1/2 cup butter and 1/2 cup light corn syrup in a saucepan over low heat. Stir in 1 cup chocolate chips until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, add sugar and eggs; stir until blended. Stir in flour, walnuts, and 1 teaspoon vanilla. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center springs back when touched, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool in the pan 10 minutes, then turn out onto a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine remaining 1/2 chocolate chips, 2 tablespoons butter, and 1 tablespoon corn syrup in a saucepan over low heat; stir until chips are melted. Off heat, stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Frost tops and sides of torte with chocolate glaze; chill until set. Garnish with strawberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
