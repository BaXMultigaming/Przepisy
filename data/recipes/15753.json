  "ingredients": [
    "1 cup butter",
    "2 cups chopped celery",
    "2 cups chopped onion",
    "2 (8 ounce) cans mushrooms, drained",
    "0.25 cup chopped parsley",
    "12 cups white bread, cut into cubes",
    "1.5 teaspoons salt",
    "1.5 teaspoons sage",
    "1 teaspoon poultry seasoning",
    "1 teaspoon dried thyme",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon dried marjoram",
    "2 eggs, beaten",
    "4 cups chicken broth"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Add celery, onion, mushrooms, and parsley; sauté until soft, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine bread cubes and cooked vegetables. Add salt, sage, poultry seasoning, thyme, pepper, and marjoram. Toss together well. Add egg and enough broth to moisten.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly pack stuffing mixture into a slow cooker. Cover and cook on High for 45 minutes. Reduce to Low and cook for 4 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
