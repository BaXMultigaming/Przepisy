  "ingredients": [
    "1 cup soft bread crumbs",
    "0.5 sweet onion, minced",
    "2 tablespoons chopped fresh dill",
    "2 teaspoons grated lemon zest",
    "1 clove garlic, minced",
    "0.25 cup olive oil, divided",
    "salt and pepper to taste",
    "4 trout, cleaned and head removed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss bread crumbs with onion, dill, lemon zest, garlic, and 1/2 of the olive oil. Season with salt and pepper to taste. Press stuffing into trout, then brush with remaining olive oil; season with salt and pepper. Place trout onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until skin begins to brown, and the flesh flakes easily with a fork, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
