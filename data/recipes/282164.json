  "ingredients": [
    "cooking spray",
    "1 cup chunky salsa",
    "6 ounces cream cheese, softened",
    "3 cups shredded, cooked chicken",
    "8 (8 inch) flour tortillas",
    "1 (15 ounce) can enchilada sauce",
    "0.5 cup shredded Mexican cheese blend"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a rimmed baking sheet with aluminum foil; coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine salsa and cream cheese in a large saucepan over medium heat; cook and stir until cream cheese melted, mixture is creamy, and thoroughly combined, 3 to 5 minutes. Add chicken; cook until heated through, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon chicken mixture onto tortillas; roll into enchiladas. Place, seam-sides down, on the prepared baking sheet. Top with enchilada sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Top with Mexican cheese; continue baking until cheese melted, 5 to 10 minutes more. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
