  "ingredients": [
    "1 onion, minced",
    "1 tomato - peeled, seeded, and minced",
    "0.5 cup chopped fresh flat-leaf parsley",
    "4 cloves garlic, minced",
    "1 tablespoon dried oregano",
    "1 tablespoon paprika",
    "1 tablespoon coarse salt",
    "1 teaspoon ground black pepper",
    "0.5 cup olive oil",
    "0.25 cup red wine vinegar",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Combine onion, tomato, parsley, garlic, oregano, paprika, salt, and black pepper. Add olive oil, red wine vinegar, and water; stir to combine. Refrigerate until flavors are blended, 8 hours to 3 days.",
