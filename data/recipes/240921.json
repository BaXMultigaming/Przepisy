  "ingredients": [
    "3 (6 ounce) salmon fillets",
    "0.25 cup lemon juice",
    "cooking spray",
    "0.25 cup brown sugar",
    "2 tablespoons chili powder",
    "4 teaspoons lemon zest",
    "1 tablespoon vegetable oil",
    "1.5 teaspoons ground cumin",
    "1.25 teaspoons ground cinnamon",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place salmon in a resealable bag and add lemon juice; marinate in the refrigerator for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a baking dish with aluminum foil and spray foil with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend brown sugar, chili powder, lemon zest, oil, cumin, cinnamon, and salt together in a blender until brown sugar mixture is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove salmon from bag and discard bag and lemon juice. Spread brown sugar mixture over salmon and place in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
