  "ingredients": [
    "nonstick cooking spray",
    "6 cups peeled and cubed sweet potatoes",
    "0.5 cup butter, sliced",
    "0.25 cup water",
    "2 tablespoons maple syrup",
    "2 tablespoons brown sugar",
    "2 tablespoons heavy cream",
    "1 teaspoon maple extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "10 miniature marshmallows, or more to taste"
  ],
  "steps": [
    {
      "text": "Spray the inside of a slow cooker with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cubed sweet potatoes in the slow cooker. Add butter and water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until sweet potatoes are soft when pricked with a fork, 4 hours on Low or 2 hours on High. Turn slow cooker off. Add maple syrup, brown sugar, heavy cream, maple extract, cinnamon, nutmeg and salt to the slow cooker and blend with an immersion blender. Garnish with mini marshmallows.",
      "section": null,
