  "ingredients": [
    "1 cup white sugar",
    "2 cups all-purpose flour",
    "1 cup mayonnaise",
    "1 teaspoon baking soda",
    "1 pinch salt",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Mix together sugar, flour, baking soda, and salt. Add mayonnaise and vanilla. Mix together very well.",
