  "ingredients": [
    "1 (15 ounce) can pumpkin",
    "1 cup white sugar",
    "1 teaspoon salt",
    "1 teaspoon ground ginger",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 cup chopped pecans",
    "0.5 gallon vanilla ice cream, softened",
    "36 vanilla wafers"
  ],
  "steps": [
    {
      "text": "In a large bowl, combine pumpkin, sugar, salt, ginger, cinnamon and nutmeg and mix until well blended. Stir in pecans. Fold in ice cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a 9x13 inch dish or sealable plastic container with 18 cookies. Spread half the ice cream mixture over the cookies. Repeat layers. Freeze until firm.",
      "section": null,
