      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fA0GRzIg6bVURd13fZy9cyCGvF4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-111840-bacon-and-parmesan-penne-pasta-ddmfs-step3-3x4-10d3ae8735034a2292452e13b7180e92.jpg"
      ],
      "image": "assets/images/111840/step_03.webp"
    },
    {
      "text": "Remove from the heat and drain grease into a small container.",
