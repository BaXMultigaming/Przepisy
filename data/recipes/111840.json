      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ygRB_kEd99Md4X93SoUhDEjiCvw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-111840-bacon-and-parmesan-penne-pasta-ddmfs-step5-3x4-6f515058aa2d4fa189f1b24b3abf7e60.jpg"
