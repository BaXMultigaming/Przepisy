  "ingredients": [
    "1 (16 ounce) package dry penne pasta",
    "1 pound bacon, coarsely chopped",
    "1 large onion, chopped",
    "0.25 cup olive oil",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
