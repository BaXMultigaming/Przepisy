  "ingredients": [
    "4 eggs",
    "0.25 cup cornstarch",
    "0.25 cup white sugar",
    "5 cloves garlic, minced",
    "0.5 cup sweet rice flour (mochiko)",
    "4 teaspoons salt",
    "4 green onions, chopped",
    "0.25 cup oyster sauce",
    "5 pounds boneless chicken thighs, cut in half",
    "2 cups vegetable oil, for deep frying"
  ],
  "steps": [
    {
      "text": "Combine eggs, cornstarch, sugar, garlic, rice flour, salt, green onions, and oyster sauce in a large bowl. Mix well. Stir in the chicken thighs, making sure to coat evenly. Cover and refrigerate overnight. Remove from refrigerator about 10 minutes prior to frying.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook chicken in the hot oil in batches, until golden brown and no longer pink inside.",
