  "ingredients": [
    "7 sweet Italian sausages, or more to taste, removed from the casings and cut into bite-size pieces",
    "1 tablespoon olive oil, or more to taste",
    "1 large sweet onion, halved and sliced",
    "2 (14.5 ounce) cans tomato sauce",
    "3 green bell peppers, sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place sausage pieces in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium-high heat. Add onion; sauté until translucent, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sausage into onion; stir in tomato sauce. Bring to a simmer; cook for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in bell pepper until coated in tomato sauce; cook until bell pepper tender, about 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
