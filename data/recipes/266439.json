  "ingredients": [
    "4 tablespoons unsalted butter, softened",
    "2 teaspoons dried dill",
    "6 ears corn, husks and silk removed",
    "0.66666668653488 cup crumbled blue cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and dill in a small bowl to form a paste; rub on each ear of corn. Wrap each ear individually in aluminum foil; arrange on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Transfer baking sheet to a heat-proof surface; carefully open each packet. Sprinkle corn with blue cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake corn in the preheated oven until cheese is melted, about 5 minutes.",
