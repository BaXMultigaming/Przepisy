  "ingredients": [
    "2 cups cooked turkey meat, chopped",
    "0.5 cup mayonnaise, or to taste",
    "1 teaspoon sweet pickle relish",
    "1 teaspoon Dijon mustard",
    "1 teaspoon white sugar",
    "0.25 cup slivered almonds",
    "0.25 cup dried cranberries",
    "salt and ground black pepper to taste",
    "1 pinch celery salt, or more to taste"
  ],
  "steps": [
    {
      "text": "Mix turkey, mayonnaise, sweet relish, Dijon mustard, and sugar together in a bowl. Fold in almonds and cranberries. Season with salt, pepper, and celery salt. Chill for at least 1 hour before serving.",
