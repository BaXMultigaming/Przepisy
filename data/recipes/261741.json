  "ingredients": [
    "1 cooking spray",
    "2 cups fresh blueberries",
    "2 cups all-purpose flour",
    "1 cup lightly packed brown sugar",
    "0.5 cup unsweetened applesauce",
    "0.5 cup soy milk",
    "0.25 cup soy margarine",
    "1 tablespoon baking powder",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 12 cups of a mini muffin tin with paper liners or spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix blueberries, flour, sugar, applesauce, soy milk, soy margarine, baking powder, vanilla extract, and salt together in a bowl. Spoon batter into muffin cups, filling them 3/4-full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are firm, about 35 minutes. Cool slightly on a rack.",
