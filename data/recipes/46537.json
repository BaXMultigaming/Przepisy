  "ingredients": [
    "4 pork chops",
    "salt and pepper to taste",
    "2 onions, sliced into rings",
    "2 sweet potatoes, sliced",
    "2 apples - peeled, cored, and sliced into rings",
    "3 tablespoons brown sugar",
    "2 teaspoons freshly ground black pepper",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season pork chops with salt and pepper to taste, and arrange in a medium oven safe skillet. Top pork chops with onions, sweet potatoes, and apples. Sprinkle with brown sugar. Season with 2 teaspoons pepper and 1 teaspoon salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and bake 1 hour in the preheated oven, until sweet potatoes are tender and pork chops have reached an internal temperature of 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
