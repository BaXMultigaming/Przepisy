    "8 ounces fresh mushrooms, finely chopped",
    "1 onion, finely chopped",
    "2 tablespoons soy sauce",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon black pepper",
    "0.25 cup crumbled blue cheese"
