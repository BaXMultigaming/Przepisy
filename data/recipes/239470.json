  "title": "Easy Red Bean Ice Cream",
  "description": "Red bean ice cream is a popular dessert in Asian countries. Canned sweetened red beans can be substituted for some red bean paste to add texture.",
  "authors": [
    "bobapanda"
  ],
  "date_published": "2020-06-19T00:00:52-04:00",
