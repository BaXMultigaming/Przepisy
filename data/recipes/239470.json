  "ingredients": [
    "3 egg yolks",
    "0.5 cup white sugar",
    "1 cup milk",
    "1.5 cups sweetened red bean paste",
    "1.5 cups heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Beat egg yolks and sugar together in a large bowl until pale yellow.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring milk to a boil in a saucepan. Remove from heat. Slowly stream milk into egg mixture while whisking until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue to cook, stirring constantly, until thickened but not boiling, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir red bean paste into thickened milk mixture. Transfer to a large bowl and let cool for several minutes. Stir cream into the slightly cooled mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl with plastic wrap and refrigerate until ice cream base is chilled completely, 1 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Churn custard in an ice cream maker according to manufacturer's directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
