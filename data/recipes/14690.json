  "ingredients": [
    "2 pounds ground beef",
    "3.5 pounds chopped cabbage",
    "1 (29 ounce) can tomato sauce",
    "1 cup chopped onion",
    "1 cup uncooked white rice",
    "1 teaspoon salt",
    "2 (14 ounce) cans beef broth"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C) and gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K4aIpjhDWHe3HCtEHEKcQD8UPo8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14690-CabbageRollCasserole-mfs-Step1-1250-ad7c28f1dc6b44c2bdc76f3c0e576e47.jpg"
      ],
      "image": "assets/images/14690/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cabbage, tomato sauce, onion, rice, and salt in a large mixing bowl. Stir in cooked ground beef. Pour mixture into a 9x13-inch baking dish, then pour beef broth over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mJJ_O9OQAhT1j0H_VByAkMZxFYE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14690-CabbageRollCasserole-mfs-Step2-1257-65eb502754414b7cb52aefaae3d4c13e.jpg"
      ],
      "image": "assets/images/14690/step_03.webp"
    },
    {
      "text": "Cover and bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pG-bbaqNxM4JVMv9YLuqsIfYXaA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14690-CabbageRollCasserole-mfs-Step3-1258-8c979174eb5b4dfca86c5b23adf85b68.jpg"
      ],
      "image": "assets/images/14690/step_04.webp"
    },
    {
      "text": "Stir, re-cover, and bake until cabbage is tender and rice is done, 20 to 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VnYTvhguJ7-DYny8-gj0-FcMOKQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14690-CabbageRollCasserole-mfs-Step-4-1260-e746df1055ef44278b5f9d28c8237b10.jpg"
      ],
      "image": "assets/images/14690/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Xx7Gd-8KMLrvnE20necZNiF2MKI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14690-Cabbage-Roll-Casserole-PICS-Beauty-4x3-a25dd263c023469e97ad501683f582c5.jpg"
      ],
      "image": "assets/images/14690/step_06.webp"
    }
