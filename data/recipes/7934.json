  "ingredients": [
    "1 cup graham cracker crumbs",
    "0.25 cup melted butter",
    "2 tablespoons white sugar",
    "2 (8 ounce) packages cream cheese, softened",
    "1 cup sour cream",
    "0.75 cup white sugar",
    "2 tablespoons all-purpose flour",
    "1 teaspoon vanilla extract",
    "4 large eggs",
    "2 cups frozen blueberries, dry pack",
    "0.33333334326744 cup blueberry jelly"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degree F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix graham crumbs, melted butter, and 2 tablespoons sugar in a bowl until well combined. Pat mixture into the bottom of a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vBxBkoFmEMHumDNAznYTQxkWsmE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7934-Blueberry-Cheesecake-ddmfs-107-step2-1f13d9e274b04bf49437f0e2ff790196.jpg"
      ],
      "image": "assets/images/7934/step_02.webp"
    },
    {
      "text": "Mash cream cheese in a mixing bowl until soft and creamy. Gradually beat in sour cream, 3/4 cup sugar, flour, and vanilla. Beat in eggs, one at a time. Pour mixture onto crumb crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v3K1p3pQS2CEtF5_KLh0JJcndpI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7934-Blueberry-Cheesecake-ddmfs-111-step6-9077b06fea90417b996230b6b4457e04.jpg"
      ],
      "image": "assets/images/7934/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until firm to the touch, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place baked cheesecake in the refrigerator until thoroughly chilled, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cheesecake from the pan by loosening the edges with a knife and opening the springform latch; transfer to a serving platter. Place frozen blueberries on top. Melt jelly in a saucepan over low heat; spoon over blueberries to glaze. Chill in the refrigerator until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/43p4HHEO0mivYXMhkCohNVEbpfY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7934-Blueberry-Cheesecake-ddmfs-107-step10-f727cf3dce8e43deb43a2aa8b6ed2fc5.jpg"
      ],
      "image": "assets/images/7934/step_06.webp"
    }
