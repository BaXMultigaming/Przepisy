  "ingredients": [
    "8 medium potatoes, peeled and sliced",
    "1 medium onion, sliced",
    "1 (14.75 ounce) can salmon, drained and flaked",
    "4 tablespoons all-purpose flour, or more as needed",
    "0.5 teaspoon salt, or to taste",
    "0.5 teaspoon ground black pepper",
    "1 cup milk",
    "2 teaspoons salted butter, cut into small pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place one layer of potato and onion slices in the prepared dish. Add salmon. Sprinkle flour over top until salmon layer is covered. Sprinkle with 1/2 of the salt and pepper. Layer with remaining onion and potato slices, then sprinkle with remaining salt and pepper. Add milk and top with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, covered, in the preheated oven until golden brown, about 1 hour and 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
