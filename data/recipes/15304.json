  "ingredients": [
    "2 cups packed brown sugar",
    "4 eggs, beaten",
    "0.5 cup all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking powder",
    "4 cups chopped black walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat eggs and sugar together until well blended. Sift together the flour, salt and baking powder, gradually add to the egg mixture. Stir in the nuts until they are evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoonfuls onto the prepared cookie sheet. Bake for 10 to 12 minutes in the preheated oven. Allow cookies to cool before removing from cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
