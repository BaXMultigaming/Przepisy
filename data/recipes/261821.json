  "ingredients": [
    "2 tablespoons ground flax seeds",
    "0.66666668653488 cup water, divided",
    "1.5 cups all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.75 cup vegan chocolate chips",
    "3 tablespoons coconut oil",
    "0.75 cup white sugar",
    "1 teaspoon vanilla extract",
    "0.5 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground flax seeds with 1/3 cup water in a bowl; let sit until thickened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cocoa powder, baking powder, and salt into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate chips and coconut oil in a microwave-safe glass or ceramic bowl in 15-second intervals, stirring after each melting, 1 to 2 minutes. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat flax seed mixture, remaining 1/3 cup water, sugar, and vanilla extract in a bowl with an electric mixer until creamy, about 3 minutes. Add flour mixture and melted chocolate; mix until well combined. Shape dough into 1-inch balls. Roll in confectioner's sugar and place on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm to the touch, 11 to 13 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
