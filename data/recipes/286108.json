  "ingredients": [
    "2 cups fresh strawberries, hulled",
    "2.25 teaspoons cornstarch",
    "2 tablespoons cold water",
    "0.25 cup white sugar",
    "0.5 tablespoon unsalted butter",
    "1 teaspoon lemon juice"
  ],
