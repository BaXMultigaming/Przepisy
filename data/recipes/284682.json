  "ingredients": [
    "1 bunch Swiss chard",
    "2 tablespoons olive oil",
    "2 cloves garlic, minced",
    "1 pinch red pepper flakes",
    "salt to taste",
    "1 squeeze fresh lemon juice"
  ],
  "steps": [
    {
      "text": "Remove Swiss chard stems and cut into small pieces. Slice leaves into strips. Set both aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet and saute chard stems for 3 to 5 minutes. Add garlic and red pepper flakes; cook until fragrant, about 30 seconds. Mix in chard leaves, cover, and cook until wilted, about 2 minutes. Uncover, stir and cook for 2 minutes longer. Season with salt and squeeze lemon juice on top.",
