  "ingredients": [
    "2 eggs",
    "0.5 cup sour cream",
    "0.5 cup milk",
    "2 tablespoons butter, melted",
    "2 tablespoons all-purpose flour",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 cup imitation crab meat",
    "1 cup shredded Swiss cheese",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, sour cream, milk, butter, flour, salt, and black pepper in a bowl until thoroughly combined; gently stir imitation crabmeat and Swiss cheese into the egg mixture. Spread the filling into the pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake quiche in the preheated oven until a knife inserted into the filling comes out clean, 40 to 45 minutes.",
