  "ingredients": [
    "4 pounds apples, coarsely chopped",
    "0.5 cup brown sugar",
    "0.25 cup apple cider vinegar",
    "4 teaspoons ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Stir chopped apples, brown sugar, apple cider vinegar, cinnamon, cloves, and salt together in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until the apples are soft enough to mash easily with a fork, 8 to 10 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree apple mixture with an immersion blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook uncovered until some of the liquid reduces and the color is dark brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
