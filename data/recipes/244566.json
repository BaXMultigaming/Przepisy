  "ingredients": [
    "4 cups fresh cut up vegetables (broccoli, celery, peppers, carrots)",
    "1.75 cups Swanson® Chicken Broth or Swanson® Certified Organic Chicken Broth or Swanson® Natural Goodness® Chicken Broth",
    "2 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Bring vegetables, broth, and garlic to a boil in a 3-quart saucepan over medium-high heat. Reduce heat to low; cover, and cook until vegetables are crisp-tender, about 5 minutes. Drain vegetables well in a colander.",
