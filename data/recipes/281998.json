  "ingredients": [
    "2.5 cups finely crushed buttery crackers (such as Ritz®)",
    "0.5 cup unsalted butter, melted",
    "1.25 cups milk",
    "2 (3.4 ounce) packages instant coconut cream pudding mix",
    "0.5 gallon vanilla ice cream, softened",
    "1 (8 ounce) container frozen whipped topping (Cool Whip®), thawed"
  ],
  "steps": [
    {
      "text": "Combine 1 1/2 cups cracker crumbs and melted butter in a bowl. Mix until evenly moistened; press into the bottom of a 9x13 glass or foil pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk and pudding mixes in a large bowl; stir in softened ice cream. Pour over crust. Top with whipped topping and remaining 1 cup cracker crumbs. Cover and freeze, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the freezer; allow to thaw. Cut into 12-24 pieces depending on crowd.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
