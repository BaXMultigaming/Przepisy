  "title": "Crispy Baked Chicken",
  "description": "Chicken breasts are coated with seasoned fresh bread crumbs and Parmesan cheese and baked to a crispy golden brown in this quick and easy dish.",
  "authors": [
    "mxDOc"
  ],
  "date_published": "2016-06-04T10:04:33-04:00",
