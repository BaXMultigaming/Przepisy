  "ingredients": [
    "2 slices bread",
    "1 cup grated Parmesan cheese",
    "2 teaspoons dried oregano",
    "1.5 teaspoons dried basil",
    "1.5 teaspoons minced garlic",
    "0.5 cup grated Parmesan cheese",
    "2 tablespoons vegetable oil",
    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread into a food processor and blend until crumbled. Transfer bread crumbs to a shallow bowl. Add 1 cup Parmesan cheese, oregano, basil, and garlic; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press chicken breast halves into bread crumb mixture until coated; arrange on a large baking dish. Drizzle chicken with vegetable oil and sprinkle with remaining 1/2 cup Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken breasts are no longer pink in the center and the juices run clear, about 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
