  "ingredients": [
    "1 pound fresh asparagus, trimmed and cut into 2 inch pieces",
    "2 tablespoons butter",
    "1 clove garlic, minced",
    "1 pint light cream",
    "1 pound linguine pasta",
    "1 lemon, juiced"
  ],
  "steps": [
    {
      "text": "Bring a medium pot of water to a boil. Cook asparagus in boiling water until bright green and slightly crisp, 3 to 4 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Sauté asparagus and garlic in hot butter for 3 to 4 minutes. Stir in cream and simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of water to a boil. Cook linguine in boiling water until tender yet firm to the bite, 8 to 10 minutes; drain and transfer to a serving dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir lemon juice into asparagus mixture; pour mixture over hot pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
