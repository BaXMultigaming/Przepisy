  "ingredients": [
    "1 recipe pastry for a 9 inch double crust pie",
    "4 cups diced rhubarb",
    "3 cups sliced fresh strawberries",
    "1.5 cups white sugar",
    "6 tablespoons quick-cooking tapioca",
    "1 teaspoon orange zest",
    "1 tablespoon milk",
    "1 tablespoon white sugar for decoration",
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "1 teaspoon salt",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a 9-inch pie plate with 1 pastry crust. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together rhubarb, strawberries, 1 ½ cups sugar, tapioca, and orange zest until well combined; spoon into crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out remaining pastry on a lightly floured surface and place over rhubarb mixture. Seal the edges, brush the top crust with milk, then sprinkle with 1 tablespoon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Reduce the heat to 350 degrees F (175 degrees C) and bake for 35 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
