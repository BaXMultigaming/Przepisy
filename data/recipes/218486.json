  "ingredients": [
    "0.5 cup soy sauce",
    "0.33333334326744 cup vegetable oil",
    "0.25 cup lemon juice",
    "1 clove garlic, minced",
    "1 tablespoon prepared mustard",
    "1 tablespoon Worcestershire sauce",
    "1.5 teaspoons salt",
    "1 teaspoon coarsely cracked black pepper",
    "1.5 pounds lean beef, cut into 1-inch cubes",
    "16 mushroom caps",
    "8 metal skewers, or as needed",
    "2 green bell peppers, cut into chunks",
    "1 red bell pepper, cut into chunks",
    "1 large onion, cut into large squares"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8eS2QJXcJ9gkCi07a03dQmBREzc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-218486-moms-shish-kabobs-DDMFS-step-1-8759fd0c49a74a638eb441815c95e799.jpg"
      ],
      "image": "assets/images/218486/step_01.webp"
    },
    {
      "text": "Whisk soy sauce, vegetable oil, lemon juice, garlic, mustard, Worcestershire sauce, salt, and black pepper together in a bowl; pour into a resealable plastic bag. Add beef cubes and squeeze out excess air; seal the bag. Marinate in the refrigerator 8 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tawJQ_YuhdrDWt6T1iVO7l0b_yA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-218486-moms-shish-kabobs-DDMFS-step-2-88bb91f4e7f04907b1478b140086e782.jpg"
      ],
      "image": "assets/images/218486/step_02.webp"
    },
    {
      "text": "Add mushrooms to the bag; squeeze out excess air and reseal the bag. Marinate in the refrigerator another 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8av5ebUbR7Wyq-xwS0vdjRfGkdA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-218486-moms-shish-kabobs-DDMFS-step-3-2990351064614e6988c8f1ecec9c1f26.jpg"
      ],
      "image": "assets/images/218486/step_03.webp"
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate. Remove beef and mushrooms from the marinade, shaking off any excess liquid. Pour the marinade into a small saucepan and bring to a boil over high heat. Reduce heat to medium-low and simmer for 10 minutes; set aside for basting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8f5LPOawZvP-LYE2ifcg9UOL6h0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-218486-moms-shish-kabobs-DDMFS-step-5-14616779e76f45dea42e51a67292868a.jpg"
      ],
      "image": "assets/images/218486/step_04.webp"
    },
    {
      "text": "Thread pieces of green bell pepper, beef, red bell pepper, mushroom, and onion onto metal skewers, repeating until all ingredients are skewered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UWJ2w-WrOrcZ4qy-xMDq8-Ei_RI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-218486-moms-shish-kabobs-DDMFS-step-4-ce7e97b09738458fb0274fd1f27dfebf.jpg"
      ],
      "image": "assets/images/218486/step_05.webp"
    },
    {
      "text": "Cook the skewers on the preheated grill, turning frequently and brushing generously with the marinade you prepared for basting until nicely browned on all sides and beef is no longer pink in the center, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ovn4BAPE3vj3OWitUS68HDm2NPk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-218486-moms-shish-kabobs-DDMFS-step-5-1-f77d507072924f9e94e53c7dcb57424f.jpg"
      ],
      "image": "assets/images/218486/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pOCGu4LXvpyFkpFszjznPjb-U7c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-218486-moms-shish-kabobs-DDMFS-4x3-e0da583e61534d65bfc76007c1f7631a.jpg"
      ],
      "image": "assets/images/218486/step_07.webp"
    }
