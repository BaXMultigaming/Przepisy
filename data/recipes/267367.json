  "ingredients": [
    "2 packets CARNATION BREAKFAST ESSENTIALS® Rich Milk Chocolate High Protein Powder Drink Mix",
    "cooking spray",
    "0.75 cup milk",
    "0.33333334326744 cup brown sugar",
    "1 egg",
    "3 tablespoons canola oil",
    "1 teaspoon vanilla extract",
    "2 cups baking mix (such as Bisquick ®)",
    "1 cup miniature semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 12-cup muffin tin with paper liners; coat liners with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chocolate drink powder into the milk. Stir until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, egg, oil, and vanilla extract together until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chocolate milk to egg mixture and stir to combine. Add baking mix and mix well. Fold in chocolate chips. Spoon batter evenly into muffin cups, filling nearly to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until a toothpick comes out with only moist crumbs attached, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
