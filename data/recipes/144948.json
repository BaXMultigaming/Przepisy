  "ingredients": [
    "1 (8 ounce) package seashell pasta",
    "1 cup mayonnaise",
    "0.25 cup sour cream",
    "1.5 tablespoons lemon juice",
    "1.5 tablespoons Dijon mustard",
    "0.25 cup chopped fresh dill weed",
    "0.25 teaspoon ground black pepper",
    "2 (4 ounce) cans small shrimp, drained",
    "0.5 cup chopped celery",
    "0.5 cup chopped seeded cucumber",
    "2 tomatoes, diced",
    "3 tablespoons minced shallot",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until tender, about 8 minutes. Drain and rinse under cold running water to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise, sour cream, lemon juice, mustard, dill, and black pepper in a serving bowl. Gently stir in cooled pasta, shrimp, celery, cucumber, tomatoes, and shallots. Mix in salt to taste and refrigerate for at least 2 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
