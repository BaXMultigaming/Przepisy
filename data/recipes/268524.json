  "ingredients": [
    "2 pounds shredded Cheddar cheese",
    "1 (16 ounce) container sour cream",
    "3 tomatoes, diced",
    "0.5 cup mayonnaise",
    "1 (4 ounce) can diced jalapeno peppers",
    "1 pound ground hot Italian sausage",
    "1 lime, juiced",
    "1 (1 ounce) package taco seasoning"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Cheddar cheese, sour cream, tomatoes, mayonnaise, and jalapeno peppers in a medium bowl and mix until well blended. Pour into an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until melted, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook and stir sausage in a hot skillet until browned and crumbly, 5 to 7 minutes. Drain excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cooked sausage, lime juice, and taco seasoning into the hot cheese mixture. Serve immediately or keep warm in a small slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
