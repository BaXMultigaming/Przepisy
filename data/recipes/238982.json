  "ingredients": [
    "1 (15 ounce) can black beans, rinsed and drained",
    "0.66666668653488 cup honey",
    "0.33333334326744 cup cocoa powder",
    "0.33333334326744 cup coconut oil",
    "2 eggs",
    "0.5 teaspoon baking powder",
    "0.125 teaspoon salt",
    "0.5 (8 ounce) package semi-sweet chocolate chips",
    "1 (1.5 ounce) bar milk chocolate candy bar, chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree black beans, honey, cocoa powder, coconut oil, eggs, baking powder, and salt in a food processor until smooth; pour into a baking dish. Stir chocolate chips into black bean mixture and sprinkle chopped chocolate over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is dry and the edges have started to pull away from the sides of the pan, about 35 minutes. Let cool at least 10 minutes before cutting.",
      "section": null,
