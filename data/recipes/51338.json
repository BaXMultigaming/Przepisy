  "ingredients": [
    "2 tablespoons olive oil",
    "1.6666666269302 cups cubed butternut squash",
    "1 large onion, chopped",
    "salt and pepper to taste",
    "8 ounces uncooked penne pasta",
    "0.5 pound turkey sausage",
    "0.25 cup heavy cream",
    "2 teaspoons dried sage",
    "3 cloves garlic, minced",
    "3.5 tablespoons balsamic vinegar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Coat a roasting pan with the olive oil. Place the squash and onion in the pan, and season with salt and pepper. Roast 30 minutes, or until squash is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Place penne pasta in the pot, cook for 8 to 10 minutes, until al dente, and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet over medium heat, cook the turkey sausage until evenly brown. Transfer the cooked squash and onion and the cooked pasta to the skillet. Gradually pour in the cream. Season with sage. Continue cooking until heated through. Mix in garlic. Transfer to a large bowl, and toss with balsamic vinegar to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
