  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "1 (8 ounce) container cold pack aged sharp Cheddar cheese (such as MacLaren's Imperial Sharp Cold Pack Cheddar Cheese product)",
    "0.25 cup finely chopped red onion",
    "1 tablespoon Worcestershire sauce",
    "2 teaspoons freshly ground black pepper",
    "1 teaspoon paprika",
    "1 dash hot sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Place cream cheese and cold pack Cheddar cheese in a microwave-safe bowl; slice cheese into chunks with a knife. Microwave cheese in 30-second intervals on high just until softened, stirring between intervals.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir red onion, Worcestershire sauce, black pepper, paprika, and hot sauce into cheese mixture with a fork until evenly combined; spoon into an airtight container and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cheese spread from refrigerator about 30 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
