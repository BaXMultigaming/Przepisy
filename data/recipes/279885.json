  "ingredients": [
    "1.5 pounds russet potatoes, unpeeled",
    "cooking spray",
    "2 tablespoons vegetable oil",
    "1 teaspoon chili powder",
    "1 teaspoon ground cumin",
    "0.5 teaspoon paprika",
    "0.5 teaspoon ground coriander",
    "0.25 teaspoon garlic powder",
    "0.125 teaspoon ground cinnamon",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Cut potatoes into 8 equal wedges, keeping them under 5 inches long to avoid breaking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potato wedges in a bowl with hot tap water and soak for about 10 minutes. Remove potatoes from the water, rinse, and pat dry with a paper towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C). Spray the air fryer basket with cooking oil spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add potatoes to a large bowl and drizzle with oil. Combine chili powder, cumin, paprika, coriander, garlic powder, and cinnamon in a bowl and sprinkle over potatoes; toss well. Transfer potatoes to the air fryer basket without overcrowding. Cook in 2 batches if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry for 10 minutes. Open air fryer and use tongs to carefully flip the wedges. Cook until crispy and golden brown, 10 to 15 minutes more. Season with salt and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
