  "ingredients": [
    "2 cups all-purpose flour",
    "4 tablespoons instant hot chocolate mix",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1.75 cups white sugar",
    "0.5 cup butter",
    "0.5 cup olive oil",
    "2 eggs",
    "0.5 cup sour milk",
    "1 teaspoon vanilla extract",
    "2.5 cups grated zucchini",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour 18 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, hot chocolate mix, baking soda, salt, cinnamon, and nutmeg in a bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, and olive oil together in a large bowl until light and fluffy. Beat in eggs, one at a time; stir in sour milk and vanilla extract. Beat in flour mixture just until incorporated; stir in zucchini and chocolate chips. Pour batter into the prepared cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 25 to 30 minutes. Cool in tins on a wire rack for at least 10 minutes before removing from cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
