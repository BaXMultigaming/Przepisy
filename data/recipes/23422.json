  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "2 teaspoons baking soda",
    "2 teaspoons baking powder",
    "1 cup unsweetened cocoa powder",
    "1 pinch salt",
    "0.67 cup shortening",
    "2 cups boiling water",
    "2 eggs, beaten",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan. Sift together the flour, sugar, baking soda, baking powder, cocoa and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the shortening in the boiling water, then stir into the flour mixture until blended. Beat in the eggs, then stir in the vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into prepared pan. Bake in the preheated oven for 30 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
