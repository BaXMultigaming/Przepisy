  "title": "Best Carrot Cake Cupcakes",
  "description": "These carrot cake cupcakes are much easier to make than the classic cake and topped with a lemony cream cheese frosting for a special Easter treat.",
  "authors": [
    "McCormick Spice"
  ],
  "date_published": "2020-06-19T00:06:08-04:00",
  "date_modified": "2026-08-10T17:09:29-04:00",
