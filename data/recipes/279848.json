  "ingredients": [
    "3 cups cooked shredded chicken",
    "2 cups cooked chopped broccoli",
    "2 (10.5 ounce) cans condensed cream of chicken soup",
    "0.5 cup sour cream",
    "1 pinch ground black pepper to taste",
    "2.5 cups shredded Cheddar cheese",
    "1.5 cups bread crumbs",
    "0.25 cup salted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chicken, broccoli, condensed soup, sour cream, and pepper in a bowl. Mix in 1 cup Cheddar cheese. Pour into a 2-quart casserole dish and top with remaining Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs and butter in a bowl. Sprinkle over casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and cheese is melted, 30 to 35 minutes.",
