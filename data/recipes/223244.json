  "ingredients": [
    "1 pound small cucumbers, peeled and thinly sliced",
    "salt to taste",
    "1 bunch dill, chopped",
    "2.5 tablespoons sour cream",
    "1 teaspoon lemon juice",
    "1 pinch white sugar, or to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place cucumbers into a colander and sprinkle generously with salt; let stand until soft, about 5 minutes. Squeeze liquid from cucumbers and transfer to a bowl with dill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sour cream, lemon juice, and sugar together in a bowl; add to cucumbers and toss to coat. Season with pepper. Cover and chill for at least 30 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
