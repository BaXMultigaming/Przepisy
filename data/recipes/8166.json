  "ingredients": [
    "2.75 cups all-purpose flour",
    "3 teaspoons baking powder",
    "1 teaspoon salt",
    "1.5 cups white sugar",
    "0.66666668653488 cup unsalted butter, softened",
    "0.75 cup Champagne",
    "6 large egg whites"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 10-inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and salt together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter with an electric mixer in a large bowl until very light and fluffy. Mix in flour mixture alternately with Champagne.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until stiff peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold 1/3 of the egg whites into cake batter to lighten it, then fold in remaining egg whites. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
