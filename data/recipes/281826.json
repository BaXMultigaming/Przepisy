  "ingredients": [
    "nonstick cooking spray",
    "2 large eggs",
    "1 cup milk",
    "0.25 cup vegetable oil",
    "1 tablespoon white sugar",
    "0.25 teaspoon salt",
    "3 teaspoons baking powder",
    "0.5 cup all-purpose flour",
    "0.5 cup whole wheat flour"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat a Belgian waffle iron according to manufacturer's instructions; coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4BIj7M1QyZe3sXy1tESPQAaSh20=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-281826-fluffy-belgian-waffles-VAT-step-01-459a08e71ec44aad92a6703d73725a15.jpg"
      ],
      "image": "assets/images/281826/step_01.webp"
    },
    {
      "text": "Meanwhile, whisk eggs until fluffy. Whisk in milk, oil, sugar, salt, baking powder, all-purpose flour, and whole wheat flour, whisking slightly after each ingredient is added in the exact order; do not over mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0xj9Gy8AnCRYo0-2RQtBNaXou9g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-281826-fluffy-belgian-waffles-VAT-step-02-2-4185a9e29c59404bae28a91fdf2b2dee.jpg"
      ],
      "image": "assets/images/281826/step_02.webp"
    },
    {
      "text": "Pour ¾ cup batter into center of hot waffle iron, spreading with a metal knife if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I2nTc6dL6IpuumXXyTrFrCRXGvQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-281826-fluffy-belgian-waffles-VAT-step-03-205378efb5994eeda4f787fbb5b4e029.jpg"
      ],
      "image": "assets/images/281826/step_03.webp"
    },
    {
      "text": "Close iron; bake until it stops steaming, 2 to 5 minutes, depending on iron. Carefully remove waffle with a fork. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OryPBEciFfZEGYjcsaKTb9wnACE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-281826-fluffy-belgian-waffles-VAT-step-04-a6be4d044fe3403f858f29013edbdd0f.jpg"
      ],
      "image": "assets/images/281826/step_04.webp"
    }
  ],
