  "ingredients": [
    "0.5 cup chopped macadamia nuts",
    "0.25 cup seasoned bread crumbs",
    "1 tablespoon extra virgin olive oil",
    "0.5 teaspoon black pepper",
    "1 pinch red pepper flakes",
    "0.5 mango - peeled, seeded and diced",
    "0.5 cup heavy cream",
    "1 teaspoon lemon juice",
    "1 pound fresh sea bass",
    "salt and ground black pepper to taste",
    "2 cloves minced garlic"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine macadamia nuts, bread crumbs, 1 teaspoon oil, black pepper, and pepper flakes in the bowl of a food processor; pulse until smooth. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mango, cream, and lemon juice in a small saucepan over medium heat; bring to a boil, reduce heat to low, and simmer until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season sea bass with salt and black pepper. Heat remaining 3 teaspoons oil and garlic in a large oven-proof skillet over medium heat. Add sea bass; sear on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer sea bass to the preheated oven; bake until cooked through. Cover sea bass with macadamia crust mixture; return to the oven until crust browns. Top servings with mango cream sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
