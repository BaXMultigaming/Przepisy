  "ingredients": [
    "4 cups water",
    "1 cup pearl onions, peeled",
    "6 tablespoons butter",
    "6 tablespoons all-purpose flour",
    "3 cups milk",
    "1 pinch salt and freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Boil water in a medium saucepan over medium-high heat. Add onions and cook until tender; drain, reserving 2 cups of cooking liquid. Set onions and liquid aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GFeckXM9VQX5bInbrEnVuY3KhlU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9162-moms-traditional-creamed-onions-ddmfs-Step3-0255-ca474a5778be40b1aa6ac7540234c062.jpg"
      ],
      "image": "assets/images/9162/step_01.webp"
    },
    {
      "text": "Melt butter in the same saucepan over medium heat; whisk in flour to make a paste. Whisk milk into reserved cooking liquid; slowly add milk mixture to the saucepan, whisking constantly. Cook until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sDBGlExllP8dwSMDi8NEDTq8jK0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9162-moms-traditional-creamed-onions-ddmfs-Step4-0258-f73252d952a744c99f00ae7de0bf19f1.jpg"
      ],
      "image": "assets/images/9162/step_02.webp"
    },
    {
      "text": "Season with salt and pepper; stir in onions and transfer to a serving dish.",
      "section": null,
      "name": null,
