  "ingredients": [
    "8 large eggs",
    "2 cups milk",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "12 slices French bread",
    "1.3333333730698 cups brown sugar",
    "0.75 cup unsalted butter, softened",
    "3 tablespoons corn syrup",
    "1 cup walnuts, chopped"
  ],
  "steps": [
    {
      "text": "Mix together eggs, milk, vanilla, and cinnamon in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread slices in a greased 9x13-inch dish. Pour egg mixture over the top of bread slices. Cover and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the refrigerator 30 minutes before baking. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together brown sugar, butter, and corn syrup in a medium bowl until creamy and very thick. Spread over bread, then sprinkle with walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
