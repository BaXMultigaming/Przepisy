        "https://www.allrecipes.com/thmb/r9vSn4JgSaZBEb_vRbb3tN8_gGI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/279903_Garlic_BrownSugarChickenThighs_mfs-Step-4-4845ceb15ddf4fef9cbdb75c0f4a6af5.jpg"
