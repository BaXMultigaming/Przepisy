  "ingredients": [
    "2.25 cups all-purpose flour",
    "0.5 cup white sugar",
    "7 tablespoons cold salted butter, cubed",
    "3 tablespoons ice water, or more as needed",
    "1 tablespoon lemon zest",
    "1 small lemon, juiced",
    "0.5 tablespoon pure vanilla extract"
  ],
  "steps": [
    {
      "text": "Sift flour and sugar into a large bowl. Cut in butter with 2 knives or pastry blender until pea-sized.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a well in flour mixture; pour in 3 tablespoons water and lemon zest and carefully fold into flour mixture until lightly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make another well; pour in lemon juice and lightly fold into dough. Repeat with vanilla extract. Add more water if needed to bring dough together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into 2 equal-sized discs; cover in plastic wrap. Chill in the refrigerator before using, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
