  "ingredients": [
    "1 cup all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 cup white sugar",
    "0.5 cup unsalted butter, softened",
    "1 egg",
    "1 teaspoon instant coffee granules",
    "1 teaspoon vanilla extract",
    "1 cup dried cherries",
    "0.25 cup miniature semisweet chocolate chips",
    "0.25 cup white chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 large baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cocoa powder, baking powder, and salt in a medium bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together sugar and butter in a large bowl with an electric mixer on medium-high speed until light and fluffy. Beat in egg, coffee granules, and vanilla until blended. Reduce speed to low and pour in flour mixture; beat until just combined. Stir in dried cherries, semisweet chocolate chips, and white chocolate chips until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are just becoming firm, 10 to 12 minutes. Let cool on the baking sheets for 2 minutes, then transfer cookies to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
