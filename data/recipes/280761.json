  "ingredients": [
    "2 bananas",
    "0.66666668653488 cup applesauce",
    "0.33333334326744 cup peanut butter",
    "1 teaspoon vanilla extract",
    "1.5 cups oats",
    "0.25 cup chopped walnuts",
    "1 scoop protein powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash bananas in a bowl and add applesauce, peanut butter, and vanilla extract. Mash together until well mixed. Add oats, walnuts, and protein powder. Mix until cookie dough comes together. Let sit for 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a tablespoon to scoop dough into 15 medium balls and place 2 inches apart on ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 20 to 30 minutes. Cool on the baking sheet for 1 minute before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
