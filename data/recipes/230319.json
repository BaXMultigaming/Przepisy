  "ingredients": [
    "1 (12 ounce) package fresh cranberries",
    "1 large Bosc pear, peeled and diced",
    "1 cup fresh orange juice",
    "1 cup white sugar",
    "0.25 cup water",
    "2 ounces candied ginger, minced",
    "1 orange, zested",
    "1 cinnamon stick",
    "1 whole star anise pod",
    "0.5 teaspoon garam masala",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine cranberries, diced pear, orange juice, sugar, water, candied ginger, orange zest, cinnamon stick, star anise, garam masala, and salt in a large saucepan over medium-high heat; bring to boil. Reduce heat to medium; simmer, stirring occasionally, until cranberries have softened, 10 to 12 minutes. Remove from heat; cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and discard cinnamon stick and star anise; transfer to an airtight container. Refrigerate until ready to serve.",
