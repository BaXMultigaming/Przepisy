  "ingredients": [
    "0.25 cup vegetable oil",
    "1 onion, chopped",
    "1 tomato, chopped",
    "2 slices habanero pepper",
    "1 garlic clove, chopped",
    "2 tablespoons Jamaican-style curry powder",
    "0.25 teaspoon ground thyme",
    "2 skinless, boneless chicken breast halves, cut into 1 1/2-inch pieces",
    "1 cup water",
    "0.5 teaspoon salt, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ctq1qpL7p3ndRR9w1TOPTfmYTSM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233444-jamaican-style-curry-chicken-DDMFS-012-ingredients-7b587d15989f4c6183aea6c10fce4579.jpg"
      ],
      "image": "assets/images/233444/step_01.webp"
    },
    {
      "text": "Heat vegetable oil in a skillet over medium-high heat. Add onion, tomato, habanero pepper, garlic, curry powder, and thyme and cook, stirring, until onion is golden, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HaHu8M_6CoST_AGE5q49RzSsXS0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233444-jamaican-style-curry-chicken-DDMFS-013-step1-8c4ae894889c48ecb321b5bfc4780062.jpg"
      ],
      "image": "assets/images/233444/step_02.webp"
    },
    {
      "text": "Stir in chicken and cook until chicken is lightly browned, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rBySv-lfuQrUJSBM9Jo0Cr9LoXM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233444-jamaican-style-curry-chicken-DDMFS-015-step3-ea02e431b5b148b890ccb4d030984c4b.jpg"
      ],
      "image": "assets/images/233444/step_03.webp"
    },
    {
      "text": "Pour water into the skillet. Reduce heat to low, cover, and simmer until chicken is no longer pink at the center, about 30 minutes. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9_LkgNK_h2OmyhcJvIEbNOIkiaE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233444-jamaican-style-curry-chicken-DDMFS-017-step4alt-2f84c0fee2e143fba30534e3578d8cc2.jpg"
