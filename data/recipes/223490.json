  "ingredients": [
    "0.5 cup water",
    "0.5 cup white sugar, or to taste",
    "4 cups cubed, seeded watermelon",
    "1 teaspoon chopped fresh mint",
    "0.5 lime, juiced",
    "0.5 teaspoon grated lime zest",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Mix water and sugar in a small saucepan and bring to a boil, stirring to dissolve sugar, about 5 minutes. Remove from heat and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend sugar syrup, watermelon, mint, lime juice, lime zest, and salt in a blender until liquefied, 1 to 2 minutes. Pour the mixture into 10 ice pop molds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Freeze paletas for 2 hours and insert wooden sticks or handles into the molds; return to freezer and freeze until solid, 12 to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
