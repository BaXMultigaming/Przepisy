  "ingredients": [
    "3 large portobello mushrooms",
    "0.25 cup canola oil",
    "0.25 cup balsamic vinegar",
    "3 tablespoons chopped onion",
    "4 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Clean mushrooms; remove stems, reserving them for another use. Place mushroom caps gill-side up in a shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil, balsamic vinegar, onion, and garlic in a small bowl. Pour mixture evenly over mushroom caps; let marinate at room temperature for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill to medium-high heat; grease the grate. Grill over the hot grill until caramelized and tender, about 5 to 8 minutes; serve warm.",
      "section": null,
      "name": null,
      "url": null,
