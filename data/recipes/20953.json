  "ingredients": [
    "4 cups shredded green tomatoes",
    "4 cups white sugar",
    "1 (6 ounce) package raspberry flavored Jell-O® mix"
  ],
  "steps": [
    {
      "text": "Inspect canning jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until jam is ready. Wash new, unused lids and rings in warm soapy water",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomatoes and sugar in a large saucepan; bring to a boil over medium heat. Cook and stir for about 10 minutes. Stir in gelatin until well combined. Reduce heat to low; simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pack jam into hot, sterilized jars and seal. Alternatively, pour into freezer containers and freeze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
