  "ingredients": [
    "1 recipe pastry for a 9 inch single crust pie",
    "1.75 cups crushed buttery round crackers",
    "2 teaspoons cream of tartar",
    "2 tablespoons lemon juice",
    "1 tablespoon lemon zest",
    "2 cups water",
    "2 tablespoons butter",
    "2 cups white sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out half of the pastry and line one 9 inch pie plate. Place the crackers in the prepared crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan, over high heat, bring water, sugar and cream of tartar to a boil and then simmer for 15 minutes. Stir in lemon juice and rind then let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour syrup over the crackers. Dot top with butter or margarine and sprinkle with cinnamon. Roll out remaining pastry and place over pie. Trim, seal and flute edges. Slit top crust to allow steam to escape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 to 35 minutes or until crust is crisp and golden. Let pie cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
