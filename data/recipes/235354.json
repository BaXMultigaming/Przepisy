  "ingredients": [
    "4 pounds potatoes, peeled and cut into chunks",
    "1 cup sour cream",
    "1 (8 ounce) package cream cheese, softened",
    "1 tablespoon salt",
    "0.25 teaspoon ground white pepper",
    "1 clove garlic, crushed",
    "1 tablespoon melted butter",
    "0.5 teaspoon paprika",
    "0.25 cup chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes; drain and transfer potatoes to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash sour cream, cream cheese, salt, white pepper, and garlic into the potatoes with a potato masher to your desired consistency; transfer to a baking dish, cover with plastic wrap and refrigerate 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle melted butter and sprinkle paprika evenly over the top of the potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until hot in the center, about 30 minutes. Garnish with chives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
