  "ingredients": [
    "2 teaspoons salt",
    "2 teaspoons freshly ground black pepper",
    "2 teaspoons garlic powder",
    "1.5 teaspoons paprika",
    "1 teaspoon onion powder",
    "1 teaspoon dried rosemary",
    "0.25 teaspoon cayenne pepper",
    "1 (2 1/2 pound) beef tri-tip roast",
    "0.33333334326744 cup red wine vinegar",
    "0.33333334326744 cup vegetable oil",
    "4 cloves crushed garlic",
    "0.5 teaspoon Dijon mustard"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WtDEceLMyZI5yjhGXeAVRK9lbuE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236992-Santa-Maria-Grilled-Tri-Tip-Beef-DDMFS-0773-4x3-step-01-0a4153f13fd648c9b1cd36dfcf689b4d.jpg"
      ],
      "image": "assets/images/236992/step_01.webp"
    },
    {
      "text": "Stir salt, black pepper, garlic powder, paprika, onion powder, rosemary, and cayenne pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pluDWrX-1C_QXxPSpNBSaJm2eiE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236992-Santa-Maria-Grilled-Tri-Tip-Beef-DDMFS-0781-4x3-step-02-6b1fe722ebae4e95a38ca68809b58862.jpg"
      ],
      "image": "assets/images/236992/step_02.webp"
    },
    {
      "text": "Place tri-tip in a glass baking dish and coat on all sides with spice mixture. Cover the dish with plastic wrap and refrigerate for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0GU1qhXVV_H_QusmVzq43RYRL8s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236992-Santa-Maria-Grilled-Tri-Tip-Beef-DDMFS-0784-4x3-step-03-709b6ca49c1847de976678ab15aad639.jpg"
      ],
      "image": "assets/images/236992/step_03.webp"
    },
    {
      "text": "Combine vinegar, vegetable oil, crushed garlic, and Dijon mustard in a sealable container. Cover the container and shake until ingredients are blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mcjkYQATGiKdhlDkhhKXktISnQE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236992-Santa-Maria-Grilled-Tri-Tip-Beef-DDMFS-0787-4x3-step-04-83eedcff2ac844208308cc02c102661f.jpg"
      ],
      "image": "assets/images/236992/step_04.webp"
    },
    {
      "text": "Remove tri-tip from the refrigerator. Let sit uncovered at room temperature for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat; lightly oil the grates.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tri-tip on the preheated grill and brush with vinegar mixture. Cook for 4 minutes, flip, and baste. Flip and baste every 4 minutes until tri-tip starts to firm up and is reddish-pink and juicy in the center, 25 to 30 minutes total. An instant-read thermometer inserted into the center should read 130 degrees F (54 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GJaVadILtApyAge9Kw2fWateFYE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236992-Santa-Maria-Grilled-Tri-Tip-Beef-DDMFS-0789-4x3-step-05-1-24278cbe0c584ce193309a4e52b89dfb.jpg"
      ],
      "image": "assets/images/236992/step_07.webp"
    },
    {
      "text": "Let rest for at least 10 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0yNL9V-4NLM7q3T1RxOFOCWlafE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236992_SantaMariaGrilledTriTipBeef_MFS_085-4x3-daac0a9ac82d4f42a68e997c09a79f8e.jpg"
      ],
      "image": "assets/images/236992/step_08.webp"
    }
