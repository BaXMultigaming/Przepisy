  "ingredients": [
    "6 medium beets, peeled and cut into chunks",
    "2.5 tablespoons olive oil, divided",
    "1 teaspoon garlic powder",
    "1 teaspoon kosher salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon sugar",
    "3 medium sweet potatoes, cut into chunks",
    "1 large sweet onion, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss beets with 1/2 tablespoon olive oil to coat in a bowl. Spread in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix remaining 2 tablespoons olive oil, garlic powder, salt, pepper, and sugar in a large resealable plastic bag. Place sweet potatoes and onion in the bag. Seal the bag and shake to coat vegetables with the oil mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake beets in the preheated oven for 15 minutes. Mix sweet potato mixture with beets on the baking sheet. Continue baking, stirring after 20 minutes, until all vegetables are tender, about 45 minutes.",
      "section": null,
      "name": null,
