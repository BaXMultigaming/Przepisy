  "ingredients": [
    "1 honeydew melon",
    "6 cups cubed, cooked chicken meat",
    "2 cups chopped celery",
    "2 cups seedless grapes",
    "1 (8 ounce) can sliced water chestnuts",
    "0.5 cup sour cream",
    "0.5 cup plain yogurt",
    "1.5 teaspoons curry powder",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Cut melon in half, and remove seeds. With a melon baller, scoop out melon balls; place in a large salad bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken, celery, and grapes to melon. Add water chestnuts if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix together, sour cream, yogurt, and curry powder. Gently stir into salad. Season with salt and pepper to taste. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
