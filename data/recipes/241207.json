  "ingredients": [
    "3 cups all-purpose flour",
    "1.25 cups milk, or more as needed",
    "1 cup raisins",
    "0.75 cup white sugar",
    "2 tablespoons caraway seeds",
    "1 tablespoon vegetable oil",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8-inch round glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, milk, raisins, sugar, caraway seeds, vegetable oil, baking powder, baking soda, and salt together in a bowl until dough is not wet enough to pour and not dry enough to handle. Add more milk if dough is too dry. Transfer dough to the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
