  "ingredients": [
    "1.5 tablespoons extra-virgin olive oil",
    "1 tablespoon lemon juice",
    "0.25 teaspoon sea salt",
    "0.13 teaspoon freshly ground black pepper",
    "8 ounces fresh asparagus, trimmed and cut into 2 inch pieces",
    "0.5 cup grape tomatoes"
  ],
  "steps": [
    {
      "text": "Whisk olive oil, lemon juice, salt, and pepper together in a large bowl. Add asparagus and grape tomatoes. Stir to combine and let sit for 5 minutes while you preheat the air fryer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the air fryer to 370 degrees F (180 degrees C) for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add asparagus and tomato mixture to the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the air fryer until vegetables are tender, about 4 minutes.",
