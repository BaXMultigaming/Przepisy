  "ingredients": [
    "1 cup raisins",
    "0.5 cup hot water",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 cups quick cooking oats",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 cup packed brown sugar",
    "0.5 cup chopped walnuts",
    "2 eggs",
    "0.75 cup vegetable oil",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Soak raisins in hot water; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, sift flour with soda, salt, and spices. Blend in rolled oats, sugar, and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, beat eggs with a fork and add oil, vanilla, raisins, and water mixture; pour into flour mixture, stirring until well mixed. Drop by rounded spoonfuls 2 inches apart onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 to 13 minutes in the preheated oven, or until the edges are golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
