  "ingredients": [
    "1 pound sugar snap peas, trimmed",
    "3 tablespoons garlic flavored olive oil",
    "0.25 cup low sodium soy sauce",
    "0.25 teaspoon sesame oil",
    "2 drops chili oil",
    "0.25 teaspoon packed brown sugar",
    "2 tablespoons toasted sesame seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven broiler, and move oven rack into the top position.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the snap peas onto a baking pan, drizzle with olive oil and toss to coat. Spread the snap peas out into a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil the snap peas in the preheated oven until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix together the soy sauce, sesame oil, chili oil, brown sugar, and sesame seeds in a large bowl. When the snap peas come out of the oven, toss them immediately with the sauce.",
      "section": null,
      "name": null,
      "url": null,
