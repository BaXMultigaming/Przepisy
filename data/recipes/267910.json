  "ingredients": [
    "1 teaspoon butter, or as needed",
    "1 (6 ounce) container fresh blackberries, or more to taste",
    "0.875 cup milk",
    "2 eggs",
    "0.75 cup all-purpose flour",
    "7 tablespoons white sugar",
    "1 pinch salt",
    "1 tablespoon brown sugar, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9-inch baking dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add blackberries to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk and eggs together in a bowl. Whisk in flour, sugar, and salt and mix until batter is smooth. Pour batter over blackberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven on the middle rack until eggs start to set, about 25 minutes. Sprinkle brown sugar on top and bake until golden brown, about 20 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
