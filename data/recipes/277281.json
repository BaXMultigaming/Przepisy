  "ingredients": [
    "1 pound boneless pork chops",
    "1 (26.5 ounce) can cream of mushroom soup",
    "1 cup diced onions",
    "1 cup sliced fresh mushrooms",
    "1 tablespoon garlic powder"
  ],
  "steps": [
    {
      "text": "Pat pork chops dry and place into a slow cooker. Add mushroom soup, onions, sliced mushrooms, and garlic powder.",
