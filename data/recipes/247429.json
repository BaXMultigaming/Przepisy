  "ingredients": [
    "1.5 cups water",
    "0.66666668653488 cup soy sauce",
    "0.66666668653488 cup white sugar",
    "0.33333334326744 cup sake",
    "1 pound thinly sliced beef",
    "1 (12 ounce) package firm tofu, drained and cut into bite-size pieces",
    "0.5 head Chinese cabbage, cut into bite-size pieces",
    "1 (7 ounce) package yam noodles (shirataki), drained",
    "7 shiitake mushrooms, sliced",
    "1 enoki mustrooms, roots removed",
    "1 green onion (negi), sliced",
    "1 tablespoon vegetable oil",
    "4 eggs"
  ],
  "steps": [
    {
      "text": "Combine water, soy sauce, sugar, and sake in a bowl; set broth aside on the table.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange beef, tofu, cabbage, yam noodles, shiitake mushrooms, enoki mushroom, and green onion on separate plates on the table.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in an electric skillet or a large skillet set over a hot plate on the table. Add beef slices; cook and stir until browned, about 1 minute. Pour in some broth; bring to a boil. Stir in tofu, cabbage, noodles, shiitake mushrooms, enoki mushroom, and green onion; simmer until softened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle cooked sukiyaki mixture into serving bowls. Replenish broth in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crack eggs into separate small bowls; beat lightly. Serve sukiyaki with eggs for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
