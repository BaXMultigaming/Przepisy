  "keywords": [],
  "ingredients": [
    "1.5 cups dried great Northern beans, rinsed",
    "2 cups water",
    "6 slices bacon",
    "1 carrot, chopped",
    "1 stalk celery, chopped",
    "1 onion, chopped",
    "1 potato - peeled and cubed",
    "1 teaspoon Italian-style seasoning",
    "0.125 teaspoon ground black pepper",
    "3 (14.5 ounce) cans low-sodium chicken broth",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Place beans in a large bowl with the water, cover, and soak overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet over medium to medium high heat, fry the bacon until crispy. Drain the bacon fat and crumble the bacon; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a slow cooker, combine the carrot, celery, onion, potato, Italian- style seasoning, ground black pepper, reserved beans and crumbled bacon. Pour the broth over all.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on low setting for 7 1/2 to 9 hours, or until beans are crisp to tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer 2 cups at a time to a blender or food processor and puree until smooth. Return all to slow cooker, add the milk, cover and heat on high for about 10 to 15 minutes, or until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
