  "ingredients": [
    "0.625 cup butter",
    "1 cup packed brown sugar",
    "1 cup all-purpose flour",
    "1 cup rolled oats",
    "1 cup flaked coconut",
    "1 egg",
    "1 teaspoon baking soda",
    "0.5 cup rhubarb jam"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 10-inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter, brown sugar, flour, oatmeal, coconut, egg and baking soda in a bowl and mix well. Put 2/3 of the batter in the prepared pan then spread the rhubarb jam over it. Pat the remaining dough over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a tester inserted in the center comes out clean, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
