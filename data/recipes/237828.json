  "ingredients": [
    "2 egg yolks",
    "1 tablespoon fresh lemon juice",
    "1 tablespoon white wine vinegar",
    "1 teaspoon Dijon mustard",
    "0.75 teaspoon salt",
    "0.125 teaspoon white sugar",
    "1 cup vegetable oil",
    "0.5 cup olive oil"
  ],
  "steps": [
    {
      "text": "Add egg yolks, lemon juice, vinegar, mustard, salt, sugar, vegetable oil, and olive oil to a tall, narrow bowl in the order listed. Set an immersion blender into the mixture and hold it against the bottom of the bowl; pulse until a thick, pale mixture begins to form, about 3 to 6 pulses. Continue blending until smooth and creamy.",
