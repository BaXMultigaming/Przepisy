  "ingredients": [
    "4 cups water",
    "1 cup instant coffee crystals (such as Folgers® Classic Roast)",
    "2 cups light brown sugar",
    "2 cups lightly packed dark brown sugar",
    "1 (750 milliliter) bottle 190 proof grain alcohol (such as Everclear®)",
    "2 teaspoons vanilla extract",
    "1 vanilla bean, split lengthwise and halved"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/csiY-y6hh_c8_dcGgOpnmdL_1e8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_244997_HomemadeKahlua_ddmfs_Step1_3x4_5290-3701a63118674a49971b62451494fdb8.jpg"
      ],
      "image": "assets/images/244997/step_01.webp"
    },
    {
      "text": "Combine water and instant coffee in a medium pot; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hs5hJI3f6D8fJaipIvUVyxFJWl4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_244997_HomemadeKahlua_ddmfs_Step2_3x4_5335-3534ccef68ba4cc590bb772f9181eee1.jpg"
      ],
      "image": "assets/images/244997/step_02.webp"
    },
    {
      "text": "Stir both brown sugars into coffee and reduce the heat to low. Simmer, stirring every 15 minutes, until slightly thickened, about 3 hours. Remove from the heat and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8k9KB7Ff4nwvISDnEYO0h2M_m8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_244997_HomemadeKahlua_ddmfs_Step3_3x4_5346-aed2a21c51c84ba195c9d804a24adb33.jpg"
      ],
      "image": "assets/images/244997/step_03.webp"
    },
    {
      "text": "Pour coffee mixture into a clean, large glass jar. Add grain alcohol, vanilla extract, and vanilla bean. Cover with a tight-fitting lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/koaM6gih7GffyEPx9uiBhufmomg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_244997_HomemadeKahlua_ddmfs_Step7_3x4_5364-e0a9b78a51ad4650af83cdda70c7359c.jpg"
      ],
      "image": "assets/images/244997/step_04.webp"
    },
    {
      "text": "Let sit in a cool, dark place, shaking occasionally, for 4 weeks. Divide into bottles, leaving a piece of vanilla bean in each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p_AAGf9d31JWVsj6yby9q8ifLic=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_244997_HomemadeKahlua_ddmfs_Step8_3x4_5369-64acf80792ba4a35a9ba4cef633faa3d.jpg"
      ],
      "image": "assets/images/244997/step_05.webp"
    }
  ],
