  "ingredients": [
    "0.25 cup low-sodium soy sauce",
    "2 tablespoons Worcestershire sauce",
    "2 tablespoons liquid smoke",
    "2 tablespoons brown sugar",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon meat tenderizer",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon ground paprika",
    "2 pounds beef round steak, cut into thin strips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xYXO0TSbUmn1omn-PSXRQxgV9uw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/142948-DocsBestBeefJerkey-Step1-0359-4x3-cbcd85c9cd7343279a6b9e2183f592f6.jpg"
      ],
      "image": "assets/images/142948/step_01.webp"
    },
    {
      "text": "Prepare the marinade: Combine soy sauce, Worcestershire sauce, liquid smoke, brown sugar, salt, pepper, meat tenderizer, garlic powder, onion powder, and paprika in a glass bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beef strips in a 9x13-inch glass baking dish. Pour marinade over top; toss until evenly coated. Cover and marinate in the refrigerator for 8 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cDGVRAzOro16DcjRA0ih2dJJ0H8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/142948-DocsBestBeefJerkey-Step2-0361-4x3-72964b7d13424761af6c9dfa7a70e86e.jpg"
      ],
      "image": "assets/images/142948/step_03.webp"
    },
    {
      "text": "Remove beef strips from the bowl and place between two pieces of plastic wrap; pound to 1/8-inch thickness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/01gesDJ5muVrwbUilEM2HurdeAI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/142948-DocsBestBeefJerkey-Step4-0378-4x3-76ddbeb77c3d44bcadb9114e72bd0ed2.jpg"
      ],
      "image": "assets/images/142948/step_04.webp"
    },
    {
      "text": "Arrange pounded beef strips in a single layer on the trays of a dehydrator. Dry at the dehydrator's highest setting until jerky is done to your liking, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sfEvJ7GIq49b69B1Cm0zpxcL9Qo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/142948-DocsBestBeefJerky-Step6-0480-4x3-2079a5b0dac94c2982b2ec063fe2de01.jpg"
      ],
