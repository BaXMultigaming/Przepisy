  "ingredients": [
    "4 cups regular rolled oats",
    "1.25 cups white sugar",
    "0.5 cup unsweetened cocoa powder",
    "1 cup butter or margarine, softened",
    "2 (1 ounce) squares unsweetened baking chocolate, melted",
    "2 tablespoons strong coffee",
    "1 teaspoon vanilla extract",
    "0.33333334326744 cup coconut flakes"
  ],
  "steps": [
    {
      "text": "Combine oats, sugar, and cocoa in a bowl. Add butter; mix, using your hands, until makes a thick dough. Mix in chocolate, coffee, and vanilla until thoroughly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place coconut flakes in a small bowl. Pinch off small pieces of dough; roll into balls (about 1 ½ inches). Roll balls in coconut flakes. Balls are ready to eat, or refrigerate to become firmer, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
