  "ingredients": [
    "4 baking (russet) potatoes, sliced into 3/8-inch thick rounds",
    "salt and freshly ground black pepper to taste",
    "1 pinch cayenne pepper, or to taste",
    "1 pinch herbes de provence, or to taste",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper or a silicone baking mat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine potatoes, salt, black pepper, cayenne pepper, and herbes de Provence in a large bowl. Drizzle with olive oil; stir to coat. Arrange potatoes, evenly spaced, onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Flip over each potato slice, then bake for 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue baking and flipping until potatoes are well browned, about 30 minutes. Potatoes should be crispy around the edges but soft in the center.",
      "section": null,
      "name": null,
      "url": null,
