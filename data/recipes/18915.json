  "ingredients": [
    "0.75 cup white sugar",
    "0.75 cup ground dry mustard",
    "0.5 cup distilled white vinegar",
    "0.5 cup dry white wine",
    "3 eggs, beaten"
  ],
  "steps": [
    {
      "text": "In the top of a double boiler, whisk together sugar, mustard, vinegar, wine, and eggs. Cook over simmering water, whisking constantly, for 8 minutes, or until thick. Allow to cool in refrigerator. Store in sealed containers in refrigerator for up to 2 months.",
