  "ingredients": [
    "4 avocados, halved lengthwise and pitted",
    "1 lemon, juiced",
    "0.5 cup cooked small shrimp",
    "0.5 cup frozen petite peas, thawed",
    "0.25 cup black olives, chopped",
    "0.25 cup diced sweet onion",
    "0.25 cup diced celery",
    "1 dash garlic powder",
    "1 dash onion powder",
    "salt and pepper to taste",
    "0.25 cup mayonnaise, or as needed"
  ],
  "steps": [
    {
      "text": "Scoop out meat from each avocado half, and cube. Reserve the peels. Place cubes in a bowl. Sprinkle cubes and inside of peels with lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the bowl with avocado, gently mix the shrimp, peas, olives, onion, and celery. Season with garlic powder, onion powder, salt and pepper. Fold in enough mayonnaise to evenly moisten all ingredients. Spoon the mixture into the reserved peels, and serve within 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
