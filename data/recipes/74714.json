  "ingredients": [
    "1 quart oil for frying",
    "4 summer squash, cut into chunks",
    "1 medium onion, grated",
    "0.66666668653488 cup all-purpose flour",
    "0.66666668653488 cup dry corn muffin mix",
    "2 eggs, beaten",
    "2 teaspoons baking powder",
    "0.75 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep, heavy skillet or deep fryer to 365 degrees F (185 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place squash in a pot with enough water to cover; bring to a boil, and cook until tender, about 10 minutes. Drain, then mash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 cups mashed squash, onion, and eggs in a bowl. Combine flour, muffin mix, baking powder, and salt in a separate bowl; stir in squash mixture until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop fritter mixture by rounded tablespoons into the hot oil; fry until evenly brown and crisp. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
