  "ingredients": [
    "0.75 cup turbinado sugar",
    "0.25 cup cocoa powder",
    "0.5 cup gluten-free all purpose baking flour",
    "1 teaspoon baking powder",
    "0.5 cup egg substitute",
    "0.5 cup coconut oil, melted",
    "1 cup So Delicious® Dairy Free Vanilla Coconut Milk",
    "2 ounces dark chocolate, chopped into small chunks",
    "1 cup mixed frozen berries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees and line a 9 x 9 inch baking pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk together the dry ingredients. Add egg substitute, Vanilla Coconutmilk and melted coconut oil. Gently fold the chocolate and berries into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the pan and bake for 30 to 40 minutes or until a knife comes out clean. Sprinkle with powdered sugar, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
