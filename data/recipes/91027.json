  "ingredients": [
    "1 cup water",
    "0.5 cup sour cream",
    "0.5 cup plain yogurt",
    "0.25 teaspoon white vinegar",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 eggs, beaten"
  ],
  "steps": [
    {
      "text": "In a bowl, mix together water, sour cream, yogurt, and vinegar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour into a separate, large bowl; stir in baking powder, baking soda, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sour cream mixture and eggs to flour mixture; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on a lightly greased waffle iron until golden brown; lift off with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
