  "ingredients": [
    "4 skinless, boneless chicken breasts",
    "0.125 cup olive oil",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon chili powder",
    "1 teaspoon dried basil",
    "1 teaspoon red pepper flakes",
    "1 pinch salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly coat each chicken breast with olive oil. Sprinkle each side of the chicken lightly with garlic powder, onion powder, chili powder, basil, red pepper flakes, salt, and black pepper; rub to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until chicken is no longer pink in the center and the juices run clear, 10 to 15 minutes, flipping each breast only once halfway through cooking time. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
