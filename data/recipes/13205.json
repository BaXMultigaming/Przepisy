  "ingredients": [
    "2 leeks, chopped",
    "1 onion, chopped",
    "2 tablespoons unsalted butter",
    "0.75 cup thinly sliced potatoes",
    "2.3333332538605 cups chicken stock",
    "salt to taste",
    "ground black pepper to taste",
    "1.125 cups heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Heat butter in a large saucepan over medium-low heat: add leeks and onions. Sauté until soft but not browned, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add potatoes and stock; season with salt and pepper to taste. Bring to a boil, reduce heat to low, and simmer gently for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree soup in a blender or food processor until very smooth. Set soup aside to cool; transfer into a bowl or a jug and refrigerate until chilled, at least 4 hours. Gently stir in cream before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
