  "ingredients": [
    "1 (18.25 ounce) package dark chocolate cake mix",
    "1 (3.9 ounce) package instant chocolate pudding mix",
    "1 (16 ounce) container sour cream",
    "3 eggs",
    "0.33333334326744 cup vegetable oil",
    "0.5 cup coffee flavored liqueur",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat cake mix, pudding mix, sour cream, eggs, oil, and coffee liqueur until well blended. Fold in chocolate chips. Batter will be thick. Spoon into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake springs back when lightly tapped, about 1 hour. Cool for 10 minutes in the pan, then turn out onto a wire rack and let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
