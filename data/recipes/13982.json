  "ingredients": [
    "1 tablespoon olive oil",
    "1 onion, chopped",
    "2 cloves crushed garlic",
    "2.5 tablespoons curry powder",
    "2 tablespoons tomato paste",
    "1 (14.5 ounce) can diced tomatoes",
    "1 cube vegetable bouillon",
    "1 (10 ounce) package frozen mixed vegetables",
    "1.5 cups water",
    "salt and pepper to taste",
    "2 tablespoons chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KyezxEJLab57T5XER1Sk3jeXwmE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13982-quick-and-easy-vegetable-curry-VAT-005-step-01-af78f4f1d8a14744999d100689421738.jpg"
      ],
      "image": "assets/images/13982/step_01.webp"
    },
    {
      "text": "Heat oil in a large saucepan over medium heat. Add onion and garlic; cook and stir until golden, about 1 to 2 minutes. Stir in curry powder and tomato paste, cook and stir for 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XWrdgWHxmJp24q2jtj7YNli1YVM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13982-quick-and-easy-vegetable-curry-VAT-006-step-02-9c3ba946620c495fac1e7e872a15f968.jpg"
      ],
      "image": "assets/images/13982/step_02.webp"
    },
    {
      "text": "Stir in tomatoes, vegetable bouillon cube, mixed vegetables, water, salt and pepper to taste. Simmer until vegetables are very soft and tender, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1uo19OpvIFVVzPlYwrGbXWmBgyw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13982-quick-and-easy-vegetable-curry-VAT-007-step-03-d463b355d84842d68574678976160bbd.jpg"
      ],
      "image": "assets/images/13982/step_03.webp"
    },
    {
      "text": "Sprinkle with fresh cilantro and serve.",
      "section": null,
      "name": null,
      "url": null,
