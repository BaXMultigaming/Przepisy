    "3 tablespoons olive oil",
    "1.5 tablespoons grated Parmesan cheese",
    "1 clove garlic, minced",
    "1 teaspoon sea salt",
    "0.5 teaspoon ground black pepper",
    "1 tablespoon lemon juice"
