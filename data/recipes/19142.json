  "title": "Apple Walnut Cake",
  "description": "This delicious cake joins Macintosh apples and chopped walnuts with warming spices such as cinnamon and nutmeg.",
  "authors": [
    "Julia"
  ],
  "date_published": "1998-12-06T13:58:40-05:00",
