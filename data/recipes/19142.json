  "ingredients": [
    "2 cups white sugar",
    "0.5 pound butter",
    "3 eggs",
    "3 cups sifted all-purpose flour",
    "1.5 teaspoons salt",
    "0.5 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.125 teaspoon ground nutmeg",
    "2 teaspoons vanilla extract",
    "1 cup chopped walnuts",
    "3 cups sliced Macintosh apples"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter and flour one 10 inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the butter and sugar. Add eggs one at a time beating well after each addition. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour, salt, baking soda, cinnamon and nutmeg. Add to wet ingredients and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in vanilla, walnuts and apples. Mix well and pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for approximately 1 hour or until toothpick inserted in center comes out clean. Set aside to cool. Slide knife along outer edges to release bottom of tube pan. Slide knife along bottom of tube pan and inner tube to release cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
