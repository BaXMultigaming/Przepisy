  "ingredients": [
    "2 (14 ounce) cans coconut milk",
    "0.75 cup sugar",
    "0.25 teaspoon kosher salt",
    "0.5 cup cornstarch",
    "1 pinch ground cinnamon"
  ],
  "steps": [
    {
      "text": "Stir together coconut milk, sugar, and salt in a saucepan. Spoon 3 to 4 tablespoons coconut milk mixture into a small bowl and stir in cornstarch until dissolved; pour into the saucepan. Bring mixture to a boil while stirring constantly; cook until smooth and thick, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into molds, cover each with plastic wrap, and refrigerate until cold and firm, 3 hours to 2 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Run a thin knife around the edges of each mold; invert onto serving plates. Garnish tops with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
