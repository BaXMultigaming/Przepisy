  "steps": [
    {
      "text": "Peel and slice beets as thinly as possible with a sharp knife or mandoline.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sliced beets, water, apple cider vinegar, and olive oil in a large bowl. Let marinate, at least 10 minutes.",
