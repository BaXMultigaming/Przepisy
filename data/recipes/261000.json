  "ingredients": [
    "0.5 cup soy sauce",
    "0.5 cup white vinegar",
    "0.5 cup water",
    "0.5 cup white sugar",
    "2 tablespoons light corn syrup",
    "1 tablespoon cider vinegar",
    "1.5 teaspoons ground black pepper",
    "1 teaspoon yeast extract spread (such as Marmite®)",
    "0.5 teaspoon sesame oil",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon ground ginger",
    "2 tablespoons cornstarch",
    "1 teaspoon xanthan gum"
  ],
  "steps": [
    {
      "text": "Combine soy sauce, white vinegar, water, sugar, corn syrup, cider vinegar, pepper, yeast extract spread, sesame oil, garlic powder, onion powder, and ginger in a bowl. Mix well and pour sauce into a pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/4 cup sauce into a small bowl. Add cornstarch; mix and add back to the main sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour another 1/4 cup sauce into the bowl; add xanthan gum. Mix and pour through a strainer back in the main sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the pot of sauce over medium heat. Cook, whisking briskly, until gooey and thickened, 6 to 10 minutes. Strain sauce into a container; cover with plastic wrap and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
