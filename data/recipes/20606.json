  "ingredients": [
    "2 tablespoons butter",
    "1 green bell pepper, chopped",
    "1 cup sliced fresh mushrooms",
    "1 cup chicken broth",
    "2 tablespoons all-purpose flour",
    "2.25 cups cooked, cubed chicken breast meat",
    "1 cup sour cream",
    "2 egg yolks",
    "4 teaspoons cooking sherry",
    "1 pimento, chopped",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium-high heat. Add bell pepper and mushrooms; sauté until tender. Stir in broth and flour; cook, stirring, until thickened. Add chicken; cook until heated through. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sour cream, egg yolks, sherry, pimento, salt, and black pepper in a small bowl until well mixed; add to chicken mixture. Cook over medium heat until thoroughly heated through, stirring often.",
      "section": null,
      "name": null,
      "url": null,
