  "ingredients": [
    "4 slices bacon, or more to taste",
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "5 tablespoons shortening",
    "1 cup buttermilk",
    "1 cup grated Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. Let cool enough to handle; crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, and salt in a bowl and cut in shortening until it resembles coarse crumbs. Add buttermilk and stir just enough to form a ball. Fold in crumbled bacon and Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop heaping tablespoonfuls on an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 10 to 12 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
