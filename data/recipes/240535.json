  "ingredients": [
    "2 cups water",
    "1 cup vegetable broth",
    "0.33333334326744 cup red lentils",
    "0.25 cup finely chopped onion",
    "1 jalapeno pepper, seeded and minced",
    "3 cloves garlic, minced, or more to taste",
    "1 cup rainbow quinoa",
    "1.5 teaspoons ground cumin",
    "1 teaspoon curry powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon chili powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon ground coriander",
    "0.25 teaspoon ground cardamom",
    "0.25 teaspoon ground cloves",
    "3 cups chopped kale",
    "0.5 cup frozen peas",
    "1 tablespoon unsalted butter, or more to taste"
  ],
  "steps": [
    {
      "text": "Bring water and broth to a boil in a stockpot; add lentils, onion, jalapeno pepper, and garlic. Cover stockpot, reduce heat to medium, and simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix quinoa, cumin, curry powder, salt, chili powder, cinnamon, black pepper, coriander, cardamom, and cloves into broth mixture; return to a boil. Cover stockpot, reduce heat to medium, and simmer until quinoa is tender, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir kale, peas, and butter into quinoa mixture and return to a boil. Cover stockpot, reduce heat to medium, and cook until kale and peas are tender, about 10 minutes more.",
