  "ingredients": [
    "2 cups tapioca starch",
    "1 teaspoon salt",
    "0.5 cup vegetable oil",
    "0.33333334326744 cup water",
    "0.33333334326744 cup milk",
    "6 ounces shredded Parmesan cheese",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tapioca starch and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring oil, water, and milk to a boil in a saucepan over medium heat until a white foam appears. Pour milk mixture over tapioca starch mixture; stir until well mixed and allow dough to rest for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Parmesan cheese and eggs into dough until well combined. Shape dough into 1 1/2-inch balls and place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until rolls are browned, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
