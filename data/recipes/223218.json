  "ingredients": [
    "8 potatoes, peeled and quartered",
    "2 Kielbasa sausage rings, cut into 2-inch pieces",
    "1 onion, cut into chunks",
    "1 (8 ounce) package baby carrots",
    "4 cloves garlic, crushed",
    "salt and ground black pepper to taste",
    "3 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine potatoes, kielbasa, onion, baby carrots, and garlic in a roasting pan; season with salt and pepper. Toss with olive oil. Cover baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Remove foil; continue baking until potatoes completely cooked, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
