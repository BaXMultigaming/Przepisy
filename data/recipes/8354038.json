  "title": "Irish Beer Cheese Puffs",
  "description": "A trio of Irish ingredients (beer, butter, and sharp Cheddar) all have a hand in making Chef John's easy, cheesy puffs rich and flavorful. Try them at your next party!",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-03-01T09:00:00-05:00",
  "date_modified": "2024-11-30T00:31:56-05:00",
  "prep_time": "PT25M",
  "cook_time": "PT35M",
  "total_time": "PT90M",
  "yield": [
    "12",
    "12 servings"
  ],
  "categories": [
    "Appetizer"
  ],
  "cuisines": [
    "Irish"
  ],
