  "ingredients": [
    "olive oil for brushing",
    "1 tablespoon olive oil",
    "1 teaspoon honey",
    "0.25 teaspoon kosher salt",
    "0.25 teaspoon ground black pepper",
    "1 pound tri-colored baby carrots",
    "1 tablespoon balsamic glaze",
    "1 tablespoon butter",
    "2 teaspoons chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Brush an air fryer basket with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together 1 tablespoon olive oil, honey, salt, and pepper in a large bowl. Add carrots and toss to coat. Place carrots in the air fryer basket in a single layer, in batches, if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the air fryer at 390 degrees F (200 degrees C), stirring once, until tender, about 10 minutes. Transfer warm cooked carrots to a large bowl, add balsamic glaze and butter, and toss to coat. Sprinkle with chives and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
