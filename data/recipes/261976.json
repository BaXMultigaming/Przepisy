  "ingredients": [
    "1 (15.25 ounce) package chocolate cake mix",
    "1 (3.4 ounce) package instant chocolate pudding mix",
    "2 tablespoons cornstarch",
    "0.5 cup vegetable oil",
    "0.25 cup water, or more as needed",
    "1 cup vegan chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, pudding mix, and cornstarch in a large bowl. Mix in oil and 1/4 cup water. Add additional water until batter is moist. Mix in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll batter into balls and arrange on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops split, about 10 minutes. Cool on the baking sheets for 5 minutes before transferring to a cooling rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
