  "title": "Chocolate Chip Banana Muffins",
  "description": "Chocolate chips and cocoa team well with banana in these lovely muffins that are made even more delicious with the addition of vanilla.",
  "authors": [
    "Noni"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
