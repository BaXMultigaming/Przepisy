  "ingredients": [
    "1.5 cups mashed bananas",
    "0.66 cup sunflower seed oil",
    "1 large egg, beaten",
    "1.5 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "2 tablespoons unsweetened cocoa powder",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix banana, oil, egg, and vanilla in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, cocoa, baking powder, and salt in a large bowl. Stir in banana mixture until just blended. Fold in chocolate chips. Spoon batter into the prepared muffin tin, filling 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 to 20 minutes. Remove muffins to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
