  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "2 (20 ounce) cans crushed pineapple, drained",
    "1 (3.4 ounce) package instant vanilla pudding mix",
    "1 (8 ounce) package cream cheese",
    "1 (8 ounce) container frozen whipped topping, thawed",
    "0.5 cup flaked coconut",
    "0.5 cup chopped walnuts",
    "0.5 (10 ounce) jar maraschino cherries"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2ocGCvui1noAA3-gRUbB6y2ADD0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17935-hawaiian-wedding-cake-ii-DDMFS-step-01-0fec2e42d56846688b7592919857bf6b.jpg"
      ],
      "image": "assets/images/17935/step_01.webp"
    },
    {
      "text": "Prepare and bake cake mix according to package directions in a 10x15-inch pan. Remove from oven and allow to cool. Spread drained pineapple on top of cooled cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gU_nOdRSrU-0kyYx1SeU7Ioq0z8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17935-hawaiian-wedding-cake-ii-DDMFS-step-02-6253db5a337348f9956d228b4e3afc1b.jpg"
      ],
      "image": "assets/images/17935/step_02.webp"
    },
    {
      "text": "Prepare pudding as instructed on package and set aside. In a medium bowl, beat cream cheese until smooth; mix in prepared pudding. Fold in whipped topping. Spread evenly over pineapple.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZzX1zqsvNYGu4FsQEONaNMJK-1Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17935-hawaiian-wedding-cake-ii-DDMFS-step-03-df9c9ff6bd4d47e4a1de249d34a7e7a0.jpg"
      ],
      "image": "assets/images/17935/step_03.webp"
    },
    {
      "text": "Sprinkle top with coconut, chopped walnuts, and maraschino cherries. Store in refrigerator until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d1niwJ50DMTKXHZUMTfgQ6DWuYs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17935-hawaiian-wedding-cake-ii-DDMFS-step-04-cfd40a99a1774034a6b368c953c695a3.jpg"
      ],
