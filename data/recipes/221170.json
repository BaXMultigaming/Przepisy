  "steps": [
    {
      "text": "Place cauliflower florets into a large microwave-safe bowl with enough water to just cover the bottom of the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl loosely with waxed paper or a paper towel. Steam in the microwave on high until tender, 4 to 5 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place drained cauliflower into a food processor with goat cheese; purée until completely smooth. Season with black pepper.",
      "section": null,
