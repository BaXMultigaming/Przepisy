  "title": "Spicy Pumpkin Pork Noodles",
  "description": "This incredible Asian-style noodle dish features ground pork, pumpkin, and Korean chile paste.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-10-21T09:00:00-04:00",
