  "ingredients": [
    "1 cup butter, softened",
    "0.66666668653488 cup white sugar",
    "1.25 teaspoons almond extract, divided",
    "2 cups all-purpose flour",
    "0.5 cup seedless raspberry jam",
    "0.5 cup confectioners' sugar",
    "1 teaspoon milk"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7nozbMytQBI2yNBhcsTS5riUq18=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10222-raspberry-and-almond-shortbread-thumbprints-ingredients-2-d0271154c9f04690b7233d1377dd730a.jpg"
      ],
      "image": "assets/images/10222/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and white sugar together in a medium bowl until creamy. Mix in 1/2 teaspoon almond extract. Add flour and mix until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/18mOWqa2EOfZ_fv1rubINuzE_eY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10222-raspberry-and-almond-shortbread-thumbprints-step-02-2-92eae6ace8bb403c85cff057c2926834.jpg"
      ],
      "image": "assets/images/10222/step_03.webp"
    },
    {
      "text": "Form dough into 1 ½-inch balls and place on ungreased cookie sheets about 2 inches apart. Use your thumb to press down and make a dent in the center of each ball, then fill with jam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l-5RSQv6MdUCx3Xlvkf8SIOIQbM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10222-raspberry-and-almond-shortbread-thumbprints-step-03-3-83965174d8b8486f8314416e555f6387.jpg"
      ],
      "image": "assets/images/10222/step_04.webp"
    },
    {
      "text": "Bake in batches the preheated oven until edges are lightly browned, about 14 to 18 minutes; allow to cool on cookie sheet for a few minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oxBuymxXfKXMK6voYPLSz1PqWy4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10222-raspberry-and-almond-shortbread-thumbprints-step-04-78843b560c714484bb81da9301cedc20.jpg"
      ],
      "image": "assets/images/10222/step_05.webp"
    },
    {
      "text": "Mix confectioners' sugar, milk, and remaining 3/4 teaspoon almond extract together in a medium bowl until smooth; drizzle lightly over warm cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l2V389BlSCtdXwdrlgcnIVxUKAE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10222-raspberry-and-almond-shortbread-thumbprints-step-05-fb06e6a5b488466cafe1d71538ef0a53.jpg"
      ],
      "image": "assets/images/10222/step_06.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kLd7vKkzV-zESyP-f8EFdfZoSss=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10222-raspberry-and-almond-shortbread-thumbprints-ingredients-step-vat-hero-4x3-1-4a3e7e1b16314afbb82976b333813a0f.jpg"
