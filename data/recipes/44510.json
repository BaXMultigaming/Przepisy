  "ingredients": [
    "24 (3 inch) unbaked tart shells",
    "2 cups dark brown sugar",
    "0.66666668653488 cup butter, melted",
    "2 eggs, lightly beaten",
    "4 tablespoons heavy cream",
    "2 teaspoons vanilla extract",
    "0.5 cup raisins",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C.) Arrange tart shells on a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together brown sugar, butter, eggs, cream and vanilla. Stir in raisins and pecans. Divide filling into 24 (3 inch) tart shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 16 to 20 minutes, or until filling is set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
