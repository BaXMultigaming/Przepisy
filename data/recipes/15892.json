  "ingredients": [
    "1.5 cups sifted all-purpose flour",
    "1 teaspoon salt",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon ground nutmeg",
    "1 cup white sugar",
    "0.75 cup shortening",
    "1.75 cups quick cooking oats",
    "1 cup mashed bananas",
    "0.5 cup chopped nuts",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, salt, cinnamon, baking soda, and nutmeg together into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and shortening together in a separate large bowl with an electric mixer until light and fluffy. Add oatmeal, banana, nuts, and egg; beat well. Add in flour mixture; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop teaspoonfuls of dough onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges turn lightly brown, about 15 minutes. Cool on a wire rack. Store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
