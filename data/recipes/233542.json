  "ingredients": [
    "3.5 cups water",
    "1.25 cups white vinegar",
    "1 tablespoon white sugar",
    "1 tablespoon sea salt",
    "4 cups cucumber spears",
    "2 cloves garlic, whole",
    "2 heads fresh dill"
  ],
