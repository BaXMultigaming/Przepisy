  "ingredients": [
    "0.75 cup white sugar",
    "1 tablespoon ground cinnamon",
    "2.5 cups all-purpose flour",
    "0.25 cup powdered buttermilk",
    "ground cinnamon",
    "1 teaspoon ground cloves",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon ground nutmeg",
    "white sugar",
    "0.75 cup packed brown sugar",
    "0.5 cup vegetable oil",
    "1 egg",
    "1 cup water",
    "2 cups diced rhubarb, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two 9x5-inch loaf pans with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 tablespoon white sugar and 1 tablespoon cinnamon in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, powdered buttermilk, 2 teaspoons cinnamon, cloves, baking soda, salt, baking powder, and nutmeg together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat ¾ cup white sugar, brown sugar, vegetable oil, and egg together in a large bowl with an electric mixer until smooth and creamy. Add flour mixture in 3 to 4 batches, alternating with water, beating briefly after each addition: stir in rhubarb with last flour addition until flour is mixed in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter between the prepared loaf pans; sprinkle with reserved cinnamon-sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
