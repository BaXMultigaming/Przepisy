      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix self-rising flour and vanilla ice cream together until smooth. Spoon batter in muffin cups, filling them 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
