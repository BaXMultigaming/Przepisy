  "ingredients": [
    "0.75 cup shortening",
    "1 cup packed brown sugar",
    "1 egg",
    "0.25 cup molasses",
    "2.25 cups all-purpose flour",
    "2 teaspoons baking soda",
    "0.25 teaspoon salt",
    "0.5 teaspoon ground cloves",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground ginger",
    "0.33333298563957 cup granulated sugar for decoration"
  ],
  "steps": [
    {
      "text": "Cream the shortening and the brown sugar. Stir in the egg and molasses and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the flour, baking soda, salt, cloves, cinnamon, and ginger. Add the flour mixture to the shortening mixture and mix well. Cover and chill dough for at least 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into balls the size of large walnuts. Roll balls in sugar and place 3 inches apart on the prepared baking sheets. Bake at 350 degrees F (175 degrees C) for 10 to 12 minutes. Let cool for one minute before transferring to a wire rack to continue cooling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
