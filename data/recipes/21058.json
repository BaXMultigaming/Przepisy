  "title": "Bread Pudding with Whiskey Sauce and Fruit",
  "description": "Bread pudding with apples and peaches, spiced with cinnamon and a hint of nutmeg and served warm with a whiskey butter sauce.",
  "authors": [
    "Suzanne"
  ],
  "date_published": "2000-08-29T15:58:32-04:00",
