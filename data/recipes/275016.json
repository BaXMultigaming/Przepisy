  "ingredients": [
    "1 pound white chocolate",
    "1 cup butter",
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "4 eggs",
    "1.5 teaspoons vanilla extract",
    "0.5 teaspoon salt",
    "0.25 cup raspberry jam",
    "0.5 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chocolate and butter in a large microwave-safe bowl. Heat in a microwave oven on high power in 30-second increments, stirring between each, until chocolate is completely melted and blended with butter, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour, sugar, eggs, vanilla extract, and salt to the bowl with the chocolate and whisk until smooth. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dollops of raspberry jam on top and use a knife to swirl into batter. Sprinkle sliced almonds on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, about 25 minutes. Cool completely before slicing, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
