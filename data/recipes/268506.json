  "ingredients": [
    "1 tablespoon butter",
    "0.25 pear, chopped",
    "2 tablespoons chopped walnuts",
    "0.5 teaspoon ground cinnamon, divided",
    "6 ounces caramel-flavored protein shake (such as Premier Protein®)",
    "0.5 cup rolled oats",
    "2 teaspoons pumpkin pie spice",
    "0.5 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Melt butter in a small pan over medium heat. Saute pear, walnuts, and 1/4 teaspoon cinnamon until pear softens, about 5 minutes. Remove from heat and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine protein drink and oats in a small Mason jar. Mix in cooled pear and walnuts. Seal and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pumpkin spice, ginger, and remaining cinnamon to the oats the following morning. Stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
