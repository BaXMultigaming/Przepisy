    "publisher-tested"
  ],
  "ingredients": [
    "6 large turkey wings",
    "2 medium onions, peeled and quartered",
    "1 cup water",
    "8 cups chicken broth, divided",
    "0.75 cup chopped carrots",
    "0.5 teaspoon dried thyme",
    "0.75 cup all-purpose flour",
    "2 tablespoons butter",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EWp8LxN06M4d6UeqOXsgxa2GwhQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76604-make-ahead-turkey-gravy-ingredientlist-f9f6be8a367f4f65a3c0e8ce68be52d0.jpg"
      ],
      "image": "assets/images/76604/step_01.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange turkey wings in a single layer in a large roasting pan; scatter onions over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rxVY1U_2EQFJC0YRV_qWFG8srDQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76604-make-ahead-turkey-gravy-step-02-2-5d8964eead954f47b3a43b9731c6ed31.jpg"
      ],
      "image": "assets/images/76604/step_03.webp"
    },
    {
      "text": "Roast in the preheated oven until wings are browned, about 1 hour 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_0NM7HGNBnC23i4usef39cDQA6Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76604-make-ahead-turkey-gravy-step-03-1-cee900f4d9c94e8087bf230cf2b5a8f2.jpg"
      ],
      "image": "assets/images/76604/step_04.webp"
    },
    {
      "text": "Transfer wings and onions to a 5-quart stockpot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PXlvoFot0JeNOpfn0fW1OavI6mU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76604-make-ahead-turkey-gravy-step-03-2-369edc7099f548a2a92b27d5fa821c1b.jpg"
      ],
      "image": "assets/images/76604/step_05.webp"
    },
    {
      "text": "Add water to the roasting pan and stir, scraping up any brown bits on the bottom of the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kWpVllZdssDflONRHeXR-zvg1h0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76604-make-ahead-turkey-gravy-step-04-2-812910f2a1ac45f2accdfebad9c32566.jpg"
      ],
      "image": "assets/images/76604/step_06.webp"
    },
    {
      "text": "Pour water and pan scrapings into the stockpot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LGpgbYmrQ_kQMAshL1cMIqNgRIU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76604-make-ahead-turkey-gravy-step-04-3-22dc8a1036ac409f9108701211546cbf.jpg"
      ],
      "image": "assets/images/76604/step_07.webp"
    },
    {
      "text": "Stir in 6 cups chicken broth, carrots, and thyme. Set over medium-high heat and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n6InfHpETCGgIhWdYaZVEG5Bg7g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76604-make-ahead-turkey-gravy-step-04-7-79b0ef5a6078424ea17e9f9c233874da.jpg"
      ],
      "image": "assets/images/76604/step_08.webp"
    },
    {
      "text": "Reduce heat to medium-low and simmer, uncovered, for 1 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer wings to a cutting board and let sit until cool enough to handle. Pull off skin and meat. Discard skin and reserve meat for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3x9p_uxy4MCt7ggJKS7lHtzOXX0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76604-make-ahead-turkey-gravy-step-06-3-b5e1ef96925641bc9ee9e82bf20c0ffd.jpg"
      ],
      "image": "assets/images/76604/step_10.webp"
    },
    {
      "text": "Pour contents of the stockpot through a large strainer into a 3-quart saucepan. Press on vegetables in the strainer to extract any remaining liquid; discard vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-UHRoVQGM5izKmPPRD5uIoapGiY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76604-make-ahead-turkey-gravy-step-07-1-40b1c45e454f4f15893ef07bf9bb41e3.jpg"
      ],
      "image": "assets/images/76604/step_11.webp"
    },
    {
      "text": "Skim and discard fat from the turkey broth, then bring to a gentle boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kZHLpyW4aRMbdD-926Owq5YrIPc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76604-make-ahead-turkey-gravy-step-07-3-d9f55f21138341d8b3b990395a58a9a7.jpg"
      ],
      "image": "assets/images/76604/step_12.webp"
    },
    {
      "text": "Whisk flour into the remaining 2 cups chicken broth in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QnAIypcUA4wDMtTHQC870IVyzdw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76604-make-ahead-turkey-gravy-step-08-2-963967f33495461ab3a147293c1cdc17.jpg"
      ],
      "image": "assets/images/76604/step_13.webp"
    },
    {
      "text": "Gradually whisk flour mixture into the simmering turkey broth. Simmer, whisking occasionally, until gravy has thickened, 3 to 4 minutes. Stir in butter and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MDJuKVE885DytL5MJEAsfijbuew=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76604-make-ahead-turkey-gravy-step-08-7-62719170a29e4fcc853eceb850832d95.jpg"
      ],
      "image": "assets/images/76604/step_14.webp"
    },
    {
      "text": "Serve immediately, or cool and store in airtight containers. Refrigerate up to 3 days or freeze up to 3 months.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S5SOFPjgFjbKsUoevjr6CUQNVKM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76604-make-ahead-turkey-gravy-vat-05-4X3-edit-5862ff101d164db3a4b33a05dce403e8.jpg"
      ],
      "image": "assets/images/76604/step_15.webp"
    }
  ],
