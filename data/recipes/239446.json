  "ingredients": [
    "0.75 cup butter",
    "2 cups white sugar",
    "0.75 cup cocoa powder",
    "1 tablespoon vanilla extract",
    "4 eggs, lightly beaten",
    "0.5 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch oven-proof skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a microwave-safe bowl; heat in the microwave until melted, about 30 seconds. Add sugar and cocoa powder to butter and stir. Heat butter-cocoa mixture in the microwave until sugar is dissolved and mixture is smooth, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix vanilla extract into cocoa mixture. Stir in eggs, then add flour and stir until batter is well-mixed. Pour batter into the prepared skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of brownie comes out clean, 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
