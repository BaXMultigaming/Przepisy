  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 medium onion, diced",
    "0.5 teaspoon celery seed",
    "4 cups vegetable broth",
    "1 (16 ounce) package fresh gnocchi",
    "0.5 cup half-and-half",
    "8 slices cooked bacon, crumbled, divided",
    "1 cup shredded sharp Cheddar cheese, divided",
    "2 tablespoons chopped fresh chives",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a soup pot over medium-high heat. Add onion and celery seed. Cook until onion is soft and translucent, about 4 minutes. Pour in broth and bring to a boil. Add gnocchi and cook for 3 minutes. Stir in half-and-half and 1/2 of the bacon. Remove from heat and stir in 3/4 of the Cheddar cheese until melted. Let sit to thicken, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle soup into bowls and top with remaining bacon, Cheddar cheese, and chives. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
