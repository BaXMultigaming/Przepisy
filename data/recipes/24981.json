  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Melt butter in an 8 inch square pan. Stir in graham cracker crumbs, 2 tablespoons sugar and 1/4 teaspoon cinnamon. Pat over bottom and onto sides of dish. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a blender, combine cottage cheese, milk, eggs, flour, lemon juice, vanilla, 2/3 cup sugar and 1/4 teaspoon salt. Blend until smooth. Pour into prepared crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 60 minutes, or until filling is firm. Allow to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
