  "ingredients": [
    "3 eggs",
    "0.75 cup white sugar",
    "1 tablespoon honey, or to taste",
    "0.75 cup all-purpose flour",
    "1 teaspoon baking powder",
    "1 tablespoon green tea powder (matcha)",
    "0.25 cup cold water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs together in a bowl using an electric mixer on medium speed until doubled or tripled in volume, about 7 minutes. Add sugar, honey, flour, baking powder, green tea powder, and water to eggs, in that exact order, beating 15 to 30 seconds after each addition. Pour batter into a 9-inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
