  "ingredients": [
    "4 chicken leg quarters",
    "1 (4.5 ounce) package instant long grain and wild rice",
    "2 cups water",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 (8 ounce) container sour cream",
    "2 cloves garlic, crushed",
    "1 tablespoon minced garlic",
    "1 cup chopped broccoli"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken quarters in a 9x13 inch baking dish and bake in preheated oven, covered, for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in a large bowl combine rice and seasoning packages, water, soup, sour cream, crushed garlic, minced garlic and broccoli. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken to a platter and drain oil. Spread rice mixture in the bottom of the baking dish, then arrange chicken on top of rice. Bake uncovered for 30 to 45 minutes, or until wild rice is opened up and liquid is absorbed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
