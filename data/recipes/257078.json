  "ingredients": [
    "6 slices bacon",
    "2 oranges, peeled",
    "1 (16 ounce) bag fresh spinach leaves",
    "0.5 red onion, thinly sliced",
    "0.5 cup pine nuts",
    "0.33333334326744 cup vegetable oil",
    "0.25 cup orange juice",
    "2 teaspoons white vinegar",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels. Crumble into small pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate oranges into individual wedges. Cut each wedge into thirds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bacon, oranges, spinach, red onion, and pine nuts in a large bowl; toss lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, orange juice, vinegar, and salt together in a small bowl to make dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle some dressing over the spinach mixture; toss to coat. Serve remaining dressing on the side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
