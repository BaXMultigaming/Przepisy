  "ingredients": [
    "1 pound spaghetti",
    "0.5 cup olive oil",
    "2 cloves garlic, minced",
    "2 tablespoons butter",
    "1 tablespoon dried parsley",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon ground black pepper",
    "2 (6.5 ounce) cans minced clams, with juice",
    "2 tablespoons grated Romano cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat olive oil in a small saucepan over medium heat. Add minced garlic; cook until browned. Stir in butter, parsley, garlic powder, oregano, basil, and black pepper until butter is melted. Stir in clams with some of their liquid until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain spaghetti; toss with clam sauce. Top with grated Romano cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
