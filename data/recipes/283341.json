  "ingredients": [
    "2 (8 ounce) strip steaks",
    "coarse sea salt and ground black pepper to taste",
    "2 tablespoons canola oil, or to taste",
    "2 tablespoons unsalted butter, softened",
    "1 tablespoon soy sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set steaks out at room temperature for 10 minutes. Season both sides with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a cast-iron skillet over medium-high heat until shimmering. Add steaks; cook until a nice crust forms, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer skillet to the preheated oven; cook for 5 minutes. Transfer steaks to a platter; cover with aluminum foil for 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and soy sauce in a bowl; serve on top steaks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
