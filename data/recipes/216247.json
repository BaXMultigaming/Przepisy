  "ingredients": [
    "1 teaspoon olive oil",
    "2 yams, peeled and cut into wedges",
    "0.5 teaspoon seasoned salt",
    "5 tablespoons fat-free sour cream",
    "1 teaspoon mayonnaise",
    "0.5 teaspoon taco seasoning",
    "0.125 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Spread the olive oil over a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange the yams on the prepared baking sheet in a single layer; season with the seasoned salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake the yams in the preheated oven until soft, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the yams bake, stir the sour cream, mayonnaise, taco seasoning, and paprika together in a small bowl. Serve as a dip for the yams.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
