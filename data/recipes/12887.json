  "ingredients": [
    "1 tablespoon butter",
    "1 onion, finely chopped",
    "2 cloves garlic, crushed",
    "1 tablespoon curry powder",
    "1 teaspoon ground cumin",
    "4 cups chicken broth",
    "4 Macintosh apples - peeled, cored and chopped",
    "1 (15 ounce) can pumpkin puree",
    "1 cup water",
    "1 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan over medium heat. Add onion, garlic, curry, and cumin; sauté, stirring often, until onion is soft and fragrant.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add broth, apples, pumpkin, water, and sugar. Bring to a boil, stirring often. Cover, and reduce heat to low; simmer, stirring occasionally, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée soup in a food processor or a blender in batches, if necessary. Return soup to saucepan; heat on low until warmed through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
