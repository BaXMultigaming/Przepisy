  "ingredients": [
    "3 tablespoons canola oil",
    "3 tablespoons honey mustard",
    "4 teaspoons honey",
    "2 large cloves garlic, minced",
    "1 tablespoon paprika",
    "2 teaspoons chopped fresh chives",
    "1.5 teaspoons dried basil",
    "2 teaspoons adobo seasoning",
    "1 teaspoon onion powder",
    "0.5 teaspoon meat tenderizer",
    "2 chicken leg quarters with skin"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil, honey mustard, and honey in a bowl until well combined. Stir in garlic, paprika, chives, basil, adobo seasoning, onion powder, and meat tenderizer. Stir until fully blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat the bottom of a glass baking dish with 2 to 3 tablespoons of mustard sauce mixture. Place chicken legs on top and cover with the rest of the sauce mixture. Cover dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink at the bone and the juices run clear, 60 to 75 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
