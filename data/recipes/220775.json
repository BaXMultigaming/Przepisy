  "ingredients": [
    "1 cucumber, peeled and thinly sliced",
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup mayonnaise",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion salt",
    "1 dash Worcestershire sauce",
    "1 (1 pound) loaf sliced bread, crusts removed",
    "1 pinch lemon pepper"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cucumber slices between 2 paper towels set in a colander. Allow liquid to drain, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese, mayonnaise, garlic powder, onion salt, and Worcestershire sauce in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cream cheese mixture evenly on one side of each bread slice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide cucumber slices over half of the bread slices; sprinkle lemon pepper on cucumber.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stack the other half of the bread slices spread-side down over cucumber to make sandwiches; slice into triangles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
