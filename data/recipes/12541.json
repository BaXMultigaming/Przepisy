  "ingredients": [
    "1 (9 inch) pie shell",
    "0.25 cup butter",
    "0.5 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon salt",
    "1 cup light corn syrup",
    "3 eggs",
    "1 cup quick cooking oats"
  ],
  "steps": [
    {
      "text": "Cream together butter or margarine and sugar. Stir in cinnamon, cloves, and salt. Stir in syrup. Add eggs one at a time, stirring after each addition until blended. Stir in oats. Pour filling into pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for about 1 hour, or until knife inserted in center comes out clean.",
      "section": null,
