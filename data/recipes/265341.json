  "ingredients": [
    "0.25 cup raw cashews",
    "1 ripe banana",
    "1 cup ice cubes",
    "3 ounces extra-firm tofu, pressed to remove water",
    "0.33333334326744 cup cacao powder",
    "2 Medjool dates, pitted",
    "3 tablespoons creamy peanut butter",
    "2 teaspoons vanilla extract",
    "1 teaspoon soy milk, or more as needed",
    "0.25 teaspoon sea salt",
    "0.33333334326744 cup crushed peanuts"
  ],
  "steps": [
    {
      "text": "Place cashews in a bowl and cover with water. Soak for 1 to 3 hours. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soaked cashews, banana, ice cubes, tofu, cacao powder, dates, peanut butter, vanilla extract, 1 teaspoon soy milk, and salt in a blender. Process until smooth. Add an additional teaspoon of soy milk only if needed, in order to keep the mixture as thick as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into a bowl and sprinkle with crushed peanuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
