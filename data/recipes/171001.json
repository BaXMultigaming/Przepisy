  "title": "Lobster Mac and Cheese",
  "description": "Lobster mac and cheese made with whole lobster, macaroni pasta, and a blend of 3 cheeses baked in a creamy sauce for a special comfort food favorite.",
  "authors": [
    "Ange"
  ],
  "date_published": "2019-04-02T02:50:51-04:00",
  "date_modified": "2026-01-20T15:38:41-05:00",
