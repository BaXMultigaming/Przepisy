  "ingredients": [
    "4 (8 ounce) boneless, skinless chicken breasts",
    "0.25 cup red wine vinegar",
    "2 teaspoons kosher salt",
    "1 teaspoon freshly ground black pepper",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried rosemary",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon cayenne pepper",
    "0.25 cup olive oil",
    "1 cup full-fat Greek yogurt",
    "8 ounces feta cheese",
    "1 tablespoon chopped fresh mint",
    "1 teaspoon finely crushed garlic, or to taste",
    "1 teaspoon lemon zest",
    "2 tablespoons chopped Italian parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YbBaRspCPx2DwuByyaJcnl7G898=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8387497-grilled-greek-chicken-breasts-with-whipped-feta-VAT-Step-01-cb8222972eae4fda99f634f19f8a05e6.jpg"
      ],
      "image": "assets/images/8387497/step_01.webp"
    },
    {
      "text": "Cut chicken breasts in half lengthwise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aY5ZhALjoXc-TsRx4D2AZPMYIpk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8387497-grilled-greek-chicken-breasts-with-whipped-feta-VAT-Step-02-391fa2542b7d4d22a6a856c15f55673c.jpg"
      ],
      "image": "assets/images/8387497/step_02.webp"
    },
    {
      "text": "Whisk vinegar, salt, black pepper, thyme, oregano, rosemary, garlic powder, and cayenne pepper together in a large glass or ceramic bowl. Add chicken and toss to thoroughly and evenly coat. Add ¼ cup olive oil; toss to coat. Cover the bowl with plastic wrap; marinate in the refrigerator for 1 to 12 hours (2 to 3 hours is ideal).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4j4NuBZ1gYFCaCNkGva41TvhhoQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8387497-grilled-greek-chicken-breasts-with-whipped-feta-VAT-Step-03-cc575f9a21374962b669c35a771e194e.jpg"
      ],
      "image": "assets/images/8387497/step_03.webp"
    },
    {
      "text": "Place Greek yogurt in a separate bowl; crumble in feta cheese. Add 1 tablespoon mint, minced garlic, and lemon zest; whip with an electric mixer or whisk until light and fluffy. Taste; adjust seasonings. Cover the bowl with plastic wrap; refrigerate until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DqftkHs8-VHS2AI8l4wuM2VQFeA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8387497-grilled-greek-chicken-breasts-with-whipped-feta-VAT-Step-04-6ef36bfd0a2648c6a92569579657e9d2.jpg"
      ],
      "image": "assets/images/8387497/step_04.webp"
    },
    {
      "text": "Preheat an outdoor charcoal grill until coals are white and very hot; lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8OERu8z_YC-TPQz4cTfyOziBlX8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8387497-grilled-greek-chicken-breasts-with-whipped-feta-VAT-Step-05-4e9fa82c1ae24fa2ab2875f81f12b6ec.jpg"
      ],
      "image": "assets/images/8387497/step_05.webp"
    },
    {
      "text": "Cook chicken on the preheated grill over hot coals for about 4 minutes per side; continue flipping and grilling until chicken is no longer pink in centers and an instant-read thermometer inserted into centers reads at least 150 degrees F (65 degrees C). Off heat, rest for about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BO9YiF2pNl5JJ9JsQD2gqok0HOA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8387497-grilled-greek-chicken-breasts-with-whipped-feta-VAT-Step-06-88fd5fa33cef4de8bcc971f29d995d2f.jpg"
      ],
      "image": "assets/images/8387497/step_06.webp"
    },
    {
      "text": "Spread whipped feta onto a serving platter or plate; place chicken over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Oa2EtzAXvSEIO3sKydqyS4sz_zU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8387497-grilled-greek-chicken-breasts-with-whipped-feta-VAT-Step-07-40c3acb65ee6407883a047d62c6c3877.jpg"
      ],
      "image": "assets/images/8387497/step_07.webp"
    },
    {
      "text": "Sprinkle chicken and feta with parsley and remaining 2 tablespoons mint.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d3TkYgfTHyv1tt5n2rveXU17Apc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8387497-grilled-greek-chicken-breasts-with-whipped-feta-VAT-4x3-Edited-149897573f0844fab45262c86ed4f05c.jpg"
      ],
      "image": "assets/images/8387497/step_08.webp"
    }
