  "title": "Slow Cooker Beef Brisket",
  "description": "This tender slow cooker brisket is seasoned with a smoky-sweet rub, cooked to perfection, then basted with BBQ sauce and finished under the broiler.",
  "authors": [
    "Cooking with Kimberly Wood"
  ],
  "date_published": "2022-03-21T12:46:26-04:00",
  "date_modified": "2025-12-16T18:19:04-05:00",
