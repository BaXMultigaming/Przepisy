  "ingredients": [
    "0.25 cup butter",
    "1 (16 ounce) package sliced mushrooms",
    "salt to taste",
    "0.25 cup all-purpose flour, or as needed",
    "1 quart beef stock",
    "1 pinch ground black pepper to taste",
    "1 pinch fresh thyme leaves, to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K5M-JY9JODQJVTUpNbVxqCGt1us=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219091-chef-johns-mushroom-gravy-VAT-step-01-ba4ee8a988cd479a8a19c0e7bd419032.jpg"
      ],
      "image": "assets/images/219091/step_01.webp"
    },
    {
      "text": "Heat butter in a saucepan over medium heat until it foams. Stir in mushrooms and season with salt. Simmer until liquid evaporates, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-T25gfiduvu4LnHTSVt063GsKtw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219091-chef-johns-mushroom-gravy-VAT-step-02-b88c56b73fa24bc5b0414d405cdb4bb6.jpg"
      ],
      "image": "assets/images/219091/step_02.webp"
    },
    {
      "text": "Stir in flour; cook and stir for 5 minutes. Add 1 cup of beef stock, stirring briskly until incorporated, then pour in the remaining stock and mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VOhrcCMg8w4pfV9ZDqe-VJkWHAw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219091-chef-johns-mushroom-gravy-VAT-step-03-b242fdc0251a4c739a84a5788bd74167.jpg"
      ],
      "image": "assets/images/219091/step_03.webp"
    },
    {
      "text": "Season with black pepper and thyme. Reduce heat to medium-low and simmer until thickened, stirring often, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0fKq2IwEx_mq9ewfaEYnjF1oEAg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219091-chef-johns-mushroom-gravy-VAT-step-04-0420a7123d0c46ed8c8843de2208e3ef.jpg"
      ],
      "image": "assets/images/219091/step_04.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YflybhAB90qCwhWGxq5Tsua9yB8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219091-chef-johns-mushroom-gravy-VAT-Beauty-4x3-39122649baf34433a9939d5e720ec18d.jpg"
