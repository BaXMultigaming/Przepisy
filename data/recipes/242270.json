  "ingredients": [
    "1 splash olive oil",
    "1 cup rice",
    "0.25 cup chopped onion",
    "1 clove garlic, chopped",
    "1 cup vegetable broth",
    "1.5 cups water",
    "1 head romaine lettuce leaves",
    "1 dash soy sauce, or to taste",
    "1 splash lime juice, or to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a large saucepan over medium heat. Cook and stir rice in hot oil until golden brown, 3 to 5 minutes; add onions and garlic and cook until the onion is softened, 5 to 7 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour vegetable broth and water into the saucepan; bring to a boil, reduce heat to low, place a cover on the saucepan, and cook rice at a simmer until tender and the liquid is absorbed, 10 to 15 minutes. Fluff rice and cook 1 to 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop rice mixture into lettuce leaves. Season with soy sauce or lime juice, as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
