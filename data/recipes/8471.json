  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "2 pounds ricotta cheese",
    "0.75 cup white sugar",
    "4 eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan. Prepare the cake according to the directions on the package.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine ricotta, sugar, eggs and vanilla. Mix until smooth. Drop by spoonfuls on top of uncooked cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 1/2 hours, or until a toothpick inserted into the cake comes out clean. Sprinkle cooled cake with confectioners sugar. Keep refrigerated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
