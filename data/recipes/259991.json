  "ingredients": [
    "2.25 cups all-purpose flour, unsifted",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup unsalted butter, softened",
    "0.75 cup granulated sugar",
    "0.75 cup brown sugar, packed",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "2 cups Ghirardelli® Bittersweet 60% Cacao Baking Chips",
    "1 cup walnuts, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and both sugars in a large mixing bowl; beat with an electric mixer at medium speed until creamy and light in color. Beat in eggs, one at a time, until combined. Add vanilla and mix on low speed until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually blend flour mixture into butter mixture. Stir in chocolate chips and walnuts. Drop by tablespoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are golden brown, 9 to 11 minutes, switching racks halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and transfer to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
