  "ingredients": [
    "1.5 cups graham cracker crumbs",
    "3 tablespoons white sugar",
    "0.5 cup butter or margarine, melted",
    "1 (8 ounce) package cream cheese, softened",
    "1 cup white sugar",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon lemon juice",
    "0.25 teaspoon salt",
    "1 (8 ounce) tub frozen whipped topping, thawed",
    "3 cups frozen blueberries"
  ],
  "steps": [
    {
      "text": "Stir graham cracker crumbs and 3 tablespoons sugar together in a medium bowl; mix in melted butter until well combined. Sprinkle evenly into the bottom of a 9-inch square baking dish; pack down into a solid crust. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and 1 cup sugar together in a large bowl with an electric mixer until smooth; mix in vanilla, lemon juice, and salt. Stir in whipped topping until well blended, then fold in frozen blueberries. Spoon into the prepared crust and spread evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover with plastic wrap and refrigerate for at least 1 hour before slicing into squares and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
