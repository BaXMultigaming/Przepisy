  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.75 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.33333334326744 cup vegetable oil",
    "0.33333334326744 cup milk",
    "1 large egg",
    "0.5 teaspoon almond extract",
    "1 cup fresh pitted and quartered sweet cherries",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, 3/4 cup sugar, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, milk, egg, and almond extract together in a small bowl; pour into flour mixture and gently stir until incorporated. Fold in cherries. Spoon batter into the prepared muffin cups, filling each 2/3 full. Sprinkle remaining sugar over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes. Transfer to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
