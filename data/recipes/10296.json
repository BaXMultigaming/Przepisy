  "ingredients": [
    "1 cup margarine",
    "1 cup confectioners' sugar",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 cup rolled oats",
    "1 cup cherry baking chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine margarine, confectioner's sugar and vanilla. Beat until fluffy. Add flour, baking soda and oats. Mix well. Stir in cherry flavored chips (other flavors work well, too!).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by rounded teaspoonful onto ungreased cookie sheets and flatten slightly with fingers. Bake for 12 minutes. Remove immediately from cookie sheets and onto wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
