  "ingredients": [
    "0.5 cup butter",
    "1 (16 ounce) package cottage cheese",
    "1 pound shredded Monterey Jack cheese",
    "2 (4 ounce) cans diced green chiles",
    "10 eggs",
    "0.25 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VKt5k0jZ_xHcnxoE6mezhGru5LI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-229987-christmas-green-chile-egg-casserole-step-01-4f58966bc6d34471af2ddd7291ada13c.jpg"
      ],
      "image": "assets/images/229987/step_01.webp"
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Set butter in a 6x10-inch casserole dish; place dish in the preheating oven until butter is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R4jMm_D9R3XF41cW4__BSma6jdw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-229987-christmas-green-chile-egg-casserole-step-02-ffa5c3c629e342b6ae9326724dc6c20b.jpg"
      ],
      "image": "assets/images/229987/step_02.webp"
    },
    {
      "text": "Mix cottage cheese, Jack cheese, green chiles, eggs, flour, baking powder, and salt in a large bowl using an electric hand mixer. Pour mixture into the melted butter in the casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qLsy17Tog8eAEvlMEMsH6OBT4lI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-229987-christmas-green-chile-egg-casserole-step-03-1a57ffe47c1a4af2ba442abbee25e34b.jpg"
      ],
      "image": "assets/images/229987/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Reduce heat to 350 degrees F (175 degrees C); bake until middle of casserole is set, about 50 more minutes. Allow to stand for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
