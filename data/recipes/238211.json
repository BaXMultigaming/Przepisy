  "ingredients": [
    "1 tablespoon white sugar",
    "1 tablespoon lemon juice",
    "1 cup ice cubes, or as needed",
    "2 fluid ounces vodka",
    "2 fluid ounces black cherry juice",
    "0.5 fluid ounce grapefruit juice",
    "1 teaspoon agave nectar",
    "1 maraschino cherry"
