  "ingredients": [
    "1 pound ground turkey",
    "0.5 cup dry bread crumbs",
    "0.5 onion, chopped",
    "1 egg, beaten",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup maple syrup",
    "0.5 cup ketchup",
    "3 tablespoons mustard",
    "0.25 cup vinegar",
    "0.5 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C), and grease a 9x12 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the ground turkey, bread crumbs, onion, egg, salt, and pepper in a bowl, and form into 6 patties. Place the patties in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together the maple syrup, ketchup, mustard, vinegar, and oil in a bowl, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake the patties in the preheated oven for 20 minutes, remove from oven, and turn them over.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle the patties with the maple syrup mixture, return to the oven, and bake until the patties are browned and the sauce is bubbling and thickened, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
