  "title": "Bacon Cheeseburger Soup",
  "description": "This bacon cheeseburger soup with cubes of potato, ground beef, and veggies is topped with Cheddar cheese and crispy bacon for a rich and filling meal.",
  "authors": [
    "Rebekah Rose Hills"
  ],
  "date_published": "2022-01-17T22:02:08-05:00",
