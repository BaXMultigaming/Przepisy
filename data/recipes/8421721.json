  "ingredients": [
    "1 pound delicata squash",
    "cooking spray",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground coriander",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon flaky sea salt",
    "fresh sage leaves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Trim both ends from squash. Slice crosswise into 1/8-inch-thick rings, keeping seeds as intact as possible. Arrange rings (with seeds) in a single layer on the prepared baking sheet. Coat with cooking spray. Sprinkle with cumin, coriander, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 20 minutes. Flip rings; continue baking until tender and browned, about 20 minutes more. Sprinkle with flaky salt and garnish with sage leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
