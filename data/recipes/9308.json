  "ingredients": [
    "0.25 cup milk",
    "2 tablespoons dried bread crumbs",
    "1 tablespoon minced onion",
    "0.5 pound lean ground beef",
    "2 tablespoons water",
    "2 tablespoons soy sauce",
    "1 tablespoon vegetable oil",
    "2 teaspoons white sugar",
    "0.5 clove crushed garlic",
    "0.25 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Combine the milk, dry bread crumbs, and chopped onion. Add meat. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape into 3 dozen small balls. Place in a shallow baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend water, soy sauce, vegetable oil, sugar, garlic, and ginger. Pour over meatballs. Let stand 1 hour. Stir once or twice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake meatballs in sauce, uncovered, at 350 degrees F (175 degrees C) for 20-25 minutes. Serve hot in chafing dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
