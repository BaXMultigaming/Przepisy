  "ingredients": [
    "1.5 pounds ground turkey",
    "2 tablespoons plain yogurt",
    "2 tablespoons chopped fresh cilantro",
    "1.5 tablespoons plain bread crumbs",
    "1.5 tablespoons ground almonds",
    "1 tablespoon lemon juice",
    "2 cloves garlic, crushed and minced",
    "1.5 teaspoons finely grated fresh ginger",
    "1.5 teaspoons salt",
    "1.5 teaspoons garam masala",
    "1 teaspoon chile paste"
  ],
  "steps": [
    {
      "text": "Combine ground turkey, yogurt, cilantro, bread crumbs, almonds, lemon juice, garlic, ginger, salt, garam masala, and chili paste with a spatula or clean hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape turkey mixture into a ball; divide into 4 even pieces. Refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form each turkey piece into a patty using damp hands. Refrigerate patties while grill heats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until patties appear cooked about halfway up sides. Flip; cook until surface is cracked and juices start to rise to the top, 4 to 5 minutes per side. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
