  "title": "French Canadian Tourtière",
  "description": "French Canadian tourtière is a double-crusted meat pie with savory pork, beef, onion, and spice filling, perfect for a festive holiday gathering.",
  "authors": [
    "Rayna Jordan"
  ],
  "date_published": "2000-08-06T20:31:50-04:00",
