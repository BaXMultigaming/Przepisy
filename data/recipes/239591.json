  "ingredients": [
    "1.25 cups chocolate cookie baking crumbs",
    "0.25 cup butter, melted",
    "3 (250 g) packages PHILADELPHIA Chocolate Brick Cream Cheese, softened",
    "0.75 cup white sugar",
    "1 teaspoon peppermint extract",
    "3 eggs",
    "0.5 cup whipping cream",
    "1 tablespoon white sugar",
    "1 candy cane, crushed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cookie crumbs and butter; press into bottom of 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and 3/4 cup sugar in large bowl with mixer until blended. Add extract; mix well. Add eggs, 1 at a time, mixing on low speed after each just until blended; pour over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 40 to 45 minutes or until centre is almost set. Run knife around rim of pan to loosen cake; cool before removing rim. Refrigerate cheesecake 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream in separate bowl with mixer on high speed until soft peaks form. Gradually add remaining sugar, beating until stiff peaks form; spoon over cheesecake. Sprinkle with crushed candy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
