  "ingredients": [
    "2 cups chopped candy bars, or more to taste",
    "1 cup white sugar",
    "0.5 cup butter",
    "2 eggs",
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Melt candy bars, sugar, and butter in a saucepan over medium heat. Remove from heat and cool slightly, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat in eggs, one at at time, until smooth. Mix in flour and baking soda to create a sticky dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill dough in the refrigerator until it can be easily scooped, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 2 baking sheets with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll 1 1/2 teaspoonful of dough into balls. Place onto prepared baking sheets 1 inch apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until brown and fluffy, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
