  "ingredients": [
    "1 tablespoon vegetable oil",
    "2 pounds cube steaks, pounded thin and cut into bite-sized pieces",
    "1.5 tablespoons all-purpose flour",
    "2 (14.5 ounce) cans stewed tomatoes",
    "1 pound mushrooms, sliced",
    "1 medium onion, chopped",
    "1 (1.2 ounce) package brown gravy mix",
    "salt and pepper to taste",
    "1 (12 ounce) package egg noodles"
  ],
  "steps": [
    {
      "text": "Heat oil in a Dutch oven over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge steak strips in flour; shake off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, fry steak in hot oil until browned. Remove to a warm platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return browned steak to the Dutch oven. Stir in stewed tomatoes, mushrooms, onion, gravy mix, salt, and pepper. Bring to a boil, then reduce heat and simmer for 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "About 20 minutes before steak is finished, fill a large pot with water and bring to a boil. Add egg noodles to boiling water and cook until al dente, about 8 to 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve Swiss steak over noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
