  "ingredients": [
    "4 large baking potatoes, scrubbed",
    "2 tablespoons olive oil",
    "kosher salt and freshly ground black pepper to taste",
    "0.5 teaspoon garlic powder, or to taste",
    "0.5 teaspoon dried parsley, or to taste",
    "4 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UFlLyvzBUjlq3sYa4UJeWwWqZYE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275253-easy-air-fryer-baked-potatoes-Step-1-1526-bf08b9a11f3f44649f09183b758b5e08.jpg"
      ],
      "image": "assets/images/275253/step_01.webp"
    },
    {
      "text": "Rub potatoes with olive oil and season with salt, pepper, garlic powder, and parsley. Place potatoes in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer until potatoes are soft, 40 to 50 minutes, depending on potato size.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0P-V0ywDzxCye_EwzeDft3HWtYw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275253-easy-air-fryer-baked-potatoes-ddmfs-Step-3-1554-978f28a8c6ef496eb12d4a12e2419ff5.jpg"
      ],
      "image": "assets/images/275253/step_03.webp"
    },
    {
      "text": "Slice potatoes lengthwise. Pinch both sides of each potato, using your hands and forcing potatoes to open, until the fluffy insides start to come out. Add 1 tablespoon of butter into each potato.",
      "section": null,
      "name": null,
      "url": null,
