  "ingredients": [
    "1 tablespoon butter",
    "1 cup uncooked quinoa",
    "2 cups vegetable broth",
    "2 teaspoons chopped garlic",
    "2 tablespoons chopped fresh parsley",
    "0.5 tablespoon chopped fresh thyme",
    "0.25 teaspoon salt",
    "1 small onion, finely chopped",
    "1 dash fresh lemon juice"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium heat. Add quinoa and toast, stirring occasionally, until lightly browned, about 5 minutes. Stir in broth and bring to a boil. Reduce the heat, cover, and simmer until tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and transfer to a bowl. Stir in garlic, parsley, thyme, salt, and onion until combined. Sprinkle lemon juice over top.",
      "section": null,
      "name": null,
      "url": null,
