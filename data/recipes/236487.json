  "ingredients": [
    "1 cup mayonnaise",
    "0.25 cup egg substitute",
    "0.25 cup freshly grated Parmesan cheese",
    "2 tablespoons water",
    "3 cloves garlic, finely chopped",
    "1.5 tablespoons lemon juice",
    "1 tablespoon anchovy paste",
    "2 teaspoons white sugar",
    "0.5 teaspoon dried parsley",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Blend mayonnaise, egg substitute, Parmesan cheese, water, garlic, lemon juice, anchovy paste, sugar, parsley, salt, and pepper in a blender until smooth, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dressing to an airtight container and refrigerate 8 hours to overnight.",
