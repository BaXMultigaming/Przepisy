  "ingredients": [
    "1 (14 ounce) package Hillshire Farm® Smoked Sausage, diagonally cut into 1/4-inch slices",
    "1 medium onion, 1/2-inch dice",
    "1 green bell pepper, 1/2-inch dice",
    "3 cloves garlic, minced",
    "2 tablespoons chili powder",
    "1 teaspoon cumin",
    "0.5 teaspoon salt",
    "1 (14 ounce) can diced tomatoes",
    "1 (14 ounce) can black beans, drained",
    "1 cup shredded Monterey Jack cheese",
    "1 jalapeño, minced",
    "1 (8.5 ounce) package dry corn muffin mix, batter prepared as directed on the box"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a 10-inch oven-safe skillet over medium-high heat. Add smoked sausage and cook until browned. Add onion, bell pepper, and garlic and cook until vegetables are soft, about 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with chili powder, cumin, and salt. Add in tomatoes with their juice and beans. Cook until mixture starts to bubble, 3 to 5 minutes. Turn off heat and stir in cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix jalapeño into prepared corn muffin mix. Spread corn muffin batter over the mixture and bake until golden brown and cooked through, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
