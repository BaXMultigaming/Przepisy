  "ingredients": [
    "1 tablespoon mirin (Japanese sweet wine)",
    "1 tablespoon soy sauce",
    "2 teaspoons sesame chili oil",
    "2 cloves garlic, minced",
    "1 teaspoon sesame seeds",
    "1 tablespoon peanut oil",
    "1 pound fresh green beans, trimmed",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Combine mirin, soy sauce, sesame chili oil, garlic, and sesame seeds in a small bowl. Set sauce aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat peanut oil over medium-high heat in a large skillet. Add green beans and saute for 2 minutes, stirring frequently. Add in sauce and lower heat to medium. Continue cooking until beans have reached the desired doneness, 4 to 5 minutes more. Season with salt, if desired, before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
