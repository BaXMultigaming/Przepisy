  "ingredients": [
    "1 pound ground bison",
    "0.5 cup panko bread crumbs",
    "1 egg",
    "3 tablespoons Worcestershire sauce",
    "4 dashes hot sauce (such as Tabasco®)",
    "1 pinch granulated garlic",
    "1 pinch ground black pepper",
    "olive oil cooking spray",
    "4 slices American cheese",
    "4 hamburger buns, split and toasted"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bison, bread crumbs, egg, Worcestershire sauce, hot sauce, garlic, and pepper in a large bowl. Form into 4 patties. Place patties on a baking sheet. Cover with foil and refrigerate until chilled, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray patties with cooking spray. Cook on the preheated grill until hot and slightly pink in center, about 5 minutes per side. Top each patty with cheese slices. Continue cooking until cheese melts, about 2 minutes more. An instant-read thermometer inserted into the center should read 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sandwich patties between toasted bun halves and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
