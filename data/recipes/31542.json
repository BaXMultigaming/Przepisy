  "ingredients": [
    "1 cup Burgundy wine",
    "2 tablespoons olive oil",
    "1 tablespoon prepared brown mustard",
    "1 teaspoon garlic powder",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "2 pounds fresh asparagus, trimmed"
  ],
  "steps": [
    {
      "text": "In a medium bowl, whisk together Burgundy wine, olive oil, brown mustard, garlic powder, black pepper and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place asparagus in a large glass bowl, and cover with the Burgundy wine mixture. Cover bowl, and marinate asparagus in the refrigerator at least 2 hours, turning occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat, and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill asparagus 10 minutes, or to desired tenderness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
