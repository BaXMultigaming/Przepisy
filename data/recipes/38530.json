  "ingredients": [
    "0.25 cup vegetable oil",
    "1 cup chopped celery",
    "1 cup chopped onion",
    "1 cup chopped green bell pepper",
    "2 cloves garlic, minced",
    "2 pounds ground beef",
    "1 cup ketchup",
    "1 cup chili sauce",
    "0.5 cup water",
    "2 tablespoons chopped fresh parsley",
    "1 tablespoon white vinegar",
    "2 teaspoons brown sugar",
    "2 teaspoons Worcestershire sauce",
    "1 teaspoon salt",
    "1 teaspoon pepper",
    "1 teaspoon dry mustard powder",
    "1 teaspoon chili powder",
    "0.5 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat. Cook and stir celery, onion, green bell pepper, and garlic in hot oil until softened, about 5 minutes. Add ground beef, increase heat to medium-high, and stir until crumbly and browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in ketchup, chili sauce, water, parsley, vinegar, brown sugar, Worcestershire sauce, salt, pepper, mustard powder, chili powder, and paprika until well combined; bring to a simmer. Reduce heat to medium-low, cover, and simmer for 30 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
