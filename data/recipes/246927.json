  "ingredients": [
    "1 (14 ounce) package extra-firm tofu",
    "1 onion, chopped",
    "1 egg",
    "0.5 cup bread crumbs",
    "0.5 cup grated Parmesan cheese",
    "1 tablespoon Worcestershire sauce",
    "1.25 teaspoons chopped fresh basil",
    "1.25 teaspoons chopped fresh marjoram",
    "1.25 teaspoons chopped fresh rosemary",
    "1.25 teaspoons chopped fresh oregano",
    "1.25 teaspoons chopped fresh thyme",
    "1 teaspoon red pepper flakes",
    "1 teaspoon salt",
    "0.5 teaspoon hot sauce",
    "0.5 teaspoon minced garlic",
    "0.25 cup olive oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tofu onto a plate and place another plate on top. Set a 3- to 5-pound weight on top. Press tofu for 15 minutes to drain excess water. Break tofu into small pieces and squeeze again to remove as much water as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tofu in a large bowl. Add onion, egg, bread crumbs, Parmesan cheese, Worcestershire sauce, basil, marjoram, rosemary, oregano, thyme, red pepper flakes, salt, hot sauce, and garlic; mix well with your hands until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle some olive oil on the lined baking sheet. Form tablespoonfuls of tofu mixture into balls and arrange in rows on the baking sheet. Drizzle remaining olive oil over meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and firm to the touch, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
