  "title": "Italian Tofu Meatballs",
  "description": "These golden tofu meatballs flavored with Parmesan cheese, fresh herbs, and Worcestershire sauce make for a savory vegetarian main dish.",
  "authors": [
    "orb205"
  ],
  "date_published": "2019-04-02T03:06:55-04:00",
