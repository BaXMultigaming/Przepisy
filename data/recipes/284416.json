  "ingredients": [
    "1 quart water",
    "1.5 tablespoons salt",
    "1 pound dried lutefisk",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Bring water and salt to a rolling boil. Add lutefisk; return to a boil. Remove from the heat, cover, and let sit for 8 minutes. An instant-read thermometer inserted into center should read at least 140 degrees F (60 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully remove lutefisk from water using a scoop strainer or skimmer spoon. Cover lutefisk with melted butter and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
