  "ingredients": [
    "1 recipe pastry for a 9 inch single crust pie",
    "3 eggs",
    "1 egg yolk",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon ground cloves",
    "1.5 cups milk",
    "0.5 cup heavy whipping cream",
    "2 cups pumpkin puree"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine eggs, egg yolk, white sugar and brown sugar. Add salt, cinnamon, nutmeg, ginger and cloves. Gradually stir in milk and cream. Stir in pumpkin. Pour filling into pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for ten minutes in preheated oven. Reduce heat to 350 degrees F (175 degrees C), and bake for an additional 40 to 45 minutes, or until filling is set.",
      "section": null,
      "name": null,
      "url": null,
