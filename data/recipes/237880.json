  "ingredients": [
    "0.75 cup ice",
    "0.5 cup milk",
    "3 tablespoons marshmallow topping (such as Smucker's®)",
    "1 shot cold espresso",
    "0.5 tablespoon Dutch-process cocoa powder",
    "0.5 tablespoon white sugar",
    "0.25 cup whipped cream",
    "0.5 tablespoon graham cracker crumbs"
  ],
  "steps": [
    {
      "text": "Blend ice, milk, marshmallow topping, espresso, cocoa powder, and sugar together in a blender until smooth; pour into a glass and top with whipped cream and graham cracker crumbs.",
