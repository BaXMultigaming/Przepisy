  "ingredients": [
    "4.6666665077209 cups water",
    "1 tablespoon olive oil",
    "0.5 teaspoon salt",
    "3 cups uncooked brown rice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and olive oil to a boil in a covered saucepan; stir in salt. Place rice in a 9x13-inch baking dish. Pour water mixture over rice; cover baking dish tightly with double layer of aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until water is absorbed, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove rice from oven, uncover, and fluff with fork. Cover with paper towels until steam is absorbed, about 5 minutes. Uncover and cool slightly, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
