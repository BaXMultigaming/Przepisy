  "ingredients": [
    "1.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup unsalted butter, softened",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "0.5 cup cashew butter",
    "0.5 cup firmly packed brown sugar",
    "1 egg",
    "2 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, and salt together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and vanilla extract together with an electric mixer in a large bowl until smooth. Add cashew butter, brown sugar, egg, and milk to the butter mixture; beat until smooth. Gradually add flour mixture and mix until just incorporated into a dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1 1/2-inch balls and arrange onto a baking sheet. Lightly press a fork into the top of the balls to make a crosshatch pattern.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden brown, 12 to 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
