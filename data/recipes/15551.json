  "ingredients": [
    "1 (12 fluid ounce) can or bottle chile sauce",
    "9 ounces grape jelly",
    "2 teaspoons lemon juice",
    "1 pound lean ground beef",
    "1 large onion, grated",
    "1 large egg, beaten",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Whisk together chile sauce, grape jelly, and lemon juice. Pour into a slow cooker and simmer over Low heat until warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, onion, egg, and salt. Mix well and form into 24 1-inch balls. Add to sauce and simmer for 1 1/2 hours.",
      "section": null,
