  "ingredients": [
    "1 cup butter, softened",
    "2 cups brown sugar",
    "1 cup white sugar",
    "1.5 cups peanut butter",
    "2 teaspoons vanilla extract",
    "3 ripe bananas",
    "2.5 cups all-purpose flour",
    "0.5 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together the butter, brown sugar, white sugar, peanut butter, and vanilla in a bowl. Mash the bananas into the mixture until there are few lumps. Sift together the flour and baking powder in a separate bowl; add to the banana mixture and stir until thoroughly incorporated. Drop rounded tablespoons of mixture onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until lightly brown and firm, about 10 minutes.",
      "section": null,
      "name": null,
