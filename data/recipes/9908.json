  "ingredients": [
    "1 cup packed brown sugar",
    "0.5 cup butter",
    "2 eggs",
    "2 (1 ounce) squares unsweetened chocolate",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Melt chocolate over low heat. Cream together sugar and butter or margarine. Add chocolate and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add eggs and dry ingredients. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat waffle iorn. Non stick spray can be used to prepare iron.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop about 1 Tablespoon of dough in each section of preheated iron.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until cookies start to turn brown. Be careful because they can burn easily.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool and frost with a white powdered sugar frosting. (See recipe for Vanilla Glaze.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
