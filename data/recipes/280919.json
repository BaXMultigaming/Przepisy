  "ingredients": [
    "2 (4 ounce) fillets tilapia fillets",
    "0.25 cup all-purpose flour",
    "1 egg",
    "2 tablespoons lemon juice",
    "0.25 teaspoon salt",
    "0.5 cup Italian-seasoned bread crumbs",
    "1 tablespoon lemon-pepper seasoning",
    "non-stick cooking spray",
    "1 lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat tilapia fillets dry using a paper towel. Coat both sides of fish with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg, lemon juice, and salt together in a shallow bowl. Place bread crumbs and lemon-pepper seasoning in a separate shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip flour-coated fish first in egg and then in bread crumb mixture. Press down on the fish so that the bread crumbs stick. Spray both sides of fish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fillets in the air fryer basket and cook for 5 minutes. Flip fish over using a spatula and cook for 3 minutes more. Serve with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
