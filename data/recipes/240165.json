  "ingredients": [
    "2 tablespoons butter",
    "1 cup white sugar",
    "0.5 teaspoon salt",
    "1 cup shelled peanuts"
  ],
  "steps": [
    {
      "text": "Line a jelly roll pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Stir sugar and salt with melted butter to dissolve completely. Remove saucepan from heat, add peanuts, and stir to coat completely; immediately pour onto prepared pan and spread into an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate until brittle, at least 30 minutes. Separate from parchment and break into pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
