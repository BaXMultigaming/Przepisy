  "ingredients": [
    "0.5 cup red wine vinegar",
    "0.5 cup olive oil",
    "0.5 cup white sugar",
    "1 tablespoon soy sauce",
    "0.25 cup margarine",
    "0.25 cup blanched slivered almonds",
    "0.25 cup sesame seeds",
    "2 (3 ounce) packages ramen noodle pasta, crushed",
    "1 medium head bok choy",
    "3 green onions"
  ],
  "steps": [
    {
      "text": "In a small bowl, whisk together the vinegar, oil, sugar and soy sauce. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the margarine over medium heat in a small skillet. Crush the ramen noodles while still in their packaging, and add to the margarine along with the almonds and sesame seeds. Saute until everything is golden brown. Remove from heat and drain on a paper towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chop the bok choy and green onions and add to a large bowl. Just before serving, sprinkle with the noodle mixture and dressing, and toss to coat.",
      "section": null,
