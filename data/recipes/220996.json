  "ingredients": [
    "2.5 cups all-purpose flour",
    "1 cup unsalted butter - chilled, cut into tablespoon-size pieces",
    "0.5 teaspoon salt",
    "7 tablespoons ice water",
    "1 tablespoon cider vinegar"
  ],
  "steps": [
    {
      "text": "Combine flour, butter, and salt in a food processor. Pulse until mixture resembles coarse crumbs, about 10 (1-second) pulses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NKTgrrRaroIEcZTrGED50xujYRw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220996-easy-homemade-pie-crust-step1-042-4x3-079da2332f4b4ad4933fe209d47e533c.jpg"
      ],
      "image": "assets/images/220996/step_01.webp"
    },
    {
      "text": "Stir ice water and vinegar in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/2 of the ice water mixture into flour mixture; pulse to combine, about 3 (1-second) pulses. Pour in remaining ice water mixture; pulse until mixture starts to come together, about 8 (1-second) pulses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9s7du2-iY80y4tm4bsWnMkbkJqg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220996-easy-homemade-pie-crust-step2-044-4x3-98bf8259360c4d3a9188ae5acc77f2cd.jpg"
      ],
      "image": "assets/images/220996/step_03.webp"
    },
    {
      "text": "Turn dough out onto a wooden surface, pat it into a circle, and divide it in half. Form each half into a disc, about 5-inches wide.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JaMqJ9Zk_3xvKelOK7xMc-iCiHE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220996-easy-homemade-pie-crust-step3-048-4x3-0c4fb7a1f0264522bd3fab783605e1fa.jpg"
      ],
      "image": "assets/images/220996/step_04.webp"
    },
    {
      "text": "Wrap each disc in plastic wrap and refrigerate for at least 30 minutes until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oTldhjPQYMu1dBRU6H3rvyPot08=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220996-easy-homemade-pie-crust-step4-056-4x3-79fd3133543b4e1a84d908e56713c1fa.jpg"
      ],
      "image": "assets/images/220996/step_05.webp"
    },
    {
      "text": "Use in your favorite pie recipe.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x0qPGfitkg-Epet7sflH7Nu-G18=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220996-easy-homemade-pie-crust-SparkleKat-4x3-3d7f0d9f53144e2d83c138ff60c56e56.jpg"
