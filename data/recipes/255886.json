  "ingredients": [
    "14 tablespoons butter, softened",
    "0.75 cup firmly packed brown sugar",
    "0.5 cup granulated sugar",
    "2 eggs",
    "1 teaspoon vanilla",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "3 cups Quaker® Oats (Quick or Old Fashioned, uncooked)",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugars together in a large bowl with an electric mixer on medium speed until creamy. Add eggs and vanilla; beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add combined flour, baking soda, cinnamon and salt; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add oats and raisins; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded tablespoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden brown, about 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool briefly on cookie sheets; remove to wire rack. Cool completely. Store tightly covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
