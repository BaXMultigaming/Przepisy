  "ingredients": [
    "1 (15 ounce) can whole kernel corn, drained",
    "1 cup milk",
    "2 eggs, beaten",
    "2 tablespoons all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 cup white sugar",
    "0.5 cup butter",
    "0.5 cup white sugar",
    "0.5 cup water",
    "2 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, whisk together the milk, eggs, flour, baking powder and sugar. Add corn and pour into a 9x13 inch baking dish. Bake for 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small sauce pan, combine butter, sugar, water and flour. Cook until clear. Once corn mixture is cooked, remove from oven, pour butter and sugar mixture over top and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
