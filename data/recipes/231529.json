  "steps": [
    {
      "text": "Grease three 8-inch round cake pans; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ¾ cup plus 2 tablespoons warm water, butter, eggs, lemon extract, bread flour, sugar, and yeast into a bread machine in the order listed, or follow the order recommended by the manufacturer if different. Run Dough cycle. Remove dough from the machine when the cycle is done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut dough into 3 equal-sized pieces; roll each piece into a ball and place into a prepared cake pan. Cover dough balls; let rise at room temperature for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake loaves in the preheated oven until lightly browned, 15 to 20 minutes.",
      "section": null,
