  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "0.25 cup melted butter",
    "salt and ground black pepper to taste",
    "2 cloves garlic, minced",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "0.5 cup chicken broth",
    "1 (8 ounce) package cream cheese, cut into cubes",
    "3 chipotle peppers in adobo sauce, minced",
    "1 tablespoon adobo sauce from chipotle peppers"
  ],
  "steps": [
    {
      "text": "Place chicken breasts into a slow cooker, brush with butter, and sprinkle with salt, pepper, and minced garlic. Pour in condensed soup and chicken broth. Add cream cheese, chipotle peppers, and adobo sauce. Stir the mixture gently.",
