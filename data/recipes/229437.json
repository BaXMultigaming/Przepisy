  "ingredients": [
    "2 cups Minute® Brown Rice, uncooked",
    "0.5 cup dried cranberries",
    "1 teaspoon dried orange peel",
    "0.5 cup chicken stock",
    "1 tablespoon margarine",
    "0.5 cup celery, finely chopped",
    "2 tablespoons shallots, finely chopped",
    "1 teaspoon poultry seasoning",
    "0.5 cup pecans, chopped and toasted",
    "0.25 cup fresh parsley, chopped",
    "1 pinch salt and ground black pepper, to taste"
  ],
  "steps": [
    {
      "text": "Prepare rice according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium microwave safe bowl, mix cranberries and orange peel with chicken stock and microwave on high for 2 minutes. Set aside. Heat a large sauce pan over high heat and add margarine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in celery, shallot and poultry seasoning and saute 3 minutes. Stir in cranberry mixture, pecans, parsley and rice and cook over medium heat for 3 more minutes or until all liquid is absorbed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
