  "ingredients": [
    "0.25 cup butter",
    "4 cups miniature marshmallows",
    "1 (20 ounce) package chocolate sandwich cookies (such as Oreo®), crushed"
  ],
  "steps": [
    {
      "text": "Butter a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over low heat; add marshmallows and stir until melted. Cook and stir mixture for 2 minutes more. Remove saucepan from heat. Stir crushed cookies into marshmallow mixture until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press cookie mixture firmly into the prepared baking dish using a buttered spatula or waxed paper; cool. Cut into 2-inch squares.",
      "section": null,
