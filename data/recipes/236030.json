  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup hot sauce",
    "0.25 cup ranch dressing",
    "0.25 cup minced onion",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion powder",
    "3 (5 ounce) cans chicken chunks, drained",
    "2 (8 ounce) packages refrigerated crescent rolls",
    "2 tablespoons butter, melted",
    "0.5 cup shredded Cheddar cheese, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese, hot sauce, ranch dressing, onion, garlic powder, and onion powder together in a bowl; fold in chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll crescent roll dough onto a work surface, pressing dough into a thin layer without tearing. Cut 3-inch pieces out of dough using a biscuit cutter. Spoon about 1 tablespoon of cream cheese mixture into the center of each dough piece. Pull dough over filling; crimp edges together using a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange pockets on a baking sheet. Brush each pocket with butter and sprinkle with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
