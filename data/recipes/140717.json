  "ingredients": [
    "0.33333334326744 cup margarine, softened",
    "0.66666668653488 cup white sugar",
    "0.5 cup packed brown sugar",
    "2 eggs",
    "1 cup peanut butter",
    "0.5 teaspoon vanilla extract",
    "2 tablespoons water",
    "0.75 cup whole wheat flour",
    "0.25 cup all-purpose flour",
    "0.25 teaspoon salt",
    "1 teaspoon baking powder",
    "0.25 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees Celsius). Grease a 9x9 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, beat together margarine and sugars; add eggs one at a time, and beat until mixture is light and fluffy. Stir in peanut butter, vanilla, and water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate mixing bowl, mix together flours with salt, baking powder, and baking soda. Stir into peanut butter mixture and blend well. Spread batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 to 35 minutes, or until the top springs back when touched. Cool and cut into 16 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
