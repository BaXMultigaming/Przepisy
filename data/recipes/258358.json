  "ingredients": [
    "6 slices bacon, cut crosswise into 1/4-inch pieces",
    "1 tablespoon olive oil",
    "2 white potatoes, cubed",
    "salt and ground black pepper to taste",
    "1 onion, chopped",
    "4 eggs, beaten"
  ],
  "steps": [
    {
      "text": "Cook and stir bacon in a large skillet over medium heat until crispy, about 5 minutes. Transfer to a paper towel-lined plate to drain, discarding most of the grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add olive oil to the same skillet over medium heat. Add potatoes, salt, and pepper; cook and stir until browned and somewhat crispy, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix onion into potatoes and cook until onion is translucent, about 5 minutes. Return bacon to the skillet; cook and stir until heated through, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour beaten eggs over potato mixture; cook and stir until eggs are set, 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
