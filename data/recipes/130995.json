  "ingredients": [
    "1.25 pounds cubed beef stew meat",
    "1 (12 fluid ounce) can pale ale or lager beer",
    "1 onion, diced",
    "2 tablespoons Worcestershire sauce",
    "2 cloves garlic, minced",
    "1.5 teaspoons chopped fresh parsley",
    "0.5 teaspoon dried thyme",
    "salt and pepper to taste",
    "2 cups peeled and cubed potatoes",
    "1.5 cups quartered fresh mushrooms",
    "1 tablespoon all-purpose flour",
    "1 pastry for double-crust pie"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/erDL91d4qtir35zRb1RF8S0DulQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/130995-steak-and-ale-pie-with-mushrooms-VAT-step-01-2caf44312e2b442fa7e7989dc2c4cb61.jpg"
      ],
      "image": "assets/images/130995/step_01.webp"
    },
    {
      "text": "Combine beef stew meat, ale, and onion in a large saucepan over low heat; simmer until beef is tender, about 30 minutes. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E0_4E5J8m0oZa28Lcy7JUD_pAi0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/130995-steak-and-ale-pie-with-mushrooms-VAT-step-02-2a267439b6234583968f4ce1c0d81e77.jpg"
      ],
      "image": "assets/images/130995/step_02.webp"
    },
    {
      "text": "Season beef mixture with Worcestershire sauce, garlic, parsley, thyme, salt, and black pepper; add potatoes and mushrooms. Increase heat to medium; cover saucepan and simmer until potatoes are just fork-tender, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5hZM-4fXH1eMN00iN4djXapCOkM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/130995-steak-and-ale-pie-with-mushrooms-VAT-step-03-b0cb8283eadf44baa9d4563cb7b589a6.jpg"
      ],
      "image": "assets/images/130995/step_03.webp"
    },
    {
      "text": "Whisk a small amount of sauce with flour in a small bowl; stir into beef mixture. Simmer until slightly thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5cCcqHZlC_InwBL-fSb2oAZh4AI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/130995-steak-and-ale-pie-with-mushrooms-VAT-step-04-480818e348ef4687b2206d4c416ca8c5.jpg"
      ],
      "image": "assets/images/130995/step_04.webp"
    },
    {
      "text": "Place 1 pie crust into bottom and up sides of a 9-inch pie plate. Spoon hot beef mixture into crust; top with remaining pie crust. Cut slits in top crust to vent steam; crimp edges to seal together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SMGP6qKMFcGdagVzLlF5luO4pnQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/130995-steak-and-ale-pie-with-mushrooms-VAT-step-05-61339322003d4310aff7592fc9e3fa67.jpg"
      ],
      "image": "assets/images/130995/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until crust is golden brown and gravy is bubbling, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6jzEgDDWla5Xuo1-P-X0lFb9V2E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/130995-steak-and-ale-pie-with-mushrooms-VAT-step-06-046dd47520e6461ab5ac176eeddc3542.jpg"
      ],
      "image": "assets/images/130995/step_06.webp"
    }
