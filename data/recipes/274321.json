  "ingredients": [
    "1 banana",
    "1 teaspoon honey",
    "1 teaspoon sweetened flaked coconut",
    "2 tablespoons whipped cream (such as Reddi-Whip®)"
  ],
  "steps": [
    {
      "text": "Cut the ends off the banana, slice it lengthwise, and lay it skin-side down on a piece of aluminum foil on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Score banana crosswise 1/4 inch deep, every 1 inch apart. Coat banana with honey and sprinkle with coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set a countertop convection oven to \"turbo\" setting. Cook until coconut starts to brown, about 5 minutes. Garnish with whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
