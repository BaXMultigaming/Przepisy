  "ingredients": [
    "8 cups water",
    "6 potatoes, cubed",
    "1 yellow onion",
    "1 tablespoon butter",
    "1 bay leaf",
    "2 teaspoons dried parsley",
    "salt to taste",
    "ground black pepper to taste",
    "1 cup all-purpose flour",
    "2 eggs",
    "0.5 cup half-and-half cream"
  ],
  "steps": [
    {
      "text": "Slice onion into quarters and separate layers. Add 8 cups water, potato, onion, butter, bay leaf, parsley, salt, and pepper into a large soup pot. Bring to a boil over medium heat; reduce heat to low and simmer until potatoes are tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the noodles: Mix flour, eggs, and about 1 teaspoon of salt in a separate bowl. Stir in enough water to form a thick dough. Slice into noodles; add to soup and cook until fluffy, abut 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cream and heat through.",
      "section": null,
