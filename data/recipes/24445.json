  "ingredients": [
    "1 cup butter, softened",
    "1 cup packed light brown sugar",
    "0.5 cup white sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "1.25 cups all-purpose flour",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "3 cups quick-cooking oats",
    "1 cup chopped walnuts",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eP1RGsgAYuDWKBp9HYnr73ua1DI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-24445-chewy-chocolate-chip-oatmeal-cookies-ddmfs-step-1-060-55b6a7da457445488727fc5f3ceaeb11.jpg"
      ],
      "image": "assets/images/24445/step_01.webp"
    },
    {
      "text": "Combine flour, salt, and baking soda in a bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HBf4GHDWJcwx4a1YJSBOZF8k5_A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24445-ChewyChocolateChip-OatmealCookies-mfs-step3-00930-35d8deab5de549c28b12be7ba766a6cd.jpg"
      ],
      "image": "assets/images/24445/step_02.webp"
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together in a large bowl until smooth; beat in eggs, one at a time, until well combined. Stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pi61oIGP_en-z4uQOs8kk4Eo3_M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24445-ChewyChocolateChip-OatmealCookies-mfs-step2-00929-f470270d0603499caf5a9e70d809e794.jpg"
      ],
      "image": "assets/images/24445/step_03.webp"
    },
    {
      "text": "Stir flour mixture into butter mixture until just blended; mix in oats, walnuts, and chocolate chips. Drop batter by heaping spoonfuls onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F9EhkGRWEShuNLeRXWXctufPhP4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24445-ChewyChocolateChip-OatmealCookies-mfs-step5-00932-df1a65897f9d4274b9ae60ef96f6c99e.jpg"
      ],
      "image": "assets/images/24445/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 12 minutes. Cool cookies on baking sheets for 3 to 5 minutes minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Wbb4FrsMVyLameKPWMyYAamP7cc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24445-chewy-chocolate-chip-oatmeal-cookies-DDMFS-4x3-4e97a758a98640759903569ef637ac18.jpg"
      ],
      "image": "assets/images/24445/step_05.webp"
    }
  ],
