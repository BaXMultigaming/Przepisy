  "ingredients": [
    "0.75 teaspoon olive oil, divided",
    "1 clove garlic, minced",
    "0.33333334326744 cup packed brown sugar",
    "0.25 cup soy sauce",
    "0.5 lemon, juiced",
    "1 teaspoon honey",
    "0.25 teaspoon sea salt, plus more for garnish",
    "0.25 teaspoon ground black pepper, plus more for garnish",
    "0.25 teaspoon red pepper flakes",
    "4 (6 ounce) fillets salmon",
    "1 tablespoon olive oil"
  ],
  "steps": [
    {
      "text": "Heat 1/4 teaspoon olive oil in a small skillet over medium-high heat. Sauté garlic in hot oil until just beginning to brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together sautéed garlic, brown sugar, soy sauce, lemon juice, honey, 1/2 teaspoon olive oil, sea salt, black pepper, and red pepper flakes in a bowl; pour into a large resealable plastic bag. Add salmon fillets to the bag, turning to coat with marinade, squeeze to remove excess air, and seal the bag. Marinate in the refrigerator for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UMd-xqZgk_KYqIHJelMybPDWvDw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239006-sweet-glazed-salmon-step-2-1327-7b59926682a249b480e5c43c21f8044a.jpg"
      ],
      "image": "assets/images/239006/step_02.webp"
    },
    {
      "text": "Remove salmon from the marinade and shake to remove excess liquid. Reserve 3 tablespoons marinade and discard remainder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W9HisQOKpADFWc3h80NUOfJNhcc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239006-sweet-glazed-salmon-step-3-1328-532a85c759ba440498adda9694018454.jpg"
      ],
      "image": "assets/images/239006/step_03.webp"
    },
    {
      "text": "Heat 1 tablespoon olive oil in a large skillet over medium heat. Arrange salmon fillets in the hot skillet; pour reserved marinade over salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2v-XU7Q6x4_Sas-S9-x4RK6lwIQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239006-sweet-glazed-salmon-step-4-1330-d77cdd456c4f45cb890cc80c7e7193bd.jpg"
      ],
      "image": "assets/images/239006/step_04.webp"
    },
    {
      "text": "Cover and cook, occasionally spooning liquid in the pan over fillets, until salmon is browned and flakes easily with a fork, 2 to 3 minutes per side. Garnish salmon with sea salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BmrT3pnmXPvv58fb6j6cFMttBsg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239006-sweet-glazed-salmon-step-5-1331-d54c230ae20f4f40b63ea34d10b3c869.jpg"
      ],
