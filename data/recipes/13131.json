  "title": "Cream Of Garlic Soup",
  "description": "Cooking mellows the flavor of garlic in this chicken stock based soup pureed with cubes of cooked potato and thickened with heavy cream.",
  "authors": [
    "MARBALET"
  ],
  "date_published": "1999-03-17T07:23:15-05:00",
