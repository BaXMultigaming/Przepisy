  "ingredients": [
    "0.75 cup garlic cloves, peeled",
    "3 tablespoons olive oil",
    "2.5 cups chicken broth",
    "1 cup white wine",
    "2.5 cups milk",
    "1 cup heavy whipping cream",
    "0.5 cup peeled and cubed potatoes",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Chop garlic in a food processor to a coarse paste, stopping occasionally to scrape the sides of the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large saucepan over low heat. Add the garlic paste and cook just until the paste begins to color, stirring constantly. Stir in the chicken broth and wine. Bring mixture to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat and simmer for 30 minutes. Stir in the milk, cream and potato and simmer for another 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree soup in blender, return to saucepan and simmer. Add salt and pepper to taste. Ladle into bowls and serve with buttered French bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
