  "steps": [
    {
      "text": "Whisk mayonnaise, egg, Dijon, Worcestershire, and hot sauce together in a small bowl. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix crabmeat, panko, and parsley together in a medium bowl. Gently fold in mayonnaise mixture. Form into 8 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 2 tablespoons oil in a skillet over medium-high heat. Add patties in batches and cook until golden brown and crisp, 3 to 5 minutes on each side. Transfer to a plate lined with paper towels. Repeat with remaining patties, adding more oil as needed.",
      "section": null,
      "name": null,
