  "ingredients": [
    "1 (12 ounce) package refrigerated cheese tortellini",
    "0.25 cup butter",
    "0.5 large onion, finely chopped",
    "2 cloves garlic, minced",
    "0.5 teaspoon paprika",
    "0.5 teaspoon ground cumin",
    "1 pinch dried marjoram",
    "salt and freshly ground black pepper to taste",
    "0.33333334326744 cup all-purpose flour",
    "4 cups chicken stock",
    "2 cups shredded cooked chicken",
    "2 cups fresh spinach",
    "0.5 cup heavy whipping cream",
    "1 cup shredded Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil; stir in tortellini and return to a boil. Cook uncovered, stirring occasionally, until the tortellini are tender yet firm to the bite, about 9 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a pot over medium heat. Add onion and garlic; cook and stir until onion is tender, about 5 minutes. Add paprika, cumin, marjoram, salt, and pepper. Reduce heat to low. Stir flour into the pot. Whisk in chicken stock slowly until fully blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring soup to a boil, stirring frequently until thickened. Add tortellini, chicken, spinach, and heavy cream; stir until heated through, about 5 minutes. Stir in Parmesan cheese until melted, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
