  "steps": [
    {
      "text": "Saute leeks, shallots, and bacon in a skillet over medium heat until fat is extracted from the bacon, about 5 minutes. Add white wine and bring to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cream, peas, Parmesan cheese, carrots, butter, and dried tarragon; bring to a simmer. Add clams, cover, and steam until clams open, 7 to 10 minutes. Season with salt and pepper.",
      "section": null,
