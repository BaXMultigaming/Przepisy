  "ingredients": [
    "1 pound ground beef",
    "1.5 tablespoons butter",
    "3 tablespoons all-purpose flour",
    "1 cup beef broth",
    "0.5 cup evaporated milk",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Brown ground beef in a medium skillet over medium-high heat until no longer pink. Drain excess fat; set beef aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a medium saucepan over medium heat. Slowly add flour, stirring constantly, to form a brown roux.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in beef broth and milk until well combined. Add ground beef; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
