  "ingredients": [
    "2 cups chopped green leaf lettuce",
    "0.25 cup sunflower sprouts",
    "1 avocado, cut into 1/2-inch cubes",
    "0.25 cup cubed seeded watermelon",
    "1 tablespoon chopped fresh cilantro, or to taste",
    "6 tablespoons orange juice",
    "2 tablespoons red wine vinegar",
    "1 tablespoon honey",
    "1 tablespoon heavy cream",
    "1 teaspoon Dijon mustard",
    "0.75 cup olive oil",
    "2 tablespoons olive oil",
    "1 teaspoon finely chopped fresh mint leaves",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine lettuce and sprouts in a bowl. Top with avocado and watermelon cubes. Sprinkle cilantro on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend orange juice, vinegar, honey, cream, and mustard in a blender or food processor. Slowly drizzle in 3/4 cup plus 2 tablespoons oil while blender is running. Blend in mint, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
