  "ingredients": [
    "2 pounds cubed beef stew meat",
    "1 cup chopped onion",
    "1 cup beef broth",
    "1 cup red wine vinegar",
    "2 bay leaves",
    "3 cups egg noodles",
    "0.75 cup crushed gingersnap cookies",
    "2 tablespoons brown sugar",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Combine beef, onion, beef broth, vinegar, and bay leaves in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 7 to 9 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook egg noodles in the boiling water, stirring occasionally until tender yet firm to the bite, 4 to 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove bay leaves from beef mixture; stir in crushed gingersnaps and brown sugar. Cook beef mixture on Low until thickened, about 15 minutes. Serve sauerbraten over egg noodles and garnish with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
