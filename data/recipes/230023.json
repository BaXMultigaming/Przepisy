  "ingredients": [
    "1 (12 ounce) package frozen dinner rolls, thawed",
    "0.75 cup vanilla ice cream",
    "0.75 cup butter",
    "0.75 cup white sugar",
    "0.75 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Arrange rolls in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat ice cream, butter, white sugar, and brown sugar in a saucepan over medium heat until ice cream is melted, sugars are dissolved, and sauce is warm, about 5 minutes; pour mixture over bread dough. Cover and let rise in a warm area until doubled, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until rolls are golden brown, about 30 minutes.",
