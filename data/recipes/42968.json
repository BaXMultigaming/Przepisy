  "ingredients": [
    "1 (12 ounce) package rice noodles",
    "2 tablespoons butter",
    "1 pound boneless, skinless chicken breast halves, cut into bite-sized pieces",
    "0.25 cup vegetable oil",
    "4 eggs",
    "3 tablespoons white sugar",
    "2 tablespoons fish sauce",
    "1 tablespoon white wine vinegar",
    "0.125 tablespoon crushed red pepper",
    "2 cups bean sprouts",
    "3 green onions, chopped",
    "0.25 cup crushed peanuts",
    "1 lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/msLPJTZuMyBhFIN8Uvj_FDqkIXc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/42968-pad-thai-step-1-1507-738e030dda64453fb9faa13e95d9cd53.jpg"
      ],
      "image": "assets/images/42968/step_01.webp"
    },
    {
      "text": "Soak rice noodles in cold water until soft, 30 to 50 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat butter in a wok; add chicken and sauté until browned. Remove chicken and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ifejz2zs6CoDYfQJB7vLBCC0eEY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/42968-pad-thai-step-2-1509-8bce3ef954de422fb0d91f5efe2b4d7b.jpg"
      ],
      "image": "assets/images/42968/step_03.webp"
    },
    {
      "text": "Heat oil in the wok over medium-high heat. Crack eggs into hot oil and cook until firm. Stir in chicken and cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jHO1bxONPov-olMGJHeZ-D_QGuY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/42968-pad-thai-step-3-1510-22a274d136ed41c6942bd8ac34a4c3a2.jpg"
      ],
      "image": "assets/images/42968/step_04.webp"
    },
    {
      "text": "Add softened noodles, sugar, fish sauce, vinegar, and red pepper; mix well until noodles are tender. Adjust seasonings to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3YFMivHT3rzPUjppjkmDj0opCl8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/42968-pad-thai-step-4-1513-ebe6c9ed5efb44b491e5b9f11b3130fd.jpg"
      ],
      "image": "assets/images/42968/step_05.webp"
    },
    {
      "text": "Stir bean sprouts into wok and cook for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/16qmaKjLiC1Ywc1B5ZFwKIVpk5Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/42968-pad-thai-step-5-1516-56260804580d458bb42118a08e55f4dc.jpg"
      ],
      "image": "assets/images/42968/step_06.webp"
    },
    {
      "text": "Serve topped with green onions, crushed peanuts, and a wedge of lemon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/11HVKKh8OrlLC3RlS3Ikh5dN_lo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/42968-pad-thai-DDMFS-4x3-f46b490ef89b4694b8bf4c5ac54a486b.jpg"
