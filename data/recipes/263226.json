  "ingredients": [
    "0.5 cup maple syrup",
    "2 tablespoons soy sauce",
    "1 tablespoon minced garlic",
    "1 tablespoon chopped fresh dill",
    "0.25 teaspoon garlic salt",
    "0.125 teaspoon ground black pepper",
    "1 pound salmon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix maple syrup, soy sauce, garlic, dill, garlic salt, and pepper together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon in a shallow baking dish and coat with the maple syrup mixture. Cover dish and marinate salmon in the refrigerator, turning once, about 30 minutes.",
