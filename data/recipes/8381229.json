  "ingredients": [
    "2 tablespoons mayonnaise",
    "4 slices white bread",
    "4 ounces processed cheese food (such as Velveeta ®), sliced"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 380 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the mayonnaise on 4 slices of bread. Distribute cheese slices evenly between 2 bread slices, mayonnaise side down. Place the remaining 2 slices on the sandwiches, mayonnaise side up, and lightly press sandwiches to close.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the sandwiches in the air fryer basket in a single layer, leaving some space around them.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry for 3 to 4 minutes, flip sandwiches, and cook until sandwich is golden brown and cheese is melted, 2 to 3 more minutes. Depending on the size of your air fryer, you may have to cook in batches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice sandwiches on the diagonal, and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
