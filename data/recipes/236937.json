  "title": "Capirotada",
  "description": "Capirotada, or Mexican bread pudding, is made with layers of buttered bread, raisins, nuts, and Oaxaca cheese baked in a sweet cinnamon syrup.",
  "authors": [
    "dromero1013"
  ],
  "date_published": "2020-03-05T00:11:47-05:00",
