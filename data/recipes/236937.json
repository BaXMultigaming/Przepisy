    "Mexican"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "3 cups water",
    "3 cups brown sugar, divided",
    "2 cinnamon sticks",
    "2 loaves sliced white bread, toasted",
    "2 cups butter, softened",
    "1 pound shredded sharp Cheddar cheese",
    "2 cups peanuts",
    "2 cups raisins",
    "0.25 teaspoon ground cinnamon, or to taste",
    "0.25 teaspoon ground nutmeg, or to taste",
    "0.125 teaspoon ground cloves, or to taste"
  ],
  "steps": [
    {
      "text": "Gather Ingredients and preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SvRsuOjPsveKHtBxeZZ7kcmg-HQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236937-Capirotada-DDMFS-step1-3x4-5376-7ebc861d5d6d40c1b89bf003994d8f04.jpg"
      ],
      "image": "assets/images/236937/step_01.webp"
    },
    {
      "text": "Combine water, 2 cups brown sugar, and cinnamon sticks together in a saucepan; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dMPdD0RpS1tH4XcUlIFD-wbE5KU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236937-Capirotada-DDMFS-step2-3x4-5382-fdd01de2d8f24f82bd7b83705b1fc4b2.jpg"
      ],
      "image": "assets/images/236937/step_02.webp"
    },
    {
      "text": "Reduce heat and simmer, stirring occasionally, until sugar is dissolved and liquid has reduced into a syrup, about 15 minutes. Remove cinnamon sticks from syrup using a slotted spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K6vDzcEadgb9s9MUOwlyxojufW4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236937-Capirotada-DDMFS-step3-3x4-5401-0d3f0fc9e424419d80e1270a1572983e.jpg"
      ],
      "image": "assets/images/236937/step_03.webp"
    },
    {
      "text": "Spread a thin layer of butter onto one side of each toasted bread slice, and sprinkle with cinnamon, nutmeg, and cloves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RFmo7nxlYJ4_rH-TkG6kBh_LJQw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236937-Capirotada-DDMFS-step6-3x4-5391-bd1c4728a2c14898925df54e6cff3d65.jpg"
      ],
      "image": "assets/images/236937/step_04.webp"
    },
    {
      "text": "Shingle bread, butter-side up, to make two rows in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HaDNhrRpXN81996chjsH5-QrRAw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236937-Capirotada-DDMFS-step7-3x4-5393-467e728d43734fe1b46264877b4ac748.jpg"
      ],
      "image": "assets/images/236937/step_05.webp"
    },
    {
      "text": "Sprinkle cheese, raisins, peanuts, cinnamon, nutmeg, and cloves over bread. Sprinkle remaining remaining 1/4 cup brown sugar over the cheese. Pour cinnamon syrup over entire dish; cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Xg3ODHBKW9WV5NSVtum3OAO2w3Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236937-Capirotada-DDMFS-step9-3x4-5411-50a1e58b9e204d17bf92eeae9adc6901.jpg"
      ],
      "image": "assets/images/236937/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until cooked through, about 30 minutes. Cool for 15 to 20 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7pLtQ3LTQL-kz91w90sRPM8elgw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236937-Capirotada-DDMFS-step10-3x4-5479-0c7a1156d3634afba5d706c064fcbb02.jpg"
      ],
      "image": "assets/images/236937/step_07.webp"
    }
  ],
