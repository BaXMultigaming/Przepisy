  "ingredients": [
    "1 cup milk",
    "0.25 teaspoon ground turmeric",
    "0.25 teaspoon ground ginger",
    "1 pinch ground black pepper",
    "2 pods cardamom",
    "2 saffron strands (such as Zaran®), or more to taste"
  ],
  "steps": [
    {
      "text": "Pour 1/3 cup milk into a saucepan. Heat over medium-low heat until hot but not boiling, about 1 minute. Add turmeric, ginger, black pepper, cardamom, and saffron; stir until combined. Pour remaining milk into the saucepan and cook over medium heat until flavors blend, 3 to 5 minutes more.",
