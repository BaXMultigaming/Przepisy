  "title": "Chicken Pan Pie",
  "description": "A richer, thicker filling and a buttery, flaky crust prove that Chef John&#39;s chicken pan pie is superior to the classic chicken pot pie.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2021-10-04T17:56:11-04:00",
