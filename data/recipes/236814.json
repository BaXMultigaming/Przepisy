  "ingredients": [
    "2 teaspoons olive oil, divided",
    "2 whole rainbow trout, gutted and cleaned, heads and tails still on",
    "0.25 teaspoon dried dill weed",
    "0.25 teaspoon dried thyme",
    "salt to taste",
    "0.5 large onion, sliced",
    "2 thin slices lemon",
    "2 tablespoons hot water",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13-inch baking dish with 1 teaspoon olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place trout in the prepared baking dish and coat with remaining olive oil. Gather the seasoning ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2jRiBU5FfhsNmec-sZhNQZ5U5OM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236814-baked-fresh-rainbow-trout-step2-82-4x3-f919291aa5e54371b859082396a64c5a.jpg"
      ],
      "image": "assets/images/236814/step_02.webp"
    },
    {
      "text": "Season inside and outside of fish with dill, thyme, and salt. Stuff each fish with onion slices; grind pepper on top. Place 1 lemon slice on each fish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PJKj-n3w8hkJBVcd-Hhpkk2mYRQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236814-baked-fresh-rainbow-trout-step3-83-4x3-7ac8ea913e684059b89208337e7fbc68.jpg"
      ],
      "image": "assets/images/236814/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 10 minutes; add 2 tablespoons hot water to the dish (cold water could cause the dish to crack) to prevent the fish from drying out. Continue baking until fish flakes easily with a fork, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b1cbga0YbDv5MMmLLkB9P7mWnRU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236814-baked-fresh-rainbow-trout-step4-128-4x3-f76b1afbb8e843f8a98a7bcc6d420947.jpg"
      ],
      "image": "assets/images/236814/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mcwYGQb-8APMrjcsOFOhSV8ouDo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236814-baked-fresh-rainbow-trout-DDMFS-4x3-5937dc3aadd74f25a85ef131cfed480f.jpg"
      ],
      "image": "assets/images/236814/step_05.webp"
    }
