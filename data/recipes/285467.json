  "ingredients": [
    "nonstick cooking spray",
    "1 (15 ounce) can pumpkin puree",
    "2 cups white sugar",
    "1 cup canola oil",
    "4 large eggs, at room temperature",
    "2 teaspoons pumpkin pie spice extract",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1.5 teaspoons pumpkin pie spice",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup all-purpose flour",
    "0.75 cup brown sugar",
    "0.5 cup unsalted butter, melted",
    "1 teaspoon pumpkin pie spice",
    "0.5 teaspoon salt",
    "0.75 cup pecans, finely chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a fluted tube pan (such as Bundt®) with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin, sugar, oil, eggs, and pumpkin pie spice extract in a large bowl. Stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, pumpkin pie spice, baking soda, and salt into a bowl. Stir into pumpkin mixture. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, melted butter, pumpkin pie spice, and salt for the streusel in a bowl. Stir in pecans. Sprinkle streusel over the cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, 55 to 65 minutes. Cool on wire rack for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Run a knife around the cake pan and flip onto a plate. Immediately flip the cake onto a serving platter so the streusel is on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
