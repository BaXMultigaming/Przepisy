  "ingredients": [
    "1 pound ground Italian sausage",
    "1 small onion, diced",
    "1 cup uncooked wild rice",
    "1 (10.75 ounce) can condensed cream of potato soup",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 cup milk",
    "1 cup evaporated milk",
    "1 pound processed cheese, cubed"
  ],
  "steps": [
    {
      "text": "In a medium skillet, fry the Italian sausage and onions until sausage is no longer pink. Drain and set aside. In a small saucepan, cook wild rice with 2 cups of water until tender; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a stockpot, combine the cooked sausage and onions, rice, potato and chicken soups, milk, and evaporated milk. Cook over low heat until warm. Stir in the processed cheese and heat, stirring occasionally until cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
