  "ingredients": [
    "0.25 cup rolled oats",
    "1 tablespoon hemp protein powder",
    "0.125 teaspoon ground cinnamon",
    "1 cup vanilla-flavored almond milk",
    "1 medium banana, sliced and frozen",
    "1 slice apple, chopped",
    "1 tablespoon peanut butter, or more to taste",
    "1 teaspoon honey",
    "5 cubes ice"
  ],
  "steps": [
    {
      "text": "Place oats, hemp powder, and cinnamon into small bowl and stir just to combine.",
