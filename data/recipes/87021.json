  "ingredients": [
    "2 teaspoons corn oil",
    "1 skinless, boneless chicken breast half - cut into bite-size pieces",
    "0.5 teaspoon garlic powder",
    "1.5 tablespoons mayonnaise",
    "0.5 lime, juiced",
    "0.5 teaspoon ground ginger",
    "2 teaspoons milk",
    "2 cups fresh spinach, stems removed",
    "4 fresh strawberries, sliced",
    "1.5 tablespoons slivered almonds",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Place chicken in skillet, season with garlic powder and cook 10 minutes on each side or until juices run clear. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix mayonnaise, lime juice, ginger and milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange spinach on serving dishes. Top with chicken and strawberries, sprinkle with almonds and drizzle with dressing. Season with pepper to serve.",
