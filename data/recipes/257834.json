  "ingredients": [
    "0.5 cup unsalted butter, softened",
    "0.25 cup Pyure Organic All Purpose Stevia Blend",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup cornstarch",
    "3 tablespoons Pyure Organic All Purpose Stevia Blend",
    "2 tablespoons unsalted butter, softened",
    "0.25 cup milk, or as needed",
    "1 teaspoon vanilla extract",
    "1 drop Food coloring"
  ],
  "steps": [
    {
      "text": "Beat butter with Pyure Organic All Purpose Stevia Blend until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat in egg until well blended. Beat in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder and salt together. Stir into butter mixture in two additions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap dough in plastic wrap and refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll on lightly floured surface or between sheets of waxed paper to 1/4-inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using desired cookie cutter, cut out desired shapes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F. Place cookies 2-inches apart on parchment paper lined baking sheets. Bake for 10 to 12 minutes or until golden. Let cool on racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Glaze cookies with Pyure Sugar Free Cookie Icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Icing Directions: Beat cornstarch, Pyure Organic All Purpose Stevia Blend and butter with a mixer on medium-high speed until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually add milk and vanilla until smooth. Add more milk if icing mixture is too dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "If adding food coloring, add a drop at a time until desired color is reached.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate icing for 10 minutes until set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread or pipe over cooled Sugar Free \"Sugar\" Cookies. Use day of.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
