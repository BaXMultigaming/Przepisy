  "ingredients": [
    "2.5 cups whole wheat flour",
    "0.5 cup powdered milk",
    "1 tablespoon wheat germ",
    "1 teaspoon beef bouillon granules",
    "0.33333334326744 cup bacon grease",
    "1 egg",
    "0.5 cup ice water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the whole wheat flour, powdered milk, wheat germ, and beef bouillon granules. Stir in the bacon grease and egg. Add ice water 1 tablespoon at a time until dough is wet enough to stick together. On a lightly floured surface, roll the dough out to 1/2 inch thickness and cut with cookie cutters. Place biscuits 1 inch apart onto an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 to 30 minutes in the preheated oven, until firm. Cool before serving.",
