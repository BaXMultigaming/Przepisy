  "ingredients": [
    "1 teaspoon extra-virgin olive oil",
    "1.5 cups dry lentils",
    "0.5 teaspoon cayenne pepper",
    "salt and ground black pepper to taste",
    "0.25 cup dried parsley"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Pour in lentils; cook and stir constantly until plump and coated with oil, about 5 minutes. Stir in cayenne pepper, salt, and pepper until lentils are brown around the edges, 5 to 7 minutes. Mix in parsley; remove popped lentils from pan and serve.",
