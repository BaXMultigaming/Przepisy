  "ingredients": [
    "1 large avocado, peeled and pitted",
    "2 cloves garlic, minced",
    "1 lemons, juiced",
    "0.25 cup sour cream",
    "0.5 cup chopped seeded cucumber",
    "0.5 teaspoon red pepper flakes, or to taste",
    "1 tablespoon chopped fresh cilantro",
    "1 tablespoon chopped fresh mint",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a medium bowl, combine the avocado, garlic, lemon juice, sour cream and cucumber. Mash with a fork until smooth. If your avocado is not quite ripe enough, you may wish to use a food processor. Season with red pepper flakes, cilantro, mint, salt and pepper, and mix well. Cover and refrigerate for 1 hour before serving.",
