  "ingredients": [
    "1 (16 ounce) package dry penne pasta",
    "5 tablespoons butter",
    "2 cloves garlic, crushed",
    "1 cup vodka",
    "2 (28 ounce) cans crushed tomatoes",
    "1 cup mozzarella cheese, shredded",
    "1 pint heavy cream"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes, or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, sauté garlic in butter. Add vodka and cook for 3 minutes. Pour in tomatoes and cheese; stir until cheese melts. Stir in heavy cream and heat thoroughly. Mix the sauce into hot pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
