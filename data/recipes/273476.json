  "ingredients": [
    "cooking spray",
    "2 (16 ounce) packages breakfast pork sausage",
    "16 eggs",
    "1.25 cups milk",
    "1 tablespoon dry mustard",
    "0.75 tablespoon garlic powder",
    "0.75 tablespoon onion powder",
    "1 pinch salt and ground black pepper to taste",
    "1 (24 ounce) package frozen hash brown potatoes, thawed",
    "24 ounces shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Line a slow cooker with a slow cooker liner and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together eggs, milk, dry mustard, garlic powder, onion powder, salt, and pepper in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1/3 hash browns, 1/3 cooked sausage, and 1/3 Cheddar cheese into the bottom of the prepared slow cooker. Repeat layers in that order with remaining hash browns, sausage, and Cheddar cheese. Pour egg mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until eggs are set, 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
