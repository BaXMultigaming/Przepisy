  "ingredients": [
    "4 cups self-rising flour",
    "1 tablespoon white sugar",
    "1 tablespoon custard powder",
    "2 cups soy milk"
  ],
  "steps": [
    {
      "text": "In a large bowl, stir together the flour, sugar and custard powder. Mix in the soy milk with a whisk so there are no lumps.",
