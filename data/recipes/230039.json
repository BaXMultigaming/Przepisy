  "ingredients": [
    "1.75 cups brown sugar",
    "0.5 cup vegetable oil",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "2 cups chopped apples",
    "2 cups fresh cranberries",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch fluted-tube pan (such as Bundt).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk brown sugar, oil, eggs, and vanilla extract together in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, salt, cinnamon, and nutmeg together in a separate bowl; stir into brown sugar mixture with a wooden spoon. Fold in apples, cranberries, and pecans until combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center of the cake comes out clean, about 75 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
