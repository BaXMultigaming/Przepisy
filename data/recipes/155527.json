  "ingredients": [
    "2 cups flour",
    "1 cup white sugar",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "3 ripe bananas, mashed",
    "1 cup mayonnaise",
    "0.5 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking soda, and baking powder together in a bowl. Stir in bananas, mayonnaise, and chocolate chips until well combined. Spoon batter into the prepared muffin cups, filling each about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and tops spring back when lightly pressed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
