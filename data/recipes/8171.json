  "ingredients": [
    "0.33333298563957 cup packed dark brown sugar",
    "2 teaspoons unsweetened cocoa powder",
    "0.33333298563957 cup chopped semisweet chocolate",
    "1 teaspoon ground cinnamon",
    "0.33333298563957 cup raisins",
    "0.33333298563957 cup golden raisins",
    "0.5 cup toasted walnuts, chopped",
    "0.75 cup unsalted butter",
    "0.5 (8 ounce) package cream cheese",
    "1 cup packed brown sugar",
    "0.33333298563957 cup white sugar",
    "5 eggs",
    "1.5 teaspoons vanilla extract",
    "1 cup plain yogurt",
    "3.25 cups all-purpose flour",
    "0.25 teaspoon salt",
    "1 tablespoon baking powder",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Generously grease a 12 cup Bundt cake pan or a 9 or 10 inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Soak raisins in warm water until plump. Drain and dry. Chop coarsely. Mix with 1/3 cup dark brown sugar, cocoa, chocolate, cinnamon, and chopped nuts. You can also mince filling ingredients in a food processor for another texture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream the unsalted butter with 1 cup brown sugar and white sugar until fluffy. Add cream cheese, and cream until blended. Add eggs and vanilla, and mix thoroughly. Blend in yogurt or sour cream. Fold in flour, salt, baking powder, soda. Mix well on low speed of mixer. Spread one third batter in prepared pan. Top with some of the filling mixture. Layer in this fashion until filling and batter are used up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until done, 50 to 60 minutes. Cool in pan 10 minutes before removing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
