  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, margarine, hot sauce, lemon juice, Worcestershire sauce, and salt in a large bowl. Add pecans; toss to coat. Spread pecans in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring often, until light brown, about 10 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken on a separate baking sheet; rub with oil and sprinkle with Greek seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven until juices run clear, about 20 minutes. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C). Slice into strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss chicken, lettuce, tomatoes, strawberries, grapes, raspberries, and blueberries together in a large bowl. Sprinkle with pecans; drizzle with dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
