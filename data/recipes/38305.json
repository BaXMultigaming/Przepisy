  "ingredients": [
    "1 (16 ounce) package dry fettuccine pasta",
    "1 tablespoon butter",
    "0.5 onion, finely chopped",
    "1 cup heavy cream",
    "0.5 cup grated Parmesan cheese",
    "0.5 cup grated Romano cheese",
    "salt and freshly ground black pepper to taste",
    "1 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a medium casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta, and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet over medium heat, melt the butter, and cook the onion until tender. Stir in the fettuccine, heavy cream, 1/4 cup Parmesan cheese, 1/4 cup Romano cheese, salt and pepper. Transfer to the prepared dish. In a bowl, mix the remaining Parmesan, remaining Romano, and mozzarella. Sprinkle the cheese mixture over the fettuccine mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 15 minutes in the preheated oven, until bubbly and golden brow.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
