  "ingredients": [
    "2 cups peeled and cubed butternut squash",
    "1 pound uncooked green lentils",
    "1 cup chopped onion",
    "1 cup chopped carrots",
    "1 tablespoon olive oil",
    "1 tablespoon chopped fresh sage",
    "1 teaspoon sea salt",
    "1 teaspoon ground ginger",
    "1 teaspoon garlic powder",
    "0.25 teaspoon cumin",
    "3 cups water",
    "2 cups vegetable stock",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Turn a slow cooker on High.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butternut squash, lentils, onion, carrots, olive oil, sage, sea salt, ginger, garlic powder, and cumin in the slow cooker. Pour in water and stock. Stir gently to evenly distribute spices and vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High until vegetables are cooked through and lentils are soft, 2 1/2 to 3 hours. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
