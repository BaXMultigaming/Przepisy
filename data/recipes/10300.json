  "ingredients": [
    "1 cup butter",
    "1 cup packed brown sugar",
    "1 egg yolk",
    "2 cups all-purpose flour",
    "0.66666668653488 cup candied cherries, halved",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Cream butter and sugar. Add yolk and flour. Cut in fruit and nuts. Shape dough into two rolls 2 inches in diameter and roll in waxed paper. Chill overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While still cold and wax paper still on, take a sharp knife and cut thin slices (1/8 inch). Set on greased cookie sheets, remove wax paper and bake for 10 minutes. (Slightly brown edges).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
