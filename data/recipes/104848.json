  "ingredients": [
    "1 (7 ounce) jar marshmallow cream",
    "0.75 cup confectioners' sugar, or to taste",
    "3 (1 ounce) squares unsweetened chocolate, melted and cooled",
    "1.5 tablespoons butter flavored shortening",
    "0.25 cup half-and-half, or as needed"
  ],
  "steps": [
    {
      "text": "Place the marshmallow cream, two-thirds of the confectioners' sugar, melted chocolate, shortening, and half of the half-and-half in a mixing bowl. Beat with an electric mixer until smooth. Alternately add remaining confectioners' sugar and half-and-half until desired level of sweetness and consistency is attained.",
