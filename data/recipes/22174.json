  "ingredients": [
    "0.25 cup extra-virgin olive oil, or more as needed",
    "4 tablespoons milk",
    "1 extra large egg",
    "1 cup cornmeal",
    "1 cup all-purpose flour",
    "3 green tomatoes, sliced 1/2 inch thick"
  ],
  "steps": [
    {
      "text": "Heat ¼ inch olive oil in a large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and egg together in a shallow bowl until well combined. Combine cornmeal and flour in a separate shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip tomato slices in milk mixture, then dredge in cornmeal mixture to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lower tomatoes carefully into the hot oil in batches. Fry until browned on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
