  "ingredients": [
    "cooking spray",
    "1 pound sweet rice flour (mochiko)",
    "2.5 cups white sugar",
    "2 cups water",
    "1 (14 ounce) can coconut milk",
    "1 teaspoon vanilla extract",
    "potato starch or kinako for rolling"
  ],
  "steps": [
    {
      "text": "Generously spray a 9x13-inch microwave-safe dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sweet rice flour and sugar in a bowl. Add water, coconut milk, and vanilla. Stir until smooth. Pour into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on high until batter sets, about 18 minutes. If the center of cake is still sticky, microwave until no longer sticky in increments of 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a cooling rack. Cool for about 90 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut cake into 16 pieces and roll in potato starch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
