  "title": "Grilled Spiral Chicken Skewers",
  "description": "Chicken breast is coated with a savory marinade of Dijon mustard, parsley, and basil and grilled on skewers in this easy make-ahead recipe.",
  "authors": [
    "Cindy Larkins"
  ],
  "date_published": "2018-11-28T20:50:02-05:00",
