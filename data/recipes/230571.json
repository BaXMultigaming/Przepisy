  "ingredients": [
    "6 large pears, peeled and sliced",
    "1 lemon, juiced",
    "0.66666668653488 cup white sugar",
    "0.5 teaspoon grated nutmeg",
    "1 (9 inch) unbaked single pie crust",
    "0.5 cup butter",
    "0.5 cup brown sugar",
    "1 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle pears with lemon juice in a bowl. Mix white sugar and nutmeg in a separate small bowl; sprinkle over pears and mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fit pie crust into the bottom of a 9-inch pie dish. Cut butter, brown sugar, and flour together in a bowl using a pastry cutter until mixture resembles crumbs. Spoon pear mixture into pie shell and sprinkle top with brown sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Reduce oven temperature to 350 degrees F (175 degrees C) and bake until filling is bubbling and crumble topping is lightly browned, about 35 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
