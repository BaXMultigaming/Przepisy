  "ingredients": [
    "1 (7 pound) bone-in pork butt",
    "0.75 cup teriyaki sauce",
    "0.25 cup apple cider vinegar",
    "0.25 cup pineapple juice",
    "2 teaspoons minced garlic",
    "1 teaspoon ground black pepper",
    "1 teaspoon crushed red pepper flakes"
  ],
  "steps": [
    {
      "text": "Place pork butt in the bottom of a slow cooker and turn heat to High.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk teriyaki sauce, vinegar, pineapple juice, garlic, pepper, and red pepper flakes together in a bowl. Pour sauce over the pork. Cook on High for 9 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pork to a large baking pan and let sit for 20 minutes. Shred the pork using 2 forks. Ladle in some of the cooking liquid if pork is too dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
