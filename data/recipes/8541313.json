  "ingredients": [
    "2 tablespoons freshly grated Parmesan cheese, divided",
    "2 tablespoons shredded mozzarella cheese, divided",
    "0.5 (8 ounce) tub cream cheese, softened",
    "0.33 cup pizza sauce, purchased or homemade",
    "8 ounces pepperoni, chopped",
    "2 tablespoons butter, melted",
    "0.25 cup panko bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Parmesan cheese and mozzarella cheese in a small bowl. Mix together cream cheese, 1/2 of cheese mixture, and pizza sauce in a bowl until thoroughly blended. Pour into a small baking dish, spreading out evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with pepperoni pieces, and sprinkle remaining cheese mixture on top. Mix panko and butter together in a small bowl and distribute on top of the dip.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the oven on broil and broil until the top is golden brown or to your liking, 1 to 2 minutes. Remove from oven and let cool about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
