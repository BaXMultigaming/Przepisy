  "ingredients": [
    "0.75 cup milk",
    "6 ice cubes",
    "1 tablespoon white sugar",
    "1 teaspoon instant coffee granules",
    "1 teaspoon cocoa powder, or more to taste",
    "0.5 teaspoon vanilla extract, or more to taste",
    "1 tablespoon chocolate syrup",
    "1 tablespoon whipped cream"
  ],
  "steps": [
    {
      "text": "Blend milk, ice cubes, sugar, instant coffee granules, cocoa powder, and vanilla extract in a blender until smooth.",
      "section": null,
