  "ingredients": [
    "0.5 (12 ounce) bottle olive oil",
    "0.25 cup lemon juice",
    "0.25 cup soy sauce",
    "2 tablespoons chopped fresh parsley",
    "2 teaspoons minced garlic",
    "1 teaspoon dried dill",
    "ground black pepper to taste",
    "2 pounds swordfish steaks"
  ],
  "steps": [
    {
      "text": "Whisk olive oil, lemon juice, soy sauce, parsley, garlic, dill, and pepper together in a large glass or ceramic bowl. Add swordfish and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for 1 to 4 hours; the longer you marinate the fish, the stronger the flavor will be.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to cook, preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove swordfish from the marinade and shake off excess. Discard the remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook swordfish on the preheated grill until fish is tender and flakes easily with a fork, about 4 minutes per side. Swordfish cooks very quickly and your grill will flare up with this marinade!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
