  "ingredients": [
    "1 (18.25 ounce) package white cake mix",
    "0.5 cup vegetable oil",
    "2 eggs",
    "1 (14 ounce) can sweetened condensed milk",
    "1 cup milk chocolate chips",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cake mix, oil, and eggs in a large bowl using a fork until just blended. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine condensed milk, chocolate chips, and butter in a saucepan over medium heat; cook and stir until melted and smooth, 2 to 4 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press 1/2 of the cake mixture into a 9x13-inch dish; pour chocolate mixture over cake mixture. Take a small handful of remaining cake mixture and flatten between your hands; lay atop chocolate layer. Repeat with remaining cake mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is lightly browned, about 20 minutes. Cool completely before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
