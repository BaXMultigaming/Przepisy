  "ingredients": [
    "3 large eggs, beaten",
    "1/4 cup chopped onion",
    "2 tablespoons olive oil",
    "1/2 teaspoon cayenne, or to taste",
    "1/4 teaspoon ground turmeric",
    "1/4 teaspoon ground black pepper",
    "salt to taste",
    "3 sprigs cilantro, finely chopped"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a nonstick frying pan over medium heat; add onions and cook and stir until translucent, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in beaten eggs. Sprinkle in cayenne, turmeric, pepper, and salt. Keep moving the omelet to avoid burning. Once the edges of the omelet are light brown, flip the omelet over, and cook until fully set, at least 5 minutes, continually moving it in the pan. Flip again, sprinkle with cilantro, and serve warm.",
