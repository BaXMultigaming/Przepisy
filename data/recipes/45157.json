  "ingredients": [
    "8 large eggs",
    "1 (15 ounce) can sliced beets with liquid",
    "0.5 cup white vinegar",
    "0.5 cup white sugar",
    "0.5 cup water",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggs in a saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove from hot water, cool, and peel. Place eggs in a glass or plastic container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beets, vinegar, sugar, water, and cinnamon in a saucepan. Bring to a boil; stir until sugar is dissolved. Pour over eggs. Cover and chill for 4 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
