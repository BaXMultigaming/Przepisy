  "ingredients": [
    "2 (3 ounce) packages any flavor ramen noodles",
    "0.5 cup sunflower seeds",
    "1 (16 ounce) package broccoli coleslaw mix",
    "0.5 cup chopped fresh pineapple",
    "0.5 cup chopped fresh cilantro",
    "2 green onions (white and green parts), chopped, or more to taste",
    "0.5 cup white sugar",
    "0.5 cup cider vinegar",
    "0.5 cup olive oil",
    "0.5 teaspoon sesame oil",
    "0.5 teaspoon freshly ground black pepper",
    "2 pinches cayenne pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Crush ramen noodles and set seasoning packets aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-low heat. Cook and stir crushed ramen noodles and sunflower seeds in the hot skillet until toasted and fragrant, 5 to 10 minutes. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine broccoli coleslaw mix, pineapple, cilantro, and green onions in a large serving bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make dressing: Whisk together sugar, vinegar, olive oil, sesame oil, black pepper, cayenne pepper, and ramen seasoning packets in a medium bowl until smooth. Pour over slaw mixture; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in toasted ramen noodles and sunflower seeds just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
