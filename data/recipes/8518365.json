  "ingredients": [
    "3 tablespoons unsalted butter",
    "8 ounces white mushrooms, sliced",
    "1 medium shallot, minced",
    "2 cloves garlic, crushed",
    "1 teaspoon crushed dried rosemary",
    "3 tablespoons all-purpose flour",
    "0.75 cup Marsala wine",
    "1 cup beef broth, or more as needed",
    "2 tablespoons port wine",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium-low heat. Add mushrooms, shallot, garlic, and rosemary and cook, stirring occasionally, until mushrooms are tender, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle flour over the mushroom mixture and cook, stirring constantly, for 1 minute. Deglaze the pan by pouring in the marsala, and cook for about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase heat to medium, stir in beef broth and port, and cook until sauce starts to reduce and thicken to your preference, 10 to 12 minutes. Season with salt and pepper, taste, and adjust any of the ingredients to your liking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
