  "ingredients": [
    "1 cup butter",
    "0.25 cup unsweetened cocoa powder",
    "1 cup cola-flavored carbonated beverage",
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "1 teaspoon baking soda",
    "0.5 cup buttermilk",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1.5 cups miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Heat to boiling: butter, cocoa and cola drink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and add flour, sugar, baking soda and mix gently. Stir in buttermilk, eggs, vanilla and marshmallows.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into greased 13 x 9-inch pan. Bake at 350 degrees F (175 degrees C) for 30 to 35 minutes. Cake can be frosted while warm. Makes 10 to 12 servings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
