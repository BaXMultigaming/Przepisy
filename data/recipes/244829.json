  "title": "Santa Sugar Cookies",
  "description": "These Santa Claus cookies are decorated with red and white icing to create a face and bright red hat. A fun whipped beard is added just before serving.",
  "authors": [
    "Pam Cooking Spray"
  ],
  "date_published": "2015-08-27T19:31:10-04:00",
  "date_modified": "2026-01-20T15:59:02-05:00",
