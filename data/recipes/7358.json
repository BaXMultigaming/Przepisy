  "title": "Melt in Your Mouth Blueberry Cake",
  "description": "This blueberry cake recipe makes a super moist, tender cake bursting with delicious blueberry flavor — a lovely treat to take along to a summer picnic.",
  "authors": [
    "irenedee"
  ],
  "date_published": "1998-04-08T23:27:34-04:00",
