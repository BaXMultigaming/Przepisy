  "ingredients": [
    "0.5 cup butter",
    "0.75 cup white sugar, divided",
    "0.25 teaspoon salt",
    "1 teaspoon vanilla extract",
    "2 egg yolks",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.33333334326744 cup milk",
    "1.5 cups fresh blueberries",
    "1 tablespoon all-purpose flour",
    "2 egg whites",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C). Grease and flour an 8-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5_LErjxN02lSnOIsba3pIlus3XY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7358-melt-in-your-mouth-blueberry-cake-ddmfs-0561-3x4-step-01-5dc247e9de91443ba2eb2e2b1d8cb466.jpg"
      ],
      "image": "assets/images/7358/step_01.webp"
    },
    {
      "text": "Beat butter and 1/2 cup sugar together in a large bowl with an electric mixer until soft and fluffy; mix in vanilla and salt. Add egg yolks and beat until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Wdh6ZHo7y6ngor61BtENukbUD_I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7358-melt-in-your-mouth-blueberry-cake-ddmfs-0601-3x4-step-02-d29308644a22426bbf7f21d862979e6c.jpg"
      ],
      "image": "assets/images/7358/step_02.webp"
    },
    {
      "text": "Combine 1 ½ cups flour and baking powder in a bowl; add alternately with milk to creamed mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uSVmyjqssZlgShf0HA8SwAiaBPA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7358-melt-in-your-mouth-blueberry-cake-ddmfs-0605-3x4-step-03-ab7d4b4a3702421dad7c7a3e4536ebfc.jpg"
      ],
      "image": "assets/images/7358/step_03.webp"
    },
    {
      "text": "Toss blueberries with 1 tablespoon flour in a small bowl. Add to the batter and fold in gently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aghJKH8uEObvE9vra4qi_29nbC4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7358-melt-in-your-mouth-blueberry-cake-ddmfs-0609-3x4-step-04-b8d7b3c6943f4abe80cd7d8483de0484.jpg"
      ],
      "image": "assets/images/7358/step_04.webp"
    },
    {
      "text": "Beat egg whites in a separate bowl until soft peaks form. Add remaining 1/4 cup of sugar, 1 tablespoon at a time, and beat until stiff peaks form. Fold egg whites into cake batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gibCd-IdR7GZLuQgxYwvH7lbOw0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7358-melt-in-your-mouth-blueberry-cake-ddmfs-0615-3x4-step-05-ddd2c65e9ef440c098bd6323f58ebade.jpg"
      ],
      "image": "assets/images/7358/step_05.webp"
    },
    {
      "text": "Pour batter into the prepared pan. Sprinkle remaining 1 tablespoon sugar over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jdZJ2-iwbd6M8FM6LUzEtnGO7mU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7358-melt-in-your-mouth-blueberry-cake-ddmfs-0620-3x4-step-06-467afbb5c45549ac9aa4b6fbc55df03d.jpg"
      ],
      "image": "assets/images/7358/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/25GwixBkB7G9wSdecALzG1JV88I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7358-melt-in-your-mouth-blueberry-cake-ddmfs-0562-3x4-step-07-9cbb268944984a25a87bf536226e3a62.jpg"
      ],
      "image": "assets/images/7358/step_07.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1exH_x42QpzHPKFN8a8l6CouCuo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7358-melt-in-your-mouth-blueberry-cake-ddmfs-0595-3x4-hero-9ce903d39b2344409cd68ad8eb81173f.jpg"
      ],
      "image": "assets/images/7358/step_08.webp"
    }
