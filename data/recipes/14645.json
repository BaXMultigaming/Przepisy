  "ingredients": [
    "8 ounces cream cheese",
    "3 ounces dried beef",
    "2 green onions, chopped",
    "1 tablespoon Worcestershire sauce",
    "1.25 teaspoons monosodium glutamate (MSG)",
    "0.25 teaspoon onion salt",
    "1/3 cup bacon bits"
  ],
