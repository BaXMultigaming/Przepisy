  "ingredients": [
    "1 pound (1/2-inch thick) pork chops",
    "kosher salt to taste",
    "freshly ground black pepper",
    "1 tablespoon olive oil",
    "1 cup barbeque sauce",
    "0.5 cup brown sugar",
    "2 limes, juiced",
    "1 teaspoon garlic powder",
    "1 tablespoon chopped parsley, or to taste"
  ],
  "steps": [
    {
      "text": "Season pork chops on both sides with salt and pepper. Heat olive oil in a large skillet over medium heat. Add pork chops in a single layer; cook until golden, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk barbecue sauce, brown sugar, lime juice, and garlic powder together in a bowl; pour over seared pork chops and bring to a boil. Reduce heat to medium, cover, and simmer until pork chops cooked through, 4 to 5 minutes. Garnish with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
