  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "0.5 cup confectioners’ sugar",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "6 Earl Grey tea bags",
    "0.5 cup unsalted butter, melted halfway",
    "2 eggs",
    "1 teaspoon water",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly spray a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, white sugar, confectioners' sugar, baking soda, and salt in a large bowl. Cut open tea bags and mix tea leaves evenly into the flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add butter, eggs, water, and vanilla extract to the flour mixture. Mix with an electric mixer or rubber spatula until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into balls and shape into 2-inch cookies on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are light brown, about 12 minutes. Cool cookies for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
