  "ingredients": [
    "cooking spray",
    "3 quarts cold water",
    "0.33333334326744 cup balsamic vinegar",
    "0.25 cup salt",
    "1 bay leaf",
    "1 teaspoon dried thyme",
    "1 teaspoon dried oregano",
    "1 teaspoon dried rosemary",
    "8 cloves garlic, minced",
    "1 pinch salt",
    "3 tablespoons olive oil, or as needed",
    "1 tablespoon freshly ground black pepper",
    "2 teaspoons red pepper flakes, or to taste",
    "4 pounds chicken wings, separated at joints, tips discarded",
    "2 tablespoons fine bread crumbs",
    "1 cup finely grated Parmigiano-Reggiano cheese, divided"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 450 degrees F (230 degrees C). Line a baking sheet with aluminum foil and coat foil with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, vinegar, 1/4 cup salt, bay leaf, thyme, oregano, and rosemary in a large stockpot and bring to a boil. Add chicken wings, return to a boil, and cook for 15 minutes. Remove chicken wings with a slotted spoon to a cooling rack and allow to dry for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IjoYFa_lMi1PlbUlFtpFtouGK8o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231008-garlic-and-parmesan-chicken-wings-ddmfs-step1-09-4x3-958b88aeb13e4fab9813ca3a9a5efcac.jpg"
      ],
      "image": "assets/images/231008/step_02.webp"
    },
    {
      "text": "Mash garlic and a pinch of salt together in a mortar and pestle until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9-SiYfq1U9CW6sQWCCBxxt7Y7os=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231008-garlic-and-parmesan-chicken-wings-ddmfs-step2-21-4x3-36b37c65fc1e4bd792961d8e9c7685c9.jpg"
      ],
      "image": "assets/images/231008/step_03.webp"
    },
    {
      "text": "Combine mashed garlic, olive oil, black pepper, and red pepper flakes in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BhPMCyWAGzNPJrswD7MSpNVDrsM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231008-garlic-and-parmesan-chicken-wings-ddmfs-step3-26-4x3-34e3fcb9b3d14429bfa52bdb78e2fe88.jpg"
      ],
      "image": "assets/images/231008/step_04.webp"
    },
    {
      "text": "Add chicken wings and bread crumbs; toss to coat. Sprinkle with 1/2 cup Parmigiano-Reggiano cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2qW3Y_oBaDUPgn90AW8sFB17S1I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231008-garlic-and-parmesan-chicken-wings-ddmfs-step4-29-4x3-8f8f5eb8566a4764922399fc53e95e81.jpg"
      ],
      "image": "assets/images/231008/step_05.webp"
    },
    {
      "text": "Transfer to the prepared baking sheet and sprinkle with remaining 1/2 cup Parmigiano-Reggiano cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1um51MUOu4zKDOFI3ZUsTvUT334=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231008-garlic-and-parmesan-chicken-wings-ddmfs-step5-33-4x3-640b3e9ebb3a4c22a7940f41379c1392.jpg"
      ],
      "image": "assets/images/231008/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until browned, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sitlsuziJa5npHkbtjSZD5Lpftw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231008-garlic-and-parmesan-chicken-wings-ddmfs-step7-39-4x3-cfbcd6cbfc764cb9bfb7c685c367b1de.jpg"
      ],
      "image": "assets/images/231008/step_07.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PkU7Yb0Gz9WhCoLDig_tfdXxuYA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231008-garlic-and-parmesan-chicken-wings-DDMFS-4x3-a551526946e84996ac9359a5adbf86b5.jpg"
      ],
      "image": "assets/images/231008/step_08.webp"
