  "ingredients": [
    "2 large eggs, beaten",
    "2 tablespoons Sriracha sauce",
    "1 pound raw shrimp, peeled and deveined",
    "2 cups panko bread crumbs",
    "1 tablespoon Cajun seasoning",
    "2 cups vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Combine eggs and Sriracha in a bowl and beat with a fork until well combined. Coat shrimp in egg batter, a few shrimp at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour panko into a shallow dish and mix in Cajun seasoning. Dredge shrimp in panko mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a Dutch oven or cast iron skillet over medium heat until hot. Add shrimp in batches without overcrowding the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook shrimp until panko is golden brown and the meat is opaque, about 3 minutes, depending on the size.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
