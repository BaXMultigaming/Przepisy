  "ingredients": [
    "2 skinless, boneless chicken breasts",
    "0.5 teaspoon garlic powder, or to taste",
    "salt and ground black pepper to taste",
    "1 (15.25 ounce) can white corn kernels, drained",
    "1 (15 ounce) can black beans, drained",
    "1.5 cups cooked long-grain white rice",
    "0.75 cup chopped lettuce",
    "0.5 cup sour cream",
    "0.5 cup shredded Monterey Jack cheese",
    "0.33333334326744 (8 ounce) jar salsa"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken breasts with garlic powder, salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook chicken on the preheated grill until no longer pink in the center and cooked through, about 6 minutes per side. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C). Cut chicken into strips or bite-sized pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat corn and black beans in two separate saucepans over medium-low heat, covered, until heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer cooked rice, corn, black beans, and chicken on two serving plates. Top with lettuce, sour cream, Monterey Jack cheese, and salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
