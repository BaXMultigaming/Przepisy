  "ingredients": [
    "1 (12 ounce) bag fresh cranberries, rinsed and sorted",
    "1 cup white sugar",
    "1 cup orange juice",
    "1 teaspoon orange zest",
    "0.25 teaspoon ground cloves",
    "2 cinnamon sticks",
    "1 pomegranate, peeled and seeds separated"
  ],
  "steps": [
    {
      "text": "Mix the cranberries, sugar, orange juice, orange zest, ground cloves, and cinnamon sticks together in a saucepan. Bring to a boil. Lower heat to medium, and simmer for 10 minutes, stirring constantly. Remove from the heat and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the pomegranate seeds into the cranberry mixture, and refrigerate at least 8 hours or overnight. Remove the cinnamon sticks before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
