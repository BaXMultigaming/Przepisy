  "ingredients": [
    "1 pound watermelon, seeded and cut into chunks",
    "1 (8 ounce) can water chestnuts, drained and halved",
    "1.75 ounces sesame seeds, or as desired",
    "1 teaspoon salt",
    "0.5 bunch garlic chives, finely chopped",
    "0.5 bunch fresh cilantro leaves, chopped",
    "0.25 cup raspberry vinegar",
    "2 tablespoons white sugar",
    "1 teaspoon sesame oil",
    "1 dash fish sauce"
  ],
  "steps": [
    {
      "text": "Combine the watermelon, water chestnuts, sesame seeds, salt, garlic chives, and cilantro in a large mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk the raspberry vinegar, white sugar, sesame oil, and fish sauce together in a small bowl; pour over the watermelon salad mixture and gently toss to coat evenly. Chill in refrigerator 1 hour to serve chilled.",
      "section": null,
