  "ingredients": [
    "2 pounds beef skirt steak",
    "2 tablespoons olive oil",
    "1 tablespoon steak seasoning",
    "2 heads romaine, chopped",
    "2 ears corn, kernels cut from cob",
    "1 large avocado, diced",
    "4 mini sweet peppers, sliced",
    "1 cup grape tomatoes, sliced",
    "0.5 cup Greek yogurt",
    "0.25 cup chopped fresh cilantro",
    "2 tablespoons lime juice",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Rub steak with olive oil and steak seasoning. Place in a slow cooker and cover. Cook on Low until tender, about 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steak and let cool slightly. Slice or pull apart with forks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss romaine, corn, avocado, mini peppers, and tomatoes together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend yogurt, cilantro, lime juice, and salt in a food processor or blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place steak pieces onto the salad and drizzle dressing on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
