  "ingredients": [
    "1.25 pounds carrots, cut into matchsticks",
    "0.5 cup mayonnaise",
    "2 tablespoons grated onion",
    "2 tablespoons freshly ground horseradish",
    "0.5 teaspoon salt (scant)",
    "0.25 teaspoon ground black pepper (scant)",
    "0.25 cup dry seasoned bread crumbs",
    "2 tablespoons melted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place carrots in a pot and add water to cover. Bring to a boil. Reduce heat to a simmer and cook until tender, 6 to 8 minutes. Drain carrots, reserving 1/4 cup of the cooking liquid. Transfer carrots to a shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix reserved cooking water, mayonnaise, onion, horseradish, salt, and pepper together in a small bowl until combined; pour over carrots.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, toss bread crumbs in melted butter. Sprinkle over carrots and bake until crumb topping is crisp, an additional 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
