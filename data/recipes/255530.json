  "ingredients": [
    "cooking spray",
    "3 McIntosh apples, cored and sliced",
    "2 teaspoons ground cinnamon, divided",
    "0.75 cup all-purpose flour",
    "0.5 cup white sugar",
    "0.5 cup brown sugar, divided",
    "0.25 cup rolled oats",
    "0.25 cup water",
    "1 egg, beaten",
    "1 tablespoon melted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange apples in the bottom of the prepared baking dish; sprinkle with 1/2 teaspoon cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, white sugar, 1/4 cup brown sugar, oats, and 1/2 teaspoon cinnamon together in a bowl. Stir in water and egg until smooth. Spread batter evenly over apple mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix remaining 1/4 cup brown sugar and remaining 1 teaspoon cinnamon together in a bowl; sprinkle over batter. Dot with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
