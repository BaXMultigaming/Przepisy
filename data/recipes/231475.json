  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "4 large eggs",
    "1 cup hot water",
    "0.5 cup vegetable oil",
    "1 (3 ounce) package instant lemon pudding mix",
    "0.25 cup poppy seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cake mix, eggs, hot water, vegetable oil, pudding mix, and poppy seeds together in a large bowl with an electric mixer on low until blended, about 4 minutes. Pour into lined muffin cups to about 1/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and the tops spring back when lightly pressed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
