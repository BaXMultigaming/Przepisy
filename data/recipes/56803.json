  "ingredients": [
    "1 cup milk",
    "0.75 cup sugar",
    "2 tablespoons unsweetened cocoa powder",
    "0.25 teaspoon salt",
    "3 egg yolk, lightly beaten",
    "2 ounces semisweet chocolate, chopped",
    "2 cups heavy cream",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6r3OXBBjB1nwMHjZ7lFtul_oAhM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-56803-very-chocolate-ice-cream-Step-01-1a89c5e18ea54ac1aa2ab19976631121.jpg"
      ],
      "image": "assets/images/56803/step_01.webp"
    },
    {
      "text": "Combine milk, sugar, cocoa powder, and salt in a saucepan over medium heat. Bring to a simmer, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TAdH5DgEhA-qg1eZGdjag5HFgug=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-56803-very-chocolate-ice-cream-Step-02-49297144e2e34b9685a0714e3b77ab9c.jpg"
      ],
      "image": "assets/images/56803/step_02.webp"
    },
    {
      "text": "Place egg yolks into a small bowl. Gradually whisk in about 1/2 cup of hot milk mixture, then return to the saucepan. Heat and stir until thickened, but do not boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hXK_jGTphWnA7Oxvwb24H76ONkI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-56803-very-chocolate-ice-cream-Step-03-a9646156db5248ec9bd2bedbed65040e.jpg"
      ],
      "image": "assets/images/56803/step_03.webp"
    },
    {
      "text": "Remove from the heat and stir in chopped chocolate until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6qYA5QW4Tojrj_JZZoi0HRARfHg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-56803-very-chocolate-ice-cream-Step-04-d8fb3d025482426e804bc11d02613604.jpg"
      ],
      "image": "assets/images/56803/step_04.webp"
    },
    {
      "text": "Pour into a chilled bowl and refrigerate, stirring occasionally, until cold, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XChqf3KqDMqLYHRpOV61TEJmFek=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-56803-very-chocolate-ice-cream-Step-05-ddba0483b76b4b8a83ebc832098f08b8.jpg"
      ],
      "image": "assets/images/56803/step_05.webp"
    },
    {
      "text": "Stir in cream and vanilla. Pour mixture into an ice cream maker and freeze according to manufacturer’s instructions, about 20 minutes. Transfer ice cream to an airtight container and freeze until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qU9RzlqCysXOoaH-urHNCCQLXLs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-56803-very-chocolate-ice-cream-Beauties-4x3-0343db03e550403aaab1a0d52cbef744.jpg"
