  "ingredients": [
    "3 cups all-purpose flour",
    "1 tablespoon ground cinnamon",
    "2 teaspoons baking soda",
    "1.5 teaspoons ground cloves",
    "1 teaspoon ground ginger",
    "0.75 teaspoon salt",
    "1.5 cups white sugar",
    "1 cup vegetable oil",
    "1 cup dark molasses",
    "0.5 cup apple juice",
    "2 eggs",
    "1 tablespoon grated fresh ginger",
    "0.5 cup chopped crystallized ginger"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter and flour a 10 inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, cinnamon, cloves, ground ginger, baking soda, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix sugar with oil, juice, molasses, eggs, and fresh ginger in a large bowl. Mix in crystallized ginger. Stir in flour mixture. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour, or until cake tester comes out clean. Run a knife around the edge to loosen cake, and release pan sides. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
