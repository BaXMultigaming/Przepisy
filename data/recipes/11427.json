  "ingredients": [
    "0.5 cup butter, softened",
    "1 cup white sugar",
    "2 (2 ounce) packages liquid unsweetened baker's chocolate",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon baking soda",
    "1.5 cups all-purpose flour",
    "0.5 cup white chocolate chips",
    "1.25 cups semi-sweet chocolate chips",
    "0.25 cup milk chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, sugar and pre-melted chocolate. Stir in eggs and vanilla; beat until smooth. Sprinkle baking soda over mixture. Slowly blend in the flour. Fold in the white chocolate, semi-sweet and milk chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop the dough by tablespoons onto a lightly greased cookie sheet (or parchment paper) about 1 inch apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 8 to 10 minutes. Be careful not to overbake! Let the cookies cool on the cookie sheet for about 10 minutes, then place them on a wire rack to finish cooling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
