  "ingredients": [
    "1 (15.25 ounce) package white cake mix",
    "1 (3 ounce) package strawberry-flavored gelatin mix (such as Jell-O®)",
    "1 cup vegetable oil",
    "4 large eggs",
    "0.75 cup mashed fresh strawberries",
    "3 tablespoons all-purpose flour",
    "0.5 (16 ounce) package powdered sugar",
    "0.75 stick unsalted butter, melted",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour three 8-inch cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, gelatin mix, oil, eggs, strawberries, and flour in a large mixing bowl. Pour equal amounts into the prepared cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 30 minutes. Remove from the oven and allow to cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While cakes are cooling, mix confectioners’ sugar, butter, and vanilla together in a bowl by hand. Chill for about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip chilled frosting until fluffy. Sandwich cake layers together with some frosting. Spread remaining frosting over the top and sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
