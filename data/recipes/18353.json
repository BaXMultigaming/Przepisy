  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 cup vegetable oil",
    "2 tablespoons cold milk",
    "1.5 teaspoons white sugar",
    "1 teaspoon salt",
    "6 Fuji apples, cored and sliced",
    "0.75 cup white sugar",
    "3 tablespoons all-purpose flour",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 cup all-purpose flour",
    "0.5 cup white sugar",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Crust: In a large bowl, mix together 1 1/2 cups flour, oil, milk, 1 1/2 teaspoons sugar and salt until evenly blended. Pat mixture into a 9 inch pie pan, spreading the dough evenly over the bottom and up sides. Crimp edges of the dough around the perimeter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Filling: Mix together 3/4 cup sugar, 3 tablespoons flour, cinnamon, and nutmeg. Sprinkle over apples and toss to coat. Spread evenly in unbaked pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Topping: Using a pastry cutter, mix together 1/2 cup flour, 1/2 cup sugar and butter until evenly distributed and crumbly in texture. Sprinkle over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put pie in the oven on a cookie sheet to catch the juices that may spill over. Bake 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
