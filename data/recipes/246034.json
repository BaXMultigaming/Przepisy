  "ingredients": [
    "1 cup whole wheat flour",
    "0.25 teaspoon baking soda",
    "0.125 teaspoon salt",
    "0.66666668653488 cup white sugar",
    "0.33333334326744 cup brown sugar",
    "0.33333334326744 cup mashed banana",
    "7 tablespoons unsweetened cocoa powder",
    "5 tablespoons coconut oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine both sugars in a saucepan with mashed banana. Set over low heat and stir in cocoa powder and coconut oil. Cook and stir until blended and smooth, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour mixture to the pan and stir until a smooth dough forms. Drop spoonfuls of dough 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
