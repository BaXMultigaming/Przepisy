  "ingredients": [
    "2 teaspoons olive oil, or as needed",
    "1 red bell pepper, chopped",
    "1 tablespoon minced garlic, or to taste",
    "salt and ground black pepper to taste",
    "1 pound green beans, cut into 1-inch pieces",
    "0.25 cup white wine",
    "0.25 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a skillet over medium heat. Stir red bell pepper and garlic into hot oil; season with salt and black pepper. Cook and stir until the bell pepper is tender, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir green beans with bell pepper. Pour white wine over the green bean mixture. Place a cover on the skillet and cook until the green beans are tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the green bean mixture. Sprinkle feta cheese over the mixture. Replace cover and continue cooking until the feta softens, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
