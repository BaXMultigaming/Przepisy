  "ingredients": [
    "cooking spray",
    "1 (4 ounce) Japanese eggplant, ends trimmed",
    "1 small yellow onion",
    "0.25 cup extra-virgin olive oil",
    "1 tablespoon minced garlic",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a sheet pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice eggplant into 1-inch thick slices, then quarter the slices. Chop onion in half, then quarter the halves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggplant and onion on the prepared sheet pan. Drizzle with olive oil, then sprinkle with garlic, salt, and pepper. Toss with your hands until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and tender, about 40 minutes, tossing halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
