  "ingredients": [
    "2 cups fresh blackberries",
    "2 tablespoons white sugar",
    "1 fluid ounce blackberry schnapps",
    "0.25 lemon, juiced, or to taste"
  ],
  "steps": [
    {
      "text": "Place blackberries in a small saucepan; mash gently with a fork. Stir sugar, schnapps, and lemon juice into mashed blackberries; cook, stirring constantly, over medium heat until blackberries break down and mixture begins to boil, 5 to 10 minutes. Cool slightly before serving.",
