  "ingredients": [
    "0.5 cup red wine vinegar",
    "0.33333334326744 cup honey",
    "1 tablespoon stone-ground mustard",
    "1 tablespoon lime juice",
    "0.75 teaspoon ground black pepper",
    "0.75 teaspoon salt",
    "1.25 teaspoons smoked paprika",
    "1 clove garlic",
    "2 tablespoons chopped onion",
    "0.25 teaspoon oregano",
    "1 pinch white sugar",
    "0.5 cup olive oil"
  ],
  "steps": [
    {
      "text": "Blend red wine vinegar, honey, mustard, lime juice, pepper, salt, paprika, garlic, onion, oregano, and sugar together in a blender until thoroughly mixed. Drizzle olive oil into mixture while blending on low. Chill at least 1 hour before serving.",
