  "ingredients": [
    "1 cup butter",
    "2 leeks, sliced",
    "salt and pepper to taste",
    "1 tablespoon cornstarch",
    "1 quart chicken broth",
    "4 cups Yukon Gold potatoes, peeled and diced",
    "2 cups heavy cream"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium heat. Add leeks and season to taste with salt and pepper; cook and stir until leeks are tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
