  "title": "Granola-Chocolate Cookies",
  "description": "This is a sweet crunchy cookie with chocolate chips and granola. Easy to make and quick to satisfy.",
  "authors": [
    "k anderson"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
