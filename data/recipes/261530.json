  "ingredients": [
    "1.5 pounds ground bison",
    "1 cup milk",
    "0.5 cup Italian seasoned bread crumbs",
    "0.5 cup chopped green chile peppers",
    "0.5 cup bacon bits",
    "1 large egg, beaten",
    "1.5 teaspoons liquid smoke flavoring",
    "1 teaspoon onion powder",
    "0.5 teaspoon dry mustard",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon ground sage",
    "0.75 cup barbeque sauce, or more to taste"
