  "ingredients": [
    "2 tablespoons olive oil",
    "1 small onion, diced",
    "3 eggs",
    "1 cup heavy cream",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon dried oregano",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 (9 inch) pie crust",
    "0.75 cup mozzarella cheese, shredded",
    "0.75 cup Cheddar cheese, shredded"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium high heat. Add onion and saute until soft, about 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat together eggs, cream, basil, oregano, salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon the onions into the pie crust. Pour the egg mixture over the onions. Sprinkle shredded cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into center of the quiche comes out clean, about 30 to 40 minutes. Let cool slightly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
