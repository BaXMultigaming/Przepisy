  "ingredients": [
    "8 cups orange blossom honey",
    "5 cups water",
    "2 cups white wine vinegar",
    "12 large sprigs fresh mint"
  ],
  "steps": [
    {
      "text": "Stir honey and water together in a pot; bring to a boil and stir constantly until honey dissolves. Add vinegar, reduce heat to low, and simmer until syrup flavors combine, about 20 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Submerge mint in hot syrup and cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and discard mint. Chill syrup in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
