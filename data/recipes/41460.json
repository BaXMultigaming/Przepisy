  "ingredients": [
    "2 cups frozen whole-kernel corn, thawed",
    "0.5 cup water",
    "0.5 cup cornmeal",
    "0.33333334326744 cup white sugar",
    "5 tablespoons margarine, softened",
    "0.25 cup masa harina",
    "4 teaspoons milk",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Blend 1 cup corn kernels, water, and cornmeal in a blender or food processor just until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, margarine, and masa harina together in a medium bowl until light and fluffy. Stir in blended corn mixture. Mix in remaining 1 cup corn, milk, baking powder, and salt until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour tomalito batter into the top of a double boiler over simmering water, and cover tightly with aluminum foil. Steam until firm, 50 to 60 minutes, checking water level occasionally and refilling if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pudding before serving to give it a consistent texture. Serve in small scoops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
