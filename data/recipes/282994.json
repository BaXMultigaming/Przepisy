  "ingredients": [
    "1 cup finely shredded carrots",
    "0.5 cup quick-cooking steel-cut oats",
    "0.25 cup flax seed meal",
    "0.25 cup peanut butter",
    "3 tablespoons honey",
    "2 tablespoons chopped walnuts",
    "2 tablespoons chopped raisins",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with parchment paper and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine carrots, oats, flax meal, peanut butter, honey, walnuts, raisins, vanilla, cinnamon, ginger, and salt in a bowl. Beat with a hand mixer until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll mixture into 12 equal-sized balls and place on the baking sheet. Freeze until they hold their shape, at least 1 hour. Transfer to a freezer-safe container and store in the freezer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
