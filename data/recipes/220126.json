  "ingredients": [
    "2 tablespoons butter",
    "8 ounces andouille sausage, cut into 1/4-inch slices",
    "2 tablespoons ground paprika",
    "1 tablespoon ground cumin",
    "0.5 teaspoon cayenne pepper",
    "0.5 cup diced tomatoes",
    "2 stalks celery, sliced 1/4 inch thick",
    "1 large green bell pepper, diced",
    "4 green onions, thinly sliced",
    "1 teaspoon salt",
    "1 bay leaf",
    "1 cup uncooked brown rice",
    "3 cups chicken stock",
    "1 pound large shrimp, peeled and deveined",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3R7vmZtiAUEKLbAn94VoIq9U5q0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220126-chef-johns-sausage-shrimp-jambalaya-DDMFS-Step-1-1d59b101c3834f408edbca412c9b95b4.jpg"
      ],
      "image": "assets/images/220126/step_01.webp"
    },
    {
      "text": "Place butter and sausage in a large stockpot over medium heat; cook and stir until sausage begins to brown, 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PL14c0mCFK8iCn6he3BmI6CkzE0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220126-chef-johns-sausage-shrimp-jambalaya-DDMFS-Step-2-d5d7c6c9b2814c38b187dc6015674bc9.jpg"
      ],
      "image": "assets/images/220126/step_02.webp"
    },
    {
      "text": "Stir in paprika, cumin, and cayenne; cook for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DlldTbMDTafG6uxuFJ-ZYK2y-Xg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220126-chef-johns-sausage-shrimp-jambalaya-DDMFS-Step-3-6f80ae6369a44324add950e661caaca0.jpg"
      ],
      "image": "assets/images/220126/step_03.webp"
    },
    {
      "text": "Stir tomatoes, celery, green pepper, green onions, salt, and bay leaf into the sausage mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gw9RPkyKIgBubISCwr8XpxJeFxU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220126-chef-johns-sausage-shrimp-jambalaya-DDMFS-Step-4-3ce640b271fe45c9baed026049ae1d00.jpg"
      ],
      "image": "assets/images/220126/step_04.webp"
    },
    {
      "text": "Add brown rice and stir to combine. Stir in chicken stock, bring it to a simmer, then turn heat to low. Cover and cook until rice is just tender, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sPUmpfLjueeNVa8yTfIezsDXZhI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220126-chef-johns-sausage-shrimp-jambalaya-DDMFS-Step-5-0e9e635ed502499ba33d1a5960fce994.jpg"
      ],
      "image": "assets/images/220126/step_05.webp"
    },
    {
      "text": "Stir in shrimp, replace lid and cook until shrimp are cooked through, about 5 minutes. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YvrT9Fjmfi2MpfrP6R0XPcpp_MA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220126-chef-johns-sausage-shrimp-jambalaya-DDMFS-4x3-26c26f3d4f1f4a81a6522b139204e5a9.jpg"
