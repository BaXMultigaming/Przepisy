  "ingredients": [
    "0.5 cup quick cooking oats",
    "0.5 cup honey-sweetened granola",
    "0.5 cup packed brown sugar",
    "3 tablespoons all-purpose flour",
    "0.25 cup butter",
    "5 cups fresh peaches - peeled, pitted, and sliced",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground allspice",
    "0.25 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, granola, brown sugar, and 3 tablespoons flour in a medium bowl. Cut in 1/4 cup butter until crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place peach slices into an 8-inch square baking dish. Sprinkle with remaining 1 tablespoon flour. Scatter oat mixture over peaches, then sprinkle with cinnamon, nutmeg, and allspice, followed by pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 30 minutes.",
