  "ingredients": [
    "1 tablespoon lemon juice",
    "1.5 teaspoons white sugar",
    "1 cup finely chopped strawberries",
    "1 (8 ounce) can unsweetened crushed pineapple, drained",
    "3 kiwis, peeled and finely chopped",
    "1 naval orange, peeled and cut into small pieces"
  ],
  "steps": [
    {
      "text": "Stir lemon juice and sugar together in a large bowl until sugar is dissolved; stir in strawberries, pineapple, kiwis, and orange pieces until fruit is evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl with plastic wrap; refrigerate for at least 30 minutes.",
