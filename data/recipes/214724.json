    },
    {
      "text": "Stir gelatin and hot water together in a small bowl until gelatin dissolves; pour into a saucepan. Stir in coffee and sugar; bring to a boil over high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C5LPoeGvuzdkmYDW4XDdcVbU8hg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_214724_CoffeeJelly_Step3_14615-25ae4bcbe27c4ff1bbd6f56732647f39.jpg"
      ],
      "image": "assets/images/214724/step_02.webp"
    },
    {
      "text": "Pour coffee mixture into a shallow, 9-inch square baking dish. Chill in the refrigerator until solidified, 6 to 7 hours.",
      "section": null,
      "name": null,
      "url": null,
