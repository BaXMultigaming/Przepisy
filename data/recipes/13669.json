  "title": "The World&#39;s Best Turkey",
  "description": "A bottle of champagne is the secret to this moist turkey stuffed with apples and baked in an oven bag.",
  "authors": [
    "Sarah"
  ],
  "date_published": "1998-11-21T00:04:57-05:00",
