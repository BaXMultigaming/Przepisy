  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 cup creamy peanut butter",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup milk chocolate chips",
    "1 cup semi-sweet chocolate chips",
    "1 (14 ounce) can sweetened condensed milk",
    "1 teaspoon vanilla extract",
    "0.75 cup pecan halves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking soda, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, peanut butter, and white and brown sugars. Mix in egg and 1/2 teaspoon vanilla. Stir flour mixture into creamed mixture. Shape the dough into 48 balls, 1-inch each. Place each ball in one compartment of a mini muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the filling, put chocolate chips in a double boiler over simmering water. Stir in milk and vanilla, mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 14 to 16 minutes or until lightly browned. Remove from oven and immediately make wells in the center of each using a melon baller. Cool in the pan for 5 minutes. Then carefully remove to wire racks. Using a measuring cup fill each shell with the chocolate mixture. Top with a pecan half.",
      "section": null,
      "name": null,
      "url": null,
