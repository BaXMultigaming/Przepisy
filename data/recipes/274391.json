  "ingredients": [
    "2 medium sweet potatoes",
    "0.25 cup olive oil, divided",
    "0.5 teaspoon smoked paprika",
    "0.5 teaspoon salt",
    "0.125 teaspoon garlic powder",
    "0.125 teaspoon ground cinnamon",
    "0.125 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrub sweet potatoes thoroughly under cold running water. Cut each potato lengthwise into 8 wedges. Place wedges in a bowl and toss with 2 tablespoons of oil. Combine remaining olive oil, paprika, salt, garlic powder, cinnamon, and cayenne in a separate small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place wedges on the grill perpendicular to the grates and reduce heat to low. Grill over low heat, turning occasionally, until potatoes are soft, 16 to 18 minutes. Brush wedges with oil mixture on both sides, and grill 1 to 2 minutes more, then transfer to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
