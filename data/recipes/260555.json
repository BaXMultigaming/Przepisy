  "ingredients": [
    "3.5 cups all-purpose flour",
    "2 tablespoons white sugar",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "1 quart buttermilk",
    "5 eggs",
    "0.25 cup butter, melted",
    "0.5 cup wheat germ"
  ],
  "steps": [
    {
      "text": "Mix flour, sugar, baking soda, and salt together in a large bowl. Mix in buttermilk, eggs, and melted butter. Stir wheat germ into the batter last.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly buttered griddle over medium-high heat. Drop batter by large spoonfuls onto the griddle and cook until bubbles form and the edges are dry, 2 to 3 minutes. Flip and cook until browned on the other side, 2 to 3 minutes more. Repeat with remaining batter.",
      "section": null,
