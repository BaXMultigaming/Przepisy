  "ingredients": [
    "0.5 cup finely chopped onions",
    "5 cups fresh corn kernels",
    "1 small jalapeno pepper, thinly sliced",
    "2 tablespoons flour",
    "0.33333334326744 cup milk",
    "1 large zucchini, thinly sliced",
    "0.75 cup KRAFT Shredded Triple Cheddar Cheese with a TOUCH OF PHILADELPHIA"
