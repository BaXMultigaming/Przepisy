  "ingredients": [
    "2 cups fig preserves",
    "0.75 cup shortening",
    "2 eggs",
    "1 cup white sugar",
    "2 cups all-purpose flour",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon baking soda",
    "2 teaspoons baking powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together shortening, eggs, sugar, and vanilla. Sift flour, soda, and baking powder. Add to egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a small cookie sheet with shortening. Pour 1/2 of the dough into pan and spread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour fig preserves over the dough and gently spread. Drop rest of dough over figs. Place in oven. When mixture starts to melt and gets soft, spread the top. Bake for 40 minutes. Cool and then cut into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
