  "ingredients": [
    "cooking spray",
    "1.5 cups spelt flour",
    "0.25 cup dark cocoa powder",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "1 cup shredded beets",
    "0.75 cup applesauce",
    "0.25 cup oil",
    "0.25 cup honey",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray 12 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cocoa powder, baking powder, and cinnamon together in a bowl. Stir beets, applesauce, oil, honey, and egg together in a separate bowl; stir into flour mixture just until batter is combined. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 18 minutes. Remove muffins from tin immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
