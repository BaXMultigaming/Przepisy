  "ingredients": [
    "4 (6 ounce) center cut pork chops",
    "1 cup dill pickle juice",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Arrange pork chops in a shallow dish and pour pickle juice over top. Cover and marinate in the refrigerator for at least 1 hour, or 8 to 24 hours for best results.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to cook, preheat an outdoor grill for medium-high heat and lightly oil the grate. Drain pork chops and discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook pork chops on the preheated grill until no longer pink in the center, 6 to 8 minutes per side. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
