  "ingredients": [
    "1.25 cups all-purpose flour",
    "0.33333298563957 cup packed brown sugar",
    "0.5 cup butter or margarine",
    "2 large eggs",
    "1.25 cups packed brown sugar",
    "1 tablespoon all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.125 teaspoon salt",
    "1 cup flaked coconut",
    "0.5 cup chopped walnuts",
    "0.5 cup maraschino cherries, chopped",
    "1 cup confectioners' sugar",
    "2 tablespoons butter",
    "0.5 teaspoon vanilla extract",
    "1 tablespoon water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare the cookie crust: Stir together flour and brown sugar in a medium bowl. Rub in butter using your hands or a pastry blender. Press into an ungreased 9-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned at the edges, about 15 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the cookie filling: Beat eggs in a medium bowl until light. Mix together brown sugar, flour, baking powder, and salt; stir into eggs. Mix in coconut, walnuts, and cherries; spread the batter evenly over the baked crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake until brown, about 25 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the frosting: Mix confectioners’ sugar, butter, water, and vanilla in a small bowl until smooth. Add more liquid if necessary to make a more spreadable mixture. Spread over cooled bars before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
