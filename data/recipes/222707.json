  "title": "Chewy Brownie Cookies",
  "description": "These chewy brownie cookies have delicious chocolate flavor from cocoa powder and semisweet chips and stay soft thanks to shortening and brown sugar.",
  "authors": [
    "Marco"
  ],
  "date_published": "2020-03-05T00:09:02-05:00",
