  "ingredients": [
    "1.5 cups packed light brown sugar",
    "0.66666668653488 cup vegetable shortening",
    "2 eggs",
    "1 tablespoon water",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.33333334326744 cup unsweetened cocoa powder",
    "0.25 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and vegetable shortening with an electric mixer in a large bowl until fluffy. Mix in 1 egg until incorporated. Beat in remaining egg along with water and vanilla until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cocoa powder, baking soda, and salt in a small bowl. Stir flour mixture into creamed mixture at low speed until just blended; fold in chocolate chips. Drop spoonfuls of dough 2 inches apart onto the ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are set, 7 to 9 minutes. Cool for 2 minutes on the baking sheets; transfer cookies to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
