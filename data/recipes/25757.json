  "ingredients": [
    "3 cups water",
    "1 (3 ounce) package chicken-flavored ramen noodles",
    "2 cups chopped cooked chicken breast",
    "2 leaves bok choy, sliced",
    "1 carrot, sliced",
    "1 teaspoon sesame oil"
