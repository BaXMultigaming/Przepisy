  "ingredients": [
    "1 onion, divided",
    "1 teaspoon butter",
    "4 teaspoons taco seasoning, divided",
    "1.25 pounds ground beef",
    "0.5 teaspoon garlic powder",
    "1 (8 ounce) can tomato sauce",
    "0.25 cup salsa",
    "4 hamburger buns"
  ],
  "steps": [
    {
      "text": "Mince enough onion to get 1/4 cup. Set remaining onion aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Add 1/4 cup minced onion and 1 teaspoon taco seasoning. Cook until onion is translucent and fragrant, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer onion to a medium bowl; add ground beef, 2 teaspoons taco seasoning, and garlic powder. Mix well and shape into 4 hamburger patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour tomato sauce into a large skillet over medium-high heat. Add salsa and remaining 1 teaspoon taco seasoning. Mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shave remaining onion into thin slices using a mandolin. Add to tomato mixture. Add hamburger patties and cook in the sauce until internal temperature reaches 170 degrees F (76 degrees C), about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast the hamburger buns if desired. Top buns with hamburger patties and sauce, and other desired toppings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
