  "title": "Baked Asian-Style Honey Chicken",
  "description": "This Asian-style honey chicken features a sweet and savory aromatic marinade of soy sauce, ginger, garlic, and onion for a quick, easy baked dinner.",
  "authors": [
    "MARBALET"
  ],
  "date_published": "2000-01-05T11:41:38-05:00",
