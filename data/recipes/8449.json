  "ingredients": [
    "0.5 cup milk",
    "0.25 cup canola oil",
    "1 large egg",
    "1.75 cups all-purpose flour",
    "0.5 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup chopped strawberries"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C) Line 8 standard-sized muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly beat milk, oil, and egg in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, baking powder, and salt together in a large bowl. Toss in chopped strawberries and stir to coat with flour. Fold in the milk mixture until just combined. Divide batter evenly among the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the tops bounce back from the touch and a toothpick inserted into the center comes out clean, about 25 minutes. Remove from the oven and cool for 10 minutes in the pan before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
