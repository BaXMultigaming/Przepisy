  "keywords": [],
  "ingredients": [
    "1 pound thin asparagus spears, trimmed",
    "1 tablespoon olive oil",
    "1 tablespoon red wine vinegar",
    "1 teaspoon Dijon mustard",
    "6 ounces sliced prosciutto",
    "4 ounces Brie cheese, cut into 1/4-inch slices",
    "3 tablespoons crushed walnuts"
  ],
  "steps": [
    {
      "text": "Place asparagus spears in a resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, vinegar, and Dijon mustard together in a small bowl until well combined; add to the bag with asparagus and distribute evenly. Marinate at room temperature for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide asparagus into 3-stalk bundles. Cut prosciutto slices in half lengthwise; lay on a cutting board. Wrap 1 piece prosciutto around each asparagus bundle to create 7 or 8 bundles; place bundles in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until asparagus is tender, 14 to 16 minutes. Transfer baking dish to a wire rack; turn on the broiler. Place 1 Brie slice on top each bundle; sprinkle with crushed walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil until cheese begins to melt, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
