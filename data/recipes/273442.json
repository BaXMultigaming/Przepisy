  "ingredients": [
    "0.25 cup steel-cut oats",
    "1 (8 ounce) container plain yogurt",
    "2 ounces fresh blueberries",
    "0.5 ounce stevia powder (such as Pure Via®)",
    "4.5 ounces coconut milk"
  ],
  "steps": [
    {
      "text": "Place oats into the bottom of a 1-pint Mason jar. Stir in yogurt, blueberries, and stevia powder. Pour in coconut milk and stir to combine.",
