  "ingredients": [
    "1 (18.25 ounce) package reduced fat yellow cake mix",
    "2 tablespoons poppy seeds",
    "1 (8 ounce) container lemon yogurt",
    "0.33300000429153 cup water",
    "0.25 cup vegetable oil",
    "0.33300000429153 cup sugar",
    "2 eggs",
    "0.25 cup lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 10 inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together cake mix and poppy seeds. Make a well in the center and pour in yogurt, water, oil, sugar, eggs and lemon juice. Beat on low speed until blended. Scrape bowl, and beat 4 minutes on medium speed. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
