  "ingredients": [
    "3 tablespoons olive oil",
    "4 shallots, sliced",
    "1 pound tart apples, cored and cut into 1/4-inch pieces",
    "2 tablespoons grated fresh ginger",
    "1 lime, zested and juiced",
    "0.25 teaspoon red pepper flakes, or more to taste",
    "0.25 teaspoon ground cayenne pepper, or more to taste",
    "2 quarts chicken broth",
    "2 (15 ounce) cans sweet potatoes, drained",
    "0.5 teaspoon salt, or to taste",
    "1 lime, cut into wedges"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat. Add shallots; cook until soft, about 3 minutes. Stir in apples, ginger, lime zest, red pepper flakes, and cayenne pepper; cook and stir until apples are very soft, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add broth, potatoes, and salt; cover and bring to a boil. Reduce heat to low; simmer about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée soup with an immersion blender until smooth. Stir in lime juice. Serve with lime wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
