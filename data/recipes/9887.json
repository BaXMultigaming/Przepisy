  "ingredients": [
    "1 cup all-purpose flour",
    "2 tablespoons brown sugar",
    "0.5 cup butter",
    "2 eggs, beaten",
    "1.5 cups packed brown sugar",
    "0.5 cup rolled oats",
    "0.25 teaspoon salt",
    "0.5 teaspoon baking powder",
    "1 teaspoon vanilla extract",
    "0.5 cup raisins",
    "0.25 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter a 9x9 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine flour and 2 tablespoons brown sugar. Cut in butter until mixture is crumbly. Press into the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 minutes in preheated oven. Crust should not be fully cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the eggs and remaining brown sugar. Combine the oats, salt, and baking powder; stir into the egg mixture along with the vanilla. Mix in raisins and coconut, if desired. Spread the mixture evenly over the partially baked crumb layer in pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 minutes more. Cool, and cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
