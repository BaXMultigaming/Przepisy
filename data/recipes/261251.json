  "ingredients": [
    "3 cups chopped cooked chicken",
    "1 (10 ounce) can condensed cream of chicken soup",
    "1 cup sour cream",
    "0.5 cup milk",
    "1 (6 ounce) package dry bread stuffing mix",
    "0.5 cup melted butter",
    "hot water as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange chicken in the bottom of a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream of chicken soup, sour cream, and milk in a small bowl; mix well. Pour over the chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss stuffing mix with melted butter in a bowl, adding hot water to moisten. Sprinkle stuffing over chicken in the casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
