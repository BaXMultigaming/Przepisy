  "ingredients": [
    "cooking spray",
    "5 pounds chicken drumsticks",
    "2 teaspoons Cajun seasoning",
    "2 teaspoons poultry seasoning",
    "1 teaspoon garlic powder",
    "salt and ground black pepper to taste",
    "1 teaspoon all-purpose flour",
    "1 cup barbeque sauce"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 250 degrees F (120 degrees C). Grease a baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N6Js4l07Fn9MuGM67q3GZgaowfs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256872-Slow-Cooked-Chicken-Drumsticks-ddmfs-ingredients-step-1-870a0f18dcef472cb16d93b952df2210.jpg"
      ],
      "image": "assets/images/256872/step_01.webp"
    },
    {
      "text": "Arrange chicken drumsticks in the prepared pan; sprinkle with Cajun seasoning, poultry seasoning, garlic powder, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YeZxstbqFu9UHhK7lYpgHXIwcqA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256872-Slow-Cooked-Chicken-Drumsticks-ddmfs-step-2-22bdd68244964a048c36e2c9d1859798.jpg"
      ],
      "image": "assets/images/256872/step_02.webp"
    },
    {
      "text": "Sprinkle flour on top. Spray chicken with cooking spray; cover the baking pan with aluminum foil. Bake in the preheated oven until juices run clear, about 2 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7XnMnR4IaGrg_TO5f4s9B05DI1s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256872-Slow-Cooked-Chicken-Drumsticks-ddmfs-step-3-f87cd769738f4e61821f938a5aa4cad8.jpg"
      ],
      "image": "assets/images/256872/step_03.webp"
    },
    {
      "text": "Remove foil and pour barbecue sauce evenly over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3Wbj0eufPmUUPZiMycFlLBJ83UY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256872-Slow-Cooked-Chicken-Drumsticks-ddmfs-step-4-f4c0d1e1f34841eeaeb65aa3a7b7400d.jpg"
      ],
      "image": "assets/images/256872/step_04.webp"
    },
    {
      "text": "Continue baking, uncovered, until chicken is tender and falling off the bone, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KbVE46jvHfeTQb7KlZQcIPjEvN0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256872-Slow-Cooked-Chicken-Drumsticks-ddmfs-step-5-db48dc659a1f4d049073d900845b7f58.jpg"
