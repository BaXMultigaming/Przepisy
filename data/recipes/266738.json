  "ingredients": [
    "1 quart unsweetened rice milk",
    "1 quart unsweetened almond milk",
    "1 (14 ounce) can sweetened condensed milk",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "3 teaspoons ground cinnamon",
    "5 cinnamon sticks",
    "ice"
