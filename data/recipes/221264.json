  "ingredients": [
    "2 tablespoons brewed espresso",
    "1 tablespoon unsalted butter",
    "3.5 ounces dark chocolate, broken into small pieces",
    "2 tablespoons Marsala wine or rum",
    "2 egg yolks",
    "4 teaspoons white sugar",
    "2 tablespoons mascarpone cheese",
    "0.75 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Combine espresso and butter in the top of a double boiler over simmering water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place dark chocolate pieces in the espresso mixture; cook without stirring until chocolate starts to melt, about 3 minutes. Whisk chocolate and espresso mixture until well combined. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Marsala, egg yolks, and sugar in a saucepan over medium-low heat, whisking constantly until frothy and thickened, 3 to 5 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mascarpone cheese into marsala mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chocolate mixture with mascarpone mixture. Cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip heavy cream in a bowl until soft peaks form, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold half of whipped cream into cooled chocolate mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold second half of whipped cream into chocolate mixture. Cover with plastic wrap and chill in refrigerator for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/woTEQrFON0wlCM2jMi6IDYAc6bo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/4568488-844a9224d6f949c283a4fd11a956a0ac.jpg"
      ],
