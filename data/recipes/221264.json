  "title": "Tiramisu Chocolate Mousse",
  "description": "This decadent mousse features dark chocolate, espresso, and mascarpone cheese.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2020-06-18T23:48:24-04:00",
