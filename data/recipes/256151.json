  "ingredients": [
    "0.5 cup unsalted butter",
    "20 mushrooms, stems removed",
    "0.5 (8 ounce) package shredded Monterey Jack cheese",
    "0.25 teaspoon garlic powder",
    "0.125 teaspoon dried thyme",
    "0.25 cup dry white wine",
    "2 teaspoons soy sauce",
    "0.5 cup seasoned dry bread crumbs"
  ],
  "steps": [
    {
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a microwave-safe bowl. Heat in the microwave until melted, 30 seconds to 1 minute. Dip the bottom of each mushroom cap in melted butter and place on a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Monterey Jack cheese, garlic powder, and thyme into the remaining melted butter. Stir in wine and soy sauce. Add enough bread crumbs to make a wet and sticky mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon bread crumb mixture into each mushroom cap, mounding it slightly to use up all the filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until brown and bubbly, 3 to 4 minutes. Cool slightly before serving, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
