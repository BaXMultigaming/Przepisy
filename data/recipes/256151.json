  "title": "Happy Hour Mushrooms",
  "description": "Mushrooms stuffed with wine-infused bread crumbs are an appetizer that's easy enough for Sunday football but tasty enough for a happy hour.",
  "authors": [
    "Watercat"
  ],
  "date_published": "2016-11-12T04:27:14-05:00",
