  "ingredients": [
    "olive oil cooking spray (such as PAM®)",
    "4 unsalted matzo boards, or more to taste",
    "1 cup unsalted butter",
    "1 cup light brown sugar, firmly packed",
    "0.75 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jMtJhuRUciYuscP5_W7HnLzzOp4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-221190-chocolate-covered-matzo-VAT-ingredients-578fcb7d7eff462fb06117f3940cc3dc.jpg"
      ],
      "image": "assets/images/221190/step_01.webp"
    },
    {
      "text": "Line a baking sheet with aluminum foil and spray with cooking spray; arrange matzo boards to fit in a single layer, breaking if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/toHcP8Ygvpm8WYqJ8hIefaIHJAY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-221190-chocolate-covered-matzo-VAT-step-02-35d0c7bde74e40edbc7005b6ab64d24b.jpg"
      ],
      "image": "assets/images/221190/step_02.webp"
    },
    {
      "text": "Combine butter and brown sugar together in a saucepan over medium heat; bring to a boil, stirring constantly, then boil for about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yg8q6-pwfGN0fEhwQdMD9PGDbR8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-221190-chocolate-covered-matzo-VAT-step-03-2-4a2cae46a0404733988ebe6fc7154d04.jpg"
      ],
      "image": "assets/images/221190/step_03.webp"
    },
    {
      "text": "Pour butter mixture evenly over matzo on the prepared baking sheet. Transfer baking sheet into the preheated oven and immediately reduce heat to 350 degrees F (175 degrees C); bake for 10 minutes. Reduce heat to 325 degrees F (165 degrees C) if the matzo are smoking too much.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/u6VeCydcBme7vKdh-VBkucwIjEU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-221190-chocolate-covered-matzo-VAT-step-04-65ccc0f36a0d4b4eb46b06bdb630d339.jpg"
      ],
      "image": "assets/images/221190/step_04.webp"
    },
    {
      "text": "Remove baking sheet from oven and sprinkle matzo with chocolate chips. Let stand to melt chocolate, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/phJ82U21FSRF07qOXG_y9GJE0mw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-221190-chocolate-covered-matzo-VAT-step-06-d4c65715066f4999a8f034b3c2924bbc.jpg"
      ],
      "image": "assets/images/221190/step_05.webp"
    },
    {
      "text": "Spread melted chocolate over matzo; place in refrigerator until chilled and set. Break into pieces when cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0c6W3R5btaZE-j8QXgkphRhWvlo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-221190-chocolate-covered-matzo-VAT-step-07-2-c731f4c97f274acdbe96e301c2a7d3e5.jpg"
      ],
      "image": "assets/images/221190/step_06.webp"
    }
  ],
