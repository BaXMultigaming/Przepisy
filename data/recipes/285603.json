  "ingredients": [
    "1 (2 pound) whole red snapper",
    "2 tablespoons grapeseed oil",
    "1 teaspoon Cajun seasoning, or to taste",
    "2 garlic cloves",
    "1 slice orange",
    "1 slice lime",
    "1 slice lemon",
    "2 sprigs fresh thyme"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Clean red snapper inside and out under cold running water. Pat dry with paper towels, then place onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush grapeseed oil all over the inside and outside of fish; sprinkle with Cajun seasoning on all sides. Insert garlic cloves, citrus slices, and thyme sprigs into the cavity.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, about 20 minutes, depending on size of fish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
