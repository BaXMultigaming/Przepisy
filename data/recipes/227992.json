  "ingredients": [
    "2 tablespoons butter",
    "1 small onion, finely chopped",
    "1 small carrot, finely chopped",
    "1 cup basmati rice",
    "1 teaspoon salt",
    "1.875 cups water",
    "0.25 cup dried apricots, diced",
    "0.25 cup slivered almonds",
    "1 tablespoon rose water",
    "0.25 teaspoon saffron threads, crushed"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan over medium heat. Add onion and carrot; cook and stir until onion is translucent, about 5 minutes. Stir in basmati rice and salt; cook and stir until rice is slightly opaque, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in water until combined. Stir in apricots, almonds, rose water, and saffron; bring to a boil. Reduce heat to low, cover, and simmer until liquid is absorbed, about 20 minutes. Remove from heat; let stand, covered, 10 minutes. Stir before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
