  "ingredients": [
    "1 (17.5 ounce) package frozen puff pastry sheets, thawed",
    "0.5 cup chopped walnuts",
    "1 cup chopped pecans",
    "1 cup chopped hazelnuts",
    "1 cup raisins",
    "1 cup flaked coconut",
    "1.25 cups white sugar, divided",
    "4 cups milk",
    "0.5 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the pastry sheets in the baking dish and place the dish in the oven. Watch it closely. When the top layer turns crunchy and golden, remove it from the oven. Continue until all the sheets are cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, combine walnuts, pecans, hazelnuts, raisins, coconut and 1/4 cup sugar. Break cooked pastry into pieces and stir into nut mixture. Spread mixture evenly in 9x13-inch dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring milk and 1/2 cup sugar to a boil in a medium saucepan over medium heat. Pour over nut mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the heavy cream with the remaining 1/2 cup sugar until stiff peaks form. Spread evenly over nut mixture in dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place dessert under oven broiler until top is golden brown, about 10 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
