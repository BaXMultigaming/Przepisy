  "ingredients": [
    "1 (3 pound) beef chuck roast, trimmed",
    "0.5 medium onion, diced",
    "0.5 cup dark brown sugar",
    "0.33333334326744 cup soy sauce",
    "10 cloves garlic",
    "1 medium jalapeno pepper, diced",
    "1 (1 inch) piece fresh ginger root, peeled and grated",
    "2 tablespoons seasoned rice vinegar",
    "1 tablespoon sesame oil",
    "salt and ground black pepper to taste",
    "16 (6 inch) corn tortillas"
  ],
  "steps": [
    {
      "text": "Place chuck roast into a slow cooker with onion, brown sugar, soy sauce, garlic, jalapeño pepper, ginger, rice vinegar, sesame oil, salt, and pepper. Cover and cook until meat is tender and can easily be pulled apart with a fork, on Low for 10 hours or High for 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer roast to a cutting board and shred meat with two forks. Return to the slow cooker and mix with the juices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with corn tortillas.",
