  "ingredients": [
    "24 graham crackers, crushed",
    "0.33333298563957 cup butter, melted",
    "0.25 cup packed brown sugar",
    "1 (6 ounce) package raspberry flavored Jell-O® mix",
    "1 cup boiling water",
    "15 ounces frozen raspberries",
    "0.33333298563957 cup milk",
    "20 large marshmallows",
    "1 cup heavy whipping cream, whipped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix crushed graham crackers, melted butter, and brown sugar in a bowl until well combined. Set aside 1/4 cup graham mixture for topping; press the remainder into a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve raspberry gelatin in boiling water. Add frozen raspberries, stirring until melted. Chill until partially set, then spread over graham crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk into a microwave-safe bowl and heat in the microwave until warm. Stir in marshmallows until melted; allow to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold whipped cream into marshmallow mixture, then spread on top of raspberry mixture. Sprinkle with reserved graham topping. Chill in the refrigerator for 3 to 4 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
