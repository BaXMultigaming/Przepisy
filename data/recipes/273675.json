  "ingredients": [
    "4 (6 inch) corn tortillas",
    "cooking spray",
    "1 small tomato, chopped",
    "2 green onions, sliced",
    "1.5 tablespoons lime juice",
    "1 tablespoon chopped fresh cilantro",
    "0.5 (8 ounce) package cream cheese, softened",
    "1 tablespoon finely chopped chipotle pepper in adobo sauce",
    "1.5 cups shredded cooked chicken",
    "0.75 cup shredded Mexican cheese blend",
    "0.33333334326744 cup sliced black olives",
    "0.25 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray both sides of each tortilla with cooking spray; place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake tortillas in the preheated oven until crisp and lightly browned, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While tortillas are baking, combine tomato, green onions, lime juice, and cilantro in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese and chipotle pepper in a separate bowl until well blended. Remove tortillas from the oven. Spread mixture over tortillas; top with chicken and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return tortillas to the oven and continue baking until cheese is melted, about 5 minutes. Top with the tomato mixture, olives, and sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
