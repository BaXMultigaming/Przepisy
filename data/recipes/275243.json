  "ingredients": [
    "1 cup water",
    "0.5 cup apple cider vinegar",
    "2 pounds rib tips",
    "1 tablespoon BBQ rub",
    "1 teaspoon kosher salt",
    "1 cup barbeque sauce"
  ],
  "steps": [
    {
      "text": "Add water and vinegar to a multi-functional pressure cooker (such as Instant Pot). Set trivet inside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle rib tips with barbecue rub and salt; massage to coat. Set rib tips on top of the trivet. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 40 minutes. Allow 8 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 10 minutes. Unlock and remove the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer rib tips to a baking dish; let cool 5 minutes. Add barbecue sauce; stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill rib tips for 6 minutes, flipping halfway.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
