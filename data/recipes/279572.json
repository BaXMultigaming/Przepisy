  "ingredients": [
    "1 (6 ounce) can pineapple juice, divided",
    "0.66666668653488 cup flaked coconut, divided",
    "0.33333334326744 cup dark brown sugar, or more to taste",
    "4 tablespoons unsalted butter, melted",
    "0.25 cup rum",
    "4 cups cubed stale bread",
    "3.5 cups coconut milk beverage",
    "5 large eggs",
    "0.5 cup orange juice",
    "0.25 cup white sugar",
    "2 teaspoons ground cinnamon, or more to taste",
    "0.25 teaspoon grated nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 1/2 fluid ounces pineapple juice, 1/3 cup coconut, brown sugar, melted butter, and rum in a bowl; pour into the bottom of a 2 1/2-quart casserole dish. Place bread cubes on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine coconut milk beverage, eggs, remaining 4 1/2 fluid ounces pineapple juice, orange juice, remaining 1/3 cup coconut, white sugar, 2 teaspoons cinnamon, and nutmeg in large bowl; pour over bread cubes and sprinkle with a little cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
