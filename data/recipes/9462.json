  "ingredients": [
    "1 (11 ounce) package butterscotch chips",
    "1 cup peanut butter",
    "0.5 cup butter",
    "3.5 cups miniature marshmallows",
    "1 cup flaked coconut",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butterscotch chips, peanut butter, and butter in the top of a double boiler over simmering water. Stir frequently, scraping down the sides with a rubber spatula to avoid scorching, until melted and combined, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir marshmallows, coconut, and walnuts into butterscotch mixture until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into prepared pan. Refrigerate until set, about 1 hour. Cut into 18 squares and store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
