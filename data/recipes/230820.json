  "ingredients": [
    "6 eggs",
    "1.5 cups milk",
    "0.5 cup all-purpose flour",
    "1 tablespoon white sugar",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "10 thick slices French bread, cut into 1-inch cubes",
    "1 cup fresh blueberries",
    "0.5 cup chopped pecans",
    "1 (3 ounce) package cream cheese, cut into 1/2-inch cubes"
  ],
  "steps": [
    {
      "text": "Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, milk, flour, sugar, cinnamon, vanilla, nutmeg, and salt in a large bowl with a hand mixer until smooth; add bread cubes and stir until well coated. Pour bread mixture into prepared baking dish. Top evenly with blueberries, pecans, and cream cheese cubes. Cover dish with plastic wrap and refrigerate 2 to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered in preheated oven until golden brown, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
