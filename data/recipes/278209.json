  "ingredients": [
    "3 cups whole wheat flour",
    "2 teaspoons ground cinnamon",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons baking soda",
    "1 teaspoon ground ginger",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground allspice",
    "1.25 cups mashed overripe bananas",
    "1 cup pumpkin puree",
    "1 cup whole-milk plain Greek yogurt",
    "3 eggs, at room temperature",
    "0.5 cup pure maple syrup",
    "1.5 teaspoons vanilla extract",
    "0.75 cup dark chocolate chips",
    "0.75 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Generously grease a 10-inch fluted tube pan (such as Bundt).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cinnamon, baking powder, baking soda, ginger, salt, nutmeg, cloves, and allspice together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk bananas, pumpkin purée, yogurt, eggs, maple syrup, and vanilla extract together in a large bowl until well combined. Add flour mixture, in two batches, mixing briefly after each addition; fold in chocolate chips and walnuts. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 50 to 55 minutes. Cool on a wire rack for 10 minutes. Tap the pan firmly a few times, then shake it gently to loosen the cake. Place a wire rack over the pan and invert to release cake onto the rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
