  "ingredients": [
    "3.75 cups all-purpose flour",
    "0.75 cup white sugar",
    "1.3333333730698 cups butter, softened",
    "0.25 cup orange juice",
    "1 egg yolk"
  ],
  "steps": [
    {
      "text": "In large bowl, mix all ingredients at medium speed until well mixed. Cover and refrigerate for about one hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F. Use part of dough at a time, keeping the rest refrigerated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a cookie press fitted with a bar-plate tip, press dough in long strips, about one inch apart down the length of the cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With a sharp knife, cut each strip into 2 1/2 inch pieces. Leave pieces in place. Bake 8 minutes or until light golden. Do not to overbake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven and immediately cut again between cookies to separate any cookies which are still joined together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Move cookies to wire rack, and allow cookies to cool completely. Store tightly covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
