  "ingredients": [
    "12 ounces dry fettuccini pasta",
    "2 cups 1 inch pieces fresh asparagus",
    "0.5 cup butter",
    "2 cups half-and-half cream",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon ground black pepper",
    "1 pinch cayenne pepper",
    "0.75 cup grated Parmesan cheese",
    "0.5 pound cooked chicken breasts - cut into bite size pieces"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes, or until al dente. Add asparagus during the last 3 to 5 minutes of cooking. Drain, and transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan over medium heat, combine butter and half-and-half. Cook until thick and bubbly. Season with garlic powder, black pepper, and cayenne pepper. Stir in Parmesan cheese and chicken, and heat through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sauce over pasta and asparagus, and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
