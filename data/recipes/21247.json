  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil and spray with vegetable cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a shallow bowl combine oil and lemon juice. Dip potatoes in oil/lemon mixture and season with salt and pepper, to taste. Place on baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 minutes. Remove from oven and turn wedges over. Return to oven and continue cooking until crisp and brown on both sides, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
