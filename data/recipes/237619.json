  "ingredients": [
    "2 cups rice-bread crumbs (such as PaneRiso™)",
    "0.5 cup olive oil",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil",
    "1 teaspoon dried rosemary",
    "1 teaspoon garlic powder",
    "2 pork tenderloins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs, olive oil, oregano, basil, rosemary, and garlic powder in a resealable plastic bag. Add pork tenderloin, seal bag, and shake until pork is coated. Place coated pork on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pork is cooked through, about 35 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C). Let pork rest for 10 minutes before cutting into 1/2-inch thick slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
