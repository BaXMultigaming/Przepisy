  "ingredients": [
    "1 large rutabaga, peeled and cubed",
    "3 cups chicken broth, or as needed",
    "0.25 cup evaporated milk, or as needed",
    "3 tablespoons butter",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place rutabaga in a medium saucepan; add broth to cover. Bring to a boil; reduce heat, cover, and cook until tender, about 40 minutes. Drain.",
