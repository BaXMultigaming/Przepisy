    "1 recipe pastry for a single 9-inch pie crust",
    "1 large fresh peach, sliced into 8 pieces",
    "1 teaspoon white sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll pie pastry onto a cutting board. Cut crust into eight 4-inch circles using a cookie cutter. Place 1 peach slice in the center of each circle. Fold circle in half to enclose each peach slice; seal edges together. Place mini pies on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cinnamon and sugar together in a small bowl; sprinkle over mini pies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly browned, 10 to 13 minutes.",
