  "ingredients": [
    "2 tablespoons butter",
    "1 cup diced onion",
    "3 cups chicken broth",
    "2.5 cups peeled and diced potatoes",
    "1.75 cups shredded sharp Cheddar cheese",
    "1 cup heavy cream",
    "0.25 teaspoon dried dill weed",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground cayenne pepper"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium heat. Add onion; cook and stir until softened. Stir in broth and potatoes; bring to a boil. Cover, reduce heat, and simmer until potatoes are tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée soup using an immersion blender (or blend in a blender or the bowl of a food processor until smooth). Reheat soup over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in Cheddar cheese, heavy cream, dill, black pepper, salt, and cayenne pepper; bring to a low boil. Cook, stirring, until thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
