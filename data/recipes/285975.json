  "ingredients": [
    "6 cups chicken broth",
    "1 pound skinless, boneless chicken breast halves",
    "1 (15 ounce) can tomato sauce",
    "1 (15 ounce) can Mexican-style pinto beans",
    "1 cup salsa",
    "5 tablespoons chili powder",
    "0.25 cup dried minced onion",
    "4 teaspoons minced garlic",
    "1 teaspoon dried Mexican oregano",
    "1 teaspoon dried basil",
    "1 teaspoon cayenne pepper",
    "1 teaspoon ground cumin",
    "1 teaspoon salt",
    "2 cups cooked rice",
    "2 cups shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Combine broth, chicken, tomato sauce, pinto beans, salsa, chili powder, onion, garlic, oregano, basil, cayenne pepper, cumin, and salt in a slow cooker. Cook on Low for 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use forks to shred chicken. Stir in cooked rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle into bowls and garnish with Monterey Jack cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
