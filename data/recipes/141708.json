  "ingredients": [
    "1 (12 ounce) bag mixed frozen berries",
    "0.25 cup cream sherry",
    "1 teaspoon fresh lemon juice",
    "1 teaspoon grated lemon zest",
    "2 cups heavy cream, chilled",
    "1 tablespoon white sugar",
    "1 (12 ounce) loaf prepared pound cake",
    "0.5 cup toasted coconut"
  ],
  "steps": [
    {
      "text": "Combine frozen berries, sherry, lemon juice, and lemon zest in a medium bowl; toss to blend. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat heavy cream in a large bowl with an electric mixer until soft peaks form. Gradually beat in sugar until stiff peaks form. Refrigerate whipped cream until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut pound cake into ⅓-inch-thick slices, discarding cake ends.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 layer cake slices in the bottom of a glass serving bowl; spoon ½ berry mixture with juice over cake slices. Cover with ½ whipped cream; sprinkle with ¼ cup coconut. Repeat layering with remaining cake slices, berries with juice, whipped cream, and coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate trifle before serving, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
