  "ingredients": [
    "2.5 tablespoons stone-ground mustard",
    "1 tablespoon maple syrup",
    "1 teaspoon fresh lemon juice",
    "0.5 teaspoon minced garlic",
    "0.25 teaspoon minced fresh thyme",
    "6 (6 ounce) frozen salmon fillets, thawed and patted dry",
    "1 teaspoon kosher salt",
    "0.5 teaspoon black pepper",
    "1 tablespoon olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large baking sheet with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together mustard, maple syrup, lemon juice, garlic, and thyme in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season salmon on both sides with salt and pepper and brush with oil. Arrange salmon on prepared baking sheet. Brush with mustard mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until salmon flakes easily with a fork, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
