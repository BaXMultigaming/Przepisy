  "ingredients": [
    "nonstick cooking spray",
    "1.5 pounds uncooked medium shrimp, peeled and deveined",
    "1 yellow bell pepper, thinly sliced",
    "1 red bell pepper, thinly sliced",
    "1 orange bell pepper, thinly sliced",
    "1 small red onion, thinly sliced",
    "1.5 tablespoons olive oil",
    "2 teaspoons chili powder",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon paprika",
    "1 medium lime, juiced, or as needed",
    "12 (6 inch) flour tortillas, warmed",
    "1 avocado, sliced, or to taste",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Spray a rimmed baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine shrimp, bell peppers, red onion, olive oil, chili powder, salt, black pepper, garlic powder, onion powder, cumin, and paprika in a large bowl; toss to combine. Spread mixture on the prepared pan evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven until shrimp are bright pink and firm, about 8 minutes. Turn on the oven's broiler and cook for an additional 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Squeeze lime juice over mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Build fajitas on tortillas with avocado slices and cilantro.",
      "section": null,
