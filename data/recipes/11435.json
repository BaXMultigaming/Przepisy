  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "0.5 cup butter, softened",
    "3 eggs",
    "1 (8 ounce) package cream cheese",
    "4 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl mix together cake mix, butter and 1 egg. Pat batter into greased 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium size mixing bowl mix together cream cheese, 2 eggs and sugar. Pour the cream cheese mixture over the cake mix batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 minutes or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
