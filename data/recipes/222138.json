  "ingredients": [
    "0.25 cup butter",
    "1 (8 ounce) package fat-free cream cheese",
    "2 teaspoons garlic powder",
    "2 cups non-fat milk",
    "6 ounces grated Parmesan cheese",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Melt butter in a non-stick saucepan over medium heat; melt cream cheese and garlic powder in butter, whisking Pour in milk, a little at a time, whisking to smooth out lumps. Stir in Parmesan cheese and pepper until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat when sauce reaches a creamy and thick consistency, about 5 minutes. This sauce will thicken rapidly as it cooks - thin with additional milk if cooked for too long.",
