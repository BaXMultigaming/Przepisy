  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon ground ginger",
    "0.25 teaspoon salt",
    "0.5 cup shortening",
    "0.5 cup white sugar",
    "1 tablespoon heavy whipping cream",
    "1 tablespoon chopped crystallized ginger"
  ],
  "steps": [
    {
      "text": "Sift together flour, ginger, and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl, cream together shortening and sugar. Beat in the cream. Gradually blend in the flour mixture. Stir or work in crystallized ginger. Cover and chill for four hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On floured surface, roll out chilled dough to a 9 inch square. Fit it into lightly greased 9 inch square baking pan. Prick it all over with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a 350 degrees F (175 degrees C) oven until lightly colored. Cool in the pan on wire rack. Cut into 2 x 1 inch bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
