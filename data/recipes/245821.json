  "ingredients": [
    "4 roma (plum) tomatoes, quartered, or more to taste",
    "1 onion, sliced into thin rings",
    "1 green bell pepper, sliced into thin rings",
    "0.5 cup olive oil",
    "0.5 cup cider vinegar",
    "1 tablespoon chopped fresh garlic",
    "2 teaspoons chopped fresh parsley",
    "1 teaspoon salt",
    "1 teaspoon white sugar",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place tomatoes in a shallow serving dish; arrange onion rings, then bell pepper rings, on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add olive oil, cider vinegar, garlic, parsley, salt, sugar, and black pepper to a jar; close tightly and shake vigorously until well combined. Pour vinaigrette over tomatoes, onions, and bell peppers. Refrigerate until flavors meld, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
