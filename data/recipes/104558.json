  "ingredients": [
    "1.5 cups milk",
    "1 cup coconut cream",
    "0.5 cup white sugar",
    "2 (1/2 pound) avocados, peeled and pitted",
    "0.75 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Puree milk, coconut cream, sugar, avocados, and lemon juice in a blender until smooth. Pour into a bowl, cover, and refrigerate for several hours until cold. Freeze in an ice cream machine according to manufacturer's directions, then freeze overnight.",
