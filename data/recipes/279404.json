  "ingredients": [
    "6 medium potatoes, peeled and thinly sliced",
    "2 teaspoons salt",
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "1.5 cups milk",
    "0.75 cup shredded Swiss cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 8x8-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange sliced potatoes in the prepared casserole dish; season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat; whisk in flour to form a thick paste. Pour in milk gradually, stirring constantly, until a thick white sauce forms, about 5 minutes. Stir in cheese and remove from heat. Pour sauce over potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are tender and the tops are golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
