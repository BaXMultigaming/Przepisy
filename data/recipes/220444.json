  "keywords": [],
  "ingredients": [
    "0.5 cup butter, softened",
    "0.75 cup white sugar",
    "4 egg yolks",
    "0.75 cup sour cream",
    "0.5 teaspoon vanilla extract",
    "1 teaspoon almond extract",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "6 tablespoons Irish cream liqueur (such as Baileys®)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line 12 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter in a large bowl with an electric mixer until the butter is light and smooth, 2 to 3 minutes; beat in sugar until the mixture is light and fluffy, at least 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat in egg yolks one at a time, mixing until each yolk is just combined before adding the next; mix in sour cream and vanilla and almond extracts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour in a separate bowl with baking powder and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour mixture into the liquid ingredients in thirds, alternating with Irish cream liqueur, until the batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the lined muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the cupcakes are golden brown on top and a toothpick inserted into the center of a cupcake comes out clean, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
