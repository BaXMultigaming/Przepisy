  "ingredients": [
    "4 (6 ounce) yellowfin tuna steaks",
    "0.5 cup vegetable oil",
    "0.33333334326744 cup soy sauce",
    "0.25 cup fresh lemon juice",
    "2 teaspoons Dijon mustard",
    "1 teaspoon grated lemon peel",
    "1 clove garlic, crushed",
    "4 wedges lemon, for garnish"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prick tuna steaks all over with a fork and place in a shallow glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together oil, soy sauce, lemon juice, Dijon mustard, lemon peel, and garlic in a bowl; pour over tuna steaks. Cover the dish with plastic wrap and refrigerate for 1 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill to medium heat and lightly oil the grate. Remove tuna from marinade; shake excess marinade from steaks and transfer to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour marinade into a small saucepan; bring to a boil. Reduce heat to medium-low and simmer marinade for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook tuna on the preheated grill, basting with boiled marinade, until cooked through, 5 to 6 minutes per side. Serve with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
