  "ingredients": [
    "1 cup all-purpose flour",
    "0.25 cup white sugar",
    "1 teaspoon cream of tartar",
    "0.5 teaspoon baking soda",
    "0.5 cup milk",
    "2 eggs, beaten"
  ],
  "steps": [
    {
      "text": "Mix together flour, sugar, cream of tartar, and baking soda in a medium bowl until combined. Add milk and beaten eggs; stir until batter is consistency of thick cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large nonstick skillet over medium-high heat. Drop batter by spoonfuls into the hot skillet and cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 more minutes. Repeat with remaining batter.",
