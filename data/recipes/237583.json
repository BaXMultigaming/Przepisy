  "ingredients": [
    "3.5 cups Silk® Unsweetened Coconutmilk",
    "1 teaspoon salt",
    "1 cup organic cornmeal",
    "0.25 cup non-dairy cream cheese",
    "1 tablespoon vegan margarine (or butter), or more as needed",
    "Chopped parsley, chives or other herbs, for garnish"
  ],
  "steps": [
    {
      "text": "Bring Silk and salt to a boil in a medium saucepan. Slowly stir in cornmeal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to a boil, then reduce to a simmer and cook for 15 minutes until very thick, stirring often to prevent polenta from sticking to pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and stir in cream cheese and margarine until fully incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon into a serving dish or press gently into a large oiled bowl, then turn over for molded polenta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with parsley, chives or other chopped herbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
