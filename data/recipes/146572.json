      ],
      "image": "assets/images/146572/step_03.webp"
    },
    {
      "text": "Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted in the center comes out clean, about 45 minutes.",
