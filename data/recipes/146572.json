  "ingredients": [
    "3 cups all-purpose flour",
    "1.3333333730698 cups white sugar",
    "1 cup cornmeal",
    "2 tablespoons baking powder",
    "1 teaspoon salt",
    "2.5 cups whole milk",
    "4 eggs, beaten",
    "0.66666668653488 cup vegetable oil",
    "0.33333334326744 cup melted butter",
    "2 tablespoons honey"
  ],
