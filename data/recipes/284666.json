  "ingredients": [
    "1 pound beef chuck roast",
    "2 cups beef broth",
    "4 medium Roma tomatoes, chopped",
    "1 medium onion, diced",
    "2 large bay leaves",
    "2 serrano chile peppers",
    "2 medium limes, juiced",
    "2 tablespoons white vinegar",
    "1 teaspoon dried Mexican oregano",
    "salt and freshly ground black pepper to taste",
    "1 cup refried beans, warmed",
    "8 fried tortillas",
    "1 cup shredded lettuce, or to taste",
    "2 medium tomatoes, chopped",
    "0.5 cup sour cream, or to taste",
    "0.5 cup salsa, or to taste"
  ],
  "steps": [
    {
      "text": "Combine chuck roast, broth, tomatoes, onion, bay leaves, serrano chiles, lime juice, vinegar, oregano, salt, and pepper in a large pot pot over medium-high heat. Bring to a boil, reduce heat to low, and simmer until meat is tender, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove roast from pot and shred meat with 2 forks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To assemble tostadas, spread a layer of refried beans on tortillas, layer shredded beef, lettuce, tomatoes, cheese, sour cream and salsa.",
