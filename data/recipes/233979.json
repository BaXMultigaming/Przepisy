  "ingredients": [
    "2 cups ice",
    "3 frozen bananas, cut into small chunks",
    "1 cup skim milk",
    "0.25 cup white sugar, or to taste",
    "6 fresh strawberries, sliced",
    "1 teaspoon pure vanilla extract",
    "2 tablespoons whipped dairy topping, or to taste"
  ],
  "steps": [
    {
      "text": "Put ice in a blender; add bananas, milk, sugar, strawberries, and vanilla extract. Blend until smooth. Top with whipped topping; blend again until smooth.",
