  "ingredients": [
    "0.75 cup shortening (such as Crisco®)",
    "0.75 cup brown sugar",
    "0.5 cup white sugar",
    "2 tablespoons milk",
    "1 tablespoon vanilla extract",
    "2 eggs",
    "1.75 cups all-purpose flour",
    "1 (3.9 ounce) package instant chocolate pudding mix",
    "1 teaspoon salt",
    "0.75 teaspoon baking soda",
    "1.5 cups chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine shortening, sugars, milk, and vanilla extract in a large bowl. Beat in eggs. Whip mixture until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, pudding mix, salt, and baking soda in a separate bowl. Pour over the shortening mixture and beat until well blended. Fold in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop rounded tablespoonfuls of cookie dough onto ungreased cookie sheets, spacing them 3 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, 1 cookie sheet at a time, until edges are set, 11 to 15 minutes. Repeat with remaining cookie sheets. Cool each batch for 5 minutes before moving cookies onto a cooling rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
