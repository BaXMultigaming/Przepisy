  "ingredients": [
    "1 teaspoon prepared yellow mustard",
    "4 hot dogs, butterflied",
    "2 ounces cheddar cheese, sliced into 8 matchsticks",
    "4 strips thick-cut bacon",
    "8 toothpicks",
    "4 hot dog buns, split",
    "1 large (5 inch) dill pickle, sliced into 8 long strips"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat grill for medium heat and lightly oil the grate.",
