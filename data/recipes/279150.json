  "title": "Italian Knot Cookies",
  "description": "Passed down through generations, this recipe for Italian knot cookies produces a large batch of soft and sweet Sicilian biscotti that can be frozen for later.",
  "authors": [
    "ROBBILYNNE"
  ],
  "date_published": "2020-06-19T00:44:53-04:00",
