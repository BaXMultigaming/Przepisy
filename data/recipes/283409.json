  "ingredients": [
    "1 (16 ounce) package mostaccioli pasta",
    "1 cup olive oil",
    "1 cup white vinegar",
    "1 cup white sugar",
    "1 (2 ounce) jar sliced pimento peppers",
    "1 tablespoon parsley flakes",
    "1.5 teaspoons ground black pepper",
    "1 teaspoon salt",
    "1 teaspoon garlic salt",
    "1 bunch green onions, thinly sliced",
    "1 medium cucumber, peeled and diced"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil, vinegar, sugar, pimentos, parsley, black pepper, salt, and garlic salt in a bowl; stir in green onions and cucumber. Pour over pasta; mix well. Refrigerate before serving, 4 hours to overnight.",
      "section": null,
