  "ingredients": [
    "1 (15 ounce) can refried beans",
    "6 (7 inch) corn tortillas",
    "cooking spray",
    "1.75 cups shredded Mexican cheese blend",
    "3 roma (plum) tomatoes, seeded and diced",
    "2 green onions, sliced",
    "0.5 cup chopped fresh cilantro",
    "1 (4 ounce) can sliced black olives, well drained"
  ],
  "steps": [
    {
      "text": "Heat refried beans in a microwave-safe bowl in the microwave on high until warmed through, about 2 minutes, stirring after 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray both sides of each corn tortilla with cooking spray and arrange them on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a non-stick skillet over medium-high heat. Pan-fry one side of each tortilla until lightly browned, about 3 minutes. Return tortillas to wire rack, browned sides up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread a thin layer of refried beans onto the tortillas, stopping about 1/2 inch from the edge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle Mexican cheese blend over refried beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully transfer a tortilla pizza back to the skillet, bean side up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly fry until cheese begins to melt, about 1 minute more; return tortilla pizza to wire rack. Repeat with remaining pizzas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scatter tomatoes, green onions, cilantro, and olives over melted cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice pizzas to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
