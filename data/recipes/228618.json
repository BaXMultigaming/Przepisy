  "ingredients": [
    "cooking spray",
    "2 racks baby back pork ribs",
    "1 teaspoon grill seasoning, or to taste",
    "1 cup ketchup",
    "3 tablespoons packed brown sugar",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon Dijon mustard",
    "1 clove garlic, minced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a large baking sheet with aluminum foil and grease with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ribs onto the prepared baking sheet. Season both sides with grill seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes; flip ribs over and bake for 15 more minutes. Cut ribs apart and place into a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together ketchup, brown sugar, Worcestershire sauce, Dijon mustard, and garlic in a small bowl until thoroughly combined; pour sauce over ribs. Stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until ribs are tender, 4 to 6 hours; stir occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
