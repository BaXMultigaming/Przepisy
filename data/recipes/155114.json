    "publisher-tested"
  ],
  "ingredients": [
    "4 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "1 teaspoon salt",
    "1.3333333730698 cups butter",
    "1 cup packed brown sugar",
    "0.66666668653488 cup white sugar",
    "2 eggs, beaten",
    "1.5 teaspoons vanilla extract",
    "1 drop red food coloring, or as needed",
    "1 drop green food coloring, or as needed"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_Eg1IOtncEPKt9FEY-oY_GWB4xE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-155114-Christmas-Pinwheel-Cookies-step-01-7c36070e72dd49ff8aa3fb16edc31e4d.jpg"
      ],
      "image": "assets/images/155114/step_01.webp"
    },
    {
      "text": "Sift flour, baking powder, baking soda, and salt together into a bowl. Resift again into another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WKO4dP1WQPk0gWE162o3RL0U8ao=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-155114-Christmas-Pinwheel-Cookies-step-02-8b99a33628a1498f8c1a1789292f14c3.jpg"
      ],
      "image": "assets/images/155114/step_02.webp"
    },
    {
      "text": "Beat butter with brown and white sugars in a mixing bowl until light and fluffy. Beat in the eggs and vanilla until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fn8MuMx39q1P6VQtMwx3SQHmNY0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-155114-Christmas-Pinwheel-Cookies-step-03-bfafed02ec0c4176bfb6ee01a3875c37.jpg"
      ],
      "image": "assets/images/155114/step_03.webp"
    },
    {
      "text": "Gradually stir in the flour mixture until evenly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DzFhe0hDBIdBbXvNvRbY3kbddLg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-155114-Christmas-Pinwheel-Cookies-step-04-e0d0b271b28741bda830a39597e87c56.jpg"
      ],
      "image": "assets/images/155114/step_04.webp"
    },
    {
      "text": "Gather dough into a ball, and divide into two equal parts. Place one half in a second bowl. Add red food coloring to the dough in one bowl, and green food coloring to the dough in the other bowl. Use a fork or wooden spoon to blend the food coloring into the dough until evenly blended. Add additional drops of food coloring to reach your desired shade, if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5JCIIEAvQjbM6glbgXsIk0F_414=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-155114-Christmas-Pinwheel-Cookies-step-05-3973817208c24fceb2a5d72857f78336.jpg"
      ],
      "image": "assets/images/155114/step_05.webp"
    },
    {
      "text": "Roll out the red dough to 1/4 inch (5mm) thickness. Roll out the green dough to 1/4 inch (5mm) thickness, and place on top of the red dough. Beginning on one edge, roll the doughs to make a log so the two colors spiral inside each other.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9YsYXMyLVxZDpf7OCsIVyVx98Mk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-155114-Christmas-Pinwheel-Cookies-step-06-a1ee9cbc8e9a4a629579e9bdc31e84e6.jpg"
      ],
      "image": "assets/images/155114/step_06.webp"
    },
    {
      "text": "Wrap the log in waxed paper, then in a cotton towel, and refrigerate at least 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JmQGsn5oNGzPQo1oSkuzqXS2g-M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-155114-Christmas-Pinwheel-Cookies-step-07-74481f48be3a429ab443371719641d0c.jpg"
      ],
      "image": "assets/images/155114/step_07.webp"
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease 2 baking sheets. Unwrap the dough log, and place on a clean, lightly floured surface. Slice the log into rounds 1/8 inch (3 mm) thick, and place on prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R432sg_nb7qwZdyTH7OQhLtZ4wY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-155114-Christmas-Pinwheel-Cookies-step-08-6186a0e5422945a1a84d98eec392f28a.jpg"
      ],
      "image": "assets/images/155114/step_08.webp"
    },
    {
      "text": "Bake in preheated oven until set, 5 to 6 minutes. Watch carefully to prevent edges from browning. Remove from oven, and cool on racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f8j-tYh6QkBxKim1tQKcL32TbfU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-155114-Christmas-Pinwheel-Cookies-step-09-ee42a02efb414a2fbab0e0b09971c40a.jpg"
      ],
      "image": "assets/images/155114/step_09.webp"
    }
  ],
