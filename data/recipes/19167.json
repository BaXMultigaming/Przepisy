  "ingredients": [
    "4 cups skim milk, divided",
    "1 (1 ounce) package instant sugar-free vanilla pudding mix",
    "1 cup egg substitute",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "In a medium bowl combine 2 cups milk and pudding mixture; stir well until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To the pudding add remaining 2 cups milk and egg substitute; mix well. Stir in vanilla extract, salt and nutmeg until well blended and coats a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
