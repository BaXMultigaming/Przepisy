  "ingredients": [
    "0.75 cup white sugar",
    "0.5 cup butter, softened",
    "1 tablespoon brown sugar",
    "1 tablespoon instant hot chocolate mix",
    "3 bananas, peeled",
    "1 large fresh peach - peeled, pitted, and diced",
    "2 eggs",
    "0.25 cup milk",
    "1 tablespoon vanilla extract",
    "2 cups all-purpose flour",
    "0.5 cup chopped walnuts",
    "1 teaspoon baking soda",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar and butter together in a large bowl with an electric mixer until light and fluffy. Beat in brown sugar and hot chocolate mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bananas, peach, eggs, milk, and vanilla extract in a blender; blend until smooth. Stir puréed mixture into butter mixture until well incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, walnuts, baking soda, and salt together in a separate bowl until evenly combined; stir into banana-butter mixture until just moistened. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 50 to 60 minutes. Cool in the pan for 5 minutes, then transfer bread to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
