  "title": "Lemon Poppyseed Scones",
  "description": "A different twist on scones with a lemon flavor. Good with any topping or just plain.",
  "authors": [
    "EGGIE4"
  ],
  "date_published": "2020-06-18T23:10:46-04:00",
