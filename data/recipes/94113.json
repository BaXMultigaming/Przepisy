    {
      "text": "Season roast with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/boDNyjma0rXMPQbvm3xSXevgjQc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-94113-High-Temperature-Eye-of-Round-Roast-DDMFS-4x3-step-01-ef946bf4e9974c3ebed7624e62471988.jpg"
      ],
      "image": "assets/images/94113/step_02.webp"
    },
    {
      "text": "Place in a roasting pan or baking dish. Do not cover or add water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EVNDx0b_6uqU-0sVWqlYobaqwwg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-94113-High-Temperature-Eye-of-Round-Roast-DDMFS-4x3-step-02-3c8e9429982445c7bfbd4aad6dfabb85.jpg"
      ],
      "image": "assets/images/94113/step_03.webp"
    },
    {
      "text": "Place roast in the preheated oven and reduce temperature to 475 degrees F (245 degrees C). Roast for 21 minutes (7 minutes per pound), then turn off the oven and let roast sit in the hot oven for 2 1/2 hours. Do not open the door at all during this time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UfErnVkqg0XQj3YwnXlfWmdlGI4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-94113-High-Temperature-Eye-of-Round-Roast-DDMFS-4x3-step-03-17f4d8d8ba6b469e863e0541e4b2a2a5.jpg"
      ],
      "image": "assets/images/94113/step_04.webp"
    },
    {
      "text": "Remove roast from the oven and check that the internal temperature is at least 145 degrees F (65 degrees C). Carve into thin slices to serve.",
