  "ingredients": [
    "2 pounds ground beef",
    "1 egg",
    "1 onion, chopped",
    "1 pinch salt",
    "1 (12 fluid ounce) can or bottle chili sauce",
    "2 teaspoons lemon juice",
    "1 cup grape jelly"
  ],
  "steps": [
    {
      "text": "Combine beef, egg, onion, and salt in a large mixing bowl; shape into 1 1/2-inch balls.",
