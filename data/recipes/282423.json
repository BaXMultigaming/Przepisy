  "ingredients": [
    "1 quart oil for frying, or as needed",
    "2 cups all-purpose flour",
    "3 tablespoons all-purpose flour",
    "0.5 cup brown sugar",
    "1 tablespoon baking powder",
    "1 teaspoon salt",
    "0.25 teaspoon ground cinnamon",
    "1 dash ground nutmeg",
    "2 tablespoons unsalted butter, melted",
    "0.25 cup mashed sweet potatoes",
    "0.25 cup milk",
    "0.25 cup applesauce",
    "1 large egg",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 cups plus 3 tablespoons flour, brown sugar, baking powder, salt, cinnamon, and nutmeg in a large bowl. Stir in melted butter until crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sweet potatoes, milk, applesauce, egg, and vanilla extract in a medium bowl. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour wet ingredients into dry ingredients and combine, kneading well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn out onto a well floured surface and roll to 1/4-inch thickness. Cut with a donut cutter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly lower the doughnuts into the hot oil. Fry in batches, turning once, until golden, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
