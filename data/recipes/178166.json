  "ingredients": [
    "2 cups white sugar",
    "2 teaspoons dried lavender buds",
    "0.5 cup butter, softened",
    "0.25 cup virgin coconut oil, softened",
    "2 cups all-purpose flour",
    "1 dash salt",
    "0.25 cup all-purpose flour",
    "4 eggs, beaten",
    "0.5 cup lemon juice",
    "0.5 teaspoon lemon extract",
    "0.5 teaspoon dried lavender buds",
    "0.25 cup confectioners' sugar, for dusting"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease an 8x12 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make lavender sugar by blending the sugar and 2 teaspoons lavender buds in a blender; blend until the lavender is powdered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend together with an electric mixer 1/4 cup of the lavender sugar, butter, coconut oil, 2 cups flour, and salt in a bowl until a dough forms; press into the bottom of the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top begins to turn golden brown; about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the dough bakes, mix together the remaining lavender sugar, 1/4 cup flour, eggs, lemon juice, lemon extract, and 1/2 teaspoon lavender buds; pour over the baked crust and return to the oven to bake until the center is set, about 20 minutes. Allow to cool completely and dust with confectioners' sugar before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
