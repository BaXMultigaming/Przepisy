  "ingredients": [
    "1 cup butter, softened",
    "2.5 cups all-purpose flour",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 egg",
    "1 teaspoon baking powder",
    "1 teaspoon vanilla extract",
    "0.25 cup raspberry preserves",
    "0.33333334326744 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream the butter with the white sugar and brown sugar. Beat in the egg and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the flour and baking powder together. Stir in the flour mixture into the butter mixture and combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into 1 inch balls and place on the prepared baking sheet. Make an indentation in each cookie and fill with jam. Bake at 350 degrees F (175 degrees C) for 12 to 15 minutes. Let cool completely and sprinkle with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
