  "ingredients": [
    "1 cup butter, softened",
    "0.5 cup brown sugar",
    "0.5 teaspoon maple-flavored extract",
    "1.5 cups all-purpose flour, or more if needed",
    "0.75 cup toffee baking bits"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter, brown sugar, and maple extract together in a bowl until smooth. Add flour; stir to combine. Fold in toffee bits. Spoon batter, about 1 tablespoon per cookie, onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, about 15 minutes.",
      "section": null,
