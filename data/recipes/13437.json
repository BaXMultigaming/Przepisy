  "ingredients": [
    "2 (14.5 ounce) cans stewed tomatoes",
    "3 cups water",
    "2 cups beef broth",
    "1 cup fresh lima beans",
    "1 cup frozen corn kernels",
    "1 cup sliced carrots",
    "2 tablespoons chopped onion",
    "2 tablespoons Old Bay Seasoning TM",
    "1 gallon water",
    "10 blue crab claws, steamed",
    "1 pound blue crab crabmeat"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zS2FT0iT32EXOhzRcGY8wL6dt30=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13437-MarylandCrabSoup-mfs-Step1-0842_preview_maxWidth_2000_maxHeight_1500_ppi_300_quality_100-ae99c57022ab4624a86c392abdb0e224.jpg"
      ],
      "image": "assets/images/13437/step_01.webp"
    },
    {
      "text": "Place stewed tomatoes, 3 cups water, beef broth, lima beans, corn, sliced carrots, chopped onion, and Old Bay seasoning in a 4-quart pot. Bring to a simmer over medium heat; cover and cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FNr8I57m2I48G4jWd0KHs4A89CE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13437-MarylandCrabSoup-mfs-Step2-0850_preview_maxWidth_2000_maxHeight_1500_ppi_300_quality_100-f51b4e274ffa401295383b91488f3f58.jpg"
      ],
      "image": "assets/images/13437/step_02.webp"
    },
    {
      "text": "Bring 1 gallon water to a boil in a large pot. Add crab claws and boil for 6 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir crabmeat and boiled crab claws into tomato and vegetable mixture. Cover and simmer for 10 to 15 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1r-8G0Rf1hw5dCJnSNrYd4kTy1I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13437-MarylandCrabSoup-mfs-Step3-0855_preview_maxWidth_2000_maxHeight_1500_ppi_300_quality_100-40777eddd69e45b2ae64a9cc16602165.jpg"
      ],
