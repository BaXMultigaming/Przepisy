  "ingredients": [
    "2 cups milk",
    "1 cup water",
    "1.5 teaspoons butter",
    "0.25 teaspoon salt",
    "0.33333334326744 cup semolina flour",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Combine milk, water, butter, and salt in a saucepan over medium-high heat. Bring to a boil, stirring gently. Remove from heat. Pour in semolina flour in a steady stream, whisking constantly to prevent lumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the saucepan back over medium heat; whisk until porridge comes to a boil, about 2 minutes. Reduce heat to low, cover, and cook, stirring occasionally, until porridge thickens, about 20 minutes. Remove saucepan from heat; stir in sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let porridge stand for 3 to 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
