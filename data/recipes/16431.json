  "ingredients": [
    "1 tablespoon olive oil",
    "2 cloves garlic, minced",
    "1 (6 ounce) can tomato sauce",
    "0.25 cup salsa",
    "2.5 teaspoons chili powder",
    "1 teaspoon minced onion",
    "1 teaspoon dried parsley",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon dried oregano",
    "0.25 teaspoon ground cumin",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon salt",
    "1.5 cups water"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large saucepan over medium heat. Sauté garlic in hot oil for 1 to 2 minutes. Add tomato sauce, salsa, chili powder, onion, parsley, basil, oregano, cumin, black pepper, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in water; bring to a boil. Reduce heat to low and simmer for 15 to 20 minutes.",
