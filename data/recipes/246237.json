  "ingredients": [
    "cooking spray",
    "0.75 cup butter, melted",
    "2 individual packages graham crackers, crushed",
    "0.5 (12 ounce) bag chocolate chips, or more to taste",
    "0.5 (12 ounce) package butterscotch chips",
    "0.5 (10.5 ounce) package miniature marshmallows",
    "0.5 (14 ounce) can sweetened condensed milk, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x8-inch square pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix melted butter and graham cracker crumbs together; press into an even layer at the bottom of the pan. Top with chocolate chips, butterscotch chips, and marshmallows. Drizzle sweetened condensed milk on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly, 17 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cool, about 30 minutes. To make it easier to cut into bars, cover with plastic wrap and chill, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
