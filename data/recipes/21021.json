  "ingredients": [
    "2 large zucchini, thinly sliced",
    "2 tablespoons olive oil",
    "1 large onion, diced",
    "2 cloves garlic, minced",
    "1 (16 ounce) jar spaghetti sauce",
    "1 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil; add zucchini slices and cook until tender; drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a medium skillet over medium heat; stir in onion and garlic and cook until onion is tender, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine zucchini, onion, and garlic in a 9x12-inch casserole dish; pour marinara sauce on top and stir well. Top with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until zucchini slices are heated through and cheese is bubbly, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
