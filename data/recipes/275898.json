  "ingredients": [
    "0.5 cup brown sugar",
    "0.5 cup applesauce",
    "0.25 cup canola oil",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.75 teaspoon salt",
    "1 cup whole wheat flour",
    "1 cup natural wheat bran",
    "3 tablespoons ground flax",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together brown sugar, applesauce, canola oil, egg, vanilla extract, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, bran, flax, baking soda, and baking powder in a separate bowl. Add bran mixture to applesauce mixture. Add milk and stir until thoroughly combined. Pour batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 11 to 13 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
