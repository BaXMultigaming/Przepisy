  "ingredients": [
    "1.5 pounds ground beef",
    "0.66666698455811 cup crushed saltine cracker crumbs",
    "0.33333298563957 cup minced onion",
    "1 egg",
    "0.25 cup milk",
    "1.5 teaspoons ground ginger",
    "0.5 teaspoon salt",
    "1 tablespoon olive oil",
    "2 tablespoons cornstarch",
    "0.5 cup packed brown sugar",
    "1 (15 ounce) can pineapple chunks - drained, with juice reserved",
    "0.33333298563957 cup white vinegar",
    "1 tablespoon soy sauce",
    "0.33333298563957 cup chopped green bell pepper"
  ],
  "steps": [
    {
      "text": "In a large bowl, combine ground beef, cracker crumbs, onion, egg, milk, ginger and salt. Shape mixture by rounded tablespoonfuls into meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat. Place meatballs in skillet and cook until evenly brown, and meat is no longer pink. Drain excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine the cornstarch, brown sugar, reserved pineapple juice, vinegar and soy sauce. Mix until smooth, then pour into the skillet with meatballs. Cook, stirring constantly, until mixture thickens and boils, about 5 minutes. Stir in the green pepper and pineapple chunks. Heat through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
