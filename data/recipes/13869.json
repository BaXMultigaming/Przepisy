  "steps": [
    {
      "text": "Preheat oven to 275 degrees F. (135 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove any visible excess fat from ham. Place the ham in a large turkey roasting oven bag and place in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cola over ham, remove as much air as possible and seal bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prick a few holes in bag to let steam escape and bake for 4 to 5 hours. Pour off excess juice and slice.",
