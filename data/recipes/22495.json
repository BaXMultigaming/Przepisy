  "ingredients": [
    "1 zucchini, cubed",
    "1 head fresh broccoli, chopped",
    "1 red bell pepper, chopped",
    "1 carrot, chopped",
    "1 yellow onion, chopped",
    "4 small button mushrooms, chopped",
    "4 (10 inch) flour tortillas",
    "0.5 cup shredded sharp Cheddar cheese",
    "0.5 cup shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to broil. Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place zucchini, broccoli, bell pepper, carrot, onion and mushrooms in a steamer over 1 inch of boiling water, and cover. Cook until tender but still firm, about 2 to 6 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place two tortillas, side by side, on the prepared baking sheet. On each tortilla layer cheddar cheese, vegetables, then Monterey jack cheese. Top each with another tortilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place under the broiler and cook until lightly browned. Carefully turn tortillas and cook on the other side until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
