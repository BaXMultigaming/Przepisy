  "ingredients": [
    "1 tablespoon vegetable oil, or to taste",
    "2 pounds mackerel fillets",
    "1 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.25 cup butter, melted",
    "2 tablespoons lemon juice",
    "0.125 teaspoon ground paprika"
  ],
