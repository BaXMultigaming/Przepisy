  "ingredients": [
    "0.75 cup white sugar",
    "0.5 cup unsalted butter, softened",
    "2 large eggs",
    "2.5 cups self-rising flour",
    "1.25 cups milk",
    "1 teaspoon white vinegar",
    "1 teaspoon vanilla extract",
    "6 fresh apricots, pitted and halved, or more to taste",
    "1 cup all-purpose flour",
    "0.75 cup superfine (castor) sugar",
    "0.5 cup salted butter, softened, cut into cubes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 7x11-inch rectangular baking dish and line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, butter, and eggs together in a bowl with an electric mixer. Add self-rising flour, milk, vinegar, and vanilla extract and stir with spoon. Pour into the prepared dish. Cover with apricots, pitted-sides down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place all-purpose flour, superfine sugar, and cubed butter into a bowl. Rub butter into flour and sugar with your fingertips until crumbles form. Sprinkle topping evenly over the apricots.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and a toothpick inserted into the center comes out clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
