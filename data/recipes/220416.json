        "https://www.allrecipes.com/thmb/rAvrjqSjStVnBc38pR2UQu5PHUA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220416-chef-johns-hamemade-chicken-noodle-soup-mfs-step-3-0a19e60d7de042a192cf936c1c386dd2.jpg"
