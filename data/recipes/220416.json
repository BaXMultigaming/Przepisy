      ],
      "image": "assets/images/220416/step_01.webp"
    },
    {
      "text": "Stir in roasted chicken broth and bring to a boil. Season with salt, if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y4t5m0eAqwNFPxSRiE7ykFNEsE8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220416-chef-johns-hamemade-chicken-noodle-soup-mfs-step-2-f1f64fbc991544188440db790eac8f38.jpg"
      ],
      "image": "assets/images/220416/step_02.webp"
    },
    {
      "text": "Stir in egg noodles; cook until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked chicken breast meat; simmer until heated through, about 5 minutes. Season with cayenne pepper, salt, and black pepper.",
      "section": null,
      "name": null,
