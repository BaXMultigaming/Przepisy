  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup chopped walnuts",
    "3 tablespoons ice water",
    "0.5 teaspoon salt",
    "0.75 cup butter",
    "1 teaspoon vanilla extract",
    "3 tablespoons white sugar",
    "2 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "If using butter it must be cold. Mix butter with flour until it resembles fine crumbs. Add white sugar, nuts, and salt. Mix well, adding ice water till you make stiff dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add vanilla extract and knead lightly. Roll out on floured board 1/4 inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut into crescent shapes using a whiskey glass coated with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (180 degrees C) until bottoms are lightly browned. While hot, roll in confectioner's sugar, (I usually use a brown bag or baggie bag to roll the cookies in with the powdered sugar).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
