  "ingredients": [
    "1 tablespoon oil, or as needed",
    "1 onion, chopped",
    "1 pound ground beef",
    "0.5 slice bread",
    "0.5 cup milk, divided",
    "1 egg, beaten, divided",
    "0.25 cup seedless raisins",
    "1 tablespoon white vinegar",
    "2 teaspoons white sugar",
    "1 teaspoon ground turmeric",
    "1 teaspoon salt",
    "0.5 teaspoon curry powder",
    "0.25 teaspoon ground black pepper",
    "2 bay leaves",
    "1.5 tablespoons chutney"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium-high heat; add onion and saute until browned, about 5 minutes. Add ground beef to onion and saute until browned, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Soak bread in 1/4 cup milk in a small bowl, mash, and add to ground beef mixture; stir in 1/2 of beaten egg, raisins, vinegar, sugar, turmeric, salt, curry powder, and ground black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer beef mixture to glass baking dish; insert bay leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes. Whisk remaining 1/2 egg and remaining 1/4 cup milk together in a small bowl; pour over meat mixture and return to oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with chutney.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
