  "ingredients": [
    "1 pound skinless, boneless chicken breast halves",
    "0.5 large red onion, chopped",
    "1 cucumber - peeled, seeded, and diced",
    "2 cloves garlic, minced",
    "1 cup ranch dressing",
    "1 pinch ground black pepper to taste"
