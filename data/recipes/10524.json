  "ingredients": [
    "1 cup packed brown sugar",
    "0.5 cup butter, softened",
    "0.5 cup shortening",
    "0.25 cup white sugar",
    "1 egg",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "2 cups mini semi-sweet chocolate chips",
    "1 (6 ounce) package almond brickle chips",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugars, butter, and shortening until light and fluffy. Mix in egg and vanilla. Stir in flour, baking soda, baking powder, and salt. Stir in chocolate chips and almond brickle chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded teaspoons onto ungreased cookie sheets. Bake in the preheated oven until lightly browned, about 9 to 10 minutes; switch racks halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
