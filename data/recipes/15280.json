  "ingredients": [
    "5 potatoes, peeled and cubed",
    "5 cubes chicken bouillon",
    "2.5 quarts water",
    "salt and pepper to taste",
    "1 dash garlic powder",
    "1 pinch ground nutmeg",
    "1 pint heavy whipping cream",
    "3 green onions, chopped"
  ],
  "steps": [
    {
      "text": "In a large pot over high heat, combine the potatoes, bouillon, water, salt and pepper, garlic powder and nutmeg. Cook for about 15 minutes or until potatoes are tender. Add the heavy cream and the green onions. Stir well and allow soup to bubble up, about 5 minutes. Remove from heat and pour into individual bowls. Garnish with bacon bits and enjoy!",
