  "title": "Gorditas",
  "description": "Gorditas are thick corn cakes made with masa dough and fried until puffy to create a pocket for stuffing with cheese, beans, or your favorite Mexican filling.",
  "authors": [
    "Diana CakeLady Rangel"
  ],
  "date_published": "2019-04-03T23:33:07-04:00",
  "date_modified": "2026-04-17T05:27:19-04:00",
