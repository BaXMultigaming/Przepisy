    "Dinner"
  ],
  "cuisines": [
    "Mexican"
  ],
  "regions": [
    "Mexican"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 cup masa harina (instant corn masa mix)",
    "1 cup hot water",
    "1 teaspoon salt",
    "1 cup all-purpose flour",
    "1 1/2 teaspoons baking powder",
    "1 tablespoon shortening",
    "1 cup oil for frying"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DBCyUy-Q3uWnmmmp_GrDqn3wP3s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78174-gorditas-DDMFS-001-794d41f2e07346aab94dd67c105227a8.jpg"
      ],
      "image": "assets/images/78174/step_01.webp"
    },
    {
      "text": "Stir masa harina, water, and salt together in a large bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UttnCnP59wrnhaSCMTXDziDSzHQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78174-gorditas-DDMFS-002-13e6154bf8d54fbabb9212e16c7fd8ca.jpg"
      ],
      "image": "assets/images/78174/step_02.webp"
    },
    {
      "text": "Whisk flour and baking powder together in a small bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4viIL2FXTv3v7lvnMmA0GmsLUog=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78174-gorditas-DDMFS-003-79e5fcf9726941edb71d59e3dd991b85.jpg"
      ],
      "image": "assets/images/78174/step_03.webp"
    },
    {
      "text": "Gradually stir flour mixture and shortening into masa harina mixture, using clean hands when mixture is cool enough to touch. If dough seems dry, add more hot water, 1 to 3 teaspoons at a time, until dough is somewhat clay-like in texture, evenly moistened, and tacky but not sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pIVD6VoUyxjlH-wSmhtfRZPUIl0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78174-gorditas-DDMFS-004-29e4aa61eada49c38e152246855b2ccf.jpg"
      ],
      "image": "assets/images/78174/step_04.webp"
    },
    {
      "text": "Evenly divide and roll dough into 6 balls (about 2 ½ inches or 2 ¾ ounces each); keep covered with plastic wrap while working.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8ya9Vpxz-aT07spDj3BsUSgbCNY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78174-gorditas-DDMFS-005-c2e1b27bd4df4606834f064a449691f2.jpg"
      ],
      "image": "assets/images/78174/step_05.webp"
    },
    {
      "text": "Line a work surface with waxed paper or plastic wrap; sprinkle lightly with water. Working with one ball at a time, flatten balls on the wet surface into a 5 ½-inch disc (about until about 1⁄8-inch thick). Transfer discs to a waxed paper- or plastic wrap-lined baking sheet; keep covered with plastic wrap while working with remaining dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CETLsdApxdGULLnSIghwmFGP5dU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78174-gorditas-DDMFS-006-d796e45e37694bcb9ab53809e6e671ae.jpg"
      ],
      "image": "assets/images/78174/step_06.webp"
    },
    {
      "text": "Heat a griddle or comal over medium heat. Working in batches if needed, cook gorditas until dry to the touch with some small, very lightly golden spots, about 2 to 3 minutes per side. Place gorditas in a single layer, uncovered, on large plates or a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pBEWHSKCQT60MmV_OlBWpc3Zpuo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78174-gorditas-DDMFS-007-eb44789499b845b886aadad15f128eea.jpg"
      ],
      "image": "assets/images/78174/step_07.webp"
    },
    {
      "text": "Heat oil in a large, heavy skillet over medium to medium-high heat until hot enough to bubble immediately when edge of gordita is dipped in. Fry gorditas, one by one, until puffed, gently pressing it down into the oil occasionally with a spatula, about 45 seconds per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NCVxAQijgW65wPeOd6i9yy_fAsg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78174-gorditas-DDMFS-008-86d316193bd142438e79ea40f1c9bd83.jpg"
      ],
      "image": "assets/images/78174/step_08.webp"
    },
    {
      "text": "Drain briefly on paper towels, then cut crosswise to create an opening large enough to stuff gorditas full of your favorite foods. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zDN05JCF6jn2xvePln-Ub6lPMo0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78174-gorditas-DDMFS-014-4x3-053f8ba0a56843c6ba854301c88298f9.jpg"
      ],
      "image": "assets/images/78174/step_09.webp"
    }
  ],
