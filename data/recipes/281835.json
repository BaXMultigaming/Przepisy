  "ingredients": [
    "2 pieces heavy-duty aluminum foil",
    "cooking spray",
    "1 medium potato, peeled and cut into 1/2-inch cubes",
    "2 tablespoons diced red bell pepper",
    "1 (1 ounce) package seafood seasoning",
    "3 teaspoons butter, divided",
    "2 (7 ounce) tilapia fillets",
    "1 medium lemon, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray foil with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place equal amounts of diced potato and red bell pepper in the middle of each piece of foil and sprinkle with 1/2 of the seafood seasoning. Dot 1 1/2 teaspoons of butter on top of the potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 1 tilapia fillet to each packet of potatoes. Sprinkle fillet with remaining seafood seasoning. Dot remaining 1 1/2 teaspoons butter on top of the fillets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut 1/2 of the lemon into thin slices and place 1 to 2 lemon slices on top of each fillet. Seal foil packets and crimp edges tightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tilapia flakes easily with a fork, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Open packets carefully and vent steam. Squeeze remaining lemon juice over the tilapia and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
