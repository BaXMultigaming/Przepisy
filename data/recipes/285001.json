  "ingredients": [
    "2 pounds skinless, boneless chicken breast",
    "1 (12 fluid ounce) can or bottle cola-flavored carbonated beverage (such as Coca-Cola®)",
    "1.5 cups barbeque sauce",
    "0.5 cup raspberry walnut vinaigrette",
    "0.25 cup light brown sugar",
    "3 tablespoons honey",
    "2 tablespoons teriyaki marinade (such as Kikkoman®)",
    "0.5 teaspoon ground cardamom",
    "0.25 cup mayonnaise, or to taste",
    "8 medium hamburger buns, split"
  ],
  "steps": [
    {
      "text": "Place chicken in a slow cooker and pour cola-flavored beverage around it. Turn slow cooker to High and cook for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix barbecue sauce, vinaigrette, brown sugar, honey, teriyaki marinade, and cardamom in a mixing bowl until well blended. Place in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "After 3 hours, remove chicken from the slow cooker and shred. Set aside 1/2 cup of the cooking juices and discard the rest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return chicken and 1/2 cup juice to the slow cooker; stir to combine. Remove barbecue sauce from the refrigerator and pour and blend it into the chicken. Cook for 1 more hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread mayonnaise on hamburger buns and fill with pulled chicken and sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
