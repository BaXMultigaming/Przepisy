  "ingredients": [
    "0.5 cup butter",
    "0.75 cup white sugar",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1.5 cups grated zucchini",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 cup quick cooking oats",
    "1 cup granola",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream butter and sugar until fluffy. Stir in the egg and vanilla, mix well, then stir in the shredded zucchini. Sift together the flour, baking soda and cinnamon, stir into the zucchini mixture. Finally, stir in the oats, granola and chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough from a teaspoon onto an unprepared cookie sheet. Leave at least 2 inches between cookies. Bake for 10 to 12 minutes in the preheated oven. The cookies will stay soft and moist because of the zucchini.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
