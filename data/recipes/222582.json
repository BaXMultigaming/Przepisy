  "title": "Baked Spaghetti",
  "description": "This baked spaghetti dish is comfort food at its best! Layers of pasta, meat sauce, and lots of melted cheese make this a perfect weeknight casserole.",
  "authors": [
    "CALLIKO"
  ],
  "date_published": "2019-04-02T02:57:31-04:00",
  "date_modified": "2026-03-05T05:26:15-05:00",
