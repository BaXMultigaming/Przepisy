  "ingredients": [
    "1 pound lean ground beef",
    "0.5 cup bacon, chopped",
    "1 (15 ounce) can pork and beans",
    "1 (15 ounce) can kidney beans, drained",
    "1 (15 ounce) can butter beans",
    "1 (15 ounce) can lima beans, drained",
    "1 cup packed brown sugar",
    "1 cup chopped onion",
    "0.5 cup chopped celery",
    "0.5 cup ketchup",
    "3 tablespoons white wine vinegar",
    "1 teaspoon mustard powder"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UOHvQoEsA03QBnpuSdRXroVPTL8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13795-Calico-Beans-Step-1-554d6926d58a4e9ca498c625e9f0c6e3.jpg"
      ],
      "image": "assets/images/13795/step_01.webp"
    },
    {
      "text": "Cook ground beef and bacon in a large, deep skillet over medium-high heat until evenly brown. Drain and transfer meat to a 4-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/760K7rZOEXx6Q2cE0Gj_hjDOfu0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13795-Calico-Beans-Step-2-1cb2071c251e410d86052be699b953fa.jpg"
      ],
      "image": "assets/images/13795/step_02.webp"
    },
    {
      "text": "Add pork and beans, kidney beans, butter beans, lima beans, brown sugar, onion, celery, ketchup, vinegar, and dry mustard to the casserole dish; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ukSohAF2Si3RxCE2cI0vtloWnYk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13795-Calico-Beans-Step-3-e3130efb927e444cab2e65a4ddfd681d.jpg"
      ],
      "image": "assets/images/13795/step_03.webp"
    },
    {
      "text": "Bake, covered, in the preheated oven until bubbly and heated through, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
