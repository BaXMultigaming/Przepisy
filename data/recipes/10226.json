  "ingredients": [
    "4 cups all-purpose flour",
    "1 cup white sugar",
    "1 tablespoon baking powder",
    "0.75 cup vegetable oil",
    "0.5 cup milk",
    "2 large eggs",
    "1 tablespoon anise extract",
    "1 cup confectioners' sugar",
    "2 tablespoons hot water",
    "1 teaspoon anise extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease or line cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, and baking powder together in a large bowl. Make a well in the center and add oil, milk, eggs, and 1 tablespoon anise extract; mix together to form a workable dough. Roll dough into walnut-sized balls, flatten slightly, and place 1 inch apart onto prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make the icing: Mix confectioners’ sugar, hot water, and 1 teaspoon anise extract together until smooth. Spoon or drizzle over warm cookies and allow to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
