  "ingredients": [
    "2 tablespoons butter, divided",
    "1 green bell pepper, chopped",
    "1 cup sliced mushrooms",
    "0.5 cup chopped onion",
    "2 teaspoons dried parsley",
    "6 large eggs",
    "0.25 cup milk",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 cup shredded Cheddar cheese, divided",
    "0.5 (15 ounce) can black beans, rinsed and drained"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 8x8-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1 tablespoon butter in a saucepan over medium heat; cook and stir bell pepper, mushrooms, onion, and parsley until mushrooms are lightly browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place remaining 1 tablespoon butter in a microwave-safe bowl; heat in microwave until melted, about 10 seconds. Whisk together melted butter, eggs, milk, salt, and pepper in a bowl; stir in mushroom mixture, 1/2 of the Cheddar cheese, and black beans. Pour egg mixture into the prepared baking dish and top with remaining Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until eggs are puffed and cheese is bubbling, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
