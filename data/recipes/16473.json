  "ingredients": [
    "2 pounds ground beef",
    "0.5 onion, chopped",
    "1 (10 ounce) package saltine crackers, crushed",
    "salt to taste",
    "0.25 teaspoon ground black pepper",
    "1 tablespoon steak sauce",
    "2 eggs",
    "0.75 cup water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the beef, onion, crushed crackers, salt, ground black pepper, steak sauce, eggs and water and mix well. Transfer to an ungreased 9x13 inch baking dish. Form into a loaf about 6x10 inches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour, or until center is completely cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
