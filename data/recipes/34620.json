  "ingredients": [
    "1 cup barley",
    "2.5 cups water",
    "1 pound cooked bay shrimp",
    "2 cups frozen corn, thawed",
    "0.5 cup diced green bell pepper",
    "0.5 cup diced red bell pepper",
    "4 green onions, chopped",
    "1 tablespoon chopped fresh thyme",
    "1 teaspoon minced lemon zest",
    "0.25 cup fresh lemon juice",
    "0.25 cup olive oil",
    "0.5 teaspoon salt",
    "0.5 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Combine barley and water in a saucepan. Bring to a boil. Cover, reduce heat, and simmer for approximately 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer barley to a large bowl, and toss with shrimp, corn, bell peppers, green onions, thyme, and lemon zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, whisk together lemon juice and oil. Season with salt and pepper. Pour dressing over barley salad, and toss to combine.",
