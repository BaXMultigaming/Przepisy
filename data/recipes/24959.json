  "ingredients": [
    "2 tablespoons unflavored gelatin",
    "0.5 cup cold water",
    "2 cups boiling water",
    "0.33000001311302 cup lemon juice",
    "1.75 cups white sugar",
    "5 egg whites"
  ],
  "steps": [
    {
      "text": "Sprinkle gelatin over cold water and let rest until water is absorbed, 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, combine gelatin, boiling water, lemon juice and sugar, stirring until sugar is dissolved. Chill in refrigerator, stirring occasionally, until mixture coats the back of a metal spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites until stiff. Beat lemon mixture until frothy. Fold egg whites into lemon mixture until mixture holds together. Pour into greased molds and chill until set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
