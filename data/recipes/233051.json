  "ingredients": [
    "1 tablespoon butter",
    "1 tablespoon all-purpose flour",
    "1 pinch white sugar",
    "ground black pepper to taste",
    "2 (15 ounce) cans young peas (such as LeSueur® Very Young Small Early Peas), drained",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium heat. Stir flour, sugar, and pepper into the melted butter until smooth.",
