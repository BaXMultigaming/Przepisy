  "ingredients": [
    "1 cup chopped red bell pepper",
    "0.5 cup chopped jalapeno pepper",
    "5 cups white sugar",
    "1.5 cups apple cider vinegar",
    "1 (6 fluid ounce) container liquid pectin"
  ],
  "steps": [
    {
      "text": "Remove stems, veins and most of the seeds of the bell and jalapeno peppers. Mince peppers in a food processor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4u9x_sPeEyxJClBUg0i4WrEVBpc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19137-red-and-green-christmas-jalapeno-jelly-VAT-step-01-5bc7cd51ae644ca1915444ebe2582929.jpg"
      ],
      "image": "assets/images/19137/step_01.webp"
    },
    {
      "text": "In a 5-quart pot over high heat, combine bell peppers, jalapenos, sugar and vinegar. Bring to a rolling boil; boil for 3 minutes. Remove from heat and cool for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Kf7rL47PA_Qb0wXYqff90rXnVgs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19137-red-and-green-christmas-jalapeno-jelly-VAT-step-02-58892e5021de4c09ae1aa34daffead89.jpg"
      ],
      "image": "assets/images/19137/step_02.webp"
    },
    {
      "text": "Stirring constantly, add the pectin and let mixture continue to cool for 2 minutes more. Now stir for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WqNWZgRgMDvSyHcmyOnK4G5yfc4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19137-red-and-green-christmas-jalapeno-jelly-VAT-step-03-b8360873ee7b4431bd422241796de44a.jpg"
      ],
      "image": "assets/images/19137/step_03.webp"
    },
    {
      "text": "Pour into hot, sterilized jars and top with sterilized lids. Secure lids with bands and allow jars to cool slowly, creating a vacuum seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GQpIUORROsWHgktSo3N5FyY0yLc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19137-red-and-green-christmas-jalapeno-jelly-VAT-step-04-55e973c59259497b82753280907b9553.jpg"
      ],
      "image": "assets/images/19137/step_04.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Lt0Fu0CJwXwUtUaA0f57YJslMRY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19137-red-and-green-christmas-jalapeno-jelly-VAT-Beauty-4x3-b0d359a1c43f427c80ab8c1915c06f2c.jpg"
