  "ingredients": [
    "1 cup milk",
    "1 cup water",
    "1 cup white sugar",
    "1 (6 ounce) can frozen orange juice concentrate",
    "1 teaspoon vanilla extract",
    "7 ice cubes",
    "2 cups vanilla ice cream, or to taste",
    "0.25 cup whipped cream, or to taste"
  ],
  "steps": [
    {
      "text": "Combine milk, water, sugar, orange juice concentrate, and vanilla extract in a blender. Cover with ice cubes and blend orange mixture on Low, gradually increasing to High, until smooth.",
