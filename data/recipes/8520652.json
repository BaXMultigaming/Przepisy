  "ingredients": [
    "1.5 (8 ounce) packages cream cheese",
    "1 (1 ounce) envelope ranch dressing mix",
    "1.75 cups shredded rotisserie chicken",
    "1.5 cups sour cream",
    "1 cup cooked and chopped bacon (about 12 slices), plus more for garnish",
    "0.5 cup sliced scallions (from 2 large scallions), plus more for garnish",
    "0.5 teaspoon black pepper",
    "1.75 cups shredded sharp Cheddar cheese, divided"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gvYysG1aor8lf7mTLdObbOpAMiY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8520652-chicken-bacon-ranch-dip-step-1-4x3-3d8ced13e9ac40eaaf20c89170071483.jpg"
      ],
      "image": "assets/images/8520652/step_01.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cream cheese and ranch dressing mix in a microwaveable, broiler-safe 9-inch square casserole dish. Microwave on HIGH until combined and cream cheese is very soft, stirring halfway through, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v8PwBQ68dqCG7VGTtGwtg-rClPM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8520652-chicken-bacon-ranch-dip-step-2-4x3-e9e79ee38a63417c807a95071851d6bb.jpg"
      ],
      "image": "assets/images/8520652/step_03.webp"
    },
    {
      "text": "Remove from microwave; stir in chicken, sour cream, bacon, scallions, pepper, and 1 cup Cheddar cheese. Top with remaining 3/4 cup cheddar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4oVLs7dgVgrv1dYbykGwyxrBXsU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8520652-chicken-bacon-ranch-dip-step-3-4x3-374eda49d50d41e7b8512d2bbb832753.jpg"
      ],
      "image": "assets/images/8520652/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are bubbly, 25 to 30 minutes. Increase oven temperature to broil; cook until cheese is lightly golden brown in spots, 3 to 5 minutes. Remove from oven, and sprinkle with additional bacon and scallions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/86NVt1tHmVeCjKRV2oSgrPOusPU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8520652-chicken-bacon-ranch-dip-step-4-4x3-17feb22b98b54cfda54cbbc8790052d7.jpg"
      ],
      "image": "assets/images/8520652/step_05.webp"
    },
    {
      "text": "Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
