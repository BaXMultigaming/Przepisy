  "ingredients": [
    "1 (15 ounce) can pear halves, drained",
    "1 cup fresh cranberries",
    "4 cups sliced banana",
    "0.25 cup orange juice",
    "0.25 cup white sugar",
    "0.125 teaspoon salt",
    "0.125 teaspoon ground cloves",
    "0.5 cup brown sugar",
    "0.5 cup all-purpose flour",
    "0.25 cup rolled oats",
    "0.125 teaspoon ground cloves",
    "0.5 teaspoon grated orange zest",
    "3 tablespoons butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 1 1/2 quart casserole dish, mix pears, cranberries, bananas, orange juice, sugar, salt and 1/8 teaspoon cloves. Mix lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix brown sugar, flour, oats, remaining 1/8 teaspoon cloves and orange rind. Cut in butter until crumbly. Sprinkle over fruit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 to 20 minutes, or until top is golden brown. Serve at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
