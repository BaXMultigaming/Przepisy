  "ingredients": [
    "1.6666667461395 cups tapioca flour",
    "6 tablespoons water",
    "0.25 cup oil",
    "1 pinch salt",
    "1 egg, beaten",
    "6 tablespoons plain yogurt",
    "0.5 cup freshly grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Pour tapioca flour into a medium sized bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, oil, and salt in a saucepan and bring to boil. Pour oil mixture into flour mixture; stir with a wooden spoon until batter is combined. Let cool slightly. Fold in egg, yogurt, Parmesan cheese into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease hands with oil and form the batter into 12 balls; arrange on a nonstick baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce oven heat to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until toothpick inserted in the center comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
