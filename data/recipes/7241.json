  "ingredients": [
    "0.66670000553131 cup white sugar",
    "2 cups self-rising flour",
    "1 teaspoon ground cinnamon",
    "0.5 cup chopped walnuts",
    "2 eggs, beaten",
    "0.5 cup margarine, melted",
    "1 apple - peeled, cored and finely chopped",
    "0.5 cup shredded Cheddar cheese",
    "0.25 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the sugar, flour, cinnamon walnuts, apples, and cheese. Add the eggs, melted butter or margarine, and milk; stir until well blended. Pour into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 1 hour, or until done. If loaf starts to brown too much, cover with foil.",
