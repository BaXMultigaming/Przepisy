  "ingredients": [
    "1 (1 pound) loaf French bread",
    "0.5 cup chopped pecans",
    "0.5 cup unsalted butter, melted",
    "3 eggs",
    "1 cup half-and-half cream",
    "1.25 cups milk",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 cup white sugar",
    "1 teaspoon vanilla extract",
    "0.25 cup golden raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Cut bread into 1 inch thick slices. Arrange bread slices and pecans on a baking sheet and drizzle with melted butter; toast lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat together eggs, cream, milk, cinnamon, nutmeg, sugar and vanilla. Put bread and pecans in a lightly greased 7x11 in casserole dish. Pour egg mixture over bread. Make sure that bread slices are saturated with liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 60 minutes, until golden. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
