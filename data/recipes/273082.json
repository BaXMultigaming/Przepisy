  "ingredients": [
    "2 (8 ounce) packages refrigerated crescent rolls",
    "2 (8 ounce) packages cream cheese, softened",
    "0.75 cup sugar",
    "1 egg, separated",
    "1 teaspoon lemon juice",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press 1 package unseparated crescent rolls into bottom of a greased 9x12-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, sugar, egg yolk, lemon juice, and vanilla extract in a bowl with an electric mixer until fluffy; spread onto crescent roll \"crust\" in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover cream cheese filling with remaining package unseparated crescent roll dough; brush with egg white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden, 25 to 35 minutes. Cool before cutting.",
      "section": null,
      "name": null,
      "url": null,
