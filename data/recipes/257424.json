  "ingredients": [
    "0.66666668653488 cup white sugar",
    "0.5 cup butter, at room temperature",
    "2 eggs, at room temperature",
    "1 cup sour cream, at room temperature",
    "0.5 teaspoon almond extract",
    "0.5 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.5 cup almond flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon ground cardamom",
    "0.5 teaspoon salt",
    "2 cups mixed frozen berries",
    "2 tablespoons sliced almonds",
    "1 tablespoon turbinado sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and butter in a large bowl; beat with an electric mixer on medium-high speed until light and fluffy, 3 to 5 minutes. Add eggs one at a time, beating well after each addition. Mix in sour cream, almond extract, and vanilla extract until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir all-purpose flour, almond flour, baking soda, baking powder, cardamom, and salt together in a bowl. Add to the batter; mix on low speed just until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter evenly in the prepared pan. Scatter berries on top. Sprinkle sliced almonds and turbinado sugar over berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 45 to 50 minutes. Cool in the pan; serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
