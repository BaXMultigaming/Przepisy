  "ingredients": [
    "0.25 cup butter",
    "6 tablespoons carob powder",
    "1 cup white sugar",
    "0.25 teaspoon salt",
    "0.5 cup all-purpose flour",
    "2 teaspoons vanilla extract",
    "2 egg white",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (175 degrees C). Grease an 8-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butter or margarine over low heat. Pour into large mixing bowl and stir in carob powder, sugar, salt, flour, and vanilla. Mix in egg whites and walnuts. Spread the dough evenly into the baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes. Let cool in pan for 10-15 minutes before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
