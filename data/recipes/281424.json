  "ingredients": [
    "1 tablespoon butter",
    "1 tablespoon olive oil",
    "0.5 small onion, minced",
    "20 fresh pumpkin blossoms, halved lengthwise",
    "2 tablespoons heavy cream",
    "1 pinch salt to taste",
    "1 tablespoon olive oil",
    "0.5 small onion, sliced",
    "1 medium zucchini, quartered and thinly sliced",
    "2 medium fresh tomatoes, chopped",
    "8 leaves fresh basil, thinly sliced"
  ],
  "steps": [
    {
      "text": "Melt butter with olive oil in a skillet over medium heat. Add minced onion; cook, stirring frequently, until soft, about 5 minutes. Add pumpkin blossoms and cook until wilted, 3 to 5 minutes. Remove skillet from heat. Transfer contents to a blender, add cream, and blend until smooth. Season with salt and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 tablespoon olive oil in a clean pan over medium heat. Cook sliced onion and zucchini until soft but not browned or sloppy, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide zucchini between 2 dinner plates or pasta bowls and top with pumpkin sauce, fresh tomatoes, and basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
