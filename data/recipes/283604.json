  "title": "Mango Cake with Olive Oil and Greek Yogurt",
  "description": "The combination of olive oil, butter, and Greek yogurt adds incredible moisture and flavor to this tasty mango cake.",
  "authors": [
    "Diana Moutsopoulos"
  ],
