  "ingredients": [
    "2 tablespoons olive oil",
    "1 (2 pound) boneless beef chuck roast, cut into 2-inch cubes",
    "1 teaspoon ground black pepper",
    "3 teaspoons kosher salt, divided",
    "1 yellow onion, chopped",
    "6 cloves garlic, chopped",
    "2 tablespoons harissa",
    "2 tablespoons tomato paste",
    "1 cup dry red wine",
    "1 (28 ounce) can crushed tomatoes",
    "1 bay leaf",
    "1 pound pappardelle pasta, cooked and drained",
    "grated Parmesan cheese, for serving"
  ],
  "steps": [
    {
      "text": "Heat oil in a large Dutch oven over medium-high. Season chuck roast with pepper and 2 teaspoons salt. Sear meat until browned on every side, working in batches if necessary, about 10 minutes. Remove from Dutch oven and transfer to a large plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rN-r8JGv7ZJs4McvDUqABk6rD3o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8465557-beef-ragu-mfs-step-1-10-563d749e95d7484ca232443d42a8b7c7.jpg"
      ],
      "image": "assets/images/8465557/step_01.webp"
    },
    {
      "text": "Reduce heat to medium and stir in onion. Cook, stirring often, until softened, about 8 minutes. Add garlic and cook, stirring constantly, until fragrant, about 1 minute. Stir in harissa and tomato paste; cook, stirring constantly, until caramelized, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_MP5pkqHIapXPif0qu224eCmsN4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/beef-ragu-mfs-step-2-.tif8465557--22498430d7764daeae40763b8100e4ef.jpg"
      ],
      "image": "assets/images/8465557/step_02.webp"
    },
    {
      "text": "Pour in wine and cook, scraping the bottom of the pot with a wooden spoon to loosen any browned bits, until reduced by two thirds, about 5 minutes. Stir in tomatoes, bay leaf, chuck roast, and remaining 1 teaspoon salt. Reduce heat to medium-low and cover. Cook, stirring occasionally, until meat is tender, sauce has thickened, and flavors meld, about 2 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IOr8Bb-uVn8qvzUsJthO6rP_Qlw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8465557-beef-ragu-mfs-step-3-07-200d73a0233f4d8d8cc041b0d9868db5.jpg"
      ],
      "image": "assets/images/8465557/step_03.webp"
    },
    {
      "text": "Remove and discard bay leaf. Transfer meat from Dutch oven to a cutting board and shred using 2 forks. Return meat to pot and stir in pappardelle. Top with grated Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ogEwbcLWUFYFbhJgf0g9z5jzBGo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8465557-beef-ragu-mfs-step-5-12-94eb2466e631480eb56fa7ebb143f655.jpg"
      ],
      "image": "assets/images/8465557/step_04.webp"
    }
