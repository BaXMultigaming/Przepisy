  "ingredients": [
    "3.5 cups all-purpose flour",
    "0.5 cup quick cooking oats",
    "1 teaspoon salt",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "1 (8 ounce) container low-fat sour cream",
    "0.75 cup skim milk",
    "2 tablespoons honey",
    "1 tablespoon white sugar",
    "0.25 cup butter, melted",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together flour, 1/2 cup oats, salt, baking powder, and baking soda.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, mix together sour cream, milk, honey, and sugar. Add to the flour mixture, and mix just until well blended. Stir in melted butter or margarine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough onto a lightly sprayed baking sheet. Shape into a round, lightly mounded circle, about 8 inches diameter. Brush the top of the loaf with melted butter or margarine, and sprinkle with remaining 1 tablespoon oats. With a knife, score the top of the loaf into quarters.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for about 40 minutes, or until browned. Cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
