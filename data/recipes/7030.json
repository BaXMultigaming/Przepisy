  "title": "Oatmeal Soda Bread",
  "description": "This is a very easy recipe that has the added bonus of being lowfat! It bakes into a round loaf.",
  "authors": [
    "Karin Christian"
  ],
  "date_published": "1998-11-13T21:32:53-05:00",
