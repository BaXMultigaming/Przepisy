  "ingredients": [
    "nonstick cooking spray",
    "2 cups white sugar",
    "2 cups shredded zucchini",
    "1 cup vegetable oil",
    "3 beaten eggs",
    "2 teaspoons vanilla extract",
    "0.5 cup golden raisins",
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 teaspoon cinnamon",
    "0.5 teaspoon baking powder",
    "1/4 cup brown sugar",
    "1/4 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat two 9x5-inch loaf pans with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, zucchini, oil, eggs, and vanilla in a large bowl; stir in raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, salt, 1 teaspoon cinnamon, and baking powder in a separate large bowl; whisk into zucchini mixture until almost no lumps remain. Divide batter between the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk brown sugar and ¼ teaspoon cinnamon together in a small bowl until well combined; sprinkle over batter in the loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Cool in the pans for 10 minutes, then remove from the pans and finish cooling on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
