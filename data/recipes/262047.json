  "ingredients": [
    "1 gallon water",
    "3 cups white sugar",
    "16 whole cloves",
    "16 whole allspice berries",
    "4 tea bags",
    "1 (46 fluid ounce) can pineapple juice",
    "6 lemons, juiced",
    "4 oranges, juiced"
  ],
  "steps": [
    {
      "text": "Combine water, sugar, cloves, and allspice berries in a large pot and bring to a boil. Reduce heat to a simmer. Add tea bags; steep for 5 minutes and leave in the pot. Add pineapple juice, lemon juice, and orange juice. Simmer until heated through, about 15 minutes more. Remove tea bags and spices, if desired.",
