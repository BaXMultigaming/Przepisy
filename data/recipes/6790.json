  "ingredients": [
    "2 tablespoons shortening",
    "1.5 cups white sugar",
    "2 eggs, beaten",
    "2 cups milk",
    "1 teaspoon baking soda",
    "4 cups all-purpose flour",
    "2 teaspoons cream of tartar",
    "1 pinch salt",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Cream shortening with sugar. Mix in eggs. Dissolve soda in milk, and add to the creamed mixture. Stir in flour, cream of tartar, and salt. Stir in nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into a 3 pound coffee can, or several 1 pound soup cans; fill containers 1/2 to 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour, or until a tester inserted in the center of loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
