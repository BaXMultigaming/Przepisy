  "ingredients": [
    "3 pounds sweet potatoes, peeled and cut in 1-inch chunks",
    "water to cover",
    "3 tablespoons unsalted butter",
    "2 tablespoons milk",
    "1 teaspoon dried sage",
    "1 teaspoon salt",
    "0.25 teaspoon pepper"
  ],
  "steps": [
    {
      "text": "Place sweet potatoes in a slow cooker and add water to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High until potatoes are tender, 1 hour and 30 minutes to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a colander until well drained, then return to the slow cooker. Add butter, milk, sage, salt, and pepper. Mash with a potato masher until potatoes are smooth.",
