  "ingredients": [
    "0.25 cup orange juice",
    "2 tablespoons balsamic vinegar",
    "1 tablespoon Dijon-style prepared mustard",
    "2 teaspoons honey",
    "0.125 teaspoon cracked black pepper"
  ],
