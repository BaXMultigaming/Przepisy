  "ingredients": [
    "2 large egg whites",
    "0.5 cup superfine sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a large bowl with an electric mixer until stiff, but not dry. Gradually beat in sugar until a little of the mixture between your thumb and forefinger feels smooth, not gritty. Stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pipe or spoon small portions onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until dry but not brown, about 35 minutes. Turn the oven off and leave meringues inside to cool for at least 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
