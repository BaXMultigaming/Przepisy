  "ingredients": [
    "2 quarts hot water",
    "0.5 cup white sugar",
    "1.5 teaspoons ground cinnamon",
    "1 cup long grain rice",
    "1 cup milk",
    "ice cubes, for serving"
  ],
  "steps": [
    {
      "text": "Pour sugar, cinnamon, and rice into hot water; stir until sugar dissolves. Cover, and let stand at room temperature for at least 3 hours, but preferably overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in milk, then puree with a hand blender, or in batches in a standing blender until the rice resembles fine sand. Strain through several layers of cheesecloth, or through a very fine strainer. Serve over ice.",
      "section": null,
