  "ingredients": [
    "1 pound ground beef",
    "1 (14 ounce) can pizza sauce",
    "4 hamburger buns, split, divided",
    "4 slices mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Heat a large, deep skillet over medium-high heat. Cook and stir ground beef in the hot skillet until evenly browned and crumbly, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in pizza sauce and cook until heated through, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bun bottoms onto a microwave-safe plate. Spoon beef mixture onto each bun and place a mozzarella cheese slice over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on high until cheese is melted, 15 to 20 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bun tops over melted cheese and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
