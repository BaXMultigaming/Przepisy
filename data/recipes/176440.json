  "ingredients": [
    "2.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "1 cup butter, softened",
    "1.5 cups white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 (2.25 ounce) package cinnamon red hot candies"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour, baking soda, and baking powder in a small bowl. Using an electric mixer, beat butter and sugar in a large bowl until smooth. Beat in egg and vanilla. Stir in the dry ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough out on lightly floured surface. Cut into heart shapes and place on ungreased baking sheets. Dot cookies with red hot candies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until golden, 8 to 10 minutes. Let stand on cookie sheet for 2 minutes before removing to cooling racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
