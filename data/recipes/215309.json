  "ingredients": [
    "1 (4 pound) boneless turkey breast, trimmed",
    "2 cups chopped onion",
    "0.5 cup pitted kalamata olives",
    "0.5 cup oil-packed sun dried tomatoes, thinly sliced",
    "0.5 cup chicken broth, divided",
    "2 tablespoons fresh lemon juice",
    "1 teaspoon Greek seasoning (such as McCormick's®)",
    "0.5 teaspoon salt",
    "0.25 teaspoon fresh ground black pepper",
    "3 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Place turkey breast, onion, kalamata olives, sun-dried tomatoes, 1/4 cup chicken broth, lemon juice, Greek seasoning, salt, and pepper in the crock of a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low for 7 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1/4 cup chicken broth and flour in a small bowl; whisk until smooth. Stir into the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low for 30 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
