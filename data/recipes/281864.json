  "ingredients": [
    "0.25 cup unsalted butter",
    "0.5 cup pineapple juice",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "2 (29 ounce) cans cut yams, drained",
    "1 (8 ounce) can pineapple chunks, drained",
    "1.5 cups miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium-low heat. Add pineapple juice, white sugar, brown sugar, cinnamon, and nutmeg; stir to combine and cook until sugars have dissolved, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place drained yams in a casserole dish. Add pineapple chunks. Pour sauce over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Add marshmallows to the top and continue to bake until golden and melted, 10 to 15 minutes more. Let stand for 15 minutes before serving so sauce can thicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
