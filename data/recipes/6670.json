  "ingredients": [
    "2 tablespoons active dry yeast",
    "1 teaspoon white sugar",
    "0.5 cup warm water",
    "3.5 cups warm water",
    "0.25 cup honey",
    "0.25 cup molasses",
    "0.5 cup vegetable oil",
    "2 eggs",
    "2 tablespoons lemon juice",
    "7 cups whole wheat flour",
    "0.25 cup flax seed",
    "0.25 cup cracked wheat",
    "0.25 cup sunflower seeds",
    "4 teaspoons salt",
    "4 cups bread flour"
  ],
  "steps": [
    {
      "text": "In a small bowl, dissolve yeast and sugar in 1/2 cup warm water. In a large bowl, mix remaining 3 1/2 cups warm water, honey, molasses, oil, eggs, and lemon juice. Mix well. Add yeast mixture and stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually add 5 cups whole wheat flour beating well after each addition. Add flax, cracked wheat, and sunflower seeds, stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let stand for 20 minutes, until mixture is very light. Stir in salt and the rest of the flours until dough pulls away from the sides of the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead 10 to 15 minutes until dough is smooth and elastic. Put into a greased bowl and cover, let rise in the oven with light on until doubled, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Punch down and shape into 6 round balls. Cover and let rest for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form into loaves and let rise covered in oven until doubled. Bake at 375 degrees F (190 degrees C) 25-35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
