  "ingredients": [
    "0.25 cup red wine vinegar",
    "2 tablespoons Dijon mustard, or to taste",
    "1 clove garlic, minced",
    "1 teaspoon dried oregano",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup olive oil",
    "2 tablespoons fresh lemon juice"
  ],
