  "ingredients": [
    "2 (8 ounce) skinless, boneless chicken breasts",
    "0.25 cup minced fresh cilantro",
    "2 tablespoons lime juice",
    "1 tablespoon low-sodium soy sauce",
    "1 tablespoon olive oil",
    "2 cloves garlic, minced",
    "0.25 cup sweet chili sauce",
    "1 teaspoon minced fresh cilantro"
  ],
  "steps": [
    {
      "text": "Place chicken in a resealable plastic bag. Combine 1/4 cup cilantro, lime juice, soy sauce, olive oil, and garlic in a small bowl. Pour over chicken and seal the bag. Let marinate in the refrigerator, 3 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat Panasonic® Countertop Induction Oven to Medium on the \"Grill\" setting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken on the grill pan. Grill chicken for 6 to 7 minutes per side or until an instant-read thermometer inserted into the center reads at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush chicken with sweet chili sauce. Garnish with 1 teaspoon cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
