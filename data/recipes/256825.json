  "ingredients": [
    "6 cups frozen mixed berries",
    "0.5 cup white sugar",
    "0.25 cup orange juice",
    "1.5 teaspoons finely grated orange zest",
    "2 tablespoons cornstarch",
    "2 tablespoons water"
  ],
  "steps": [
    {
      "text": "Stir frozen berries, sugar, orange juice, and orange zest together in a slow cooker. Cover and cook on High until bubbling, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cornstarch and water together in a cup until fully dissolved. Stir into berry mixture. Cover again and cook until thickened, 5 to 10 minutes. Serve warm or at room temperature.",
