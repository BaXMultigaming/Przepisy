  "ingredients": [
    "2 zucchinis",
    "1 tablespoon olive oil",
    "1 small onion, diced",
    "4 ounces fresh mushrooms, sliced",
    "2 cloves garlic, minced",
    "salt and ground black pepper to taste",
    "0.25 cup crumbled feta cheese",
    "0.25 cup grated Parmesan cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Trim ends from zucchini and half each length-wise. Scoop out flesh of zucchini; dice. Arrange zucchini shells into a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a 10-inch skillet over medium heat. Cook and stir onion, mushrooms, and garlic in hot oil until the onion is tender, 5 to 7 minutes; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir diced zucchini flesh into the onion mixture; cook and stir until hot, about 5 minutes. Spoon zucchini mixture into the shells in the baking dish; top each with 1 tablespoon each feta cheese and Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the zucchini shells are soft, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
