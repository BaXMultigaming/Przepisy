  "ingredients": [
    "1.5 cups water",
    "1.5 cups white sugar",
    "4 whole cloves",
    "1 (3 inch) cinnamon stick",
    "0.5 cup raisins",
    "1 (750 milliliter) bottle red wine",
    "2 lemons, juiced",
    "1 orange, juiced",
    "0.25 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "In a large pot, combine the water, sugar, cloves, cinnamon, and raisins. Bring to a boil, then remove from the heat and stir in the wine, lemon juice, and orange juice. Heat through, but do not boil. Remove the cinnamon stick. Ladle into cups, and serve with sliced almonds and the boiled raisins.",
