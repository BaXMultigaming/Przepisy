  "ingredients": [
    "0.25 cup butter",
    "0.5 cup chopped mushrooms",
    "2 cups chopped celery",
    "2 onions, chopped",
    "0.25 teaspoon garlic powder",
    "2.5 cups chicken broth",
    "1 (15 ounce) can baby corn",
