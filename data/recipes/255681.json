  "ingredients": [
    "1 pound ground beef",
    "0.5 cup chopped green onions",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon cayenne pepper",
    "2 tablespoons steak seasoning",
    "4 hamburger buns",
    "2 tablespoons melted butter",
    "0.75 cup barbecue sauce",
    "1 tablespoon honey",
    "8 thick slices bacon, cooked crisp",
    "8 frozen onion rings, prepared according to package directions",
    "4 slices Borden® American Cheese Singles",
    "4 slices tomato",
    "Fresh lettuce"
  ],
  "steps": [
    {
      "text": "Combine ground beef, green onions, garlic powder, and cayenne pepper; form into 4 patties. Sprinkle both sides with steak seasoning. Cover and chill. The patties can be made several hours ahead, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush buns with melted butter, set aside. Mix barbecue sauce with honey in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill to a medium-high heat. Grill burgers to an internal temperature of 160 degrees F (71 degrees C), about 4 to 6 minutes per side. Two minutes before burgers are finished, grill buns, butter side down, until golden brown. Place American cheese singles on burgers to melt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve each burger on a buttered bun topped with 2 slices crisp bacon, onion rings, honey barbecue sauce, lettuce, and tomato.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
