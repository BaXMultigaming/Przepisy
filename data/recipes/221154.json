  "ingredients": [
    "1 teaspoon vegetable oil",
    "10 ounces egg substitute (such as Egg Beaters®)",
    "12 hard boiled eggs, yolks discarded and egg whites chopped",
    "7 ounces mashed potatoes",
    "0.33333334326744 cup mayonnaise",
    "6 green onions, diced",
    "1 stalk celery, chopped",
    "1 tablespoon spicy brown mustard, or more to taste",
    "0.33333334326744 teaspoon chili powder",
    "0.33333334326744 teaspoon garlic powder",
    "1 dash balsamic vinegar",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a skillet over medium heat. Cook and stir egg substitute in hot oil until set, about 5 minutes.",
      "section": null,
      "name": null,
