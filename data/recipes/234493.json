  "ingredients": [
    "1 tablespoon olive oil",
    "6 potatoes, peeled and thinly sliced",
    "1 large onion, thinly sliced",
    "0.25 pound grated mozzarella cheese",
    "1 ounce sliced pepperoni",
    "1 (8 ounce) can pizza sauce"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook and stir potatoes and onion in oil until the onion is translucent, 7 to 10 minutes; drain. Put potato mixture in a slow cooker and add mozzarella cheese and pepperoni. Pour pizza sauce over the mixture.",
