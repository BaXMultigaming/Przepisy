  "ingredients": [
    "aluminum foil",
    "2 large white onions, sliced into 1/4-inch rings",
    "8 ounces baby bella mushrooms, sliced",
    "2 cloves garlic, thinly sliced",
    "4 tablespoons butter, cut into 4 pieces",
    "5 tablespoons steak seasoning (such as Dale's®)"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold an 18-inch wide piece of aluminum foil so it is square.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place onions, mushrooms, and garlic in the middle of the foil. Arrange butter pieces on top of vegetables and drizzle with steak seasoning. Bring 4 corners of the foil together in the center, and crimp any open spaces to seal packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the foil packet on the preheated grill and cook until vegetables are tender, about 45 minutes. Remove from grill, open packet carefully, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
