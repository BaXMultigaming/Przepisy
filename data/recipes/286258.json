  "ingredients": [
    "1 (16 ounce) package Italian herb polenta tube, cut into 1/2 inch slices (12 slices)",
    "2 teaspoons extra-virgin olive oil",
    "1 (2.25 ounce) can sliced ripe olives, drained",
    "0.25 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place polenta rounds on a cutting board and brush both sides with extra-virgin olive oil. Transfer 1/2 of the rounds to the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry for 15 minutes. Using tongs, flip rounds over, and cook for 5 minutes more. Sprinkle 1/2 of the sliced olives over the polenta and top with 1/2 of the mozzarella cheese. Cook until cheese has melted, about 2 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Repeat with remaining half of polenta rounds, olives, and mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
