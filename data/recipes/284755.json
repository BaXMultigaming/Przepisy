  "ingredients": [
    "3 tablespoons olive oil",
    "0.25 cup all-purpose flour",
    "0.5 cup hot water",
    "0.5 teaspoon ham base",
    "1 drop liquid smoke, or more to taste",
    "1.5 cups whole milk",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a medium saucepan over medium heat. Sprinkle with flour and whisk to combine. Cook for 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine water, ham base, and liquid smoke. Slowly add liquid to pan, whisking constantly until smooth. Whisk in milk, a little bit at a time. Continue to cook, stirring often until gravy thickens, about 5 minutes. Season to taste with pepper.",
      "section": null,
      "name": null,
      "url": null,
