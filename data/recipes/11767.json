  "ingredients": [
    "1 (8 ounce) package wide egg noodles",
    "1 pound lean ground beef",
    "1 tablespoon butter",
    "1 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.25 teaspoon garlic salt",
    "1 cup tomato sauce",
    "1 cup cottage cheese, creamed",
    "1 cup sour cream",
    "1 cup chopped green onions",
    "1 cup shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Cook noodles in boiling salted water. Rinse in cold water and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brown meat in butter; add salt, pepper, garlic salt and tomato sauce. Simmer for 5 minutes. Mix cottage cheese, sour cream, onions, meat sauce and noodles. Place in a casserole dish and sprinkle with cheddar cheese",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, at 350 degrees F (175 degrees C) for 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
