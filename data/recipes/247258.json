  "ingredients": [
    "3 pounds chicken wings",
    "1 tablespoon seasoned salt",
    "0.25 cup LAND O LAKES® Salted Butter",
    "1 cup heavy cream",
    "1 tablespoon minced garlic",
    "1.25 cups grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a large rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place wings on the prepared baking sheet. Sprinkle with seasoned salt; mix to evenly season wings. Arrange in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crisp and cooked through, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn on the oven broiler; cook wings under the broiler to crisp both sides, about 1 minute per side. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter over medium-low heat in a small saucepan. Add cream and garlic, stirring until small bubbles form. Add cheese and continue to stir until well blended. Remove the pan from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss wings with cream sauce and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
