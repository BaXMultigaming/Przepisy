  "ingredients": [
    "1 pound boneless pork shoulder, cubed",
    "1 pound boneless pork loin, cubed",
    "0.5 pound pork neck bones",
    "water to cover",
    "1 head garlic, cloves peeled",
    "salt to taste",
    "1 large plum tomato",
    "4 ounces dried guajillo chiles, stemmed and seeded",
    "1 clove garlic",
    "0.25 teaspoon dried oregano",
    "1 pinch ground cumin",
    "2 cups water",
    "2 (16 ounce) cans white hominy, drained",
    "shredded lettuce or cabbage",
    "1 small onion, diced",
    "4 limes, quartered"
  ],
  "steps": [
    {
      "text": "Place pork shoulder, pork loin, and pork neck bones in a large pot; cover with water. Add 1 head of garlic and salt; bring to a boil, reduce heat, and simmer until meat is tender and cooked through, about 1 hour. Stir in hominy; bring to a boil and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lMiskEHxWO4I8OwdQLtW4Qgemp0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257061-pozole-rojo-mexican-pork-and-hominy-stew-PICS-5795-step-01-1918edb8c2de4f699b4e828912d01569.jpg"
      ],
      "image": "assets/images/257061/step_01.webp"
    },
    {
      "text": "Meanwhile, place tomato and guajillo chiles in a pot; add enough water to cover and bring to a boil. Cook until chiles have softened, about 15 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/No_KbJasDe3C0WclmokKFigNLDI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257061-pozole-rojo-mexican-pork-and-hominy-stew-PICS-5802-step-02-3bd6723802084106ab9b82354d4aae2a.jpg"
      ],
      "image": "assets/images/257061/step_02.webp"
    },
    {
      "text": "Place tomato and chiles, 1 clove garlic, oregano, cumin, and salt in a blender; add 2 cups water and blend until smooth. Strain mixture through a fine-mesh sieve; set chile sauce aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qZWT_i-2yK61gmW711TOmQklwkc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257061-pozole-rojo-mexican-pork-and-hominy-stew-PICS-5807-step-03-1549ed4289214485a07a13b979ae5c6a.jpg"
      ],
      "image": "assets/images/257061/step_03.webp"
    },
    {
      "text": "Transfer pork to a work surface; shred with 2 forks. Discard pork bones and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QwOY0EaGygrKzFgt7SPo39B4D1c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257061-pozole-rojo-mexican-pork-and-hominy-stew-PICS-5811-step-04-7fec72e61f25460ab832df5be7de0ad9.jpg"
      ],
      "image": "assets/images/257061/step_04.webp"
    },
    {
      "text": "Stir chile sauce and shredded pork into the pot. Simmer pozole until flavors have blended, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AixJ5qEvIRqcr7cDUA63JoVYRcY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257061-pozole-rojo-mexican-pork-and-hominy-stew-PICS-5824-step-05-05510f9e3171493c9f08bb09f28ec582.jpg"
      ],
      "image": "assets/images/257061/step_05.webp"
    },
    {
      "text": "Divide pozole among serving bowls. Top with shredded cabbage and onion; serve lime wedges on the side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a6w8vZUbhnkbBdXuKlx-WBUobYM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/257061-pozole-rojo-mexican-pork-and-hominy-stew-PICS-5832-step-06-19b4b2819c074178b13646293fdb85a2.jpg"
      ],
      "image": "assets/images/257061/step_06.webp"
    }
