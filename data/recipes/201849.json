    "publisher-tested"
  ],
  "ingredients": [
    "2 teaspoons vegetable oil",
    "1 tablespoon finely chopped garlic",
    "0.5 teaspoon grated fresh ginger root",
    "0.66666668653488 cup dark brown sugar",
    "0.5 cup soy sauce",
    "0.5 cup water",
    "1 pound beef flank steak, sliced 1/4 inch thick on the diagonal",
    "0.25 cup cornstarch",
    "1 cup vegetable oil for frying",
    "2 bunches green onions, cut in 2-inch lengths"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aEJ0-PB7Wgicd0Tl6zwUJkM3Gs4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-201849-mongolian-beef-and-spring-onions-ddmfs-4x3-ingredients-b37f75fc8b5143c7be6eee05e616d8a3.jpg"
      ],
      "image": "assets/images/201849/step_01.webp"
    },
    {
      "text": "Heat 2 teaspoons of vegetable oil in a saucepan over medium heat. Add garlic and ginger; cook and stir until fragrant, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g_tcAXuvcSLqZTBjDafGS1GolS8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-201849-mongolian-beef-and-spring-onions-ddmfs-4x3-steps-01-dd562dd2689e4d14a3977c04403d7e82.jpg"
      ],
      "image": "assets/images/201849/step_02.webp"
    },
    {
      "text": "Stir in brown sugar, soy sauce, and water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KgmZcgihWf7t8MulNWffYHYVk78=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-201849-mongolian-beef-and-spring-onions-ddmfs-4x3-steps-02-1465788fd9a74930b3e7f7c82c0fe103.jpg"
      ],
      "image": "assets/images/201849/step_03.webp"
    },
    {
      "text": "Increase heat to medium-high; stir until sauce boils and slightly thickens, about 4 minutes. Remove sauce from the heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F8CXOj2feH05NtEYMX-S7obY3kI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-201849-mongolian-beef-and-spring-onions-ddmfs-4x3-steps-03-086583a3e78a4f9db376cd4eb049abb9.jpg"
      ],
      "image": "assets/images/201849/step_04.webp"
    },
    {
      "text": "Place beef into a large bowl; add cornstarch and mix until beef is thoroughly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wyKeW5p1bq1l4LAa1gATHiKifiQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-201849-mongolian-beef-and-spring-onions-ddmfs-4x3-steps-04-0f86432d8b9540b19f2a1ced5496d9d6.jpg"
      ],
      "image": "assets/images/201849/step_05.webp"
    },
    {
      "text": "Set aside until most of the cornstarch has been absorbed, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MKGB-l6vQSQfRVnulmZGZRC2wW8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-201849-mongolian-beef-and-spring-onions-ddmfs-4x3-steps-05-1abfd6d637f847afab4f7c0dd93c4134.jpg"
      ],
      "image": "assets/images/201849/step_06.webp"
    },
    {
      "text": "Heat vegetable oil in a deep skillet to 375 degrees F (190 degrees C). Shake excess cornstarch from beef slices and drop into hot oil, a few at a time, stirring briefly and frying until edges become crisp, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9xpOlVWICn5kvnTMjTHRVhHM53o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-201849-mongolian-beef-and-spring-onions-ddmfs-4x3-steps-06-73a62e2591bb4b1c8889fa4b1938a321.jpg"
      ],
      "image": "assets/images/201849/step_07.webp"
    },
    {
      "text": "Remove beef with a large slotted spoon; drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IJpPmKs4UY1LGhZc8AoZ8UVtJ48=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-201849-mongolian-beef-and-spring-onions-ddmfs-4x3-steps-07-f4c5384053e8462cb6149c77d453bb16.jpg"
      ],
      "image": "assets/images/201849/step_08.webp"
    },
    {
      "text": "Remove excess oil from the skillet, then heat the skillet over medium heat; add beef slices and stir in prepared sauce. Add green onions and bring to a boil; cook until the onions have just softened and are bright green, about 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tF33kkIh37JIFaPSp-LgReah6RY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-201849-mongolian-beef-and-spring-onions-ddmfs-4x3-steps-09-8b1c86284ae04912a5fe6eaffa617cdc.jpg"
      ],
      "image": "assets/images/201849/step_09.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fZYfIok0th4pJv_z9ofeZm0MLbM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-201849-mongolian-beef-and-spring-onions-ddmfs-4x3-hero-f8101ac0154f4bffa773894241803042.jpg"
      ],
      "image": "assets/images/201849/step_10.webp"
    }
  ],
