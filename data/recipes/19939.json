  "ingredients": [
    "1 (8 ounce) package egg noodles",
    "2 cups sour cream",
    "0.5 cup grated Parmesan cheese, divided",
    "1 tablespoon chopped fresh chives",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add noodles and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While noodles are cooking, combine the sour cream, 1/4 cup cheese, chives, salt and pepper in a medium bowl. Mix together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter into drained noodles, then stir in sour cream mixture. Place on a warm platter and sprinkle with remaining 1/4 cup cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
