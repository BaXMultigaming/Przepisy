    "publisher-tested"
  ],
  "ingredients": [
    "0.5 cup vegetable oil",
    "2 cloves garlic, crushed",
    "0.25 cup coarsely ground fresh black pepper",
    "2 tablespoons smoked paprika",
    "2 teaspoons ground coriander",
    "1 teaspoon dry mustard",
    "0.5 teaspoon ground white pepper",
    "0.25 teaspoon cayenne pepper",
    "4 pounds corned beef brisket"
  ],
  "steps": [
    {
      "text": "Mix vegetable oil and garlic in a small bowl; set aside for 1 hour. Combine black pepper, paprika, coriander, dry mustard, white pepper, and cayenne pepper in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mRvxRmBRbopfsdF-KwvBBEg87Z8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221900-Easy-Homemade-Pastrami-ddmfs-001-step1-70a69c1f7d2541a292c0bfdf7ea85a5f.jpg"
      ],
      "image": "assets/images/221900/step_01.webp"
    },
    {
      "text": "Preheat the oven to 225 degrees F (110 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover a baking sheet with a large sheet of heavy-duty aluminum foil; coat with prepared garlic oil. Lay beef brisket on the oiled foil sheet and brush with remaining garlic oil. Cover brisket completely with pepper mixture, reserving 1 to 2 tablespoons.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0pUs1R2JQfEw2Jm-fUyPXxYO_as=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221900-Easy-Homemade-Pastrami-ddmfs-002-step2-cbe1bea78f21408fbbe384eb353201ac.jpg"
      ],
      "image": "assets/images/221900/step_03.webp"
    },
    {
      "text": "Wrap brisket, fat-side up, in the sheet of foil. Place wrapped corned beef on another sheet of aluminum foil with the seam- and fat-sides down. Place double-wrapped brisket, seam-side down, on a third sheet of aluminum foil; wrap again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zuVeuiYy1qxhdGWDR3kUOXLg2kM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221900-Easy-Homemade-Pastrami-ddmfs-003-step3-39519a0b4cfd4cb6bf557b10a6a8bcb3.jpg"
      ],
      "image": "assets/images/221900/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pastrami from the oven and let cool to room temperature, about 3 hours. Do not remove the foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place foil-wrapped pastrami in a freezer bag or other plastic bag; refrigerate for 8 to 10 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven's broiler and set the oven rack about 6 inches from the heat source. Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pastrami from the refrigerator, unwrap, and place on the prepared baking sheet. Sprinkle top with 1 to 2 tablespoons remaining pepper mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Nsjj45UiI_Fd_w99CTdvFb1F1pU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221900-Easy-Homemade-Pastramiddmfs-059-step2-86e262f2f951468ab675e3a5eb102b81.jpg"
      ],
      "image": "assets/images/221900/step_09.webp"
    },
    {
      "text": "Place pastrami under the broiler and cook until surface browns, 3 to 4 minutes. Remove pastrami from the oven and cut into thin slices, about 1/8-inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/grSohS-Q-RXlcDmgdCCJbJH3ucY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221900-Easy-Homemade-Pastramiddmfs-061-step4-86d8ce6d6e4b4b1dbc86f4b0a535def6.jpg"
      ],
      "image": "assets/images/221900/step_10.webp"
    },
    {
      "text": "Heat a large skillet over low heat; warm pastrami slices in the skillet with a few drops of water until fat turns translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZXdDiEDq0PpOEyb2bBMhDKp4p_A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221900-Easy-Homemade-Pastramiddmfs-070-4x3-1-437f64cf26eb43c7985819506123fc94.jpg"
      ],
      "image": "assets/images/221900/step_11.webp"
    }
  ],
