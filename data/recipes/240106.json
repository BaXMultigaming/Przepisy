  "ingredients": [
    "2 ripe bananas, mashed",
    "0.75 cup packed dark brown sugar",
    "0.5 cup milk",
    "0.5 cup butter, softened",
    "1 egg, beaten",
    "1 teaspoon vanilla extract",
    "1.5 cups gluten-free baking mix (such as Bob's Red Mill® 10 Grain Pancake Mix)",
    "0.5 cup chopped pecans",
    "1 teaspoon xanthan gum",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "0.25 cup dark brown sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bananas, 3/4 cup brown sugar, milk, butter, egg, and vanilla extract together with a stand mixer; add baking mix, pecans, xanthan gum, cinnamon, nutmeg, and salt and mix on Low until just combined into a batter. Pour batter into prepared muffin cups. Sprinkle additional brown sugar over the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 20 minutes. Cool in the pans for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
