  "ingredients": [
    "2.5 cups unpeeled shredded zucchini",
    "1 large egg, beaten",
    "2 tablespoons butter, melted",
    "1 cup panko bread crumbs",
    "0.25 cup chopped green onions",
    "0.5 teaspoon seasoned salt",
    "0.5 teaspoon red pepper flakes",
    "0.25 cup all-purpose flour",
    "0.5 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Combine zucchini, egg, and melted butter in a large bowl; stir in panko, green onions, seasoned salt, and red pepper flakes until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour in a shallow dish; set aside. Shape zucchini mixture into 5 palm-sized patties; dredge in flour to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add patties; fry until golden brown and crispy, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
