  "ingredients": [
    "1 tablespoon olive oil",
    "1 (15 ounce) can kidney beans",
    "1.5 cups tomato sauce",
    "4.5 cups water, divided",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried basil",
    "1 pinch dried thyme",
    "salt and pepper to taste",
    "5 teaspoons adobo seasoning, divided",
    "2 cups uncooked white rice"
  ],
  "steps": [
    {
      "text": "Combine olive oil, kidney beans, tomato sauce, 1/2 cup water, oregano, basil, thyme, salt, pepper, and 2 teaspoons adobo in a large saucepan. Simmer over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring 4 cups water to a boil. Stir in rice. Reduce heat, cover, and simmer until rice is cooked and all liquid is absorbed, about 20 minutes. Stir remaining 3 teaspoons adobo into rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve bean sauce over rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
