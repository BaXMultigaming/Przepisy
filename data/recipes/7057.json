  "ingredients": [
    "1.625 cups water",
    "4 cups bread flour",
    "2 tablespoons butter",
    "2 tablespoons dry milk powder",
    "0.33333334326744 cup molasses",
    "1 tablespoon active dry yeast",
    "2 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Place ingredients in the bread machine pan in the order suggested by the manufacturer. Select Dough or White Bread setting, and then Start.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "If the dough does not form a ball on the paddle, add 1 tablespoon of flour at a time until the ball forms. Allow machine to complete selected cycle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To bake conventionally, grease a 9x5-inch loaf pan. Remove dough from the bread machine pan after the Dough cycle has been completed. Shape into a loaf, and place in the prepared pan. Let rise until doubled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until top is golden brown, about 40 minutes. Carefully tip loaf out of pan onto a work surface and gently tap bottom of loaf. If it sounds hollow, bread is done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
