  "ingredients": [
    "5 tablespoons butter",
    "0.25 cup all-purpose flour",
    "1 quart milk",
    "1 teaspoon salt, or more to taste",
    "0.25 teaspoon freshly grated nutmeg"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F3dBL50Ejdsdr_P5KSjJBO7oxds=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/139987-BasicBechamelSauce-mfs-Step1-0830-0dd4aceefae143d7af16374f22e01636.jpg"
      ],
      "image": "assets/images/139987/step_01.webp"
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Add flour and whisk into the melted butter until smooth. Cook and stir until flour turns a light, golden, sandy color, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5Lq-wodlV2Vi7hvKeBMeuwJF65k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/139987-BasicBechamelSauce-mfs-Step3-0841-11f1834cc2cc4dd485dc2a58ed619c0a.jpg"
      ],
      "image": "assets/images/139987/step_02.webp"
    },
    {
      "text": "Increase heat to medium-high and slowly whisk in milk until thickened by the roux. Bring to a gentle simmer, then reduce heat to medium-low and continue simmering until the flour has softened and no longer tastes gritty, 10 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xo-ICFmozzaqOo5TXzdrUB3yXr8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/139987-BasicBechamelSauce-mfs-Step4-0842-1735c384c2e74716867570e6740d4e47.jpg"
      ],
      "image": "assets/images/139987/step_03.webp"
    },
    {
      "text": "Season to taste with salt and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/seqJSf5fTjHEVmq70slE2_f4TN8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/139987-BasicBechamelSauce-mfs-Step6-0861-bf29376a8b3046099a4203133d792dd7.jpg"
      ],
      "image": "assets/images/139987/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
