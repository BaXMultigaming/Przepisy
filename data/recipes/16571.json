  "ingredients": [
    "1.0625 cups white sugar",
    "1 tablespoon white sugar",
    "0.75 cup brown sugar",
    "0.5 cup butter or margarine, softened",
    "2 eggs",
    "0.5 cup peanut butter",
    "0.5 banana",
    "1 teaspoon vanilla extract",
    "1.5625 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.5 cups semisweet chocolate chips",
    "1.25 cups rolled oats"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, brown sugar, and butter together in a large bowl with an electric mixer until light and fluffy. Beat in eggs, one at a time, beating well after each addition. Stir in peanut butter, banana, and vanilla until incorporated; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, and salt in a small bowl; gradually stir into peanut butter-banana mixture. Stir in chocolate chips and oats until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded spoonfuls onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 8 to 10 minutes. Cool cookies on the baking sheets for 5 minutes; transfer to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
