  "ingredients": [
    "0.5 cup orange juice",
    "0.5 cup milk",
    "1 medium lemon, chopped and seeded",
    "1 egg",
    "2 tablespoons vegetable oil",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "0.75 cup hemp hearts",
    "0.66666668653488 cup blueberries, or more to taste",
    "1.25 teaspoons baking soda",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x4-inch loaf pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend orange juice, milk, lemon, egg, oil, and vanilla extract in a blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, hemp hearts, blueberries, baking soda, and salt together in a medium bowl. Pour in the orange juice mixture; stir to combine. Do not overmix. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the loaf comes out clean, 55 to 60 minutes. Let cool for 5 minutes before removing from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
