    "0.5 cup peanut oil",
    "0.5 cup vinegar",
    "3 tablespoons ground allspice",
    "3 habanero peppers",
    "1 (1 inch) piece fresh ginger, peeled",
    "5 cloves garlic, peeled",
    "2 limes, juiced",
    "0.25 cup dark brown sugar",
    "2 tablespoons chopped fresh thyme",
    "2 tablespoons soy sauce",
    "2 tablespoons ketchup",
