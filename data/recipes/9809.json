  "title": "Rosettes",
  "description": "Rosettes are festive Swedish cookies made with a simple batter fried in a lacy pattern with a rosette iron until crispy, then dusted with powdered sugar.",
  "authors": [
    "Pat Kersteter"
  ],
  "date_published": "1997-07-28T23:38:35-04:00",
