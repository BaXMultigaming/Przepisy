  "ingredients": [
    "2 cups white sugar",
    "2 lemons, thinly sliced",
    "4 eggs, beaten",
    "1 recipe pastry for a 9 inch double crust pie",
    "1 tablespoon milk"
  ],
  "steps": [
    {
      "text": "Combine sugar and sliced lemons in a large bowl. Let stand for at least 4 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Press one pie pastry into a pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add beaten eggs to the sugar-lemon mixture and mix until well combined. Pour into the bottom crust, then cover with remaining pie pastry. Brush top crust with milk and sprinkle with sugar as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Reduce the heat to 375 degrees F (190 degrees C) and bake until a knife inserted into the center comes out clean, 20 to 25 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
