  "ingredients": [
    "1 tablespoon vegetable oil",
    "0.5 large onion, chopped",
    "2 ribs celery, chopped",
    "1 pinch salt and ground black pepper to taste",
    "3 (15.25 ounce) cans sweet whole-kernel corn, drained",
    "2 (15 ounce) cans creamed corn",
    "1 (4 ounce) packet saltine crackers, crushed",
    "2 eggs",
    "2 tablespoons milk",
    "4 tablespoons melted butter",
    "0.25 teaspoon ground black pepper",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat; stir in onion and celery. Saute until the onion has softened and turned translucent, about 5 minutes. Season with salt and pepper, if desired. Transfer to a large bowl with whole-kernel corn, creamed corn, and crushed crackers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together eggs and milk in a small bowl and add to the corn mixture. Add butter, pepper, and salt; mix until all ingredients are incorporated. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden brown, 45 to 60 minutes. Let cool for 5 to 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
