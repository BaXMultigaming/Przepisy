  "ingredients": [
    "3 tablespoons butter, melted",
    "0.5 (8 ounce) package wide egg noodles",
    "1 large apple - peeled, cored, and chopped",
    "1 large pear - peeled, cored, and chopped",
    "1 tablespoon lemon juice",
    "1 cup milk",
    "4 eggs",
    "0.5 cup applesauce",
    "0.25 cup white sugar",
    "2 tablespoons light brown sugar",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon salt",
    "1 pinch ground nutmeg, or to taste",
    "0.33333334326744 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease an 8x8-inch baking dish with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook egg noodles in the boiling water, stirring occasionally until cooked through but firm to the bite, about 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the apple and pear with lemon juice in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk, eggs, applesauce, white sugar, light brown sugar, vanilla extract, cinnamon, salt, and nutmeg in a large bowl until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cranberries, egg noodles, and apple mixture into the egg mixture; pour in prepared baking dish and cover baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake noodle pudding in preheated oven until set, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove foil and return pudding to oven to bake until browned, about 10 minutes more; cool to room temperature or serve chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
