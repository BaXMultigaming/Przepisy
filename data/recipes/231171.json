  "ingredients": [
    "6 cups rolled oats",
    "4 eggs, beaten",
    "2 cups frozen blueberries",
    "1 cup applesauce",
    "1 cup brown sugar",
    "2 cups skim milk",
    "0.25 cup flax seed meal",
    "3 tablespoons wheat germ",
    "1 tablespoon baking powder",
    "1 tablespoon ground cinnamon",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, eggs, blueberries, applesauce, brown sugar, skim milk, flax seed meal, wheat germ, baking powder, cinnamon, vanilla, and salt together in a large bowl; pour into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the moisture is absorbed and the oats are tender, 25 to 32 minutes.",
      "section": null,
