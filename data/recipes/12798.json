  "ingredients": [
    "1.5 pounds bay scallops",
    "2 tablespoons melted butter, or as needed",
    "2 tablespoons lemon juice",
    "1 tablespoon garlic salt"
  ],
  "steps": [
    {
      "text": "Preheat the broiler to high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse scallops and place in a shallow baking pan. Sprinkle with 2 tablespoons melted butter, lemon juice, and garlic salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated broiler until scallops begin to turn golden, 6 to 8 minutes. Remove from the oven and serve with extra melted butter on the side for dipping.",
