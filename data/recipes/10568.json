  "ingredients": [
    "0.5 cup butter, softened",
    "0.75 cup white sugar",
    "1 egg",
    "1 tablespoon lemon zest",
    "1.5 teaspoons fresh lemon juice",
    "0.75 teaspoon vanilla extract",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "1.25 cups all-purpose flour",
    "0.5 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar in a large bowl with electric mixer on high speed until fluffy. Beat in remaining ingredients except flour until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On low speed, beat in flour just until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by rounded teaspoonfuls 1 1/2 inches apart on ungreased cookie sheets. Sprinkle with sugar or almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 10 to 12 minutes until edges are lightly browned. Cool on cookie sheet 1 minute before removing to wire rack to cool completely. Store in an airtight container at room temperature for up to one week. HINT: These cookies will have a nicely browned edge if baked on a regular thin cookie sheet rather than a thick or insulated one.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
