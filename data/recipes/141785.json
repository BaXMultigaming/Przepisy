  "ingredients": [
    "4 pounds new potatoes",
    "1.5 cups fine salt",
    "8 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Wash potatoes and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large pot with water; stir in salt until fully dissolved and no salt sinks to the bottom of the pot. Place potatoes in the pot and bring to a boil; reduce heat and simmer until potatoes are tender but firm, about 15 minutes. Drain; cover to keep hot and let the salt crust develop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While potatoes are cooking, melt butter in a small pan over medium-high heat, or in the microwave. Drizzle over hot potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
