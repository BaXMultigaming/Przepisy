  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease 24 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all-purpose flour, oats, whole wheat flour, sugar, flax seed meal, baking powder, and salt together in a large bowl. Stir in milk, coconut oil, applesauce, and eggs. Fold in strawberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill the prepared muffin tins evenly with batter, about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
