  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking powder",
    "1 cup shortening",
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "2 eggs",
    "2 cups rolled oats",
    "1 teaspoon vanilla extract",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Blend shortening and sugars together. Add eggs, and beat until fluffy. Whisk together flour, soda, salt, and baking powder; mix into the egg mixture. Stir in oats, vanilla, and chocolate chips. Drop by teaspoonfuls on ungreased cookie sheets",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 15 minutes. Cool on wire racks.",
