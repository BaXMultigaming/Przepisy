  "ingredients": [
    "1 large potato, peeled and shredded",
    "1 cup shredded Swiss cheese",
    "1 cup chopped fresh mushrooms",
    "2 pounds lean ground beef",
    "2 (1 ounce) packages dry onion soup mix"
  ],
  "steps": [
    {
      "text": "Preheat grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together potato, cheese, and mushrooms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix ground beef with onion soup mix. Form into 6 large burger patties. Make a pocket in each burger, stuff with potato mixture, and seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to grill, brush grate with oil. Cook burgers over high heat for 5 minutes on each side, or until well done. Serve hot.",
