  "ingredients": [
    "1 teaspoon olive oil",
    "0.75 pound bulk chorizo sausage",
    "0.5 cup cooked rice",
    "0.25 cup diced onion",
    "0.25 cup taco sauce",
    "0.25 cup shredded Cheddar cheese",
    "1 teaspoon ground cumin",
    "2 poblano peppers, halved lengthwise and seeded",
    "2 tablespoons taco sauce, or to taste",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium-high heat. Add chorizo; cook and stir until completely browned and broken into small pieces, 7 to 10 minutes. Off heat; stir in rice, onion, 1/4 cup taco sauce, Cheddar, and cumin until evenly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill pepper halves with chorizo mixture; place in a small casserole dish or pie plate. Drizzle remaining 2 tablespoons taco sauce over peppers. Pour water into bottom of dish; cover loosely with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until peppers tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
