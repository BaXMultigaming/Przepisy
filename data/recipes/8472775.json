  "ingredients": [
    "2 large leeks",
    "2 tablespoons olive oil",
    "0.25 teaspoon salt",
    "0.13 teaspoon freshly ground black pepper",
    "0.25 cup freshly grated Parmesan cheese",
    "chopped parsley for garnish (optional)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Trim leeks by discarding the root end and the dark green tops. Quarter leeks and rinse well to remove any sand. Pat dry with a paper towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle olive oil, salt, and pepper over the leeks. Use your hands to make sure they are evenly coated. Place leeks cut side down in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook for 20 minutes. Carefully flip leeks over to cut side up. Sprinkle with grated Parmesan cheese and cook until soft and cheese has melted, about 10 minutes more. Garnish with chopped parsley if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
