  "ingredients": [
    "3 large eggs",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "2 teaspoons vanilla extract",
    "3 cups all-purpose flour",
    "3 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "2 teaspoons ground nutmeg",
    "2 cups shredded summer squash"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl with an electric mixer until fluffy. Beat in sugar, oil, and vanilla; gradually mix in flour, baking powder, cinnamon, and nutmeg until combined. Fold in shredded squash and pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center of bread comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
