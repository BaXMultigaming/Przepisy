  "ingredients": [
    "0.5 cup butter, softened",
    "0.25 cup non-fat plain yogurt",
    "1 cup packed light brown sugar",
    "0.5 cup white sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "1.25 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "3 cups quick cooking oats",
    "1 cup chopped walnuts",
    "0.5 cup semisweet chocolate chips",
    "0.25 cup carrots, shredded",
    "0.25 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, yogurt, brown sugar, and white sugar with an electric mixer in a large bowl until smooth. Add eggs one at a time. Beat in vanilla extract. Mix in flour and baking soda until just incorporated. Fold in quick oats, walnuts, chocolate chips, carrots, and cranberries. Roll dough into walnut-sized balls and place 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until cookies are golden brown, about 12 minutes. Allow cookies to cool on baking sheet for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
