  "ingredients": [
    "1 tablespoon paprika",
    "1 teaspoon chili powder",
    "1 teaspoon onion powder",
    "0.25 teaspoon cayenne pepper",
    "0.125 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 pound pork back ribs, membrane removed",
    "apple wood chips, soaked",
    "0.5 cup barbeque sauce, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the smoker to 225 degrees F (110 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together paprika, chili powder, onion powder, cayenne pepper, salt, and pepper in a small bowl until well combined; rub evenly over both sides of ribs. Place ribs, back-side down, on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the rack in the preheated smoker. Add apple wood chips according to manufacturer's instructions. Smoke ribs until meat shrinks away from the bones, about 5 hours and 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ribs from the smoker; cover with barbecue sauce. Wrap with aluminum foil. Let rest for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
