  "ingredients": [
    "1 (15 ounce) can butter beans, drained",
    "1 small onion, chopped",
    "1 tablespoon finely chopped jalapeño pepper",
    "6 saltine crackers, crushed",
    "1 egg, beaten",
    "0.5 cup shredded Cheddar cheese",
    "0.25 teaspoon garlic powder",
    "salt and pepper to taste",
    "0.25 cup vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mash butter beans. Mix in onion, jalapeño, crackers, egg, cheese, garlic powder, salt, and pepper. Divide into 4 equal parts and shape into patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat; use more or less oil to reach 1/4 inch in depth. Fry patties until golden, about 5 minutes on each side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
