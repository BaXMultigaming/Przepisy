  "ingredients": [
    "6 cups white sugar",
    "6 cups brown sugar",
    "3 cups distilled white vinegar",
    "5 small red hot chile peppers, seeded and chopped",
    "4 teaspoons ground allspice",
    "2 teaspoons ground ginger",
    "2 teaspoons ground nutmeg",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "1 teaspoon kosher salt",
    "2 large onions, chopped",
    "1 cup golden raisins",
    "1 cup raisins",
    "0.5 cup fresh ginger root, chopped",
    "3 cloves garlic, chopped",
    "16 cups sliced, semi-ripe mangos",
    "0.5 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M2-BrTkp5VxK5z0r7BN6K_R4Am0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19842-mango-chutney-VAT-step-01-26e340402bfb4024a2178c2d256dbf99.jpg"
      ],
      "image": "assets/images/19842/step_01.webp"
    },
    {
      "text": "Combine white sugar, brown sugar, vinegar, chile peppers, allspice, ground ginger, nutmeg, cinnamon, cloves, and salt in a large saucepan. Bring to a boil; boil for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_xv6MjKzOpfAevWyhZXOJoITM3g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19842-mango-chutney-VAT-step-02-98a42430928f4cfe830e461871138074.jpg"
      ],
      "image": "assets/images/19842/step_02.webp"
    },
    {
      "text": "Stir in onions, golden raisins, raisins, fresh ginger, and garlic; boil for another 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5NjBupdqjXg_I_1dh-R1ENofH44=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19842-mango-chutney-VAT-step-03-bd7c7f8e42794e75bdc5988616ea5edc.jpg"
      ],
      "image": "assets/images/19842/step_03.webp"
    },
    {
      "text": "Stir in mangos (and almonds if using); reduce heat to low and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q07ST8XeOq6RnjmYDC_hPgD7UX8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19842-mango-chutney-VAT-step-04-ce9b2b9e00d84b1c8c5160d2bd85e8ae.jpg"
      ],
      "image": "assets/images/19842/step_04.webp"
    },
    {
      "text": "Pack chutney into hot, sterilized jars, filling to within 1/4 inch of the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1VQfbOmEUHF1v5Npgt1OqJSNkjU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19842-mango-chutney-VAT-step-05-A-6fb62f36568e4db99a3a5397c1f1ee98.jpg"
      ],
      "image": "assets/images/19842/step_05.webp"
    },
    {
      "text": "Run a clean knife or thin spatula around the insides of the jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-ZPU7Y0iJKyERGQsVD1CVPD2sLY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19842-mango-chutney-VAT-step-06-2e2a2259fc3c4c7297719cd1e2271f98.jpg"
      ],
      "image": "assets/images/19842/step_06.webp"
    }
