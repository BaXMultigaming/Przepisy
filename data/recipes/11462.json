  "ingredients": [
    "2.5 cups all-purpose flour",
    "2 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.2999999523163 cups packed brown sugar",
    "10 tablespoons butter, softened",
    "1 egg",
    "0.66699999570847 cup apple juice",
    "2 cups butterscotch chips",
    "0.75 cup grated apple",
    "0.75 cup chopped walnuts",
    "2 tablespoons butter",
    "1 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, cinnamon, baking soda and salt in medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and 1/2 cup butter in large mixer bowl until creamy. Beat in egg. Gradually beat in flour mixture alternately with apple juice. Stir in 1 1/2 cups butterscotch chips, apple and 1/2 cup walnuts. Drop by slightly rounded tablespoon onto lightly greased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 to 12 minutes, until lightly browned. Let stand 2 minutes; cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the cookies cool make the butterscotch glaze: Melt remaining butterscotch chips and 2 tablespoons butter in small, heavy saucepan over lowest possible heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When the butter and chips have melted remove the pan from heat and stir in 1 cup confectioners' sugar and 1 1/2 tablespoon apple juice until the glaze is smooth. Spread the glaze on the cooled cookies and sprinkle with remaining walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
