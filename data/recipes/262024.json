  "ingredients": [
    "cooking spray",
    "1 (8 pound) spiral-cut ham, or more to taste",
    "0.5 cup honey",
    "0.5 cup brown sugar",
    "2 tablespoons spicy brown mustard",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.33333334326744 cup water",
    "2 tablespoons cornstarch",
    "1 tablespoon water"
  ],
  "steps": [
    {
      "text": "Spray the slow cooker insert with cooking spray and place ham inside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine honey, brown sugar, mustard, cinnamon, and nutmeg in a saucepan over medium heat. Cook, whisking thoroughly, until sugar is melted and ingredients are combined, 2 to 5 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour water into the bottom of the slow cooker. Pour sauce over the ham. Cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the slow cooker on Low, 6 to 8 hours. Baste the ham with the juices from the bottom once every hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ham from the slow cooker. Pour juices from the bottom into a saucepan over medium heat. Mix cornstarch and water together in a bowl and pour into the saucepan. Cook until mixture thickens into a glaze, 6 to 8 minutes. Pour glaze over the ham or use as a gravy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
