  "ingredients": [
    "5 eggs, lightly beaten",
    "1.5 cups milk",
    "1 cup half-and-half cream",
    "1 teaspoon vanilla extract",
    "0.5 (1 pound) loaf French bread, cut diagonally in 1 inch slices",
    "0.5 cup butter, melted",
    "1 cup light brown sugar",
    "2 tablespoons maple syrup",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "In a large bowl, whisk together eggs, milk, cream and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kdiw2Ce7kSOjB28oszbJi2yslhI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21315-make-ahead-french-toast-PICS-step-01-ce58f72c92434e3bb0922853dc8f4a21.jpg"
      ],
      "image": "assets/images/21315/step_01.webp"
    },
    {
      "text": "Dip bread slices into egg mixture and place in a lightly greased 9x13 inch baking pan. Refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YXdSjI1-cMWcquXQyDkzvVGR27A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21315-make-ahead-french-toast-PICS-step-02-e826a72d9f80419cb25afd3063afefa8.jpg"
      ],
      "image": "assets/images/21315/step_02.webp"
    },
    {
      "text": "The next morning: Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine butter, sugar, maple syrup and pecans. Spoon mixture over bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kkeYKEdKW9rJYpupoq2dliwyGhs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21315-make-ahead-french-toast-PICS-step-03-25e923df065e44508c57112b0370ddf2.jpg"
      ],
      "image": "assets/images/21315/step_04.webp"
    },
    {
      "text": "Bake in preheated oven until golden, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/54UT7v7eNWmG2xzziMokzB6Khks=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21315-make-ahead-french-toast-PICS-step-04-db9b516d3df64e07be47d0bd7df052fe.jpg"
      ],
      "image": "assets/images/21315/step_05.webp"
    },
    {
      "text": "Let stand 5 minutes before serving.",
