  "ingredients": [
    "1 tablespoon canola oil",
    "2 pounds boneless beef chuck roast, cut into chunks",
    "1 pound tomatoes, chopped",
    "4 cups water",
    "1 medium onion, chopped",
    "4 medium jalapeno peppers, diced",
    "1 cup chopped fresh cilantro, divided",
    "5 cloves garlic, smashed",
    "2 tablespoons ground cumin",
    "salt and ground black pepper to taste",
    "2 medium limes, juiced",
    "1 cup shredded Monterey Jack cheese",
    "12 (6 inch) flour tortillas, warmed"
  ],
  "steps": [
    {
      "text": "Heat oil in a large Dutch oven or pot over medium heat. Add beef and saute, working in batches if needed, until browned, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w_Egxfey40mkukFBeNadyHO2QSk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283197-beef-flautas-step-1-0358-1-96c9487ccddb40cca686876ea1862b1a.jpg"
      ],
      "image": "assets/images/283197/step_01.webp"
    },
    {
      "text": "Add tomatoes, water, onion, jalapenos, 1/2 cup cilantro, garlic, cumin, salt, and pepper; bring to a boil. Lower heat to a simmer and cook until meat is tender, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9FfmeqZ7-M1OU1WFKOTtmbLUn0k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283197-beef-flautas-step-3-0420-1-e317097662854d2e986dfff1fc92289b.jpg"
      ],
      "image": "assets/images/283197/step_02.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove beef from the pot, shred with 2 forks, and toss with remaining cilantro, lime juice, and more salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0WoBq4059N_BInYL0JuSy0pyR48=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283197-beef-flautas-step-4-0422-1-566798fe31fe46d39c2ab6ef68f0c757.jpg"
      ],
      "image": "assets/images/283197/step_04.webp"
    },
    {
      "text": "Take each tortilla and place 2 tablespoons of the shredded beef and some Monterey Jack cheese into it. Roll tightly and place on the prepared cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WjDIMSy8r0Si8O5EhsDK1MHbLs4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283197-beef-flautas-step-5-0423-1-0c227785850344738bac6eccbf5454de.jpg"
      ],
      "image": "assets/images/283197/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until flautas are golden and crisp, about 15 minutes, turning once halfway through. Remove from the oven and cut in half before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EdZPl7GPq38tyrIU5jLjKT7GVSE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283197-beef-flautas-step-6-0424-1-37615e5ff1a04604806b36079689a540.jpg"
