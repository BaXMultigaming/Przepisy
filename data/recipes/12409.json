  "ingredients": [
    "10 cups all-purpose apples, peeled, cored and sliced",
    "1 cup white sugar",
    "1 tablespoon all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.5 cup water",
    "1 cup quick-cooking oats",
    "1 cup all-purpose flour",
    "1 cup packed brown sugar",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "0.5 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9Gr5w8pjajtKRf-X3GXmsKWZ7uY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12409-apple-crisp-ii-ddmfs-0177-4x3-step01-683b834511d646b38715ae14fba1bb56.jpg"
      ],
      "image": "assets/images/12409/step_01.webp"
    },
    {
      "text": "Place sliced apples in a 9x13-inch baking dish. Mix white sugar, 1 tablespoon flour, and cinnamon together; sprinkle over apples. Pour water evenly over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Sd2AX7Oea9QYiGd7o_IhUBYaO5c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12409-apple-crisp-II-MFS-023-step2c-4x3-6a489b45f2014513997cc8f2f04983dc.jpg"
      ],
      "image": "assets/images/12409/step_02.webp"
    },
    {
      "text": "Combine oats, 1 cup flour, brown sugar, baking powder, and baking soda in a large bowl. Add melted butter and mix with a fork until crumbly; sprinkle evenly over apple mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jLNfCH4GeqykAnF188JkoQIiXJ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12409-apple-crisp-II-MFS-024-step3-4x3-44de440a07d4424da96dbc2dd38c9329.jpg"
      ],
      "image": "assets/images/12409/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until apple filling is bubbling, and top is golden brown, crisp, and caramelized around the edges, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5Cqghl-BLnGYFj_swWCs6nvZ-Bo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12409-apple-crisp-II-MFS-025-step4-4x3-10a95075340c4b89a45009902674a8dc.jpg"
      ],
      "image": "assets/images/12409/step_04.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G1ETl0aSJafMaQAQIwV2AFR1Lzs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12409-apple-crisp-II-MFS-033-beauty1-4x3-e7f6d6c193484e0daa43e571723ff16e.jpg"
