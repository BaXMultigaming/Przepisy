        "https://www.allrecipes.com/thmb/hKenjvOu4PUWHM4kLzYYA68bl4E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-26060-pumpkin-dump-cake-ddmfs-step01_7645-60cc6fa049fa4af88c1b47d738bb6c19.jpg"
