  "title": "Monterey Chicken",
  "description": "Classic Monterey chicken — marinated, baked, and then topped with crispy bacon, sautéed onions, peppers, mushrooms, and melted mozzarella cheese.",
  "authors": [
    "Leigh"
  ],
  "date_published": "2018-03-21T12:19:57-04:00",
