  "ingredients": [
    "1.5 cups cooked black beans",
    "3 tablespoons hot salsa",
    "2 green onions, chopped",
    "2 cloves garlic, minced",
    "0.5 cup low-fat cottage cheese",
    "1 teaspoon hot pepper sauce",
    "2 teaspoons ground cumin",
    "1 teaspoon ground coriander seed",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine black beans, salsa, green onions, garlic, cottage cheese, hot pepper sauce, cumin, coriander, salt and pepper in an electric blender and blend until smooth. Add a little water, if necessary, to blend mixture thoroughly.",
