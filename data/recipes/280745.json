  "ingredients": [
    "3.5 cups rolled oats",
    "0.75 cup sweetened dried cranberries (such as Craisins®)",
    "0.66666668653488 cup sunflower seeds",
    "0.5 cup white chocolate chips",
    "0.5 cup toasted sesame seeds",
    "0.5 cup oat bran",
    "3 tablespoons flax seeds",
    "1 tablespoon ground cinnamon",
    "1 teaspoon salt",
    "1.5 cups creamy natural peanut butter",
    "1 cup honey",
    "5 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, cranberries, sunflower seeds, chocolate chips, sesame seeds, oat bran, flax seeds, cinnamon, and salt in a large bowl. Stir in peanut butter, honey, and oil until well combined. Press mixture firmly into a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 12 to 15 minutes. Cool for 5 minutes. Chill in the refrigerator for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice chilled bars into twenty 2x3-inch squares. Wrap in plastic wrap and refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
