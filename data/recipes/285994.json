  "ingredients": [
    "1 stick butter",
    "1 medium onion, diced",
    "1.5 teaspoons garlic, minced",
    "1 cup all-purpose flour",
    "0.5 (32 ounce) container chicken broth",
    "1.5 cups milk",
    "2 teaspoons chicken bouillon granules",
    "1 cup sour cream",
    "1 cup shredded Colby-Jack cheese",
    "1 cup shredded Cheddar cheese",
    "1 pound cooked chicken breasts, shredded",
    "3 cups chopped cooked broccoli",
    "salt and ground black pepper to taste",
    "4 cups crushed cornflakes",
    "1 tablespoon butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1 stick butter in a large frying pan over medium heat. Add onion and garlic and saute until onion is translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour and stir quickly until it is mixed like Play-Doh®. Quickly add broth, milk, and chicken bouillon; whisk until smooth. Remove from the heat and transfer to a large bowl. Add sour cream and both cheeses; stir until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place shredded chicken across the bottom of a 9x13-inch casserole dish. Layer cooked broccoli over the chicken and season with salt and pepper. Pour the cheese mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until hot, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place crushed cornflakes in a zip-top bag. Add melted butter and seal the bag. Massage with your hands until butter coats all the cornflakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove casserole from the oven and distribute cornflake mixture evenly over the top. Bake for 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
