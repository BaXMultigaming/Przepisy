  "ingredients": [
    "2 gallons apple cider",
    "2 cups fresh orange juice",
    "1 cup white sugar",
    "1 cup lemon juice",
    "1 cup pineapple juice",
    "1 cinnamon stick, broken into pieces",
    "1 teaspoon whole cloves"
