  "ingredients": [
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "0.25 cup milk",
    "6 skinless, boneless chicken breasts",
    "6 slices Swiss cheese",
    "2 cups herb-seasoned stuffing mix",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x12-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk condensed soup and milk together in a small bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange chicken in the prepared baking dish. Layer each breast with a slice Swiss cheese, then spoon soup mixture over top. Sprinkle with stuffing mix and drizzle with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake in the preheated oven until no longer pink in the center and the juices run clear, about 50 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
