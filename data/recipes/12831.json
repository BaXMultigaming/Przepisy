  "title": "Shrimp and Crab Casserole",
  "description": "This crab and shrimp casserole is a traditional baked casserole with a seafood twist! Fresh crabmeat can be substituted for imitation.",
  "authors": [
    "D. L. Mooney"
  ],
  "date_published": "1999-07-25T05:40:20-04:00",
