  "ingredients": [
    "1 egg",
    "2 tablespoons peanut butter",
    "0.5 tablespoon any flavor fruit jam",
    "1 teaspoon white vinegar",
    "1 teaspoon warm water"
  ],
  "steps": [
    {
      "text": "Place egg in a saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let egg stand in hot water for 10 to 12 minutes. Remove from hot water, cool, peel and separate the yolk from the white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, crumble the egg yolk and whisk together with the peanut butter, jam and vinegar. Add enough warm water to achieve the desired consistency.",
