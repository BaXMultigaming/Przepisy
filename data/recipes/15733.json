  "ingredients": [
    "3 pounds apples - peeled, cored and chopped",
    "3 cups water",
    "1 cup white sugar",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Gather all the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bKUMsp19-MniP3rZ7Cvx01oTUws=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15733-fresh-applesauce-DDMFS-step-01-2d4c38e2661947e4b8a209c299860cc6.jpg"
      ],
      "image": "assets/images/15733/step_01.webp"
    },
    {
      "text": "Place apples in a large saucepan barely covered with water over medium-low heat; simmer until apples are tender, 15 to 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gvWR0fEnhtUkIyLIEwBTIKEDMpY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15733-fresh-applesauce-DDMFS-step-02-639c153b16ad463daf9e36eec6eead4e.jpg"
      ],
      "image": "assets/images/15733/step_02.webp"
    },
    {
      "text": "Run apples through a food mill (or purée in a blender); return to the saucepan. Stir in sugar and lemon juice; cook over medium heat until sugar is dissolved and sauce is thickened, 3 to 5 minutes.",
      "section": null,
