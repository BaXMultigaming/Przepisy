  "ingredients": [
    "3 cups quick-cooking oatmeal",
    "1.5 cups all-purpose flour",
    "0.25 cup cocoa powder",
    "1 (3.4 ounce) package instant chocolate pudding mix",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup butter, softened",
    "0.75 cup brown sugar",
    "0.75 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups chocolate chips",
    "1 cup chopped walnuts",
    "nonstick cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C) according to manufacturer's instructions. Spray the air fryer basket with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oatmeal, flour, cocoa powder, pudding mix, baking soda, and salt together in a bowl until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, brown sugar, and white sugar together in another bowl using an electric mixer. Add eggs and vanilla extract. Add oatmeal mixture and mix well. Stir in chocolate chips and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough into the air fryer using a large cookie scoop; flatten out and leave about 1 inch between each cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until lightly browned, 6 to 10 minutes. Cool on a wire rack before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
