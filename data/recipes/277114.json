  "title": "Air Fryer Triple-Chocolate Oatmeal Cookies",
  "description": "These delicious triple-chocolate oatmeal cookies with walnuts are given a preparation makeover by cooking them in an air fryer.",
  "authors": [
    "Yoly"
  ],
