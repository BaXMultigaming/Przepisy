  "ingredients": [
    "1.5 pounds cauliflower, broken into florets",
    "0.25 cup Buffalo wing sauce",
    "1 teaspoon dry ranch dressing mix",
    "1 teaspoon olive oil"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cauliflower, Buffalo sauce, ranch mix, and oil together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold an extra-long sheet of aluminum foil in half to make a double-layer sheet; place cauliflower mixture in the center. Pull two opposite edges of the foil over cauliflower, overlapping each other. Fold the remaining two edges in to create a packet. Don't seal the packet too tightly; leave some room for the steam to expand.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until cauliflower is tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
