  "ingredients": [
    "1 (9 inch) deep dish pastry shell, partially baked",
    "1 pound baby carrots",
    "0.33333298563957 cup honey",
    "2 eggs",
    "5 tablespoons unsalted butter, softened",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 teaspoon vanilla extract",
    "0.5 cup finely chopped walnuts",
    "0.5 cup packed brown sugar",
    "0.5 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Steam carrots until soft but not mushy. Cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place carrots in food processor and puree until smooth. Add honey, eggs, butter or margarine, salt, cinnamon, nutmeg, vanilla, and walnuts. Blend until smooth. Pour mixture into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl combine brown sugar and white sugar, mixing well to get all lumps out. Fold sugar mixture gradually into carrot mixture until well incorporated. Pour mixture into partially baked pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 60 to 70 minutes, until toothpick inserted in center comes out clean. Serve pie warm or cold. Refrigerate any leftovers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
