  "ingredients": [
    "1 cup white sugar",
    "1 cup light corn syrup",
    "0.5 cup unsalted butter",
    "4 large eggs",
    "0.25 cup bourbon",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "6 ounces semisweet chocolate chips",
    "1 cup chopped pecans",
    "1 (9 inch) pie shell"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees F).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat sugar, corn syrup, and butter in a small saucepan over medium heat, stirring constantly, until butter melts and sugar dissolves. Remove from the heat and cool slightly, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EIfBH-PlT6CxV2IF-wlw00Yo_14=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15994-chocolate-bourbon-pecan-pie-VAT-step-02-a622a43d5dcd4516b2ed0e2cd803eaf2.jpg"
      ],
      "image": "assets/images/15994/step_02.webp"
    },
    {
      "text": "Whisk eggs, bourbon, vanilla, and salt together in a large bowl until well combined. Slowly pour sugar mixture into egg mixture, whisking constantly. Stir in chocolate chips and pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bqB_3jAzjLpzAkVDwPWZJ7dkxtQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15994-chocolate-bourbon-pecan-pie-VAT-step-03-01e79746d63f444ebe26e15c1104f362.jpg"
      ],
      "image": "assets/images/15994/step_03.webp"
    },
    {
      "text": "Pour mixture into prepared deep-dish pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NndBi5VTWuAao9P075mhIRb3K7c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15994-chocolate-bourbon-pecan-pie-VAT-step-04-0347bbf761064bdaae1adaa966209198.jpg"
      ],
      "image": "assets/images/15994/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until set and golden, 50 to 55 minutes. Serve warm or chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JisAN4WUwd6gzEHj0xxk4v26tGA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15994-chocolate-bourbon-pecan-pie-VAT-step-05-b3471e7c483d43d0ac09716100edd9ce.jpg"
