  "ingredients": [
    "2.25 cups packed light brown sugar",
    "0.75 cup butter, melted",
    "3 eggs",
    "2.75 cups all-purpose flour",
    "2.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup chopped walnuts",
    "6 ounces semi-sweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and melted butter in a large bowl; cool slightly. Beat in eggs, one at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, and salt in a separate bowl. Add to brown sugar mixture; mix well. Stir in walnuts and chocolate chips. Pour into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes. When almost cool, cut into 48 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
