  "ingredients": [
    "1.5 cups quick-cooking oats",
    "0.25 cup white sugar",
    "1 teaspoon baking powder",
    "0.75 teaspoon salt",
    "0.5 cup milk",
    "0.25 cup butter, softened",
    "0.25 cup applesauce",
    "1 egg, beaten",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, sugar, baking powder, and salt together in a bowl. Add milk, butter, applesauce, egg, and vanilla extract; mix until a smooth, thin consistency is reached. Pour oatmeal into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
