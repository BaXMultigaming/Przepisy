  "ingredients": [
    "2.25 cups sifted all-purpose flour",
    "1.125 cups warm milk",
    "0.25 cup white sugar",
    "1 (.25 ounce) package active dry yeast",
    "6 tablespoons butter, softened",
    "1 tablespoon vanilla extract",
    "1 pinch salt",
    "3 large apples - peeled, cored, and sliced",
    "1 cup white sugar",
    "0.75 cup sifted all-purpose flour",
    "2 ounces candied lemon peel, chopped",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 pinch salt",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Grease the bottom and sides of a 9x13-inch baking dish or a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jqDNZE3x4pSEQ0OfDmBBsYyxsd0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-221383-apfelkuchen-apple-cake-VAT-step-01-4e79b95cc7e84f21816cd80136110395.jpg"
      ],
      "image": "assets/images/221383/step_01.webp"
    },
    {
      "text": "Beat 2 ¼ cups flour, milk, 1/4 cup sugar, yeast, 6 tablespoons butter, vanilla extract, and 1 pinch salt in a large bowl with an electric mixer on high until dough is smooth, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E0bOvNGirD52ykIf-jK32X0Iymk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-221383-apfelkuchen-apple-cake-VAT-step-02-f612a719760d4d5f95d30e02064a5bf3.jpg"
      ],
      "image": "assets/images/221383/step_02.webp"
    },
    {
      "text": "Spread into baking dish and press dough up the sides. Press apple slices into dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UuwjmESQ5TlCuJ3NKsXVTUiSQdM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-221383-apfelkuchen-apple-cake-VAT-step-03-6f371b2da7d445b29b062a9b82cce7c2.jpg"
      ],
      "image": "assets/images/221383/step_03.webp"
    },
    {
      "text": "Mix 1 cup sugar, 3/4 cup flour, candied lemon peel, cinnamon, nutmeg, and 1 pinch salt in a bowl. Cut in 1/2 cup butter with a knife or pastry blender until mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AD6LZTEVmT-AUgOWEDo1bSlDvtE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-221383-apfelkuchen-apple-cake-VAT-step-04-56a13600290d4872baf1eb9b0123cef9.jpg"
      ],
      "image": "assets/images/221383/step_04.webp"
    },
    {
      "text": "Sprinkle over apples. Allow dough to rise for 30 minutes. Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0jMqj3mRPRurpsxlgopM0j3g23s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-221383-apfelkuchen-apple-cake-VAT-step-05-90641c301d9a4ce6973a21e64f46838c.jpg"
      ],
      "image": "assets/images/221383/step_05.webp"
    },
    {
      "text": "Bake in preheated oven until cake is golden brown and apples are tender, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ylicwoqtmGKfjmcmJo2Lif8-OFk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-221383-apfelkuchen-apple-cake-VAT-step-06-b8cbdf86c39842669b0f6763ff72be6e.jpg"
      ],
      "image": "assets/images/221383/step_06.webp"
    }
  ],
