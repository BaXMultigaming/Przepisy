  "ingredients": [
    "6 cups old-fashioned oats",
    "1.5 cups finely chopped pecans",
    "0.5 cup finely chopped almonds",
    "0.5 cup vegetable oil",
    "0.5 cup pure maple syrup",
    "0.33333334326744 cup boiling water",
    "2 teaspoons ground cinnamon",
    "1 teaspoon ground cardamom",
    "0.75 cup minced dates",
    "0.75 cup minced raisins",
    "0.66666668653488 cup minced dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, pecans, and almonds together in a bowl. Whisk oil, maple syrup, and water together in a measuring cup and pour over oat mixture; stir until evenly coated. Spread oat mixture onto 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 12 minutes; stir and continue baking for 12 minutes more. Stir and bake until granola is golden brown, about 12 minutes more. Cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cinnamon and cardamom together in a container with a lid; add dates, raisins, and cranberries. Cover container and shake until fruit is coated. Stir dried fruit into cooled granola.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
