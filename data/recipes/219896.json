  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "1.5 cups sour cream",
    "0.5 cup mayonnaise",
    "2 cups shredded mozzarella cheese, divided",
    "1 (12 ounce) jar roasted red peppers in oil with garlic, drained and chopped",
    "1 (6 ounce) jar artichoke hearts, drained and chopped",
    "1 loaf Italian bread, sliced"
  ],
  "steps": [
    {
      "text": "Beat cream cheese, sour cream, and mayonnaise together with an electric mixer in a large bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in roasted red peppers, artichoke hearts, and about half the mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkled the remaining mozzarella on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until cheese is melted and the dip is bubbly, 2 to 3 hours. Serve with Italian bread slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
