  "ingredients": [
    "2 eggs",
    "1 teaspoon milk",
    "0.5 teaspoon minced garlic",
    "salt to taste",
    "0.5 teaspoon pepper",
    "1.5 cups panko crumbs",
    "8 thin cut boneless pork chops",
    "1 cup vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Combine eggs, milk, garlic, salt, and pepper in a medium bowl until well mixed. Place panko crumbs in a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip 1 pork chop in egg mixture, then press into panko crumbs to coat evenly. Dip in egg mixture again and coat with another layer of panko crumbs. Lay coated pork chop on a plate and repeat with remaining chops. If you have time, let coated chops sit for about 10 minutes so the coating will set well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large heavy skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry pork chops in hot oil until golden brown, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
