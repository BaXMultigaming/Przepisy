  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup whole wheat flour",
    "0.5 cup packed brown sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.75 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground allspice",
    "0.25 cup butter",
    "0.5 cup raisins",
    "1 cup canned pumpkin",
    "1 egg",
    "2 tablespoons buttermilk",
    "1 egg white, beaten"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine all-purpose flour, whole wheat flour, brown sugar, baking powder, baking soda, cinnamon, salt, nutmeg, and allspice in a large bowl. Cut butter into flour mixture using a pastry blender or 2 knives until mixture is crumbly. Stir raisins into flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk pumpkin, egg, and buttermilk together in a bowl; stir into flour mixture until dough is well mixed. Pat dough into a 3/4-inch-thick circle on a lightly floured surface. Cut dough into 14 scones using a 2-inch round cutter and transfer to a baking sheet. Brush tops of scones with egg white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 10 to 12 minutes. Transfer scones to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
