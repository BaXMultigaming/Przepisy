  "ingredients": [
    "0.5 cup butter, melted",
    "0.75 cup brown sugar",
    "1 tablespoon ground cinnamon",
    "12 slices sandwich bread",
    "6 eggs",
    "0.5 cup milk",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TggfaZRPaCQSNNn_ge2Mi5qVz7U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221259-best-oven-baked-french-toast-DDMFS-Step-1-7aa49f5c46be48bd841b7c7f3989c957.jpg"
      ],
      "image": "assets/images/221259/step_01.webp"
    },
    {
      "text": "Pour melted butter into a 9x13-inch baking dish; grease the sides with butter and let remaining butter sit in the bottom of the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/62tzS-ccnHUkABQGdEYikUo-ZvQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221259-best-oven-baked-french-toast-DDMFS-Step-2-628883b45b224ef1a14511601fdeb652.jpg"
      ],
      "image": "assets/images/221259/step_02.webp"
    },
    {
      "text": "Sprinkle brown sugar and cinnamon evenly over melted butter. Arrange two layers of bread slices on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LCkG9CeyVP55npg1ihf5fMCWdAc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221259-best-oven-baked-french-toast-DDMFS-Step-3-b41d374823f7416c9925844c56ce0bcd.jpg"
      ],
      "image": "assets/images/221259/step_03.webp"
    },
    {
      "text": "Whisk eggs, milk, and salt together in a bowl; pour over bread slices. Cover and refrigerate 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h_WEHHUIDY1Y_eNqNx5hJUaSnz0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221259-best-oven-baked-french-toast-DDMFS-Step-5-361d9afcec964fdc90d31dfba0a1693c.jpg"
      ],
      "image": "assets/images/221259/step_04.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Bake in the preheated oven until golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZZ2aREjotdl9AVXV1YWUIPhR7Xw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221259-best-oven-baked-french-toast-DDMFS-Step-6-6e95fe4dfb2d4e2fb3ee5d36374808e5.jpg"
      ],
      "image": "assets/images/221259/step_05.webp"
    },
    {
      "text": "Serve with the toppings of your choice and enjoy!",
      "section": null,
      "name": null,
      "url": null,
