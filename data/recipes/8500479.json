  "ingredients": [
    "1 pound ground pork",
    "1 tablespoon soy-based liquid seasoning (such as Maggi® Jugo)",
    "0.5 teaspoon chipotle powder",
    "1 clove garlic, minced",
    "1 cup diced fresh pineapple",
    "0.25 cup minced red onion",
    "1 small jalapeno pepper, seeded and minced",
    "2 tablespoons minced fresh cilantro",
    "0.5 lime, juiced",
    "salt to taste",
    "8 (6 inch) corn tortillas"
  ],
  "steps": [
    {
      "text": "Combine ground pork, liquid seasoning, ground chipotle powder, and garlic in a bowl. Set aside for flavors to meld.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pineapple, red onion, jalapeno, cilantro, lime juice, and salt in a bowl. Set pineapple salsa aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a large skillet over high heat. Crumble ground pork into the hot skillet. Cook and stir until pork is completely browned and edges begin to crisp, 7 to 10 minutes. Drain any excess grease. Place pork in a bowl and keep warm. Wipe out skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm tortillas in skillet over medium-low heat, about 20 seconds per side. Divide meat mixture between tortillas and top with pineapple salsa",
      "section": null,
