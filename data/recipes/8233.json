  "ingredients": [
    "1 (10 inch tube pan) angel food cake",
    "1 (3 ounce) package strawberry flavored Jell-O®",
    "1 (15 ounce) can sliced peaches",
    "3 bananas",
    "1 (5 ounce) package instant vanilla pudding mix",
    "1 (8 ounce) container frozen whipped topping, thawed",
    "1 (20 ounce) can crushed pineapple, drained"
  ],
  "steps": [
    {
      "text": "Break angel food or pound cake into bite size pieces. Put into a 9x13 inch pan (preferably glass).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve 1 package of flavored gelatin in 1 cup of water and pour over cake pieces, spreading to the edges of pan. Drain the peaches and pour the juice over the gelatin in the pan. Slice bananas on top of gelatin. Arrange peach slices on top of banana slices. If desired, add crushed pineapple.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare instant pudding according to instructions on box and spread evenly over fruit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread whipped topping on top of the pudding. Try to keep the layers separate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate at least 2 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
