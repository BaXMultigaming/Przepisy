  "title": "Angel Cake Surprise",
  "description": "An easy, quick no-bake dessert made with angel food cake, fruit, flavored gelatin, and whipped topping.",
  "authors": [
    "Mel"
  ],
  "date_published": "1999-05-20T02:13:17-04:00",
