  "ingredients": [
    "2 cups all-purpose flour",
    "1.5 cups white chocolate chips",
    "0.5 cup white sugar",
    "3 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup milk",
    "0.33333334326744 cup vegetable oil",
    "1 egg",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 12-cup muffin tray with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, white chocolate chips, sugar, baking powder, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix milk, oil, egg, and vanilla extract together in a medium-sized bowl. Add to flour mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill 2/3 of each prepared muffin cup with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool for 2 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
