  "ingredients": [
    "2 (3 ounce) packages chicken-flavored ramen noodles, broken into pieces, seasoning packets reserved",
    "0.5 cup raw sunflower seeds",
    "0.5 cup slivered almonds",
    "1 (16 ounce) package coleslaw mix",
    "3 green onions, chopped",
    "0.5 cup olive oil",
    "3 tablespoons white vinegar",
    "1 tablespoon white sugar",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread ramen noodles, sunflower seeds, and almonds onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jrJI5hXxCzRxRyYjtkPBeHRKFnI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237732-top-ramen-salad-step1-434copy-6d573ac501774cc793044684c42f448c.jpg"
      ],
      "image": "assets/images/237732/step_02.webp"
    },
    {
      "text": "Bake noodle mixture in the preheated oven until fragrant and toasted, 10 to 15 minutes. Set aside to cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EyWP0jhiLxV27zDzKvyQzbPk7Os=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237732-top-ramen-salad-step2-436copy-7e3ea39c18274cb3a2ebd1cec40c0fff.jpg"
      ],
      "image": "assets/images/237732/step_03.webp"
    },
    {
      "text": "Combine coleslaw mix and green onions in a large bowl; sprinkle cooled noodle mixture over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Jrjvy6ADea8EhtARHhTytP2hHwo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237732-top-ramen-salad-step3-439copy-37d8520fb3644a538f2ea06ca7220396.jpg"
      ],
      "image": "assets/images/237732/step_04.webp"
    },
    {
      "text": "To make the dressing: Whisk olive oil, reserved ramen seasoning packets, vinegar, sugar, and black pepper together in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kogs1viwb1R0BGZ8bQQpjLPt7rk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237732-top-ramen-salad-step4-443copy-8148b62ac4ba4c8498fe94f4dcb8e445.jpg"
