  "ingredients": [
    "0.5 cup olive oil",
    "0.25 cup red wine vinegar",
    "0.75 medium lemon, juiced",
    "2.5 tablespoons minced fresh rosemary",
    "6 cloves garlic, minced",
    "0.75 teaspoon Dijon mustard",
    "salt to taste",
    "4 (4 ounce) Lamb, Australian, imported, fresh, leg, sirloin chops, boneless, separable lean and fat, trimmed to 1/8\" fat, raw"
  ],
  "steps": [
    {
      "text": "Whisk oil, vinegar, lemon juice, rosemary, garlic, Dijon, and salt together in a large glass or ceramic bowl. Add chops; toss to evenly coat. Cover the bowl with plastic wrap; marinate in the refrigerator 2 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chops from marinade; shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until an instant-read thermometer inserted into centers reads at least 135 degrees F (57 degrees C), 5 to 7 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
