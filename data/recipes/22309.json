  "ingredients": [
    "2 cups white sugar",
    "2 cups cantaloupe - peeled, seeded and pureed",
    "1 cup vegetable oil",
    "3 large eggs",
    "1 tablespoon vanilla extract",
    "3 cups all-purpose flour",
    "2 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon ground ginger",
    "1.6666666269302 cups brown sugar",
    "0.5 cup butter",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease and flour two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, puréed cantaloupe, oil, eggs, and vanilla in a large bowl with an electric mixer until well combined. Whisk flour, cinnamon, baking soda, salt, baking powder, and ginger together in a separate bowl. Stir flour mixture into cantaloupe mixture until combined. Divide batter evenly between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the centers of loaves comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make praline glaze: Combine brown sugar, pecans, and butter in a microwave-safe bowl. Cook on High in the microwave for about 3 minutes, stirring every minute, until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sauce over warm loaves. Cool for 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
