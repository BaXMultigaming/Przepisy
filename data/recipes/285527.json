  "ingredients": [
    "3 tablespoons butter",
    "2 teaspoons minced garlic",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon dried thyme",
    "2 cups sliced button mushrooms",
    "1.5 cups Cabernet Sauvignon",
    "1 cup beef broth",
    "1 bay leaf",
    "0.25 cup water",
    "1 tablespoon cornstarch"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium heat. Add garlic, salt, black pepper, and thyme; cook until fragrant, about 30 seconds. Add mushrooms; cook until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add wine, beef broth, and bay leaf; cook until sauce is reduced by about 1/4, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk water and cornstarch together in a bowl until smooth; whisk into sauce. Reduce heat to medium-low; simmer until thickened, 2 to 3 minutes. Remove and discard bay leaf before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
