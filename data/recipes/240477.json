  "ingredients": [
    "8 cups water, or more as needed",
    "1 whole orange peel",
    "1 whole Granny Smith apple peel",
    "1 whole lemon peel",
    "2 cinnamon sticks",
    "1 tablespoon vanilla extract",
    "3 whole star anise pods",
    "1 fresh pine sprig"
  ],
  "steps": [
    {
      "text": "Bring 8 cups water to a boil in a large pot over high heat. Add orange peel, apple peel, lemon peel, cinnamon sticks, vanilla, star anise, and pine sprig to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce the heat to low and simmer for as long as desired, up to 8 hours or all day. Check the water level every 30 minutes, adding more water as necessary.",
      "section": null,
      "name": null,
