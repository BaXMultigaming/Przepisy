  "ingredients": [
    "1 cup packed brown sugar",
    "0.5 cup shortening",
    "0.5 cup real maple syrup",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, beat together brown sugar and shortening until fluffy. Mix in maple syrup, egg, and vanilla until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, and salt in a separate bowl. Add flour mixture to creamed mixture a little at a time, mixing well after each addition. Stir in coconut. Drop by tablespoonfuls 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
