  "ingredients": [
    "0.25 cup butter, melted",
    "2 tablespoons grated Parmesan cheese",
    "1 tablespoon minced garlic",
    "1 (8 ounce) package refrigerated crescent roll dough (such as Pillsbury®",
    "0.5 teaspoon Italian seasoning",
    "0.25 teaspoon ground black pepper to taste",
    "0.125 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, Parmesan cheese, and garlic in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Open can of dough but do not unroll. Cut dough into 12 equal pieces using a serrated knife; place slices onto the prepared baking sheet. Brush with garlic butter; sprinkle with Italian seasoning, black pepper, and paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 16 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
