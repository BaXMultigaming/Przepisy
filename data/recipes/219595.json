  "ingredients": [
    "2 tablespoons butter",
    "1 tablespoon cooking oil",
    "2 tablespoons all-purpose flour",
    "0.25 teaspoon dried rosemary",
    "0.25 teaspoon dried thyme",
    "1.5 cups heavy cream",
    "1 tablespoon brown sugar",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon ground nutmeg",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter with oil in a saucepan over medium heat. Add flour, rosemary, and thyme; cook and stir until smooth, bubbling, and turns a light tan color, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in heavy cream, a little at a time, allowing each addition to incorporate fully before adding more. Stir in brown sugar, cinnamon, nutmeg, salt, and black pepper; cook and stir until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
