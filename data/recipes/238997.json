  "ingredients": [
    "0.25 cup fresh raspberries",
    "2 tablespoons rice vinegar",
    "1 tablespoon lemon juice",
    "1 clove garlic, chopped, or more to taste",
    "0.5 teaspoon white sugar",
    "1 pinch sea salt",
    "1 pinch ground white pepper",
    "6 tablespoons avocado oil"
