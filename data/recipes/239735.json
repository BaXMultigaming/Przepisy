  "ingredients": [
    "1 pastry for an 8-inch pie crust",
    "6 slices bacon, chopped",
    "1 onion, chopped",
    "1 (10 ounce) bag fresh spinach",
    "1 courgette (zucchini), thinly sliced",
    "1.5 cups milk",
    "2 eggs",
    "salt and ground black pepper to taste",
    "0.25 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Press pie pastry into an 8-inch pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium heat; cook and stir bacon for 3 minutes. Add onion, spinach, and courgette to bacon; cook and stir until onion and courgette are tender, spinach is wilted, and bacon is fully cooked, 5 to 10 minutes. Transfer bacon-courgette mixture to the pie pastry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk, eggs, salt, and pepper together in a bowl; pour into pastry crust. Top egg mixture with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is browned and quiche bounces back when touched, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
