  "ingredients": [
    "0.5 cup melted butter",
    "1.25 cups white sugar",
    "1 cup all-purpose flour",
    "0.75 cup milk",
    "1.5 teaspoons baking powder",
    "2.5 cups black raspberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
