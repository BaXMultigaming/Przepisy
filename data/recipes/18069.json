  "ingredients": [
    "1 pound ground beef",
    "0.5 cup dry bread crumbs",
    "1 egg",
    "garlic powder to taste",
    "1 dash Worcestershire sauce",
    "0.33300000429153 cup ketchup",
    "0.25 cup packed brown sugar",
    "0.25 cup pineapple preserves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine ground beef, bread crumbs, egg, garlic powder, and Worcestershire sauce. Mix well, and place into a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, 30 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in a separate medium bowl, stir together ketchup, brown sugar, and pineapple preserves. Pour over meatloaf about 20 minutes before removing it from the oven.",
      "section": null,
      "name": null,
      "url": null,
