  "ingredients": [
    "4 cups whole milk",
    "2 cups almond meal",
    "0.75 cup white sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon instant espresso powder",
    "0.5 teaspoon ground cardamom",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Mix milk, almond meal, sugar, cinnamon, espresso powder, and cardamom in a large saucepan; bring to a simmer. Cook, stirring often, over low heat until slightly thickened, 20 minutes. Remove from heat and stir in vanilla extract. Chill in refrigerator until thickened, at least 3 hours.",
