  "ingredients": [
    "8 eggs",
    "0.5 teaspoon prepared mustard",
    "1 tablespoon creamy salad dressing (such as Miracle Whip®), or as needed",
    "salt and pepper to taste",
    "1 pinch paprika"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
