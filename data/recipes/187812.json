  "ingredients": [
    "1 cup warm water (100 degrees F/40 degrees C)",
    "0.5 teaspoon white sugar",
    "1 (.25 ounce) package active dry yeast",
    "5 cups all-purpose flour",
    "0.75 cup white sugar",
    "2 teaspoons salt",
    "2 eggs, beaten",
    "0.5 cup butter, melted",
    "1 (8 ounce) package sliced pepperoni"
  ],
  "steps": [
    {
      "text": "Stir together 1 cup warm water and 1/2 teaspoon sugar in a small bowl until sugar dissolves. Sprinkle yeast over water; let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AIRF6vXMATnwRsGiLnVY57Lr8ek=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/187812-pepperoni-rolls-mfs-step-1-009--72db59012783423e88f3b75583d680a9.jpg"
      ],
      "image": "assets/images/187812/step_01.webp"
    },
    {
      "text": "Mix flour, 3/4 cup sugar, and salt in a large bowl. Stir in yeast mixture, beaten eggs, and melted butter until dough comes together. Turn dough out onto a lightly floured surface and knead until smooth and elastic, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iyTBqcvArETmaTJRp6bRkXVInXk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/187812-pepperoni-rolls-mfs-step-3-012--139f95a1be2846ce9e8644f4d56d71ff.jpg"
      ],
      "image": "assets/images/187812/step_02.webp"
    },
    {
      "text": "Place dough into a greased bowl and turn to coat with oil. Cover with a light cloth; let rise in a warm place until doubled in volume, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Pe7QJiCK1bU_n6JIN-h6uc4n1CQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/187812-pepperoni-rolls-mfs-step-4-068--244540d1e2524d94a78f211d7cfd1088.jpg"
      ],
      "image": "assets/images/187812/step_03.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Punch down dough; divide into 20 equal pieces about the size of a golf ball. Using your hands, flatten each piece into a small rectangle, about 4 inches square.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 3 overlapping slices of pepperoni down the center of each dough square. Place another row of 3 pepperoni slices next to the first. Roll dough around pepperoni, pinch the edges closed, and place rolls on the prepared cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/shprpOz5-4IMFnIKKgp-IVphkb4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/187812-pepperoni-rolls-mfs-step-6-072--df127066483f4df98cf95657221377e7.jpg"
      ],
      "image": "assets/images/187812/step_06.webp"
    },
    {
      "text": "Bake rolls in the preheated oven until bottoms are lightly browned and tops are barely golden, 14 to 16 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y3IhsNbNebxLI5AKkrdW_rc3YEU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/187812-pepperoni-rolls-mfs-4x3-085--f10cc371996b4898a2f19c91f6caa07d.jpg"
      ],
      "image": "assets/images/187812/step_07.webp"
    }
