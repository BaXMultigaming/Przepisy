  "ingredients": [
    "1 (4 pound) pork butt roast",
    "1.5 teaspoons salt",
    "1 teaspoon ground black pepper",
    "0.75 cup freshly squeezed orange juice",
    "0.5 cup freshly squeezed lime juice",
    "0.5 cup extra-virgin olive oil",
    "0.25 cup chopped cilantro",
    "6 cloves garlic, pressed",
    "2 oranges, zested",
    "1 lime, zested",
    "2 bay leaves",
    "2 teaspoons dried oregano",
    "1 teaspoon ground cumin"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qIXn25QT_YkUpB3I-WBr9rfSBs8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281144-slow-cooker-mojo-pork-VAT-step-01-53bce39be8054c55b90b71334df16893.jpg"
      ],
      "image": "assets/images/281144/step_01.webp"
    },
    {
      "text": "Score fat side of pork butt in a crosshatch pattern, cutting about 1/8-inch deep. Season with salt and black pepper. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qA_9yZje9tU15EPc-TmGPmW0cR0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281144-slow-cooker-mojo-pork-VAT-step-02-a2b3d112748943b6870e67db8e392086.jpg"
      ],
      "image": "assets/images/281144/step_02.webp"
    },
    {
      "text": "Combine orange juice, lime juice, olive oil, cilantro, garlic, orange zest, lime zest, bay leaves, oregano, and cumin in a large resealable bag. Add pork, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator 6 hours to overnight. Flip bag occasionally and massage marinade over roast to evenly distribute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_K30uw8VCKGwgjEVheetmWplrf8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281144-slow-cooker-mojo-pork-VAT-step-03-e1e65954b6124a43b747febeab1df24b.jpg"
      ],
      "image": "assets/images/281144/step_03.webp"
    },
    {
      "text": "Transfer pork and marinade to a slow cooker. Cover slow cooker. Cook on Low until pork is fork-tender, 7 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mNg2ddZhrZShGOMI0BZfgscn0C4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281144-slow-cooker-mojo-pork-VAT-step-04-f513af78730d44db872eb6d56a459350.jpg"
      ],
      "image": "assets/images/281144/step_04.webp"
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9HRAht_y7JvsQRDgvyox00TJWWo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281144-slow-cooker-mojo-pork-VAT-step-05-fcc149ee9fa448399dc4fddd7506c69b.jpg"
      ],
      "image": "assets/images/281144/step_05.webp"
    },
    {
      "text": "Transfer pork to a roasting pan, fat-side up. Broil until lightly browned and skin has crisped, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TTDZuz3imVou_gW4N9XKt4ca5No=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281144-slow-cooker-mojo-pork-VAT-step-06-ffe732c403994e1796c5b63a3c46c492.jpg"
      ],
      "image": "assets/images/281144/step_06.webp"
    }
