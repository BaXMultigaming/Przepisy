  "ingredients": [
    "0.75 cup soy milk",
    "0.75 cup water",
    "12 dates, pitted",
    "1.5 tablespoons flax seeds",
    "2 cups rolled oats, ground",
    "1 tablespoon brown sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.75 cup applesauce",
    "0.5 teaspoon vanilla extract",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Combine soy milk, water, dates, and flax seeds in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground oats, brown sugar, baking powder, and cinnamon in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the date mixture, applesauce, and vanilla extract in a blender. Blend until evenly mixed; pour into the bowl with the oat mixture. Stir until no dry spots remain. Fold in blueberries. Pour batter into a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 20 minutes. Let cool in the tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
