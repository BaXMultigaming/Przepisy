  "ingredients": [
    "2 large acorn squash, halved and seeded",
    "2 tablespoons brown sugar",
    "1 tablespoon butter, melted",
    "2 tablespoons olive oil",
    "2 stalks celery, chopped",
    "2 carrots, chopped",
    "2 cloves garlic, chopped",
    "1 cup garbanzo beans, drained",
    "0.5 cup raisins",
    "1.5 tablespoons ground cumin",
    "1 pinch salt and pepper to taste",
    "1 (14 ounce) can chicken broth",
    "1 cup uncooked couscous"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange squash halves cut-side down on a baking sheet. Bake until tender, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar and melted butter together in a small bowl. Brush cut sides of squash with mixture; keep squash warm while preparing stuffing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Stir in celery, carrots, and garlic; cook for 5 minutes. Mix in garbanzo beans and raisins. Season with cumin, salt, and pepper. Continue to cook and stir until vegetables are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken broth to the skillet; mix in couscous. Cover the skillet, turn off heat, and let sit until couscous completely absorbs liquid, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stuff squash halves with the skillet mixture and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
