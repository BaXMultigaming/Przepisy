  "ingredients": [
    "2 pounds lean ground beef",
    "1 (8 ounce) can tomato sauce",
    "0.5 cup crushed saltine crackers",
    "0.25 cup finely chopped onion",
    "2 eggs, beaten",
    "2 tablespoons finely chopped green bell pepper",
    "1 teaspoon salt",
    "0.25 teaspoon ground thyme",
    "0.25 teaspoon ground marjoram",
    "0.25 cup ketchup",
    "2 tablespoons light corn syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, tomato sauce, cracker crumbs, onion, eggs, bell pepper, salt, thyme, and marjoram in a large bowl until well combined. Shape mixture into two equal loaves and place into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover with foil and bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the meatloaves are baking, mix ketchup and corn syrup in a small bowl to make a glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "After 1 hour, remove the baking dish from the oven and remove the foil. Brush glaze onto both loaves. Return the baking dish to the oven and bake, uncovered, until loaves are no longer pink in the center, 15 to 20 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
