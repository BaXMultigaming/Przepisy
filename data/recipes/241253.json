  "ingredients": [
    "6 tablespoons butter",
    "0.5 cup minced onion",
    "1 tablespoon curry powder",
    "6 tablespoons all-purpose flour",
    "1.5 teaspoons salt",
    "1.5 teaspoons white sugar",
    "0.25 teaspoon ground ginger",
    "2 cups chicken broth",
    "2 cups milk",
    "4 cups cubed, cooked chicken",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Melt butter in large skillet over medium-high heat. Add onion and curry powder; saute until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, salt, sugar, and ginger into the onion mixture; cook until smooth and bubbling, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chicken broth and milk into the skillet, stir, and bring to a boil; cook at a boil for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chicken and lemon juice into the broth to cover completely; cook until the chicken is heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
