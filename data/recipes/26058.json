  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "1 cup water",
    "1 egg",
    "1/3 cup vegetable oil",
    "1 cup light brown sugar",
    "0.5 cup butter",
    "1 tablespoon all-purpose flour",
    "0.75 cup chopped pecans",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 13x9-inch baking pan with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cake mix, water, 3 eggs, and oil in a large bowl with an electric mixer on low speed until moistened. Increase speed to medium; beat for 2 minutes. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 23 to 28 minutes. Cool cake in the pan on a wire rack, about 25 minutes. Increase oven temperature to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, butter, remaining 1 egg, and flour in a large saucepan over low heat; cook until thickened, about 3 minutes. Off heat, stir in pecans and vanilla extract; spread over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until caramelized, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
