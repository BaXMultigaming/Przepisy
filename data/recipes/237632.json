  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a non-stick mini-muffin pan with floured cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chopped pecans, brown sugar, flour, melted butter, and eggs together in a bowl. Spoon pecan mixture into prepared muffin cups and place 1 whole pecan in the center of each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a cupcake comes out clean, about 18 minutes. Transfer cupcakes to a wire rack to cool completely, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
