  "ingredients": [
    "1 (3 ounce) package chicken flavored ramen noodles",
    "2 cups water",
    "0.5 cup frozen peas and carrots",
    "1 large egg",
    "2 tablespoons mayonnaise"
  ],
  "steps": [
    {
      "text": "Break up noodles and place in a microwave safe bowl. Add water and frozen veggie mix. Microwave on high 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile whisk egg, mayonnaise, and season packet from the instant ramen together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Temper egg mixture by ladling 1/4 cup of the boiling water from the noodles, whisking until combined. Ladle another 1/4 cup of the boiling water whisking until egg is \"cooked\" and completely incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add remaining liquid and the noodles. Let sit until the noodles have absorbed the majority of the liquid, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle into 2 serving bowls and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
