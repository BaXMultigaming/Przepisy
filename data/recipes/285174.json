  "ingredients": [
    "6 medium Granny Smith apples - peeled, cored and sliced",
    "0.5 cup white sugar",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 cup brown sugar",
    "1 cup all-purpose flour",
    "1 cup quick-cooking oats",
    "0.5 cup unsalted butter, diced",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apples, sugar, cinnamon, and nutmeg for filling in a bowl; transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, flour, oats, butter, and cinnamon for topping in a large bowl. Sprinkle on top of filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apple filling is bubbling, and top is crisp and golden, about 1 hour.",
      "section": null,
