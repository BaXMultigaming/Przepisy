  "ingredients": [
    "1 pound lean ground beef",
    "1 cup chopped onion",
    "0.5 medium red bell pepper, chopped",
    "1 (14.5 ounce) can peeled and diced tomatoes",
    "1 cup spaghetti sauce",
    "1 cup salsa",
    "0.25 cup taco sauce",
    "3 tablespoons chili powder",
    "2 teaspoons minced garlic",
    "1 large bay leaf",
    "1 (15 ounce) can kidney beans, drained"
  ],
  "steps": [
    {
      "text": "Cook ground beef, onion, and bell pepper in a large stockpot over medium-high heat until beef is browned, 7 to 10 minutes. Drain off excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in diced tomatoes, spaghetti sauce, salsa, taco sauce, chili powder, garlic, and bay leaf. Reduce the heat and simmer, stirring occasionally, for 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in kidney beans and cook until heated through, 3 to 5 minutes. Discard bay leaf and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
