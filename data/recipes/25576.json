  "ingredients": [
    "2 pounds dates, pitted and chopped",
    "2 pounds English walnuts, coarsely chopped",
    "1.25 cups all-purpose flour",
    "1 cup white sugar",
    "1 tablespoon baking powder",
    "4 large egg yolks",
    "4 large egg whites"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease and flour a 10-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine dates, walnuts, flour, sugar, and baking powder in a large bowl. Stir in egg yolks until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a clean, large glass or metal mixing bowl until stiff peaks form. Fold whites into date mixture until no streaks remain. Spoon into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 90 minutes. Let cool in the pan for 10 minutes, then turn out onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
