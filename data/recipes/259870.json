  "ingredients": [
    "2 pounds potatoes, peeled and thinly sliced",
    "4 large zucchini, thinly sliced",
    "4 small red onions, thinly sliced",
    "6 ripe tomatoes, pureed",
    "0.5 cup olive oil",
    "2 tablespoons chopped fresh parsley",
    "sea salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fx6ILUJEWezqTvX7Mi5KWvQQkDM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259870-Briam-Greek-Baked-Zucchini-and-Potatoes-ddmfs-4x3-step1-da255ecd5c5e402e8694a6e6ddced3e0.jpg"
      ],
      "image": "assets/images/259870/step_01.webp"
    },
    {
      "text": "Spread potatoes, zucchini, and red onions in an extra-large baking dish (9x13-inch or larger, or 2 baking dishes).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z6ZggbS8aBu1qO8tt5rcVjOZwuk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259870-BriamGreekBakedZucchiniandPotatoes-ddms-4x3-step2-71518c474a7945208099f38b1e212517.jpg"
      ],
      "image": "assets/images/259870/step_02.webp"
    },
    {
      "text": "Cover with puréed tomatoes, olive oil, and parsley; season liberally with sea salt and pepper. Toss until vegetables are evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8cyHPsOaVeFply5Bf6AZC7_BZWw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259870-BriamGreekBakedZucchiniandPotatoes-ddms-4x3-step4-407703b1dbbc4416992a15c28204aef9.jpg"
      ],
      "image": "assets/images/259870/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Stir gently, then continue baking until vegetables are tender and moisture has evaporated, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool briam slightly before serving or serve at room temperature.",
      "section": null,
