  "ingredients": [
    "4 tablespoons olive oil, divided",
    "1 onion, chopped",
    "0.25 cup balsamic vinegar",
    "1.5 cups uncooked Arborio rice",
    "0.25 cup dry white wine",
    "7 cups hot chicken broth",
    "2 cups chopped cooked chicken breast",
    "2 tablespoons butter",
    "salt and pepper to taste",
    "2 tablespoons chopped fresh thyme for garnish"
  ],
  "steps": [
    {
      "text": "Heat 2 tablespoons olive oil in a medium saucepan over medium heat. Sauté onion in hot oil until dark golden brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B1g9T83Q06lGp4wXcvYEHEhlZO8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18791-Roasted-Chicken-Risotto-Caramalized-Onions-ddmfs--step-2-128-5f8a62b187634e63937a9837c4c20af6.jpg"
      ],
      "image": "assets/images/18791/step_01.webp"
    },
    {
      "text": "Remove from heat and stir in balsamic vinegar; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/coPvwKMJrXGF1JjhHay0UAwWdN4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18791-Roasted-Chicken-Risotto-Caramalized-Onions-ddmfs--step-3-133-e64f5b2fcb164512aedb890d724d65cd.jpg"
      ],
      "image": "assets/images/18791/step_02.webp"
    },
    {
      "text": "Heat remaining 2 tablespoons olive oil in a large skillet over medium heat. Cook and stir rice in hot oil for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9NqkqRtlO22JEw5s_ouS3X5eTHQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18791-Roasted-Chicken-Risotto-Caramalized-Onions-ddmfs--step-4-136-399db6fd623d49d1bc16f3c9263af33c.jpg"
      ],
      "image": "assets/images/18791/step_03.webp"
    },
    {
      "text": "Pour in wine while stirring. Reduce heat to medium-low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FLtgQ7Fx6hRFFzYsL_sEo4F-wqE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18791-Roasted-Chicken-Risotto-Caramalized-Onions-ddmfs--step-5-142-c13a7d82799241158270e47bf78bea0c.jpg"
      ],
      "image": "assets/images/18791/step_04.webp"
    },
    {
      "text": "Pour in 1 cup hot broth; cook and stir until broth is absorbed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TB0P2R-q-wQUQyiQnPntUWXJRXM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18791-Roasted-Chicken-Risotto-Caramalized-Onions-ddmfs--step-6-146-df439fbb9ee44e4d88b32ff26843011e.jpg"
      ],
      "image": "assets/images/18791/step_05.webp"
    },
    {
      "text": "While stirring constantly, continue adding remaining broth, 1 cup at a time, until all broth is absorbed and rice is tender yet firm to the bite, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wicwNSxW5CycYoJupkt8VikhgxM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18791-Roasted-Chicken-Risotto-Caramalized-Onions-ddmfs--step-7-170-a1e243b017f2441680288f7339d8c429.jpg"
      ],
      "image": "assets/images/18791/step_06.webp"
    },
    {
      "text": "Stir in reserved onion mixture until heated through. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mIKCtUizLMXpLqeiKll7gFhJw7I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18791-Roasted-Chicken-Risotto-Caramalized-Onions-ddmfs--step-8-171-707bae3eb9c74d6bae2bd8d7184bec04.jpg"
      ],
      "image": "assets/images/18791/step_07.webp"
    },
    {
      "text": "Stir in chicken and butter; season with salt and pepper. Garnish each serving with thyme.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4KvQGgFbQIKojGfEIbGuReYKj2Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18791-roasted-chicken-with-risotto-and-caramelized-onions-DDMFS-4x3-93a41053c7bd4e829724e3a4a97e35b9.jpg"
      ],
      "image": "assets/images/18791/step_08.webp"
    }
