  "ingredients": [
    "2 tablespoons Mazola® Corn Oil",
    "0.75 cup orange marmalade",
    "0.75 cup apple juice",
    "0.5 cup brown sugar",
    "0.33333334326744 cup raisins",
    "1 tablespoon Spice Islands® Pumpkin Pie Spice",
    "1 teaspoon Spice Islands® Curry Powder",
    "3 large sweet potatoes, peeled, cut into 1-inch chunks",
    "12 ounces fresh cranberries",
    "0.25 cup finely chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F. Spray a rimmed 15 x 10-inch baking pan with cooking spray. Combine oil, marmalade, apple juice, brown sugar, raisins, pumpkin pie spice and curry powder in a large bowl. Add sweet potatoes, cranberries and pecans; mix to coat well. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 50 to 60 minutes, stirring occasionally until potatoes and cranberries are tender. Pour into a serving bowl. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
