  "ingredients": [
    "2 pounds ground beef",
    "2 pounds ground pork",
    "2 large sweet onions, diced",
    "3 large green onions, chopped",
    "4 large garlic cloves, minced",
    "2 (14.5 ounce) cans fire-roasted diced tomatoes",
    "1 (12 fluid ounce) can or bottle beer",
    "0.5 cup chili powder",
    "0.25 cup ground cumin",
    "2 ounces fire-roasted diced green chile peppers",
    "1 (1.5 fluid ounce) jigger tequila",
    "2 tablespoons corn meal",
    "6 slices pickled jalapeno pepper, chopped",
    "1 large dried ancho chile pepper",
    "1 teaspoon unsweetened cocoa powder",
    "1 teaspoon salt",
    "1 (15 ounce) can black beans, rinsed and drained",
    "0.5 cup frozen fire-roasted corn"
  ],
  "steps": [
    {
      "text": "Heat a large stock pot over medium heat. Add ground beef and ground pork; cook and stir until completely browned, about 10 minutes. Drain as much grease as you can; return the pot to the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in sweet onions, green onions, and garlic; cook and stir until onions are translucent, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomatoes, beer, chili powder, cumin, green chile peppers, tequila, corn meal, jalapeño peppers, ancho chile pepper, cocoa powder, and salt; bring to a simmer and cook until tomatoes have dissolved into liquid, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in black beans and corn; continue cooking until hot, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
