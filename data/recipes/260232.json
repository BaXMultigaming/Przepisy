  "ingredients": [
    "1 teaspoon olive oil",
    "2 skinless, boneless chicken breast halves, cut into strips",
    "2 cloves garlic, minced",
    "1.5 teaspoons Thai red curry paste",
    "1 cup coconut milk",
    "2 tablespoons white sugar",
    "1 teaspoon salt",
    "1 head broccoli, florets separated and stems chopped",
    "3 green onions, chopped"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep skillet over medium-high heat and saute chicken until browned, 2 to 3 minutes. Add garlic and curry paste and cook until fragrant, about 2 minutes. Pour in coconut milk and season with sugar and salt. Mix well. Add broccoli, cover, and simmer until broccoli is soft, about 7 minutes. Sprinkle with green onions.",
