  "ingredients": [
    "cooking spray",
    "4 large baking potatoes",
    "3 tablespoons canola oil",
    "1 tablespoon grated Parmesan cheese",
    "0.5 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon ground paprika",
    "0.125 teaspoon ground black pepper",
    "1.5 cups shredded Cheddar cheese",
    "8 strips cooked bacon, crumbled",
    "0.5 cup sour cream",
    "4 stalks green onion, sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 475 degrees F (245 degrees C). Grease a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut potatoes in half lengthwise; scoop out and discard pulp, leaving a 1/4- to 1/2-inch-thick skin. Place potatoes on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil, Parmesan cheese, salt, garlic powder, paprika, and pepper in a small bowl. Brush mixture over both sides of potato skins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crisp, 30 to 45 minutes; thicker skins can take longer to cook. Sprinkle Cheddar cheese and bacon inside skins and continue baking until cheese is melted, about 2 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with sour cream and green onions. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
