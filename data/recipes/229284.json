  "ingredients": [
    "3 cups frozen hash brown potatoes, thawed",
    "3 tablespoons butter, melted",
    "1 cup cooked ham, chopped",
    "1 cup shredded Cheddar cheese",
    "0.25 cup chopped onion",
    "0.25 cup chopped green bell pepper",
    "3 large eggs",
    "0.5 cup milk",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press hash brown potatoes between paper towels to remove excess moisture. Transfer potatoes to an 8-inch pie dish and press into the bottom and up the sides to form a crust. Drizzle with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 25 minutes. Remove from the oven and reduce heat to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ham, Cheddar cheese, onion, and bell pepper in a bowl; spread over hash brown crust. Beat eggs, milk, salt, and black pepper in the same bowl; pour over ham mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven until eggs are set, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
