  "ingredients": [
    "0.5 cup milk",
    "1 tablespoon lemon juice",
    "4 (3 ounce) fillets cod",
    "1 cup oil for frying",
    "0.33333298563957 cup cornmeal",
    "0.33333298563957 cup all-purpose flour",
    "1 teaspoon paprika",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon dried thyme",
    "0.125 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk and lemon juice in a medium bowl. Add cod fillets and soak for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep saucepan over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cornmeal and flour together in a shallow bowl. Season with paprika, black pepper, salt, garlic powder, thyme, and cayenne pepper. Dredge cod fillets in cornmeal mixture to coat both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry cod fillets in hot oil, until cooked through and golden brown, about 3 to 4 minutes per side. Transfer to a paper towel-lined plate to drain.",
      "section": null,
