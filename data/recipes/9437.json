  "ingredients": [
    "2 cups mayonnaise",
    "2 cups sour cream",
    "3 tablespoons chopped onion",
    "1 tablespoon dried dill weed",
    "1 tablespoon white sugar",
    "1 teaspoon seasoning salt"
