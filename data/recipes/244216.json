  "ingredients": [
    "2 cups frozen strawberries",
    "1.5 cups warm water",
    "2 cups milk",
    "1.5 cups fresh spinach, or to taste",
    "1 cup frozen blueberries",
    "1 frozen chopped banana",
    "1 tablespoon honey",
    "0.5 lemon, juiced"
