  "ingredients": [
    "1 (6 ounce) can tuna in water, drained",
    "3 tablespoons mayonnaise",
    "2 tablespoons hummus spread",
    "8 olives, chopped, or more to taste",
    "1 teaspoon dried oregano, or more to taste",
    "salt and ground black pepper to taste"
