  "ingredients": [
    "8 cups sliced zucchini",
    "8 cups chopped tomatoes",
    "2 cups chopped green bell pepper",
    "2 cups chopped celery",
    "2 cups chopped onion",
    "1 (10.75 ounce) can condensed tomato soup (such as Campbell's®)",
