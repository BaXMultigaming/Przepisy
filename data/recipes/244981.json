  "ingredients": [
    "0.25 cup butter",
    "6 tablespoons brown sugar, or to taste",
    "1 cup hot water",
    "6 tablespoons soy sauce",
    "1 large rutabaga, peeled and cubed"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over low heat; add brown sugar and cook and stir until brown sugar has dissolved. Stir water and soy sauce into butter mixture, increase heat to medium-high, and bring mixture to a boil. Stir in chopped rutabaga and return to boil.",
