  "ingredients": [
    "0.5 cup all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 egg",
    "0.33333298563957 cup white sugar",
    "1 tablespoon butter, melted and cooled",
    "1 cup dates, pitted and chopped",
    "0.25 cup chopped walnuts",
    "1 tablespoon milk",
    "1 tablespoon butter",
    "1 cup confectioners' sugar",
    "1 teaspoon lemon juice",
    "0.5 teaspoon lemon zest"
  ],
  "steps": [
    {
      "text": "Sift the flour with baking powder and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg and add sugar slowly. Blend in 1 tablespoon butter or margarine. Stir in dates and nuts. Gradually add flour mixture, mixing well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into a greased 8x8 inch pan, spreading evenly. Bake at 325 degrees F (165 degrees C) for 25-30 minutes. Cool in pan on wire rack. Spread top with glaze and cut into 24 sticks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Glaze: Combine 1 tablespoon milk, 1 tablespoon margarine, 1 cup confectioners' sugar, 1 teaspoon lemon juice, and 1/2 teaspoon grated lemon rind. Heat over low heat until well blended. Cool slightly before pouring over cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
