  "title": "Homemade Stewed Tomatoes",
  "description": "Learn how to make stewed tomatoes in your own kitchen by simply simmering freshly peeled ripe tomatoes and salt over low heat. Easy and delicious!",
  "authors": [
    "Mary Ann Armstrong"
  ],
  "date_published": "2000-09-16T16:20:20-04:00",
