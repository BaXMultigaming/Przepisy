  "ingredients": [
    "10 ripe tomatoes",
    "2 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Bring a large pot of water to a boil. Fill a large bowl with ice water and set it aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t4BMOY5lH7i4kl9Ccrnfv2Fll34=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21145-homemade-stewed-tomatoes-VAT-001-step-01-6d0b068910b542179dedb04e5600cedc.jpg"
      ],
      "image": "assets/images/21145/step_01.webp"
    },
    {
      "text": "Cut a shallow X on the bottom of each tomato. This will make peeling much easier. Place tomatoes in boiling water until the skin begins to peel back, about 30 seconds to 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-ivRMH9kUiHVBkrWRcURX9s9AYs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21145-homemade-stewed-tomatoes-VAT-002-step-02-af9b0fc3c13942648579897c7842f3f0.jpg"
      ],
      "image": "assets/images/21145/step_02.webp"
    },
    {
      "text": "Transfer tomatoes into the bowl of ice water; set aside for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gdCcTU469fOZx1EZA856GiSEozc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21145-homemade-stewed-tomatoes-VAT-003-step-03-2c02e279f00f4ff592022029aa0788e4.jpg"
      ],
      "image": "assets/images/21145/step_03.webp"
    },
    {
      "text": "Remove tomatoes from water; peel off the skin with your hands and slice into quarters.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_M48f0kQZAkQAONi3ujXiNl0pg8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21145-homemade-stewed-tomatoes-VAT-004-step-04-af395feeb69b4395b537f564e583d577.jpg"
      ],
      "image": "assets/images/21145/step_04.webp"
    },
    {
      "text": "Transfer tomatoes into a large saucepan over low heat; stir in salt. Simmer, stirring occasionally to prevent burning, until slightly thickened, about 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/atkz1QsBo99yp-dUNrt9d1keaso=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21145-homemade-stewed-tomatoes-VAT-005-step-05-87b430eb8bf94e698961e2c7064510a9.jpg"
      ],
      "image": "assets/images/21145/step_05.webp"
    }
  ],
