  "ingredients": [
    "2 pounds fresh asparagus, trimmed",
    "5 tablespoons butter, divided",
    "3 tablespoons all-purpose flour",
    "2 cups milk",
    "1 teaspoon salt",
    "6 slices bread, toasted"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c-0IVExjRcS-aMeOVg336yvCSm8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Creamed-Asparagus-on-Toast-DDMFS-Step-01-3012-3582acce68264dcc8dbeab50ff0b6824.jpg"
      ],
      "image": "assets/images/237537/step_01.webp"
    },
    {
      "text": "Place asparagus into a large pot or skillet and cover with water; bring to a boil. Reduce heat to medium-low and simmer until tender, 8 to 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O5PJtwRlMdzTlmxdi70yhkp0UDg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Creamed-Asparagus-on-Toast-DDMFS-Step-02-3014-19776900dc9844b78819462b3ebdff99.jpg"
      ],
      "image": "assets/images/237537/step_02.webp"
    },
    {
      "text": "Mix 3 tablespoons butter and flour together in the same pot over medium-low heat until flour is dissolved and mixture is smooth, 2 to 3 minutes. Add milk, asparagus, and salt to butter-flour mixture and simmer until thickened, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yf5TBSp3QC5i5CDcKbypwpdrOtQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Creamed-Asparagus-on-Toast-DDMFS-Step-03-3015-2f8ba363047f44758128b004bd859fc6.jpg"
      ],
      "image": "assets/images/237537/step_03.webp"
    },
    {
      "text": "Spread about 1 teaspoon butter onto each piece of toast. Pour creamed asparagus over each piece of toast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lgwGIzfjf-4lq3eWz26v-Ghutrg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/3231-Creamed-Asparagus-on-Toast-DDMFS-Step-04-3018-57da621645244bad892eb69dc251ca10.jpg"
      ],
      "image": "assets/images/237537/step_04.webp"
    }
