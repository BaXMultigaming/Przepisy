  "ingredients": [
    "1 (29 ounce) can sliced peaches, drained",
    "2 cups all-purpose flour",
    "1.5 cups white sugar",
    "1.5 teaspoons ground cinnamon",
    "1 pinch salt",
    "1 cup butter, chilled"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Layer canned peaches in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, cinnamon, and salt together in a large bowl. Mix in butter until the mixture resembles pea-sized crumbs; sprinkle over peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is light golden brown, 30 to 40 minutes.",
      "section": null,
