  "ingredients": [
    "1 clove garlic, minced",
    "1 teaspoon chili powder",
    "0.25 teaspoon cayenne pepper",
    "1 pod cardamom seeds",
    "0.5 teaspoon water, or as needed",
    "1 teaspoon vegetable oil",
    "0.25 cup rice wine vinegar",
    "0.5 cup sugar",
    "1 mango - peeled, seeded, and chopped",
    "0.25 teaspoon salt",
    "0.5 teaspoon cilantro",
    "2 teaspoons lemon juice",
    "1 fresh jalapeno pepper, minced",
    "1.5 cups unsweetened applesauce",
    "3 pineapple rings, chopped",
    "1 pinch white pepper",
    "0.33333334326744 cup soy sauce",
    "0.33333334326744 cup rice wine vinegar",
    "6 pork chops"
  ],
  "steps": [
    {
      "text": "With a mortar and pestle, mash together the garlic, chili powder, cayenne, and cardamom seeds. Mix in enough water to form a paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oil in a saucepan over medium heat. Stir in spice paste, and cook until it begins to bubble, about 30 seconds. Stir in vinegar; cook without boiling for 2 minutes. Stir in sugar until it dissolves. Mix in mango, salt, cilantro, lemon juice, and jalapeno; simmer 20 minutes. Stir in applesauce and pineapple; simmer 10 minutes more. Season with white pepper. Place in a bowl, cover, and refrigerate until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To prepare marinade, mix 2/3 cup of the salsa with soy sauce and 1/3 cup vinegar. Place pork chops in a large resealable plastic bag, and pour marinade over chops. Seal tightly, and place in the refrigerator for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare grill for medium-high heat. Drain marinade from bag, and heat in a saucepan until boiling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil grill grate. Place pork chops on the hot grill. Cook 10 minutes, or to desired doneness, turning once and basting occasionally with the boiled marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm remaining salsa over medium-low heat. Serve pork chops topped with the salsa.",
      "section": null,
      "name": null,
      "url": null,
