  "ingredients": [
    "1 cup non-fat milk powder",
    "0.5 cup self-rising flour",
    "2 tablespoons butter, softened",
    "0.5 cup milk, or as needed",
    "1 cup confectioners' sugar",
    "1 cup white sugar",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk powder and flour in a bowl. Add butter; beat together until creamy and blended. Add just enough milk to make a firm dough. Shape dough into 18 small balls and arrange on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until gulab are lightly browned, 12 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine confectioners' sugar, white sugar, and water in a saucepan over medium heat. Simmer until sugars dissolve and consistency is syrupy, 5 to 10 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer gulab to the saucepan; let soak in the warm syrup, at least 10 minutes. Let cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
