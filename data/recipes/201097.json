    },
    {
      "text": "Blend carrots in a blender until smooth. Add beets and blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4uHZWPly2aLPvMOSiA6tnc-Lv-U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/201097-no-tomato-pasta-sauce-ddmfs-step-2-a387125b5ce1474e979df25599245743.jpg"
      ],
      "image": "assets/images/201097/step_02.webp"
    },
    {
      "text": "Heat oil in a skillet over medium heat. Add onion and garlic; cook and stir until onion is translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nceqGwzSru0NtXy-P4i4xgTvZ9E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/201097-no-tomato-pasta-sauce-ddmfs-step-3-cd1bba53bd4b45b0ab9abac2f76d2670.jpg"
      ],
      "image": "assets/images/201097/step_03.webp"
    },
    {
      "text": "Stir in puréed vegetables, vinegar, Italian seasoning, and bay leaf; cover and bring to a boil. Uncover, reduce the heat to low, and simmer for at least 30 minutes, or up to 4 hours.",
