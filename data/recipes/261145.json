  "steps": [
    {
      "text": "Combine tomatoes, onions, green bell pepper, red bell pepper, yellow bell pepper, and mushrooms in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush chicken thighs with 2 teaspoons hot pepper sauce. Heat oil in a skillet over medium-high heat. Cook chicken thighs until lightly browned, 3 to 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken thighs to the slow cooker. Add 2 teaspoons hot pepper sauce and salsa. Pour in chicken broth and stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until chicken thighs are tender, about 6 hours.",
