  "ingredients": [
    "4 large tomatoes, chopped",
    "2 large onions, chopped",
    "1 green bell pepper, chopped",
    "1 red bell pepper, chopped",
    "1 yellow bell pepper, chopped",
    "8 mushrooms, chopped",
    "6 skinless chicken thighs",
    "4 teaspoons hot pepper sauce, divided, or to taste",
