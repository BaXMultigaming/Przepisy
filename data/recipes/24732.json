  "ingredients": [
    "7 slices bacon",
    "2 cloves garlic, peeled and minced",
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup half-and-half",
    "4 ounces blue cheese, crumbled",
    "2 tablespoons chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large, deep skillet over medium-high heat until evenly browned, 7 to 9 minutes. Transfer to a paper towel-lined plate to drain; leave grease in the pan. Crumble bacon when cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook garlic in bacon grease over medium heat until soft, about 1 minute. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and half-and-half in a medium bowl with an electric mixer until blended. Stir in bacon, garlic, blue cheese, and chives. Transfer mixture to a medium baking dish and cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
