  "ingredients": [
    "2 pounds halibut steak, 1 1/2-inch thickness",
    "1 cup sour cream",
    "0.5 cup chopped green onions",
    "2 tablespoons butter, softened",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground white pepper",
    "1 pinch dried dill weed",
    "0.33333334326744 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease the inside of a 9x13-inch baking dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place halibut in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sour cream, green onions, butter, salt, white pepper, and dill in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread sour cream mixture over halibut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake halibut in preheated oven until fish flakes easily with a fork, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove halibut from the oven and sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place oven rack about 6 inches from broiler heat source and turn on oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place under preheated broiler and broil until cheese is lightly browned, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
