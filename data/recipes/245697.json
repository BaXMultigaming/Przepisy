  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "0.5 cup white sugar",
    "1 tablespoon vanilla extract",
    "2 eggs",
    "0.5 cup crushed peppermint candies, divided",
    "1 (9 inch) prepared graham cracker crust"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AH8NqhzvA07PdLfdz7eFy9r_XqA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-245697-peppermint-cheesecake-step-01-e8709de7645a4b60b44b1613c2eed683.jpg"
      ],
      "image": "assets/images/245697/step_01.webp"
    },
    {
      "text": "Place cream cheese, sugar, and vanilla extract in a large bowl; beat with an electric mixer on low speed until smooth. Mix in eggs, one at a time, until well-incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ay0UiKXF7xM1iyTQ5e0mdtnmrDc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-245697-peppermint-cheesecake-step-02-fc6592854a34498e96b741160d7a1e8a.jpg"
      ],
      "image": "assets/images/245697/step_02.webp"
    },
    {
      "text": "Fold crushed peppermint candies into filling with a spoon, reserving 2 tablespoons for decorating the top. Pour filling onto prepared crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ww709N2712ncOGYXfRAi-xyVLZ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-245697-peppermint-cheesecake-step-03-476804b0082c4364968c43eacd4b55c0.jpg"
      ],
      "image": "assets/images/245697/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until cheesecake is set, about 40 minutes. Allow to cool at room temperature, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Gf2WRi5ZqDfgrh2a_0Fv-nBlttw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-245697-peppermint-cheesecake-step-04-314d9ba763404d2685b83db3d3d7cdfb.jpg"
      ],
      "image": "assets/images/245697/step_04.webp"
    },
    {
      "text": "Refrigerate cheesecake until completely chilled, 4 hours to overnight. Sprinkle reserved peppermint candies on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tm_Uh8laMZZdRFgIpA01gJRCsE4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-245697-peppermint-cheesecake-step-05-5c6610c7491e4ed2bd1917b51de66194.jpg"
      ],
      "image": "assets/images/245697/step_05.webp"
    }
  ],
