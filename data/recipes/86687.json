  "ingredients": [
    "1.5 pounds fresh broccoli, cut into bite size pieces",
    "0.33333334326744 cup butter",
    "1 tablespoon brown sugar",
    "3 tablespoons soy sauce",
    "2 teaspoons white vinegar",
    "0.25 teaspoon ground black pepper",
    "2 cloves garlic, minced",
    "0.33333334326744 cup chopped salted cashews"
  ],
  "steps": [
    {
      "text": "Place the broccoli into a large pot with about 1 inch of water in the bottom. Bring to a boil, and cook for 7 minutes, or until tender but still crisp. Drain, and arrange broccoli on a serving platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Sw3Yf3OecJgtSdOJN-GxE4jUd3w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86687-broccoli-with-garlic-butter-and-cashews-VAT-step-01-23dba249588247fcbdb5cad9dd0ecbd8.jpg"
      ],
      "image": "assets/images/86687/step_01.webp"
    },
    {
      "text": "While the broccoli is cooking, melt the butter in a small skillet over medium heat. Mix in the brown sugar, soy sauce, vinegar, pepper and garlic. Bring to a boil, then remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F1NCxouh6L0FS6y3ykil9qVTMw8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/86687-broccoli-with-garlic-butter-and-cashews-VAT-step-02-1b380eee2cb64173ba3f48c5f07be04a.jpg"
      ],
      "image": "assets/images/86687/step_02.webp"
    },
    {
      "text": "Mix in the cashews, and pour the sauce over the broccoli. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
