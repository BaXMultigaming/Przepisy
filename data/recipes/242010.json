  "ingredients": [
    "0.5 head green cabbage, cored and shredded",
    "0.5 head red cabbage, cored and shredded",
    "1 pound carrots, peeled and shredded",
    "1 bunch cilantro, roughly chopped",
    "0.33333334326744 cup lime juice",
    "0.66666668653488 cup peanut oil",
    "2 teaspoons sugar",
    "kosher salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Toss green cabbage, red cabbage, carrots, and cilantro together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat peanut oil and lime juice together with a whisk until smooth; add sugar and beat to dissolve. Drizzle dressing over the slaw and toss to coat; season with kosher salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl with plastic wrap and refrigerate at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
