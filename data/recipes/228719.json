  "ingredients": [
    "0.5 teaspoon olive oil",
    "3 cups pecans",
    "20 pitted dates",
    "0.25 cup agave nectar",
    "6 ripe persimmons",
    "2 tablespoons chopped pecans",
    "1 teaspoon ground cinnamon, for garnish"
  ],
  "steps": [
    {
      "text": "Lightly grease an 8-inch pie pan with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend 3 cups pecans and dates in a food processor until finely ground, about 1 minute. Pour agave nectar over nut mixture and process until fully incorporated, about 30 seconds. Press nut mixture evenly into prepared pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel and pit persimmons, then puree in food processor until smooth. Pour over crust and smooth out. Garnish with chopped pecans and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
