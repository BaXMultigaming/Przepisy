  "ingredients": [
    "3 eggs",
    "2 egg whites",
    "1 cup almond milk",
    "3 teaspoons vanilla extract",
    "3 teaspoons coconut sugar",
    "0.5 teaspoon unflavored gelatin",
    "1 teaspoon baking powder",
    "0.33333331346512 cup coconut flour",
    "0.25 cup tapioca flour",
    "0.5 cup almond flour",
    "1 pinch salt",
    "1 teaspoon arrowroot flour, or as needed"
  ],
  "steps": [
    {
      "text": "Combine eggs, egg whites, almond milk, vanilla extract, coconut sugar, and gelatin in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine coconut flour, tapioca flour, almond flour, and salt in a separate bowl. Fold into the egg mixture and mix to just combine. Add arrowroot flour to thicken batter, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle over medium-high heat. Drop batter by large spoonfuls onto the griddle and cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
