  "ingredients": [
    "1 cup milk",
    "1 cup quick cooking oats",
    "1 egg",
    "0.25 cup vegetable oil",
    "1 cup all-purpose flour",
    "0.25 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C). Grease 12 standard muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gwv1K2Law7SNM6sDxaHdo6570yo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22458-easy-oatmeal-muffins-DDMFS-step-1-1403681141eb42dea162500cda2c25a8.jpg"
      ],
      "image": "assets/images/22458/step_01.webp"
    },
    {
      "text": "Combine milk and oats in a small bowl; let soak for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n9QMuEx5VWO4MXtHCseCQTw4gAc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22458-easy-oatmeal-muffins-DDMFS-step-2-c1a3c95792364120aaf607f3796bcae2.jpg"
      ],
      "image": "assets/images/22458/step_02.webp"
    },
    {
      "text": "Beat together egg and oil in a large bowl; stir in oat mixture. Sift together flour, sugar, baking powder, and salt in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B-7B4adYcJZc7cp0hlELLTMkPDw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22458-easy-oatmeal-muffins-DDMFS-step-3-0785c5368bb944ac8d2af281398352bf.jpg"
      ],
      "image": "assets/images/22458/step_03.webp"
    },
    {
      "text": "Stir flour mixture into wet ingredients until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1HAqdbVCIlncoqtG5vMqw49XESs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22458-easy-oatmeal-muffins-DDMFS-step-5-87d1dbba79cc40a5b52cb8c93e0cb0e4.jpg"
      ],
      "image": "assets/images/22458/step_04.webp"
    },
    {
      "text": "Spoon batter into the prepared muffin cups until 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ule4cBIsL0ESVJsqUKCMySGPHO0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22458-easy-oatmeal-muffins-DDMFS-step-6-1c9a0eb3477b4c38a01794b735f652d6.jpg"
      ],
      "image": "assets/images/22458/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gMbdgzORNib85nk1W34Qpi-akWE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22458-easy-oatmeal-muffins-DDMFS-step-7-083069deb2fc49a6b9f4a2c020a1358b.jpg"
