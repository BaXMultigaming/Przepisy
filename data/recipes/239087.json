  "ingredients": [
    "1 teaspoon vegetable oil",
    "1 small onion, chopped",
    "1 medium carrot, diced",
    "0.5 cup chopped broccoli florets",
    "0.25 cup diced red bell pepper",
    "1 clove garlic, minced",
    "3 cups vegetable broth",
    "1.5 cups rice",
    "1 (1.41 ounce) package sazon seasoning with coriander and achiote (such as Goya®)",
    "1 pinch adobo seasoning with pepper (such as Goya®)"
  ],
  "steps": [
    {
      "text": "Heat oil in a saucepan over medium heat. Add onion, carrot, broccoli, bell pepper, and garlic; cook and stir until vegetables soften and garlic just begins to brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in broth, rice, sazón seasoning, and adobo seasoning; bring to a boil. Reduce the heat to low and cook until liquid is absorbed and rice is tender, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fluff rice with a fork to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
