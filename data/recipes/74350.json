  "ingredients": [
    "0.75 pound fresh green beans, trimmed",
    "2 tablespoons soy sauce",
    "1 clove garlic, minced",
    "1 teaspoon garlic chili sauce",
    "1 teaspoon honey",
    "2 teaspoons canola oil"
