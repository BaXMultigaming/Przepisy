  "ingredients": [
    "1.5 cups unsalted butter, softened",
    "0.25 cup white sugar",
    "3.5 cups all-purpose flour",
    "1 medium lemon, zested",
    "0.5 cup lemon curd"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar together in a bowl until thoroughly creamed. Gradually mix in flour, 1 cup at a time. Add lemon zest and mix until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jyP-AqUR-iIzwDWr5s-2vHSmlbA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282592-lemon-thumbprint-cookies-ddmfs-Step3-1512-3d579e72b61747d3914f479276dcba3b.jpg"
      ],
      "image": "assets/images/282592/step_02.webp"
    },
    {
      "text": "Roll dough into 1-inch balls and place on an ungreased cookie sheet. Make an indent in the center of each using your thumb. Put a small spoonful of lemon curd into each indent.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Pyz5L6zd23xMVzEVYfZP23I43Xg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282592-lemon-thumbprint-cookies-ddmfs-Step6-1516-be61b727f2784a4dac922548de3b814d.jpg"
      ],
      "image": "assets/images/282592/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 15 to 20 minutes. Cool on the cookie sheet for 1 minute before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IDMkXWBee63OaFjId0gY-rYn_sc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/282592-lemon-thumbprint-cookies-ddmfs-Step7-1525-ce190d611c9b47819a5e97c6de952a08.jpg"
      ],
      "image": "assets/images/282592/step_04.webp"
    }
  ],
