  "ingredients": [
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "2 teaspoons white sugar",
    "0.5 teaspoon cream of tartar",
    "0.33333334326744 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "0.5 cup chilled unsalted butter, cut into cubes",
    "1 cup shredded mild Cheddar cheese",
    "1 teaspoon dried Italian seasoning",
    "1 cup cold whole milk",
    "2 tablespoons salted butter, melted",
    "0.5 teaspoon dried parsley flakes",
    "0.5 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, white sugar, cream of tartar, 1/3 teaspoon garlic powder, and salt together in a large bowl. Mash unsalted butter cubes into the flour mixture with a pastry cutter or large fork until coarsely blended. Mix Cheddar cheese and Italian seasoning into the flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk over the flour mixture while stirring until you get a tough and sticky dough. Drop dough by the tablespoon onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until lightly browned, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir melted salted butter, parsley flakes, and 1/2 teaspoon garlic powder together in a bowl; brush over biscuits immediately upon removing from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
