  "ingredients": [
    "1 pound sweet potatoes, peeled and cut into 3/4-inch cubes",
    "3 tablespoons olive oil, divided",
    "0.5 teaspoon ground cumin, or more to taste",
    "0.25 teaspoon red pepper flakes",
    "coarse salt and ground black pepper to taste",
    "2 tablespoons freshly squeezed lime juice",
    "1 (14.5 ounce) can black beans, rinsed and drained",
    "0.5 red onion, finely chopped",
    "0.5 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle sweet potatoes with 1 tablespoon olive oil on a rimmed baking sheet; season with cumin, pepper flakes, salt, and black pepper. Toss until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven on the lower rack, stirring halfway through, until sweet potatoes tender, 25 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk remaining 2 tablespoons olive oil and lime juice together in a large bowl; season with salt and black pepper. Add sweet potatoes, black beans, onion, and cilantro; gently toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
