  "ingredients": [
    "1 (12 ounce) package pork sausage, halved and cut into 4-inch pieces",
    "2 tablespoons vegetable oil butter spread",
    "1 (32 ounce) jar sauerkraut, drained",
    "1 teaspoon dried celery flakes",
    "1 tablespoon dried minced onion",
    "1 teaspoon caraway seeds",
    "2 tablespoons brown sugar",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J89r3BVbsJspOqkciXYtiVDQakY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214842-sausage-n-kraut-VAT-step-01-fe02cb5bc7b540e48db97ba159dcaab7.jpg"
      ],
      "image": "assets/images/214842/step_01.webp"
    },
    {
      "text": "Grill sausages on the preheated grill until browned, about 3 minutes on each side. Cut cooked sausage into 1/2-inch slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T5HI0B9kQaGwdjKAjp-kTKZwAio=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214842-sausage-n-kraut-VAT-step-02-faaadae9834a4d1a8d69462f0a1a4bc3.jpg"
      ],
      "image": "assets/images/214842/step_02.webp"
    },
    {
      "text": "While the sausage is cooking, melt butter spread in a large skillet over medium-high heat. Stir in sauerkraut, celery flakes, onion, caraway seeds, brown sugar, and pepper. Cook and stir until sauerkraut begins to brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/geDzG2_07UxcL4-4rwTqNwhSnnM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214842-sausage-n-kraut-VAT-step-03-88ea3ae9b7134d2da6f2bd7ff08085c4.jpg"
      ],
      "image": "assets/images/214842/step_03.webp"
    },
    {
      "text": "Stir in sausage slices. Serve hot.",
