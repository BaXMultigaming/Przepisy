  "ingredients": [
    "4 cups peeled and sliced potatoes",
    "2 cups diced ham",
    "0.5 onion, chopped",
    "2 cups milk",
    "1 cup frozen peas",
    "3 tablespoons all-purpose flour",
    "2 tablespoons butter",
    "1 teaspoon dried parsley",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.125 teaspoon garlic powder",
    "0.125 teaspoon onion powder",
    "0.25 pound Cheddar cheese, diced",
    "1 pinch paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EkgeTLdWgtIxBgTHQG8MpTIFGac=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221004-cheesy-scalloped-potatoes-with-ham-ddmfs-step-1-166-f5693173e5514e04b94cc91db3463219.jpg"
      ],
      "image": "assets/images/221004/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer 1/2 of the potatoes, 1/2 of the ham, and 1/2 of the onions in a 2-quart baking dish; repeat layers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aPNZT6OAXRRSqYF-8YczJ4GFVxA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221004-cheesy-scalloped-potatoes-with-ham-ddmfs-step-2-169-66f6a596fa5946f1adc7a85c3ee33dd2.jpg"
      ],
      "image": "assets/images/221004/step_03.webp"
    },
    {
      "text": "Cook milk, peas, flour, butter, parsley, salt, black pepper, garlic powder, and onion powder in a saucepan over medium heat, stirring constantly, until thickened, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CY6m7YzdddbpwaG6vg_HP4It1og=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221004-cheesy-scalloped-potatoes-with-ham-ddmfs-step-3-172-5567146357994296b06fda0438d0055c.jpg"
      ],
      "image": "assets/images/221004/step_04.webp"
    },
    {
      "text": "Stir Cheddar cheese into sauce until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eJUM8Em9kOE7-e8e985Av18XhAw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221004-cheesy-scalloped-potatoes-with-ham-ddmfs-step-4-173-0ce9262179bc4ccf9beb28b7d976705c.jpg"
      ],
      "image": "assets/images/221004/step_05.webp"
    },
    {
      "text": "Pour sauce over potato and ham mixture; sprinkle with paprika. Cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oKQScKqBIcozqb2vPl3J8lBTsg0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221004-cheesy-scalloped-potatoes-with-ham-ddmfs-step-8-181-f9e4e693e0e848b589d44ee33340d21a.jpg"
      ],
      "image": "assets/images/221004/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until potatoes are tender, about 1 hour. Remove foil and continue baking until lightly browned, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KNVwPY_k_osoL9RzgYyHk5I-_YQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221004-cheesy-scalloped-potatoes-with-ham-ddmfs-step-10-187-c7d771b300144ed1b3e1473fe2bd2eac.jpg"
