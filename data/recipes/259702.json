  "title": "Pumpkin Pie Triple Berry Tarties",
  "description": "Leftover pumpkin puree and whipped topping are baked into mini tarts topped with berries and cinnamon in this cute mini dessert recipe.",
  "authors": [
    "Kaelyn McGinty"
  ],
