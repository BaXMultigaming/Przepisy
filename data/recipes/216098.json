  "ingredients": [
    "2 pounds dried pinto beans",
    "8 cups water, or more if needed",
    "1 small onion, chopped",
    "2 teaspoons garlic powder",
    "2 bay leaves",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon onion powder",
    "1 smoked turkey leg",
    "0.33333334326744 cup olive oil"
  ],
  "steps": [
    {
      "text": "Wash and pick over beans; place in a large bowl. Fill with cold water; soak beans 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain and rinse beans; place in a slow cooker. Add 8 cups water to the slow cooker; stir in onion, garlic powder, bay leaves, black pepper, and onion powder. Place turkey leg in the slow cooker; cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low setting for 6 hours. Stir in olive oil, add more water if beans are beginning to dry out; cook until beans are very tender, 2 hours more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
