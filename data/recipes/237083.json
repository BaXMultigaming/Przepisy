  "ingredients": [
    "2 large sweet potatoes, peeled, cut into 1x3-inch wedges",
    "3 tablespoons soybean oil (often labeled \"vegetable oil\")",
    "0.5 teaspoon sea salt",
    "0.5 teaspoon freshly ground black pepper",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/baJeha_7KqYshUJRWZJvNZT36Fo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237083-oven-baked-sweet-potato-fries-ddmfs-step1-0049-89cca085f7874ea2817d8f6bbe185523.jpg"
      ],
      "image": "assets/images/237083/step_01.webp"
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C) with the rack positioned in the upper third of the oven. Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel sweet potatoes; cut into 1x3-inch wedges. Place wedges and soybean oil in a large bowl; toss lightly. Sprinkle with salt, pepper, garlic powder, and paprika; toss.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange potatoes in a single layer on the prepared baking sheet, being sure not to overcrowd.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, turning occasionally, until tender and golden brown, 18 to 24 minutes. Cool 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WeSpundWvWZ6yomDRyt_mWP1p1A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237083-oven-baked-sweet-potato-fries-ddmfs-step3-0051-253e75cdf62342419794b15d5972d6dd.jpg"
