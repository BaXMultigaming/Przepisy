  "ingredients": [
    "1 (12 ounce) package elbow macaroni (such as Wacky Mac®)",
    "1 pound bacon",
    "1.5 cups chilled mayonnaise (such as Hellman's®)",
    "1.5 cups chilled coleslaw dressing (such as Kraft®)",
    "3 tomatoes, diced",
    "2 cups chopped romaine lettuce",
    "1 bunch green onions, chopped"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain; cool, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels; crumble. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise and coleslaw dressing in a large bowl until creamy; stir in macaroni, bacon, tomatoes, lettuce, and green onions until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
