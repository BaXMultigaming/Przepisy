  "ingredients": [
    "1 (10 ounce) can jumbo, butter-flavored biscuits",
    "0.33333334326744 cup olive oil",
    "2 teaspoons dried rosemary, or more to taste",
    "3 teaspoons granulated garlic",
    "0.5 teaspoon chili powder",
    "0.5 teaspoon salt",
    "1 dash dried basil",
    "1 dash dried oregano",
    "1 dash ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape biscuit dough into 12 balls. Roll each ball into a 4- to 6-inch long strip.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil, rosemary, garlic, chili powder, salt, basil, oregano, and pepper in a bowl. Dip dough strips one-by-one into the oil mixture and roll until totally covered. Tie each strip into a knot, stretching as needed. Place knots on an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 15 minutes.",
