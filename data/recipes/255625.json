  "ingredients": [
    "12 slices white sandwich bread, or as needed, cubed",
    "cooking spray",
    "1 (15 ounce) can pumpkin puree",
    "4 eggs",
    "0.5 cup milk",
    "0.5 cup unsalted butter, melted and cooled",
    "0.5 cup white sugar",
    "0.5 cup light brown sugar",
    "2 tablespoons maple syrup",
    "1 teaspoon pumpkin pie spice",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "0.75 cup all-purpose flour",
    "0.75 cup light brown sugar",
    "0.5 cup unsalted butter, at room temperature",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Place bread cubes in a bowl. Cover and let stand until stale, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 7x11-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk pumpkin puree, eggs, milk, 1/2 cup melted butter, white sugar, 1/2 cup brown sugar, maple syrup, pumpkin pie spice, vanilla extract, and salt together in a large bowl. Add bread cubes a few at a time, folding until mixture is moist but not soupy. Pour into the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 3/4 cup brown sugar, 1/2 cup butter, and cinnamon in a bowl; crumble together with your fingers. Stir in walnuts; sprinkle over the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center is set and crumb topping is golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
