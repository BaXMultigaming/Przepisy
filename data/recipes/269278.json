  "ingredients": [
    "3 tablespoons coarse grain Dijon mustard",
    "3 tablespoons maple syrup",
    "salt and freshly ground black pepper to taste",
    "4 (6 ounce) fillets salmon fillets",
    "0.25 cup finely chopped pistachio nuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together mustard, maple syrup, salt, and pepper in a small bowl until well combined. Place salmon fillets skin-side down onto the prepared baking sheet and spread mustard mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for about 10 minutes. Sprinkle pistachios on top of salmon. Continue baking until salmon flakes easily with a fork, about 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
