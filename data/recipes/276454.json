  "ingredients": [
    "1 cup water",
    "0.5 cup uncooked white rice",
    "1 tablespoon butter",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon poultry seasoning",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 pound ground turkey"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and rice to a boil in a saucepan. Add butter, salt, pepper, poultry seasoning, garlic powder, and onion powder. Reduce heat to medium-low, cover, and simmer until rice is tender and water has been absorbed, 20 to 25 minutes. Let cool until easily handled, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add ground turkey to cooled rice in a medium bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll the mixture into golf ball-sized meatballs and place on an ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the centers, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
