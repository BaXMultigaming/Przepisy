  "ingredients": [
    "6 medium potatoes, peeled and quartered",
    "2 tablespoons olive oil",
    "1.5 teaspoons chopped fresh chives",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon garlic powder",
    "salt and pepper to taste",
    "1 (4 pound) boneless pork loin roast",
    "1 teaspoon onion powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a pot and cover with water; boil potatoes for about 10 minutes. Drain, cool, and place in a bowl. Toss with olive oil, chives, 1/2 teaspoon thyme, 1/2 teaspoon garlic powder, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub pork roast with remaining 1 teaspoon thyme, remaining 1 teaspoon garlic powder, and onion powder; sprinkle with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place roast on a rack in a shallow roasting pan; cook in the preheated oven for 50 minutes. Arrange potatoes around roast; continue cooking until an instant-read thermometer inserted into center of roast reads 145 degrees F (63 degrees C), about 50 minutes more. Remove from oven, cover with foil, and let sit 15 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
