  "ingredients": [
    "cooking spray",
    "2 cups white sugar",
    "0.5 cup milk",
    "0.25 cup margarine",
    "3 tablespoons cocoa powder",
    "2 cups quick-cooking oats",
    "0.5 cup peanut butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with aluminum foil and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, milk, margarine, and cocoa powder in a saucepan; bring to a boil, stirring often, for 1 minute. Remove from heat and stir in oats, peanut butter, and vanilla extract. Drop about 1 tablespoon of mixture per cookie onto the prepared baking sheet. Let stand until cookies are cooled and firm, about 30 minutes.",
