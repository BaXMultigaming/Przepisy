  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup butter, softened",
    "1 tablespoon minced garlic",
    "2 loaves French bread, sliced",
    "1 pound sliced sausage of your choice",
    "1 cucumber, sliced",
    "3 medium tomatoes, sliced",
    "1 hard-cooked egg, chopped"
  ],
  "steps": [
    {
      "text": "Stir together cream cheese, butter, and garlic in a small bowl until well combined. Spread onto each bread slice. Top each with a sausage slice, cucumber slice, and tomato slice, then sprinkle chopped egg over each one. Serve open-faced.",
