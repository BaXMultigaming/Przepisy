  "ingredients": [
    "cooking spray",
    "1 (9 inch) prepared pie dough, thawed if frozen",
    "0.25 cup butter at room temperature",
    "1 cup brown sugar",
    "2 eggs",
    "1 (15 ounce) can pumpkin puree",
    "1.25 cups all-purpose flour",
    "1 tablespoon pumpkin pie spice",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 (11 ounce) package butterscotch chips",
    "0.5 (2.25 ounce) package chopped pecans",
    "2 tablespoons confectioners' sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Prepare a 9x13-inch pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mold the pie crust to fit the pan. It may be thin in some spots; that's ok, just try to get it as even as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and brown sugar together with an electric mixer in a large bowl until smooth. Beat 1 egg into the butter until completely blended; repeat with the second egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, pumpkin pie spice, baking soda, and salt together in a separate bowl. Add to pumpkin mixture and beat to combine. Fold butterscotch chips and pecans into the mixture; pour into the pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a knife inserted in the center comes out clean, 25 to 35 minutes. Dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
