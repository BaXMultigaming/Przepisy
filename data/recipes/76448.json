  "ingredients": [
    "5 cups buttermilk",
    "1.5 cups milk",
    "5 eggs",
    "6 tablespoons butter, melted",
    "5 cups all-purpose flour",
    "5 tablespoons sugar",
    "5 teaspoons baking powder",
    "5 teaspoons baking soda",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Whisk buttermilk, milk, eggs, and butter together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, baking soda, and salt in a bowl; stir into buttermilk mixture until just blended. Adjust batter thickness to your liking by adding more flour or buttermilk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat; coat with cooking spray. Drop batter by ¼ cupfuls onto the skillet; cook until bubbles appear on the surface. Flip and cook until browned on the other side. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
