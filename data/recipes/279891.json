  "ingredients": [
    "0.25 preserved lemon",
    "2 fluid ounces gin",
    "2 cups ice cubes, or as needed",
    "4 fluid ounces tonic water (such as Fever Tree)",
    "1 small sprig fresh rosemary"
  ],
  "steps": [
    {
      "text": "Remove pulp from lemon with a sharp knife and discard, saving peel. Lightly rinse peel with cool water. Slice off a thin sliver of peel and set aside for garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine lemon peel and gin in a shaker. Muddle lemon until slightly crushed. Add 1 cup ice to the shaker, cover, and shake until chilled, 15 to 20 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a rocks glass with ice and strain cocktail over the ice. Top with tonic water. Garnish with lemon sliver and rosemary sprig.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
