  "title": "Homemade Corn Tortillas",
  "description": "These corn tortillas are made with an easy dough of masa harina and water, rolled flat and cooked in a hot skillet until soft and foldable for tacos.",
  "authors": [
    "jenn"
  ],
  "date_published": "2000-04-17T21:49:07-04:00",
