  "ingredients": [
    "8 cups self-rising flour",
    "4 cups ground All-Bran® cereal",
    "1.25 cups white sugar",
    "1.75 cups brown sugar",
    "1 teaspoon baking powder",
    "0.75 teaspoon salt",
    "4.5 sticks unsalted butter",
    "4 cups heavy cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line a high-rimmed baking sheet with parchment paper, letting the paper overhang the sides for easy removal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, ground All-Bran®, white sugar, brown sugar, baking powder, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over low heat. Remove from the heat and mix in cream. Add flour mixture and mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread out batter into the prepared baking sheet and use a knife to cut into slices; this will make removing the rusks easier once baked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 50 minutes. Reduce heat to 160 degrees F (70 degrees C) and leave rusks in the low temperature oven for 4 hours to dry. Remove from oven and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut into 80 slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
