  "ingredients": [
    "0.5 pound pork liver",
    "0.5 pound ground pork",
    "1.5 teaspoons salt",
    "1 pinch ground black pepper",
    "1 dash ground allspice",
    "1 onion, chopped",
    "1 tablespoon butter",
    "1 tablespoon all-purpose flour",
    "1 cup milk",
    "1 egg",
    "2 bay leaves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put liver, ground pork, salt, pepper, allspice, and onion in a food processor or meat grinder and let it run until mixture is still slightly coarse.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make sauce: Melt butter over low heat. Stir in flour until smooth. Add milk, stirring until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sauce, egg, and meat mixture and stir. Put in a mold with bay leaves on top of mold and bake 1 to 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
