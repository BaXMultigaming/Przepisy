  "ingredients": [
    "8 cups popped popcorn, or more to taste",
    "1 cup brown sugar",
    "0.5 cup butter",
    "0.25 cup corn syrup",
    "0.25 teaspoon salt",
    "1 tablespoon ground cinnamon",
    "1 tablespoon vanilla extract",
    "0.5 teaspoon baking powder",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place popcorn in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, butter, corn syrup, and salt together in a saucepan; bring to a boil, stirring occasionally. Remove from heat and cool while stirring constantly for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cinnamon, vanilla extract, and baking powder into butter mixture. Pour butter mixture over popcorn and toss to coat. Mix walnuts into popcorn mixture. Spread popcorn in a single layer onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake popcorn in the preheated oven until coating is set, 10 to 12 minutes. Cool slightly before breaking apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
