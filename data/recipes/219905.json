  "ingredients": [
    "1 fluid ounce light rum",
    "1 fluid ounce amber rum",
    "3 fluid ounces pineapple juice",
    "2 fluid ounces sweet and sour mix",
    "2 fluid ounces cream of coconut (such as Coco Lopez®)",
    "1 fluid ounce half-and-half cream",
    "ice cubes, as needed",
    "0.25 fluid ounce dark rum"
  ],
  "steps": [
    {
      "text": "Pour light rum, amber rum, pineapple juice, sweet and sour mix, cream of coconut, and half-and-half cream into the pitcher of a blender with ice; blend until cocktail has a slushy texture. Pour slushy mixture into a glass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly and gently drizzle dark rum over the drink, so it just floats on top; serve.",
