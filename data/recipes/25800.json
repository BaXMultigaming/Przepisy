  "title": "Basic Gingersnap Cookies",
  "description": "Spicy crispy gingerbread cookies made with black pepper. Cut into shapes for the winter holidays.",
  "authors": [
    "Karen"
  ],
  "date_published": "2020-03-04T23:56:42-05:00",
