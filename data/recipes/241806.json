  "title": "Spicy Baked Tofu",
  "description": "A spicy tofu marinade featuring soy sauce, hoisin sauce, chili sauce, and fresh ginger adds tons of flavor to baked tofu.",
  "authors": [
    "Kiara Sexton"
  ],
  "date_published": "2015-03-21T02:06:50-04:00",
