  "ingredients": [
    "4 cups fresh cranberries",
    "1 cup white sugar",
    "0.5 cup brown sugar",
    "1 cup water",
    "2 teaspoons ground cinnamon",
    "1.5 teaspoons ground ginger",
    "1.5 teaspoons ground cloves",
    "0.25 teaspoon ground allspice",
    "1 tart apple, peeled and diced"
  ],
  "steps": [
    {
      "text": "Bring cranberries, white sugar, brown sugar, water, cinnamon, ginger, cloves, and allspice to a boil over medium-high heat in a large saucepan; cook and stir for 20 minutes. Stir in apple; cook and stir until apple is tender and sauce is thick, about 5 minutes. Refrigerate until cold.",
