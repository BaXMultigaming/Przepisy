  "ingredients": [
    "1 (15 ounce) can garbanzo beans, drained and rinsed",
    "0.5 pound sweet potatoes, diced",
    "0.5 pound butternut squash, diced",
    "1 (8 ounce) package sliced fresh mushrooms",
    "1 medium zucchini, sliced",
    "1 medium yellow squash, sliced",
    "0.5 white onion, sliced",
    "0.5 cup diced carrot",
    "2 tablespoons olive oil",
    "1 tablespoon minced garlic",
    "2 tablespoons honey",
    "2 tablespoons dried oregano",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large baking pan with foil. Oil lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine garbanzo beans, sweet potatoes, butternut squash, mushrooms, zucchini, yellow squash, onion, and carrot in a large bowl; mix well. Add olive oil and garlic and continue to mix. Add honey, oregano, and pepper. Continue to mix until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring occasionally, until tender, 30 to 35 minutes. Let cool for 3 to 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
