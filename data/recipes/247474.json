    "1 cup white sugar",
    "1 cup fresh basil leaves"
  ],
  "steps": [
    {
      "text": "Combine water, sugar, and basil leaves in a small saucepan. Bring to a boil, stirring until sugar dissolves. Reduce heat and simmer for 1 minute. Remove from heat and let syrup steep for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain syrup through a mesh strainer into a sterilized glass jar; discard basil leaves. Let cool, then cover and store in the refrigerator for up to 1 month.",
