  "ingredients": [
    "1 cup creamy peanut butter",
    "0.5 cup butter, softened",
    "2 cups confectioners' sugar",
    "3 tablespoons milk, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ayNUyWpw5-_DUsuspE0IqYOlNco=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/84429-fluffy-peanut-butter-frosting-ddmfs-step1-1808-0b095a04fd5f477ca493198cbdb8b838.jpg"
      ],
      "image": "assets/images/84429/step_01.webp"
    },
    {
      "text": "Beat peanut butter and butter in a medium bowl until creamy and combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AKWdSWCd96_XkFT7WQ3BrupMeXU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/84429-fluffy-peanut-butter-frosting-ddmfs-step2-1812-41dd75f03f45432f842854185fd356ff.jpg"
      ],
      "image": "assets/images/84429/step_02.webp"
    },
    {
      "text": "Gradually blend in sugar; when the mixture thickens, begin incorporating milk, 1 tablespoon at a time, until frosting is thick and spreadable.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D7ru22aX0a5d_LrxyzHTkXFXM48=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/84429-fluffy-peanut-butter-frosting-ddmfs-step3-1813-42cdae9ae6064f6ba8023a87b9cd6004.jpg"
      ],
      "image": "assets/images/84429/step_03.webp"
    },
    {
      "text": "Beat on high speed until light and fluffy, about 3 minutes. Scrape down the sides of the bowl with a spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5zpD8YVwL2RtBrkIbclB756ogAc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/84429-fluffy-peanut-butter-frosting-ddmfs-step4-1815-09ae850465dd4f758df280bd182db15f.jpg"
      ],
      "image": "assets/images/84429/step_04.webp"
    },
    {
      "text": "Use it to frost a peanut butter cake, pipe it onto chocolate cupcakes, or spread it on cookies or brownies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FYmzW3u5iv18xQtkigUQYCFeT7I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/84429-fluffy-peanut-butter-frosting-ddmfs-3X4-1827-81b9451d81244ec19be6c889ffaf16e0.jpg"
