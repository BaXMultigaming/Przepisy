  "ingredients": [
    "1 pound Brussels sprouts, trimmed and halved",
    "1 medium onion, thickly sliced",
    "3 tablespoons olive oil",
    "3 tablespoons butter",
    "2 teaspoons chopped garlic",
    "3 cups chicken stock",
    "1 cup milk",
    "0.5 cup heavy cream",
    "4 ounces Cheddar cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Brussels sprouts, onion, olive oil, butter, and garlic in a large heatproof soup pot that fits into the oven. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast sprouts mixture in the preheated oven for 20 minutes; stir. Continue roasting, stirring every 20 minutes, until soft and browned, about 1 hour total.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return pot to the stove over medium heat. Add stock and bring to a simmer. Add milk, heavy cream, and Cheddar cheese and heat through, 5 to 10 minutes more. Use a stick blender to puree to the desired consistency. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
