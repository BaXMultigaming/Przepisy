  "ingredients": [
    "12 small red potatoes, quartered",
    "salt and ground black pepper to taste",
    "1 pinch garlic powder, or to taste",
    "1 pinch dried oregano, or to taste",
    "0.5 cup light butter-flavored spread (such as I Can't Believe It's Not Butter ® Light)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease 4 aluminum foil sheets with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_GKnVul41AD-lMDTQ9jysfRmaq4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213657-simple-pouch-potatoes-VAT-step-01-aaa1e4059b13405bb6bd07bc746b07e5.jpg"
      ],
      "image": "assets/images/213657/step_01.webp"
    },
    {
      "text": "Divide potatoes evenly among the prepared aluminum foil sheets; season with salt, pepper, garlic powder, and oregano. Place 2 tablespoons butter-flavored spread over each set of potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ALmalJi8NFa_Oe3SJDucCCofeOY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213657-simple-pouch-potatoes-VAT-step-02-ed32050f0c1741a985d30835840853a1.jpg"
      ],
      "image": "assets/images/213657/step_02.webp"
    },
    {
      "text": "Create packets by folding and sealing the aluminum foil. Place the 4 foil packets on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CYrWIapmpuapefFbdK0ZQK4cE1I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213657-simple-pouch-potatoes-VAT-step-03-0369ce0713324b19902717c3f992a573.jpg"
      ],
      "image": "assets/images/213657/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until potatoes are tender and easily pierced with a fork, 55 minutes to 1 hour. Drain melted butter-flavored spread before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0jhwE9eMDRqb1nT6ap9-GBLiJhk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213657-simple-pouch-potatoes-VAT-step-04-9197ecbcfb0348ea961ec139da7bdbf9.jpg"
      ],
      "image": "assets/images/213657/step_04.webp"
    }
