  "ingredients": [
    "3 medium Yukon Gold potatoes, unpeeled",
    "0.25 medium red onion, thinly sliced",
    "3 tablespoons sliced pitted Kalamata olives",
    "3 tablespoons red wine vinegar",
    "2 tablespoons chopped fresh parsley",
    "1.5 tablespoons olive oil",
    "1 teaspoon chopped fresh thyme leaves",
    "0.5 teaspoon salt",
    "0.25 teaspoon pepper",
    "0.25 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Slice potatoes 1/4 inch thick and place in a large saucepan. Add salted water to cover by about 1 inch. Bring to a boil over medium-high heat. Reduce heat to medium and simmer potatoes until tender, 6 to 8 minutes; do not overcook. Drain and transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add red onion, and Kalamata olives to the warm potatoes; toss gently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk vinegar, parsley, olive oil, thyme, salt, pepper, and sugar together in a small bowl. Pour dressing over potato mixture, tossing gently. Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
