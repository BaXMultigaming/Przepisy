  "ingredients": [
    "2.25 cups cake flour",
    "1.5 cups white sugar",
    "1 tablespoon baking powder",
    "1 teaspoon salt",
    "5 egg yolks",
    "0.5 cup vegetable oil",
    "0.75 cup orange juice",
    "1 tablespoon orange zest",
    "1 teaspoon vanilla extract",
    "1 cup egg whites",
    "0.5 teaspoon cream of tartar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Wash angel food tube pan in hot soapy water to ensure it is totally grease free.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, baking powder, and salt together into bowl. Make a well in center. Put egg yolks, cooking oil, orange juice, orange rind, and vanilla into well. Set aside. Don't beat yet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat egg whites and cream of tartar in mixing bowl until very stiff. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using same beaters, beat egg yolk-flour mixture until smooth. Gently fold 1/4 at a time into egg whites. Pour batter into ungreased 10 inch angel food tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in oven for 60 to 70 minutes, until an inserted wooden pick comes out clean. Invert pan until cake has cooled. Remove from pan. Serve plain or frost with Orange Icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
