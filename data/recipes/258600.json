  "ingredients": [
    "4 (14.5 ounce) cans Del Monte® Green Beans, any style, drained",
    "2 (10.5 ounce) cans Campbell's® Condensed Cream of Mushroom Soup",
    "2.6666667461395 cups French's® French Fried Onions, divided",
    "1 cup milk",
    "0.5 cup shredded Cheddar cheese, divided",
    "6 slices cooked bacon, divided",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine green beans, condensed soup, milk, and pepper in a large bowl. Add 1 1/3 cups French-fried onions and 1/2 of the Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble 5 slices of bacon; add to the green bean mixture and mix until well combined. Transfer to a 3-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for until hot and bubbly, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and stir. Sprinkle with the remaining Cheddar and onions. Crumble remaining slice of bacon over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake until onions are golden brown, about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
