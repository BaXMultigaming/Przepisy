        "https://www.allrecipes.com/thmb/FMYDX2EOgv3mmeW-TeyJs70Z_i4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-80969-Simple-Turkey-Chili-DDMFS-4x3-Step-04-db785fe3333140faa0e30ded3352f168.jpg"
