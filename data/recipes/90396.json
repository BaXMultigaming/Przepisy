  "ingredients": [
    "2 pounds large shrimp - peeled, deveined and chopped",
    "0.75 cup fresh lime juice",
    "5 roma (plum) tomatoes, diced",
    "1 white onion, chopped",
    "0.5 cup chopped fresh cilantro",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon ketchup",
    "1 teaspoon hot pepper sauce",
    "salt and pepper to taste",
    "1 avocado - peeled, pitted and diced",
    "16 saltine crackers"
  ],
  "steps": [
    {
      "text": "Place the shrimp and lime juice into a large bowl, and stir to coat. Let stand for about 5 minutes, or until shrimp are opaque. The lime juice will cure them. Mix in the tomatoes, onion, and cilantro until coated with lime juice; cover and refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the refrigerator, and mix in the Worcestershire sauce, ketchup, hot sauce, salt and pepper. We have our own hot sauce recipe, but you can use whatever hot sauce you like, or leave it out and let people add their own when serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve in glass tumblers and top with avocado pieces. Set out extra Worcestershire sauce, ketchup, lime wedges and hot sauce for people to individualize their dish. Serve with saltine crackers.",
      "section": null,
      "name": null,
      "url": null,
