  "ingredients": [
    "2 teaspoons olive oil",
    "1 large jalapeno pepper, minced",
    "2 tablespoons diced onion",
    "1.5 cups frozen corn, thawed",
    "salt and ground black pepper to taste",
    "1 tablespoon chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Heat olive oil over medium-low heat. Add jalapeño pepper; cook and stir until softened, about 5 minutes. Add onion; cook and stir until softened, about 2 minutes. Add corn; season with salt and black pepper. Cook and stir until corn is hot, about 5 minutes. Stir in cilantro to combine; simmer 30 to 60 seconds.",
