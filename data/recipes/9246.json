  "title": "Gingerbread Cupcakes with Cream Cheese Frosting",
  "description": "Moist and spicy little cakes made with molasses and cocoa powder, balanced by a tangy cream cheese frosting.",
  "authors": [
    "Kevin Ryan"
  ],
  "date_published": "1998-12-02T06:04:27-05:00",
