  "ingredients": [
    "5 tablespoons unsalted butter, softened",
    "0.5 cup white sugar",
    "0.5 cup unsulfured molasses",
    "1 egg",
    "1 egg yolk",
    "1.25 cups all-purpose flour",
    "1 tablespoon Dutch process cocoa powder",
    "1.25 teaspoons ground ginger",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "1 teaspoon baking soda",
    "0.5 cup hot milk",
    "2 tablespoons unsalted butter, softened",
    "2 ounces cream cheese, softened",
    "0.66666668653488 cup sifted confectioners' sugar",
    "0.25 teaspoon lemon extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter or line with paper liners a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream 5 tablespoons of the butter with the white sugar. Add the molasses and the egg and egg yolk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour, cocoa powder, ginger, cinnamon, allspice, nutmeg and salt. Dissolve the baking soda in the hot milk. Add the flour mixture to the creamed mixture and stir until just combined. Stir in the hot milk mixture. Pour the batter evenly into the prepared tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 20 minutes or until slightly springy to the touch. Allow to cool a few minutes in the pan and remove to a rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Frosting: Cream the 2 tablespoons butter and the cream cheese together. Beat in the confectioners' sugar until fluffy. Add the lemon extract and beat. When the cupcakes are cool, frost the tops with the frosting and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
