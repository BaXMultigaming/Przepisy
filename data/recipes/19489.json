  "ingredients": [
    "cooking spray",
    "1 pound crabmeat, shredded",
    "1.5 tablespoons dry bread crumbs",
    "2 teaspoons chopped fresh parsley",
    "salt and pepper to taste",
    "1 egg",
    "1.5 tablespoons mayonnaise",
    "0.5 teaspoon ground dry mustard",
    "1 dash hot pepper sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven’s broiler. Lightly grease a broiler pan or baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix crabmeat, bread crumbs, parsley, salt, and pepper together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sxtEEfLL0wX1bjrST8l2KM5NrwQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19489-maryland-crab-cakes-mfs-step-1-A-a47a81107ef242f7ba71770d8a1f89a2.jpg"
      ],
      "image": "assets/images/19489/step_02.webp"
    },
    {
      "text": "Mix egg, mayonnaise, mustard, and hot sauce together in a small bowl; stir into crab mixture until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-B8JFyRBzHc7Zegfhdb5vAU2v7M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19489-maryland-crab-cakes-mfs-step-3-A-4ea4a4e587eb45d281f478ce3a594788.jpg"
      ],
      "image": "assets/images/19489/step_03.webp"
    },
    {
      "text": "Form into patties and place on the prepared broiler pan or baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8wucI01AA5ipunFn9pqvV8rYKHI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19489-maryland-crab-cakes-mfs-step-4-1bf32861670c4605970426d268271f67.jpg"
      ],
      "image": "assets/images/19489/step_04.webp"
    },
    {
      "text": "Broil crab cakes under the preheated broiler until golden brown on both sides, about 5 to 7 minutes per side.",
