  "ingredients": [
    "3 tablespoons vegetable oil",
    "2 cups julienne celery",
    "2 onions, chopped",
    "4 cloves crushed garlic",
    "1 teaspoon white sugar",
    "2 tablespoons all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon cayenne pepper",
    "2 (14.5 ounce) cans crushed tomatoes",
    "1 (15 ounce) can tomato sauce",
    "1 bay leaf, crushed",
    "1 tablespoon hot pepper sauce",
    "2 pounds medium shrimp - peeled and deveined"
  ],
  "steps": [
    {
      "text": "Heat oil in a Dutch oven on medium heat. Sauté celery, onions, and garlic in the Dutch oven until onions are pearly white and celery has begun to soften.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, flour, salt, pepper, and cayenne pepper into the Dutch oven. Add crushed tomatoes and tomato sauce, both pieces of bay leaf, and hot sauce. Bring mixture to a boil, then turn the heat to low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let mixture simmer for 30 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Approximately 15 minutes before serving, add shrimp to the pot and stir well. If necessary, raise the temperature to medium-low to ensure Creole is bubbling but not burning. Scoop out bay leaf halves before serving. Serve when shrimp is pink and thoroughly cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
