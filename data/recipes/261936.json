  "ingredients": [
    "3 tablespoons butter",
    "0.5 cup all-purpose flour",
    "1 cup milk",
    "0.5 teaspoon salt",
    "2 cups diced ham",
    "2 tablespoons prepared yellow mustard",
    "1 tablespoon dried minced onion",
    "canola oil for frying",
    "2 eggs, or to taste",
    "1 cup seasoned bread crumbs"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium heat. Add flour slowly, stirring to create a buttery paste. Add milk and salt; cook and stir until mixture thickens, about 5 minutes. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ham, mustard, and onion thoroughly into the butter mixture. Chill dough in the refrigerator until safe to handle, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape chilled dough into croquettes about 1/3 cup apiece.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oil in a skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a bowl. Place bread crumbs into a separate bowl. Dip each croquette in the egg; coat in bread crumbs. Repeat with remaining croquettes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry croquettes in the hot oil in batches until browned and crispy, 7 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
