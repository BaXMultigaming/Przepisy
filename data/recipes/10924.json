  "ingredients": [
    "0.5 cup shortening",
    "0.5 cup butter, softened",
    "1 cup white sugar",
    "2 eggs",
    "1 cup mashed bananas",
    "0.5 cup evaporated milk",
    "1 teaspoon vanilla extract",
    "1 teaspoon distilled white vinegar",
    "3 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "0.5 teaspoon salt",
    "1 cup chopped walnuts",
    "2.5 cups confectioners' sugar",
    "2 tablespoons butter, softened",
    "0.25 cup evaporated milk",
    "0.25 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Mix together shortening, 1/2 cup butter, white sugar, eggs, bananas, vanilla, 1/2 cup evaporated milk and vinegar till light and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl mix together flour, baking soda, and salt. Add to other mixture. Add nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill one hour in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoonful on greased cookie sheet about two inches apart. Bake at 375 degrees F (190 degrees C) for about 15 minutes. Let cool then frost them.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Frosting: Mix 2 1/2 cups confectioners' sugar with 2 tablespoons soft butter or margarine, 1/4 cup evaporated milk, and 1/4 tsp vanilla. Beat until soft. Spread on tops of cooled cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
