  "ingredients": [
    "24 (2 inch) frozen mini tart shells",
    "6 slices bacon",
    "6 eggs",
    "1.5 cups heavy cream",
    "0.25 cup all-purpose flour",
    "2 teaspoons garlic salt",
    "2 teaspoons onion powder",
    "1 teaspoon chili powder",
    "0.5 teaspoon ground cumin",
    "2 cups shredded Cheddar cheese",
    "0.5 cup diced green bell pepper",
    "0.5 cup diced red bell pepper",
    "0.5 cup cubed fully cooked ham",
    "0.25 cup salsa",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 375 degrees F (190 degrees C). Place the tart shells into muffin pans and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the bacon in a large, deep skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on a paper towel-lined plate; crumble once cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the eggs in a mixing bowl; whisk in the cream, flour, garlic salt, onion powder, chili powder, and cumin until smooth. Stir in the crumbled bacon, 2 cups Cheddar cheese, green bell pepper, red bell pepper, ham, and salsa. Ladle the mixture into the tart shells; sprinkle with 1/2 cup of Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center of the quiche comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
