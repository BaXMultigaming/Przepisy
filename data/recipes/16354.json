  "ingredients": [
    "1.5 pounds ground beef",
    "1 egg",
    "1 onion, chopped",
    "1 cup milk",
    "1 cup dried bread crumbs",
    "salt and pepper to taste",
    "0.333 cup ketchup",
    "2 tablespoons brown sugar",
    "2 tablespoons prepared mustard"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xTljdJi2uuh_jKG24vpjHJ65Qd8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16354-easy-meatloaf-DDMFS-5162-4x3-step-01-a0cd2ba748d04dea8be2becd02cf4568.jpg"
      ],
      "image": "assets/images/16354/step_01.webp"
    },
    {
      "text": "Combine ground beef, onion, milk, bread crumbs, and egg in a large bowl, and season with salt and pepper. Press mixture evenly into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-EUBkQ4y0jLlG-fht7NXbiGO3VE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16354-easy-meatloaf-DDMFS-5163-4x3-step-02-6a4458c02e704554975c5cc28ab64979.jpg"
      ],
      "image": "assets/images/16354/step_02.webp"
    },
    {
      "text": "Stir ketchup, brown sugar, and mustard together in a small bowl until smooth, and spread evenly over the meatloaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KWQyyniPnHiZZnRwX9rZAn8BynM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16354-easy-meatloaf-DDMFS-5164-4x3-step-03-740995db72f0479eacd8c2fd2a39d1bc.jpg"
      ],
      "image": "assets/images/16354/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the middle reads at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VQhAWfUjhEufIzC6XhuV3Slkpks=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16354-easy-meatloaf-DDMFS-5186-4x3-step-04-193eea1d035441d0b24e6aa4cb870292.jpg"
      ],
      "image": "assets/images/16354/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q2i_L11qt7QzJ7gl66atPJmKuU0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16354-easy-meatloaf-DDMFS-0034-5186-hero-4x3-30547610d0f64d2fb3c25c0cab909af6.jpg"
