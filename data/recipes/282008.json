  "ingredients": [
    "1.5 tablespoons olive oil",
    "0.5 cup coarsely chopped onion",
    "1 clove garlic, smashed and chopped",
    "0.5 cup freekeh [frikeh, fireek, farik]",
    "1 medium carrot, peeled and roughly chopped",
    "3 tablespoons celery leaves, chopped",
    "0.5 teaspoon dried parsley",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 large bay leaf",
    "3 cups Chicken Stock-Dry-Prepared EFC"
  ],
  "steps": [
    {
      "text": "Heat oil in a saucepan over medium heat. Add onion and cook until slightly softened, about 3 minutes. Add garlic and cook until fragrant, about 30 seconds. Stir in freekeh and toast for 3 minutes. Add carrot, celery leaves, parsley, salt, pepper, and bay leaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil. Reduce heat and simmer until freekeh is tender, 15 to 20 minutes. Taste and adjust seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow soup to rest for 5 minutes. Remove bay leaf and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
