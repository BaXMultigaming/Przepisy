  "ingredients": [
    "2 tablespoons vegetable oil",
    "2 onions, chopped",
    "1 green bell pepper, seeded and chopped",
    "1 red bell pepper, seeded and chopped",
    "1 yellow bell pepper, seeded and chopped",
    "2 cloves garlic, crushed",
    "0.75 cup uncooked quinoa",
    "4 cups vegetable broth or stock",
    "1 tablespoon tomato puree",
    "3 tomatoes - peeled, seeded and chopped",
    "Italian seasoning to taste"
  ],
  "steps": [
    {
      "text": "Heat the oil in a large skillet over medium-high heat. Add the onions and red, green and yellow peppers; cook and stir for about 5 minutes. Add the garlic, and cook for about 2 more minutes. Stir in the quinoa, vegetable stock, and tomato puree.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to a boil, then cover and simmer over low heat for 20 minutes, or until quinoa grains are soft. Stir in the diced tomatoes and season with Italian seasoning. Cook until heated through, then serve.",
      "section": null,
      "name": null,
      "url": null,
