  "title": "Chef John's Tzatziki Sauce",
  "description": "Tzatziki sauce is an incredibly refreshing and delicious dip or side dish that's easy to make with Greek yogurt, cucumber, garlic, lemon, and herbs.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2013-04-26T16:00:51-04:00",
