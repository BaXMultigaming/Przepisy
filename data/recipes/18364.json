  "ingredients": [
    "2 (8 ounce) cans refrigerated dinner roll dough",
    "1 pound lean ground beef",
    "1 pound pork sausage",
    "5 cups shredded cabbage",
    "1 cup chopped onion",
    "0.5 teaspoon salt",
    "0.5 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Roll out dough to 1/4 inch in thickness, then cut into 5 inch squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, cook beef and sausage over medium heat until browned; make sure there is no remaining pink color. Stir in cabbage, onions and salt with meat. Saute for about 20 minutes. Turn down heat to warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each dough square with a tablespoon of meat filling. Seal dough by bringing the four corners up and then overlapping them. Place pastry upside down on a baking sheet; brush each roll with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow rolls to rise for 1 hour and then bake in a preheated 350 degrees F (175 degrees C) oven for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
