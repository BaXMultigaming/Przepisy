  "ingredients": [
    "1 red onion, sliced into rings",
    "0.25 cup cider vinegar",
    "1 tablespoon olive oil",
    "4 (5 ounce) boneless pork chops",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup sour cream",
    "0.25 cup Dijon mustard",
    "2.5 tablespoons apricot preserves"
  ],
  "steps": [
    {
      "text": "Mince enough of the red onion slices to have 1/3 cup minced onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put remaining onion slices in a bowl and pour vinegar over them; marinate for 10 minutes. Drain and discard the vinegar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium-high heat. Season pork chops with salt and pepper; fry in the hot oil until nicely browned and no longer pink in the center, about 4 minutes per side. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange pork chops onto serving plates; top each with a portion of the red onion slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk minced onion, sour cream, Dijon mustard, and apricot preserves together in a bowl; serve with the pork chops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
