  "ingredients": [
    "6 ounces cream cheese, softened",
    "1 (14 ounce) can sweetened condensed milk",
    "1 large egg",
    "3 tablespoons lemon juice",
    "1 teaspoon vanilla extract",
    "1 cup frozen raspberries",
    "1 chocolate crumb pie crust",
    "0.25 cup heavy whipping cream",
    "2 (1 ounce) squares semi-sweet baking chocolate"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese in a large bowl until fluffy. Gradually beat in condensed milk until smooth. Add egg, lemon juice, and vanilla extract; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange raspberries on the bottom of the pie crust and slowly pour cream cheese mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center is almost set, 30 to 35 minutes. Let cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream and chocolate in a small saucepan over low heat, stirring until melted and smooth, 3 to 5 minutes. Pour chocolate glaze over the cooled pie and refrigerate until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
