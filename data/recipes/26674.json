  "ingredients": [
    "8 large potatoes, peeled and chopped",
    "1 pound lean ground beef",
    "0.5 cup chopped onion",
    "1 (15 ounce) can carrots, drained",
    "1 (15 ounce) can green beans, drained",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "1 (10.5 ounce) can condensed tomato soup",
    "0.75 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large saucepan of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes. Drain and mash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While potatoes are cooking, combine ground beef and onion in a large skillet over medium-high heat. Cook and stir until beef is evenly browned and crumbly and onion is tender, 7 to 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir carrots, green beans, and condensed soups into beef mixture. Transfer to the prepared baking dish. Spread mashed potatoes over beef mixture and sprinkle Cheddar cheese over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are lightly golden brown on top, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
