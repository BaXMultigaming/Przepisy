  "ingredients": [
    "1 (15.25 ounce) package cake mix with candy bits (such as Pillsbury® Funfetti®), or more to taste",
    "2 eggs",
    "0.33333334326744 cup vegetable oil",
    "0.33333334326744 cup confectioners' sugar",
    "5 tablespoons multicolored candy sprinkles"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, eggs, and oil in a large bowl until forms a dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine confectioners’ sugar and sprinkles together in a separate small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 1-inch balls; roll balls in confectioners’ sugar mixture. Arrange cookie balls on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are golden, about 6 minutes. Cool on the baking sheets, about 5 minutes, before transferring to a wire rack to cool completely.",
