  "ingredients": [
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.125 teaspoon ground nutmeg",
    "0.125 teaspoon ground cinnamon",
    "1 tablespoon white sugar",
    "1 egg",
    "0.5 cup plain yogurt",
    "0.5 cup milk",
    "2 tablespoons vegetable oil",
    "0.75 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat griddle over medium heat. Stir together the flour, baking powder, nutmeg, cinnamon and sugar, set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the egg, yogurt, milk and oil. Gradually stir in the flour mixture, then fold in the blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter onto hot greased griddle, two tablespoons at a time. Cook over medium heat until bubbles pop and stay open, then turn over and cook on the other side until golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
