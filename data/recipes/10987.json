  "ingredients": [
    "0.625 cup butter",
    "0.5 cup white sugar",
    "1 egg",
    "1 tablespoon lavender flowers",
    "1.5 cups all-purpose flour",
    "0.5 cup colored sugar for decoration",
    "1 tablespoon lavender flowers"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the butter and sugar. Beat the egg, and blend into the butter and sugar. Mix in the lavender flowers and the flour. Drop batter by teaspoonfuls onto cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 15 to 20 minutes, or until golden. Remove cookies to cooling racks, and sprinkle with decorative sugar and additional lavender flowers if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
