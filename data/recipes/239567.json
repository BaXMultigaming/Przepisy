  "ingredients": [
    "1.5 cups all-purpose flour, sifted",
    "0.5 cup white sugar",
    "0.25 cup brown sugar",
    "1 tablespoon pumpkin pie spice",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 cup pumpkin puree, or as needed",
    "0.33333334326744 cup vegetable oil",
    "0.33333334326744 cup milk",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon lemon extract",
    "0.75 cup white chocolate chips",
    "1 tablespoon all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 9 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1 ½ cups flour, white sugar, brown sugar, pumpkin pie spice, baking powder, and salt together in a large bowl until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin purée, oil, milk, egg, vanilla extract, and lemon extract in a separate large bowl until smooth; stir into flour mixture until batter is just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss white chocolate chips and 1 tablespoon flour together in a small bowl until evenly coated; fold into batter. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
