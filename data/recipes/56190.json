  "ingredients": [
    "6 large eggs, beaten",
    "2 teaspoons grated lime zest",
    "3 (14 ounce) cans sweetened condensed milk",
    "0.75 cup canned evaporated milk",
    "1.5 cups rum",
    "1 tablespoon aromatic bitters",
    "1 pinch freshly grated nutmeg"
  ],
  "steps": [
    {
      "text": "Beat eggs and lime zest in a large bowl using an electric mixer until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CmXWTywtl7QzrPVifp7UmwOpUGI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/56190-trinidads-ponche-de-creme-punch-with-cream-VAT-step-01-1924f49fcaf74d09927fe5758f5f1afe.jpg"
      ],
      "image": "assets/images/56190/step_01.webp"
    },
    {
      "text": "Gradually pour in condensed milk while continuing to mix, and then pour in evaporated milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P45r2qUfS2Ocor7VxwM0K6yrFnQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/56190-trinidads-ponche-de-creme-punch-with-cream-VAT-step-02-fd9c930838af45259ecf405e2a0557e9.jpg"
      ],
      "image": "assets/images/56190/step_02.webp"
    },
    {
      "text": "Stir in rum and bitters and sprinkle with nutmeg. Transfer to a bottle and chill for at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d2MLU64H9ucrjYoZsdmvVB27lw0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/56190-trinidads-ponche-de-creme-punch-with-cream-VAT-step-03-7c4cbbc9a2364540b96f0cc19f9092be.jpg"
      ],
      "image": "assets/images/56190/step_03.webp"
    },
    {
      "text": "Serve over crushed ice.",
