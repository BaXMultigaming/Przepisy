  "ingredients": [
    "1 (3 pound) whole chicken",
    "1 tablespoon olive oil",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon paprika",
    "0.125 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse chicken thoroughly inside and out under cold running water and remove all fat. Pat dry with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put chicken into a small baking pan. Rub with olive oil. Mix the salt, pepper, oregano, basil, paprika and cayenne pepper together and sprinkle over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast the chicken in the preheated oven for 20 minutes. Lower the oven to 400 degrees F (205 degrees C) and continue roasting to a minimum internal temperature of 165 degrees F (74 degrees C), about 40 minutes more. Let cool 10 to 15 minutes and serve.",
      "section": null,
      "name": null,
      "url": null,
