  "ingredients": [
    "1 bunch radishes, trimmed and halved",
    "1 medium onion, halved and sliced",
    "0.5 teaspoon lemon zest",
    "0.25 teaspoon dried thyme",
    "0.25 teaspoon dried dill",
    "0.25 teaspoon garlic powder",
    "1 pinch salt and ground black pepper to taste",
    "3 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place radishes and onion in a medium bowl. Sprinkle with lemon zest, thyme, dill, garlic powder, salt, and pepper. Drizzle with olive oil and toss to coat. Spread on the baking sheet in an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven, stirring every 5 to 10 minutes, until edges are beginning to brown and radishes are fork-tender, 20 to 25 minutes. Taste and season with additional salt, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
