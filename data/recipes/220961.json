  "ingredients": [
    "6 small potatoes, peeled and cut into 1/2-inch cubes",
    "7 tablespoons butter, divided",
    "0.667 pound leftover cooked ham, cut into 1/2-inch cubes",
    "1 small onion, finely chopped",
    "3 tablespoons all-purpose flour",
    "1.5 cups milk",
    "salt and ground black pepper to taste",
    "1 (8 ounce) package shredded Cheddar cheese",
    "0.25 cup bread crumbs"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C). Grease a 1 ½-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When the potatoes are almost finished, melt 3 tablespoons butter in a skillet over medium heat. Add ham and onion; cook and stir until the onion has softened and turned translucent, about 5 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hjcsKNB-K1nb0yAnwJwlkt2KPBk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220961-LeftoverHam-N-PotatoCasserole-mfs-step-1-f1cde226d86548bf89c26a72720a3dcd.jpg"
      ],
      "image": "assets/images/220961/step_03.webp"
    },
    {
      "text": "Drain potatoes; add to the ham mixture and stir to combine. Transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt remaining 4 tablespoons butter in a saucepan over medium heat. Whisk in flour and stir until the mixture becomes paste-like and light golden brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually whisk milk into the flour mixture; season with salt and black pepper. Continue cooking and stirring until thickened, about 2 minutes. Reduce heat to medium-low and stir in Cheddar cheese until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5YNOeuayCMD9CwFvbgLQd5p_y3o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220961-LeftoverHam-N-PotatoCasserole-mfs-step-2-b10dbbf88054410a96276938e49a150b.jpg"
      ],
      "image": "assets/images/220961/step_06.webp"
    },
    {
      "text": "Pour cheese sauce over ham and potatoes. Sprinkle bread crumbs over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mMyiOcPMaIiC03HJyZYBXH9TQdo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220961-LeftoverHam-N-PotatoCasserole-mfs-step-4-658fb50ea8f64b5c9c48b744ba03cef5.jpg"
      ],
      "image": "assets/images/220961/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until sauce is bubbly and browned, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V_9SxADa4kSPfv2JWbZS3YWYREA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220961leftover-ham-n-potato-casserolefabeverydayvideo4x3-f7c0d63ceeb544f3a48a6fb0c640886b.jpg"
