  "ingredients": [
    "2 cups soy milk",
    "2 teaspoons apple cider vinegar",
    "2 cups cornmeal",
    "1 cup all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.33333334326744 cup canola oil",
    "2 tablespoons maple syrup",
    "1 cup frozen corn kernels"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Place a greased, 10-inch cast iron skillet in the preheating oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix soy milk and vinegar together in a bowl. Let stand until curdled, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cornmeal, flour, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour oil and maple syrup into the soy milk mixture. Whisk with a fork until foamy, about 3 minutes. Pour over cornmeal mixture and mix until combined. Fold in corn kernels. Pour batter into the hot skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 35 minutes. Slice into squares or wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
