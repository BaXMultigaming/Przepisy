  "title": "Moist Vegan Cornbread",
  "description": "This moist vegan cornbread with soy milk, canola oil, and frozen corn kernels is a snap to make in a cast iron skillet and great with soup.",
  "authors": [
    "Caiti Ann"
  ],
  "date_published": "2020-03-10T02:52:46-04:00",
