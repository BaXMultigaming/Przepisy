  "ingredients": [
    "1 pound tagliatelle pasta",
    "1 (6 ounce) jar sun-dried tomatoes packed in oil, drained and chopped",
    "1 cup sour cream",
    "1 cup ricotta cheese",
    "0.5 cup grated Parmesan cheese",
    "0.75 ounce chopped fresh flat-leaf parsley",
    "0.75 ounce chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in tagliatelle and return to a boil; cook, uncovered, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and return to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sun-dried tomatoes in a large skillet over medium heat, 2 to 3 minutes. Stir in sour cream, ricotta cheese, and Parmesan cheese, then stir in parsley and basil. Toss in tagliatelle to combine.",
