  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 large onion, sliced",
    "0.25 pound zucchini, chopped",
    "1 (8 ounce) can garbanzo beans, with liquid",
    "1 (8 ounce) can whole peeled tomatoes with liquid, chopped",
    "0.75 cup dry white wine",
    "3 tablespoons butter, melted",
    "1 teaspoon minced garlic",
    "1 teaspoon dried basil",
    "1 bay leaf",
    "0.5 cup heavy cream",
    "0.5 cup shredded Monterey Jack cheese",
    "0.5 cup grated Romano cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a medium saucepan over medium heat, and saute onion until tender and lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium baking dish, mix onion, zucchini, garbanzo beans with liquid, tomatoes with liquid, wine, butter, garlic, basil, and bay leaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and bake in the preheated oven 30 minutes. Uncover, stir, and continue baking 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir heavy cream, Monterey Jack cheese, and Romano cheese into the vegetable mixture, and continue baking 10 minutes, until cheeses are melted and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
