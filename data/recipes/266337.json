  "ingredients": [
    "0.75 cup white sugar",
    "2 eggs",
    "0.75 tablespoon vanilla extract",
    "3 tablespoons rum",
    "0.75 stick butter, softened, divided",
    "0.75 cup all-purpose flour",
    "0.75 teaspoon baking powder",
    "1 pinch salt",
    "4 cups chopped peeled apples, or more taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, eggs, and vanilla extract in a bowl; beat with an electric mixer until smooth. Mix in rum. Mix in 1/2 of the butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, and salt together in a separate bowl. Add 1/2 of the flour mixture to the egg mixture; mix well. Mix in remaining butter and flour. Fold in apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrape batter into the prepared pan. Smooth the top gently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown and a toothpick inserted into the center comes out clean, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
