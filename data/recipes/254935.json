  "ingredients": [
    "1 cup whole wheat flour",
    "1 cup oats",
    "0.5 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup milk",
    "0.25 cup vegetable oil",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2 cups diced strawberries",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Grease muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, oats, sugar, baking powder, baking soda, and salt together in a bowl. Combine milk, vegetable oil, egg, and vanilla extract in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk mixture into flour mixture until batter is combined. Fold in strawberries and blueberries. Spoon batter into prepared muffin pan until full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into the center comes out clean, 18 to 22 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
