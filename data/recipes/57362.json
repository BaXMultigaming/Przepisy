  "ingredients": [
    "20 pitted dates",
    "0.25 cup goat cheese",
    "20 pecan halves",
    "10 slices bacon, cut in half",
    "0.5 cup balsamic vinegar",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice open the dates, and stuff each with about 1/2 teaspoon goat cheese. Top each date with a pecan, using the goat cheese to hold the pecans in place. Wrap each date with 1/2 slice bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange the wrapped dates on a baking sheet. Bake 15 to 20 minutes in the preheated oven, until the bacon is crisp and evenly brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan over medium heat, mix the balsamic vinegar and sugar until thickened. Pour over the dates to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
