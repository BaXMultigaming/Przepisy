  "ingredients": [
    "2 teaspoons butter",
    "1 portobello mushroom, sliced",
    "2 strips turkey bacon, chopped",
    "0.25 cup chopped green bell pepper",
    "2 tablespoons chopped onion",
    "2 tablespoons shredded sharp Cheddar cheese",
    "3 eggs",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a nonstick skillet over medium-high heat. Saute mushroom slices, turkey bacon, green pepper, and onion until tender, 3 to 4 minutes. Remove to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip eggs with salt and pepper in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour eggs into the skillet so they completely cover the bottom. Sprinkle Cheddar cheese and turkey bacon mixture over the top. Cook until eggs are set, about 5 minutes. Slide omelette onto a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll up the omelette from one edge until it resembles a burrito. Cut in half and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
