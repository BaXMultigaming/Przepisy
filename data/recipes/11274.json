  "ingredients": [
    "1 cup margarine, softened",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "1.75 cups all-purpose flour",
    "1 cup finely chopped walnuts",
    "1 (6 ounce) bag milk chocolate candy kisses",
    "0.33333298563957 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "In a large bowl, cream margarine with sugar and vanilla until light and fluffy. Mix in flour and walnuts, beating on low speed of an electric mixer until well mixed. Cover, and refrigerate dough for 2 hours, or until firm enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove wrappers from chocolate kisses. Shape approximately 1 tablespoon of dough around each chocolate kiss; be sure to cover chocolate completely. Place cookies on an ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 to 12 minutes in the preheated oven. While cookies are still warm, roll them in confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
