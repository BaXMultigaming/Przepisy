  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice zucchini into 3 lengthwise pieces. Spray each slice with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with salt, garlic powder, and onion powder and set on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
