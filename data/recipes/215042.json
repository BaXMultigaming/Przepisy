  "ingredients": [
    "6 habanero peppers, seeded and chopped, or to taste",
    "4 cloves garlic, minced",
    "1 (15 ounce) can sliced peaches, drained",
    "1 cup distilled white vinegar",
    "0.25 cup dark molasses",
    "0.25 cup honey",
    "0.25 cup brown sugar",
    "2 tablespoons spicy brown mustard (such as Gulden's®)",
    "2 tablespoons paprika",
    "1 tablespoon kosher salt",
    "1 tablespoon black pepper",
    "1 tablespoon ground cumin",
    "1 teaspoon liquid smoke flavoring",
    "0.5 teaspoon ground coriander",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground allspice"
  ],
  "steps": [
    {
      "text": "Place habaneros and garlic in a blender; blend until chiles are finely chopped. Add peaches, vinegar, molasses, honey, brown sugar, mustard, paprika, salt, black pepper, cumin, liquid smoke, coriander, ginger, and allspice; blend until smooth.",
