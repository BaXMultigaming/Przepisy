  "title": "Baked Trout Fillets",
  "description": "A colorful mixture of green onions, mushrooms, artichoke hearts, and cherry tomatoes makes a delicious topping for simple baked trout.",
  "authors": [
    "acsdeb"
  ],
  "date_published": "2019-07-10T03:04:02-04:00",
