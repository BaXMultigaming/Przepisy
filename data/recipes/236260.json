  "ingredients": [
    "1.5 pounds bulk pork sausage",
    "3.5 cups milk, divided",
    "8 eggs",
    "0.75 teaspoon dry mustard",
    "8 slices bread, torn into small squares",
    "2 cups shredded mozzarella cheese",
    "1 (10.75 ounce) can condensed cream of mushroom soup"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 2 1/2 cups milk, eggs, and mustard in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread bread squares into the bottom of a baking dish. Layer mozzarella cheese atop the bread and top with sausage. Pour the egg mixture over the entire dish. Cover the baking dish with plastic wrap and refrigerate 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream of mushroom soup and 1 cup milk together in a bowl. Remove and discard plastic wrap from baking dish. Pour soup mixture over the 'bake.'",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until hot in the center, about 90 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
