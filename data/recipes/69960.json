  "ingredients": [
    "0.5 cup white sugar",
    "0.33333334326744 cup unsweetened cocoa powder",
    "3 tablespoons cornstarch",
    "2 cups milk",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Whisk together sugar, cocoa, and cornstarch in a microwave-safe bowl. Whisk in milk, a little at a time, until no dry lumps remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the microwave on high for 3 minutes. Stir well. Continue cooking and stirring at 1-minute intervals until shiny and thick, 2 to 4 minutes. Mix in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press a piece of plastic wrap directly on surface of pudding to prevent skin from forming. Place in the refrigerator to chill. Serve cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
