  "ingredients": [
    "1 teaspoon McCormick® Dill Weed",
    "1 teaspoon McCormick® Garlic Powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon McCormick® Black Pepper, Coarse Ground",
    "2 pounds red potatoes, cut into wedges",
    "1 tablespoon olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 10x15-inch baking pan with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix dill, garlic powder, salt, and pepper together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss potatoes with oil in a large bowl; sprinkle seasoning mixture over top and toss to coat. Spread potatoes in a single layer on the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are tender and golden brown, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
