  "ingredients": [
    "2 cups creamy peanut butter",
    "2 cups powdered milk",
    "2 cups honey",
    "1 (15 ounce) package pretzel rods",
    "2 tablespoons sliced almonds, or as needed",
    "0.25 cup plum jam, or as needed"
  ],
  "steps": [
    {
      "text": "Mix peanut butter, powdered milk, and honey together in a bowl until mixture resembles a soft dough. This will be the 'flesh' of the fingers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mold enough dough around each pretzel rod, making sure to cover the ends. The pretzels will be the 'bones' of the fingers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use the tip of a teaspoon the make marks on the 'flesh' similar to knuckles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Push 1 sliced almond onto 1 end of each 'finger' to resemble a finger nail.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place jam in a microwave-safe bowl and heat in microwave until softened, 20 to 30 seconds. Dip the end opposite the 'finger nail' into the jam for the 'blood'.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
