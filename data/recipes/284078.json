  "ingredients": [
    "1 tablespoon olive oil",
    "1 medium green pepper, diced",
    "0.5 large yellow onion, diced",
    "4 cloves garlic, minced",
    "0.25 cup crushed tomatoes",
    "2 tablespoons red wine vinegar",
    "1 teaspoon ground cumin",
    "1 teaspoon salt",
    "0.75 teaspoon dried thyme",
    "0.25 teaspoon red pepper flakes",
    "1 bay leaf",
    "1.3333333730698 (15 ounce) cans black beans, rinsed and drained",
    "2 cups uncooked long-grain white rice",
    "4 cups chicken stock"
  ],
  "steps": [
    {
      "text": "Heat oil in a Dutch oven over medium heat. Add bell pepper, onion, and garlic. Cook and stir until onion is translucent, about 5 minutes. Stir in crushed tomatoes and vinegar. Add cumin, salt, thyme, pepper flakes, and bay leaf. Cook for 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add black beans, rice, and stock. Bring to a boil. Reduce heat to low, cover, and simmer until rice is tender and all liquid has been absorbed, about 25 minutes; do not lift the cover during cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
