  "ingredients": [
    "1 crusty sandwich roll, split",
    "1 tablespoon prepared Dijon mustard mayonnaise blend",
    "2 slices deli turkey",
    "1 slice Swiss cheese",
    "2 slices deli ham",
    "1 tablespoon mayonnaise",
    "2 slices deli roast beef",
    "2 slices tomato",
    "1 slice Muenster cheese"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place roll on the prepared baking sheet, cut-sides-up. Spread Dijonnaise on 1 roll half; top with turkey, Swiss cheese, and ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1 tablespoon mayonnaise on other roll half; top with roast beef, tomato, and Muenster cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil sandwich, open-faced, until cheeses melt and begin to bubble and ham begins to crisp around the edges. Put both halves together to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
