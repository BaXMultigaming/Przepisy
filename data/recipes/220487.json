  "ingredients": [
    "1 egg white",
    "1.5 pounds pecan halves",
    "0.75 cup white sugar",
    "0.25 cup light brown sugar",
    "1.25 teaspoons ground cinnamon",
    "2 tablespoons unsalted butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white in a large glass or metal bowl until foamy and soft peaks form. Lift your beater or whisk straight up: the egg white will form soft mounds rather than a sharp peak.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pecan halves into whipped egg white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, brown sugar, and cinnamon in a bowl; stir into pecan mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat bottom of a jelly roll pan with softened butter. Spread pecan mixture in an even single layer in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crisp, turning occasionally, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
