  "ingredients": [
    "0.25 cup applesauce",
    "0.75 cup white sugar",
    "2 eggs",
    "1.25 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.75 cup nonfat sour cream",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a muffin pan with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the applesauce, sugar and eggs. Combine the flour and baking soda, add to the wet mixture and mix well. Stir in the sour cream, then fold in the berries. Spoon the batter into the prepared muffin cups. Cups should be at least 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in the preheated oven, until muffins spring back when touched lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
