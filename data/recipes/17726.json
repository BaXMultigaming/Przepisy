  "title": "Sour Cream Muffins",
  "description": "Surprisingly tasty muffins with fresh fruit. Use any type of fresh berry or chopped fresh fruit for a delightful breakfast.",
  "authors": [
    "Sara"
  ],
  "date_published": "2000-01-18T19:23:13-05:00",
