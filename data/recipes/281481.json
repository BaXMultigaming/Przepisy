  "ingredients": [
    "1 large egg",
    "1 tablespoon olive oil",
    "1 cup unseasoned dry breadcrumbs",
    "1.5 teaspoons dry ranch seasoning mix, or to taste",
    "2 (4 ounce) tilapia fillets",
    "2 hamburger buns, split",
    "0.5 cup shredded lettuce, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spread olive oil on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a bowl. Mix bread crumbs and ranch dressing mix in a second bowl. Submerge tilapia in the egg, remove, and coat with bread crumb mixture. Place breaded tilapia on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, about 15 minutes. Assemble fillets on hamburger buns and top with lettuce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
