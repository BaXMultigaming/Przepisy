  "ingredients": [
    "1.25 cups self-rising cornmeal",
    "0.25 cup self-rising flour",
    "1 tablespoon sugar",
    "0.25 teaspoon salt",
    "0.5 cup vegetable oil",
    "2 eggs, beaten",
    "1.5 cups grated unpeeled zucchini",
    "1 onion, chopped",
    "0.75 cup cottage cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a cast-iron skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornmeal, flour, sugar, and salt in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil and eggs together in separate large bowl until smooth; stir in zucchini, onion, and cottage cheese until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a well in flour mixture; slowly pour in egg mixture and mix until just combined. Pour batter into the prepared skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is lightly browned and a toothpick inserted into the center comes out clean, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
