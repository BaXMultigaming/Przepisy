  "ingredients": [
    "1 cup bread crumbs",
    "1 (1.5 ounce) package stackable potato chips (such as Pringles®), crushed",
    "1 tablespoon ground black pepper",
    "1 tablespoon dried dill",
    "1 teaspoon salt",
    "1 teaspoon garlic powder",
    "4.25 cups shredded cooked chicken",
    "0.5 cup ranch dressing",
    "0.5 cup tartar sauce",
    "0.25 cup hot sauce",
    "4 green onions, minced",
    "3 tablespoons vegetable oil, or as needed",
    "2 tablespoons honey",
    "2 tablespoons hot sauce"
  ],
  "steps": [
    {
      "text": "Mix bread crumbs, crushed potato chips, pepper, dill, salt, and garlic together in a large bowl. Mix in chicken, ranch dressing, tartar sauce, 1/4 cup hot sauce, and green onions. Form mixture into 2-inch or 3-inch balls; press down into patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Place patties in a single layer in the hot oil; cook until dark golden brown, about 3 minutes per side. Drain on paper towels. Repeat with remaining patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk honey and 2 tablespoons hot sauce together to make dipping sauce. Serve dipping sauce with patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
