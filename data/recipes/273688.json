  "ingredients": [
    "1 cup butter",
    "0.66666668653488 cup white sugar",
    "2 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 tablespoon vanilla sugar",
    "16 teaspoons raspberry jam, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 16-cup muffin tin with muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar together in a large bowl using an electric mixer until creamy. Add flour, vanilla sugar, and baking powder; beat to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough in half and divide each half into 8 equal pieces. Roll each piece into a ball. Place a ball of dough into each prepared muffin cup; make a small indentation in the center of each dough ball with a flour-coated thumb. Fill each indentation with a teaspoon of raspberry jam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
