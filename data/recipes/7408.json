  "ingredients": [
    "2.5 cups all-purpose flour",
    "0.5 cup packed brown sugar",
    "0.25 cup butter",
    "0.5 cup chopped walnuts",
    "1 cup white sugar",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.5 cup shortening",
    "2 eggs",
    "1 cup buttermilk",
    "1 teaspoon vanilla extract",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease and flour one 13x9 inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup of the flour and the brown sugar, cut in the butter until the mixture is crumbly, stir in the chopped nuts and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a double boiler or microwave melt chocolate chips and set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl mix the remaining 2 cups flour, white sugar, baking soda, and salt. Add the shortening, eggs, buttermilk, and vanilla. Blend and then beat with an electric mixer at medium speed for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup of the batter and the melted cooled chocolate, mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Alternate spooning the light and the dark batters into the prepared 13x9 cake pan. Cut through with a knife to marble. Sprinkle top with the reserved nut mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 30 minutes or until cake tests done. Let cake cool and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
