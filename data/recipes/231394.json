  "ingredients": [
    "1.5 cups all-purpose flour",
    "2 tablespoons baking powder",
    "1 tablespoon white sugar",
    "0.5 teaspoon salt",
    "1.25 cups milk",
    "1 ripe banana, mashed",
    "0.33333334326744 cup smooth peanut butter",
    "1 large egg",
    "1 tablespoon canola oil",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat a griddle over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yebzr6ERwrfdDEXUqCE-OK2YeaE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231394-peanut-butter-banana-pancakes-ddmfs-step1-3x4-b9f070b41f5b45c5a252ce18464d353b.jpg"
      ],
      "image": "assets/images/231394/step_01.webp"
    },
    {
      "text": "Whisk together flour, baking powder, sugar, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/afG9tl3ei1cdELtUn4dVzHTofqY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231394-peanut-butter-banana-pancakes-ddmfs-step2-3x4-d1535d6f53174b5b8d385f119beb8261.jpg"
      ],
      "image": "assets/images/231394/step_02.webp"
    },
    {
      "text": "Combine milk, mashed banana, peanut butter, egg, oil, and vanilla in a separate bowl; pour into flour mixture and whisk until batter is thoroughly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Hxsia4ejzU4fInZ4IYgUx3HNnnk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231394-peanut-butter-banana-pancakes-ddmfs-step3-1-3x4-7692c0160c744589ba3c55a3062fea84.jpg"
      ],
      "image": "assets/images/231394/step_03.webp"
    },
    {
      "text": "Ladle batter in 1/4 cup portions onto the preheated griddle and cook until tiny air bubbles form on the top, 2 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vRnlnJb05qCAiISDeK-3WHwM4IY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231394-peanut-butter-banana-pancakes-ddmfs-step4-1-3x4-736b2cc625aa4342a9006ca003023393.jpg"
      ],
      "image": "assets/images/231394/step_04.webp"
    },
    {
      "text": "Flip and continue cooking until the bottoms are browned, 2 to 3 minutes. Remove pancakes to a plate and cover to keep warm. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/swSy1hUa7iCEkGtyHLDyeBj0arM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231394-peanut-butter-banana-pancakes-ddmfs-step4-2-3x4-a8453ad86cad47ec853ff64e9437bc6a.jpg"
      ],
      "image": "assets/images/231394/step_05.webp"
    }
