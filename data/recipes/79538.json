  "ingredients": [
    "6 skinless, boneless chicken breast halves",
    "0.33333334326744 cup sultana raisins",
    "1 (1 pound) large mango, peeled, thinly sliced",
    "0.66666668653488 cup mayonnaise",
    "1 teaspoon mild curry powder",
    "1 tablespoon mango chutney",
    "1 teaspoon fresh lemon juice",
    "1 pinch salt and ground black pepper",
    "0.75 cup toasted cashews"
  ],
  "steps": [
    {
      "text": "Poach chicken in lightly salted boiling water until no longer pink and cooked through, 20 minutes. Drain, cool, and cut into 1/2-inch strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chicken strips, raisins, and 1/2 of the mango in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mayonnaise, curry powder, chutney, and lemon juice together in a medium bowl; season with salt and pepper, then toss gently with chicken mixture. Stir in 1/2 of the cashews. Transfer to a platter, and garnish with remaining mango strips and cashews.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
