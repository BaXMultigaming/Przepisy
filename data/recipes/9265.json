  "title": "Christmas Cake",
  "description": "This classic Christmas cake made with brandy-soaked dried fruit, nuts, and spices is a decadent and moist festive fruitcake full of rich flavor.",
  "authors": [
    "Carol"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
