  "ingredients": [
    "1 teaspoon coconut oil",
    "1 medium Spanish sweet onion, chopped",
    "2 cups fresh spinach",
    "2 large eggs, beaten",
    "1 ounce shredded mozzarella cheese",
    "1 cup leftover mashed potatoes",
    "1 tablespoon salsa",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a pan over medium-high heat. Saute onion in the hot oil until softened, about 5 minutes. Add spinach and beaten eggs and mix together to coat. Add cheese and cover the pan with a lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lower heat and steam until eggs are set, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, microwave leftover mashed potatoes until heated through, about 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay out cooked omelette over potatoes and top with salsa. Add salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
