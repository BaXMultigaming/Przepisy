  "ingredients": [
    "0.33333334326744 cup cilantro",
    "0.25 cup molasses",
    "1.5 tablespoons hot pepper relish",
    "2 cloves garlic",
    "2 tablespoons olive oil",
    "1 teaspoon onion powder",
    "0.125 teaspoon cayenne pepper",
    "1 pound salmon, with skin"
  ],
  "steps": [
    {
      "text": "Combine cilantro, molasses, relish, garlic, olive oil, onion powder, and cayenne pepper in a blender and blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon in a shallow glass baking dish and coat with the molasses mixture. Cover and refrigerate 15 minutes. Turn salmon over and refrigerate 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Uncover baking dish and turn salmon skin-side down in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, uncovered, until fish flakes easily with a fork and the internal temperature reaches 145 degrees F (63 degrees C), about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
