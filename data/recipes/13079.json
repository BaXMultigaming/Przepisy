  "ingredients": [
    "2 pounds lean ground beef",
    "1 (46 fluid ounce) can tomato juice",
    "1 (29 ounce) can tomato sauce",
    "1.5 cups chopped onion",
    "0.5 cup chopped celery",
    "0.25 cup chopped green bell pepper",
    "0.25 cup chili powder",
    "2 teaspoons ground cumin",
    "1.5 teaspoons garlic powder",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon white sugar",
    "0.125 teaspoon ground cayenne pepper",
    "2 cups canned red beans, drained and rinsed"
  ],
  "steps": [
    {
      "text": "Place ground beef in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add all ingredients to a large kettle. Bring to boil. Reduce heat and simmer for 1 to 1 1/2 hours, stirring occasionally.",
      "section": null,
