  "title": "Hearty Ham Casserole",
  "description": "This ham casserole has tender chunks of potatoes and leftover holiday ham baked in a velvety cream sauce with corn for a hearty, comforting dinner.",
  "authors": [
    "LINDYSUE"
  ],
  "date_published": "2000-08-30T22:22:08-04:00",
  "date_modified": "2026-01-04T11:10:42-05:00",
  "prep_time": "PT25M",
  "cook_time": "PT55M",
  "total_time": "PT80M",
  "yield": [
    "6",
    "1 (11x7-inch) casserole"
  ],
  "categories": [
    "Dinner"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 cups potatoes, cubed",
    "2 cups cooked ham, cubed",
    "1 (15.25 ounce) can whole kernel corn, drained",
    "0.25 cup finely minced fresh parsley",
    "0.25 cup butter",
    "1 tablespoon chopped onions",
    "0.33333334326744 cup all-purpose flour",
    "1.75 cups milk",
    "0.125 teaspoon ground black pepper",
    "4 ounces processed cheese food, shredded"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease an 11x7-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oCb849reGmGn40G3PUVbnXYtak0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22273-hearty-ham-casserole-VAT-step-01-6dd5d6ef43304653ae4e44ef88954981.jpg"
      ],
      "image": "assets/images/22273/step_01.webp"
    },
    {
      "text": "Bring a large pot of salted water to a boil. Cook potatoes in boiling water until tender but firm, about 15 minutes. Drain and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_cOLuE8dnemZhzl-CPBtPAQyoDo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22273-hearty-ham-casserole-VAT-step-02-4d4643fc6e2842578b9ca88544c320c5.jpg"
      ],
      "image": "assets/images/22273/step_02.webp"
    },
    {
      "text": "Combine potatoes, ham, corn, and parsley in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k1UdauHIm4LyW3aWMBfXuCB0JFA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22273-hearty-ham-casserole-VAT-step-03-c96eb59763ee4de6bc92be5e0e7e0e79.jpg"
      ],
      "image": "assets/images/22273/step_03.webp"
    },
    {
      "text": "Heat butter in a large saucepan over medium-high heat. Sauté onions in hot butter for 2 minutes, then stir in flour until blended. Pour in milk slowly, stirring constantly; season with pepper. Bring to a boil. Cook and stir for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FrtU7VrxzNaLWmHsxvrCVT_aBvw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22273-hearty-ham-casserole-VAT-step-04-d19b1c0272f443efbba48e4fa1336b53.jpg"
      ],
      "image": "assets/images/22273/step_04.webp"
    },
    {
      "text": "Pour over ham mixture; stir until combined. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k3XHLVp_dgoyw7BPC3Y1QhlT-SI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22273-hearty-ham-casserole-VAT-step-05-bb64de9f612e4accb86c5c86b2b2c7ea.jpg"
      ],
      "image": "assets/images/22273/step_05.webp"
    },
    {
      "text": "Bake, covered, in the preheated oven for 25 minutes. Uncover the dish and sprinkle with cheese. Continue baking until cheese is melted, 5 to 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k3B04IapfueV_jfq2IZH3h0Zcco=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22273-hearty-ham-casserole-VAT-step-06-137b451fb55c4627b56192cf78b18299.jpg"
      ],
      "image": "assets/images/22273/step_06.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NBIFnXKpK10qOKCOeJ74k5ezjpQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22273-hearty-ham-casserole-VAT-4x3-9ccafacd67434244bd4ca74fe1efb7d8.jpg"
      ],
      "image": "assets/images/22273/step_07.webp"
    }
