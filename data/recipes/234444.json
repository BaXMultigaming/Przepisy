  "ingredients": [
    "1.5 cups all-purpose flour",
    "1.25 cups white sugar",
    "0.75 cup butter, partially frozen and cut into cubes",
    "2 eggs, beaten",
    "0.5 cup milk",
    "0.25 cup coffee-flavored liqueur (such as Kahlua®)",
    "0.25 cup brewed coffee",
    "1 tablespoon cocoa powder",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking powder",
    "0.25 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 10x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, butter, eggs, milk, coffee-flavored liqueur, brewed coffee, cocoa powder, vanilla extract, baking powder, and baking soda together in the bowl of a stand mixer; beat until smooth. Spread batter into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes. Cool 10 minutes before cutting to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
