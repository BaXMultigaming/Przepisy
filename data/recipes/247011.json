  "ingredients": [
    "2 eggs",
    "1 cup sugar",
    "0.5 cup milk",
    "0.25 cup butter, softened",
    "1.5 cups cooked RiceSelect® Jasmati® Rice",
    "0.5 cup flaked coconut",
    "0.5 cup raisins",
    "0.25 cup applesauce",
    "1 teaspoon cinnamon",
    "1 teaspoon vanilla",
    "2 (9 inch) unbaked pie crusts",
    "Whipped cream",
    "Cinnamon",
    "Toasted coconut"
  ],
  "steps": [
    {
      "text": "Cut each piecrust in half and roll each portion to fit 4 (5-inch) mini pie pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together eggs, sugar, milk, butter, and rice until well blended; stir in remaining ingredients. Divide filling between the 4 pie pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pies on baking sheet; bake in preheated 375-degree F oven for 15 minutes. Lower to 300 F, bake for additional 15-20 minutes until center is set and crust is golden brown. (If crust begins to brown too much, cover crust edges with foil.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "If preferred, the filling can be baked in a 10-inch piecrust; just add approximately 30 extra minutes to the cooking time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
