  "ingredients": [
    "1.5 cups white sugar",
    "4 eggs, beaten until light and fluffy",
    "4 cups heavy whipping cream",
    "2 cups milk",
    "4 teaspoons vanilla extract",
    "4 teaspoons almond extract",
    "1.25 cups sliced almonds"
  ],
  "steps": [
    {
      "text": "Beat sugar into eggs in small amounts, assuring each addition dissolves completely before introducing the next.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cream, milk, vanilla extract, and almond extract into egg mixture; fold almonds into mixture.",
