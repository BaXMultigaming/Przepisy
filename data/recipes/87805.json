  "ingredients": [
    "4 thick cut boneless pork chops",
    "salt and pepper to taste",
    "1½ teaspoons black pepper",
    "1 tablespoon paprika",
    "1 tablespoon garlic powder",
    "1 tablespoon poultry seasoning",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil",
    "1 cup chicken broth",
    "2 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/boDabZQ4S1BUJ_HezsHU8vXfd0g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/87805-SlowCookerPorkChops-ddmps-step-01-f2b7da8953074ef7b210f89f72f83d1c.jpg"
      ],
      "image": "assets/images/87805/step_01.webp"
    },
    {
      "text": "Cut small slits in a diamond pattern in each pork chop with the tip of a knife; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D_aTuoALv0ktTtRSeHVpChUtOzE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/87805-SlowCookerPorkChops-ddmps-step-3-4x3-104461-a196f51223fe40bf886a0ee55ce0fb2b.jpg"
      ],
      "image": "assets/images/87805/step_02.webp"
    },
    {
      "text": "Whisk paprika, garlic powder, poultry seasoning, oregano, and basil together in a medium bowl. Remove 2 teaspoons of the spice mix to season the pork chops, rubbing it into the slits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk broth and garlic into remaining spice mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/u-LjYmbcqc1HI6Jx_xmxubd5Eyw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/87805-SlowCookerPorkChops-ddmps-step-2-4x3-104453-929b1af27f4d43d9995224d1b2488b40.jpg"
      ],
      "image": "assets/images/87805/step_04.webp"
    },
    {
      "text": "Pour broth mixture into a 6-quart slow cooker; arrange seasoned chops on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TkL4juGopYuxyflocjwgsTQ9gaQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/87805-SlowCookerPorkChops-ddmps-step-3-4x3-104470-fca00db1f5df40058dc0b2c97a434a9b.jpg"
      ],
      "image": "assets/images/87805/step_05.webp"
    },
    {
      "text": "Cover and cook on High, basting periodically with sauce, until slightly pink in the center, about 1 hour and 40 minutes. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6bwa3481LKN6Clq6JF6-Oj210e8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/87805-SlowCookerPorkChops-ddmps-step-5-d8601d14a6e946e9bba8e897a632897c.jpg"
      ],
      "image": "assets/images/87805/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DPWkVu87MMsRhOP9JiHjFoBdkAo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/87805-SlowCookerPorkChops-ddmps-4x3-104800-ce15811a852f48a09277592679c03938.jpg"
