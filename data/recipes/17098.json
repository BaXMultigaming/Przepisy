  "ingredients": [
    "1 (16 ounce) package dry ziti pasta",
    "1 pound lean ground beef",
    "1 onion, chopped",
    "2 (28 ounce) jars spaghetti sauce",
    "6 ounces sliced provolone cheese",
    "6 ounces sliced mozzarella cheese",
    "1.5 cups sour cream",
    "0.5 cup grated Parmesan cheese",
    "0.25 cup chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, brown beef over medium heat. Add onions; saute until tender. Drain off fat and add spaghetti sauce; simmer for about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a lightly greased 2 quart baking dish, place about half of the pasta; top with a layer of provolone and mozzarella cheese slices. Spread on a layer of half the spaghetti sauce mixture and sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover with remaining pasta, cheese and sauce; sprinkle a layer of Parmesan cheese and fresh basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for about 30 minutes or until cheese and sauce are bubbly; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
