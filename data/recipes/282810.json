  "ingredients": [
    "1 cup great northern beans, rinsed and drained",
    "2 medium russet potatoes, peeled and diced",
    "1 medium avocado, diced",
    "2 tablespoons prepared yellow mustard",
    "1 tablespoon nutritional yeast",
    "1 teaspoon lemon juice",
    "0.5 teaspoon coarse salt",
    "2 stalks celery, cut into 1/4-inch slices",
    "0.33333334326744 cup chopped onion"
  ],
  "steps": [
    {
      "text": "Pour great northern beans into a saucepan and cook over medium heat until very soft, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "At the same time, place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until fork-tender but not mushy, about 12 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer beans to a large bowl. Add avocado and mash. Add mustard, yeast, lemon juice, and salt; stir until mixture is smooth. Add potatoes, celery, and onion and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill for at least 30 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
