  "ingredients": [
    "3 (13.5 ounce) cans coconut milk",
    "1 large onion, chopped",
    "6 small unripe (green) bananas"
  ],
  "steps": [
    {
      "text": "Combine coconut milk and onion in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil over medium heat. Boil bananas in their skins for 30 to 40 minutes; drain. Run bananas under cold water until they are cool enough to handle. Remove bananas whole from their skins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large saucepan over medium-high heat. Place bananas into in the pan. Pour coconut milk and onion over bananas; cook until coconut milk is foamy. Allow to cool for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
