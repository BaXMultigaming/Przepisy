  "ingredients": [
    "1 cup Hidden Valley® Original Ranch® Salad Dressing",
    "4 skinless, boneless chicken breast halves - rinsed and patted dry",
    "0.25 cup seasoned panko Japanese-style bread crumbs",
    "0.25 cup shredded sharp Cheddar cheese",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the Hidden Valley® Original Ranch® Dressing into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the chicken to the bowl of dressing and mix until the chicken is evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a shallow bowl, add the breadcrumbs, Cheddar and Parmesan cheeses and stir until well combined. Dredge each breast in the bread crumb and cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange the chicken on a parchment-lined baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake the chicken for 20 to 25 minutes until the chicken is crisp and an internal temperature of 165 degrees F is reached.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
