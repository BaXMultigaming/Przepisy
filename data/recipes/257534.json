  "ingredients": [
    "2 cups fresh sweet corn kernels",
    "1 cup milk",
    "1 cup butter, melted and cooled",
    "1 cup white sugar",
    "4 eggs",
    "2 cups pancake mix, sifted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine corn, milk, butter, sugar, and eggs in a blender; blend until smooth. Pour mixture into a bowl; stir in pancake mix until batter is well blended. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
