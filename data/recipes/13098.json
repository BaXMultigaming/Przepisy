  "ingredients": [
    "1 tablespoon olive oil",
    "1 tablespoon butter",
    "1 onion, thinly sliced",
    "1 clove garlic, minced",
    "4 cups fresh sliced mushrooms",
    "1.5 cups beef broth",
    "1 cup water",
    "0.25 cup red wine",
    "0.25 cup tomato paste",
    "ground black pepper to taste",
    "0.25 cup Parmesan cheese",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Heat oil and butter in a medium saucepan until hot. Add onion and garlic and cook until translucent, about 5 minutes. Add mushrooms and sauté until soft, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in broth, water, and wine. Add tomato paste and season with pepper. Cook until heated through, 6 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle into bowls and garnish with Parmesan and parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
