  "title": "Seafood Salad Supreme",
  "description": "Shrimp and crabmeat, mixed with seashell pasta, red pepper, and mozzarella cheese, to form a delicious salad that everyone will enjoy.",
  "authors": [
    "fuzziepuppy"
  ],
  "date_published": "2000-02-26T13:08:43-05:00",
