  "ingredients": [
    "1 cup unsalted raw cashews",
    "1 (4 ounce) can chopped green chile peppers",
    "0.25 cup hemp milk",
    "0.5 jalapeno pepper with seeds, or more to taste",
    "0.5 teaspoon salt",
    "1.25 cups chopped fresh cilantro",
    "3 cups water",
    "1.5 cups quinoa",
    "2 romaine hearts, chopped",
    "2 (15 ounce) cans black beans, rinsed and drained",
    "3 cups chopped red bell pepper",
    "0.5 cup chopped red onion",
    "2 avocados, chopped"
  ],
  "steps": [
    {
      "text": "Combine cashews, green chile peppers, hemp milk, jalapeno pepper, and salt in a blender; process until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cashew mixture into a small bowl; stir in 1 cup cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide romaine lettuce among 4 bowls. Top with quinoa, black beans, red bell pepper, and onion. Drizzle cilantro sauce on top. Garnish with remaining 1/4 cup cilantro and chopped avocados.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
