  "ingredients": [
    "1 (28 ounce) can baked beans with pork",
    "1 medium onion, diced",
    "1 medium bell pepper, diced",
    "4 links spicy pork sausage, cut into chunks",
    "2 tablespoons chili powder",
    "3 tablespoons Worcestershire sauce",
    "4 tablespoons vinegar",
    "0.5 cup packed brown sugar",
    "0.5 cup ketchup",
    "1 teaspoon garlic powder",
    "salt to taste",
    "1 dash cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a Dutch oven, combine the baked beans, onion, bell pepper, and sausage. Season with chili powder, Worcestershire sauce, vinegar, brown sugar, ketchup, garlic powder and salt. Add a dash of cayenne if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake for one hour in the preheated oven.",
