  "ingredients": [
    "3 cups white sugar",
    "2.75 cups all-purpose flour",
    "1 cup unsweetened cocoa powder",
    "2 tablespoons unsweetened cocoa powder",
    "2.25 teaspoons baking soda",
    "2.25 teaspoons baking powder",
    "1 teaspoon salt",
    "1.5 cups milk",
    "0.75 cup vegetable oil",
    "3 eggs",
    "1 tablespoon vanilla extract",
    "1.5 cups hot water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line the bottom and sides of a deep 14x17-inch baking sheet with parchment or waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift sugar, flour, 1 cup plus 2 tablespoons cocoa powder, baking soda, baking powder, and salt together in a large bowl. Transfer to a stand mixer fitted with a whisk attachment; whisk dry ingredients together on low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, vegetable oil, eggs, and vanilla extract together in a separate medium bowl. Add to the flour mixture and mix at low speed until well incorporated, about 5 minutes. Gradually add hot water while mixer is on low speed until just combined. Pour batter into the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cake comes out clean, 25 to 30 minutes. Let cake cool in the pan for about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
