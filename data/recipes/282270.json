  "ingredients": [
    "3 tablespoons Country Crock® Spread, melted",
    "3 tablespoons chopped fresh cilantro",
    "2 tablespoons lime juice",
    "2 tablespoons honey",
    "2 cloves garlic, chopped",
    "1 teaspoon ground cumin",
    "0.25 teaspoon chipotle chili powder, or more to taste",
    "0.5 teaspoon salt",
    "1 pound large shrimp, peeled, deveined and tails on"
  ],
  "steps": [
    {
      "text": "Combine Country Crock® Spread, cilantro, lime juice, honey, garlic, cumin, chipotle chili powder, and salt in non-aluminum dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reserve half of Country Crock® Spread mixture. Add shrimp and toss to coat. Cover and marinate 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Skewer shrimp. Grill or broil shrimp, turning once and brushing with reserved Spread mixture, 5 minutes or until shrimp turn pink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve shrimp in tortillas and, if desired with black beans, Mexican crema, diced avocado, and chopped cilantro. Garnish with lemons or limes if desired.",
