  "ingredients": [
    "2 tablespoons butter",
    "4 teaspoons all-purpose flour",
    "0.75 cup milk",
    "2 tablespoons lemon juice",
    "0.25 teaspoon salt",
    "0.125 teaspoon cayenne pepper"
  ],
  "steps": [
    {
