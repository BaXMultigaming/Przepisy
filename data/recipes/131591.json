  "ingredients": [
    "1 cup whole cranberries",
    "0.5 cup fresh orange juice",
    "1 tablespoon orange zest",
    "2 tablespoons white sugar",
    "0.75 cup cashew halves",
    "6 cups chopped cooked turkey",
    "2 celery ribs, diced",
    "0.75 cup mayonnaise, or to taste",
    "2 tablespoons applesauce",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon ground dried sage",
    "0.25 teaspoon dried thyme",
    "ground black pepper, to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line a baking pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the cranberries, orange juice, orange zest, and sugar into a pan. Bring to a boil, and cook, stirring occasionally, until almost all the liquid has cooked away, about 5 minutes. Remove from the heat, and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cashews on prepared baking pan. Roast in preheated oven until golden brown, 10 to 12 minutes. Remove, and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the turkey together in a large bowl with the celery, mayonnaise, applesauce, salt, sage, thyme, and pepper until evenly blended. Fold in the cranberry mixture. Refrigerate at least 2 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
