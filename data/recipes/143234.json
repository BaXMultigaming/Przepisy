  "ingredients": [
    "8 slices pumpernickel bread",
    "1 cup Thousand Island dressing",
    "0.75 pound deli sliced corned beef",
    "0.5 pound sliced Swiss cheese",
    "1 cup sauerkraut"
  ],
  "steps": [
    {
      "text": "Preheat a grill for low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut 4 large squares of aluminum foil. Place 2 slices of bread side-by-side on each piece of foil. Spread the bread slices with Thousand Island dressing. Evenly divide the corned beef, Swiss cheese, and sauerkraut among the bread. Top with a second slice of bread to make a sandwich. Wrap the foil snugly around the sandwich to make a sealed packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the packets on the preheated grill. Cook, turning every 10 minutes, until the bread is lightly toasted and cheese melted, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
