  "title": "Pasta Chickpea Salad",
  "description": "A flavorsome pasta salad with chickpeas, olives, green onions, peas, and herbs. Parmesan cheese stirred in just before chilling adds creaminess.",
  "authors": [
    "Anita Hughes"
  ],
  "date_published": "1999-08-10T09:55:52-04:00",
