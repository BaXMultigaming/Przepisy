  "ingredients": [
    "1 pound ground beef chuck",
    "0.5 cup chopped onion",
    "0.5 teaspoon garlic powder",
    "1.5 cups barbeque sauce",
    "1 (10 ounce) package refrigerated biscuit dough",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease 8 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet or frying pan, cook ground chuck with onion and garlic powder until evenly brown; drain off the grease. Stir in the barbeque sauce and simmer for another 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out each biscuit on a floured surface so that each biscuit is 6 inches across. Put the biscuit in the muffin tin and fold up sides to create a cup shape. Fill each biscuit fill almost to the top with the meat mixture; top with cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until biscuits are baked, cheese is melted and tops are golden brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
