  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s_MfGsrkgNeB88pcDrOz7p355vk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272347-air-fryer-roasted-bananas-ddmfs-step-1-3-1362-4x3-17501b81ab2445c39243c55493f957de.jpg"
      ],
      "image": "assets/images/272347/step_01.webp"
    },
    {
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C) according to manufacturer's instructions. Line the air fryer basket, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place banana slices into the basket, making sure that they are not touching; cook in batches if necessary. Mist banana slices with avocado oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H_MvNSNkp5kmoDn4-7AUjRK_SR0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272347-air-fryer-roasted-bananas-ddmfs-step-2-1363-4x3-10b5f71d9fc04234b0a4e6bce90fe159.jpg"
      ],
      "image": "assets/images/272347/step_03.webp"
    },
    {
      "text": "Cook in the air fryer for 5 minutes. Remove the basket and flip banana slices carefully (they will be soft). Cook until banana slices are browned and caramelized, an additional 2 to 3 minutes. Carefully remove from basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AxK3SRWW5OCt6B4fgLPQNU04dZs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272347-air-fryer-roasted-bananas-ddmfs-step-3-1364-4x3-6bf804a2b14d45d6a77832aee8c0d11a.jpg"
