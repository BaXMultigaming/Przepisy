  "ingredients": [
    "0.25 cup brown sugar",
    "0.5 teaspoon garlic powder",
    "2 teaspoons dried sage, divided",
    "0.25 teaspoon dried rosemary",
    "salt and ground black pepper to taste",
    "2 (6 ounce) pork chops",
    "1.5 tablespoons olive oil",
    "1 teaspoon butter",
    "1 cup apple cider",
    "2 teaspoons honey"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, garlic powder, 1 teaspoon sage, rosemary, salt, and pepper in a bowl. Dredge pork chops in seasoning mixture until coated thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil and butter in an oven-safe skillet over medium heat until butter is frothy, 1 to 2 minutes. Brown pork chops in the hot skillet on each side, 7 to 10 minutes total. Add apple cider, remaining sage, and drizzle in honey. Reduce heat to low and simmer for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the skillet to the oven and bake until pork chops are no longer pink in the centers, 10 to 15 minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the skillet from the oven and plate pork chops with sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
