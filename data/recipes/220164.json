    {
      "text": "Heat olive oil in a skillet over medium heat; cook and stir onion, bell pepper, and garlic, onion in the hot oil until softened, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
