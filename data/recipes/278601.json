  "ingredients": [
    "1 cup unsalted butter, softened",
    "3 cups confectioners' sugar",
    "2 tablespoons heavy cream",
    "0.33333334326744 cup cherry preserves, or more to taste",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Cream butter in a bowl with an electric mixer on medium speed until fluffy. Beat in confectioners' sugar gradually until light and fluffy.",
