  "ingredients": [
    "1 quart oil for frying, or as needed",
    "1 large onion, diced",
    "0.5 cup white sugar",
    "2 large eggs, beaten",
    "1 cup self-rising flour",
    "1 cup self-rising cornmeal"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
