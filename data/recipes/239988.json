  "ingredients": [
    "2 cups Cinnamon Chex™ cereal",
    "2 cups Wheat Chex™ cereal",
    "2 cups Banana Nut Cheerios™ cereal",
    "0.5 cup walnuts",
    "0.25 cup butter or margarine",
    "0.25 cup packed brown sugar",
    "2 tablespoons corn syrup",
    "1 teaspoon vanilla",
    "0.5 teaspoon ground cinnamon",
    "2 ounces freeze-dried bananas with cinnamon"
  ],
  "steps": [
    {
      "text": "In large microwavable bowl, measure cereals and walnuts; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In 2-cup microwavable measuring cup, microwave butter until melted, about 30 seconds. Stir in brown sugar and corn syrup; microwave 30 seconds longer or until mixture is boiling. Stir in vanilla and cinnamon. Pour over cereals, stirring until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave uncovered on High about 3 minutes, stirring every minute, until mixture is glazed. Stir in dried bananas. Spread on waxed paper to cool. Store in airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
