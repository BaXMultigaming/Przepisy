  "ingredients": [
    "1 tablespoon olive oil",
    "1 (8 ounce) jar mushroom stems and pieces, drained",
    "1 medium onion, coarsely chopped",
    "6 cups vegetable broth",
    "1 tablespoon soy sauce",
    "1 tablespoon oyster sauce"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large pot over medium-high heat. Add mushrooms and onion; cook until onions are transparent, about 5 minutes. Add vegetable broth, soy sauce, and oyster sauce and bring to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce the heat to low. Cover and cook for 1 to 3 hours. The longer it cooks, the more flavorful it becomes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
