  "ingredients": [
    "1 package Duncan Hines® Moist Deluxe® Spice Cake Mix",
    "1.25 cups applesauce",
    "3 large eggs",
    "0.33333334326744 cup vegetable oil",
    "1 cup chopped nuts",
    "1 container Duncan Hines® Creamy Home-Style Classic Vanilla Frosting",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 13x9-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make cake: Beat cake mix, applesauce, eggs, and oil in a large bowl with an electric mixer at medium speed for 2 minutes. Stir in nuts until combined. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, about 40 minutes. Cool in the pan for 15 minutes before inverting onto a cooling rack. Turn cake right-side up and allow to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make frosting: Combine vanilla frosting and cinnamon in a medium bowl; stir until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread frosting over cooled cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
