  "ingredients": [
    "1 pound extra lean ground beef",
    "1 (8.8 ounce) pouch UNCLE BEN'S® Ready Rice® Long Grain & Wild",
    "0.75 cup water",
    "1 (1.25 ounce) package taco seasoning mix",
    "0.5 cup frozen whole kernel corn, thawed",
    "1 cup shredded white Cheddar cheese",
    "2 green onions, sliced",
    "1 (12 ounce) bag tortilla chips"
  ],
  "steps": [
    {
      "text": "Heat a large nonstick skillet over medium heat. Cook ground beef, crumbling as it cooks, until browned, about 8 minutes. Drain liquid from pan. Add water and taco seasoning to beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook rice according to package directions. Add cooked rice to beef mixture; stir in corn. Increase heat and bring to a boil. Simmer until liquid is absorbed, about 7 minutes, stirring constantly. Remove pan from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle in the cheese and mix to incorporate. Top with green onions if desired. Serve with tortilla chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
