  "ingredients": [
    "1 (12 ounce) package rotini pasta",
    "0.25 cup butter",
    "2 sweet onions, chopped",
    "1 (26 ounce) can tomato soup (such as Campbell's®)",
    "1 (16 ounce) package hot dogs (such as Oscar Mayer®), sliced 1/4 inch thick",
    "1 (15.25 ounce) can whole kernel corn, undrained",
    "4 teaspoons dill pickle relish",
    "1 tablespoon prepared yellow mustard"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TXImNZX5cGRDMJ48eTHoGIbp0jM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231624-mommas-hot-dog-casserole-VAT-001-step-01-005912e3b9e54436b1856c3ca0ac82b7.jpg"
      ],
      "image": "assets/images/231624/step_01.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil; cook rotini at a boil until tender yet firm to the bite, about 8 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IiMsn-Q5Bhnb-WLKzaZG4CPevMM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231624-mommas-hot-dog-casserole-VAT-002-step-02-b696a2c8a990435da559ce4d92654dcc.jpg"
      ],
      "image": "assets/images/231624/step_02.webp"
    },
    {
      "text": "Meanwhile, melt butter in a large skillet over medium heat; cook and stir onions until translucent, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AqIHB4MfiqxjWNdkk4r6Jxu9LY0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231624-mommas-hot-dog-casserole-VAT-003-step-03-31043842ab7a45c0a4bb9e9a26475b30.jpg"
      ],
      "image": "assets/images/231624/step_03.webp"
    },
    {
      "text": "Transfer onions to a large bowl and mix in pasta, tomato soup, hot dogs, corn with juice, dill pickle relish, and yellow mustard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7CumB1EYAqbf6n3V_XktyS6LjMg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231624-mommas-hot-dog-casserole-VAT-004-step-04-92dfd5d80b6c4be2aa5884d95b3ccb04.jpg"
      ],
      "image": "assets/images/231624/step_04.webp"
    },
    {
      "text": "Pour mixture into a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fm4xi5P5tsDT_Uluft7JfOx5wUY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231624-mommas-hot-dog-casserole-VAT-005-step-05-edf54d985cce4ddca6febc6e5acafe8f.jpg"
      ],
      "image": "assets/images/231624/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until bubbling and top is lightly browned, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f8tuquWQLfDSqMW0vGmmtBkue0Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231624-mommas-hot-dog-casserole-VAT-006-step-06-5c7785fe7174447694a462cc3056cf94.jpg"
      ],
      "image": "assets/images/231624/step_06.webp"
    }
