  "ingredients": [
    "1 cup frozen cut green beans",
    "1 cup frozen lima beans",
    "1 cup drained and rinsed canned red beans",
    "0.5 cup frozen red bell pepper strips",
    "0.5 cup chopped onion",
    "2 tablespoons canola oil",
    "0.25 cup apple cider vinegar",
    "2 teaspoons white sugar",
    "0.5 teaspoon garlic powder",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine green beans, lima beans, red beans, red bell pepper, and onion in a large bowl with a tight-fitting lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together canola oil, apple cider vinegar, sugar, garlic powder, salt, and black pepper in a small bowl. Pour mixture over bean mixture. Seal lid and shake bowl until evenly coated. Refrigerate for 24 hours or until all ingredients are completely thawed. Shake well before serving.",
      "section": null,
