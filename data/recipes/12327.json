  "ingredients": [
    "3 eggs",
    "0.25 teaspoon salt",
    "0.75 cup white sugar",
    "0.5 cup butter, melted",
    "1 cup dark corn syrup",
    "1.5 cups pecan halves",
    "1 recipe pastry for a 9 inch single crust pie"
  ],
  "steps": [
    {
      "text": "Bake pie shell at 450 degrees F (230 degrees C) for 5 minutes. Cool. Turn oven down to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and salt until very light and lemon colored. Beat in sugar a little at a time. With a wire whisk, fold in melted butter or margarine, and corn syrup. Pour into partially baked shell. Arrange pecan halves on top, broken side down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 minutes, and reduce heat to 325 degrees F (165 degrees C). Bake for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
