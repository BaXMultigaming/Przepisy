  "ingredients": [
    "1 cup softened butter",
    "0.75 cup white sugar",
    "0.75 cup packed brown sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "0.66666668653488 cup cocoa powder",
    "1 teaspoon baking soda",
    "0.5 cup chopped pecans",
    "1 (8 ounce) package cream cheese",
    "0.5 cup white sugar",
    "1 egg",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Beat butter, white sugar, and brown sugar together in a large bowl using an electric mixer until smooth. Beat in eggs and vanilla extract until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cocoa powder, and baking soda together in a bowl. Add flour mixture to butter mixture. Fold in nuts. Refrigerate dough for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While dough is chilling, beat cream cheese, sugar, egg, and vanilla extract together in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove dough from fridge and form about 1 tablespoon dough into a ball; make an indentation and fill with about 1 teaspoon filling. Place cookie on an ungreased baking sheet. Repeat with remaining dough and filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 11 to 13 minutes. Allow cookies to cool completely before removing from the baking sheet, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
