  "ingredients": [
    "cooking spray",
    "1 cup all-purpose flour",
    "2.5 teaspoons baking soda",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "1 pinch ground cinnamon, or to taste",
    "0.5 cup soy milk",
    "0.25 cup vegetable oil",
    "0.5 teaspoon apple cider vinegar",
    "0.5 teaspoon vanilla extract",
    "1 cup confectioners' sugar",
    "1 tablespoon soy milk",
    "1 dash vanilla extract, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a mini doughnut pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, nutmeg, salt, and cinnamon together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix soy milk, vegetable oil, vinegar, and vanilla extract together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the flour mixture and the soy milk mixture and stir until smooth; pour into a mini doughnut pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until doughnuts are light brown and the tops spring back when touched, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine confectioners' sugar, soy milk, and vanilla extract together in a bowl; stir until glaze is combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip doughnuts into glaze and cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
