  "ingredients": [
    "3 cups crushed digestive biscuits",
    "5 tablespoons butter, at room temperature",
    "0.33333334326744 cup white sugar",
    "3 egg yolks",
    "1 tablespoon thinly sliced calamansi peel",
    "1 (14 ounce) can sweetened condensed milk",
    "0.66666668653488 cup calamansi juice",
    "1 cup heavy whipping cream",
    "2 tablespoons confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine biscuit crumbs, butter, and sugar in a bowl; press into bottom and up sides of a 9-inch tart pan using your fingers and the back of a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 7 to 8 minutes. Cool crust (leave the oven on).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat egg yolks and calamansi peel in a bowl with an electric mixer on high speed until light and fluffy. Reduce speed to medium, gradually beat in condensed milk, until smooth and thick; stir in calamansi juice until well combined. Pour filling into tart shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center is set but not brown, about 10 minutes. Cool on a wire rack, about 30 minutes. Refrigerate until chilled, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat heavy cream and confectioners' sugar together in a bowl until stiff peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve tart with whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
