  "ingredients": [
    "2.5 cups elbow macaroni",
    "0.25 cup butter",
    "0.25 cup all-purpose flour",
    "0.5 teaspoon salt",
    "4 cups milk",
    "1 pound shredded Cheddar cheese",
    "0.25 cup butter, melted",
    "1 sleeve buttery round crackers, crushed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h46fKrv46sT9c0EBhzdtu6Vdw_8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-102393-baked-homemade-macaroni-and-cheese-VAT-step-01-204c95f2447a4b30b674e86cf66e409e.jpg"
      ],
      "image": "assets/images/102393/step_01.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes; drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7R7SbY5Zn11ExFzVSxQ1nzP9kXU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-102393-baked-homemade-macaroni-and-cheese-VAT-step-02-316bcd410efc40ab962c905353c4b44a.jpg"
      ],
      "image": "assets/images/102393/step_02.webp"
    },
    {
      "text": "Melt 1/4 cup butter in a large saucepan over medium heat. Stir in flour and salt; cook, stirring constantly, for 2 minutes. Whisk in milk and simmer, stirring frequently, until mixture thickens slightly, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-ybhIIxHj_zCKACMkr-wIH6QDDA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-102393-baked-homemade-macaroni-and-cheese-VAT-step-03-6024c4b2c7eb44d0a0dd87e06163103e.jpg"
      ],
      "image": "assets/images/102393/step_03.webp"
    },
    {
      "text": "Turn off the heat and stir in Cheddar cheese, in batches, until cheese is melted. Add macaroni and stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oeYm6LeqKrHYxQUmeUVO1PhdZoI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-102393-baked-homemade-macaroni-and-cheese-VAT-step-04-1pastastirred-edd230b3b2e7400386e4d6947459d2bf.jpg"
      ],
      "image": "assets/images/102393/step_04.webp"
    },
    {
      "text": "Pour into a 9x13-inch baking dish. Mix the remaining 1/4 cup of melted butter and crushed crackers together in a bowl; scatter evenly over macaroni mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0Saa6AXbgqEgLStzfIkerwGZGvE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-102393-baked-homemade-macaroni-and-cheese-VAT-step-05-ff8a26e91b0641afbd323060ccea0e49.jpg"
      ],
      "image": "assets/images/102393/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown on top, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fuUNdIoUPfTBjruDx9WFjpM9QZc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-102393-baked-homemade-macaroni-and-cheese-VAT-step-06-cbab69eb23cb4ab29033eb518240d77b.jpg"
      ],
      "image": "assets/images/102393/step_06.webp"
    }
