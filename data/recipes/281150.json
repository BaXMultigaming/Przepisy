  "ingredients": [
    "1 (16 ounce) package baby carrots",
    "1 large onion, sliced into rings",
    "2 tablespoons olive oil",
    "0.5 tablespoon freeze-dried dill",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine carrots and onion slices in a large bowl. Whisk olive oil, dill, salt, and pepper together in a separate bowl until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour seasoned oil over the carrots and onions. Stir until evenly coated. Spread the mixture out evenly on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast vegetables until soft, stirring halfway through, about for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
