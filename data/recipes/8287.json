  "ingredients": [
    "1 cup white sugar",
    "0.5 cup shortening",
    "1.5 cups applesauce",
    "2 tablespoons molasses",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "0.5 teaspoon salt",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, sift together the flour, baking soda, cinnamon, cloves and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream the sugar and shortening until fluffy. Add applesauce and molasses and mix in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually add the flour mixture and beat well to moisten. Fold in the raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into a prepared fluted or straight sided tube pan. Bake at 350 degrees F (175 degrees C) for 45 minutes, or until toothpick inserted into the middle of cake comes out clean. Cake will not rise to top of pan. Cool for 10 minutes and remove from pan and cool on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
