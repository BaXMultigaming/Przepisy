  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "0.25 cup brown sugar",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "1 (15 ounce) can pumpkin puree",
    "3.5 tablespoons canola oil",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CNPy4VTd3suf1Hfj05Vomw_DGN4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-235259-vegan-pumpkin-pie-blondies-ddmfs-step1-3x4-13221-c191dc3c91de48229da3a36da2459271.jpg"
      ],
      "image": "assets/images/235259/step_01.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, white sugar, brown sugar, baking powder, baking soda, cinnamon, cloves, ginger, nutmeg, and salt together in a bowl. Add pumpkin puree, canola oil, and vanilla extract to the flour mixture and stir until a thick batter forms. Pour batter into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-8ZJmw6426LfBlCWp0uxFVrbLAE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-235259-vegan-pumpkin-pie-blondies-ddmfs-step3-3x4-13225-d37b5626346b40379ce4c782176901ee.jpg"
      ],
      "image": "assets/images/235259/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RRmF_i5wS5vlaPtXPjV3P_mMTkk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-235259-vegan-pumpkin-pie-blondies-ddmfs-step5-3x4-13327-a977ccea23f8431f95276a13281c7b3a.jpg"
      ],
      "image": "assets/images/235259/step_04.webp"
    },
    {
      "text": "Remove from the oven and cool completely before cutting into 1 1/2-inch squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Que6Gm_LEpSCoUhhCnCzatmb6wM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-235259-vegan-pumpkin-pie-blondies-ddmfs-step6-3x4-13328-5510480f71f345c6b57fc26cff710d5b.jpg"
