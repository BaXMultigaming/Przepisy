  "ingredients": [
    "2 cups cold mashed potatoes",
    "1 cup shredded Cheddar cheese",
    "3 green onions, chopped",
    "0.25 cup real bacon bits",
    "2 tablespoons all-purpose flour",
    "1 small egg, beaten"
  ],
  "steps": [
    {
      "text": "Combine mashed potatoes, Cheddar cheese, green onions, bacon bits, and flour in a bowl; stir until combined. Mix in beaten egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat air fryer to 400 degrees F (200 degrees C) for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form mixture into 6 patties and set on a baking sheet. Place baking sheet in the freezer for 10 minutes while you preheat the air fryer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place patties in the air fryer basket in batches, making sure to not overcrowd. Cook undisturbed for 12 minutes. Repeat with remaining patties.",
      "section": null,
