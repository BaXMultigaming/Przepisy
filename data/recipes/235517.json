  "ingredients": [
    "2 cups brown sugar",
    "0.5 cup unsalted butter, softened",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, butter, eggs, and vanilla extract together in a bowl using an electric mixer until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a separate bowl. Stir flour mixture into butter mixture until dough is fully combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour confectioners' sugar onto a large plate. Spoon dough, 1 1/2 teaspoons per cookie, onto confectioners' sugar and roll to coat. Arrange coated dough on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 12 to 14 minutes. Cool cookies on baking pan for 2 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
