  "ingredients": [
    "2.5 cups pecan halves",
    "1.5 cups rolled oats",
    "6 large over-ripe bananas, mashed",
    "1 cup cane sugar",
    "1.75 cups white whole wheat flour",
    "1 tablespoon baking powder",
    "0.5 cup coconut oil, melted",
    "1 teaspoon sea salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line two 9x5-inch loaf pans with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Process pecan halves in a food processor until a flour forms; transfer to a bowl. Process oats in the food processor until a flour forms; add to pecan flour. Mix bananas and sugar together in a bowl; add to pecan flour mixture. Stir white whole wheat flour, baking powder, coconut oil, and salt into pecan flour mixture until batter is thick and well mixed. Spoon batter into prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a loaf comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
