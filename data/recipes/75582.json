  "ingredients": [
    "1 pound bacon",
    "1 large onion, chopped",
    "3 cups sliced fresh or frozen okra",
    "1 (14.5 ounce) can chicken broth",
    "1 cup uncooked rice",
    "1.5 cups water"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large, deep skillet over medium-high heat until evenly browned, 7 to 9 minutes. Drain all but 1 tablespoon grease from the skillet. Crumble bacon and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat reserved bacon grease in the skillet over medium-high heat. Add onion and sauté until tender, about 3 minutes. Add crumbled bacon, okra, and chicken broth. Reduce heat and simmer until okra is tender and falling apart, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add rice to the skillet and pour in water. Cover and simmer until rice is fluffy, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
