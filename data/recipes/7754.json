  "ingredients": [
    "2.5 cups all-purpose flour",
    "1 tablespoon baking soda",
    "1 pinch salt",
    "1 cup white sugar",
    "0.75 cup light brown sugar",
    "0.5 cup unsalted butter, softened",
    "2 eggs",
    "4 ripe bananas, mashed",
    "0.66666668653488 cup buttermilk",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 8-inch round pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour, baking soda, and salt in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream white sugar, brown sugar, and butter in a large bowl until light and fluffy. Beat in eggs, one at a time. Mix in mashed bananas. Add flour mixture alternately with buttermilk, mixing well after each addition. Stir in chopped walnuts. Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake springs back when gently pressed, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cake layers from the oven and place them on a damp tea towel to cool.",
      "section": null,
      "name": null,
      "url": null,
