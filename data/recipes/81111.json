  "ingredients": [
    "1 eggplant",
    "1 teaspoon vegetable oil",
    "1 medium onion, chopped",
    "2 roma (plum) tomatoes, chopped",
    "0.25 teaspoon ground cayenne pepper",
    "0.25 teaspoon salt",
    "0.25 teaspoon pepper",
    "4 sprigs chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Preheat the oven broiler. Place eggplant in a roasting pan, and broil 5 minutes, turning occasionally, until about 1/2 the skin is scorched.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggplant in microwave safe dish. Cook 5 minutes on High in the microwave, or until tender. Cool enough to handle, and remove skin, leaving some scorched bits. Cut into thick slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat, stir in the onion, and cook until tender. Mix in eggplant, and tomatoes. Season with cayenne pepper, salt, and black pepper. Continue to cook and stir until soft. Garnish with cilantro to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
