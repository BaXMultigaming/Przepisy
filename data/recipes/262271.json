  "ingredients": [
    "2 celeriac (celery root), peeled and cut into quarters",
    "2 cups water",
    "1 tablespoon salt, or as needed",
    "1 large onion, finely chopped",
    "5 tablespoons white vinegar",
    "2 tablespoons white sugar",
    "1 tablespoon rapeseed oil"
  ],
  "steps": [
    {
      "text": "Combine celeriac pieces, water, and 1 tablespoon salt in a saucepan, bring to a boil and cook until celeriac is soft, 15 to 20 minutes. Drain, reserving cooking liquid, and set aside to cool, about 1 hour. Cube celeriac and place in a bowl with onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together cooled cooking liquid, vinegar, and sugar. Pour over celeriac and onion. Add oil and mix well. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
