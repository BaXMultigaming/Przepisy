  "ingredients": [
    "6 thick slices bacon",
    "1.5 teaspoons olive oil",
    "0.5 cup chopped onion",
    "0.5 cup chopped carrots",
    "1 stalk celery, chopped",
    "4 cups low fat, low sodium chicken broth",
    "4 cups cubed potatoes",
    "0.125 teaspoon cayenne pepper",
    "0.5 cup shredded Cheddar cheese",
    "0.5 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "Cook bacon in a 3-quart saucepan over medium-high heat, turning occasionally, until evenly browned and crisp, about 10 minutes. Drain on a paper towel-lined plate. Discard bacon grease and wipe the pan thoroughly with a paper towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/olqNC1fFhgilIf5lZwxYWeqzWgo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13076_BaconandPotatoSoup_ddmfs_step1_4x3_2027-453314a62b1840e4ac9f7c1c0941f815.jpg"
      ],
      "image": "assets/images/13076/step_01.webp"
    },
    {
      "text": "Heat olive oil in the same saucepan over medium heat. Sauté onion, carrots, and celery in hot oil until onion is soft but not brown, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_SY9vzO79U56HD0MxixLNN3YLw0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13076_BaconandPotatoSoup_ddmfs_step2_4x3_2035-092c41a2a5834c0cbb42f205221d1631.jpg"
      ],
      "image": "assets/images/13076/step_02.webp"
    },
    {
      "text": "Stir in broth, potatoes, and cayenne pepper; bring to a boil, reduce heat, and simmer, covered, until potatoes are tender, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-HPg4RAE1OJy1qw28WIVrHsxiW8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13076_BaconandPotatoSoup_ddmfs_step4_4x3_2047-d0602973c96b4de6b6fa6bf869ef8b52.jpg"
      ],
      "image": "assets/images/13076/step_03.webp"
    },
    {
      "text": "Stir in cheese, heating just until melted; do not boil. Chop bacon and add to soup. Season with salt and serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UxVjzP7xGIBnKTMBGXkEx9-tank=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13076_BaconandPotatoSoup_ddmfs_step4_4x3_2050-a180f3c2bea34a7eb19f12e1a4cf203b.jpg"
      ],
      "image": "assets/images/13076/step_04.webp"
    }
