  "title": "Bacon and Potato Soup",
  "description": "This potato soup features sautéed onion, carrot, and celery cooked in chicken broth and mixed with cheese and crumbled bacon for a hearty winter dish.",
  "authors": [
    "Kwollak"
  ],
  "date_published": "1999-02-20T10:35:13-05:00",
