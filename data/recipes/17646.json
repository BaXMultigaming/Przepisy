  "title": "Chicken and Mushroom Tetrazzini",
  "description": "This baked chicken tetrazzini recipe with spaghetti and mushrooms has a creamy homemade white sauce flavored with Parmesan cheese.",
  "authors": [
    "Mary"
  ],
  "date_published": "2000-04-24T15:19:44-04:00",
