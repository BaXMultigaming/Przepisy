  "ingredients": [
    "1 (4 ounce) package cream cheese, softened",
    "1 tablespoon heavy whipping cream",
    "1 (9 inch) prepared shortbread pie crust (such as Keebler®)",
    "2 cups fresh strawberries, quartered",
    "2 cups fresh strawberries, mashed",
    "1 cup white sugar",
    "0.25 cup cornstarch",
    "1 cup heavy whipping cream",
    "2 tablespoons white sugar",
    "0.25 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Beat cream cheese and 1 tablespoon heavy cream together in a bowl. Spread into bottom of pie crust. Arrange 2 cups quartered strawberries onto cream cheese layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 cups mashed strawberries, 1 cup sugar, and cornstarch in a saucepan; cook over medium heat until slightly reduced and thickened, about 10 minutes. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cooled mashed strawberry mixture over quartered strawberries in pie crust. Refrigerate until set, 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 cup heavy cream, 2 tablespoons sugar, and vanilla extract in a bowl until light and fluffy, about 5 minutes. Spread over cooled pie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
