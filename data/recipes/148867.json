  "ingredients": [
    "2 eggs",
    "0.5 cup milk",
    "0.5 cup blue cheese salad dressing",
    "1 teaspoon cornstarch",
    "0.25 cup thawed frozen chopped spinach",
    "1 (12 ounce) can solid white tuna packed in water, drained",
    "3 slices bacon strips, cooked and chopped",
    "6 ounces Swiss cheese, shredded",
    "1 (9 inch) unbaked pie shell"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together eggs, milk, blue cheese dressing, and cornstarch in a bowl until smooth. Fold in spinach, tuna, bacon, and Swiss cheese until evenly mixed. Pour into pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a knife inserted into the center comes out clean, 30 to 35 minutes.",
      "section": null,
