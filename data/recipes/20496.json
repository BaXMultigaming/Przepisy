  "ingredients": [
    "0.5 cup vegetable oil",
    "0.75 cup white sugar",
    "2 eggs",
    "1 cup milk",
    "0.5 teaspoon salt",
    "1 tablespoon baking powder",
    "3 cups quick cooking oats",
    "0.5 cup raisins",
    "2 tablespoons brown sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Beat together oil and sugar. Mix in eggs, milk, salt, baking powder, oatmeal. Beat well then stir in raisins. Pour into a lightly grease pie pan. Sprinkle with brown sugar and cinnamon. Refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "The next morning, preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until firm, about 35 minutes. Serve hot.",
