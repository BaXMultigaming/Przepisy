  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup whole wheat flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking soda",
    "2.5 teaspoons baking powder",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon ground nutmeg",
    "0.33333334326744 cup vegetable oil",
    "0.75 cup brown sugar",
    "2 eggs",
    "0.33333334326744 cup orange juice",
    "1 cup pumpkin puree"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, salt, baking soda, baking powder, allspice and nutmeg. In a large bowl, beat together vegetable oil, brown sugar, eggs, orange juice and pumpkin. Stir flour mixture into pumpkin mixture until just combined. Pour batter into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 50 to 60 minutes, until a toothpick inserted into center of the loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
