  "steps": [
    {
      "text": "Squeeze lime quarters into a sturdy glass pitcher. Toss juiced limes into the pitcher along with mint, strawberries, and sugar. Crush fruits together with a muddler to release juices from strawberries and oil from mint leaves. Stir in carbonated water until sugar is dissolved.",
      "section": null,
      "name": null,
