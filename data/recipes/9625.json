  "ingredients": [
    "2 cups raisins",
    "1 cup white sugar",
    "3 eggs",
    "2.5 tablespoons cornstarch",
    "1.5 cups sour cream",
    "1 teaspoon ground cinnamon",
    "1 cup packed brown sugar",
    "1.75 cups rolled oats",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.75 cups all-purpose flour",
    "1 cup butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F. Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook raisins, white sugar, eggs, cornstarch, sour cream, and cinnamon in a saucepan over low heat, stirring often, until well blended. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, oats, baking soda, salt, flour, and butter together in a bowl until crumbly. Press 1/2 of the mixture into the prepared baking dish. Pour the cooked mixture over the crust, then crumble the remaining crust mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Cut into 30 bars when cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
