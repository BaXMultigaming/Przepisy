  "ingredients": [
    "2 cups mayonnaise",
    "1 cup sweet pickle relish",
    "2 teaspoons salt",
    "0.5 teaspoon freshly ground black pepper",
    "2 pounds smoked boneless ham, diced",
    "2 stalks celery, diced",
    "1 small onion, diced",
    "1 small green bell pepper, diced"
  ],
  "steps": [
    {
      "text": "Stir mayonnaise, relish, salt, and pepper together in a large bowl until well blended. Add diced ham, celery, onion, and bell pepper; toss until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve immediately, or cover and store in the refrigerator until ready to serve.",
