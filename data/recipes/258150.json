  "ingredients": [
    "12 ears fresh corn, husked",
    "3 eggs",
    "1 cup milk",
    "1 teaspoon white sugar",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 tablespoons butter, cut into small pieces, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut the kernels from the corn cobs. Mix corn and eggs together in a bowl until smooth; add milk, sugar, salt, and pepper and mix well. Transfer mixture to the prepared baking dish and dot with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
