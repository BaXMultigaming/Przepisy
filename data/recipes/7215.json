  "ingredients": [
    "0.625 cup warm water",
    "0.5 cup canned pumpkin puree",
    "0.25 cup margarine",
    "0.25 cup nonfat dry milk powder",
    "0.25 cup packed brown sugar",
    "1 teaspoon ground cinnamon",
    "0.75 teaspoon ground nutmeg",
    "0.75 teaspoon salt",
    "0.125 teaspoon ground ginger",
    "2.75 cups bread flour",
    "2.25 teaspoons active dry yeast"
  ],
  "steps": [
    {
      "text": "Place ingredients in bread machine pan in the order suggested by the manufacturer. Select basic setting. Start.",
      "section": null,
      "name": null,
      "url": null,
