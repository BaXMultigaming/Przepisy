  "ingredients": [
    "1 cup white sugar",
    "0.5 cup all-purpose flour",
    "0.5 teaspoon salt",
    "2 cups milk",
    "3 egg yolks",
    "0.25 cup butter",
    "0.25 cup lemon juice",
    "1.5 teaspoons lemon zest",
    "0.5 cup sour cream",
    "1 (9 inch) pie crust, baked"
  ],
  "steps": [
    {
      "text": "Combine sugar, flour, and salt in a saucepan. Gradually stir in milk. Cook and stir on medium heat until thickened and bubbly. Reduce heat, cook, and stir for 2 more minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat yolks slightly. Gradually stir 1 cup of custard mix into yolks. Return yolk mixture to the saucepan with the rest of custard and bring to a gentle boil. Cook and stir for 2 more minutes. Remove from heat and stir in butter, lemon juice, and zest. Fold in sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour filling into baked pie shell. Chill until set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
