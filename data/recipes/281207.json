  "ingredients": [
    "3 pounds skinless, boneless chicken breast halves",
    "1 cup chicken broth",
    "0.5 teaspoon seasoned salt, or to taste"
  ],
  "steps": [
    {
      "text": "Place chicken breasts in the bottom of a slow cooker. Pour in chicken broth and seasoned salt. Cover and cook on High until no longer pink in the center and the juices run clear, 3 to 4 hours, or on Low for 6 to 8 hours. An instant-read thermometer inserted into the center of the chicken breasts should read at least 165 degrees F (74 degrees C).",
