  "title": "Indian Chicken Curry (Murgh Kari)",
  "description": "This Indian chicken curry simmers chicken breasts in a homemade curry sauce made with yogurt, tomatoes, fresh ginger, garam masala, and warm spices.",
  "authors": [
    "Ayshren"
  ],
  "date_published": "2019-07-10T03:02:01-04:00",
