  "ingredients": [
    "4 sheets 8x12-inches each) Reynolds Wrap® Aluminum Foil",
    "4 graham crackers, broken into halves",
    "2 (1.55 ounce) bars milk chocolate candy bars, divided in half diagonally",
    "4 marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat grill to medium or preheat oven to 450 degrees F. For each s'more, top one graham cracker square with one candy bar half, one marshmallow and another graham cracker square. Repeat with remaining graham crackers, candy and marshmallows.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Center s'mores individually on each sheet of Reynolds Wrap® Aluminum Foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring up foil sides. Double fold top and ends to seal packet, leaving room for heat circulation inside. Repeat to make four packets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill 4 to 5 minutes in covered grill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "OR Bake 4 to 5 minutes on a cookie sheet in oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
