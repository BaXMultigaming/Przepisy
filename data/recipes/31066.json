  "ingredients": [
    "1 cup peach preserves",
    "1.5 tablespoons Worcestershire sauce",
    "0.5 teaspoon chile paste",
    "2 tablespoons vegetable oil",
    "4 boneless pork chops",
    "1 teaspoon ground ginger",
    "1 pinch ground cinnamon",
    "salt and pepper to taste",
    "0.5 cup white wine"
  ],
  "steps": [
    {
      "text": "Mix together peach preserves, Worcestershire sauce, and chile paste in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse pork chops, then pat dry. Sprinkle chops with ginger, cinnamon, salt, and pepper. Sear chops in hot oil until lightly browned, about 2 minutes per side. Remove from the skillet and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour white wine into the skillet and stir to scrape the browned bits off of the bottom of the pan. Stir in peach preserves mixture. Return chops to the skillet, flipping to coat with sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium-low and cook chops until no longer pink in the centers, about 8 minutes per side. An instant-read thermometer inserted into the centers should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
