  "title": "Spicy Peach-Glazed Pork Chops",
  "description": "Sweet and spicy boneless pork chops made with a special sauce that includes peach preserves and white wine.",
  "authors": [
    "Virginia C"
  ],
  "date_published": "2001-02-07T19:28:08-05:00",
