    "Dinner"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 cup brown sugar",
    "0.5 cup fajita seasoning (such as Fiesta®)",
    "2 tablespoons Hungarian sweet paprika",
    "2 racks pork spareribs, fat trimmed",
    "1 cup beer",
    "3 cloves garlic, minced",
    "1 tablespoon honey",
    "3 tablespoons Worcestershire sauce",
    "1 tablespoon prepared brown mustard"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C1IFfoN5goXNjeGbmlYZNScyDXU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Ingredients-8262-b64bead510c14dfaa594c80777ec23a9.jpg"
      ],
      "image": "assets/images/216985/step_01.webp"
    },
    {
      "text": "Mix brown sugar, fajita seasoning, and paprika in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/--oo0J3podixEQRwEqsK8SRi3Ac=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Step-01-8270-494006afcbbe47a99e3003aa38217e93.jpg"
      ],
      "image": "assets/images/216985/step_02.webp"
    },
    {
      "text": "Rub both sides of pork spareribs with the brown sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hojoU36ENjl7nUgGZwB8VumktfE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Step-02-8276-f5f03d1da10c4bc0ad38ecacdce70046.jpg"
      ],
      "image": "assets/images/216985/step_03.webp"
    },
    {
      "text": "Place spareribs in a 9x13-inch baking pan; cover and refrigerate 8 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vmIlkhbtgt0uCrJEvFZEtH_AypQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Step-03-8279-5f60ac5ecb7e4465ad6ce774c06bc770.jpg"
      ],
      "image": "assets/images/216985/step_04.webp"
    },
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Whisk together beer, garlic, honey, Worcestershire sauce, and mustard in a bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QrEfjZGv5pjrcuUFOX_eUM91q88=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Step-04b-8286-0779b4f6a047436b993468c2805b34d6.jpg"
      ],
      "image": "assets/images/216985/step_05.webp"
    },
    {
      "text": "Tear off 2 large sheets of heavy-duty aluminum foil and lay them shiny-side down. Place a rack of spare ribs on each sheet, meaty-side up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rWZpVSyFIk9StYdfPKrcpj3ugi4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Step-05-8294-377b979b49164a04b158d8349a0d5c7f.jpg"
      ],
      "image": "assets/images/216985/step_06.webp"
    },
    {
      "text": "Tear off 2 more sheets of foil and place them on top of the spare ribs, shiny-side up. Begin tightly folding the edges of the foil together to create a sealed packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rvv_ncSKa1qQgdXBr8D6MfjDZPw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Step-06-8304-708fb1676c4c4c4a8cc7276f41a85b18.jpg"
      ],
      "image": "assets/images/216985/step_07.webp"
    },
    {
      "text": "Just before sealing completely, divide beer mixture evenly into each packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NlZ6L0zu-IucOuzCsvPh21SjTy8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Step-07b-8313-1dd00bb917be41129fe018fd1e5a4eeb.jpg"
      ],
      "image": "assets/images/216985/step_08.webp"
    },
    {
      "text": "Complete the seal. Place the packets side-by-side on an 11x14-inch baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EbPsYmmNfOe83CmF7dKpZv9Xu5M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Step-09-8326-3f2f6dd304154975b98799e250716494.jpg"
      ],
      "image": "assets/images/216985/step_09.webp"
    },
    {
      "text": "Bake ribs in the preheated oven until the ribs are very tender, 3 1/2 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5AE6MpIP7_UuJW5PYqgzQ5vWAL0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Step-10-8593-fa95eef496ef4f21b05d09b2697fa91c.jpg"
      ],
      "image": "assets/images/216985/step_10.webp"
    },
    {
      "text": "Carefully open each packet and drain drippings into a saucepan. You may only need the drippings from one packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fE5Q7aGh5FiDdXLh9jTqqOZV5l0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Step-11b-8607-cdf83aac2700465a8c9c876b4d456afd.jpg"
      ],
      "image": "assets/images/216985/step_11.webp"
    },
    {
      "text": "Place ribs on a foil-lined baking sheet and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4SDFviGWxsFEgNhnrz_lJ6J-S74=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Step-12-8619-be8c0ce6b8464f399b1999c089a17222.jpg"
      ],
      "image": "assets/images/216985/step_12.webp"
    },
    {
      "text": "Heat the saucepan over medium-high and simmer drippings until the sauce begins to thicken, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-3II730FmUn0xYZGGoiAkzT4u_4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Step-13-8610-6164a812043940c5853f8d9589dcc745.jpg"
      ],
      "image": "assets/images/216985/step_13.webp"
    },
    {
      "text": "Brush the thickened sauce over ribs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oFygppRt7NGcTAhaMr6pCvM6S2g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-Step-14-8622-6e940d9abe3b40dd97aff36c52022994.jpg"
      ],
      "image": "assets/images/216985/step_14.webp"
    },
    {
      "text": "Preheat the broiler and set the oven rack about 6 inches from the heat source. Return ribs to the oven and broil until the sauce is lightly caramelized, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Vr-9r1pDjcuOr0DeZv-g1mGAB3k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-216985-Tender-Pork-Spare-Ribs-DDMFS-4x3-8666-2465d26cb9fe41e78aeceee43c27e8af.jpg"
      ],
      "image": "assets/images/216985/step_15.webp"
    }
  ],
