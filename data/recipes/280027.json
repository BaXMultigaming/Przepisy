  "ingredients": [
    "1 pound fingerling potatoes",
    "0.75 cup salad dressing (such as Miracle Whip®)",
    "0.5 cup sour cream",
    "0.25 cup chopped onion, or to taste",
    "3 tablespoons chopped fresh parsley",
    "3 tablespoons chopped fresh chives",
    "2 tablespoons sweet pickle relish",
    "2 tablespoons dill pickle relish",
    "1.5 tablespoons prepared yellow mustard",
    "1 tablespoon white sugar",
    "1 tablespoon chopped fresh Thai basil",
    "1 teaspoon celery seed"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 15 to 20 minutes. Drain and let cool, about 15 minutes. Chop coarsely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine salad dressing, sour cream, onion, parsley, chives, sweet relish, dill relish, mustard, sugar, basil, and celery seed in a large bowl. Add potatoes; stir well to coat. Cover and chill to let all the flavors blend, 12 to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
