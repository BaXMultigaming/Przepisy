  "ingredients": [
    "1 sack giblets from one turkey",
    "0.5 cup butter",
    "1 cup diced celery",
    "0.5 cup chopped onion",
    "1 teaspoon poultry seasoning",
    "salt and pepper to taste",
    "8 cups dry bread cubes",
    "1 cup chicken broth, or as needed"
  ],
  "steps": [
    {
      "text": "Chop giblets into small pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a medium skillet over medium heat. Add giblets and cook for 2 minutes. Add celery and onion; cook and stir until tender, about 5 minutes. Remove from the heat and stir in poultry seasoning, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread crumbs into a large bowl. Stir in giblet mixture and enough broth to lightly moisten bread. Stuffing is ready for baking as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
