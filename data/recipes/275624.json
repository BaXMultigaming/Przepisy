  "ingredients": [
    "0.5 cup raisins",
    "boiling water",
    "1 cup whole wheat flour",
    "0.66666668653488 cup all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground nutmeg",
    "1 cup pumpkin puree",
    "1 cup white sugar",
    "2 large eggs",
    "0.25 cup canola oil",
    "1 cup coarsely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place raisins in a small bowl; cover with boiling water by 1 inch. Set aside until raisins are plump and rehydrated, 3 to 4 minutes; drain, reserving ⅓ cup soaking water in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine whole wheat flour, all-purpose flour, cinnamon, baking soda, baking powder, salt, cloves, and nutmeg in a large bowl. Combine pumpkin, sugar, eggs, reserved soaking water, and oil in a separate bowl; stir into flour mixture until just moistened. Fold in walnuts and raisins. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 50 to 55 minutes. Cool in the pan for 15 minutes, then remove from the pan and transfer loaf to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
