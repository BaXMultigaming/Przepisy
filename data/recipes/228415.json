  "ingredients": [
    "1.5 cups whole wheat flour",
    "0.5 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "1 cup skim milk",
    "1 egg",
    "2 tablespoons butter, softened",
    "1 tablespoon vegetable oil",
    "2 cups fresh blueberries",
    "0.5 cup brown sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 6 jumbo muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk whole wheat flour, white sugar, baking powder, 1/2 teaspoon cinnamon, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, egg, butter, and oil in a separate bowl until smooth; stir into flour mixture just until blended. Fold in blueberries gently. Spoon batter into the prepared muffin cups, filling them to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the topping: Combine brown sugar with 1/2 teaspoon cinnamon in a bowl and spoon the mixture onto the muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake muffins in the preheated oven until golden brown and a toothpick inserted into the center of a muffin comes out clean, 20 to 25 minutes. Cool in the pan for 5 minutes before transferring to a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
