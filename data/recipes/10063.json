  "title": "Church Window Cookies",
  "description": "Church window cookies are a deliciously easy, no-bake, festive chocolate treat with coconut and colorful marshmallows to look like stained glass windows.",
  "authors": [
    "Martha"
  ],
  "date_published": "1997-11-02T19:50:09-05:00",
  "date_modified": "2026-03-10T04:21:19-04:00",
  "prep_time": "PT10M",
  "cook_time": "PT15M",
  "total_time": "PT145M",
  "yield": [
    "48",
    "48 cookies"
  ],
  "categories": [
    "Dessert"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "0.5 cup butter",
    "2 cups semisweet chocolate chips",
    "1 (10.5 ounce) package rainbow colored miniature marshmallows",
    "1 (8 ounce) package flaked coconut",
    "parchment paper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/31G9fK_7_HaKU70KR1mIvddgYMA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10063-Church-Windows-step-01-1791-f08bb4b7149d4b2a807cda6a751a11a1.jpg"
      ],
      "image": "assets/images/10063/step_01.webp"
    },
    {
      "text": "Place butter in a 2 ½ quart glass or metal bowl. Place the bowl over a 3-quart saucepan of gently boiling water (upper bowl should not touch water). Cook over the simmering water until butter is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ftqbd5gCHcXS5rksyyygmARv_tY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10063-Church-Windows-step-02-1798-404ce39a0619449785aded085da86903.jpg"
      ],
      "image": "assets/images/10063/step_02.webp"
    },
    {
      "text": "Add chocolate chips; stir until melted, then remove from heat. Let cool 10 minutes at room temperature, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VS7ftFTiUj1tHn4Cke9tUqhZIMg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10063-Church-Windows-step-03-1799-ee5888b661434a95ae34034ba429c9d0.jpg"
      ],
      "image": "assets/images/10063/step_03.webp"
    },
    {
      "text": "Add marshmallows to melted chocolate; gently stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lPugOpxgOEGcYLfayj64f3y0yl8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10063-Church-Windows-step-04-1802-9ba2b648c2df45a589f3c9104c810838.jpg"
      ],
      "image": "assets/images/10063/step_04.webp"
    },
    {
      "text": "Place two 15x18-inch pieces of parchment paper on work surface. Place half of the chocolate-marshmallow mixture onto the middle of each piece of parchment and shape into a 12-inch long log using a rubber spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CQy6eH2Fry8GqDCKV8ZVKg8LrGk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10063-Church-Windows-step-05and06-1804-713d6ec3e9554f73877bba40d293d0ea.jpg"
      ],
      "image": "assets/images/10063/step_05.webp"
    },
    {
      "text": "Wrap logs tightly in the parchment and transfer to refrigerator; chill logs for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MDF9PLLHCfHcK0qx3SH7KsOE4Ns=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10063-Church-Windows-step-07-1806-83b7e0d071bf4fb49e7f4418bcb5067f.jpg"
      ],
      "image": "assets/images/10063/step_06.webp"
    },
    {
      "text": "Place two new 15x18-inch pieces of parchment paper on work surface and sprinkle each with 1 cup flaked coconut. Carefully transfer chilled logs (they will still be soft) to the new pieces of parchment with coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/06fLRZQqTFsfOh02hPjZVPBNm8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10063-Church-Windows-step-09-1894-d64aef7025d449acba962b6c1ffc90ac.jpg"
      ],
      "image": "assets/images/10063/step_07.webp"
    },
    {
      "text": "Roll logs in coconut and gently press to fully cover outside and sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/01uoc4Y6KuM9RefTXhjix7hA82M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10063-Church-Windows-step-10-1895-8a3cec67e3cb4d028908423221c9dfd1.jpg"
      ],
      "image": "assets/images/10063/step_08.webp"
    },
    {
      "text": "Wrap coated logs tightly in the new parchment paper and chill until firm, at least 4 hours up to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/he0wGISg7goGRXmZK_OEqusWf4I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10063-Church-Windows-step-11-1897-1f3ffa24efc5446ba0200f4e2a2a31c7.jpg"
      ],
      "image": "assets/images/10063/step_09.webp"
    },
    {
      "text": "When well chilled, cut into 1/2-inch thick slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o8_E9URTF8Spv4jyudYV8oOvJCo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10063-Church-Windows-step-12-2050-2b432eb09ab64d73bf72cf515cdcb1eb.jpg"
      ],
      "image": "assets/images/10063/step_10.webp"
    }
  ],
