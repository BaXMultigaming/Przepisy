  "ingredients": [
    "0.5 cup milk",
    "0.5 cup all-purpose flour",
    "0.5 teaspoon garlic and onion seasoning",
    "0.5 cup ranch dressing",
    "0.75 cup panko bread crumbs",
    "2 tablespoons dry ranch dressing mix",
    "8 ounces portobello mushroom caps, cleaned",
    "nonstick cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set up a breading station with 4 shallow dishes. Add milk to the first dish. Mix flour and seasoning blend together in the second dish. Add ranch dressing to the third dish. Mix panko bread crumbs and dry ranch dressing in the fourth dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each mushroom first into milk, then flour, shaking off excess flour. Dip in ranch dressing, followed by panko bread crumbs. Set mushrooms in a shallow air fryer pan or the air fryer basket and spray with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry until mushrooms are golden, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
