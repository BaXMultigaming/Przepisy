  "ingredients": [
    "1 pound ground turkey",
    "0.5 cup crushed cheese flavored crackers",
    "1 egg",
    "1 tablespoon red pepper flakes",
    "1 tablespoon garlic powder",
    "1 teaspoon dried minced onion"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together ground turkey, crushed crackers, egg, red pepper flakes, garlic powder, and onion until well combined. Form into four fat patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook patties on the preheated grill until no longer pink in the center, about 5 minutes per side. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
