  "ingredients": [
    "6 cups raspberries",
    "0.5 cup white sugar",
    "2 tablespoons cornstarch",
    "0.25 cup cold water",
    "1 tablespoon fresh lemon juice",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine berries and sugar in non-stick saucepan over medium heat; bring to a boil while stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cornstarch into cold water in a small bowl until dissolved completely; stir into the berry mixture. Reduce heat to medium low and cook mixture at a simmer until it begins to thicken, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove berry mixture from heat. Stir lemon juice and vanilla extract into the berry mixture; transfer to a bowl. Cover bowl with plastic wrap and refrigerate for 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
