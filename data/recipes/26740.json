  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup unsalted butter, softened",
    "0.75 cup confectioners' sugar",
    "2 tablespoons brown sugar",
    "0.25 teaspoon vanilla extract",
    "0.75 cup miniature semisweet chocolate chips",
    "0.75 cup finely chopped pecans"
  ],
  "steps": [
    {
      "text": "Beat cream cheese and butter in a medium bowl with an electric mixer until smooth. Mix in confectioners' sugar, brown sugar, and vanilla. Stir in chocolate chips. Cover and chill in the refrigerator for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FUAGA4T4k9nLleL_aA7Qx4fyDyc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26740-chocolate-chip-cheese-ball-VAT-step-01-be6fe3884a064ce7b1622c2d048e7e83.jpg"
      ],
      "image": "assets/images/26740/step_01.webp"
    },
    {
      "text": "Shape chilled cream cheese mixture into a ball. Wrap with plastic wrap and return to the refrigerator for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0eSeXVoA-XUfQNH9plYVBP3qrD0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26740-chocolate-chip-cheese-ball-VAT-step-02-f67221dd64a2486096cb2668c7615c3d.jpg"
      ],
      "image": "assets/images/26740/step_02.webp"
    },
    {
      "text": "When ready to serve, remove and discard the plastic wrap. Roll cheese ball in pecans and place onto a serving platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/66WKv1a2nnIlB2iYXHiRl_SlQgE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26740-chocolate-chip-cheese-ball-VAT-step-03-b3a387cdfeb74935afdfcfa37d6e61c0.jpg"
      ],
      "image": "assets/images/26740/step_03.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
