  "ingredients": [
    "0.5 cup warm water",
    "2 tablespoons flaxseed meal",
    "2 cups all-purpose flour",
    "2 tablespoons baking powder",
    "1 tablespoon white sugar",
    "0.5 teaspoon salt",
    "1.75 cups almond milk",
    "0.25 cup vegetable oil",
    "0.25 cup applesauce",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine water and flaxseed meal in a medium-sized bowl. Set aside for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, sugar, and salt in a large mixing bowl. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add almond milk, oil, applesauce, and vanilla extract to flaxseed mixture. Combine until smooth. Add to flour mixture and stir until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 1/3 cup waffle batter to the preheated waffle iron and cook until waffle is golden brown and the iron stops steaming, about 5 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
