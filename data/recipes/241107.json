  "ingredients": [
    "6 eggs, beaten",
    "1 cup milk",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "cooking spray",
    "3 slices bread, torn in pieces",
    "1 (12 ounce) package cooked breakfast sausage",
    "0.5 cup Monterey Jack cheese",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Whisk eggs, milk, salt, and black pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a 2-quart baking dish with cooking spray. Spread bread pieces out in an even layer on the bottom of the prepared dish; top with sausage, Monterey Jack cheese, egg mixture, and Cheddar cheese, respectively. Cover the baking dish with plastic wrap and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Remove casserole from refrigerator and let sit at room temperature for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake casserole in the preheated oven until bubbling and hot throughout, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
