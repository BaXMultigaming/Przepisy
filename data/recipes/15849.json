  "steps": [
    {
      "text": "Melt butter in a large skillet over medium-low heat. Add celery, onion, and green bell pepper; sauté until tender. Stir in tomatoes, broth, rice, thyme or basil, garlic salt, ground black pepper, hot pepper sauce, and bay leaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring all to a boil; reduce heat, cover skillet and simmer for about 20 minutes or until rice is tender. Stir in cooked chicken and cook until heated through. Discard bay leaf and serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
