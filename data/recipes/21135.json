  "ingredients": [
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "2 teaspoons white sugar",
    "0.5 teaspoon cream of tartar",
    "0.25 teaspoon salt",
    "0.5 cup melted butter",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine flour, baking powder, sugar, cream of tartar and salt. Stir in butter and milk just until moistened. Drop batter on a lightly greased cookie sheet by the tablespoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden on the edges, about 8 to 12 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
