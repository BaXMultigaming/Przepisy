  "ingredients": [
    "2 pounds beef tenderloin",
    "1 onion, chopped",
    "0.125 cup fresh lime juice",
    "1 tablespoon salt",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Cut beef into 1x1/2-inch cubes and place in a large bowl. Add onion, lime juice, salt, and black pepper; mix well. Cover the bowl and refrigerate for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread beef on skewers, 6 to 8 pieces per skewer. Discard any excess marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook beef skewers on the preheated grill for 3 to 4 minutes per side, 12 to 16 minutes in total. An instant-read thermometer inserted into the center of beef should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
