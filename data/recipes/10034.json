  "ingredients": [
    "1.5 cups packed brown sugar",
    "1 cup butter flavored shortening",
    "2 eggs",
    "1 tablespoon orange zest",
    "0.5 cup sour milk",
    "1 teaspoon vanilla extract",
    "3 teaspoons baking powder",
    "3.25 cups all-purpose flour",
    "1 cup confectioners' sugar",
    "1 teaspoon butter",
    "3 tablespoons orange juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C). Lightly grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium size mixing bowl, mix together 3 teaspoons baking powder and 3 1/4 cups flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together brown sugar and shortening then add eggs, orange rind and vanilla. Mix in flour mixture, alternating the flour mixture and sour milk until all is blended. Drop dough by teaspoonful onto cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 12-15 minutes. Let cool and frost cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Frosting: Mix together powdered sugar, 1 teaspoon butter and enough orange juice mixed in to make it able to spread over cooled cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
