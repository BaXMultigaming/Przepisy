  "ingredients": [
    "1 tablespoon vegetable oil",
    "1.5 pounds ground beef",
    "2 onions, chopped",
    "1 cup water",
    "1 (14 ounce) can tomato sauce",
    "1 clove garlic, minced",
    "1 teaspoon salt",
    "1 pinch ground black pepper",
    "0.5 cup white rice",
    "4 cups shredded cabbage",
    "8 slices bacon"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EGBqZD9x5R0Lg41bZzduKRvO2j4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231094-easy-cabbage-roll-casserole-ddmfs-Step-01-7d1ae724fb4641a0a0b21a3976b01f42.jpg"
      ],
      "image": "assets/images/231094/step_01.webp"
    },
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease an 8x12-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a large skillet over medium-high heat; cook and stir ground beef until crumbly, evenly browned, and no longer pink, 8 to 10 minutes. Drain and discard any excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Mi_JD2youx1ndfokwbU78f8Eibg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231094-easy-cabbage-roll-casserole-ddmfs-Step-03-0dba9d5fe97c4ce18c3e54aa54d8a4aa.jpg"
      ],
      "image": "assets/images/231094/step_03.webp"
    },
    {
      "text": "Stir in onions, water, tomato sauce, garlic, salt and black pepper; bring to a simmer. Add rice, cover, and cook for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QI6UweHmXTFhhoS2ex9Lr9N2lCM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231094-easy-cabbage-roll-casserole-ddmfs-Step-05-a4f03545e3234398908996fdb9936cbb.jpg"
      ],
      "image": "assets/images/231094/step_04.webp"
    },
    {
      "text": "Spread half the shredded cabbage in prepared baking dish; cover with half the beef mixture. Repeat layers. Arrange bacon over final layer of beef. Cover baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZRMLKbB_LfXE7x-Nv2c_f06GmEU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231094-easy-cabbage-roll-casserole-ddmfs-Step-08-4034aa8bc9124926aef9c71e02a0bdb9.jpg"
      ],
      "image": "assets/images/231094/step_05.webp"
    },
    {
      "text": "Bake in preheated oven until bacon is crisp and cabbage is tender, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yfp8KP7bivd5_8zfUVIwrxliZFE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231094-easy-cabbage-roll-casserole-ddmfs-Step-10-bf95357fe6a94ebfa0ff4620d26e0423.jpg"
      ],
      "image": "assets/images/231094/step_06.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3GBymXFbblWWfBe7_cr0K9JncOo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231094-easy-cabbage-roll-casserole-ddmfs-Beauty-3x4-d5b1d4742ad741c28e9b498eced085e0.jpg"
      ],
