    "publisher-tested"
  ],
  "ingredients": [
    "2 cups uncooked long-grain rice",
    "4 cups water",
    "2 large heads savoy cabbage",
    "1 cup water",
    "2 onions, chopped",
    "3 tablespoons butter",
    "0.75 cup uncooked long-grain rice",
    "1 pound extra-lean ground beef",
    "0.5 pound pork sausage",
    "4 cloves garlic, minced",
    "2 teaspoons dried dill weed",
    "0.75 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon white sugar",
    "1 (28 ounce) can whole peeled tomatoes, with liquid",
    "1 (26 ounce) can condensed tomato soup",
    "8 bay leaves"
  ],
  "steps": [
    {
      "text": "Wash 2 cups of rice thoroughly. Combine it with 4 cups water in a medium saucepan; bring to a boil. Reduce heat, cover, and simmer until all of the water is absorbed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, remove cabbage cores using a thin, long knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4_gWA6LIK5fZVuVs_xng8UA79y0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19759-cabbage-rolls-ddmfs-step-1-0560-4x3-04605f8a2dd54020a124b088692e2245.jpg"
      ],
      "image": "assets/images/19759/step_02.webp"
    },
    {
      "text": "Place one cabbage in a microwave-proof container with the cored part facing down. Pour 1/2 cup water into the container, cover, and microwave on high for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3FUHyCOfh7kHVufPfVlPM55Z-0Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19759-cabbage-rolls-ddmfs-step-2-0566-4x3-ca762ea417c5406dbe7a41fdffbb14fc.jpg"
      ],
      "image": "assets/images/19759/step_03.webp"
    },
    {
      "text": "Carefully turn cabbage over, and cook, covered, for an additional 10 minutes. Let cabbage sit until it is cool enough to handle, then separate leaves carefully and remove any tough ribs. Cook the second cabbage in the same manner.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eHEyCTA3E9qRD5xitgyuIAnVlr8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19759-cabbage-rolls-ddmfs-step-3-0574-4x3-1a7389518dab410cb4c2f0b30fbedba5.jpg"
      ],
      "image": "assets/images/19759/step_04.webp"
    },
    {
      "text": "Sauté 1/2 of the onions in 3 tablespoons butter; cook just until translucent (do not brown). Combine the cooked rice and the 3/4 cup uncooked rice, cooked and uncooked onions, ground beef, pork sausage, garlic, dill weed, salt, black pepper, and sugar in a large mixing bowl. Mix until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HLodA5eHei35bJBl05xt_eO3o3E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19759-cabbage-rolls-ddmfs-step-4-0576-4x3-34756501fef641f0ac3ebd6d34e8b658.jpg"
      ],
      "image": "assets/images/19759/step_05.webp"
    },
    {
      "text": "Spoon about 2 tablespoons of mixture onto each cabbage leaf. Bring one end of the cabbage leaf over the mixture, rolling and tucking in the ends to prevent the filling from falling out.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AYusr_SGicX6tbdpShBeCS1MtuE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19759-cabbage-rolls-ddmfs-step-5-0581-4x3-1a82c19269a140b3b184f6aa23df35ec.jpg"
      ],
      "image": "assets/images/19759/step_06.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place leftover cabbage leaves on the bottoms of two 9x13-inch casserole dishes. Arrange cabbage rolls in a single layer so they are tight against each other.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée tomatoes and condensed tomato soup in a food processor or blender. Pour tomato mixture over the cabbage rolls until just covered. Place 4 bay leaves on top of sauce in each dish. Cover each dish tightly with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RZ7OBpuSS--MRhEpLVGwB2ZvnAc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19759-cabbage-rolls-ddmfs-step-6-0589-4x3-e838aa3fc9c045b188f362373eee16fc.jpg"
      ],
      "image": "assets/images/19759/step_09.webp"
    },
    {
      "text": "Bake in the preheated oven for 2 hours. Remove from the oven and let cool for 15 minutes before removing the foil. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pG6Ovu0KlmtMI8wkY2-1lXeTL10=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19759-cabbage-rolls-ddmfs-step-7-0615-4x3-1ddd483cc320488ba82311fbfbdc5a02.jpg"
      ],
      "image": "assets/images/19759/step_10.webp"
    }
  ],
