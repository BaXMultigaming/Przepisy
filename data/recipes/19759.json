  "title": "Cabbage Rolls",
  "description": "Traditional savoy cabbage rolls stuffed with ground beef, pork sausage, and long-grain rice, simmered in a tomato sauce until tender and flavorful.",
  "authors": [
    "William Uncle Bill Anatooskin"
  ],
  "date_published": "2000-07-09T05:37:44-04:00",
  "date_modified": "2026-06-15T12:57:18-04:00",
  "prep_time": "PT30M",
