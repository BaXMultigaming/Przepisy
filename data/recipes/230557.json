  "ingredients": [
    "0.333 cup white sugar, or more to taste",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon salt, or more to taste",
    "1 large egg white",
    "1 tablespoon water",
    "1 pound pecan halves"
  ],
  "steps": [
