  "ingredients": [
    "1 pound tilapia fillets",
    "2 large lemons",
    "1 pinch steak seasoning, or to taste",
    "4 slices Swiss cheese",
    "2 large tomatoes, sliced",
    "1 pinch dried oregano, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the fish fillets into a 9x13 inch glass baking dish. Slice the lemons in half, and squeeze the juice out over the fillets, turning them to coat thoroughly. Sprinkle steak seasoning to taste over both sides of the fillets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay slices of Swiss cheese over the fillets so they are covered. Place tomato slices over the cheese. Sprinkle dried oregano over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 minutes in the preheated oven, or until fish flakes easily with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
