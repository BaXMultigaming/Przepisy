  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "0.5 cup butter, melted",
    "0.5 cup packed brown sugar",
    "2 eggs",
    "0.5 cup peanuts",
    "0.33333334326744 cup English toffee bits",
    "0.5 cup chocolate chips",
    "0.5 cup butterscotch chips",
    "0.33333334326744 cup shredded coconut, or to taste",
    "1 (16 ounce) package prepared chocolate frosting"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, butter, brown sugar, and eggs in a bowl. Beat with an electric mixer, scraping bowl occasionally, until well mixed. Stir in peanuts and toffee; spread into an ungreased 9x13-inch baking pan. Sprinkle chocolate chips, butterscotch chips, and coconut on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes. Cool on a wire rack and coat with frosting. Cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
