  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "0.25 cup butter",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "0.5 cup half-and-half",
    "0.5 cup grated Parmesan cheese",
    "3 teaspoons minced garlic",
    "1 tablespoon lemon juice",
    "1 tablespoon Italian seasoning",
    "2 (13.5 ounce) cans spinach, drained",
    "4 ounces fresh mushrooms, sliced",
    "0.66666668653488 cup bacon bits",
    "2 cups shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken breasts on a baking sheet. Bake in the preheated oven until no longer pink and juices run clear, 20 to 30 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase the oven temperature to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a medium saucepan over medium heat. Stir in cream of mushroom soup, half-and-half, Parmesan cheese, garlic, lemon juice, and Italian seasoning, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange spinach in bottom of a 9x9-inch baking dish; cover with mushrooms. Pour 1/2 soup mixture over mushrooms; arrange chicken breasts on top. Cover with remaining soup mixture. Sprinkle with bacon bits; top with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and lightly browned, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
