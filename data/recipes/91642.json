  "ingredients": [
    "8 ears corn, husk and silk removed",
    "0.5 cup butter, melted",
    "1.5 tablespoons macadamia nut oil",
    "0.5 cup grated Parmesan cheese",
    "2 tablespoons minced garlic",
    "1 teaspoon crushed rosemary",
    "1 teaspoon rubbed sage",
    "1 teaspoon dried basil",
    "1 teaspoon dried thyme leaves",
    "1.5 teaspoons salt",
    "1.5 teaspoons pepper"
  ],
  "steps": [
    {
      "text": "Soak corn in cold water for 1 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate. Drain corn and pat dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir melted butter and oil together in a bowl; stir in garlic, rosemary, sage, basil, thyme, salt, and pepper, then stir in Parmesan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place each ear corn in center of a sheet of aluminum foil; brush with butter mixture, then tightly wrap in foil. Gently puncture foil a few times to allow excess steam to escape while grilling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, turning frequently, until kernels are tender when pierced with a knife, 20 to 30 minutes. Remove from the grill and check for doneness; if not done, cook 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
