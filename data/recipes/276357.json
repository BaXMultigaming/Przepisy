  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "0.5 cup brown sugar, divided",
    "2 teaspoons baking powder",
    "0.25 teaspoon baking soda",
    "0.75 teaspoon salt",
    "0.5 cup lime juice",
    "0.5 cup butter, melted",
    "2 eggs",
    "0.25 cup coconut-flavored rum",
    "0.66666668653488 cup white chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line each cup with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, white sugar, 1/4 cup brown sugar, baking powder, baking soda, and salt in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine lime juice, melted butter, eggs, and rum in a small bowl. Slowly stir into the flour mixture until moistened. Fold in white chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared muffin cups. Sprinkle remaining brown sugar over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
