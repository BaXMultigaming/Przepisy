  "ingredients": [
    "0.25 cup maple syrup",
    "2 tablespoons soy sauce",
    "1 clove garlic, minced",
    "0.25 teaspoon garlic salt",
    "0.125 teaspoon ground black pepper",
    "1 pound salmon"
  ],
