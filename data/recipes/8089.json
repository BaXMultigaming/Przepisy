    "1 (15.25 ounce) package yellow cake mix",
    "4 large eggs, divided",
    "1 cup butter, melted, divided",
    "1 (8 ounce) package cream cheese, softened",
    "4 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cake mix, 2 eggs, and 1/2 cup melted butter in a large bowl. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese in another bowl until smooth. Blend in remaining 1/2 cup melted butter and 2 eggs. Gradually beat in confectioners' sugar. Pour over cake mixture already in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
