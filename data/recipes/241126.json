  "ingredients": [
    "0.5 cup creamy salad dressing (such as Miracle Whip®)",
    "0.5 cup olive oil",
    "0.25 cup red wine vinegar",
    "2 large cloves garlic, minced",
    "2 teaspoons spicy Dijon mustard",
    "1 teaspoon white sugar",
    "1 teaspoon ground black pepper",
    "0.25 teaspoon salt",
    "0.25 teaspoon chopped fresh basil",
    "0.25 teaspoon chopped fresh oregano",
    "0.25 teaspoon chopped fresh thyme",
    "0.25 teaspoon chopped fresh parsley",
    "2 tablespoons pickle juice, or more to taste"
  ],
  "steps": [
    {
      "text": "Whisk salad dressing, olive oil, vinegar, garlic, Dijon mustard, sugar, black pepper, salt, basil, oregano, thyme, and parsley together in a bowl until smooth; stir in pickle juice to thin until reaches desired consistency.",
