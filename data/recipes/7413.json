  "ingredients": [
    "1 (18.25 ounce) package German chocolate cake mix",
    "14 ounces individually wrapped caramels",
    "1 (5 ounce) can evaporated milk",
    "0.75 cup butter",
    "1 cup chopped pecans",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make cake mix according to package directions. Pour a little less than 1/2 of the batter into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Remove cake from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place caramels, milk, and butter in a microwave-safe bowl and cook on high, stirring occasionally, until melted and smooth, about 10 minutes. Pour melted caramel mixture over cake and sprinkle with pecans and chocolate chips. Pour remaining cake batter over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the center of cake bounces back when gently pressed, 20 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
