  "title": "Debbie&#39;s Baked Spaghetti",
  "description": "A comforting pasta bake with tomato soup made with ground beef, onion, bell pepper, garlic, and cream of mushroom and tomato soups, topped with Cheddar cheese.",
  "authors": [
    "Debbie Clark"
  ],
  "date_published": "2000-01-23T15:03:41-05:00",
  "date_modified": "2022-08-29T14:16:56-04:00",
