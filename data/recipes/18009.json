  "ingredients": [
    "1 pound spaghetti",
    "1 pound lean ground beef",
    "1 onion, chopped",
    "1 green bell pepper, chopped",
    "2 cloves chopped garlic",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1.5 cups water",
    "1 (10.75 ounce) can condensed tomato soup",
    "2 cups shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until al dente, 8 to 10 minutes; drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sauté beef, onion, green pepper, and garlic in a large skillet over medium heat until beef is browned, about 10 minutes; drain and return mixture to the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream of mushroom soup, water, and condensed tomato soup into the skillet. Stir pasta into meat and soup mixture; mix well. Spread mixture into a 9x13-inch baking dish; top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and cheese is lightly browned, 20 to 30 minutes; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
