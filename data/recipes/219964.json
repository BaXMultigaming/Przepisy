  "ingredients": [
    "2 egg yolks",
    "2 eggs",
    "3 tablespoons white sugar",
    "3.5 ounces chopped dark chocolate",
    "5 tablespoons butter",
    "4 teaspoons unsweetened cocoa powder",
    "3 tablespoons flour",
    "1 pinch salt",
    "0.125 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Generously butter the insides of four 5 ½-ounce ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg yolks, eggs, and sugar together in a bowl with an electric mixer until foamy and lighter in color.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate and butter in a microwave-safe bowl in 30-second intervals until melted, stirring after each interval, 1 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir melted chocolate mixture into egg and sugar mixture until combined. Sift in cocoa powder and stir to combine. Sift in flour and salt; stir to combine into a batter. Stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer batter to a resealable plastic bag. Snip off one corner of the bag with scissors to create a tip. Divide batter evenly between the prepared ramekins; gently tap ramekins on the counter to remove any air bubbles. Refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange chilled ramekins in a casserole dish. Pour enough warm tap water into the casserole dish to reach halfway up the sides of the ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15-18 minutes. Remove from the oven and let cool for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Loosen the edges from each ramekin with a knife. Invert cakes onto serving plates and dust with powdered sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
