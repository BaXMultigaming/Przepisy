  "ingredients": [
    "6 cups cubed turnips",
    "2 eggs, beaten",
    "2 tablespoons butter",
    "3 tablespoons all-purpose flour",
    "1 tablespoon brown sugar",
    "1 teaspoon baking powder",
    "0.75 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 pinch nutmeg",
    "0.5 cup fine bread crumbs",
    "2 tablespoons melted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place turnips in a large pot, cover with salted water, and bring to a boil. Reduce heat to medium-low; simmer until tender, about 20 minutes. Drain turnips. Mash turnips; stir in beaten eggs and 2 tablespoons butter until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, baking powder, salt, black pepper, and nutmeg in a small bowl; stir into mashed turnip mixture. Transfer mixture to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs and 2 tablespoons melted butter in a small bowl; sprinkle over turnip mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the topping is light brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
