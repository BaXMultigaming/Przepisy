  "ingredients": [
    "2 tablespoons vegetable oil",
    "3 pounds ground venison",
    "2 stalks celery, diced",
    "3 cups chopped white onion",
    "0.5 teaspoon dried red pepper flakes",
    "1 tablespoon garlic powder",
    "0.25 cup chili powder",
    "2 (28 ounce) cans diced tomatoes",
    "1 (16 ounce) can tomato sauce",
    "0.5 cup gold tequila",
    "0.5 cup orange juice",
    "2 (15 ounce) cans chili beans in sauce"
  ],
  "steps": [
    {
      "text": "Heat the oil in a large pot over medium-high heat. Add the ground venison and cook, stirring to crumble, until no longer pink. Mix in the celery and onion; cook and stir until tender. Season with red pepper flakes, garlic powder and chili powder. Cook and stir for a minute to intensify the flavors.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in the tomatoes, tomato sauce, tequila and orange juice; simmer over low heat, uncovered, for 2 hours. After 2 hours, mix the beans into the chili and simmer for another 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
