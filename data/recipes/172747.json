  "ingredients": [
    "2 large sweet potatoes, peeled and cubed",
    "3 tablespoons olive oil",
    "1.5 tablespoons paprika",
    "2 teaspoons packed brown sugar",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon poultry seasoning",
    "0.5 teaspoon chili powder",
    "1 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sweet potatoes into a large mixing bowl; drizzle with olive oil. Season with paprika, brown sugar, black pepper, onion powder, garlic powder, poultry seasoning, chili powder, and cayenne pepper; toss until potatoes are evenly coated. Spread onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes, then turn potatoes over with a spatula. Continue baking until potatoes are golden and tender, 10 to 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
