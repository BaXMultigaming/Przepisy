  "ingredients": [
    "2 tablespoons olive oil",
    "3 garlic cloves, minced",
    "2 (14.5 ounce) cans petite diced tomatoes",
    "0.25 cup tomato paste",
    "0.5 teaspoon dried basil",
    "0.25 teaspoon dried oregano"
  ],
  "steps": [
    {
      "text": "Heat oil and garlic in a large saucepan or Dutch oven until garlic starts to sizzle and turn golden. Add tomatoes, tomato paste, basil and oregano; bring to a simmer. Simmer, uncovered, until sauce is thick enough for dipping, 15 to 20 minutes. Cool and refrigerate.",
