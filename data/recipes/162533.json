  "ingredients": [
    "3 cups prepared au jus sauce",
    "2 pounds thinly sliced roast beef",
    "6 Kaiser rolls, split",
    "2 teaspoons coarse kosher salt",
    "2 teaspoons caraway seeds",
    "0.25 cup prepared horseradish"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place rolls onto a baking sheet with the cut sides down. Brush roll tops lightly with water, then sprinkle salt and caraway seeds over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until toasted, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the rolls are toasting, warm au jus sauce in a saucepan over medium heat, 3 to 5 minutes. Add roast beef and cook until heated through, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove rolls from the oven and transfer to serving plates. Top with warm beef and au jus sauce. Serve horseradish on the side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
