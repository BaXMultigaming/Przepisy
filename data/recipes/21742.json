  "ingredients": [
    "2 tablespoons butter",
    "0.25 cup shallots, minced",
    "0.75 cup dry white wine",
    "3 pounds mussels, cleaned and debearded",
    "0.5 cup chopped fresh parsley",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "In a medium stock pot, heat butter over medium heat. Add shallots and saute until translucent.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in wine and mussels. Raise heat to medium/high and steam mussels until shells open, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mussels and cooking liquid into a serving bowl, sprinkle with parsley and freshly ground black pepper to taste. Serve immediately.",
