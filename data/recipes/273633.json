  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "1 tablespoon baking powder",
    "0.25 teaspoon salt",
    "1.5 cups fresh black raspberries",
    "1.5 lemons, zested",
    "2 large eggs",
    "1 cup milk",
    "3 tablespoons vegetable oil",
    "1 lemon, juiced",
    "0.5 cup white sugar",
    "1 lemon, juiced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 1 cup sugar, baking powder, and salt in a medium bowl; stir in black raspberries and lemon zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs together in a separate bowl; whisk in milk, oil, and juice of 1 lemon. Stir in flour mixture until just moistened; transfer to the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ½ cup sugar and juice of 1 lemon in a microwave-safe bowl. Microwave at 20-second intervals until sugar is dissolved and glaze is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush glaze over warm bread while still in the pan; cool for 10 minutes. Transfer loaf to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
