  "ingredients": [
    "1 (8 ounce) package crescent roll dough, unrolled and divided into triangles",
    "1 (8 ounce) package reduced-fat cream cheese",
    "0.25 cup light sour cream",
    "0.25 cup light mayonnaise-style salad dressing (such as Miracle Whip®)",
    "3 tablespoons ranch dressing mix",
    "0.25 cup diced bell pepper",
    "0.25 cup finely chopped broccoli florets",
    "0.33333334326744 cup shredded Cheddar cheese"
  ],
  "steps": [
