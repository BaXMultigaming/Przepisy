  "ingredients": [
    "1.5 cups unsweetened almond milk",
    "1 medium very ripe banana",
    "0.5 cup unsweetened coconut milk",
    "1.5 teaspoons maple syrup",
    "0.5 teaspoon vanilla extract",
    "1 pinch ground turmeric, or to taste",
    "1 pinch ground cinnamon, or to taste",
    "1 pinch ground ginger, or to taste"
  ],
  "steps": [
    {
      "text": "Combine almond milk, banana, coconut milk, maple syrup, vanilla extract, turmeric, cinnamon, and ginger in a blender; blend until completely smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into a small saucepan over medium-low heat. Cook, stirring constantly, just until warm. Do not bring to a simmer or milk will curdle. Serve immediately.",
