  "ingredients": [
    "6 slices bacon, chopped",
    "1 potato, peeled and sliced into thin 1-inch pieces",
    "2 tablespoons water, or as needed",
    "1 clove garlic, thinly sliced",
    "0.5 teaspoon red pepper flakes",
    "salt and ground black pepper to taste",
    "1 bunch Swiss chard, chopped",
    "8 eggs, beaten",
    "0.33333334326744 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven’s broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir bacon in a large oven-proof skillet over medium heat until evenly browned and crispy, about 10 minutes. Drain all but 1 teaspoon bacon grease from the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir potato slices, water, garlic, red pepper flakes, salt, and black pepper into bacon; cover the skillet with a lid and cook until potatoes are tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Swiss chard into potato mixture; cook and stir until chard is slightly wilted, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour eggs over potato-chard mixture, stir gently, and remove skillet from heat. Top egg mixture with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until eggs are set and frittata is golden brown around the edges, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
