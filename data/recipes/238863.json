  "ingredients": [
    "3 cups all-purpose flour",
    "0.5 cup oats",
    "0.25 cup white sugar",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "1.5 cups day-old beer",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, oats, sugar, baking powder, and salt together in a bowl. Stir beer and butter into flour mixture using a wooden spoon until dough is well mixed; pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 1 hour. Cool bread for 10 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
