  "ingredients": [
    "4 cups milk",
    "2.5 teaspoons vanilla extract, divided",
    "1 teaspoon ground cinnamon",
    "5 whole cloves",
    "12 egg yolks",
    "1.5 cups white sugar",
    "4 cups light cream",
    "2.5 cups light rum",
    "0.5 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Combine milk, 1/2 teaspoon vanilla extract, cinnamon, and cloves in a large saucepan over low heat; stir and heat for 5 minutes. Increase the heat to medium-low; Gradually bring to a boil. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jvp7sRMvu5lrx0JWq0sCZEUR-wU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-57028-amazingly-good-eggnog-VAT-4x3-step-02-5fa799359a3b4b63a8815c6541166895.jpg"
      ],
      "image": "assets/images/57028/step_01.webp"
    },
    {
      "text": "Whisk egg yolks in a large bowl until they turn light yellow. Add sugar; whisk until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8zF7J01HO2N4zx2jZuP5A7nEGwE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-57028-amazingly-good-eggnog-VAT-4x3-step-03-67a08150576f42cbb4c7a4999ed47b92.jpg"
      ],
      "image": "assets/images/57028/step_02.webp"
    },
    {
      "text": "Pour some of the hot milk mixture into egg yolk mixture; whisk quickly to avoid scrambling eggs. Continue adding hot milk and whisking until all milk is incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QrqOiDtiNC1Azana826ISiEWti0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-57028-amazingly-good-eggnog-VAT-4x3-step-04-3312098187524cb2b60c0d60ff78d418.jpg"
      ],
      "image": "assets/images/57028/step_03.webp"
    },
    {
      "text": "Pour mixture back into the saucepan. Cook over medium heat, stirring constantly, until thick, about 3 minutes; do not boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2TaOgv3adJN2sDlhdakd_zFkEeQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-57028-amazingly-good-eggnog-VAT-4x3-step-05-d4b82cd4c4ea4741bd134f8ddf7f5722.jpg"
      ],
      "image": "assets/images/57028/step_04.webp"
    },
    {
      "text": "Strain; let cool for 1 hour. Stir in cream, rum, remaining 2 teaspoons vanilla extract, and nutmeg. Refrigerate 8 hours to overnight before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6sIStBsqjsHMH9kf9yuqX1e1lm0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-57028-amazingly-good-eggnog-VAT-4x3-step-06-460c200ffcfc4994a1b53d12f8a517f2.jpg"
      ],
      "image": "assets/images/57028/step_05.webp"
    }
  ],
