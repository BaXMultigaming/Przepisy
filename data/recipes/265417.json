  "ingredients": [
    "0.5 pound sliced fresh strawberries",
    "1.5 cups fresh raspberries",
    "0.25 cup white sugar",
    "4 teaspoons vanilla sugar",
    "1 (17.5 ounce) package mascarpone cheese",
    "11 ounces plain yogurt"
  ],
  "steps": [
    {
      "text": "Combine strawberries, raspberries, sugar, and vanilla sugar in the bowl of a food processor; pulse until blended. Pass mixture through a fine-mesh sieve into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add mascarpone cheese and yogurt to the bowl with the berry mixture. Stir until well combined. Transfer to a lidded container; cover and freeze for about 2 hours.",
