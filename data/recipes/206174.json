  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.66666668653488 cup sugar",
    "0.5 cup cornmeal",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 cup milk",
    "1 cup mashed, ripe plantains",
    "0.33333334326744 cup corn oil",
    "2 large eggs",
    "3 tablespoons melted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 16 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, sugar, cornmeal, baking powder, and salt together in a bowl. Whisk milk, plantains, oil, eggs, and butter together in a separate bowl; stir in flour mixture until just combined. Do not overmix batter. Rest batter at room temperature for 10 to 15 minutes. Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and tops spring back when lightly pressed, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
