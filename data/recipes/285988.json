  "ingredients": [
    "2 pounds ground beef",
    "1 cup diced onion",
    "2 cloves garlic, minced",
    "1 tablespoon ground cumin",
    "1 tablespoon chili powder",
    "1 (8 ounce) package cream cheese, softened and cut into pieces",
    "4 cups beef broth",
    "2 (14.5 ounce) cans diced tomatoes, undrained",
    "1 (7 ounce) can chopped mild green chiles",
    "0.5 cup heavy cream",
    "1 teaspoon salt, or to taste"
  ],
  "steps": [
    {
      "text": "Stir ground beef, onion, and garlic together in a large pot on medium heat until beef is brown and crumbly, and onion is translucent, 5 to 7 minutes. Drain; discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in cumin and chili powder; cook for 2 to 3 minutes more. Add cream cheese to the pot; stir until melted, and no chunks remain. Stir in beef broth, diced tomatoes and juices, green chiles, cream, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium and cook until heated through, about 30 minutes; do not boil or mixture may curdle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
