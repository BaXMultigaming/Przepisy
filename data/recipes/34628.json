  "title": "Linguine with Clams and Porcini Mushrooms",
  "description": "Clams are cooked in a mushroom broth and served with linguine pasta.",
  "authors": [
    "Debbie Zanet"
  ],
  "date_published": "2018-03-21T12:23:21-04:00",
