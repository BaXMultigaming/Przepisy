  "ingredients": [
    "0.25 cup butter",
    "1.5 pounds banana squash, peeled and cubed",
    "2 tablespoons water, or as needed",
    "3 tablespoons apricot preserves",
    "1 tablespoon orange juice",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground cloves",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Add squash and water; cover and cook until squash is tender, about 5 minutes, stirring occasionally and adding more water as needed to prevent squash from sticking to the skillet. Reduce heat to low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir apricot preserves, orange juice, salt, cloves, and black pepper into squash; cook and stir, uncovered, until squash is evenly glazed.",
      "section": null,
