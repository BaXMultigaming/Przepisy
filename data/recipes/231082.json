  "ingredients": [
    "2 tablespoons olive oil",
    "2 pounds ground beef",
    "2 stalks celery, chopped",
    "1 onion, chopped",
    "1 green bell pepper, chopped",
    "3 (14 ounce) cans stewed tomatoes",
    "1 (14 ounce) can tomato sauce",
    "1 (10 ounce) can diced tomatoes with green chiles (such as RO*TEL)",
    "1 cup water",
    "2 (1.25 ounce) packages chili seasoning (such as McCormick® Mild Chili Seasoning Mix)",
    "1 (14 ounce) can kidney beans, undrained",
    "1 (14 ounce) can pinto beans, undrained",
    "salt and ground black pepper to taste",
    "1 tablespoon white vinegar, or more to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eDt8ZoF85LClHhxwUW1-VWolI2Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231082-Just-Like-Wendys-Chili-ddmfs-Step-1-4062b3f95c0c4feba07ef4557925b8da.jpg"
      ],
      "image": "assets/images/231082/step_01.webp"
    },
    {
      "text": "Heat olive oil in a large pot over medium-high heat. Press ground beef into the hot oil to form one large patty; let the bottom brown, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lr8NLKqM5N6f73W0RrltlzXycR4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231082-Just-Like-Wendys-Chili-ddmfs-Step-2-203d5e1db69a42a6ad92a02f8fab55f7.jpg"
      ],
      "image": "assets/images/231082/step_02.webp"
    },
    {
      "text": "Stir and break browned beef into crumbles. Continue to cook until no longer pink, about 5 minutes longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UPbeJ8M7qr-7Zc1BMxhWM6A_XXM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231082-Just-Like-Wendys-Chili-ddmfs-Step-3-dc4c915d858b456f9dded1e290076f02.jpg"
      ],
      "image": "assets/images/231082/step_03.webp"
    },
    {
      "text": "Stir celery, onion, and bell pepper into beef and cook until onion is translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xGZonOyaG_siZLEMnINEE-e3AwE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231082-Just-Like-Wendys-Chili-ddmfs-Step-4-8a3bf7b9784b4caf813b2845cdead9e5.jpg"
      ],
      "image": "assets/images/231082/step_04.webp"
    },
    {
      "text": "Pour in stewed tomatoes, tomato sauce, diced tomatoes with green chiles, and water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Qh5fLYaxfQUE6fwdksPFi154_Is=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231082-Just-Like-Wendys-Chili-ddmfs-Step-5-98bc2f0d171d46e9986ce2be722c4116.jpg"
      ],
      "image": "assets/images/231082/step_05.webp"
    },
    {
      "text": "Break apart large chunks of stewed tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k3irTVrfSaaxNIPSOrsL2yWhrTk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231082-Just-Like-Wendys-Chili-ddmfs-Step-6-111239aa034b48fda6af79a0892cabf4.jpg"
      ],
      "image": "assets/images/231082/step_06.webp"
    },
    {
      "text": "Stir in chili seasoning. Stir in kidney and pinto beans. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iSPyCgkDOmLFvt6AVPnHmgmIz18=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231082-Just-Like-Wendys-Chili-ddmfs-Step-7-1f59487865554d12ae81ee79f8e711de.jpg"
      ],
      "image": "assets/images/231082/step_07.webp"
