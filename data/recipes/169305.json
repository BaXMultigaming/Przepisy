  "ingredients": [
    "cooking spray",
    "2 (8 ounce) packages cream cheese, softened",
    "1.75 cups white sugar, divided",
    "1 teaspoon Mexican vanilla extract",
    "2 (8 ounce) cans refrigerated crescent rolls",
    "0.5 cup butter, room temperature",
    "1 teaspoon ground cinnamon",
    "0.25 cup honey"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PsNfLDzSoFzENS4TTp9LuUcRS-I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-169305-sopapilla-cheesecake-pie-step1-9764aec751e548b88e6b096a703e7585.jpg"
      ],
      "image": "assets/images/169305/step_01.webp"
    },
    {
      "text": "Beat cream cheese, 1 cup sugar, and vanilla extract in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mqRboSVF0aRlojOtyajrqIBtgZ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-169305-sopapilla-cheesecake-pie-step2-6d937a54da274e06ba7c4f2917666c02.jpg"
      ],
      "image": "assets/images/169305/step_02.webp"
    },
    {
      "text": "Unroll crescent roll dough, and use a rolling pin to shape each sheet into a 9x13-inch rectangle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nAynnYpUUSl7hz2ky9pNvLKLiyk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-169305-sopapilla-cheesecake-pie-step3-35e0548ca3af435ea191e077486e1cc8.jpg"
      ],
      "image": "assets/images/169305/step_03.webp"
    },
    {
      "text": "Press one piece into the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Gj7AcPXds2kucrzMXdfpD8aN-kE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-169305-sopapilla-cheesecake-pie-step4-69c2e41d368d4d9d810fdbd4b97f0c75.jpg"
      ],
      "image": "assets/images/169305/step_04.webp"
    },
    {
      "text": "Evenly spread cream cheese mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xwwMIufLrbkD7RJDDpRMHMHmtHM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-169305-sopapilla-cheesecake-pie-step5-d5cb109c035f4febb1076e83790c1560.jpg"
      ],
      "image": "assets/images/169305/step_05.webp"
    },
    {
      "text": "Cover with remaining piece of crescent dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6bs_pCGIY1LT49-NIRLjAyDwJF8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-169305-sopapilla-cheesecake-pie-step6-abd84549e7364fe8acde5b2f2278b427.jpg"
      ],
      "image": "assets/images/169305/step_06.webp"
    },
    {
      "text": "Mash remaining 3/4 cup sugar, butter, and cinnamon with a fork until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TVc90q6HH2G4_v771juDLwxJuF8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-169305-sopapilla-cheesecake-pie-step7-3e45055c709041df839e4b4d50bc486f.jpg"
      ],
      "image": "assets/images/169305/step_07.webp"
    },
    {
      "text": "Dot mixture over top of dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yPyvuk2nwmbpxIkdOeRfAA1fz5A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-169305-sopapilla-cheesecake-pie-step8-518b4406b7784499ace9443621ecc10c.jpg"
      ],
      "image": "assets/images/169305/step_08.webp"
