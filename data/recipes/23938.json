  "ingredients": [
    "2 cups mayonnaise",
    "2 teaspoons dried oregano",
    "1 pound processed American cheese, sliced",
    "0.5 pound cooked ham, thinly sliced",
    "0.5 pound Genoa salami, thinly sliced",
    "1 medium onion, diced",
    "0.5 head iceberg lettuce, shredded",
    "2 medium tomatoes, diced",
    "12 hoagie rolls, torn into pieces for dipping"
  ],
  "steps": [
    {
      "text": "Stir mayonnaise and oregano together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Tear American cheese, ham, and salami into small pieces; place into a large bowl. Stir in mayonnaise mixture, 1/2 cup at a time, until cheese and meats are well coated. Stir in onion, then stir in lettuce and tomatoes.",
      "section": null,
      "name": null,
      "url": null,
