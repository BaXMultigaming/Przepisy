  "ingredients": [
    "2 pounds very ripe strawberries, hulled and cut into chunks",
    "3 cups cold water",
    "2 cups white sugar"
  ],
  "steps": [
    {
      "text": "Place strawberries into a heavy saucepan, add water, and bring to a boil. Stir, reduce heat to low, and simmer until strawberries soften, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain juice into a separate saucepan, using a fine mesh strainer; discard strawberry pulp. Stir in sugar until dissolves. Bring strawberry juice back to a boil a second time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium and simmer for 5 minutes. Skim any foam from the top of the syrup. Turn off heat and let cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour syrup into a lidded container and refrigerate.",
      "section": null,
      "name": null,
      "url": null,
