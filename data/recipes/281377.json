  "ingredients": [
    "2 tablespoons olive oil",
    "1 tomato, cubed",
    "1 clove garlic, minced",
    "2 teaspoons dried oregano",
    "2 teaspoons Italian seasoning",
    "1 pinch salt and ground black pepper to taste",
    "0.25 cup chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Put oil in a medium saucepan over medium heat until hot. Add tomato and garlic and cook until soft, about 3 minutes. Add Italian seasoning, salt, and pepper; cook until sauce is fragrant, about 5 minutes. Add chopped basil and cook until soft, 1 to 2 minutes.",
