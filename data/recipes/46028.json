  "ingredients": [
    "1 tablespoon olive oil",
    "1.5 pounds fresh mushrooms",
    "1 teaspoon Italian seasoning",
    "0.25 cup dry white wine",
    "2 cloves garlic, minced",
    "salt and pepper to taste",
    "2 tablespoons chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Add mushrooms; season with Italian seasoning and cook 10 minutes, stirring frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir wine and garlic into the skillet; cook until most of the wine has evaporated. Season with salt and black pepper; sprinkle with chives. Cook 1 minute.",
