  "ingredients": [
    "1 (4 pound) whole chicken, cut into pieces",
    "6 cloves garlic, chopped",
    "4 tablespoons oyster sauce",
    "2 tablespoons curry powder",
    "0.5 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "To Marinate: In a nonporous glass dish or bowl, combine the garlic, oyster sauce and curry powder. Mix together. Add chicken pieces and turn to coat. Cover dish or bowl and refrigerate to marinate for at least 1/2 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet or wok, heat oil over medium high heat. Add marinated chicken (disposing of leftover marinade) and fry for 20 to 25 minutes or until chicken is crispy and brown and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
