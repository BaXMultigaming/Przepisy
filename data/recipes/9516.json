  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup unsalted butter, softened",
    "0.5 cup confectioners' sugar",
    "5 red maraschino cherries, quartered, or as needed",
    "5 green maraschino cherries, quartered, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DzaeXBy3MfPXAsTAptx1D95a1rg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9516-whipped-shortbread-cookies-VAT-step-01-a3b1cdc3cdb64246bb9967954964e3e6.jpg"
      ],
      "image": "assets/images/9516/step_01.webp"
    },
    {
      "text": "Beat flour, butter, and confectioners’ sugar together in a large bowl with an electric mixer on medium speed until very light and fluffy, 8 to 10 minutes; dough should look pale, soft, and airy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T0O0cWUANmc-Hn7q2yuoWtjtvJo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9516-whipped-shortbread-cookies-VAT-step-02-ce6d697a9f6a4a8c9962374c83ab067d.jpg"
      ],
      "image": "assets/images/9516/step_02.webp"
    },
    {
      "text": "Drop tablespoonfuls of dough 2 inches apart on the prepared baking sheets. Top each cookie with a cherry quarter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EJ_2sEqus1EKufXH9Qm3imvcg4I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9516-whipped-shortbread-cookies-VAT-step-03-2367d7f5becb44b8acb135f07d48c8ff.jpg"
      ],
      "image": "assets/images/9516/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until bottoms are light golden, 18 to 20 minutes. Cool on the baking sheets for 5 minutes; transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9QFHLqTOScBlArf-glbZuWUWQQY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9516-whipped-shortbread-cookies-VAT-step-04-324c84e32f8b4a098115ea47474578ed.jpg"
      ],
      "image": "assets/images/9516/step_04.webp"
    }
  ],
