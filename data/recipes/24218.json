  "ingredients": [
    "1 cup biscuit baking mix",
    "0.25 cup grated Parmesan cheese",
    "1 teaspoon dried parsley",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon seasoning salt",
    "0.5 teaspoon dried oregano",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "4 eggs",
    "0.33300000429153 cup vegetable oil",
    "0.25 cup grated onion",
    "2 zucchini, thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine baking mix, Parmesan cheese, parsley, garlic powder, seasoning salt, oregano, salt, and black pepper in a large bowl. Add eggs, oil, and onion; mix well. Stir in zucchini until evenly distributed. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
