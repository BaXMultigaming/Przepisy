    "publisher-tested"
  ],
  "ingredients": [
    "1 large onion, chopped",
    "2 carrots, chopped",
    "2 ribs celery, chopped",
    "2 teaspoons vegetable oil",
    "2 large turkey wings",
    "2 tablespoons cold water",
    "10 cups cold water",
    "4 sprigs fresh thyme",
    "2 cloves garlic",
    "3 tablespoons butter",
    "0.5 cup all-purpose flour",
    "1 pinch cayenne pepper, or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients, and preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7essf8WPgk_1fKpdfuR4Bb12z0s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230049-chef-johns-make-ahead-turkey-gravy-VAT-4x3-step-01-f4b699b023684d78879c48e439a6371b.jpg"
      ],
      "image": "assets/images/230049/step_01.webp"
    },
    {
      "text": "Combine onion, carrots, celery, and oil in a large roasting pan; toss to coat. Place turkey wings on top of vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7Qs6JfMRasjHHljD4Wj_cB1T-JQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230049-chef-johns-make-ahead-turkey-gravy-VAT-4x3-step-02-3e279dda55c44b0ba262d37fb0cb1257.jpg"
      ],
      "image": "assets/images/230049/step_02.webp"
    },
    {
      "text": "Roast in the preheated oven until turkey wings are browned and vegetables are caramelized and softened, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l4ME7ukpkGJcL1PUnW7I-Z6L7mg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230049-chef-johns-make-ahead-turkey-gravy-VAT-4x3-step-03-497c3506c944498e9cf395d19af4f833.jpg"
      ],
      "image": "assets/images/230049/step_03.webp"
    },
    {
      "text": "Transfer turkey wings and vegetables to a large stockpot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tkBbC2MjBtCJAY0UIx8Ugyw7E5k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230049-chef-johns-make-ahead-turkey-gravy-VAT-4x3-step-04-b24d8cb2753c4e6b813d4dcd63a33e0c.jpg"
      ],
      "image": "assets/images/230049/step_04.webp"
    },
    {
      "text": "Place the roasting pan over a stovetop burner set to medium heat. Pour 2 tablespoons cold water into the pan and bring to a boil, scraping up any browned bits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yfYe416Qqm7onyv4mvsjm-SJ44k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230049-chef-johns-make-ahead-turkey-gravy-VAT-4x3-step-05-aa5b39508eb242e0a316a59ea9b1b6ce.jpg"
      ],
      "image": "assets/images/230049/step_05.webp"
    },
    {
      "text": "Pour mixture into the stockpot and add 10 cups cold water, thyme, and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1piH3nl70OWMk4Vn6-4i__oYW0g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230049-chef-johns-make-ahead-turkey-gravy-VAT-4x3-step-06-d2941ffc78b3491a90c2757f4544e427.jpg"
      ],
      "image": "assets/images/230049/step_06.webp"
    },
    {
      "text": "Bring turkey wing mixture to a boil. Reduce heat to low and simmer, uncovered, until meat falls off the bone, about 3 hours. Skim off turkey fat throughout the process, reserving 2 tablespoons.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0fCFceGzN1OTthkdnh5fPHoKlyM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230049-chef-johns-make-ahead-turkey-gravy-VAT-4x3-step-07-13370131b1e24cb99298449fdee803e4.jpg"
      ],
      "image": "assets/images/230049/step_07.webp"
    },
    {
      "text": "Strain turkey stock and reserve 6 cups stock; discard all solids.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DjAtJfQnM1qehuuVv31l8UzHySQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230049-chef-johns-make-ahead-turkey-gravy-VAT-4x3-step-08-77969c7b9712495788dddb32108fdfe7.jpg"
      ],
      "image": "assets/images/230049/step_08.webp"
    },
    {
      "text": "Heat butter and reserved turkey fat in a large saucepan over medium heat. Whisk in flour and cook until it smells like cooked pie crust, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Pj-W7ElpyqvNM1EcGGeupBP3yyU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230049-chef-johns-make-ahead-turkey-gravy-VAT-4x3-step-09-c1fe1ea836ab4c61b16a32dcaa1c3dba.jpg"
      ],
      "image": "assets/images/230049/step_09.webp"
    },
    {
      "text": "Slowly pour in reserved turkey stock, whisking constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6fCRlhsSxXu7hh5lyEiY0DePMpk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230049-chef-johns-make-ahead-turkey-gravy-VAT-4x3-step-10-c11cfdce15aa46eba51aef3307258854.jpg"
      ],
      "image": "assets/images/230049/step_10.webp"
    },
    {
      "text": "Increase heat to high and simmer gravy until thick and warmed through, about 5 minutes. Season with cayenne, salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sU3foWw3fISbTxEBewVmgC_Xn_0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230049-chef-johns-make-ahead-turkey-gravy-VAT-4x3-step-11-d31c2b7d057f49f2acd7099f450f109b.jpg"
      ],
      "image": "assets/images/230049/step_11.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8Wv007pjgVWC2fXLGMQsSvDsmEI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230049-chef-johns-make-ahead-turkey-gravy-VAT-hero-4x3-990411e69503436abfa6533b0c0a9dfa.jpg"
      ],
      "image": "assets/images/230049/step_12.webp"
    }
  ],
