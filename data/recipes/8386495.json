  "ingredients": [
    "1 (18 ounce) package gnocchi",
    "1 tablespoon unsalted butter",
    "0.5 cup sliced fresh mushrooms",
    "4 cloves garlic, minced",
    "0.25 cup heavy whipping cream",
    "0.75 cup reserved pasta water",
    "4 cups baby spinach",
    "1 (5.2 ounce) package garlic and herb cheese spread (such as Boursin®)"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook gnocchi in the boiling water until they float to the top, 2 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a heavy skillet over medium-high heat. Add sliced mushrooms and sauté until softened, about 3 minutes. Add garlic and sauté until fragrant, about 30 seconds. Reduce heat, and pour in cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop out 3/4 cup of cooking water and set aside. Place spinach in the bottom of a colander and drain the gnocchi over the spinach to wilt it.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cheese into the skillet and add reserved cooking water; keep stirring until cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add gnocchi and wilted spinach to the skillet and stir until well combined. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
