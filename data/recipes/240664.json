  "ingredients": [
    "1 cup vegan semi-sweet chocolate chips",
    "0.25 cup canola oil",
    "2 eggs, beaten",
    "2 teaspoons instant coffee granules",
    "0.5 cup white sugar",
    "0.33333334326744 cup cocoa powder",
    "0.33333331346512 cup gluten-free flour",
    "0.125 teaspoon baking soda",
    "1 tablespoon coffee-flavored liqueur",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat chocolate with canola oil in a large glass bowl in a microwave oven in 30 second increments, stirring between each round of heating, until completely melted, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir eggs and coffee granules into the melted chocolate. Sift sugar, cocoa powder, flour, and baking soda together into a bowl; add to chocolate mixture and stir to incorporate fully. Pour coffee liqueur and vanilla extract into the mixture; stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour brownie batter into an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until beginning to dry along the edges, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
