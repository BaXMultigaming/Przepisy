  "ingredients": [
    "0.5 head cabbage, thinly sliced",
    "3 tablespoons white sugar",
    "3 tablespoons cider vinegar",
    "0.5 teaspoon celery seed",
    "0.5 teaspoon salt",
    "0.5 cup mayonnaise, or more to taste"
  ],
  "steps": [
    {
      "text": "Place cabbage in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, vinegar, celery seed, and salt together in a separate bowl. Stir mayonnaise into sugar-vinegar mixture until dressing is smooth and creamy. Pour dressing over cabbage; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Marinate coleslaw in refrigerator for 2 to 3 hours; stir well before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
