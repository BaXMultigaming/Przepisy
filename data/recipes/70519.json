  "ingredients": [
    "1 (3 pound) boneless pork roast",
    "2 teaspoons seasoned salt",
    "1 teaspoon ground black pepper",
    "1 (20 ounce) can pineapple chunks, undrained",
    "1.5 cups chopped dried cranberries"
  ],
  "steps": [
