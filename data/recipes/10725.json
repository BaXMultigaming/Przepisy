  "ingredients": [
    "12.5 cups white sugar",
    "12.5 cups packed brown sugar",
    "8.3333301544189 cups butter",
    "25 large eggs",
    "0.33333298563957 cup vanilla extract",
    "36.333301544189 cups all-purpose flour",
    "0.25 cup baking soda",
    "1.5 tablespoons salt",
    "9.3333301544189 pounds semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugars and butter in a very large bowl. Mix in eggs and vanilla. Combine flour, baking soda, and salt in a separate bowl. Add dry ingredients gradually to creamed mixture. Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop with ice cream scoop onto baking sheets. Flatten balls with wet hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies start to brown, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
