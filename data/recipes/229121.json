  "ingredients": [
    "0.5 cup butter, melted",
    "0.66666668653488 cup crushed saltine crackers",
    "0.25 cup grated Parmesan cheese",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "1 pound yellow perch fillets"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour melted butter into a shallow dish. Combine crushed crackers, Parmesan cheese, basil, oregano, salt, and garlic powder in a separate shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip perch fillets into melted butter. Press into cracker mixture to coat both sides. Arrange coated fillets on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until coating is browned and fish flakes easily with a fork, 25 to 30 minutes. An instant-read thermometer inserted into the center of fillets should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
