  "ingredients": [
    "2 cups finely chopped almonds",
    "1.5 cups cornmeal",
    "1 cup white sugar",
    "1.6666667461395 cups all-purpose flour",
    "1 lemon, zested",
    "1 vanilla bean, split lengthwise and scraped",
    "1 pinch salt",
    "0.5 cup butter, softened",
    "0.66666668653488 cup lard",
    "3 egg yolks"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almonds, cornmeal, sugar, flour, lemon zest, vanilla, and salt in a bowl. Mix well using a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pile flour mixture onto a flat work surface, forming a mound. Make a large well in the center; add butter, lard, and egg yolks. Knead vigorously until mixture is combined but crumbly. Spread evenly in the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 40 to 45 minutes. Cut while still warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
