  "title": "Pork and Bamboo Shoot Soup with Cloud Ear",
  "description": "Pork fillet is simmered with bamboo shoots, cloud ear mushrooms, and eggs in this simple, comforting Chinese soup with complex flavors.",
  "authors": [
    "ZAYO"
  ],
  "date_published": "2020-06-19T00:06:40-04:00",
