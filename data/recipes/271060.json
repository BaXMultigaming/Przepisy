  "title": "Chirashi Bowl",
  "description": "Instead of spending time making sushi rolls, you can take the chirashi route and serve all the rice, seafood, and garnishes in one big bowl!",
  "authors": [
    "Benjamin Zuckerman"
  ],
  "date_published": "2020-06-19T00:35:23-04:00",
