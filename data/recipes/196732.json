  "ingredients": [
    "6 slices bacon, chopped",
    "1 large onion, diced",
    "2 cloves garlic, minced",
    "1 large head cabbage, cored and sliced",
    "1 tablespoon salt, or to taste",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "0.125 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6PQ6ihmLBhU4Olz66qo4qmQZpMY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/196732-fried-cabbage-with-bacon-onion-and-garlic-DDMFS-step-01-1511--f22bc8acfb534abeacddad9b5d8e2b0c.jpg"
      ],
      "image": "assets/images/196732/step_01.webp"
    },
    {
      "text": "Place bacon in a large stockpot and cook over medium-high heat until crispy, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BUAD_lK3tCmi8WuvynSBcyJOi14=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/196732-fried-cabbage-with-bacon-onion-and-garlic-DDMFS-step-02-1514-057adf1b2bac498a973112e1e8c46ca9.jpg"
      ],
      "image": "assets/images/196732/step_02.webp"
    },
    {
      "text": "Add onion and garlic; cook and stir until onion caramelizes, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zywwdK_itbMdX7VEqghRN8ytqeA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/196732-fried-cabbage-with-bacon-onion-and-garlic-DDMFS-step-03-1515-88af5fc66f1347d4bbd1da5db3d10f18.jpg"
      ],
      "image": "assets/images/196732/step_03.webp"
    },
    {
      "text": "Immediately stir in cabbage and continue to cook and stir another 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OSzMK1HSeYDHDtsvQCCRfZa85Ts=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/196732-fried-cabbage-with-bacon-onion-and-garlic-DDMFS-step-04-1516-7ce4cb9e99da4551b2026829cc64220e.jpg"
      ],
      "image": "assets/images/196732/step_04.webp"
    },
    {
      "text": "Season with salt, pepper, onion powder, garlic powder, and paprika. Reduce heat to low, cover, and simmer, stirring occasionally, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hGtCadSYUFDQwTWzSpjrwUCBqq4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/196732-fried-cabbage-with-bacon-onion-and-garlic-DDMFS-step-06-1520-c5b726fd4bbe4c1fa13f0c3ced0cdc0d.jpg"
      ],
      "image": "assets/images/196732/step_05.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
