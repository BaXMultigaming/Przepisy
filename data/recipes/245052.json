  "ingredients": [
    "1 cup crushed saltine crackers",
    "2 eggs, beaten",
    "1 pound Dover sole",
    "0.25 cup all-purpose flour",
    "2 tablespoons vegetable oil, or more as needed",
    "1 pinch fresh dill, or to taste",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Spread crushed crackers onto a plate. Pour eggs into a shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fish in a 1-gallon resealable plastic bag and add flour; gently shake until completely coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large, nonstick skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each flour-coated piece of fish in egg, allowing excess to drip back into dish, then press coated fish in cracker crumbs until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry fish in hot oil until lightly browned and fish flakes easily with a fork, about 5 minutes per side. Season fish with dill and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
