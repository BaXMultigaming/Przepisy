  "ingredients": [
    "1 large egg",
    "1 teaspoon honey",
    "1 cup panko bread crumbs",
    "0.5 cup grated Parmesan cheese",
    "12 asparagus spears, trimmed",
    "0.25 cup stone-ground mustard",
    "0.25 cup Greek yogurt",
    "1 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine egg and honey in a long, narrow dish and beat together. Combine panko and Parmesan cheese in a separate plate. Coat each asparagus stalk in egg mixture and roll in panko mix to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 6 spears in the air fryer and cook to desired brownness, 4 to 6 minutes. Repeat with remaining spears.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mustard, yogurt, and cayenne pepper in a small bowl. Serve dipping sauce alongside asparagus spears.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
