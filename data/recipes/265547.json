  "ingredients": [
    "2 (5 ounce) cans salmon, drained and flaked",
    "0.5 cup panko bread crumbs",
    "0.25 cup green bell pepper, diced",
    "0.25 cup green onions, diced",
    "2 large eggs",
    "2 teaspoons finely minced fresh ginger",
    "2 tablespoons soy sauce",
    "1 tablespoon sesame seeds",
    "1 teaspoon five-spice powder",
    "1 tablespoon sesame oil, or as needed"
  ],
  "steps": [
    {
      "text": "Mix salmon, panko, bell pepper, green onions, eggs, ginger, soy sauce, sesame seeds, and five-spice powder together in a bowl until well-combined. Form mixture into 4 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat sesame oil in a skillet over medium heat until shimmering. Working in batches, cook patties in the hot skillet until browned, 4 to 5 minutes. Flip and brown on the other side, 4 to 5 more minutes. Remove to a paper towel-lined plate to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
