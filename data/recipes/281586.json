  "title": "Easy Grilled Cauliflower Steaks",
  "description": "Cauliflower is cut into \"steaks\", lightly seasoned with olive oil and steak seasoning, and grilled for an easy side dish with smoky flavor.",
  "authors": [
    "Soup Loving Nicole"
  ],
  "date_published": "2020-09-13T22:09:24-04:00",
