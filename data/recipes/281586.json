  "ingredients": [
    "2 tablespoons olive oil",
    "1.5 teaspoons grill seasoning (such as Montreal Steak Seasoning®)",
    "1 large head cauliflower"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil and grill seasoning together in a small bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cauliflower on a cutting board and trim off inedible leaves. Trim off the bottom of the cauliflower stem but make sure to keep the core intact. Cut the cauliflower in half. Cut 1-inch-thick \"steaks\" out of each half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush each side with the seasoned oil. Grill for 6 minutes. Flip over and grill for 6 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
