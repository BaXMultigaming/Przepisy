  "ingredients": [
    "2.25 cups all-purpose flour",
    "0.5 cup white sugar",
    "1 teaspoon baking soda",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground nutmeg",
    "0.25 cup butter, melted",
    "1 egg, lightly beaten",
    "1 cup buttermilk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 375 degrees F (190 degrees C). Grease 12 muffin cups, or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour, sugar, baking soda, baking powder, salt, and nutmeg. In a separate bowl, whisk together the melted butter, egg, buttermilk, and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the buttermilk mixture into the dry ingredients and stir just until mixed (the batter will not be smooth). Gently stir in fruit, if desired (see Cook's Note).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop the batter into the prepared muffin tins; fill the cups almost to the top. Bake in the preheated oven until golden and the tops spring back when lightly pressed, about 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
