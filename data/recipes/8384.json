  "ingredients": [
    "1.5 cups butter",
    "1 (8 ounce) package cream cheese",
    "3 cups white sugar",
    "6 eggs",
    "3 cups all-purpose flour",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Uy6qIoWDi0uWD1hQXe9QqCKTnRc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8384-cream-cheese-pound-cake-Step-01-1002f24a49f3431cb0291315159c2f95.jpg"
      ],
      "image": "assets/images/8384/step_01.webp"
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 10-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and cream cheese together in a mixing bowl until smooth. Gradually add sugar and beat until fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zMCkL8sYKqZJoiGJX1Y9y5Qi6lg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8384-cream-cheese-pound-cake-Step-04-89ddec32489f4886a04db59cc2f82b4a.jpg"
      ],
      "image": "assets/images/8384/step_03.webp"
    },
    {
      "text": "Add eggs, two at a time, beating well with each addition. Add flour all at once and mix in. Mix in vanilla. Pour batter into the prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/whh9K6obK7ZQWX0ZCJxns2ejXIY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8384-cream-cheese-pound-cake-Step-05-7238452a81594783ac748c8f002fca9b.jpg"
      ],
      "image": "assets/images/8384/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 1 hour and 20 minutes, checking for doneness at 1 hour. A toothpick inserted into the center of the cake should come out clean. Remove and cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oEpta-Dd-atHhfThMthEN12IOT8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8384-cream-cheese-pound-cake-Step-07-d8a0c30a04d746d29041401c76de1f4b.jpg"
      ],
      "image": "assets/images/8384/step_05.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7BB9KlGqF5B9Et586sMp4UBaT_c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8384-cream-cheese-pound-cake-Beauty-3x4-8f259c3ac81947db9490ee84cf78f3a8.jpg"
