  "ingredients": [
    "4 egg yolks",
    "2 tablespoons distilled white vinegar",
    "2 teaspoons lemon juice",
    "2 teaspoons white sugar",
    "0.5 teaspoon dry mustard",
    "0.25 teaspoon salt",
    "2 cups vegetable oil"
  ],
  "steps": [
    {
      "text": "Beat egg yolks, vinegar, lemon juice, sugar, mustard, and salt together in a chilled bowl with an electric mixer. Increase the mixer speed to high and slowly pour oil into egg mixture, beating until mayonnaise is thick and creamy. Transfer mayonnaise to a jar and refrigerate until flavors blend, at least 1 hour.",
