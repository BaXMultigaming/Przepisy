  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "0.5 cup melted butter",
    "3 eggs",
    "3 cups pumpkin pie filling",
    "0.66666668653488 cup milk",
    "0.25 cup white sugar",
    "1 teaspoon ground cinnamon",
    "0.25 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (190 degrees C). Grease the bottom of a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour one cup of yellow cake mix into a medium size mixing bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining cake mix, 1/2 cup melted butter and 1 egg; mix well. Press into the baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin pie filling, 2 eggs and milk in a medium size mixing bowl; mix until smooth. Pour evenly over the crust in the 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the sugar and cinnamon into the mixing bowl containing the 1 cup of yellow cake mix. Cut in the butter until the mixture looks crumbly. Sprinkle this mixture over the pumpkin filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 45 to 50 minutes or until a knife inserted into the bars come out clean. Let cool before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
