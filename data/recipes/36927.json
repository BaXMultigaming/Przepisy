  "title": "Braised Lamb Shanks",
  "description": "These slow cooked lamb shanks are braised in a rich and flavorsome red wine sauce with rosemary, garlic, and tomatoes until fall-apart tender.",
  "authors": [
    "S HODGE"
  ],
  "date_published": "2019-04-02T02:44:19-04:00",
