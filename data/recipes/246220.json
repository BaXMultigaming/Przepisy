  "ingredients": [
    "1 cup dried white beans",
    "water to cover",
    "3 tablespoons olive oil",
    "1 onion, chopped",
    "2 carrots, cut into matchsticks",
    "0.5 pound fresh spinach",
    "5 cups chicken broth",
    "2 teaspoons minced garlic",
    "1 bay leaf",
    "3 tablespoons chopped fresh parsley",
    "1.5 teaspoons salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place white beans into a large container and cover with water; let soak 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain beans, reserving 2 cups soaking water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large pot over medium heat. Add onion and carrots; cook and stir until tender, about 6 minutes. Stir in spinach; cook until wilted, about 2 minutes. Add beans, reserved soaking water, broth, garlic, and bay leaf. Simmer, covered, until beans are tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Discard bay leaf. Pour half the soup into a blender. Cover and hold lid down with a potholder; puree until smooth. Stir pureed soup back into the pot. Season with parsley, salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
