  "ingredients": [
    "1 gallon water",
    "1 (15 ounce) package dried purple corn (maiz morado)",
    "2 cinnamon sticks",
    "1 tablespoon whole cloves",
    "5 large lemons, juiced",
    "1.5 cups brown sugar",
    "0.5 cup fresh pineapple, chopped",
    "0.5 apple, chopped"
  ],
  "steps": [
    {
      "text": "Bring the water to a boil with the corn, cinnamon sticks, and cloves in a large pot. Reduce heat to medium-low; simmer 40 minutes. Remove from the heat and strain through a mesh strainer to remove the corn and spices. Stir the lemon juice and sugar into the chicha until the sugar has dissolved. Refrigerate until cold.",
