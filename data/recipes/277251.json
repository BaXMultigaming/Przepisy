  "ingredients": [
    "2 tablespoons vegetable oil",
    "3 cups chopped red cabbage",
    "1.5 cups chopped celery",
    "1 cup chopped onion",
    "3 cloves garlic, crushed",
    "5 cups water",
    "1 cube vegetable bouillon",
    "1 (14 ounce) can diced tomatoes",
    "1 (6 ounce) can tomato paste",
    "2 tablespoons white vinegar",
    "0.25 cup brown sugar, or to taste",
    "0.5 teaspoon paprika",
    "0.5 teaspoon cayenne powder, or to taste",
    "0.25 teaspoon dried rosemary",
    "0.25 teaspoon dried thyme",
    "1 pinch salt and ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat oil in a large saucepan over medium heat. Stir in cabbage, celery, onion, and garlic. Cook until onion is translucent, about 5 minutes. Stir in water and vegetable bouillon. Add diced tomatoes, tomato paste, and vinegar. Continue stirring, slowly adding sugar until broth reaches the desired sweetness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season soup with paprika, cayenne, rosemary, thyme, salt, and pepper. Bring to a boil; reduce heat and simmer until vegetables are tender, 40 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
