  "title": "Scott Hibb's Amazing Whisky Grilled Baby Back Ribs",
  "description": "This recipe for cooking ribs in the oven, then grilling over high heat, features a barbecue sauce with molasses, vinegar, honey, and tomato paste.",
  "authors": [
    "Scott David Hibbard"
  ],
  "date_published": "2020-03-04T23:57:09-05:00",
  "date_modified": "2025-12-11T11:49:00-05:00",
