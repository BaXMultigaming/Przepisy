  "ingredients": [
    "2 (2 pound) slabs baby back pork ribs",
    "coarsely ground black pepper",
    "1 tablespoon ground red chile pepper",
    "2.25 tablespoons vegetable oil",
    "0.5 cup minced onion",
    "1.5 cups water",
    "0.5 cup tomato paste",
    "0.5 cup white vinegar",
    "0.5 cup brown sugar",
    "2.5 tablespoons honey",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon dark molasses",
    "2 teaspoons salt",
    "2 teaspoons garlic powder",
    "2 teaspoons whiskey",
    "1.25 teaspoons liquid smoke flavoring",
    "0.5 teaspoon onion powder",
    "0.25 teaspoon paprika",
    "0.25 teaspoon coarsely ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each full rack of ribs in half to make 4 half racks. Season with salt and black pepper (more black pepper than salt); sprinkle 1 tablespoon ground chile pepper over meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/37Vi69IseN22azHyKpMYoYlGGA8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35753_scotthibbsamazingwhiskeygrilledbabybackribs_ddmfs_step2_4x3_1072-13c945fccd2e432c9818a4e96da252ff.jpg"
      ],
      "image": "assets/images/35753/step_02.webp"
    },
    {
      "text": "Wrap each half rack in aluminum foil. Bake in the preheated oven for 2 hours and 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f75Zd3E--ktspOJKp1mJU5f2U5o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35753_scotthibbsamazingwhiskeygrilledbabybackribs_ddmfs_step2_4x3_1073-99a74e16316e4bc5b537c43a540a8b56.jpg"
      ],
      "image": "assets/images/35753/step_03.webp"
    },
    {
      "text": "Meanwhile, heat oil in a medium saucepan over medium heat. Cook and stir onion in hot oil for 5 minutes. Stir in water, tomato paste, vinegar, brown sugar, honey, and Worcestershire sauce. Add molasses, 2 teaspoons salt, garlic powder, whisky, remaining 1/2 tablespoon ground chile pepper, liquid smoke, onion powder, paprika, and 1/4 teaspoon black pepper. Bring to a boil, then reduce heat. Simmer uncovered until sauce thickens, about 1 hour and 15 minutes. Remove from heat and set sauce aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0-_XAEg8w2-9ZUG_DfuvBLOIhJs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35753_scotthibbsamazingwhiskeygrilledbabybackribs_ddmfs_step3_4x3_1085-cdaba005c8d94c969238a42182b39591.jpg"
      ],
      "image": "assets/images/35753/step_04.webp"
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grates.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove wrapped ribs from the oven. Let stand for 10 minutes, then remove ribs from the foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook ribs on the preheated grill for 3 to 4 minutes on each side. Brush sauce on ribs while grilling, just before you serve them (adding sauce too early will burn ribs).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QbrI4gkehWDDSB8-tx4kiHJKE6w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/35753_scott-hibbs-amazing-whiskey-grilled-baby-back-ribs_ddmfs_4x3_1168-356cc7fe00104c52b1aeba25abba1ddd.jpg"
      ],
      "image": "assets/images/35753/step_07.webp"
    }
  ],
