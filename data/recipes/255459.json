  "ingredients": [
    "0.75 cup butter",
    "0.75 cup brown sugar",
    "0.25 cup white sugar",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "2 eggs",
    "1 teaspoon root beer concentrate",
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 cup white chocolate chips, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together in a bowl with an electric mixer until creamy; beat in pudding mix. Add eggs and root beer concentrate; stir in flour and baking soda. Fold in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
