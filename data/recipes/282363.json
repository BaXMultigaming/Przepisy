  "ingredients": [
    "6 large Yukon Gold potatoes, peeled and cut into 1 1/2-inch chunks",
    "1 (6 ounce) package crumbled feta cheese",
    "0.5 cup milk",
    "2 cloves garlic, minced",
    "2 tablespoons salted butter",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes in a saucepan and cover with water. Bring to a boil and cook until tender, about 20 minutes. Remove from heat and drain well.",
