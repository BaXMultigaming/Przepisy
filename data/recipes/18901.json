  "ingredients": [
    "1 (32 ounce) package frozen potatoes au gratin",
    "1 (16 ounce) container sour cream",
    "4 cups shredded Cheddar cheese",
    "2 (10.75 ounce) cans condensed cream of chicken soup",
    "4 cups crushed cornflakes cereal"
  ],
  "steps": [
