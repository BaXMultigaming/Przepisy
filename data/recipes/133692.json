  "ingredients": [
    "1 tablespoon Dijon mustard",
    "1.5 teaspoons horseradish",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon dried thyme leaves",
    "0.25 teaspoon dried tarragon leaves",
    "0.25 teaspoon black pepper",
    "2 (8 ounce) beef tenderloin steaks",
    "Salt to taste"
  ],
  "steps": [
    {
      "text": "Stir together Dijon, horseradish, basil, thyme, tarragon, and pepper. Spread mixture evenly over top and sides of the steaks. Wrap individually with plastic wrap, and allow to marinate in the refrigerator overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray a small, glass baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unwrap steaks and sprinkle with salt to taste. Place into baking dish, and roast in preheated oven to desired degree of doneness (30 minutes for medium-rare, 60 minutes for well done).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
