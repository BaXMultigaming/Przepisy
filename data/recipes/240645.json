  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white in a large bowl with an electric mixer until frothy. Add pecans to egg white and stir until evenly coated.",
