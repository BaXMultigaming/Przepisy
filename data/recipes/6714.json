      ],
      "image": "assets/images/6714/step_04.webp"
    },
    {
      "text": "Add the flour mixture and stir until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mZq9A9n-thzccF5MT1YSJuEkJRA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6714-Banana-Oat-Muffin-ddmfs-step-5-3d3fdee3184b48c3854b2035fd488261.jpg"
