      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xIFqBd-QjYh_gm5BCuwnsMXV-QA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6714-Banana-Oat-Muffin-ddmfs-step-3-3ba130664d4046d4bb6a445e5ece084e.jpg"
