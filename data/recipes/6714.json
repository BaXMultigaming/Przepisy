  "ingredients": [
    "1.5 cups unbleached all-purpose flour",
    "1 cup rolled oats",
    "0.5 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 egg",
    "0.75 cup milk",
    "0.33333334326744 cup vegetable oil",
    "0.5 teaspoon vanilla extract",
    "1 cup mashed bananas"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (205 degrees C). Line a 12-cup muffin tin with paper liners.",
