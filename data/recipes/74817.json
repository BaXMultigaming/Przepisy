  "ingredients": [
    "2 pounds russet potatoes, cut into fries",
    "1 cup corn flour",
    "2 tablespoons cornmeal",
    "2 tablespoons Cajun seasoning",
    "1 quart oil for deep frying",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Place cut potatoes into a large bowl of cold water. Soak for 10 minutes. In a large resealable plastic bag, combine the corn flour, corn meal, and Cajun seasoning. Shake the bag to blend. Drain the potatoes, but leave them wet. Place the fries in the plastic bag with the seasoning, and shake to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oil in a deep-fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook fries in hot oil for 7 to 10 minutes, or until golden brown. Remove from the fryer to paper towels to drain. Season with a small amount of salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
