  "ingredients": [
    "2 egg whites",
    "1 teaspoon vanilla extract",
    "1 pinch salt",
    "1 cup semisweet chocolate chips",
    "0.25 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (170 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites with the salt until foamy. Slowly add sugar, one tablespoonful at a time, beating after each addition until the meringue stands in stiff peaks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in vanilla and fold in chocolate chips. Drop by teaspoonfuls on a lined baking sheet and place in preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "After 2 minutes, turn off oven. Leave meringues in oven overnight. Remove from pan and store in cookie tin lined with paper towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
