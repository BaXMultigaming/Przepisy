  "ingredients": [
    "2 gallons cold water",
    "0.5 cup Better Than Bouillon® Roasted Chicken Base",
    "1 cup maple syrup",
    "2 tablespoons black pepper",
    "0.5 tablespoon granulated garlic",
    "2 tablespoons fresh thyme"
  ],
  "steps": [
    {
      "text": "In the vessel that you will marinate the turkey in, combine all ingredients and mix well with a wire whisk, being sure that the chicken base is completely blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully place raw turkey or poultry into this vessel, being sure that the entire bird is covered with the brine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover vessel and place under proper refrigeration for 24 to 48 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to cook the turkey, carefully remove it from the brine and rinse under cold water and pat dry with a paper towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Your turkey is now ready to cook, as you normally would do.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
