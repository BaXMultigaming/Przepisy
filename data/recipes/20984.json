  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "3 tablespoons mayonnaise",
    "1 tablespoon Worcestershire sauce",
    "2 teaspoons lemon juice",
    "1 green onion, chopped",
    "1 (6 ounce) can canned crabmeat, drained"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium baking dish, mash the cream cheese with a fork. Blend in the mayonnaise, Worcestershire sauce, lemon juice and green onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse the crab meat and remove any pieces of shell. Flake the crab meat and mix it into the cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 15 to 20 minutes in the preheated oven. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
