  "ingredients": [
    "0.5 cup shortening",
    "0.5 cup white sugar",
    "1 egg, beaten",
    "0.5 cup molasses",
    "0.33300000429153 cup hot, brewed coffee",
    "1.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.25 teaspoon baking soda",
    "2 teaspoons ground cinnamon",
    "0.5 cup raisins",
    "0.25 cup butter",
    "2 cups confectioners' sugar",
    "2 tablespoons cold, brewed coffee"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the shortening and sugar. Blend in the egg, molasses and hot coffee. Sift together the flour, baking powder, baking soda and cinnamon; stir into the molasses mixture until well blended. Mix in the raisins. Pat the mixture evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for about 25 minutes in the preheated oven, or until firm. To make icing, combine butter, confectioners' sugar and cold coffee in a medium bowl; beat until smooth. Frost bars while warm, but allow them to cool before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
