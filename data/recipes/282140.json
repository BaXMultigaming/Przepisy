  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.33333334326744 cup packed brown sugar",
    "1 (15 ounce) can pumpkin puree",
    "2 teaspoons pure maple syrup",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground allspice"
  ],
  "steps": [
    {
      "text": "Beat cream cheese and brown sugar together in a bowl using a mixer until light and fluffy. Add pumpkin, maple syrup, vanilla extract, cinnamon, nutmeg, and allspice and beat on medium speed until well blended. Chill until serving.",
