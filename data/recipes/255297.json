  "ingredients": [
    "cooking spray",
    "0.5 cup brown rice",
    "1 cup diced celery",
    "1 red bell pepper, diced",
    "1 green bell pepper, diced",
    "3 skinless, boneless chicken breasts, cut into 1-inch pieces",
    "1 cup water",
    "2 tablespoons gluten-free soy sauce (tamari)",
    "1 tablespoon rice vinegar",
    "1 tablespoon minced garlic",
    "1.5 teaspoons minced ginger",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon salt",
    "1 (8 ounce) can sliced water chestnuts, drained",
    "1 cup cashews"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a large casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread brown rice at the bottom of the casserole dish. Layer celery, red bell pepper, and green pepper on top. Top with chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix water, soy sauce, rice vinegar, garlic, ginger, cumin, pepper, and salt in a small bowl. Pour over chicken. Arrange water chestnuts on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is tender, about 45 minutes. Add cashews. Continue baking until browned, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
