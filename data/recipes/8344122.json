  "ingredients": [
    "cooking spray",
    "1 (14.75 ounce) can cream-style corn",
    "1 (8.5 ounce) box dry corn muffin mix (such as Jiffy®)",
    "1 cup frozen corn kernels, thawed",
    "1 cup plain Greek yogurt",
    "2 large eggs",
    "2 cups chopped cooked chicken",
    "1 cup barbeque sauce",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream-style corn, muffin mix, corn, yogurt, and eggs together in a large bowl. Pour into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While casserole bakes, toss chicken with barbecue sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove casserole from oven. Top with chicken mixture and sprinkle with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake until cheese melts and chicken is heated through, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
