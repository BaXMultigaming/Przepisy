  "ingredients": [
    "2 cups mung bean vermicelli",
    "3 tablespoons vegetable oil",
    "0.5 pound ground pork",
    "2 tablespoons dark soy sauce, or more to taste",
    "2 teaspoons Sichuan peppercorn powder",
    "0.5 cup water",
    "2 stalks green onions, thinly sliced"
  ],
  "steps": [
    {
      "text": "Place vermicelli in a bowl and cover with water; soak for at least 15 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a large frying pan over medium heat until you can feel the heat above the pan. Put in ground pork; cook and stir until browned and crumbly, 5 to 7 minutes. Stir in 2 tablespoons soy sauce. Stir in peppercorn powder until evenly distributed. Add water and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add drained vermicelli and mix evenly with the pork. Cook until all water has evaporated, about 5 more minutes. Taste and add more soy sauce if not salty enough for you.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a serving plate and top with green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
