  "ingredients": [
    "1 pint fat-free half-and-half",
    "1 (14 ounce) can fat-free sweetened condensed milk",
    "1 teaspoon cinnamon",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine half-and-half and condensed milk in a small pot over medium-low heat; warm until steaming. Add cinnamon and vanilla extract. Heat for 5 more minutes, being careful not to boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and let stand for 5 minutes. Pour in a glass container and store in the refrigerator for up to 10 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
