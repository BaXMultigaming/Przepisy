  "ingredients": [
    "1 (16 ounce) package beef frankfurters",
    "8 slices processed American cheese",
    "8 slices bread",
    "8 teaspoons butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/17d88TTmV8v1Kt-XAyNMVKVsEKo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23117-wiener-winks-VAT-005-step-01-e6e19a433e504b36b81702e6cd294ae8.jpg"
      ],
      "image": "assets/images/23117/step_01.webp"
    },
    {
      "text": "Take 1 slice of bread and spread 1 teaspoon of butter on one side. Turn the bread over and place a slice of cheese on the bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/te6hNIqoByR4pnk37bIOnfRpL1E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23117-wiener-winks-VAT-005-step-02-02spreadingaciton-ed01c64abcab4deca551791928067b53.jpg"
      ],
      "image": "assets/images/23117/step_02.webp"
    },
    {
      "text": "Place a frankfurter diagonally on the cheese. Fold bread corner to corner around the frankfurter. Insert a toothpick to hold together. Repeat steps for the remaining frankfurters.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0sv3eXap1NZYRqE_MauiLMo-Bnc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23117-wiener-winks-VAT-008-step-03-a3128fd17b684dc59595fd4e666d45ba.jpg"
      ],
      "image": "assets/images/23117/step_03.webp"
    },
    {
      "text": "Bake in a preheated oven for 20 to 30 minutes or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aHjK6ISdo23KNY-X0QcmOuhzk90=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23117-wiener-winks-VAT-007-step-04-533277658e384d1698ebe438824b5563.jpg"
