  "ingredients": [
    "1 cup cultured coconut milk",
    "1.5 teaspoons dried parsley",
    "1.5 teaspoons lemon juice",
    "1 teaspoon garlic powder",
    "1 teaspoon dill",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon Dijon mustard",
    "salt and ground black pepper to taste"
