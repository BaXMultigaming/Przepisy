  "ingredients": [
    "1 (15 ounce) can red beets",
    "0.5 cup white vinegar",
    "0.5 cup cold water",
    "0.25 cup brown sugar",
    "1 small cinnamon stick",
    "4 whole cloves",
    "0.5 teaspoon salt",
    "6 hard-cooked eggs"
  ],
  "steps": [
    {
      "text": "Pour beet juice into a medium pot over medium heat. Stir in vinegar, cold water, brown sugar, cinnamon stick, cloves, and salt. Cook, stirring occasionally, until sugar is dissolved, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beets into liquid mixture and continue cooking until beets are heated through, about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place hard-cooked eggs in a container with a tight-fitting lid. Pour liquid and beets into the container with eggs. Store the container in the refrigerator for about 5 days before eating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
