  "ingredients": [
    "1 (1 pound) loaf processed cheese (such as Velveeta®), cubed",
    "0.5 cup milk",
    "2 pounds ground beef",
    "4 (10 ounce) cans diced tomatoes with green chile peppers (such as RO*TEL®)",
    "1 (1.25 ounce) package taco seasoning"
  ],
  "steps": [
    {
      "text": "Place processed cheese and milk in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat and cook and stir beef in the skillet until crumbly, evenly browned, and no longer pink. Drain and discard any excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir diced tomatoes and taco seasoning into ground beef and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer ground beef mixture to the slow cooker. Stir with milk and processed cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High until cheese is melted, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
