  "title": "Old-Time Taffy Pull",
  "description": "This is a delicious and basic recipe for a taffy pull. Enjoy.",
  "authors": [
    "Monica Jimenez"
  ],
  "date_published": "1999-11-05T17:54:37-05:00",
