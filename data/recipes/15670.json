  "ingredients": [
    "1 cup white sugar",
    "0.25 cup light corn syrup",
    "0.66666698455811 cup water",
    "2 tablespoons butter",
    "1 tablespoon cornstarch",
    "1 teaspoon salt",
    "1 teaspoon vanilla extract",
    "2 teaspoons almond extract",
    "0.5 cup sliced almonds",
    "10 drops green food coloring"
  ],
  "steps": [
    {
      "text": "Butter one 8-inch square pan; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 2-quart saucepan over medium heat, combine sugar, corn syrup, water, butter, cornstarch, and salt. Mix together well and bring to a boil. Heat without stirring until a candy thermometer reads 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat; stir in vanilla, almond extract, almonds, and food coloring. Pour mixture into prepared pan. Let stand until cool enough to handle. Taffy should be lukewarm in the center as well as at the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold, double, and pull taffy until it is light in color and stiff, 5 to 10 minutes. Butter hands lightly if taffy begins to stick. Cut taffy into pieces with scissors and wrap the pieces with plastic wrap to maintain shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
