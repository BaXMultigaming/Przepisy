  "ingredients": [
    "2 medium sweet potatoes",
    "2 tablespoons unsalted butter",
    "1 tablespoon honey",
    "1 tablespoon ground cinnamon",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Wash sweet potatoes and prick several times all over with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in a microwave on top of a paper towel and cover with another paper towel. Cook on high for 5 minutes (may need more depending on strength of microwave and thickness of potato).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the potatoes over and cook for another 5 minutes. Remove potatoes and test for softness. If not soft, cook for 1 to 2 minutes more. Wrap potatoes in aluminum foil and allow to cool, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice them open and add butter, honey, cinnamon, and salt. Mash the soft flesh with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
