  "ingredients": [
    "1 (14 ounce) can sweetened condensed milk",
    "0.33 cup unsweetened cocoa powder",
    "1 cup fresh sweet cherries, pitted and cut into quarters",
    "0.75 cup chocolate chunks",
    "2 cups heavy whipping cream",
    "2 teaspoons vanilla extract",
    "0.25 cup fresh sweet cherries, pitted and cut into eighths",
    "0.25 cup chocolate chunks"
  ],
  "steps": [
    {
      "text": "Stir together sweetened condensed milk and cocoa powder for ice cream in a large bowl, then add in cherries and chocolate chunks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream and vanilla extract in a chilled glass or metal bowl with an electric mixer until soft peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully fold whipped cream into the condensed milk mixture until fully combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Split the mixture between two loaf pans and garnish with cherries and chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press plastic wrap onto the surface of the mixture so it rests on top, and put another sheet across the sides of the pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Freeze until firm, about 8 hours.",
      "section": null,
      "name": null,
