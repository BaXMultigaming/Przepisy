  "ingredients": [
    "0.5 pound bacon, diced",
    "1 onion, chopped",
    "3 quarts water",
    "4 cubes chicken bouillon",
    "2.5 cups dry black-eyed peas",
    "0.5 teaspoon salt",
    "0.5 teaspoon pepper",
    "6 small potatoes, diced"
