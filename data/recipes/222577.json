  "ingredients": [
    "0.5 cup Italian seasoned bread crumbs",
    "0.5 cup grated Parmesan cheese",
    "2 teaspoons garlic powder",
    "1 teaspoon dried parsley",
    "ground black pepper to taste",
    "2 eggs, beaten",
    "3 zucchinis, sliced",
    "1 cup vegetable oil for frying",
    "1 tablespoon grated Parmesan cheese, or more to taste",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Mix bread crumbs, 1/2 cup Parmesan cheese, garlic powder, parsley, and black pepper together in a shallow bowl until well combined. Place beaten eggs in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hg05PzSwUkxzAL8jCfIjojT1iXw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222577-parmesan-fried-zucchini-DDMFS-Step-01-0dec815a500d4ed1a29dd51226127103.jpg"
      ],
      "image": "assets/images/222577/step_01.webp"
    },
    {
      "text": "Dip zucchini slices into eggs, then press into bread crumb mixture to coat, shaking off excess. Place breaded zucchini onto a plate in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B7UA1xM5aGIdNFw64GSRdbnqubc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222577-parmesan-fried-zucchini-DDMFS-Step-02-b0cf47c301ee4b7ca34739f2389f2540.jpg"
      ],
      "image": "assets/images/222577/step_02.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Fry breaded zucchini in hot oil in batches until golden brown, about 3 minutes. Transfer to a paper towel-lined plate to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sMMy-RwTm9H7UeZs8kudSHfgb7s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222577-parmesan-fried-zucchini-DDMFS-Step-03-7413cf9b5f85410f82976dd6af733681.jpg"
      ],
      "image": "assets/images/222577/step_03.webp"
    },
    {
      "text": "Sprinkle fried zucchini with 1 tablespoon Parmesan cheese and salt to serve.",
      "section": null,
