  "ingredients": [
    "1 cup non-dairy margarine",
    "0.5 cup brown sugar",
    "0.5 cup confectioners' sugar",
    "0.5 cup lukewarm water",
    "2 tablespoons ground flax seeds",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 cups rolled oats",
    "0.25 cup shredded coconut",
    "2.5 teaspoons ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.5 cup vegan chocolate chips",
    "0.5 cup dried apricots, quartered"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine margarine, brown sugar, and confectioners' sugar in a large bowl; beat with an electric mixer until creamy. Mix in water, flax seeds, and vanilla extract. Add flour and baking powder. Fold in oats, coconut, cinnamon, and cloves. Add chocolate chips and apricots.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into small balls and arrange on baking sheets. Flatten slightly with the palm of your hand.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
