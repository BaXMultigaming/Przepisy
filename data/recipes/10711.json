  "ingredients": [
    "0.5 cup butter",
    "0.5 cup shortening",
    "0.75 cup packed brown sugar",
    "0.5 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1.5 cups semisweet chocolate chips",
    "2 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, and salt in a large bowl. Beat softened butter, shortening, sugar, brown sugar, and vanilla in another bowl until creamy. Beat in egg, then gradually add flour mixture and mix well. Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on ungreased cookie sheet until edges are starting to turn golden brown, about 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
