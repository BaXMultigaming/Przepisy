  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "4 eggs",
    "0.5 cup butter",
    "vanilla extract",
    "4 cups confectioners' sugar",
    "8 ounces cream cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 13x9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine yellow cake mix, 2 eggs, butter, and vanilla in a large bowl; mix well. The batter will be stiff. Add cake batter to the prepared pan and spread evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine confectioners' sugar, cream cheese, and the remaining 2 eggs in a separate bowl; mix well and pour over the top of the cake batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cake in the preheated oven until set around the edges, just beginning to pull away from the sides, and slightly jiggly in the center, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cake cool completely before you cut it to achieve those delicious layers.",
      "section": null,
      "name": null,
      "url": null,
