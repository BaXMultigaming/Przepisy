  "ingredients": [
    "1 cup butter, softened",
    "0.75 cup superfine sugar",
    "0.75 cup light brown sugar",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 teaspoon cinnamon",
    "1 (3.4 ounce) package instant vanilla pudding mix",
    "2 cups semisweet chocolate chips",
    "1 cup chopped nuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat together the butter, brown sugar, superfine sugar, and vanilla until smooth and creamy; then add eggs, and beat well. In a large bowl, mix together flour, baking soda, salt, cinnamon, and pudding mix. Gradually mix the dry into the creamy mixture until well blended. Stir in chocolate chips and nuts, if using. Drop by teaspoonfuls 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated oven for 8 to 10 minutes, until golden brown. Remove from oven; allow cookies to cool momentarily on baking sheets before removing them to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
