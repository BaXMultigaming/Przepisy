  "ingredients": [
    "2 tablespoons butter, or more if needed",
    "2 leeks, cleaned and chopped",
    "0.5 cup chopped onion",
    "6 potatoes, peeled and cubed",
    "4 cups chicken broth",
    "1 cup half-and-half",
    "4 ounces shredded Cheddar cheese",
    "1 tablespoon chopped fresh parsley",
    "1 teaspoon garlic powder",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a pot over medium heat. Add leeks and onion; cook and stir until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add potatoes and chicken broth; simmer until potatoes are tender, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in half-and-half; simmer until slightly thickened, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in Cheddar cheese, parsley, garlic powder, salt, and black pepper until cheese is melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
