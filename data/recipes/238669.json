  "ingredients": [
    "1 (2 pound) package frozen hash brown potatoes, thawed",
    "1 (16 ounce) container sour cream",
    "12 ounces shredded sharp Cheddar cheese",
    "1 (10.75 ounce) can cream of celery soup",
    "1 onion, chopped",
    "0.5 cup butter, melted, divided",
    "0.25 teaspoon ground white pepper",
    "0.125 teaspoon cayenne pepper",
    "1 cup crushed corn flakes",
    "1 cup crushed cheese-flavored crackers (such as Cheez-It®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine hash browns, sour cream, Cheddar cheese, celery soup, onion, 1/4 cup butter, white pepper, and cayenne pepper in a bowl; transfer to a 9x13-inch baking dish. Sprinkle corn flakes and cheese-flavored crackers over casserole; drizzle remaining 1/4 cup butter over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling and cooked through, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
