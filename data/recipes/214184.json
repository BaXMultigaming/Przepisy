  "ingredients": [
    "1.6666667461395 cups vegetable oil",
    "2 (1 ounce) envelopes ranch dressing mix",
    "3 tablespoons crushed red pepper flakes",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "0.5 teaspoon black pepper",
    "1 (16.5 ounce) package multigrain saltine crackers"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1ZSLUkAaK--wqf6uQdVFL2c5jl0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-214184-alabama-fire-crackers-step-1-71a03f2c78e348ff93013129274df757.jpg"
      ],
      "image": "assets/images/214184/step_01.webp"
    },
    {
      "text": "Place vegetable oil, ranch dressing mix, crushed red pepper flakes, garlic powder, onion powder, and black pepper in a 2-gallon resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gjY2YxLcM94IzZ6LlXhPn9-Zdtk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-214184-alabama-fire-crackers-step-2-13e651c4f5454bcf8fe4d60a93d0f498.jpg"
      ],
      "image": "assets/images/214184/step_02.webp"
    },
    {
      "text": "Seal the bag and squeeze with your hands until oil and spices are well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2DX6vm5wvZNF_3DJUFfFBxzoXuE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-214184-alabama-fire-crackers-step-3-a78c46b06f2a4b978838bce055ae0dc5.jpg"
      ],
      "image": "assets/images/214184/step_03.webp"
    },
    {
      "text": "Place crackers into the bag, seal, and turn the bag over to coat crackers with spice mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xf-Gmuvl6KDygWUjvarH1ux3ea0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-214184-alabama-fire-crackers-step-4-cf136792f21046de87d32e76d47c32af.jpg"
      ],
      "image": "assets/images/214184/step_04.webp"
    },
    {
      "text": "Let sit for about 1 hour, then turn again. Repeat several times until crackers are well-coated with spice mix, then allow the bag to sit 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8nA7wOLe6nnp6i7S2XvtytzI3ag=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-214184-alabama-fire-crackers-step-5-e852fc4d96b042dbb20c40affce5520a.jpg"
      ],
      "image": "assets/images/214184/step_05.webp"
    },
    {
      "text": "Remove crackers and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w7WCfEevHi08KDQhhcc0OGRZX7E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-214184-alabama-fire-crackers-4x3-8ce79d790f29486581528d76154678ee.jpg"
