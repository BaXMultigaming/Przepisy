  "ingredients": [
    "0.75 cup butter",
    "3.25 cups all-purpose flour",
    "0.33333334326744 cup white sugar",
    "2.5 teaspoons baking powder",
    "0.5 pinch baking soda",
    "0.5 teaspoon salt",
    "1 cup buttermilk",
    "1 (10 ounce) package cinnamon baking chips",
    "2 tablespoons butter, melted",
    "2 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Place 3/4 cup butter into the freezer for 1 hour. Cut into cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 1/3 cup sugar, baking powder, baking soda, and salt in a large bowl using a whisk. Cut in very cold cubed butter with a pastry blender or using your fingers until you get coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Create a well in the flour mixture; add buttermilk and stir gently until dough is just moistened. Fold in cinnamon chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a lightly floured surface. Knead gently until dough is no longer sticky, 10 to 12 times, and divide in half. Pat or roll each portion gently into a 7-inch circle. Brush melted butter over circles. Sprinkle each with 1 tablespoon sugar. Cut each circle into 6 wedges. Separate and place scones on an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 10 to 13 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
