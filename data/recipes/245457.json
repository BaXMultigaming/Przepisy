  "ingredients": [
    "2 pints whole cherry tomatoes",
    "0.5 cup fresh sage leaves",
    "6 sprigs fresh thyme, leaves removed",
    "6 sprigs fresh oregano, leaves removed",
    "0.5 cup olive oil",
    "Salt and cracked black pepper to taste",
    "Reynolds Wrap® Aluminum Foil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with Reynolds Wrap® Aluminum Foil. Place cherry tomatoes on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Distribute sage and thyme amongst tomatoes, reserving about 1 tablespoon of each for garnishing. Drizzle generously with olive oil. Sprinkle with salt and pepper. Roast until tomatoes blister, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tomatoes and place into a bowl, tossing with all juices collected in the foil. Garnish with additional fresh thyme, sage, and oregano. Season with salt and pepper to taste and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
