  "ingredients": [
    "1 (10.75 ounce) can condensed tomato soup",
    "2 (.25 ounce) envelopes unflavored gelatin",
    "0.5 cup cold water",
    "6 ounces cream cheese, softened",
    "1 cup mayonnaise",
    "1 pound cooked shrimp",
    "1 cup minced celery",
    "0.5 cup green onions, minced"
  ],
  "steps": [
    {
      "text": "Heat soup in a small saucepan or in a microwave oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir gelatin into cold water. Mix hot tomato soup into the gelatin liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium size mixing bowl, combine cream cheese and mayonnaise together. Mix soup mixture into the mayonnaise and cream cheese mixture. Mix well. Add shrimp, celery, and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon the mixture into a 1 quart mold and refrigerate for at least 1 hour, but preferably overnight. Unmold onto a serving plate before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
