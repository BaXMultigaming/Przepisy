  "ingredients": [
    "3 ounces rice vermicelli noodles",
    "2 ounces cooked chicken, diced",
    "0.5 cup diced bok choy",
    "0.33333334326744 cup shredded carrot",
    "1 tablespoon chopped green onion",
    "1 teaspoon dashi broth powder",
    "1 teaspoon nutritional yeast flakes",
    "1 teaspoon grated fresh ginger",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon ground white pepper",
    "0.125 teaspoon red pepper flakes, or more to taste",
    "1 tablespoon tamari soy sauce",
    "1 teaspoon toasted sesame oil",
    "0.5 teaspoon gluten-free miso paste",
    "1.5 cups boiling water",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Combine rice noodles, chicken, bok choy, carrot, green onion, dashi, nutritional yeast, ginger, black pepper, white pepper, and red pepper flakes in a large, portable bowl with a lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tamari, sesame oil, and miso paste in a small, portable container. Cover and shake until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add hot water to the noodle bowl when ready to eat. Push aside the noodles and crack egg into the middle, stirring constantly with chopsticks. Close lid and let sit until noodles soften, about 3 minutes. Remove the cover and pour in tamari mixture.",
      "section": null,
      "name": null,
      "url": null,
