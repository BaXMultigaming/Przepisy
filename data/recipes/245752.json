  "ingredients": [
    "cooking spray",
    "0.33333334326744 cup Buffalo wing sauce (such as Frank's®)",
    "3 tablespoons mayonnaise",
    "1 large egg",
    "6 cups cauliflower florets",
    "1.5 cups garlic croutons",
    "0.25 cup grated Parmesan cheese",
    "0.25 cup blue cheese salad dressing",
    "0.25 cup sour cream",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Spray a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk wing sauce, mayonnaise, and egg together in a large bowl. Toss cauliflower florets in the sauce mixture to coat completely. Spread cauliflower out on baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pulse croutons into fine crumbs in a food processor. Add Parmesan cheese and mix to combine. Sprinkle crouton and cheese mixture over cauliflower.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cauliflower is golden brown and tender, about 15 minutes. Let sit before removing from baking sheet, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix blue cheese dressing with sour cream and black pepper to make dip. Serve dip alongside cauliflower.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
