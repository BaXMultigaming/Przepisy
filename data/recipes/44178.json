  "ingredients": [
    "2 tablespoons butter",
    "1 Royal Gala apple - peeled, cored and sliced",
    "1 cup white wine",
    "0.25 cup brown sugar",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon vanilla extract",
    "0.33333334326744 cup golden raisins"
