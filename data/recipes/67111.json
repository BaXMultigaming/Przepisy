  "ingredients": [
    "2 cups white sugar",
    "1.5 cups wheat flour",
    "1.5 cups all-purpose flour",
    "0.5 cup oatmeal",
    "0.5 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 teaspoon ground allspice",
    "0.5 teaspoon ground cloves",
    "2 teaspoons baking soda",
    "2 cups ripe Hachiya persimmon pulp",
    "0.5 cup applesauce",
    "0.5 cup vegetable oil",
    "3 eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, wheat flour, all-purpose flour, oatmeal, salt, cinnamon, nutmeg, allspice, cloves, and baking soda together in a large bowl until well mixed. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir persimmon pulp, applesauce, vegetable oil, and eggs until well blended. Combine the wet and dry ingredients, stirring until free of lumps. Divide batter between two prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the loaves comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
