  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "4 eggs, beaten",
    "1.5 cups white sugar",
    "1 cup vegetable oil",
    "0.66666668653488 cup water",
    "1 cup all-purpose flour",
    "1 cup whole-wheat pastry flour",
    "0.75 cup powdered milk",
    "0.75 cup ground unsalted almonds",
    "0.5 cup flax seed meal",
    "2 teaspoons baking soda",
    "1.5 teaspoons salt",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon ground ginger",
    "0.25 (18 ounce) package miniature semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a large bar-cookie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pumpkin puree, eggs, sugar, oil, and water together in a large bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir all-purpose flour, pastry flour, powdered milk, almonds, flax seed meal, baking soda, salt, cinnamon, nutmeg, cloves, and ginger together with a whisk in a separate bowl; stir into the pumpkin mixture until you have a smooth batter. Pour the batter into the prepared pan. Sprinkle chocolate chips over the top of the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes. Let cool completely before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
