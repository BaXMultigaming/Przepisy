  "ingredients": [
    "6 cups tart apples - peeled, cored and sliced",
    "1.25 teaspoons ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 cup white sugar",
    "0.75 cup milk",
    "0.5 cup biscuit mix (e.g. Bisquick)",
    "2 eggs",
    "2 tablespoons butter",
    "1 cup biscuit mix (e.g. Bisquick)",
    "0.5 cup chopped walnuts",
    "0.33333334326744 cup light brown sugar",
    "3 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 10-inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix apples, cinnamon, and nutmeg together; turn mixture into pan. In a separate bowl, beat sugar, milk, 1/2 cup biscuit mix, eggs, and butter until smooth. Pour over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, stir together 1 cup biscuit mix, nuts, brown sugar and butter; mix until crumbly. Sprinkle streusel over top of pie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 55 to 60 minutes; bake until knife inserted in center of pie comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
