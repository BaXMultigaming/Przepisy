  "ingredients": [
    "4.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 cups butter",
    "1.5 teaspoons white sugar",
    "0.5 pint sour cream",
    "5 eggs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the flour, baking powder, butter or margarine, sugar, sour cream and eggs. Knead until dough is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle a work surface generously with confectioners' sugar. Roll dough out over the confectioners' sugar to 1/4 inch thick, adding more as needed. Cut out into 3 inch squares and fill with nut, poppyseed or prune filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 15 minutes. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
