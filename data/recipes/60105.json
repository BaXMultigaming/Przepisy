  "ingredients": [
    "2 tablespoons butter",
    "2 cloves garlic, minced",
    "1 onion, chopped",
    "1 (28 ounce) can peeled and diced tomatoes",
    "0.5 teaspoon dried dill weed",
    "0.25 teaspoon salt",
    "0.25 teaspoon pepper",
    "1 (10.5 ounce) can condensed chicken broth",
    "1 bay leaf"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium heat. Add onion and garlic, and cook, stirring until tender. Stir in tomatoes and condensed chicken broth, and season with dill weed, salt, pepper, and bay leaf. Bring to a boil, then reduce heat and simmer for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat, and discard bay leaf. Use a food processor or blender to purée the soup in small batches until smooth. Serve immediately, or chill and serve cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
