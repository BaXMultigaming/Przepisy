  "ingredients": [
    "2 cups butter, softened",
    "1 cup white sugar",
    "2 teaspoons vanilla extract",
    "4 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nFTB7pNYJ5bEJwU3SlewLe40iLw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10269-shortbread-cookies-ii-ddmfs-step-1-004eeb316b8843088b901999159f2225.jpg"
