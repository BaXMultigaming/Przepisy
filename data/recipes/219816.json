  "ingredients": [
    "2 ripe bananas, mashed",
    "1 (8 ounce) package cream cheese, softened",
    "1 cup white sugar",
    "0.5 cup butter",
    "2 eggs, well-beaten",
    "2.25 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat bananas, cream cheese, sugar, butter, and eggs together in a large bowl until very smooth. Stir in flour, baking powder, and baking soda until just combined; fold in walnuts. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour 15 minutes. Cool in the pan for 10 minutes before removing from the pan to cool completely on a wire rack, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
