  "ingredients": [
    "12 slices bread, cut into 1-inch cubes",
    "2 (8 ounce) packages cream cheese, cubed",
    "1 cup fresh blueberries",
    "12 large eggs",
    "2 cups milk",
    "0.33333334326744 cup maple syrup",
    "1 cup water",
    "1 cup white sugar",
    "2 tablespoons cornstarch",
    "1 cup fresh blueberries",
    "1 tablespoon unsalted butter"
  ],
  "steps": [
    {
      "text": "Grease a 9x13-inch pan and spread half of the bread cubes over the bottom. Top with cream cheese and 1 cup blueberries. Layer remaining bread cubes on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together eggs, milk, and syrup in a bowl. Pour over the bread cubes in the pan. Cover and refrigerate for 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the refrigerator and let stand for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, covered, for 30 minutes. Uncover and continue to bake until a knife inserted into the center comes out clean, about 25 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While casserole bakes, combine water, sugar, and cornstarch for sauce. Bring to a boil until thickened. Reduce to a simmer and add blueberries and butter until cooked down. Serve on top of casserole or on the side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
