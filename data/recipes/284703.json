  "ingredients": [
    "4 pounds boneless, skinless chicken thighs",
    "0.75 cup soy sauce",
    "0.75 cup orange juice",
    "0.33333334326744 cup olive oil",
    "0.33333334326744 cup ketchup",
    "0.33333334326744 cup chopped fresh parsley",
    "3 cloves garlic, minced",
    "3 teaspoons lemon juice",
    "1.5 teaspoons dried oregano",
    "1.5 teaspoons ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W-TE94uePU1nniMIMv0A-RZpzmM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/284703-grilled-chicken-thighs-VAT-005-step-01-512bca0a8ab4478488d8c3dbe8138305.jpg"
      ],
      "image": "assets/images/284703/step_01.webp"
    },
    {
      "text": "Rinse chicken thighs and pat dry between paper towels. Transfer to a 1-gallon zip-top freezer bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7qR8TnYxa99nJs5uPM6C_EqBCKo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/284703-grilled-chicken-thighs-VAT-006-step-02-01781c0103794c9893b0c59aec69657f.jpg"
      ],
      "image": "assets/images/284703/step_02.webp"
    },
    {
      "text": "Mix soy sauce, orange juice, olive oil, ketchup, parsley, garlic, lemon juice, oregano, and pepper in a large bowl until marinade is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iDRs8n7RLUTh1x-Svx7JCjgb5fA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/284703-grilled-chicken-thighs-VAT-007-step-03-02-3037e8a8874b46b2b250159945852eb0.jpg"
      ],
      "image": "assets/images/284703/step_03.webp"
    },
    {
      "text": "Pour marinade over chicken thighs in the freezer bag. Squeeze out excess air, seal the bag, and marinate in the refrigerator for at least 1 hour and up to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LIQRKP5DUWh_PVOa48u0WfhC_II=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/284703-grilled-chicken-thighs-VAT-008-step-04-04f807ecc5c24ec9a5b74b56764e45a3.jpg"
      ],
      "image": "assets/images/284703/step_04.webp"
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Remove chicken thighs from marinade and shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GpgD4dleD4SKFRne4h7qGsXr3us=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/284703-grilled-chicken-thighs-VAT-009-step-05-54dcfa4da63548d389c881f908103a71.jpg"
      ],
      "image": "assets/images/284703/step_05.webp"
    },
    {
      "text": "Cook chicken in a single layer on the preheated grill until no longer pink in the center, 5 to 7 minutes per side. An instant-read thermometer inserted into the center of chicken thighs should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E7WtTaYU6rrrZbQIFyhefxE5Jus=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/284703-grilled-chicken-thighs-VAT-010-step-06-02-b689ee9e4b694d2fb0c6c5f6c1de20d2.jpg"
      ],
      "image": "assets/images/284703/step_06.webp"
    }
