  "ingredients": [
    "1 (16 ounce) package whole white button mushrooms",
    "2 scallions",
    "4 ounces cream cheese, softened",
    "0.25 cup finely shredded sharp Cheddar cheese",
    "0.25 teaspoon ground paprika",
    "1 pinch salt",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Gently clean mushrooms with a damp cloth. Remove and discard stems.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mince scallions, separating white and green parts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 360 degrees F (182 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese, Cheddar cheese, scallion whites, paprika, and salt together in a small bowl. Stuff mixture into mushrooms, pressing gently with the back of a small spoon to fill each cavity.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray the air fryer basket with cooking spray and set mushrooms inside without overcrowding; you may need to work in batches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry mushrooms until filling is lightly browned, about 8 minutes. Transfer to a serving plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle mushrooms with scallion greens. Let cool for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
