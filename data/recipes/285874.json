  "ingredients": [
    "2.5 cups gluten-free all-purpose flour (such as King Arthur®)",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups light brown sugar",
    "0.5 cup vegan butter (such as Earth Balance®), softened",
    "2 large eggs",
    "1.5 teaspoons vanilla extract",
    "1.5 cups vegan chocolate chips (such as Enjoy Life®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour, baking soda, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and vegan butter in a large bowl for 2 to 3 minutes. Mix in eggs and vanilla. Add flour mixture and mix until combined. Fold in vegan chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop small spoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, rotating halfway through about 10 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
