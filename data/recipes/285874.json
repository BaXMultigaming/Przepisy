  "title": "Dairy-Free, Gluten-Free Chocolate Chip Cookies",
  "description": "These allergy-friendly chocolate chip cookies are made with gluten-free flour and vegan butter and vegan chocolate chips.",
  "authors": [
    "Avery"
  ],
