  "ingredients": [
    "1 package Duncan Hines® Moist Deluxe® Fudge Marble Cake Mix",
    "2 (8 ounce) packages cream cheese",
    "8 ounces milk chocolate, melted",
    "3 large eggs",
    "0.66666668653488 cup whipping cream",
    "0.25 cup butter or margarine, melted",
    "whipping cream",
    "fresh strawberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Grease and flour 13 x 9 x 2-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For filling, combine contents of cocoa packet from mix, 1/4 cup cake mix, cream cheese and melted chocolate in large bowl. Beat at high speed with electric mixer for 2 minutes. Add eggs and cream. Beat at high speed for 1 minute. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For crust, stir remaining cake mix and melted butter in medium bowl. Mixture will be crumbly. Sprinkle mixture into pan. Pour filling over mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F for 30 to 35 minutes. Cool in pan. Refrigerate until chilled. Garnish individual servings with dollops of whipped cream and strawberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
