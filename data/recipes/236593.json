  "ingredients": [
    "1.5 cups white sugar",
    "0.5 cup applesauce",
    "3 ripe bananas, pureed",
    "0.5 cup plain fat-free Greek yogurt",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2 cups gluten-free all-purpose baking flour (such as Bob's Red Mill®)",
    "2 teaspoons xanthan gum",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 cup miniature chocolate chips, or more to taste",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and applesauce together in a bowl with an electric mixer; add pureed bananas, yogurt, egg, and vanilla and beat until well-combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, xanthan gum, baking powder, and baking soda together in a bowl. Add flour mixture to applesauce mixture and stir until just combined. Fold chocolate chips and walnuts into batter. Spoon batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the loaf comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
