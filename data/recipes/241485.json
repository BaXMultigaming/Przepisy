  "ingredients": [
    "2 gallons water",
    "2 cups brown sugar",
    "1 cup pork seasoning (such as Fraboni's® Porketta®)",
    "1 cup garlic powder",
    "1 cup onion powder",
    "4 ounces pink speed-cure salt"
  ],
  "steps": [
    {
      "text": "Put water into a large pot; add brown sugar, pork seasoning, garlic powder, onion powder, and curing salt. Bring the mixture to a boil, reduce heat to low, and cook and stir until the seasonings are completely dissolved, 20 to 30 minutes.",
