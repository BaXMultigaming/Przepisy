  "ingredients": [
    "12 vanilla wafers",
    "2 (8 ounce) packages cream cheese, softened",
    "2 eggs",
    "2 tablespoons lemon juice",
    "0.66666668653488 cup white sugar",
    "1 (21 ounce) can cherry pie filling, or flavor of choice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line muffin tins with 12 paper baking cups. Place a vanilla wafer in each one.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q8_5vbWfxZXMRC12BHtLzgyeauc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15823-mini-cheesecakes-VAT-step-02-2a72274daa22428e9f2cdddb404019f7.jpg"
      ],
      "image": "assets/images/15823/step_02.webp"
    },
    {
      "text": "In a medium mixing bowl beat cream cheese until fluffy. Add eggs, lemon juice, and sugar. Beat until smooth and thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Sh5JwHIZ0kbxgEdXERIUO_3KUCk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15823-mini-cheesecakes-VAT-step-03-7d8c62bafce44f71bbf933dd0b837050.jpg"
      ],
      "image": "assets/images/15823/step_03.webp"
    },
    {
      "text": "Fill each baking cup 2/3 full with cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qddyyLgLVbGkdYXQloAyWBYa_CU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15823-mini-cheesecakes-VAT-step-04-4fd02d3b2a2d4848a578d454785b31eb.jpg"
      ],
      "image": "assets/images/15823/step_04.webp"
    },
    {
      "text": "Bake in preheated oven for 15 to 17 minutes. Cool on a rack. Top with fruit pie filling or topping of your choice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lAuRs0ydiVLWwD9JsRQR4JIWCH0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15823-mini-cheesecakes-VAT-step-05-5ca6ee07de1d4721b34c9ca00456ddb8.jpg"
