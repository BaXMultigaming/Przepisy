  "ingredients": [
    "1.25 cups all-purpose flour",
    "2 tablespoons granulated sugar",
    "0.25 tablespoon vanilla powder",
    "0.5 cup milk",
    "1 egg",
    "2 tablespoons butter, melted",
    "1 teaspoon rum flavoring",
    "4 ripe bananas, sliced",
    "2 cups oil for frying"
  ],
  "steps": [
    {
      "text": "Combine flour, sugar, and vanilla powder in a large bowl; make a well in the center. Pour milk, egg, melted butter, and rum flavoring into the well; mix until smooth. Fold in banana slices until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a wok or deep fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop banana mixture by tablespoon into hot oil. Fry in hot oil until golden brown and crispy, 10 to 15 minutes. Remove bananas from oil and drain them on paper towels. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
