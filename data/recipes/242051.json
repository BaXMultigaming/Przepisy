  "ingredients": [
    "2 tablespoons cornmeal",
    "2 tablespoons Italian-seasoned bread crumbs",
    "0.25 teaspoon salt",
    "0.25 teaspoon paprika",
    "0.125 teaspoon dried dill weed",
    "1 dash ground black pepper",
    "0.25 cup milk",
    "1 pound orange roughy, cut into 1 1/2x2-inch pieces",
    "3 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 500 degrees F (260 degrees C) with rack positioned slightly above middle of oven. Generously grease a 13x9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornmeal, bread crumbs, salt, paprika, dill, and black pepper in a shallow bowl. Pour milk into a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip orange roughy pieces into milk, then press into bread crumb mixture to coat on all sides. Gently toss pieces between your hands so any bread crumbs that haven't stuck fall away. Place breaded orange roughy in the prepared baking dish in a single layer; drizzle butter over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with fork, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
