  "ingredients": [
    "1 tablespoon cornstarch",
    "0.25 cup dry white wine",
    "4 tablespoons peanut oil",
    "2 green onions, minced",
    "1.5 pounds scallops",
    "1 cup clam juice",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground cayenne pepper",
    "0.5 teaspoon ground ginger",
    "0.33333334326744 (8 ounce) can sliced water chestnuts"
  ],
  "steps": [
    {
      "text": "In a small bowl, dissolve cornstarch in 1/4 cup dry white wine. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, heat peanut oil on medium-high heat until almost smoking. Remove the skillet from heat and add green onions. Return the skillet to heat and cook, stirring constantly, until the scallions are soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the scallops to the skillet. Cook the scallops for 1 minute, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add clam juice or broth to the skillet. Continue stirring. Add salt and red pepper or hot sauce to taste. Stir in ginger and water chestnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the mixture of dissolved cornstarch and white wine. Turn the heat to high, and cook the mixture until it boils and thickens.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
