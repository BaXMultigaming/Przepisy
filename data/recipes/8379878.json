  "ingredients": [
    "1 (6 ounce) container nonfat vanilla yogurt",
    "1 (6 ounce) container nonfat lemon yogurt",
    "1 (8 ounce) can crushed pineapple, drained",
    "1 (3 ounce) package fat-free, sugar-free lemon pudding mix (such as Jell-O®)",
    "1 cup low-fat frozen whipped topping (such as Cool Whip® Lite), thawed",
    "4 teaspoons toasted coconut",
    "4 fresh blueberries"
  ],
  "steps": [
    {
      "text": "Combine vanilla yogurt, lemon yogurt, pineapple, and pudding mix in a bowl; stir until well combined. Fold in whipped topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon mixture into 4 dessert dishes, and chill for about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish each dessert with a blueberry, toasted coconut, or an additional dollop of the whipped topping, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
