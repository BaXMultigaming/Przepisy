  "ingredients": [
    "1 cup white sugar",
    "1 cup light corn syrup",
    "1 cup peanut butter",
    "6 cups crispy rice cereal",
    "1 cup semisweet chocolate chips",
    "1 cup butterscotch chips"
  ],
  "steps": [
    {
      "text": "Butter a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan over medium heat, combine the sugar and corn syrup, and bring to a rolling boil. Remove from heat, and stir in peanut butter. Mix in the rice cereal until evenly coated. Press the mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a glass bowl in the microwave, melt the chocolate and butterscotch chips, stirring occasionally until smooth and well blended. Spread over the top of the bars. Chill until set, then cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
