  "ingredients": [
    "2 cups sifted all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup butter, softened",
    "1 cup packed brown sugar",
    "1 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1.5 cups rolled oats",
    "1 cup chopped walnuts",
    "1 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Sift flour, baking powder, soda and salt. In a separate bowl cream butter until fluffy; add sugars, eggs and vanilla. Beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour mixture to butter mixture. Mix well. Stir in oats, nuts, and coconut. Mix until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on ungreased cookie sheets for 10-12 minutes at 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
