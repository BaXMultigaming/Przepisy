  "ingredients": [
    "cooking spray",
    "8 large eggs",
    "1 cup milk",
    "salt and pepper to taste",
    "2 cups diced ham",
    "1 cup shredded American cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Generously grease a 9-inch deep-dish pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a large bowl until frothy on top. Whisk in milk, salt, and pepper until well combined. Stir in ham and then cheese until well combined; pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set in the center and lightly browned on top, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
