  "ingredients": [
    "2 cups sifted all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.75 cup white sugar",
    "0.25 cup unsalted butter, softened",
    "1 teaspoon vanilla extract",
    "1 large egg",
    "0.5 cup milk",
    "2 cups frozen blueberries",
    "1 tablespoon white sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Butter a 9x9-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking powder, and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar, butter, and vanilla together in another bowl. Add egg and beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a wooden spoon, stir in dry ingredients in 3 additions alternately with the milk (ending with dry) just until flour is incorporated. Do not overbeat. Fold in blueberries. Turn into the prepared cake pan and spread evenly with a spatula. Frozen blueberries make dough very stiff, so pressing with moistened fingertips works better for me. Combine 1 tablespoon sugar and cinnamon in a small bowl; sprinkle on top of batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
