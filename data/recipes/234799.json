  "ingredients": [
    "1 (12 ounce) package egg noodles",
    "1 pound ground beef",
    "1 teaspoon Greek seasoning (such as Cavender's®)",
    "salt and ground black pepper to taste",
    "1 teaspoon vegetable oil",
    "1 (16 ounce) package sliced fresh mushrooms",
    "1 pint sour cream"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat a large skillet over medium-high heat. Add ground beef; cook and stir until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Season beef with Greek seasoning, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a separate skillet over medium heat. Add mushrooms; cook and stir until tender, about 5 minutes; add to ground beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sour cream into ground beef mixture; cook and stir until hot, about 5 minutes. Serve over egg noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
