  "ingredients": [
    "cooking spray",
    "1 cup butter",
    "0.5 cup packed brown sugar",
    "1 teaspoon vanilla extract",
    "3 cups quick-cooking oats",
    "1 cup semisweet chocolate chips",
    "0.5 cup peanut butter"
  ],
  "steps": [
    {
      "text": "Grease a 9-inch square baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Stir in brown sugar and vanilla extract. Add oats and cook over low heat until combined, 2 to 3 minutes. Spread 1/2 of the oat mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate chips with peanut butter in small heavy saucepan over low heat, stirring frequently until smooth, about 4 minutes. Pour chocolate mixture over oat layer and spread evenly. Crumble remaining oat mixture over chocolate, pressing in gently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover with plastic wrap and chill until set, 2 to 3 hours or overnight. Bring to room temperature before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
