  "ingredients": [
    "1 pound ground pork",
    "1 pound ground turkey",
    "8 ounces fresh mushrooms, sliced",
    "2 eggs",
    "2 tablespoons dry bread crumbs",
    "1.5 teaspoons Worcestershire sauce",
    "1 clove garlic, minced",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon basil"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground pork, ground turkey, mushrooms, eggs, bread crumbs, Worcestershire sauce, garlic, Italian seasoning, and basil in a large bowl using your hands; pat into a 9-inch pie plate. Place pie plate on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the baking sheet on the grill grate, close the lid, and cook on the preheated grill until no longer pink in center, 30 to 45 minutes. An instant-read thermometer inserted into center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
