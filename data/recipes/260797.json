  "ingredients": [
    "cooking spray",
    "1 cup unsweetened dark cocoa powder",
    "0.5 cup hot coffee",
    "0.5 cup whole milk, warmed",
    "3 cups all-purpose flour",
    "1 teaspoon salt",
    "0.25 teaspoon baking powder",
    "3 cups white sugar",
    "1.5 cups butter, softened",
    "1 (8 ounce) package cream cheese, softened",
    "1 teaspoon vanilla extract",
    "4 large eggs, at room temperature",
    "2 large egg yolks, at room temperature"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a fluted tube pan (such as Bundt) with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cocoa powder and hot coffee together in a bowl until cocoa is fully dissolved. Whisk in milk to thin and cool mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, salt, and baking powder together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar, butter, and cream cheese in a bowl with an electric mixer until white and fluffy (like frosting), about 5 minutes. Mix in vanilla. Add eggs and egg yolks, one at a time, mixing completely after each addition. Mix in 1/2 of the flour mixture until incorporated. Stir in cocoa-milk mixture, then mix in remaining flour mixture until well blended. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into a few places comes out dry, 70 to 90 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
