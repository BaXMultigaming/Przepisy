  "ingredients": [
    "4 slices bacon",
    "0.75 cup mayonnaise",
    "1 tablespoon honey",
    "1 tablespoon white sugar",
    "salt and ground black pepper to taste",
    "1 (20 ounce) package fresh green peas",
    "2 stalks celery, chopped",
    "0.5 cup cubed Cheddar cheese",
    "0.33333334326744 cup chopped onion"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hr5KrvL6horAgye1Ex5268e644E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234068-bacon-pea-salad-VAT-006-step-01-d0e7ea5ec6c34c1e9cb7fe7f431aa24b.jpg"
      ],
      "image": "assets/images/234068/step_01.webp"
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels and crumble. Reserve 1 tablespoon bacon grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w8xhZy2q0OwhtZ5dOu9Kxt_Db8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234068-bacon-pea-salad-VAT-007-step-02-dd82b06eb7dd4800b89168debf42e154.jpg"
      ],
      "image": "assets/images/234068/step_02.webp"
    },
    {
      "text": "Whisk mayonnaise, reserved bacon grease, honey, sugar, salt, and black pepper together in a bowl until dressing is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4YIGztfrpNzIVd5JDiCl_y2lehs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234068-bacon-pea-salad-VAT-008-step-03-b22ffbb1e7c44e908547ffef6f757ce7.jpg"
      ],
      "image": "assets/images/234068/step_03.webp"
    },
    {
      "text": "Mix bacon, peas, celery, Cheddar cheese, and onion together in a bowl. Drizzle dressing over salad and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v3iwOrqFcyH5AWm2O4HM085KUWw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234068-bacon-pea-salad-VAT-009-step-04-7cdcccc26989408dad5b7075ba2938dc.jpg"
      ],
      "image": "assets/images/234068/step_04.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
