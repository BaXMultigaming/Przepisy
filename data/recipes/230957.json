  "ingredients": [
    "1 (15 ounce) can black beans, drained",
    "1 (14 ounce) can whole kernel corn",
    "0.5 cup salsa",
    "4 skinless, boneless chicken breast halves",
    "1 (8 ounce) package cream cheese, cut into cubes",
    "8 tortillas"
  ],
  "steps": [
    {
      "text": "Combine black beans, corn, and 1/2 cup salsa in a slow cooker. Lay chicken breasts atop black bean mixture; top with remaining 1/2 cup salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on High for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cream cheese; cover and cook another 30 minutes. Shred chicken with two forks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon chicken mixture into the middle of each tortilla; roll tortillas around filling and serve.",
