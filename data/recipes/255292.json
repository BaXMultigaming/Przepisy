  "ingredients": [
    "1 head garlic",
    "2 teaspoons olive oil",
    "kosher salt and ground black pepper to taste",
    "0.5 cup mayonnaise",
    "1 teaspoon lemon juice",
    "0.5 teaspoon Worcestershire sauce",
    "1 pinch ground cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Trim off the top of the head of garlic to expose cloves. Drizzle with olive oil. Sprinkle salt and black pepper on top. Wrap completely in aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until garlic feels soft when lightly pressed, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unwrap and allow to cool at room temperature, 5 to 10 minutes. Refrigerate until completely chilled, 30 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pull out individual garlic cloves with a sharp knife; place in a small bowl. Mash with a fork until creamy. Mix in mayonnaise, lemon juice, Worcestershire sauce, and cayenne until well blended. Refrigerate until flavors combine, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
