  "ingredients": [
    "2 tablespoons butter",
    "1.5 pounds sliced zucchini",
    "1 pound mushrooms, sliced",
    "1 onion, sliced",
    "1.5 pounds tomatoes, chopped",
    "salt and pepper to taste",
    "1.5 pounds Monterey Jack cheese, shredded",
    "10 (10 inch) flour tortillas"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Mix together the zucchini, mushrooms, onion, tomatoes, salt and pepper, and add to the skillet. Cook and stir until the vegetables are soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm the tortillas 2 to 3 minutes, until soft, in the preheated oven. Fill the warmed tortillas with zucchini mixture and Monterey Jack cheese, reserving some of both for toppings. Roll the filled tortillas and place them seam side down in the baking dish. Cover with the remaining zucchini mixture. Top with remaining cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 15 minutes, or until the cheese is bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
