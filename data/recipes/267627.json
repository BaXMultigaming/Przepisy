  "ingredients": [
    "0.5 medium lime, juiced",
    "0.25 bunch fresh cilantro, or to taste",
    "1 clove garlic, minced",
    "1 medium ripe avocado, pitted, peeled and cut into wedges",
    "1 (8 ounce) container Mexican crema (such as Crema Supremo®)",
    "1 tablespoon olive oil",
    "1 teaspoon kosher salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Combine ingredients in a blender in the following order: lime juice, cilantro, garlic, avocado, crema, oil, salt, and pepper. Blend until smooth.",
