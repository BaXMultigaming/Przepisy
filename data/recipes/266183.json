  "ingredients": [
    "2 tablespoons butter, melted",
    "0.5 cup finely chopped pecans",
    "0.5 cup stevia sugar substitute (such as Truvia®)",
    "0.5 teaspoon ground cinnamon",
    "1 pinch salt",
    "1 (15 ounce) can pumpkin puree",
    "4 large eggs",
    "0.75 cup granular sucralose sweetener (such as Splenda®)",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine melted butter, pecans, stevia, cinnamon, and salt in a bowl. Press into the bottom of a 10-inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake crust in the preheated oven for 5 minutes. Remove from the oven and increase temperature to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin puree, eggs, sweetener, ginger, nutmeg, allspice, and cloves in a bowl and mix completely. Pour filling into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the hot oven for 15 minutes. Reduce temperature to 350 degrees F (175 degrees C). Continue baking until a knife inserted into the pie comes out clean, 50 to 60 minutes more. Cool for 1 hour before refrigerating. Refrigerate for 2 to 3 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
