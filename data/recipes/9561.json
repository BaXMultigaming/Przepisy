  "ingredients": [
    "1 cup butter, softened",
    "1 cup white sugar",
    "2 eggs, beaten",
    "2 tablespoons vanilla extract",
    "2.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup ground walnuts",
    "60 milk chocolate candy kisses, unwrapped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the butter, sugar, eggs and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the flour, baking soda and salt; mix well. Shape into 1 inch balls and roll in ground nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place on ungreased baking sheet and bake for 10 minutes or until set. Press kiss in center of each cookie. Cool on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
