  "ingredients": [
    "2 (3.5 ounce) packages microwave popcorn, popped",
    "0.5 cup margarine",
    "0.75 cup brown sugar",
    "0.25 cup peanut butter",
    "20 large marshmallows"
  ],
  "steps": [
    {
      "text": "Pour popcorn into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a microwave-safe bowl, combine margarine, brown sugar, and marshmallows. Cook at 1-minute intervals in the microwave, stirring between each interval, until the mixture is melted and smooth. Stir in the peanut butter until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the brown sugar mixture over the popcorn, and stir quickly to coat the corn before it cools.",
      "section": null,
