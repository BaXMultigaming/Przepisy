  "ingredients": [
    "1 cup uncooked white rice",
    "2 cups water",
    "0.5 cup raw almonds",
    "16 ounces Gevalia® Cold Brew Concentrate - House Blend",
    "1 tablespoon blue agave nectar",
    "ice cubes",
    "4 (3 inch) cinnamon sticks"
  ],
  "steps": [
    {
      "text": "Combine rice, water, and almonds in a blender. Blend the mixture until well combined, about 2 minutes. The mixture will be coarse.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain mixture through a fine sieve or cheesecloth into a pitcher; discard solids. Stir in cold brew concentrate and blue agave.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve over ice. Garnish with cinnamon sticks.",
