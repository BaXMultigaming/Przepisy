  "ingredients": [
    "2 cups whole wheat flour",
    "0.75 cup white sugar",
    "0.5 cup old-fashioned oats",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "1.25 cups ripe, mashed bananas (about 3 bananas)",
    "2 large eggs",
    "0.75 cup plain low-fat yogurt",
    "⅓ cup Becel® Salted Plant-Based Bricks, melted",
    "1 teaspoon vanilla extract",
    "0.33333334326744 cup coarsely chopped walnuts",
    "0.75 cup chopped, pitted dates"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Spray 12-cup muffin pan with no-stick cooking spray; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, rolled oats, baking powder, baking soda and cinnamon and in large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, yogurt, melted Becel® Plant-Based Bricks, vanilla, and bananas in medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir banana mixture into flour, then stir in the walnuts and dates. Evenly spoon batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
