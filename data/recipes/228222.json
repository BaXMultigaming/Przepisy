  "ingredients": [
    "1 pound ground breakfast sausage",
    "1 (8 ounce) package refrigerated crescent rolls",
    "1 cup frozen hash brown potatoes, thawed",
    "1 cup shredded Cheddar cheese",
    "5 eggs",
    "0.25 cup milk",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XoSkT1lndrRAeYcQ7uw_kP5KadU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-228222-breakfast-pizza-step-01-2d675fdc032f404bb3d3a3363c61d03b.jpg"
      ],
      "image": "assets/images/228222/step_01.webp"
    },
    {
      "text": "Brown breakfast sausage in a large skillet until no longer pink and the meat is crumbly, about 10 minutes. Drain off excess grease; set sausage aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U2CokRV3zf1EpWnbJVsS5Ox6lu0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-228222-breakfast-pizza-step-02-b089575ebd134855aeb401656147d9a1.jpg"
      ],
      "image": "assets/images/228222/step_02.webp"
    },
    {
      "text": "Separate crescent-roll dough into triangles and place in a deep-dish or rimmed 12-inch pizza pan, points toward the inside. Press the triangles together to join; pinch dough so it comes 1 ½ inches up the sides of the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O3GKaHlQf8CnTVUc7cV6YO8kKow=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-228222-breakfast-pizza-step-03-b86b68a15ae548d39d68c475ab744f23.jpg"
      ],
      "image": "assets/images/228222/step_03.webp"
    },
    {
      "text": "Spoon cooked sausage over crust. Spread hash browns over sausage and sprinkle with Cheddar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rOkhx5RYAu2bB5UH98Io3p2CcIE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-228222-breakfast-pizza-step-04-35817af8495d4b3fa4719fd00b050b8f.jpg"
      ],
      "image": "assets/images/228222/step_04.webp"
    },
    {
      "text": "Whisk eggs, milk, salt, and black pepper in a bowl until smooth and pour egg mixture over cheese. Sprinkle pizza evenly with Parmesan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FQ_-D-kSRi-w-OKnGE_7rB7cEjk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-228222-breakfast-pizza-step-05-eaefecaafb464b5997010f135d75d763.jpg"
      ],
      "image": "assets/images/228222/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until eggs are set and crust is lightly browned, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zhWTejquZ2tQVLhPI1148y1hOR4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-228222-breakfast-pizza-step-06-3269f4df4451433b8e7f080862e9bbf5.jpg"
      ],
      "image": "assets/images/228222/step_06.webp"
    }
