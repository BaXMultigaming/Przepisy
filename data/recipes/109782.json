  "ingredients": [
    "4 jalapeno peppers, stemmed",
    "0.25 cup lime juice",
    "4 cloves garlic, peeled",
    "1 tablespoon dried oregano",
    "1 tablespoon coarse salt",
    "1.5 teaspoons cracked black pepper",
    "1.5 pounds top sirloin steak"
  ],
  "steps": [
    {
      "text": "Combine jalapeños, lime juice, garlic, oregano, salt, and pepper in a blender. Blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place steak in a shallow pan or large resealable plastic bag. Pour jalapeño marinade over steak and turn to coat. Cover the pan or seal the bag; marinate in the refrigerator for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steak from marinade and cook on the preheated grill to desired doneness, about 5 minutes per side. Discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
