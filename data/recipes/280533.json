  "ingredients": [
    "1.75 pounds russet potatoes, peeled and cut into fries",
    "2 tablespoons truffle-infused olive oil",
    "0.5 teaspoon paprika",
    "1 tablespoon grated Parmesan cheese",
    "2 teaspoons chopped fresh parsley",
    "1 teaspoon black truffle sea salt"
  ],
  "steps": [
    {
      "text": "Place fries in a bowl. Cover with water and let soak for 30 minutes. Drain and pat dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place drained fries into a large bowl. Add truffle olive oil and paprika; stir until evenly combined. Transfer fries to the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry for 20 minutes, shaking every 5 minutes. Transfer fries to a bowl. Add Parmesan cheese, parsley, and truffle salt. Toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
