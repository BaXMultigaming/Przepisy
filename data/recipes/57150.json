  "ingredients": [
    "2.5 cups self-rising flour",
    "0.5 cup all-purpose flour",
    "0.25 cup brown sugar",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon onion powder",
    "0.75 teaspoon Italian seasoning",
    "1 (12 fluid ounce) can beer",
    "0.25 cup butter or margarine, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x5-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together self-rising flour, all-purpose flour, brown sugar, baking powder, salt, onion powder, and Italian seasoning in a bowl. Pour in beer; mix just until moistened. Transfer to the prepared pan. Top with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 45 to 55 minutes. Cool on a wire rack.",
      "section": null,
