  "ingredients": [
    "1 (64 fluid ounce) bottle unsweetened pineapple juice",
    "1 (64 fluid ounce) bottle cranberry juice cocktail",
    "4.5 cups water",
    "1 cup brown sugar, packed",
    "2 tablespoons whole cloves",
    "4 (4 inch) cinnamon sticks, broken",
    "0.25 teaspoon salt"
