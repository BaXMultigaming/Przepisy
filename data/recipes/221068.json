  "ingredients": [
    "1.6666667461395 cups all-purpose flour",
    "2 teaspoons ground ginger",
    "1.25 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "0.75 teaspoon salt",
    "0.25 teaspoon Chinese five-spice powder",
    "0.5 cup white sugar",
    "0.5 cup dark molasses",
    "0.5 cup vegetable oil",
    "1 egg, beaten",
    "0.5 cup boiling water",
    "1 cup powdered sugar",
    "0.25 cup lemon juice",
    "1 tablespoon grated lemon zest"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and lightly flour a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, ginger, baking soda, cinnamon, salt, and Chinese five-spice powder together in a bowl. Stir in sugar, molasses, oil, and egg until just combined. Pour in boiling water; whisk until batter is smooth and shiny, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared baking pan. Tap the pan gently on the counter to remove any air bubbles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make the lemon glaze: Mix powdered sugar, lemon juice, and lemon zest in a bowl until sugar dissolves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour lemon juice mixture over cake while cake is still hot. Spread mixture around with a spatula to ensure even distribution.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cake cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
