  "title": "Southern Bread Pudding",
  "description": "The simplicity of this Southern bread pudding is what makes it so delicious--it&#39;s a classic custard dessert passed down through generations.",
  "authors": [
    "ban_the_circus"
  ],
  "date_published": "2007-10-30T21:15:44-04:00",
