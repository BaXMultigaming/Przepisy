  "ingredients": [
    "4 cups mashed sweet potatoes",
    "1 cup white sugar",
    "2 eggs, beaten",
    "0.5 cup milk",
    "0.5 teaspoon salt",
    "0.33333334326744 cup butter, melted",
    "1 teaspoon vanilla extract",
    "1 cup packed brown sugar",
    "0.5 cup all-purpose flour",
    "0.33333334326744 cup butter, melted",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "In a mixing bowl, combine the sweet potatoes, sugar, eggs, milk, salt, 1/3 cup butter and vanilla. Mix together and pour into a greased 13x9 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To prepare the topping, combine in a separate bowl the brown sugar, flour, 1/3 cup melted butter and pecans. Mix together and crumble over sweet potato mixture. Bake uncovered at 350 degrees F (175 degrees C) for 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
