    "3 tablespoons butter, melted",
    "1 clove garlic, minced",
    "1 large zucchini, very thinly sliced",
    "0.5 cup shredded Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat. Lightly grease a 9x12-inch foil pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter and garlic together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay zucchini slices in rows in the prepared pan, overlapping if necessary. Brush garlic butter on each slice and sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the pan on the preheated grill and cook until cheese is melted and zucchini is tender, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
