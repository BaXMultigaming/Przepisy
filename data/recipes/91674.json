  "ingredients": [
    "0.75 cup peanut butter",
    "0.75 cup brown sugar",
    "0.75 cup honey",
    "1 teaspoon vanilla extract",
    "0.5 cup unsweetened cocoa powder",
    "2 cups crisp rice cereal",
    "1.5 cups rolled oats",
    "1 cup coconut",
    "0.75 cup sesame seeds",
    "0.75 cup sunflower seeds"
