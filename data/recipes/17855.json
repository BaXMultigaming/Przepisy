  "ingredients": [
    "nonstick cooking spray",
    "4.5 pounds corned beef, rinsed",
    "1 cup water",
    "1 cup apricot preserves",
    "0.25 cup brown sugar",
    "2 tablespoons soy sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a large baking dish with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place corned beef into the prepared baking dish; pour in water. Cover the dish tightly with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 2 hours; drain liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apricot preserves, brown sugar, and soy sauce in a small bowl. Spread evenly over corned beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake uncovered until meat is tender, 25 to 30 more minutes. Baste occasionally with pan drippings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice corned beef across grain and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
