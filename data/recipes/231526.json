  "ingredients": [
    "1 (5 pound) boneless fully cooked ham",
    "0.25 cup honey, warmed",
    "0.125 teaspoon ground cloves",
    "1 cup packed brown sugar",
    "0.5 cup prepared horseradish",
    "0.25 cup lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut ham into 1/4-inch-thick slices. Use kitchen string to tie slices back together in the shape of original ham, then place on a rack set in a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together honey and cloves in a small bowl until well combined; drizzle over ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake ham in the preheated oven for 1 hour and 15 minutes, basting often with pan drippings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together brown sugar, horseradish, and lemon juice in a medium bowl until glaze is well combined. Baste ham with glaze, allowing it to drip between slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue baking until glaze has set, ham has browned, and an instant-read meat thermometer inserted into the center of sliced ham reads at least 140 degrees F (60 degrees C), 25 to 30 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
