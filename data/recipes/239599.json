  "ingredients": [
    "1 cup all-purpose flour",
    "1.25 cups whole wheat flour",
    "0.25 cup ground flaxseed",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup orange juice",
    "2 egg whites",
    "0.33333334326744 cup almond milk",
    "3 tablespoons brown sugar",
    "2 tablespoons honey",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease 12 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all-purpose flour, whole wheat flour, flaxseed, baking soda, and salt together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat orange juice, egg whites, almond milk, brown sugar, and honey together in a large bowl until smooth. Stir flour mixture into the orange juice mixture just until the dry ingredients are moistened completely. Fold walnuts through the batter. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until lightly browned and a toothpick inserted into the center of a muffin comes out clean, 15 to 20 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
