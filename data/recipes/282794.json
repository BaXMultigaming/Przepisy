  "ingredients": [
    "hickory and apple wood chips, as needed",
    "1 (2 pound) head cauliflower",
    "1 tablespoon olive oil",
    "0.5 teaspoon seasoned salt",
    "0.25 teaspoon ground black pepper",
    "1 tablespoon mayonnaise",
    "1 tablespoon barbeque sauce"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor smoker to 250 degrees F (120 degrees C). Add hickory and apple wood chips according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub cauliflower head with olive oil and season with seasoned salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place on the rack of the preheated smoker and smoke until tender, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise and barbeque sauce together in a small bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cauliflower to a serving dish. Drizzle mayo mixture over top before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
