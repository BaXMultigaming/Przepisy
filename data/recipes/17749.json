  "ingredients": [
    "0.25 cup vegetable oil",
    "2 cups diced chicken meat",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "3 cups chicken broth",
    "2 tablespoons soy sauce",
    "1 cup chopped celery",
    "1 (8 ounce) can bamboo shoots, drained and diced",
    "1 (8 ounce) can water chestnuts, drained and diced",
    "0.33333298563957 cup cornstarch",
    "0.5 cup cold water",
    "1 cup cashews"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium high heat. Sauté chicken until it turns white, then season with salt and pepper and add broth, soy sauce, celery, bamboo shoots and water chestnuts. Cover skillet, reduce heat to low and simmer for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cornstarch and water together in a small bowl, then blend into skillet mixture and heat through until thick and bubbly. Sprinkle with cashews and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
