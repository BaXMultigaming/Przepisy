  "ingredients": [
    "0.5 cup pure maple syrup",
    "0.25 cup balsamic vinegar",
    "1 tablespoon fresh lemon juice",
    "1 clove garlic, minced",
    "1 teaspoon dry mustard",
    "1 teaspoon salt",
    "0.5 teaspoon dried basil",
    "0.25 teaspoon ground black pepper",
    "1 cup extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "Blend maple syrup, balsamic vinegar, lemon juice, garlic, dry mustard, salt, basil, and black pepper in a blender until smooth; stream olive oil into the mixture while blending and continue blending until dressing is thick and creamy.",
