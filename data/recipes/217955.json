  "ingredients": [
    "8 eggs",
    "1 tablespoon white sugar",
    "2 teaspoons ground cinnamon",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon ground nutmeg",
    "1 (15 ounce) can pumpkin puree",
    "1 loaf Texas toast thick-sliced bread, cut into 1-inch cubes",
    "0.33333334326744 cup brown sugar",
    "0.25 teaspoon ground cinnamon",
    "2 tablespoons all-purpose flour",
    "1 tablespoon butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, white sugar, vanilla extract, 2 teaspoons of cinnamon, vanilla extract, cloves, and nutmeg together in a bowl; beat in pumpkin until fully incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bread cubes in a single layer in the prepared baking dish; pour pumpkin mixture over bread cubes, and gently toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir 1/3 cup of brown sugar, 1/4 teaspoon of cinnamon, flour, and butter together with a fork in a small bowl until the mixture is crumbly; sprinkle over bread cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden brown on top, 30 to 40 minutes.",
      "section": null,
      "name": null,
