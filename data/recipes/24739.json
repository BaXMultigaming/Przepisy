  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "1 (14 ounce) can artichoke hearts in water, drained",
    "0.5 teaspoon Old Bay (tm) Seasoning",
    "0.5 pound fresh crabmeat, picked over for cartilage and shell fragments"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cream cheese in a medium baking dish with 3/4 of the artichoke hearts and Old Bay Seasoning TM. Blend until smooth. Gently fold in crabmeat, taking care not to break up lumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 30 minutes, or until surface is golden brown. Remove from heat and garnish with remaining artichoke hearts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
