  "ingredients": [
    "0.75 cup pumpkin seeds",
    "1.5 pounds cubed beef stew meat",
    "salt to taste",
    "0.5 cup peanut oil",
    "2 large tomatoes, chopped",
    "1 small onion, chopped",
    "2 habanero peppers, seeded and minced",
    "2 pounds fresh shrimp, peeled and deveined",
    "18 ounces tomato sauce",
    "1.5 cups water",
    "3 tablespoons tomato paste",
    "1 pound fresh spinach, washed and chopped"
  ],
  "steps": [
    {
      "text": "Place seeds in a blender; blend until mixture is powdery, 30 to 40 seconds. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NXybg40zApPlBCZ0UcymuxtSi4c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12978-Egusi-Soup-ddmfs-017-step1-e31ab42223b94a848dcae58167d73508.jpg"
      ],
      "image": "assets/images/12978/step_01.webp"
    },
    {
      "text": "Cut beef into bite-sized cubes; season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2TFZqwfFqz9yvlfSr_5p21cdsnQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12978-Egusi-Soup-ddmfs-018-step2-1e8046cb7d074cff9190b64af533d629.jpg"
      ],
      "image": "assets/images/12978/step_02.webp"
    },
    {
      "text": "Heat oil in a large pot over medium-high heat. Cook beef in hot oil until brown but not cooked through, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FHBgONdaedqz4FpvLzXo8wucT9A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12978-Egusi-Soup-ddmfs-019-step3-912518db311f4b558a234aeab597aedb.jpg"
      ],
      "image": "assets/images/12978/step_03.webp"
    },
    {
      "text": "Place tomatoes, onion, and peppers in a blender; blend until smooth, about 30 seconds. Stir tomato mixture into beef; reduce heat to medium-low and cover. Cook until meat is tender, 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P7zrXpNBP167CTWvG05bJ6VHboQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12978-Egusi-Soup-ddmfs-020-step4-5dd3c07ebeeb4c70b239726d39693438.jpg"
      ],
      "image": "assets/images/12978/step_04.webp"
    },
    {
      "text": "Add shrimp, tomato sauce, water, and tomato paste; simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WGyrhejZNYTrN1sKyQ41A5OoV60=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12978-Egusi-Soup-ddmfs-021-step5-e78e3f67ea5d4fa59a77ea73ba7dac80.jpg"
      ],
      "image": "assets/images/12978/step_05.webp"
    },
    {
      "text": "Stir in spinach and powdered seeds. Continue simmering for 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OthkTqZDY1WPJ6SYH5jJqIp6Njw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12978-Egusi-Soup-ddmfs-022-step6-f7a3c15a14b148dfba681862a35bf2d8.jpg"
