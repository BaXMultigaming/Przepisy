  "title": "Amy's Garlic Egg Chicken",
  "description": "An egg yolk/garlic marinade tenderizes these chicken breasts before they are dipped in a seasoned crumb mixture and baked.",
  "authors": [
    "amy miazga"
  ],
  "date_published": "2000-05-06T21:50:47-04:00",
