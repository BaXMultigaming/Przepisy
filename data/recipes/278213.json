  "ingredients": [
    "2 leaves kale",
    "1 teaspoon olive oil, or as needed",
    "0.5 pint cherry tomatoes, diced",
    "kosher salt to taste",
    "0.125 pound crumbled feta cheese",
    "0.33333334326744 cup dried cranberries",
    "0.5 cup cooked couscous",
    "0.25 cup roasted pumpkin seeds",
    "0.25 cup sunflower seeds",
    "0.5 lemon, juiced"
  ],
  "steps": [
    {
      "text": "Remove kale leaves from stems; finely chop leaves and massage with oil in a large bowl until dark green and fragrant, about 30 seconds. Add cherry tomatoes and sprinkle with kosher salt. Add feta cheese, cranberries, couscous, pumpkin seeds, and sunflower seeds.",
