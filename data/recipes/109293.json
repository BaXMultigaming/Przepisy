  "ingredients": [
    "1.25 pounds ahi tuna, cut into 1/2 inch cubes",
    "0.25 cup minced onion",
    "0.25 cup minced green onion",
    "2 tablespoons lightly crumbled wakame seaweed",
    "1 tablespoon ground roasted macadamia nuts",
    "2 teaspoons sesame oil",
    "1.5 teaspoons crushed red pepper flakes",
    "1 teaspoon minced fresh ginger",
    "8 leaves iceberg lettuce",
    "2 tablespoons cilantro leaves, for garnish"
  ],
  "steps": [
    {
      "text": "Mix together ahi tuna, onion, green onion, seaweed, macadamia nuts, sesame oil, red pepper flakes, and ginger in a mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate for the flavors to come together, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange lettuce leaves on a serving platter, spoon ahi poke on top, and garnish with cilantro.",
