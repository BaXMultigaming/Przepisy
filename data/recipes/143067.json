  "ingredients": [
    "5 Yukon Gold potatoes, peeled and thinly sliced",
    "1 small onion, chopped",
    "1 clove garlic, minced",
    "1 cup shredded sharp Cheddar cheese",
    "1.5 cups cubed fully cooked ham",
    "1 quart heavy cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
