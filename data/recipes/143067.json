      "image_sources": []
    },
    {
      "text": "Place potatoes, onion, garlic, Cheddar cheese, and ham in a 9x13-inch baking dish. Gently stir until well combined. Pour cream over the potato mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
