  "ingredients": [
    "10 cherry peppers",
    "1 (7 ounce) package mozzarella cheese",
    "5 slices prosciutto",
    "2 cups olive oil",
    "3 tablespoons grated Parmesan cheese",
    "2 cloves garlic, minced",
    "1 teaspoon chopped fresh oregano",
    "1 teaspoon chopped fresh thyme",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Cut a circle, at an inward angle, around pepper stems. Remove tops; scoop out seeds and membranes, like a tiny pumpkin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut mozzarella into thumbnail-sized cubes, varying sizes slightly to fit each pepper. Cut prosciutto slices in half; wrap around mozzarella cubes. Stuff into pepper openings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add olive oil to a sterilized jar or lidded container. Whisk in Parmesan cheese, garlic, oregano, thyme, salt, black pepper, and pepper flakes to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add peppers to oil mixture; seal the jar. Marinate 5 to 6 hours. Serve straight out of the jar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
