  "ingredients": [
    "3 cups all-purpose flour",
    "1 cup white sugar",
    "1 cup brown sugar",
    "0.75 cup cocoa powder",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "1 cup milk",
    "1 cup water",
    "0.75 cup vegetable oil",
    "0.25 cup sour cream",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, white sugar, brown sugar, cocoa powder, baking soda, and salt together in a large bowl. Add milk, water, oil, sour cream, and vanilla extract; mix together until well combined. Pour into an ungreased 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 minutes.",
      "section": null,
