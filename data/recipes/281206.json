  "ingredients": [
    "0.25 cup extra-virgin olive oil",
    "2 tablespoons distilled white vinegar",
    "2 tablespoons fresh lime juice",
    "2 teaspoons grated lime zest",
    "1.5 teaspoons honey",
    "2 cloves garlic, minced",
    "1 teaspoon seafood seasoning (such as Old Bay®)",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon chili powder",
    "0.5 teaspoon ground black pepper",
    "1 pound mahi mahi fillets, diced",
    "0.5 cup plain fat-free yogurt",
    "2 tablespoons lime juice",
    "1.5 tablespoons chopped fresh cilantro",
    "1 (8 ounce) package flour tortillas, warmed"
  ],
  "steps": [
    {
      "text": "Combine oil, vinegar, lime juice, lime zest, honey, garlic, seafood seasoning, cumin, chili powder, and black pepper in a nonreactive bowl or large resealable zip-top bag. Add mahi mahi and marinate for 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "At the same time, combine yogurt, lime juice, and cilantro for dressing in a bowl. Chill overnight while fish marinates.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate. Remove mahi mahi from marinade and place on a grill pan; discard excess marinade. Cook until fish flakes easily with a fork, turning as needed, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve fish on warmed tortillas with dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
