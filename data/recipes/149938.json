  "ingredients": [
    "1 tablespoon canola oil",
    "1 (2 pound) boneless pork loin roast, cut into 1-inch cubes",
    "2 (14.5 ounce) cans enchilada sauce",
    "2 (15.5 ounce) cans white hominy, drained",
    "1 onion, sliced",
    "0.5 cup green chilies, diced",
    "4 cloves garlic, minced",
    "0.5 teaspoon cayenne pepper, or to taste",
    "2 teaspoons dried oregano",
    "0.25 cup cilantro, chopped",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over high heat. Add pork; cook and stir just until meat is browned on all sides, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place meat in a 4-quart slow cooker. Pour enchilada sauce over the meat. Top with hominy, onion, chilies, garlic, cayenne pepper, and oregano. Pour in enough water to fill the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on High for 6 to 7 hours. Stir in cilantro and salt. Cook on Low for 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
