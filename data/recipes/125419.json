  "ingredients": [
    "2.5 cups wheat bran",
    "1.5 cups sifted all-purpose flour",
    "1 teaspoon salt",
    "1.5 teaspoons baking soda",
    "2 eggs",
    "1.5 cups buttermilk",
    "0.5 cup white sugar",
    "0.25 cup molasses",
    "2.5 tablespoons vegetable shortening, melted",
    "0.5 cup chopped raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 18 muffin cups, or line with paper muffin liners. Whisk bran, flour, salt, and baking soda in a mixing bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a mixing bowl. Whisk in buttermilk, sugar, molasses, and melted shortening until smooth. Stir in bran mixture along with raisins until no dry lumps remain. Pour into the prepared muffin tins, filling them no more than 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
