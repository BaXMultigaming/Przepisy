  "title": "Easy Pineapple Cake",
  "description": "This pineapple cake is made from scratch with crushed pineapple and topped with a luscious homemade cream cheese frosting for a delicious dessert.",
  "authors": [
    "Catherine Dallas"
  ],
  "date_published": "1999-12-09T08:20:43-05:00",
