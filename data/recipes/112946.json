  "ingredients": [
    "2 cups sweet rice flour (mochiko)",
    "1.75 cups white sugar",
    "1 tablespoon baking soda",
    "2 eggs",
    "1 (12 fluid ounce) can evaporated milk",
    "1 (13.5 ounce) can coconut milk",
    "1 teaspoon vanilla extract",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a 9x13-inch glass baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the rice flour, sugar, and baking soda; set aside. Beat eggs with evaporated milk, coconut milk, and vanilla extract. Add flour and butter; beat until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into prepared pan and bake in preheated oven for 30 minutes. Allow to cool completely before cutting into small (1 1/2 inch) squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
