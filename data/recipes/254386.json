  "ingredients": [
    "1 cup grated Gruyere cheese",
    "1 cup panko bread crumbs",
    "0.25 cup butter",
    "2 zucchini, sliced",
    "1 yellow squash, sliced",
    "2 shallots, diced",
    "1 clove garlic, minced",
    "2 tablespoons chopped fresh basil",
    "1 tablespoon chopped fresh rosemary",
    "salt and ground black pepper to taste",
    "1.5 tablespoons all-purpose flour",
    "0.75 cup light cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Gruyere cheese and panko bread crumbs together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a large skillet over medium heat until melted. Add zucchini, yellow squash, shallots, and garlic; cook and stir until softened, about 10 minutes. Stir in basil, rosemary, salt, and black pepper; cook until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour into the skillet. Pour in cream in a steady stream and stir until thickened, 3 to 5 minutes. Mix in half the cheese mixture. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour zucchini mixture into a baking dish. Top with remaining cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
