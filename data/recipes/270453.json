  "ingredients": [
    "1 pound lean ground beef",
    "0.5 cup seasoned bread crumbs",
    "0.25 cup ketchup",
    "4 tablespoons Worcestershire sauce",
    "1 tablespoon garlic powder",
    "1 tablespoon onion powder",
    "0.5 teaspoon mustard powder",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, bread crumbs, ketchup, Worcestershire sauce, garlic powder, onion powder, mustard powder, salt, and black pepper in a bowl until well mixed. Form into 4 patties and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, about 30 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
