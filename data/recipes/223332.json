  "ingredients": [
    "4 cups blackberries",
    "1 cup white sugar",
    "2 tablespoons cornstarch",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground allspice",
    "0.5 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ij0iq6iwK2OzwhVYQUKeEt72I1I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223332-blackberry-jam-ddmfs-step1-3x4-3e1168c53ea84535958f07a814f237d5.jpg"
      ],
      "image": "assets/images/223332/step_01.webp"
    },
    {
      "text": "Mash blackberries in a saucepan with a potato masher.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ouSQSUdAl-UFW73QFBaw124MmOY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223332-blackberry-jam-ddmfs-step2-3x4-ea76d535b9e5443fa306f0e3b3e14838.jpg"
      ],
      "image": "assets/images/223332/step_02.webp"
    },
    {
      "text": "Stir in sugar until juices are released. Remove 1 tablespoon blackberry juice from the saucepan; mix with cornstarch in a small bowl. Stir cornstarch mixture back into the saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IqWuRg-Mg5G5dsTSX4UbzYzt8tQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223332-blackberry-jam-ddmfs-step2-2-3x4-886eaa2bf49140b595bd1369cbbf8be6.jpg"
      ],
      "image": "assets/images/223332/step_03.webp"
    },
    {
      "text": "Bring blackberries to a boil; cook, stirring often, until jam has thickened, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D-t0vcbS_z2EWiTHC0Y5Bq1qJmY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223332-blackberry-jam-ddmfs-step3-3x4-927ea079f4e249c595867df40f9609eb.jpg"
      ],
      "image": "assets/images/223332/step_04.webp"
    },
    {
      "text": "Stir in cinnamon and allspice. Remove saucepan from the heat and allow jam to cool, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mLFB-w0VnbQfQ8mJD5IICMe7OqQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223332-blackberry-jam-ddmfs-step5-3x4-ffac6c64ef5545d5b6943f06d13d29d3.jpg"
      ],
      "image": "assets/images/223332/step_05.webp"
    },
    {
      "text": "Transfer jam to a bowl, cover, and refrigerate until chilled. Stir in lemon juice before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cjw6TzMjPJ_icKHV2B0oM7QwXCM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223332-blackberry-jam-ddmfs-step6-3x4-f99e295003e34cb39b01768b6aaaae31.jpg"
      ],
