  "ingredients": [
    "0.25 cup fresh lemon juice",
    "2 cloves garlic, minced",
    "1 teaspoon Dijon mustard",
    "1 teaspoon honey",
    "0.5 teaspoon dried basil",
    "1 pinch salt and freshly ground black pepper",
    "0.33333334326744 cup extra-virgin olive oil",
    "3 medium zucchini, ends trimmed",
    "0.25 cup chopped cilantro leaves and stems",
    "0.25 cup toasted pine nuts"
  ],
  "steps": [
    {
      "text": "Whisk lemon juice, garlic, mustard, honey, basil, salt, and black pepper together in a small bowl; slowly whisk in olive oil until emulsified. Set vinaigrette aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut zucchini into zoodles using the thin blade of a spiralizer; cut strands into manageable lengths with kitchen shears. Place zoodles in a large bowl; add cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour vinaigrette over zoodles right before serving; gently toss to coat. Taste; adjust seasoning if necessary. Sprinkle with pine nuts; serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
