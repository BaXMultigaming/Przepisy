  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon curry powder, or more to taste",
    "1 egg",
    "0.5 cup soy milk",
    "salt",
    "1 (16 ounce) can whole kernel corn",
    "olive oil for frying, as needed"
  ],
  "steps": [
    {
      "text": "Sift flour and curry powder into medium mixing bowl. Form a well in the flour, and carefully mix in egg, milk, and salt. Mixture should be fairly thin, and may require more milk. Whisk until smooth if any lumps exist. Set aside, and let rest for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat the bottom of a heavy frying pan with oil, and heat to medium-high. Stir corn into mixture, and drop batter by the spoonful into pan. Fry fritters until golden brown, about 2 minutes per side. Serve hot or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
