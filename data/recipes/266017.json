  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spread sesame seeds on a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, shaking the baking sheet frequently, until seeds are lightly toasted, 5 to 10 minutes. Let cool, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cooled seeds and 1 1/2 cups olive oil into a food processor. Blend until smooth, 1 to 2 minutes. Add more oil and blend until a thick yet pourable consistency is reached.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
