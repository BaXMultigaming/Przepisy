  "ingredients": [
    "2 cups peeled, cored and chopped apple",
    "0.75 cup white sugar",
    "2 tablespoons vegetable oil",
    "1 egg",
    "1.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 cup fresh or frozen cranberries",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together apples, sugar, and oil in a large bowl. Add egg; mix well. Sift flour, baking powder, baking soda, and cinnamon in a separate bowl. Stir flour mixture into wet ingredients until dry ingredients are moist. Stir in cranberries and walnuts. Spread batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of loaf comes out clean, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
