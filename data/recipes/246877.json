  "ingredients": [
    "cooking spray",
    "2 tablespoons olive oil",
    "1 white onion, minced",
    "6 cloves garlic, minced",
    "2 cups canned chickpeas, drained",
    "0.75 cup dry bread crumbs",
    "1 egg",
    "2 tablespoons parsley",
    "1 tablespoon salt-free seasoning blend",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat. Add onion and garlic; cook and stir until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pulse chickpeas in a food processor until finely ground. Add onion and garlic, bread crumbs, egg, parsley, seasoning blend, salt, and black pepper; process until mixture holds together like a dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop out 2 tablespoons chickpea mixture and roll into a ball; set on the prepared baking sheet. Repeat with remaining mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bottoms are golden brown, about 15 minutes. Turn each meatball over and continue baking until golden brown on top, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
