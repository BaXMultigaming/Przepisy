  "steps": [
    {
      "text": "Heat the oil in a skillet over medium heat and cook the onion and garlic until tender. Mix in ketchup, vinegar, Worcestershire sauce, brown sugar, dry mustard, salt, pepper and hot sauce. Bring to a boil. Reduce heat to low and simmer 10 minutes, stirring occasionally. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil grill grate. Place chicken on grill. Brush constantly with the sauce and cook 8 to 15 minutes on each side, depending on size of piece, until juices run clear. Discard any remaining sauce.",
      "section": null,
      "name": null,
