  "ingredients": [
    "1 head cauliflower",
    "0.25 cup butter, cut into pieces",
    "1 teaspoon mayonnaise",
    "1 teaspoon prepared mustard",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Steam whole head of cauliflower for 30 minutes. Drain and place on a pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, combine mayonnaise and mustard; spread the mixture over cauliflower and dot with pats of butter. Sprinkle generously with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven uncovered, for about 30 minutes, or until cheese is brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
