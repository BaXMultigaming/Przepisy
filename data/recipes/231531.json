  "ingredients": [
    "cooking spray",
    "1.75 cups egg substitute (such as Egg Beaters® Southwestern Style)",
    "1 cup 2% milk",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground mustard",
    "8 frozen hash brown patties",
    "2 (6 ounce) packages Canadian bacon, quartered",
    "4 cups shredded Cheddar Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg substitute, milk, salt, and mustard together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer hash brown patties over the bottom of the prepared baking dish, then cover with Canadian bacon and Cheddar-Jack cheese. Pour egg mixture over top. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Remove the foil and continue to bake until a knife inserted in the center comes out clean and the edges are golden brown, about 15 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
