  "ingredients": [
    "1 cup unpopped popcorn",
    "0.33329999446869 cup butter",
    "0.66666668653488 cup white sugar",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A-tS015p2Mux-0qzzN2oZD2shbM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59854-cinnamon-sugar-popcorn-ddmfs-step-1-0809-cfe2a514b56d4c7aaabd144066b42e19.jpg"
      ],
      "image": "assets/images/59854/step_01.webp"
    },
    {
      "text": "Pop corn using an air popper according to the manufacturer's directions. Place into a large mixing bowl and set aside. Melt butter in a small saucepan over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uQBO6OUFjdx-UCt8830Ra5m5tsA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59854-cinnamon-sugar-popcorn-ddmfs-step-2-0811-b7ab42c427b64e8693beca75c11ce4a4.jpg"
      ],
      "image": "assets/images/59854/step_02.webp"
    },
    {
      "text": "Stir in sugar, cinnamon, salt, and vanilla; cook until thick and bubbly. Pour over popcorn; stir until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lMMEuk3d1Lak_XDFV02CNIWVisQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59854-cinnamon-sugar-popcorn-ddmfs-step-3-0812-a31eb423673d44d6ae6acb8df86212d8.jpg"
      ],
      "image": "assets/images/59854/step_03.webp"
    },
    {
      "text": "Spread popcorn into a large roasting pan. Bake in the preheated oven for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the oven off and allow popcorn to stay in the oven for 20 minutes. Remove from the oven and let cool completely before serving.",
      "section": null,
