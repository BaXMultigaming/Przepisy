  "ingredients": [
    "1 tablespoon salt",
    "0.25 cup distilled white vinegar",
    "6 cups water",
    "8 large eggs"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Vsdu9-k8CHO1qeJio0VxwJWMsV8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213737-kens-perfect-hard-boiled-egg-and-i-mean-perfect-ddmfs-4x3-step1-1123-6142aa604ffe48afa3d60d334b5d2d37.jpg"
      ],
      "image": "assets/images/213737/step_01.webp"
    },
    {
      "text": "Combine salt, vinegar, and water in a large pot, and bring to a boil over high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3j9ullZFPYBswwfpjCPSIKm9_BE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213737-kens-perfect-hard-boiled-egg-and-i-mean-perfect-ddmfs-4x3-step2-1128-4eae5eeb9e0a43b69b84a91b9cd91975.jpg"
      ],
      "image": "assets/images/213737/step_02.webp"
    },
    {
      "text": "Add eggs one at a time, being careful not to crack them. Reduce the heat to a gentle boil, and cook for 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aHMXgZs_rf1yYvFKcxFoBvnLKJw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213737-kens-perfect-hard-boiled-egg-and-i-mean-perfect-ddmfs-4x3-step3-1130-f92104d2228b4e33abccf6b71c65a1b5.jpg"
      ],
      "image": "assets/images/213737/step_03.webp"
    },
    {
      "text": "Once eggs have cooked, remove them from the hot water, and place into a container of ice water or cold, running water. Cool completely, about 15 minutes. Store in the refrigerator up to 1 week.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kpLZFITNF8ibjgfV-x736sxMhME=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213737-kens-perfect-hard-boiled-egg-and-i-mean-perfect-ddmfs-4x3-step4-1125-e92f621d98fd4681a8b8a8d1b0bdb845.jpg"
      ],
      "image": "assets/images/213737/step_04.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
