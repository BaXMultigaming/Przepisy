  "ingredients": [
    "1 cup unsweetened applesauce",
    "0.75 cup maple syrup",
    "0.5 cup crunchy almond butter",
    "4 cups oat flour",
    "2 tablespoons ground cinnamon",
    "2 tablespoons unsweetened cocoa powder",
    "2 scoops vanilla-flavored whey protein powder"
  ],
  "steps": [
    {
      "text": "Line a 9x13-inch baking dish with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine applesauce, maple syrup, and almond butter in a large mixing bowl. Add oat flour, cinnamon, cocoa, and protein powder; mix until well combined. Spread into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate until firm, about 1 hour. Cut into 30 squares and wrap in parchment paper.",
