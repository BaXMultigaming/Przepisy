  "ingredients": [
    "0.5 cup sweetened condensed milk",
    "3 tablespoons teriyaki sauce",
    "1 tablespoon vinegar",
    "1 tablespoon red curry paste",
    "3 large skinless, boneless chicken breast halves - cut into thin strips",
