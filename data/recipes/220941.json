  "ingredients": [
    "cooking spray",
    "1 cup whole wheat flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "2 ripe bananas, mashed",
    "0.75 cup brown sugar",
    "0.33333334326744 cup unsweetened crunchy peanut butter",
    "0.25 cup plain fat-free yogurt",
    "1 large egg",
    "1 tablespoon canola oil",
    "0.75 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x5-inch loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk whole wheat flour, baking powder, baking soda, and salt together in a large bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mashed bananas, brown sugar, peanut butter, yogurt, egg, and canola oil in a separate bowl; stir into flour mixture until thoroughly combined. Fold in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned at edges, and a toothpick inserted into center comes out clean, 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool bread in the pan on a wire rack for 15 minutes before removing from the pan to finish cooling on the rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
