  "ingredients": [
    "2 (15.5 ounce) cans white or yellow hominy, rinsed and drained",
    "1 (16 ounce) can diced tomatoes",
    "1 (4.5 ounce) can diced green chiles",
    "1 clove minced garlic",
    "1 teaspoon ground cumin",
    "2 tablespoons chopped fresh cilantro, or to taste",
    "salt and pepper to taste",
    "0.5 cup shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Combine hominy, tomatoes, chiles, garlic, and cumin in a saucepan over medium heat. Cook and stir until heated through, about 7 minutes. Stir in cilantro and season with salt and pepper. Top each serving with Monterey Jack.",
