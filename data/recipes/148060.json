  "ingredients": [
    "2 pounds elk loin (backstrap), cut into 2 ounce pieces",
    "1 tablespoon liquid smoke flavoring",
    "1 tablespoon Worcestershire sauce",
    "0.5 teaspoon garlic powder, or to taste",
    "0.5 teaspoon onion powder, or to taste",
    "0.5 teaspoon black pepper, or to taste",
    "16 slices thick cut bacon"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season backstrap pieces with liquid smoke and Worcestershire sauce. Sprinkle with garlic powder, onion powder, and pepper. Wrap each piece of meat with a strip of bacon, and place on a metal skewer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the elk on the preheated grill until the bacon becomes slightly burnt, and the meat has cooked to medium-rare, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
