  "ingredients": [
    "1.5 cups graham cracker crumbs",
    "0.5 cup all-purpose flour",
    "2 teaspoons baking powder",
    "1 (14 ounce) can sweetened condensed milk",
    "0.5 cup butter, softened",
    "1.5 cups sweetened, flaked coconut",
    "2 cups red and green candy-coated chocolate"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl combine graham cracker crumbs, flour and baking powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate, large bowl combine condensed milk and butter; beat until smooth. Stir in graham cracker mixture, mixing well. Stir in coconut and chocolates.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by rounded teaspoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 7 to 9 minutes, or until lightly browned. Allow cookies to cool on baking sheet for 1 minute before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
