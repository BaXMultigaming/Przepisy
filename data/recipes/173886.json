  "ingredients": [
    "2 cups crushed ice",
    "5.5 ounces coconut milk",
    "0.75 cup milk",
    "1 tablespoon white sugar",
    "1 tablespoon honey",
    "2 teaspoons ground flax seed",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Place the place the crushed ice, coconut milk, and milk into a blender. Add the sugar, honey, flax seed, cinnamon, nutmeg, ginger, and vanilla extract. Cover, and puree until smooth. Pour into glasses to serve.",
