  "ingredients": [
    "4 ears corn, with husks",
    "0.5 lime, juiced, or more to taste",
    "0.5 teaspoon chili powder",
    "5 ounces crumbled cotija cheese",
    "0.25 cup packed chopped fresh cilantro",
    "4 tablespoons mayonnaise",
    "1 pinch ground black pepper to taste",
    "1 pinch salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill corn in the husks on the preheated grill, turning occasionally, to desired tenderness, about 15 minutes; some charring is fine. Remove from the grill. Remove and discard husks and silk when cool enough to handle. Cut kernels off into a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add lime juice and chili powder, then mix in cotija cheese, cilantro, mayonnaise, and pepper until thoroughly combined. Taste and add salt if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
