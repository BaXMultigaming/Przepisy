  "ingredients": [
    "8 ounces cream cheese, softened",
    "0.25 cup sour cream",
    "1 tablespoon horseradish sauce",
    "1 teaspoon seafood seasoning (such as Old Bay®)",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon ground black pepper",
    "2 kosher dill pickles, chopped",
    "0.25 cup red onion, chopped"
  ],
  "steps": [
    {
      "text": "Combine cream cheese, sour cream, horseradish sauce, seafood seasoning, garlic powder, and black pepper in a large mixing bowl. Fold in pickles and onion. Transfer to a bowl with a lid and refrigerate at least 4 hours.",
