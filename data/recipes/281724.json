  "ingredients": [
    "cooking spray",
    "1 pound ground turkey",
    "0.5 cup bread crumbs",
    "1 large egg",
    "0.25 cup finely chopped onion",
    "2 cloves garlic, minced",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "8 slices bacon, cut in half",
    "16 toothpicks",
    "0.5 cup teriyaki sauce, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil and spray with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground turkey, bread crumbs, egg, onion, garlic, salt, and pepper until well mixed. Form into sixteen 1 1/2-inch balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap each meatball with a piece of bacon, securing with a toothpick. Brush each bacon-wrapped meatball with teriyaki sauce, then place seam side down on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Brush meatball with additional teriyaki sauce. Continue baking until the turkey is cooked completely and the bacon has reached your desired crispness, 15 to 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
