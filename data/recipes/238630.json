  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.25 cup butter, cut into chunks",
    "0.33333334326744 cup milk",
    "1 egg, beaten",
    "2 cups blueberries",
    "1 tablespoon tapioca",
    "1 tablespoon lemon juice",
    "2 tablespoons butter, cut into small pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13-inch baking dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, baking powder, and salt together into a large bowl; cut in ¼ cup butter with 2 knives or a pastry blender until mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and egg together in a small bowl until well combined; stir into flour mixture until batter is just moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread blueberries into the prepared baking dish; sprinkle tapioca flour over blueberries, drizzle with lemon juice, and dot with 2 tablespoons butter pieces. Drop batter in mounds on top blueberry mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cobbler is golden and bubbling, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
