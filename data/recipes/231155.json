  "ingredients": [
    "3 tablespoons butter",
    "0.5 medium head cabbage, cut into chunks",
    "1 (16 ounce) package kielbasa sausage, sliced into rounds",
    "1 (12 fluid ounce) can beer",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a pot over medium heat. Cook and stir cabbage in the butter until tender, about 5 minutes. Add sausage and beer to the cabbage; stir. Season cabbage mixture with pepper. Simmer mixture until the sausage casings begin to shrink, about 20 minutes. Drain liquid from mixture before serving.",
