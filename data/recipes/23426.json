  "ingredients": [
    "cooking spray",
    "1.5 cups all-purpose flour",
    "0.75 cup white sugar",
    "1.25 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "1 cup banana, mashed",
    "0.25 cup applesauce",
    "2 egg whites"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8x4-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, sugar, baking powder, baking soda, and cinnamon together in a large bowl. Add banana, applesauce, and egg whites; stir just until combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
