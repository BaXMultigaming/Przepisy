  "ingredients": [
    "4 large baking potatoes",
    "0.5 pound bacon",
    "4 tablespoons butter",
    "1 large onion, chopped",
    "0.5 cup chopped fresh mushrooms",
    "1 teaspoon crushed red pepper",
    "1 teaspoon garlic powder",
    "1 teaspoon ground black pepper",
    "1 teaspoon chopped fresh chives",
    "1 teaspoon salt",
    "1 (8 ounce) container sour cream",
    "1 (8 ounce) package shredded Cheddar cheese",
    "1 teaspoon dry bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Use a fork to pierce the potato skins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake the potatoes unwrapped for about 1 hour, or until soft, in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Over medium-low heat melt the butter in a large saucepan. Combine onion, mushrooms, red pepper, garlic powder, pepper, chives and salt. Cook slowly, stirring occasionally until the onions are soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice open the baked potatoes and, keeping the skins intact, scoop the insides into a medium bowl. Transfer the onion mixture to the bowl. Mix in the sour cream. Pour in 1/2 of the cheese and continue mixing until all ingredients are well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a large spoon, fill the potato skins with the mixture. Top with bread crumbs, the remaining cheese and bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return the potatoes to the preheated oven and continue baking for about 15 minutes, until the cheese is melted and the filling is slightly brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
