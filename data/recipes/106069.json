  "ingredients": [
    "1 tablespoon vegetable oil",
    "2 tablespoons chopped garlic",
    "1 (14 ounce) package tofu, drained and cubed",
    "0.5 cup peanuts",
    "2 tablespoons soy sauce",
    "2 large cucumbers, peeled and thinly sliced",
    "0.5 cup Vietnamese sweet chili sauce",
    "0.25 cup lime juice",
    "1 bunch chopped cilantro leaves"
  ],
  "steps": [
    {
      "text": "Heat the vegetable oil over medium heat in a large frying pan. Cook the garlic until fragrant, about 30 seconds. Gently stir in the tofu and peanuts; cook until the tofu has lightly browned. Pour in the soy sauce, and cook, stirring frequently, until absorbed by the tofu. Remove from heat and let cool. Refrigerate for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss the sliced cucumbers together with the chili sauce, lime juice, and cilantro. Gently fold in the chilled tofu.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
