  "title": "German Chocolate Upside Down Cake",
  "description": "This upside-down version of German chocolate cake is both quicker and easier then the traditional right side-up cake.",
  "authors": [
    "SUNSET1"
  ],
  "date_published": "1999-07-16T14:09:56-04:00",
