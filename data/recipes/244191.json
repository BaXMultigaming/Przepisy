  "ingredients": [
    "8 honey graham crackers, crushed and divided",
    "1 pound semisweet chocolate chips",
    "1 (14 ounce) can sweetened condensed milk",
    "0.25 cup unsalted butter",
    "2 tablespoons vanilla extract",
    "1 (10.5 ounce) package miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Line an 11x7-inch baking dish with parchment paper. Sprinkle 1/2 of the crushed graham crackers on the bottom of the dish. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate chips, condensed milk, butter, and vanilla in the top of a double boiler over simmering water, stirring frequently and scraping down the sides with a rubber spatula to avoid scorching.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/2 of the melted chocolate mixture into the prepared baking dish; sprinkle 1/2 of the marshmallows over chocolate mixture. Repeat layers with remaining crushed graham crackers, chocolate mixture, and marshmallows.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill in the refrigerator until solid, 3 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
