  "ingredients": [
    "2 large Granny Smith apples, peeled and cored",
    "2 (10 ounce) cans refrigerated crescent roll dough",
    "1 cup butter",
    "1.5 cups white sugar",
    "1 teaspoon ground cinnamon",
    "1 (12 fluid ounce) can or bottle Mountain Dew ™"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each apple into 8 equal wedges; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate crescent roll dough into triangles. Roll each apple wedge in a crescent roll triangle, starting at the wide end and rolling toward the pointed tip. Pinch to seal and place in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7LK1lqwoJXIji4nT-AgyYwwt9XA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/102133-country-apple-dumplings-ddmfs-Step2-5079-0d263b8ed85b40119d28ef7df582a1ef.jpg"
      ],
      "image": "assets/images/102133/step_03.webp"
    },
    {
      "text": "Melt butter in a small saucepan over low heat. Stir sugar and cinnamon into melted butter until combined. Pour over apple dumplings, followed by soda.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a7jHmK5HBmb5ndIszx6D5TJhYAA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/102133-country-apple-dumplings-ddmfs-Step3-5081-d764fb35ffb7476db953daa7bb83034d.jpg"
      ],
      "image": "assets/images/102133/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-9JbAZ0BBl5hKFPtYVD0PMyM7Zk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/102133-country-apple-dumplings-ddmfs3X4-5089-6797a8056fdd431fae660d3b65d29ff0.jpg"
