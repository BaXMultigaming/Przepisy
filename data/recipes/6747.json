  "title": "Lower Fat Banana Nut Bread",
  "description": "Fat-free sour cream and reduced-fat margarine really make a dent in the fat gram count without sacrificing the yumminess factor of this banana nut bread.",
  "authors": [
    "Julia Oh"
  ],
  "date_published": "1998-06-19T19:36:51-04:00",
