  "ingredients": [
    "0.5 pound feta cheese, crumbled",
    "0.33333334326744 cup extra-virgin olive oil",
    "4 tablespoons julienned sun-dried tomatoes in oil",
    "1 clove garlic, minced",
    "0.5 teaspoon lemon juice",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon red pepper flakes",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine feta cheese, olive oil, sun-dried tomatoes (plus some of the oil), garlic, lemon juice, pepper, red pepper flakes, and salt in a large resealable plastic bag and allow to marinate for 1 hour at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer ingredients to a small oven-proof stone dish or ramekin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until spread bubbles and is slightly browned, about 15 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
