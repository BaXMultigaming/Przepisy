  "ingredients": [
    "4 pounds chicken legs",
    "2 tablespoons chili powder",
    "1 tablespoon garlic powder",
    "1 teaspoon cayenne pepper",
    "1 teaspoon Himalayan pink salt",
    "2 tablespoons tamari"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken legs in a large bowl. Spread chili powder, garlic powder, cayenne, and salt onto the chicken; pour sauce over top. Mix thoroughly and transfer to a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until chicken is no longer pink at the bone and the juices run clear, 45 to 50 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
