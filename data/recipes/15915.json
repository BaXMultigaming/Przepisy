  "ingredients": [
    "1 (2 pound) package frozen hash brown potatoes, thawed",
    "0.5 cup melted butter",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "12 ounces shredded American cheese",
    "1 (8 ounce) container sour cream",
    "1 teaspoon salt",
    "0.5 onion, chopped",
    "2 cups crushed cornflakes cereal",
    "0.5 cup melted butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease one 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in bottom of prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the 1/2 cup butter, condensed soup, cheese, sour cream, salt and onion; mix well and pour over potatoes. Top with crushed corn flakes and drizzle with 1/2 cup melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered at 350 degrees F (175 degrees C) for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
