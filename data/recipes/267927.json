  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sriracha, butter, sucralose, mustard, soy sauce, ginger, onion powder, and salt in a saucepan. Cook and stir over medium heat until blended and heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cooked wings in a large bowl with sauce and toss gently to coat. Spread on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until sauce thickens slightly, 5 to 10 minutes.",
