  "ingredients": [
    "1 onion, chopped",
    "4 cloves crushed garlic",
    "6 (3/4 inch) thick pork chops",
    "0.5 cup water",
    "0.33300000429153 cup all-purpose flour",
    "1 (14.5 ounce) can fat-free chicken broth",
    "1 tablespoon browning sauce"
  ],
  "steps": [
    {
      "text": "Saute onion and garlic in a non-stick skillet coated with vegetable spray until tender. Add pork chops, and brown on both sides. Add 1/2 cup of water, and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together, flour, chicken broth, and browning sauce until smooth. Add to skillet, stirring well. Cover and cook over low heat 30 to 45 minutes or until tender.",
      "section": null,
