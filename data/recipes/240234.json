  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "0.5 cup brown sugar",
    "1.5 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 cup butter",
    "0.75 cup orange juice",
    "1 egg, well beaten",
    "1 teaspoon vanilla extract",
    "1 tablespoon grated orange zest",
    "1.5 cups cranberries",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, white sugar, brown sugar, baking powder, baking soda, and salt together in a large mixing bowl. Mash butter into the flour mixture with a pastry cutter until the mixture resembles coarse cornmeal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir orange juice, egg, vanilla extract, and orange zest together in a small bowl; add to flour mixture and stir just until the dry ingredients are moistened and batter-like. Fold cranberries and walnuts through the batter; spoon into the prepared loaf pan, spreading so the corners and sides are slightly higher than the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
