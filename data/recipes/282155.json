  "title": "Cheesy Baked Cauliflower Florets",
  "description": "Cheesy cauliflower florets are a delicious side dish--they start off in the oven and finish up in a rich and creamy Cheddar cheese sauce.",
  "authors": [
    "Mark Adams"
  ],
  "date_published": "2016-07-06T20:26:17-04:00",
