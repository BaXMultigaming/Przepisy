  "ingredients": [
    "3 pounds skinless, boneless chicken thighs",
    "1 (12 fluid ounce) can or bottle root beer",
    "1 (18 ounce) bottle barbeque sauce (such as Sweet Baby Ray's®), or more to taste",
    "8 (2 ounce) hamburger buns, split"
  ],
  "steps": [
    {
      "text": "Place chicken inside a slow cooker and pour the root beer over the meat. Cook on Low until meat easily shreds, 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain off the cooking liquid and use meat claws, two forks, or a large spoon to break the meat apart. Stir in barbeque sauce. Keep warm in the slow cooker until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place meat onto hamburger buns and serve drizzled with more barbeque sauce if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
