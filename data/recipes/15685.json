  "ingredients": [
    "4 apples - peeled, cored and sliced",
    "1 cup water",
    "2 teaspoons ground cinnamon",
    "2 tablespoons cornstarch",
    "0.25 cup fructose (fruit sugar)",
    "1 cup whole wheat pastry flour",
    "1 teaspoon baking powder",
    "0.25 cup canola oil",
    "1 tablespoon honey",
    "0.5 cup lowfat buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F ( 190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan over medium heat, combine the apples, water, cinnamon, cornstarch and fructose. Cook until apples are soft and mixture is thickened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the apple mixture into a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare biscuit dough by combining the whole-wheat pastry flour and baking powder. Add the oil and stir until well mixed. Add the honey and buttermilk; stir with a fork until flour mixture is moist. Add additional milk if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop biscuit dough by tablespoons on top of apples. Bake for 20 minutes or until biscuits are golden brown. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
