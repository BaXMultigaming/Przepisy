  "title": "Warm Apple Cinnamon Cobbler",
  "description": "Apples and cinnamon sweetened with fructose are baked under a honey buttermilk biscuit crust in this dessert from the American Diabetes Association.",
  "authors": [
    "Robyn Webb"
  ],
  "date_published": "2000-01-04T19:25:47-05:00",
