  "ingredients": [
    "1 cup Italian-season bread crumbs, or more to taste",
    "salt and ground black pepper to taste",
    "1 egg",
    "0.5 cup bay scallops, or more to taste",
    "2 tablespoons butter",
    "1 tablespoon olive oil",
    "1.5 teaspoons lemon juice"
  ],
  "steps": [
    {
      "text": "Mix bread crumbs, salt, and pepper in a resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg lightly in a bowl. Dip scallops in egg; place in the bread crumb mixture in the bag. Seal bag and shake until scallops are coated with bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring butter, olive oil, and lemon juice to a simmer in a skillet over medium-high heat. Add breaded scallops; cook, shaking skillet occasionally, until browned, 6 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
