  "ingredients": [
    "3 ripe peaches",
    "2 tablespoons unsalted butter",
    "0.5 cup real maple syrup",
    "1 teaspoon lemon zest",
    "1 pinch freshly grated nutmeg"
  ],
  "steps": [
    {
      "text": "Cut each peach in half, remove pit, and cut each half into 6 slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a medium saucepan over medium-high heat until slightly browned, 2 to 4 minutes. Place peach slices into the butter, reduce heat to medium-low, and cook for 3 minutes, turning carefully. Add maple syrup, lemon zest, and nutmeg to the pot and cook for 2 to 3 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow to cool slightly before serving.",
      "section": null,
