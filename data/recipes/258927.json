  "ingredients": [
    "1 (8 ounce) can pineapple chunks, drained",
    "1 cup cubed, seeded watermelon",
    "1 mango, peeled and cubed",
    "1 green apple, cored and sliced",
    "0.25 cup lime juice",
    "2 tablespoons honey, or more to taste",
    "1 jalapeno pepper, seeded and chopped",
    "2 teaspoons chili-lime seasoning (such as Tajin®)"
  ],
  "steps": [
    {
      "text": "Combine pineapple, watermelon, mango, and green apple in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine lime juice, honey, and jalapeño in a blender; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour jalapeño dressing over fruit; mix thoroughly. Sprinkle chili-lime seasoning on top. Refrigerate to chill before serving, 1 to 2 hours.",
