  "ingredients": [
    "1 (16 ounce) package potato gnocchi",
    "1 pound ground turkey",
    "1 (28 ounce) jar marinara sauce",
    "2 cups shredded Cheddar cheese",
    "1 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook gnocchi in the boiling water until they float to the top, 2 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat a large skillet over medium-high heat. Cook and stir ground turkey in the hot skillet until browned and crumbly, about 5 minutes, making sure not to overcook as meat will continue to brown in the oven. Stir in marinara sauce; remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cooked gnocchi to a 9-inch square baking dish using a slotted spoon. Top with meat sauce. Sprinkle Cheddar cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese begins to brown, 25 to 35 minutes. Serve with sour cream on the side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
