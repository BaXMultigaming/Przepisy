  "ingredients": [
    "2 tablespoons vegetable oil",
    "0.5 onion, minced",
    "0.5 green bell pepper, chopped",
    "1 pound ground beef",
    "4 slices bacon",
    "2 (4 ounce) jars mushrooms, drained",
    "1 (29 ounce) can tomato sauce",
    "1 (6 ounce) can tomato paste",
    "2 tablespoons garlic powder",
    "2 tablespoons dried oregano",
    "0.5 cup white wine",
    "0.75 cup sugar",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a skillet over medium heat, cook onion and bell pepper in oil until transparent. Add beef to onions and peppers; cook until brown. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown. Reserve drippings and crumble bacon. Combine drippings and crumbled bacon with the beef mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add mushrooms, tomato sauce, tomato paste, garlic powder and oregano. Pour in wine while stirring. Stir in sugar, then salt and pepper. Cook until hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
