    "publisher-tested"
  ],
  "ingredients": [
    "1 (3 pound) whole chicken",
    "1 onion, chopped",
    "2 ribs celery, chopped",
    "1 carrot, chopped",
    "2 bay leaves",
    "2 teaspoons salt, or more to taste",
    "0.25 teaspoon dried oregano leaves",
    "3 quarts cold water",
    "2 cups finely diced onion",
    "2 tablespoons extra-virgin olive oil",
    "0.66666668653488 cup arborio rice, or more to taste",
    "2 large eggs",
    "0.5 teaspoon ground black pepper",
    "1 pinch cayenne pepper",
    "0.5 cup fresh lemon juice"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GDiGYMjNAfn9y5NZDCjhnORXZyI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241873-avgolemono-soup-VAT-001-step-01-7a00931a60fc4e37b6c25d8fac805390.jpg"
      ],
      "image": "assets/images/241873/step_01.webp"
    },
    {
      "text": "Place chicken, 1 chopped onion, celery, carrot, bay leaves, salt, and oregano in a large pot. Pour water over the top; bring to a boil, reduce heat to medium-low, and simmer, skimming foam as necessary, until chicken is falling off the bone, 60 to 90 minutes. An instant-read thermometer inserted into the thickest part of the thigh, near the bone, should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yRN6kFk90NLb914pJjlg5uOngXA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241873-avgolemono-soup-VAT-003-step-02-02-0a33c55090504ea28d6d28240fb32d28.jpg"
      ],
      "image": "assets/images/241873/step_02.webp"
    },
    {
      "text": "Transfer chicken to a large bowl to cool. Strain all vegetables from simmering broth, discard vegetables, and return broth to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SB8C5bRz3Cu1ef-TG8CHvOEc7DA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241873-avgolemono-soup-VAT-004-step-03-01-d4f3a83416304fe3a9fb3937d465a245.jpg"
      ],
      "image": "assets/images/241873/step_03.webp"
    },
    {
      "text": "Chop chicken meat into bite-sized pieces and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pXByZdDtmI5k6t_nT4W1wYh45ss=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241873-avgolemono-soup-VAT-006-step-04-249338223a444af68505ad887c0eb4ec.jpg"
      ],
      "image": "assets/images/241873/step_04.webp"
    },
    {
      "text": "Combine 2 cups diced onion, olive oil, and a pinch of salt in a large skillet over medium heat. Cook and stir onion mixture until onion is soft, sweet, and golden, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/omR8Z280s7n88LSaJFuS2qbOhNU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241873-avgolemono-soup-VAT-007-step-05-1a527d3c66394b65af38081642617925.jpg"
      ],
      "image": "assets/images/241873/step_05.webp"
    },
    {
      "text": "Stir onion mixture into broth in the pot and set over medium-low heat; add Arborio rice and a pinch of salt. Bring to a simmer; cook, stirring occasionally, until rice is very tender and broth flavors combine, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q_smEXuujstAXezQkLdxPWanAbM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241873-avgolemono-soup-VAT-008-step-06-bf934f244abd436e955934b7c9af8e50.jpg"
      ],
      "image": "assets/images/241873/step_06.webp"
    },
    {
      "text": "Whisk together eggs, black pepper, and cayenne pepper in a medium bowl; whisk in lemon juice until combined. Slowly pour 1 cup broth mixture into egg mixture, whisking constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ipMr-2J_zFjxPNPxMd3f5c72Rc4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241873-avgolemono-soup-VAT-010-step-07-02-10c9012f8f804b249280925807acc77f.jpg"
      ],
      "image": "assets/images/241873/step_07.webp"
    },
    {
      "text": "Whisk another 1 cup broth mixture into egg mixture, then pour egg mixture into the pot. Stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eo8yq27xDa2zGG0pzPlTdOiDMbk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241873-avgolemono-soup-VAT-011-step-08-b5483ffa40d048648450a4b6006e9bfa.jpg"
      ],
      "image": "assets/images/241873/step_08.webp"
    },
    {
      "text": "Add chopped chicken and cook until heated through, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6RGFZTd8_NwfVcyinuoP5W_YNCU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241873-avgolemono-soup-VAT-012-step-09-fa9ef41751844e278358e29df1ec9da6.jpg"
      ],
      "image": "assets/images/241873/step_09.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ugx2h93P0rqOCKtV3oHb1tzDN-0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241873-avgolemono-soup-VAT-014-4x3-02-bbabbfc95edf4b5fbc74f7ede8857017.jpg"
      ],
      "image": "assets/images/241873/step_10.webp"
    }
  ],
