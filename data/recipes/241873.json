  "title": "Avgolemono Soup",
  "description": "Greek avgolemono soup is a rich and silky chicken and rice soup flavored with lemon and enriched with eggs. Chef John&#39;s recipe makes this epic soup from scratch.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2015-03-23T19:51:03-04:00",
