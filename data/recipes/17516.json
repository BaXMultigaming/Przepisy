  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "1 (3.4 ounce) package instant vanilla pudding mix",
    "1 cup sour cream",
    "4 eggs",
    "0.5 cup vegetable oil",
    "0.5 cup white sugar",
    "0.5 cup chopped walnuts",
    "2 teaspoons ground cinnamon",
    "6 apples - peeled, cored and sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cake and pudding mix together in a large bowl. Add sour cream, eggs, and oil; mix until well blended. Combine sugar, walnuts, and cinnamon medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/2 of the batter into the prepared pan; layer with 1/2 of the sliced apples; sprinkle with 1/2 of the cinnamon-walnut mixture. Pour remaining 1/2 of the batter over top; layer with the remaining 1/2 of the apples and cinnamon-walnut mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in cake comes out clean, 60 to 70 minutes. Cool for 30 minutes before removing from the pan to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
