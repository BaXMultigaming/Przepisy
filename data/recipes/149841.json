  "ingredients": [
    "3.25 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 cup butter, room temperature",
    "2.125 cups white sugar",
    "2 eggs",
    "0.66666668653488 cup sweetened dried cranberries"
  ],
  "steps": [
    {
      "text": "Sift together the flour and cinnamon in a bowl. Cream together the butter and sugar in a separate bowl. Mix in 1 egg thoroughly, then mix in the second egg. Slowly stir the flour mixture into the butter mixture. Stir in the cranberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll the dough into a log with a diameter of about 1 1/2 inches; wrap in plastic; place in freezer for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Cut the cookie dough into 1/2-inch-thick slices using a sharp knife. Arrange the cookies onto a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until edges turn brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
