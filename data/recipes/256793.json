  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "1 cup sour cream",
    "2 (16 ounce) cans refried beans",
    "1 (4.5 ounce) can chopped green chiles, drained",
    "1 (1.25 ounce) package McCormick® Taco Seasoning Mix",
    "4 cups shredded Mexican blend cheese, divided"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Microwave cream cheese and sour cream in large microwaveable bowl on HIGH 1 minute or until cheese is softened. Remove from microwave. Mix with wire whisk until smooth. Add refried beans, green chiles, Seasoning Mix and 2 cups of the cheese; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread bean mixture into 13x9-inch baking dish sprayed with no stick cooking spray. Sprinkle with remaining 2 cups cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25 minutes or until cheese is melted. Serve with tortilla chips.",
