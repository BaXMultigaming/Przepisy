  "ingredients": [
    "3 (14.5 ounce) cans chicken broth",
    "3 (10 ounce) packages frozen chopped broccoli",
    "6 tablespoons margarine",
    "1 medium onion, chopped",
    "0.5 cup all-purpose flour",
    "2 cups milk",
    "1.5 pounds processed cheese food (eg. Velveeta), cubed",
    "1 pinch ground white pepper"
  ],
  "steps": [
    {
      "text": "Bring broth to a simmer in a large pot over medium heat. Cook broccoli in simmering broth for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in a separate skillet over medium heat, melt margarine. Add onion and sauté for 5 minutes, or to desired tenderness. Stir flour into onion until pasty. Gradually add milk and stir until thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion mixture to broccoli mixture in the pot and stir well. Stir in cheese until melted; do not boil. Season with white pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
