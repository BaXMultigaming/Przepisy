  "ingredients": [
    "2 tablespoons mayonnaise",
    "2 tablespoons sour cream",
    "1 tablespoon lemon juice",
    "0.5 teaspoon salt",
    "0.25 teaspoon white pepper",
    "0.25 teaspoon hot pepper sauce (such as Tabasco®)",
    "6 hard-cooked eggs, chopped",
    "2 avocados - peeled, pitted, and chopped",
    "2 small tomatoes, cored and diced",
    "0.5 cup chopped red onion",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Combine mayonnaise, sour cream, lemon juice, salt, white pepper, and hot pepper sauce in a large bowl. Add eggs, avocados, tomatoes, onion, and cilantro. Toss lightly to combine. Cover and refrigerate until ready to serve, at least 20 minutes.",
