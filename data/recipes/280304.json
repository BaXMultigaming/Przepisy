  "ingredients": [
    "2 lemons",
    "2 limes",
    "6 skinless, boneless chicken breasts",
    "1 tablespoon lemon-pepper seasoning, divided",
    "0.5 head iceberg lettuce, chopped",
    "4 carrots, chopped",
    "2 tomatoes, chopped",
    "2 cucumbers, chopped",
    "0.25 cup sliced green onions, or to taste"
  ],
  "steps": [
    {
      "text": "Roll lemons and limes on a cutting board to release the juices; cut in half and squeeze 1/2 of the juice onto chicken breasts. Sprinkle with 1/2 of the lemon-pepper seasoning, and let marinate for about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss lettuce, carrots, tomatoes, cucumbers, and green onions together in a large salad bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn marinated chicken over and sprinkle other side with remaining lemon-pepper seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook chicken on the preheated grill until no longer pink in the centers and juices run clear, 5 to 7 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut chicken into long strips and place on salad. Squeeze remaining lemon and lime juice on salad at the last minute before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
