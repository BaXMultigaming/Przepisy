  "title": "Grilled Lemon-Pepper Chicken Salad",
  "description": "Lemon-pepper chicken breasts are grilled and placed on top of iceberg lettuce and veggies for this easy, summery salad.",
  "authors": [
    "REDNECKGRL"
  ],
  "date_published": "2020-06-04T03:09:12-04:00",
