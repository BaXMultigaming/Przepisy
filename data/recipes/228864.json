  "ingredients": [
    "0.5 pound bulk spicy pork sausage",
    "0.5 pound ground beef",
    "1 onion, diced",
    "1 (2 pound) loaf processed cheese food (such as Velveeta®), cubed",
    "1 (28 ounce) can diced tomatoes with green chile peppers (such as RO*TEL®)",
    "1 (10.5 ounce) can condensed cream of mushroom soup"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Crumble sausage and ground beef into the skillet; add onion. Cook and stir until the meat is evenly browned, and no longer pink, about 10 minutes; drain and discard any excess grease. Transfer meat mixture into a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nc6HCzXk3b1Kn0ZJbX7u4OfLBok=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228864-best-cheese-dip-VAT-step-01-edd0d420f8074abc8d24ba278559c634.jpg"
      ],
      "image": "assets/images/228864/step_01.webp"
    },
    {
      "text": "Layer cheese food cubes atop meat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N7yPTln8bdyVnWbLM6Kzc37g5hM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228864-best-cheese-dip-VAT-step-02-06ad408d9bf84d4697855699ea68d081.jpg"
      ],
      "image": "assets/images/228864/step_02.webp"
    },
    {
      "text": "Blend diced tomatoes with green chile peppers in a blender until smooth; pour over cheese cubes along with condensed soup. Stir well and cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j2HmaCZSym33rTXr2a_jsrwwOJM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228864-best-cheese-dip-VAT-step-03-a4a65c2de1b6499a8e63219b83930d39.jpg"
      ],
      "image": "assets/images/228864/step_03.webp"
    },
    {
      "text": "Cook on High, stirring occasionally until the cheese is completely melted, about 90 minutes.",
      "section": null,
