  "title": "Chocolate Thumbprint Cookies",
  "description": "A recipe for chocolate thumbprint cookies with no shortage of chocolate! These are made with chocolate cookie dough and filled with an easy chocolate ganache.",
  "authors": [
    "Anna Theoktisto"
  ],
  "date_published": "2022-11-20T09:00:00-05:00",
