  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup chopped rhubarb",
    "0.75 cup brown sugar",
    "0.75 cup wheat bran",
    "2 teaspoons baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 cup unsweetened applesauce",
    "0.5 cup vegetable oil",
    "2 tablespoons molasses",
    "1.5 teaspoons apple cider vinegar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, rhubarb, brown sugar, wheat bran, baking powder, cinnamon, and nutmeg in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine applesauce, oil, molasses, vinegar, and vanilla extract in a separate bowl; slowly mix into flour mixture until a thick batter forms. Divide batter among the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
