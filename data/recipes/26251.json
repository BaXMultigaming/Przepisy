  "ingredients": [
    "1 (12 ounce) package angel hair pasta",
    "2.5 tablespoons butter, divided",
    "1.5 tablespoons all-purpose flour",
    "1.5 cups milk",
    "0.5 cup heavy cream",
    "1.5 tablespoons pesto",
    "1.5 tablespoons chopped fresh parsley",
    "3 cloves garlic, minced",
    "2 tablespoons grated Parmesan cheese",
    "2 teaspoons salt, divided",
    "0.5 teaspoon ground white pepper",
    "1 dash Worcestershire sauce",
    "1 dash hot sauce",
    "0.5 (16 ounce) package frozen broccoli florets, thawed",
    "1 pound jumbo shrimp, peeled and deveined",
    "3 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1.5 tablespoons butter in a medium saucepan over medium heat. Stir in flour and cook for 2 minutes. Slowly stir in milk and cream; simmer, stirring constantly, until thickened. Mix in pesto, parsley, 3 cloves minced garlic, Parmesan cheese, 1 teaspoon salt, white pepper, Worcestershire sauce and hot sauce. Reduce heat to low and allow to simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place broccoli in a steamer over 1 inch of boiling water, and cover. Cook until tender but still firm, about 2 to 6 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1 tablespoon butter in a large skillet. Saute shrimp, remaining 3 cloves minced garlic, and 1 teaspoon salt for 5 minutes, or until shrimp are pink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, toss pasta, shrimp and broccoli; pour sauce over and serve.",
      "section": null,
      "name": null,
      "url": null,
