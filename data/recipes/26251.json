  "title": "Angel Hair Pasta with Garlic Shrimp and Broccoli",
  "description": "Angel hair pasta is tossed with sauteed shrimp and steamed broccoli, and topped with a rich garlicky cream sauce.",
  "authors": [
    "Robbie Rice"
  ],
  "date_published": "2019-04-02T02:43:33-04:00",
