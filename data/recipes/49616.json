  "ingredients": [
    "1 cup heavy cream",
    "3 tablespoons butter",
    "0.5 cup shredded mozzarella cheese",
    "2 tablespoons grated Parmesan cheese",
    "0.25 cup chopped sun-dried tomatoes",
    "salt and pepper to taste",
    "1 tablespoon pine nuts"
