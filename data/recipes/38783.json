  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup shredded coconut",
    "0.5 cup white sugar",
    "0.33333298563957 cup chopped toasted almonds",
    "1.5 teaspoons baking powder",
    "0.75 teaspoon orange zest",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.75 cup unsweetened coconut milk",
    "0.25 cup orange juice",
    "0.25 cup extra virgin olive oil",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease a 12 cup muffin pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix flour, shredded coconut, sugar, almonds, baking powder, orange zest, baking soda, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, whisk together coconut milk, orange juice, olive oil, and vanilla extract. Pour into the flour mixture, and stir until just blended. Transfer to the prepared muffin pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 15 minutes in the preheated oven, until a knife inserted in the center of a muffin comes out clean. Turn onto a wire rack to cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
