  "ingredients": [
    "1 cup brown lentils, picked over",
    "2 apples, cored and chopped",
    "1 carrot, cubed",
    "0.5 bunch chives, chopped",
    "1 tablespoon chopped fresh parsley, or more to taste",
    "5 tablespoons olive oil",
    "2 tablespoons cider vinegar",
    "1 teaspoon Dijon mustard, or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place lentils in a saucepan. Add enough water to cover by 1 inch. Bring to boil. Reduce heat and simmer, uncovered, until lentils are tender but not mushy, 15 to 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine lentils, apples, carrot, chives, and parsley in a bowl. Stir together olive oil, vinegar, mustard, salt, and pepper in a cup and pour over lentil mixture. Mix and serve.",
      "section": null,
