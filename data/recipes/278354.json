  "ingredients": [
    "1 (1 pound) ground Mexican chorizo",
    "1 medium onion, diced",
    "1 green bell pepper, diced",
    "1 (4 ounce) can chopped green chiles",
    "1 clove garlic, minced",
    "1 (15 ounce) can chili beans",
    "1 (14 ounce) can diced tomatoes with green chiles",
    "1 large sweet potato, diced",
    "0.5 (6 ounce) can tomato paste",
    "1 teaspoon chili powder",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "1 bay leaf",
    "salt and ground black pepper to taste",
    "3 cups water, or to taste"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Saute chorizo, onion, and bell pepper until chorizo is mostly browned and vegetables soften, about 10 minutes. Add green chiles and garlic; saute for 3 to 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer sauteed mixture to a slow cooker. Add chili beans, diced tomatoes, sweet potato, tomato paste, chili powder, cinnamon, cloves, bay leaf, salt, and pepper. Mix well. Add water until chili is at your desired consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for at least 4 hours. Serve in deep bowls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
