  "ingredients": [
    "2 cups white sugar",
    "1 cup brown sugar",
    "4 eggs, lightly beaten",
    "1 (16 ounce) can solid pack pumpkin",
    "3.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 teaspoons ground cinnamon",
    "2 teaspoons ground nutmeg",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon ground cloves",
    "1 teaspoon ground allspice",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease two 9-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix white sugar, brown sugar, and eggs in a large bowl; stir in pumpkin and mix well. Combine flour, baking soda, salt, cinnamon, nutmeg, baking powder, cloves, and allspice in a bowl; add alternately with water to pumpkin mixture. Pour into prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden and a toothpick inserted into the center comes out clean, 60 to 65 minutes. Cool in pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
