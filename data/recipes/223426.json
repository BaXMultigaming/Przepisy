  "title": "Pumpkin Spice Bread",
  "description": "Reminiscent of pumpkin pie, but without the crust, this pumpkin spice bread is sweet, spicy, and extra moist.",
  "authors": [
    "Kris Gunn"
  ],
  "date_published": "2020-06-18T23:50:20-04:00",
