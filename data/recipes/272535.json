  "ingredients": [
    "1 pound Brussels sprouts, halved",
    "1 tablespoon olive oil",
    "4 tablespoons reduced-sodium soy sauce",
    "2 tablespoons chicken broth",
    "2 tablespoons rice vinegar",
    "2 tablespoons sambal oelek",
    "2 tablespoons dry sherry",
    "2 teaspoons cornstarch",
    "0.25 cup unsalted roasted peanuts",
    "2 green onions, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a large rimmed baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss the Brussels sprouts and olive oil together in a bowl and spread out on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until soft, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile combine soy sauce, chicken broth, rice vinegar, sambal oelek, sherry, and cornstarch in a small bowl. Whisk until smooth. Pour mixture into a large saucepan and cook over low heat until sauce is thickened and Brussels sprouts are done cooking. Add Brussels sprouts to saucepan and toss to coat with sauce. Return Brussels sprouts to baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler to high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil Brussels sprouts until browned, about 5 minutes. Garnish with peanuts and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
