  "ingredients": [
    "7.5 cups all-purpose flour",
    "2 tablespoons baking soda",
    "1.5 teaspoons salt",
    "6 cups brown sugar",
    "3 cups butter, softened",
    "3 cups peanut butter",
    "6 eggs",
    "0.5 cup white sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line several baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate large bowl, cream brown sugar, butter, and peanut butter together until evenly mixed and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat in eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the the flour mixture into the peanut butter mixture to make a smooth dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place white sugar into a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into tablespoon-size balls, then roll in the white sugar to coat all sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cookies onto the prepared baking sheets at least 1 inch apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press each cookie down flat with a fork, making a cross-cross pattern.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are lightly browned on the bottom, about 12 minutes. Allow to cool on baking sheets about 5 minutes before removing to finish cooling on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
