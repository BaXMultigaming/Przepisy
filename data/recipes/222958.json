  "ingredients": [
    "4 large portobello mushrooms",
    "2 teaspoons olive oil",
    "0.5 cup PHILADELPHIA Herb & Garlic Cooking Creme",
    "0.5 cup grape tomatoes, quartered",
    "2 tablespoons Kraft 100% Parmesan Shredded Cheese",
    "1 green onion, thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat the grill to medium heat and grease the grates. Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Discard stems from mushrooms; scrape out gills with a small spoon. Brush mushrooms with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook mushrooms on the preheated grill until slightly softened, about 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove mushrooms from the grill and place on the prepared baking sheet. Dab the insides of mushroom caps with paper towels to remove excess moisture. Fill caps with cooking creme, tomatoes, Parmesan cheese, and green onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the tray with stuffed mushrooms on the preheated grill. Cover and cook until filling is heated through, 6 to 8 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
