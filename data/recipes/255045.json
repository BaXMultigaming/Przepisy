  "ingredients": [
    "cooking spray",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 cup vegetable oil",
    "0.5 cup white sugar",
    "0.25 (6 ounce) container soy yogurt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, cinnamon, and baking soda into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix vegetable oil, sugar, and soy yogurt together in a bowl. Stir in flour mixture until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoons of dough 2 inches apart onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 7 minutes.",
