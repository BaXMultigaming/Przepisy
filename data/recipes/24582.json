  "ingredients": [
    "20 fresh mushrooms, stems removed",
    "2 (6.5 ounce) cans minced clams, drained",
    "2 cloves garlic, peeled and minced",
    "0.5 cup grated Parmesan cheese",
    "1 small onion, finely chopped",
    "0.75 cup dry bread crumbs",
    "0.5 cup chopped green bell pepper",
    "2 tablespoons dried parsley",
    "2 tablespoons Italian-style seasoning",
    "ground black pepper to taste",
    "1.5 cups butter, melted",
    "0.5 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange mushroom caps hollow side up in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together minced clams, garlic, Parmesan cheese, onion, bread crumbs, green bell pepper, parsley, Italian-style seasoning and black pepper. Slowly stir in approximately 1/2 the butter, enough to make the mixture slightly moist.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Generously fill the mushroom caps with the clam mixture. Sprinkle with mozzarella cheese. Drizzle with remaining butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 30 minutes, or until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
