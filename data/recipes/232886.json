  "ingredients": [
    "2 teaspoons extra-virgin olive oil",
    "2 teaspoons sesame oil",
    "3 green bell peppers, thinly sliced",
    "1 yellow bell pepper, chopped",
    "1 red bell pepper, chopped",
    "1 red onion, chopped",
    "2 teaspoons minced garlic",
