  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.25 cup shortening",
    "0.5 cup white sugar",
    "1 egg",
    "0.5 cup buttermilk",
    "0.5 cup molasses",
    "1 teaspoon vanilla extract",
    "1.5 cups semisweet chocolate chips",
    "0.75 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets. Sift together the flour, cocoa, baking soda and salt; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the shortening and sugar until smooth. Beat in the egg, buttermilk, molasses and vanilla one at a time. Gently mix in the sifted ingredients just until blended, but no more than necessary. Drop by heaping spoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in the preheated oven, or until firm to the touch. Cool for a few minutes on cookie sheets before removing to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
