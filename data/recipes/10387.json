  "ingredients": [
    "1 cup butter, melted",
    "0.75 cup packed brown sugar",
    "0.75 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 cup peanut butter",
    "2 eggs, beaten",
    "1.25 cups all-purpose flour",
    "1 cup wheat bran",
    "0.75 cup rolled oats",
    "2 teaspoons baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, beat together butter, brown sugar, white sugar, vanilla, peanut butter, and eggs. In a separate bowl, mix flour, bran, oats, and baking soda. Stir flour mixture into butter mixture until smooth. Drop by rounded teaspoons onto an ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 18 minutes in the preheated oven. Remove to a rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
