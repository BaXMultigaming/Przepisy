  "ingredients": [
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "1.25 cups whole milk, or more as needed",
    "0.5 teaspoon onion powder",
    "0.125 teaspoon garlic powder",
    "1 (8 ounce) package shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Heat butter in a saucepan over medium-high heat; whisk flour into melted butter until smooth. Slowly pour milk into flour mixture; bring to a boil. Reduce heat to low and stir in onion powder and garlic powder; simmer for 2 minutes. Add Monterey Jack cheese while stirring constantly until melted, about 5 more minutes.",
