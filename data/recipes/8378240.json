  "ingredients": [
    "2 teaspoons sesame oil",
    "0.5 smoked sausage, sliced on the diagonal",
    "1 teaspoon minced fresh ginger",
    "1 teaspoon minced garlic",
    "2 tablespoons stir-fry sauce",
    "0.5 cup frozen broccoli florets",
    "0.5 cup frozen bell pepper strips",
    "1 (8.5 ounce) package instant jasmine rice",
    "0.5 teaspoon sesame seeds",
    "1 green onion, chopped"
  ],
  "steps": [
    {
      "text": "Heat sesame oil in a skillet over medium-high heat. Add sliced sausage and cook for 2 minutes. Add ginger and garlic and cook until fragrant, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in broccoli, bell peppers, and stir-fry sauce. Cook until heated through, about 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Snip 1 inch of the corner of the rice pouch, and cook rice in the microwave for 90 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fluff rice and place a scoop onto a plate. Top with sausage stir-fry and garnish with sesame seeds and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
