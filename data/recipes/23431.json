  "ingredients": [
    "24 ounces dry fettuccine pasta",
    "1 cup butter",
    "0.75 pint heavy cream",
    "1 dash garlic salt",
    "salt and pepper to taste",
    "0.75 cup grated Romano cheese",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AIxX5eiG3p_PKhSTFcvOBRFYkN0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23431-to-die-for-fettuccine-alfredo-DDMFS-ingredients-3x4-ba65aa04aeff41d19367a2a0addfc9f2.jpg"
      ],
      "image": "assets/images/23431/step_01.webp"
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x7ulHDq4TW4aCyc8ZM6RtsP--1c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23431-to-die-for-fettuccine-alfredo-DDMFS-step-1-3x4-d68d771414f4482093e2f18055015d47.jpg"
      ],
      "image": "assets/images/23431/step_02.webp"
    },
    {
      "text": "Heat butter and cream in a large saucepan over low heat until butter melted; add garlic salt, salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BSQFIEGp1SoNDLQqXk2tapFycBI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23431-to-die-for-fettuccine-alfredo-DDMFS-step-2-3x4-ba27f5a117e54bebb486f1958418d1ed.jpg"
      ],
      "image": "assets/images/23431/step_03.webp"
    },
    {
      "text": "Increase the heat to medium; stir in Romano and Parmesan cheeses until melted and sauce has thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z0LUbErN_LXrYq6SIjH0rA8F3zw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23431-to-die-for-fettuccine-alfredo-DDMFS-step-3-3x4-5f37b87abf2c4cf88cc1781f018b84d1.jpg"
      ],
      "image": "assets/images/23431/step_04.webp"
    },
    {
      "text": "Add cooked pasta to sauce; toss until thoroughly coated. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ey5aal-JHk7PoNP92is_VCambmA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23431-to-die-for-fettuccine-alfredo-DDMFS-beauty-3x4-b64d36c7ff314cb39774e261c5b18352.jpg"
