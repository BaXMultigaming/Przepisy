  "ingredients": [
    "1 (16 ounce) package linguine pasta",
    "4 tablespoons olive oil",
    "1 onion, chopped",
    "2 cloves garlic, minced",
    "3 tablespoons all-purpose flour",
    "2 (6.5 ounce) cans minced clams, drained with juice reserved",
    "1.5 cups milk",
    "2 tablespoons white wine",
    "0.5 teaspoon chopped fresh parsley",
    "0.25 teaspoon pepper",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large heavy skillet over medium heat. Saute onion and garlic until soft and translucent. Stir in flour, then the reserved clam juice. Gradually blend in the milk. Stir in wine and parsley. Cook, stirring, for 5 minutes, or until sauce thickens. Mix in the clams. Spoon over cooked pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
