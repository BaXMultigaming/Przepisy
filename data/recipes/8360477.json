  "ingredients": [
    "1.75 cups milk",
    "1 large egg, beaten",
    "1 tablespoon white sugar",
    "1 teaspoon vanilla extract",
    "2 cups baking mix (such as Bisquick®)",
    "butter-flavored cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat a regular waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk, egg, sugar, and vanilla together in a large mixing bowl until completely combined. Add baking mix and beat until incorporated; some lumps are okay as long as they are no bigger than a pea. Transfer batter to a liquid measure.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray the top and bottom of the preheated waffle iron with cooking spray. Slowly pour in enough batter to cover the bottom of the iron, being careful not to let if overflow.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Close the lid and cook until waffle is golden brown and the iron stops steaming, about 5 minutes. Repeat to cook remaining waffles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
