  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 cups diced fresh tomatoes with juices",
    "0.5 cup packed grated zucchini",
    "0.33 cup sliced green onions",
    "2 teaspoons kosher salt, or to taste",
    "1 teaspoon white sugar",
    "0.5 teaspoon freshly ground black pepper",
    "0.25 teaspoon dried oregano",
    "1 pinch cayenne pepper",
    "0.25 cup chopped fresh Italian parsley",
    "2 tablespoons chopped fresh mint",
    "2 tablespoons chopped fresh basil",
    "3 ounces feta cheese, crumbled",
    "0.75 cup all-purpose flour, or more as needed",
    "0.75 teaspoon baking powder",
    "vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GkdW26x5RR1By7YFK96WJmo41Is=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8431349-greek-tomato-feta-fritters-domatokeftethes-VAT-4x3-ingredients-1977b4abfc74434fac3c89b228b13d7e.jpg"
      ],
      "image": "assets/images/8431349/step_01.webp"
    },
    {
      "text": "Stir together tomatoes, zucchini, green onions, kosher salt, sugar, black pepper, oregano, and cayenne in a bowl to combine. Let sit for 15 minutes for the sugar and salt to draw out liquids from the vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8c7KdnKGsg7MLmXTntM5ZbTySio=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8431349-greek-tomato-feta-fritters-domatokeftethes-VAT-4x3-step-02-8878195567f5457c8119677a8b4a7d9f.jpg"
      ],
      "image": "assets/images/8431349/step_02.webp"
    },
    {
      "text": "Stir the tomato mixture; add parsley, mint, and basil. Crumble in feta cheese. Add flour and baking powder; mix with a spoon until combined. Batter should be relatively loose but will hold its shape on a spoon. If too loose, add more flour; if too dry, add some water until desired consistency is reached. Wrap the bowl in plastic wrap and let chill in the refrigerator for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ixlurwtc2RkjbyETyHZkRlEXjig=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8431349-greek-tomato-feta-fritters-domatokeftethes-VAT-4x3-step-03-3640e2290f824355bc2264ae26e8fcc3.jpg"
      ],
      "image": "assets/images/8431349/step_03.webp"
    },
    {
      "text": "Heat 1 inch of vegetable oil in a frying pan over medium-high heat to 350 degrees F (175 degrees C), or use a deep fryer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s5NKykq9lCiGodPZXegljhVNfds=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8431349-greek-tomato-feta-fritters-domatokeftethes-VAT-4x3-step-04-fb4afda616774dc88b3f71bb0b916449.jpg"
      ],
      "image": "assets/images/8431349/step_04.webp"
    },
    {
      "text": "Place heaping tablespoonfuls of batter in the hot oil; reduce heat to medium. Fry until golden brown and cooked through, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nfBIZzd1pQmaP9t7O_2kEVbPwRg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8431349-greek-tomato-feta-fritters-domatokeftethes-VAT-4x3-step-05-d8cc801509bf4bd499e6655a81e33a86.jpg"
      ],
      "image": "assets/images/8431349/step_05.webp"
    },
    {
      "text": "Flip once more and fry for an additional 30 seconds, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QGviF2g-XWGrusM7gc48g7vqooY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8431349-greek-tomato-feta-fritters-domatokeftethes-VAT-4x3-step-06-cf8b33233f2c4a048f862a92076597d1.jpg"
      ],
      "image": "assets/images/8431349/step_06.webp"
    },
    {
      "text": "Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x0PGvtArcGX4lT6ufRgAaHmD4l4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8431349-greek-tomato-feta-fritters-domatokeftethes-VAT-4x3-08bf1c81329146b0aa702552890d0837.jpg"
      ],
      "image": "assets/images/8431349/step_07.webp"
    }
  ],
