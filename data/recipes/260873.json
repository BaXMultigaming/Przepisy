  "ingredients": [
    "1.25 cups whole almonds",
    "3 cups white chocolate melting wafers",
    "3 tablespoons butter",
    "1 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast almonds on 1 baking sheet in the preheated oven, stirring occasionally, until toasted, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave white chocolate melting wafers and butter in a microwave-safe bowl on medium-high for 1 minute 30 seconds; stir. Microwave until completely melted, 20 to 30 seconds more. Add almond extract and stir until smooth. Stir in toasted almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread chocolate mixture evenly onto the second baking sheet. Chill in the refrigerator until hardened, about 1 hour. Break into small pieces by hand.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
