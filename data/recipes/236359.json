  "title": "Beef and Rice Stuffed Bell Peppers",
  "description": "These stuffed peppers with rice are Chef John's recipe for a savory filling of seasoned ground beef, cheese, and parsley baked in tomato sauce.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2014-01-23T16:54:03-05:00",
