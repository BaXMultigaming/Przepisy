  "ingredients": [
    "8 small zucchini, cut into 1/4 inch rounds",
    "1 onion, sliced",
    "6 tomatoes, sliced",
    "0.5 pound thinly sliced pepperoni",
    "1 (16 ounce) package small curd cottage cheese",
    "0.25 pound shredded Cheddar cheese",
    "0.25 pound shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bottom of the prepared baking dish with ½ zucchini slices; layer with ½ each onion rings, tomato slices, and pepperoni slices. Sprinkle with ½ each cottage cheese, Cheddar cheese, and mozzarella cheese. Repeat layers once more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until zucchini is tender and cheese is melted, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
