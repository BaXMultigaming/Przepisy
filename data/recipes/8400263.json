  "ingredients": [
    "1 pound ground beef",
    "2 large eggs",
    "0.75 cup panko bread crumbs",
    "0.25 cup finely chopped onion",
    "0.25 cup BBQ sauce, divided",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon garlic powder",
    "salt and freshly ground black pepper to taste",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, eggs, bread crumbs, onion, 2 tablespoons BBQ sauce, Worcestershire sauce, garlic powder, salt, and pepper in large bowl and mix by hand.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a sheet pan with foil and spray with cooking spray. Shape meatloaf mixture evenly into a rectangular shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Brush with remaining BBQ sauce (or more as needed) and bake until internal temperature reaches 165 degrees C (73 degrees C), about 15 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice meatloaf and serve with extra BBQ sauce if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
