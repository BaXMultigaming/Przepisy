  "ingredients": [
    "1 cup white sugar",
    "0.5 cup milk",
    "0.5 cup butter",
    "1 (12 ounce) bag semisweet chocolate chips",
    "2 cups quick-cooking oats",
    "1 cup shredded coconut",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, milk, and butter in a saucepan. Bring to a boil; simmer until sugar is dissolved, about 2 minutes. Remove from heat; stir in chocolate chips, oats, coconut, and walnuts. Drop spoonfuls of mixture 1 inch apart on the lined baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill until firm, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
