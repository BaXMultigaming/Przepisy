  "ingredients": [
    "1 (8 ounce) can water chestnuts, halved",
    "0.5 pound sliced bacon, cut in half",
    "0.25 cup mayonnaise",
    "0.5 cup packed light brown sugar",
    "0.25 cup tomato-based chili sauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap each water chestnut with a piece of bacon. Place the rolls seam-side down in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes, or until bacon is crisp and cooked through. Drain off the grease. In a small bowl, stir together the mayonnaise, brown sugar and chili sauce; pour over the bacon-chestnut rolls. Return to the oven and bake for another 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
