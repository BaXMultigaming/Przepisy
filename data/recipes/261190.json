  "ingredients": [
    "1 cup all-purpose flour",
    "1 tablespoon green tea powder (matcha)",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 cup cashew milk",
    "1 tablespoon cashew milk",
    "1 egg",
    "2 tablespoons olive oil",
    "2 teaspoons vanilla extract",
    "0.25 cup white chocolate chips"
  ],
  "steps": [
    {
      "text": "Whisk together flour, matcha, baking powder, and salt in a large bowl. Make a well in the center of mixture; add 1 cup plus 1 tablespoon cashew milk, egg, olive oil, and vanilla to the well. Whisk batter briefly until just a few small clumps of flour remain. Add chocolate chips; stir again briefly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a small saucepan lightly; heat over medium-low heat. Transfer 2 to 3 spoonfuls batter onto the center of the pan, spreading batter with the back of the spoon. Cook until small bubbles rise to the surface and burst, about 1 minute. Flip and cook until the edges are lightly golden brown, about 1 minute more. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
