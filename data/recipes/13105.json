  "ingredients": [
    "1 tablespoon margarine",
    "0.5 cup chopped onion",
    "1 teaspoon Worcestershire sauce",
    "0.5 teaspoon minced garlic",
    "1 (12 fluid ounce) can or bottle light beer",
    "1 (14.5 ounce) can chicken broth",
    "3 tablespoons cornstarch",
    "water",
    "2 cups half-and-half",
    "2 cups shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Melt margarine in a 4 1/2-quart soup pot over medium heat. Stir in onion, Worcestershire sauce, and garlic. Pour in beer and increase heat to high. Boil mixture until alcohol is evaporated, about 3 minutes. Pour in broth and bring soup back to a boil. Lower heat to medium-low and simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together cornstarch and water in a small bowl until smooth. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add half-and-half and cheese to soup; stir constantly until cheese melts. Stir in cornstarch mixture and continue stirring until soup is thick, about 2 minutes. Garnish with bacon bits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
