  "title": "Beer Cheese Soup",
  "description": "This recipe for beer cheese soup garnished with bacon bits features onion, garlic, beer, cream, and Worcestershire sauce in a chicken broth base.",
  "authors": [
    "Debbie Rowe"
  ],
  "date_published": "1999-03-06T20:08:11-05:00",
