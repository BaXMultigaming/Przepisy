  "ingredients": [
    "0.5 cup shortening",
    "1 cup white sugar",
    "1 egg",
    "0.75 cup buttermilk",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Cream together the shortening and the sugar. Stir in the egg, buttermilk and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the flour, baking soda and salt. Add the flour mixture to the creamed mixture and stir to combine. Chill dough in the refrigerator for 1 hour. Drop mixture by rounded teaspoons 2 inches apart on a lightly greased baking sheet. If desired sprinkle tops of cookies with white sugar before baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 400 degrees F (205 degrees C) for 7 to 9 minutes or until set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
