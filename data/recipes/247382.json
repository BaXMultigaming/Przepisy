  "ingredients": [
    "1 teaspoon softened butter",
    "1 dash all-purpose flour",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "3 eggs",
    "1 cup milk",
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "0.75 cup white sugar",
    "0.5 cup water",
    "4 large bananas, halved"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9-inch baking pan with butter; dust with flour, shaking off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 2 cups sugar, oil, and eggs with an electric mixer until creamy. Beat in milk. Add 2 cups flour and baking powder; beat until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 3/4 cup sugar and water in a small saucepan. Simmer until sugar dissolves and syrup is clear and thick, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour syrup into prepared baking pan. Arrange banana halves on top. Pour batter over bananas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cake in the preheated oven until top is golden brown and a toothpick inserted into the center comes out clean, about 40 minutes. Let cool for 10 minutes before inverting onto a platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
