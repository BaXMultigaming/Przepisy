  "title": "Glazed Homemade Lemon Cake",
  "description": "Moist and easy to make, this homemade, fresh lemon cake is baked golden and topped with a sugary sweet citrus glaze.",
  "authors": [
    "Kirsten Johnson"
  ],
  "date_published": "2020-06-19T00:37:35-04:00",
