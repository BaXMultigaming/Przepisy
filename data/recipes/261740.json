  "ingredients": [
    "2 cups whole wheat flour",
    "1 cup white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 teaspoon vanilla extract",
    "1.5 cups blueberries",
    "0.5 cup unsweetened applesauce",
    "0.5 cup soy milk",
    "0.25 cup margarine"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, baking powder, and salt together in a bowl. Stir in blueberries, applesauce, soy milk, and margarine. Fill each muffin cup approximately 3/4 of the way with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
