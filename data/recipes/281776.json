  "ingredients": [
    "cooking spray",
    "1 medium yellow squash, grated",
    "0.25 cup finely chopped onion",
    "1 (16 ounce) can vegetarian refried beans",
    "4 (10 inch) whole wheat tortillas",
    "1 (15.5 ounce) can black beans, rinsed and drained",
    "1 cup cottage cheese",
    "0.5 cup shredded mozzarella cheese",
    "0.5 cup shredded Cheddar cheese",
    "1 (16 ounce) jar salsa"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 9-inch square baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a skillet with cooking spray. Add squash and onion and cook over medium heat until softened, 3 to 5 minutes. Add refried beans and cook until heated through, about 3 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using 1/4 of the ingredients at a time, make 4 layers in the prepared baking dish as follows: tortilla, refried bean mixture, black beans, cottage cheese, mozzarella cheese, Cheddar cheese, and salsa. Repeat layers 3 more times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and heated through, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
