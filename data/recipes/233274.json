  "ingredients": [
    "2 cucumbers",
    "4 cups cubed seeded watermelon",
    "0.5 cup finely chopped red onion",
    "3 tablespoons seasoned rice vinegar",
    "3 tablespoons white wine vinegar",
    "3 tablespoons lime juice",
    "0.25 cup chopped fresh mint",
    "0.5 cup feta cheese"
  ],
  "steps": [
    {
      "text": "Peel cucumbers lengthwise in a striped pattern using a vegetable peeler; halve lengthwise and cut into ¼-inch slices creating half-moon shapes. Transfer cucumbers to a large bowl; add watermelon and red onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk seasoned rice wine vinegar, white wine vinegar, and lime juice together in a small bowl until well combined; add mint. Muddle mint by vigorously stirring and pressing leaves with a spoon until bruised but not falling apart. Discard mint leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle vinaigrette over salad; gently toss. Sprinkle with feta cheese; toss again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
