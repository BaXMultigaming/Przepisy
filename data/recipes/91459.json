  "ingredients": [
    "0.875 cup all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1.5 cups white sugar",
    "0.75 cup butter, melted",
    "1.5 teaspoons vanilla extract",
    "3 eggs",
    "0.75 cup semisweet chocolate chips",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cocoa powder, baking powder, and salt in a bowl; set aside. Combine sugar, melted butter, and vanilla in a separate large bowl; stir in eggs until combined. Gradually stir in flour mixture just until blended; fold in chocolate chips and pecans. Transfer batter to the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges start to pull away from the sides of the pan and the top appears dry, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
