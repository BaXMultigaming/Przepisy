  "ingredients": [
    "1 bunch Swiss chard",
    "1 tablespoon salt",
    "2 tablespoons olive oil",
    "4 cloves garlic, coarsely chopped",
    "0.125 teaspoon crushed red pepper flakes",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Wash Swiss chard and cut into 1-inch strips. Separate the thick, tough stalk sections from the upper leafy strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 1 tablespoon salt to 1 cup water in a large saucepan; bring to a boil. Add stalks and cook for 2 minutes. Stir in leafy strips. Cook until stalks are fork-tender and leafy strips are wilted, about 6 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil, garlic, and red pepper flakes in a large skillet over medium heat until aromatic, about 3 minutes. Add drained Swiss chard; cook and stir for 2 minutes. Season with salt to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
