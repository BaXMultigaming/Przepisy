  "ingredients": [
    "4 cups all-purpose flour",
    "0.25 cup baking powder",
    "1.5 cups butter, cut into large chunks",
    "1.75 cups buttermilk",
    "8 ounces crumbled cooked bacon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly butter 2 muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and baking powder together in a large bowl; cut in butter until mixture resembles coarse crumbs. Stir buttermilk and bacon into flour mixture just until dough holds together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough onto a floured surface and roll into an even thickness. Fold dough over itself a few times. Cut dough into circles using a cookie or biscuit cutter and arrange circles in the prepared muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven on the top rack until biscuits are lightly browned, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
