  "ingredients": [
    "3 cups all-purpose flour",
    "1 tablespoon white sugar",
    "2 teaspoons baking powder",
    "1.25 teaspoons salt",
    "6 tablespoons ice water",
    "1 cup shortening"
  ],
  "steps": [
    {
      "text": "Whisk flour, sugar, baking powder, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer 1/2 cup flour mixture to a small bowl; stir in water until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut shortening into remaining flour mixture until it resembles coarse meal. Blend in wet flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into two pieces. Form each piece into a disk, wrap in plastic wrap, and refrigerate for at least 45 minutes or up to 3 days before using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
