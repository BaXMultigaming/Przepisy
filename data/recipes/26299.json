  "ingredients": [
    "1 (8 ounce) package spaghetti",
    "1 pound ground beef",
    "2.5 cups spaghetti sauce",
    "0.5 cup grated Parmesan cheese",
    "2 eggs, beaten",
    "3 slices processed American cheese",
    "1 (8 ounce) package shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place ground beef in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and combine with spaghetti sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl toss pasta with Parmesan cheese and eggs. Press into a 9-inch pie plate and spread sauce mixture over pasta. Top with American cheese and sprinkle with mozzarella.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes. Let stand 5 minutes before cutting into wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
