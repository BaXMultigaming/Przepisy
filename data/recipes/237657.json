  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup butter, softened",
    "5 tablespoons confectioners' sugar",
    "1 cup brown sugar",
    "2 eggs, beaten",
    "0.5 cup white sugar",
    "0.25 cup all-purpose flour",
    "0.75 teaspoon salt",
    "2 cups 1/4-inch slices rhubarb"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make crust: Mix together flour, butter, and confectioners' sugar in a bowl; pack firmly into the bottom of a 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust hardens slightly and is very fragrant, but not yet browned, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make filling: Whisk together brown sugar, eggs, white sugar, flour, and salt in a bowl until completely smooth; stir in rhubarb to coat. Pour rhubarb mixture over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven until rhubarb mixture sets, about 40 minutes. Cool at least 10 minutes before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
