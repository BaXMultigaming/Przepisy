  "ingredients": [
    "2 tablespoons coconut oil (such as British Class®)",
    "1 medium onion, diced",
    "1 small carrot, diced",
    "2 cloves garlic, minced",
    "0.5 cup uncooked medium shrimp, peeled and deveined",
    "0.5 cup diced ham",
    "4 cups cooked jasmine rice",
    "1 tablespoon soy sauce (such as Chinatown)",
    "salt and ground black pepper to taste",
    "ground black pepper",
    "1.5 cups diced pineapple",
    "1 small tomato, diced",
    "3 green onions, thinly sliced"
  ],
  "steps": [
    {
      "text": "Melt coconut oil in a large pan over medium-high heat. Add onion, carrot, and garlic; cook until tender, stirring occasionally, about 3 minutes. Add shrimp and ham; cook until shrimp are almost opaque and cooked through, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked rice and soy sauce; continue to cook and stir for 1 minute. Season with salt and pepper. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in pineapple, tomato, and green onions into fried rice until thoroughly combined. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
