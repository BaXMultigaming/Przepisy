    "4 thick cut boneless pork chops",
    "salt and pepper to taste",
    "10 ounces fresh mushrooms, sliced",
    "1 (14 ounce) can stewed tomatoes, with juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
