  "ingredients": [
    "1 medium egg, beaten",
    "0.5 cup all-purpose flour",
    "1 teaspoon seasoned salt",
    "1 teaspoon grill seasoning (such as Montreal Steak Seasoning®)",
    "2 (6 ounce) fillets bottom round cube steaks",
    "1 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Place beaten egg in a dish. Place flour in a separate dish. Add seasoned salt and Montreal steak seasoning to the flour and stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge each cube steak first in the beaten egg and then coat in the seasoned flour. Set aside on a plate while the oil heats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil to a bubble in a large skillet over medium-high heat. Add steaks and cook for 5 minutes. Using tongs, flip steaks over, and cook until brown, about 2 minutes more. Drain on a paper towel lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
