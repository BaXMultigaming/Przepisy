  "ingredients": [
    "3 (8 ounce) packages cream cheese, softened",
    "2 (4.5 ounce) cans deviled ham spread",
    "1 pound Colby cheese, shredded",
    "0.25 cup chopped green olives",
    "2 tablespoons prepared yellow mustard",
    "0.5 tablespoon chopped black olives",
    "0.5 teaspoon mustard powder",
    "0.5 teaspoon celery salt",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon garlic salt"
  ],
  "steps": [
    {
      "text": "In a medium bowl, stir together the cream cheese, deviled ham spread, shredded cheese, green olives, mustard, and black olives. Season with mustard powder, celery salt, cayenne pepper and garlic salt. Mix well, then cover and refrigerate at least 15 minutes before serving.",
