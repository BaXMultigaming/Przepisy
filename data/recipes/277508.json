  "ingredients": [
    "1.25 cups butter, softened",
    "1 cup white sugar",
    "1 cup brown sugar",
    "2 large eggs",
    "0.25 cup strong brewed coffee, cooled",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 (11 ounce) package caramel bits",
    "1 cup chilled mini marshmallows, cut in half"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 to 3 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, white sugar, and brown sugar together in a large bowl with an electric mixer. Add eggs, cooled coffee, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, and salt together in a small bowl. Incorporate slowly into egg mixture. Fold in caramel bits and marshmallow pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by heaping teaspoonfuls onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
