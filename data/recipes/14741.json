  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 pound boneless pork loin, cubed",
    "1 (16 ounce) can sauerkraut with juice",
    "1 apple, cored and chopped with peel"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add pork and brown on both sides. Add sauerkraut with juice, then add apple. Cook and stir until simmering; reduce the heat to low, cover, and simmer until pork is tender and no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C).",
