  "ingredients": [
    "1 pound seashell pasta",
    "0.5 pound Asiago cheese, diced",
    "0.25 pound Genoa salami, chopped",
    "0.25 pound pepperoni sausage, chopped",
    "3 medium tomatoes, chopped",
    "1 medium red bell pepper, diced",
    "1 medium green bell pepper, chopped",
    "1 (6 ounce) can black olives, drained and chopped",
    "1 (.7 ounce) package dry Italian-style salad dressing mix",
    "0.75 cup extra virgin olive oil",
    "0.25 cup balsamic vinegar",
    "2 tablespoons dried oregano",
    "1 tablespoon dried parsley",
    "1 tablespoon grated Parmesan cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rTscQVl8MwPo2PTZY3CXg-kkP-w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14278-antipasto-pasta-salad-VAT-step-01-5b70965439a442098c407970be0ba6e6.jpg"
      ],
      "image": "assets/images/14278/step_01.webp"
    },
    {
      "text": "Make the salad: Bring a large pot of salted water to a boil. Add shell pasta and cook, stirring occasionally, until tender yet firm to the bite, about 9 minutes. Drain, run under cold water to cool pasta, and drain again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5DW2xvZIKXy_A9guDf--a_8u36o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14278-antipasto-pasta-salad-VAT-step-02-96a3a132c6eb45ebbcfc952a3c6e0fe4.jpg"
      ],
      "image": "assets/images/14278/step_02.webp"
    },
    {
      "text": "Transfer drained pasta to a large bowl. Add Asiago, salami, pepperoni, tomatoes, bell peppers, and olives. Sprinkle dry dressing mix over top and stir until ingredients are thoroughly mixed. Cover and refrigerate for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JekSUcL2x4MXNtEG-fY4zS-dsMg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14278-antipasto-pasta-salad-VAT-step-03-811d3f60f40b4dbabb13751546fa2ab7.jpg"
      ],
      "image": "assets/images/14278/step_03.webp"
    },
    {
      "text": "Make the dressing: Whisk oil, vinegar, oregano, parsley, Parmesan, salt, and pepper together in a small bowl. Cover and set aside until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ogLdv1bBS9zcHeMQiGZ4I0Y2d1s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14278-antipasto-pasta-salad-VAT-step-04-9c6b8986f58f4d63b40b5403f40c1d75.jpg"
      ],
      "image": "assets/images/14278/step_04.webp"
    },
    {
      "text": "When ready to serve, pour dressing over chilled salad and mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rmoKRE1UOnl1ObgeqXijhwlWayU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14278-antipasto-pasta-salad-VAT-Beauty-4x3-182433bf5de44994987b2eed7cd8a25b.jpg"
      ],
      "image": "assets/images/14278/step_05.webp"
    }
