  "ingredients": [
    "3 tablespoons unsalted butter, melted",
    "7 ounces polenta",
    "0.5 cup all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 tablespoon white sugar",
    "1 teaspoon salt",
    "1.25 cups milk",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a baking dish with some of the melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine polenta, flour, baking powder, sugar, and salt in a bowl. Whisk milk, eggs, and remaining melted butter together in a second bowl. Add flour mixture and briefly stir batter until well combined. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 30 minutes.",
      "section": null,
