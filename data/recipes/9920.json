  ],
  "ingredients": [
    "1 cup shortening",
    "1 cup peanut butter",
    "1 cup packed brown sugar",
    "1.5 cups white sugar, divided",
    "2 large eggs",
    "0.25 cup milk",
    "2 teaspoons vanilla extract",
    "3.5 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "2 (9 ounce) bags milk chocolate candy kisses, unwrapped"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0a3nLMl1CSRTAXNu5rQv6vlBoDU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9920-peanut-blossoms-VAT-ingredients-4x3-069bb85c35bd4687a32872f5b9949641.jpg"
      ],
      "image": "assets/images/9920/step_01.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease or line cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat shortening, peanut butter, brown sugar, and 1 cup white sugar together in a large bowl with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H5lJFs8AIj1ZES2gukqs2uvHF1E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9920-peanut-blossoms-VAT-02-4x3-38ab7cf83592479eaec259dfbb3b2f3e.jpg"
      ],
      "image": "assets/images/9920/step_03.webp"
    },
    {
      "text": "Beat in eggs one at a time, then stir in milk and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2UpnNIEvQq2PPeBiVM3W5_8GP3w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9920-peanut-blossoms-VAT-04-4x3-993ab4314f854610acf02fcbee7ec149.jpg"
      ],
      "image": "assets/images/9920/step_04.webp"
    },
    {
      "text": "Combine flour, baking soda, and salt; stir into peanut butter mixture until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ayAt7vXtDEzPG4UWrrbltJ0Q7NM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9920-peanut-blossoms-VAT-05-4x3-68989bdccd66402fa8da45c47b070a8c.jpg"
      ],
      "image": "assets/images/9920/step_05.webp"
    },
    {
      "text": "Shape spoonfuls of dough into balls and roll in remaining 1/2 cup white sugar. Place cookies 2 inches apart on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XD_5wN9jZ9x1MACJiOBmQH1Lq2s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9920-peanut-blossoms-VAT-08-4x3-b637aa2caa4d4ab4a59c49f6a3d76505.jpg"
      ],
      "image": "assets/images/9920/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven for 10 to 12 minutes. Remove from the oven and immediately press a chocolate kiss into each cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y_xgOk5yOgaC39ZK2dGo0Td6BfU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9920-peanut-blossoms-VAT-10-4x3-c42bf34a7dd4442087d94c5ad7a65d0d.jpg"
      ],
      "image": "assets/images/9920/step_07.webp"
    },
    {
      "text": "Allow to cool completely; the kiss will harden as it cools.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g6PeY-B1CpW6nnMfenC-SUIgF7o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9920-peanut-blossoms-VAT-hero-4x3-e92f5e03faf54c99941806825da4e143.jpg"
      ],
      "image": "assets/images/9920/step_08.webp"
    }
