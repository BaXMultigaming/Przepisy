  "title": "Peanut Butter Blossoms",
  "description": "These peanut butter blossoms are baked for just 10 minutes then topped with a chocolate kiss for a crowd-pleasing treat perfect for holiday cookie trays.",
  "authors": [
    "Rosemarie Magee"
  ],
  "date_published": "1997-08-23T13:35:54-04:00",
