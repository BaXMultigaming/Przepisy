  "ingredients": [
    "1 pound ground beef",
    "1 (28 ounce) can crushed tomatoes, undrained",
    "1 (28 ounce) can diced tomatoes, undrained",
    "2 potatoes, peeled and cubed",
    "1 (15.25 ounce) can whole kernel corn, undrained",
    "1 yellow squash, sliced",
    "1 zucchini, sliced",
    "1 tablespoon seasoning salt",
    "1 tablespoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Cook ground beef in a large skillet over medium heat until evenly browned; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add crushed tomatoes with liquid, diced tomatoes with liquid, potatoes, corn with liquid, yellow squash, zucchini, seasoning salt, and black pepper to the skillet; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add enough water as needed to cover ingredients; bring to a boil. Reduce heat; simmer until potatoes are tender, about 20 minutes. Drain before serving.",
