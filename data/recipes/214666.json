  "steps": [
    {
      "text": "Stir together potato flakes, pancake mix, onion, Cheddar cheese, milk, egg, olive oil, garlic powder, salt, pepper, and cayenne pepper in a bowl until well combined.",
      "section": null,
      "name": null,
