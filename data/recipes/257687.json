  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "5 ounces sweetened yogurt",
    "2 teaspoons vanilla extract",
    "1.5 cups all-purpose flour",
    "1.75 teaspoons baking powder",
    "1 (.23 ounce) package powdered strawberry-lemonade mix",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a bowl using an electric mixer until smooth and creamy; beat in yogurt until smooth. Stir vanilla extract into mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and baking powder together in a separate bowl. Stir flour mixture into butter mixture; add lemonade mix and stir. Stir milk into batter until smooth; pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 30 to 40 minutes. Cool for 10 to 20 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
