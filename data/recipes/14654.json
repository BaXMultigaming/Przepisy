  "ingredients": [
    "0.25 cup shortening",
    "2 pounds lean beef chuck, trimmed and cut into 1 inch cubes",
    "1 cup chopped onion",
    "1 clove garlic, minced",
    "0.75 cup ketchup",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon brown sugar",
    "2 teaspoons salt",
    "0.5 teaspoon mustard powder",
    "2 teaspoons paprika",
    "1.5 cups water",
    "2 tablespoons all-purpose flour",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Melt shortening in large skillet over medium high heat. Add meat, onion, and garlic; cook and stir until meat is browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in ketchup, Worcestershire sauce, brown sugar, salt, paprika, mustard and 1 1/2 cup water. Reduce heat, cover, and simmer 2 to 2 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend flour and 1/4 cup water. Stir into meat. Heat to boiling, stirring constantly. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
