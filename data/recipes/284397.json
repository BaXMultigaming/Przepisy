  "ingredients": [
    "2 tablespoons soy sauce",
    "2 tablespoons sake",
    "1 tablespoon vegetable oil",
    "0.5 teaspoon minced fresh ginger",
    "0.5 teaspoon minced fresh garlic",
    "0.5 pound chicken breast, cut into bite-sized pieces",
    "1 cup oil for frying, or as needed",
    "3 tablespoons all-purpose flour",
    "3 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Combine soy sauce, sake, oil, ginger, and garlic in a bowl and whisk to combine. Add chicken pieces and mix well with the marinade. Marinate at room temperature for 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and cornstarch on a plate. Coat marinated chicken with flour-cornstarch mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry chicken pieces in batches until lightly browned, about 3 minutes. Remove from the hot oil, transfer to a wire rack, and allow to rest for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase heat until oil is 375 degrees F (190 degrees C). Fry chicken pieces for another 1 to 2 minutes in the hot oil until very crisp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
