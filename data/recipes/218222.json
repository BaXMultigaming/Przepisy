  "ingredients": [
    "2 tablespoons spicy horseradish mustard",
    "1 (4 pound) boneless pork loin roast",
    "1 onion, chopped",
    "1 Granny Smith apple, chopped",
    "1 (16 ounce) can sauerkraut with juice",
    "salt and pepper to taste",
    "1.5 cups chicken broth"
  ],
  "steps": [
    {
      "text": "Rub horseradish mustard all over pork loin. Layer onion and apple in a slow cooker and set pork loin on top. Pour in sauerkraut and its juices. Season with salt and pepper, then add chicken broth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until pork is very tender, 6 to 8 hours. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C).",
