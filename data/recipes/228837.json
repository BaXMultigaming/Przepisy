  "ingredients": [
    "butter-flavored cooking spray",
    "2 cups all-purpose flour",
    "0.5 cup confectioners' sugar",
    "1 cup cold butter",
    "1 (8 ounce) package cream cheese, softened",
    "0.33333334326744 cup white sugar",
    "1 teaspoon almond extract",
    "2 cups sliced fresh strawberries",
    "1 cup fresh blueberries",
    "1 kiwi, peeled and sliced",
    "1 cup unsweetened pineapple juice",
    "0.5 cup white sugar",
    "2 tablespoons cornstarch",
    "1 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly spray a 12-inch round pizza pan with butter-flavored cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and confectioners' sugar in a bowl. Cut in butter with a knife or pastry blender until the mixture resembles coarse crumbs. Press into the prepared pizza pan to make a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until very lightly browned, 12 to 15 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, 1/3 cup white sugar, and almond extract until smooth; spread over completely cooled crust. Arrange strawberries, blueberries, and kiwi decoratively over cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pineapple juice, 1/2 cup white sugar, cornstarch, and lemon juice in a saucepan until smooth; bring to a boil. Cook and stir until thickened, about 2 minutes. Cool slightly and drizzle over fruit. Refrigerate until chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
