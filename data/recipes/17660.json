  "ingredients": [
    "1 whole orange, with peel",
    "1 cup raisins",
    "0.33333298563957 cup chopped walnuts",
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "1 cup milk",
    "0.5 cup shortening",
    "2 eggs",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.33333298563957 cup white sugar",
    "0.25 cup finely chopped walnuts",
    "1 teaspoon ground cinnamon",
    "1 orange, sliced in rounds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut whole orange in half; squeeze orange and reserve 1/3 cup juice. Grind together orange peel and pulp, raisins, and 1/3 cup walnuts in a food processor. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend together flour, 1 cup sugar, milk, shortening, eggs, baking soda, and salt in a large bowl with an electric mixer on medium speed for 3 minutes. Stir in orange-raisin mixture until incorporated. Pour into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, 35 to 40 minute. Remove cake from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle reserved 1/3 cup orange juice over warm cake. Mix together 1/3 cup sugar, 1/4 cup walnuts, and cinnamon in a small bowl until well combined; sprinkle over cake. Garnish with orange slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
