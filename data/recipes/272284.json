  "ingredients": [
    "0.125 cup lime juice",
    "0.125 cup soy sauce",
    "3 cloves garlic, minced",
    "1.5 tablespoons tamarind paste",
    "1 tablespoon sugar",
    "1 tablespoon sambal oelek",
    "1 pound pork loin"
  ],
  "steps": [
    {
      "text": "Whisk lime juice, soy sauce, garlic, tamarind paste, sugar, and sambal oelek together in a bowl. Whisk marinade for 1 minute; pour into a resealable plastic bag. Poke pork tenderloin with a fork or knife. Add to the bag, coat with. marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 8 hours to overnight (for best results).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high, indirect heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pork loin from marinade and shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sear on the preheated grill over direct heat, 1 to 3 minutes per side; move to indirect heat until cooked through, 20 to 30 minutes more, depending on thickness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
