  "ingredients": [
    "2 pounds kielbasa sausage, cut into 1 inch pieces",
    "1 onion, chopped",
    "0.66670000553131 cup water",
    "0.5 cup brown sugar",
    "0.33329999446869 cup Worcestershire sauce",
    "1 tablespoon fresh lemon juice",
    "2 dashes hot pepper sauce"
  ],
  "steps": [
    {
      "text": "Place sausage in a large saucepan with enough water to cover; simmer over low heat for 1 hour. Drain. Transfer sausage to a 9x13-inch baking dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onion, 2/3 cup water, brown sugar, Worcestershire sauce, lemon juice, and hot pepper sauce in same saucepan; bring to a boil, stirring. Pour over sausage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
