  "ingredients": [
    "1 (12 ounce) package fresh cranberries, rinsed and sorted",
    "2 large Granny Smith apples - peeled, cored, and diced",
    "1 cup water",
    "1 cup white sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Place cranberries, apples, water, sugar, and cinnamon in a medium saucepan over medium heat; bring to a boil.",
