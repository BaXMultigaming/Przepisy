  "ingredients": [
    "1 cooking spray",
    "2 tablespoons canola oil",
    "1 cup chopped carrots",
    "1 cup chopped onions",
    "1 cup chopped celery",
    "1 pound ground beef",
    "4 tablespoons butter",
    "3 tablespoons all-purpose flour",
    "2 cups beef broth",
    "1.5 teaspoons garlic salt",
    "1 teaspoon onion powder",
    "1 teaspoon garlic powder",
    "0.25 teaspoon ground black pepper",
    "3 cups baking mix",
    "1 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly coat a baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a sauté pan over medium-high heat. Add carrots, onions, and celery; sauté until onions translucent, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat a large skillet over medium-high heat. Add ground beef; cook and stir until browned and crumbly, 5 to 7 minutes. Drain; discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Move beef to one side of skillet; add butter and melt over medium heat. Whisk in flour, a little at a time until combined. Whisk in beef broth. Add sautéed vegetables, garlic salt, onion powder, garlic powder, and black pepper. Bring to a boil; cover and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, add baking mix to a bowl; stir in buttermilk until a soft dough forms. Transfer dough to a piece of waxed paper; roll to 1/2-inch thickness. Cut out biscuits with a 2 ½-inch round biscuit cutter dipped in baking mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour beef mixture into prepared baking dish; top with biscuits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until biscuits browned, 24 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
