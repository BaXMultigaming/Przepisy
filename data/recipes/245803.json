  "ingredients": [
    "0.5 cup white sugar",
    "3 tablespoons unsweetened cocoa powder",
    "2 tablespoons cornstarch",
    "0.125 teaspoon salt",
    "2.75 cups milk",
    "1 tablespoon tahini",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Mix sugar, cocoa powder, cornstarch, and salt together in a saucepan. Stir in milk. Bring to a boil over medium heat and cook, stirring constantly, until mixture thickens and coats the back of a spoon, about 5 minutes. Remove from heat. Add tahini and vanilla extract; stir well.",
