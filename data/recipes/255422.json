    "2 pounds fresh green beans, trimmed",
    "1 cup water",
    "0.25 teaspoon onion salt",
    "1 (9.74 ounce) package Idahoan Signature™ Russets Mashed Potatoes"
  ],
  "steps": [
    {
      "text": "Place cured venison, beans, water, and onion salt in slow cooker. Cook on low setting 3 1/2 hours.",
