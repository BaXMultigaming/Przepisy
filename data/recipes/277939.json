  "ingredients": [
    "1.5 cups gluten-free flour blend (such as Namaste®)",
    "1 cup gluten-free quick-cooking oats",
    "0.25 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 egg",
    "1 cup milk",
    "0.33333334326744 cup applesauce",
    "0.5 teaspoon vanilla extract",
    "1 cup mashed banana"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 12-cup muffin tin with parchment baking cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, oats, sugar, baking powder, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg lightly in a large bowl. Stir in milk, applesauce, and vanilla extract. Add mashed banana and combine thoroughly. Stir flour mixture into the banana mixture until just combined. Divide batter evenly between the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
