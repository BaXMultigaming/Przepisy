  "ingredients": [
    "1 cup water",
    "0.25 cup white vinegar",
    "3 tablespoons white sugar",
    "0.5 cup sliced seedless cucumber",
    "0.5 cup sliced red onion",
    "0.25 head romaine lettuce, chopped",
    "2 cups baby arugula",
    "3.5 tablespoons olive oil",
    "1.5 tablespoons balsamic vinegar",
    "salt and ground black pepper to taste",
    "0.5 cup red seedless grapes, halved"
  ],
  "steps": [
    {
      "text": "Whisk water, white vinegar, and sugar together in a bowl until sugar has dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cucumber and onion into the vinegar mixture; cover and refrigerate for 3 hours. Drain vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss romaine lettuce and arugula with olive oil and balsamic vinegar in a large bowl. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide salad on 2 plates and scatter cucumber mixture and grapes on top to serve.",
