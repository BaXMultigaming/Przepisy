  "ingredients": [
    "1 (14.75 ounce) can red salmon, skin and bone removed, drained and flaked",
    "2 eggs",
    "0.5 lemon, juiced",
    "1 tablespoon chopped capers",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon cayenne pepper",
    "12 saltine crackers",
    "1 tablespoon bread crumbs, or as needed",
    "1 tablespoon butter",
    "1 tablespoon olive oil"
  ],
  "steps": [
    {
      "text": "Stir salmon, eggs, lemon juice, capers, salt, black pepper, and cayenne pepper together in a bowl until well-combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crush saltine crackers with your hands into the salmon mixture and mix well. Wrap the bowl with plastic wrap and refrigerate, 30 minutes to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dust a plate with half the bread crumbs. Divide salmon mixture into 4 portions and shape into patties; place onto prepared plate and sprinkle remaining bread crumbs atop the salmon patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter and oil in a large skillet over medium heat. Cook patties in hot oil until cooked and heated through, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
