  "title": "Banana Flips",
  "description": "Banana flip cake with two moist layers of cake surrounding a light and fluffy banana cream filling.",
  "authors": [
    "Erin Walczak"
  ],
  "date_published": "1999-12-29T14:57:12-05:00",
