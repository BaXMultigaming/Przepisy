  "ingredients": [
    "4 skinless, boneless chicken breasts",
    "2 cups corn oil",
    "1 egg, beaten",
    "0.33333334326744 cup water",
    "0.33333334326744 cup all-purpose flour",
    "1.5 tablespoons sesame seeds, toasted",
    "1.5 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Rinse chicken with cold water and pat dry with paper towels. Cut into 1x1x1/2 inch pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a deep fryer with corn oil, no more than 1/3 full. Heat to medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place egg and water in a small bowl and mix well. Add the flour, sesame seeds and salt, stirring until a smooth batter is formed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken pieces in batter and drain off any excess. Add battered chicken, a few pieces at a time, to the hot oil. Fry about 4 minutes or until golden brown and done (remove chicken from oil to test). Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
