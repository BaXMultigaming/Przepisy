  "ingredients": [
    "0.5 cup whole milk",
    "0.5 cup half-and-half cream",
    "2 tablespoons white sugar",
    "2 teaspoons lemon extract",
    "0.5 teaspoon ground cinnamon",
    "1 cup frozen blueberries",
    "12 vanilla wafers",
    "ice cubes as desired"
  ],
  "steps": [
    {
      "text": "Blend milk, half-and-half, sugar, lemon extract, and cinnamon in a blender; add blueberries and blend until thick and smooth. Blend vanilla wafers and ice cubes into milk mixture until desired consistency is reached.",
