  "ingredients": [
    "48 (2 inch) unbaked tart shells",
    "2 cups brown sugar",
    "0.66666668653488 cup butter, softened",
    "2 eggs",
    "3 tablespoons heavy cream",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place tart shells on a baking tray.",
      "section": null,
