  "ingredients": [
    "1 pound ground beef (80% lean)",
    "0.25 cup water",
    "1 tablespoon chili powder",
    "1 teaspoon ground cayenne pepper",
    "salt and ground black pepper to taste",
    "1 (14.5 ounce) package tortilla chips",
    "1 (12 ounce) jar pickled jalapeno pepper slices",
    "1 (4 ounce) can sliced black olives",
    "2 cups shredded Cheddar cheese",
    "1 (8 ounce) container sour cream",
    "1 cup salsa"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a sheet pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MUZnzq0_DRLStumWxetWXTFBIRE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-269484-sheet-pan-nachos-VAT-step-01-16097a784c4f4100b4b9d30ae163469d.jpg"
      ],
      "image": "assets/images/269484/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Mix in water, chili powder, cayenne, salt, and pepper until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JmRnlb0JKD5pnTphp5WseFIC1OQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-269484-sheet-pan-nachos-VAT-step-02-7e900b0d71e44089a4306cf4e7766b5c.jpg"
      ],
      "image": "assets/images/269484/step_02.webp"
    },
    {
      "text": "Lay out tortilla chips on the prepared sheet pan. Top with ground beef mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B2-Rew5eDGK4uPfLEpjJPLHsBTY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-269484-sheet-pan-nachos-VAT-step-03-f938ed84407249dd9eb1f67d7ac1e143.jpg"
      ],
      "image": "assets/images/269484/step_03.webp"
    },
    {
      "text": "Cover with jalapeño slices and olives. Sprinkle with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CHd6RsPsuifh-N6q0q1l4fyCsv8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-269484-sheet-pan-nachos-VAT-step-04-c15ef8ff992e486dbd729f37bc55fa77.jpg"
      ],
      "image": "assets/images/269484/step_04.webp"
    },
    {
      "text": "Cook under the preheated broiler until cheese is bubbly and golden brown, 3 to 5 minutes. Serve with sour cream and salsa for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5f0GgZv3DNwfbr7lVXevMpMcsYA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-269484-sheet-pan-nachos-VAT-step-05-1nosaucesinframe-c275e15d25054086892862431deff8f1.jpg"
