  "ingredients": [
    "0.5 (8 ounce) package cream cheese",
    "0.5 cup white sugar",
    "1 tablespoon butter",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "2 (8 ounce) packages refrigerated crescent rolls"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 370 degrees F (190 degrees C) for 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whip cream cheese, sugar, butter, vanilla, and cinnamon together in a small bowl with an electric mixer. Transfer mixture to a piping bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out crescent sheets on a clean work surface. Mark 2-inch increments lengthwise and widthwise with a ruler, making small squares. Pipe 1 to 2 tablespoons cream cheese filling into each square.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully lay remaining crescent sheet on top. Press dough around the filling. Use a pizza cutter to cut out the squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce air fry temperature to 340 degrees F (171 degrees C) and place a parchment round in the bottom of the air fryer basket. Place cheese cake bites into the basket and air fry for 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
