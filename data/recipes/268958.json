  "ingredients": [
    "cooking spray",
    "1 pound extra-lean ground beef",
    "0.5 cup Italian-seasoned bread crumbs",
    "0.33333334326744 cup finely chopped onion",
    "0.33333334326744 cup Worcestershire sauce",
    "0.25 cup ketchup, divided",
    "2 egg whites",
    "1.5 tablespoons brown sugar",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a loaf pan lightly with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix beef, bread crumbs, onion, Worcestershire sauce, 2 tablespoons ketchup, egg whites, brown sugar, salt, and pepper together in a bowl until well combined. Press into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, uncovered, until no longer pink in the center, about 45 minutes. Spread the remaining ketchup over the top and continue baking until it bubbles and thickens, about 15 minutes more. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
