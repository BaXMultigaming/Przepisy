  "ingredients": [
    "8 ounces baby carrots",
    "8 ounces Brussels sprouts, halved lengthwise",
    "1 small red onion, peeled and cut into 8 wedges",
    "3 tablespoons olive oil",
    "2 teaspoons chopped fresh rosemary",
    "1 teaspoon kosher salt",
    "0.5 teaspoon black pepper",
    "1 (12 ounce) package Hillshire Farm® Rope Smoked Sausage, cut in 1/2\" bias-cut slices",
    "1 medium Honeycrisp apple, cut into 12 wedges",
    "1 lemon, halved",
    "2 tablespoons chopped parsley"
  ],
  "steps": [
    {
      "text": "Place a large baking pan in the oven. Preheat the oven to 450 degrees F (232 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss together carrots, Brussels sprouts, onion, olive oil, rosemary, salt, and pepper in a large bowl until combined. Arrange vegetable mixture and sausage in a single layer on the preheated pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until just tender, about 20 minutes. Remove from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the broiler to high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add apple to the pan; broil until apple is tender and vegetables are slightly caramelized, 5 to 6 minutes. Remove from the oven, squeeze lemon over vegetable mixture in the pan, and sprinkle with parsley.",
      "section": null,
      "name": null,
      "url": null,
