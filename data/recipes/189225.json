  "ingredients": [
    "2 hamburger buns, split and cut into 3/4 inch strips*",
    "1 pound lean ground beef",
    "1 small red onion",
    "1 cup ketchup",
    "0.5 cup finely chopped dill pickle",
    "1 tablespoon prepared yellow mustard",
    "8 cups chopped lettuce",
    "2 plum tomatoes, chopped",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bun strips in a single layer on a baking sheet. Bake in the preheated oven until lightly toasted, 8 to 10 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook ground beef in a skillet over medium heat, breaking it apart as it cooks, until no longer pink, 10 to 12 minutes. Add chopped onion, ketchup, pickle, and mustard; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange lettuce on a large serving platter; spoon beef mixture over top. Top with sliced onion, tomatoes, and cheese; arrange bun croutons around platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
