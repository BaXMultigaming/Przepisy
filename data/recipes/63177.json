  "ingredients": [
    "0.25 cup red wine vinegar",
    "0.25 cup olive oil",
    "1 teaspoon sugar",
    "0.25 teaspoon dried cilantro",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon dried tarragon",
    "1 (15 ounce) can white kidney beans, drained and rinsed",
    "1 roma (plum) tomato, diced",
    "0.25 red onion, diced",
    "0.75 pound cooked tiny shrimp"
  ],
  "steps": [
    {
      "text": "In a small bowl, whisk vinegar, oil, sugar, cilantro, basil, and tarragon until well blended. You may adjust these seasonings to your personal preference.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, toss together the beans, tomato, onion, and shrimp. Pour dressing over salad, and toss again to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate several hours, or overnight, to develop flavors.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
