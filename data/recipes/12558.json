  "ingredients": [
    "3 cups all-purpose flour",
    "1 teaspoon salt",
    "1.25 cups shortening",
    "1 egg, beaten",
    "1 tablespoon distilled white vinegar",
    "4 tablespoons water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl mix flour and salt. Cut in shortening with two butter knives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, mix together egg, vinegar, and water. Drizzle wet mixture into dry mixture, cutting it in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out dough, and fit into two 9-inch pie pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
