  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "2 eggs, beaten",
    "0.5 cup white sugar",
    "24 chocolate sandwich cookies (such as Oreo®)"
  ],
  "steps": [
    {
      "text": "Move the oven rack to the middle tier and preheat the oven to 350 degrees F (175 degrees C). Line 24 mini-muffin cups with miniature paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, eggs, and sugar together in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put 1 cookie into the bottom of each paper liner. Spoon cream cheese mixture atop cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until nearly set in the middle, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Move tins to a wire rack to cool slightly before refrigerating until cheesecake layer sets firmly, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
