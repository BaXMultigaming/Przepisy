  "ingredients": [
    "0.25 cup lime juice",
    "2 tablespoons white vinegar",
    "0.5 bunch cilantro, chopped",
    "1 tablespoon brown sugar",
    "1 clove garlic, minced",
    "0.25 teaspoon salt",
    "0.75 teaspoon spicy brown mustard",
    "0.75 cup light olive oil"
  ],
  "steps": [
    {
      "text": "Blend the lime juice, vinegar, and cilantro together in a blender until smooth. Add the brown sugar, garlic, and salt; blend again until smooth. Spoon the mustard into the mixture. Turn the blender on and slowly pour the olive oil into the dressing mixture in a thin stream; blend until thoroughly combined.",
