  "ingredients": [
    "1 cup all-purpose flour",
    "1 tablespoon white sugar",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 egg, beaten",
    "1 cup milk",
    "2 tablespoons vegetable oil",
    "2 ripe bananas, mashed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3qV5O6VirE3YZN120XqxVOZBoX0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20334-banana-pancakes-i-ddmfs-3233-4x3-step-01-654df5dc5fca4bf3a8aebb5d5c4bef44.jpg"
      ],
      "image": "assets/images/20334/step_01.webp"
    },
    {
      "text": "Combine flour, white sugar, baking powder, and salt in a bowl. Mix together egg, milk, vegetable oil, and bananas in a second bowl. Stir flour mixture into banana mixture; batter will be slightly lumpy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KG5KXGE2oG4XGzqqTw5fYB-X6pM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20334-BananaPancakes-mfs_-Step03-65e57ab9c8694032ba2b4fea6137ce60.jpg"
      ],
      "image": "assets/images/20334/step_02.webp"
    },
    {
      "text": "Heat a lightly oiled griddle or frying pan over medium high heat. Pour or scoop the batter onto the griddle, using approximately 1/4 cup for each pancake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hXdydHj7GtdzqfNJ4U9NeLelrTA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20334-BananaPancakes-mfs_-Step04-ca48d173d21d45a39b2111a70e27ba50.jpg"
      ],
      "image": "assets/images/20334/step_03.webp"
    },
    {
      "text": "Cook until pancakes are golden brown, 3 to 5 minutes per side. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2dAp0iWY6GH7-8ySUAFKbkDo4hc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20334-BananaPancakes-mfs_-Step05-6d64d8f0752447058a12391b4e3a38bf.jpg"
