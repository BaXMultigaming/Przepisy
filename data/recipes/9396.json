  "ingredients": [
    "1.25 cups all-purpose flour",
    "0.5 cup cornstarch",
    "10 tablespoons butter, softened",
    "0.25 cup confectioners' sugar",
    "2 tablespoons white sugar",
    "0.25 teaspoon salt",
    "0.5 teaspoon vanilla extract",
    "1 cup mini semi-sweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour and cornstarch; set aside. Cream butter until smooth, then add white sugar, confectioner's sugar, vanilla, and salt; beat until fluffy. Slowly add flour mixture to butter mixture, beating on low until dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a floured surface, knead in 1/2 cup chocolate chips. Shape dough into two equal parts, pat each into a 6 inch round, and transfer to baking sheet. Cut into wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25 minutes. Remove immediately to cool on wire rack. Melt remaining chips and drizzle over wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
