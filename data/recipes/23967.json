  "ingredients": [
    "1 tablespoon olive oil",
    "1 onion, chopped",
    "1 clove garlic, chopped",
    "1 (14.5 ounce) can peeled and diced tomatoes",
    "1 (8 ounce) can tomato sauce",
    "1 teaspoon white sugar",
    "0.5 teaspoon dried oregano",
    "0.25 teaspoon salt"
