  "ingredients": [
    "0.33 cup butter",
    "0.5 large onion, minced",
    "1 bunch green onions, chopped",
    "0.5 green bell pepper, chopped",
    "1 stalk celery, minced",
    "3 cloves garlic, minced",
    "1 pound crabmeat, shredded",
    "0.25 teaspoon Cajun seasoning",
    "0.5 cup dry bread crumbs",
    "salt and pepper to taste",
    "2 tablespoons butter, softened",
    "4 pounds whole flounder - cleaned, rinsed and dried"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a large casserole dish or a baking sheet lined with tin foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter over medium-low heat in a large saucepan. Stir in onion, green onions, bell pepper, celery, and garlic. Cook slowly, occasionally stirring until onions are soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pan from heat and stir in shredded crabmeat, seasoning, bread crumbs, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub flounder skin and cavity with butter. Stuff with crab mixture and place in prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes, or until flesh is firm and white at the thickest part of fish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
