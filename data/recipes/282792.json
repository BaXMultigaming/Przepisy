  "ingredients": [
    "cooking spray",
    "2 (15.5 ounce) cans pinto beans, drained",
    "1.5 cups chopped, cooked chicken",
    "1 (11 ounce) can Mexican-style corn (such as Green Giant®), drained",
    "1 (10 ounce) can diced tomatoes and green chiles (such as RO*TEL®), undrained",
    "1 (8 ounce) can tomato sauce",
    "1 teaspoon dried minced onion",
    "1 teaspoon ground cumin",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "ground black pepper to taste",
    "1.5 cups corn chips (such as Fritos®)",
    "2 cups shredded Colby-Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a large casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pinto beans, chicken, corn, diced tomatoes and green chiles, tomato sauce, onion, cumin, garlic powder, salt, and black pepper in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread corn chips in the prepared casserole dish; spread bean mixture over top. Sprinkle with Colby-Jack cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese melts and casserole is heated through, about 25 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
