  "ingredients": [
    "3 cups gemelli pasta, uncooked",
    "1 (5 ounce) can evaporated milk",
    "1 cup Hidden Valley® Original Ranch® Salad Dressing",
    "2 eggs, slightly beaten",
    "3 cups grated Asiago cheese",
    "0.5 cup unseasoned bread crumbs",
    "2 tablespoons unsalted butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook pasta according to package directions. Rinse and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, whisk evaporated milk, dressing and eggs together until smooth. Fold in the cheese. Add the cooked pasta and mix well. Spoon pasta mixture into an oiled 1 1/2-quart casserole. In a bowl, combine bread crumbs and melted butter. Sprinkle on top of pasta. Bake for 20 to 25 minutes until the top is nicely browned and heated through.",
