  "ingredients": [
    "0.25 cup coarse-grain mustard",
    "0.25 cup Greek yogurt",
    "1 teaspoon garlic powder",
    "1 pinch cayenne pepper",
    "2 eggs, beaten",
    "2 cups instant mashed potato flakes",
    "4 hard-boiled eggs, peeled",
    "1 (15 ounce) can HORMEL® Mary Kitchen® Corned Beef Hash",
    "2 quarts vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Mix whole grain mustard, Greek yogurt, garlic powder, and cayenne pepper in a small bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 2 beaten eggs into a shallow dish; place potato flakes in a separate shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide corned beef hash into 4 portions. Form corned beef hash around each egg until the egg is completely encased.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll encased eggs into the beaten egg and coat with mashed potato flakes until covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop 2 eggs into the hot oil and fry until brown, 3 to 5 minutes. Remove with a slotted spoon and place on a paper towel-lined plate. Repeat with remaining 2 eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut the lengthwise and serve with mustard sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
