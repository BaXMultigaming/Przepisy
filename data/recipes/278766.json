  "ingredients": [
    "1 (8 ounce) slice feta cheese",
    "0.5 cup all-purpose flour",
    "1 egg, beaten",
    "0.5 cup sesame seeds",
    "1 pinch ground black pepper to taste",
    "0.25 cup olive oil",
    "2 tablespoons honey, or more to taste"
  ],
  "steps": [
    {
      "text": "Slice feta into four fingers and place in the freezer for 10 minutes to help the cheese hold its shape while you prepare the other ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set out egg, flour, and sesame seeds in three separate shallow dishes. Season egg with black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour oil into a small skillet to a depth of about 1/2-inch. Heat over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove feta from freezer and dredge each finger first in egg, then flour, egg again, followed by sesame seeds. Evenly coat all sides. Add breaded fingers to the hot oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until golden brown, about 2 minutes per side. Remove from oil and briefly drain excess oil on kitchen towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place feta fingers on a serving plate and drizzle with honey. Enjoy immediately while hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
