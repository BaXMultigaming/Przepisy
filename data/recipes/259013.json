  "ingredients": [
    "cooking spray",
    "2 cups white sugar",
    "3 eggs",
    "1 cup vegetable oil",
    "1 cup whole milk",
    "2 cups all-purpose flour",
    "2 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 cups mashed fig preserves",
    "1 cup pecan pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 12-cup fluted tube pan (such as Bundt) with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and eggs in a large bowl with an electric mixer until sugar dissolves; stir in oil. Add milk; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cinnamon, baking soda, and salt in a separate bowl; beat into egg mixture until blended. Fold in fig preserves and pecan pieces until incorporated. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour. Cool in the pan for 10 minutes, then invert onto a wire rack to cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
