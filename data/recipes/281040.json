  "title": "Air Fryer Chicken Tenders",
  "description": "These air fryer chicken tenders are dipped in egg, then coated in a seasoned flour of paprika, salt, pepper, and parsley for a flavorful crisp coating.",
  "authors": [
    "Soup Loving Nicole"
  ],
  "date_published": "2020-07-25T21:26:49-04:00",
