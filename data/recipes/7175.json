  "ingredients": [
    "1.75 cups all-purpose flour",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "0.75 cup white sugar",
    "0.5 cup lowfat cream cheese",
    "2 eggs",
    "0.75 cup mashed bananas",
    "0.25 cup brewed chai tea"
  ],
  "steps": [
    {
      "text": "In a medium bowl mix together flour, baking powder, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl mix sugar, cream cheese, and eggs until light and fluffy. Mix mashed bananas and Chai into cream cheese mixture. Add flour mixture and mix until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into a greased 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 350 degree F(175 degrees C) oven for 60 minutes. Cool on rack. Remove from pan after 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
