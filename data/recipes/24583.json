  "ingredients": [
    "1 (8 ounce) package shredded Cheddar cheese",
    "2 cups mayonnaise",
    "2 cups chopped sweet onion",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Lightly grease a 1 quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix Cheddar cheese, mayonnaise and sweet onion. Transfer to the baking dish and sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 40 to 45 minutes, or until onions are tender and the mixture is bubbly and lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
