  "ingredients": [
    "2 acorn squash, halved and seeded",
    "1 pinch ground cinnamon",
    "0.25 cup butter",
    "2 teaspoons salt",
    "1 pinch brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
