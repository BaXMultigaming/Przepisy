    },
    {
      "text": "Place acorn squash, cut-sides down, on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Flip squash, sprinkle cinnamon into centers, and dot with butter. Continue baking until flesh can easily be pierced with a fork, about 30 minutes more.",
