  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "2 (10 ounce) packages frozen chopped broccoli",
    "1 tablespoon butter",
    "1 bunch celery, chopped",
    "1 large onion, chopped",
    "2 cloves garlic, minced",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "1.25 cups water",
    "8 ounces Muenster",
    "2 teaspoons Dijon mustard",
    "1/2 teaspoon paprika",
    "salt and pepper to taste",
    "3 cups instant rice",
    "1/2 cup panko bread crumbs"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 3-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ld-9rcnxi5W5sF9ccxNMrHfSk18=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18253-Broccoli-Rice-Casserole-DDMFS-step1-3x4-5504-1ec2f2b52ed845d8b39c78bc79efb76a.jpg"
      ],
      "image": "assets/images/18253/step_01.webp"
    },
    {
      "text": "Place broccoli and 2 tablespoons water in a large microwave-safe bowl; cover with plastic wrap and microwave on high for 5 minutes, stirring once. Drain; transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V-QBRb2cOMBz6GwD7KCXFpWRRQM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18253-Broccoli-Rice-Casserole-DDMFS-step2-3x4-5506-87f99f6839c341f3964f11294a514a9e.jpg"
      ],
      "image": "assets/images/18253/step_02.webp"
    },
    {
      "text": "Meanwhile, melt 1 tablespoon butter in a large skillet over medium heat. Add celery, onion, and garlic; cook and stir until tender, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xMl2w-6QXAQNiyzr6q1TzXusPQY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18253-Broccoli-Rice-Casserole-DDMFS-step3-3x4-5511-1f9bbbe95ee44119b890ee87a10be9a0.jpg"
      ],
      "image": "assets/images/18253/step_03.webp"
    },
    {
      "text": "Stir in condensed soups and milk; heat through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5zro5OPoE9HgNhDYb6qx8G8cJmw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18253-Broccoli-Rice-Casserole-DDMFS-step4-3x4-5515-94d44e0747dc42baab69877608c4b893.jpg"
      ],
      "image": "assets/images/18253/step_04.webp"
    },
    {
      "text": "Stir cooked vegetable-soup mixture into broccoli.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e4g3aLhfpZ6Wu2t_jHetJpas360=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18253-Broccoli-Rice-Casserole-DDMFS-step5-3x4-5518-c8266aec8e044390ac21734fef01eb31.jpg"
      ],
      "image": "assets/images/18253/step_05.webp"
    },
    {
      "text": "Stir in shredded cheese, mustard, paprika, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-ZSNgJDHn81m7f4BGU_p7fYQRcE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18253-Broccoli-Rice-Casserole-DDMFS-step6-3x4-5520-eac814bfd5cb44518cef1da188891fc3.jpg"
      ],
      "image": "assets/images/18253/step_06.webp"
    },
    {
      "text": "Stir in rice until combined. Transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O7msSJbpbBnIs1pRAwk0UUYlU7Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18253-Broccoli-Rice-Casserole-DDMFS-step7-3x4-5523-73373d45ea044011b504f733412464ba.jpg"
      ],
      "image": "assets/images/18253/step_07.webp"
    },
    {
      "text": "Combine panko with remaining 1 tablespoon melted butter; sprinkle on top casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eHG8cfKbaQfQAsKEQQj1tVbnbFY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18253-Broccoli-Rice-Casserole-DDMFS-step8-3x4-5525-0b2c239e388d42478d4382d5582d0da8.jpg"
      ],
      "image": "assets/images/18253/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven until browned and bubbly, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AElzVMKARVwpk7ggvwECabBE06s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18253-Broccoli-Rice-Casserole-DDMFS-step9-3x4-5560-8770dd136051463ea1f5e367924b0202.jpg"
      ],
      "image": "assets/images/18253/step_09.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zanF-V9l_beplkDqEZlD_3ayDAc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18253-broccoli-rice-casserole-FranceCevallos-Horizontal-4x3-6da0f30657ca424fb2d13e5d72293c7f.jpg"
      ],
      "image": "assets/images/18253/step_10.webp"
    }
