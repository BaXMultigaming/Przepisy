  "title": "Broccoli Rice Casserole",
  "description": "This comforting broccoli rice casserole combines broccoli, rice, and a creamy cheese sauce, topped with crispy panko, baked until golden and bubbly.",
  "authors": [
    "GMW"
  ],
  "date_published": "2000-05-27T17:27:43-04:00",
  "date_modified": "2026-03-18T20:12:26-04:00",
