  "ingredients": [
    "1 pound smoked beef sausage, cut into bite-size pieces",
    "1 small onion, chopped",
    "3 (15 ounce) cans black-eyed peas, rinsed and drained",
    "2 (10.75 ounce) cans low sodium chicken stock",
    "1 cup water",
    "0.5 teaspoon cayenne pepper, or to taste",
    "2 cups uncooked instant rice"
  ],
  "steps": [
    {
      "text": "Place sausage and onion into a large saucepan over medium heat; cook and stir until sausage begins to brown, about 10 minutes.",
