  "ingredients": [
    "2 tilapia fillets",
    "3 tablespoons lime juice, divided",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon chili powder",
    "2 tablespoons olive oil",
    "16 (5 inch) corn tortillas",
    "2 cups tomatillo salsa",
    "1 avocado",
    "0.5 cup sour cream",
    "2 tablespoons chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Preheat grill to medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub tilapia fillets with 2 tablespoons lime juice and season with salt, black pepper, and chili powder. Brush both sides of each fillet with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill tilapia on preheated grill until fish flakes easily with a fork, about 5 minutes on each side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tortillas on an ungreased skillet over medium-high heat for 10 to 15 seconds. Turn and heat for another 5 to 10 seconds. Fill the heated tortillas with flaked tilapia. Top with tomatillo salsa, avocado, and sour cream. Sprinkle with cilantro and 1 tablespoon lime juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
