  "ingredients": [
    "1 (8 ounce) tub cream cheese, softened",
    "1 cup shredded mozzarella cheese, divided",
    "0.13 teaspoon garlic powder",
    "0.13 teaspoon onion powder",
    "1.5 cups pizza sauce",
    "0.33 cup mini pepperoni slices",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon dried oregano",
    "tortilla chips, pita chips, or crackers for dipping"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cream cheese, half of the mozzarella cheese, garlic powder, and onion powder in a bowl. Spread cream cheese mixture in the bottom of a small baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pizza sauce over cream cheese mixture, spreading it into an even layer. Top with remaining mozzarella cheese, followed by pepperoni. Sprinkle basil and oregano over everything.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the pre-heated oven until the cheese has melted and the dip is thoroughly heated through, about 15 minutes. Serve with chips or crackers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
