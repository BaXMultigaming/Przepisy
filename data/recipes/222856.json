  "ingredients": [
    "1 ear corn on the cob, unhusked",
    "1 teaspoon butter, or to taste",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Place ear of corn in a microwave oven and cook on high for 2 minutes; flip corn over and cook on high until kernels are hot and steaming, about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a pot holder or folded kitchen towel, place the corn ear on a cutting board. Cut off the bottom of the ear, exposing 1/4 to 1/2 inch of kernels. Hold the ear from the top and squeeze the ear of corn out of the husk from top to bottom. Husks and silk will be left behind.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread ear with butter and season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
