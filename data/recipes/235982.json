  "ingredients": [
    "1.5 pounds russet potatoes, cut into 1/2-inch wedges",
    "1.5 tablespoons vegetable oil",
    "1 teaspoon Mexican-style seasoning blend",
    "0.5 teaspoon garlic salt",
    "1 cup shredded Mexican cheese blend",
    "0.25 cup rinsed and drained canned black beans",
    "0.25 cup diced tomatoes",
    "0.25 cup sliced black olives",
    "0.25 cup sliced green onions",
    "3 tablespoons canned chopped green chiles"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine potatoes, oil, Mexican seasoning, and garlic salt together in a bowl; stir to coat potatoes completely. Spread potatoes in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring occasionally, until potatoes are crisp and golden brown, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer potatoes to a plate and top with Mexican cheese blend, black beans, diced tomatoes, black olives, green onions, and green chiles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
