  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup butter",
    "0.66666668653488 cup white sugar",
    "1 tablespoon grated fresh jalapeno",
    "1 lime, zested and juiced",
    "0.5 teaspoon salt",
    "1 cup confectioners' sugar",
    "0.25 cup lime juice",
    "0.5 tablespoon grated fresh jalapeno, or more to taste",
    "1 lime, zested"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, butter, sugar, jalapeno, lime zest and juice, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1-inch balls and place on ungreased cookie sheets; flatten slightly with a thumb print to accommodate icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and set, 8 to 10 minutes. Remove cookies from the oven and let cool at least 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine confectioners' sugar, lime juice, jalapeno, and lime zest in a bowl. Drizzle icing onto cooled cookies.",
