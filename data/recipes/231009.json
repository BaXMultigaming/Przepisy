    "publisher-tested"
  ],
  "ingredients": [
    "2.5 pounds boneless beef chuck roast, cut into 2-inch cubes",
    "salt and ground black pepper to taste",
    "2 tablespoons vegetable oil",
    "2 onions, chopped",
    "2 teaspoons olive oil",
    "0.5 teaspoon salt",
    "2 tablespoons Hungarian paprika",
    "2 teaspoons caraway seeds, crushed",
    "1 teaspoon freshly ground black pepper",
    "1 teaspoon dried marjoram",
    "0.5 teaspoon ground thyme",
    "0.5 teaspoon cayenne pepper",
    "4 cups chicken broth, divided",
    "0.25 cup tomato paste",
    "3 cloves garlic, crushed",
    "2 tablespoons balsamic vinegar",
    "1 teaspoon white sugar",
    "0.5 teaspoon salt, or to taste",
    "1 bay leaf"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/51Qw98MPqVu--aQf2wnx3ZgwGg8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231009-Chef-Johns-Beef-Goulash-ddmfs-step-1-102-afee1d8399b941be897088c36956dc13.jpg"
      ],
      "image": "assets/images/231009/step_01.webp"
    },
    {
      "text": "Season beef with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nr_wTkkKRVa_HQoLkm17UWTvD9U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231009-Chef-Johns-Beef-Goulash-ddmfs-step-2-104-c749af6d4b7046e6a97f4d0651630d67.jpg"
      ],
      "image": "assets/images/231009/step_02.webp"
    },
    {
      "text": "Heat vegetable oil in a large skillet over high heat; cook and stir beef in hot oil in batches until browned on all sides, about 5 minutes per batch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8deY696vkeaY3e4BYrCRYurT7_c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231009-Chef-Johns-Beef-Goulash-ddmfs-step-3-104-a474c010c462495d8945ec5b93af0cb9.jpg"
      ],
      "image": "assets/images/231009/step_03.webp"
    },
    {
      "text": "Transfer to a large stockpot and reserve drippings in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6nHUtDA1ZRoo5SlWdY_pm0-2-gI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231009-Chef-Johns-Beef-Goulash-ddmfs-step-4-104-834687fe46d34550b7154fe0276f8a76.jpg"
      ],
      "image": "assets/images/231009/step_04.webp"
    },
    {
      "text": "Return skillet to medium heat; stir onions into the reserved drippings, drizzle olive oil over onions, season with 1/2 teaspoon salt and cook until onion has softened, about 5 minutes. Transfer to the stockpot with beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Nm92NUV5SUk-ejQEy3HJ95DJRis=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231009-Chef-Johns-Beef-Goulash-ddmfs-step-6-117-36d8cc1c06a24ff9ba1b7cf3bdd09714.jpg"
      ],
      "image": "assets/images/231009/step_05.webp"
    },
    {
      "text": "Combine paprika, caraway seeds, black pepper, marjoram, thyme, and cayenne pepper in the skillet and toast over medium heat until fragrant, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XW2Gsap9R1rGqJ7MC35UpHE_KTA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231009-Chef-Johns-Beef-Goulash-ddmfs-step-7-119-57cf6d9360ad46ccb6adaf297c1a6b43.jpg"
      ],
      "image": "assets/images/231009/step_06.webp"
    },
    {
      "text": "Add 1 cup chicken broth and stir; transfer to the beef and onion mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_crxrFtznTJsX9NdDC01e1Wea6s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231009-Chef-Johns-Beef-Goulash-ddmfs-step-8-2-123-a177bd8a2b70407e8ab3de497d16bd3b.jpg"
      ],
      "image": "assets/images/231009/step_07.webp"
    },
    {
      "text": "Stir 3 cups chicken broth into beef mixture. Add tomato paste, garlic, vinegar, sugar, 1/2 teaspoon salt, and bay leaf; place stockpot over high heat and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jUF8DvSG_lBXehaf9rv3px1eZxU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231009-Chef-Johns-Beef-Goulash-ddmfs-step-9-124-47a5296435af47a5ae19d4479b163387.jpg"
      ],
      "image": "assets/images/231009/step_08.webp"
    },
    {
      "text": "Reduce heat to low and simmer until a fork inserts easily into the meat, 1 1/2 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nm3Afr7HtcnWvKuoRb6-6VaNWBM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231009-Chef-Johns-Beef-Goulash-ddmfs-4x3-258-b311fe6ab2764db38fb28753e6de54a4.jpg"
      ],
      "image": "assets/images/231009/step_09.webp"
    }
  ],
