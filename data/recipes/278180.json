  "ingredients": [
    "1.5 cups all-purpose flour",
    "2 tablespoons baking powder",
    "1 tablespoon white sugar",
    "0.25 teaspoon salt",
    "1 cup vanilla-flavored almond milk",
    "0.5 cup low-fat vanilla Greek yogurt (such as Cabot®)",
    "1 large egg, lightly beaten",
    "1 lemon, zested and juiced",
    "1 teaspoon almond extract",
    "1 tablespoon unsalted butter, melted",
    "1 cup blueberries"
  ],
  "steps": [
    {
      "text": "Whisk flour, baking powder, sugar, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk almond milk, yogurt, egg, lemon zest and juice, and almond extract together in a separate bowl Stir in butter. Add to flour mixture, stirring until just mixed. Gently fold in blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a lightly oiled griddle or large skillet over medium-high heat. For each pancake, pour approximately 1/4 cup of batter onto the hot griddle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until pancakes start to lightly bubble and edges begin to dry, 3 to 4 minutes. Flip and continue cooking until lightly browned and cooked through, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
