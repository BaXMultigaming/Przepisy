  "ingredients": [
    "15 ounces mini twist pretzels",
    "2 cups mixed nuts",
    "1 cup unsalted butter",
    "2 cups packed dark brown sugar",
    "0.5 cup light corn syrup",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 9x13-inch baking dish, combine the pretzels and nuts. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan combine the butter, sugar, corn syrup and salt. Stir together over medium heat until sugar dissolves. Bring to a boil and cook until very thick and at the 'firm ball' stage (260 degrees F, 125 degrees C). Remove from heat, pour over pretzel/nut mixture and mix all together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes, stirring after 10 minutes. Remove from oven and spread out on wax paper to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
