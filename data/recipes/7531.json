  "ingredients": [
    "1.25 cups butter, softened",
    "0.5 cup unsweetened cocoa powder",
    "2 cups white sugar",
    "4 eggs",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1.5 cups chopped walnuts",
    "2 teaspoons vanilla extract",
    "0.5 cup milk",
    "3 cups confectioners' sugar",
    "0.33333334326744 cup unsweetened cocoa powder",
    "1 (7 ounce) jar marshmallow creme"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan over low heat, melt 1 cup butter with cocoa, stirring often. Remove from the heat and add white sugar. Beat until well combined, then beat in eggs, one at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour, baking powder, and salt until combined, then stir in walnuts and 1 teaspoon vanilla. Pour batter into the prepared pan and bake in the preheated oven for 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the cake is baking, make the icing: Beat remaining 1/4 cup butter and 1 teaspoon vanilla with cocoa, milk, and confectioner's sugar until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cake from the oven and spread marshmallow cream over top. Spoon icing over marshmallow cream while cake is still hot; spread with a spatula for a \"muddied\" look.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
