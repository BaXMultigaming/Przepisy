  "ingredients": [
    "1 cup all-purpose flour",
    "1 tablespoon white sugar",
    "1 teaspoon baking powder",
    "0.5 cup butter",
    "2 tablespoons heavy cream",
    "1 egg",
    "2.5 cups pitted and sliced plums",
    "0.5 cup heavy cream",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 1 tablespoon sugar, and baking powder in a large bowl. Cut in butter with 2 knives or pastry blender until mixture resembles coarse crumbs. Stir in 2 tablespoons cream and 1 egg: press into the bottom of an ungreased 9-inch square pan. Place plums on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat ½ cup cream, ½ cup sugar, 1 egg, and vanilla together in a separate bowl with an electric mixer until smooth and creamy: pour over plums. Bake in the oven until custard is set, 20 to 30 minutes more. Store in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
