  "ingredients": [
    "nonstick cooking spray",
    "3 thin slices ham",
    "0.25 cup shredded Gruyere cheese",
    "3 large eggs",
    "1 tablespoon milk, or as needed",
    "3 leaves fresh basil, torn",
    "0.5 teaspoon chopped fresh chives, or to taste",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 6-cup muffin pan with nonstick spray, making sure the spray coats all sides of the cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut ham in half and place 1 piece in each cup, pressing it down so it forms a basket in the cup. Sprinkle a small amount of Gruyere cheese on the bottom of the ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crack eggs into a a measuring cup. Add milk, basil, chives, salt, and pepper. Whisk until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour egg mixture evenly into each muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 20 to 25 minutes. Let cool for a few minutes before using a spoon to slide the cups out onto a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
