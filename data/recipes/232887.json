  "ingredients": [
    "3 large eggs",
    "1 cup 100% pure pumpkin",
    "1.5 teaspoons pumpkin pie spice",
    "1 (14 ounce) can EAGLE BRAND® Sweetened Condensed Milk",
    "1.3333333730698 cups whole milk",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "0.5 cup whipped cream, or to taste",
    "1 pinch ground cinnamon, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs together in a large bowl. Stir in pumpkin and pumpkin pie spice until blended. Whisk in condensed milk, milk, vanilla, and salt until blended. Pour into six 6-ounce custard cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place custard cups in a 9x13-inch baking dish. Place the dish on the center rack in the middle of the preheated oven. Pour boiling water into the pan around custard cups to a depth of 1 1/4 inches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until the centers are almost set, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove custard cups from the baking dish and set on a wire rack to cool. Serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with whipped cream and sprinkle with cinnamon just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
