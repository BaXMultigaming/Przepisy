  "title": "Cinnamon Carrot Bread",
  "description": "This easy carrot bread is made with cinnamon, brown and white sugars, carrots, pecans, and vanilla extract.",
  "authors": [
    "Vicki Monte"
  ],
  "date_published": "1998-05-16T15:55:32-04:00",
