  "ingredients": [
    "0.75 cup sunflower seed oil",
    "0.75 cup white sugar",
    "0.25 cup packed brown sugar",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 pinch salt",
    "2 large eggs, beaten",
    "1 cup grated carrots",
    "0.5 cup chopped pecans",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 Degrees C). Grease and flour a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sunflower oil and both sugars with an electric mixer in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, baking soda, cinnamon, and salt together into a bowl. Gradually stir dry ingredients into wet ingredients. Stir in beaten eggs until combined. Mix in carrots, pecans, and vanilla. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on the middle rack of the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool in the pan for 10 minutes. Turn out onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
