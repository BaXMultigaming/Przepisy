  "ingredients": [
    "1 large orange, peeled",
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "0.5 cup vegetable oil",
    "1.5 teaspoons baking soda",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease an 8x8-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend orange in the blender until liquified; measure 1 cup orange juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk orange juice, flour, sugar, vegetable oil, baking soda, and salt together in a bowl. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cake comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
