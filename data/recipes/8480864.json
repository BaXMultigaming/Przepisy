  "ingredients": [
    "1 teaspoon olive oil",
    "1 tablespoon minced shallots",
    "2 tablespoons green peppercorns in brine, drained",
    "2 tablespoons unsalted butter",
    "2 tablespoons Cognac",
    "2 teaspoons all-purpose flour",
    "1 cup beef broth",
    "0.5 cup half-and-half",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Add shallots, peppercorns, and butter; cook for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add Cognac and cook for 1 minute. Whisk in flour and cook for 1 minute until alcohol evaporates. Pour in beef broth and increase heat to bring sauce to a simmer. Cook and stir for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add half and half, reduce heat to low, and cook 5 minutes. Season with salt and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
