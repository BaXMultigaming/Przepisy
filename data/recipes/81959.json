  "ingredients": [
    "5 cups chopped cooked chicken",
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "1 cup sour cream",
    "1.5 cups crushed buttery round crackers",
    "0.5 cup butter, melted",
    "1 teaspoon poppy seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in a 9x13-inch baking dish. Combine condensed soup and sour cream in a medium bowl; pour over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir crushed crackers, melted butter, and poppy seeds together in a separate bowl; sprinkle over chicken and sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is browned and sauce is bubbly, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
