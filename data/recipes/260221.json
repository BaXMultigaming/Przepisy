  "ingredients": [
    "2 pounds lean ground beef",
    "1 (10.5 ounce) can condensed French onion soup",
    "0.5 cup fine dry bread crumbs",
    "0.5 cup rolled oats",
    "1 egg, lightly beaten",
    "1 tablespoon dried parsley",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, condensed soup, bread crumbs, oats, beaten egg, parsley, salt, and pepper together in a bowl until well combined. Pack into a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, about 1 hour and 15 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Let rest for 5 minutes before cutting.",
      "section": null,
      "name": null,
      "url": null,
