  "ingredients": [
    "1 pound dry fettuccine pasta",
    "0.25 cup olive oil",
    "3 cloves garlic, minced",
    "2 zucchinis, diced",
    "0.5 teaspoon salt",
    "0.5 teaspoon crushed red pepper flakes",
    "1 cup chopped fresh basil",
    "4 roma (plum) tomatoes, chopped",
    "1 pound bay scallops",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat oil in a large skillet; stir in garlic and cook until tender. Add zucchini, salt, and red pepper flakes; sauté for 10 minutes. Stir in chopped tomatoes, bay scallops, and fresh basil; simmer for 5 minutes, or until scallops are opaque.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sauce over cooked pasta and serve with grated Parmesan cheese.",
      "section": null,
      "name": null,
