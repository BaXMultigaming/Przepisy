  "ingredients": [
    "1 cup packed brown sugar",
    "0.5 cup buttermilk",
    "0.5 cup shortening",
    "0.25 cup honey",
    "1 egg",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "2 cups semisweet chocolate chips",
    "1 cup chopped white chocolate"
  ],
  "steps": [
    {
      "text": "Heat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix brown sugar, buttermilk, shortening, honey, and egg. Stir in flour, baking soda, baking powder, and salt. Stir in chocolate chips and chopped white chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by level 1/4 cupfuls about 2 inches apart onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 12 to 14 minutes, or until edges are golden brown. Cool for 4 minutes, and remove from cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
