  "ingredients": [
    "1 tablespoon olive oil",
    "3 slices black forest ham, chopped",
    "0.25 cup chopped pineapple",
    "0.25 cup chopped red onion",
    "2 bunches kale, chopped",
    "2 bunches rainbow chard, chopped",
    "0.25 cup crumbled feta cheese",
    "0.25 cup slivered almonds",
    "0.25 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add ham, pineapple, and onion; cook until onion is tender and lightly browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add kale and chard; cover and cook until wilted and reduced by half, about 7 minutes. Toss mixture, cover, and continue to cook until greens have softened, 3 to 4 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer kale-chard mixture to a large bowl; stir in feta cheese, almonds, and cranberries.",
