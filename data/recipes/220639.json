  "ingredients": [
    "3 cups elbow macaroni",
    "cooking spray",
    "1 tablespoon butter",
    "1 cup cubed ham",
    "1 cup chopped onion",
    "1 tablespoon minced garlic",
    "2 cups shredded Cheddar cheese",
    "1 (10.75 ounce) can condensed cream of celery soup",
    "1 cup frozen peas",
    "1 cup milk",
    "0.5 cup sour cream",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "1 (6 ounce) can French-fried onions, crushed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R-4Yh6KIhCkwIxDrRK0D7Kd9P9c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-220639-deluxe-ham-casserole-VAT-step-01-830695c7cede43799b6d8ab024a64d8e.jpg"
      ],
      "image": "assets/images/220639/step_01.webp"
    },
    {
      "text": "Bring a large pot of salted water to a boil. Cook macaroni in boiling water uncovered, stirring occasionally, until tender yet firm to the bite, about 8 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fJKt3fDy_3H9uquEXAZWrC4kgMU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-220639-deluxe-ham-casserole-VAT-step-02-9d7ad3096c9d4bacac89c7eb33415d74.jpg"
      ],
      "image": "assets/images/220639/step_02.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gJM9zqr6xPlEM_jB1YDYuWut7jI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-220639-deluxe-ham-casserole-VAT-step-03-2nohand-35ae800ceaa147e4b6d6e877511ceac9.jpg"
      ],
      "image": "assets/images/220639/step_03.webp"
    },
    {
      "text": "Melt butter in a large skillet over medium-high heat. Cook and stir ham and onion in hot butter until onion is tender, about 5 minutes. Stir in garlic and cook for about 2 minutes more; remove the skillet from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/27peu-MI07Xn5Gzf0AsQ5qVLNMQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-220639-deluxe-ham-casserole-VAT-step-04-1-92a2f22c09ed4c4084966453728f5101.jpg"
      ],
      "image": "assets/images/220639/step_04.webp"
    },
    {
      "text": "Add macaroni, Cheddar cheese, condensed soup, peas, milk, sour cream, onion powder, and garlic powder to ham mixture in the skillet; mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XHgAvuiCcbIx5a2E0SFxWpHu4GM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-220639-deluxe-ham-casserole-VAT-step-05-4a31d26722964257bca9e09422a51fba.jpg"
      ],
      "image": "assets/images/220639/step_05.webp"
    },
    {
      "text": "Transfer mixture to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aQWdMvKy7iZokM3RBX0T70bCTnY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-220639-deluxe-ham-casserole-VAT-step-06-709c657595904186bb4dc149ff801323.jpg"
      ],
      "image": "assets/images/220639/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R2umV2Qr1MBSjACOBrIYqB7A8dE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-220639-deluxe-ham-casserole-VAT-step-07-ae59561e33974986bd26c015e4af7e70.jpg"
      ],
      "image": "assets/images/220639/step_07.webp"
    },
    {
      "text": "Sprinkle French-fried onions over casserole and continue baking until golden, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uk8BWSFG3U0e6nFistTLU8lN67Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-220639-deluxe-ham-casserole-VAT-step-08-73ea90c076b349988ead3f8877721425.jpg"
      ],
      "image": "assets/images/220639/step_08.webp"
    }
