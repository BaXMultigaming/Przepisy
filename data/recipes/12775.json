      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7NETTs79M49hNoBvBDr9F3ZFBzI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12775-Spicy-Grilled-Shrimp-DDMFS-4x3-step-02-05a09e41ed3f4a56abab20ac12913fbc.jpg"
      ],
      "image": "assets/images/12775/step_03.webp"
    },
    {
      "text": "Combine garlic paste and shrimp in a large bowl and toss until shrimp are evenly coated.",
