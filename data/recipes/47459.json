  "ingredients": [
    "2 tablespoons butter",
    "0.33333334326744 cup confectioners' sugar",
    "1 cup white sugar",
    "4 eggs",
    "1 egg yolk",
    "2 (14 ounce) cans coconut milk",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "2 tablespoons coconut extract",
    "1.5 cups flaked coconut, divided",
    "0.5 cup fresh coconut",
    "1 (1 pound) loaf French bread, cut into 1 inch cubes"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease a 9x13 inch baking dish with butter, and dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine sugar, eggs, egg yolk, coconut milk, cinnamon, nutmeg, salt and coconut extract. Mix until smooth. Stir in 1 cup of flaked coconut, and 1/2 cup fresh coconut. Fold in bread cubes until evenly coated. Pour into prepared baking dish. Set aside for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on a cookie sheet in preheated oven for 25 minutes. Sprinkle top with remaining 1/2 cup flaked coconut. Continue baking for 25 to 30 minutes, or until center springs back when lightly tapped.",
      "section": null,
      "name": null,
      "url": null,
