  "ingredients": [
    "2 sweet potatoes, diced",
    "2 (14.5 ounce) cans diced stewed tomatoes with chili seasonings",
    "1 (8 ounce) can tomato sauce",
    "0.75 cup diced sweet onion",
    "0.5 cup chopped celery",
    "0.5 cup water",
    "1 tablespoon chili powder",
    "1 teaspoon ground cumin",
    "0.5 teaspoon ground cinnamon",
    "1 pinch salt",
    "1 pinch ground black pepper",
    "1 pinch cayenne pepper",
    "1 pinch garlic powder",
    "1 pinch onion powder",
    "0.5 pound ground turkey",
    "0.5 pound ground beef",
    "1 (12 ounce) can black beans, drained and rinsed",
    "1 cup corn"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rIHQelW4NmDiMy6x7AsJSK0H0V0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229081-sweet-potato-chili-VAT-step-01-d094d6ec91b44dc5ab3df17dca0bfeb2.jpg"
      ],
      "image": "assets/images/229081/step_01.webp"
    },
    {
      "text": "Place sweet potatoes, stewed tomatoes, tomato sauce, onion, celery, water, chili powder, cumin, cinnamon, salt, black pepper, cayenne pepper, garlic powder, and onion powder in a slow cooker. Cook on high, stirring occasionally, for 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SG7vONSeUedVhJzAAGWtpWqlc1s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229081-sweet-potato-chili-VAT-step-02-d672f551ecf343b8a1ea00a0f142bc80.jpg"
      ],
      "image": "assets/images/229081/step_02.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat and stir in ground turkey and ground beef. Cook and stir until meat is crumbly, evenly browned, and no longer pink, 10 to 15 minutes. Drain and discard any excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xx4-JEHUM2FGlnFBU31OSSr4Z5Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229081-sweet-potato-chili-VAT-step-03-66d85a2a52104b53b7f2134c78cc989d.jpg"
      ],
      "image": "assets/images/229081/step_03.webp"
    },
    {
      "text": "Add cooked ground turkey, cooked ground beef, black beans, and corn to sweet potato mixture in the slow cooker; cook until flavors have blended, 1 to 2 more hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7ML0As4SjUg18QTnMt1QhEzd9MI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229081-sweet-potato-chili-VAT-step-04-9a26394bcb674c9bafe2189a0b0394e9.jpg"
      ],
      "image": "assets/images/229081/step_04.webp"
    },
    {
      "text": "Serve warm and enjoy!",
      "section": null,
      "name": null,
      "url": null,
