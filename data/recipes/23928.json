  "ingredients": [
    "12 large eggs",
    "1 onion, sliced into rings",
    "1 cup distilled white vinegar",
    "1 cup water",
    "10 cloves garlic, peeled",
    "0.25 cup white sugar"
  ],
  "steps": [
    {
      "text": "Place eggs in a medium saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove from hot water, cool, and peel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggs and onion into a 1-quart jar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine vinegar, water, garlic, and sugar in a medium saucepan; bring to a boil. Remove from heat and allow to cool, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour vinegar mixture over eggs and cover with a lid. Refrigerate for 1 week before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
