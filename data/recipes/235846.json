  "ingredients": [
    "1 teaspoon salt, divided",
    "0.5 teaspoon cumin",
    "0.25 teaspoon ground red pepper, or more to taste",
    "1 tablespoon olive oil",
    "4 (4 ounce) boneless skinless chicken breast halves",
    "1 fully ripened Avocado from Mexico, halved, pitted, peeled and cubed",
    "1 cup chopped tomato",
    "0.5 cup diced cucumber",
    "0.25 cup diced red onion",
    "0.25 cup chopped fresh cilantro",
    "2 tablespoons lime juice"
  ],
  "steps": [
    {
      "text": "In small bowl, combine 1/2 teaspoon of the salt, the cumin and pepper; rub on chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large non-stick skillet, heat oil over medium heat. Add chicken; cook, turning occasionally, until no longer pink in the center, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in medium bowl, combine Avocado, tomato, cucumber, onion, cilantro and remaining 1/2 teaspoon salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve over cumin-rubbed chicken with whole grain couscous or rice, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
