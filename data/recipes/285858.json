  "ingredients": [
    "nonstick cooking spray",
    "3 cups peeled and diced apples",
    "1 lime, juiced",
    "0.75 cup all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon salt",
    "2 large eggs",
    "0.5 cup brown sugar",
    "0.25 cup white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 6½-inch springform pan with nonstick cooking spray and line with parchment paper. Spray parchment paper with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss apples with lime juice and set aside. Mix flour, cinnamon, ginger, and salt in a bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs with brown sugar, white sugar, and vanilla extract in a second bowl and beat with an electric mixer until creamy. Add dry ingredients and mix until just combined. Pour about 1/3 of the batter into the prepared pan. Add apples and top with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, 50 to 60 minutes. Transfer to a wire rack and cool for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Run a knife around the springform pan, release springform, and flip apple Charlotte onto a plate. Immediately flip the cake onto a serving platter.",
      "section": null,
      "name": null,
      "url": null,
