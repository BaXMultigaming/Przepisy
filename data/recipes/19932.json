  "ingredients": [
    "5 potatoes",
    "1 pound bacon",
    "2 stalks celery",
    "4 small green onions",
    "12 stuffed green olives",
    "5 radishes",
    "0.25 cup mayonnaise",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Cut potatoes into ½-inch pieces; add to pot. Boil until tender but still firm, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cut bacon into small pieces. Cook in a large skillet over medium-high heat until crisp; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chop celery, green onions, olives, and radishes; transfer to a large bowl. Add potatoes and bacon; stir to combine. Stir in mayonnaise and lemon juice. Refrigerate salad before serving, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
