  "ingredients": [
    "1 (8 ounce) package 1/3-less-fat cream cheese, softened",
    "1 cup powdered sugar",
    "4 tablespoons butter, room temperature",
    "3 cups milk",
    "2 (3.5 ounce) packages instant vanilla pudding mix",
    "1 (8 ounce) container frozen whipped topping (such as Cool Whip®), thawed",
    "1 (16 ounce) package chocolate sandwich cookies (such as Oreo®), crushed into chunks"
  ],
  "steps": [
    {
      "text": "Combine cream cheese, powdered sugar, and butter in a large bowl; beat with an electric mixer until creamy. Add milk and vanilla pudding mix and beat until well combined and all lumps are gone. Fold in whipped topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Distribute 1/2 of the chocolate sandwich cookies on the bottom of a 9x13-inch dish. Cover with the pudding mixture and top with remaining cookie chunks. Cover and refrigerate for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
