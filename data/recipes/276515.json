  "ingredients": [
    "2 cups gluten-free all-purpose flour",
    "1.5 cups maple syrup",
    "0.75 cup dark cocoa powder",
    "0.75 teaspoon gluten-free baking powder",
    "1 teaspoon salt",
    "1 cup mashed bananas",
    "0.25 cup unsweetened coconut milk",
    "0.25 cup olive oil",
    "1 teaspoon vanilla extract",
    "1 cup vegan dark chocolate chips",
    "0.5 cup cocoa nibs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, maple syrup, cocoa powder, baking powder, and salt in a large bowl; blend well and make a well in the center. Combine mashed bananas, coconut milk, olive oil, and vanilla extract in a second bowl. Pour banana mixture into the flour mixture and stir until batter is evenly mixed. Fold in chocolate chips. Pour batter into the prepared baking dish and sprinkle with cocoa nibs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 30 minutes. Let cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
