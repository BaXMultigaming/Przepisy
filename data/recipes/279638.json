  "ingredients": [
    "4 quarts whole milk",
    "0.5 teaspoon sea salt",
    "0.5 cup lemon juice"
  ],
  "steps": [
    {
      "text": "Line a colander with a damp piece of muslin or cheesecloth and set in the sink or over a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk into a large saucepan. Heat over medium-low heat to 200 degrees F (93 degrees C). Stir well and add salt. Pour in lemon juice gradually, 1 tablespoon at a time. Stir until curds separate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle curds into the prepared colander. Fold muslin over curds and place a weight on top (such as a bowl filled with water). Press lightly and let drain for 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
