  "ingredients": [
    "1 (14.1 ounce) package pastry for a 9-inch double-crust pie",
    "0.75 cup white sugar, or more to taste",
    "1 teaspoon ground cinnamon",
    "6 cups thinly sliced apples",
    "1 tablespoon butter",
    "1 egg",
    "1 tablespoon water"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a 9-inch pie dish with one pastry crust; set second one aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 3/4 cup sugar and cinnamon in a small bowl. Add more sugar if your apples are tart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer apple slices in the prepared pie dish, sprinkling each layer with cinnamon-sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1b2wHCuc2VVYxAFAE7JjbcHwdvU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12324-ApplePiei-ddmfs-Step1-0935-aa34f4c16ff64e77ada77d6ccaa88061.jpg"
      ],
      "image": "assets/images/12324/step_04.webp"
    },
    {
      "text": "Dot top layer with small pieces of butter. Cover with top crust and flute the edges to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R_eMjAiDmyNkx6iwXTb1QLSHXlg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12324-ApplePiei-ddmfs-Step2-0936-a31d5f43ccfd499f91cf1a4527e6d834.jpg"
      ],
      "image": "assets/images/12324/step_05.webp"
    },
    {
      "text": "Beat egg with 1 tablespoon water to make an egg wash; brush the top crust with egg wash. Cut several slits in the top crust to allow steam to escape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pie on the lowest rack of the preheated oven for 10 minutes. Reduce oven temperature to 350 degrees F (175 degrees C) and continue baking until golden brown and filling bubbles, 30 to 35 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1u9ML3MzRArqMZ3JWqRb9yRwC40=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12324-apple-pie-i-DDMFS-4x3-82e54fc773c44e2492f0ff6abdb0ec9a.jpg"
