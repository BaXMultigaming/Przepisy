  "ingredients": [
    "3 pounds Yukon Gold potatoes, peeled and cut into 2-inch chunks",
    "1.5 tablespoons kosher salt",
    "0.5 cup salted butter, cubed",
    "4 large cloves garlic, crushed",
    "1 cup whole milk, warmed",
    "1 cup sour cream",
    "6 tablespoons unsalted butter, cubed",
    "2 teaspoons kosher salt",
    "0.5 teaspoon freshly ground black pepper",
    "2 tablespoons thinly sliced scallions"
  ],
  "steps": [
    {
      "text": "Place potatoes and 1 ½ tablespoons of the salt in a large stock pot. Add enough cold water to cover potatoes by 2 inches. Bring to a boil over high heat. Reduce heat to medium-high and boil until potatoes can be easily pierced with a fork, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zUIMkx2kgFWL4oWJzvN5gvQbGG8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486301-sour-cream-mashed-potatoes-ddmfs-step-2-205-4x3-1aa5165f6e7e4810bf83e35b9acf5ad3.jpg"
      ],
      "image": "assets/images/8486301/step_01.webp"
    },
    {
      "text": "Meanwhile, place salted butter and garlic in a small saucepan over low heat. Cook, stirring occasionally until garlic is fragrant and white milk solids have separated from butter, 2 to 3 minutes. Remove from heat and cover to keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zoh8jCT0DqTmc9gnhvpjEq0OAQw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486301-sour-cream-mashed-potatoes-ddmfs-step-1-204-4x3-d756d9c36b1849c0a71b0a1f56be752b.jpg"
      ],
      "image": "assets/images/8486301/step_02.webp"
    },
    {
      "text": "Remove potatoes from heat and drain in a colander. Return potatoes to the pot; add milk, sour cream, unsalted butter, 2 teaspoons salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7d1BuVawRxjVTG870RBa8GqUFWA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486301-sour-cream-mashed-potatoes-ddmfs-step-4-208-4x3-b9fa104b132446baa46f2f13654b76ae.jpg"
      ],
      "image": "assets/images/8486301/step_03.webp"
    },
    {
      "text": "Mash using a potato masher until smooth; transfer mashed potatoes into a serving bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w64C42RBTtn0ZN3Dnm3Q40Ltrvo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486301-sour-cream-mashed-potatoes-ddmfs-step-5-210-4x3-b6f586aae4d347dfafcec57a29737488.jpg"
      ],
      "image": "assets/images/8486301/step_04.webp"
    },
    {
      "text": "Pour garlic butter through a fine mesh strainer into a small bowl. Discard milk solids and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-J6OKPIrhnWUDSiBDCvQsMzeQEI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486301-sour-cream-mashed-potatoes-ddmfs-step-6-212-4x3-65c483ffdfb94df4b795e9e5bb82f05c.jpg"
      ],
      "image": "assets/images/8486301/step_05.webp"
    },
    {
      "text": "Pour butter over mashed potatoes and sprinkle with scallions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NFNM6QMikoXmk_UjvmEMX9mRtzM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486301-sour-cream-mashed-potatoes-ddmfs-beauty-0392-4x3-5e22fd792726483cb59b7e3f39c0837b.jpg"
      ],
