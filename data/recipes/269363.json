  "ingredients": [
    "0.5 cup maple syrup",
    "0.25 cup Dijon mustard",
    "0.5 teaspoon minced fresh thyme",
    "0.25 teaspoon ground cinnamon",
    "2 pounds salmon fillets",
    "kosher salt and ground black pepper to taste",
    "1 tablespoon canola oil, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together maple syrup, Dijon mustard, thyme, and cinnamon in a small bowl until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season salmon with salt and pepper. Heat canola oil in a large oven-proof sauté pan over medium heat. Cook salmon in hot oil until browned, about 3 minutes. Flip and brush surface generously with maple syrup mixture. Cook until bottom is browned, about 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to the preheated oven and bake until salmon flakes easily with a fork, 5 to 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
