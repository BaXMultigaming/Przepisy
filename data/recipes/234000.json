  "ingredients": [
    "0.75 cup all-purpose flour",
    "0.5 cup white sugar",
    "3 tablespoons unsweetened cocoa powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.25 cup buttermilk",
    "3 tablespoons vegetable oil",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "0.25 cup freshly brewed hot coffee"
  ],
  "steps": [
    {
      "text": "Preheat a cake pop maker and brush with oil according to the manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, cocoa powder, baking soda, baking powder, and salt together in a bowl. Beat in buttermilk, vegetable oil, egg, and vanilla extract with an electric mixer until smooth. Beat in coffee until evenly incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon about 1 tablespoon batter into each reservoir of the prepared cake pop maker to fill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until a toothpick inserted into centers comes out clean, about 4 minutes. Remove cake pops. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
