  "ingredients": [
    "1 large jalapeno pepper, including seeds and ribs, cut diagonally into thin slices",
    "1 medium green onion, cut into 1-inch pieces",
    "1 tablespoon minced fresh ginger root",
    "3 cloves garlic, finely chopped",
    "1 tablespoon toasted sesame oil",
    "0.5 teaspoon sesame seeds"
  ],
  "steps": [
    {
      "text": "Heat a small nonstick skillet over medium-high heat and pour in toasted sesame oil. Immediately add green onion, jalapeno, and ginger; be careful of the fumes. Stir-fry for 20 to 30 seconds. Add garlic and sesame seeds and stir-fry until there is some char and the jalapeno slices are slightly wilted, 20 to 30 seconds more. Transfer to a heat-safe serving dish.",
