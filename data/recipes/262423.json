  "title": "Leche Flan",
  "description": "Leche flan is popular Filipino custard dessert with a smooth caramel sauce that&#39;s easy to make with egg yolks, sugar, and sweetened condensed milk.",
  "authors": [
    "Hannah"
  ],
  "date_published": "2020-06-19T00:26:54-04:00",
  "date_modified": "2026-01-04T11:47:27-05:00",
  "prep_time": "PT10M",
  "cook_time": "PT70M",
  "total_time": "PT380M",
  "yield": [
    "12",
    "1 (10-inch) flan"
  ],
  "categories": [
    "Dessert"
  ],
  "cuisines": [
    "Filipino",
    "Asian"
  ],
  "regions": [
    "Filipino",
