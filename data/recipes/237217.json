  "ingredients": [
    "1 bunch fresh asparagus, trimmed and cut into bite-size pieces",
    "2 tablespoons olive oil",
    "1 pinch garlic powder, or to taste",
    "4 cups lettuce leaves, cut into bite-size pieces",
    "1 cup grape tomatoes, halved",
    "0.5 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place asparagus in a large bowl. Drizzle olive oil over asparagus and season with garlic powder; toss well. Transfer asparagus to a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until asparagus are tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place lettuce in the same bowl used for asparagus; top with tomatoes, feta cheese, and roasted asparagus.",
      "section": null,
