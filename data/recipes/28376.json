  "ingredients": [
    "1 tablespoon olive oil",
    "5 cloves garlic, minced",
    "0.25 cup fresh ginger root, minced",
    "1 tablespoon fermented black beans, minced",
    "0.5 cup chopped green onions",
    "1 cup chopped green bell pepper",
    "8 chicken drumsticks",
    "4 cups fresh white mushrooms",
    "0.5 tablespoon salt",
    "0.5 teaspoon freshly ground black pepper",
    "0.5 teaspoon sesame oil",
    "0.25 cup chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Heat a large frying pan over medium-high heat. Add olive oil and heat through. Stir in the garlic, ginger, black beans, green onion and green pepper. Sautee for 1 to 2 minutes, or until the garlic turns yellow.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place drumsticks into the pan and fry for 5 minutes, then stir in the mushrooms and season with salt and pepper. Cover and let cook for 10 minutes. Reduce heat to medium-low and heat for 10 minutes, or until chicken is no longer pink and the juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When chicken is cooked through, stir in the sesame oil and fresh chives, remove from heat and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
