  "ingredients": [
    "1 (3 ounce) package cream cheese, softened",
    "2 tablespoons mayonnaise",
    "2 tablespoons finely grated onion",
    "2 tablespoons finely grated peeled and seeded cucumber",
    "1 drop green food coloring"
  ],
  "steps": [
    {
      "text": "Combine cream cheese, mayonnaise, onion, cucumber, and food coloring in a bowl until well blended and food coloring is incorporated. Cover the bowl with plastic wrap; chill in the refrigerator, 8 hours to overnight.",
