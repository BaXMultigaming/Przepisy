  "ingredients": [
    "0.75 pound boneless tender beef steak, rib eye, sirloin or flank",
    "1 tablespoon cornstarch",
    "3 tablespoons Kikkoman Soy Sauce, divided",
    "1 large clove garlic, minced",
    "0.5 teaspoon sugar",
    "1 pound fresh broccoli, trimmed",
    "4 teaspoons cornstarch",
    "0.5 teaspoon crushed red pepper",
    "3 tablespoons vegetable oil, divided",
    "1 medium onion, thinly sliced",
    "2 teaspoons Kikkoman Seasoned Rice Vinegar"
  ],
  "steps": [
    {
      "text": "Cut beef across grain into thin slices. Combine 1 Tbsp. each cornstarch and soy sauce with garlic and sugar in medium bowl; stir in beef. Let stand 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, remove flowerets from broccoli; cut into bite-size pieces. Peel stalks; cut diagonally into thin slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup water, remaining 2 Tbsp. soy sauce, 4 teaspoons cornstarch and crushed red pepper in small bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 Tbsp. oil in hot wok or large skillet over high heat. Add beef and stir-fry 1 minute; remove.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining 2 Tbsp. oil in same pan. Add broccoli and onion; stir-fry 2 minutes. Sprinkle 1 Tbsp. water over vegetables; cover and cook 2 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add beef and soy sauce mixture; cook and stir until sauce boils and thickens. Remove from heat; stir in vinegar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
