  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup cornmeal",
    "1 cup white sugar",
    "4 teaspoons baking powder",
    "1 teaspoon salt",
    "1 cup fresh cranberries",
    "1 cup milk",
    "0.66666668653488 cup pumpkin puree",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a 9-inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cornmeal, sugar, baking powder, and salt in a large bowl. Mix in cranberries, milk, pumpkin, and egg until well combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted into the center comes out clean, about 25 minutes. Let cool before cutting, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
