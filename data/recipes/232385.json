  "ingredients": [
    "1.25 cups all-purpose flour",
    "0.75 cup rolled oats",
    "0.75 cup brown sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1.25 cups milk",
    "0.25 cup peanut butter",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, oats, brown sugar, baking powder, and salt in a large bowl. Beat milk, peanut butter, and eggs in another bowl; stir into oat mixture, mixing until batter is well blended. Spoon batter evenly into 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
