  "ingredients": [
    "2.5 cups all-purpose flour",
    "0.25 teaspoon salt",
    "1 cup shortening",
    "0.25 cup cold water",
    "1 large egg",
    "1 tablespoon distilled white vinegar"
  ],
  "steps": [
    {
      "text": "Whisk flour and salt together in a large bowl. Cut in shortening until it resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cold water, egg, and vinegar together in a separate bowl. Add to flour mixture and blend with a fork until a ball of dough forms. Divide into three equal balls; flatten each ball into a disk. Wrap disks in plastic wrap and refrigerate until ready to use.",
      "section": null,
      "name": null,
      "url": null,
