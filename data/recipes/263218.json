  "ingredients": [
    "0.5 cup unsalted butter",
    "3 cloves garlic, peeled",
    "3 sprigs fresh dill",
    "1 teaspoon salt, or to taste",
    "1 pound salmon filet",
    "1 plank food-safe wood, such as untreated cedar or alder wood",
    "1 lemon, thinly sliced",
    "2 sprigs fresh dill, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the smoker to 250 degrees F (120 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, garlic, 3 sprigs dill, and salt in a heat-proof dish. Place in the smoker until butter is melted and infused with flavor, at least 20 minutes. Remove from the smoker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay salmon on the plank of wood. Brush salmon with the flavored butter. Season with salt and pepper. Place in the smoker and close the door.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook salmon until easily flaked with a fork, about 40 minutes. Check at 10-minute intervals and baste with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve garnished with lemon slices, remaining dill, and remaining flavored butter.",
      "section": null,
      "name": null,
      "url": null,
