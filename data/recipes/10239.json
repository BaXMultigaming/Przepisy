  "ingredients": [
    "0.33333334326744 cup butter, softened",
    "0.66666668653488 cup packed brown sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon baking soda",
    "1 egg",
    "0.5 cup applesauce",
    "1.25 cups all-purpose flour",
    "1.25 cups rolled oats"
  ],
  "steps": [
    {
      "text": "In bowl beat butter till creamy. Add brown sugar, cinnamon, and baking soda. Stir until combined. Mix in applesauce and egg. Add flour, a little at a time. Stir in oats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough onto ungreased cookie sheets. Bake at 375 degrees F (190 degrees C) for 8 to 10 minutes or until lightly browned. Enjoy!",
      "section": null,
