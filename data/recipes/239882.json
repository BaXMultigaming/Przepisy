  ],
  "steps": [
    {
      "text": "Put squash in a microwave-safe bowl; add sage. Dot squash with butter pieces; season with salt and pepper. Cover bowl tightly with plastic wrap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in microwave oven set on High for 5 minutes. Stir squash to coat in melted butter while checking cubes for softness. Replace plastic and continue to cook until completely tender, 2 to 4 minutes.",
