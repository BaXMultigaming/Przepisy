  "ingredients": [
    "3 tablespoons olive oil, or as needed",
    "0.25 cup chopped onion",
    "0.25 cup chopped green pepper",
    "1 pound ham steak, cut into small pieces",
    "1 teaspoon garlic salt",
    "5 large eggs",
    "4 asparagus spears, chopped",
    "2 tablespoons milk",
    "2 slices Provolone cheese"
