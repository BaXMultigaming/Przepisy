  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 cup raisins",
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "1 cup vegetable oil",
    "0.75 cup brown sugar",
    "4 large eggs",
    "3 cups shredded carrots"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lxJJw3doCD6dO8_vgDH8LbriOn0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23787-Awesome-Carrot-Muffins-gw-ddmfs-4x3-step-01-2a0b2f7751b64ec78824233e0729991e.jpg"
      ],
      "image": "assets/images/23787/step_01.webp"
    },
    {
      "text": "Soak raisins in 2 cups water in a small bowl for 15 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FtuQA13SiVvtpg9Uda-_3abuWUA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23787-Awesome-Carrot-Muffins-gw-ddmfs-4x3-step-02-43324886d1784513b0b4515b9fec9796.jpg"
      ],
      "image": "assets/images/23787/step_02.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 18 standard muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TGgtIMEUsycu4KUmi7Rlt7_4LNI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23787-Awesome-Carrot-Muffins-gw-ddmfs-4x3-step-03-2c4f405fd5b8404f913a2d20e7bb1f42.jpg"
      ],
      "image": "assets/images/23787/step_03.webp"
    },
    {
      "text": "Sift flour, baking powder, baking soda, salt, and cinnamon together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lfPVnRpA-QOEIgt8KIk2rgkNsj8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23787-Awesome-Carrot-Muffins-gw-ddmfs-4x3-step-04-254ab3839dae425fa4897f52f3fa9409.jpg"
      ],
      "image": "assets/images/23787/step_04.webp"
    },
    {
      "text": "Beat oil, brown sugar, and eggs in a large bowl with an electric mixer until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6evM6FAOX25alA4ZkcYVmztQVYc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23787-Awesome-Carrot-Muffins-gw-ddmfs-4x3-step-05-6e40dc87eb324dbfa3b3c64280f7e9fe.jpg"
      ],
      "image": "assets/images/23787/step_05.webp"
    },
    {
      "text": "Gradually mix in flour mixture, then fold in carrots and drained raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G3fq3MugsKWvffcPuRCMSGPFXWE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23787-Awesome-Carrot-Muffins-gw-ddmfs-4x3-step-06-79482fb5aa494eef9269d3ccb0a13b6f.jpg"
      ],
      "image": "assets/images/23787/step_06.webp"
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ddw0ezJi8Aeiz-W2guPIBTHurV8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23787-Awesome-Carrot-Muffins-gw-ddmfs-4x3-step-07-2e663fda104c4cc88f201d1aad260c57.jpg"
      ],
      "image": "assets/images/23787/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_YrOLw2Hn1WxNRVHg3a7xGRa_-g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23787-Awesome-Carrot-Muffins-gw-ddmfs-4x3-step-08-b02c15fdf1e5458ba4ec7fc02f6a68d0.jpg"
      ],
      "image": "assets/images/23787/step_08.webp"
    },
    {
      "text": "Cool in the tins for 5 minutes, then transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9p1YYSy3nD13IyKMlC2NTmr5pBA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23787-Awesome-Carrot-Muffins-gw-ddmfs-4x3-step-09-f4d6911858f148e6a1ae508576f7969c.jpg"
      ],
      "image": "assets/images/23787/step_09.webp"
    }
  ],
