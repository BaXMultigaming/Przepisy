  "ingredients": [
    "1 large head cauliflower, cut into bite-size pieces",
    "1 cup light sour cream",
    "1 cup shredded Cheddar cheese",
    "0.5 cup diced onion",
    "3 tablespoons melted butter",
    "2 tablespoons red pepper flakes, or to taste",
    "0.25 teaspoon salt",
    "0.5 cup panko bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil. Add cauliflower and cook uncovered until tender, about 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sour cream, Cheddar cheese, onion, melted butter, red pepper flakes, and salt in a baking dish. Mix in cauliflower. Sprinkle bread crumbs on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and cheese is melted, about 30 minutes.",
      "section": null,
