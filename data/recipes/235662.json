  "ingredients": [
    "2 (29 ounce) cans sweet potatoes, drained and mashed",
    "1 cup white sugar",
    "0.5 cup butter, melted",
    "0.5 cup milk",
    "2 eggs",
    "1 teaspoon salt",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "1 cup brown sugar",
    "1 cup chopped pecans",
    "0.33333334326744 cup butter, melted",
    "1 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x9-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XGbMmXSnewvSyT7B9aFCNiX7ht4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235662-sweet-potato-crunch-casserole-VAT-step-01-dfcb48523768402aab966d911018dfbb.jpg"
      ],
      "image": "assets/images/235662/step_01.webp"
    },
    {
      "text": "Mix sweet potatoes, white sugar, 1/2 cup butter, milk, eggs, salt, vanilla extract, and cinnamon together in a bowl until smooth; spread into the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZYLpLSbJPEAqP_l3mnGFvftrnzo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235662-sweet-potato-crunch-casserole-VAT-step-02-bf9860fcf2564bc89c74d600228dad2c.jpg"
      ],
      "image": "assets/images/235662/step_02.webp"
    },
    {
      "text": "Stir brown sugar, pecans, and 1/3 cup butter together in a bowl. Mix flour into pecan mixture using your hands until evenly coated and crumbly; sprinkle over sweet potato mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VX6vsn8_ULZfpckmFVDvrePYZVQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235662-sweet-potato-crunch-casserole-VAT-step-03-f3e462c6d5cd4a6b95123ebc8d738c2c.jpg"
      ],
      "image": "assets/images/235662/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until cooked through and praline topping is lightly browned, about 40 minutes. Cool slightly before serving, at least 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A8j_ImRLoH6E7R5EpEM59P9JVFo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235662-sweet-potato-crunch-casserole-VAT-step-04-d33a7ab25a8741fd99426bcd26867962.jpg"
      ],
      "image": "assets/images/235662/step_04.webp"
    }
