  "ingredients": [
    "1 cup softened butter",
    "0.75 cup packed brown sugar",
    "0.75 cup white sugar",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "1.25 cups almond flour",
    "1 cup coconut flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.5 cup chocolate chips, or to taste",
    "0.25 cup shredded coconut",
    "0.25 cup rolled oats"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line two baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together in a large bowl with an electric mixer until creamy. Add vanilla extract; beat in eggs, one at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almond flour, coconut flour, baking soda, and salt in a separate bowl; stir into butter mixture just until combined. Add chocolate chips, coconut, and oats; stir until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop cookie dough onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
