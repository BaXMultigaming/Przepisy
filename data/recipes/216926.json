  "ingredients": [
    "2 cups plain yogurt",
    "0.5 cup mayonnaise",
    "1 lime, juiced",
    "2 tablespoons chopped fresh cilantro",
    "1 pinch cayenne pepper, or to taste",
    "salt to taste",
    "1.5 cups shredded corned beef",
    "8 (10 inch) flour tortillas",
    "1 pound prepared coleslaw"
  ],
  "steps": [
    {
      "text": "Mix yogurt, mayonnaise, lime juice, cilantro, cayenne pepper, and salt together in a bowl until smooth. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place corned beef in a saucepan over medium-low heat; cook, stirring occasionally, just until hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While corned beef is warming, place a tortilla into a heavy skillet over medium heat until hot and just beginning to show brown spots, about 30 seconds per side. Repeat to warm remaining tortillas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange about 2 tablespoons coleslaw in the center of each tortilla; top each with about 3 tablespoons corned beef. Drizzle each taco with 2 tablespoons yogurt sauce; roll up to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
