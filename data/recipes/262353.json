  "ingredients": [
    "1 (12 ounce) package extra-firm tofu, drained",
    "0.25 cup cornstarch",
    "0.25 cup all-purpose flour",
    "1 teaspoon vegetarian chicken-flavored bouillon granules",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon cayenne pepper",
    "0.5 cup unsweetened soy milk",
    "2 tablespoons canola oil",
    "0.5 cup cayenne pepper hot sauce",
    "0.33333334326744 cup margarine, melted"
  ],
  "steps": [
    {
      "text": "Slice tofu into 6 slices. Lay flat onto a clean kitchen towel. Fold towel over to cover tofu completely. Cover with a baking sheet and set a 3- to 5-pound weight on top. Press tofu for about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornstarch, flour, bouillon, garlic powder, and cayenne powder in a shallow bowl. Pour soy milk into another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each slice of tofu in half, for 12 'wings' total. Dip each slice in soy milk; roll into the cornstarch mixture. Place coated slices on a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large saucepan over medium heat. Add the coated tofu slices. Fry, flipping halfway, until crispy on all sides, 7 to 10 minutes total. Add hot sauce and margarine to the saucepan and stir to coat the tofu.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
