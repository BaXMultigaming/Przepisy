  "ingredients": [
    "2 teaspoons olive oil",
    "6 ounces chicken tenderloin strips",
    "0.25 teaspoon salt",
    "0.125 teaspoon freshly ground black pepper",
    "2 tablespoons chopped fresh basil",
    "1.5 teaspoons honey",
    "1.5 teaspoons balsamic vinegar, or more to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a nonstick skillet over medium-high heat. Season chicken with salt and pepper. Cook and stir chicken in the hot oil until chicken is no longer pink in the center, about 3 to 5 minutes. Stir basil, honey, and balsamic vinegar into chicken and cook for 1 more minute.",
