  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 teaspoon salt",
    "2 cups white sugar",
    "1.25 cups vegetable oil",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups apples - peeled, cored, and chopped",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish lightly with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, cinnamon, nutmeg, and salt into a large bowl. Whisk in sugar, oil, eggs, and vanilla extract. Fold in apples and walnuts. Spread batter in the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
