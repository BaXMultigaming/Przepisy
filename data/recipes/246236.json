  "ingredients": [
    "9 graham cracker squares",
    "0.5 cup butter, melted",
    "0.5 cup brown sugar",
    "2 cups miniature marshmallows",
    "1.5 cups chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line an 8x8-inch square pan with aluminum foil, leaving a 1-inch overhang on sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jziU8gcaUYZElJO5UHKJaP0zUmo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246236-easy-smores-bars-VAT-001-Step-01-f623adcf95b14537956f438a7083f4a2.jpg"
      ],
      "image": "assets/images/246236/step_01.webp"
    },
    {
      "text": "Crumble graham crackers in a bag; pour into a bowl. Stir in butter and brown sugar until well mixed. Press graham cracker mixture into bottom of prepared pan to form crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cxe1mALyWYXWD8slyoX5nnPxhXs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246236-easy-smores-bars-VAT-002-Step-02-5c041064ecd24a9cb5518956c330bf25.jpg"
      ],
      "image": "assets/images/246236/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until crust is lightly browned and smells toasted, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Sya-HdDs3xigvpvNNp0cRL8scMs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246236-easy-smores-bars-VAT-003-Step-03-9d1ddda11c6845779ffef0879000abd3.jpg"
      ],
      "image": "assets/images/246236/step_03.webp"
    },
    {
      "text": "Remove the pan from the oven; cover crust evenly with marshmallows. Sprinkle chocolate chips over marshmallows.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4rYO1aWRKikB0XzMiK_mUVH4rOg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246236-easy-smores-bars-VAT-004-Step-04-28f55602a36e47aba75a00bb8df499ff.jpg"
      ],
      "image": "assets/images/246236/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until chocolate chips are melted and marshmallows are browned, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/17SDh7Rs2F21kx5K_a8MOgT0JNI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246236-easy-smores-bars-VAT-005-Step-05-a01472ab3dd243938167eadf8381c8af.jpg"
      ],
      "image": "assets/images/246236/step_05.webp"
    },
    {
      "text": "Let s'mores rest in the pan until cool, about 30 minutes. Refrigerate until set, about 45 minutes. Remove from the pan and cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HNP8DLnrz4VL-aWn1XGYXH-zs8M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246236-easy-smores-bars-VAT-006-Step-06-851db5b9d7d84f48b6ab4ab47abdc8c5.jpg"
      ],
      "image": "assets/images/246236/step_06.webp"
    }
