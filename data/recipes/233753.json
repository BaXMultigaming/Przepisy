  "ingredients": [
    "1 cup fresh raspberries",
    "1 cup applesauce",
    "0.5 cup oat bran",
    "0.5 cup white sugar",
    "1.5 cups quick-cooking oats",
    "1 cup brown sugar",
    "0.5 cup butter",
    "0.5 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix raspberries, applesauce, oat bran, and white sugar together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, brown sugar, and butter together in a bowl using a pastry blender; add flour. Continue cutting into mixture using pastry blender until crumbly. Spread half the crumb topping into the bottom of the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly browned, about 20 minutes. Remove from oven and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the raspberry filling onto the cooled crust and sprinkle with remaining crumb topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is lightly browned, about 20 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
