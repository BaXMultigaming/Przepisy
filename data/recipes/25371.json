  "ingredients": [
    "1.5 pounds skinless, boneless chicken breast meat - cubed",
    "2 green onions, chopped",
    "0.125 cup red wine vinegar",
    "0.5 lime, juiced",
    "2 cloves garlic, minced",
    "1 teaspoon dried oregano",
    "1 teaspoon white sugar",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "10 (6 inch) flour tortillas",
    "1 tomato, diced",
    "0.25 cup shredded lettuce",
    "0.25 cup shredded Monterey Jack cheese",
    "0.25 cup salsa"
  ],
  "steps": [
    {
      "text": "Sauté chicken in a medium saucepan over medium high heat until tender, about 15 to 20 minutes. Add green onions, vinegar, lime juice, garlic, oregano, sugar, salt, and pepper. Simmer over low heat for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat an iron skillet over medium heat. Place a tortilla in the pan, warm, and turn over to heat the other side. Repeat with remaining tortillas. Serve lime chicken mixture in warm tortillas topped with tomato, lettuce, cheese and salsa.",
      "section": null,
      "name": null,
