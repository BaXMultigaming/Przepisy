  "ingredients": [
    "2 cups crushed pretzels",
    "0.75 cup margarine, melted",
    "2 teaspoons white sugar",
    "1 (8 ounce) package cream cheese",
    "0.75 cup white sugar",
    "4.5 ounces frozen whipped topping, thawed",
    "1 (6 ounce) package strawberry flavored Jell-O®",
    "2 cups boiling water",
    "2 (10 ounce) packages frozen strawberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix crushed pretzels, margarine, and sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press crushed pretzel mixture into the bottom of a 9x13-inch baking dish, and bake in the preheated oven, 8 minutes. Remove from heat and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend together cream cheese and sugar. Fold in whipped topping and spread evenly over cooled pretzel mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, dissolve strawberry-flavored gelatin in boiling water. Mix in strawberries and set aside to cool for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour gelatin mixture over cream cheese mixture and refrigerate until set, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
