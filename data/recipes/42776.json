  "ingredients": [
    "1 large lemon, juiced and zested",
    "1 cup white sugar",
    "1 cup milk",
    "1 cup heavy cream, chilled"
  ],
  "steps": [
    {
      "text": "Combine zest and sugar in the bowl of a food processor; pulse until zest is very fine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir zest-sugar mixture and milk together in a bowl until sugar dissolves; stir in lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip cream in a separate bowl until stiff peaks form; gently fold into lemon mixture until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into a 9x5-inch loaf pan; cover with plastic wrap. Freeze until firm, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
