  "title": "Whole Wheat Oatmeal Chocolate Chip Muffins",
  "description": "These oat muffins are made with Greek yogurt, chocolate chips, and whole wheat flour for a healthy start to the day.",
  "authors": [
    "fabeveryday"
  ],
  "date_published": "2021-03-30T21:53:50-04:00",
