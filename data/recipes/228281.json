  "ingredients": [
    "6 red potatoes, cut into chunks",
    "0.5 pound baby carrots, halved",
    "10 skinless, boneless chicken thighs, trimmed of excess fat",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "0.125 teaspoon garlic salt",
    "2 tablespoons mashed potato flakes"
  ],
  "steps": [
    {
      "text": "Place potatoes and carrots in a slow cooker; top with chicken thighs.",
      "section": null,
      "name": null,
      "url": null,
