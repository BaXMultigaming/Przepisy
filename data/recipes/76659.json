  "ingredients": [
    "0.5 cup grated Parmesan cheese",
    "0.25 cup butter, softened",
    "3 tablespoons mayonnaise",
    "3 tablespoons chopped green onions",
    "2 tablespoons lemon juice",
    "0.25 teaspoon salt",
    "1 dash hot pepper sauce",
    "2 pounds skinless halibut fillets"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Grease a rimmed baking sheet; place halibut fillets on the sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mMWhQ4iDyzjAa97JLky2mKsJgyY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76659-HeavenlyHalibut-mfs-Step2-1129-afa7fa8bdd6c4364b341ae3183cab802.jpg"
      ],
      "image": "assets/images/76659/step_01.webp"
    },
    {
      "text": "Broil in the preheated oven until fish flakes easily with a fork, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix Parmesan cheese, butter, mayonnaise, green onions, lemon juice, salt, and hot pepper sauce in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pdCa3TxJWWW-HDkiN5fh2psKZyc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76659-HeavenlyHalibut-mfs-Step1-1118-cd8d43608bd2441983de2315afe88d39.jpg"
      ],
      "image": "assets/images/76659/step_03.webp"
    },
    {
      "text": "Remove fillets from the oven; spread Parmesan mixture over top. Return to the oven and broil until topping is bubbly and lightly browned, about 2 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MauEdqsVvE9qK7bOCZJvcO8ayNQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76659-HeavenlyHalibut-mfs-Step3-1133-5509dd6095494202a519b891fc813b10.jpg"
      ],
      "image": "assets/images/76659/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
