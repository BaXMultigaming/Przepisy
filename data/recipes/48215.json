  "steps": [
    {
      "text": "Place flour in a small bowl. Dredge chicken in the flour to lightly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil and butter in a medium skillet over medium heat, and saute the chicken breasts until no longer pink and juices run clear. Set aside, and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir hoisin sauce and orange juice into the skillet, and scrape up the browned bits. Mix in mandarin oranges, green onions, and cashews, Return chicken to the skillet. Continue cooking until all ingredients are heated through.",
