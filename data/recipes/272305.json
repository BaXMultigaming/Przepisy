  "ingredients": [
    "4 cups vegetable oil for frying",
    "1 pound squid, cleaned and sliced into rings",
    "1 tablespoon garlic powder",
    "0.5 tablespoon onion powder",
    "0.5 teaspoon sea salt",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon dried parsley",
    "0.5 teaspoon paprika",
    "0.25 teaspoon cayenne pepper, or to taste",
    "0.25 teaspoon ground white pepper",
    "0.5 cup all-purpose flour",
    "1 lemon, cut into wedges",
    "0.25 cup marinara sauce, warmed"
  ],
  "steps": [
    {
      "text": "Preheat oil to 370 degrees F (185 degrees C) in a deep fryer, deep frying pan, or pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat squid with garlic powder, onion powder, salt, oregano, basil, parsley, paprika, cayenne, and white pepper in a medium bowl. Mix thoroughly. Add flour and toss to dredge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry squid in the hot oil, in batches if needed, until light brown, 2 to 3 minutes. Do not overcook, or squid will be tough and chewy. Drain on paper towels. Serve with lemon wedges and marinara sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
