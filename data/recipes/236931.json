  "ingredients": [
    "24 frozen dinner roll dough, thawed, divided",
    "0.5 cup butter",
    "1 cup brown sugar",
    "1 (4.6 ounce) package cook-and-serve vanilla pudding mix",
    "2 tablespoons milk",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Grease a 9x13-inch baking dish. Place 12 dinner rolls in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium-low heat; stir in brown sugar, pudding mix, milk, and cinnamon until smooth. Pour brown sugar mixture over rolls; top with remaining 12 rolls. Allow rolls to rise for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until rolls are cooked through, 30 to 35 minutes. Cool before serving, 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
