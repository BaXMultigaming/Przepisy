  "ingredients": [
    "5 eggs",
    "2 cups white sugar",
    "0.75 cup buttermilk",
    "0.5 cup melted butter",
    "1 (10 ounce) package flaked coconut",
    "1 teaspoon vanilla extract",
    "2 (9 inch) unbaked pie crusts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat eggs and sugar until smooth. Blend in buttermilk and melted butter. Stir in the coconut and vanilla. Pour filling into 2 - 9 inch pie shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 to 50 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
