  "ingredients": [
    "2 tablespoons olive oil",
    "1 pound zucchini, sliced",
    "1 onion, chopped",
    "1 small green bell pepper, chopped",
    "4 hard-cooked eggs, chopped",
    "1 (7 ounce) can diced green chiles, drained",
    "1 teaspoon salt, or to taste",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon garlic powder",
    "0.125 teaspoon cayenne pepper, or to taste",
    "2 cups sour cream",
    "2 tablespoons all-purpose flour",
    "6 (6 inch) corn tortillas, cut into wedges",
    "3 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet. Add zucchini, onion, and bell pepper; cook until tender, about 5 minutes. Off heat, stir in eggs, chiles, salt, cumin, garlic powder, and cayenne pepper; set aside. Combine sour cream and flour in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer ½ corn tortillas in a 9x13-inch baking dish; spread ½ zucchini mixture and ½ sour cream mixture on top then sprinkle with ½ cheese. Repeat layers with remaining ½ each tortillas, zucchini mixture, sour cream mixture, and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese melts, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
