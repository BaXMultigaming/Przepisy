  "ingredients": [
    "0.5 cup butter, softened",
    "1 cup white sugar",
    "1 egg",
    "1 tablespoon vanilla extract",
    "1.3333333730698 cups all-purpose flour",
    "0.75 teaspoon baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar in a mixing bowl with an electric mixer until light and fluffy; beat in egg and vanilla extract. Combine flour, baking powder, and salt in a bowl and mix the dry ingredients thoroughly into butter mixture. Drop cookies about 2 inches apart, 1 teaspoon at a time, onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges of cookies are golden brown, 12 to 15 minutes. Cool cookies on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
