  "ingredients": [
    "4 tablespoons butter",
    "2 tablespoons grated onion",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground white pepper",
    "1 cup half-and-half",
    "1 cup chicken broth",
    "1 pinch dried thyme",
    "1 pinch ground cayenne pepper"
  ],
  "steps": [
    {
      "text": "Melt butter in a small saucepan over medium-low heat; stir in onion, flour, salt, and white pepper. Stir in half-and-half and chicken broth; cook, stirring frequently, at medium heat until thickened. Off heat, stir in thyme and cayenne pepper.",
