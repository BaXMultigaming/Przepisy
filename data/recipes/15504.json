  "title": "Cinnamon Sugar Biscotti",
  "description": "This cinnamon biscotti is an Italian version of cinnamon toast. Everyone is sure to enjoy these!",
  "authors": [
    "SARA LEE"
  ],
  "date_published": "2000-01-21T13:24:30-05:00",
