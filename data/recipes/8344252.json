  "ingredients": [
    "1.5 cups cornmeal",
    "1 cup buttermilk",
    "1 large egg",
    "2 tablespoons vegetable oil, or more to taste",
    "1 teaspoon salt, or to taste",
    "1 teaspoon baking powder",
    "0.25 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Oil an 8-inch cast iron skillet. Heat in the preheated oven for 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cornmeal, buttermilk, egg, oil, salt, baking powder, and baking soda together in a mixing bowl. Pour batter into the hot skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes. Remove from the oven and transfer cornbread to a serving plate.",
