  "ingredients": [
    "2 cups sifted all-purpose flour",
    "1 cup butter",
    "4 tablespoons confectioners' sugar",
    "1 cup chopped walnuts",
    "2 tablespoons water",
    "2 teaspoons vanilla extract",
    "0.33333298563957 cup confectioners' sugar for decoration",
    "30 whole cloves"
  ],
  "steps": [
    {
      "text": "Cream butter, add sugar gradually cream until smooth. Blend in flour. Stir in nuts, water, and vanilla. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape into small 1 inch balls, press down while pressing in 1 whole clove on ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 20 minutes. While still warm roll into confectioners' sugar. If desired roll again when cooled.",
      "section": null,
