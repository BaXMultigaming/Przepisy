        "https://www.allrecipes.com/thmb/riDyE0QcQemsEyAqKMoa4UQbM5U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26463-salmon-chowder-DDMFS-Step-02-4491-60cc45adb9bd48579684e0838820df21.jpg"
