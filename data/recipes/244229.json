  "ingredients": [
    "3 cups whole wheat pastry flour",
    "0.75 cup white sugar",
    "0.5 cup brown sugar",
    "0.75 cup cocoa powder",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 cups mashed very ripe bananas",
    "0.5 cup creamy peanut butter",
    "1.25 cups almond milk",
    "0.75 cup canola oil",
    "1 (10 ounce) bag semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x12-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pastry flour, white sugar, brown sugar, cocoa powder, baking powder, baking soda, and salt together in a bowl. Stir bananas and peanut butter together in a separate bowl until smooth; add almond milk and oil and mix well. Carefully fold banana mixture into flour mixture until batter is just combined; fold in chocolate chips. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
