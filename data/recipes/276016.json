  "ingredients": [
    "1 egg, lightly beaten",
    "1 tablespoon water",
    "0.5 cup all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon dried Italian seasoning",
    "0.75 cup panko bread crumbs",
    "6 mozzarella cheese sticks, cut in half, crosswise",
    "cooking spray",
    "0.75 cup marinara sauce",
    "0.25 teaspoon crushed red pepper"
  ],
  "steps": [
    {
      "text": "Whisk egg and water together in a shallow dish. Stir flour, salt, and Italian seasoning together in another shallow dish. Place bread crumbs in a third shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip cheese sticks into egg mixture, then coat with flour mixture. Dip again into egg mixture, then into bread crumbs until coated. Place on a baking sheet and freeze until firm, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 360 degrees F (180 degrees C). Lightly coat the air fryer basket with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place frozen cheese bites in a single layer in the air fryer, working in batches if necessary, being careful not to crowd.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer until golden brown and cheese just begins to melt, 4 to 6 minutes. Repeat with remaining bites.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir together marinara sauce and crushed red pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve mozzarella bites with marinara sauce.",
      "section": null,
      "name": null,
      "url": null,
