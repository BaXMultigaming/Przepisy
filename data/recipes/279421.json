  "ingredients": [
    "1 (14.1 ounce) package pastry",
    "3 cups pitted plums",
    "1 cup white sugar",
    "0.25 cup cornstarch",
    "1 teaspoon lemon juice",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon almond extract",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a 9-inch pie plate with 1 pie crust; set aside. Set remaining 1 pie crust aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss plums, sugar, cornstarch, lemon juice, vanilla extract, and almond extract together in a large bowl with a rubber spatula until well combined. Transfer to the prepared pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover filling with remaining pie crust; flute edges to seal or use a fork dipped in egg to press them down. Brush remaining egg on top crust; cut several ventilation slits in top crust to allow steam to escape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is bubbly and crust is golden brown, 35 to 40 minutes. Cool before serving for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
