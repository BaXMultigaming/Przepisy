  "ingredients": [
    "2 cups shredded sharp Cheddar cheese",
    "0.25 cup mayonnaise",
    "0.25 cup butter, softened",
    "1 (4 ounce) jar chopped pimentos, drained",
    "1 teaspoon garlic powder, or to taste",
    "0.25 teaspoon salt, or to taste",
    "0.25 teaspoon white sugar",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Beat the shredded Cheddar cheese, mayonnaise, and softened butter in a mixing bowl with a mixer on low speed until well blended. Add the pimentos, garlic powder, salt, and sugar; mix to combine. Stir in the pecans.",
