  "ingredients": [
    "2 cups frozen pineapple chunks",
    "2 cups spinach leaves, packed",
    "0.5 cup frozen mango chunks",
    "0.5 cup frozen sliced peaches",
    "1 medium firm banana, cut into 1-inch pieces",
    "1 Persian cucumber, cut into 1-inch chunks",
    "1 tablespoon chia or flax seeds",
    "2 cups coconut milk",
    "1.25 cups orange juice"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p19cPczd02gPe1h2eO_smwanU-8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8445941-make-ahead-tropical-smoothie-packs-VAT-step-01-0b22bba269ea43b7bd58b6bc72b13f36.jpg"
      ],
      "image": "assets/images/8445941/step_01.webp"
    },
    {
      "text": "Place pineapple, spinach, mango, peaches, banana, cucumber and chia seeds in a large resealable plastic bag or lidded container. Squeeze out the air. Freeze for up to 1 month.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n3sRjdsC_KYsT8ifWkfjb9nQsjM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8445941-make-ahead-tropical-smoothie-packs-VAT-step-02-279dd45974234ed9bd78574e33d09701.jpg"
      ],
      "image": "assets/images/8445941/step_02.webp"
    },
    {
      "text": "When ready to blend, add contents of bag to blender. Add coconut milk and orange juice and blend on high until mixture is smooth. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7wppbyHka9MSOHdFXflMolRO6rY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8445941-make-ahead-tropical-smoothie-packs-VAT-step-03-2-ff7e83d4a36546029fafaace075cc32c.jpg"
