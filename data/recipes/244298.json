  "ingredients": [
    "1 pound ground beef",
    "1 (15.25 ounce) can corn",
    "1 (8 ounce) jar salsa",
    "1 ounce processed cheese (such as Velveeta®)",
    "1 ounce cream cheese",
    "1 package taco seasoning mix",
    "1 (16 ounce) package frozen bite-size potato nuggets (such as Tater Tots®)",
    "1 (4 ounce) can sliced black olives",
    "1 (4 ounce) can diced jalapeno peppers",
    "4 ounces shredded Cheddar cheese",
    "1 (8 ounce) container sour cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Add corn, salsa, processed cheese, cream cheese, and taco seasoning to ground beef and stir until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread beef mixture over bottom of 9x13-inch baking dish. Arrange potato nuggets over beef mixture, sprinkle black olives, jalapenos, and Cheddar cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until potato nuggets are crisp and cheese is bubbly, about 25 minutes. Garnish with sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
