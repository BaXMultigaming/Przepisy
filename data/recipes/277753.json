  "ingredients": [
    "2 cups nonfat dry milk powder",
    "0.5 cup low-fat powdered non-dairy creamer",
    "0.5 cup unsweetened cocoa powder",
    "1 tablespoon granular sweetener (such as Equal®)",
    "0.75 teaspoon ground cinnamon"
  ],
