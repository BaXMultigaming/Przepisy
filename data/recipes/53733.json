  "ingredients": [
    "0.5 teaspoon dried thyme, crushed",
    "0.5 teaspoon dried sage, crushed",
    "0.25 teaspoon salt",
    "0.25 teaspoon pepper",
    "4 (4 ounce) boneless pork loin chops",
    "1 tablespoon butter",
    "1 tablespoon olive oil",
    "0.25 cup seedless raspberry jam",
    "2 tablespoons orange juice",
    "2 tablespoons white wine vinegar",
    "4 sprigs fresh thyme"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 200 degrees F (95 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine thyme, sage, salt, and pepper in a small bowl. Rub evenly over pork chops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter and olive oil in a nonstick skillet. Cook pork chops in the hot butter and oil until a instant-read thermometer inserted into the center reads 145 degrees F (63 degrees C), 4 to 5 minutes per side. Transfer pork chops to an oven-safe plate and keep warm in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine raspberry jam, orange juice, and vinegar in the same skillet. Bring to a boil and cook until slightly thickened, 2 to 3 minutes. Sauce will thicken as it cools.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon sauce in a pool onto a serving plate and top with pork chops. Garnish with thyme sprigs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
