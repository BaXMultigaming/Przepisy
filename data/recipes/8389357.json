  "ingredients": [
    "0.25 cup apple cider vinegar",
    "1 tablespoon freshly squeezed lemon juice",
    "1.5 teaspoons honey, or to taste",
    "1 teaspoon Dijon mustard",
    "0.5 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon oregano",
    "0.125 teaspoon freshly ground black pepper",
    "0.33 cup extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "Combine apple cider vinegar, lemon juice, honey, mustard, salt, garlic powder, onion powder, oregano, and pepper in a small jar. Place lid on tightly and shake until ingredients are well combined. Pour in olive oil, and shake jar again to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use immediately or keep extra stored in the fridge. Shake jar again before using.",
