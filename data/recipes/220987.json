  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "0.5 cup ancho chile powder",
    "0.25 cup white sugar",
    "0.25 cup brown sugar",
    "0.25 cup salt",
    "2 tablespoons freshly ground black pepper",
    "1 tablespoon ground cumin",
    "1 teaspoon dry mustard",
    "1 teaspoon ground cayenne pepper",
    "0.5 teaspoon ground dried chipotle pepper",
    "1 rack baby back pork ribs",
    "1 cup barbeque sauce"
  ],
  "steps": [
    {
      "text": "Gather ingredients and preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/De4-v_lqXF1eZbwH9TB3QL09-oU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220987-Baked-BBQ-Baby-Back-Ribs-mfs-STEP-001-fbd31f2e98334fd6bf9190256b6c8e74.jpg"
      ],
      "image": "assets/images/220987/step_01.webp"
    },
    {
      "text": "Mix ancho chile powder, white and brown sugars, salt, black pepper, cumin, dry mustard, cayenne, and chipotle pepper in a small bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6shwN6q8wQ5oUvxDQz_ENkYiDLk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220987-Baked-BBQ-Baby-Back-Ribs-mfs-STEP-005-a10c457ff718490e8f2359f1ac758d7f.jpg"
      ],
      "image": "assets/images/220987/step_02.webp"
    },
    {
      "text": "Place rib rack, meat-side down, on heavy-duty aluminum foil. Prick back of the rack several times with a knife. Generously apply a coating of dry rub to all sides of the rack. Store any remaining dry rub in an airtight container for future use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oOhveQy9BoreUE8L-ZSr2bhLkLg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220987-Baked-BBQ-Baby-Back-Ribs-mfs-STEP-006-282a7c438caf4aa19e891ef07170f25a.jpg"
      ],
      "image": "assets/images/220987/step_03.webp"
    },
    {
      "text": "With the meat facing down, fold foil around the rack to create a tight seal. Transfer to a sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aQHFMKNkwXTj9-M8MCCLKwiqbzc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220987-Baked-BBQ-Baby-Back-Ribs-mfs-STEP-008-bd4303d6ef47482db1430d41b521d505.jpg"
      ],
      "image": "assets/images/220987/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until tender and cooked through, about 2 hours. Remove and cool 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase oven temperature to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Open foil, drain and discard any accumulated juices and fat. Brush barbeque sauce on all sides of the rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gI8aExK8d4S7unAa8dxla9rdqic=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220987-Baked-BBQ-Baby-Back-Ribs-mfs-STEP-012-d235949998b5432ca8fd41780b810250.jpg"
      ],
      "image": "assets/images/220987/step_07.webp"
    },
    {
      "text": "Turn the rack on the foil so the meat is facing up. Return to the oven, leaving the foil open and bake for 10 minutes. Remove from the oven and brush another layer of barbeque sauce on the meat side only. Repeat baking and brushing with sauce 4 more times, for a total of 50 minutes baking time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9vWz4-6E3qGQ2NpWWkuibjiC1vo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220987-Baked-BBQ-Baby-Back-Ribs-mfs-STEP-015-fd242cdbd78a46c695230aa719e55e6f.jpg"
      ],
      "image": "assets/images/220987/step_08.webp"
    },
    {
      "text": "Cut rack into individual rib segments and serve with more barbeque sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I2ENWJQG1mb2b5OSXPqQudzlzJw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220987-Baked-BBQ-Baby-Back-Ribs-mfs-041-77a42b0ce0f0424e9aeec2b22664f1aa.jpg"
      ],
      "image": "assets/images/220987/step_09.webp"
    }
  ],
