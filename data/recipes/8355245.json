  "ingredients": [
    "2 tablespoons olive oil",
    "1 (5.2 ounce) container Boursin cheese",
    "2 cups cherry tomatoes",
    "1 teaspoon granulated garlic",
    "salt and ground black pepper to taste",
    "0.75 pound frozen Italian-style meatballs",
    "2 cups penne pasta"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour olive oil into a 9-inch square baking dish. Place Boursin cheese in the middle of the dish. Add cherry tomatoes around the cheese, then sprinkle garlic, salt, and pepper over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Remove from the oven; crush the tomatoes and mix with the melted cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add frozen meatballs and return to the oven; bake until meatballs are heated through, about 15 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove meatballs and tomato mixture from the oven. Add pasta and mix until well combined. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
