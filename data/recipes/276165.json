  "ingredients": [
    "8 ounces fresh green beans, trimmed and cut into 2-inch pieces",
    "2 cups Brussels sprouts, trimmed and cut in half if large",
    "2 cups cauliflower florets",
    "2 teaspoons chopped fresh rosemary",
    "2 teaspoons chopped fresh basil",
    "2 teaspoons chopped fresh oregano",
    "0.25 teaspoon kosher salt",
    "0.125 teaspoon freshly ground black pepper",
    "2 tablespoons extra-virgin olive oil",
    "2 tablespoons water",
    "aluminum foil",
    "3 red bell peppers, seeded and cut into strips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place green beans, Brussels sprouts, and cauliflower in a shallow roasting pan. Sprinkle with rosemary, basil, oregano, salt, and pepper; drizzle with olive oil and water. Cover pan with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 20 minutes. Remove foil and stir in bell peppers. Return to the oven and cook, uncovered, until vegetables are crisp-tender, about more 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
