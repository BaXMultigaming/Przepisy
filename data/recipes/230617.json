  "title": "Potato Fish Chowder",
  "description": "This creamy fish soup with potatoes is made with cod, potatoes, and clam juice. A warm bowl of chowder is comforting on a cold winter day.",
  "authors": [
    "Donna Nagel Roberts"
  ],
  "date_published": "2019-04-03T23:54:21-04:00",
