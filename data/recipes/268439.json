  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "0.5 cup canola oil",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 (19 ounce) package gluten-free yellow cake mix",
    "0.5 cup yellow cornmeal",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon pumpkin pie spice",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat pumpkin puree, oil, egg, and vanilla extract together in a large bowl. Add cake mix, cornmeal, cinnamon, pumpkin pie spice, and salt and mix well. Pour into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the center of the preheated oven until edges are browned and a knife inserted in the center comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
