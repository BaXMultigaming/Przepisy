  "ingredients": [
    "1 pound blanched almonds",
    "1 (16 ounce) package confectioners' sugar",
    "3 large egg whites",
    "1 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Grind almonds in a blender. Mix confectioners' sugar into almonds until combined. Beat egg whites slightly in a separate bowl, then mix into almond mixture. Use your hands to blend in almond extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form paste into a log, wrap tightly in plastic, and store in an airtight container in the refrigerator for up to 1 week or in the freezer for up to 3 months.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
