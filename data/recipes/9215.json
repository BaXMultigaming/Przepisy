  "ingredients": [
    "4 turkey legs",
    "1 cup olive oil",
    "2 green bell peppers",
    "1 large white onion",
    "2 tablespoons salt",
    "1 pinch ground black pepper",
    "1 teaspoon dried oregano",
    "2 tablespoons distilled white vinegar",
    "5 slices bacon",
    "2 tablespoons teriyaki sauce"
  ],
  "steps": [
    {
      "text": "Make numerous vertical slits in the turkey legs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl combine olive oil, salt, pepper, teriyaki sauce, vinegar, and oregano. Add turkey legs and toss to coat. Let marinate while you prepare vegetables and bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut onion, green pepper, and bacon into small squares (approximately the same size as the slits in the legs).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each slit with one piece of pepper, onion, and bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "After the legs are stuffed, brown them in the oil mixture on medium-high heat for 5 minutes. Reduce the temperature to low and cover. Cook for 40 to 45 minutes or until the meat starts to separate from the bone. If the legs dry out when cooking, add a little water to the skillet and lower the temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
