  "ingredients": [
    "2 teaspoons garlic powder",
    "1.5 teaspoons smoked paprika",
    "1 teaspoon cayenne pepper",
    "1 teaspoon chili powder",
    "1 teaspoon ground cumin",
    "0.5 teaspoon brown sugar",
    "salt and ground black pepper to taste",
    "3 (4 ounce) fillets flounder",
    "1 tablespoon olive oil, or as needed",
    "6 (6 inch) corn tortillas",
    "0.5 (8 ounce) package coleslaw mix",
    "0.5 cup chopped cilantro",
    "2 medium limes, juiced",
    "salt and ground black pepper to taste",
    "1 large avocado, diced",
    "0.5 cup chopped cilantro",
    "0.25 cup water",
    "2 medium limes, juiced",
    "3 tablespoons mayonnaise",
    "2 teaspoons Dijon mustard",
    "salt and ground black pepper to taste",
    "0.5 tablespoon chopped pickled jalapeno peppers"
  ],
  "steps": [
    {
      "text": "Combine garlic powder, paprika, cayenne pepper, chili powder, cumin, brown sugar, salt, and black pepper in a small bowl. Rub the mixture on both sides of the fish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Place fish in the hot skillet and cook until the outside has browned and fish is flaky, 4 to 5 minutes per side. Remove from heat and break fillets into pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tortillas in the same skillet over low heat until warm, about 30 seconds per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare coleslaw: Combine coleslaw mix, cilantro, lime juice, salt, and pepper in a bowl and mix until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare avocado sauce: Combine avocado, cilantro, water, lime juice, mayonnaise, Dijon mustard, salt, and pepper in a blender or food chopper; blend until smooth. Stir in jalapenos.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Evenly distribute the fish into each tortilla, add in some slaw, and top with a heaping spoon of the avocado sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
