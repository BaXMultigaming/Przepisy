  "ingredients": [
    "4 cups egg noodles",
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup brown sugar, or more to taste",
    "1 (16 ounce) package cottage cheese",
    "1 egg",
    "2 egg whites",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "2 firm, tart apples - cored, quartered, and thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook egg noodles in the boiling water, stirring occasionally until cooked through but firm to the bite, about 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and brown sugar together in a bowl using an electric mixer until smooth and creamy; beat in cottage cheese, egg, egg whites, vanilla extract, cinnamon, and nutmeg until well combined. Fold noodles and apples into cheese mixture by hand; spread into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until kugel is lightly browned and firm, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
