  "ingredients": [
    "2 teaspoons Italian seasoning",
    "1 teaspoon garlic powder",
    "0.5 teaspoon seasoning salt",
    "0.5 teaspoon mustard powder",
    "0.5 teaspoon ground black pepper",
    "1 (3 pound) whole chicken",
    "2 lemons",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Italian seasoning, garlic powder, seasoning salt, mustard powder, and black pepper in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove giblets from chicken cavity; rinse chicken thoroughly. Place chicken in a 9x13-inch baking dish. Sprinkle 1 ½ teaspoons spice mixture in chicken cavity; rub remaining spice mixture on outside of chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine lemon juice and olive oil in a small bowl; drizzle over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the juices run clear, about 1 ½ hours, basting several times with remaining lemon-oil mixture. An instant-read thermometer inserted into the thickest part of the thigh, near but not touching the bone, should read at least 165 degrees F (74 degrees C).",
