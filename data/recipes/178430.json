  "ingredients": [
    "1 (16 ounce) package farfalle (bow tie) pasta",
    "0.5 cup butter",
    "2 cloves garlic, minced",
    "0.25 cup olive oil",
    "1 large head green cabbage, shredded",
    "salt and pepper to taste",
    "1 pound smoked sausage, sliced",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil over high heat. Once the water is boiling, stir in the bow tie pasta and return to a boil. Cook the pasta uncovered, stirring occasionally, until the pasta has cooked through, but is still firm to the bite, about 12 minutes. Drain well in a colander set in the sink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butter in a large pot over medium heat. Add the garlic, olive oil, and cabbage; season with salt and pepper; cook until tender, about 15 minutes. Stir in the sausage and bow tie pasta; cook until completely heated, about 5 minutes more. Top with Parmesan cheese and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
