  "ingredients": [
    "2 (8 ounce) containers mascarpone cheese",
    "2 cups pumpkin puree",
    "0.5 cup white sugar",
    "1 tablespoon ground cinnamon",
    "2 apples, peeled and mashed",
    "1 teaspoon frozen orange juice concentrate"
  ],
  "steps": [
    {
      "text": "Mix mascarpone cheese, pumpkin puree, and cinnamon together in a bowl; add mashed apples and orange juice concentrate and stir until smooth. Refrigerate dip until chilled, about 1 hour.",
