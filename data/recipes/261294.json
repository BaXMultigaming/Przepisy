  "ingredients": [
    "2 tablespoons extra virgin olive oil",
    "1 large sweet onion, chopped",
    "7 ripe mangoes, cored and chopped",
    "1 fresh peach, chopped",
    "0.33333334326744 cup honey",
    "15 habanero peppers, stemmed, or more to taste",
    "0.25 cup yellow mustard",
    "2.5 tablespoons salt",
    "2.5 tablespoons paprika",
    "1.5 tablespoons ground white pepper",
    "1 tablespoon ground cumin",
    "0.33333334326744 teaspoon ground allspice",
    "0.25 cup light brown sugar",
    "1.5 cups white vinegar",
    "0.5 cup apple cider vinegar"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a skillet over medium heat. Add onion; cook and stir until translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the onion, mangoes, peach, honey, habanero peppers, and mustard in a food processor. Process until smooth; mix in salt, paprika, white pepper, cumin, and allspice. Add brown sugar; continue to process until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mango-habanero mixture into a large saucepan. Bring to a boil. Add white vinegar and apple cider vinegar, stirring frequently until thoroughly combined. Boil until thickened, 10 to 12 minutes. Pour sauce into jars or containers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
