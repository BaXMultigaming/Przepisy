  "title": "Cheese Sauce for Pretzels",
  "description": "Make your own cheese sauce for pretzels in a few minutes. A great dip and leftovers keep in the fridge for a few days.",
  "authors": [
    "lutzflcat"
  ],
  "date_published": "2022-08-01T11:59:07-04:00",
