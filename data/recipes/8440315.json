  "ingredients": [
    "1 tablespoon unsalted butter",
    "1 tablespoon all-purpose flour",
    "1 cup whole milk, or more as needed",
    "1 teaspoon spicy brown mustard",
    "0.5 teaspoon Worcestershire sauce",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "2 cups shredded extra-sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Melt butter in a small saucepan over medium heat until a pinch of flour sprinkled into the oil will just begin to bubble. Whisk in flour to form a thick paste the consistency of cake frosting, stirring constantly for 30 seconds to 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the milk, mustard, Worcestershire, garlic powder, and salt. Cook until mixture starts to bubble and thicken, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and gradually stir in Cheddar cheese until melted and smooth. Keep in mind that the sauce will thicken as it cools, so if necessary, add a little more milk to reach dipping consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
