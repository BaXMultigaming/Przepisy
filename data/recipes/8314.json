      ],
      "image": "assets/images/8314/step_01.webp"
    },
    {
      "text": "Whisk heavy cream and half-and-half together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yljASe5NRfHoFJGqOqHHLyujz3U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-8314-Vanilla-Ice-Cream-gw-ddmfs-4x3-step-02-bb49c11e67be4f9188ab4c2ed1209549.jpg"
      ],
      "image": "assets/images/8314/step_02.webp"
    },
    {
      "text": "Gradually whisk in sugar until blended, then whisk in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pqN8AJuCFOxVRaVZM_RUNqiwvD4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-8314-Vanilla-Ice-Cream-gw-ddmfs-4x3-step-03-2-11a33a994ca04fd987d7f471d4c3cc64.jpg"
      ],
      "image": "assets/images/8314/step_03.webp"
    },
    {
      "text": "Cover and refrigerate until very cold, at least 3 hours or up to 3 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2DTEKPAs-0L8hG1ExhgVjQOwXkU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-8314-Vanilla-Ice-Cream-gw-ddmfs-4x3-step-04-a84e908563674a98ad06e0fe86d3b30e.jpg"
      ],
      "image": "assets/images/8314/step_04.webp"
    },
    {
      "text": "Remove from the refrigerator and whisk mixture to blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DmWpuVFK4161W-ByrjdpNH9XLlQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-8314-Vanilla-Ice-Cream-gw-ddmfs-4x3-step-05-cab9860e9a404b1289dd1ed8d69e989b.jpg"
      ],
      "image": "assets/images/8314/step_05.webp"
    },
    {
      "text": "Pour into an ice cream maker and freeze according to the manufacturer's instructions, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0gBrmLnGCL3auu3pP3VKLiXN8dM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-8314-Vanilla-Ice-Cream-gw-ddmfs-4x3-step-06-e29a951436044bbfb60a6816ee8fb2d3.jpg"
