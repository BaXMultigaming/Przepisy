  "ingredients": [
    "1 (5 ounce) skinless, boneless chicken breast",
    "2 tablespoons Italian dressing",
    "1 (1 pound) loaf frozen bread dough, thawed",
    "0.33333334326744 cup Alfredo sauce",
    "1 (8 ounce) package shredded mozzarella cheese",
    "0.5 cup sliced fresh mushrooms",
    "3 slices bacon, cooked and crumbled"
  ],
  "steps": [
    {
      "text": "Place chicken in a shallow bowl. Cover with Italian dressing and let marinate for 10 minutes. Slice chicken across the grain into 1/8-inch-thick pieces; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide bread dough into 2 equal pieces. Roll each into a 9-inch circle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread Alfredo sauce evenly over each dough circle. Cover with 1/2 of the mozzarella cheese. Arrange chicken, mushrooms, and bacon on top. Sprinkle with remaining mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 pizza in a Panasonic CIO. Press \"Auto Cook\" and select the \"Frozen Pizza, 9-inch Size\" setting. Allow pizza to cook until the timer goes off, about 13 minutes. Repeat with second pizza.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
