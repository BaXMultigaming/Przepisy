  "title": "Apple Pancakes",
  "description": "These apple pancakes are made with a simple pancake batter loaded with freshly grated apple and cinnamon. Perfect for a fall breakfast or brunch.",
  "authors": [
    "Veronica Martin"
  ],
  "date_published": "2000-08-05T19:37:15-04:00",
