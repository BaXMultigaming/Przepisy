  "ingredients": [
    "cooking spray",
    "1 spaghetti squash, halved and seeded",
    "0.25 cup butter or margarine",
    "1 small onion, chopped",
    "2 cloves garlic, finely chopped",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Coat a baking sheet with cooking spray, and place squash halves cut-side down on the sheet. Bake until squash is tender but still crunchy, about 40 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once cool enough to handle, shred squash flesh from rind using a fork. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Cook onion and garlic in butter until soft. Add squash to the skillet, and cook until hot. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
