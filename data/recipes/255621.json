  "ingredients": [
    "cooking spray",
    "3.5 cups unbleached all-purpose flour",
    "3 tablespoons ground cinnamon",
    "1.5 tablespoons ground nutmeg",
    "2 teaspoons ground cloves",
    "1 teaspoon ground ginger",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.5 teaspoon baking powder",
    "2 cups dark brown sugar",
    "1 cup white sugar",
    "1 cup unsweetened applesauce",
    "4 eggs, lightly beaten",
    "1 (15 ounce) can solid-pack pumpkin",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 2 loaf pans with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, cinnamon, nutmeg, cloves, ginger, baking soda, salt, and baking powder together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, white sugar, applesauce, and eggs in a large bowl. Add pumpkin and mix well. Add flour mixture alternately with water, mixing well between additions. Divide between the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake loaves in the preheated oven until a toothpick inserted into the center comes out clean, 60 to 65 minutes. Cool in pans for 10 minutes. Invert onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
