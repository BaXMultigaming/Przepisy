  "ingredients": [
    "1 pound summer squash, sliced",
    "0.25 cup butter",
    "0.25 cup chopped green bell pepper",
    "1 tablespoon white sugar",
    "0.5 cup chopped onion",
    "1 egg",
    "0.5 cup mayonnaise",
    "salt and pepper to taste",
    "0.5 cup shredded Cheddar cheese",
    "0.5 cup pecans, chopped",
    "0.5 cup bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to boil. Add squash, and cook until tender. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place squash in a large mixing bowl. Add butter, reserving 1/2 tablespoon, to the squash and mash well. Mix bell pepper, sugar, onion, egg, mayonnaise, salt and pepper, cheese and nuts to the mixture. Transfer the mixture to a 1-quart casserole dish. Top with bread crumbs. Dot with the reserved butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
