  "ingredients": [
    "24 (1/4-inch thick) baguette slices",
    "0.5 cup extra virgin olive oil",
    "0.75 pound Smithfield Ham slices, cut into 24 pieces",
    "9 ounces Brie cheese, sliced and cut into 24 pieces",
    "0.25 cup fig jam"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F. Lightly brush both sides of baguette slices with oil and place slightly spaced on rimmed baking pans. Bake for 10-12 minutes or until lightly browned and crisp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top each slice with ham and Brie and bake for an additional 5-8 minutes or until Brie has just begun to melt. Top each crostini with fig jam and serve warm for best flavor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
