  "ingredients": [
    "1.5 cups chicken stock",
    "1 tablespoon vegetable oil",
    "0.25 cup finely diced onion",
    "1 bay leaf",
    "1 cup uncooked basmati rice",
    "salt to taste",
    "1 tablespoon unsalted butter"
  ],
  "steps": [
    {
      "text": "Heat chicken stock in a saucepan until boiling; keep hot until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a 2 quart saucepan over medium-high heat. Cook and stir onion and bay leaf in the hot oil until onion is tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir basmati rice into onion mixture until rice is coated with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour hot chicken stock into the rice mixture. Season with salt; stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring rice mixture to a boil; cover and reduce heat to medium-low. Continue simmering until rice is tender and liquid is absorbed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove saucepan from heat and discard bay leaf. Add butter and fluff the rice with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
