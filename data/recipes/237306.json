  "ingredients": [
    "1 pound chicken livers - rinsed, trimmed, and patted dry",
    "1.5 tablespoons olive oil",
    "2 teaspoons lemon juice",
    "0.5 teaspoon salt, or to taste",
    "6 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Heat a skillet over medium heat. Add livers and sauté in the dry skillet until cooked through, 3 to 5 minutes. Gently stir in oil, lemon juice, and salt until livers are well coated. Remove from the heat and sprinkle with garlic.",
