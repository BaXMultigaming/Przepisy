  "title": "Crispy Garlic Crumb Steak",
  "description": "Try this crispy garlic crumb steak that's prepared without any actual breading. This preparation is a great way to make a cheaper, tougher cut of meat taste tender and delicious.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-09-30T09:00:00-04:00",
  "date_modified": "2025-10-29T11:53:24-04:00",
  "prep_time": "PT10M",
  "cook_time": "PT5M",
  "total_time": "PT15M",
  "yield": [
    "2"
  ],
