    "Dinner"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "0.5 cup panko bread crumbs",
    "5 tablespoons olive oil, divided",
    "2 cloves garlic, crushed",
    "1 pound top-sirloin steak, trimmed",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2dE-aJXRXD59OdsDSpDXnPLCuqE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486795-crispy-garlic-crumb-VAT-step-01-199fcabbd6ff4d95849f902e3bc9fec9.jpg"
      ],
      "image": "assets/images/8486795/step_01.webp"
    },
    {
      "text": "Put breadcrumbs in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DMXQp1DUkpsbziXrSuhGusXk-f4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486795-crispy-garlic-crumb-VAT-step-02-a6985948abf143dd94f3d7242c810f24.jpg"
      ],
      "image": "assets/images/8486795/step_02.webp"
    },
    {
      "text": "Combine 3 tablespoons olive oil and garlic in a skillet and heat over medium heat until garlic sizzles, 20 to 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cUT8xIbfaOxziVHxO08-YdO1JVI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486795-crispy-garlic-crumb-VAT-step-03-9d2cedc166cc4c5f95c0a00f90d64051.jpg"
      ],
      "image": "assets/images/8486795/step_03.webp"
    },
    {
      "text": "Strain olive oil into the breadcrumbs and mix to combine to create garlic crumbs. Allow garlic crumbs to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ir8vgGUBUQEld0c9BH126ieaOoY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486795-crispy-garlic-crumb-VAT-step-04-dbdad115e27c4274ad9fa4f2ab864950.jpg"
      ],
      "image": "assets/images/8486795/step_04.webp"
    },
    {
      "text": "Cut the steak into two (8-pounce) portions. Place one of the steaks onto a piece of plastic wrap and fold wrap over to cover meat. Pound with a tenderizer or another heavy object to 1/4 inch thickness. Repeat with the second steak.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oUi6WoRIXMJJHj7uvWBpUItzjVM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486795-crispy-garlic-crumb-VAT-step-05-96446c0c5de84cfb96883d2241337da4.jpg"
      ],
      "image": "assets/images/8486795/step_05.webp"
    },
    {
      "text": "Season on both sides with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iz-y6OdoyTRHARamiW7xLplOLkE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486795-crispy-garlic-crumb-VAT-step-06-b5132c5e46074120a40baa9473fac42f.jpg"
      ],
      "image": "assets/images/8486795/step_06.webp"
    },
    {
      "text": "Spoon cooled garlic crumb over the flattened steak to cover the surface up to the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/490M_ADCdkEOalCgF_7ungPRRW8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486795-crispy-garlic-crumb-VAT-step-07-3c9f7c3fda204967a3aea00a19aee06a.jpg"
      ],
      "image": "assets/images/8486795/step_07.webp"
    },
    {
      "text": "Fold over plastic wrap and pound again to drive garlicky breadcrumbs into the steak. Flip steak over and repeat process on the other side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/khJGYSeS-tQKyMuvOahexfyCxzg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486795-crispy-garlic-crumb-VAT-step-08-da7afb6feaec4a0b9cbec2c4ba361510.jpg"
      ],
      "image": "assets/images/8486795/step_08.webp"
    },
    {
      "text": "Heat remaining 2 tablespoon olive oil in a skillet over medium-high heat. Once hot, add steak and cook until meat starts to sizzle, 1 to 2 minutes. Reduce heat to medium and cook about 2 minutes per side for medium to medium-rare. An instant-read thermometer inserted into the center should read 130 to140 degrees F (54 to 60 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Kqy2vMI_WSeXggLl99vomhk3rFs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486795-crispy-garlic-crumb-VAT-step-09-de8c7d0a1ef14c4f9376889eff477e14.jpg"
      ],
      "image": "assets/images/8486795/step_09.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Oe9cUzZy0L9pu3-t_zgNWyQ4-Dk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8486795-crispy-garlic-crumb-VAT-4x3-02-91a7632efe59493eb674ac8012f1457b.jpg"
      ],
      "image": "assets/images/8486795/step_10.webp"
    }
  ],
