  "ingredients": [
    "4 large potatoes, peeled and sliced",
    "1 small onion, finely chopped",
    "1.5 cups shredded Cheddar cheese",
    "1 teaspoon margarine",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Layer potatoes, onion, cheese, salt and pepper into a microwave-safe casserole dish. Once finished layering, place 1 teaspoon of butter on the top of the uppermost layer. Cover and cook in the microwave oven on High for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the dish from the microwave and stir before cooking for another 10 minutes or until done. Stir well and serve.",
