  "ingredients": [
    "1.5 cups fresh pearl onions",
    "2 cups fresh or frozen peas",
    "1 tablespoon margarine or butter",
    "1 cup heavy cream",
    "0.25 teaspoon salt",
    "0.25 teaspoon pepper",
    "0.125 teaspoon onion powder",
    "0.125 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Bring a pot of water to a boil. Add pearl onions and cook for 3 minutes. Drain and rinse under cold water. Peel onions and remove the ends.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place onions back into the pot. Add peas and fill with just enough water to cover. Simmer until tender, about 10 to 12 minutes. Drain and transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt margarine in the same pot over medium-high heat. Add cream, salt, pepper, onion powder, and garlic powder; bring to a boil. Cook, stirring constantly, until sauce thickens, about 5 minutes. Add peas and onions and stir until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
