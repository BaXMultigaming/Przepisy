  "ingredients": [
    "1 (12 ounce) package fresh cranberries",
    "1 cup freshly squeezed orange juice",
    "1 cup brown sugar",
    "0.5 cup red wine",
    "1 cinnamon stick",
    "2 whole star anise pods",
    "0.25 teaspoon ground nutmeg",
    "1 dash ground cloves"
  ],
  "steps": [
    {
      "text": "Mix cranberries, orange juice, and brown sugar in a saucepan over low heat. Bring to a simmer; cook and stir until sugar has dissolved, about 5 minutes. Add wine, cinnamon, star anise, nutmeg, and cloves. Mix well. Continue simmering until sauce starts to thicken, about 10 minutes.",
