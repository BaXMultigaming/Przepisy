  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "1 cup crushed pineapple",
    "2 eggs",
    "1 teaspoon baking soda",
    "1 pinch salt",
    "1 cup white sugar",
    "1 (5 ounce) can evaporated milk",
    "0.5 cup butter",
    "1 cup sweetened flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, 2 cups white sugar, pineapple, eggs, baking soda, and salt together in a bowl until evenly combined; pour into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cake comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup sugar, evaporated milk, and butter together in a saucepan; bring to a boil. Boil mixture for 1 minute; stir in coconut. Pour mixture evenly over hot cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
