  "ingredients": [
    "2 cups water",
    "1 teaspoon kosher salt",
    "1 cup long-grain white rice",
    "1 tablespoon butter",
    "0.5 cup chopped cilantro",
    "2 tablespoons fresh lime juice",
    "1 teaspoon lime zest"
  ],
