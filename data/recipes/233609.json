  "ingredients": [
    "1 (3 pound) beef brisket",
    "0.5 teaspoon seasoned salt",
    "0.25 teaspoon ground black pepper",
    "2 tablespoons olive oil",
    "2 large onions, sliced",
    "3 cloves garlic, minced",
    "1 cup beef broth",
    "1 cup ketchup",
    "0.33333334326744 cup packed brown sugar",
    "0.33333334326744 cup cider vinegar",
    "3 tablespoons chili powder",
    "2 bay leaves",
    "0.25 teaspoon cayenne pepper",
    "0.25 cup cold water",
    "3 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Sprinkle brisket with seasoned salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a Dutch oven over medium-high heat. Sear brisket in hot oil until browned on both sides, then transfer to a large plate. Cook and stir onions and garlic in the Dutch oven until vegetables are softened, about 6 minutes. Return brisket to the Dutch oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk beef broth, ketchup, brown sugar, vinegar, chili powder, bay leaves, and cayenne pepper together in a bowl; drizzle over brisket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring mixture to a boil, then reduce the heat to low, cover, and simmer until beef is very tender and easily falls apart when pulled with a fork, 2 1/2 to 3 hours. Remove and discard bay leaves. Transfer beef to a platter, reserving liquid in the Dutch oven. Slice beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk water and flour together in a small bowl; stir into the Dutch oven and bring to a boil until sauce is thickened. Serve sauce over sliced brisket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
