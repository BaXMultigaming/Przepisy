  "ingredients": [
    "1 sheet Reynolds Wrap® 18-inch Wide Heavy Duty Aluminum Foil",
    "2.5 cups chopped cooked chicken",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 cup sour cream, divided",
    "1.5 cups shredded Cheddar cheese",
    "0.25 cup chopped cilantro",
    "12 (6 inch) flour tortillas",
    "1.5 cups salsa"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Line a large baking pan with Reynolds Wrap® 18-inch Wide Heavy Duty Aluminum Foil. Grease or spray foil to prevent sticking. Combine chicken and soup with half of sour cream, cheese and cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon 1/4 cup chicken mixture down center of each tortilla roll up. Place, seam sides down, in foil lined pan. Top with salsa and remaining cheese. Cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 15 minutes remove foil. Continue baking 10 minutes or until cheese is melted. Top with cilantro and sour cream.",
      "section": null,
      "name": null,
      "url": null,
