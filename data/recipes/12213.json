  "ingredients": [
    "20 chocolate wafer cookies, finely crushed",
    "0.25 cup butter, melted",
    "2 bananas, sliced",
    "1 quart strawberry ice cream, softened",
    "1 (20 ounce) can crushed pineapple, drained",
    "1 cup heavy whipping cream",
    "0.25 cup chopped walnuts",
    "0.25 cup maraschino cherries"
  ],
  "steps": [
    {
      "text": "Mix cookie crumbs with melted butter. Press into a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bananas over bottom of crust. Spread ice cream in an even layer over bananas. Top with drained pineapple. Whip the cream and spread over top. Sprinkle with nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pie in freezer for 4 hours or until firm. Garnish with cherries, if desired. Makes 8 servings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
