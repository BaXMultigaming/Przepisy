  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1 cup white sugar",
    "1 cup brown sugar",
    "1 cup shortening",
    "2 large eggs",
    "2 cups rolled oats",
    "1 cup cornflakes cereal",
    "1 cup Spanish peanuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, and baking powder together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream white sugar, brown sugar, shortening, and eggs together in a large bowl with an electric mixer until smooth. Gradually add flour mixture to the wet ingredients, mixing it in on low speed until combined. Mix in oats, cornflakes, and peanuts by hand.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoonfuls of dough 2 inches apart onto ungreased cookie sheets; flatten each cookie with the bottom of a glass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 12 to 15 minutes. Cool on the baking sheet for 1 to 2 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
