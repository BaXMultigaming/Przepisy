  "ingredients": [
    "1 cup warm water (110 degrees F/45 degrees C)",
    "2 tablespoons white sugar",
    "1 (.25 ounce) package bread machine yeast",
    "0.25 cup vegetable oil",
    "3 cups bread flour",
    "1 teaspoon salt"
  ],
