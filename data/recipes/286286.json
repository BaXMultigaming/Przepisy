  "ingredients": [
    "0.5 pound ground Italian sausage",
    "0.5 cup chopped pepperoni",
    "0.33333334326744 cup chopped onion",
    "2 cloves garlic, minced",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup pizza sauce",
    "0.5 teaspoon dried oregano",
    "0.25 cup grated Parmesan cheese",
    "1 (16 ounce) package white button mushrooms",
    "0.75 cup shredded mozzarella cheese",
    "2 tablespoons sliced pepperoni"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sausage, 1/2 cup pepperoni, onion, and garlic in a large skillet over medium heat until sausage is no longer pink, 5 to 6 minutes. Add cream cheese, pizza sauce, and oregano; cook and stir until cream cheese has melted. Stir in Parmesan cheese and remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wipe mushrooms clean and remove and discard stems. Spoon a heaping tablespoon of the stuffing mixture into each mushroom cap and place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until mushrooms are tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and top mushrooms with mozzarella and remaining 2 tablespoons pepperoni. Return to the oven until cheese is melted, 2 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
