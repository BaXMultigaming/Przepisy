    "publisher-tested"
  ],
  "ingredients": [
    "cooking spray",
    "1.5 large zucchinis, thinly sliced lengthwise",
    "1 tablespoon olive oil",
    "1 pound ground beef",
    "1.5 cups low-carb marinara sauce",
    "2 teaspoons salt, divided",
    "1 teaspoon dried oregano",
    "0.5 teaspoon ground black pepper",
    "1 (8 ounce) container ricotta cheese",
    "1 large egg",
    "0.5 teaspoon ground nutmeg",
    "2 cups shredded mozzarella cheese",
    "0.25 cup grated Parmesan cheese",
    "aluminum foil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 8-inch square baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat dry zucchini slices with a paper towel to remove excess moisture. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a saucepan over medium-high heat. Add ground beef; cook until browned, 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Sk4rcftyxr5y3N9wm9XhiIUYawQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261026-ultimate-low-carb-zucchini-lasagna-ddmfs-4x3-step1-0072-aa9bfaab47b64dc393486f617e221785.jpg"
      ],
      "image": "assets/images/261026/step_03.webp"
    },
    {
      "text": "Add marinara sauce, 1 teaspoon salt, oregano, and pepper; simmer for 10 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rzi1OGqZ0cZQkmV2xwdM1BcQfos=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261026-ultimate-low-carb-zucchini-lasagna-ddmfs-4x3-step2-0073-059abc7b45714a659b22c717007f0e3e.jpg"
      ],
      "image": "assets/images/261026/step_04.webp"
    },
    {
      "text": "Combine ricotta cheese, egg, 1 teaspoon salt, and nutmeg in a bowl; mix well. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JyZvbzwY9splQWCzs0bdJqGQGEo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261026-ultimate-low-carb-zucchini-lasagna-ddmfs-4x3-step3-0074-6b22e4a9cbbe4fd68441e83eebe14914.jpg"
      ],
      "image": "assets/images/261026/step_05.webp"
    },
    {
      "text": "Arrange one layer of zucchini slices in the prepared baking dish. Cover with 1/2 of the sauce. Add another layer of zucchini slices. Spread ricotta mixture on top. Sprinkle with 1/2 of the mozzarella cheese. Add another layer of zucchini slices; cover with remaining sauce and top with remaining mozzarella cheese and Parmesan cheese. Cover the baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pyVg8PioDKBNxG621xYXLApWxfc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261026-ultimate-low-carb-zucchini-lasagna-ddmfs-4x3-step6-0077-1023681c8b7c4842876708b486fa4fb9.jpg"
      ],
      "image": "assets/images/261026/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Remove aluminum foil and bake until top is golden, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e46MABa-7h4w-0-G16ya4pbV7-8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261026-ultimate-low-carb-zucchini-lasagna-ddmfs-4x3-step7-0089-7eb81758bb1747bb82ce602053b879bd.jpg"
      ],
      "image": "assets/images/261026/step_07.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tB7L2Xy_gEh_vx4lML9o2t6yyQ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261026_UltimateLowCarbZucchiniLasagne_MFS_182-1-4x3-8f5ac12a01144605b27e50476cad27a6-47e2bdf3c06840ea874a8113cf4f82fa.jpg"
      ],
      "image": "assets/images/261026/step_08.webp"
    }
