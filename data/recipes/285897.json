  "ingredients": [
    "1 (3 pound) corned beef brisket",
    "2 cups water",
    "0.25 cup honey",
    "1 tablespoon country Dijon mustard"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place brisket and water in a Dutch oven. Cover tightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Simmer in the preheated oven for 1 hour. Turn brisket over and continue cooking, covered, until meat is tender, 1 1/2 to 2 more hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and turn on the broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer brisket, fat-side up, to a rack set in a broiler pan. Mix together honey and Dijon mustard; brush 1/2 of the mixture over the top of the brisket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the roasting pan under the broiler, making sure the surface of the meat is 3 to 4 inches from the heat. Broil for 3 minutes. Brush with remaining honey-mustard and broil until brisket is glazed to perfection, about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
