  "ingredients": [
    "1 (32 fluid ounce) container chicken broth",
    "1 (14.5 ounce) can diced tomatoes with lime juice and cilantro (such as RO*TEL®)",
    "0.25 cup shredded jalapeno Jack cheese",
    "2 Roma tomatoes",
    "1 carrot",
    "1 stalk celery",
    "1 slice onion",
    "1 slice red bell pepper",
    "1 avocado",
    "1 clove garlic",
    "1 teaspoon taco seasoning mix",
    "0.5 teaspoon salt",
    "2 sprigs fresh cilantro, or more to taste",
    "0.25 cup canned black beans, rinsed and drained",
    "0.25 cup canned corn, drained",
    "1.5 cups shredded cooked chicken"
  ],
  "steps": [
    {
      "text": "Combine chicken broth, diced tomatoes, jalapeno Jack cheese, Roma tomatoes, carrot, celery, bell pepper, avocado, garlic, taco mix, salt, and cilantro in a high-speed blender (such as Vitamix). Mix at level 10 for a few seconds, then at full speed until steaming, 6 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour black beans and corn into the blender and pulse two times. Serve soup over shredded chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
