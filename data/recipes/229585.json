  "ingredients": [
    "1 cup boiling water",
    "1 cup couscous",
    "4 tomatoes",
    "16 leaves fresh basil",
    "8 ounces fresh mozzarella cheese, diced",
    "0.25 cup balsamic vinegar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour boiling water over couscous in a bowl. Cover the bowl with plastic wrap; set aside until water is completely absorbed, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice tops from tomatoes; cut a very small slice from bottoms so they stand upright. Remove and discard tomato seeds and pulp using a spoon. Place tomatoes in the prepared baking dish, right-sides up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake tomatoes in the preheated oven until slightly soft, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line insides of each tomato with 4 basil leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss couscous and mozzarella cheese together; stuff evenly into tomatoes. Drizzle vinegar over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
