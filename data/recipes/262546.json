  "ingredients": [
    "1 teaspoon all-purpose flour",
    "1 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon dried Italian herb seasoning",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon cayenne pepper",
    "1.25 pounds ground lamb"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, oregano, salt, garlic powder, onion powder, Italian seasoning, black pepper, and cayenne pepper in a large bowl. Add ground lamb and knead until thoroughly mixed together, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape seasoned lamb mixture and place into a loaf pan; set on top of a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, turning halfway to ensure even browning, for about 1 hour and 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap loaf in aluminum foil and let rest for about 10 minutes. Slice as thinly as possible to make doner kebab pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
