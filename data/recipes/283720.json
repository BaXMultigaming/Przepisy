  "ingredients": [
    "1 (16 ounce) can refried beans",
    "1 (16 ounce) can pinto beans, rinsed and drained",
    "1 (10 ounce) can diced tomatoes and green chiles (such as RO*TEL®), drained",
    "salt to taste",
    "2 tablespoons shredded Cheddar cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Combine refried beans, pinto beans, diced tomatoes and green chiles, and salt in a microwave-safe bowl. Microwave on high for 4 1/2 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the microwave and stir until pinto beans are slightly mashed. Sprinkle Cheddar cheese on top and serve immediately.",
