  "ingredients": [
    "1 cup all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon baking powder",
    "0.5 teaspoon dried dill weed",
    "0.75 cup beer",
    "0.5 cup milk",
    "2 eggs",
    "2 pounds cod fillets",
    "2 quarts vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix together flour, salt, baking powder, and dill. Add beer, milk, and eggs; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fish fillets in batter mixture, coat well, and let stand for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat deep fryer to 375 degrees F (190 degrees C). Place fish in hot oil, and fry until golden brown. Cook fish in batches to maintain oil temperature. Serve.",
