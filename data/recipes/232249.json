  "title": "Ham Bone Chowder",
  "description": "Leftover ham bones are a perfect addition to potato and corn chowder in the slow cooker for a warm and comforting weeknight dinner.",
  "authors": [
    "D-Man and Pivo"
  ],
  "date_published": "2020-03-10T02:52:04-04:00",
