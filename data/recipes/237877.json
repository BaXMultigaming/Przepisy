  "ingredients": [
    "0.5 cup nonfat vanilla yogurt (such as Dannon® Light and Fit®)",
    "0.5 cup sliced strawberries",
    "0.5 cup water",
    "0.5 cup nonfat powdered milk",
    "1 banana, cut in chunks",
    "0.25 cup blueberries, or to taste",
    "0.25 cup raspberries, or to taste",
    "0.25 cup blackberries, or to taste",
    "2 scoops vanilla whey protein powder",
    "1 cup crushed ice",
    "3 tablespoons turbinado sugar (such as Sugar in the Raw®)",
    "1 tablespoon honey"
  ],
  "steps": [
    {
      "text": "Pulse yogurt, strawberries, water, powdered milk, banana, blueberries, raspberries, blackberries, and protein powder together in a blender until well-mixed. Add ice, sugar, and honey and blend until smooth.",
