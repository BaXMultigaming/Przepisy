  "ingredients": [
    "2 medium potatoes, peeled and diced",
    "2 tablespoons olive oil",
    "1 medium onion, chopped",
    "1 (15 ounce) can chickpeas, drained",
    "1 (14.5 ounce) can diced tomatoes",
    "1 cup broccoli florets",
    "1 cup peas",
    "4 teaspoons curry powder",
    "1 tablespoon garlic powder",
    "2 teaspoons salt",
    "2 teaspoons ground cumin",
    "1 teaspoon ground ginger",
    "1 teaspoon cayenne pepper",
    "2 cups chopped kale, or to taste",
    "1 (14 ounce) can coconut milk",
    "1 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a pot over medium heat. Saute onion in the hot oil until soft, about 5 minutes. Add potatoes, chickpeas, tomatoes, broccoli, and peas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix curry powder, garlic powder, salt, cumin, ginger, and cayenne together in a small bowl and pour over vegetables. Cook and stir for 10 minutes. Add kale, coconut milk, and sugar. Cover and cook over medium heat for 30 minutes. Mix and continue to cook until sauce is desired thickness, about 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
