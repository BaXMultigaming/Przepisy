  "ingredients": [
    "0.5 cup packed brown sugar",
    "0.66666668653488 cup peanut butter",
    "5 tablespoons corn syrup",
    "0.5 cup applesauce",
    "2 teaspoons vanilla extract",
    "3 cups rolled oats",
    "1 cup chocolate chips",
    "0.5 cup miniature marshmallows",
    "0.5 cup toasted oat cereal rings",
    "0.66666668653488 cup wheat germ"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the brown sugar, peanut butter, corn syrup, applesauce, and vanilla. In a separate bowl, stir together the oats, chocolate chips, mini marshmallows, cereal rings and wheat germ. Stir the dry ingredients into the peanut butter mixture until evenly coated. Press lightly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake or 25 to 30 minutes in the preheated oven, or until slightly golden. Cool in the pan on a wire rack. Cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
