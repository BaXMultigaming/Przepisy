  "ingredients": [
    "1 cup pitted dates",
    "0.5 cup almonds",
    "0.5 cup pecans",
    "3 tablespoons cocoa powder",
    "1 tablespoon chia seeds",
    "1 pinch salt",
    "2 tablespoons coconut oil",
    "2 tablespoons unsweetened cocoa powder",
    "1 teaspoon honey"
  ],
  "steps": [
    {
      "text": "Place dates in a bowl and cover with hot water until fully submerged. Let dates soak until softened, about 10 minutes. Transfer to a colander to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almonds, pecans, cocoa powder, and chia seeds in the bowl of a food processor; pulse until blended. Add dates and salt and process until smooth. Transfer to the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together coconut oil, cocoa powder, and honey for the icing. Spread on top of brownies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
