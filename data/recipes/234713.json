  "ingredients": [
    "1 pound fresh green beans",
    "0.5 cup all-purpose flour",
    "1 large egg",
    "1 cup seasoned bread crumbs",
    "2 cups vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil; cook beans in boiling water until bright green, about 2 minutes. Immediately transfer green beans to a bowl of ice water to stop the cooking process. Drain and pat dry beans with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kLxpvMmWf3ZcCJrbBT-ccTaJdTA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234713-deep-fried-green-beans-VAT-step-01-3860768daf4d47e7bf9933936355ffc3.jpg"
      ],
      "image": "assets/images/234713/step_01.webp"
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ErzopJLvbYDJN4m-5Ow3x5T3Ssc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234713-deep-fried-green-beans-VAT-step-02-c46e1fcbafaf4335ab49aa2740126acf.jpg"
      ],
      "image": "assets/images/234713/step_02.webp"
    },
    {
      "text": "Pour flour into a bowl. Whisk egg in a separate bowl. Pour bread crumbs into a third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z0dRAwfyhHRLn7KFnWbGvVYbDLs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234713-deep-fried-green-beans-VAT-step-03-90d4b0470c184cfe80723d19677f7772.jpg"
      ],
      "image": "assets/images/234713/step_03.webp"
    },
    {
      "text": "Coat green beans with flour; transfer to beaten egg and coat evenly. Press coated green beans into bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w181-VDx8s6eYUbJSv-ERagfO04=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234713-deep-fried-green-beans-VAT-step-04-6e60af8999e641bc8a9e956734e1260e.jpg"
      ],
      "image": "assets/images/234713/step_04.webp"
    },
    {
      "text": "Working in batches, fry breaded green beans in hot oil until golden brown, 3 to 5 minutes. Transfer fried beans to a paper towel-lined plate to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zn4m_qxyiCYUnbZIIC7t4QrTTvw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234713-deep-fried-green-beans-VAT-step-05-393f10bf0bfc4121ac4f83f56bc26e44.jpg"
      ],
