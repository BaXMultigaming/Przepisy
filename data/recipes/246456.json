  "ingredients": [
    "0.75 pound ground turkey",
    "0.5 pound chicken sausage, casings removed",
    "0.66666668653488 cup gluten-free bread crumbs",
    "3 tablespoons chopped fresh basil",
    "3 tablespoons milk",
    "2 teaspoons minced garlic",
    "0.25 cup grated Parmesan cheese",
    "1 egg, lightly beaten",
    "1 teaspoon kosher salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground turkey, chicken sausage, bread crumbs, basil, milk, garlic, Parmesan cheese, beaten egg, salt, and black pepper in a bowl; mix gently with a fork. Form mixture into 1 ¼-inch diameter balls and place on prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through and lightly browned, about 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
