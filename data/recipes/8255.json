  "ingredients": [
    "2 cups white sugar",
    "0.5 cup shortening",
    "2 eggs",
    "2.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup milk",
    "3 tablespoons white sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, sift together flour, baking powder and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream shortening and 2 cups sugar until fluffy. Add eggs one at a time, mixing well with each addition. Alternately add milk and flour mixture in three stages, mixing well with each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix 3 tablespoons sugar with 1 teaspoon cinnamon. Sprinkle this mixture evenly over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into prepared 9x13 inch pan and bake at 350 degrees F (175 degrees C) for 35 to 40 minutes or until done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
