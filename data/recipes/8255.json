  "title": "Snickerdoodle Cake I",
  "description": "Sugar and cinnamon topping. Like the famous cookie, only BIGGER!",
  "authors": [
    "Kathy Tylka"
  ],
  "date_published": "1999-06-20T21:40:36-04:00",
