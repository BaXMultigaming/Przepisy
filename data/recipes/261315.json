  "ingredients": [
    "1.5 (12 ounce) packages Brussels sprouts",
    "1 cup water",
    "1 tablespoon butter",
    "1 teaspoon vegetable bouillon",
    "1 teaspoon white sugar",
    "1 pinch ground nutmeg",
    "salt",
    "1 tablespoon ground walnuts, or more to taste"
  ],
  "steps": [
    {
      "text": "Combine Brussels sprouts, water, butter, bouillon, sugar, and nutmeg in a saucepan over medium heat, cover,and bring to a boil. Reduce heat and simmer until soft, 20 to 30 minutes. Uncover for the last few minutes so any excess liquid can evaporate. Season with salt and sprinkle with ground nuts.",
