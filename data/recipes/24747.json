  "ingredients": [
    "5 cups pureed persimmons",
    "3 cups white sugar",
    "0.25 cup fresh lemon juice",
    "0.5 teaspoon grated orange zest",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Combine persimmon purée, sugar, lemon juice, orange zest, and nutmeg in a large saucepan over medium-high heat; bring to a boil and cook until slightly thickened, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pack jam into sterilized freezer jars or containers, filling to within ½ inch of tops. Run a clean knife or thin spatula around insides of jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any residue. Seal jars. Set jam aside to cool. Store jam in the freezer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
