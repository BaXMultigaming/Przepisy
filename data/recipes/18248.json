  "ingredients": [
    "6 slices bacon",
    "6 medium tomatoes",
    "0.5 cup chopped green bell pepper",
    "0.25 cup grated Parmesan cheese",
    "0.33333334326744 cup croutons",
    "salt and pepper to taste",
    "6 sprigs parsley"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 11x7 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside. While bacon is cooking, wash tomatoes and slice off stem ends. Gently scoop out pulp, leaving a 1/2 inch wall. Finely chop pulp and place 1/3 cup of it in a medium bowl. You may discard remaining pulp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir crumbled bacon, green pepper, cheese, croutons, and salt and pepper into tomato pulp. Spoon an equal amount of mixture into each hollowed out tomato. Place stuffed tomatoes into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 to 25 minutes, until heated through. Garnish with parsley sprigs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
