  "ingredients": [
    "0.5 cup butter",
    "1 cup white sugar",
    "1 egg",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon coconut extract",
    "1.75 cups sifted all-purpose flour",
    "0.75 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Cream the butter until smooth; add sugar and continue creaming until light and fluffy. Stir in egg, vanilla and coconut flavoring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift the flour with the salt and baking soda. Alternately add the flour mixture and the shredded coconut to the creamed mixture. Form the dough into logs about 2 inches in diameter. Tightly wrap dough and chill for at least two hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Remove dough from refrigerator and cut into 1/4-inch slices. Bake on an ungreased cookie sheet until the edges are golden, about 10 minutes. Cool on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
