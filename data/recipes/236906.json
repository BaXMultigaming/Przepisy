  "ingredients": [
    "cooking spray",
    "1 (8 ounce) package cream cheese, softened",
    "0.75 cup white sugar",
    "1 tablespoon cornstarch",
    "2 cups gluten-free flour blend",
    "1 (15 ounce) can pumpkin puree",
    "1.5 cups white sugar",
    "3 eggs",
    "0.75 cup milk",
    "0.5 cup melted butter",
    "1 tablespoon baking powder",
    "1 tablespoon ground cinnamon",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Prepare 2 loaf pans with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, 3/4 cup sugar, and cornstarch together in a small bowl until creamy and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat flour blend, pumpkin puree, 1 1/2 cups sugar, eggs, milk, butter, baking powder, cinnamon, and salt together in a large mixing bowl with an electric hand mixer set to Low until you have a thick batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour about 1/4 of the batter into the bottom of each prepared loaf pan. Spread 1/2 the cream cheese filling over each batter portion. Divide remaining batter between the two pans and spread into an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake, not the filling, comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
