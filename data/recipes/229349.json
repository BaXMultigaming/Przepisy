  "ingredients": [
    "2 pounds fresh green beans, trimmed",
    "1 tablespoon olive oil, or as needed",
    "1 teaspoon kosher salt",
    "0.5 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O9P313dWtAuePgOP7aXOdqWCU_k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229349-roasted-green-beans-ddmfs-step-01-3x4-1352-2-8278795358c94b938812bfd7b507c3fb.jpg"
      ],
      "image": "assets/images/229349/step_01.webp"
    },
    {
      "text": "Rinse green beans and pat dry with paper towels; spread onto a rimmed baking sheet. Drizzle beans with olive oil, then season with salt and pepper. Use your hands to toss the beans until evenly coated with oil; spread out in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hqegUw7SYIzmyWm4E54unmBNfmo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229349-roasted-green-beans-ddmfs-step-03-3x4-1363-2-177f9e28047e4f8199bee4431b2fff8a.jpg"
      ],
      "image": "assets/images/229349/step_02.webp"
    },
    {
      "text": "Roast in the preheated oven until beans are crisp-tender, look slightly shriveled, and start to show golden caramelized spots, 15 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
