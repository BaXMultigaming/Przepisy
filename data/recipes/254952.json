  "ingredients": [
    "cooking spray",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup mashed pumpkin",
    "0.5 cup honey",
    "0.5 cup milk",
    "0.5 cup vegetable oil",
    "1 egg",
    "0.25 cup cashews, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8-inch cake pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, and salt together in a bowl. Stir in mashed pumpkin. Mix in honey, milk, oil, and egg until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the greased cake pan. Gently press cashews into the batter for decoration.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 35 to 40 minutes. Let cool in the pan, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
