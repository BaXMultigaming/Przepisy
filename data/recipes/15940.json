  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon white sugar",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 cup lard",
    "0.33329999446869 cup cold water",
    "1 egg yolk",
    "1 teaspoon vanilla extract",
    "1 teaspoon distilled white vinegar"
  ],
  "steps": [
    {
      "text": "Mix together flour, sugar, baking powder, and salt in a medium bowl. Cut in lard until mixture resembles a coarse meal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together water, egg yolk, vanilla, and vinegar in a separate bowl. Stir into flour mixture and knead dough briefly, just until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow dough to rest for 15 minutes before rolling out.",
      "section": null,
      "name": null,
      "url": null,
