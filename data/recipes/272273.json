  "ingredients": [
    "1 pound cod fillets",
    "0.25 cup all-purpose flour",
    "1 egg",
    "0.5 cup panko bread crumbs",
    "0.25 cup grated Parmesan cheese",
    "1 tablespoon parsley flakes",
    "1 teaspoon paprika",
    "0.5 teaspoon black pepper",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat fish dry with paper towels and cut into 1x3-inch sticks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour in a shallow dish. Beat egg in a separate shallow dish. Combine panko, Parmesan cheese, parsley, paprika, and pepper in a third shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat each fish stick in flour, then dip in beaten egg, and finally coat in seasoned panko mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray the basket of the air fryer with nonstick cooking spray. Arrange 1/2 the sticks in the basket, making sure none are touching. Spray the top of each stick with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 5 minutes. Flip fish sticks and cook an additional 5 minutes. Repeat with remaining fish sticks.",
      "section": null,
      "name": null,
      "url": null,
