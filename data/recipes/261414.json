  "ingredients": [
    "1.5 cups white sugar",
    "1 cup butter, softened",
    "2 eggs",
    "1 egg yolk",
    "10 drops green food coloring",
    "1 teaspoon peppermint extract",
    "3.25 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon cream of tartar",
    "0.5 teaspoon kosher salt",
    "1 (12 ounce) bag dark chocolate chips"
  ],
  "steps": [
    {
      "text": "Beat sugar and butter in a large bowl with an electric mixer until light and fluffy. Beat in eggs, egg yolk, green food coloring, and peppermint extract until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, cream of tartar, and kosher salt in a separate bowl. Mix into egg mixture until dough comes together. Fold in chocolate chips. Cover dough and refrigerate until firm enough to scoop, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto the baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 8 to 10 minutes. Cool on the baking sheet for 1 minute before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
