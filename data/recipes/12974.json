  "ingredients": [
    "4 tablespoons margarine",
    "6 cups peeled and cubed butternut squash",
    "6 tablespoons chopped onion",
    "3 cups water",
    "4 cubes chicken bouillon",
    "0.5 teaspoon dried marjoram",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon ground cayenne pepper",
    "2 (8 ounce) packages cream cheese"
  ],
  "steps": [
    {
      "text": "Melt margarine in a large saucepan over medium-low heat. Add onion and sauté until soft and translucent, about 5 minutes. Add butternut squash, water, bouillon, marjoram, black pepper, and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil over medium-high heat; reduce heat and simmer until squash is tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée squash mixture and cream cheese in a blender or food processor in batches until smooth. Return to saucepan and cook until just heated through.",
      "section": null,
      "name": null,
      "url": null,
