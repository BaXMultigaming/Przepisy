  "ingredients": [
    "0.25 cup all-purpose flour",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon salt",
    "1 egg",
    "1 teaspoon water",
    "1 ripe avocado, halved, seeded, peeled and cut into 8 slices",
    "0.5 cup panko bread crumbs",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, pepper, and salt together in a shallow bowl. Beat together egg and water in a second shallow bowl. Place panko in a third shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge an avocado slice through the flour, shaking off excess. Dip into egg and allow excess to drop off, then press into panko so both sides are covered. Set on a plate and repeat with the remaining slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray avocado slices generously with cooking spray and arrange in the air fryer basket, sprayed-side down. Spray the top side of the avocado slices as well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 4 minutes. Turn avocado slices over and cook until golden, about 3 more minutes.",
      "section": null,
      "name": null,
      "url": null,
