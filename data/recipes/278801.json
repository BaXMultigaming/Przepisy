  "ingredients": [
    "2.5 cups semisweet chocolate chips",
    "1 cup heavy whipping cream",
    "1 tablespoon white sugar",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "2 tablespoons cocoa powder, or as needed"
  ],
  "steps": [
    {
      "text": "Combine chocolate chips, cream, and sugar in a microwave-safe dish and cook in the microwave for 1 minute. Stir, then cook for 30-second intervals until chocolate is melted and mixture is smooth. Mix in vanilla and salt until well incorporated. Cover the bowl and refrigerate for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop chocolate mixture onto a parchment-lined baking sheet using a large cookie scoop. Freeze until solid, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape frozen scoops into balls and roll in cocoa powder. Store in a freezer-safe container until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
