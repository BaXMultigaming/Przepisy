  "ingredients": [
    "1 pound bacon",
    "1 cup bread cubes",
    "2.75 cups milk",
    "12 eggs",
    "salt and pepper to taste",
    "0.25 cup butter",
    "1 pound Swiss cheese, shredded",
    "4 teaspoons butter, melted",
    "1 cup dry bread crumbs"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, Combine the bread cubes and milk. Drain after 5 minutes. In a separate bowl, beat together milk, eggs, salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet or saucepan, melt 1/4 cup butter over medium heat. Add the egg mixture and scramble until soft. Do not fully cook. Add the soaked bread cubes and turn into a greased 9x13 inch baking pan. Sprinkle shredded cheese on top of casserole. In a small bowl, stir together butter and bread crumbs. Sprinkle this mixture over the cheese and then top with the bacon. Cover and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "The next morning, preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 40 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
