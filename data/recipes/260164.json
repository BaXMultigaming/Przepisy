  "ingredients": [
    "1 teaspoon butter",
    "6 slices bacon",
    "1 large sweet potato, cubed",
    "1 cup chopped broccoli",
    "0.25 yellow onion, chopped",
    "2 cloves garlic, minced, or more to taste",
    "2 cups fresh spinach",
    "salt and ground black pepper to taste",
    "6 eggs, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a skillet over medium heat until golden brown, about 8 minutes. Drain on paper towels then coarsely chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sweet potato, broccoli, onion, and garlic in the same skillet until onion is translucent, about 5 minutes. Add spinach, salt, and black pepper; cook until spinach is wilted, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a bowl until foamy; stir in bacon and spinach mixture. Pour egg-vegetable mixture into the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top and sides are golden brown, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
