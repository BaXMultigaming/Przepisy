  "ingredients": [
    "1 (15 ounce) can chickpeas, drained and rinsed",
    "1 tablespoon olive oil",
    "1 tablespoon paprika",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon cayenne pepper",
    "0.25 teaspoon salt",
    "1 cup tzatziki sauce",
    "4 (6 inch) pita bread rounds",
    "1 medium tomato, sliced",
    "0.25 medium red onion, cut into strips",
    "2 leaves lettuce, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat dry chickpeas with a paper towel, removing any skins that may come off. Toss chickpeas gently with olive oil, paprika, black pepper, cayenne, and salt. Spread onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned but not hard, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread some tzatziki on the inside of each pita. Sprinkle in the chickpeas and add tomato slices, red onion, and lettuce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
