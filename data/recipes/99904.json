  "ingredients": [
    "3 pounds beef sirloin roast",
    "1 (1 ounce) packet dry au jus mix",
    "1 cup water",
    "8 (1 ounce) slices provolone cheese",
    "8 hoagie rolls, split lengthwise"
  ],
  "steps": [
    {
      "text": "Place beef roast into a slow cooker. Stir together water and au jus mix; pour over the roast. Cover and cook on Low for 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the roast from the slow cooker and shred or slice. Open the hoagie rolls and top with beef and provolone cheese. Serve with small bowls of the hot au jus from the slow cooker.",
