  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup soy milk",
    "1 egg",
    "2 tablespoons flax seeds",
    "1 teaspoon baking powder",
    "1 teaspoon white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Stir flour, soy milk, egg, flax seeds, baking powder, sugar, and vanilla extract together in a bowl.",
