  "ingredients": [
    "1 pound cooked bacon, chopped",
    "2 (6 ounce) packages frozen peas, thawed",
    "1 cup golden raisins",
    "1 (8 ounce) package shredded Cheddar cheese",
    "1 sweet onion, chopped",
    "0.5 cup sunflower seeds",
    "1 cup mayonnaise",
    "2 tablespoons wine vinegar",
    "0.25 teaspoon white sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Toss bacon, peas, raisins, Cheddar cheese, onion, and sunflower seeds together in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, vinegar, and sugar together in a small bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing over salad; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl; refrigerate until chilled, about 1 hour.",
      "section": null,
      "name": null,
