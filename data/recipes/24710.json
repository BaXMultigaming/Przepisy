  "ingredients": [
    "1 (8 ounce) container tofu",
    "0.33333334326744 cup 1% milk, or more if needed",
    "0.5 teaspoon salt, or to taste",
    "0.5 teaspoon pepper",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "0.66666668653488 cup shredded Cheddar cheese",
    "0.5 cup shredded Swiss cheese",
    "0.25 cup diced onion",
    "1 teaspoon minced garlic",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend tofu, milk, salt, and pepper in a blender until smooth, adding more milk if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine spinach, Cheddar, Swiss, onion, and garlic in a medium bowl. Add tofu mixture and mix until well combined; pour into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set in the center and golden brown on top, about 30 minutes. Let stand for 5 minutes before cutting into six generous slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
