  "ingredients": [
    "2 tablespoons olive oil",
    "3 tablespoons butter",
    "0.5 large sweet onion, finely chopped",
    "4 cloves garlic, chopped",
    "1.5 cups Arborio rice",
    "0.5 cup dry white wine (such as Sauvignon Blanc)",
    "2 tablespoons lemon juice",
    "5 cups hot chicken broth",
    "1 cup heavy cream",
    "3 cups cooked broccoli florets",
    "2 tablespoons chopped fresh chives",
    "1 tablespoon grated Parmesan cheese",
    "1.5 tablespoons grated Asiago cheese",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vkVTyZxkzlh_6SXjLcoYHeig9Ag=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-166138-broccoli-risotto-with-cream-and-lemon-VAT-step-01-dd6d155be65e439198d1ed86f0ccf28e.jpg"
      ],
      "image": "assets/images/166138/step_01.webp"
    },
    {
      "text": "Heat olive oil and butter in a large, heavy-bottomed saucepan over medium-high heat. Add onion and garlic; cook and stir until onion begins to turn golden brown at the edges, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/50jz0cptu44-SuIeh4Z_NIJlzA8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-166138-broccoli-risotto-with-cream-and-lemon-VAT-step-02-2df49344d76d4f19a9f15a7d4dc9caf4.jpg"
      ],
      "image": "assets/images/166138/step_02.webp"
    },
    {
      "text": "Pour in rice, and stir until rice is coated in oil and has started to toast, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V0qm_2dNqNnpQEVc3pB8GvueR0o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-166138-broccoli-risotto-with-cream-and-lemon-VAT-step-03-ee2e687a1d9247a38d7ed7993ae589c7.jpg"
      ],
      "image": "assets/images/166138/step_03.webp"
    },
    {
      "text": "Reduce heat to medium and stir in white wine and lemon juice. Cook and stir until wine has mostly evaporated, then stir in 1/3 of the chicken broth; continue stirring until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uxwEmzfJvn8Xp5JtyQmOkl-1AMU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-166138-broccoli-risotto-with-cream-and-lemon-VAT-step-04-92f1b67a982d43cda0fa280719d45bdc.jpg"
      ],
      "image": "assets/images/166138/step_04.webp"
    },
    {
      "text": "Repeat this process twice more, stirring constantly. Stirring in broth should take 15 to 20 minutes in all. Stir in cream and cook 5 minutes before stirring in broccoli, chives, Parmesan cheese, and Asiago cheese. Cook and stir until risotto is hot; season to taste with salt and pepper before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7U9WcFXydZtYAVrFGfmOMrVLDmk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-166138-broccoli-risotto-with-cream-and-lemon-VAT-step-05-a631b92771da487987d6ef660c92db14.jpg"
      ],
      "image": "assets/images/166138/step_05.webp"
    }
