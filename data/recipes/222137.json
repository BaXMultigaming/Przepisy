  "ingredients": [
    "4 large baking potatoes",
    "8 slices bacon",
    "1 cup light sour cream",
    "0.5 cup nonfat milk",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 cup shredded Cheddar cheese",
    "4 green onions, sliced",
    "0.5 cup shredded Cheddar cheese",
    "4 green onions, sliced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake potatoes in preheated oven until easily pierced with a fork, about 1 hour. Allow to cool for 10 minutes. Do not turn off oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook bacon in a large deep skillet over medium-high heat until evenly browned. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice potatoes in half lengthwise and scoop flesh into a large bowl; save skins. Mix in sour cream, milk, salt, pepper, 1/2 cup Cheddar cheese, and half the green onions into potato flesh. Blend with a hand mixer until creamy. Spoon potato mixture into potato skins. Top each with remaining 1/2 cup Cheddar cheese, 4 sliced green onions, and bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in oven until filling is hot and cheese is melted, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
