  "ingredients": [
    "0.5 cup finely chopped tomato",
    "0.25 cup mayonnaise",
    "0.25 cup minced red onion",
    "2 tablespoons dill pickle relish",
    "0.5 teaspoon ground piri piri chile pepper",
    "salt and ground black pepper to taste",
    "2 (4 ounce) fillets tilapia fillets",
    "1 teaspoon seafood seasoning (such as Old Bay®)",
    "0.5 teaspoon garlic powder",
    "2 tablespoons butter",
    "4 slices pepperjack cheese",
    "4 slices whole wheat bread, toasted"
  ],
  "steps": [
    {
      "text": "Stir tomato, mayonnaise, red onion, relish, and piri piri together in a small bowl. Season to taste with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season tilapia on both sides with seafood seasoning and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Add seasoned tilapia and cook until golden brown and fish flakes easily with a fork, 2 to 3 minutes per side. Place two slices of pepper Jack on top of each fillet, cover the skillet, and cook until cheese melts, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer each tilapia fillet to a slice of toasted bread. Spread with mayonnaise sauce and top with remaining bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
