  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup butter, softened",
    "1.25 cups white sugar",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "0.25 cup milk",
    "1 cup semisweet chocolate chips",
    "0.5 cup chopped pecans",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and butter together in a large bowl with an electric mixer until well blended, about 30 seconds. Beat in 1 ¼ cups sugar and vanilla extract until light and fluffy. Add eggs, one at a time, beating well after each addition. Add flour mixture, alternately with milk, mixing until just incorporated. Fold in chocolate chips; mixing just enough until evenly combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pecans, remaining ¼ cup sugar, and cinnamon in a small bowl; sprinkle over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 55 minutes. Cool in the pans for 10 minutes before transferring to a wire rack to cool. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
