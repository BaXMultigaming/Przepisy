  "ingredients": [
    "2 cups whole wheat flour",
    "1 tablespoon brown sugar",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground ginger",
    "1 dash ground nutmeg",
    "2 cups 2% milk",
    "2 eggs",
    "0.5 banana, mashed",
    "2 tablespoons vegetable oil",
    "0.5 teaspoon vanilla extract",
    "1 apple, finely chopped"
  ],
  "steps": [
    {
      "text": "Combine whole wheat flour, brown sugar, baking powder, cinnamon, baking soda, salt, ginger, and nutmeg in a mixing bowl, ideally one with a lip for pouring the batter later. Mix with a fork or whisk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, eggs, banana, oil, and vanilla extract in another bowl. Beat together using a hand mixer until frothy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a griddle or frying pan to 350 to 375 degrees F (175 to 190 degrees C), depending on altitude.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk mixture over the flour mixture and mix until just combined and most lumps have incorporated into the batter. Fold in apple. Let batter rest for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour or ladle 1/3 cup of batter onto the griddle. Cook until edges are dry and bubbles form on the edges, 2 to 3 minutes. Flip and cook until bottom is golden brown, about 2 minutes more. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
