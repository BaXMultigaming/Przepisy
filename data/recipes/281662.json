  "ingredients": [
    "1 (27 ounce) can sliced apples",
    "0.25 cup cranberries",
    "1 cup all-purpose flour",
    "0.75 cup white sugar",
    "0.5 cup cold salted butter",
    "1.5 teaspoons ground cinnamon",
    "0.5 gallon vanilla ice cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter an 8-inch square glass baking dish and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain apple slices and place in the baking dish. Randomly scatter cranberries among the apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, and butter in a food processor. Process until pea-sized crumbs are formed, stopping just short of it being cookie dough. Cover the apples with the crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 45 minutes. Remove from the oven and sprinkle with cinnamon. Serve warm topped with a scoop of ice cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
