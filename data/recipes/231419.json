  "ingredients": [
    "0.25 cup Worcestershire sauce",
    "2 tablespoons soy sauce",
    "0.5 lime, juiced",
    "1 tablespoon dried minced onion",
    "1 teaspoon red pepper flakes",
    "1 teaspoon dry mustard",
    "0.5 teaspoon Kosher salt",
    "0.25 teaspoon thyme",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon dried, minced garlic",
    "3 dashes hot pepper sauce (such as Tabasco®), or to taste",
    "2 (4 ounce) venison steaks"
  ],
  "steps": [
    {
      "text": "Whisk together Worcestershire sauce, soy sauce, lime juice, onion, red pepper flakes, dry mustard, salt, thyme, black pepper, garlic, and hot pepper sauce in a bowl; pour into a resealable plastic bag. Add venison steaks, coat with marinade, squeeze to remove excess air, and seal the bag. Marinate in the refrigerator for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d1I_Q5D6CbIp9bxemnS4UU-Z6P4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231419-emilys-marinated-venison-steaks-ddmfs-Step2-0366-1eb840c4ccb7405ca62854609244eb77.jpg"
      ],
      "image": "assets/images/231419/step_01.webp"
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Remove venison from marinade and shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook steaks on the preheated grill until they are firm, hot in the center, and just turning from pink to grey, about 5 minutes per side. An instant-read thermometer inserted into the center should read 150 degrees F (65 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sz7RTfGFnTESnGtFxF705LoRWuA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231419-emilys-marinated-venison-steaks-ddmfs-Step3-0387-8224c0c84d1a457a82792dd4a2a193fd.jpg"
      ],
