  "ingredients": [
    "2 cups all-purpose flour",
    "0.75 cup unsweetened cocoa powder",
    "1.25 teaspoons baking soda",
    "0.5 teaspoon salt",
    "1.75 cups white sugar",
    "0.75 cup unsalted butter, at room temperature",
    "2 large eggs",
    "1 teaspoon maple extract",
    "1.333 cups brewed coffee"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9-inch round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour, cocoa powder, baking soda, and salt in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and butter together in a large bowl with an electric mixer. Mix in eggs and maple extract. Add flour mixture in 2 batches, alternating with coffee, beating batter until smooth after each addition. Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the centers comes out clean, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
