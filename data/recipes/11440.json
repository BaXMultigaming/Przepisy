  "ingredients": [
    "2.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 pinch salt",
    "1 cup white sugar",
    "0.5 cup butter",
    "2 eggs, beaten",
    "0.5 teaspoon lemon extract",
    "0.5 cup milk",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and salt together. Beat sugar and butter together in a large bowl with an electric mixer until lighter in color. Beat in eggs and lemon extract. Mix in milk and flour mixture alternately in three parts, starting with the milk. Gently mix in blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter by tablespoons onto prepared sheets 1 ½ inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies in the preheated oven until edges are golden brown, about 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
