  "ingredients": [
    "3 eggs, lightly beaten",
    "3 tablespoons milk",
    "1.5 cups Italian seasoned bread crumbs",
    "0.5 cup grated Parmesan cheese",
    "2 tablespoons dried parsley",
    "2 tablespoons olive oil",
    "4 cloves garlic, peeled and chopped",
    "4 pork chops"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (160 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Utl7ZCEuVayL69WLhqhfDENrbQg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-31064-Italian-Breaded-Pork-Chops-Step-1-fed44ded73b34e258e449d98435b4abb.jpg"
      ],
      "image": "assets/images/31064/step_01.webp"
    },
    {
      "text": "Beat eggs and milk together in a shallow dish. Mix bread crumbs, Parmesan cheese, and parsley together in a second shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x6IG9AtIsMx6UTQqwV_SIeKQU6g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-31064-Italian-Breaded-Pork-Chops-Step-2-9c346a57f20c4b4383aae4e4fbb25e64.jpg"
      ],
      "image": "assets/images/31064/step_02.webp"
    },
    {
      "text": "Heat oil in a large, oven-proof skillet over medium heat. Stir in garlic and cook until just golden brown to flavor the oil. Remove garlic with a slotted spoon and reserve for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aRqV0DdDCJRoT0YsOxvbm8PsYgw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-31064-Italian-Breaded-Pork-Chops-Step-3-ef5b06bf125a431c848117f96ac21fa1.jpg"
      ],
      "image": "assets/images/31064/step_03.webp"
    },
    {
      "text": "Dip each pork chop into egg mixture, then bread crumb mixture until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Qc2GUwvW8Gr4fy3CSi-JNZB_LZ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-31064-Italian-Breaded-Pork-Chops-Step-4-c35d781854e4464694b512b9cd1d72fe.jpg"
      ],
      "image": "assets/images/31064/step_04.webp"
    },
    {
      "text": "Place pork chops in the skillet and cook until golden and crisp, about 5 minutes on each side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3UsJQgKkiaoQZ1eoHHZZ92mb32w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-31064-Italian-Breaded-Pork-Chops-Step-5-4ff27a74ccae41f4bf4524d3925ddcdb.jpg"
      ],
      "image": "assets/images/31064/step_05.webp"
    },
    {
      "text": "Transfer the skillet into the preheated oven and bake chops until cooked through, about 20 to 25 minutes. A meat thermometer inserted into the center of a pork chop should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pAJsJVptFWYzJpDja877oa0Kx4M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-31064-Italian-Breaded-Pork-Chops-4x3-273483666dbb4a18ba01de637ef5461a.jpg"
      ],
      "image": "assets/images/31064/step_06.webp"
    }
