  "ingredients": [
    "1 cup vegetable oil for frying, or as needed",
    "1.75 cups pancake mix",
    "1 cup water, or as needed",
    "2 bananas, cut into 1/2-inch pieces",
    "0.25 cup white sugar",
    "0.25 cup ground cinnamon"
  ],
  "steps": [
    {
      "text": "Heat oil in a large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pancake mix and water together until batter is smooth. Dip each banana slice in the pancake batter until fully coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry coated banana slices, 3 to 4 at a time, in the hot oil until lightly browned, about 1 minute per side; remove with a slotted spoon and transfer to a paper towel-lined plate. Sprinkle pancake pops with sugar and cinnamon.",
