  "ingredients": [
    "1 (8 ounce) package lo mein noodles",
    "2.5 tablespoons sesame oil, divided",
    "1 (16 ounce) package extra-firm tofu, drained and cubed",
    "3 cloves garlic, chopped",
    "1 teaspoon ground ginger",
    "0.5 cup soy sauce",
    "0.5 cup teriyaki sauce",
    "0.5 cup brown sugar",
    "1 stalk green onion, chopped",
    "1 teaspoon sesame seeds, or to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil. Add lo mein noodles and cook, stirring occasionally, until tender yet firm to the bite, about 6 minutes. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the noodles are cooking, heat 1 tablespoon sesame oil in a large pan over medium heat. When hot, place tofu in the pan and saute until browned on all sides, about 6 minutes. Transfer tofu to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining 1 tablespoon sesame oil in the same pan. Add garlic and cook for 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soy sauce, teriyaki sauce, brown sugar, and remaining 1/2 tablespoon of sesame oil in a small bowl. Pour into the pan. Add tofu and lo mein noodles; toss to coat in the sauce mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve garnished with green onion and sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
