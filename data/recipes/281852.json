  "ingredients": [
    "2 (15 ounce) cans cannellini beans, drained",
    "2.5 cups chicken stock",
    "2 cups diced cooked rotisserie chicken",
    "1 (15.25 ounce) can sweet whole kernel corn, drained",
    "1 (4 ounce) can chopped green chiles, drained",
    "2 tablespoons white chicken chili seasoning mix (such as McCormick®)",
    "1 teaspoon chicken bouillon granules",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon ground black pepper",
    "1 (8 ounce) carton sour cream",
    "1 tablespoon chopped fresh cilantro, or to taste"
  ],
  "steps": [
    {
      "text": "Combine cannellini beans, chicken stock, rotisserie chicken, corn, chiles, chili seasoning, bouillon granules, onion powder, and black pepper in a pot; bring to boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat; simmer at least 1 hour. Add sour cream during the last 15 minutes of cooking; stir to combine. Garnish with cilantro.",
