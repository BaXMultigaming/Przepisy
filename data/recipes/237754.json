  "ingredients": [
    "1.25 cups water",
    "1 (6 ounce) package dry falafel mix",
    "2 cups vegetable oil for frying",
    "salt to taste",
    "0.5 cup sour cream",
    "0.25 cup milk",
    "0.25 cup diced cucumber",
    "1 teaspoon minced fresh parsley",
    "0.125 teaspoon salt",
    "1 (10 ounce) bag mixed salad greens",
    "2 tomatoes, diced",
    "1 avocado, diced",
    "8 slices cooked bacon, crumbled",
    "3 hard-boiled eggs, diced",
    "0.75 cup feta cheese"
  ],
  "steps": [
    {
      "text": "Mix water and falafel mix together in a bowl; let stand for 10 minutes. Form mixture into 12 patties, about 1/2-inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry falafel patties, working in batches, in the hot oil until golden brown and crisp, 3 to 5 minutes. Transfer cooked falafel to a paper towel-lined plate using a slotted spoon; season with salt. Cool falafel to room temperature; break into pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sour cream, milk, cucumber, parsley, and 1/8 teaspoon salt together in a bowl until dressing is smooth and creamy; refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread greens onto serving plates. Arrange tomatoes, avocado, bacon, eggs, feta cheese, and falafel in rows over the greens. Drizzle dressing over each salad.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
