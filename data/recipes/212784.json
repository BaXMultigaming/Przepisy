  "ingredients": [
    "1 (8 ounce) package softened cream cheese",
    "1 tablespoon mayonnaise",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon minced garlic",
    "0.5 teaspoon lemon juice",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon seafood seasoning",
    "0.25 teaspoon dried dill weed",
    "0.125 teaspoon ground black pepper",
    "6 ounces flaked smoked salmon"
  ],
  "steps": [
    {
      "text": "Stir together cream cheese, mayonnaise, Worcestershire sauce, garlic, lemon juice, onion powder, seafood seasoning, dill, and pepper in a large bowl until evenly blended and no lumps of cream cheese remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently fold in flaked salmon until incorporated. Refrigerate before serving, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
