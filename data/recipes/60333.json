  "ingredients": [
    "1 (14 ounce) package firm tofu, drained and mashed",
    "2 pounds ground turkey",
    "0.5 cup dry bread crumbs",
    "1 (1 ounce) envelope dry onion soup mix",
    "0.25 cup minced green bell pepper",
    "2 eggs, beaten",
    "0.25 cup brown sugar",
    "0.25 cup soy sauce",
    "1 teaspoon prepared yellow mustard"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9 inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix the tofu, turkey, bread crumbs, soup mix, green pepper, and eggs. Place the mixture into the prepared pan, and mold into a loaf shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan over low heat, blend the brown sugar, soy sauce, and mustard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake the meatloaf 30 minutes in the preheated oven. Drizzle with the sauce mixture, and continue baking 15 minutes, or to an internal temperature of 180 degrees F (80 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
