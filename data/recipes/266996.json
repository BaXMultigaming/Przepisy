  "title": "Salpicao de Frango (Brazilian Chicken Salad)",
  "description": "Use leftover chicken to make this Brazilian chicken salad with golden raisins, apples, carrots, and corn tossed in a simple cream and mustard dressing.",
  "authors": [
    "Mia"
  ],
