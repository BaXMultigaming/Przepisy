  "ingredients": [
    "1 (8 ounce) can refrigerated crescent dinner rolls",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup sugar",
    "0.5 teaspoon almond extract, or more to taste",
    "1 (21 ounce) can peach pie filling",
    "0.5 cup flour",
    "0.25 cup firmly packed brown sugar",
    "3 tablespoons margarine or butter, softened",
    "0.5 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate crescent dough into 2 long rectangles; press into an ungreased 9x13-inch baking pan to cover bottom of pan, sealing perforations.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, sugar, and almond extract in a bowl with an electric mixer until smooth; spread evenly over dough. Spoon peach pie filling evenly over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, and margarine in a bowl until crumbly; sprinkle over peach filling. Top with almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 25 to 30 minutes. Cool completely before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
