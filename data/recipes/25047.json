  "title": "Betty's Sugar Cookies",
  "description": "Simple sugar cookies are formed into balls and coated with sugar before baking. Use colored sugars for special occasions.",
  "authors": [
    "Karen Conner"
  ],
  "date_published": "2020-06-18T23:05:56-04:00",
