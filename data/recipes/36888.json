  "ingredients": [
    "1 pound cubed or minced pork stew meat",
    "1 (1.25 ounce) package taco seasoning mix",
    "1 tablespoon vegetable oil",
    "1 (16 ounce) can chili beans, undrained",
    "1 cup chunky salsa",
    "0.33333334326744 cup apricot preserves",
    "12 taco shells",
    "1 (10 ounce) can sliced ripe olives, for topping"
  ],
  "steps": [
    {
      "text": "Combine pork and taco seasoning in a resealable plastic bag. Squeeze out excess air, seal bag, and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium-high heat. Add pork to the skillet; cook, stirring occasionally, until no longer pink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in beans, salsa, and apricot preserves; reduce heat to low and simmer until heated through, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon ⅓ cup pork mixture into each taco shell; top with sliced olives.",
