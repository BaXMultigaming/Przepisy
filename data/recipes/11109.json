  "ingredients": [
    "0.5 cup butter",
    "0.5 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 cup raspberry jam",
    "1 cup confectioners' sugar",
    "0.25 teaspoon almond extract",
    "1 tablespoon hot water",
    "0.25 cup candied cherries, chopped"
  ],
  "steps": [
    {
      "text": "Cream butter. Add sugar, creaming well. Beat in egg and vanilla. Combine flour and baking powder; gradually add to creamed mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a lightly floured surface, roll out dough to 1/8 inch thickness. Cut into 2 inch rounds, and place on ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 10 minutes, or until very lightly browned at edges. Cool thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread half of the cookies with jam, and top with remaining cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine confectioners' sugar, almond extract, and enough hot water to make a thin icing. Frost tops of cookies. Top each with a small piece of candied cherry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
