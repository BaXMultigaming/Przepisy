  "ingredients": [
    "2 pounds kielbasa sausage, cut into 1 inch pieces",
    "1.5 pounds sauerkraut, drained and rinsed",
    "2 Granny Smith apples - peeled, cored and sliced into rings",
    "0.75 onion, sliced into rings",
    "2 pounds red potatoes, quartered",
    "1.5 cups chicken broth",
    "0.5 teaspoon caraway seeds",
    "0.5 cup shredded Swiss cheese"
  ],
  "steps": [
    {
      "text": "Place half the sausage in a slow cooker, and top with the sauerkraut. Cover with the remaining sausage, apples, and onion. Top with the potatoes. Pour chicken broth over all, and sprinkle with caraway seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook on High 4 hours, or until potatoes are tender. Top each serving with Swiss cheese.",
      "section": null,
