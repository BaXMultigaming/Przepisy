  "ingredients": [
    "10 Yukon Gold potatoes, thinly sliced",
    "0.25 cup chopped white onion",
    "1 (10.75 ounce) can condensed cream of potato soup",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "3 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together the cream of potato soup, cream of mushroom soup and onion in a bowl. Heat in the microwave until hot, about 3 minutes. Make a layer of potato slices in the bottom of a 9x13 inch baking dish. Cover with a layer of the soup mixture and then sprinkle with some of the cheese. Repeat layers until ingredients are used up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are fork-tender and cheese is browned on top, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
