  "title": "Raspberry Cream Cheese Coffee Cake",
  "description": "This raspberry cream cheese coffee cake is a fruity alternative to those standard coffee cake recipes made with cinnamon, walnuts, and streusel.",
  "authors": [
    "springfield70"
  ],
  "date_published": "2020-06-18T23:50:28-04:00",
