  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2.25 cups all-purpose flour",
    "0.75 cup white sugar",
    "0.75 cup unsalted butter, cut into 1-inch pieces",
    "0.75 cup sour cream",
    "1 large egg",
    "1 teaspoon almond extract",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup white sugar",
    "1 large egg",
    "0.5 cup raspberry preserves",
    "0.5 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k8UelEUKdPurjhwClr0H0aadOm0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223600-raspberry-cream-cheese-coffee-cake-VAT-step-01-fa29c86a2da6470295977c473c24400c.jpg"
      ],
      "image": "assets/images/223600/step_01.webp"
    },
    {
      "text": "Make the cake: Combine flour, sugar, and butter in a food processor; pulse until mixture resembles coarse crumbs. Remove 1 cup of mixture and set aside for topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V5z1w-1a2mOXnTWPvKH_76yAGnA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223600-raspberry-cream-cheese-coffee-cake-VAT-step-02-d2ee2d3842524674974807cbd0a05630.jpg"
      ],
      "image": "assets/images/223600/step_02.webp"
    },
    {
      "text": "Add sour cream, egg, almond extract, baking soda, baking powder, and salt to the food processor. Process until batter is combined and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UdBGkBYrQ851W4SmkDSQoR8Kljs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223600-raspberry-cream-cheese-coffee-cake-VAT-step-03-f579e784a90645e3948f685980f6e98a.jpg"
      ],
      "image": "assets/images/223600/step_03.webp"
    },
    {
      "text": "Pour into the prepared pan. Spread over the bottom and 2 inches up the sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4tjm0a-1vuIBxmatD-JebDsd08M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223600-raspberry-cream-cheese-coffee-cake-VAT-step-04-1handspreadingbatter-956e8671e62a4ff793d4c69d8ac750f5.jpg"
      ],
      "image": "assets/images/223600/step_04.webp"
    },
    {
      "text": "Make the cream cheese layer: Beat cream cheese, sugar, and egg in a bowl with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LQTr1XM9N2Kxe4sU1Na-7zPbAKo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223600-raspberry-cream-cheese-coffee-cake-VAT-step-05-1mixingaction-b8b7d76c5676484795769d841a5a63f2.jpg"
      ],
      "image": "assets/images/223600/step_05.webp"
    },
    {
      "text": "Pour over batter in the pan and spread evenly. Carefully spread preserves over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dxnahF68udhFo9i6Bty6I-8AD6k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223600-raspberry-cream-cheese-coffee-cake-VAT-step-06-5240ee3366c649658122819b068be406.jpg"
      ],
      "image": "assets/images/223600/step_06.webp"
    },
    {
      "text": "Make the topping: Stir 1 cup reserved crumb mixture and almonds together in a small bowl. Sprinkle over preserves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/plzro-TbmYeLJs7OFevSFu5HLnQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223600-raspberry-cream-cheese-coffee-cake-VAT-step-07-bbc05e767d724943a765e5f036c3ce1e.jpg"
      ],
      "image": "assets/images/223600/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until filling is set and topping is golden brown, 45 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lxGdDHcb3Rf7dX2aIUeewGAQHOg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223600-raspberry-cream-cheese-coffee-cake-VAT-step-08-46b885a38ebc4a7aafd0cd884ed4975b.jpg"
      ],
      "image": "assets/images/223600/step_08.webp"
    },
    {
      "text": "Remove from the oven and cool in the pan for 15 minutes. Carefully remove the sides of the pan. Chill completely before serving, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7aol8a5C111_ePFqJx24RnaRgHk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223600-raspberry-cream-cheese-coffee-cake-VAT-step-09-1sideofpannexttocake-2802f45207934f38922bb1e34057069f.jpg"
      ],
      "image": "assets/images/223600/step_09.webp"
    }
  ],
