  "ingredients": [
    "1 teaspoon cornstarch",
    "0.33333334326744 cup distilled white vinegar",
    "2 teaspoons vegetable oil",
    "0.66666668653488 cup unsweetened pineapple juice",
    "2 tablespoons ketchup",
    "3 tablespoons brown sugar",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "In a small saucepan over a medium-low heat, whisk (using a metal whisk) together vinegar and cornstarch. Add oil, pineapple juice, ketchup, brown sugar, and salt; whisking constantly until the mixture is heated through.",
