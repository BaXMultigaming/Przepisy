  "ingredients": [
    "2 pounds carrots, peeled and sliced diagonally into 1/2-inch pieces",
    "0.25 cup brown sugar",
    "0.25 cup butter, melted",
    "2 tablespoons bourbon, or more to taste"
  ],
  "steps": [
    {
      "text": "Place carrots in a large pot and cover with water; bring to a boil. Reduce heat to medium-low and simmer until tender yet firm to the bite, 10 to 15 minutes. Drain and transfer to a serving bowl.",
