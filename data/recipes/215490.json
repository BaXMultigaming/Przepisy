  "ingredients": [
    "1.75 cups all-purpose flour",
    "1.5 cups whole wheat flour",
    "1 cup white sugar",
    "1 cup light brown sugar",
    "2 teaspoons baking soda",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground cinnamon",
    "1 teaspoon salt",
    "1 tablespoon vanilla extract",
    "4 eggs, lightly beaten",
    "1 cup vegetable oil",
    "1 tablespoon lemon juice",
    "3 cups shredded zucchini, squeezed dry"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flours, sugars, baking soda, nutmeg, cinnamon, and salt together in a large bowl. Fold in the following ingredients, one at a time and with a rubber spatula, in the order listed: vanilla, eggs, vegetable oil, lemon juice, and zucchini. Divide the mixture between two loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 65 to 75 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
