  "title": "Loaded Breakfast Skillet",
  "description": "This breakfast skillet features flavorful layers of onions, potatoes, bacon, fried eggs, and Cheddar cheese seasoned with garlic and smoked paprika.",
  "authors": [
    "Dorinda Medley"
  ],
