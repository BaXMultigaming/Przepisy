  "ingredients": [
    "1 pound salmon, cut into 4 portions",
    "1 lemon, juiced",
    "1 lime, juiced",
    "1 teaspoon minced garlic",
    "1 teaspoon onion powder",
    "0.5 teaspoon Cajun seasoning",
    "0.5 teaspoon paprika",
    "0.5 cup honey",
    "2.6666667461395 fluid ounces cognac (such as Hennessy)",
    "olive oil",
    "freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Coat salmon in lemon and lime juice and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine garlic, onion powder, Cajun seasoning, and paprika in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat honey in a small saucepan over medium-low heat until bubbling. Add garlic mixture and cognac. Simmer until flavors combine and sauce starts to thicken, about 5 minutes. Let cool until thick, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Coat salmon in olive oil; season with pink salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil salmon for 6 to 8 minutes. Spoon the cognac-honey sauce over the salmon. Continue broiling until light brown on top and fish flakes easily with a fork, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
