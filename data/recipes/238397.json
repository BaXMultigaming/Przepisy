  "ingredients": [
    "2 (8 ounce) packages carrots, peeled and cut into chunks",
    "1 cup dried cranberries, or more to taste",
    "0.25 cup chicken broth",
    "0.25 cup butter, melted",
    "0.25 cup dark brown sugar",
    "1 pinch ground cinnamon, or to taste"
  ],
  "steps": [
    {
      "text": "Place carrots and cranberries into a microwave-safe dish. Combine chicken broth, butter, and brown sugar in a bowl; drizzle over carrot mixture and stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave at high power for 4 minutes; continue microwaving until carrots are tender, about 8 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool at room temperature for 5 minutes; sprinkle with cinnamon.",
