  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "1 cup coconut milk (such as Silk®)",
    "1 banana, mashed",
    "0.75 cup sugar",
    "2 teaspoons xanthan gum, or more as desired",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground ginger",
    "0.33333334326744 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend pumpkin puree, coconut milk, and banana together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, xanthan gum, cinnamon, salt, ginger, nutmeg, and cloves together in a small bowl; add to pumpkin mixture and blend. Pour the pumpkin mixture into a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 15 minutes. Reduce heat to 350 degrees F (175 degrees C) and continue baking until a toothpick inserted into the center comes out clean, 30 to 45 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
