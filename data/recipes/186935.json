  "ingredients": [
    "8 ounces sour cream",
    "0.75 cup sugar",
    "1 egg",
    "2 tablespoons flour",
    "2 teaspoons vanilla extract",
    "0.25 teaspoon salt",
    "2.5 cups fresh blueberries",
    "1 (9 inch) unbaked pie crust",
    "3 tablespoons all-purpose flour",
    "2 tablespoons white sugar",
    "3 tablespoons chilled butter, cut into small pieces",
    "2 teaspoons five-spice powder",
    "4 tablespoons chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together sour cream, 3/4 cup sugar, egg, 2 tablespoons flour, vanilla extract and salt in a mixing bowl until smooth. Gently fold the blueberries into the sour cream mixture. Spoon the filling into the unbaked pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the filling is baking, prepare the streusel crunch topping: In a medium bowl combine 3 tablespoons flour, 2 tablespoons sugar, and five-spice powder. Cut the cold butter into the flour mixture until crumbly. Fold in the chopped pecans. After the filling has baked 25 minutes, sprinkle the streusel crunch topping over the top of the pie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until the topping is golden brown, about 15 additional minutes.",
      "section": null,
      "name": null,
      "url": null,
