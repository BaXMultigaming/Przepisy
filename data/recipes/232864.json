  "ingredients": [
    "5 pounds red potatoes, chopped",
    "3 cups mayonnaise",
    "2 cups finely chopped pickles",
    "5 large hard-cooked eggs, chopped",
    "0.5 cup chopped red onion",
    "0.5 cup chopped celery",
    "3 tablespoons prepared mustard",
    "1 tablespoon apple cider vinegar",
    "1 teaspoon salt, or to taste",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pWuU6K7xuqiTpwSJ0qf49_Zj-LA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232864-potato-salad-VAT-001-step-01-4ca54611cbe7480cb981f02787f2ef13.jpg"
      ],
      "image": "assets/images/232864/step_01.webp"
    },
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 10 minutes. Drain. Return potatoes to the empty pot to dry and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PMqUYK0D_UtbaQw8JKogUVOigyk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232864-potato-salad-VAT-003-step-02-02-cb4d0c509fdd48c79312a0de228c842b.jpg"
      ],
      "image": "assets/images/232864/step_02.webp"
    },
    {
      "text": "Stir mayonnaise, pickles, hard-cooked eggs, red onion, celery, mustard, and cider vinegar together in a large bowl; season to taste with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E39ld0syymP7eZeea1ZFyeuw1CM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232864-potato-salad-VAT-005-step-03-02-30442f78f1f243018da18dc47bb5992a.jpg"
      ],
      "image": "assets/images/232864/step_03.webp"
    },
    {
      "text": "Fold in cooled potatoes until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c9ABrB8P36EHQfeY7k6Kmj9P18w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232864-potato-salad-VAT-006-step-04-ac4a06c965c7423393878890b586437a.jpg"
      ],
      "image": "assets/images/232864/step_04.webp"
    },
    {
      "text": "For best results, store potato salad in the refrigerator until chilled or overnight before serving to allow the flavors to meld.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uaQGFD-Uxx5oJeMnObI9urlZUKs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232864-potato-salad-VAT-007-step-05-1e0ba98916d34c2886dd731debf797c0.jpg"
