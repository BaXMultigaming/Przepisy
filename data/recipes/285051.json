  "ingredients": [
    "6 cups water",
    "3 tablespoons kosher salt",
    "2 tablespoons white sugar",
    "2 tablespoons maple syrup",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon pink salt #1 (curing salt)",
    "1 (1 pound) pork tenderloin"
  ],
  "steps": [
    {
      "text": "Mix water, kosher salt, sugar, maple syrup, garlic powder, and curing salt until dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the pork loin in a large bag or food-safe container large enough to completely submerge it in the curing brine. Add brine and refrigerate for at least 3 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pork from brine and pat dry with paper towels; discard brine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a smoker to 180 degrees F (82 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork onto wire racks. Place the racks into the smoker. Add wood chips according to manufacturer's directions. Smoke until pork is slightly pink in the center, about 2 1/2 hours. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C). Let cool before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
