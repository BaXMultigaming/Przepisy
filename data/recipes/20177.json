  "ingredients": [
    "1.25 cups all-purpose flour",
    "1 tablespoon baking powder",
    "1.25 teaspoons white sugar",
    "0.5 teaspoon salt",
    "1 cup milk",
    "1 egg",
    "0.5 tablespoon butter, melted",
    "0.5 cup frozen blueberries, thawed"
  ],
  "steps": [
    {
      "text": "Sift flour, baking powder, sugar, and salt together in a large bowl. Combine milk and egg in a small bowl. Stir egg mixture into flour mixture until just combined. Stir in melted butter, then fold in blueberries. For best results, set the batter aside for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle or nonstick frying pan over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour or scoop the batter onto the hot griddle, using approximately 1/4 cup for each pancake; cook until bubbles appear on the surface, then flip and cook until golden brown on both sides. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
