  "ingredients": [
    "nonstick cooking spray",
    "12 ounces pork breakfast sausage, or more to taste",
    "0.5 cup chopped onion",
    "2 medium apples - peeled, cored, and chopped",
    "0.5 cup natural unsweetened applesauce",
    "0.25 cup packed light brown sugar",
    "2 tablespoons spicy brown mustard",
    "1 teaspoon ground cinnamon",
    "0.125 teaspoon ground nutmeg",
    "1 pinch cayenne pepper, or more to taste",
    "2 (28 ounce) cans baked beans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sausage and onion in a large skillet over medium-high heat, until sausage is browned and crumbly and onions are translucent, 5 to 7 minutes. Drain and discard grease and remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir apples, applesauce, brown sugar, mustard, cinnamon, nutmeg, and cayenne pepper together in a large bowl. Add baked beans and sausage mixture and mix until well combined. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
