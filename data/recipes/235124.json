  "ingredients": [
    "1 tablespoon lemon juice",
    "1 tablespoon olive oil",
    "1 clove garlic, minced",
    "16 medium fresh asparagus spears, each trimmed to 5 inches",
    "8 thin slices Margherita® Deli Prosciutto",
    "0.33333334326744 cup soft goat cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F. Combine lemon juice, olive oil and garlic in large bowl. Add asparagus; toss to coat. Place asparagus in baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 8 minutes, or until crisp-tender. Let cool to room temperature (about 15 minutes).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each prosciutto slice in half lengthwise. Spread each piece with about 1 teaspoon goat cheese. Wrap each slice in a spiral around each asparagus spear. Serve immediately, or cover and refrigerate until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
