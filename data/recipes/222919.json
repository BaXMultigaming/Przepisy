  "ingredients": [
    "3 cups graham cracker crumbs",
    "0.75 cup butter, melted",
    "1 cup crunchy peanut butter",
    "1.5 cups confectioners' sugar",
    "0.66666668653488 cup honey",
    "1 tablespoon vanilla extract",
    "0.5 cup brown sugar",
    "1 cup all-purpose flour",
    "0.5 cup semi-sweet chocolate chips",
    "0.5 cup peanut butter chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix graham cracker crumbs and melted butter together in a bowl until cracker crumbs are moistened. Press evenly into the bottom of a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix peanut butter, confectioners' sugar, honey, and vanilla extract together in a mixing bowl; stir in brown sugar. Fold flour into peanut butter mixture until well incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread peanut butter mixture over graham cracker crust. Sprinkle with chocolate chips and peanut butter chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chips start to melt, 13 to 15 minutes. Cool before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
