        "https://www.allrecipes.com/thmb/Qce7vf4eqjVgGBwkJ3nJ3mjjgOg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/153205-butternut-squash-fries-step-03-aac421e5ff5d4b27be50d88103888af2.jpg"
