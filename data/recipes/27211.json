  "ingredients": [
    "3 (8 ounce) packages cream cheese",
    "1 cup white sugar",
    "1 cup sour cream",
    "1 teaspoon vanilla extract",
    "1 tablespoon pumpkin pie spice",
    "6 eggs",
    "1 cup pumpkin puree",
    "2 (9 inch) prepared graham cracker crusts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat cream cheese and sugar until smooth. Blend in sour cream, vanilla and spice. Beat in eggs, one at a time. Blend in pumpkin puree until no streaks remain. Pour filling into 2 crusts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes, or until filling is set. Allow to cool, then refrigerate at least 4 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
