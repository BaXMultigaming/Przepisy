  "ingredients": [
    "2 cups diced papaya",
    "1 red bell pepper, diced",
    "0.5 red onion, diced",
    "0.25 cup chopped fresh cilantro",
    "2 tablespoons lime juice",
    "1 clove garlic, minced",
    "0.25 teaspoon hot chile paste, or to taste",
    "3 eggs",
    "0.5 cup chopped macadamia nuts",
    "4 (6 ounce) tuna steaks",
    "0.25 cup extra-virgin olive oil",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine papaya, bell pepper, and onion in a medium bowl. Add cilantro, lime juice, garlic, and hot chile paste; toss to combine. Refrigerate salsa until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a shallow bowl until smooth. Spread nuts on a shallow plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush tuna steaks with olive oil, then season with salt and pepper. Dip tuna steaks in beaten eggs and allow excess eggs to run off. Press into macadamia nuts until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook tuna steaks on the preheated grill to desired degree of doneness, about 2 minutes per side for medium. Serve with papaya salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
