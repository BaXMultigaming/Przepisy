  "title": "Ramp Sausage Gravy",
  "description": "Fresh ramps and grated apple bring spring-ready flavor to this breakfast pork gravy, best served over hot biscuits.",
  "authors": [
    "Darcy Lenz"
  ],
  "date_published": "2021-05-06T22:11:52-04:00",
