  "title": "Taiwanese-Style Oxtail Stew",
  "description": "A delicious, oxtail tomato stew cooked low and slow with carrots, onions, and red wine.",
  "authors": [
    "eli2884"
  ],
  "date_published": "2019-04-03T23:47:46-04:00",
