  "ingredients": [
    "4 cups fresh cranberries",
    "1 cup raisins",
    "1 cup water",
    "0.75 cup packed brown sugar",
    "0.5 cup white sugar",
    "2 teaspoons ground cinnamon",
    "1 teaspoon minced fresh ginger root",
    "0.25 teaspoon ground cloves",
    "0.5 cup minced onion",
    "0.5 cup chopped Granny Smith apple",
    "0.5 cup finely chopped celery"
  ],
  "steps": [
    {
      "text": "Bring cranberries, raisins, water, both sugars, cinnamon, ginger, and cloves to a boil in a saucepan. Reduce the heat to low and simmer until berries start to pop, about 5 minutes. Add onion, apple, and celery; continue to cook, stirring occasionally, until mixture begins to thicken, 5 to 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a bowl and let cool slightly, about 15 minutes. Cover and refrigerate until flavors fully develop, 8 hours to overnight.",
