  "ingredients": [
    "3 eggs, beaten",
    "1 cup milk",
    "0.25 teaspoon salt",
    "0.5 cup butter, softened",
    "0.66666668653488 cup brown sugar",
    "1 (16 ounce) loaf French bread, cut into 1-inch slices",
    "2 teaspoons ground cinnamon, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, milk, and salt together in a bowl; pour into a shallow dish. Soak bread slices in egg mixture until saturated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread softened butter over the bottom of a 10x15-inch jelly roll pan. Sprinkle brown sugar over the butter. Arrange bread slices onto sugar in a single layer; sprinkle with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until beginning to firm, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
