  "ingredients": [
    "1.5 cups white sugar",
    "1 cup shortening",
    "2 eggs",
    "3.25 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "1 teaspoon ground allspice",
    "1 teaspoon ground cloves",
    "0.5 teaspoon salt",
    "1.5 cups chopped walnuts",
    "1.5 cups raisins",
    "1.5 cups dates, pitted and chopped",
    "0.5 cup maraschino cherries, coarsely chopped",
    "2 cups applesauce",
    "6 maraschino cherries, halved",
    "6 pecan halves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (160 degrees C). Grease a 10 inch tube pan. Line bottom with parchment paper and grease again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl, cream sugar and shortening until light and fluffy. Add eggs and blend well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly spoon flour into measuring cup; level off. Combine 1/2 cup of flour with nuts, raisins, dates and 1/2 cup cherries, stir until coated. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add remaining 2 3/4 cups flour, baking soda, cinnamon, allspice, cloves and salt to egg mixture. Blend at low speed until moistened, then beat 2 minutes on medium speed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold fruit and nut mixture and applesauce into batter. Pour batter into a 10 inch tube pan. Arrange cherry halves and pecans on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (160 degrees C) for 1hour and 15 to 45 minutes, or until toothpick inserted in center comes clean. Cool upright in pan 5 minutes. Turn upright onto wire rack and remove pan and parchment paper. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
