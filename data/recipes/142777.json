  "ingredients": [
    "cooking spray",
    "2 zucchini, halved lengthwise",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 cup part-skim ricotta cheese",
    "0.25 cup shredded part-skim mozzarella cheese",
    "2 tablespoons grated Parmesan cheese",
    "2 teaspoons dried basil",
    "1 teaspoon fresh lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Coat a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop out seeds from zucchini halves with a spoon; season cut sides with ½ teaspoon salt and ½ teaspoon black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ricotta, mozzarella, Parmesan, basil, lemon juice, and remaining ½ teaspoon each salt and black pepper in a bowl; divide among zucchini halves. Place stuffed zucchini on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until zucchini are tender and filling beginning to brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
