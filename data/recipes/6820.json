  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "4 eggs",
    "1 cup vegetable oil",
    "0.66666668653488 cup water",
    "3 cups white sugar",
    "3.5 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1.5 teaspoons salt",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/va9BXgrNYgWF8VQImwqFKeOMHpM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6820-downeast-maine-pumpkin-bread-ddmfs-0653-4x3-step01_previewcopy-d079d7e8c23742f89c10e9eb2ac63fa8.jpg"
      ],
      "image": "assets/images/6820/step_01.webp"
    },
    {
      "text": "Whisk flour, baking soda, salt, cinnamon, nutmeg, cloves, and ginger together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0GzdKF1jKjqZi5ucYeYY8W8SLjQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6820-DowneastMainePumpkinBread-MFS-Step1-eda3f6f03b04432b86eea92aca27453e.jpg"
      ],
      "image": "assets/images/6820/step_02.webp"
    },
    {
      "text": "Mix pumpkin puree, eggs, oil, water, and sugar in a separate bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e8Z3hONmCO3pC_BwvgO26FY9ihc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6820-downeast-maine-pumpkin-bread-ddmfs-0662-4x3-step03_previewcopy-10b1b8d472eb4cea8da54f89b6512c8f.jpg"
      ],
      "image": "assets/images/6820/step_03.webp"
    },
    {
      "text": "Stir flour mixture into pumpkin mixture until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k5V5RgwALhCg31WEOUncASy7x3Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6820-DowneastMainePumpkinBread-MFS-Step3-42229d7922c34e3b86fe84440d186be1.jpg"
      ],
      "image": "assets/images/6820/step_04.webp"
    },
    {
      "text": "Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4ZcFdb0mN4WrOeuOK_DHdKgxiE8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6820-DowneastMainePumpkinBread-MFS-Step4-fbf721e682f44dd18ba6cf9d3f52c83c.jpg"
      ],
      "image": "assets/images/6820/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, about 50 minutes.",
