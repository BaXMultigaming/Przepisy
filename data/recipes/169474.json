  "ingredients": [
    "1.25 cups water",
    "1 (8 ounce) package yellow rice mix",
    "2 tablespoons olive oil",
    "1 (15.25 ounce) can whole kernel corn, drained",
    "1 (15 ounce) can black beans, rinsed and drained",
    "2 teaspoons lime juice",
    "1 teaspoon ground cumin"
