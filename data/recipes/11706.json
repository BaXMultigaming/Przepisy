  "ingredients": [
    "6 ounces angel hair pasta",
    "6 ounces fresh sliced shiitake mushrooms",
    "1 clove garlic, minced",
    "0.5 onion, chopped",
    "0.25 cup white wine",
    "1 tablespoon olive oil",
    "0.25 cup chicken broth",
    "0.5 cup heavy whipping cream",
    "salt to taste",
    "ground black pepper to taste",
    "2 tablespoons grated Parmesan cheese",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Saute garlic and onion in olive oil over medium heat; add mushrooms as the aroma develops. Add chicken stock and wine, and cook until mixture is reduced to 1/2 volume. Blend in cream, and reduce to desired thickness. Season with salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile cook pasta in a large pot of boiling salted water until al dente.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta, and toss with sauce until coated. Serve on small warmed plates, topped with grated Parmesan cheese and parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
