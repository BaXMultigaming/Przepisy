  "ingredients": [
    "3 egg yolks",
    "0.5 teaspoon lemon juice",
    "1 cup vegetable oil",
    "2.5 tablespoons white miso paste",
    "0.25 teaspoon grated yuzu (Japanese orange), lemon or lime peel",
    "1 pinch freshly ground white pepper",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Beat egg yolks and lemon juice in a medium bowl with a wooden spoon. Beat in vegetable oil, a few drops at a time, beating well after each addition, until the mixture begins to emulsify. When all oil has been incorporated, stir in miso, orange zest, pepper, and salt.",
