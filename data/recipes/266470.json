    "0.33333334326744 cup white wine vinegar",
    "2 teaspoons toasted sesame oil",
    "2 teaspoons vegetable oil",
    "1 tablespoon rice vinegar",
    "1 tablespoon soy sauce",
    "1 tablespoon sugar",
    "1 teaspoon minced fresh ginger root",
