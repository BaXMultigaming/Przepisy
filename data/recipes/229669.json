  "title": "Glazed Carrots",
  "description": "Glazed carrots coated with a brown sugar and butter glaze are a quick and easy (but delicious) side dish for special occasions or everyday dinners.",
  "authors": [
    "Tricia McTamaney"
  ],
  "date_published": "2020-03-05T00:09:41-05:00",
