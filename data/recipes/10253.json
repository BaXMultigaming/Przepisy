  "ingredients": [
    "0.5 cup butter",
    "2 cups basic cookie mix",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.5 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter over low heat and stir into the Basic Cookie Mix. Beat egg lightly and add to mixture. Stir in vanilla and coconut and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With lightly floured hands shape into 1 inch balls and arrange about 2 inches apart on a greased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes until golden. Cool a couple of minutes before removing from cookie sheet to racks to complete cooling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
