  "ingredients": [
    "1 cup mashed bananas",
    "1 cup creamy salad dressing (such as Miracle Whip®)",
    "0.75 cup white sugar",
    "2 cups whole wheat flour",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bananas, salad dressing, and sugar in a large bowl until smooth. Stir flour, baking soda, and salt into banana mixture until batter is just moistened. Divide batter evenly into 24 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 17 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
