  "ingredients": [
    "1 (20 ounce) bottle vanilla cream soda",
    "2 cups water",
    "0.5 cup white sugar",
    "0.25 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Pour cream soda into a bowl and whisk until no longer bubbly; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat water and sugar in a saucepan over medium-high heat, stirring until sugar is dissolved, about 5 minutes. Stir sugar mixture and vanilla into cream soda.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cream soda mixture into small plastic cups or popsicle molds, then insert wooden popsicle sticks into centers of popsicles. Freeze until firm, about 4 hours.",
