  "ingredients": [
    "2 tablespoons butter",
    "2 tablespoons honey",
    "0.5 lemon, juiced",
    "2 cloves garlic, minced",
    "2 teaspoons soy sauce",
    "0.5 teaspoon ground black pepper",
    "1 pound fresh halibut fillet"
  ],
  "steps": [
    {
      "text": "Combine butter, honey, lemon juice, garlic, soy sauce, and pepper in a small bowl. Transfer a small amount of the mixture to another small bowl and reserve for serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Portion halibut by cutting it into three pieces with a sharp knife. Brush each side with the remaining butter-honey mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over high heat until sizzling hot. Add halibut and sear for 90 seconds on each side. Reduce the heat to medium and cook until the fish flakes easily with a fork, 2 to 3 minutes per side. Serve with reserved butter-honey marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
