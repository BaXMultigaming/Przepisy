  "ingredients": [
    "3 ounces yellow corn tortilla chips",
    "2 teaspoons olive oil",
    "0.25 (12 ounce) package ground beef vegetarian substitute (such as MorningStar®)",
    "2 tablespoons water",
    "1.5 teaspoons hot taco seasoning mix",
    "0.5 cup black beans, rinsed and drained",
    "0.66666668653488 cup shredded mild Cheddar cheese",
    "0.5 cup shredded lettuce, or to taste",
    "0.25 cup purchased salsa",
    "3 tablespoons purchased guacamole",
    "1 tablespoon sliced jalapeno peppers, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium-high heat. Add ground beef substitute and fry for 1 to 2 minutes. Stir in water and taco seasoning. Continue to cook and stir until cooked through, about 8 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tortilla chips on an oven-safe plate and top with black beans. Add fried beef substitute and top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, about 5 minutes; make sure the chips do not burn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and top with lettuce, salsa, guacamole, and jalapeno peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
