  "ingredients": [
    "6 pork chops",
    "salt and pepper to taste",
    "3 tablespoons butter",
    "1 onion, chopped",
    "1 clove garlic, minced",
    "0.75 cup chicken broth",
    "1 bay leaf",
    "1 cup sour cream",
    "2 teaspoons paprika"
  ],
  "steps": [
    {
      "text": "Saute onion and garlic in hot butter. Remove from skillet. Trim excess fat from chops and sprinkle with salt and pepper. Brown chops in skillet; pour off fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lower heat, add bay leaf and chicken broth. Cook covered over low heat for 1 hour. Transfer chops to a serving plate, but keep them hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat juices in skillet and reduce to half. Add the sour cream, onion-garlic mixture and paprika, blending thoroughly. Heat through, but don't boil. Pour over pork chops and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
