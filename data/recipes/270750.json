  "ingredients": [
    "4 tablespoons butter",
    "2 teaspoons olive oil",
    "1.5 teaspoons garlic powder",
    "salt and ground black pepper to taste",
    "6 medium potatoes, scrubbed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a microwave-safe bowl and microwave on high until melted, 20 to 30 seconds. Stir in olive oil, garlic powder, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a fork to poke about 5 holes into each potato. Place each potato on a sheet of aluminum foil about 6 inches wide. Brush butter mixture over potatoes, making sure to evenly coat each one. Wrap up completely in foil. Poke 5 more holes into the wrapped potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake potatoes in the center of the preheated oven until easily pierced with a fork, about 1 hour. Spread leftover butter mixture over potatoes after cutting them open.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
