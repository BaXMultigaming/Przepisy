  "ingredients": [
    "3 large sweet potatoes",
    "2 avocados, peeled and pitted",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.33333334326744 cup diced red onion",
    "2 tablespoons unsalted butter, divided"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a long, narrow cut lengthwise down the center of each sweet potato. Wrap each potato in aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake potatoes directly on the rack of the preheated oven until tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash avocado flesh, salt, and pepper together in a bowl with a fork until mostly smooth. Fold onion into avocado mixture. Cover the bowl with plastic wrap and refrigerate until chilled, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove potatoes from foil and slice open, pushing the two ends of each together to open the potato. Divide 1/2 of the butter between the potato openings. Spoon avocado mixture into each potato and top each with remaining butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
