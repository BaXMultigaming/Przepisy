  "ingredients": [
    "4 Hawaiian bread rolls, split",
    "4 tablespoons lingonberry jam",
    "4 slices deli ham",
    "4 slices deli Swiss cheese",
    "0.5 cup melted butter",
    "0.25 cup dried onion flakes",
    "0.25 cup white sugar",
    "2 tablespoons poppy seeds",
    "2 tablespoons sesame seeds",
    "1 tablespoon honey mustard"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bottom of buns on the prepared baking sheet. Layer lingonberry jam, ham, and Swiss cheese equally on top of each. Add melted butter, onion flakes, sugar, poppy seeds, sesame seeds, and honey mustard equally to each. Replace tops of buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and buns are toasty, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
