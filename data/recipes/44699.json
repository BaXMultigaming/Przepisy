  "ingredients": [
    "0.5 cup white sugar",
    "3 tablespoons unsweetened cocoa powder",
    "0.25 cup cornstarch",
    "0.125 teaspoon salt",
    "2.75 cups milk",
    "2 tablespoons butter, room temperature",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
