  "ingredients": [
    "2 cups all-purpose flour",
    "1.25 cups white sugar",
    "0.5 cup butter, softened",
    "0.25 cup milk",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup semisweet chocolate chips",
    "0.5 cup milk",
    "0.5 teaspoon vanilla extract",
    "18 candied pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease or line 18 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, butter, milk, eggs, vanilla extract, baking soda, and salt in a large mixing bowl. Mix using a rubber spatula until combined; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate chips, milk, and vanilla extract in a microwave-safe bowl. Stir. Microwave until melted, about 30 seconds. Mix together until it is a thick, dark chocolate sauce. Stir into flour mixture until completely combined and light brown in color.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 1/2 to 3/4 full. Place a candied pecan onto the top of each muffin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
