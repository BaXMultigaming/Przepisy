  "ingredients": [
    "3 eggs",
    "0.5 cup butter, softened",
    "0.5 cup white sugar",
    "1 teaspoon lemon zest",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking powder",
    "1.25 cups plums, pitted and quartered"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease and flour a 9-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate eggs into whites and yolks. Beat egg whites until stiff peaks form; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar together in a large bowl until light and fluffy. Beat in egg yolks and lemon zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour and baking powder together, then blend into butter mixture. Gently fold in egg whites. Spread cake batter evenly into the prepared pan. There will only be a little over an inch of batter. Arrange plums, skin-side down, in a nice pattern over the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a tester inserted in the center comes out clean, about 40 minutes. Transfer to a cooling rack and allow to cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
