  "title": "Plum Cake",
  "description": "This homemade plum cake recipe tops a simple cake batter with sliced fresh plums; bake until golden for a simple yet special dessert.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-06-14T11:34:48-04:00",
