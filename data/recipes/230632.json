  "ingredients": [
    "2 cups uncooked dried penne pasta",
    "3 squares Italian Herb Saute Express® Saute Starter",
    "1 pound boneless skinless chicken breasts",
    "0.5 cup chopped onion",
    "2 large tomatoes, chopped",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Cook pasta according to package directions; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 2 Saute Express® squares in 12-inch nonstick skillet over medium-low heat just until bubbles begin to form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Saute 13-18 minutes or until chicken is golden brown on both sides and done (165 degrees F). Remove from skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt remaining 1 Saute Express® square in skillet. Add onions; cook 1-2 minutes or until softened. Toss in pasta and tomatoes to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice chicken; serve over pasta. Sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
