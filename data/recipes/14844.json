  "ingredients": [
    "2 (3 ounce) packages cream cheese, softened",
    "1 (6 ounce) can pitted black olives, chopped",
    "1 (5 ounce) jar pitted green olives",
    "3 tablespoons chopped fresh parsley",
    "0.5 teaspoon crushed red pepper flakes",
    "salt and pepper to taste",
    "4 tablespoons sesame seeds"
  ],
  "steps": [
    {
      "text": "Whip softened cream cheese with a whisk in a medium-sized bowl. Add olives, parsley, and pepper flakes; season with salt and black pepper. Spoon mixture into a serving bowl; top with sesame seeds.",
