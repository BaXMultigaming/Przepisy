  "ingredients": [
    "30 chocolate sandwich cookies (such as Oreo®), crushed",
    "1 (14 ounce) can sweetened condensed milk",
    "1 cup semisweet chocolate chips",
    "0.75 cup all-purpose flour",
    "0.25 cup butter, softened",
    "1 teaspoon vanilla extract",
    "1 cup sweetened flaked coconut",
    "2 tablespoons powdered sugar, or more as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 8x8-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cookies, sweetened condensed milk, chocolate chips, flour, butter, and vanilla together in a large bowl. Fold in coconut. Press mixture into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 25 to 30 minutes. Dust with powdered sugar.",
