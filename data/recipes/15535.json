  "ingredients": [
    "1 cup margarine",
    "4 cups confectioners' sugar",
    "1 (14 ounce) can sweetened condensed milk",
    "2 cups shredded coconut",
    "2 cups chopped pecans",
    "2 teaspoons vanilla extract",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Es0ysewyvAA71DGMIhlObONvwDQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15535-martha-washington-candies-ddmfs-step-1-BG-4150-74db1513180c47e4b55f04f6f7649df4.jpg"
      ],
      "image": "assets/images/15535/step_01.webp"
    },
    {
      "text": "Mix margarine, confectioners' sugar, and condensed milk together in a large mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zY3lq6p4jKC5YVpPbw8o7q2hPu0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15535-martha-washington-candies-ddmfs-step-2-BG-4153-a50bb44170774522ae35cebe5f123bbb.jpg"
      ],
      "image": "assets/images/15535/step_02.webp"
    },
    {
      "text": "Add coconut, pecans, and vanilla; mix well, using a large, sturdy spoon. Chill until firm enough to handle, about 30 minutes..",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tPOKWYqG5y0k-vjCkBe5RmM0MuY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15535-martha-washington-candies-ddmfs-step-3-BG-4154-e1e8fde6d7774fb6b4ac61147681b9d5.jpg"
      ],
      "image": "assets/images/15535/step_03.webp"
    },
    {
      "text": "Form into small balls and place onto wax paper-lined cookie sheets. Chill until very firm, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7nhdykIYEAUNJOJtfTNgZWMYGds=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15535-martha-washington-candies-ddmfs-step-4-BG-4160-684fd28d91dd4faba8f28ac21f350de0.jpg"
      ],
      "image": "assets/images/15535/step_04.webp"
    },
    {
      "text": "Melt chocolate chips in the top of a double boiler over simmering water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a6PbnFve7t3eyv9BLyv4ZPeBeEE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15535-martha-washington-candies-ddmfs-step-5-BG-4166-9f147eb513714c7cb6f5afe8b7704d46.jpg"
      ],
      "image": "assets/images/15535/step_05.webp"
    },
    {
      "text": "Using a toothpick, dip each ball into melted chocolate. Let cool on wax paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/77D04WPyBkfNbtTl_N8YdID85I0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15535-martha-washington-candies-ddmfs-step-7-BG-4170-f95765a2c0fc492088159a7b7da92475.jpg"
