  "ingredients": [
    "0.75 cup packed light brown sugar",
    "0.5 cup butter, at room temperature",
    "1.25 cups all-purpose flour",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "0.25 cup heavy whipping cream, or to taste",
    "0.5 cup miniature chocolate chips, or more to taste"
  ],
  "steps": [
    {
      "text": "Beat brown sugar and butter together in a bowl using an electric mixer on medium speed until smooth and creamy. Beat flour, vanilla extract, and salt into creamed butter until combined. Slowly mix cream into butter mixture until desired consistency is reached; fold in chocolate chips.",
