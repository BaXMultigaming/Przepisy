    "publisher-tested"
  ],
  "ingredients": [
    "1.25 cups all-purpose flour, plus more for rolling",
    "1 tablespoon granulated sugar",
    "0.5 teaspoon kosher salt",
    "0.5 cup cold unsalted butter, cut into 1/2-inch pieces",
    "3 tablespoons ice water, or more as needed",
    "10 tablespoons unsalted butter, melted and cooled",
    "0.75 cup granulated sugar",
    "2 large eggs, at room temperature",
    "1 large egg yolk, at room temperature",
    "2 tablespoons canola oil",
    "1 teaspoon vanilla extract",
    "0.75 cup unsweetened cocoa powder",
    "0.5 cup all-purpose flour",
    "2 teaspoons instant espresso granules",
    "0.5 teaspoon kosher salt",
    "0.5 cup chopped walnuts or hazelnuts",
    "0.5 cup semisweet chocolate chips, divided"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P8RCSo2_hcK0PfQAIrQik7Rw1Ik=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8487044-brownie-pie-step-01-ba3c5dc9628b4069b4bde86150dfd53f.jpg"
      ],
      "image": "assets/images/8487044/step_01.webp"
    },
    {
      "text": "For the crust, combine flour, sugar, and teaspoon salt in a food processor and pulse about 3 times until combined. Scatter cold butter over flour mixture in food processor. Pulse about 6 times until butter resembles pea-sized pieces. Drizzle 3 tablespoons water over butter mixture. Pulse about 6 times until couscous-like beads of dough form, adding 1 more tablespoon ice water if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ksiuRKCyLG0CAi3z8KKu64HBLVo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8487044-brownie-pie-step-02-5fbff1d35156487bbe9d9cb1160544e8.jpg"
      ],
      "image": "assets/images/8487044/step_02.webp"
    },
    {
      "text": "Transfer dough to a work surface, and press into a single mass. Shape and flatten dough into a disk. Wrap in plastic wrap, and chill for at least 1 hour or up to 2 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-mOLX5fNmMLQxSSbtfqb0dtPGSI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8487044-brownie-pie-step-03-35d2c60dac67459baa4128fa3dddb602.jpg"
      ],
      "image": "assets/images/8487044/step_03.webp"
    },
    {
      "text": "Unwrap dough and place on a lightly floured work surface. Let dough sit at room temperature for 10 minutes to soften. Dust top of dough with flour. Using a lightly floured rolling pin, roll disk into a 12-inch circle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d55nkuc71xbibxc8IO_IqOQ_ZCY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8487044-brownie-pie-step-04-a8fd869ff5284448a98421bf0e60120e.jpg"
      ],
      "image": "assets/images/8487044/step_04.webp"
    },
    {
      "text": "Place in a 9-inch pie plate, pressing into bottom and up sides of pie plate. Fold edges under, and crimp as desired. Cover with plastic wrap, and freeze for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4rizNUst1dUf2-YFW53xIvnOef4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8487044-brownie-pie-step-05-5ec359c0219f4c20bf8e2783571fcf64.jpg"
      ],
      "image": "assets/images/8487044/step_05.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place parchment paper over dough in pie plate; fill with pie weights or dried beans. Bake in the preheated oven until crust is starting to set, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RMCE3Bot7Equj7CBixjGIxE2djg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8487044-brownie-pie-step-06-b7a3e4456877494aaebe9b90c94843db.jpg"
      ],
      "image": "assets/images/8487044/step_06.webp"
    },
    {
      "text": "Carefully remove pie plate from oven and take off parchment paper and pie weights. Return pie plate to oven, and bake until pie crust is light golden brown, 8 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VsFoEh-ZtyJLkqjZs3a_p4rSi8A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8487044-brownie-pie-step-07-69cd9b599cd54bc897146318380c6fc1.jpg"
      ],
      "image": "assets/images/8487044/step_07.webp"
    },
    {
      "text": "Transfer to a wire rack; let cool to room temperature, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RHsBnNFra-fSAEQFrHvkMU4KGCg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8487044-brownie-pie-step-08-6335774f05a2439dbbf1739643a392de.jpg"
      ],
      "image": "assets/images/8487044/step_08.webp"
    },
    {
      "text": "Whisk together melted butter, sugar, eggs, egg yolk, canola oil, and vanilla extract in a bowl until blended and smooth. Whisk in cocoa, flour, instant espresso, and salt just until combined. Stir in nuts and 1/4 cup chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WSEPJjOYROZ5nuE5MEI-3J62Ylg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8487044-brownie-pie-step-09-98fd6bc92e1b442f9ecf30c865b615fd.jpg"
      ],
      "image": "assets/images/8487044/step_09.webp"
    },
    {
      "text": "Scrape mixture into cooled crust, and smooth top with a small offset spatula. Sprinkle remaining 1/4 cup chocolate chips on top of the pie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Mp5hsIqn7as6fKTDzIqAWUJk_GA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8487044-brownie-pie-step-10-11058c38b3d04e029b35ccf045224b91.jpg"
      ],
      "image": "assets/images/8487044/step_10.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 30 to 35 minutes, covering the crust with aluminum foil if it gets too dark. Let cool 20 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oar3xI8kIS4JLxz6ayCj1oXbwY8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8487044-brownie-pie-step-11-71b09c371e104471933bdf6e1a318975.jpg"
      ],
      "image": "assets/images/8487044/step_11.webp"
    }
  ],
