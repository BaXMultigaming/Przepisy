  "ingredients": [
    "1 tablespoon paprika",
    "4 teaspoons dried thyme",
    "2 teaspoons onion powder",
    "2 teaspoons garlic powder",
    "1 tablespoon white sugar",
    "2 teaspoons salt",
    "1.5 teaspoons black pepper",
    "1 teaspoon cayenne pepper, or to taste",
    "1 teaspoon dried oregano",
    "0.5 teaspoon ground nutmeg",
    "0.75 teaspoon ground cumin"
  ],
  "steps": [
    {
      "text": "In a small jar with a lid, combine paprika, thyme, onion powder, garlic powder, sugar, salt, pepper, cayenne pepper, oregano, nutmeg, and cumin. Seal securely and shake vigorously to blend. Store in a cool dry place. Shake the jar before each use.",
