    "publisher-tested"
  ],
  "ingredients": [
    "cooking spray",
    "3 tablespoons white miso paste",
    "2 tablespoons water",
    "2 tablespoons mirin (Japanese sweet wine)",
    "2 tablespoons sake",
    "1 tablespoon brown sugar",
    "2 (7 ounce) black cod fillets"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YqCAzuv4_TuRxnulI3ipV943UCc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237637-Miso-Glazed-Black-Cod-step-1-152-5929a7d2091348ab8af3de987bb87c5b.jpg"
      ],
      "image": "assets/images/237637/step_01.webp"
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil and lightly grease the foil with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk miso, water, mirin, sake, and brown sugar together in a small skillet over medium heat until mixture simmers and thickens slightly, 1 to 3 minutes. Remove from the heat and let cool completely, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fcmTcTKe0Pnxe-X6BBslID7B4Ug=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237637-Miso-Glazed-Black-Cod-step-2-157-3a7f6a2e88694fe7944b49ae30640d57.jpg"
      ],
      "image": "assets/images/237637/step_03.webp"
    },
    {
      "text": "Place cod fillets on the prepared baking sheet. Brush fillets all over with cooled miso mixture. Marinate at room temperature for 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A6m6U1a0mU9kjY9UsW8SN3WIEA4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237637-Miso-Glazed-Black-Cod-step-3-159-2256fb3ef07640c49f4bc0245f568737.jpg"
      ],
      "image": "assets/images/237637/step_04.webp"
    },
    {
      "text": "Broil in the preheated oven for 5 minutes. Turn the baking sheet 180 degrees and continue broiling until fish flakes easily with a fork, about 5 minutes more. Remove pin bones before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jH8wi9fo0tIcaCL1RPO1c-7zRPQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237637-Miso-Glazed-Black-Cod-step-4-160-c24554c2daee4d7c9756d548d8d9bf6c.jpg"
      ],
      "image": "assets/images/237637/step_05.webp"
    },
    {
      "text": "Serve with your favorite sides, enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PMS71CQn0KsQfV8xTXr0zDdt97s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237637-Miso-Glazed-Black-Cod-4x3-177-c65cd0606c0741ecbd92407a57d648ae.jpg"
      ],
      "image": "assets/images/237637/step_06.webp"
    }
  ],
