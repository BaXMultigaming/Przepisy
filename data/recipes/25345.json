  "ingredients": [
    "0.5 (12 ounce) package uncooked lasagna noodles",
    "1 (12 ounce) package firm tofu, crumbled",
    "2 eggs",
    "0.25 teaspoon salt",
    "0.25 teaspoon black pepper",
    "0.25 teaspoon ground nutmeg",
    "2 tablespoons milk",
    "1 cup spaghetti sauce",
    "1 tablespoon dried parsley",
    "2 cups shredded mozzarella cheese, divided",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add lasagna and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl combine tofu, eggs, salt, pepper, nutmeg, milk, spaghetti sauce, parsley and 1 cup of mozzarella cheese. Spread a layer in the bottom of a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer lasagna noodles with the sauce mixture, ending with sauce. Sprinkle with remaining mozzarella and Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 25 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
