  "ingredients": [
    "nonstick cooking spray",
    "1 cup all-purpose flour",
    "0.33333334326744 cup white sugar",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup reduced-fat plain yogurt",
    "1 egg",
    "2 tablespoons butter, melted",
    "1 teaspoon vanilla extract",
    "1 cup fresh or frozen raspberries",
    "3 tablespoons brown sugar",
    "1 tablespoon slivered almonds",
    "0.25 cup confectioners' sugar",
    "1 teaspoon fat free milk",
    "0.25 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly coat an 8-inch round cake pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, white sugar, baking powder, baking soda, and salt into a large bowl. Whisk yogurt, egg, melted butter, and 1 teaspoon vanilla extract together in a bowl until well combined; stir into flour mixture until batter is well moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss raspberries and brown sugar together in a small bowl until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour ⅔ batter into the prepared pan; sprinkle with raspberry mixture and almonds. Spoon remaining ⅓ batter on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center springs back when lightly touched, 35 to 40 minutes. Cool completely in the pan on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir confectioners' sugar, milk, and ¼ teaspoon vanilla extract together in a small bowl until glaze is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle glaze over cooled coffee cake. Serve at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
