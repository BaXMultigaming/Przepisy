  "ingredients": [
    "1.5 gallons water",
    "1 (12 fluid ounce) can frozen orange juice concentrate, thawed",
    "1 cup kosher salt",
    "1 orange, sliced",
    "1 lemon, sliced",
    "1 lime, sliced",
    "1 tablespoon dried thyme",
    "1 tablespoon ground black pepper",
    "3 cloves garlic",
    "2 bay leaves"
  ],
  "steps": [
    {
      "text": "Combine water, orange juice concentrate, salt, orange slices, lemon slices, lime slices, thyme, black pepper, garlic, and bay leaves in a large stockpot; bring to a boil. Remove from heat; cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash and pat turkey dry (make sure giblets are removed). Place turkey, breast-side down, into brine, making sure the cavity is filled. Place the stockpot in the refrigerator. Brine turkey for 8 to 48 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
