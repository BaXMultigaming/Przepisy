  "ingredients": [
    "0.5 cup butter, softened",
    "0.66666668653488 cup packed brown sugar",
    "2 eggs",
    "1 cup mashed bananas",
    "1 teaspoon vanilla extract",
    "0.75 cup all-purpose flour",
    "1.3333333730698 cups rolled oats",
    "0.25 teaspoon salt",
    "1 teaspoon baking soda",
    "0.75 cup rolled oats",
    "0.33333334326744 cup packed brown sugar",
    "2 tablespoons butter, melted",
    "2 tablespoons chopped walnuts",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Stir together flour, 1 1/3 cups oats, salt, and baking soda.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream 1/2 cup butter or margarine with 2/3 cup brown sugar. Beat in the eggs, then the bananas and vanilla. Beat the flour mixture into the banana mixture. Turn the batter into a greased and floured 8 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 3/4 cup oats, 1/3 cup brown sugar, melted butter or margarine, walnuts, and cinnamon together until crumbly. Sprinkle evenly over the top of the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven at 350 degrees F (175 degrees C) for 40 to 45 minutes, or until it tests done. Transfer to a rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
