  "ingredients": [
    "2 cups sour cream",
    "0.25 cup prepared horseradish, or to taste",
    "1 teaspoon lemon juice",
    "salt to taste",
    "1 pinch paprika",
    "1 pinch garlic salt",
    "0.25 teaspoon dried minced onion"
  ],
  "steps": [
    {
      "text": "In a medium bowl, stir together sour cream, horseradish, and lemon juice. Season with salt, paprika, garlic salt, and minced onion. Mix and then chill for about 20 minutes to let the flavors blend before you start dipping.",
