  "ingredients": [
    "2.25 cups white sugar",
    "1 cup vegetable oil",
    "3 large eggs, lightly beaten",
    "3 teaspoons vanilla extract",
    "2 cups shredded zucchini",
    "3 cups all-purpose flour",
    "1 tablespoon ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "1 pint fresh blueberries"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v29DdQVinUGkZAIsXc8V5aXr998=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-74657-blueberry-zucchini-bread-DDMFS-Step-1a-58fe25c209b64a7a9d44afde455945ba.jpg"
      ],
      "image": "assets/images/74657/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease 4 mini loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PurNE6GLNDnBkHTO5xjf8z7mw74=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-74657-blueberry-zucchini-bread-DDMFS-Step-1b-11022abad2cb4bddaa3ccde4f2451595.jpg"
      ],
      "image": "assets/images/74657/step_02.webp"
    },
    {
      "text": "Beat sugar, oil, eggs, and vanilla together in a large bowl; fold in shredded zucchini.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Kzp1IlCjZVmi5oueLGnTHjnP30I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-74657-blueberry-zucchini-bread-DDMFS-Step-2-30905d2d1a5448819725c78618431ce9.jpg"
      ],
      "image": "assets/images/74657/step_03.webp"
    },
    {
      "text": "Beat in flour, cinnamon, salt, baking powder, and baking soda until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9w7vTAKT75Wjrc3W9Hxm-mi1F8I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-74657-blueberry-zucchini-bread-DDMFS-Step-3-59e8a3661362441a835448c6c6d005ba.jpg"
      ],
      "image": "assets/images/74657/step_04.webp"
    },
    {
      "text": "Gently fold in blueberries. Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3_egxQNb3wRv46tHZmztFO2t8XM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-74657-blueberry-zucchini-bread-DDMFS-Step-4-f43831e0e5ee42899dade20d1db21024.jpg"
      ],
      "image": "assets/images/74657/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HDnRKspbGI8_OA-d-hPgqe7dUe4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-74657-blueberry-zucchini-bread-DDMFS-Step-5-8ff12de52e18482ab648025d8f4f50cb.jpg"
      ],
      "image": "assets/images/74657/step_06.webp"
    },
    {
      "text": "Cool in the pans for 20 minutes, then turn out onto a wire rack to cool completely. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9sliY8-kZs_aWIdtG1y1nBpEZp8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-74657-blueberry-zucchini-bread-DDMFS-4x3-f247949e36464a6da9f58a6e625334d6.jpg"
