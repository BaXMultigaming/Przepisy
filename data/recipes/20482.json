    "publisher-tested"
  ],
  "ingredients": [
    "1 (12 ounce) package corn tortillas",
    "3 tablespoons lime juice",
    "1 tablespoon vegetable oil",
    "1 teaspoon ground cumin",
    "1 teaspoon chili powder",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DH8MvrL1u7535_jD1ogMOQt5U8U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20482-baked-tortilla-chips-DDMFS-step-01-0404-a95d6969b569416eb22d232f3319842f.jpg"
      ],
      "image": "assets/images/20482/step_01.webp"
    },
    {
      "text": "Stack tortillas in layers of 5 or 6. Cut through each stack to make 8 wedges. Arrange wedges in a single layer on rimmed baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8U89g8BLGuBudhoxhW96Xd5H_Tg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20482-baked-tortilla-chips-DDMFS-step-02-0405-db4c975506414d3e961a8670d8087d77.jpg"
      ],
      "image": "assets/images/20482/step_02.webp"
    },
    {
      "text": "Combine lime juice and oil in a spray bottle or mister; shake until well mixed. Spray the tops of the tortilla wedges until slightly moist.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U139eryUPTQIdQhuRNlFeYB16sQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20482-baked-tortilla-chips-DDMFS-step-03-0424-cff5b15f3e7f4f58a3de651ffec4311a.jpg"
      ],
      "image": "assets/images/20482/step_03.webp"
    },
    {
      "text": "Combine cumin, chili powder, and salt in a small bowl; sprinkle mixture over the chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S1Id3MGbcflUrvbkuKtbgUicizE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20482-baked-tortilla-chips-DDMFS-step-04-0427-556e7d1bc6d64295b92cf1d8472ed18b.jpg"
      ],
      "image": "assets/images/20482/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 7 minutes. Remove from the oven. Flip chips, then mist and season again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X_qDv2FjUXjIQ7WcpY-GLiDznbY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20482-baked-tortilla-chips-DDMFS-step-05-0428-e859f51c9c7d478a82daa8ee74e19cdc.jpg"
      ],
      "image": "assets/images/20482/step_05.webp"
    },
    {
      "text": "Return to the oven, rotating the pans and switching racks. Bake, checking often to ensure they don't burn, until chips are lightly browned and crisp, 5 to 8 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3snU2OTo-sB4mnL8EqQ7euJ1oh0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20482-baked-tortilla-chips-DDMFS-step-06-0432-62b0421f1fec42cd9971719c10070e16.jpg"
      ],
      "image": "assets/images/20482/step_06.webp"
    },
    {
      "text": "Remove from the oven and cool slightly before serving. Chips will crisp up more as they cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/53PU8P9JElB1bItRUXfPnPttGmc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20482-baked-tortilla-chips-DDMFS-step-07-0434-5369384b65a843b8978cf2ba7c02f794.jpg"
      ],
      "image": "assets/images/20482/step_07.webp"
    },
    {
      "text": "Enjoy with a side of salsa!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YZgIEBUG_a2lGC6Oywia0q2ZoTk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20482-baked-tortilla-chips-DDMFS-4x3-9c0db75a920c4bebbb6166984c8ecf00.jpg"
      ],
      "image": "assets/images/20482/step_08.webp"
    }
  ],
