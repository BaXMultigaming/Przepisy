  "ingredients": [
    "1 tablespoon canola oil",
    "1 tablespoon Thai red curry paste, or more to taste",
    "1 shallot, minced",
    "1 clove garlic, minced",
    "1 (3.75 ounce) can sardines in oil, drained",
    "1 tablespoon unsweetened coconut cream"
  ],
  "steps": [
    {
      "text": "Heat canola oil in a skillet. Stir in red curry paste; cook and stir 3 to 5 seconds. Add shallot and garlic; cook and stir until fragrant. Add sardines; cook and stir until skins slightly browned and coated in paste mixture. Gently stir in coconut cream; toss to coat sardines. Bring mixture to a boil and cook until sauce thickens, about 5 minutes.",
