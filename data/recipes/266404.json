  "ingredients": [
    "6 Tyson® Fresh Chicken Drumsticks",
    "0.33333334326744 cup flour",
    "0.25 cup fat-free egg product",
    "1 tablespoon water",
    "1 cup baked potato chips, coarsely crushed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F. Spray baking sheet with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour in large resealable plastic bag. Blend egg product and water in small shallow dish. Place crushed potato chips in separate shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add drumsticks to flour in bag; shake to coat evenly. One at a time, dip drumsticks in egg mixture; coat evenly with potato chips and place on baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 30 to 35 minutes or until chicken reaches an internal temperature of 180 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
