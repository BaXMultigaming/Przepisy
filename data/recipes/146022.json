  "ingredients": [
    "1 package pita pockets",
    "2 tablespoons olive oil",
    "1 tablespoon garlic powder",
    "1 teaspoon kosher salt",
    "1 teaspoon garlic salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush one side of each pita pocket with oil; sprinkle with garlic powder, kosher salt, and garlic salt. Evenly slice each pocket into 4 triangles; arrange, oiled-sides up, on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pita chips are light brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
