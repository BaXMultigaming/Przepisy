  "title": "Best Ever Cinnamon Buns",
  "description": "Yellow cake mix is the secret to the success of these yeasted cinnamon buns. They make a rich, sweet breakfast treat.",
  "authors": [
    "anne"
  ],
  "date_published": "1998-12-30T13:43:05-05:00",
