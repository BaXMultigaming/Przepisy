  "ingredients": [
    "2 (.25 ounce) packages active dry yeast",
    "2.5 cups warm water (110 degrees F)",
    "1 (18.25 ounce) package yellow cake mix",
    "6 cups all-purpose flour, divided",
    "3 eggs",
    "0.33333334326744 cup vegetable oil",
    "1.5 teaspoons salt",
    "0.5 cup butter, softened",
    "4 tablespoons white sugar",
    "2 tablespoons ground cinnamon",
    "0.25 cup butter, melted",
    "3 cups confectioners' sugar",
    "1.5 teaspoons vanilla extract",
    "0.66666668653488 cup milk"
  ],
  "steps": [
    {
      "text": "In a large bowl, dissolve yeast in warm water, and let stand for 3 minutes. Add cake mix, 1 cup flour, eggs, oil, and salt; beat well. Stir in remaining flour until a soft dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead on well floured surface for about 5 minutes. Place in a greased bowl, and turn to coat the dough surface. Let rise until doubled in bulk, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Punch down, and divide into two equal parts. Roll out each section on a lightly floured surface. Spread each with softened butter and sprinkle with sugar and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll up like jelly rolls and cut buns 1 1/2 inches thick with a piece of dental floss or a dull knife. Place in greased baking pans, and allow to rise until doubled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 25 to 35 minutes or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine confectioners sugar, 1/4 cup melted butter, vanilla, and milk. Remove baked buns from oven and drizzle with frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
