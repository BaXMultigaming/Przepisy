  "ingredients": [
    "1 cup chocolate hazelnut spread",
    "4 (7 inch) pre-made crepes",
    "4 bananas, sliced",
    "1 (7 ounce) can pressurized whipped cream"
  ],
  "steps": [
    {
      "text": "Spread 1/4 cup of chocolate hazelnut spread onto each crepe. Arrange 1 sliced banana down the center of each one. Roll up, and place in a warm skillet over medium heat. Let them warm up for about 90 seconds. Transfer to plates, and serve topped with whipped cream.",
