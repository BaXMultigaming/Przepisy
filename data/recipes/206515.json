  "ingredients": [
    "3 pounds yellow summer squash, cut into 1-inch cubes",
    "0.75 cup dry bread crumbs",
    "0.5 cup chopped onion",
    "2 large eggs",
    "0.5 cup butter, melted",
    "1 tablespoon white sugar",
    "1 teaspoon salt",
    "0.5 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
