  "ingredients": [
    "1.25 cups white sugar",
    "0.75 cup ghee (clarified butter)",
    "3.5 tablespoons ghee (clarified butter)",
    "2 cups all-purpose flour",
    "4 eggs",
    "0.5 teaspoon vanilla extract",
    "3 tablespoons milk",
    "1 teaspoon baking powder",
    "2 teaspoons lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 355 degrees F (180 degrees C). Grease two 8-inch cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and 3/4 cup plus 3 1/2 tablespoons ghee together in a large bowl with an electric mixer. Add flour; mix until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and vanilla extract together in a separate bowl; add to the flour mixture and mix well. Add milk and baking powder; stir. Mix in lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
