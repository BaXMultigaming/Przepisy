  "ingredients": [
    "1 cup vegetable oil",
    "3 eggs",
    "1 (15 ounce) can pumpkin puree",
    "1 teaspoon vanilla extract",
    "2.5 cups white sugar",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground allspice",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "0.25 teaspoon salt",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 10-inch Bundt or tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend oil, beaten eggs, pumpkin and vanilla together in a large bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, baking soda, ground nutmeg, ground allspice, ground cinnamon, ground cloves and salt together. Add flour mixture to pumpkin mixture and stir until just combined. Fold in chopped walnuts; pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the middle comes out clean, about 1 hour. Let cake cool in the pan for 5 minutes. Turn out onto a plate and dust with confectioners’ sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
