  "ingredients": [
    "1 egg",
    "2 tablespoons vanilla yogurt",
    "2 tablespoons chopped walnuts",
    "1 tablespoon all-purpose flour",
    "1 tablespoon flax seed meal",
    "1 tablespoon quick-cooking oats",
    "1 tablespoon honey",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Whisk egg in a microwave-safe mug. Stir yogurt, walnuts, flour, flax, oats, honey, cinnamon, and baking powder into egg until well-combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave until set, 90 to 100 seconds. Turn out over a plate to remove muffin from mug.",
