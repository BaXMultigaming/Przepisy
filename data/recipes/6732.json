  "title": "Chocolate Chip Pumpkin Bread",
  "description": "This pumpkin chocolate chip bread is loaded with sweet mini chocolate chips and chopped walnuts; cinnamon and nutmeg add even more fall flavor.",
  "authors": [
    "Star Pooley"
  ],
  "date_published": "1998-06-25T13:09:52-04:00",
