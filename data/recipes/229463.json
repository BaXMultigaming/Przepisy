  "ingredients": [
    "0.75 cup Truvia® Baking Blend",
    "1 cup peanut butter",
    "3 tablespoons shortening",
    "3 tablespoons unsalted butter plus",
    "2 teaspoons unsalted butter",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "2 cups all-purpose flour, sifted",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Truvia® Baking Blend, peanut butter, shortening, butter, egg, and vanilla in a large bowl and mix on low speed until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a second smaller bowl, whisk together flour, baking soda, and salt. Add slowly to the larger bowl and mix until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 1 1/4 inch balls, flattening slightly on the top and bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cookies 3 inches apart on a parchment-lined or ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a fork, press a crisscross pattern in each cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 12-14 minutes or until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow to rest 5 minutes on pan, then place cookies on a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
