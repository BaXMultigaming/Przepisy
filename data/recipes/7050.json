  "title": "Julekake",
  "description": "Try this Julekake recipe, a Norwegian cardamom bread adorned with candied cherries, citron, and golden raisins.",
  "authors": [
    "Janice"
  ],
  "date_published": "1998-12-14T03:19:01-05:00",
