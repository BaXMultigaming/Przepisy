  "ingredients": [
    "2 (.25 ounce) packages active dry yeast",
    "0.5 cup warm water (110 degrees F/45 degrees C)",
    "2 cups cold milk",
    "1 cup white sugar",
    "1 cup butter, melted",
    "2 teaspoons salt",
    "8.5 cups all-purpose flour, divided",
    "1 cup golden raisins",
    "0.5 cup candied cherries, sliced",
    "0.5 cup chopped candied citron",
    "1 tablespoon ground cardamom",
    "1 large egg white, beaten"
  ],
  "steps": [
    {
      "text": "Dissolve yeast in warm water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cold milk into a wide, shallow, heavy-bottomed saucepan. Heat over medium heat, stirring frequently, until small bubbles appear around the outside of the saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and transfer to a large bowl. Stir in sugar, melted butter, and salt; let sit until lukewarm, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add yeast mixture, then stir in 4 cups flour. Cover and let rise in a warm place until doubled in size, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Punch down dough. Stir in raisins, cherries, citron, and cardamom. Work in remaining 4 1/2 cups flour until a soft dough forms. Cover and let rise in a warm place until doubled in size, 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead dough slightly on a lightly floured surface. Divide into fourths and form into round loaves. Place loaves onto greased cookie sheets. Cover and let rise in a warm place until doubled in size, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Brush loaves with egg white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
