  "ingredients": [
    "4 cups white sugar",
    "1 cup milk",
    "0.5 cup butter",
    "12 ounces peanut butter",
    "1 (7 ounce) jar marshmallow creme",
    "0.66666668653488 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Grease a 9x13-inch baking dish; set aside.",
