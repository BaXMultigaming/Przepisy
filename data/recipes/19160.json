      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rj8AMe-v0A2v6gRmWn5rcf-xxBo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19160-worlds-best-peanut-butter-fudge-VAT-step-02-51db5cc631174f8288b2b397119ba973.jpg"
      ],
      "image": "assets/images/19160/step_02.webp"
    },
    {
      "text": "Stir in peanut butter and marshmallow creme. Mix in flour gradually until incorporated.",
      "section": null,
