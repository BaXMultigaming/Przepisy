  "ingredients": [
    "1 cup all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon pepper",
    "1 cup crushed saltine crackers",
    "2 eggs, beaten",
    "0.5 cup butter",
    "5 green tomatoes, sliced 1/2 inch thick"
  ],
  "steps": [
    {
      "text": "Stir flour, salt, and black pepper together in a shallow bowl until well combined. Place crushed crackers in a second shallow bowl. Beat eggs in a third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each tomato slice in egg to coat, then dredge in flour mixture. Dip floured tomato slice back into egg, then press into crushed crackers until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook tomato slices, in batches, in hot butter until golden brown on each side, 3 to 5 minutes per side. Add more butter to the skillet as needed. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
