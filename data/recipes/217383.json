  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "1 cup grated Parmesan cheese",
    "0.5 cup mayonnaise",
    "2 cloves garlic, minced",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "1 (10 ounce) container refrigerated pizza dough",
    "2 tablespoons olive oil",
    "1 teaspoon Italian seasoning",
    "2 tablespoons olive oil",
    "1 small red bell pepper, sliced",
    "0.5 small red onion, sliced",
    "2 teaspoons Italian seasoning",
    "2 (6.5 ounce) cans small shrimp, drained"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Stir cream cheese, Parmesan cheese, mayonnaise, garlic, and spinach together until evenly mixed; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press pizza dough onto a baking sheet and brush with 2 tablespoons of olive oil. Sprinkle with 1 teaspoon Italian seasoning. Bake in the preheated oven until golden brown, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat 2 tablespoons of olive oil in a skillet over medium heat; cook bell pepper and onion until tender, about 5 minutes. Season with 2 teaspoons of Italian seasoning; stir in shrimp and cook until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread spinach mixture on cooked pizza crust; spread shrimp and vegetable mixture on top. Slice into pieces to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
