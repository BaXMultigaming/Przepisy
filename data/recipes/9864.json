  "ingredients": [
    "1.25 cups white sugar",
    "1 cup butter",
    "3 egg yolks",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon cream of tartar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C). Lightly grease 2 cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together sugar and butter. Beat in egg yolks and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour, baking soda, and cream of tartar. Stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into walnut size balls and place 2 inches apart on cookie sheet. Don't flatten. Bake 10 to 11 minutes, until tops are cracked and just turning color.",
      "section": null,
      "name": null,
      "url": null,
