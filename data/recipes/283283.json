  "ingredients": [
    "1 (4 pound) corned beef brisket, seasoning packet discarded",
    "1 tablespoon whole black peppercorns",
    "4 whole cloves",
    "0.25 teaspoon cayenne pepper",
    "1 pinch ground cinnamon",
    "1 (15 ounce) can dark Irish stout beer (such as Guinness®)",
    "2 medium heads garlic, cloves separated",
    "4 bay leaves"
  ],
  "steps": [
    {
      "text": "Place brisket, fat-side down, into a slow cooker. Cover with hot water and cook on High for 1 hour. Drain and discard water from the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add peppercorns, cloves, cayenne, and cinnamon to a tea ball or spice bag. Place in the slow cooker with beer, garlic cloves, and bay leaves. Add more water to just cover the brisket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Medium for 5 hours. Remove brisket carefully; it will be very tender and may fall apart or break in half. Let meat rest before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
