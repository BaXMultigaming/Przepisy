  "ingredients": [
    "1.125 cups warm water",
    "4 tablespoons butter",
    "2 cups whole wheat flour",
    "1 cup bread flour",
    "1.5 teaspoons salt",
    "2 tablespoons white sugar",
    "0.25 cup potato flakes",
    "1.25 teaspoons active dry yeast"
  ],
  "steps": [
    {
      "text": "Combine water and butter in a bread machine pan. Add, respectively, the whole wheat flour, bread flour, salt, sugar, and potato flakes; top with yeast, assuring yeast and salt do not mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Select Whole Wheat cycle; press Start.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove loaf from pan to a wire rack to cool.",
