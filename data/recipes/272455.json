  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup shortening",
    "3 teaspoons white sugar",
    "1 teaspoon salt",
    "0.5 cup water",
    "1 cup jam"
  ],
  "steps": [
    {
      "text": "Combine flour, shortening, sugar, and salt in the bowl of a food processor; pulse until the mixture resembles coarse crumbs. Add water; process until it forms a dough ball. Wrap dough ball in plastic wrap; refrigerate until well chilled, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease two 12-cup shallow muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough out until thin; cut into rounds with a cookie cutter. Place each round in a muffin cup. Add 2 teaspoons jam to each cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 20 minutes. Cool tarts on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
