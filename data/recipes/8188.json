  "ingredients": [
    "1.5 cups raisins",
    "0.75 cup white sugar",
    "0.5 cup butter, cut into pieces",
    "2 eggs",
    "0.5 cup milk",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "salt to taste",
    "0.5 cup chopped walnuts",
    "0.25 cup corn syrup"
  ],
  "steps": [
    {
      "text": "Place raisins, sugar, butter, slightly beaten eggs, milk, and vanilla in a large heavy-bottomed saucepan. Cook over medium heat, stirring frequently, until mixture is hot, slightly thickened, and just beginning to bubble. Cool slightly, uncovered, in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour with baking powder, baking soda, and salt in a large mixing bowl. Make a well in centre, and pour in warm raisin mixture; stir just until combined. Stir in nuts until evenly mixed. Spoon batter into greased muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in center of oven at 350 degrees F (190 degrees C) until golden, about 15 to 17 minutes. Remove from oven, and immediately pour about 1 teaspoon syrup over each muffin. Cool muffins in pan for 10 minutes, then remove to a rack. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
