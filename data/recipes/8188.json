  "title": "Butter Tart Muffins with Raisins",
  "description": "Muffins as tasty as butter tarts without the calories. Rum or butterscotch flavorings make tasty variations.",
  "authors": [
    "HELEJEAN"
  ],
  "date_published": "1999-04-07T23:33:01-04:00",
