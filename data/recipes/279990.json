  "ingredients": [
    "cooking spray",
    "2 sweet potatoes, halved lengthwise",
    "2 teaspoons olive oil",
    "2 tablespoons coconut oil",
    "0.25 cup diced sweet onion",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon white (shiro) miso",
    "1 tablespoon soy sauce",
    "2 tablespoons brown sugar",
    "1 scallion, sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with foil and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush cut sides of sweet potatoes with olive oil. Lay cut side-down onto the baking sheet. Brush skins with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until cooked through, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, prepare miso-scallion butter. Warm coconut oil in a small saucepan over medium heat. Add onion and ginger and cook for 3 to 4 minutes. Remove from heat and add miso, pressing miso against the saucepan with the back of a spoon to soften. Add soy sauce, brown sugar, and scallion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat over low, stirring constantly, until sugar is completely melted and mixture is warmed through, about 3 minutes. Do not boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove sweet potatoes from the oven and flip over. Cut a slit into the sweet potato flesh and spoon miso butter over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
