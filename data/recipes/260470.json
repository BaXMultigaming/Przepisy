    "publisher-tested"
  ],
  "ingredients": [
    "1 tablespoon vegetable oil",
    "2 (8 inch) flour tortillas",
    "2 oven-safe ramekins, about 4 inches in diameter",
    "Aluminum foil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush oil on both sides of tortillas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HyPKtRByQ6z7z4SROCVmCx7H43s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260470-CrispyBasketBurritos-Step-2-0111-752111e858d14274be25c9bf33585dc1.jpg"
      ],
      "image": "assets/images/260470/step_02.webp"
    },
    {
      "text": "Invert ramekin on a work surface. Center tortilla over bottom of the ramekin; gently shape tortilla down around sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_JJR6JZ2AspBY1cARIx_KfdbIQo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260470-CrispyBasketBurritos-Step-2-0113-b6644651e2714fc2af87864ad4d641ef.jpg"
      ],
      "image": "assets/images/260470/step_03.webp"
    },
    {
      "text": "Place a double layer of aluminum foil over tortilla and press to form a bowl around the ramekin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YMacJkLohuF98GMFztwTE-UA9x0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260470-CrispyBasketBurritos-Step-3-0115-ee0b35ed5a1d4b37ac1406b33b1ec5d8.jpg"
      ],
      "image": "assets/images/260470/step_04.webp"
    },
    {
      "text": "Place right-side-up on a baking sheet. Leave about 1/2-inch of tortilla exposed above foil, so it gets browned and crispy when baked. Repeat this step with second tortilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wHIhOEXJbF1Ra2ktuBAF2ld-Whc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260470-CrispyBasketBurritos-Step-4-0114-be2b007691d44f8bb0bd363270bf9983.jpg"
      ],
      "image": "assets/images/260470/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven for 5 minutes. Use tongs to remove the ramekins from shells. Continue baking shells until lightly browned, about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully remove foil from around shells. Flatten foil sheets and invert shells on them. Bring foil up just around bottom of shells to protect top edge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IAzk9opnCy-FVtSSlcCGRjgLGYM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260470-CrispyBasketBurritos-Step-5-0116-b2e5fb41a0e146c1be0afd129913191e.jpg"
      ],
      "image": "assets/images/260470/step_07.webp"
    },
    {
      "text": "Bake shells until browned and crispy, 8 to 10 minutes. Invert shells and continue baking until crisp, 3 to 5 minutes. Watch them carefully, so they don't burn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jF3kRrkGhWhaV7gqNtvgvShI03Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260470-CrispyBasketBurritos-Step-6-0117-eb81f91b66c042389b204736cd6bf646.jpg"
      ],
      "image": "assets/images/260470/step_08.webp"
    },
    {
      "text": "Transfer basket burritos to a rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1Gxr7bVCMPgDMhKc_c7_P8HhNH4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260470-CrispyBasketBurritos-0128-4x3-1-32c3a886eb574027aa99f481180c78c7.jpg"
      ],
      "image": "assets/images/260470/step_10.webp"
    }
  ],
