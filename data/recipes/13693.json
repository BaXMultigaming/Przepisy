  "title": "Bread and Celery Stuffing",
  "description": "A basic bread dressing or stuffing recipe for your 10- to 12-pound turkey with savory flavors from celery, onion and seasonings. Simple and easy.",
  "authors": [
    "Carlota Chmielewski"
  ],
  "date_published": "1998-12-03T23:03:28-05:00",
