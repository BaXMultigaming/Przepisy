  "ingredients": [
    "1 (1 pound) loaf sliced white bread",
    "0.75 cup butter or margarine",
    "1 onion, chopped",
    "4 stalks celery, chopped",
    "2 teaspoons poultry seasoning",
    "salt and pepper to taste",
    "1 cup chicken broth"
  ],
  "steps": [
    {
      "text": "Let bread slices air dry for 1 to 2 hours, then cut into cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a Dutch oven or large saucepan over medium heat. Add onion and celery and cook until soft. Season with poultry seasoning, salt, and pepper. Stir in bread cubes until evenly coated. Moisten with chicken broth; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill, and use as stuffing for turkey, or bake in a buttered casserole dish at 350 degrees F (175 degrees C) for 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
