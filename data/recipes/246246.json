  "ingredients": [
    "1 cup water",
    "0.5 cup rolled oats",
    "1 tablespoon cooked real bacon bits",
    "1 teaspoon butter",
    "0.5 teaspoon Creole seasoning (such as Tony Cachere's®)"
  ],
  "steps": [
    {
      "text": "Place water and oats in a microwave-safe bowl. Cook at 50% power, stirring half way through cooking, until oats are softened, 3 to 5 minutes. Stir in butter until melted. Stir in bacon bits and Creole seasoning until evenly distributed.",
