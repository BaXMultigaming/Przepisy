  "ingredients": [
    "1.5 cups canola oil",
    "2 tablespoons crushed red pepper flakes",
    "1 (1 ounce) packet ranch dressing mix",
    "1 tablespoon chili powder",
    "1 (16 ounce) package Whole Wheat Saltine Crackers"
  ],
  "steps": [
    {
      "text": "Whisk canola oil, crushed red pepper flakes, ranch dressing mix, and chili powder together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide crackers evenly into two 1-gallon-sized sealable bags. Pour oil mixture evenly over crackers; seal the bags and flip to allow oil mixture to run over the crackers for 5 minutes; flip again. Repeat the flipping every five minutes to evenly coat the crackers for about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove crackers from the bags and spread onto large platters. Allow to sit, 8 hours to overnight before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
