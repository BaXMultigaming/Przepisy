  "title": "Cheater's Thanksgiving Turkey",
  "description": "Lean turkey breast cutlets are breaded in tasty seasoned stuffing crumbs and baked in the oven for a quick dinner.",
  "authors": [
    "Nancy Benson"
  ],
  "date_published": "2019-04-03T23:54:07-04:00",
