  "ingredients": [
    "3 tablespoons vegetable oil",
    "1.5 pounds catfish fillets, cut into serving pieces",
    "1 cup cornmeal",
    "2 teaspoons Creole seasoning",
    "1 teaspoon paprika",
    "1 teaspoon white sugar",
    "0.5 teaspoon ground black pepper",
    "2 eggs, lightly beaten",
    "1 tablespoon hot pepper sauce or water"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 425 degrees F (220 degrees C). Grease a 13x9 glass baking dish with the oil, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse the catfish fillets, and pat dry. In a shallow bowl, combine the cornmeal, creole seasoning, paprika, sugar, and black pepper. Combine the eggs and hot sauce or water in a another bowl. Dip the fillets in the egg mixture, dredge in the cornmeal mixture, and arrange in the baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 minutes, or until cooked through and golden brown. Turn once during cooking. Place catfish on a paper-towel lined plate, and serve immediately with additional hot sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
