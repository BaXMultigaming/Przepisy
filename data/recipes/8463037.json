  "title": "Easter Dirt Cake",
  "description": "This fun Easter dirt cake made with layers of chocolate cookies and creamy pudding is an easy, no-bake holiday dessert that the kids will love decorating.",
  "authors": [
    "Pam Lolley"
  ],
  "date_published": "2022-08-25T16:07:41-04:00",
