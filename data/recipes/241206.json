  "ingredients": [
    "1 (4 pound) package country-style pork ribs, or to taste",
    "1 (20 ounce) can pineapple chunks, undrained",
    "2 (8 ounce) cans tomato sauce",
    "2 medium green bell peppers, sliced",
    "1 medium onion, chopped",
    "0.5 cup packed brown sugar",
    "0.25 cup cider vinegar",
    "0.25 cup tomato paste",
    "2 tablespoons Worcestershire sauce",
    "1 clove garlic, minced"
  ],
  "steps": [
    {
      "text": "Place ribs in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix undrained pineapple, tomato sauce, bell peppers, onion, brown sugar, vinegar, tomato paste, Worcestershire sauce, and garlic together in a bowl; pour over ribs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until meat pulls away easily from the bone, 8 to 10 hours. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
