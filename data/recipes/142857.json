  "ingredients": [
    "1 tablespoon butter",
    "3 eggs",
    "3 tablespoons mango chutney",
    "4 slices toasted white bread",
    "1 teaspoon chili sauce"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium heat. Cook eggs until whites are completely set, but yolks are still soft, flipping once.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide and spread mango chutney among 4 toast slices. Place 1 fried egg on chutney side of 1 toast slice; break yolk and season with chili sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Repeat twice more with 2 toast slices, remaining 2 eggs, and chili sauce. Stack egg topped toast slices, egg-sides up, placing remaining toast slice on top, chutney-side down. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
