  "ingredients": [
    "1 large tomato, diced",
    "2 tablespoons chopped red onion",
    "0.5 cup chopped cilantro",
    "0.5 teaspoon honey",
    "1 teaspoon lime juice",
    "1 tablespoon balsamic vinegar",
    "Salt and pepper to taste",
    "1 tablespoon bacon grease",
    "1 clove garlic, minced",
    "2 tablespoons minced red onion",
    "1 (15.5 ounce) can black beans, drained and rinsed",
    "2 tablespoons water"
  ],
  "steps": [
    {
      "text": "Stir together the tomato, onion, cilantro, and honey. Season with lime juice, vinegar, salt and pepper; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt bacon grease in a saucepan over medium heat. Stir in garlic and onion, cook until softened and translucent, about 3 minutes. Pour in the black beans and water, season to taste with salt and pepper, then simmer for 10 minutes or until hot. Serve topped with pico de gallo.",
      "section": null,
