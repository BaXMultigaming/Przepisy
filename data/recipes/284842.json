  "ingredients": [
    "6 large baking potatoes",
    "1 (8 ounce) container sour cream",
    "1 cup grated Cheddar cheese",
    "0.5 cup butter, softened",
    "1 (1 ounce) package dry onion dip mix",
    "1 teaspoon salt",
    "0.25 teaspoon ground white pepper",
    "0.125 teaspoon ground paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Prick potatoes several times with a fork and place onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are easily pierced with a fork, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and lower temperature to 350 degrees F (175 degrees C). Cut potatoes in half lengthwise. Scoop out the pulp and reserve the shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the pulp with sour cream, Cheddar cheese, butter, onion dip mix, salt, and pepper. Spoon mixture back into the shells and sprinkle the tops with paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven until heated through and cheese is melted, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
