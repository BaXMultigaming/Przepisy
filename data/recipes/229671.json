  "ingredients": [
    "20 baby carrots",
    "3 tablespoons honey",
    "2 tablespoons butter",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon white vinegar",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add baby carrots, cover, and steam until tender, 3 to 6 minutes. Transfer to a serving dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place honey, butter, vanilla extract, and vinegar in a small microwave-safe bowl and heat on high for 30 seconds in microwave oven; stir until combined. Pour glaze over carrots; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
