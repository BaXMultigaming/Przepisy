  "ingredients": [
    "1 cup butter",
    "1 cup packed brown sugar",
    "1 cup white sugar",
    "2 eggs",
    "2 tablespoons vanilla extract",
    "3 cups all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C). Lightly grease a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the butter or margarine, white sugar, brown sugar, and eggs. Add vanilla and stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the flour, salt, baking soda, and baking powder and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by spoonfuls onto a lightly greased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 300 degrees F (150 degrees C) for about 12 minutes or until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
