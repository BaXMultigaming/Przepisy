  "ingredients": [
    "4 cups vegetable broth",
    "2 cups brown rice",
    "3 tablespoons butter",
    "0.5 cup diced onion",
    "0.5 cup diced celery",
    "0.5 cup diced carrot",
    "0.25 cup chopped almonds",
    "0.5 cup diced mushrooms",
    "salt to taste",
    "2 cups chopped kale"
  ],
  "steps": [
    {
      "text": "Bring broth and brown rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium heat; cook and stir onion, celery, carrot, and almonds until onion begins to softened, 5 to 10 minutes. Add mushrooms and cook 1 minute more; season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cooked rice into onion mixture until evenly combined. Add kale and cook until completely wilted, about 5 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
