  "steps": [
    {
      "text": "In a large saucepan, saute onion and garlic in butter or margarine over medium heat till tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add broth, and bring to a boil. Reduce heat, and add noodles. Cook for 3 to 4 minutes. Stir in broccoli. Cover, and cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in milk and cheese. Heat slowly, stirring, till cheese melts. DO NOT BOIL. Serve immediately.",
