  "ingredients": [
    "2 cucumbers, sliced",
    "0.25 cup white wine vinegar",
    "2 tablespoons chopped onion",
    "2 tablespoons white sugar",
    "1 tablespoon lemon juice",
    "2 teaspoons celery seed",
    "0.75 teaspoon salt",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Toss cucumbers, vinegar, chopped onion, sugar, lemon juice, celery seeds, salt, and black pepper in a bowl until combined; cover. Chill in the refrigerator, 4 hours.",
