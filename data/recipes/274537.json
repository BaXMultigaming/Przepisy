  "ingredients": [
    "0.5 cup unsweetened applesauce",
    "0.25 cup packed brown sugar",
    "2 tablespoons white sugar",
    "1 egg white",
    "1 tablespoon canola oil",
    "1 tablespoon milk",
    "1 teaspoon vanilla extract",
    "0.75 cup whole wheat flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.125 teaspoon salt",
    "1.5 cups rolled oats",
    "0.5 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk applesauce, brown sugar, white sugar, egg white, oil, milk, and vanilla extract together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, baking soda, cinnamon, and salt together in a separate bowl; add to the applesauce mixture. Stir in oats and chocolate chips. Spread dough evenly into an ungreased 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes. Cool completely before cutting into 16 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
