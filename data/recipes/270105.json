  "ingredients": [
    "2.5 pounds ripe quinces",
    "1 medium lemon",
    "1 cup water",
    "2 cups white sugar",
    "1 (1 inch) piece cinnamon stick"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uUIrlmK1Vhl5P7hbquOYa4jKt88=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270105-quince-jam-VAT-step-01-48d5951129f147cba5721ca1757f08c8.jpg"
      ],
      "image": "assets/images/270105/step_01.webp"
    },
    {
      "text": "Wash quinces under running water with a soft sponge or fruit brush to remove the fuzzy outer layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rMUg0RCEY8O1GLPyfjUka_qJzJ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270105-quince-jam-VAT-step-02-745fe6cc69894cd28a763dc50e19b221.jpg"
      ],
      "image": "assets/images/270105/step_02.webp"
    },
    {
      "text": "Zest lemon; set zest aside. Squeeze lemon juice into a saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mtLKxzDXDZg5ADRTR4-qtddTZUk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270105-quince-jam-VAT-step-03-4d525e24d2164f24a4c4ce5e31d169e1.jpg"
      ],
      "image": "assets/images/270105/step_03.webp"
    },
    {
      "text": "Add water to lemon juice in the saucepan and bring to a simmer. Add quinces and bring to a boil. Stir in sugar and cinnamon stick. Reduce the heat and simmer until quinces are soft, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C60b0FDVYt2SoCHm2icX-_pqyLg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270105-quince-jam-VAT-step-04-c992647c3aeb4f97a66da6ed196f5d1e.jpg"
      ],
      "image": "assets/images/270105/step_04.webp"
    },
    {
      "text": "Remove from the heat. Discard cinnamon stick and stir in lemon zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GBAvIk0864INZTYyEGN1c6pu4GQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270105-quince-jam-VAT-step-05-b45d02128b964d6b801819521b752b62.jpg"
      ],
      "image": "assets/images/270105/step_05.webp"
    },
    {
      "text": "Pass hot mixture through a sieve into a bowl to create a semi-smooth consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KoYy5VrG4CCQWrbgWGFDyNpoWdI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270105-quince-jam-VAT-step-06-408c6625e7bc4ab880134c6a5a708b87.jpg"
      ],
      "image": "assets/images/270105/step_06.webp"
    },
    {
      "text": "Allow to cool and thicken for 30 to 45 minutes, then pour into sealable jars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zyVhZ3rabPloCrlH2xEP2fBKFwA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-270105-quince-jam-VAT-step-07-9f40c8fb8de54fab8d2a6fe2d705682d.jpg"
