  "ingredients": [
    "1.5 cups confectioners' sugar",
    "0.33333298563957 cup skim milk",
    "6 tablespoons butter",
    "1 cup semisweet chocolate chips",
    "0.75 cup marshmallow creme",
    "0.25 teaspoon vanilla extract",
    "3 tablespoons cocoa"
  ],
  "steps": [
    {
      "text": "Grease one 8x8 inch pie pan and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a heavy saucepan over medium heat, combine the powdered sugar, milk and butter. Mix well and stir constantly until candy thermometer reads 238 degrees F (112 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and add chocolate chips, marshmallow creme, vanilla and cocoa. Quickly stir together and pour into prepared pan. Cool and serve. Refrigerate in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
