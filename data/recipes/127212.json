  "title": "Sweet Spicy Pumpkin Seeds",
  "description": "Pumpkin seeds saved from your Halloween pumpkin are toasted and coated with a sweet, spicy cinnamon and chili seasoning.",
  "authors": [
    "Traci"
  ],
  "date_published": "2020-06-18T23:25:43-04:00",
