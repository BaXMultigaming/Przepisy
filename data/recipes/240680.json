  "ingredients": [
    "3 eggs, beaten",
    "0.5 cup heavy whipping cream",
    "0.5 cup cider vinegar",
    "5 tablespoons white sugar",
    "0.25 cup dry mustard powder (such as Coleman's®)",
    "1 dash salt"
  ],
  "steps": [
    {
      "text": "Mix together beaten eggs, cream, vinegar, sugar, mustard powder, and salt in a large bowl using an electric mixer until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
