  "ingredients": [
    "cooking spray",
    "6 skinless, boneless chicken breast halves",
    "salt and pepper to taste",
    "0.5 cup honey",
    "0.5 cup prepared mustard",
    "1 teaspoon dried basil",
    "1 teaspoon paprika",
    "0.5 teaspoon dried parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KXsrrTimyFL8wcgCItSALv9Scgw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-8847-baked-honey-mustard-chicken-DDMFS-4x3-step-01-ec065486301c48f88bc7e046184b6134.jpg"
      ],
      "image": "assets/images/8847/step_01.webp"
    },
    {
      "text": "Season chicken breasts with salt and pepper. Place in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HUCohVTbKu7Enryh4KWh7kVqXWU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-8847-baked-honey-mustard-chicken-DDMFS-4x3-step-02-c728f8210a0f422eb3f2ecf3c03cb52c.jpg"
      ],
      "image": "assets/images/8847/step_02.webp"
    },
    {
      "text": "Combine honey, mustard, basil, paprika, and parsley in a small bowl; mix well. Pour 1/2 of the honey mustard mixture over chicken and brush to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WnKSPxDrWrMtsSpMLXSbnAxBmMA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-8847-baked-honey-mustard-chicken-DDMFS-4x3-step-03-b-79424ad674dd428482536df09e57102e.jpg"
      ],
      "image": "assets/images/8847/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Turn chicken pieces over and brush with remaining honey mustard mixture. Continue baking until chicken is no longer pink and juices run clear, 10 to 15 minutes more. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Cma2REevZLFLw8vOJINT9O8JJyM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-8847-baked-honey-mustard-chicken-DDMFS-4x3-step-04-e2e2c072b42940b2bae1f805963ba38c.jpg"
      ],
      "image": "assets/images/8847/step_04.webp"
    },
    {
      "text": "Let chicken rest for 10 minutes before serving. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aDI0d9kmPzs7sbP1-poO-V_ioQM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-8847-baked-honey-mustard-chicken-DDMFS-4x3-Beauty-7a722636696d4cf4837ea1366545bada.jpg"
      ],
      "image": "assets/images/8847/step_05.webp"
    }
  ],
