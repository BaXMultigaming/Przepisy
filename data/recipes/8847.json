  "title": "Baked Honey Mustard Chicken",
  "description": "This honey mustard chicken, made with juicy baked chicken breasts and a sweet honey mustard and paprika glaze, is an easy midweek dinner full of flavor.",
  "authors": [
    "Mary Annthipie Bane"
  ],
  "date_published": "1999-04-27T05:16:15-04:00",
