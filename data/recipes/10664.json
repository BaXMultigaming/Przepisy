  "ingredients": [
    "8 cups all-purpose flour",
    "4 teaspoons baking soda",
    "1 teaspoon salt",
    "3 cups margarine, softened",
    "2.5 cups white sugar",
    "2.5 cups packed brown sugar",
    "2 teaspoons vanilla extract",
    "4 large eggs",
    "4 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat margarine and both sugars in a large bowl with an electric mixer until smooth and creamy. Beat in eggs and vanilla. Gradually beat in flour mixture, then stir in chocolate chips. Drop spoonfuls of dough 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in batches in the preheated oven until the edges are golden, 12 to 15 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
