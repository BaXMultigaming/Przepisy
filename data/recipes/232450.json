  "ingredients": [
    "1.5 cups cold water",
    "0.5 cup white sugar",
    "0.25 cup unsweetened cocoa powder",
    "2 tablespoons all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon salt",
    "6 cups whole milk",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Whisk cold water, sugar, cocoa powder, flour, cinnamon, cloves, and salt in a saucepan until smooth. Place over low heat; bring to a simmer, whisking constantly, until mixture is thickened and hot, about 4 minutes. Stir in milk; heat until hot chocolate just forms bubbles around the edge. Mix vanilla extract into hot chocolate. Blend until smooth with an immersion blender to make the drink slightly frothy.",
