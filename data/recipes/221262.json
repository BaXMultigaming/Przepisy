  "ingredients": [
    "1 (16 ounce) package bulk mild pork sausage",
    "1 (16 ounce) package bulk hot pork sausage",
    "1 (8 ounce) package shredded sharp Cheddar cheese",
    "2 cups biscuit baking mix (such as Bisquick®)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mild sausage and hot sausage in a large bowl until evenly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Cheddar cheese into sausage mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix biscuit baking mix into sausage mixture about 1/2 cup at a time until baking mix is moist.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll meat mixture into 1 1/4- to 1 1/2-inch balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange meatballs on prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until meatballs are no longer pink in the center and cheese is browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
