  "ingredients": [
    "6 ounces skinless, boneless salmon",
    "0.125 cup mayonnaise",
    "0.125 cup dry bread crumbs",
    "0.125 cup chopped green onion",
    "1 egg white",
    "2 teaspoons lemon juice",
    "0.5 teaspoon Cajun seasoning",
    "1 teaspoon butter or margarine",
    "1 tablespoon mayonnaise",
    "0.5 teaspoon Dijon mustard"
  ],
  "steps": [
    {
      "text": "Combine salmon, 1/8 cup mayonnaise, bread crumbs, green onion, egg white, lemon juice, and Cajun seasoning in a large bowl; mix well. Shape mixture into 1/2-inch-thick patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a large nonstick skillet over medium heat. Add patties and cook until golden brown, 3 to 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together 1 tablespoon mayonnaise and Dijon mustard in a small bowl until sauce is well combined. Serve with croquettes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
