  "ingredients": [
    "1 head green cabbage, shredded",
    "1 large carrot, grated",
    "1 cup grated jicama",
    "1 tablespoon black sesame seeds",
    "1 cup mayonnaise",
    "2 tablespoons rice vinegar",
    "1 tablespoon sesame oil",
    "3 tablespoons honey"
  ],
