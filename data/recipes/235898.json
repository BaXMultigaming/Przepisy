  "ingredients": [
    "2 tablespoons butter, softened",
    "4 cups cubed day-old bread, or as needed to fill a 9x12-inch baking dish",
    "2 apples - peeled, cored, and chopped into 1/2 inch pieces",
    "3 cups eggnog",
    "4 eggs"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Generously grease a 9x12-inch baking dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vJz69BC0e122t3b5mZf73Sfyiik=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235898-eggnog-and-apple-bread-pudding-ddmfs-step-1-BG-3928-9a3c6eff72b94d139f8cf8df736a64fb.jpg"
      ],
      "image": "assets/images/235898/step_01.webp"
    },
    {
      "text": "Spread bread into the bottom of the prepared baking dish. Sprinkle apple pieces evenly over the bread pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LQyocjxxKP90Am6ZcHw8HmQ2bGE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235898-eggnog-and-apple-bread-pudding-ddmfs-step-3-BG-3938-0d2adeac551748e8b62b22d8f682a0bf.jpg"
      ],
      "image": "assets/images/235898/step_02.webp"
    },
    {
      "text": "Beat eggnog and eggs together in a bowl; pour over the bread and apples. Cover dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rah8nWac6927LkMkIZydFnj6Rmk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235898-eggnog-and-apple-bread-pudding-ddmfs-step-4-BG-3944-075d89905a944640b9bba47963dff7a7.jpg"
      ],
      "image": "assets/images/235898/step_03.webp"
    },
    {
      "text": "Bake in preheated oven for 30 minutes, remove aluminum foil, and continue baking until browned and somewhat set in the middle, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LdHZ3GX90kDCkX5GE1w6ygjIBSs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235898-eggnog-and-apple-bread-pudding-ddmfs-step-5-BG-3948-30adba17b530483bb56a7f2b78a96d10.jpg"
