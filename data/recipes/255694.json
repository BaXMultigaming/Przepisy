  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "1 cup blue cheese dressing",
    "1 cup shredded Cheddar cheese, divided",
    "0.5 cup Buffalo wing sauce",
    "1 (15 ounce) can cannellini beans, drained and rinsed",
    "1 teaspoon chopped fresh chives, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, blue cheese dressing, 1/2 cup Cheddar cheese, and Buffalo wing sauce together in a bowl. Slightly mash cannellini beans in a separate bowl; fold into cheese mixture. Spread mixture into a pie pan or baking dish and top with remaining Cheddar cheese and chives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
