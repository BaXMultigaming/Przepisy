  "ingredients": [
    "0.5 pound poppy seeds",
    "1 cup milk",
    "0.25 cup margarine",
    "0.75 cup white sugar",
    "1 pinch salt",
    "2 eggs, beaten"
  ],
  "steps": [
    {
      "text": "Grind the poppy seeds in a mill or coffee grinder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the milk, margarine, and sugar in a saucepan. Cook on low heat, stirring often, until the sugar dissolves. Gradually pour about half of the hot milk into the beaten eggs, whisking constantly. Return the egg and milk mixture to the saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue to cook and stir until the mixture begins to thicken and coats the back of a metal spoon. (Run your finger down the coated spoon: it should draw a clear line.) Add the poppy seeds and stir well to blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat; cool before using. Store unused filling in the refrigerator for up to five days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
