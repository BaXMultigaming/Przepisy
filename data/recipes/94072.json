    {
      "text": "Heat 1 tablespoon olive oil in a 12-inch frying pan over medium-high heat until oil starts to smoke.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomatoes to hot oil; season with salt and pepper. Sauté, shaking pan frequently, until tomatoes soften and skins just begin to wrinkle, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VN2U5uaGgnsmivorqY7EkrztQB0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_94072-SauteedCherryTomatoeswithGarlicandBasil_Shot2_13175-22fc102372754863a9e63ced839af9d0.jpg"
      ],
      "image": "assets/images/94072/step_03.webp"
    },
    {
      "text": "Stir in garlic and continue shaking the pan until garlic is fragrant.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BGp8KJmwTBWWcFhBUOgNQHjs_a4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_94072-SauteedCherryTomatoeswithGarlicandBasil_Shot3_13178-627c0f132db549d3a5e63ff486f7e4fd.jpg"
      ],
      "image": "assets/images/94072/step_04.webp"
    },
