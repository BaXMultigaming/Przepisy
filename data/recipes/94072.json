  "ingredients": [
    "2 tablespoons olive oil, divided",
    "2 pints cherry or grape tomatoes",
    "salt and pepper to taste",
    "2 garlic cloves, minced",
    "1 tablespoon minced fresh basil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
