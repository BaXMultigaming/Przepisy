  "ingredients": [
    "10 cups water, divided",
    "2.6666667461395 cups uncooked white rice",
    "4 cinnamon sticks",
    "1 cup soy milk",
    "1 cup white sugar",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Place 2 cups water and 1 ⅓ cups rice in a blender; pulse until rice is roughly ground. Add 3 cups water and cinnamon sticks to the blender; blend until cinnamon sticks are broken into pieces. Pour rice mixture into a large pitcher.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place remaining 5 cups water and remaining 1 ⅓ cups rice in the blender; blend until rice is roughly ground. Add to the pitcher.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the pitcher; refrigerate, 4 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain mixture through a sieve into another pitcher or bowl; discard solids.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir soy milk, sugar, and vanilla extract into mixture; chill until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
