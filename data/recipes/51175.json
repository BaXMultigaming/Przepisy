  "ingredients": [
    "0.66666668653488 cup butter, softened",
    "0.66666668653488 cup white sugar",
    "1 egg",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 cup raspberry preserves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the butter and sugar until smooth. Mix in the egg and vanilla. Combine the flour and baking powder; stir into the batter until a soft dough forms. Divide into 4 pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape each piece of dough into a log about 12 inches long. Place on cookie sheet and flatten slightly. Using the round handle of a wooden spoon make an indention all the way down the center of each strip. Fill the indention with preserves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 20 minutes in the preheated oven. Cool slightly before slicing diagonally into 1 inch pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
