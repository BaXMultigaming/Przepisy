  "ingredients": [
    "0.25 cup olive oil",
    "1 bunch asparagus, trimmed",
    "0.25 cup seasoned bread crumbs",
    "3 tablespoons grated Parmesan cheese",
    "2 tablespoons garlic powder",
    "0.25 tablespoon sea salt"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large skillet over medium-high heat for 1 minute. Add asparagus; cook, flipping regularly, until slightly tender, about 5 minutes. Sprinkle bread crumbs, Parmesan cheese, and garlic powder over asparagus; flip asparagus with a spatula to evenly coat. Reduce heat to medium; continue cooking until asparagus is completely tender, about 8 minutes. Season with sea salt.",
