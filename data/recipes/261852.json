  "ingredients": [
    "1 cup white sugar",
    "1 cup brown sugar",
    "0.5 cup butter",
    "1.5 cups peanut butter",
    "3 eggs",
    "4.5 cups rolled oats",
    "2 teaspoons baking soda",
    "1 teaspoon vanilla extract",
    "1.5 cups semisweet chocolate chips",
    "1.5 cups candy-coated milk chocolate pieces (such as M&M's®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 10x15-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together white sugar, brown sugar, and butter in a large bowl with an electric mixer until creamy. Mix in peanut butter and eggs until smooth. Mix in oats, baking soda, and vanilla until incorporated. Stir in chocolate chips and milk chocolate pieces until evenly distributed. Spread in the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly brown on top, about 15 minutes. Do not overbake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
