  "ingredients": [
    "4 cups grape tomatoes",
    "4 cloves garlic, sliced",
    "2 tablespoons olive oil",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 450 degrees F (230 degrees C). Place a piece of aluminum foil over a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
