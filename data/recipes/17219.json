  "ingredients": [
    "1 (12 ounce) package egg noodles",
    "2 (10.5 ounce) cans condensed cream of mushroom soup",
    "2 cups shredded Cheddar cheese, divided",
    "2 (5 ounce) cans tuna, drained",
    "1 cup frozen green peas",
    "0.5 (4.5 ounce) can sliced mushrooms",
    "0.25 cup chopped onion",
    "1 cup crushed potato chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fH-17C0fsqxteTtXZ0cVlbUmhyY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17219-Best-Tuna-Casserole-DDMFS-Step1-25a22dd65bba4059bd569134ce5ba181.jpg"
      ],
      "image": "assets/images/17219/step_01.webp"
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a boil. Add egg noodles and cook until tender yet firm to the bite, 7 to 9 minutes; drain. Meanwhile, preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0qrZ4NJgNnMw1YghFccMFq5c9Bo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17219-Best-Tuna-Casserole-DDMFS-Step2-a264d38cf820461a84de1c9ef8ab3f4b.jpg"
      ],
      "image": "assets/images/17219/step_02.webp"
    },
    {
      "text": "Mix noodles, condensed soup, 1 cup cheese, tuna, peas, mushrooms, and onion in a large bowl until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ebllB4hCMfNukAemxBWk_twHP8Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17219-best-tuna-casserole-mfs-step-2-226-4f81c180df134f52bdaf7234337d4728.jpg"
      ],
      "image": "assets/images/17219/step_03.webp"
    },
    {
      "text": "Transfer the mixture into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jA3cuwlp3lT9F5UmtT4eZ_INHiA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17219-best-tuna-casserole-mfs-step-3-230-f4f5251f8b1b46dd85c0fb281449ecb8.jpg"
      ],
      "image": "assets/images/17219/step_04.webp"
    },
    {
      "text": "Top the mixture with crushed potato chips and remaining 1 cup of cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a4oX5QH_agEiSxcvhQSsSqSG0t4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17219-best-tuna-casserole-mfs-step-5-235-93f5add121794e75aacf21a106755f6d.jpg"
      ],
      "image": "assets/images/17219/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and edges are lightly golden, about 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C76lUnJq-6RK8Z5nmCtsBXiba2M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17219-best-tuna-casserole-mfs-step-5-239-f7854e59425541efa839c953a8b87578.jpg"
      ],
