  "ingredients": [
    "2 cups peanut oil for frying",
    "1 pound peeled and deveined large shrimp",
    "0.25 cup cornstarch",
    "2 large cloves garlic, minced",
    "0.5 teaspoon minced fresh ginger",
    "0.5 teaspoon cayenne pepper",
    "1/4 cup water",
    "5 teaspoons white sugar",
    "1 tablespoon white wine",
    "1 tablespoon white vinegar",
    "1 tablespoon ketchup",
    "0.5 teaspoon salt",
    "2 teaspoons cornstarch",
    "2 teaspoons water",
    "5 green onions, sliced"
  ],
  "steps": [
    {
      "text": "Heat oil in a wok to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss shrimp with ¼ cup cornstarch to coat. Carefully lower shrimp into hot oil; fry until golden brown, about 45 seconds. Drain on paper towels; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and discard all but 1 tablespoon oil from the wok. Add garlic, ginger, and cayenne pepper to the wok; cook, stirring continuously, until garlic is fragrant, about 30 seconds. Add ¼ cup water, sugar, wine, vinegar, ketchup, and salt; bring to a boil over high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve 2 teaspoons cornstarch in 2 teaspoons water in a bowl; stir into boiling sauce until thickened, about 1 minute. Add shrimp and green onions; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
