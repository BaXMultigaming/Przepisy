  "ingredients": [
    "0.75 cup brown sugar",
    "0.75 cup white sugar",
    "0.5 cup butter, softened",
    "2 eggs",
    "1 cup pumpkin puree",
    "0.33333334326744 cup water",
    "1.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground nutmeg",
    "0.33333334326744 cup packed brown sugar",
    "1 tablespoon all-purpose flour",
    "1 tablespoon butter",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour an 18-muffin cup tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the muffins, beat brown sugar, white sugar, and butter together in a bowl with an electric mixer until smooth and creamy. Add eggs and beat until combined. Beat in pumpkin purée and water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, salt, cinnamon, ginger, and nutmeg in a separate bowl. Stir flour mixture into pumpkin mixture. Spoon batter into the prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the streusel, mix brown sugar, flour, butter, and cinnamon together in a bowl using two forks until mixture is crumbly. Sprinkle streusel onto each muffin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the middle of muffins comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
