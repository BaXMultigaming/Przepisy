  "steps": [
    {
      "text": "Preheat the oven to 350 degrees (175 degrees C). Lightly grease one 8x8-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together sugar and butter. Add flour, milk, salt, and baking powder. Mix well and pour into the prepared pan. Spread fruit evenly over top of batter and pour juice from canned peaches over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven for 50 minutes or until fully browned on top.",
