  "ingredients": [
    "1.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground cloves",
    "0.5 cup margarine",
    "1 cup white sugar",
    "2 eggs",
    "0.75 cup solid pack pumpkin puree",
    "0.75 cup semi-sweet chocolate chips",
    "0.75 cup chopped walnuts",
    "0.5 cup confectioners' sugar",
    "1 tablespoon milk",
    "0.125 teaspoon ground nutmeg",
    "0.125 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "In a large bowl mix together the flour, baking soda, 1 teaspoon cinnamon, 1/2 teaspoon nutmeg, ground ginger, and ground cloves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl cream together the sugar and butter or margarine. Add eggs and beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Alternately add the creamed ingredients and pumpkin to the dry ingredients. Fold in chocolate chips and chopped nuts. Spoon into two greased 9x5 inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 350 degree F(175 degrees C) oven for 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the glaze: In a small bowl, combine confectioners sugar, 1/8 teaspoon cinnamon, and 1/8 teaspoon nutmeg. Add milk, and mix until smooth. Drizzle over warm cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
