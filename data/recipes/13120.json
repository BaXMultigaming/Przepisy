  "ingredients": [
    "6 slices bacon",
    "1 onion, chopped",
    "2 potatoes, peeled and cubed",
    "0.5 cup water",
    "2 cups milk",
    "2 (14.75 ounce) cans cream-style corn",
    "1 (15.25 ounce) can whole kernel corn",
    "0.5 teaspoon salt",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Fry bacon in a Dutch oven until crisp; remove bacon, reserving 2 tablespoons drippings. Crumble bacon and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sauté onion in reserved drippings until tender; add potatoes and water. Cover and simmer until potatoes are tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in milk, corn, salt, and pepper to taste; continue to cook, stirring frequently, until heated through. Sprinkle with crumbled bacon to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
