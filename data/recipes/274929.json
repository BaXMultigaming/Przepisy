  "ingredients": [
    "1 pound fresh green beans, trimmed",
    "0.25 cup extra-virgin olive oil",
    "sea salt and freshly ground black pepper to taste",
    "0.5 large lemon, juiced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss beans with olive oil in a medium mixing bowl until well coated. Spread beans out on a rimmed baking sheet or in a roasting pan. Sprinkle lightly with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the oven until beans look shriveled and browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove beans from the oven, gather into a pile, and squeeze lemon juice over the top. Toss and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
