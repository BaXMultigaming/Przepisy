  "ingredients": [
    "cooking spray",
    "1 (30 ounce) package frozen shredded hash browns, thawed",
    "2.5 cups shredded Colby cheese, divided",
    "1 (10.5 ounce) can cream of chicken soup",
    "8 ounces sour cream",
    "0.67 cup finely chopped onion",
    "0.25 cup unsalted butter, melted",
    "1 large egg, beaten",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon freshly ground black pepper",
    "chopped parsley for garnish (optional)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain defrosted hash browns well. Combine drained hash browns, 2 cups Colby cheese, soup, sour cream, onion, butter, egg, garlic powder, salt, and pepper in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon the mixture into the casserole dish, and sprinkle the remaining 1/2 cup of cheese over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and starts to brown, 45 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with chopped parsley and serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
