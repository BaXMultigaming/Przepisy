  "ingredients": [
    "5 slices bread, cubed",
    "2 tablespoons butter",
    "0.5 cup sliced fresh mushrooms",
    "0.25 cup diced onion",
    "0.25 cup diced green bell pepper",
    "0.25 cup chopped ham",
    "7 eggs",
    "0.5 cup 2% milk",
    "2 teaspoons mustard",
    "2 teaspoons Worcestershire sauce",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 dash hot pepper sauce (such as Tabasco®), or to taste",
    "1 cup shredded Mexican cheese blend",
    "3 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spread bread cubes in a 8x12-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add mushrooms, onion, and green pepper; cook and stir until starting to soften, about 5 minutes. Stir in ham until heated through, 2 to 3 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and milk together in a separate bowl; mix in mustard, Worcestershire sauce, salt, pepper, and hot sauce. Stir in mushroom-ham mixture and cheeses. Pour into the casserole dish. Stir well to moisten the bread cubes. Cover baking dish with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until eggs are set, about 25 minutes. Uncover and continue baking until top starts to brown, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
