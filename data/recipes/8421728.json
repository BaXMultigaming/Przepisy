  "ingredients": [
    "8 ounces sugar snap peas",
    "2 tablespoons sunflower seeds",
    "1 lemon, halved",
    "1 tablespoon crumbled feta cheese",
    "1 tablespoon sunflower seed oil",
    "1 tablespoon chopped fresh dill",
    "0.125 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "lemon slices and additional crumbled feta, for garnish"
  ],
  "steps": [
    {
      "text": "Slice sugar snap peas on the diagonal into 1/2-inch pieces (about 2 1/2 cups). Add sunflower seeds, juice and zest of half the lemon, feta cheese, sunflower oil, and dill. Season with salt and black pepper. Toss to combine. Garnish with slices of lemon and additional feta.",
