  "ingredients": [
    "3 pounds smoked ham, cut into chunks",
    "1 (8 ounce) can tomato sauce",
    "2 tablespoons quick-cooking tapioca",
    "2 tablespoons ketchup",
    "1 tablespoon prepared mustard",
    "1 teaspoon vinegar",
    "1 teaspoon Worcestershire sauce",
    "1 pound processed cheese food (such as Velveeta®), cubed"
  ],
  "steps": [
    {
      "text": "Place ham into a saucepan and cover with water. Bring to a boil, reduce heat to medium, and boil ham gently for 15 minutes. Drain and allow ham to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ham into a food processor and pulse several times to grind the meat to your desired texture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomato sauce, tapioca, ketchup, mustard, vinegar, and Worcestershire sauce in a large saucepan over low heat; melt cheese food in the tomato sauce mixture and stir all ingredients smoothly together. Do not allow to simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine melted cheese food mixture with ground ham in a large bowl; stir thoroughly. Chill before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
