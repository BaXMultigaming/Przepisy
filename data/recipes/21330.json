  "steps": [
    {
      "text": "In a large pot, bring 1 quart of water to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place shrimp in a steamer basket and place on top of the pot; cover. Do not submerge shrimp. Remove some water if necessary. Season the shrimp with Old Bay seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Steam shrimp until pink, about 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Eat by removing shells as you go and dipping in cocktail sauce.",
