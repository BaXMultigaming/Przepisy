  "ingredients": [
    "4 cups fat-free buttermilk",
    "1 (15 ounce) can sliced beets with liquid",
    "1 cucumber - peeled, seeded, quartered lengthwise and diced",
    "3 green onions, chopped",
    "2 tablespoons chopped fresh dill",
    "2 tablespoons white vinegar, or to taste",
    "0.5 teaspoon salt, or to taste"
  ],
  "steps": [
    {
      "text": "Combine buttermilk, beets and liquid, cucumber, green onions, dill, vinegar, and salt in a bowl. Cover the bowl; refrigerate 2 hours to overnight for best flavor. Serve cold.",
