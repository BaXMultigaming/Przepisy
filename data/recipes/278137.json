  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup old-fashioned oats",
    "0.5 cup flaxseed meal",
    "0.25 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup plain yogurt",
    "0.5 cup orange juice",
    "0.33333334326744 cup honey",
    "2 eggs, slightly beaten",
    "2 teaspoons grated orange zest",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped walnuts",
    "0.5 cup granola"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, oats, flaxseed meal, sugar, baking powder, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine yogurt, orange juice, honey, eggs, orange zest, and vanilla extract in a smaller bowl. Whisk well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a well in the center of the dry ingredients and pour in honey mixture. Stir just until combined. Fold in walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 3/4 full. Sprinkle each muffin with granola.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until centers spring back when touched, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
