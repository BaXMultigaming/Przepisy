  "ingredients": [
    "1 pound ground beef",
    "0.5 cup chopped onion",
    "0.25 cup chopped celery",
    "0.25 cup chopped green bell pepper",
    "1 teaspoon salt",
    "1 pinch ground black pepper",
    "0.33333334326744 cup ketchup",
    "1 tablespoon white vinegar",
    "1 tablespoon white sugar",
