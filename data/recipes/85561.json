  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "6 packets aspartame artificial sweetener",
    "1.5 teaspoons baking powder",
    "0.75 teaspoon baking soda",
    "0.5 cup butter, melted",
    "1 tablespoon vanilla extract",
    "0.75 cup skim milk",
    "2 eggs",
    "4 ripe bananas, mashed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the flour, sugar, artificial sweetener, baking powder and baking soda. In a separate bowl, stir together the butter, vanilla, milk, eggs and bananas; pour into the dry ingredients and mix well. Spread evenly in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 minutes in the preheated oven, until a toothpick inserted in the center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
