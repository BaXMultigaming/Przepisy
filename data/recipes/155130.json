  "ingredients": [
    "1 (12 ounce) can evaporated milk",
    "1 (5.9 ounce) package chocolate instant pudding mix",
    "1 (6.5 ounce) can Reddi-wip® Original Dairy Whipped Topping",
    "0.5 cup miniature semi-sweet chocolate morsels",
    "1 (9 inch) graham cracker pie crust",
    "1 tablespoon Additional Reddi-wip Original Whipped Light Cream and crushed candy"
  ],
  "steps": [
    {
      "text": "Pour milk into medium bowl. Add dry pudding mix; beat with wire whisk until well blended and mixture just begins to thicken. Stir in chocolate morsels, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add contents of Reddi-wip can; stir gently but quickly until well blended. Pour into crust; cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate 6 hours, or until set. Cut into 8 slices to serve. Garnish with additional Reddi-wip and crushed candy, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
