  "ingredients": [
    "1 cup vegetable oil, or as needed",
    "0.25 cup confectioners' sugar",
    "0.75 teaspoon ground cinnamon, divided",
    "1.25 cups all-purpose flour",
    "0.75 cup apple cider",
    "1 egg",
    "1 teaspoon baking powder",
    "1 teaspoon vanilla extract",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Pour about 3/4 inch oil in a 12-inch skillet and heat 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine confectioners' sugar and 1/4 teaspoon cinnamon in a bowl. Mix flour, apple cider, egg, baking powder, vanilla extract, 1/2 teaspoon cinnamon, and salt together in a separate large bowl until batter is smooth. Pour batter into a funnel with a narrow spout or squeeze bottle, covering the opening with a clean finger.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dispense batter into the hot oil in a spiral pattern, making about a 6-inch cake; cook until lightly browned, about 5 minutes per side. Transfer cake to a paper towel-lined plate and sprinkle confectioners' sugar mixture over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
