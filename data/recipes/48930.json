  "ingredients": [
    "1 cup soy sauce",
    "0.5 cup vegetable oil",
    "1 tablespoon cooking sherry",
    "3 tablespoons brown sugar",
    "3 cloves garlic, crushed",
    "4 boneless, skinless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Mix soy sauce, oil, sherry, brown sugar, and garlic in a medium bowl. Pour into a large resealable bag. Place chicken in the bag, and shake to coat. Marinate in the refrigerator for at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken on the prepared grill. Cook until no longer pink in the center and juices run clear, 6 to 8 minutes on each side. Discard remaining marinade.",
      "section": null,
      "name": null,
