  "ingredients": [
    "1 (13.5 ounce) can pineapple chunks, drained (juice reserved)",
    "1 cup water",
    "0.5 cup brown sugar",
    "2 tablespoons vinegar",
    "2 tablespoons cornstarch",
    "2 green bell peppers, chopped",
    "1 (12 ounce) can fully cooked luncheon meat (such as SPAM®), chopped"
