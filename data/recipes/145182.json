  "ingredients": [
    "1 cup canola oil",
    "0.25 cup white vinegar",
    "1 teaspoon fresh lemon juice",
    "1 clove garlic, chopped",
    "1.5 teaspoons dried basil",
    "1.5 teaspoons dried oregano",
    "1 teaspoon dried thyme",
    "0.5 teaspoon dried parsley",
    "0.5 teaspoon onion powder",
    "2 bay leaves",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon ground black pepper",
    "8 wooden skewers, soaked in water for 15 minutes",
    "2 pounds cubed beef",
    "8 (1 inch thick) slices French bread"
  ],
  "steps": [
    {
      "text": "In a large resealable bag, combine canola oil, vinegar, lemon juice, garlic, basil, oregano, thyme, parsley, onion powder, bay leaves, salt, and pepper. Place beef cubes into marinade, seal the bag, and shake to coat beef. Marinate in the refrigerator overnight, or for up to 3 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat. Thread beef cubes onto 8 skewers, dividing evenly. Discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook beef skewers on the grill for 15 to 20 minutes, or until cooked to your liking. To serve, place a whole skewer of beef on a slice of French bread. Hold onto beef using bread, and pull the skewer out.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
