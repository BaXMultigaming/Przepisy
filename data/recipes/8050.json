  "ingredients": [
    "4 eggs",
    "1 teaspoon vanilla extract",
    "1 (16 ounce) can chocolate syrup",
    "2 cups vegetable oil",
    "2 cups all-purpose flour",
    "16 ounces white sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the eggs and the vanilla with a spoon. Blend in the chocolate syrup. Fill emptied chocolate syrup can with vegetable oil and add to bowl. Add the flour to bowl. Fill can with sugar and add to bowl. Stir well and pour into a lightly greased 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 40-45 minutes at 350 degrees F (175 degrees C). Ice after cooling or leave plain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
