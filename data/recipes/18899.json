  "ingredients": [
    "1.5 pounds new red potatoes",
    "1 tablespoon vegetable oil",
    "1 onion, chopped",
    "1 clove garlic, crushed",
    "1 cup chicken broth",
    "1 cup chopped fresh parsley",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Peel a strip of skin from around the center of each potato, place the potatoes in cold water. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium high heat. Saute onion and garlic for 5 minutes or until tender. Pour in broth and 3/4 cup of the parsley; mix well. Bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the potatoes into a large pot full of salted water. Bring the water to a boil; then reduce heat. Simmer covered, for 10 minutes or until the potatoes are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove potatoes with a slotted spoon to a serving bowl. Sprinkle the black pepper into the skillet and stir.. Pour the peppered sauce over potatoes and sprinkle with remaining parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
