  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, melted",
    "1 egg",
    "3 medium apples - peeled, cored and thinly sliced",
    "0.5 cup chopped walnuts",
    "1 cup all-purpose flour",
    "0.25 teaspoon salt",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, melted butter, and egg in a large bowl with an electric mixer until fluffy. Fold in the apples and walnuts. Sift flour, salt, baking powder, baking soda, and cinnamon together in a separate bowl; stir into apple mixture until just blended. Spread batter evenly in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
