  "ingredients": [
    "1.5 cups orange juice without pulp",
    "0.5 cup packed brown sugar",
    "0.25 cup white sugar",
    "1 tablespoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "3 whole pears, peeled and cored",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Combine orange juice, brown sugar, white sugar, vanilla extract, and cinnamon in a large saucepan over medium heat; bring to a boil, stirring until sugar dissolved. Place pears into syrup, cover, and simmer 1 hour and 15 minutes, flipping pears twice and spooning sauce over pears every 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pears to individual serving dishes. Continue cooking syrup, stirring often, until thickened, about 15 minutes, then stir in walnuts. Pour sauce over pears.",
