  "ingredients": [
    "1.5 cups shredded Irish Cheddar cheese (such as Dubliner®)",
    "1 cup plain yogurt",
    "0.5 cup finely chopped green onions",
    "0.25 cup mayonnaise",
    "2 teaspoons prepared horseradish",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Stir Cheddar cheese, yogurt, green onions, mayonnaise, horseradish, and black pepper together in a bowl; refrigerate until chilled, at least 1 hour.",
