  "ingredients": [
    "4 tablespoons dry vegan egg replacer (such as VeganEgg®)",
    "0.5 cup ice cold water",
    "1.75 cups almond milk",
    "1.75 cups all-purpose flour",
    "0.5 cup almond flour",
    "0.5 cup vegetable oil",
    "1 tablespoon baking powder",
    "1 tablespoon white sugar",
    "2 teaspoons vanilla extract",
    "nonstick cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine egg replacer and water in a blender; blend until smooth and all lumps have disappeared. Add almond milk, all-purpose flour, almond flour, oil, baking powder, sugar, and vanilla extract; blend on low until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray the preheated waffle iron with cooking spray. Pour batter by 1/4-cupfuls onto the iron and cook until waffle is golden brown and the iron stops steaming, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
