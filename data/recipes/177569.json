  "ingredients": [
    "1 tablespoon vegetable oil",
    "4 skinless, boneless chicken breast halves",
    "1.75 cups Swanson® Chicken Stock",
    "1 teaspoon dried oregano leaves, crushed",
    "1 teaspoon garlic powder",
    "1 (14.5 ounce) can diced tomatoes",
    "1 small green pepper, cut into 2-inch long strips",
    "1 medium onion, cut into wedges",
    "0.25 teaspoon ground black pepper",
    "2.5 cups uncooked medium shell-shaped pasta"
  ],
  "steps": [
    {
      "text": "Heat the oil in a 10-inch skillet over medium-high heat. Add the chicken and cook for 10 minutes or until it's well browned on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the stock, oregano, garlic powder, tomatoes, green pepper, onion and black pepper in the skillet and heat to a boil. Stir in the pasta. Reduce the heat to low. Cover and cook for 15 minutes or until the pasta is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
