  "ingredients": [
    "2 (14.75 ounce) cans salmon, drained and flaked",
    "0.75 cup Italian-seasoned panko (Japanese bread crumbs)",
    "0.5 cup minced fresh parsley",
    "2 eggs, beaten",
    "2 green onions, chopped",
    "3 tablespoons Worcestershire sauce",
    "3 tablespoons grated Parmesan cheese",
    "2 tablespoons Dijon mustard",
    "2 tablespoons creamy salad dressing (such as Miracle Whip®)",
    "2 teaspoons seafood seasoning (such as Old Bay®)",
    "1.5 teaspoons garlic powder",
    "1.5 teaspoons ground black pepper",
    "1 tablespoon olive oil, or as needed, divided"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
