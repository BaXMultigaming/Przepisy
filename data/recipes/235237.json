  "ingredients": [
    "2 cups chocolate chips",
    "1 cup butter",
    "0.5 cup peanut butter",
    "0.5 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "1 cup white sugar",
    "3 eggs, beaten",
    "2 teaspoons baking soda",
    "0.25 teaspoon salt",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the chocolate chips, butter, and peanut butter together in the top of a double boiler over simmering water, stirring frequently and scraping down the sides with a rubber spatula to avoid scorching. Stir vanilla into chocolate mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, sugar, eggs, baking soda, and salt into the chocolate mixture. Fold walnuts into batter. Pour batter into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake brownies in the preheated oven until a toothpick inserted in the center comes out with moist chunks on it, but not wet, about 30 minutes. Cool to room temperature before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
