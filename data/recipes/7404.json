  "title": "Pumpkin Sheet Cake",
  "description": "A moist pumpkin sheet cake with cream cheese frosting, sprinkled with nuts. Cut into bite-sized pieces, it’s perfect for holiday potlucks!",
  "authors": [
    "Sandy Rowe"
  ],
  "date_published": "1998-05-02T16:02:25-04:00",
