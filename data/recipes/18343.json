  "ingredients": [
    "2 plum tomatoes, halved and cut into 1/4 inch slices",
    "1 large zucchini, sliced",
    "3 tablespoons salsa",
    "3 tablespoons water",
    "0.5 teaspoon dried oregano",
    "0.25 teaspoon dried basil",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a small saucepan, mix together tomatoes, zucchini, salsa, water, oregano, basil, salt, and pepper. Mix in bell peppers if desired. Bring to a boil over medium heat, then reduce to a simmer. Simmer 3 to 4 minutes, stirring frequently.",
