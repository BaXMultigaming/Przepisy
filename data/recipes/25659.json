  "ingredients": [
    "3 tablespoons butter",
    "6 onions, thinly sliced",
    "0.5 teaspoon salt",
    "1.5 cups white wine",
    "3.5 cups chicken broth",
    "0.25 teaspoon ground white pepper",
    "0.25 teaspoon ground nutmeg",
    "2 cups shredded Gruyere cheese"
  ],
  "steps": [
    {
      "text": "In a medium saucepan over medium heat, cook butter until foamy. Stir in onions and cook a couple of minutes, then reduce heat, stir in salt, cover and cook very slowly until very tender, 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer onions and their caramel to a larger pot and place it over medium heat. Pour in the wine and bring to a boil. Stir in chicken broth, pepper and nutmeg and simmer gently, uncovered, 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in shredded cheese until melted (cheese will remain a little stringy). Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
