  "ingredients": [
    "1 pound ground beef",
    "1 onion, chopped",
    "1 (1.25 ounce) package taco seasoning mix",
    "2 (16 ounce) cans refried beans",
    "2 cups shredded Cheddar cheese",
    "1 (15 ounce) jar salsa",
    "1 (12 ounce) bag tortilla chips",
    "0.25 cup chopped iceberg lettuce",
    "1 chopped green onions",
    "1 tablespoon diced tomatoes",
    "1 tablespoon shredded Cheddar cheese",
    "0.25 cup diced avocado",
    "1 tablespoon sour cream",
    "1 tablespoon taco sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch pan; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat and stir in the ground beef and onions. Cook and stir until the beef is crumbly and evenly browned. Drain fat. Mix in the taco seasoning, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the refried beans to cover the bottom of the prepared 9x13 inch pan. Layer the cooked ground beef and onions evenly over the refried beans. Pour the jar of salsa over the ground beef and spread 2 cups shredded Cheddar cheese over the salsa layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the cheese is bubbly and the layers are heated through. Serve with tortilla chips and your choice of fresh toppings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
