    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "24 (2 inch) frozen tart shells, thawed",
    "1.25 cups white sugar, divided",
    "4 eggs, separated",
    "0.25 cup butter, melted and cooled",
    "3 tablespoons lemon juice",
    "1 lemon, zested",
    "1.5 cups buttermilk, shaken",
    "4 tablespoons all-purpose flour",
    "1 pinch salt",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon cream of tartar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange tart shells on a baking sheet. Bake in the preheated oven until heated through, about 5 minutes. Remove from the oven; leave oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 3/4 cup sugar, egg yolks, butter, lemon juice, and lemon zest together in a medium bowl. Whisk in buttermilk. Add flour and salt; whisk well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide filling among tart shells, filling almost to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling rises and appears set, about 15 minutes. Watch carefully to avoid overcooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat egg whites in a glass, metal, or ceramic bowl with an electric mixer on high speed until frothy. Add remaining 1/2 cup sugar, vanilla, and cream of tartar; continue beating until meringue is stiff and shiny.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top baked tarts with meringue; press meringue down to form a seal around edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until meringue starts to brown, about 10 minutes more. Cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
