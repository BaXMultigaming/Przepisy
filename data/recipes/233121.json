  "ingredients": [
    "cooking spray",
    "6 cups sliced rhubarb",
    "0.66666668653488 cup white sugar",
    "1 (3 ounce) package strawberry-flavored gelatin mix",
    "1 (9 ounce) package yellow cake mix (such as Jiffy® Golden Yellow cake mix)",
    "0.75 cup water",
    "0.33333334326744 cup unsalted butter, melted",
    "2 teaspoons confectioners' sugar",
    "1 cup frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat an 11x7x2-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add rhubarb to the prepared baking dish; sprinkle white sugar on top, followed by gelatin mix and cake mix. Pour water over top; drizzle with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until rhubarb is tender, about 50 minutes. Cool on a wire rack for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dust cobbler with confectioners’ sugar; top servings with whipped topping.",
      "section": null,
