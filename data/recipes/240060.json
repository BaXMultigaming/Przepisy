  "ingredients": [
    "1 head cauliflower",
    "0.5 cup sour cream",
    "0.5 cup shredded Cheddar cheese",
    "1 teaspoon dry ranch salad dressing mix (such as Hidden Valley Ranch®)",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "1 tablespoon butter, cut into small pieces, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add cauliflower, cover, and steam until very tender, 15 to 20 minutes. Transfer cauliflower to a bowl, mash, and strain excess water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cauliflower, sour cream, Cheddar cheese, ranch dressing mix, onion powder, and garlic powder together in a 9-inch baking dish; top with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
