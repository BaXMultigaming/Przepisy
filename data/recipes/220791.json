  "ingredients": [
    "3 cups water",
    "1.5 cups uncooked brown rice",
    "1 red bell pepper, thinly sliced",
    "1 cup frozen green peas, thawed",
    "0.5 cup raisins",
    "0.25 sweet onion (such as Vidalia®), chopped",
    "0.25 cup chopped Kalamata olives",
    "0.5 cup vegetable oil",
    "0.25 cup balsamic vinegar",
    "1.25 teaspoons Dijon mustard",
    "salt and ground black pepper to taste",
    "0.25 cup feta cheese"
  ],
  "steps": [
    {
      "text": "Bring water and brown rice to a boil in a saucepan over high heat. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bell pepper, peas, raisins, onion, and olives in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, vinegar, and mustard together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown rice and vinaigrette into bell pepper mixture; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top salad with feta cheese before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
