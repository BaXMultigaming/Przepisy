  "ingredients": [
    "2.25 cups packed brown sugar",
    "2 cups finely chopped rhubarb",
    "2 cups chopped strawberries",
    "0.5 cup white vinegar",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground allspice",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Stir brown sugar, rhubarb, strawberries, vinegar, cinnamon, allspice, cloves, and nutmeg together in a saucepan over medium heat. Cook and stir until relish thickens, about 30 minutes. Cool, transfer to a sealable container, and store in the refrigerator.",
