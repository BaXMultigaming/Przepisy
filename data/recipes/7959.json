  "ingredients": [
    "1.75 cups strong brewed coffee",
    "0.25 cup dark rum",
    "5 (1 ounce) squares unsweetened chocolate",
    "1 cup butter",
    "2 eggs",
    "2 cups white sugar",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place coffee and rum in a saucepan and heat to simmer. Add the chocolate and the butter or margarine. Cook, stirring, occasionally, until both are melted. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat the eggs. Gradually beat in the sugar until the mixture is thick. Beat in the vanilla and the chocolate mixture. In another bowl, stir together the flour, baking soda, and salt. Beat into the chocolate mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the batter into a greased and floured tube pan. Bake in a preheated 275 degrees F (135 degrees C) oven for 1 1/2 hours, or until the cake tests done with a toothpick. Transfer to a rack to cool. Makes 16 servings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
