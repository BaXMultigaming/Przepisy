  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "1 (14 ounce) can sweetened condensed milk",
    "0.5 cup lemon juice",
    "1 teaspoon vanilla extract",
    "1 (8 inch) prepared graham cracker crust"
  ],
  "steps": [
    {
      "text": "Place cream cheese in a microwave-safe bowl; microwave at 50% power for 45 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend sweetened condensed milk, lemon juice, and vanilla extract together in a bowl until smooth. Add softened cream cheese and blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour filling into graham cracker crust. Refrigerate until filling sets, about 1 hour.",
