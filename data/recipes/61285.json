  "ingredients": [
    "1 pound ground beef",
    "2 cubes chicken bouillon, crumbled",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon onion powder",
    "0.5 cup all-purpose flour",
    "1.5 cups low-fat milk"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat; stir in the ground beef, chicken bouillon, garlic powder, black pepper, and onion powder. Cook and stir until the beef is crumbly, evenly browned, and no longer pink, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the flour and cook for 3 minutes, stirring constantly. Stir in the milk and bring to a simmer, stirring constantly. Reduce heat to medium-low, and simmer 5 minutes to thicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
