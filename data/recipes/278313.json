  "ingredients": [
    "2 eggs",
    "2 tablespoons Italian seasoning",
    "2 teaspoons chopped fresh basil",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon garlic powder",
    "2 pounds ground beef",
    "0.5 cup panko bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, Italian seasoning, basil, salt, pepper, and garlic powder in a large bowl until combined. Add ground beef and panko; mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape beef mixture into about 40 golf ball-sized meatballs (about 1 ½-inches). Arrange on ungreased, rimmed baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in centers, 10 to 15 minutes, flipping halfway through. An instant-read thermometer inserted into centers should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
