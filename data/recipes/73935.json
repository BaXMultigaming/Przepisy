  "ingredients": [
    "4 medium cucumbers, peeled and diced",
    "1 (8 ounce) container vanilla low-fat yogurt",
    "1 (8 ounce) container reduced-fat sour cream",
    "0.5 cup diced onion",
    "2 cloves garlic, minced",
    "1 tablespoon dried dill weed",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Place cucumbers onto paper towels and let drain for a few minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir yogurt, sour cream, onion, garlic, and dill together in a serving bowl. Add cucumbers and gently stir until coated. Season with salt and pepper. Refrigerate for 2 hours before serving for the best flavor.",
