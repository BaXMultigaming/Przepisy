  "ingredients": [
    "2 large (8 ounce) beets",
    "Reynolds Wrap® Aluminum Foil",
    "3 tablespoons lemon juice",
    "1 tablespoon finely chopped shallot",
    "1.5 teaspoons Dijon-style mustard",
    "0.5 teaspoon finely grated lemon zest",
    "0.5 teaspoon honey",
    "0.33333334326744 cup olive oil",
    "0.5 teaspoon salt, divided",
    "0.5 teaspoon ground black pepper, divided",
    "2 medium fennel bulbs, cored and very thinly sliced",
    "8 cups torn butterhead (Boston or bibb) lettuce",
    "4 ounces crumbled goat cheese (chevre)",
    "0.25 cup chopped walnuts, toasted",
    "2 tablespoons snipped fresh chives"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrub beets; wrap each beet in aluminum foil and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife can easily be inserted into beets, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk lemon juice, shallot, Dijon mustard, lemon zest, and honey together in a medium bowl. Slowly whisk in 1/3 cup olive oil in a steady stream. Cover and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool beets until able to handle, about 20 minutes. Remove and discard foil. Trim off stems and root ends; peel and cut into 1-inch pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beets, 3 tablespoons vinaigrette, 1/4 teaspoon salt, and 1/4 teaspoon black pepper in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine fennel, 3 tablespoons vinaigrette, 1/4 teaspoon salt, and 1/4 teaspoon black pepper in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line 8 salad plates with lettuce; drizzle with remaining vinaigrette. Layer on beets, fennel, goat cheese, walnuts, and chives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
