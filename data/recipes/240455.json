  "ingredients": [
    "1 cup all-purpose flour",
    "0.75 cup whole wheat flour",
    "1 tablespoon baking powder",
    "0.25 teaspoon kosher salt",
    "1.5 cups milk",
    "1 cup mashed overripe bananas",
    "0.5 cup canola oil",
    "2 eggs",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions. Grease waffle iron.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk all-purpose flour, whole wheat flour, baking powder, and salt together in a bowl. Whisk milk, bananas, canola oil, eggs, and vanilla extract together in a separate bowl; stir into flour mixture until batter is moistened with a few lumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon about 1/4 cup batter onto the preheated waffle iron, or according to manufacturer's instructions. Cook until waffle is golden brown and the iron stops steaming, about 5 minutes, or according to manufacturer's instructions. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
