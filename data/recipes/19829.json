  "ingredients": [
    "2 (20 ounce) cans crushed pineapple, drained",
    "1 cup all-purpose flour",
    "1 cup brown sugar",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 egg",
    "0.5 cup butter, melted",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XcSudejB9cAvPjBJidCV0kt2Nx4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-19829-pineapple-crisp-DDMFS-step-1-ccddea5d76374c9f9ddb179b110305bf.jpg"
      ],
      "image": "assets/images/19829/step_01.webp"
    },
    {
      "text": "Spread pineapple into a 9x9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KvHSCMYWv4Gwrg5OuVhNTMh5hoo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-19829-pineapple-crisp-DDMFS-step-2-24d6a3e282d24b1689457fc30c5c6213.jpg"
      ],
      "image": "assets/images/19829/step_02.webp"
    },
    {
      "text": "Mix flour, sugar, baking powder, salt, and egg together in a medium bowl until well combined and crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4-Pli703u5O4dfSVsl2oUi_PZgs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-19829-pineapple-crisp-DDMFS-step-3-ecda1d4fb0674b759c1bcbfafa8f0c28.jpg"
      ],
      "image": "assets/images/19829/step_03.webp"
    },
    {
      "text": "Spoon mixture evenly over pineapple. Pour melted butter over mixture, then sprinkle with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s6aca1RsLz2IqID8RBg6XDpof8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-19829-pineapple-crisp-DDMFS-step-4-12fe0748e76542bfad98900680f2130c.jpg"
      ],
      "image": "assets/images/19829/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until top is lightly browned and filling is bubbly, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VEcHdcPMrpRorMZ7o_HHo87Dv5M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-19829-pineapple-crisp-DDMFS-step-5-48539c9d98974988be3d256426102502.jpg"
      ],
      "image": "assets/images/19829/step_05.webp"
    },
    {
      "text": "Serve hot or cold. Enjoy!",
