  "ingredients": [
    "0.75 cup white sugar",
    "0.25 cup honey",
    "1 tablespoon water",
    "1 cup raw sesame seeds",
    "2 teaspoons butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with a silicone mat or parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, honey, and water in a small, thick-bottomed saucepan over medium heat; cook and stir until a smooth slurry forms, about 3 minutes. Stir in sesame seeds. Attach a candy thermometer to the saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook over medium-low heat, stirring often, until mixture turns amber-caramel colored and reaches 300 degrees F (150 degrees C), 5 to 10 minutes. Off heat, stir in butter and vanilla extract; pour onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool until hardened, 15 to 20 minutes; break into pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
