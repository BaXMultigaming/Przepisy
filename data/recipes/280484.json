  "ingredients": [
    "1 cup frozen strawberries, roughly chopped",
    "2 tablespoons all-purpose flour",
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "0.66666668653488 cup buttermilk",
    "0.5 cup vegetable oil",
    "1 large egg",
    "2.5 tablespoons plain yogurt",
    "1 teaspoon vanilla extract",
    "0.75 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease or line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix strawberries and 2 tablespoons flour together in a bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 cups flour, sugar, baking powder, cinnamon, and salt in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine buttermilk, oil, egg, yogurt, and vanilla extract in a large bowl. Pour in dry ingredients and mix until just incorporated. Fold in strawberries and chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 to 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
