  "title": "Grandma Gudgel's Black Bottom Cupcakes",
  "description": "A dollop of a rich cream cheese and chocolate chip batter is baked into the center of each of these deliciously moist chocolate cupcakes.",
  "authors": [
    "NANCYSTANFIELD"
  ],
