  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "1 egg",
    "0.33333334326744 cup white sugar",
    "0.125 teaspoon salt",
    "1 cup semisweet chocolate chips",
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "0.25 cup cocoa",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup water",
    "0.33333334326744 cup vegetable oil",
    "1 tablespoon distilled white vinegar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly butter muffin tins and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, egg, sugar, and salt together in a large bowl until well combined. Stir in chocolate chips and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, cocoa, baking soda, and salt together in a bowl. Add the water, oil, vinegar, and vanilla. Beat until well combined and smooth. Batter will be thin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill muffin cups 1/3 full with the chocolate batter. Top each one with a spoonful of cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
