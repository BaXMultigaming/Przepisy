  "ingredients": [
    "1 cup chicken broth",
    "0.5 cup honey",
    "0.25 cup prepared yellow mustard",
    "1 tablespoon mustard powder",
    "1.5 teaspoons garlic powder",
    "1.5 teaspoons onion powder",
    "1 teaspoon rosemary flakes",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "8 chicken thighs",
    "3 pounds red potatoes, unpeeled and diced into 3/4-inch cubes",
    "1 large yellow onion, coarsely chopped"
  ],
  "steps": [
    {
      "text": "Whisk broth, honey, yellow mustard, mustard powder, garlic powder, onion powder, rosemary, salt, and black pepper together in a large mixing bowl until well blended. Add chicken, potatoes, and onion and stir until well coated. Let mixture marinate for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken to the prepared baking dish. Cover chicken with potatoes and pour remaining liquid on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are golden brown and chicken is no longer pink at the bone and juices run clear, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
