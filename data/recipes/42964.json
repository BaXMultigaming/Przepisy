  "ingredients": [
    "2 pounds thinly sliced Scotch fillet (chuck eye steaks)",
    "0.5 cup soy sauce",
    "5 tablespoons white sugar",
    "2.5 tablespoons sesame seeds",
    "2 tablespoons sesame oil",
    "3 shallots, thinly sliced",
    "2 cloves garlic, crushed",
    "5 tablespoons mirin (Japanese sweet wine)"
  ],
  "steps": [
    {
      "text": "In a large bowl, stir together the soy sauce, sugar, sesame seeds, sesame oil, shallots, garlic, and mirin. Add the meat, and stir to coat. Cover and refrigerate for 12 to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat. Fry the meat for 5 to 10 minutes, or until no longer pink. Serve with salad or fried rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
