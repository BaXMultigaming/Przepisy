  "ingredients": [
    "0.5 cup ketchup",
    "2 tablespoons brown sugar",
    "1 teaspoon prepared mustard",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon salt",
    "1.5 teaspoons onion powder",
    "0.25 teaspoon garlic powder",
    "1 egg",
    "1 tablespoon milk",
    "0.25 teaspoon ground black pepper",
    "1.5 cups crispy wheat cereal squares",
    "1.5 pounds ground beef"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ketchup, brown sugar, and mustard in a large bowl and mix well. Remove 4 tablespoons of this mixture and reserve for later for the top of the loaves. Add Worcestershire sauce, salt, onion, garlic, egg, milk, and ground black pepper to meatloaf mixture; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in wheat cereal squares and let stand for 5 minutes. Then break up the cereal squares and add the ground beef, mixing well. Shape the mixture into the mini loaf pans you’ve decided to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 65 minutes. Brush on reserved ketchup mixture and bake for 15 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
