  "ingredients": [
    "2 cups all-purpose flour",
    "1.25 cups white sugar",
    "2 teaspoons ground cinnamon",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt",
    "0.75 cup vegetable oil",
    "2 eggs",
    "2.5 cups mangos, peeled, seeded and chopped",
    "0.25 cup raisins",
    "1 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 8x4-inch loaf pans. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, cinnamon, baking soda, and salt together in a large bowl. Beat oil and eggs together in a separate bowl until well combined; stir into flour mixture. Fold in mangoes, raisins, and lemon juice. Divide batter between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
