  "ingredients": [
    "6 slices pancetta, cut into small strips",
    "0.5 red onion, diced",
    "2 cloves garlic, minced",
    "0.5 teaspoon salt",
    "0.25 teaspoon freshly ground black pepper",
    "1 head cabbage, finely shredded",
    "2 tablespoons lite soy sauce",
    "1 dash hot pepper sauce (such as Tabasco®), or to taste"
  ],
  "steps": [
    {
      "text": "Cook and stir pancetta in a large skillet over medium heat until slightly browned, about 5 minutes. Add onion, garlic, salt, and black pepper; cook until onions become translucent, 5 to 10 minutes. Cook and stir cabbage with pancetta mixture until slightly softened, 5 minutes. Add soy sauce and hot pepper sauce; cook until cabbage is tender, about 10 more minutes.",
