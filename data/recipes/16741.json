    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix barbecue sauce, honey, ketchup, and onion together in a medium bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in a 9x13-inch baking dish. Pour sauce over chicken, then cover the dish with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center and the juices run clear, 45 minutes to 1 hour. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
