  "ingredients": [
    "1.75 cups all-purpose flour",
    "0.33333334326744 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "5 tablespoons unsalted butter, chilled and cubed",
    "0.5 cup miniature semisweet chocolate chips",
    "3 tablespoons orange juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a baking sheet with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking powder, and salt together in a large bowl. Cut in butter with a pastry blender or a large fork until the mixture resembles coarse crumbs. Stir in chocolate chips. Mix in orange juice to form a dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn out dough on a floured surface. Pat or roll into a 9-inch circle about 1/2 inch thick. With a 2 ½-inch fluted biscuit cutter, cut out 12 scones, pushing the dough scraps together for the last few, if necessary. Transfer the scones to the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden brown, about 12 minutes. Move to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
