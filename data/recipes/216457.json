  "ingredients": [
    "12 shucked oysters",
    "12 slices bacon",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon smoked paprika",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 450 degrees F (230 degrees C). Set a wire rack into a small baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap each oyster with a slice of bacon, and secure with a toothpick. Sprinkle with salt, pepper, paprika, and parsley; set onto wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the bacon is crispy, 10 to 12 minutes. Serve immediately. They aren't as good once they get cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
