  "title": "Moist Apple Crisp",
  "description": "In this moist apple crisp recipe, sliced apples, brown sugar, white sugar, oats, butter, cinnamon, and vanilla unite in this oat crumble layered crisp.",
  "authors": [
    "Medichef"
  ],
  "date_published": "2000-10-08T15:09:45-04:00",
