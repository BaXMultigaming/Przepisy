  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup brown sugar",
    "0.75 cup rolled oats",
    "0.5 cup butter, melted",
    "1 teaspoon ground cinnamon",
    "4 cups peeled, cored and sliced apples",
    "0.5 cup white sugar",
    "0.5 cup water",
    "1 tablespoon cornstarch",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, oats, melted butter, and cinnamon in a bowl; stir until crumbly. Press ½ oat mixture into a 9x13-inch baking dish; cover with sliced apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, water, cornstarch, and vanilla extract in a medium saucepan over medium heat; cook and stir until thick and clear, about 10 minutes. Pour over sliced apples; top with remaining ½ oat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and golden, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
