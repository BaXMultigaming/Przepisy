  "ingredients": [
    "1 (10.75 ounce) can Campbell's® Condensed Cream of Chicken Soup (Regular or 98% Fat Free)",
    "1 (8 ounce) can whole kernel corn, drained",
    "2 cups cubed cooked chicken or turkey",
    "1 (8 ounce) package corn muffin mix",
    "0.75 cup milk",
    "1 egg",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Heat the oven to 400 degrees F. Stir the soup, corn and chicken in a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the muffin mix, milk and egg in a small bowl just until blended. Spread the batter over the chicken mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes or until the topping is golden brown. Sprinkle with the cheese. Let stand until the cheese is melted.",
      "section": null,
