  "ingredients": [
    "1 cup butter, softened",
    "1.5 cups white sugar",
    "3 cups all-purpose flour",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar in a bowl until creamy. Stir in flour, vanilla extract, baking powder, and baking soda until dough is well mixed. Drop spoonfuls of dough 2-inches apart onto prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until lightly browned, 5 to 10 minutes.",
