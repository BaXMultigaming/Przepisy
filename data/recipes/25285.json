  "ingredients": [
    "0.5 pound fresh green beans, cut into 1-inch lengths",
    "2 carrots, cut into thick strips",
    "0.25 cup butter",
    "1 onion, sliced",
    "0.5 pound fresh mushrooms, sliced",
    "1 teaspoon salt",
    "0.5 teaspoon seasoned salt",
    "0.25 teaspoon garlic salt",
    "0.25 teaspoon white pepper"
