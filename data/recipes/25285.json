  "steps": [
    {
      "text": "Fill a pot with 1-inch water and bring to a boil over high heat. Place green beans and carrots in boiling water. Cover and cook until tender but still firm. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Sauté onions and mushrooms until almost tender. Reduce heat, cover, and simmer 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in green beans, carrots, salt, seasoned salt, garlic salt, and white pepper. Cover and cook for 5 minutes over medium heat.",
