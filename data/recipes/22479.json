  "ingredients": [
    "28 ounces fresh, ground spicy pork sausage",
    "1 cup uncooked long-grain rice",
    "1 slice onion, diced",
    "3 cloves garlic, minced",
    "1 green bell pepper, chopped",
    "1 red bell pepper, chopped",
    "1 (28 ounce) can whole peeled tomatoes, crushed",
    "1 cup chicken broth",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brown sausage in a skillet over medium-high heat; drain grease. Add rice, onion, garlic, and peppers; cook and stir for 5 minutes. Stir in tomatoes, chicken broth, salt, pepper, and cayenne pepper. Transfer into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until rice is tender and most of the liquid is absorbed, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
