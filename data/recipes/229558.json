  "ingredients": [
    "cooking spray",
    "1 pound bulk sausage",
    "1 cup shredded Cheddar cheese",
    "1 cup shredded Swiss cheese",
    "0.5 cup chopped green onion",
    "8 eggs",
    "0.66666668653488 cup instant potato flakes",
    "0.5 cup heavy whipping cream",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Spray 36 mini muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat and crumble in sausage. Cook and stir until sausage is crumbly and evenly browned, about 10 minutes . Drain and discard any excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle sausage, Cheddar cheese, Swiss cheese, and green onion evenly into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, potato flakes, and cream together in a bowl; season with salt and pepper. Pour egg mixture evenly over the sausage-cheese mixture in the muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until quiches are set in the middle and lightly browned, about 22 minutes. Cool for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
