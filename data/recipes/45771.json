  "title": "Pears in Chocolate Sauce",
  "description": "Delight your family with this elegant and delicious dessert. Pears are poached in vanilla syrup, then served with dark chocolate sauce.",
  "authors": [
    "MONICA SELF"
  ],
  "date_published": "2020-06-18T23:08:38-04:00",
