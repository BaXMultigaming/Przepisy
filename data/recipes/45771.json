  "ingredients": [
    "4 pears, peeled",
    "0.5 lemon, juiced",
    "2 cups water",
    "0.5 cup white sugar",
    "0.25 teaspoon vanilla extract",
    "4 (1 ounce) squares bittersweet chocolate, chopped",
    "2 tablespoons heavy cream",
    "1 tablespoon butter",
    "1 tablespoon coffee flavored liqueur",
    "4 maraschino cherries, garnish"
  ],
  "steps": [
    {
      "text": "Leave stems on peeled pears. Sprinkle with lemon juice to prevent browning. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan large enough to accommodate 4 pears standing upright, combine water and sugar. Place over medium heat, and boil until sugar is dissolved. Stir in vanilla, then place the pears in. Reduce heat, cover, and simmer for 15 minutes. Allow to cool in liquid, then drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the top of a double boiler, combine chocolate, cream and butter. Heat, stirring, until chocolate is melted and smooth. Remove from heat, and stir in coffee liqueur.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pears on serving dish, pour chocolate sauce over pears, and garnish with maraschino cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
