  "ingredients": [
    "1 teaspoon ground cumin",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon paprika",
    "8 skinless, boneless chicken thighs",
    "2 teaspoons vegetable oil",
    "3 cloves garlic, finely chopped",
    "0.25 cup good-quality honey",
    "2 tablespoons Dijon mustard",
    "0.5 cup chicken broth",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine cumin, thyme, and paprika in a small bowl and rub chicken thighs with spice mix on all sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat and brown chicken on all sides, about 10 minutes. Place chicken in a slow cooker. Cover with chopped garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir honey and mustard together in a small bowl and pour over chicken. Pour in chicken broth and close slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until chicken is cooked through, about 6 hours. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
