  "ingredients": [
    "2 cups brown sugar",
    "2.5 cups rolled oats",
    "4 cups all-purpose flour",
    "1 tablespoon baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "1.5 teaspoons ground cinnamon",
    "0.25 cup canola oil",
    "0.5 cup prune puree",
    "2 tablespoons water",
    "5 egg whites",
    "1.5 teaspoons vanilla extract",
    "0.75 cup raisins",
    "0.25 cup chopped walnuts",
    "0.33333334326744 cup chopped dried apricots"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the brown sugar, oats, flour, baking soda, baking powder, salt and cinnamon. Make a well in the center and pour in the canola oil, prune puree, water, egg whites and vanilla. Mix until well blended. Stir in the raisins, walnuts and apricots. Scoop cookies using an ice cream scoop, or roll into golf ball sized balls. Place cookies 2 inches apart onto the prepared cookie sheets and flatten to 1/2 tall with wet hands. These cookies do not flatten very much while baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the preheated oven, bake 8 minutes for chewy cookies 10 to 12 minutes for dry cookies. Cookies will not get crisp. Remove from cookie sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
