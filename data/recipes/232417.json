  "ingredients": [
    "3 eggs",
    "1.25 cups self-rising flour",
    "0.5 cup white sugar",
    "0.5 cup brown sugar, packed",
    "0.75 cup butter, melted and cooled",
    "2 tablespoons milk",
    "0.5 teaspoon vanilla extract",
    "1 cup chopped walnuts",
    "1 cup sweetened flaked coconut",
    "0.66666668653488 cup miniature chocolate chips",
    "1 unbaked frozen pie shell"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a mixing bowl until foamy. Add flour, white sugar, and brown sugar; beat into the eggs. Blend butter, milk, and vanilla extract into the egg mixture. Stir walnuts, coconut, and chocolate chips into the egg mixture; pour into the pie shell. Place pie onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until cooked through, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
