    "publisher-tested"
  ],
  "ingredients": [
    "0.5 cup warm water",
    "2.5 teaspoons yeast",
    "4 cups all-purpose flour",
    "0.5 cup evaporated milk",
    "0.375 cup white sugar",
    "0.33333334326744 cup butter, melted",
    "1 large egg",
    "1 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.66666668653488 cup white sugar",
    "0.5 cup butter, softened",
    "1 cup all-purpose flour",
    "2 teaspoons ground cinnamon",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GbkmcS5G3g3jogTP4THEXz4N4Ko=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88907-Conchas-DDMFS-001-step1-61a5d33916944a53b20fcc3a37fcf90a.jpg"
      ],
      "image": "assets/images/88907/step_01.webp"
    },
    {
      "text": "To make the bread: combine warm water and yeast in a large bowl; let stand until yeast softens and begins to form a creamy foam, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3IY7ErKtb0rToZ_yzTInFqaR-vI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88907-Conchas-DDMFS-001-step2-c0283c6a508b44bfbcf0de976483cdd7.jpg"
      ],
      "image": "assets/images/88907/step_02.webp"
    },
    {
      "text": "Mix in 2 cups flour, milk, 3/8 cup sugar, ⅓ cup melted butter, egg, and salt until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xdGJD0gQptju4JhwZzdXKDmXPbE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88907-Conchas-DDMFS-001-step3-538bb28f96b843b69b02e9933bd43859.jpg"
      ],
      "image": "assets/images/88907/step_03.webp"
    },
    {
      "text": "Gradually mix in remaining 2 cups flour and ½ teaspoon cinnamon until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QFJ-ci6di0l9QdOlu7IMQ-HB5zw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88907-Conchas-DDMFS-001-step4-1266ea94b7ae4942a4e4084f6291c2ae.jpg"
      ],
      "image": "assets/images/88907/step_04.webp"
    },
    {
      "text": "Turn dough out onto a floured surface; knead until smooth and elastic, 6 to 8 minutes. Place in a large greased bowl; turn dough to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jOFZfkObNBl-AUsWM-FPeJABGvI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88907-Conchas-DDMFS-001-step6-fa4002ec3b324085aed58f10e2199abd.jpg"
      ],
      "image": "assets/images/88907/step_05.webp"
    },
    {
      "text": "Cover; let dough rise in a warm place until doubled in volume, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l8mGrzU1NcWf0FOLr9kP-ECpm1A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88907-Conchas-DDMFS-001-step7-9316984646dc4db18751242221de9391.jpg"
      ],
      "image": "assets/images/88907/step_06.webp"
    },
    {
      "text": "Meanwhile, make the topping: Beat ⅔ cup sugar and ½ cup butter in a medium bowl with an electric mixer until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4zM5hhFvh2dfK-wz4ak2GzD5CpU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88907-Conchas-DDMFS-001-step8-72c0f57369914ea4acc53eeb5cf74763.jpg"
      ],
      "image": "assets/images/88907/step_07.webp"
    },
    {
      "text": "Stir in 1 cup flour until a thick paste forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QFJ-ci6di0l9QdOlu7IMQ-HB5zw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88907-Conchas-DDMFS-001-step4-1266ea94b7ae4942a4e4084f6291c2ae.jpg"
      ],
      "image": "assets/images/88907/step_08.webp"
    },
    {
      "text": "Divide paste in half; place each half in separate bowls. Stir 2 teaspoons cinnamon into one half and vanilla extract into other half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o-JwFELdBNi9M4Y5AfB2zxlrP60=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88907-Conchas-DDMFS-001-step10-d363a6d892714cc494f4172de0fe97b8.jpg"
      ],
      "image": "assets/images/88907/step_09.webp"
    },
    {
      "text": "Divide dough into 12 equal pieces; shape into balls and place 3 inches apart onto a greased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b335-j9LjFcYz9Kg-2tOkOSLPW8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88907-Conchas-DDMFS-001-step12-96c12f2418564ad88c4152003e4fc869.jpg"
      ],
      "image": "assets/images/88907/step_10.webp"
    },
    {
      "text": "Divide each topping paste into 6 balls; pat each until flat. Place flattened topping circles onto dough balls, patting down lightly. Cut grooves in topping like a seashell using a knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B4hf-zabaomT6VUdegUpQxo8C_I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88907-Conchas-DDMFS-001-step14-4dcfa77583a44eb2b7c8941a0559bc31.jpg"
      ],
      "image": "assets/images/88907/step_11.webp"
    },
    {
      "text": "Cover; let dough balls rise until doubled in volume, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8FVCCfw7lbKZpfXEAHuJVfb1vy8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88907-Conchas-DDMFS-001-step15-05878b2e5bb74ef8b13d161f9cc7b129.jpg"
      ],
      "image": "assets/images/88907/step_12.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Co-VeI62Lag8DqrGnEsjyA6GXgY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88907-Conchas-DDMFS-001-step16-6e58dda782d54c15aa1bd218ccf774e3.jpg"
      ],
      "image": "assets/images/88907/step_14.webp"
    }
  ],
