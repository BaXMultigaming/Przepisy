  "ingredients": [
    "1 tablespoon finely ground roasted peanuts",
    "1 teaspoon ground cayenne pepper",
    "1 teaspoon ground paprika",
    "1 teaspoon salt",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "1.5 pounds beef tri-tip steak, cut into bite-size pieces",
    "1 red bell pepper, cut into bite-size pieces",
    "0.25 onion, cut into bite-size pieces",
    "4 mushrooms, halved"
  ],
  "steps": [
    {
      "text": "Mix ground peanuts, cayenne pepper, paprika, salt, ginger, garlic powder, and onion powder together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine spice mixture and beef in a resealable plastic bag; shake until well coated. Marinate in the refrigerator, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beef, bell pepper, onion, and mushrooms in alternating order onto skewers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, flipping once, until meat is browned and vegetables are soft, 10 to 15 minutes.",
      "section": null,
