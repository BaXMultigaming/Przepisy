  "ingredients": [
    "1 cup butter",
    "1 cup packed brown sugar",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tjNEDa6r8yUcOva1iSTJjdJkaFM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10909-annas-chocolate-chip-cookies-VAT-step-01-3fc1555656a34ff8be4e2b14e0a651d5.jpg"
      ],
      "image": "assets/images/10909/step_01.webp"
    },
    {
      "text": "Beat butter, brown sugar, and white sugar in a large bowl with an electric mixer on medium speed until smooth, about 2 minutes. Beat in vanilla and eggs, one at a time, until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-MZz8EoDUwe-SmczS7JZPUt7Jtw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10909-annas-chocolate-chip-cookies-VAT-step-02-0a295ae9df8440079b092d73df81174c.jpg"
      ],
      "image": "assets/images/10909/step_02.webp"
    },
    {
      "text": "Combine flour, baking soda, and salt; stir into sugar mixture. Finally, fold in chocolate chips until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pZ8frBVvciye9MCMDZ-Y_H8Klzs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10909-annas-chocolate-chip-cookies-VAT-step-03-2297c1b68dfc4e9b990037dd791b5890.jpg"
      ],
      "image": "assets/images/10909/step_03.webp"
    },
    {
      "text": "Drop dough by rounded tablespoonfuls onto ungreased baking sheets, spacing about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gsNWLph45r6cVw2dbROF2fniOAg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10909-annas-chocolate-chip-cookies-VAT-step-04-f71a1b3ac82a4666870cacc6bfef5f04.jpg"
      ],
      "image": "assets/images/10909/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 8 to 10 minutes. Briefly cool on baking sheets, then transfer to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Wtj6Xx2CmAmE5b8mxUzvO7eEO5g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10909-annas-chocolate-chip-cookies-VAT-step-05-0e71caed060242e5b2526a456f291b88.jpg"
      ],
      "image": "assets/images/10909/step_05.webp"
    }
  ],
