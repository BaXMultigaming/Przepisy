  "ingredients": [
    "6 ears corn, husked and cleaned",
    "3 large tomatoes, diced",
    "1 large onion, diced",
    "0.25 cup chopped fresh basil",
    "0.25 cup olive oil",
    "2 tablespoons white vinegar",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
