  "ingredients": [
    "2 tablespoons olive oil",
    "1 onion, chopped",
    "2 teaspoons chopped garlic",
    "4 skinless, boneless chicken breast, chopped",
    "2 (14.5 ounce) cans great Northern beans",
    "20 ounces chicken broth",
    "1 (4 ounce) can chopped green chiles (such as Old El Paso®)",
    "12 sprigs cilantro, chopped",
    "2 teaspoons salt",
    "0.5 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large pot over medium-high heat. Add onion and garlic; sauté until softened, about 5 minutes. Transfer to a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chicken in the residual oil; cook and stir until completely browned, 5 to 7 minutes. Return onion mixture to the pot; add beans, broth, chiles, cilantro, salt, and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring the soup to a boil, then reduce the heat to medium-low and cook until beans are very tender and chicken is cooked through, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
