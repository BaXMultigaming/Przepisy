  "ingredients": [
    "1 (29 ounce) can sliced peaches, with juice",
    "1 (18.25 ounce) package yellow cake mix",
    "0.5 cup margarine",
    "1 cup white sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour canned peaches into a 9x13-inch baking pan; make sure juices cover peaches, if not add a small amount of water to just cover fruit. Mix peaches with 1/2 cup of sugar and sprinkle with cinnamon to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle dry cake mix evenly over top of peach mixture. Poke holes into cake mix to allow juice through. Cut stick of margarine into small pats; place randomly over the top. Sprinkle with remaining 1/2 cup sugar and a light dusting of cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes, or until bubbly and top is crusty and golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
