  "ingredients": [
    "2 (15 ounce) cans pineapple chunks, drained",
    "1 cup white sugar",
    "0.75 cup all-purpose flour",
    "2 cups shredded sharp Cheddar cheese",
    "25 buttery round crackers, crumbled",
    "0.5 cup melted butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pineapple in the bottom of a 2 quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, stir together the sugar, flour and cheese. Add to casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle crackers over the top of pineapple and cheese mixture. Pour melted butter over the top and bake for 30 minutes.",
