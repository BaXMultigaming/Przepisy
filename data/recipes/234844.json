  "ingredients": [
    "24 large mushrooms, stems removed, or more as needed",
    "1 pound bulk hot Italian sausage",
    "1 onion, diced",
    "4 ounces grated Parmesan cheese, divided",
    "0.25 cup Italian bread crumbs",
    "1 teaspoon minced garlic",
    "1 teaspoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Hollow out each mushroom cap, reserving the scrapings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GGbZsjPRddo0V5v3DH-MRuRNwXs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234844-easy-sausage-stuffed-mushrooms-ddmfs-4x3-step1-0006-b9cd6900932347b6ace31705e05c062c.jpg"
      ],
      "image": "assets/images/234844/step_02.webp"
    },
    {
      "text": "Heat a skillet over medium-high heat; add sausage, onion, and reserved mushroom scrapings. Cook and stir until sausage is browned and cooked through, 4 to 6 minutes. Drain and discard grease; return sausage mixture to the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FJJoYLqXXNAuBDXaQfzCtT3em0c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234844-easy-sausage-stuffed-mushrooms-ddmfs-4x3-step2-0010-f37ec05ce8144669b93c80dc12ba1d96.jpg"
      ],
      "image": "assets/images/234844/step_03.webp"
    },
    {
      "text": "Stir 3 ounces Parmesan cheese, bread crumbs, garlic, and parsley into sausage mixture. Cook and stir until heated through, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4U9F_yT7RIT3zboFDW1MlDH0-E0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234844-easy-sausage-stuffed-mushrooms-ddmfs-4x3-step3-0012-bd2f75a1885440e2a1b3cb04262e1115.jpg"
      ],
      "image": "assets/images/234844/step_04.webp"
    },
    {
      "text": "Stuff each mushroom cap with sausage mixture and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0yad5yzQxY7Qfvo2qnLsrTIiIc8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234844-easy-sausage-stuffed-mushrooms-ddmfs-4x3-step4-0016-cffebffc22964b5c8a5fe4a254a70a67.jpg"
      ],
      "image": "assets/images/234844/step_05.webp"
    },
    {
      "text": "Bake stuffed mushrooms in the preheated oven for 12 minutes. Sprinkle remaining 1 ounce Parmesan cheese over mushrooms and bake until mushrooms are cooked through and cheese is melted and bubbling, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uZyDViNnoy1ZXHY-Vef-N0FTlok=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234844-easy-sausage-stuffed-mushrooms-ddmfs-4x3-0063-78a437aba03645de8f85cca7d045718f.jpg"
      ],
