  "ingredients": [
    "1 bunch fresh dill, chopped",
    "1 tablespoon walnuts",
    "1 tablespoon freshly grated Parmesan cheese",
    "0.5 lemon, zested and juiced",
    "1 clove garlic, peeled and quartered",
    "0.13 teaspoon salt",
    "freshly ground black pepper to taste",
    "1 pinch red pepper flakes",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Place dill fronds (a few stems are OK), walnuts, lemon juice, lemon zest, garlic, salt, pepper, and red pepper flakes into the bowl of a food processor. If you have a mini or small food processor, it will be large enough for this recipe.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pulse until everything is minced well, scraping down the sides as necessary. With the machine running, drizzle in the olive oil, blending for a few seconds until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "If not serving immediately, store the pesto in an airtight container and chill until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
