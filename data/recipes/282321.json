  "ingredients": [
    "1 tablespoon olive oil",
    "6 (5 ounce) bone-in chicken thighs",
    "1 cup dark brown sugar",
    "4 tablespoons reduced-sodium soy sauce",
    "3 tablespoons honey",
    "3 cloves garlic, minced",
    "0.5 tablespoon ground ginger",
    "2 cups pineapple chunks",
    "1 medium white onion, cut into large chunks",
    "2 tablespoons cornstarch",
    "2 tablespoons water",
    "1 (8 ounce) package frozen sugar snap peas"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium-high heat. Brown chicken in hot oil, about 2 1/2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While chicken is cooking, mix brown sugar, soy sauce, honey, garlic, and ginger together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken to the bottom of a slow cooker. Place pineapple and onion on top of the chicken. Pour sauce over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on High for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 500 degrees F (260 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from the slow cooker and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake chicken in the preheated oven until no longer pink at the bone and the juices run clear, about 15 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix cornstarch and water together in a small bowl. Add it to the slow cooker, stir, and cook until sauce has thickened, about 30 minutes. Add snap peas and chicken and cook until heated through, 15 to 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
