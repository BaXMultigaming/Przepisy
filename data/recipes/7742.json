  "ingredients": [
    "1 (21 ounce) can apple pie filling",
    "0.5 teaspoon ground cinnamon, or to taste",
    "1 (18.25 ounce) package apples and cinnamon muffin mix",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together apple pie filling and cinnamon in a large bowl; pour into the prepared dish. Sprinkle muffin mix over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small saucepan over medium heat, then pour evenly over the top of cake. Sprinkle with additional cinnamon if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 20 minutes.",
      "section": null,
