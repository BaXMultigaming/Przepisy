  "ingredients": [
    "1 cup uncooked white rice",
    "0.25 cup white sugar",
    "2 (15 ounce) cans crushed pineapple",
    "1 cup miniature marshmallows",
    "1 cup heavy cream, whipped",
    "6 maraschino cherries"
  ],
  "steps": [
    {
      "text": "In a saucepan bring 2 cups water to a boil. Add rice and stir. Reduce heat, cover and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine the cooked, cooled rice, sugar, pineapple and marshmallows. Fold in the whipped cream. Chill for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon the rice mixture into 6 dessert dishes and place a cherry on top of each.",
