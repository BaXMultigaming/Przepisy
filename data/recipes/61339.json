  "ingredients": [
    "3 tablespoons brown sugar",
    "2 tablespoons rice wine",
    "2 teaspoons rice wine vinegar",
    "0.25 cup coconut milk",
    "0.75 cup peanut butter",
    "0.25 teaspoon curry powder",
    "2 teaspoons dark soy sauce",
    "0.25 teaspoon toasted sesame oil",
    "0.5 teaspoon minced garlic",
    "0.5 teaspoon sweet chili sauce",
    "1 teaspoon minced pickled ginger",
    "0.5 teaspoon fish sauce"
  ],
  "steps": [
    {
      "text": "Mix together the brown sugar, rice wine, and rice wine vinegar in a small bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the coconut milk and peanut butter in a small saucepan over low heat. Heat and stir until the peanut butter melts, being careful to not allow the coconut milk to boil. Stir the sugar mixture into the coconut milk mixture; pour into a bowl. Stir in curry powder, soy sauce, sesame oil, garlic, chili sauce, ginger, and fish sauce.",
