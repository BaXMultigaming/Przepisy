  "ingredients": [
    "1.75 cups milk",
    "1.5 cups all-purpose flour",
    "0.25 cup unsalted butter, melted",
    "3 large eggs",
    "3 tablespoons powdered sugar",
    "1.5 tablespoons vanilla extract",
    "1 pinch ground nutmeg",
    "cooking spray",
    "1 (8 ounce) package cream cheese",
    "1 cup powdered sugar",
    "0.25 cup unsalted butter, softened",
    "1 tablespoon hazelnut-flavored syrup",
    "2 tablespoons chopped pecans, or to taste"
  ],
  "steps": [
    {
      "text": "Mix milk, flour, melted butter, eggs, powdered sugar, vanilla, and nutmeg for crepes together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a nonstick pan with cooking spray and heat over medium heat. Pour 1/4 cup crepe batter into the heated pan. Tilt and swirl the pan until batter evenly coats the surface. Cook until light brown on the bottom, about 2 minutes. Flip and cook on the other side for about 2 minutes. Remove to a plate and repeat to cook remaining crepes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese, powdered sugar, softened butter, and syrup together in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
