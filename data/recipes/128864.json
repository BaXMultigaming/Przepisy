  "ingredients": [
    "2 pounds smoked haddock fillets",
    "2 tablespoons all-purpose flour",
    "0.25 cup melted butter",
    "2 cups warm milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place smoked haddock into a glass baking dish. Whisk flour into the melted butter until smooth, then whisk in milk, and pour over the haddock.",
