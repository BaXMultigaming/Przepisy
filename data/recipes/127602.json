  "ingredients": [
    "2 small red onions",
    "0.5 cup cider vinegar",
    "0.25 cup sugar",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel onions and trim root ends just slightly. Quarter the onions, keeping the layers intact with the remaining root ends. If necessary, use a toothpick to keep layers together while on the grill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill onions until slightly charred, about 5 minutes. Remove from the grill and place in a nonreactive bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat vinegar, sugar, and salt in a small non-reactive saucepan over medium heat. Stir until the sugar is dissolved. Pour hot liquid over the grilled onions and let stand for 10 to 15 minutes. Remove onions from liquid and refrigerate until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
