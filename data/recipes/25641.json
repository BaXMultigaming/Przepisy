  "ingredients": [
    "1.75 cups margarine, softened",
    "1.75 cups white sugar",
    "6 eggs",
    "2 cups confectioners' sugar",
    "2.25 cups all-purpose flour",
    "0.75 cup unsweetened cocoa powder",
    "2 cups chopped walnuts",
    "0.75 cup confectioners' sugar",
    "0.25 cup unsweetened cocoa powder",
    "2 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 10 inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter and white sugar until light and fluffy. Beat in the eggs one at a time. Gradually blend in 2 cups confectioners' sugar. Beat in the flour and 3/4 cup cocoa powder. Stir in the chopped walnuts. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 60 to 65 minutes, or until a toothpick inserted into the center of the cake comes out clean. Let cool in pan for 1 hour, then turn out onto a wire rack and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the glaze: In a small bowl, combine 3/4 cup confectioners' sugar and 1/4 cup cocoa. Stir in milk, a tablespoon at a time, until desired drizzling consistency is achieved. Spoon over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
