  "title": "Easy Cabbage Rolls",
  "description": "This easy recipe for cabbage rolls combines ground beef and rice with cabbage leaves in a tomato sauce for a tasty and wholesome slow cooker meal.",
  "authors": [
    "BJ"
  ],
  "date_published": "2000-03-09T11:25:31-05:00",
