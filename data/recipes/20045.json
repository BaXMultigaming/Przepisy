  "ingredients": [
    "12 leaves cabbage",
    "1 pound extra-lean ground beef",
    "1 cup cooked white rice",
    "1 egg, beaten",
    "0.25 cup milk",
    "0.25 cup minced onion",
    "1.25 teaspoons salt",
    "1.25 teaspoons ground black pepper",
    "1 (8 ounce) can tomato sauce",
    "1 tablespoon brown sugar",
    "1 tablespoon lemon juice",
    "1 teaspoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil. Boil cabbage leaves for 2 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-6qQnMJaomI9dnzHWV4C74xB24Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20045-cabbage-rolls-ii-ddmfs-Step1-0055-6070beb839364a46836b78538307e5af.jpg"
      ],
      "image": "assets/images/20045/step_01.webp"
    },
    {
      "text": "Combine ground beef, cooked rice, egg, milk, onion, salt, and pepper in a large bowl. Spoon about 2 tablespoons of mixture onto each cabbage leaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ypq_ucJwWMrfulyq0q7SXRQOXQI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20045-cabbage-rolls-ii-ddmfs-Step3-0060-a3ff58b5f4a548ccbc555555c40314c7.jpg"
      ],
      "image": "assets/images/20045/step_02.webp"
    },
    {
      "text": "Bring one end of the cabbage leaf over the mixture, rolling and tucking in the ends to prevent filling from falling out; arrange rolls in a single layer in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KS4eEji9oviuPuFGx88Zwi1MRRU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20045-cabbage-rolls-ii-ddmfs-Step5-0067-b757d643fba34448963c7703f543ce13.jpg"
      ],
      "image": "assets/images/20045/step_03.webp"
    },
    {
      "text": "Mix tomato sauce, brown sugar, lemon juice, and Worcestershire sauce together in a small bowl until combined. Pour over cabbage rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J_x2MmAs7e07qqn4_5OJkqVdjds=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20045-cabbage-rolls-ii-ddmfs-Step7-0069-0ecde92ab28a4ee9b4460f551b82b04c.jpg"
      ],
      "image": "assets/images/20045/step_04.webp"
    },
    {
      "text": "Cover and cook on Low for 8 to 9 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xoEEI0xQsAdA9DmOLHNfdc4R6TU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20045-cabbage-rolls-ii-ddmfs-4X3-0117-ab42229579aa48acb9aef2d6f4451813.jpg"
      ],
      "image": "assets/images/20045/step_05.webp"
    }
  ],
