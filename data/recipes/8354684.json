  "ingredients": [
    "3 tablespoons dry bread crumbs",
    "3 tablespoons panko bread crumbs",
    "2 tablespoons freshly grated Parmesan cheese",
    "0.25 teaspoon dried oregano",
    "1 pinch salt",
    "2 tablespoons butter, melted",
    "2 (5 ounce) sole fillets",
    "1 tablespoon butter",
    "0.25 cup whipping cream",
    "2 tablespoons Pinot Grigio wine",
    "0.5 teaspoon lemon juice",
    "1 pinch ground white pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix both bread crumbs, Parmesan cheese, oregano, and salt in a shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour melted butter over both sides of sole fillets. Place fillets in bread crumb mixture and press to coat. Transfer to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, about 12 minutes. Turn on the broiler and broil until crumb topping is light golden brown, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the fish is cooking, melt butter for sauce in a pan over medium heat. Add cream, Pinot Grigio, lemon juice, and pepper; stir until sauce is smooth and has thickened slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve sauce over sole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
