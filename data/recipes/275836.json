  "ingredients": [
    "1 teaspoon butter, or as needed",
    "1 French baguette, cut into 1/2-inch slices",
    "1.5 cups half-and-half",
    "1.5 cups milk",
    "6 eggs",
    "1 teaspoon imitation vanilla extract",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon ground nutmeg",
    "1 cup brown sugar",
    "1 cup chopped pecans",
    "0.5 cup margarine",
    "2 tablespoons corn syrup"
  ],
  "steps": [
    {
      "text": "Butter a 9x13-inch baking pan. Place baguette slices into the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine half-and-half, milk, eggs, vanilla extract, cinnamon, and nutmeg in a bowl. Pour over bread slices, cover the baking pan, and store in the refrigerator, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Uncover pan. Combine brown sugar, pecans, margarine, and corn syrup in a bowl and spoon over bread mixture, making sure to touch each slice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out mostly clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
