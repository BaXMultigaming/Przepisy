  "title": "Cinnamon White Chocolate Cookies",
  "description": "White chocolate chunk cookies with a hint of cinnamon will be a crowd-pleasing treat for any occasion.",
  "authors": [
    "cmb2kool"
  ],
  "date_published": "2020-06-18T23:53:44-04:00",
