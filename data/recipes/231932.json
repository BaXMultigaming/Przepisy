  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 cup shortening",
    "0.75 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 egg",
    "2 teaspoons vanilla extract",
    "1.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "10 ounces white chocolate, chopped",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Beat butter and shortening together with an electric mixer until creamy and smooth; gradually add white sugar and brown sugar, beating on medium speed, until incorporated. Beat in egg and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, and salt in a separate bowl; mix into butter mixture until incorporated. Fold in white chocolate and cinnamon. Refrigerate dough for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by the heaping tablespoonful onto the prepared baking sheet, leaving 3 inches between cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are lightly browned on the edges, 12 to 14 minutes. Cool on the pans for 10 minutes before removing to cool on a wire rack until cookies are firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
