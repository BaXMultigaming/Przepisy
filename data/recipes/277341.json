  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.66666668653488 cup white sugar",
    "0.5 cup butter",
    "2 large eggs",
    "0.5 teaspoon orange oil",
    "0.5 teaspoon vanilla extract",
    "0.5 cup white chocolate chips",
    "0.5 cup dried cranberries",
    "0.5 cup coarsely chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend sugar and butter together using an electric mixer in another bowl. Beat in eggs, orange oil, and vanilla extract until smooth. Sift in flour mixture and beat until completely incorporated. Fold in white chocolate chips, cranberries, and pecans. Divide dough in half and form into rectangles on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Remove from the oven and let cool enough to handle, about 5 minutes; slice into biscotti as desired. Return to the oven and bake until toasted, about 15 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
