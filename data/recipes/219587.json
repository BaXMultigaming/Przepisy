  "title": "Christmas Prime Rib",
  "description": "A prime rib dinner is a great choice for Christmas! This impressive recipe includes the perfect roasting time for tender beef, plus a delicious au jus.",
  "authors": [
    "JUDY2RIVER"
  ],
  "date_published": "2020-06-18T23:46:49-04:00",
  "date_modified": "2026-01-05T16:50:40-05:00",
  "prep_time": "PT15M",
