  "ingredients": [
    "1 (16.5 ounce) can pitted Bing cherries, drained, juice reserved",
    "1 (15 ounce) can crushed pineapple, drained with juice reserved",
    "1 (6 ounce) package cherry Jell-O®",
    "1 (3 ounce) package cream cheese",
    "6 fluid ounces cola-flavored carbonated beverage",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Combine reserved cherry juice and pineapple juice in a saucepan to make 1 cup. Bring to a boil. Add gelatin and whisk until dissolved. Remove from the heat, add cream cheese, and whisk until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cola and beat until mixture becomes fluffy. Fold in cherries, pineapple, and nuts. Pour into molded container, chill 6 to 8 hours or until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
