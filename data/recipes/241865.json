  "ingredients": [
    "0.5 cup cocoa powder",
    "0.33333334326744 cup virgin coconut oil",
    "1 cup white sugar",
    "6 eggs",
    "0.5 teaspoon salt",
    "0.5 teaspoon vanilla extract",
    "0.5 cup coconut flour, sifted",
    "1 tablespoon semisweet chocolate chips, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cocoa powder and coconut oil together in a saucepan over low heat until coconut oil has melted, about 5 minutes. Remove from the heat and let cool, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, eggs, salt, and vanilla in a bowl with an electric mixer. Stir in cooled cocoa mixture, then whisk in coconut flour until no lumps remain. Pour batter into the prepared baking dish and sprinkle chocolate chips over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
