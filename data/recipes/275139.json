  "ingredients": [
    "2 large unpeeled navel oranges, each cut into 4 wedges",
    "0.25 cup honey",
    "1 tablespoon olive oil",
    "3 sprigs fresh thyme, leaves removed",
    "0.25 teaspoon Sriracha sauce, or more to taste",
    "coarse sea salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place orange wedges onto the prepared baking sheet. Mix honey, olive oil, thyme, and Sriracha sauce together in a small bowl. Brush enough mixture onto orange wedges to coat. Set remaining mixture aside for basting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast oranges in the preheated oven for about 30 minutes, basting once halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and immediately sprinkle wedges lightly with coarse sea salt. Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
