  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C). Spray a muffin tin with cooking spray; line cups with 1 wonton wrapper each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine shrimp, water chestnuts, mayonnaise, 2 tablespoons green onions, sesame oil, ginger, and salt in a bowl. Spoon mixture into the wonton wrappers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are dark brown, about 18 minutes. Remove wontons from muffin tin; garnish with the remaining green onions.",
      "section": null,
