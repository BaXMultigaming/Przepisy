  "ingredients": [
    "1 teaspoon butter",
    "3 cups white chocolate chips",
    "1 (14 ounce) can sweetened condensed milk",
    "0.33333334326744 cup butter",
    "2 teaspoons rum flavoring",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon ground nutmeg, or to taste",
