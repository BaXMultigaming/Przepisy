  "steps": [
    {
      "text": "Grease a 9-inch square baking pan with 1 teaspoon butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white chocolate chips, sweetened condensed milk, and 1/3 cup butter in a microwave-safe bowl. Microwave until white chocolate starts to melt, about 3 minutes; stir until smooth. Continue microwaving in 30-second intervals, stirring after each interval, until white chocolate is completely melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rum flavoring, vanilla extract, and nutmeg into white chocolate mixture. Fold in cranberries and walnut pieces. Pour fudge into the prepared baking pan, spreading evenly into the corners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool fudge until set, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
