  "title": "Simple but Awesome Lemon Pepper Pork Chops",
  "description": "Melt-in-your-mouth pork chops coated with lemon pepper and baked in butter, olive oil and Worcestershire sauce.",
  "authors": [
    "Matthew Jordan"
  ],
  "date_published": "2000-09-28T23:15:52-04:00",
