  "ingredients": [
    "3 tablespoons ground New Mexico chile",
    "2 tablespoons red wine vinegar",
    "1 tablespoon dried Mexican oregano",
    "1 tablespoon water",
    "3 cloves garlic, minced",
    "1.75 teaspoons salt",
    "1.5 teaspoons red pepper flakes",
    "1 teaspoon cumin seeds, crushed",
    "0.75 teaspoon white sugar",
    "0.5 teaspoon ground black pepper",
    "1 pound ground pork, well chilled"
  ],
  "steps": [
    {
      "text": "Combine chile powder, vinegar, oregano, water, garlic, salt, red pepper flakes, cumin seeds, sugar, and pepper in a small bowl. Mix until the salt and sugar are dissolved in the liquids.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break up pork in a bowl. Pour in spice mixture and knead thoroughly. Use immediately or refrigerate to let flavors meld, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir in a nonstick skillet over medium heat until browned and crumbly, about 10 minutes.",
      "section": null,
