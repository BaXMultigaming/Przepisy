  "ingredients": [
    "8 pounds untrimmed beef brisket",
    "1 cup strong black coffee",
    "1 (14 ounce) bottle ketchup",
    "1 (12 fluid ounce) can cola carbonated beverage",
    "3 tablespoons Worcestershire sauce",
    "3 tablespoons prepared yellow mustard",
    "2 tablespoons liquid smoke flavoring",
    "2 tablespoons brown sugar, packed"
  ],
  "steps": [
    {
      "text": "Place beef brisket in a large slow cooker, fat-side up. Pour coffee over brisket. Cover the slow cooker. Cook on Low for 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine ketchup, cola, Worcestershire sauce, mustard, liquid smoke, and brown sugar in a bowl until well blended. Refrigerate until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Discard any fat from brisket. Pull or shred brisket using two forks; pour sauce over brisket, stirring to evenly coat. Cook on Low, 1 hour more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
