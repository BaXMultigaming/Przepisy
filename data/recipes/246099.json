  "ingredients": [
    "2.5 cups pasta sauce",
    "6 tablespoons CRACKER BARREL Finely Shredded 100% Parmesan Cheese",
    "6 small boneless skinless chicken breasts",
    "330 grams spaghetti, uncooked",
    "1.5 cups CRACKER BARREL Shredded Mozzarella Cheese"
  ],
  "steps": [
    {
      "text": "Heat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sauce into 13x9-inch baking dish sprayed with cooking spray. Stir in 1/4 cup (4 Tbsp.) Parmesan. Add chicken; turn to evenly coat both sides of each breast with sauce. Cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 30 minutes or until chicken is done (165 degrees F). Meanwhile, cook spaghetti as directed on package, omitting salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top chicken with remaining cheeses; bake, uncovered, 5 minutes or until mozzarella is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain spaghetti. Serve topped with chicken and sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
