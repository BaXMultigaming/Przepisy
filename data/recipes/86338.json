  "steps": [
    {
      "text": "Place couscous in a bowl and pour boiling water over top. Gently stir, then cover and let sit for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place cranberries in a glass liquid measure and add water to cover. Microwave on high for 1 minute; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cranberries to the couscous, along with almonds, apricots, scallions, cumin, salt, and pepper. Toss well to combine. Serve at room temperature or chilled.",
      "section": null,
