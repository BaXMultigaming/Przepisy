  "ingredients": [
    "1.3333333730698 cups dry couscous",
    "2 cups boiling water",
    "0.66666668653488 cup sweetened dried cranberries",
    "0.66666668653488 cup slivered almonds",
    "0.5 cup packed dried apricots, chopped",
