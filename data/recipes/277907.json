  "ingredients": [
    "2 tablespoons brown sugar",
    "1 tablespoon smoked paprika",
    "1 teaspoon ground mustard",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon ground cayenne pepper",
    "1 (1 1/2 pound) pork tenderloin, trimmed",
    "1 tablespoon olive oil",
    "4 cups chopped broccoli florets",
    "1 tablespoon olive oil",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine brown sugar, paprika, ground mustard, 1 teaspoon salt, ½ teaspoon black pepper, garlic powder, and cayenne pepper in a small bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush pork tenderloin with 1 tablespoon olive oil to coat; rub spice mixture on all sides of tenderloin and let sit for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully place tenderloin in air fryer basket; cook in the preheated air fryer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place broccoli in a microwave-safe bowl. Microwave on high until tender, about 3 minutes. Stir in 1 tablespoon olive oil; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer tenderloin to a cutting board; rest before slicing, 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place broccoli in air fryer basket. Cook in the air fryer 10 minutes, shaking basket halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
