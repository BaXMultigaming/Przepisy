  "title": "Sourdough Banana Nut Bread",
  "description": "Sourdough starter is an amazing addition to this banana bread studded with pecans, almonds, and dried cranberries.",
  "authors": [
    "Mrs CJR"
  ],
  "date_published": "2020-06-19T00:36:02-04:00",
