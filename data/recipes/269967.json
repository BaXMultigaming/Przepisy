      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AMI-F-r-xGZ9oC5JMc-zsMmeJtg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269967-simple-air-fryer-brussels-sprouts-Step-02-1-a159e59d58074dc99a405ff5aff4a804.jpg"
      ],
      "image": "assets/images/269967/step_02.webp"
    },
    {
      "text": "Spread sprouts evenly in the air fryer basket.",
