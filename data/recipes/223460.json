  "ingredients": [
    "9 large potatoes",
    "1 (8 ounce) package cream cheese",
    "1 cup sour cream",
    "0.25 cup minced green onions",
    "2 tablespoons butter",
    "salt and ground black pepper, to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 1 1/2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash potatoes in the pot with a potato masher or fork until smooth. Stir in cream cheese, sour cream, green onions, butter, salt, and black pepper. Transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and bubbly, about 1 hour 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
