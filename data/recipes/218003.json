  "ingredients": [
    "2 pints ripe strawberries, hulled and chopped",
    "2 tablespoons white sugar",
    "1 cup sweetened condensed milk",
    "5 prepared strawberry shortcake cups",
    "1 cup whipping cream, whipped"
