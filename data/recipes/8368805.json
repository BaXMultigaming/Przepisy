  "ingredients": [
    "0.25 cup olive oil",
    "1.5 cups medium-grain white rice",
    "2 teaspoons large-grain kosher salt",
    "0.25 teaspoon freshly ground black pepper",
    "1 pinch cayenne pepper, or to taste",
    "1 bunch green onions, thinly sliced",
    "0.5 cup packed finely chopped fresh dill",
    "0.5 cup packed finely chopped fresh mint leaves",
    "1 pound frozen chopped spinach, thawed and squeezed dry",
    "2.75 cups cold water, or more as needed",
    "kosher salt to taste",
    "3 medium lemons, cut in half",
    "0.75 cup crumbled feta cheese",
    "2 tablespoons pickled red onions, or to taste",
    "1 pinch hot chili flakes, or to taste",
    "1 drizzle olive oil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JRxfsWGynokN_KwOlcroH-4qfTQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8368805-greek-spinach-rice-spanakorizo-VAT-step-01-28e001943e2340ddb129d419c461e4a8.jpg"
      ],
      "image": "assets/images/8368805/step_01.webp"
    },
    {
      "text": "Heat oil in a saucepan over medium-high heat. Add rice and stir until every grain is coated in oil and you hear it start to sizzle. Stir in 2 teaspoons large-grain kosher salt, pepper, cayenne, and green onions and cook for about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Wqz8MG4JkOreez5GkC3-RAXqHXo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8368805-greek-spinach-rice-spanakorizo-VAT-step-02-bb21ca4cd2344986a601872116bfea31.jpg"
      ],
      "image": "assets/images/8368805/step_02.webp"
    },
    {
      "text": "Add dill, mint, spinach, and 2 3/4 cups water. Mix until thoroughly combined and bring to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pyPkfEvLZJmRmy0BuPHwbQOaDdw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8368805-greek-spinach-rice-spanakorizo-VAT-step-03-e8fd7c93d140486a812cc089f8b48ca9.jpg"
      ],
      "image": "assets/images/8368805/step_03.webp"
    },
    {
      "text": "Cover, reduce heat to medium-low, and cook until rice is tender, about 25 minutes. If rice is not quite ready at 25 minutes, add a splash of water, cover, and continue to cook until it is ready.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lZZtoNNwSiwc8DuWl8Oqm4muNMo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8368805-greek-spinach-rice-spanakorizo-VAT-step-04-9a864046cf704a6fb8d422fa1534dc0b.jpg"
      ],
      "image": "assets/images/8368805/step_04.webp"
    },
    {
      "text": "Uncover and stir well. Cover again and let sit for 5 minutes. Taste and adjust salt if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xTxdxn54jX604SCwTeJW_s3MdjQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8368805-greek-spinach-rice-spanakorizo-VAT-step-05-e01f42999ea643adabf513ac3104a97b.jpg"
      ],
      "image": "assets/images/8368805/step_05.webp"
    },
    {
      "text": "Divide rice mixture evenly into six bowls. Squeeze ½ lemon over each serving, then top with feta cheese, pickled onions, chili flakes, and a drizzle of olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wV4aILnG0oWv6HJCAWAKk109N5U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8368805-greek-spinach-rice-spanakorizo-VAT-4x3-01fc8817f6c447ecab1cbdb575838a29.jpg"
      ],
