  "ingredients": [
    "2 (10.75 ounce) cans condensed cream of mushroom soup",
    "1 cup mayonnaise",
    "0.25 cup sour cream",
    "0.5 cup frozen corn kernels",
    "0.5 cup grated Parmesan cheese",
    "4 skinless, boneless chicken breast halves",
    "0.5 cup shredded Cheddar cheese",
    "1 cup seasoned dry bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "FOR THE SAUCE: In a medium size bowl combine the soup, mayonnaise, sour cream, corn and Parmesan cheese. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the chicken breasts in a 9x13 inch baking dish and pour the sauce mixture over the chicken. Sprinkle with Cheddar cheese and breadcrumbs for topping and bake in the preheated oven for 38 to 40 minutes. Let cool and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
