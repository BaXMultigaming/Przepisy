  "ingredients": [
    "1 (8 inch) flour tortilla",
    "2 ounces shredded Oaxaca cheese",
    "1 tablespoon Buffalo sauce",
    "1 tablespoon ranch dressing",
    "2 ounces chopped cooked chicken breast"
  ],
  "steps": [
    {
      "text": "Heat a skillet over medium-high heat. Place tortilla onto skillet and top with Oaxaca cheese. Drizzle on Buffalo sauce and ranch dressing. Place chicken one half of the tortilla and cook until cheese is melted, 2 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold the tortilla in half, enclosing the filling. Flip once in the pan, and cook until both sides are golden brown, about 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from skillet and cut quesadilla into 4 triangles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
