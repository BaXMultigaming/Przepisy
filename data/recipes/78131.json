  "title": "Erin's Indonesian Chicken",
  "description": "Chicken and green beans are served over rice with a spicy peanut sauce.",
  "authors": [
    "ERINPETERSON"
  ],
  "date_published": "2004-11-08T15:50:35-05:00",
