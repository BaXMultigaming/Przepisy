  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup sour cream",
    "0.25 cup mayonnaise",
    "1 cup cocktail sauce",
    "0.5 cup chopped green bell pepper",
    "3 green onions, chopped",
    "1 tomato, seeded and chopped",
    "1 cup cooked crabmeat",
    "1 cup cooked baby shrimp",
    "1 cup finely shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "In a medium bowl, blend cream cheese, sour cream and mayonnaise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the bottom of an approximately 12 inch round serving dish, spread the cream cheese mixture. Pour cocktail sauce evenly over the mixture. Layer with green bell pepper, green onions and tomato. Top with crabmeat and shrimp. Sprinkle with mozzarella.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and chill in the refrigerator at least 2 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
