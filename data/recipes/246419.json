  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 pound beef sirloin steak, cut into 1-inch cubes",
    "1 large onion, chopped",
    "2 medium carrots, chopped",
    "2 ribs celery, chopped",
    "3 cups hot water",
    "2.5 tablespoons dry brown gravy mix",
    "2 cubes beef bouillon",
    "0.25 cup Worcestershire sauce",
    "1 teaspoon chili powder",
    "0.25 teaspoon dried oregano",
    "8 medium potatoes, cubed",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a stockpot over medium heat. Add beef and cook until browned on all sides, 6 to 8 minutes. Stir in onion, carrots, and celery.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix water, gravy mix, and bouillon together in a small bowl; pour into the stockpot. Stir in Worcestershire sauce, chili powder, and oregano. Cover and simmer over low heat for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in potatoes. Cover and simmer until potatoes are easily pierced with a fork, about 30 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
