  "ingredients": [
    "cooking spray",
    "0.25 cup mashed banana",
    "0.25 cup honey",
    "0.5 teaspoon almond extract",
    "1.25 cups rolled oats",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "3 cups yogurt"
  ],
  "steps": [
    {
      "text": "Spray six muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir banana, honey, and almond extract together in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oats, cinnamon, and salt together in another bowl; add to banana mixture and stir until well combined. Press mixture into the base and up the sides of the prepared muffin cups. Refrigerate until chilled and firm, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove muffin cups from the refrigerator. Press oat mixture firmly into the base and sides of each cup again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and fragrant, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven; use a spoon to press the sides of granola into the muffin cups again. Let cool for 20 minutes, then remove from the muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon yogurt into each cup.",
      "section": null,
      "name": null,
      "url": null,
