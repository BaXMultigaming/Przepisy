  "ingredients": [
    "40 cherry tomatoes, halved",
    "1 cup pitted and sliced green olives",
    "1 (6 ounce) can black olives, drained and sliced",
    "2 green onions, minced",
    "3 ounces pine nuts",
    "0.5 cup olive oil",
    "2 tablespoons red wine vinegar",
    "1 tablespoon white sugar",
    "1 teaspoon dried oregano",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine cherry tomatoes, green olives, back olives, and green onions in a salad bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast pine nuts in a dry skillet over medium heat until golden brown, turning frequently. Stir into tomato mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, red wine vinegar, sugar, and oregano together in a small bowl; season to taste with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing over salad, and gently stir to coat tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
