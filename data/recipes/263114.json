  "ingredients": [
    "0.75 cup white sugar",
    "8 4-ounce Mason® jars with lids and rings",
    "1 (14 ounce) can sweetened condensed milk",
    "1 (12 fluid ounce) can evaporated milk",
    "3 eggs",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Place a sous vide cooker inside a large heat-proof container filled with water. Preheat the water bath to 179 degrees F (82 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt sugar in a small saucepan over medium heat until browned, about 5 minutes. Pour hot melted sugar into eight 4 ounce Mason jars, enough to cover the bottom of each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sweetened condensed milk, evaporated milk, eggs, and vanilla extract together in a separate bowl. Add to the jars; seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place jars in the water bath and set timer for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove jars from the water bath. Let flan cool until safe to handle, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unseal jars and run a small rubber spatula around the sides of the flan. Top each flan with a plate;invert and gently shake to release.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
