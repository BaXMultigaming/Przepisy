  "ingredients": [
    "2 cups heavy whipping cream",
    "1.25 pounds bittersweet chocolate"
  ],
  "steps": [
    {
      "text": "Chop the chocolate into small pieces and place it in a large stainless steel bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat cream in a large, high-sided saucepan over medium high heat, stirring frequently, until it just begins to boil. The cream can boil over quickly at this stage, so watch it closely. Immediately remove from heat and pour over chopped chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir until chocolate is completely melted and mixture is smooth. Cool completely and then store in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
