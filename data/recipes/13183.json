  "ingredients": [
    "1 (16 ounce) package smoked sausage",
    "6 slices bacon",
    "0.75 cup chopped onion",
    "1.5 teaspoons minced garlic",
    "1 quart water",
    "2 tablespoons chicken soup base",
    "2 potatoes, cut into 1/4-inch slices",
    "2 cups kale - washed, dried, and shredded",
    "0.33333334326744 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sausage links onto a sheet pan and bake for 25 minutes, or until done. Cut links in half lengthwise, then cut at an angle into 1/2-inch slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon and onion in a large saucepan and cook over medium heat until onion is almost clear. Remove bacon and crumble. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add garlic into the pan with onion and cook together, about 1 minute. Add water, chicken soup base, and potatoes, simmer 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add crumbled bacon, sausage, kale, and cream. Simmer, about 5 minutes, and serve.",
      "section": null,
      "name": null,
      "url": null,
