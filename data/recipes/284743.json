  "ingredients": [
    "2 bunches broccolini",
    "2 tablespoons olive oil",
    "2 tablespoons red wine vinegar",
    "1 teaspoon salt",
    "1 teaspoon garlic powder",
    "1 teaspoon dried oregano",
    "0.5 teaspoon crushed red pepper",
    "0.5 teaspoon ground black pepper",
    "0.25 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Trim about 1/4 inch off the bottoms of the broccolini and remove any leaves. Place broccolini into a large resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil, vinegar, salt, garlic powder, oregano, crushed red pepper, and black pepper in a small bowl. Pour over broccolini and gently toss to coat. Seal bag and let sit for 5 to 10 minutes, turning over halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread broccolini in a single layer on the prepared baking sheet and top with feta cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast for in the preheated oven until tops are browned and stems are crisp-tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
