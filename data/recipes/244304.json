  "ingredients": [
    "1 (40 ounce) package prepared cookie dough, divided",
    "2 (8 ounce) packages cream cheese, softened",
    "1 cup white sugar",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press 1/2 of the cookie dough into the bottom of prepared dish. Mix cream cheese, sugar, and eggs together in a bowl until smooth; spread over cookie dough in baking dish. Crumble remaining cookie dough over cream cheese layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set in the middle, 35 to 40 minutes.",
