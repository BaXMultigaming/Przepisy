  "ingredients": [
    "6 poblano peppers",
    "2 cups chicken broth",
    "salt and pepper to taste",
    "0.5 teaspoon ground nutmeg",
    "2 cups milk",
    "3 tablespoons margarine",
    "1 tablespoon all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place poblanos on a baking sheet and place in the oven. Allow skin to blacken and blister, turning chile peppers until all sides are done. Transfer them to a paper bag and seal for about 15 to 20 minutes. Remove from the bag and peel the skins off under running water. Remove stems and seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a blender, combine poblanos, broth, salt, pepper, and nutmeg. Blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small saucepan over medium heat, warm milk and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another saucepan over medium heat, melt butter or margarine, add flour and stir well. Add warmed milk and stir until well blended. Add poblano mixture and mix well. Reduce heat to low and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
