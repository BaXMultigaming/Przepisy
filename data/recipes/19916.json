  "ingredients": [
    "3 pounds chicken wings, separated at joints, tips discarded",
    "0.5 cup butter",
    "1 cup hot sauce",
    "0.5 teaspoon cayenne pepper",
    "0.25 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil the grill grate. Cook the wings 8 to 12 minutes on each side, until juices run clear. The larger pieces will take slightly longer to cook.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butter in a saucepan, and mix in the hot sauce, cayenne pepper, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place wings in a large container with a secure lid. Pour sauce over the wings, and seal. Shake wings with the sauce until thoroughly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
