  "ingredients": [
    "1 cup butter, room temperature",
    "1 cup white sugar",
    "2.5 tablespoons Earl Grey tea, finely ground in a coffee grinder",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "2 cups all-purpose flour",
    "0.66666668653488 cup unsweetened cocoa powder",
    "2 teaspoons baking powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together butter, sugar, and tea. Beat in vanilla, then eggs, one at a time until incorporated. Sift together flour, cocoa powder, and baking powder; fold into egg mixture until just mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop cookies by rounded tablespoonfuls onto a ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
