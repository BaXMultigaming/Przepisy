  "ingredients": [
    "2 cups mayonnaise",
    "2 tablespoons ground black pepper",
    "2 tablespoons salt",
    "6 tablespoons lemon juice",
    "6 tablespoons distilled white vinegar",
    "4 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "In a medium bowl, combine the mayonnaise, pepper, salt, lemon juice, vinegar and sugar. Mix all together until smooth. Use to baste chicken, pork chops or ribs as they cook on the grill. Serve extra as dipping sauce!",
