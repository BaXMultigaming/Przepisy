  "ingredients": [
    "1 large head broccoli, cut into florets",
    "2 cloves garlic, sliced",
    "1 tablespoon extra-virgin olive oil",
    "1 pinch onion powder, or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss together broccoli and garlic in a large bowl. Drizzle olive oil over broccoli; toss to coat. Spread broccoli and garlic onto a baking sheet; season with onion powder, salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 10 minutes. Turn and continue roasting until broccoli begins to char, about 10 minutes more.",
