  "ingredients": [
    "2 tablespoons olive oil",
    "0.5 teaspoon paprika",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon parsley flakes",
    "0.25 teaspoon salt",
    "0.13 teaspoon freshly ground black pepper",
    "2 small yellow squash, cut into 1/2-inch slices",
    "3 tablespoons shredded Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, paprika, garlic powder, parsley, salt, and pepper together in a large bowl until well combined. Add squash; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place squash in the basket of the air fryer in 2 batches, if necessary, so as not to overcrowd the air fryer; cook 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flip squash; sprinkle cheese over top. Cook until cheese melts and starts to brown, about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
