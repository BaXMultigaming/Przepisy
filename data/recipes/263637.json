  "ingredients": [
    "1 cup all-purpose flour",
    "0.25 cup wheat germ",
    "2 tablespoons soy flour",
    "1 tablespoon white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1.5 cups soy milk",
    "1 tablespoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Combine flour, wheat germ, soy flour, sugar, baking powder, and salt in a medium bowl. Add soy milk and oil and whisk until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a dry, nonstick pan over medium heat. Pour batter into 5-inch circles. Peek under pancakes when edges appear dry; flip when bottoms are golden brown, about 2 minutes. Flip and cook other side until golden brown, about 1 minute more. Repeat with remaining batter.",
