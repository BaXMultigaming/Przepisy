  "ingredients": [
    "3 cups red wine",
    "3 green onions, minced",
    "0.25 cup Worcestershire sauce",
    "2 tablespoons prepared Dijon-style mustard",
    "2 tablespoons fresh lemon juice",
    "2 tablespoons double-concentrated Italian tomato paste",
    "2 tablespoons chopped fresh oregano",
    "2 tablespoons chopped fresh basil",
    "2 tablespoons chopped fresh chives",
    "1 tablespoon balsamic vinegar",
    "1 tablespoon brandy-based orange liqueur (such as Grand Marnier®)",
    "1 tablespoon packed brown sugar",
    "1 tablespoon fine sea salt",
    "1 tablespoon ground black pepper",
    "1 tablespoon ground cumin",
    "1 tablespoon minced garlic",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon chopped horseradish",
    "1 tablespoon minced fresh dill"
  ],
  "steps": [
    {
      "text": "Whisk red wine, green onions, Worcestershire sauce, Dijon mustard, lemon juice, tomato paste, oregano, basil, chives, vinegar, orange liqueur, brown sugar, salt, black pepper, cumin, garlic, ginger, horseradish, and dill together in a large glass or ceramic bowl until combined.",
