  "ingredients": [
    "2.75 cups all-purpose flour",
    "1.75 cups white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "0.5 cup butter, melted",
    "2 cups fresh cranberries",
    "1 cup mandarin oranges, drained",
    "0.75 cup milk",
    "0.75 cup sour cream",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 teaspoon orange extract",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a large loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, 1 3/4 cups sugar, baking powder, salt, and baking soda together in a large bowl. Add melted butter; stir until mixture is crumbly. Reserve 1/4 cup each cranberries and mandarin oranges; stir remaining into flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk, sour cream, eggs, and extracts in a separate bowl until smooth; gradually stir into flour mixture until batter is thoroughly incorporated. Pour into prepared loaf pan. Scatter reserved 1/4 cup each cranberries and mandarin oranges on top of batter; sprinkle with remaining 1 tablespoon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 minutes; reduce heat to 350 degrees F (175 degrees C) and continue baking until center of bread springs back when touched, 35 to 40 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
