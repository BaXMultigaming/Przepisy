  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter or margarine",
    "4 eggs",
    "1 (20 ounce) can crushed pineapple, drained",
    "5 slices white bread, cubed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W5DFr3uMYpLtgYPCA4iSmRk6wD4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-18391-pineapple-stuffing-VAT-step-01-c7ecf6200c744033949700ce9900c42e.jpg"
      ],
      "image": "assets/images/18391/step_01.webp"
    },
    {
      "text": "Combine sugar and butter in a large bowl; beat with an electric mixer until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WUYH5L4AnQ10Ko5iO3yXR1TDFnE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-18391-pineapple-stuffing-VAT-step-02-c8b0832b88344e7ca333785a354fe8b5.jpg"
      ],
      "image": "assets/images/18391/step_02.webp"
    },
    {
      "text": "Beat in eggs one at a time, then stir in crushed pineapple and bread cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o-T0iB-QtPznxUH8Aa7jyyJFHZ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-18391-pineapple-stuffing-VAT-step-03-76bb1da6b14149bbae4031e1c146f2a0.jpg"
      ],
      "image": "assets/images/18391/step_03.webp"
    },
    {
      "text": "Transfer mixture into prepared baking dish. Bake in the preheated oven until golden brown on top, about 50 minutes to 1 hour. Let stuffing stand for a few minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
