  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.25 cup white sugar",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.125 teaspoon baking soda",
    "0.5 cup pitted and chopped dates",
    "1 cup buttermilk, at room temperature",
    "1 egg, at room temperature",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease or line 10 cups of a muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking powder, salt, and baking soda together in a bowl. Add dates, separating the pieces as you drop them into the flour mixture. Mix to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk buttermilk, egg, and butter together in a small bowl. Fold buttermilk mixture into flour mixture until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the largest muffin comes out clean, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
