  "ingredients": [
    "1 quart vegetable oil for frying",
    "4.333 cups all-purpose flour, divided",
    "1.5 tablespoons garlic salt",
    "1 tablespoon ground black pepper",
    "1 tablespoon paprika",
    "0.5 teaspoon poultry seasoning",
    "1.5 cups beer, or as needed",
    "2 egg yolks, beaten",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 (3 pound) whole chicken, cut into pieces"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5SYcOBML7ZT2MVYVhKPa6tArkog=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-89268-triple-dipped-fried-chicken-ingredients-4x3-1314f2c7b38f4118ad9f873dbe7cafcf.jpg"
      ],
      "image": "assets/images/89268/step_01.webp"
    },
    {
      "text": "Heat oil in a deep fryer to 350 degrees F (175 degrees C). Mix 3 cups flour, garlic salt, 1 tablespoon pepper, paprika, and poultry seasoning together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1EbHjFy4vIU6-xWpRkCXtc09FSs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-89268-triple-dipped-fried-chicken-step-1-4x3-f4aa41d289fa485dac2ed336a364cf52.jpg"
      ],
      "image": "assets/images/89268/step_02.webp"
    },
    {
      "text": "Stir 1 1/2 cups beer, remaining 1 1/3 cups flour, egg yolks, salt, and 1/4 teaspoon pepper together in a separate bowl; thin with more beer if batter is too thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w0BGtuBrdY_nQMjnXIwTzGlJTeQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-89268-triple-dipped-fried-chicken-step-2-4x3-ca5d2f0e1ff04bbc87a7dbd81bec35bf.jpg"
      ],
      "image": "assets/images/89268/step_03.webp"
    },
    {
      "text": "Moisten chicken pieces with a little water, then dip in seasoned flour mixture. Shake off excess and dip in beer batter, then dip in the seasoned flour mixture once more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XFDORsHhJ9TSjulKiwuidJ81Ym4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-89268-triple-dipped-fried-chicken-step-3-4x3-c29929f235df4f61bbc4c1e9fa68cd24.jpg"
      ],
      "image": "assets/images/89268/step_04.webp"
    },
    {
      "text": "Lower chicken pieces carefully into the hot oil in batches. Fry until crispy and well-browned, about 15 to 18 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uBT3ZvDT3BbmlE2MTtZjnWjAM4c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-89268-triple-dipped-fried-chicken-step-4-4x3-45ed989815214397a50ccb409f3e0934.jpg"
      ],
      "image": "assets/images/89268/step_05.webp"
    },
    {
      "text": "Transfer to a paper towel-lined plate to drain. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q-IfK20zxeyp1DgKWhrVp6CQ43w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-89268-triple-dipped-fried-chicken-beauty-4x3-3961ac838ddd41958e7cb9f49376cd68.jpg"
      ],
      "image": "assets/images/89268/step_06.webp"
    }
