  "ingredients": [
    "0.75 cup uncooked grits",
    "6 ounces garlic flavored processed cheese, cubed",
    "1 pinch cayenne pepper",
    "2 tablespoons butter",
    "2 tablespoons olive oil",
    "2 cloves garlic, minced",
    "1 tomato, diced",
    "2 pounds fresh shrimp, peeled and deveined",
    "0.5 lemon, juiced",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Cook grits according to package directions. Stir in cubed cheese and cayenne pepper. Keep warm over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter and olive oil in a large skillet over medium-high heat. Sauté garlic and tomato in hot butter-oil mixture until tomato begins to soften. Stir in shrimp and lemon juice. Sauté until shrimp are bright pink on the outside and the meat is opaque. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread warm grits on a serving platter and cover with shrimp mixture.",
      "section": null,
