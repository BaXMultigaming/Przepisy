  "ingredients": [
    "12 (4 inch) prepared tart shells, baked",
    "0.66666668653488 cup white sugar",
    "2.5 tablespoons cornstarch",
    "1 pinch salt",
    "1 cup apple juice",
    "3 cups fresh strawberries"
