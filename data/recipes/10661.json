  "ingredients": [
    "1 cup peanut butter",
    "0.5 cup packed brown sugar",
    "0.5 cup corn syrup",
    "0.33333298563957 cup butter",
    "2 teaspoons vanilla extract",
    "3.3333299160004 cups rolled oats",
    "0.5 cup flaked coconut",
    "0.5 cup sunflower seeds",
    "0.5 cup raisins",
    "0.5 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine peanut butter, brown sugar, corn syrup, butter, and vanilla together in a large bowl until smooth. Stir in oats, coconut, sunflower seeds, raisins, and chocolate chips; press mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 to 25 minutes; let cool on a wire rack before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
