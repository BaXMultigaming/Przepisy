  "ingredients": [
    "1 (12 ounce) package frozen edamame (soybeans) in their pods",
    "2 tablespoons extra-virgin olive oil",
    "2 cloves garlic, minced",
    "1 teaspoon sea salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss edamame, olive oil, garlic, sea salt, and black pepper together in a large bowl until well-coated. Spread in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven, stirring halfway through, until edamame shells start to brown, about 20 minutes. Serve whole, popping beans out of the shell to eat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
