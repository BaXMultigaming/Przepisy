  "title": "Braised Beef Cheeks",
  "description": "Beef cheeks are braised with red wine, onion, carrot, and porcini mushrooms in this gourmet one-pot meal full of rich, deep flavors.",
  "authors": [
    "Robert Smith"
  ],
  "date_published": "2016-06-10T00:56:24-04:00",
