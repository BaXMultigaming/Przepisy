  "ingredients": [
    "1.5 cups shredded coconut",
    "1 cup white sugar",
    "2 cups all-purpose flour",
    "2 eggs, room temperature",
    "0.5 cup milk, or more as needed",
    "0.25 cup simple syrup, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk coconut and sugar together in a bowl. Sift in flour and whisk to combine. Form a well in the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs together in a small bowl and pour into the well. Add enough milk to reach a slightly thickened but runny texture. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown on top and a toothpick inserted into the center comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool for 20 minutes. Pour simple syrup over cake before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
