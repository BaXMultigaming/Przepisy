  "title": "Finnish Pulla",
  "description": "This Finnish pulla is flavored with cardamom and braided before baking for an eye-catching holiday sweet bread great for breakfast or afternoon tea.",
  "authors": [
    "Kim B"
  ],
  "date_published": "1998-10-19T11:50:22-04:00",
  "date_modified": "2026-04-14T01:58:02-04:00",
  "prep_time": "PT30M",
