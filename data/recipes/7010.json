    "Breakfast"
  ],
  "cuisines": [
    "Finnish",
    "Scandinavian"
  ],
  "regions": [
    "Finnish",
    "Scandinavian"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 cups milk",
    "0.5 cup warm water (110 degrees F/45 degrees C)",
    "1 (.25 ounce) package active dry yeast",
    "1 cup white sugar",
    "4 large eggs, beaten",
    "1 teaspoon salt",
    "1 teaspoon ground cardamom",
    "9 cups all-purpose flour",
    "0.5 cup butter, melted",
    "1 large egg",
    "1 tablespoon water",
    "2 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Warm milk in a small saucepan over medium heat until it bubbles, then remove from heat. Let cool until lukewarm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lsX5vijE30GcajLPntnkMTTlEDQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7010-finnish-pulla-VAT-step-01-4ed7764cc982430fb6ba67fbe3f4c97c.jpg"
      ],
      "image": "assets/images/7010/step_01.webp"
    },
    {
      "text": "Stir together warm water and yeast in a large bowl. Let stand until yeast softens and begins to form a creamy foam, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tsENyxIxWpP0VPtixZCokqluCMQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7010-finnish-pulla-VAT-step-02-feefc595f87c4d88b71a06524d2645f9.jpg"
      ],
      "image": "assets/images/7010/step_02.webp"
    },
    {
      "text": "Stir lukewarm milk, sugar, 4 beaten eggs, salt, and cardamom into yeast mixture. Beat in 2 cups flour until combined. Add 3 cups flour and beat until dough is smooth and elastic. Add melted butter; beat until glossy. Mix in remaining flour until dough is stiff.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AUZWTr49g9qpxOePP3XPGRZJKm0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7010-finnish-pulla-VAT-step-03-29f048becdbb42f6a14627bb72d0cdd5.jpg"
      ],
      "image": "assets/images/7010/step_03.webp"
    },
    {
      "text": "Transfer dough to a floured surface, cover with an inverted mixing bowl, and let rest for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YG8_cOA1D0eEr-X-lQb5BBQAZr0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7010-finnish-pulla-VAT-step-04-87b5677fe6c8426cab9bfeaacb4eb9e4.jpg"
      ],
      "image": "assets/images/7010/step_04.webp"
    },
    {
      "text": "Knead dough until smooth and satiny, then place in a lightly greased mixing bowl and turn dough to coat. Cover with a dish towel; let rise in a warm place until doubled, about 1 hour. Punch down dough; let rise again until almost doubled, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QYwPQeJExlvP-3w8Zx074kvG8M8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7010-finnish-pulla-VAT-step-05-08e5abc748c54fd699843868da5d94fb.jpg"
      ],
      "image": "assets/images/7010/step_05.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dzyroz4zt5MZbUJacUkQ_7YP9ec=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7010-finnish-pulla-VAT-step-06-960ae4d5c2ea4a6eaa509c9052db2928.jpg"
      ],
      "image": "assets/images/7010/step_06.webp"
    },
    {
      "text": "Turn dough out again onto a floured surface and divide into 3 equal pieces. Divide each piece into thirds. Roll each piece into a 12- to 16-inch strip. Braid 3 strips into a loaf to get 3 large, braided loaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/72XUKHajo7Ngxx8DW2Xcj8U0y5E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7010-finnish-pulla-VAT-step-07-67adf0fa071e42b4833c829478359ab5.jpg"
      ],
      "image": "assets/images/7010/step_07.webp"
    },
    {
      "text": "Lift loaves onto the prepared baking sheets. Cover with a dish towel and let rise for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rXLLxe1U-8O4ZeYrDMgYIiJ5T10=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7010-finnish-pulla-VAT-step-08-f30f4772ae504e0381884ea105ea012b.jpg"
      ],
      "image": "assets/images/7010/step_08.webp"
    },
    {
      "text": "Beat together 1 egg and water in a small bowl. Brush over loaves and sprinkle with sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yx7MetMRNU0fJn2yTS1UqTBpSKs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7010-finnish-pulla-VAT-step-09-8e482122fb724a76a139cec0b36590cc.jpg"
      ],
      "image": "assets/images/7010/step_09.webp"
    },
    {
      "text": "Bake in the preheated oven until the top is golden brown, 25 to 30 minutes. Check occasionally because the bottoms of loaves can burn quickly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RCC01IiVEt0sfpIbO9IXs7e5Fxg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7010-finnish-pulla-VAT-step-10-28c70d887ed94679a9979f834ac2b82f.jpg"
      ],
      "image": "assets/images/7010/step_10.webp"
    }
  ],
