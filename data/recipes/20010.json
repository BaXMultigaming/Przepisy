  "ingredients": [
    "0.5 cup white sugar",
    "1 tablespoon cornstarch",
    "0.125 teaspoon salt",
    "0.25 teaspoon freshly grated nutmeg",
    "1 cup boiling water",
    "1 tablespoon butter",
    "1 teaspoon grated lemon zest",
    "1 lemon, juiced"
  ],
  "steps": [
