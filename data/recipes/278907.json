  "ingredients": [
    "3 eggs",
    "1 cup monk fruit sugar substitute",
    "0.66666668653488 cup olive oil",
    "2 medium oranges, zested and juiced",
    "1 teaspoon vanilla extract",
    "2.25 cups oat flour",
    "2 teaspoons baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl and mix in monk fruit sweetener and olive oil. Stir in orange zest, orange juice, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and baking powder in another bowl; stir into the egg mixture until just blended. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center of the cake comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
