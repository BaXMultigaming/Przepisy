  "ingredients": [
    "1.5 pounds ground beef",
    "1 small onion, chopped",
    "1 (27 ounce) can sauerkraut, drained",
    "2 cups tomato juice",
    "1 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat, and stir in the ground beef and onion. Cook until the beef is crumbly, evenly browned, and no longer pink. Drain, and discard any excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the beef mixture into a 3-quart casserole dish. Layer the sauerkraut over the ground beef, pour the tomato juice over the sauerkraut, then sprinkle with brown sugar. Bake in the preheated oven until the sauce is bubbly, about 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
