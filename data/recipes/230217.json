  "ingredients": [
    "4 cups chopped fresh broccoli",
    "1 (10.75 ounce) can cream of mushroom soup",
    "1 cup shredded Cheddar cheese",
    "0.25 cup mayonnaise",
    "2 cups dry bread crumbs",
    "0.5 cup melted butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put broccoli in a large microwave-safe bowl with a small amount of water in the bottom; cook in microwave until tender, about 5 minutes. Drain liquid from bowl. Stir mushroom soup, Cheddar cheese, and mayonnaise with the broccoli until evenly mixed; pour into prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs and melted butter together in a separate bowl; spread evenly over the broccoli mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the surface is bubbling, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
