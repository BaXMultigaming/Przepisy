  "ingredients": [
    "0.5 cup shortening",
    "1 cup white sugar",
    "1 cup solid-pack pumpkin (such as Libby's®)",
    "2 eggs, beaten",
    "2 cups sifted all-purpose flour",
    "4 teaspoons baking powder",
    "2.5 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground ginger",
    "1 cup raisins",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat shortening with an electric mixer until creamy; add sugar gradually. Beat until light and fluffy. Add pumpkin and eggs; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, cinnamon, salt, nutmeg, and ginger together. Stir into the pumpkin mixture until blended. Add raisins and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop teaspoonfuls of cookie dough onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are firm and starting to brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
