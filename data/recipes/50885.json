  "ingredients": [
    "1 cup pumpkin puree",
    "1 cup all-purpose flour",
    "1 large egg, lightly beaten",
    "1 teaspoon baking powder",
    "1 teaspoon curry powder",
    "1 teaspoon salt",
    "4 cups vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Combine pumpkin, flour, egg, baking powder, curry powder, and salt in a large bowl. Mix until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep saucepan to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, drop batter by spoonfuls into hot oil. Fry until golden brown all over, about 2 minutes. Remove to a paper towel-lined plate using a slotted spoon. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
