  "ingredients": [
    "4 cups halved cherry tomatoes",
    "1 tablespoon olive oil",
    "1 tablespoon Italian seasoning",
    "1 teaspoon onion powder",
    "1 teaspoon garlic powder",
    "1 teaspoon dried rosemary",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Toss tomatoes in a bowl with olive oil, Italian seasoning, onion powder, garlic powder, rosemary, salt, and pepper. Place seasoned tomatoes into the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the basket into the air fryer and select the Dehydrate setting at 190 degrees F (88 degrees C). Cook, gently shaking the bowl every hour to keep tomatoes from sticking, until dry, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
