  "ingredients": [
    "1.5 cups packed brown sugar",
    "1 cup chopped pecans",
    "0.5 cup unsalted butter, softened",
    "1 (16 ounce) loaf day-old French bread, cut into 3/4-inch cubes",
    "2.5 cups milk",
    "1 cup half-and-half",
    "4 large eggs, lightly beaten",
    "0.5 cup white sugar",
    "1 tablespoon vanilla extract",
    "0.125 teaspoon salt",
    "butter-flavored nonstick cooking spray"
  ],
  "steps": [
    {
      "text": "Combine brown sugar, pecans, and softened butter in a small bowl; mash together with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread cubes in a large bowl. Beat milk, half-and-half, eggs, sugar, vanilla, and salt in another bowl. Pour over the bread and let sit for liquid to absorb, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a slow cooker with nonstick spray. Pour 1/2 of the bread mixture into the prepared slow cooker and top with 1/2 of the pecan mixture. Repeat layers once more, then press down slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until a knife inserted in the center comes out clean, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
