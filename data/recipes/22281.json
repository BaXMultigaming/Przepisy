  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.25 cup unsweetened cocoa powder",
    "0.5 teaspoon salt",
    "1 cup white sugar",
    "0.33333334326744 cup vegetable oil",
    "1 cup water",
    "1 tablespoon vinegar",
    "1 teaspoon vanilla extract",
    "1 (8 ounce) package cream cheese, softened",
    "1 egg",
    "0.33333334326744 cup white sugar",
    "0.125 teaspoon salt",
    "1 cup miniature semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line two 12 cup muffin pans with paper liners. Sift together the flour, baking soda, cocoa powder and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk together 1 cup sugar, oil and water until blended. Stir in the vinegar and vanilla. Beat in the flour mixture until incorporated. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat together the cream cheese, egg, 1/3 cup sugar and salt. Stir in the chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill muffin cups 1/3 full with chocolate batter, then top with a heaping tablespoon of the cream cheese mixture. Bake in the preheated oven until the tops spring back when lightly pressed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
