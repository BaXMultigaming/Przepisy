  "ingredients": [
    "1 (9 inch) pie shell",
    "1 egg",
    "6 packets granulated artificial sweetener",
    "1 teaspoon pumpkin pie spice",
    "1 cup pumpkin puree",
    "1 cup evaporated milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg, sugar substitute, and pumpkin pie spice in a medium bowl until well blended. Add pumpkin and milk to egg mixture; stir until smooth. Pour mixture into prepared pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pie on a baking sheet and bake in the preheated oven until center is set but still slightly jiggly, about 30 to 35 minutes. Remove from oven and cool completely on a wire rack before slicing.",
      "section": null,
      "name": null,
      "url": null,
