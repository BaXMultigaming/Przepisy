  "ingredients": [
    "1 pound fresh asparagus, trimmed",
    "1 cup half-and-half",
    "2 teaspoons cornstarch",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon ground mustard",
    "0.25 teaspoon red pepper flakes",
    "1 cup shredded mozzarella cheese",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange asparagus spears in a shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together half-and-half, cornstarch, Italian seasoning, ground mustard, red pepper flakes, mozzarella cheese, and Parmesan cheese. Pour mixture over asparagus and swirl the dish so that liquid coats the bottom of the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until asparagus is soft and cheese sauce starts to bubble, about 15 minutes. Remove from oven and let sit for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
