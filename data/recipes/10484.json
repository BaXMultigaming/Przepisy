  "ingredients": [
    "0.25 cup butter, softened",
    "0.5 cup white sugar",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.5 cup arrowroot flour",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease baking sheets or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar just until smooth. Beat in egg and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, arrowroot flour, baking powder, and salt. Add to butter mixture and mix well. Divide dough in half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a lightly floured surface, roll half the dough out 1/8 inch thick. Cut into 2 1/2-inch rounds. Transfer rounds to prepared baking sheet; prick with fork. Repeat with remaining dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until edges are golden brown, 8 to 10 minutes. Allow a bit more baking time if rolled thicker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
