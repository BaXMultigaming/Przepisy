  "title": "Seafood Gumbo Stock",
  "description": "Roasted shrimp shells are simmered all day in water seasoned with whole cloves, bay leaf, garlic, and vegetables in this seafood stock recipe to use as a base for gumbos.",
  "authors": [
    "sara"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
