  "ingredients": [
    "2 tablespoons pure maple syrup",
    "0.25 cup dark brown sugar",
    "1 tablespoon Dijon mustard",
    "0.5 teaspoon salt",
    "0.25 teaspoon cayenne pepper",
    "1 (14 ounce) package Hillshire Farm Lit'l Smokies® Smoked Sausage",
    "0.5 cup salted pistachios, chopped"
  ],
  "steps": [
    {
      "text": "Combine maple syrup, brown sugar, mustard, salt and cayenne in a non-stick skillet over medium-high heat. Add Lit'l Smokies smoked sausages and bring to a simmer. Heat, stirring occasionally, until sauce is reduced and almost gone, about 15 minutes. Sauce will be thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove smoked sausages on to a parchment-lined baking sheet and when cool enough to handle, dip in pistachios. Serve warm.",
