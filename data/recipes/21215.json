  "ingredients": [
    "0.25 cup butter, melted and cooled",
    "1 teaspoon cayenne pepper",
    "1 teaspoon freshly ground black pepper",
    "1 teaspoon lemon-pepper seasoning",
    "1 teaspoon garlic powder",
    "1 teaspoon salt",
    "4 (4 ounce) fillets red drum",
    "1.25 cups Italian-style salad dressing"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i3OgoCp-xoXTWxCeCUXSyqP1_E0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21215-cajun-blackened-redfish-step-01-db24f829190840adb4374990b8843350.jpg"
      ],
      "image": "assets/images/21215/step_01.webp"
    },
    {
      "text": "Place melted butter in a shallow bowl. Mix cayenne pepper, black pepper, lemon-pepper seasoning, garlic powder, and salt together in a small bowl. Dip fillets into butter, then sprinkle with seasoning mixture on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7uQWN9RG0FmubLMOO8vDkc-YDI4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21215-cajun-blackened-redfish-step-04-6f34ecbc15484a3a98f1e01724c4481b.jpg"
      ],
      "image": "assets/images/21215/step_02.webp"
    },
    {
      "text": "Heat a large skillet over high heat. Add fish and sear until slightly charred, about 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wrzGtzh-8PUzdy0ERUlgNCsygCQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21215-cajun-blackened-redfish-step-05-171c7eb6b8814950a28f500551877098.jpg"
      ],
      "image": "assets/images/21215/step_03.webp"
    },
    {
      "text": "Transfer fillets to an 11x7-inch baking dish and pour Italian dressing over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eddysT4LE8C7TV_9757wLgoXLq0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21215-cajun-blackened-redfish-step-06-5d9157af0fc64c6e95e271b4d9734bb9.jpg"
      ],
      "image": "assets/images/21215/step_04.webp"
    },
    {
      "text": "Cover and bake in the preheated oven until fish flakes easily with a fork, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OQGj315ZHjSuRRtuU-nrfHRvau8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21215-cajun-blackened-redfish-step-07-1c447ce37e98425d9fed5c4eb22070ed.jpg"
