  "ingredients": [
    "6 medium apples - peeled, cored, and diced small",
    "6 tablespoons all-purpose flour",
    "0.25 cup dark brown sugar",
    "0.25 cup water",
    "0.25 cup cold salted butter, cut into small pieces",
    "3 tablespoons white sugar",
    "2 tablespoons ground cinnamon",
    "1 (8 ounce) package refrigerated crescent rolls",
    "2 tablespoons caramel sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apples, flour, brown sugar, water, butter, white sugar, and cinnamon in a bowl; mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate dough into 8 triangles. Scoop 1 tablespoon apple mixture into center of each triangle; fold into a package, sealing ends. Transfer to the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 15 to 18 minutes. Remove from the oven and let cool for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle caramel sauce over each turnover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
