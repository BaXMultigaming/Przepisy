  ],
  "steps": [
    {
      "text": "Coat an 8x10-inch pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over low heat. Gently stir in marshmallows until melted and butter and marshmallows are blended. Off heat, stir in cereal until completely coated with melted marshmallow mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread mixture into the prepared pan. Refrigerate until set, 1 hour, then cut into bars.",
