  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill jalapeños with cream cheese; sprinkle with Cajun seasoning. Wrap each stuffed jalapeño with 1 halved strip bacon; secure with a toothpick. Arrange wrapped jalapeños in a single layer, stuffed-sides down, on a broiler pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until bacon is crisp, 8 to 15 minutes per side.",
