  "ingredients": [
    "1 (3 ounce) package ramen noodles, crushed",
    "10 ounces cashew pieces",
    "1 (16 ounce) package shredded coleslaw mix",
    "1 bunch green onions, chopped",
    "0.5 cup white sugar",
    "0.5 cup vegetable oil",
    "0.25 cup cider vinegar",
    "1 tablespoon soy sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degree F oven (175 degree C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place crushed ramen noodles and cashew pieces on a baking sheet. Bake in the preheated oven until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine coleslaw, green onions, ramen noodles, and cashews in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, oil, vinegar and soy sauce together in a bowl. Pour vinaigrette over coleslaw mixture; toss and serve.",
      "section": null,
