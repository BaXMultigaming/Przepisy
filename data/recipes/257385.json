  "ingredients": [
    "2 cups water",
    "1 pound mung bean sprouts",
    "1 baby carrot, cut into matchsticks",
    "1 green onion, cut into 1-inch pieces",
    "1 teaspoon sesame oil",
    "1 teaspoon crushed garlic",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon sesame seeds"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a saucepan. Add mung beans; cook until tender, about 5 minutes. Drain. Rinse under cool running water to stop the cooking process. Drain well; transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine baby carrot and green onion in a small microwave-safe bowl. Cover with water and place in the microwave for 30 seconds. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir baby carrot and green onion into the bean sprouts in the bowl. Add sesame oil, garlic, salt, pepper, and sesame seeds; mix by hand until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
