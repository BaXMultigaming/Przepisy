  "ingredients": [
    "1 pound ground chicken (preferably dark meat)",
    "0.5 cup plain dry bread crumbs",
    "1 large egg",
    "3 tablespoons peeled and minced fresh ginger",
    "0.33333334326744 cup minced scallions",
    "2 teaspoons soy sauce",
    "2 teaspoons toasted sesame oil",
    "2 cloves garlic, minced",
    "0.25 teaspoon kosher salt",
    "1 tablespoon canola oil, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground chicken, bread crumbs, egg, ginger, minced scallions, soy sauce, sesame oil, garlic, and kosher salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form the mixture into 1 1/2-inch balls and arrange on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush the meatballs with canola oil. Bake in the preheated oven until browned and no longer pink in the center, about 13 minutes. Transfer to a platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
