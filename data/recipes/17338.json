  "ingredients": [
    "1 teaspoon chili powder",
    "0.125 teaspoon dried oregano",
    "1 pinch onion powder",
    "cayenne pepper to taste",
    "garlic powder to taste",
    "salt and pepper to taste",
    "0.5 cup butter, softened",
    "6 ears corn, husked and cleaned"
  ],
  "steps": [
    {
      "text": "Preheat the grill for medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chili powder, oregano, onion powder, cayenne pepper, garlic powder, salt, and pepper in a medium bowl; blend in softened butter. Spread butter mixture on each ear of corn, and place each one onto a piece of aluminum foil big enough to wrap like a burrito, twisting the ends to close.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place wrapped corn on the preheated grill, and cook until tender when poked with a fork, about 20 to 30 minutes. Turn corn occasionally during cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
