  "ingredients": [
    "0.75 cup peanut butter",
    "0.33333334326744 cup shortening",
    "0.66666668653488 cup white sugar",
    "1 cup mashed very ripe banana",
    "2 eggs",
    "1.75 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "0.25 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 4x8-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat peanut butter and shortening in a bowl. Gradually add sugar, beating until light and fluffy. Beat one egg into peanut butter mixture until completely blended before beating in the second egg. Stir in mashed banana.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, salt, and baking soda in a bowl. Stir flour mixture into banana mixture alternately with buttermilk, mixing until batter is just blended. Pour batter into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
