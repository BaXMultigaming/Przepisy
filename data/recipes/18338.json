  "ingredients": [
    "2 (16 ounce) packages frozen corn kernels",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup butter, melted",
    "1 clove garlic, pressed",
    "1 teaspoon white sugar",
    "0.5 teaspoon dried parsley",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook corn according to package directions. Drain; transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream cheese, melted butter, garlic, sugar, parsley, and salt into corn until well combined; transfer to a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned on top, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
