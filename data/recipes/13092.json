  "ingredients": [
    "1.5 pounds lean ground beef",
    "1 onion, finely diced",
    "0.25 cup chopped green bell pepper",
    "1 (15 ounce) can tomato sauce",
    "6 ounces tomato paste",
    "1 (16 ounce) can chili beans, drained",
    "1 tablespoon chili powder",
    "1 teaspoon hot pepper sauce",
    "0.5 teaspoon seasoning salt",
    "0.5 teaspoon ground cayenne pepper",
    "0.25 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Place ground beef in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain excess fat, and crumble. Stir in onion, green pepper, tomato sauce, tomato paste, and chili beans. Season with chili powder, hot sauce, seasoning salt, cayenne pepper, and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook over low heat, stirring occasionally, until desired consistency (at least 1 hour for best flavor).",
