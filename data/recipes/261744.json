  "ingredients": [
    "1.5 cups soy milk",
    "2 tablespoons all-purpose flour",
    "1 teaspoon white sugar",
    "1 teaspoon ground cinnamon",
    "1 tablespoon vegetable oil",
    "4 slices bread, or more as needed"
  ],
  "steps": [
    {
      "text": "Whisk soy milk, flour, sugar, and cinnamon together in a bowl until well beaten. Pour into a pie pan or other wide, shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each slice of bread into the soy milk mixture and place into the skillet. Cook until golden brown and crispy on both sides, 5 to 7 minutes.",
