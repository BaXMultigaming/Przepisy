  "ingredients": [
    "3 bunches rainbow chard, trimmed and rinsed",
    "6 tablespoons olive oil",
    "6 cloves garlic, sliced, or to taste",
    "1 pinch crushed red pepper flakes",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Separate the stems of the chard from the leaves; cut leaves into thin strips and set aside. Thinly slice the stems.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6XtSdS8h-WYUUWNIQARSRqFYeIE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218594-Lemon-Garlic-Rainbow-Chard-ddmfs-step-2-227-31a2e9029f6e460080a427d24831b63d.jpg"
      ],
      "image": "assets/images/218594/step_01.webp"
    },
    {
      "text": "Heat olive oil in a large skillet or pot over medium heat. Stir in garlic, red pepper flakes, and chard stems; cook and stir for 3 minutes until garlic mellows and stems begin to soften.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l-YHBb8e5Ygj2Gol_J9E2IPuQAI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218594-Lemon-Garlic-Rainbow-Chard-ddmfs-step-3-231-cd48c97477ce4e23b017ff178e4fce74.jpg"
      ],
      "image": "assets/images/218594/step_02.webp"
    },
    {
      "text": "Stir in shredded chard leaves, cover, and cook 5 minutes over medium-low heat. Stir, re-cover, and continue cooking until chard is tender. Toss with lemon juice to serve.",
      "section": null,
      "name": null,
      "url": null,
