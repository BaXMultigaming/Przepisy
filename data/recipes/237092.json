  "ingredients": [
    "0.5 teaspoon butter",
    "3 Brussels sprouts, trimmed, halved lengthwise, and thinly sliced",
    "2.5 teaspoons chopped dried apricots",
    "1 teaspoon water",
    "0.75 teaspoon maple syrup",
    "1 teaspoon lime juice"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium-high heat. Add sprouts and apricots to the skillet. Drizzle water over the sprouts mixture. Pour syrup over the the mixture. Saute sprouts mixture until sprouts are wilted, 5 to 10 minutes.",
