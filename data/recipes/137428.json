  "ingredients": [
    "cooking spray",
    "3 strips bacon",
    "6 large mushrooms",
    "1 tablespoon butter",
    "0.5 onion, diced",
    "1 clove garlic, sliced",
    "0.33333334326744 cup bread crumbs",
    "3 ounces blue cheese",
    "3 ounces cream cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a small baking dish with cooking spray; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon strips in a large skillet over medium heat until crispy. Drain on paper towels; leave drippings in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove stems from mushrooms; chop stems and set caps aside. Heat butter with drippings in the skillet until melted; stir in mushroom stems, onion, and garlic. Cook, stirring frequently, until onion caramelizes, 15 to 20 minutes; transfer to a blender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add bacon, bread crumbs, blue cheese, and cream cheese to the blender; pulse until combined. Stuff cheese mixture into mushroom caps; place in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and lightly browned, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
