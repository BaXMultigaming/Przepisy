  "ingredients": [
    "3 cups peeled and chopped apples",
    "1 (12 ounce) package fresh cranberries",
    "2 cups chopped pecans, divided",
    "1.5 cups white sugar, divided",
    "0.75 cup butter, melted, divided",
    "1 cup quick-cooking oats"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix apples, cranberries, 1 cup pecans, 1 cup sugar, and 1/2 cup butter together in a bowl; divide between two 8x8-inch baking dishes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir 1 cup pecans, oats, 1/2 cup sugar, and 1/4 cup butter together in a bowl; sprinkle over each cranberry mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling and topping is lightly browned, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
