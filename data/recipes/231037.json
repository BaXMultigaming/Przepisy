  "ingredients": [
    "1 pound dried pinto beans, rinsed",
    "4 cups water, or as needed",
    "2 (10 ounce) cans diced tomatoes with green chile peppers (such as RO*TEL®)",
    "0.5 pound bacon, cut into 1/2-inch pieces",
    "1 yellow onion, chopped",
    "1 tablespoon chili powder, or to taste",
    "1 tablespoon ground cumin, or to taste",
    "1.5 teaspoons garlic powder, or to taste",
    "0.5 bunch fresh cilantro, chopped",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pZ_SPiXYC_yf_bZlVRDoluTsfrU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231037-Pinto-beans-with-mexiacn-style-seasoning-Step1-2d5997d5bb39457b929cc83aca22a419.jpg"
      ],
      "image": "assets/images/231037/step_01.webp"
    },
    {
      "text": "Place pinto beans into a large pot and pour in enough water to cover by 2 to 3 inches. Let beans soak overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1JqDgauKd90Diu3Q-xHEztvfzw0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231037-Pinto-beans-with-mexican-style-seasoning-Step2-a11c19aa31bb4f479e9b50f8c14ad203.jpg"
      ],
      "image": "assets/images/231037/step_02.webp"
    },
    {
      "text": "Drain beans, return to pot, and pour in fresh water to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xYfsNFiDcR41U1cMPVtBSi55SZ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231037-Pinto-beans-with-mexican-style-seasoning-Step3-bb60df5565834119bbf5ba92984a58a6.jpg"
      ],
      "image": "assets/images/231037/step_03.webp"
    },
    {
      "text": "Add tomatoes, bacon, onion, chili powder, cumin, and garlic powder. Bring to a boil, reduce heat to low, and simmer for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TxCg_eJp2lj120UblK6ykhMcfeg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231037-Pinto-beans-with-mexican-style-seasoning-Step4-836047e8a2ff4390ab90a583c9c7654e.jpg"
      ],
      "image": "assets/images/231037/step_04.webp"
    },
    {
      "text": "Check the beans occasionally and add more water if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YMohzX8GzRJ4wxZpdkIK7r9Yly0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231037-Pinto-beans-with-mexican-style-seasoning-Step5-1ac93ba494f94d97b0b1184513c88bcc.jpg"
      ],
      "image": "assets/images/231037/step_05.webp"
    },
    {
      "text": "Stir cilantro and salt into beans simmer until beans are soft, about 1 more hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eVo3CZym6mFsogizXn8GTZzvoUo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231037-Pinto-beans-with-mexican-style-seasoning-Step6-a597aca623d44a4eadfc9b685131c712.jpg"
      ],
      "image": "assets/images/231037/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
