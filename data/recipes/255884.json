  "ingredients": [
    "0.25 cup granulated sugar",
    "1.75 cups all-purpose flour",
    "0.75 cup Quaker® Oats (Quick or Old Fashioned, uncooked)",
    "4 teaspoons baking powder",
    "1 teaspoon ground ginger",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.125 teaspoon ground cloves",
    "0.33333334326744 cup chilled margarine",
    "0.33333334326744 cup low-fat milk",
    "2 egg whites, slightly beaten",
    "2 tablespoons molasses",
    "0.75 cup ricotta cheese",
    "2 tablespoons frozen lemonade concentrate, thawed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine sugar,flour, oatmeal, baking powder, ginger, cinnamon, & nutmeg. Stir in margarine until crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine milk, egg whites and molasses. Add to dry ingredients and mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add dough onto a floured surface; knead gently up to 10 times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flatten dough to about 3/4-inch thickness. Cut with round biscuit cutter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place on ungreased cookie sheet. Sprinkle tops of scones with reserved 1 teaspoon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 9 to 11 minutes or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While cooking, begin making the Lemon Breakfast Cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cheese and lemonade concentrate into blender or food processor and blend until smooth. Serve on top of warm scones and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
