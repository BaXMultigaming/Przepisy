  "title": "California Sherry Chicken",
  "description": "Chicken simmered in a fine sherry, lemon, and garlic broth is presented with julienne cut carrots and zucchini for a delicious and beautiful dish.",
  "authors": [
    "Nikki"
  ],
  "date_published": "2000-04-05T12:52:28-04:00",
