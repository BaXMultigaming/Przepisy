  "ingredients": [
    "0.75 cup white sugar",
    "4 teaspoons cornstarch",
    "0.33333334326744 cup white vinegar",
    "0.33333331346512 cup water",
    "2 (15 ounce) cans sliced beets, drained",
    "3 tablespoons butter",
    "0.25 teaspoon salt",
    "0.25 teaspoon pepper"
  ],
