  "ingredients": [
    "1 (14 ounce) can sweetened condensed milk",
    "1.6666667461395 cups Irish whiskey",
    "1 cup heavy cream",
    "2 tablespoons chocolate syrup",
    "1 teaspoon instant coffee granules",
    "1 teaspoon vanilla extract",
    "1 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Combine sweetened condensed milk, whiskey, cream, chocolate syrup, coffee granules, vanilla extract, and almond extract in a blender. Blend on high speed until well combined, 20 to 30 seconds. Store in a tightly sealed container in the refrigerator for up to 2 months.",
