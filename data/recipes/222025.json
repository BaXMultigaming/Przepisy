  "ingredients": [
    "1 (8 ounce) package sugar snap peas, trimmed",
    "2 tablespoons water",
    "2 cups cherry tomatoes, halved",
    "1 clove garlic, minced",
    "0.75 teaspoon white sugar",
    "0.5 teaspoon salt-free onion and herb seasoning (such as Mrs. Dash®)",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium heat for 5 minutes. Add sugar snap peas and water; cover. Cook until peas are bright green, about 3 minutes. Remove cover and continue to cook until water is evaporated, about 2 minutes more. Stir tomatoes, garlic, sugar, and onion and herb seasoning into peas; cook for 3 minutes. Stir in lemon juice to serve.",
