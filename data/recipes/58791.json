  "ingredients": [
    "1 tablespoon ground coriander",
    "1 tablespoon cumin seed",
    "0.75 teaspoon salt",
    "0.5 teaspoon vegetable oil",
    "0.125 teaspoon ground black pepper",
    "3 pounds pork butt roast, cut into 1 1/2 inch cubes",
    "0.5 cup sliced onions",
    "0.33333334326744 cup soy sauce",
    "1 tablespoon brown sugar",
    "0.25 teaspoon ground ginger",
    "3 limes, cut into wedges"
  ],
  "steps": [
    {
      "text": "In a glass bowl or dish, mix together coriander, cumin, salt, oil, and pepper. Add pork cubes and stir to coat. Let stand for 20 minutes. Add onions, soy sauce, brown sugar, soy sauce, and ginger; stir to blend. Cover and refrigerate for at least 1 hour or overnight for best results.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate. Thread pork cubes onto eight skewers. Discard onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, basting frequently with the remaining marinade. Turn occasionally until cooked through, about 15 minutes. Serve sprinkled with lime juice to taste. Discard any unused marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
