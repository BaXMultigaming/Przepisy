  "ingredients": [
    "1 pound shrimp, heads off and unpeeled",
    "0.5 cup butter",
    "0.5 cup zesty Italian dressing",
    "1 tablespoon lemon juice",
    "2 teaspoons ground black pepper",
    "0.125 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash shrimp and drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt margarine/butter in a one quart casserole dish. Add salad dressing, lemon juice, black pepper and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add shrimp to the casserole dish. Stir gently to cover the shrimp with the mixture. Cover and bake, stirring occasionally for 25 to 30 minutes or until shrimp are pink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve the shrimp hot on a large platter and place the sauce in individual bowls so that you can easily 'dunk' bread in the sauce!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
