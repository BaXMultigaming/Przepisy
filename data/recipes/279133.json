  "ingredients": [
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "1 cup buttermilk",
    "0.66666668653488 cup cocoa",
    "2 large eggs, beaten",
    "2 teaspoons baking soda",
    "1 teaspoon vanilla extract",
    "1 teaspoon salt",
    "1 cup boiling water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 10x15-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, oil, buttermilk, cocoa, eggs, baking soda, vanilla extract, and salt in a large bowl; beat with an electric mixer until smooth and creamy. Add boiling water and mix well. Pour into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Increase oven temperature to 350 degrees F (175 degrees C) and continue to bake until a toothpick inserted into the center comes out clean, 20 to 25 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
