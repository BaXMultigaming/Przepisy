  "ingredients": [
    "0.5 cup soy sauce",
    "0.5 cup honey",
    "0.25 cup molasses",
    "2 tablespoons chile sauce",
    "2 cloves garlic, finely chopped",
    "1 teaspoon ground ginger",
    "3 pounds chicken wings, split and tips discarded"
  ],
  "steps": [
    {
      "text": "Mix together soy sauce, honey, molasses, chile sauce, garlic, and ginger in a shallow bowl. Add chicken; turn to coat evenly. Cover the bowl and chill in the refrigerator for 1 hour, turning occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange chicken in a single layer in a large baking dish; reserve marinade in the bowl for basting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, turning once and basting often with reserved marinade, until meat is no longer pink and the juices run clear, about 50 minutes. An instant-read thermometer inserted into the center of a wing should read at least 165 degrees F (74 degrees C). Discard any leftover marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
