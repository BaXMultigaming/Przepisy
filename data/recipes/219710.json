  "ingredients": [
    "1 (8 ounce) package broad egg noodles",
    "2 tablespoons butter",
    "3 eggs, separated",
    "1 cup white sugar",
    "2 apples - peeled, cored and chopped",
    "0.5 cup chopped almonds",
    "0.25 cup raisins",
    "1.5 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, about 5 minutes; drain well. Place cooked noodles into a large bowl; toss with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a bowl with an electric mixer until stiff peaks form; set meringue aside. Whisk egg yolks together in a separate bowl until smooth, then stir in sugar until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour egg yolk mixture over noodles; stir in apples, almonds, raisins, and cinnamon until evenly combined. Gently fold in meringue, trying to keep as much volume as possible. Transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until kugel is browned and center is set, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
