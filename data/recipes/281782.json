  "ingredients": [
    "olive oil cooking spray",
    "1 (16 ounce) package ziti pasta",
    "1 tablespoon olive oil",
    "0.5 (8 ounce) package fresh spinach, chopped",
    "1 (4 ounce) package fresh mushrooms, sliced",
    "1 (15 ounce) container part-skim ricotta cheese",
    "1 (8 ounce) package crumbled goat cheese",
    "0.5 (8 ounce) package shredded mozzarella cheese",
    "1 (14 ounce) jar spaghetti sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook ziti in boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium-high heat. Sauté spinach and mushrooms in hot oil until soft, about 5 minutes. Remove from heat and add to ziti in the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add ricotta cheese, goat cheese, and 1/2 of the mozzarella cheese to ziti mixture; mix thoroughly. Stir in spaghetti sauce until well combined, then transfer mixture to the prepared baking dish. Sprinkle with remaining mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until bubbly and cheese is melted, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
