  "ingredients": [
    "1 cup buttermilk baking mix",
    "0.33333331346512 cup chopped pecans",
    "2 teaspoons paprika",
    "0.5 teaspoon salt",
    "0.5 teaspoon poultry seasoning",
    "0.5 teaspoon dried sage",
    "1 (2 to 3 pound) whole chicken, cut into pieces",
    "0.5 cup evaporated milk",
    "0.33333334326744 teaspoon butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease one 13x9 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a shallow dish, combine the biscuit mix, pecans, paprika, salt, poultry seasoning and sage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip the chicken pieces in the evaporated milk then coat generously with the pecan mixture. Place pieces in the prepared baking dish and drizzle with the melted butter or margarine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour or until juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
