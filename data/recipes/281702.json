  "ingredients": [
    "1 tablespoon olive oil, or as needed",
    "1 medium butternut squash - peeled, seeded, and cubed",
    "1 medium red onion, diced",
    "2 tablespoons red curry paste",
    "1.25 cups vegetable broth",
    "4 medium tomatoes, chopped",
    "1 (15 ounce) can chickpeas, drained",
    "salt and ground black pepper to taste",
    "3 tablespoons Greek yogurt",
    "0.5 tablespoon ground coriander"
  ],
  "steps": [
    {
      "text": "Heat oil in a pot over medium heat. Add butternut squash; cook and stir for 3 minutes. Add onion and curry paste; cook and stir for 4 minutes. Pour in vegetable broth, cover, and cook until butternut squash is tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomatoes, chickpeas, salt, and pepper into the pot and cook until heated through, about 4 minutes. Stir in Greek yogurt and coriander.",
