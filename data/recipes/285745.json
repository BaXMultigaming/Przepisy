  "ingredients": [
    "1 medium sweet potato",
    "0.5 teaspoon olive oil",
    "1 tablespoon butter, or to taste",
    "1 tablespoon brown sugar, or to taste",
    "0.25 teaspoon cinnamon, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash sweet potato and pierce holes throughout. Rub olive oil all over sweet potato using your hands and place in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 15 minutes. Turn sweet potato and continue to cook until potato is soft and tender, 15 to 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut a slit on top of the sweet potato and top with butter, brown sugar, and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
