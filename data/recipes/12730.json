  "ingredients": [
    "4 (6 ounce) albacore tuna steaks, 1 inch thick",
    "3 tablespoons extra virgin olive oil",
    "salt and ground black pepper to taste",
    "1 lime, juiced",
    "0.5 cup hickory wood chips, soaked"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
