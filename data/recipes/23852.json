  "ingredients": [
    "2 cooked, boneless chicken breast halves, shredded",
    "4 cups chicken broth",
    "2 cups water",
    "1 (4.5 ounce) package quick cooking long grain and wild rice with seasoning packet",
    "0.75 cup all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 cup butter",
    "2 cups heavy cream"
  ],
  "steps": [
    {
      "text": "Combine chicken, broth, and water in a large pot over medium heat. Bring to a boil, then stir in rice, reserving the seasoning packet. Cover and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kAzUiyK34R28RQwVTPge5F6k8q8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23852-creamy-chicken-and-wild-rice-soup-ddmfs-step2-09-4x3-192b9d7aee2e46a89691d8222af84ed6.jpg"
      ],
      "image": "assets/images/23852/step_01.webp"
    },
    {
      "text": "Combine flour, salt, and pepper in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qeVUkaWZpWpeR1Z6D6CdzNPqzqU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23852-creamy-chicken-and-wild-rice-soup-ddmfs-step3-12-4x3-fcf7f9817a8244c28256ea338bfee1de.jpg"
      ],
      "image": "assets/images/23852/step_02.webp"
    },
    {
      "text": "Melt butter in a medium saucepan over medium heat. Stir in contents of seasoning packet until mixture is bubbly. Reduce heat to low, then add flour mixture, a few tablespoons at a time, into the butter mixture, stirring continuously to form a roux. Whisk in cream, a little at a time, until fully incorporated and smooth. Cook until thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zLTlXxVFnZwU5uvXzPUm3WG1TmI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23852-creamy-chicken-and-wild-rice-soup-ddmfs-step5-19-4x3-802992f360bf484ea1fdb7a8a3984796.jpg"
      ],
      "image": "assets/images/23852/step_03.webp"
    },
    {
      "text": "Stir flour and cream mixture into broth and rice. Cook over medium heat until heated through, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_7M5B1FnjkTNvY8FSk8oM5M8szc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23852-creamy-chicken-and-wild-rice-soup-ddmfs-step6-32-4x3-e183297e24fc46bdab0cf4ed333c0a1a.jpg"
      ],
      "image": "assets/images/23852/step_04.webp"
