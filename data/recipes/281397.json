  "ingredients": [
    "0.25 cup vegetable oil",
    "1 (1.06 ounce) package mojito lime marinade mix",
    "2 tablespoons cider vinegar",
    "2 tablespoons water",
    "2 pounds raw jumbo shrimp, shelled and deveined",
    "1 serving cooking spray",
    "2 yellow bell peppers, quartered",
    "2 red bell peppers, quartered",
    "1 large onion, sliced into 1/2-inch rings",
    "1 (8 ounce) package fajita-size flour tortillas"
  ],
  "steps": [
    {
      "text": "Combine oil, marinade mix, vinegar, and water in a large bowl; add shrimp and marinate, 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill to 300 degrees F (150 degrees C) and lightly coat the grate with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bell peppers and onion on the preheated grill, 3 to 5 minutes per side. Transfer to a cutting board; roughly chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove shrimp from marinade, shake off excess, and discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook shrimp on the preheated grill until opaque and cooked through, 1 to 2 minutes per side. Transfer shrimp to a bowl; cover with aluminum foil to keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tortillas on the preheated grill, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide shrimp, onion, and bell peppers among tortillas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
