  "ingredients": [
    "0.5 cup vegetable oil",
    "0.25 cup cider vinegar",
    "1 tablespoon garlic powder",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon dried thyme",
    "4 skinless, boneless chicken breast halves",
    "4 large potatoes, peeled and cut into 1/4-inch slices",
    "2 large onions, cut into 1/4 inch thick slices",
    "2 large green bell pepper, cut into 1/4 inch strips",
    "2 cups sliced button mushrooms"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat an outdoor grill for medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NWRdxnucx5JZ_KIlec3zDR-SuPc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/142962-Grilled-Chicken-and-Potato-Foil-Packs-DDMFS-Step-01-8184965f7fb94ceca6518cbe304ba846.jpg"
      ],
      "image": "assets/images/142962/step_01.webp"
    },
    {
      "text": "Stir vegetable oil, cider vinegar, garlic powder, black pepper, salt, basil, and thyme together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9lCo6rz9gtlSsv0dtIYs5JddGqw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/142962-Grilled-Chicken-and-Potato-Foil-Packs-DDMFS-Step-02-5716ccdc7cc446c2b8ba6b3f175f8258.jpg"
      ],
      "image": "assets/images/142962/step_02.webp"
    },
    {
      "text": "Lay out four 12x12-inch squares of aluminum foil. Place 1 chicken breast in the center of each square, top with potatoes, onions, bell peppers, and mushrooms. Ladle 1/4 of the sauce on each and fold the foil around the ingredients to form four sealed packets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wiWhaX9Uu0Z-vgAhquXE7CTbRfI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/142962-Grilled-Chicken-and-Potato-Foil-Packs-DDMFS-Step-03-235d494a598a4dd49abb3fc806ab5314.jpg"
      ],
      "image": "assets/images/142962/step_03.webp"
    },
    {
      "text": "Grill the packets on the preheated grill until chicken is cooked through and tender, about 30 to 40 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P77UA6avOoJ6ajLVE1W0jLzsr8U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/142962-Grilled-Chicken-and-Potato-Foil-Packs-DDMFS-Step-04-26de07cc437d42f099172a13d04926e2.jpg"
      ],
