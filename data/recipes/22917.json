  "ingredients": [
    "1 (21 ounce) can apple pie filling",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 cup margarine",
    "0.25 cup brown sugar",
    "2 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pie filling in an 8x8-inch baking dish. Sprinkle with cinnamon and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream margarine and sugar together in a large bowl. Cut in flour with a pastry blender until mixture resembles coarse crumbs; sprinkle over pie filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is brown and filling is bubbly, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
