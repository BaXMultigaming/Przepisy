  "ingredients": [
    "2.5 cups ground cherries",
    "0.5 cup packed brown sugar",
    "1 tablespoon all-purpose flour",
    "2 tablespoons water",
    "1 (9 inch) pie shell",
    "3 tablespoons all-purpose flour",
    "3 tablespoons white sugar",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ground cherries in unbaked pie shell. Combine brown sugar and 1 tablespoon flour in a bowl: sprinkle over cherries. Sprinkle water over top. Combine 3 tablespoons flour and 3 tablespoons sugar in a separate bowl: mix in butter until crumbly. Add crumb mixture over cherry mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Reduce the temperature to 375 degrees F (190 degrees C) and bake for 25 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
