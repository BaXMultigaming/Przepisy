  "ingredients": [
    "1 pound ground beef",
    "3 cups cooked rice",
    "1 red bell pepper, chopped",
    "1 orange bell pepper, chopped",
    "1 green bell pepper, chopped",
    "2 cups tomato sauce",
    "0.5 cup brown sugar",
    "8 ounces shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Break ground beef into pieces and add to skillet; cook and stir until about half of the beef is browned, 3 to 5 minutes. Stir red bell pepper, orange bell pepper, and green bell pepper into the beef; continue to cook and stir until the beef is entirely browned, about 5 minutes more. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix tomato sauce and brown sugar together in a bowl; pour over the beef mixture. Stir rice into the beef mixture and stir; transfer to a 9x13-inch baking dish. Sprinkle Cheddar cheese over the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the cheese is bubbling, about 30 minutes. Cool dish 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
