  "ingredients": [
    "0.75 cup vegetable oil",
    "0.66670000553131 cup vinegar",
    "2 teaspoons hot pepper sauce",
    "3 teaspoons celery seed",
    "1 teaspoon salt",
    "2 large onions, chopped",
    "1.5 pounds cooked shrimp, peeled and deveined without tail"
  ],
  "steps": [
    {
      "text": "In a large stainless steel or glass mixing bowl, combine the oil, vinegar, hot sauce, celery seed and salt. Mix thoroughly. Place the chopped onions and shrimp into the oil mixture. Toss to coat evenly. DO NOT use an aluminum mixing bowl! The high acid content in the vinegar could cause a reaction with the aluminum and poison the food.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the mixture in the refrigerator and chill over night.",
      "section": null,
