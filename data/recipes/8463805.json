    "publisher-tested"
  ],
  "ingredients": [
    "baking spray with flour",
    "1 cup unsalted butter, softened",
    "1.5 cups white sugar",
    "3 large eggs, at room temperature",
    "2 teaspoons vanilla extract",
    "3 cups enriched bleached cake flour",
    "1 tablespoon baking powder",
    "0.5 teaspoon kosher salt",
    "1 cup whole milk, at room temperature",
    "gel food coloring: red or pink, orange, yellow, green, blue, and purple",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup unsalted butter, softened",
    "3 cups powdered sugar, sifted",
    "1 teaspoon vanilla extract",
    "0.125 teaspoon kosher salt",
    "gel food coloring: red or pink, orange, and green"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IWbnH5qmBi1qCM_6SggcYf14K1M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/rainbow-cake-mfs-step-1-06-6dc96b6dc3454b0e9e4f624ea5337a25.jpg"
      ],
      "image": "assets/images/8463805/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan with baking spray and line with parchment paper; spray parchment with baking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare Cake: Beat butter in a stand mixer fitted with a paddle attachment on medium speed until creamy, about 30 seconds. Gradually add white sugar; beat until light and fluffy, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4j3YVcVOnxN_MbRZtl6ZHhIKY5g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/rainbow-cake-mfs-step-2-11-8ff0221e1d0f4cf1a62ba3f71d41ee14.jpg"
      ],
      "image": "assets/images/8463805/step_03.webp"
    },
    {
      "text": "Add eggs, 1 at a time, and beat just until incorporated after each addition, about 1 minute total. Add vanilla and beat until combined, about 15 seconds. Scrape down sides and bottom of bowl using a flexible spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pzemAgkzpHc6mtxu7tmicx4pO74=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/rainbow-cake-mfs-step-2-13-58e7f843a860470383c2b0857b5b9bd2.jpg"
      ],
      "image": "assets/images/8463805/step_04.webp"
    },
    {
      "text": "Whisk together flour, baking powder, and salt in a medium bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QuknUs_oWHLEqEsLQkTgCdnvamQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/rainbow-cake-mfs-step-3-14-e00ef4064dae43c0a8f725552e612e14.jpg"
      ],
      "image": "assets/images/8463805/step_05.webp"
    },
    {
      "text": "Add flour mixture to butter mixture alternately with milk, beginning and ending with flour mixture, beating on low speed just until combined after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vknAPKH-5PHPAbajV0_QkRmN3sk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/rainbow-cake-mfs-step-4-19-8e4d17c4a64b47d68a427bf6d139bb79.jpg"
      ],
      "image": "assets/images/8463805/step_06.webp"
    },
    {
      "text": "Divide batter equally between 6 small bowls. Add one to two drops of food coloring to each bowl, tinting one bowl red or pink, one orange, one yellow, one green, one blue and one purple. Mix gently to combine and add additional coloring as needed to reach desired shades.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_l34yqjy0sKrgza_RYqhgStagpw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/rainbow-cake-mfs-step-5-23-3ba62e1a4c8b453185440609b1cd8634.jpg"
      ],
      "image": "assets/images/8463805/step_07.webp"
    },
    {
      "text": "Dollop the batter into the prepared pan, alternating colors, until the whole pan is filled. [If you have leftover batter, top up existing dollops of the same color – don't make a second layer of different colors]. Gently bang the pan on the counter to ensure that the batter is evenly distributed and that all gaps are filled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OSHgdx2XOpsDPkaPtC-oX60SCVs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/rainbow-cake-mfs-step-6-25-d097488e79ff47a9975382a76984aaa6.jpg"
      ],
      "image": "assets/images/8463805/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 30 minutes. Cool in pan for 15 minutes. Remove cake from pan and cool on a wire rack until completely cool, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare frosting: Beat cream cheese and butter in a stand mixer fitted with a paddle attachment on medium speed until smooth, about 1 minute. Reduce mixer speed to low, and gradually add powdered sugar, beating until incorporated, about 2 minutes. Add vanilla and salt, then increase mixer speed to medium, and beat until fluffy, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/acKgGGbKfI-eYulDZ8oyYNZX9vU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/rainbow-cake-mfs-step-7-36-b008c69e2d0d4a689c17e1795aaa85aa.jpg"
      ],
      "image": "assets/images/8463805/step_10.webp"
    },
    {
      "text": "Spoon out 1/4 cup of frosting into each of 3 small bowls. Add one to two drops of food coloring to each bowl, tinting one bowl red or pink, one orange, and one green. Mix well to combine and add additional coloring as needed to reach desired shades. Transfer each of the colored frostings to piping bags fitted with small round writing tips. Leave the remaining frosting in the mixing bowl white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/czQItQ5VOcEqOMmdbe_FrbAuaYE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/rainbow-cake-mfs-step-8-38-dcb05798c9b34cc8b1445a45a287bcd5.jpg"
      ],
      "image": "assets/images/8463805/step_11.webp"
    },
    {
      "text": "Using a serrated knife, trim the edges of the cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UYU5t6OJ_eMbhNCPeKJy7qZNN4k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/rainbow-cake-mfs-step-9-62-5c489b53c6ab4d1c9c9c9ecc5e56ad1d.jpg"
      ],
      "image": "assets/images/8463805/step_12.webp"
    },
    {
      "text": "Frost the top of the cake with the white frosting, leaving the sides uncovered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zAyBXOvM5FJcSPQmptaw0N8juRE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/rainbow-cake-mfs-step-9-64-ef4a4597cc73401db4f9dab9b3cb5f7d.jpg"
      ],
      "image": "assets/images/8463805/step_13.webp"
    },
    {
      "text": "Use the colored frosting to pipe small rainbows across top of cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-Em1eMKFYc8WDTZJVXurqR7p0Pw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/rainbow-cake-mfs-step-10-69-d404f9a22ea24781bb403f63f5b6f419.jpg"
      ],
      "image": "assets/images/8463805/step_14.webp"
    }
  ],
