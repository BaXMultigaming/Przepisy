  "title": "Rainbow Sheet Cake",
  "description": "This kid-friendly rainbow sheet cake is a super simple vanilla cake base with cream cheese frosting, making it the perfect, colorful choice for a birthday party.",
  "authors": [
    "Nicole Hopper"
  ],
  "date_published": "2022-08-30T10:18:34-04:00",
