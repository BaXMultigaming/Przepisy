  "ingredients": [
    "8 slices sourdough bread",
    "2 tablespoons honey mustard",
    "0.5 pound sliced deli ham",
    "1.5 cups shredded mozzarella cheese",
    "0.5 cup grated Parmesan cheese",
    "2 eggs, beaten",
    "0.25 cup milk",
    "0.125 teaspoon freshly ground nutmeg",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Spread one side of 4 bread slices with mustard. Top remaining 4 slices with ham. Combine mozzarella and Parmesan cheeses and mix together; sprinkle mixture evenly over ham and close sandwiches, mustard side down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a shallow dish or bowl combine the eggs, milk and nutmeg and mix well. Melt butter in a large skillet or on a griddle over medium heat. Dip each sandwich in egg mixture, turning to coat. Let excess egg mixture drip into dish or bowl, and place sandwiches in hot skillet. Cook until golden brown and cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
