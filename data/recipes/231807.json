  "ingredients": [
    "3 cups chicken broth",
    "1 cup wild rice",
    "cooking spray",
    "1 (26.5 ounce) can cream of mushroom soup",
    "1 pound cubed cooked chicken",
    "0.5 cup diced carrot",
    "0.25 cup diced onion",
    "2 teaspoons red pepper flakes",
    "4 large red bell peppers, halved lengthwise and seeded"
  ],
  "steps": [
    {
      "text": "Bring chicken broth to a boil in a saucepan; add wild rice. Reduce heat to medium-low, cover, and simmer until the rice is tender, 55 minutes. Remove from heat and cool for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray a 9x13-inch casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mushroom soup, chicken, carrot, onion, and red pepper flakes in a bowl; fold in wild rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange red bell pepper halves in the prepared casserole dish. Fill each half with chicken-rice filling. Cover casserole dish loosely with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is heated through and bubbling, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
