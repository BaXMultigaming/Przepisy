  "ingredients": [
    "1 pound skinless, boneless chicken breast, diced",
    "1 (1.27 ounce) packet fajita seasoning",
    "1 tablespoon vegetable oil",
    "2 green bell peppers, chopped",
    "2 red bell peppers, chopped",
    "1 onion, chopped",
    "10 (10 inch) flour tortillas",
    "1 (8 ounce) package shredded Cheddar cheese",
    "1 (8 ounce) package shredded Monterey Jack cheese",
    "1 tablespoon bacon bits"
  ],
  "steps": [
    {
      "text": "Gather ingredients, preheat the broiler, and lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y9T7KxKm12ZliEuN3nqL_fgecEU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21659-Chicken-Quesadillas-DDMFS-3246-4x3-Ingredients-1f92c676b22040b6ac1dcc05b608ea6f.jpg"
      ],
      "image": "assets/images/21659/step_01.webp"
    },
    {
      "text": "Toss chicken with fajita seasoning, then spread onto the prepared baking sheet. Place under the broiler and cook until chicken is cooked through and no longer pink in the center, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gabpoxBbX3uFSJUJ9xZZ-hCQm8M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21659-Chicken-Quesadillas-DDMFS-3251-4x3-Step-03-5851d4e8e0144083b8bdb9888d845b65.jpg"
      ],
      "image": "assets/images/21659/step_02.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large saucepan over medium heat. Stir in bell peppers, onion, and broiled chicken. Cook and stir until vegetables have softened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g-Bhoh07DbthfRnbgOg03NgjR5w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21659-Chicken-Quesadillas-DDMFS-3257-4x3-Step-05-a5ad9b4149b54cdf87bcc90f6afaa53d.jpg"
      ],
      "image": "assets/images/21659/step_04.webp"
    },
    {
      "text": "Layer half of each tortilla with chicken and vegetable mixture, Cheddar cheese, Monterey Jack cheese, and bacon bits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UJe2TfYaCywIhab63byxFXKHpiI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21659-Chicken-Quesadillas-DDMFS-3259-4x3-Step-06-f136bf95cdc64f96937d533ae084ec16.jpg"
      ],
      "image": "assets/images/21659/step_05.webp"
    },
    {
      "text": "Fold tortillas in half and place onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Uc7kSwdisj9pFyGxXJajlrbpYRE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21659-Chicken-Quesadillas-DDMFS-3262-4x3-Step-07-f9aac4bd6b804388b9e21b4e2d6c409b.jpg"
      ],
      "image": "assets/images/21659/step_06.webp"
    },
    {
      "text": "Bake quesadillas in the preheated oven until cheeses have melted, about 10 minutes. Cut each quesadilla into wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/avp4qCi2myhqPTsA53NZT_8g1gs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21659-Chicken-Quesadillas-DDMFS-3271-4x3-Step-08-3495074ac02c4ae9b8f3e9e235c16e3a.jpg"
      ],
      "image": "assets/images/21659/step_07.webp"
