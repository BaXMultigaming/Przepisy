  "ingredients": [
    "8 medium potatoes, sliced",
    "0.5 pound sliced bacon",
    "1 pound processed American cheese, sliced",
    "0.5 onion, chopped",
    "1 cup mayonnaise",
    "salt and pepper to taste",
    "0.25 cup black olives, sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Butter a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put sliced potatoes into a large pot, and fill with enough water to cover. Bring to a boil, and cook until tender but still firm, about 10 minutes. Drain, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "At the same time, place bacon in a large deep skillet. Cook over medium-high heat until evenly browned. Remove to paper towels to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir potatoes, cheese, onion, mayonnaise, salt, and pepper together in a large bowl; spoon into prepared baking dish. Crumble bacon over the top, and sprinkle with olives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
