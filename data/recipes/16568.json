  "title": "Potato Salad Casserole",
  "description": "Sliced potatoes, cheese, bacon, onion, and mayo all feature in this comforting casserole to give you all the flavors you&#39;d expect to find in potato salad.",
  "authors": [
    "Tom"
  ],
  "date_published": "2000-01-19T12:22:49-05:00",
