  "ingredients": [
    "1 cup rolled oats",
    "0.5 cup flax seeds",
    "0.5 cup roasted almonds",
    "0.25 cup pumpkin seeds",
    "2 cups puffed rice",
    "0.5 cup dry milk powder",
    "0.5 cup dried cranberries",
    "0.33333334326744 cup protein powder",
    "0.33333334326744 cup sesame seeds",
    "0.25 cup chia seeds",
    "0.25 cup shredded coconut",
    "0.5 cup almond butter",
    "0.5 cup peanut butter",
    "0.5 cup honey",
    "0.33333334326744 cup coconut milk",
    "2 tablespoons vegetable oil",
    "2 teaspoons vanilla extract",
    "0.75 cup oat bran"
  ],
  "steps": [
    {
      "text": "Cover a large cookie sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pulse oats in a food processor just until slightly ground. Transfer to a large bowl. Repeat with flax seeds, then almonds, and finally pumpkin seeds, pulsing just one ingredient at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add puffed rice, milk powder, cranberries, protein powder, sesame seeds, chia seeds, and shredded coconut to the bowl; mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix almond butter, peanut butter, honey, coconut milk, vegetable oil, and vanilla together in a quart-sized bowl until well combined. Pour wet mixture into the dry mixture and stir until well blended. Spread thinly onto the prepared cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in the freezer until solid, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the freezer, dust with oat bran, and cut into 24 bars. Store in a zip-top bag in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
