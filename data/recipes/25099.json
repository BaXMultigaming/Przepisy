  "ingredients": [
    "0.5 cup butter flavored shortening",
    "1 tablespoon water",
    "0.5 cup white sugar",
    "1 cup packed brown sugar",
    "1.5 teaspoons vanilla extract",
    "2 egg whites",
    "1.75 cups unbleached all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup rolled oats",
    "0.5 cup miniature semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter flavored shortening, water, white sugar and brown sugar until smooth. Beat in the egg whites and vanilla. Combine the flour, baking soda and salt; stir into the creamed mixture. Blend in the oats and mini chocolate chips. Drop dough by half-teaspoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 7 to 9 minutes in the preheated oven, until the edges begin to brown. Remove from baking sheets to cool on wire racks. Cool at least 10 minutes before eating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
