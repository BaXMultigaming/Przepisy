  "ingredients": [
    "5 pounds pork roast, trimmed",
    "3 cloves garlic, sliced",
    "0.5 tablespoon ground black pepper",
    "1 teaspoon salt",
    "3 bay leaves",
    "0.5 cup cider vinegar",
    "1 teaspoon dried thyme"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut slits into top of roast with a paring knife; place garlic slices into slits. Season roast with black pepper and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bay leaves in the bottom of a roasting pan; place roast, fat-side up, on top of bay leaves. Combine cider vinegar and thyme in a small bowl; pour over roast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into the center reads 145 degrees F (63 degrees C), about 3 hours. Baste drippings frequently over roast while cooking using a baster or spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rest roast before slicing, 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
