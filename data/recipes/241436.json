  "ingredients": [
    "1 cup white rice flour",
    "1 cup white sugar",
    "0.5 cup potato starch",
    "0.25 cup tapioca starch",
    "1 tablespoon ground cinnamon",
    "2.5 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon xanthan gum",
    "0.5 teaspoon salt",
    "0.25 teaspoon nutmeg",
    "1 (8 ounce) can crushed pineapple, drained and juice reserved",
    "1 cup soy yogurt",
    "0.66666668653488 cup shredded carrots",
    "0.5 cup coarsely ground walnuts",
    "0.5 cup unsweetened coconut flakes",
    "0.25 cup unsweetened applesauce",
    "2 tablespoons vegetable oil",
    "1 teaspoon pure vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly oil a 9-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix rice flour, sugar, potato starch, tapioca starch, cinnamon, baking powder, baking soda, xanthan gum, salt, and nutmeg together in a bowl. Add pineapple, 1/4 cup reserved pineapple juice, yogurt, carrots, walnuts, coconut, applesauce, vegetable oil, and vanilla extract to flour mixture; mix with a wooden spoon until well blended. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
