  "ingredients": [
    "0.25 cup warm water",
    "1 tablespoon ground flaxseed",
    "2 over-ripe bananas, mashed",
    "0.5 cup applesauce",
    "0.5 cup grated carrots",
    "0.5 cup vegetable oil",
    "0.5 cup almond milk",
    "2 tablespoons brown sugar",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.5 cup quick oats",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together warm water and ground flaxseed; let sit for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mashed bananas with applesauce, grated carrots, vegetable oil, almond milk, brown sugar, and vanilla extract in a large bowl. Mix in water and flaxseed mixture. Add in flour, oats, baking powder, cinnamon, nutmeg, baking soda, cloves, and salt and stir until just mixed. Pour 1/4 cup of batter into each muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
