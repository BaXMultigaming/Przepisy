  "ingredients": [
    "1.25 cups warm water (110 degrees F/45 degrees C)",
    "2 tablespoons margarine",
    "2 tablespoons honey",
    "2.5 cups bread flour",
    "0.25 cup oat bran",
    "1 teaspoon salt",
    "1.5 teaspoons active dry yeast"
  ],
  "steps": [
    {
      "text": "Place warm water, margarine, honey, bread flour, oat bran, salt, and yeast into a bread machine in the order listed, or follow the order recommended by your manufacturer if different.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Run the Dough cycle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "After dough has risen once, remove it from the machine. Knead dough a few times, then shape into a loaf. Place into a greased 9x5-inch loaf pan and let rise until doubled in size, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until done, 35 to 40 minutes, or until done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
