  "ingredients": [
    "2 cups Make Ahead Cookie Mix",
    "0.5 cup white sugar",
    "2 tablespoons butter",
    "1 teaspoon vanilla extract",
    "1 egg",
    "0.5 cup chopped walnuts",
    "1 cup any flavor fruit jam",
    "1 egg white"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
