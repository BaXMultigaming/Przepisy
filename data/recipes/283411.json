  "ingredients": [
    "0.25 cup peanuts",
    "2 Thai chiles, chopped",
    "3 cloves garlic",
    "1 tablespoon dried shrimp",
    "1 tablespoon white sugar",
    "2 medium limes, juiced",
    "2 tablespoons fish sauce",
    "1 medium papaya - peeled, seeded, and sliced",
    "1 cup cherry tomatoes, halved",
    "0.5 medium carrot, peeled and shredded",
    "0.25 cup fresh green beans, cut into 1-inch pieces",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place peanuts on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast in the preheated oven until fragrant and golden, 7 to 8 minutes. Cool for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grind peanuts, Thai chiles, garlic, dried shrimp, and sugar in a mortar and pestle, or food processor; stir in lime juice and fish sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss papaya, tomatoes, carrot, and green beans with peanut dressing; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
