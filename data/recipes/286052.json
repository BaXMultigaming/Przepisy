  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sweet potatoes, sugar, 1/2 cup melted butter, milk, bourbon, eggs, and vanilla in a bowl. Transfer to the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix pecans, brown sugar, flour, and 1/3 cup melted butter in a bowl; set aside.",
