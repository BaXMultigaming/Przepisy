  "ingredients": [
    "0.33333334326744 cup white sugar",
    "0.75 teaspoon ground cinnamon",
    "0.125 teaspoon ground cardamom",
    "0.25 cup white sugar",
    "1 sheet frozen puff pastry, thawed",
    "1 tablespoon butter, melted"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EIt2FNgQcSnpPL4aQLQhcQYS934=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231466-cinnamon-palmiers-step-01-19d74481f3594b8cae56e1668bef3e2d.jpg"
      ],
      "image": "assets/images/231466/step_01.webp"
    },
    {
      "text": "Mix 1/3 cup sugar, cinnamon, and cardamom together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle remaining 1/4 cup sugar onto a work surface. Unfold puff pastry and place over sugar; roll out to a 10x15-inch rectangle. Brush pastry with melted butter, then sprinkle sugar mixture evenly over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UsLE9HyX8RY7NaMEA4lbPYypz_k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231466-cinnamon-palmiers-step-05-0e9a52201f3a46e99cfff57c1313df5b.jpg"
      ],
      "image": "assets/images/231466/step_03.webp"
    },
    {
      "text": "Starting with one long edge, roll pastry tightly around filling, stopping in the middle of the rectangle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TGOALdl5oG91gjj8QVkKND7167U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231466-cinnamon-palmiers-step-06-4b868f349aeb45cfa3730252794233b9.jpg"
      ],
      "image": "assets/images/231466/step_04.webp"
    },
    {
      "text": "Repeat with the opposite edge, rolling to the center and meeting the first roll. Wet your finger with water and dot along the long edges where the two rolls touch; press gently to seal. Refrigerate until slightly firm, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ii_kfGZLRXpAgr3NcUfGzA9EGzY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231466-cinnamon-palmiers-step-07-7d3393b90a764eaf9ace2fb6254ee821.jpg"
      ],
      "image": "assets/images/231466/step_05.webp"
    },
    {
      "text": "Meanwhile, preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut chilled pastry into 1/4-inch slices; place 1 inch apart onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ckAb0MsBx0hS6Bgp2wbpBRQZuGw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231466-cinnamon-palmiers-step-09-30f5a5ea30fb4c8ba5feeccfdb37b821.jpg"
      ],
      "image": "assets/images/231466/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until golden and crisp, about 12 minutes. Let rest briefly on the baking sheet before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Hf3DnRWlAM39s0eOoJSadwCQw7o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231466-cinnamon-palmiers-step-11-5380c6fd04d94134b3651be1299cd1da.jpg"
      ],
      "image": "assets/images/231466/step_08.webp"
    }
