  "ingredients": [
    "2 pounds cauliflower, cut into 1-inch pieces",
    "0.25 cup heavy cream",
    "0.33333334326744 cup freshly grated Parmesan cheese",
    "0.25 cup unsalted butter",
    "0.25 cup reduced-fat cream cheese",
    "1 teaspoon sea salt"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil. Add cauliflower and reduce heat to medium. Cook cauliflower until very tender, about 10 minutes; drain, shaking the colander to remove as much water as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cauliflower in a blender and pour in cream. Blend until smooth, then transfer mixture to a large pot over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in Parmesan cheese, butter, cream cheese, and sea salt until well combined; cook and stir until hot, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
