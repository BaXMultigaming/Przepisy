  "ingredients": [
    "2 pounds fresh green beans, rinsed and trimmed",
    "0.5 cup margarine",
    "0.5 onion, chopped",
    "1 tablespoon minced garlic",
    "0.5 cup soy sauce",
    "0.25 cup water",
    "2 tablespoons beef bouillon",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil. Cook green beans in boiling water for 5 minutes. Drain, then rinse with cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt margarine in a large saucepan over high heat. Stir green beans, onions, and garlic into hot margarine. Pour in soy sauce. Stir in water and bouillon. Reduce heat to low and simmer, stirring occasionally, for 20 minutes. Season with salt and pepper.",
