  "ingredients": [
    "1 pound mild Italian turkey sausage, casings removed",
    "1 pound ground turkey",
    "2 eggs, beaten",
    "1.5 cups rolled oats",
    "0.5 cup chopped onion",
    "0.5 cup milk",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon Italian-style seasoning",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "2 cups spaghetti sauce",
    "5 dashes hot pepper sauce",
    "1 tablespoon Worcestershire sauce",
    "0.5 teaspoon liquid smoke flavoring"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine ground turkey, sausage, eggs, oats, onion, and milk. Season with 1 tablespoon Worcestershire sauce, Italian seasoning, garlic powder, and salt. Mix well and form into a loaf. Place into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate small bowl, mix together spaghetti sauce, hot sauce, 1 tablespoon Worcestershire sauce, and liquid smoke. Smooth over the entire meatloaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
