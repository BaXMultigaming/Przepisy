  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "0.75 cup cornmeal",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 (14.5 ounce) can cream-style corn",
    "2 eggs, beaten",
    "0.5 cup applesauce",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 18 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, cornmeal, baking powder, and salt together in a large mixing bowl. Add cream-style corn, eggs, applesauce, and 1/2 cup milk to the flour mixture and beat with an electric hand mixer for 1 minute. Pour remaining milk into the batter and beat until just blended. Fill muffin tins 3/4 full of batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 25 to 30 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
