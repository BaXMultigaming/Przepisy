  "title": "Sweet Corn Muffins with Real Corn",
  "description": "These corn muffins use canned cream-style corn for a delicious dessert-type muffin perfect for burrito night at your house.",
  "authors": [
    "Bob Manasco"
  ],
  "date_published": "2020-06-18T23:50:34-04:00",
