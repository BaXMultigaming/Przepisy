  "ingredients": [
    "1 large egg",
    "2 tablespoons mayonnaise",
    "1 tablespoon chopped fresh parsley",
    "1 tablespoon chopped fresh chervil",
    "1 tablespoon chopped fresh dill",
    "1 tablespoon chopped fresh chives",
    "0.5 teaspoon Worcestershire sauce",
    "0.5 teaspoon Dijon mustard",
    "0.5 teaspoon seafood seasoning (such as Old Bay®)",
    "0.5 teaspoon salt",
    "0.25 cup panko bread crumbs",
    "2 (5 ounce) packages of fresh salmon"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer for 10 minutes to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg, mayonnaise, parsley, chervil, dill, chives, Worcestershire sauce, mustard, seafood seasoning, and salt together in a bowl. Mix in panko bread crumbs until combined. Gently fold in salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape mixture into 4 cakes. Line the air fryer basket with perforated parchment.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry salmon cakes for 8 minutes, flipping at the halfway point. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
