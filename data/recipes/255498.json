  "ingredients": [
    "1 cup butter",
    "1 cup brown sugar, packed",
    "0.5 cup white sugar",
    "2 eggs",
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "1 teaspoon vanilla extract",
    "20 (.3 ounce) miniature bars fun-sized candy bars, chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter, brown sugar, and white sugar together in a bowl until creamy. Beat in eggs, one at a time, until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and baking powder in a bowl. Mix gradually into the butter mixture. Beat in vanilla extract until mixed. Fold in candy a little at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are golden, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
