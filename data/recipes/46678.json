  "ingredients": [
    "1 pound extra-lean ground beef",
    "1 small onion, finely chopped",
    "1 tablespoon pepper",
    "2 teaspoons salt",
    "1 (28 ounce) can diced tomatoes",
    "1 (15 ounce) can tomato sauce",
    "1 (6 ounce) can tomato paste",
    "2 cloves garlic, minced",
    "4 teaspoons dried thyme",
    "2 teaspoons dried basil leaves",
    "2 teaspoons dried rosemary",
    "1 teaspoon dried marjoram",
    "1 teaspoon crushed bay leaf"
  ],
  "steps": [
    {
      "text": "Heat a large, deep skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion to beef in the skillet and cook, stirring occasionally, until onion is soft and translucent, about 5 minutes. Season with pepper and salt. Stir in tomatoes, tomato sauce, tomato paste, and garlic; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with thyme, basil, rosemary, marjoram, and bay leaf. Reduce heat to low, cover, and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
