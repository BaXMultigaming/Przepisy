    "2 tablespoons water",
    "0.33333334326744 cup heavy whipping cream",
    "2 teaspoons all-purpose flour",
    "2 tablespoons grated Asiago cheese",
    "0.5 shallot, minced",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper"
