  "steps": [
    {
      "text": "Stir vegetables, chicken soup, mushroom soup, and chicken cubes together in a Dutch oven with a flat lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook over campfire coals until warmed through but not boiling, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange biscuit dough segments in a layer atop the vegetable mixture. Put lid on the Dutch oven and carefully arrange some hot coals atop the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat until the biscuits are cooked through, 15 to 30 minutes.",
      "section": null,
