  "ingredients": [
    "3 cups raisins",
    "2 cups currants",
    "1 cup prunes",
    "0.66666668653488 cup candied mixed peel",
    "1.25 cups cherry brandy",
    "0.5 cup dark brown sugar",
    "6 tablespoons dark rum",
    "1 teaspoon mixed spice",
    "2 cups butter, softened",
    "1.75 cups dark brown sugar",
    "10 eggs",
    "4 cups self-rising flour, sifted",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Place raisins, currants, prunes, and mixed peel in a food processor; process until finely chopped. Transfer to a large jar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cherry brandy, 1/2 cup brown sugar, dark rum, and mixed spice into the jar; mix well and seal. Refrigerate, occasionally stirring, until flavors blend, 2 weeks to 3 months.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and line two 9-inch cake pans with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and 1 ¾ cups brown sugar in a bowl; beat with an electric mixer until smooth and creamy. Beat in eggs until smooth. Beat in raisin mixture until evenly incorporated. Fold in flour and vanilla extract gradually until batter is smooth and falls off the back of a lifted spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter between the prepared cake pans. Cover cake pans loosely with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cakes are firm and spring back when lightly pressed, about 2 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool cakes in the pans, 8 hours to overnight. Wrap in aluminum foil to keep moist.",
      "section": null,
      "name": null,
      "url": null,
