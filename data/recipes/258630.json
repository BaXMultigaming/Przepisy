  "title": "Trinidad Black Cake",
  "description": "This spiced black cake is made with cherry brandy and rum-soaked dried fruit for a classic Caribbean holiday dessert. This cake tastes better as it ages.",
  "authors": [
    "Roxanne J.R."
  ],
  "date_published": "2020-03-05T00:16:29-05:00",
