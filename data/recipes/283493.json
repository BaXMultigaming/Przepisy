  "ingredients": [
    "cooking spray",
    "2 tablespoons brown sugar",
    "1 tablespoon soy sauce",
    "1 tablespoon hot water",
    "1 tablespoon miso paste",
    "2 (6 ounce) salmon fillets"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a shallow baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk brown sugar, soy sauce, hot water, and miso in a large glass or ceramic bowl until thoroughly combined. Add salmon and turn several times to coat. Marinate for 10 minutes, occasionally spooning mixture over fish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer salmon to the prepared baking dish and cover with foil. Leave extra marinade in the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 7 minutes. Uncover, spoon remaining marinade evenly onto the salmon, and bake until fish flakes easily with a fork, about 3 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
