  "ingredients": [
    "1 pound pork sausage",
    "1 onion, chopped",
    "1 (15 ounce) can cream-style corn",
    "1.5 cups buttermilk self-rising cornmeal mix",
    "0.5 cup sour cream",
    "0.5 cup milk",
    "0.25 cup vegetable oil",
    "2 large eggs, lightly beaten",
    "2 cups shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a 10-inch oven-proof skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sausage and onion in a separate skillet over medium heat until sausage is browned and crumbly and onion is translucent, 5 to 7 minutes; drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix corn, cornmeal mix, sour cream, milk, oil, and eggs together in a large bowl; pour 1/2 of the mixture into the prepared skillet. Sprinkle with sausage mixture and Cheddar, then pour remaining cornmeal mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 40 minutes. Let stand 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
