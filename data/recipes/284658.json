  "ingredients": [
    "0.75 cup freshly squeezed orange juice",
    "0.5 cup freshly squeezed lime juice",
    "0.5 cup extra-virgin olive oil",
    "0.25 cup chopped fresh cilantro",
    "6 cloves garlic, pressed",
    "2 medium oranges, zested",
    "1 medium lime, zested",
    "2 teaspoons dried oregano",
    "1.5 teaspoons salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon ground cumin",
    "2 bay leaves",
    "4 (6 ounce) bone-in chicken thighs"
  ],
  "steps": [
    {
      "text": "Combine orange juice, lime juice, olive oil, cilantro, garlic, orange zest, lime zest, oregano, salt, pepper, cumin, and bay leaves in a large resealable bag. Add chicken thighs, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for at least 6 hours or overnight. Flip the bag over occasionally and rub over chicken thighs to evenly distribute marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken and marinade in a slow cooker. Cook on Low until chicken is no longer pink at the bone and the juices run clear, 4 to 5 hours. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
