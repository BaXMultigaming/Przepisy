  "ingredients": [
    "8 ounces diced canned peaches, drained",
    "1 red onion, chopped",
    "1 firm peach, chopped",
    "2 habanero peppers, seeded and minced",
    "8 sprigs fresh cilantro, minced",
    "0.25 cup tequila",
    "2 tablespoons fresh lime juice",
    "2 tablespoons extra-virgin olive oil",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine canned peaches, onion, fresh peach, habaneros, and cilantro in a bowl. Stir in tequila, lime juice, and olive oil to coat; season with salt and black pepper. Cover the bowl with plastic wrap; refrigerate before serving, 8 hours to overnight.",
