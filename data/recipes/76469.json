  "ingredients": [
    "1 pound jumbo shrimp, peeled and deveined",
    "5 large lemons, juiced, or as needed",
    "2 white onions, finely chopped",
    "1 large tomato, seeded and chopped",
    "1 cucumber, peeled and finely chopped",
    "1 bunch radishes, finely diced",
    "2 cloves fresh garlic, minced",
    "3 fresh jalapeno peppers, seeded and minced",
    "0.25 cup chopped fresh cilantro, or to taste",
    "tomato and clam juice cocktail",
    "tortilla chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M0EulJqvJ9fc1BgRWVzBiwR4TnQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76469-Mexican-Ceviche-ddmfs-step-1-056-9abe9236938f43b1ab7184e60d56f3a0.jpg"
      ],
      "image": "assets/images/76469/step_01.webp"
    },
    {
      "text": "Place shrimp in a bowl. You may either coarsely chop the shrimp, or leave them whole, depending on your preference. Add lemon juice, covering shrimp completely. Cover and refrigerate for 30 minutes, or until opaque and slightly firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V4swgZkdYWKVGmC_cSbN5eVnACU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76469-Mexican-Ceviche-ddmfs-step-2-067-25e1b98b7cd641fb993899331201e487.jpg"
      ],
      "image": "assets/images/76469/step_02.webp"
    },
    {
      "text": "Add onions, tomato, cucumber, radishes, and garlic; toss to combine. Gradually add jalapeño and cilantro to desired taste (jalapeño will grow stronger while marinating).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F13f6MbaA06TpA2iLmPjLfT8_rE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76469-Mexican-Ceviche-ddmfs-step-3-069-f3289d959f0e4563bbeeb6599d32ebe6.jpg"
      ],
      "image": "assets/images/76469/step_03.webp"
    },
    {
      "text": "Stir in tomato and clam juice cocktail to desired consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K0sNbx1BsohblvKT1Ki8lxNFfWA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76469-Mexican-Ceviche-ddmfs-step-4-071-ad7dd3f7ee174d3896c731a285025a15.jpg"
      ],
      "image": "assets/images/76469/step_04.webp"
    },
    {
      "text": "Cover and refrigerate for 1 hour. Serve chilled with tortilla chips.",
      "section": null,
      "name": null,
