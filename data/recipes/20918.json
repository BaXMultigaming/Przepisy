  "ingredients": [
    "2 cups milk",
    "0.75 cup white sugar",
    "2 eggs",
    "1 teaspoon vegetable oil",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1.5 tablespoons baking powder"
  ],
  "steps": [
    {
      "text": "Place milk, sugar, eggs, oil and vanilla in the blender. Add flour and baking powder. Blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle or frying pan over medium high heat. Pour or scoop the batter onto the griddle, using approximately 1/4 cup for each pancake. Brown on both sides and serve hot.",
      "section": null,
      "name": null,
