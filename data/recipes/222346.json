  "ingredients": [
    "3 cups water",
    "1.5 cups lemon juice",
    "1.25 cups white sugar",
    "2 tablespoons dried lavender flowers",
    "1.5 teaspoons dried hibiscus petals"
  ],
  "steps": [
    {
      "text": "Mix 3 cups water and lemon juice together in a large pitcher. Refrigerate until chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring remaining 3 cups water, sugar, lavender, and hibiscus to a boil in a medium saucepan. Reduce heat to medium-low and simmer for 10 minutes, then cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain lavender-hibiscus liquid through a sieve into a pitcher; discard solids. Stir lemon water into lavender-hibiscus liquid. Refrigerate until cold.",
      "section": null,
