  "ingredients": [
    "1 (3 pound) German bologna block",
    "0.5 cup distilled white vinegar",
    "2 tablespoons vegetable oil",
    "1 small onion, finely chopped",
    "1 tomato, thinly sliced",
    "0.5 teaspoon minced garlic",
    "0.5 teaspoon minced fresh chives",
    "0.5 teaspoon minced fresh parsley",
    "4 Polskie Ogorki (Polish Dill Pickles)"
  ],
  "steps": [
    {
      "text": "Slice bologna into 1/4-inch thick slices, and then into 1/4-inch strips going down the entire length of the block. It should look like big spaghetti. Place in a serving bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together vinegar and oil in a medium bowl. Stir in onion, tomato, garlic, chives, and parsley. Slice pickles lengthwise into spears and add them to the dressing. Pour over bologna, and stir to coat. Cover and refrigerate for 2 hours before serving. Serve cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
