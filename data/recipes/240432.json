  "ingredients": [
    "shortening for greasing",
    "2 cups cake flour",
    "1 (3.9 ounce) package instant chocolate fudge pudding mix",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground nutmeg",
    "1 (15 ounce) can pumpkin puree",
    "0.75 cup white sugar",
    "0.5 cup butter, softened",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "1 cup chopped walnuts",
    "1 cup miniature semisweet chocolate chips",
    "1 tablespoon raw sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a casserole dish or two 9x5-inch loaf pans with shortening.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cake flour, pudding mix, cinnamon, baking soda, baking powder, salt, and nutmeg together in a bowl. Beat pumpkin, white sugar, butter, egg, and vanilla extract together in a separate bowl using an electric mixer until smooth. Slowly spoon flour mixture into pumpkin mixture and mix until batter is smooth; stir in walnuts and chocolate chips. Spoon batter into the prepared dish and sprinkle raw sugar over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 45 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
