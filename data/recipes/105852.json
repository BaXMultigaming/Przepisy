  "ingredients": [
    "aluminum foil",
    "nonstick cooking spray",
    "8 large baking potatoes, peeled and diced",
    "1 (10 ounce) can condensed cream of mushroom soup",
    "1 bunch green onions, sliced",
    "1 cup shredded Cheddar cheese",
    "0.5 cup crumbled crisply cooked bacon",
    "0.5 cup sauteed mushrooms",
    "garlic salt to taste",
    "black pepper to taste",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat. Coat 8 aluminum foil squares with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together potatoes, condensed soup, green onions, cheese, bacon, and mushrooms in a large bowl until well combined. Season with garlic salt and pepper. Evenly divide mixture among the prepared aluminum foil squares. Dot each with butter. Fold into foil packets, sealing well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook foil packets on the preheated grill until potatoes are cooked through, 12 to 20 minutes,",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
