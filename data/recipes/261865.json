  "ingredients": [
    "2 cups gluten-free graham cracker crumbs",
    "0.5 cup butter, melted",
    "1 (14 ounce) can sweetened condensed milk",
    "1 (12 ounce) bag semisweet chocolate chips",
    "1 cup shredded coconut",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix graham cracker crumbs and melted butter together in a bowl; press into an 8x11-inch glass casserole dish. Pour condensed milk evenly over the crust. Sprinkle chocolate chips, coconut, and pecans evenly on top and press down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 25 to 30 minutes. Let cool before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
