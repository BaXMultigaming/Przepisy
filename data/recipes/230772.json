  "ingredients": [
    "6 carrots, peeled and chopped",
    "4 large parsnips, peeled and chopped",
    "2 turnips, peeled and chopped",
    "0.5 cup butter",
    "0.5 cup heavy whipping cream",
    "0.25 teaspoon ground nutmeg",
