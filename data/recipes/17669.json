  "ingredients": [
    "1 (8 ounce) can refrigerated crescent roll dough",
    "1 (8 ounce) package cream cheese",
    "1 teaspoon dried dill weed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll dough on lightly floured surface and press seams together. Sprinkle one side of block of cream cheese with enough dill to cover. Place cream cheese, dill side down, in center of dough. Sprinkle with more dill to cover. Bring sides of dough up around cheese block and seal to completely enclose.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for approximately 15 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
