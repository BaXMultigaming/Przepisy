  "ingredients": [
    "0.75 cup halved, thinly sliced red onion",
    "1 tablespoon fresh lime juice",
    "1.5 quarts seeded, cubed watermelon",
    "0.75 cup crumbled feta cheese",
    "0.5 cup pitted black olive halves",
    "1 cup chopped fresh mint",
    "2 tablespoons olive oil"
