  "ingredients": [
    "5 plain bagels, split",
    "1 (14 ounce) package cooked bacon, cut into 1/4-inch pieces",
    "1 cup prepared sausage gravy",
    "1 (8 ounce) package shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bagels onto a baking sheet with the cut sides up. Arrange bacon pieces atop the bagel halves. Spoon gravy lightly atop the bacon. Sprinkle mozzarella cheese over the gravy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the cheese melts, about 10 minutes.",
