  "ingredients": [
    "1 cup water",
    "1 cup white sugar",
    "1 (12 ounce) bag fresh cranberries, rinsed and drained",
    "3 medium jalapeño peppers, seeded and minced",
    "2 teaspoons lemon juice",
    "0.5 cup sherry"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i9VKu_CF9n5Inqqt3Koerm5to_Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9372-jalapeno-cranberry-sauce-VAT-step-01-a9a0670b16324af590dcdf32db72b52a.jpg"
      ],
      "image": "assets/images/9372/step_01.webp"
    },
    {
      "text": "Mix water and sugar together in a saucepan over medium heat until sugar is dissolved and mixture is boiling, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aYYCYM93a193NVK_Unk1XtH5wqc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9372-jalapeno-cranberry-sauce-VAT-step-02-ee413971d5e3499e8b0dfb40ac5fddb2.jpg"
      ],
      "image": "assets/images/9372/step_02.webp"
    },
    {
      "text": "Add cranberries, jalapeño peppers, and lemon juice; return to boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k4d12NMqD5JcR2_YkqPVlWPGT60=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9372-jalapeno-cranberry-sauce-VAT-step-03-fe55349df74b4d7eb477c1e59d46de5d.jpg"
      ],
      "image": "assets/images/9372/step_03.webp"
    },
    {
      "text": "Reduce heat to a gentle simmer and cook, stirring occasionally, until cranberries have broken down and sauce has thickened, 10 to 25 minutes. Stir in sherry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uEil_Z8fHI2Gggy_pOpcQeo_C18=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9372-jalapeno-cranberry-sauce-VAT-step-04-c1238f92bd0b4d65b80f4caf5f819c79.jpg"
      ],
      "image": "assets/images/9372/step_04.webp"
    },
    {
      "text": "Remove from the heat and let cool to room temperature. Serve or transfer to a glass container, cover, and refrigerate until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZDYzEUD-07oRW0NvuM_TXStnXQM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9372-jalapeno-cranberry-sauce-VAT-step-05-531aff44c0b144a5b033485681e89563.jpg"
      ],
      "image": "assets/images/9372/step_05.webp"
    }
  ],
