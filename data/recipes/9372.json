  "title": "Jalapeño Cranberry Sauce",
  "description": "A moderately spicy jalapeño cranberry sauce with sherry for extra flavor is easy to make for your holiday meal. Leftovers are great on sandwiches!",
  "authors": [
    "William Uncle Bill Anatooskin"
  ],
  "date_published": "1998-12-20T07:16:58-05:00",
