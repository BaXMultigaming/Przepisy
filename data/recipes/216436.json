  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 egg",
    "0.5 cup light mayonnaise",
    "3 ripe bananas, mashed",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking soda, and salt together in a medium bowl. Stir egg, mayonnaise, bananas, and vanilla extract together in a large bowl until well combined. Stir flour mixture into banana mixture until no dry lumps remain. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes. Cool in the pan for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
