  "ingredients": [
    "1.5 cups water",
    "0.75 cup white sugar",
    "4 eggs",
    "0.25 cup evaporated milk",
    "24 (3 inch) unbaked tart shells"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water and sugar in a saucepan and bring to a boil. Cook until sugar dissolves. Remove from heat and cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl. Add evaporated milk and continue beating until combined. Add sugar water, and mix until well combined. Place tart shells on a baking sheet. Strain custard through a sieve into a large cup with a spout. Fill tart shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until custard puffs slightly and is mostly firm, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
