  "ingredients": [
    "nonstick cooking spray",
    "2.5 cups all-purpose flour",
    "3 teaspoons pumpkin pie spice",
    "2 teaspoons cinnamon sugar",
    "0.5 teaspoon salt",
    "1 cup butter, softened",
    "1 cup brown sugar",
    "0.5 cup white sugar",
    "2 eggs",
    "1 tablespoon vanilla extract",
    "2 cups pumpkin puree",
    "1 cup chocolate chips",
    "1 cup butterscotch chips",
    "1 cup chopped hazelnuts",
    "0.75 cup caramel sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, pumpkin pie spice, cinnamon sugar, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together in the bowl of an electric stand mixer until creamy. Beat in eggs and vanilla extract until creamy. Beat in pumpkin until combined. Mix in flour mixture. Stir in chocolate chips, butterscotch chips, and hazelnuts. Spread 1/2 the batter into the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Remove from the oven and spread caramel sauce over the top. Top with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake until the top is light golden brown and the edges start to pull away from the dish, 30 to 35 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and transfer to a wire rack to cool completely, 20 to 30 minutes. Cut into bars and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
