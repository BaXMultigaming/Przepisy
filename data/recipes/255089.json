  "ingredients": [
    "2 cups whole wheat pastry flour",
    "0.5 cup brown sugar",
    "1 tablespoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 tablespoons butter",
    "0.5 cup dried cranberries",
    "0.5 cup chopped pecans",
    "0.5 cup skim milk, or more as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk whole wheat flour, brown sugar, baking powder, baking soda, and salt together in a large bowl. Cut in butter with a pastry blender until coarse crumbs form. Stir in cranberries and pecans. Mix in skim milk until dough comes together and is the consistency of cookie dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a lightly floured surface. Pat into a 1-inch thick round. Cut into 8 wedges with a greased knife. Arrange 2 inches apart on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 12 to 15 minutes. Transfer to a wire rack to cool, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
