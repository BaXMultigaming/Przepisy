  "ingredients": [
    "3 (15 ounce) cans asparagus, drained",
    "2 (10.75 ounce) cans condensed cream of mushroom soup",
    "4 hard-boiled eggs",
    "2 cups crushed buttery round crackers",
    "4 ounces shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mXurooRZADPQGxsQ3q4f2ULSLC4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24328-asparagus-casserole-ii-DDMFS-Step-01-069-c44d5bb29ebf4b8eb11776a5d5126a88.jpg"
      ],
      "image": "assets/images/24328/step_01.webp"
    },
    {
      "text": "Layer 1 ½ cans of asparagus in the prepared casserole dish. Top with 1 can mushroom soup, ½ of the sliced hard-boiled eggs, and 1 cup of crushed crackers. Repeat layers with remaining asparagus, soup, sliced eggs, and crackers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EDj4A1nPM1K5N9xsshtotlta-rs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24328-asparagus-casserole-ii-DDMFS-Step-02-070-594d566f94d647b2b60b57271791c805.jpg"
      ],
      "image": "assets/images/24328/step_02.webp"
    },
    {
      "text": "Cover and bake in preheated oven for 25 minutes. Remove cover and top with shredded cheese. Cover and bake an additional 5 minutes, or until cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
