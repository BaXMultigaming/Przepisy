  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cinnamon candies, butter, and corn syrup in a medium pot over medium heat. Bring to a boil and cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour hot syrup over popcorn in a large, heatproof bowl; stir to cover popcorn as evenly as possible. Spread popcorn out onto the prepared baking sheets.",
