  "ingredients": [
    "2 tablespoons unsalted butter",
    "0.5 pound skinless, boneless chicken breast",
    "1 (1 ounce) package dry ranch salad dressing mix (such as Hidden Valley Ranch®)",
    "1 large egg",
    "1 tablespoon milk",
    "0.75 cup plain bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place butter in 9x13-inch baking dish and let melt in the preheating oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice chicken breast against the grain into thin strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ranch dressing mix in a small bowl. Whisk egg and milk together in a second bowl. Place bread crumbs in a third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge each chicken strip in ranch dressing mix, then coat in egg mixture and cover with bread crumbs; arrange in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Gently turn chicken pieces over and bake until an instant-read thermometer inserted into the center reads 165 degrees F (74 degrees C), about 15 minutes longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow to rest 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
