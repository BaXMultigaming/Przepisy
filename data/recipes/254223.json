  "ingredients": [
    "6 cups boysenberries",
    "1 cup all-purpose flour",
    "1 egg",
    "1 teaspoon baking powder",
    "0.75 teaspoon salt",
    "0.33333334326744 cup butter, melted",
    "0.5 cup white sugar, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
