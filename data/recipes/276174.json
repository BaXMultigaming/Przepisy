  "ingredients": [
    "cooking spray",
    "2 tablespoons pure maple syrup",
    "1 tablespoon mayonnaise",
    "salt to taste",
    "0.5 cup panko bread crumbs",
    "0.25 cup chopped pecans",
    "4 medium skinless, boneless chicken breast halves, cut into strips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place a wire rack onto a baking sheet and lightly coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine maple syrup, mayonnaise, and salt in a bowl. Combine panko and pecans in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken in syrup mixture, then press into panko mixture. Place breaded chicken onto the prepared rack. Repeat with remaining chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into centers reads at least 165 degrees F (74 degrees C), 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
