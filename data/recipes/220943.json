  "title": "Chef John’s Buttermilk Biscuits",
  "description": "These homemade buttermilk biscuits are buttery and tender. Ice-cold butter and some extra dough folding are key to having lots of flaky layers in each golden brown biscuit.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-04-03T13:17:38-04:00",
  "date_modified": "2026-03-19T13:25:53-04:00",
  "prep_time": "PT20M",
  "cook_time": "PT15M",
  "total_time": "PT35M",
  "yield": [
    "12",
    "12 biscuits"
  ],
  "categories": [
    "Breakfast",
