  "ingredients": [
    "2 tablespoons hot water",
    "2 tablespoons white sugar",
    "1 tablespoon instant coffee granules",
    "1.5 teaspoons pumpkin pie spice",
    "1 cup 2% milk",
    "0.25 cup pumpkin puree",
    "1 tablespoon maple syrup",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Whip hot water, sugar, instant coffee, and pumpkin pie spice together with a mixer or by hand until mixture is light and has thick to soft peaks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix milk, pumpkin puree, maple syrup, and vanilla together in a separate bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk mixture into a serving glass and spoon coffee mixture on top. If desired, mix them together for that wonderful pumpkin pie flavor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
