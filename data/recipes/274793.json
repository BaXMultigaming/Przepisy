  "ingredients": [
    "1 cup butter",
    "0.75 cup white sugar",
    "0.75 cup brown sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 (10 ounce) bag white chocolate chips",
    "1.5 cups dried tart cherries",
    "1 cup slivered almonds, toasted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, white sugar, brown sugar, eggs, vanilla extract, and almond extract in a large mixing bowl; beat with an electric mixer on medium speed until thoroughly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and baking soda in a separate bowl; gradually add to the butter mixture, mixing until incorporated. Stir in white chocolate chips, cherries, and almonds. Drop teaspoonfuls of dough onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
