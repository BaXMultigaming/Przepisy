  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, white chocolate chips, toffee chips, eggs, vegetable oil, and brown sugar in a large bowl; mix until dough comes together. Form dough into 2-inch balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour confectioners' sugar into a shallow bowl. Roll each ball of dough in the confectioners' sugar until coated. Arrange on an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
