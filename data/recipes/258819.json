  "ingredients": [
    "1.75 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "1 cup butter",
    "0.75 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 teaspoon vanilla extract",
    "1 egg",
    "1 cup semisweet chocolate chips",
    "0.75 cup chopped pecans",
    "3 ounces chopped white chocolate"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and baking soda together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, brown sugar, and vanilla extract in a bowl with an electric mixer until fluffy. Beat egg into the mixture using a wooden spoon. Stir in flour mixture until fully combined. Fold chocolate chips, pecans, and white chocolate into the dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded teaspoonfuls onto 4 ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
