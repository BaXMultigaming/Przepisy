  "ingredients": [
    "4 medium russet potatoes, scrubbed",
    "0.25 cup unsalted butter, melted",
    "1 cup shredded Colby-Monterey Jack cheese",
    "0.25 teaspoon seasoned salt",
    "0.33333334326744 cup crumbled cooked bacon",
    "0.25 cup sour cream",
    "2 stalks scallions, thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Prick potatoes several times with a fork and place onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are easily pierced with a fork, 1 to 1 1/2 hours. Remove from the oven. Turn on the broiler to the low setting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When potatoes are cool enough to handle, cut them lengthwise and scoop out flesh to within 1/4 inch of skin. Reserve flesh for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush inside of potato skins with butter. Add 2 tablespoons cheese to each one, sprinkle with seasoned salt, and top with bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and broil until cheese is melted, 2 to 3 minutes. Serve with sour cream and scallions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
