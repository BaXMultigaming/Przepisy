  "ingredients": [
    "2 cups water",
    "1 cup quinoa, rinsed and drained",
    "0.25 teaspoon salt",
    "1.5 teaspoons olive oil, or as needed",
    "1 medium bell pepper, chopped",
    "1 tablespoon sliced green onions",
    "1 clove garlic, minced",
    "3 large eggs, whisked",
    "2 tablespoons soy sauce",
    "1 tablespoon sriracha sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Combine water, quinoa, and salt in a pot over medium-high heat; bring to a boil. Reduce heat to medium-low, cover, and simmer until all water has been absorbed, about 15 minutes. Remove from the heat and fluff with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium heat. Add bell pepper and saute until soft, about 5 minutes. Add garlic and saute until fragrant, about 30 seconds. Pour eggs into the skillet; cook and stir until eggs are set, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the egg-vegetable mixture into the quinoa. Add soy sauce and sriracha and garnish with green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
