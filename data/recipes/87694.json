  "ingredients": [
    "3 cups peeled and sliced carrots",
    "2 tablespoons butter",
    "2 tablespoons brown sugar",
    "1.5 tablespoons chopped fresh dill",
    "0.5 teaspoon salt",
    "0.5 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "Place carrots in a skillet and pour in just enough water to cover. Bring to a boil over medium heat; simmer until water has evaporated and the carrots are tender. Stir in butter, brown sugar, dill, salt, and pepper.",
