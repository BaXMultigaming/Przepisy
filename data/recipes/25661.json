  "ingredients": [
    "3 pounds ground beef",
    "2 onions, chopped",
    "2 (16 ounce) packages frozen corn kernels",
    "2 (15 ounce) cans pinto beans",
    "3 (10 ounce) cans diced tomatoes with green chile peppers",
    "6 serrano peppers, crushed",
    "1 (1.25 ounce) package taco seasoning mix",
    "1 (1 ounce) package ranch dressing mix",
    "cold water, as needed"
  ],
  "steps": [
    {
      "text": "Cook and stir ground beef in a large pot over medium heat until crumbly and browned, 5 to 7 minutes. Stir in onion and cook for 2 to 3 minutes more. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir corn, pinto beans, diced tomatoes with green chiles, serrano peppers, taco seasoning, and ranch dressing mix into beef-onion mixture. Fill the pot with water to come within 2 inches of the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil and cook for 30 minutes, stirring occasionally. Reduce heat and simmer for 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
