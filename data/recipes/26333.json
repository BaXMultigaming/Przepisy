  "ingredients": [
    "1 (9 inch) unbaked pie crust",
    "0.5 cup brown sugar",
    "2 tablespoons all-purpose flour",
    "1.25 cups maple syrup",
    "3 tablespoons butter",
    "0.25 teaspoon salt",
    "3 eggs",
    "1.5 teaspoons maple flavored extract",
    "1 cup walnut halves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan, Mix brown sugar and flour. Add maple syrup, butter and salt. Heat until butter melts, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat eggs with maple flavoring. Stir in sugar mixture. Pour into unbaked pie shell and sprinkle with walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 to 45 minutes, or until filling is set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
