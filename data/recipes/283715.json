  "ingredients": [
    "4 cups all-purpose flour, sifted",
    "1 cup confectioners' sugar, sifted",
    "7 ounces unsalted butter, melted",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Put flour in a wide saucepan. Cook and stir over medium heat until fragrant, about 15 minutes. Don't let it turn yellow. Add sugar slowly, mixing well, until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add melted butter and vanilla to the mixture. Mix all by a spoon or your hands, but be careful, as it can be very hot, until it has a sand-like consistency. Transfer to a 9x9-inch pan, pressing down as much as you can.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut the mixture into a baklava shape or squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill until set, 1 to 2 hours. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
