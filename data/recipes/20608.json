  "ingredients": [
    "cooking spray",
    "6 bone-in chicken breast halves, with skin",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon hickory-flavored liquid smoke",
    "2 teaspoons chili powder",
    "2 teaspoons ground cumin",
    "2 teaspoons garlic powder",
    "2 teaspoons dried thyme",
    "2 teaspoons dried oregano",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange chicken, skin-side up, in the prepared baking dish, leaving a bit of room between each piece. Drizzle chicken with Worcestershire sauce and liquid smoke, then sprinkle with chili powder, cumin, garlic powder, thyme, oregano, salt, and pepper. Cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink at the bone and the juices run clear, 1 to 1 1/2 hours. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
