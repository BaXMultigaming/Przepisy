  "steps": [
    {
      "text": "Grate the zest of 2 limes; squeeze juice from 1 lime. Reserve separately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 cups water, Knorr® Rice SidesTM- Chicken Broccoli Rice, diced chicken, roasted garlic, black pepper, and lime zest in a pot. Bring to a boil over high heat; stir. Reduce heat and cover. Simmer over low heat until most of the water has been absorbed, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
