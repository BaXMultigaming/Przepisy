  "ingredients": [
    "5 pounds potatoes, cut into wedges",
    "1 cup water",
    "0.75 cup olive oil",
    "0.25 cup fresh lemon juice",
    "6 cloves garlic, minced",
    "sea salt to taste",
    "ground black pepper to taste",
    "1.5 tablespoons dried oregano",
    "1 teaspoon chopped fresh mint",
    "1 (8 ounce) package crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Lightly oil a large baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together potatoes, water, olive oil, lemon juice, garlic, salt, and pepper in a large bowl until potatoes are evenly coated. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until potatoes begin to brown, about 40 minutes. Season potatoes with oregano and mint. If mixture appears dry, pour another 1/2 cup water into the dish. Return to the oven and bake until potatoes are very tender, about 40 minutes more. Top with feta cheese to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
