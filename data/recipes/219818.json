  "ingredients": [
    "0.25 cup butter",
    "2 onions, finely chopped",
    "1 teaspoon paprika",
    "1 cup red lentils",
    "0.5 cup fine bulgur",
    "2 tablespoons tomato paste",
    "8 cups vegetable stock",
    "0.125 teaspoon cayenne pepper",
    "1 tablespoon dried mint leaves",
    "4 slices lemon",
    "0.5 teaspoon chopped fresh mint"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan over low heat. Cook onions in hot butter until golden brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir paprika, lentils, and bulgur into onions to coat with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomato paste, vegetable stock, and cayenne pepper; bring to a boil and cook until soft and creamy, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble dried mint leaves into soup; stir and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle into bowls and garnish with lemon slices and fresh mint to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
