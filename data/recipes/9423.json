  "ingredients": [
    "0.25 cup packed brown sugar",
    "1 cinnamon stick",
    "1 teaspoon whole cloves",
    "0.5 teaspoon whole allspice",
    "0.25 teaspoon salt",
    "1 pinch ground nutmeg",
    "1 large orange, quartered with peel",
    "2 quarts apple cider"
  ],
  "steps": [
    {
      "text": "Place a filter in the basket of an automatic coffee maker. Add brown sugar, cinnamon stick, cloves, allspice, salt, and nutmeg to the basket; top with orange wedges. Pour apple cider into the water reservoir.",
