  "ingredients": [
    "Mazola Pure® No-Stick Canola or Butter Flavored Cooking Spray",
    "1.25 cups all-purpose flour",
    "0.5 cup sugar",
    "2 teaspoons Argo® Baking Powder",
    "0.25 teaspoon salt",
    "1 large egg",
    "0.75 cup mashed bananas",
    "0.5 cup Mazola® Corn Oil",
    "0.5 teaspoon Spice Islands® Pure Vanilla Extract",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray an 8 1/2x4 1/2-inch loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, and salt in a medium mixing bowl. Whisk together egg, bananas, oil, and vanilla in another bowl. Add to flour mixture and stir until flour is moistened. Fold in walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden brown, 35 to 40 minutes. A wooden pick inserted in the center should come out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer loaf pan to a rack to cool for 10 minutes before turning out of the pan. Serve warm or store in an air-tight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
