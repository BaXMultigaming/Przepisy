  "ingredients": [
    "3 cups diced fresh rhubarb",
    "2 cups diced fresh strawberries",
    "0.5 cup white sugar, divided",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1 pinch salt",
    "0.66666668653488 cup white sugar",
    "0.66666668653488 cup butter, at room temperature",
    "1 large egg",
    "0.5 teaspoon almond extract",
    "1 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine rhubarb, strawberries, and 1/4 cup sugar in a bowl; transfer to the prepared baking pan. Sprinkle 1/4 cup sugar on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, baking soda, and salt together in a bowl. Beat 2/3 cup sugar and butter in a large bowl with an electric mixer on medium speed until fluffy, 4 to 5 minutes; beat in egg and almond extract until incorporated, about 3 minutes. Add flour mixture, alternating with sour cream, mixing until just incorporated; batter will be thick. Spoon batter evenly over rhubarb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
