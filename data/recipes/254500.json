  "ingredients": [
    "1 (15 ounce) package double crust ready-to-use pie crust",
    "4 cups Bing cherries, pitted and sliced",
    "1 cup white sugar",
    "0.25 cup instant tapioca",
    "2 tablespoons lemon juice",
    "0.25 teaspoon almond extract",
    "1 tablespoon unsalted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Press one pie crust into a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cherries, sugar, tapioca, lemon juice, and almond extract in bowl; refrigerate until cherry filling begins to set, about 10 minutes. Stir filling; chill until flavors combine, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour filling into bottom crust in pie plate; dot with butter. Cover with remaining 1 crust; crimp edges to seal. Cut several ventilation slits into top crust with a sharp knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes; quarter rotate pie. Continue baking until crust is golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
