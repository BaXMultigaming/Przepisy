  "ingredients": [
    "3 cups water",
    "2 tablespoons black tea leaves",
    "1 tablespoon soy sauce",
    "1 tablespoon black soy sauce",
    "1 tablespoon tangerine zest",
    "1 (2 inch) piece cinnamon stick",
    "2 pods star anise",
    "1.25 teaspoons salt, divided",
    "8 large eggs"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HUlF3bY8PPc2ymfQQrNN2kHSY2E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-51326-chinese-tea-leaf-eggs-VAT-step-01-289d6cdb86b24593900717ece5e14f87.jpg"
      ],
      "image": "assets/images/51326/step_01.webp"
    },
    {
      "text": "Combine 3 cups water, tea leaves, soy sauce, black soy sauce, zest, cinnamon stick, star anise, and 1/4 teaspoon salt in a large saucepan; bring to a boil. Reduce heat, cover, and simmer for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rc-ka-cQL2EO3Nuldijbx5PmTx4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-51326-chinese-tea-leaf-eggs-VAT-step-02-313b719a4b50460c97ce4d9c7fe67160.jpg"
      ],
      "image": "assets/images/51326/step_02.webp"
    },
    {
      "text": "Meanwhile, place eggs and remaining 1 teaspoon salt into a medium pot; cover with cold water. Bring to a boil, reduce heat, and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7HUwh2lrhoXshYmUpCYmhY7RPM4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-51326-chinese-tea-leaf-eggs-VAT-step-03-2lidoff-5e76a07ea1014fdeb6215ffeed756280.jpg"
      ],
      "image": "assets/images/51326/step_03.webp"
    },
    {
      "text": "Remove from heat, drain, and cool. Tap cooled eggs with the back of a spoon to crack shells; do not remove shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f-s7QiJqzcSVsF3i7SQq6A6GGuI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-51326-chinese-tea-leaf-eggs-VAT-step-04-6dfaf2871d6741a48112060cb56732e4.jpg"
      ],
      "image": "assets/images/51326/step_04.webp"
    },
    {
      "text": "Remove the saucepan from the heat. Add eggs and let steep for at least 8 hours, or for a richer flavor, up to 1 ½ days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XJW599GeOo_E3YOGIqpmMjqeFsw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-51326-chinese-tea-leaf-eggs-VAT-step-05-7eb541a5d99f477d923d3b7221f2dcaa.jpg"
      ],
      "image": "assets/images/51326/step_05.webp"
    }
  ],
