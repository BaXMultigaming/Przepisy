  "title": "Greek Rice Salad",
  "description": "This Greek rice salad recipe mixes avocado, tomato, and brown rice, tossed with cucumber, Kalamata olives, mint, and feta cheese for a tasty dish.",
  "authors": [
    "Audrey Noland"
  ],
  "date_published": "2019-07-10T03:01:47-04:00",
