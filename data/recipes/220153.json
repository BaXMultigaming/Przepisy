  "title": "Broken Glass Cake",
  "description": "This broken glass cake is easy to make with 3 different colors of gelatin and whipped cream in a graham cracker crust for a fun retro dessert.",
  "authors": [
    "Chessenden"
  ],
  "date_published": "2020-06-18T23:47:30-04:00",
  "date_modified": "2026-04-15T23:07:23-04:00",
