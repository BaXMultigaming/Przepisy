    "Dessert"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 (3 ounce) package lime flavored Jell-O® mix",
    "1 (3 ounce) package orange flavored Jell-O® mix",
    "1 (3 ounce) package strawberry flavored Jell-O®",
    "3 cups boiling water, divided",
    "3 cups cold water, divided",
    "1 cup canned pineapple juice",
    "1 (.25 ounce) package unflavored gelatin",
    "2.5 cups graham cracker crumbs",
    "0.5 cup butter, melted",
    "0.5 cup brown sugar",
    "2 cups chilled heavy cream",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d-JxZmzPtgpzPY5ibcpCA6NI2Dw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220153-broken-glass-cake-VAT-step-01-387a10e75df945d5aa80b3d39ce6c9ac.jpg"
      ],
      "image": "assets/images/220153/step_01.webp"
    },
    {
      "text": "Place lime, orange, and strawberry gelatin mixes into 3 separate 9x9-inch glass dishes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jjXVlzfle75qF-QgNmQMNSKdKmg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220153-broken-glass-cake-VAT-step-02-7b3804835c524be9a98dea0fdd9b61d3.jpg"
      ],
      "image": "assets/images/220153/step_02.webp"
    },
    {
      "text": "Pour 1 cup boiling water into each flavor of gelatin mix; stir the gelatin until dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0dFOy54q-M4JkGBT-k-P1yQUrg8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220153-broken-glass-cake-VAT-step-03-44692da9b187455b9c5059bb3f096757.jpg"
      ],
      "image": "assets/images/220153/step_03.webp"
    },
    {
      "text": "Pour 1 cup cold water into each flavor of gelatin, stir to combine, and refrigerate the 3 flavors of gelatin until set, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h4fP0b58I1DdRdDbEw2jqdiOsVI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220153-broken-glass-cake-VAT-step-04-4f8242f572d24269aaae244fccb5a808.jpg"
      ],
      "image": "assets/images/220153/step_04.webp"
    },
    {
      "text": "Heat pineapple juice in a saucepan until hot but not simmering. Stir unflavored gelatin into pineapple juice until dissolved. Refrigerate pineapple juice mixture until cool and thickened, about 30 minutes. Stir occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9eHmULJcbEjVoeb-NMFN0bvt1JU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220153-broken-glass-cake-VAT-step-05-f1e7268bf06548e1842c957d70436408.jpg"
      ],
      "image": "assets/images/220153/step_05.webp"
    },
    {
      "text": "Mix graham cracker crumbs, melted butter, and brown sugar together in a bowl. Set 1 cup of crumb mixture aside for garnish. Press remaining 2 cups crumb mixture into the bottom of a 9x13-inch cake pan to make a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W3Mp743TQO05PMJ1-EjFR2vdGlA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220153-broken-glass-cake-VAT-step-06-f1585ec038024f9aa7185d3c2321ede9.jpg"
      ],
      "image": "assets/images/220153/step_06.webp"
    },
    {
      "text": "Pour cream into a large metal mixing bowl and beat with an electric mixer until the cream is fluffy and forms soft peaks, about 3 minutes. Slowly beat sugar into whipped cream, 1 or 2 tablespoons at a time; beat in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4Ox3lzm7UK9yR6tv9JzPJfFA8VM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220153-broken-glass-cake-VAT-step-07-aafaf9491eea4499902c68c4351ce69d.jpg"
      ],
      "image": "assets/images/220153/step_07.webp"
    },
    {
      "text": "Cut the different flavors of gelatin into cubes. Use a thin spatula to lift the cubes away from the bottom of the dish and loosen them.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HVjsSFF66saT_nsnoUqUfIQ3HFo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220153-broken-glass-cake-VAT-step-08-cb92563dc5b142699eb1d8d053206c11.jpg"
      ],
      "image": "assets/images/220153/step_08.webp"
    },
    {
      "text": "Very gently fold the thickened pineapple juice and gelatin cubes into the whipped cream mixture until thoroughly combined. Spoon into the graham cracker crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FhIxC_iGL_Fbm8MWLYrjpQdADts=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220153-broken-glass-cake-VAT-step-09-2a0e8306675d481caf80c88138cd71f6.jpg"
      ],
      "image": "assets/images/220153/step_09.webp"
    },
    {
      "text": "Sprinkle the cake with reserved graham cracker crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tzL87Rz3kB2MGM_4RQBP3_akKIs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220153-broken-glass-cake-VAT-step-10-87ac0126cb434ab9a52f7334a4ad1762.jpg"
      ],
      "image": "assets/images/220153/step_10.webp"
    },
    {
      "text": "Refrigerate until set, at least 3 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nUt6VLVpbMeLYEuyqgqeY73LBuM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220153-broken-glass-cake-VAT-Beauty-4x3-c0b25bdad951400d85183a2558dd636c.jpg"
      ],
      "image": "assets/images/220153/step_11.webp"
    }
  ],
