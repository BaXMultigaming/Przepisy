  "ingredients": [
    "1 pie pumpkin"
  ],
  "steps": [
    {
      "text": "Cut stem off pumpkin using a strong knife to create a hole; scoop and scrape pulp and seeds from pumpkin, saving seeds to roast. Cut pumpkin in quarters; cut quarters in half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pumpkin pieces in a microwave-safe bowl; cover tightly with plastic wrap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the microwave for 7 minutes; check plastic wrap seal to ensure no moisture is escaping. Continue cooking in the microwave for 8 minutes more; remove plastic wrap. Cool pumpkin for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel skin from pumpkin using your fingers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer peeled pumpkin to the bowl of a food processor; pulse until puréed. (Or purée pumpkin using a hand masher or potato ricer.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
