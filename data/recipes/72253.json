  "ingredients": [
    "1 pound dry navy beans",
    "2 quarts water",
    "2 cups cubed cooked ham",
    "2 medium potatoes, peeled and diced",
    "3 carrots, peeled and shredded",
    "3 stalks celery, sliced",
    "1 medium onion, diced"
  ],
  "steps": [
    {
      "text": "Cover beans with several inches of cool water in a large container. Let soak, 6 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain beans and place into a slow cooker. Add enough water to cover, then mix in ham, potatoes, carrots, celery, and onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on High for 3 1/2 hours. Switch to Low and continue cooking for at least 6 1/2 hours. The longer it cooks the more flavorful it becomes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
