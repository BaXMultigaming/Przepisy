  "ingredients": [
    "2 (14 ounce) cans sweetened condensed milk",
    "6 egg yolks",
    "0.5 cup lemon juice",
    "2 teaspoons lemon zest",
    "1 (8 inch) deep dish graham cracker pie crust",
    "6 egg whites",
    "0.25 cup white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sweetened condensed milk, egg yolks, lemon juice, and lemon zest together in a bowl until smooth; pour into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites with an electric mixer in a glass or metal bowl until foamy. Gradually add sugar and vanilla extract, continuing to beat until stiff peaks form. Lift your beater or whisk straight up: the egg whites will form sharp peaks; spoon onto the pie to cover completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pie in preheated oven until the tips of the topping begin to brown, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
