  "ingredients": [
    "0.25 cup all-purpose flour",
    "1.25 teaspoons Cajun seasoning, divided",
    "1 pound turkey cutlets",
    "2 tablespoons olive oil",
    "0.5 cup dry white wine"
  ],
  "steps": [
    {
      "text": "Combine flour and 1 teaspoon Cajun seasoning in a shallow dish; dredge turkey cutlets in flour mixture, shaking off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook turkey in hot oil until no longer pink in the center, 2 to 3 minutes on each side. Transfer turkey to a serving platter and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add wine and remaining Cajun seasoning to the skillet; cook until liquid is reduced by half, stirring to loosen particles from the bottom of the skillet, 1 to 2 minutes. Drizzle sauce over turkey. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
