  "title": "Cherry Tomato Pasta",
  "description": "This cherry tomato pasta dish is a delicious combination of roasted cherry tomatoes, garlic, and basil tossed with ricotta to make a rich and creamy sauce.",
  "authors": [
    "Scott Koeneman"
  ],
  "date_published": "2010-08-02T00:04:39-04:00",
