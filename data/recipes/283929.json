  "ingredients": [
    "2 pounds red cherry tomatoes, halved",
    "0.5 pound tomatoes, roughly chopped",
    "3 cloves garlic, thinly sliced",
    "3 tablespoons chicken broth",
    "1 tablespoon olive oil",
    "1 tablespoon balsamic vinegar",
    "1 teaspoon red pepper flakes",
    "0.75 teaspoon salt",
    "0.5 teaspoon freshly ground black pepper",
    "0.25 cup julienned fresh basil leaves",
    "2 tablespoons chopped flat-leaf parsley",
    "1 tablespoon chopped fresh oregano",
    "12 ounces whole wheat linguine",
    "0.5 (16 ounce) container low-fat ricotta cheese",
    "0.5 cup finely shredded Pecorino Romano cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine all tomatoes, garlic, chicken broth, olive oil, balsamic vinegar, red pepper flakes, salt, and pepper in a large, glass baking dish; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BzuJmmQGUv7dMrwa2FpWWpqnuDs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283929-RoastedCherryTomatoPasta-MFS-Step1-0150-5ada49cabdc4430692265d966bffd9e6.jpg"
      ],
      "image": "assets/images/283929/step_02.webp"
    },
    {
      "text": "Roast in the middle of the preheated oven, stirring regularly, until tomatoes are tender, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and stir in basil, parsley, and oregano.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dTayef5XqtIJzTSG0R4nphnfNDY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283929-RoastedCherryTomatoPasta-MFS-Step2-0169-91d7accd4a49442aaea1b87c5e3b06dd.jpg"
      ],
      "image": "assets/images/283929/step_04.webp"
    },
    {
      "text": "When the tomatoes have been roasting for about 35 minutes, bring a large pot of lightly salted water to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook linguine at a boil until tender yet firm to the bite, 5 to 7 minutes (cook for 2 minutes less than package directions.) Drain and return to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lelVpK8q2_cmc3KSm5lLPq4Xg08=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283929-RoastedCherryTomatoPasta-MFS-Step3-0153-de4728db043d4e959dbc80bd2d3b6af4.jpg"
      ],
      "image": "assets/images/283929/step_06.webp"
    },
    {
      "text": "Add the roasted tomatoes and herbs to the linguine and cook over medium-low heat for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yj71o7AKBzF5oggj8EdDTvUKi5s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283929-RoastedCherryTomatoPasta-MFS-Step4-0171-9a457bca50f74a3e81786262d13a5582.jpg"
      ],
      "image": "assets/images/283929/step_07.webp"
    },
    {
      "text": "Add ricotta cheese and stir until melted and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CLsv9_iWm4EjL3BXwav3tWfN2Uw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283929-RoastedCherryTomatoPasta-MFS-Step5-0188-13e0560a6b874489b17435a2862d8f71.jpg"
      ],
      "image": "assets/images/283929/step_08.webp"
    },
    {
      "text": "Serve topped with Pecorino Romano cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
