  "ingredients": [
    "1 pound ground beef",
    "8 (6 inch) corn tortillas",
    "1 small onion, diced",
    "1 pound processed cheese food, shredded",
    "1 (4 ounce) can green chile peppers, chopped",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease a medium sized casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium skillet over medium heat, cook the ground beef until evenly browned; drain fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place half of the tortillas on the bottom of the prepared casserole dish and spread with half of the onion, cheese, ground beef and chiles. Layer with the remaining tortillas, onion, half of the remaining cheese, ground beef and chiles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, dilute the soup with milk and pour over the top of the casserole. Bake in the preheated oven for 30 minutes. Sprinkle with the remaining cheese and bake for another 5 to 10 minutes, or until the cheese has melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
