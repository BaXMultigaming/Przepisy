  "ingredients": [
    "0.25 cup vegetable oil for frying, or as needed",
    "1.25 cups all-purpose flour, or more if needed",
    "0.5 cup white sugar",
    "0.5 cup water",
    "0.5 cup milk",
    "1 egg",
    "1 tablespoon baking powder",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Pour enough oil into a skillet to completely coat the bottom and heat over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend flour, sugar, water, milk, egg, baking powder, vanilla extract, and salt together in a blender until smooth. Add more flour if batter is too watery. Put your finger over the hole of a funnel and fill funnel with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Hover filled funnel over the skillet, release finger, and swirl batter into the hot oil; cook until golden brown, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
