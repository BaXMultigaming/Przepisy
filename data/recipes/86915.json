  "ingredients": [
    "3 tablespoons bacon drippings",
    "2 large onions, chopped",
    "8 pounds beef stew meat, or coarse ground chili beef",
    "4 tablespoons ground red chile pepper",
    "4 tablespoons mild chili powder",
    "5 cloves garlic, finely chopped",
    "1 tablespoon ground cumin",
    "0.25 cup sweet Hungarian paprika",
    "1 teaspoon dried Mexican oregano",
    "3 (10 ounce) cans tomato sauce",
    "3 cups water",
    "1 (6 ounce) can tomato paste",
    "0.25 cup dried parsley",
    "1 fresh jalapeno peppers",
    "2 tablespoons salt",
    "1 cup masa harina flour"
  ],
  "steps": [
    {
      "text": "Melt bacon drippings in a large, heavy pot over medium heat. Cook and stir onions in hot drippings until translucent.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beef, red chile pepper, chili powder, garlic, and cumin in a large bowl. Add to onions in the pot. Cook and stir until meat is crumbly and evenly browned (very browned, not just gray), about 30 minutes. Sprinkle in Hungarian paprika and oregano.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in tomato sauce, water, tomato paste, parsley, jalapeño peppers, and salt. Bring to a boil, then reduce heat and simmer, uncovered, for 1 hour. During cooking you may squeeze the jalapeño peppers as it softens against the sides of the pot to release more heat if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in masa harina. Cook and stir until desired consistency is achieved, about 30 minutes. Taste and adjust seasonings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
