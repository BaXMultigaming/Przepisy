  "ingredients": [
    "6 large potatoes, peeled and cubed",
    "0.25 cup butter",
    "10 cups water",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "2.5 pounds kale - rinsed, dried and chopped",
    "0.66666668653488 pound kielbasa sausage, sliced into 1/2 inch pieces"
  ],
  "steps": [
    {
      "text": "Place the potatoes into a large stockpot, over medium high heat. Add butter and water, and bring to a boil. Cook potatoes until tender, about 20 minutes. Reserve the cooking liquid and mash potatoes in the pan until smooth. Return the potato water to the pot and stir in salt and pepper. Simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the fresh kale and sausage and simmer for another 30 minutes. Serve hot.",
