  "ingredients": [
    "1 small onion, diced",
    "1 (6 ounce) can salmon, drained and flaked",
    "8 crackers, crushed, or more to taste",
    "1 egg, beaten",
    "1 tablespoon butter, softened",
    "1 tablespoon lemon juice",
    "1 teaspoon ground black pepper",
    "3 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Mix onion, salmon, crackers, egg, butter, lemon juice, and black pepper together in a bowl; form into 4 patties.",
