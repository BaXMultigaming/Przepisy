  "ingredients": [
    "1 cup mayonnaise",
    "1 tablespoon lime juice",
    "1 tablespoon ground cumin",
    "1 teaspoon cayenne pepper",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 medium head green cabbage, rinsed and very thinly sliced",
    "1 large carrot, shredded",
    "2 green onions, sliced",
    "2 radishes, sliced"
  ],
  "steps": [
    {
      "text": "Whisk together mayonnaise, lime juice, cumin, cayenne, salt, and pepper in a large bowl. Add cabbage, carrot, green onions, and radishes and stir until well-combined. Chill at least 1 hour before serving.",
