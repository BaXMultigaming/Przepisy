  "ingredients": [
    "1 frozen banana, thawed for 10 to 15 minutes",
    "0.5 cup vanilla soy milk",
    "1 cup vanilla fat-free yogurt",
    "1.5 teaspoons flax seed meal",
    "1.5 teaspoons honey",
    "0.66666668653488 cup frozen blueberries"
