  "ingredients": [
    "3 cups all-purpose flour",
    "1.5 teaspoons salt",
    "1.5 teaspoons baking powder",
    "3 tablespoons poppy seeds",
    "1.5 teaspoons butter flavored extract",
    "1.3333333730698 cups vegetable oil",
    "3 eggs",
    "1.5 cups milk",
    "2.25 cups white sugar",
    "1.5 teaspoons vanilla extract",
    "1.5 teaspoons almond extract",
    "0.25 cup orange juice",
    "0.5 teaspoon butter flavored extract",
    "0.5 teaspoon almond extract",
    "1 teaspoon vanilla extract",
    "2 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease bottoms of two 9-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, salt, baking powder, poppy seeds, 1 ½ teaspoons butter flavoring, oil, eggs, milk, sugar, vanilla, and almond flavoring together in a large bowl. Pour into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the loaves comes out clean, about 1 hour. Cool loaves for 5 minutes, then poke holes in top of loaves; pour glaze over top of bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the glaze: Mix orange juice, 1/2 teaspoon butter flavoring, 1/2 teaspoon almond flavoring, and 1 teaspoon vanilla together in a bowl; stir in enough confectioners' sugar to make a smooth glaze.",
      "section": null,
      "name": null,
