  "title": "Carrots Au Gratin",
  "description": "A rich and creamy carrot and cheese casserole with a buttery, crunchy topping. An excellent complement to honey glazed ham.",
  "authors": [
    "Sharon"
  ],
  "date_published": "2000-09-24T03:02:40-04:00",
