  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "2 eggs",
    "0.5 cup butter, softened",
    "0.5 teaspoon salt",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon vanilla extract",
    "1 cup chopped walnuts",
    "1 (21 ounce) can apple pie filling",
    "2 cups confectioners' sugar",
    "0.5 cup butter, softened",
    "1 teaspoon vanilla extract",
    "3 ounces cream cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour one 9x13 inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dump the flour, white sugar, eggs, 1/2 cup butter or margarine, salt, baking soda, cinnamon, 1 teaspoon vanilla, chopped nuts, and fruit pie filling into a bowl and stir. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Icing: Mix together until fluffy the confectioner's sugar, 1/2 cup butter or margarine, 1 teaspoon vanilla, and the cream cheese. Spread icing on top of cooled cake.",
