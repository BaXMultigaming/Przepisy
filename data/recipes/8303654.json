  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "0.25 cup unsalted butter",
    "1 cup light brown sugar",
    "1 cup light corn syrup",
    "2 teaspoons kosher salt",
    "1 teaspoon pure vanilla extract",
    "2 tablespoons bourbon whiskey",
    "4 large eggs",
    "3 cups pecan halves, coarsely chopped",
    "2 tablespoons unsalted butter, softened",
    "6 large croissants"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4t0Fv1eoA_4fCXxpRbWcEn-i2E4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8303654-mini-croissant-crust-pecan-pies-step-01-e8810d6e719d441294ce26177409ae79.jpg"
      ],
      "image": "assets/images/8303654/step_01.webp"
    },
    {
      "text": "Combine butter, brown sugar, corn syrup, salt, vanilla, and bourbon whiskey in a saucepan over medium-high heat. Bring to a simmer, then whisk mixture and boil for 1 minute. Remove from the heat and let cool for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BSX6-RT9xJq00TcHxqAJ35W46Iw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8303654-mini-croissant-crust-pecan-pies-step-02-57e4501d4fc048ef98d0fa8b3ea38be4.jpg"
      ],
      "image": "assets/images/8303654/step_02.webp"
    },
    {
      "text": "Add eggs and whisk quickly to combine. Stir in pecans. Set aside until mixture thickens a bit and cools down, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8B6NwHFIJUzgzAkzlamV3noAgH4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8303654-mini-croissant-crust-pecan-pies-step-03-11d84260248d49149bea0ded418513a4.jpg"
      ],
      "image": "assets/images/8303654/step_03.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Use the butter to generously grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ab6b8k09ZBDbRYhq4YfdtS9npac=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8303654-mini-croissant-crust-pecan-pies-step-04-a6f2d65a31c9429993ac56be5030bcc6.jpg"
      ],
      "image": "assets/images/8303654/step_04.webp"
    },
    {
      "text": "Cut each croissant in half, then turn the halves and slice open like you're making a sandwich. Place each piece into a prepared muffin cup and press it down and into the sides to fit and line the cup. Remove any pieces that stick up over the edge of the muffin cup and patch those in where needed to cover the sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Kr--_45wJFKieBYMW-iezHbWNLA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8303654-mini-croissant-crust-pecan-pies-step-05-2287f1c1de8a4cfca109f5647425d379.jpg"
      ],
      "image": "assets/images/8303654/step_05.webp"
    },
    {
      "text": "Spoon the pecan filling evenly into the muffin cups, stirring between each spoonful to ensure you get an even amount of nuts and sauce. Use your fingers to press pecans into the cups and even out the tops so they don't burn. Clean up any syrup that dripped onto the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JinJApKM5vS5JYDL0nC35fRbMRE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8303654-mini-croissant-crust-pecan-pies-step-06-284fac7472c5418db759360b103f19df.jpg"
      ],
      "image": "assets/images/8303654/step_06.webp"
    },
    {
      "text": "Bake in the center of the preheated oven until golden brown, about 25 minutes, with a pan on the rack underneath to catch any drips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tvwdtNvG_3NGO3ozsYq018pcAWc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8303654-mini-croissant-crust-pecan-pies-step-07-efea4223032a4692bf7e4d0bb7f2ad5b.jpg"
      ],
      "image": "assets/images/8303654/step_07.webp"
    },
    {
      "text": "Remove from the pan and let sit in the pan for 5 minutes. Turn each pie a bit, then lift out and place on a plate to continue cooling. Let cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H8VzuBWreFKxmK_oQz4qf_6omb8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8303654-mini-croissant-crust-pecan-pies-hero-02-4x3-65ffec2ee6ac48589b6ad2e53cfc9338.jpg"
      ],
      "image": "assets/images/8303654/step_08.webp"
    }
  ],
