  "steps": [
    {
      "text": "Stir barbecue sauce, honey, mustard, Worcestershire sauce, and hot pepper sauce together in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken all over with salt and pepper. Place into a slow cooker and pour barbecue mixture over top; stir to until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until chicken is no longer pink inside and the juices run clear, about 5 hours. An instant-read thermometer inserted into the middle should read at least 165 degrees F (74 degrees C).",
      "section": null,
