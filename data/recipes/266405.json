  "ingredients": [
    "1.5 cups barbecue sauce",
    "0.25 cup honey",
    "2 teaspoons Creole mustard",
    "0.25 teaspoon Worcestershire sauce",
    "0.25 teaspoon hot pepper sauce",
    "9 Tyson® Fresh Boneless, Skinless Chicken Thighs",
