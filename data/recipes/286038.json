  "ingredients": [
    "12 cups popped popcorn",
    "0.5 cup unsalted butter",
    "1 cup white sugar",
    "0.25 cup light corn syrup",
    "0.5 teaspoon salt",
    "0.25 teaspoon green food coloring",
    "0.5 teaspoon peppermint extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Place popped popcorn into a large roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Stir in sugar, corn syrup, and salt. Cook, stirring constantly, until mixture comes to a boil. Boil, without stirring, for 5 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in food coloring and peppermint extract. Pour over popcorn and stir until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour, stirring 2 to 4 times during baking. Remove from the oven and let cool completely before serving, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
