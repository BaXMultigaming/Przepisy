  "ingredients": [
    "2 slices multigrain bread",
    "1 pound ground turkey",
    "6 white mushrooms, finely chopped",
    "1 egg",
    "2 green onions, finely chopped",
    "3 slices cooked bacon, finely chopped, or more to taste",
    "5 dashes hot sauce, or more to taste",
    "0.5 teaspoon pureed garlic",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Mince bread in a food processor and transfer crumbs to a bowl. Add turkey, mushrooms, egg, green onions, bacon, hot sauce, garlic, salt, and pepper. Mix well and divide into 4 portions. Form each portion into a patty.",
