  "ingredients": [
    "nonstick cooking spray",
    "1 cup pizza sauce",
    "1 (10 ounce) can refrigerated biscuit dough",
    "1 cup grated mozzarella cheese",
    "1 cup mini pepperoni",
    "0.5 cup chopped mushrooms",
    "0.5 cup chopped olives",
    "1 tablespoon Italian seasoning"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper liners and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour pizza sauce into a large bowl. Cut each biscuit into 10 to 15 small pieces and stir into the pizza sauce. Add mozzarella, pepperoni, mushrooms, olives, and Italian seasoning and mix to combine well. Spoon the pizza mixture equally into the prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and cheese has melted, 25 to 30 minutes. Remove from the oven; let cool for 5 minutes before removing muffins from the tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
