  "ingredients": [
    "2 (12.5 fl oz) cans chunk chicken breast, drained and flaked",
    "4 green onions, chopped",
    "1 cup shredded sharp Cheddar cheese",
    "1 cup shredded pepperjack cheese",
    "1 cup hot pepper sauce (such as Frank's RedHot®)",
    "1 (1 ounce) package ranch dressing mix",
    "oil for frying",
    "1 cup all-purpose flour",
    "3 eggs, beaten",
    "1 cup plain bread crumbs"
  ],
  "steps": [
    {
      "text": "Mix the chicken, green onions, Cheddar cheese, pepperjack cheese, hot sauce, and ranch dressing mix together in a bowl; form the mixture into 1-inch balls with a scoop. Place the balls on a large, flat dish; chill in refrigerator 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently press the balls into the flour to coat and shake off any excess. Dip into the beaten egg and then press into bread crumbs. Place the breaded chicken balls onto a plate while breading the rest; do not stack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry the breaded balls in the hot oil until slightly browned, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
