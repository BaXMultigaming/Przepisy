  "ingredients": [
    "0.5 sheet puff pastry",
    "3 tablespoons butter",
    "0.25 pound mushrooms, sliced",
    "2 cloves garlic, crushed",
    "0.5 cup crumbled goat cheese",
    "4 teaspoons finely chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking tray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay puff pastry out on a lightly floured surface and cut into 8 squares. Prick the squares in several places with a fork. Place the puff pastry squares on prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake puff pastry squares for 7 minutes. Remove tray from the oven; flatten squares using the backside of a spatula. Return puff pastry to the oven to bake until golden brown, about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a skillet over medium-high heat. Add mushrooms and garlic; cook and stir until mushrooms are tender, 5 to 7 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top baked puff pastry squares evenly with mushroom mixture; crumble goat cheese over mushrooms and sprinkle with parsley. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
