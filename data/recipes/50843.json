  "ingredients": [
    "1 cup chopped dried figs",
    "0.5 cup water",
    "1 tablespoon olive oil",
    "2 tablespoons balsamic vinegar",
    "1 teaspoon dried rosemary",
    "1 teaspoon dried thyme",
    "0.25 teaspoon cayenne pepper",
    "0.66666668653488 cup chopped kalamata olives",
    "2 cloves garlic, minced",
    "salt and pepper to taste",
    "0.33333334326744 cup chopped toasted walnuts",
    "1 (8 ounce) package cream cheese"
  ],
  "steps": [
    {
      "text": "Combine figs and water in a saucepan over medium heat. Bring to a boil, and cook until tender, and liquid has reduced. Remove from heat, and stir in the olive oil, balsamic vinegar, rosemary, thyme, and cayenne. Add olives and garlic, and mix well. Season with salt and pepper to taste. Cover, and refrigerate for 4 hours or overnight to allow flavors to blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unwrap cream cheese block, and place on a serving platter. Spoon tapenade over cheese, and sprinkle with walnuts. Serve with slices of French bread or crackers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
