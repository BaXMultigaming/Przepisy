  "ingredients": [
    "1.5 cups barbecue sauce, or as needed",
    "0.5 cup chopped white onion",
    "0.25 cup ketchup",
    "0.25 cup brown sugar",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon chili powder",
    "1 pound boneless pork loin, quartered",
    "4 onion rolls, halved"
  ],
  "steps": [
    {
      "text": "Stir barbecue sauce, onion, ketchup, brown sugar, salt, black pepper, and chili powder in a slow cooker; add pork loin and coat with sauce. Cover and cook on High until pork is very tender, about 4 1/2 hours. Shred pork with 2 forks. Keep warm on Low until ready to serve.",
      "section": null,
      "name": null,
