  "ingredients": [
    "6 cut up chicken pieces",
    "1 cup soy sauce",
    "0.5 cup distilled white vinegar",
    "1 teaspoon crushed garlic",
    "ground black pepper to taste",
    "0.25 cup fresh lemon juice",
    "salt to taste",
    "1 cup unsweetened flaked coconut",
    "0.33333298563957 cup chopped green onions",
    "1 dash lemon pepper",
    "0.125 cup chopped green onion for topping"
  ],
  "steps": [
    {
      "text": "To Make Marinade: Combine the soy sauce, vinegar, garlic and ground black pepper. Mix together. Marinate chicken in refrigerator for 2 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from refrigerator and dispose of marinade. Broil or barbecue chicken for 25 to 30 minutes or until cooked through and juices run clear. When chicken is cooked, remove bones and dice chicken meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put diced chicken in a medium bowl. Add the lemon juice and salt and mix together. Then add the coconut, green onion and lemon pepper spice. Mix all together, top with green onion and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
