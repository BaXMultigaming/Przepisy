  "ingredients": [
    "2.25 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup butter, softened",
    "1.3333333730698 cups white sugar",
    "1 egg",
    "1 cup chocolate chips, melted",
    "1 cup white chocolate chips",
    "0.33333334326744 cup chopped nuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour and baking soda together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese and butter in the bowl of a stand mixer fitted with the paddle attachment; beat until smooth and creamy. Gradually beat in sugar and egg. Stir in melted chocolate chips. Add flour mixture, white chocolate chips, and nuts; stir until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm around the edges, 10 to 12 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
