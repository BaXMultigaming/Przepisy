  "ingredients": [
    "cooking spray",
    "1 cup rolled oats",
    "0.5 cup almond milk",
    "1 large ripe banana",
    "1 large egg",
    "2 tablespoons maple syrup (or sweetener of your choice)",
    "1 teaspoon baking powder",
    "1 teaspoon vanilla",
    "0.5 teaspoon ground cinnamon",
    "0.125 teaspoon salt",
    "0.25 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray the bottom and sides of two 8-ounce ramekins with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, almond milk, banana, egg, maple syrup, baking powder, vanilla, cinnamon, and salt in a blender. Blend until well combined, 30 to 60 seconds. Stir in blueberries. Transfer to the prepared ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
