  "ingredients": [
    "2.5 pounds yams",
    "2 tablespoons butter",
    "2 cups brown sugar",
    "1 cup orange juice",
    "1 teaspoon ground nutmeg",
    "3 cups marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast whole yams in the preheated oven until almost tender, 35 to 40 minutes; let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4vxxepRVBqi3Vm14JsxMn7Ug6Yo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240158-candied-yams-and-marshmallows-VAT-step-02-842de82e711044159df390e80eb37349.jpg"
      ],
      "image": "assets/images/240158/step_02.webp"
    },
    {
      "text": "Reduce the oven heat to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large pot over medium heat; stir in sugar, juice, and nutmeg until sugar dissolves. Bring to a boil, then reduce heat to low; cook until liquid thickens and becomes syrupy, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tTWnt2iVgKyaZnEsuD0wjt1uEFE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240158-candied-yams-and-marshmallows-VAT-step-04-7f54fb909bcd4f44b19c819d4a4d64ba.jpg"
      ],
      "image": "assets/images/240158/step_04.webp"
    },
    {
      "text": "Peel yams; cut into bite-sized chunks. Arrange in a single layer in a 13 x 9-inch baking dish. Drizzle syrup over yams.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bIpCAgqqC0Y-ije6aUr-qMyHnyA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240158-candied-yams-and-marshmallows-VAT-step-05-3a17c2e164784f17a5199b4ad3af820b.jpg"
      ],
      "image": "assets/images/240158/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven, basting yams with syrup every 15 minutes until fork-tender, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8XlAUuJoHsoFjFfMEwrnV9OjPkQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240158-candied-yams-and-marshmallows-VAT-step-06-65ef9bb5698f445fa6f06a58dab3daec.jpg"
      ],
      "image": "assets/images/240158/step_06.webp"
    },
    {
      "text": "Arrange marshmallows over yams; continue baking until marshmallows are puffy and brown, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rIkh2okeTwkreXn6KfpOmNjRozo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240158-candied-yams-and-marshmallows-VAT-step-07-8de2e3c688a049308c342406edf11c96.jpg"
      ],
      "image": "assets/images/240158/step_07.webp"
    }
  ],
