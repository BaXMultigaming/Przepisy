  "ingredients": [
    "0.5 cup all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "1 pinch salt",
    "1.3333333730698 cups white sugar",
    "2 eggs",
    "0.5 cup butter, melted",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C). Lightly grease an 8-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, cocoa powder, and salt in a medium bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together sugar and eggs in a large bowl until smooth. Add flour mixture; stir just until combined. Pour in melted butter and vanilla; stir until well combined. Pour into the prepared pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on the lower rack of the preheated oven until the center has slightly set, about 35 minutes. Allow cake to cool for 1 hour in the pie plate. Serve warm or refrigerate overnight and serve cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
