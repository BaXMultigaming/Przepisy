  "ingredients": [
    "1 tablespoon salt",
    "1 (16 ounce) package elbow macaroni",
    "cooking spray",
    "0.5 cup butter, cut into small pieces",
    "2 (12 fluid ounce) cans evaporated milk",
    "1 cup milk",
    "3 eggs",
    "0.5 cup sour cream",
    "1 tablespoon white sugar",
    "1 teaspoon ground black pepper",
    "salt to taste",
    "2 (8 ounce) packages Colby-Jack cheese",
    "1.5 (8 ounce) packages processed cheese food (such as Velveeta®), cut into cubes",
    "1 (8 ounce) package shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Sprinkle salt into a large pot of water; bring to a boil. Cook elbow macaroni in the boiling water, stirring occasionally until tender yet firm to the bite, about 8 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 4-quart baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour hot macaroni into the baking dish. Add butter; stir until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk evaporated milk, milk, eggs, and sour cream together in a large bowl. Season with sugar, pepper, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle Colby Jack cheese, processed cheese food, and Cheddar cheese over macaroni. Pour milk mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is lightly browned, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
