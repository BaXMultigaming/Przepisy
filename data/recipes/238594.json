  "ingredients": [
    "2 cups shredded sharp Cheddar cheese",
    "1.25 cups mayonnaise",
    "4 cups torn iceberg lettuce",
    "2 large Roma (plum) tomatoes, or more to taste, chopped",
    "1 (6 ounce) can sliced black olives, drained",
    "1 (10 ounce) package frozen peas, thawed",
    "1 (4 ounce) can sliced water chestnuts, drained",
    "0.5 cup cooked crumbled bacon"
  ],
  "steps": [
    {
      "text": "Mix Cheddar cheese and mayonnaise together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat lettuce into an even layer in the bottom of a large glass serving bowl. Layer tomatoes, black olives, peas, and water chestnuts, respectively, into the bowl. Spread Cheddar cheese mixture over the water chestnuts layer; top with bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl with plastic wrap and refrigerate until salad is chilled, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
