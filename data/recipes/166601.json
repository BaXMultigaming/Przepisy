  "ingredients": [
    "1 cup uncooked rolled oats",
    "1 cup whole wheat flour",
    "0.75 cup all-purpose flour",
    "0.25 cup brown sugar",
    "2 tablespoons dry milk powder",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups milk",
    "1 large egg",
    "2 tablespoons vegetable oil",
    "1 teaspoon vanilla extract",
    "1 medium banana, mashed",
    "1 teaspoon vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Blend oats in a blender until the texture resembles coarse flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer oats to a bowl. Add both flours, brown sugar, milk powder, baking powder, baking soda, and salt; whisk until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together milk, egg, 2 tablespoons vegetable oil, and vanilla in a separate bowl; stir in mashed banana. Pour egg mixture into flour mixture; stir just until moistened, then let batter stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil a griddle with 1 teaspoon oil and heat over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, drop batter by large spoonfuls onto the hot griddle; cook until bubbles form and the edges are dry, about 2 minutes. Flip, and cook until browned on the other side. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
