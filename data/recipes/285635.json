  "ingredients": [
    "1 cup oil for frying, or as needed",
    "1 large large egg, beaten",
    "0.5 (8.5 ounce) bag spicy cheese-flavored cornmeal snack (such as Cheetos® Flamin' Hot®)",
    "0.25 teaspoon cayenne pepper",
    "12 slices dill pickles"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beaten egg in a flat dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place Cheetos® and cayenne in a food processor. Pulse until crumbs are achieved. Pour into a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip a pickle slice in the egg and coat with Cheetos® crumb mixture. Transfer to a plate. Repeat with remaining pickle slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry pickle slices in the hot oil, working in batches, for 3 minutes. Transfer to a paper towel-lined plate and let sit for 2 minutes for final crisping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
