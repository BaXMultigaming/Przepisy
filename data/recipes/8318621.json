  "ingredients": [
    "1 (16.3 ounce) can refrigerated biscuit dough, separated",
    "1 cup shredded Cheddar cheese",
    "4 ounces sliced deli ham, chopped",
    "1 large egg, beaten",
    "2 teaspoons everything bagel seasoning, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 8 cups of a standard muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll each biscuit until 1/4 inch thick. Sprinkle with Cheddar cheese and ham. Wrap biscuit dough around the filling, pinch the edges to seal, and form into a ball. Press into the prepared muffin cups. Brush with beaten egg and sprinkle with bagel seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
