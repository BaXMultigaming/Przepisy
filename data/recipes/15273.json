  "ingredients": [
    "1 pound beef shank",
    "1 tomato, quartered",
    "2 potatoes, cubed",
    "1 onion, chopped",
    "3 carrots, chopped",
    "0.5 medium head cabbage, chopped",
    "4 cloves garlic, minced",
    "6 teaspoons chopped fresh cilantro",
    "1 tablespoon salt",
    "0.25 teaspoon ground cumin",
    "2 fluid ounces fresh lime juice"
  ],
  "steps": [
    {
      "text": "In a large pot over low heat combine the beef, tomato, potatoes, onion, carrots, cabbage, garlic, 5 teaspoons cilantro, salt and cumin. Add water to cover and stir well. Cover and simmer for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove lid, stir, and simmer for another hour with lid off. Serve hot. Just before eating, squeeze in fresh lime juice to taste and sprinkle with remaining cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
