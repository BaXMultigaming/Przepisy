  "ingredients": [
    "2 cups fresh spinach",
    "1 cup diced avocado",
    "0.5 cup reduced-fat sour cream",
    "0.25 cup chopped red onion",
    "1 tablespoon fresh lime juice",
    "1 tablespoon chopped seeded jalapeno pepper",
    "1 large garlic clove",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "hot sauce"
  ],
  "steps": [
    {
      "text": "Process spinach, avocado, sour cream, red onion, lime juice, jalapeno pepper, garlic, salt, black pepper, and hot sauce in a food processor until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrape dip into a serving bowl, cover with plastic wrap, and refrigerate until chilled, at least 1 hour.",
