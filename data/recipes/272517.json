  "ingredients": [
    "0.75 cup chicken broth",
    "0.5 cup tricolor orzo",
    "1 tablespoon butter",
    "2 cloves garlic, minced",
    "0.5 cup julienned fresh spinach",
    "2 ounces sliced portobello mushrooms",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Combine chicken broth and orzo in a multi-functional pressure cooker (such as Instant Pot); stir to combine. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 5 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Switch to Sauté function. Stir in butter, garlic, spinach, and mushrooms. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
