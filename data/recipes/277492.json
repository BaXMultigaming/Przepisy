  "ingredients": [
    "0.25 cup vegan butter",
    "3 tablespoons olive oil",
    "2 large leeks, diced",
    "1 yellow onion, minced",
    "1 large carrot, diced",
    "1 cup minced Pleurotus mushrooms (oyster mushrooms)",
    "2 pounds potatoes, peeled and diced",
    "4 cups low-sodium vegetable broth",
    "1 cup unsweetened oat milk, divided",
    "1 tablespoon potato starch",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A_PQvdFOQe8SvCIL3cfokGgRplc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277492-slow-cooker-vegan-leek-and-potato-soup-VAT-step-01-08bed4bdb93846d28c28ba392ac21286.jpg"
      ],
      "image": "assets/images/277492/step_01.webp"
    },
    {
      "text": "Turn on the Sauté function on your slow cooker. Heat vegan butter and olive oil in the slow cooker. Add leeks, onion, carrot, and mushrooms. Cook and stir until leeks and onions are translucent and softened, carrots have softened, and mushrooms have liquefied, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9uEWighQqCgcOBa6lUqy0dh-Sw0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277492-slow-cooker-vegan-leek-and-potato-soup-VAT-step-02-38f09fcf7c4e47b59a065399dee69683.jpg"
      ],
      "image": "assets/images/277492/step_02.webp"
    },
    {
      "text": "Add potatoes and vegetable broth; mix well. Mix 1 tablespoon oat milk with potato starch in a small bowl to create a slurry and stir it into soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3HsMHU7hVLJrGPrM6Fe2rxc5_P4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277492-slow-cooker-vegan-leek-and-potato-soup-VAT-step-03-3a8c8456b5464b83a8f1d5f4fb138b30.jpg"
      ],
      "image": "assets/images/277492/step_03.webp"
    },
    {
      "text": "Place remaining oat milk in a microwave-safe bowl and heat in the microwave until hot, about 30 seconds. Pour into soup and season with salt and pepper. Turn off the Sauté function.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8YIqFQG5uauOkhQz0tuQCv3U1OM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277492-slow-cooker-vegan-leek-and-potato-soup-VAT-step-04-1bc1c5f55beb45e089096e7de37bc1f4.jpg"
      ],
      "image": "assets/images/277492/step_04.webp"
    },
    {
      "text": "Cook on Low for 6 hours or High for 3 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pnhrDmrfIWh8a7tpUQiGIZV35Bo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277492-slow-cooker-vegan-leek-and-potato-soup-VAT-step-05-9bff4191120c4248a33e24299e150ddc.jpg"
      ],
      "image": "assets/images/277492/step_05.webp"
    },
    {
      "text": "Stir soup before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CdyazBh943RQ_vO9FL2cfL8U3Qk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277492-slow-cooker-vegan-leek-and-potato-soup-VAT-step-06-7b51167855574628805359d2fc565ab7.jpg"
