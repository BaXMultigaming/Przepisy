  "ingredients": [
    "1 cup yellow cornmeal",
    "1 cup all-purpose flour",
    "0.25 cup white sugar",
    "4 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 cup cold whole milk",
    "1 large egg",
    "16 large hot dogs",
    "2 cups vegetable oil for frying, or as needed",
    "16 skewers"
  ],
  "steps": [
    {
      "text": "Mix cornmeal, flour, sugar, baking powder, salt, and pepper together in a large bowl; stir in milk and egg until smooth. Cover; refrigerate until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-2IV6OSp2rACDZY4k3U58Cffk4Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244753-dads-homemade-corn-dogs-VAT-006-step-02-7218adfd6ee94a3d8b9b8589e9bb5662.jpg"
      ],
      "image": "assets/images/244753/step_01.webp"
    },
    {
      "text": "Bring a large pot of water to a boil. Add hot dogs; cook until heated through, about 7 minutes. Drain on a paper towel-lined plate; let rest for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rifbkD4ohwGPpvjRhHuKNrQ8JAU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244753-dads-homemade-corn-dogs-VAT-007-step-03-4bdc007a36914e1c83dd3c5fef6d57fe.jpg"
      ],
      "image": "assets/images/244753/step_02.webp"
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C). Insert one skewer into each hot dog; blot dry with paper towels. Pour chilled batter into a tall glass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cvXVsV0uB05oekJSfsrfiPR1-1I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244753-dads-homemade-corn-dogs-VAT-008-step-04-90e01be33f994a709afde0066746d817.jpg"
      ],
      "image": "assets/images/244753/step_03.webp"
    },
    {
      "text": "Dip one hot dog into batter to coat; transfer to oil. Repeat with as many hot dogs as can comfortably fit in the fryer without overcrowding.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z5a8jcqBbw726vDf6wGaJtbJTRc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244753-dads-homemade-corn-dogs-VAT-009-step-05-e17a721425974ba09aea9578c43dd092.jpg"
      ],
      "image": "assets/images/244753/step_04.webp"
    },
    {
      "text": "Fry until lightly browned, about 3 minutes. Drain on paper towels. Repeat with remaining hot dogs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/INbxzT_8rh8RFb1wa7ytmvQZTHs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/244753-dads-homemade-corn-dogs-VAT-010-step-06-3f537781223b46c398bca659667ea111.jpg"
