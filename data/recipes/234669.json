  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "1 cup light brown sugar",
    "1 cup white sugar",
    "0.75 cup canola oil",
    "3 eggs",
    "2.5 cups whole wheat flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.75 teaspoon baking soda",
    "0.75 teaspoon baking powder",
    "0.75 teaspoon salt",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground cloves",
    "1 cup cooked quinoa",
    "1 cup chopped walnuts",
    "0.5 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk pumpkin, brown sugar, white sugar, canola oil, and eggs together in a bowl until smooth. Sift flour, cinnamon, nutmeg, baking soda, baking powder, salt, allspice, and cloves together in a separate bowl. Stir flour mixture, a little at a time, into pumpkin mixture until batter is smooth; fold in quinoa, walnuts, and cranberries. Pour batter into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top of loaf springs back when lightly touched, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
