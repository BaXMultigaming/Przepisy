  "title": "Pumpkin Quinoa Bread",
  "description": "Quinoa and walnuts are added to whole wheat pumpkin bread batter for a heartier and nutty bread perfect during Thanksgiving season.",
  "authors": [
    "jabguit"
  ],
  "date_published": "2020-06-18T23:56:19-04:00",
