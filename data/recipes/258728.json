  "ingredients": [
    "18 roma (plum) tomatoes",
    "4 jalapeno peppers, stemmed",
    "4 serrano chile peppers, stemmed",
    "4 Anaheim chile peppers, stemmed",
    "0.25 cup chopped onion",
    "0.25 cup chopped fresh cilantro",
    "1 tablespoon lime juice",
    "1.5 teaspoons salt",
    "1.5 teaspoons chili-lime seasoning (such as Tajin®)",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate. Place tomatoes, jalapeno peppers, serrano peppers, and Anaheim peppers on grill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, turning often, until tomatoes have collapsed and all peppers are blackened, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer tomatoes, jalapeno peppers, serrano peppers, and Anaheim peppers to a large serving bowl; blend with an immersion blender until chunky. Add onion, cilantro, lime juice, salt, chili-lime seasoning, and black pepper; stir salsa to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
