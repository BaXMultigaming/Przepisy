  "title": "Mohawk Milk Cake",
  "description": "A wonderful cake given to me by a Mohawk Indian after a bake off at the Fryeburg Fair here in Maine. It is heavy in weight but light in taste.",
  "authors": [
    "DAISY"
  ],
  "date_published": "2000-04-07T10:58:14-04:00",
