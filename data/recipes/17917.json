  "ingredients": [
    "1 cup milk",
    "0.5 cup butter",
    "2 cups white sugar",
    "4 eggs",
    "2 tablespoons baking powder",
    "2 cups all-purpose flour",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease and flour a 9 inch Bundt pan. Sift together the flour and baking powder. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan heat milk and butter until butter is melted. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the sugar and eggs until light and lemon colored. Stir in the vanilla. Beat in the flour mixture and the milk. Mix thoroughly and pour into prepared 9 inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 to 50 minutes, or until a toothpick inserted into the center of the cake comes out clean. Cool 10 minutes in the pan, then turn out onto a wire rack and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
