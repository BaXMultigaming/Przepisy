  "ingredients": [
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "1 teaspoon salt",
    "0.5 cup butter, softened",
    "0.5 cup packed brown sugar",
    "0.5 cup real maple syrup",
    "2 large eggs",
    "0.75 cup milk",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 12-cup muffin pan with paper baking cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking powder, and salt in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar in a mixing bowl until light and fluffy. Stir in maple syrup and eggs; beat until well blended. Add flour mixture alternately with milk, beating just until combined. Stir in walnuts. Spoon batter into the prepared muffin cups, filling each about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 20 minutes. Remove to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
