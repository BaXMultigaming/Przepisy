  "ingredients": [
    "1.5 cups brown sugar, packed",
    "1 cup butter, softened",
    "2 cups all-purpose flour",
    "0.75 cup mini semisweet chocolate chips",
    "0.75 cup chopped walnuts, if desired",
    "2 teaspoons vanilla extract",
    "1 tablespoon water"
  ],
  "steps": [
    {
      "text": "Beat together brown sugar and butter in a large bowl until creamy. Stir in flour, chocolate chips, walnuts, vanilla, and water; mix until dough is well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into bite-sized balls or use a small ice cream scoop. Place on a baking sheet and freeze until firm, about 2 hours. Store balls in resealable plastic bags in the freezer.",
      "section": null,
