  "ingredients": [
    "2 cucumbers - halved lengthwise, seeded, and sliced",
    "2 teaspoons salt",
    "0.5 cup rice vinegar",
    "0.25 cup white sugar",
    "2 tablespoons sesame oil",
    "1 tablespoon minced garlic",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon sesame seeds",
    "4 fresh red chile peppers, sliced"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DjC0yDcG0Yn5JPMNEZWVm78d3I8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/192623-asian-cucumber-salad-VAT-005-step-01-f6dd1ddbab3c426eaa42299ec2eee438.jpg"
      ],
      "image": "assets/images/192623/step_01.webp"
    },
    {
      "text": "Place cucumber slices in a colander and sprinkle with salt; set aside to drain while you prepare the remaining ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bfnDFux4bqI26dKNIuzzyKVjxhE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/192623-asian-cucumber-salad-VAT-006-step-02-4c18cbd53faa49aaa0956b7c9f8e04f2.jpg"
      ],
      "image": "assets/images/192623/step_02.webp"
    },
    {
      "text": "Whisk vinegar and sugar together in a small bowl until sugar is dissolved; stir in sesame oil, garlic, ginger, and sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QnlXVCymhXspFb7IDg_MFYZADJA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/192623-asian-cucumber-salad-VAT-007-step-03-3c661d4cad354453a3bccc799484a6fb.jpg"
      ],
      "image": "assets/images/192623/step_03.webp"
    },
    {
      "text": "Rinse salt off cucumber slices by running under cold water; place in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mn_HNftdqgz6fSbd8OaZ8eEK18Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/192623-asian-cucumber-salad-VAT-008-step-04-c8a8361f610a445bbb13188968ec603a.jpg"
      ],
      "image": "assets/images/192623/step_04.webp"
    },
    {
      "text": "Add sliced red chili peppers and vinegar dressing; toss to coat. Cover and refrigerate the salad until ready to serve. This salad tastes best on the day it is made.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KRfPY8WxnYnt8is3clI9zLste5g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/192623-asian-cucumber-salad-VAT-009-step-05-eae2f142b5c9498ab638887da587ff7e.jpg"
