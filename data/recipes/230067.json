  "ingredients": [
    "2 cups mashed sweet potatoes",
    "0.25 cup milk, or as needed",
    "0.5 cup maple syrup",
    "0.25 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x12-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash sweet potatoes with milk in a bowl, adding milk a little at a time, until potatoes reach desired consistency. Spread sweet potatoes into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring maple syrup and butter to a boil in a saucepan; pour boiling syrup mixture over sweet potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until sweet potatoes are hot and topping begins to cook into a sticky caramel, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
