  "ingredients": [
    "5 fresh peaches - peeled, pitted, and sliced",
    "5 slices white bread, crusts trimmed",
    "1.5 cups white sugar",
    "2 tablespoons all-purpose flour",
    "1 egg, lightly beaten",
    "0.5 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place peaches in prepared dish. Cut each slice of bread into five fingers, and lay the fingers over the peaches. In a medium bowl, combine sugar, flour, egg and butter and mix until well blended. Pour over bread and peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 35 to 45 minutes, until golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
