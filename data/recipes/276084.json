  "title": "Linda's Crab and Shrimp Cakes",
  "description": "Canned crabmeat and shrimp plus other pantry staples means these tasty, Creole-spiced seafood cakes come together quickly and easily.",
  "authors": [
    "Linda F Bergfeld"
  ],
  "date_published": "2020-02-15T01:11:34-05:00",
