  "ingredients": [
    "1.5 cups Italian-style bread crumbs",
    "1 cup mayonnaise",
    "2 eggs",
    "2 teaspoons dill mustard",
    "2 teaspoons capers with brine",
    "0.5 lemon, juiced",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon dried dill",
    "1 teaspoon Creole seasoning",
    "1 teaspoon minced garlic",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon garlic powder",
    "3 (4.25 ounce) cans white crabmeat, drained",
    "1 (4 ounce) can tiny shrimp, drained",
    "2 tablespoons canola oil, or as needed"
  ],
  "steps": [
    {
      "text": "Combine bread crumbs, mayonnaise, eggs, mustard, capers and brine, lemon juice, Worcestershire sauce, dill, Creole seasoning, garlic, salt, pepper, and garlic powder in a bowl; mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine crabmeat and shrimp in a small bowl. Fold into the mayonnaise mixture until well blended. Cover and refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the refrigerator and form into 12 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook seafood patties in batches in the hot oil, until browned, 5 to 6 minutes per side. Transfer to a paper towel-lined plate and repeat with remaining patties, adding more oil if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
