  "ingredients": [
    "1.5 cups dry black-eyed peas",
    "1 pound ham hocks",
    "1 onion, chopped",
    "0.5 teaspoon crushed red pepper flakes",
    "salt and pepper to taste",
    "4 cups water",
    "1.5 cups long-grain white rice",
    "1 cup shredded smoked Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Place peas, ham hock, onion, red pepper, salt and pepper in a large pan. Cover with water and bring to a boil. Reduce heat to medium-low and cook for 1 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ham hock and cut meat into pieces. Return meat to pot. Stir in rice; cover and cook until rice is tender, about 20 to 25 minutes. Season to taste with salt and pepper. Sprinkle shredded cheese over top, if desired.",
      "section": null,
      "name": null,
