  "ingredients": [
    "3 pounds whole sweet potatoes, pricked with a fork",
    "salt and ground black pepper to taste",
    "0.5 cup buttermilk",
    "0.5 cup whole milk",
    "6 tablespoons butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Adjust an oven rack to the upper-middle position. Line a baking tray with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake sweet potatoes on the prepared tray in the preheated oven until tender, 45 to 60 minutes. Peel when cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée peeled sweet potatoes in a food processor until smooth; season with salt and pepper. With the motor running, add buttermilk and milk gradually through the feeder tube, then butter. Continue processing until silky smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
