  "ingredients": [
    "2 cups raisins",
    "2 cups water",
    "0.5 cup packed brown sugar",
    "2 tablespoons cornstarch",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "1 tablespoon distilled white vinegar",
    "1 tablespoon butter",
    "1 (14.1 ounce) package double-crust pie pastry, thawed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Combine raisins and water in a small saucepan. Boil 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mH4s3hkc-HuEFliOlYdDEDzlahI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12412-old-fashioned-raisin-pie-VAT-step-01-c549221e7c6f4304870a652f88d4bf37.jpg"
      ],
      "image": "assets/images/12412/step_01.webp"
    },
    {
      "text": "Mix brown sugar, cornstarch, cinnamon, and salt together; add to hot raisins. Cook and stir until syrup is clear. Remove from heat; stir in vinegar and butter. Cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mu0Ophyz1H7rvg3iOiTJUd_6EEA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12412-old-fashioned-raisin-pie-VAT-step-02-c29985ceb7ad440591203b9f4913c27f.jpg"
      ],
      "image": "assets/images/12412/step_02.webp"
    },
    {
      "text": "Turn filling into a pastry-lined pie dish. Cover with top crust. Seal edges and cut slits in the top crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dRIeadC_JaRFBV2w3uxbDnyCU2o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12412-old-fashioned-raisin-pie-VAT-step-03-0a52a3f74e7640d2999c0c106502c176.jpg"
      ],
      "image": "assets/images/12412/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MHXP_jd4DwqX2yQ9xpjj7IR2FuY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12412-old-fashioned-raisin-pie-VAT-step-04-3f9cae07ae624743985dc47542dbac14.jpg"
