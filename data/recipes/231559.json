  "ingredients": [
    "4 eggs",
    "3 cups milk",
    "0.75 cup real maple syrup",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a large bowl until lightly beaten. Add milk, maple syrup, and vanilla; gently beat until incorporated. Pour mixture into twelve (1/2-cup) ramekins in a baking dish. Pour enough water into the baking dish to come halfway up the sides of the ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center of a custard comes out clean, 35 to 45 minutes. Remove the ramekins from the baking dish and refrigerate until completely chilled, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
