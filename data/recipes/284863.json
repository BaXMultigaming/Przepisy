  "ingredients": [
    "nonstick cooking spray",
    "1 (8 ounce) package refrigerated crescent rolls",
    "1 pound bulk pork sausage",
    "0.5 cup chopped red bell pepper",
    "0.25 cup chopped onion",
    "0.25 cup chopped green onions",
    "0.5 cup cream cheese",
    "1 teaspoon ground black pepper",
    "2 cups shredded Cheddar cheese",
    "6 large eggs",
    "0.75 cup low-fat milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place crescent roll dough in bottom of the prepared pan, pinching perforated seams together; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Add sausage, bell pepper, onion, and green onions; cook and stir until sausage is brown and crumbly, 5 to 7 minutes. Discard any excess oil from the skillet. Stir in cream cheese and black pepper; cook until cream cheese melts, 2 to 3 minutes. Off heat, cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread sausage mixture over dough; sprinkle with Cheddar cheese. Beat eggs and milk together in a bowl; pour over cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until casserole bottom browns, cheese melts, and eggs are set in the center, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
