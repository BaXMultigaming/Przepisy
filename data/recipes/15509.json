  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 pound lean ground beef",
    "1 onion, diced",
    "3 carrots, diced",
    "2 tablespoons all-purpose flour",
    "1 tablespoon Italian seasoning",
    "0.5 teaspoon ground cinnamon",
    "2 tablespoons chopped fresh parsley",
    "1.5 cups beef broth",
    "1 tablespoon tomato paste",
    "salt and pepper to taste",
    "4 potatoes, peeled and diced",
    "1 cup milk",
    "0.25 cup butter, softened",
    "0.25 pound shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yyCceDYfgkeo4R5YEZbYs8X0Ae8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Easy-English-Cottage-Pie-step-1-026-50708c5ff35143769c61bb86c2978f9a.jpg"
      ],
      "image": "assets/images/15509/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Add onion and carrot; cook and stir until onion has softened, about 5 minutes. Mix in flour, Italian seasoning, and cinnamon. Stir in parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uVCRbozsCdPge-RUtjgGfxMlydM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15509-Easy-English-Cottage-Pie-ddmfs-step-2-046-3c8cc78e30404c7994560b046f81fb78.jpg"
      ],
      "image": "assets/images/15509/step_02.webp"
    },
    {
      "text": "Combine beef broth and tomato paste together in a jug; add to beef mixture. Season with salt and pepper; lower heat and simmer for 15 minutes, stirring occasionally, until slightly thickened. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cTKTgUv4jgjkUkY9SsSD-NCQwJ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15509-Easy-English-Cottage-Pie-ddmfs-step-3-052-d8e6f458b51345dd884e8ac6a4f0ed9e.jpg"
      ],
      "image": "assets/images/15509/step_03.webp"
    },
    {
      "text": "Meanwhile, place diced potatoes in a medium saucepan; cover with water and place over high heat. Bring to a boil and simmer until potatoes are tender, about 15 minutes; drain. Mash potatoes until smooth, then add milk and butter; whip until fluffy. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y891P36jK9-GKetNvG0-YtDJzgQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15509-Easy-English-Cottage-Pie-ddmfs-step-4-055-111cada38334428387f874199435d89e.jpg"
      ],
      "image": "assets/images/15509/step_04.webp"
    },
    {
      "text": "Spoon ground beef mixture into a 9x13-inch baking dish; spread mashed potatoes on top and sprinkle with grated Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OhOJbpHJZsqyGqAOyjfWhTCNfGA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15509-Easy-English-Cottage-Pie-ddmfs-step-5-061-f4eaccf2239a40a7961212aec1177760.jpg"
      ],
      "image": "assets/images/15509/step_05.webp"
    },
    {
      "text": "Bake in preheated oven until top is browned and cheese is bubbly, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WxJ0AIh8V7sYw0U7qcjcDxcuplY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15509-Easy-English-Cottage-Pie-ddmfs-step-6-113-7fdfcd41101b4728be6634b787a664e5.jpg"
      ],
      "image": "assets/images/15509/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B9es8FlN8CfmQjrPvnCS3fXqPTk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15509-Easy-English-Cottage-Pie-ddmfs-3x4-235-c7e2216579c941d8b7156f29043d180a.jpg"
      ],
      "image": "assets/images/15509/step_07.webp"
    }
