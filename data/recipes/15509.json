  "title": "Easy English Cottage Pie",
  "description": "This flavorful cottage pie made with ground beef, carrots, and onions is topped with cheesy mashed potatoes and baked for a comforting pleasing meal.",
  "authors": [
    "Caroline"
  ],
  "date_published": "1999-02-17T07:16:08-05:00",
