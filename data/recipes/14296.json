  "ingredients": [
    "5 (.25 ounce) envelopes unflavored gelatin",
    "2.25 cups boiling water",
    "4 teaspoons almond extract",
    "4 cups cold water",
    "1.3333333730698 cups white sugar",
    "1 cup fresh strawberries, halved",
    "1 cup seedless grapes",
    "1 cup cubed cantaloupe"
  ],
  "steps": [
    {
      "text": "Soften gelatin in 1 cup cold water. Add 2 1/4 cups boiling water and sugar. Stir until thoroughly dissolved. Add 3 cups cold water and the almond extract. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour gelatin mixture into a 9x13 inch pan and refrigerate for at least 4 hours. Cut into 1 inch squares and serve in a bowl with cut fruits.",
