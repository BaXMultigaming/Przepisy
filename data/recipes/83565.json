  "ingredients": [
    "1 cup whole wheat couscous",
    "1 tablespoon vegetable oil",
    "1 medium onion, chopped",
    "2 bay leaves",
    "5 whole cloves, crushed",
    "0.5 teaspoon cinnamon",
    "1 teaspoon ground dried turmeric",
    "0.25 teaspoon ground cayenne pepper",
    "6 skinless, boneless chicken breast halves - chopped",
    "1 (48 fluid ounce) can chicken broth",
    "1 (16 ounce) can garbanzo beans",
    "1 (16 ounce) can crushed tomatoes",
    "2 carrots, cut into 1/2 inch pieces",
    "1 zucchini, cut into 1/2-inch pieces",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Prepare couscous according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large pot over medium heat. Cook and stir onion in hot oil until tender. Mix in bay leaves, cloves, cinnamon, turmeric, and cayenne pepper. Add chicken and cook until well browned. Pour in chicken broth, garbanzo beans, and tomatoes; bring to a boil. Reduce heat to low and simmer for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix carrots and zucchini into the pot. Season with salt. Continue cooking until vegetables are tender, about 10 minutes. Serve stew over cooked couscous.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
