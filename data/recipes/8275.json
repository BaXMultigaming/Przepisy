  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "1 cup white sugar",
    "1 teaspoon vanilla extract",
    "2 cups frozen whipped topping, thawed",
    "1 (9 inch) prepared graham cracker crust",
    "1 (21 ounce) can apple pie filling"
  ],
  "steps": [
    {
      "text": "Beat together cream cheese, sugar, and vanilla in a large bowl with an electric mixer until smooth. Fold in whipped topping. Pour into graham crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with pie filling. Chill in the refrigerator for 1 to 2 hours before serving.",
      "section": null,
