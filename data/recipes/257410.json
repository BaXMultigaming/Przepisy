  "ingredients": [
    "18 fresh oysters in shells",
    "1 cup butter, softened",
    "1.5 tablespoons sriracha sauce",
    "1.5 tablespoons minced garlic",
    "1 tablespoon chopped green onions",
    "1 tablespoon chopped cilantro",
    "1 tablespoon fresh lime juice",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place oysters in a baking pan, flat-side up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter, sriracha sauce, garlic, green onions, cilantro, and lime juice together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake oysters in the preheated oven until they open slightly, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the top shell of the oysters using a towel and an oyster knife, being careful not to spill the liquor. Gently cut the muscles that attach the oysters to the shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide the butter mixture among the oysters, placing a dollop on each. Sprinkle Parmesan cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil oysters in the preheated oven until butter melts and Parmesan cheese is golden brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
