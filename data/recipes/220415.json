  "ingredients": [
    "1.5 cups all-purpose flour",
    "3.5 teaspoons baking powder",
    "1 tablespoon white sugar",
    "1 teaspoon salt",
    "1.25 cups milk",
    "3 tablespoons butter, melted",
    "1 egg",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hsL_lRZ94XNI7bvtKNvlg0UUvIo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22041-old-fashion-pancakes-DDMF-Step-1-6e3c22919b104730afdfd807a7fc68a1.jpg"
      ],
      "image": "assets/images/220415/step_01.webp"
    },
    {
      "text": "Sift together flour, baking powder, sugar, and salt in a large bowl. Whisk in milk, melted butter, and egg until combined. Let batter rest for 5 minutes. Preheat a large skillet over medium-high heat. Spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oSJRcsgNwSnHcUVLq46eLzI2WgU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22041-old-fashion-pancakes-DDMF-Step-3-8b81bd35b16a4f2491b32e4db04cf38d.jpg"
      ],
      "image": "assets/images/220415/step_02.webp"
    },
    {
      "text": "Pour batter into the hot skillet, about 1/4 cup batter for each pancake. Cook until bubbles appear on the sides and center of each pancake, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0QsH5QE89nvBUNvoEl9OXLfTDZE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22041-old-fashion-pancakes-DDMF-Step-4-cf60b5a1100649a5a26cbe53f16ad8a9.jpg"
      ],
      "image": "assets/images/220415/step_03.webp"
    },
    {
      "text": "Flip and cook until the bottom is golden, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tG4tbQwhorJ_7JQ6MRGlyrete10=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22041-old-fashion-pancakes-DDMF-Step-5-a9eac3a80cf34e33912be36a3d523a08.jpg"
      ],
      "image": "assets/images/220415/step_04.webp"
    },
    {
      "text": "Serve with butter and maple syrup and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uSATJaGKrQDgvVPOmJdFnv_0ZaQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22041-old-fashion-pancakes-DDMF-4x3-86e4c756f8814fff851d748460cb6d45.jpg"
