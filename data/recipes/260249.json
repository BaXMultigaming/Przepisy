  "ingredients": [
    "2 cups warm milk",
    "2 teaspoons white sugar",
    "1 (.25 ounce) package quick-rise yeast",
    "3.5 cups rice flour",
    "1.5 cups cornstarch",
    "3 teaspoons xanthan gum",
    "1 teaspoon garlic powder",
    "1 teaspoon dried oregano",
    "3 teaspoons white vinegar",
    "4 teaspoons canola oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease 2 pizza pans or baking sheets well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, sugar, and yeast together in a bowl. Set aside until foamy, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift rice flour, cornstarch, xanthan gum, garlic powder, and oregano together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix vinegar and oil together in a bowl. Whisk into the milk-yeast mixture, then pour the liquid into the flour. Knead until the dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Split the dough in half. Spread the dough thinly over the prepared pans using your fingers and fists.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on the lowest rack of the preheated oven until golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
