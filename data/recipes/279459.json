  "ingredients": [
    "4 red potatoes, cut into 1/2-inch cubes",
    "3 cloves garlic, minced",
    "2 tablespoons seafood seasoning (such as Old Bay®)",
    "1 teaspoon dried thyme"
  ],
  "steps": [
    {
      "text": "Fill a large pot halfway with water and bring to a boil. Reduce heat to medium-low and add garlic, seafood seasoning, and thyme. Let cook for 2 minutes; add potatoes. Drain some of the water mixture so that there is a thin layer just hovering over potatoes.",
