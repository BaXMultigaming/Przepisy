  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup cornmeal",
    "0.25 cup white sugar",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup shredded Cheddar cheese",
    "0.5 cup fresh spinach",
    "0.5 (14 ounce) can artichoke hearts, broken up with your fingers",
    "0.33333334326744 cup milk",
    "1 egg, lightly beaten"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cornmeal, sugar, baking powder, baking soda, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Cheddar cheese, spinach, artichoke hearts, milk, and egg together in a separate bowl. Stir into the flour mixture just until moistened. Pour into the prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes. Cool briefly on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
