  "ingredients": [
    "2 tablespoons olive oil",
    "0.5 cup diced onion",
    "1 large cooked chicken breast, shredded",
    "1.5 teaspoons chili powder",
    "1 teaspoon garlic powder",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon seasoned salt",
    "0.5 teaspoon red pepper flakes",
    "0.5 teaspoon ground cumin",
    "1 cup shredded Cheddar cheese",
    "2 (4 ounce) cans diced green chiles",
    "0.75 cup milk",
    "2 large eggs",
    "0.25 cup crushed pork rinds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease an 8-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat; stir in onion. Cook and stir until the onion has softened and turned translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onion with shredded chicken, chili powder, garlic powder, black pepper, seasoned salt, red pepper flakes, and cumin. Stir in 1/2 cup Cheddar cheese and green chiles. Spread in the bottom of the prepared baking pan and top with remaining Cheddar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and eggs together in a bowl. Stir in crushed pork rinds and pour over top of the casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until top of casserole is set, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
