  "ingredients": [
    "2.75 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.75 cups white sugar",
    "0.5 cup butter, melted",
    "1 cup mandarin orange segments, drained",
    "2 cups cranberries",
    "2 eggs",
    "0.75 cup milk",
    "0.75 cup sour cream",
    "1 teaspoon vanilla extract",
    "1 teaspoon orange extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 8x4-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together flour, baking powder, baking soda, salt, and white sugar. Mix in melted butter until mixture looks crumbly. Stir in cranberries and oranges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl or large measuring cup, whisk together eggs, milk, sour cream, vanilla, and orange extract. Pour liquid ingredients into the bowl with dry ingredients and stir just until blended. Divide batter evenly between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the crown comes out clean, about 40 minutes. Cool in the pans for a while, then remove from the pans and place on wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
