  "ingredients": [
    "cooking spray",
    "2.5 cups white sugar",
    "1 cup butter, melted",
    "1 tablespoon vanilla extract",
    "4 eggs",
    "1.5 cups all-purpose flour",
    "1 cup unsweetened cocoa powder",
    "1 teaspoon salt",
    "0.25 cup milk",
    "0.5 teaspoon white vinegar",
    "0.5 cup butter, softened",
    "0.5 cup creamy peanut butter",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1.25 cups all-purpose flour",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.75 cup chocolate chips, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 1/2 cups white sugar, 1 cup melted butter, and vanilla extract in a large bowl. Beat in eggs one at a time with an electric mixer, mixing well after each addition until thoroughly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift 1 1/2 cups flour, cocoa powder, and salt together in a bowl. Stir flour mixture gradually into butter mixture until blended. Spread batter evenly into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an inserted toothpick comes out clean, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk and vinegar in a large bowl and let stand for 5 minutes until milk sours. Add 1/2 cup butter, peanut butter, 1/2 cup white sugar, and brown sugar; stir until mixture is smooth and fully combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift 1 1/4 cups flour, baking soda, baking powder, and salt together in a small bowl. Mix into peanut butter mixture until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread peanut butter mixture over warm brownies. Drizzle melted chocolate chips on top. Refrigerate for 1 to 2 hours before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
