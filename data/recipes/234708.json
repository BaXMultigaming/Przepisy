  "ingredients": [
    "3 potatoes, peeled and cut into 1-inch cubes",
    "1 cup baby carrots",
    "1.5 cups green beans, sliced diagonally (also known as \"Frenched\")",
    "1 tablespoon olive oil",
    "1 (2 pound) boneless beef chuck roast",
    "1 (10.75 ounce) can cream of mushroom soup",
    "0.66666668653488 cup water",
    "1 (1 ounce) package dry onion soup mix"
  ],
  "steps": [
    {
      "text": "Spread potatoes into the bottom of a slow cooker. Layer carrots on top, followed by green beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium-high heat. Sear roast in hot oil until browned completely, about 2 minutes per side. Place roast over layered vegetables in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together condensed soup, water, and dry onion soup mix in a medium bowl; pour over roast and vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 8 to 10 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
