  "ingredients": [
    "cooking spray",
    "0.5 pound breakfast sausage",
    "1 small onion, diced",
    "0.5 cup milk",
    "5 large eggs",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon ground black pepper",
    "1 (12 ounce) package shredded Cheddar cheese, divided",
    "1 (16 ounce) package frozen bite-size potato nuggets (such as Tater Tots®)"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly spray a 2-quart baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Me2ZymscMqliBXQQIEGYXWf4YP0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-279858-tater-tot-breakfast-casserole-VAT-step-01-4feacd3fdc73415caadf9d58eacea394.jpg"
      ],
      "image": "assets/images/279858/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage and onion in the hot skillet until sausage is browned and crumbly, 5 to 7 minutes. Drain and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Si7E3lr95Vchi_EUo9ThC8SP3dc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-279858-tater-tot-breakfast-casserole-VAT-step-02-9b9feee2c3844d6fa1a19b6b452d99a6.jpg"
      ],
      "image": "assets/images/279858/step_02.webp"
    },
    {
      "text": "Meanwhile, whisk milk, eggs, onion powder, salt, garlic powder, and pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CMRjASEQ8exKVJRa-iHbDc7fNYs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-279858-tater-tot-breakfast-casserole-VAT-step-03-08398fdfbb2b423a953a40498031a40d.jpg"
      ],
      "image": "assets/images/279858/step_03.webp"
    },
    {
      "text": "Spread sausage mixture over the bottom of the prepared baking dish. Pour egg mixture over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x796h6wmNZIul1p_hYMlzVQR55A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-279858-tater-tot-breakfast-casserole-VAT-step-04-83abbe66023941c0b6230775d40b7f96.jpg"
      ],
      "image": "assets/images/279858/step_04.webp"
    },
    {
      "text": "Layer with 1/2 of the Cheddar cheese and all of the potato nuggets. Cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Okf_etVNzeBFTVibpbRu7qgYvwg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-279858-tater-tot-breakfast-casserole-VAT-step-05-8c814d9306b949fc8c125306e29df33e.jpg"
      ],
      "image": "assets/images/279858/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven for 40 minutes. Remove foil and sprinkle with the remaining cheese. Bake until melted, about 20 minutes more. Remove from the oven and let stand briefly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fKZwQDgV3KSs7lZyzuZyJne1NSE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-279858-tater-tot-breakfast-casserole-VAT-step-06-068bb47ee7424c27b50bf5f09d3043b4.jpg"
      ],
      "image": "assets/images/279858/step_06.webp"
    }
  ],
