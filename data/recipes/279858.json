  "title": "Cheesy Tater Tot Breakfast Casserole",
  "description": "This cheesy Tater Tot breakfast casserole has layers of savory sausage and potato baked in a fluffy egg mixture with cheese until golden and delicious.",
  "authors": [
    "Shannon Kimmich Kenny"
  ],
  "date_published": "2020-04-24T20:38:28-04:00",
