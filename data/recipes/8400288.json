  "ingredients": [
    "1.5 cups brown sugar",
    "1.5 cups ketchup",
    "0.5 cup vinegar",
    "0.5 cup bourbon whiskey",
    "2 tablespoons dry mustard",
    "1 tablespoon Worcestershire Sauce",
    "2 teaspoons salt",
    "1 teaspoon smoked paprika",
    "0.5 teaspoon freshly ground black pepper",
    "0.25 teaspoon liquid smoke"
  ],
  "steps": [
    {
      "text": "Combine brown sugar, ketchup, vinegar, whiskey, mustard, Worcestershire sauce, salt, paprika, pepper, and liquid smoke in a saucepan. Simmer for 15 minutes, stirring occasionally. Place in jars and refrigerate until use.",
