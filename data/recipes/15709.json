  "ingredients": [
    "1 teaspoon oil, or as needed",
    "1 pound skinless, boneless chicken breast meat",
    "1 (12 ounce) package egg noodles",
    "2 (12 ounce) jars chicken gravy",
    "3 cups frozen green peas, thawed"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet. Cube chicken into bite-sized pieces and brown in hot oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add hot cooked noodles to chicken in the skillet and pour in gravy and peas. Stir together until ingredients are coated with gravy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover skillet, reduce heat to medium-low, and let simmer for 10 minutes until gravy and peas are hot. Serve directly from the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
