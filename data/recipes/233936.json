  "ingredients": [
    "3 fresh peaches - peeled, pitted, and cubed",
    "2 cups cubed cooked chicken breast",
    "1 cucumber, seeded and chopped",
    "0.33333334326744 cup white sugar",
    "0.25 cup white wine vinegar",
    "0.25 cup minced fresh mint",
    "1 tablespoon lemon juice",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "3 dashes hot sauce, or to taste",
    "2 avocados - peeled, pitted, and cubed"
  ],
  "steps": [
    {
      "text": "Combine peaches, chicken, and cucumber in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sugar, vinegar, mint, lemon juice, salt, black pepper, and hot sauce in a blender; blend until smooth. Drizzle vinaigrette over peach mixture; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl with plastic wrap; refrigerate until chilled, at least 30 minutes. Fold avocado into salad before serving.",
      "section": null,
