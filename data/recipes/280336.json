  "ingredients": [
    "1 tablespoon Sriracha sauce",
    "1 tablespoon honey",
    "0.5 tablespoon lime juice",
    "0.5 tablespoon soy sauce",
    "0.5 teaspoon minced garlic",
    "0.5 pound large raw tail-on shrimp",
    "2 green onions, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk Sriracha, honey, lime juice, soy sauce, and garlic together in a large bowl. Stir in shrimp until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place shrimp in the air fryer basket with tongs; cook for 3 minutes. Transfer shrimp back to the sauce and stir. Place shrimp back in the basket and cook for 3 minutes more. Garnish with chopped green onions.",
