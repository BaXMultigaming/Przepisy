  "ingredients": [
    "1 (16 ounce) can refried black beans",
    "1 (16 ounce) can black beans",
    "1 (4 ounce) can diced green chiles",
    "1 teaspoon garlic powder",
    "1 teaspoon chili powder",
    "1 teaspoon cayenne pepper",
    "salt and ground black pepper to taste",
    "8 corn tostada shells",
    "2 cups shredded Monterey Jack cheese",
    "0.25 cup salsa, or as desired",
    "0.25 cup shredded lettuce, or as desired",
    "0.25 cup sour cream, or as desired",
    "0.25 cup guacamole, or as desired"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine refried black beans, black beans, green chiles, garlic powder, chili powder, cayenne, salt, and pepper in a saucepan. Heat over medium heat until warm and combined, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tostada shells on an ungreased baking sheet and evenly distribute bean mixture between them. Top with Monterey Jack cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until cheese is melted, watching carefully to avoid burning tostadas, 1 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve immediately and garnish with salsa, lettuce, sour cream, and guacamole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
