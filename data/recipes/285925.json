  "ingredients": [
    "3 tablespoons unsalted butter",
    "3.5 ounces fresh mushrooms, sliced",
    "1 clove garlic, minced, or more to taste",
    "2 tablespoons all-purpose flour",
    "0.75 cup half-and-half",
    "1 tablespoon soy sauce",
    "0.25 teaspoon salt, or as needed",
    "1 pinch freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium-high heat. Add mushrooms and cook until tender, about 3 minutes. Add garlic and cook until fragrant, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle flour over the mixture and stir to create a smooth paste. Slowly add half-and-half and continue to stir to prevent any lumps. Add soy sauce, salt, and pepper; stir to combine. Taste and adjust seasoning to your liking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
