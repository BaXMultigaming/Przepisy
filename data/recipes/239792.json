  "ingredients": [
    "12 vanilla wafer cookies",
    "2 (8 ounce) packages cream cheese, softened",
    "0.5 cup white sugar",
    "2 eggs, beaten",
    "0.5 teaspoon vanilla extract",
    "0.75 cup cherry pie filling, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 12 muffin cups with foil cupcake liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a vanilla wafer cookie into the bottom of each cupcake liner.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, sugar, eggs, and vanilla extract together in a bowl until smooth; pour atop the cookies until the liners are about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until center is nearly set and slightly collapsed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate cupcakes 2 hours to overnight. Spoon cherry pie filling onto the cupcakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
