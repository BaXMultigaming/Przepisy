  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "1 cup white sugar",
    "1 tablespoon lemon juice",
    "3 cups plain Greek yogurt",
    "2 cups pitted, chopped fresh cherries"
  ],
  "steps": [
    {
      "text": "Mash cream cheese and sugar together until well combined; stir in lemon juice until well combined. Stir in yogurt, 1 cup at a time, until smooth and creamy. Fold in cherries. Cover the bowl with plastic wrap; refrigerate until very cold, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer's instructions.",
