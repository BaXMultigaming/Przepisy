  "ingredients": [
    "1.5 pounds salmon fillets",
    "1 serving cooking spray",
    "0.5 cup water",
    "1 (8 ounce) can crushed pineapple",
    "0.25 cup reduced-sodium teriyaki sauce",
    "3 tablespoons pineapple preserves",
    "3 tablespoons Asian sweet chili sauce",
    "2 teaspoons reduced-sodium teriyaki sauce"
  ],
  "steps": [
    {
      "text": "Heat a large saute pan over medium-high heat for 2 minutes. Coat both sides of salmon fillets with cooking spray and add to the hot pan. Cook for 4 minutes. Flip, cover, and cook for 4 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk water, crushed pineapple, and 1/4 cup teriyaki sauce together in a bowl. Pour sauce over salmon; reduce heat to medium-low, cover, and cook for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pineapple preserves, chili sauce, and remaining 2 teaspoons teriyaki sauce together. Spoon evenly over salmon, cover, and remove from heat. Let stand for 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
