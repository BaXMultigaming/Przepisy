  "ingredients": [
    "0.5 cup butter",
    "1 finely chopped onion",
    "0.5 cup chopped celery",
    "0.5 cup sliced carrots",
    "0.5 pound fresh sliced mushrooms",
    "0.75 cup all-purpose flour",
    "6 cups chicken broth",
    "2 cups cooked wild rice",
    "1 pound boneless skinless chicken breasts, cooked and cubed",
    "0.5 teaspoon salt",
    "0.5 teaspoon curry powder",
    "0.5 teaspoon mustard powder",
    "0.5 teaspoon dried parsley",
    "0.5 teaspoon ground black pepper",
    "1 cup slivered almonds",
    "3 tablespoons dry sherry",
    "2 cups half-and-half"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-ZsfAQ-6LCrmVp30u4UqUjiN73o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18448-chicken-wild-rice-soup-DDMFS-082-1-d82b4976c30a406ebf70580953b6bd64.jpg"
      ],
      "image": "assets/images/18448/step_01.webp"
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Stir in onion, celery, and carrots and sauté for 5 minutes. Add mushrooms and sauté for 2 more minutes. Then add flour and stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RFaAAcwj46xHQGAKpsUgqV9RZVA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18448-chicken-wild-rice-soup-DDMFS-085-2-42328fd46e6d4aebbc96892b5e631e31.jpg"
      ],
      "image": "assets/images/18448/step_02.webp"
    },
    {
      "text": "Gradually pour in chicken broth, stirring constantly, until all has been added. Bring just to a boil, reduce heat to low and let simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y1lqH0KAzvaJCw1Ivn9VB-x5Irc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18448-chicken-wild-rice-soup-DDMFS-087-3-bc18e7b7a9514ea6aac09d32b4e56ec6.jpg"
      ],
      "image": "assets/images/18448/step_03.webp"
    },
    {
      "text": "Add rice, chicken, salt, curry powder, mustard powder, parsley, ground black pepper, almonds, and sherry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6PDsxOr-dldEzaYDyljgZLBb1SY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18448-chicken-wild-rice-soup-DDMFS-088-4-827cac038d054787b7ee722bfee3b944.jpg"
      ],
      "image": "assets/images/18448/step_04.webp"
    },
    {
      "text": "Allow to heat through, then pour in the half-and-half. Let simmer for 1 to 2 hours. (Note: Do not boil or your roux will break.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3qM4m8vM1dln3qzPzHlETz_EYqs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18448-chicken-wild-rice-soup-DDMFS-108-5-27154f49acb84618969484a1190adafe.jpg"
      ],
      "image": "assets/images/18448/step_05.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
