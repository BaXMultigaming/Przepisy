  "ingredients": [
    "2 tablespoons rum",
    "0.5 cup raisins",
    "0.5 cup water",
    "2 cups bread flour",
    "1 tablespoon dry milk powder",
    "2 teaspoons brown sugar",
    "1 teaspoon salt",
    "2 teaspoons butter",
    "2 tablespoons heavy whipping cream",
    "0.5 teaspoon rum flavored extract",
    "1 egg",
    "1 teaspoon olive oil",
    "1.5 teaspoons active dry yeast"
  ],
  "steps": [
    {
      "text": "In a small bowl, pour rum over raisins. Let stand for 30 minutes and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ingredients in pan in the order recommended by the manufacturer. Use the regular setting for a 1 pound loaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "If your machine has a Fruit setting, add the raisins at the signal, or about 5 minutes before the kneading cycle has finished.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
