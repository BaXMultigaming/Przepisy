  "ingredients": [
    "1 (9 inch) unbaked pastry shell",
    "1 cup white sugar",
    "1 cup water",
    "3 tablespoons cornstarch",
    "0.25 cup raspberry flavored Jell-O® mix",
    "2.5 cups raspberries",
    "1 cup whipped cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line pie crust (unpricked) with two layers heavy-duty aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 8 minutes. Remove foil; bake 5 minutes more. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, water, and cornstarch in a saucepan; cook over medium heat until sugar and cornstarch dissolve and mixture thickens, about 10 minutes. Off heat, whisk in gelatin mix. Refrigerate filling until slightly cooled, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange raspberries evenly in bottom of pie crust; pour gelatin filling over berries. Chill in the refrigerator until set, 4 to 6 hours. Garnish with whipped cream to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
