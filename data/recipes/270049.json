  "ingredients": [
    "5 (1-inch thick) boneless pork chops",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon garlic powder",
    "1 tablespoon olive oil",
    "1 cup honey",
    "0.25 cup brown sugar",
    "0.25 cup soy sauce",
    "2 teaspoons chopped garlic",
    "2 tablespoons butter",
    "0.25 teaspoon ground ginger",
    "1 dash cayenne pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season pork chops with salt, pepper, and garlic powder. Heat olive oil in a skillet over medium heat. Brown pork chops 3 to 4 minutes per side. Transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk honey, brown sugar, soy sauce, garlic, and butter together in a bowl and pour over the pork chops in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes. Remove from oven and let pork chops sit in the baking dish 5 minutes more to soak up juices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve pork chops topped with extra sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
