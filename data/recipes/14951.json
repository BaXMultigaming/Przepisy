  "ingredients": [
    "1.5 cups fresh lime juice",
    "0.75 cup olive oil",
    "6 cloves garlic, sliced",
    "2 teaspoons salt",
    "6 tablespoons dried oregano",
    "2 (1 pound) pork tenderloins"
  ],
  "steps": [
    {
      "text": "Combine lime juice, olive oil, garlic, salt, and oregano in a large resealable plastic bag. Seal the bag and shake until well combined. Taste marinade for tartness: if too tart, add a little more oil; if not enough zing, add more lime juice. The garlic and salt flavors should also be noticeable, but not overpowering. Place tenderloins into the bag, seal, and turn to coat. Marinate in the refrigerator for 2 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tenderloins from marinade and shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill tenderloins on the preheated grill for 20 to 30 minutes, turning once, or to desired doneness. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
