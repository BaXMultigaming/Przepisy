  "ingredients": [
    "0.5 pound bacon",
    "2 heads fresh broccoli",
    "1 small red onion",
    "0.75 cup raisins",
    "0.75 cup sliced almonds",
    "1 cup mayonnaise",
    "0.5 cup white sugar",
    "2 tablespoons white wine vinegar"
  ],
  "steps": [
