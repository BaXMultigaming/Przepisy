  "title": "Tilapia Feta Florentine",
  "description": "The Mediterranean flavors you love, including olive oil, lemon, garlic, and feta cheese, are combined in a quick fish dish served Florentine-style with fresh cooked spinach.",
  "authors": [
    "Eddie Riddell"
  ],
  "date_published": "2019-07-10T03:04:18-04:00",
