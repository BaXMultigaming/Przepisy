  "keywords": [],
  "ingredients": [
    "0.25 cup pecans",
    "0.5 cup all-purpose flour",
    "0.5 cup whole wheat flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "6 tablespoons cold butter, cut into small cubes",
    "0.25 cup cold water",
    "0.25 cup dark brown sugar",
    "1 cup pumpkin puree",
    "1 teaspoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spread pecans on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast pecans in the preheated oven until golden brown and fragrant, about 5 minutes. Chop coarsely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase oven temperature to 425 degrees F (220 degrees C). Brush a large rimmed baking sheet with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all-purpose flour, whole wheat flour, baking powder, and salt together in a bowl. Rub butter into the mixture until it reaches a crumbly consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water and brown sugar together in a bowl. Blend into crumbly mixture. Stir in pumpkin puree and fold in pecans. Wrap dough in plastic wrap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill dough in the freezer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 5 pieces and shape into balls. Flatten slightly and place 1 inch apart on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden brown, 12 to 15 minutes. Transfer to a wire rack and cool completely, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
