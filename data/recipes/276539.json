  "ingredients": [
    "3 cups water",
    "1.5 cups hard red winter wheat berries",
    "2 cups butternut squash cut into 1-inch cubes",
    "2 tablespoons extra-virgin olive oil, divided",
    "3 tablespoons orange juice",
    "1 tablespoon pure maple syrup",
    "1 large orange, zested",
    "0.5 cup chopped fresh parsley",
    "0.75 cup dried cranberries",
    "0.25 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a saucepan and add wheat berries. Reduce heat to low, cover, and let cook until soft, 45 to 50 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss squash with 1 tablespoon oil and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until tender, 20 to 30 minutes. Transfer squash to a paper towel-lined plate to soak up excess oil and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix orange juice, remaining oil, maple syrup, and orange zest together in a bowl for vinaigrette.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooked wheat berries, roasted squash, vinaigrette, parsley, and cranberries together in a large bowl. Let cool in the refrigerator, 10 to 20 minutes. Top salad with sliced almonds and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
