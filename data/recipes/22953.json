  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "0.75 cup unsweetened cocoa",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "2 eggs",
    "1 cup cold brewed coffee",
    "1 cup milk",
    "0.5 cup vegetable oil",
    "2 teaspoons vinegar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the flour, sugar, cocoa, baking soda, baking powder and salt. Make a well in the center and pour in the eggs, coffee, milk, oil and vinegar. Mix until smooth; the batter will be thin. Pour the batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 35 to 40 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
