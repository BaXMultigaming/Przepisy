  "ingredients": [
    "5.5 cups flaked coconut",
    "0.66666668653488 cup all-purpose flour",
    "0.25 teaspoon salt",
    "1 (14 ounce) can sweetened condensed milk",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tOWUKC8ZsFca5R6DmFTuXvJeGSs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25787-coconut-macaroons-step1--072-58efe6b03c3f470487a60603b4431741.jpg"
      ],
      "image": "assets/images/25787/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper or aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine coconut, flour, and salt in a large bowl; stir in sweetened condensed milk and vanilla extract until mixture is evenly blended. Use your hands if needed to combine thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tg8mBywTJjoDb9BPCV_UZXVETL0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25787-coconut-macaroons-iii-step2-075-9ca1accbed3443cfaec64531ec8558f6.jpg"
      ],
      "image": "assets/images/25787/step_03.webp"
    },
    {
      "text": "Drop coconut mixture onto the prepared baking sheets, about 1 inch apart, using a small ice cream scoop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c3eshi7s6m8QhSqmFAXshIWMook=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25787-coconut-macaroons-iii-step3-080-be91a1485423447a9040453ca2a59d73.jpg"
      ],
      "image": "assets/images/25787/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until tops are golden and lightly toasted, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Mph4HqAkqgpvTsRzQYQwNN2ZuBU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25787-coconut-macaroons-iii-step4-084-27134883039b42f79e03199ae9204276.jpg"
      ],
      "image": "assets/images/25787/step_05.webp"
    },
    {
      "text": "Cool macaroons on baking sheets for 5 minutes, then transfer to wire racks to cool completely. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zti8zi1OlUxkGdZktWQVC-z3Y7c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25787-coconut-macaroons-iii-DDMFS-4x3-55db21470b804257a10a2ec5c9b21e2e.jpg"
