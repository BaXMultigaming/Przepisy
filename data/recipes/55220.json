  "ingredients": [
    "2.25 pounds fresh lingonberries",
    "0.875 cup water",
    "1 cup white sugar"
  ],
  "steps": [
    {
      "text": "Place lingonberries and water in a large pot; bring to a boil. Boil for 5 to 10 minutes; skim off any foam from the surface. Stir in sugar, bring to a rapid boil, and continue boiling for a few more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle jam into sterile jars, leaving 1/4 inch of headspace. Cover with lids, and screw on rings. Process in a hot water bath for 10 minutes to seal. Refrigerate jam once the jar has been opened.",
      "section": null,
