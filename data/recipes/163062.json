  "ingredients": [
    "3 pounds turnips",
    "1 tablespoon vegetable oil",
    "0.33333334326744 cup grated Parmesan cheese",
    "1 teaspoon garlic salt",
    "1 teaspoon paprika",
    "1 teaspoon onion powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with a piece of aluminum foil and lightly grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel turnips, and cut into French fry-sized sticks, about 1/3 inch by 4 inches. Place into a large bowl and toss with vegetable oil to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5H7LT2qCFqdjR9YJISfv1OgT-Ko=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/163062-crispy-turnip-fries-ddmfs-52-step-1-71cb633cbe824062a752604e2da9d4fc.jpg"
      ],
      "image": "assets/images/163062/step_02.webp"
    },
    {
      "text": "Combine Parmesan, garlic salt, paprika, and onion powder in a resealable plastic bag; shake until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z0leTXOWo8UGj-pdqALNXz3d3-Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/163062-crispy-turnip-fries-ddmfs-54-step-2-92eda4536d4a4e8e830a663ba5d0a17d.jpg"
      ],
      "image": "assets/images/163062/step_03.webp"
    },
    {
      "text": "Place turnips into the bag and shake until evenly coated with the spices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IpVN6E-1u_K0jY0QXoLjio7g4JQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/163062-crispy-turnip-fries-ddmfs-55-step-3-57a5edd579ad45a9a767bb266b7c2a7e.jpg"
      ],
      "image": "assets/images/163062/step_04.webp"
    },
    {
      "text": "Spread out onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0-ySeATGr3m7PCnxRkd1SMq4zf0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/163062-crispy-turnip-fries-ddmfs-57-step-4-fbc5640928d343ad97da8a1d614e7f0b.jpg"
      ],
      "image": "assets/images/163062/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until the outside is crispy and the inside is tender, about 20 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dMA7XQxRrbgyC6nm6qvk9o1Ik3g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/163062-crispy-turnip-fries-ddmfs-57-step-474-step-5-c9b316d2c9c546d2b1efac8361fddcf0.jpg"
      ],
