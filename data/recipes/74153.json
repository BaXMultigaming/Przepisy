  "ingredients": [
    "3 tablespoons butter",
    "1 medium onion, chopped",
    "1 pound sliced fresh okra",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground coriander",
    "0.25 teaspoon ground black pepper",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Add onion and cook until tender. Stir in okra and season with cumin, ginger, coriander, pepper, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir for a few minutes, then reduce the heat to medium-low and cover the pan. Cook, stirring occasionally, until okra is tender, about 20 minutes.",
      "section": null,
      "name": null,
