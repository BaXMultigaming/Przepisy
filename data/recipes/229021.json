  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "2 ripe bananas, mashed",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 3 mini loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, and salt together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter with an electric mixer in a large bowl until light in color and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CkcGE8Y7APP7dRwO8rcp-rF0aIk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229021-BlueberryBananaBread-ddms-4x3-step1-2240f7700a3f4b2e97d5d88a430fd995.jpg"
      ],
      "image": "assets/images/229021/step_03.webp"
    },
    {
      "text": "Add eggs, one at a time, mixing well after each addition. Stir in vanilla extract; beat in mashed bananas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cWycXQB58dDUzdBm5-MWvN5RSiI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229021-BlueberryBananaBread-ddms-4x3-step2-adde4bff003846939cac396424e84e7f.jpg"
      ],
      "image": "assets/images/229021/step_04.webp"
    },
    {
      "text": "Add flour mixture a little at a time, beating until just combined into a thick batter. Fold in blueberries until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iVLI9KshzchK7djvyb9jFEoohVo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229021-BlueberryBananaBread-ddms-4x3-step3-6ee715d663f84836a24c72c21b8008bb.jpg"
      ],
      "image": "assets/images/229021/step_05.webp"
    },
    {
      "text": "Pour batter into the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/siAL5mZ0SMPFDRbnHePFxaerb2I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229021-BlueberryBananaBread-ddms-4x3-step4-b3c668fce95347d48bdada73bb362c78.jpg"
      ],
      "image": "assets/images/229021/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 35 minutes. Cool in the pans for 10 minutes, then transfer loaves to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XKiv2HXgPkEJSaK4Llj1GhcUsq8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229021-BlueberryBananaBread-ddms-4x3-step5-48585e63c95c49a6b7488759b82a8bbe.jpg"
      ],
      "image": "assets/images/229021/step_07.webp"
    }
