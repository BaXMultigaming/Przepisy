  "ingredients": [
    "0.25 cup butter or margarine",
    "4 (8 ounce) russet potatoes, quartered and sliced",
    "1 clove garlic, minced",
    "0.25 teaspoon paprika",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "2 teaspoons chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Add potatoes in an even layer; cover and cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with garlic, paprika, salt, and black pepper; stir to coat. Cover; cook 15 minutes more, flipping potatoes occasionally. Stir in chives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase heat to medium-high; cook until potatoes are tender, about 10 minutes more, stirring frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
