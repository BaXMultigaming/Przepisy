  "steps": [
    {
      "text": "Shuck corn and remove silk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the steamer basket inside a multi-functional pressure cooker (such as an Instant Pot). Add water and place 2 ears corn in the basket; stack remaining 2 ears corn on top, perpendicularly. Close and lock the lid. Close the vent.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Select Meat/Stew pressure setting according to the manufacturer's instructions; set the timer for 2 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid.",
      "section": null,
