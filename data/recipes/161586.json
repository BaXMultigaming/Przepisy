    "publisher-tested"
  ],
  "ingredients": [
    "3 cups all-purpose flour, divided, or more as needed",
    "1 tablespoon active dry yeast",
    "1 teaspoon white sugar",
    "1.33 cups water",
    "2 tablespoons butter, softened",
    "0.25 teaspoon salt",
    "3 tablespoons baking soda",
    "2 tablespoons butter, melted",
    "1 tablespoon coarse sea salt, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UDVp3U9LN6kn3vpqW3PoYjl6tS0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161586-papa-drexlers-bavarian-pretzels-DDMFS-001-step1-3c7d6d77f48b4bc58331904e3c51d07e.jpg"
      ],
      "image": "assets/images/161586/step_01.webp"
    },
    {
      "text": "Whisk 1 cup flour, yeast, and sugar together in a bowl. Stir in water and softened butter until well combined. Let stand until bubbles begin to form, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cMEM9OVhKCwG813tVI-5V9ypDRs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161586-papa-drexlers-bavarian-pretzels-DDMFS-001-step2-383c9f75589c438e8c1b410661e7ae39.jpg"
      ],
      "image": "assets/images/161586/step_02.webp"
    },
    {
      "text": "Stir salt into yeast mixture, then gradually stir in 2 1/2 cups flour until dough can be picked up in a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_35-3GSh93GqC2MGPo5-YZWurGc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161586-papa-drexlers-bavarian-pretzels-DDMFS-001-step4-20827a7103e64f3db90e876b08f259ee.jpg"
      ],
      "image": "assets/images/161586/step_03.webp"
    },
    {
      "text": "Knead until smooth and elastic, about 8 minutes, adding more flour if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D4QwkDVimGoRqXsK4P-g3ZLdUw8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161586-papa-drexlers-bavarian-pretzels-DDMFS-001-step6-384ca5aa783c4c24b13468044db932c1.jpg"
      ],
      "image": "assets/images/161586/step_04.webp"
    },
    {
      "text": "Divide dough into 6 pieces and let rest for a few minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SeC85Bmbb2TG1RYwiX8fxENATxA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161586-papa-drexlers-bavarian-pretzels-DDMFS-001-step7-b2714be2303947c79681efc345305142.jpg"
      ],
      "image": "assets/images/161586/step_05.webp"
    },
    {
      "text": "Roll one piece into a 15-inch rope, then loop and twist rope into a pretzel shape. Place onto a baking sheet and form remaining pretzels. Cover and let rise for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xWEPUGFNq84ellIBjVcwEqSyOc0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161586-papa-drexlers-bavarian-pretzels-DDMFS-001-step9-28dac7ab737244429ca66b656b77e65e.jpg"
      ],
      "image": "assets/images/161586/step_06.webp"
    },
    {
      "text": "Preheat the oven to 450 degrees F (220 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring 3 cups water to a boil in a pot. Stir in baking soda and remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0YUUxfsd8r21kT0mik1Ek8ISFCY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161586-papa-drexlers-bavarian-pretzels-DDMFS-001-step11-d92abd00913244adaf354455ba99d109.jpg"
      ],
      "image": "assets/images/161586/step_08.webp"
    },
    {
      "text": "Dip pretzels into the water bath for about 45 seconds, flipping over about halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FD00x0qqSu71lMjTuqDBAtzhCSQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161586-papa-drexlers-bavarian-pretzels-DDMFS-001-step12-766512249fc24274813ca2164af8f044.jpg"
      ],
      "image": "assets/images/161586/step_09.webp"
    },
    {
      "text": "Transfer soaked pretzels to the prepared baking sheet; brush with melted butter and sprinkle with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XPmV74h6IQ1jb8z6xTWZPeVb8IE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161586-papa-drexlers-bavarian-pretzels-DDMFS-001-step14-45cbf683c65a4d38b2dcd7a4fd40683c.jpg"
      ],
      "image": "assets/images/161586/step_10.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5jMISGXSBWYcpWQPSBxpTJM2Xd8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/161586-papa-drexlers-bavarian-pretzels-DDMFS-001-step15-f46df97b3ecd480295c73f33da8e5a69.jpg"
      ],
      "image": "assets/images/161586/step_11.webp"
    }
  ],
