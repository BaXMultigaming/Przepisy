  "ingredients": [
    "1.5 teaspoons white vinegar",
    "0.5 cup milk, or as needed",
    "1 cup white sugar",
    "1 (4 ounce) package cream cheese, softened",
    "0.5 cup butter, softened",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.5 cups fresh strawberries, mashed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x5x3-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour vinegar into a measuring cup; add milk until reaches ½ cup measuring mark.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut sugar, cream cheese, and butter together in a large bowl with a pastry blender until smooth. Add eggs, one at a time, blending after each addition. Add vanilla extract: mix until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, baking soda, and salt together in a bowl until combined; fold into egg mixture, in 4 additions, until batter is doughy. Fold in milk-vinegar mixture until blended, making sure not to overmix. Fold in mashed strawberries with juices until just combined. Transfer batter to the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
