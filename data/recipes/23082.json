  "ingredients": [
    "3 cups white sugar",
    "0.75 cup butter, softened",
    "3 large eggs",
    "2 cups mashed ripe banana",
    "0.5 cup sour cream",
    "3.5 cups all-purpose flour",
    "1.5 cups chopped pecans",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease and flour two 8x4-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together sugar and butter in a large bowl with an electric mixer until light and fluffy. Beat in eggs one at a time, mixing well after each addition. Stir in banana and sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, pecans, baking soda, baking powder, and cinnamon in a separate bowl; add to banana mixture, mixing until just combined. Pour batter into the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of each loaf comes out clean, 55 to 65 minutes. Remove loaves from the pans and place on a wire rack to cool. Serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
