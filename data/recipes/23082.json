  "title": "Janet&#39;s Famous Banana Nut Bread",
  "description": "Janet&#39;s banana bread is warm, nutty, and tastes great on a cold winter morning.",
  "authors": [
    "MARIK84"
  ],
  "date_published": "2000-07-22T12:07:44-04:00",
