  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 cup minced onion",
    "3 cloves garlic, minced",
    "2 teaspoons chili powder",
    "0.5 teaspoon cumin",
    "0.5 teaspoon oregano",
    "4 cups water",
    "4 cups shredded cooked turkey",
    "1 (28 ounce) can diced tomatoes",
    "1 (10.75 ounce) can condensed tomato soup",
    "1 cup salsa",
    "3 chicken bouillon cubes",
    "1 tablespoon dried parsley",
    "2 cups frozen corn",
    "1 (14 ounce) can black beans, rinsed, drained",
    "0.5 cup sour cream",
    "0.25 cup chopped fresh cilantro",
    "6 cups corn tortilla chips",
    "1 cup shredded Cheddar-Monterey Jack cheese blend",
    "0.75 cup chopped green onion",
    "0.5 cup chopped fresh cilantro",
    "0.5 cup sour cream"
  ],
  "steps": [
    {
      "text": "Heat oil in a large saucepan over medium heat. Add onion; cook until begins to soften, about 4 minutes. Add garlic, chili powder, cumin and oregano; cook, stirring, for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in water, turkey, diced tomatoes, tomato soup, salsa, bouillon cubes, and parsley. Bring to a boil, then reduce heat, and simmer until bouillon cubes dissolve, 5 minutes. Stir in corn, black beans, 1/2 cup sour cream, and 1/4 cup cilantro; simmer 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve soup with crushed tortilla chips, cheese, green onion, 1/2 cup cilantro, and 1/2 cup sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
