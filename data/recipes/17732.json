  "ingredients": [
    "3 cups crushed saltine crackers",
    "2 cups grated Parmesan cheese",
    "1 tablespoon Italian-style seasoning",
    "0.25 teaspoon garlic powder",
    "1 cup butter, melted",
    "6 pork chops"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine the crushed saltines, Parmesan cheese, Italian-style seasoning and garlic powder and mix together well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip the chops in the melted butter and then dredge each chop in the cracker mixture, coating all sides thoroughly. Place the chops in a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 425 degrees F (220 degrees C) for 30 to 40 minutes, or until internal pork temperature reaches 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
