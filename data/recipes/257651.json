  "ingredients": [
    "8 ounces smoked trout, skin removed, flaked",
    "8 ounces cream cheese",
    "0.33333334326744 cup sour cream",
    "1 tablespoon Worcestershire sauce",
    "1 green onion, finely chopped",
    "1 teaspoon garlic powder",
    "1 teaspoon paprika",
    "0.5 teaspoon lemon juice",
    "0.5 teaspoon prepared horseradish",
    "1 pinch cayenne pepper",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Stir trout, cream cheese, sour cream, Worcestershire sauce, green onion, garlic powder, paprika, lemon juice, horseradish, cayenne pepper, and black pepper together in a bowl until well blended. Cover and refrigerate for 30 minutes before serving.",
