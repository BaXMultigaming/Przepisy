  "ingredients": [
    "2 tablespoons olive oil",
    "1 onion, chopped",
    "1 green bell pepper, chopped",
    "1 clove garlic, minced",
    "1 pound ground pork",
    "1 tablespoon Creole seasoning (such as Tony Cachere's®)",
    "salt to taste",
    "1 head cabbage, cut into 2-inch squares",
    "0.5 (10 ounce) can diced tomatoes with green chile peppers (such as RO*TEL®), or more to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat. Add onion, green pepper, and garlic. Cook and stir until browned, about 5 minutes. Add pork, Creole seasoning, and salt. Cook until pork is browned, 5 to 7 minutes. Do not drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange cabbage over pork; cover with diced tomatoes. Add lid and reduce heat to medium. Cook, without stirring, until cabbage is wilted, 15 to 20 minutes. Stir and taste for seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
