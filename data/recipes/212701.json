  "ingredients": [
    "2 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cloves",
    "1 egg",
    "1.5 cups pumpkin butter, divided",
    "1 cup brown sugar",
    "0.5 cup apple juice",
    "0.25 cup melted butter",
    "0.5 cup raisins",
    "0.5 cup toasted chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease and flour a 3x7-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, cinnamon, nutmeg, salt, baking soda, and cloves together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a mixing bowl. Whisk in half pumpkin butter, brown sugar, apple juice, and melted butter until smooth. Stir in the flour mixture until no lumps remain. Fold in raisins and walnuts, if using, just until evenly distributed. Pour half of the batter into the prepared pan, spread the remaining pumpkin butter evenly over top, and pour in the remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 60 minutes. Cool in the pan for 10 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
