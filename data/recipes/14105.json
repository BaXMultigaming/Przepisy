  "steps": [
    {
      "text": "Combine green beans and 1/2 cup water in a medium pot. Cover, and bring to boil. Reduce heat to medium, and let beans cook for 10 minutes, or until tender. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beans in a medium serving bowl, and mix in bread crumbs, olive oil, salt, pepper, garlic powder, oregano and basil. Toss mixture until the beans are coated. Sprinkle with Parmesan cheese, and serve.",
