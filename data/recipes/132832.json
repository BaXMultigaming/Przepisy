  "ingredients": [
    "1 tablespoon vegetable oil",
    "0.5 onion, sliced",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon minced garlic",
    "1 pound pork tenderloin, thinly sliced",
    "1 (10 ounce) package sliced white mushrooms",
    "1 carrot, shredded",
    "3 tablespoons soy sauce",
    "2 tablespoons rice wine",
    "1 tablespoon brown sugar",
    "0.5 teaspoon cornstarch"
  ],
  "steps": [
    {
      "text": "Heat oil in a wok or large skillet over high heat until smoking. Add onion; stir-fry for 1 minute. Add ginger and garlic; stir-fry for 30 seconds. Add pork; stir-fry until browned, 2 minutes. Add mushrooms and carrot; stir-fry for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk soy sauce, rice wine, sugar, and cornstarch together in a small bowl; add to wok and bring to a boil. Cook until sauce has thickened and turned clear, 30 seconds.",
