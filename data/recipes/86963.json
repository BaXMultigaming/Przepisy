  "ingredients": [
    "0.5 cup butter",
    "1 cup sliced carrots",
    "1 cup cashews",
    "0.5 cup honey",
    "3 eggs",
    "1.5 cups heavy cream",
    "0.5 teaspoon nutmeg",
    "0.5 teaspoon salt",
    "0.75 cup shredded Cheddar cheese",
    "1 (9 inch) pie crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butter in a skillet over medium heat. Stir in the carrots and cashews, and cook until carrots are tender and cashews are golden brown. Mix in the honey.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, beat together the eggs, heavy cream, nutmeg, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Evenly spread the cheese in the bottom of the pie crust. Layer the carrot mixture over the cheese, and top with the egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 40 minutes in the preheated oven, until a toothpick inserted in the center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
