  "ingredients": [
    "0.5 cup finely chopped pumpkin seeds",
    "0.5 cup whole wheat flour",
    "0.5 cup all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "1.3333333730698 cups milk",
    "1 cup pumpkin puree",
