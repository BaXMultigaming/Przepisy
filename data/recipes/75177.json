  "ingredients": [
    "6 slices bacon",
    "1 pound ground beef",
    "1.5 cups chopped onion",
    "1 (31 ounce) can pork and beans, drained",
    "1 (31 ounce) can pork and beans, with liquid",
    "2 (15 ounce) cans kidney beans, drained",
    "1 (15 ounce) can lima beans, drained",
    "1.5 cups barbeque sauce",
    "0.33333334326744 cup packed brown sugar",
    "2 tablespoons cider vinegar",
    "1 teaspoon liquid smoke flavoring",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a Dutch oven. Cook over medium high heat until evenly brown. Drain, crumble, and set aside. Place the ground beef and onion in the Dutch oven. Cook until beef is evenly brown and onion is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return bacon to the Dutch oven. Mix in the drained pork and beans, pork and beans with liquid, kidney beans, and lima beans. Stir in the barbeque sauce, brown sugar, vinegar, and liquid smoke. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover Dutch oven, and bake 1 hour in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
