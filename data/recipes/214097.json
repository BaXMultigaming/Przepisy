  "ingredients": [
    "4 pounds pork spareribs, sawed in thirds across bones",
    "2 tablespoons garlic powder, divided",
    "1 tablespoon vegetable oil",
    "0.5 cup Kikkoman Less Sodium Soy Sauce",
    "0.25 cup dry sherry",
    "2 tablespoons packed brown sugar"
  ],
  "steps": [
    {
      "text": "Cut ribs into 1-rib pieces and toss with 1 teaspoon garlic powder. Brown half of ribs in hot oil in Dutch oven over medium-high heat; remove. Brown remaining ribs. Drain fat from pan. Return ribs to pan; stir 1/3 cup water, less sodium soy sauce, sherry and brown sugar. Cover and simmer 1 hour, or until ribs are done, stirring occasionally.",
