  "ingredients": [
    "1 (8 inch) angel food cake loaf",
    "0.5 cup Italian sweet cream-flavored creamer (from Coffee-Mate®)",
    "1 large egg",
    "1 teaspoon cinnamon sugar",
    "nonstick cooking spray",
    "1 tablespoon pure maple syrup"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 360 degrees F (180 degrees C) for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, slice angel food cake loaf into 1-inch slices. Cut each slice into thirds, then cut each in half so you will get 6 cubes from each slice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk creamer, egg, and cinnamon sugar together in a bowl. Dip each cube into the liquid and place cubes into the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air0fry for 6 minutes. Spray with nonstick spray. Reduce heat to 350 degrees F (175 degrees C) and air-fry for 5 more minutes. Serve immediately with maple syrup for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
