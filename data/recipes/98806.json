  "ingredients": [
    "1 quart apple cider vinegar",
    "1 (20 ounce) bottle ketchup",
    "1 pound dark brown sugar",
    "0.5 cup lemon juice",
    "0.25 cup paprika",
    "0.25 cup salt",
    "0.25 cup Worcestershire sauce",
    "2 tablespoons red pepper flakes",
    "1 tablespoon black pepper",
    "1 tablespoon garlic powder"
  ],
  "steps": [
    {
      "text": "Combine apple cider vinegar, ketchup, brown sugar, lemon juice, paprika, salt, Worcestershire sauce, red pepper flakes, black pepper, and garlic powder in a large container. Transfer to an empty sterilized vinegar bottle, ketchup bottle, or other large container with a lid; store in the refrigerator for up to 1 month.",
