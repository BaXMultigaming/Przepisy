  "ingredients": [
    "1 pound shredded, cooked chicken breast meat",
    "0.25 cup mayonnaise",
    "0.25 cup plain Greek yogurt",
    "1 medium avocado, chopped",
    "1 stalk celery, diced",
    "2 tablespoons freshly squeezed lime juice",
    "2 tablespoons chopped green onions",
    "1 tablespoon garlic powder",
    "1 teaspoon chopped fresh cilantro",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Mix chicken, mayonnaise, Greek yogurt, avocado, celery, lime juice, green onions, garlic powder, cilantro, salt, and pepper together in a large bowl until well combined. Cover and refrigerate for at least 30 minutes to let the flavors blend together.",
