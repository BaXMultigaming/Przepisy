  "ingredients": [
    "0.75 (16 ounce) box Barilla® Jumbo Shells",
    "1 cup ricotta cheese",
    "2 cups shredded mozzarella cheese",
    "1 (9 ounce) package frozen cut asparagus, chopped and cooked",
    "1.5 cups chopped prosciutto",
    "0.5 cup freshly grated Parmigiano-Reggiano cheese",
    "1 teaspoon salt",
    "1 teaspoon garlic powder",
    "0.125 teaspoon freshly ground black pepper",
    "1 (24 ounce) jar Barilla® Three Cheese Sauce"
  ],
  "steps": [
    {
      "text": "Cook shells according to package directions. Rinse cooked shells under cold water and drain. Cover and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together ricotta cheese, mozzarella cheese, asparagus, prosciutto, Parmigiano Reggiano cheese, salt, garlic powder, and black pepper in medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1 cup of Barilla Three Cheese Sauce into 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each shell with one heaping tablespoon of filling; place in baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour remaining sauce over shells. Cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 45 minutes or until thoroughly heated. Let stand 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
