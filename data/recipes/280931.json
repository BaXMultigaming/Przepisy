  "ingredients": [
    "2 zucchini, sliced lengthwise into 1/4-inch-thick strips",
    "1 tablespoon olive oil",
    "0.5 teaspoon dried rosemary",
    "0.25 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.125 teaspoon freshly ground black pepper, or to taste",
    "1 serving olive oil cooking spray"
  ],
  "steps": [
    {
      "text": "Toss zucchini strips with olive oil in a bowl until evenly coated. Toss in rosemary, salt, garlic powder, and pepper until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a grill pan over medium-high heat; coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill zucchini until soft and grill marked, 4 to 5 minutes per side. Work in batches if needed, coating pan with cooking spray between batches.",
