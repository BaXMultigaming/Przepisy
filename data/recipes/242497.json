  "ingredients": [
    "1 pound lean ground beef",
    "2 (8.8 ounce) pouches UNCLE BEN'S® Ready Rice® Garden Vegetable",
    "1 (1.25 ounce) package sodium-reduced taco seasoning",
    "0.75 cup water",
    "0.5 cup shredded Cheddar cheese, divided",
    "2 roma (plum) tomatoes, seeded and chopped",
    "1 avocado - peeled, pitted and sliced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly oil a 10-inch round baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a 10-inch non-stick skillet over medium heat. Cook ground beef, breaking up chunks, until until browned throughout, about 10 minutes. Drain off fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomatoes, taco seasoning, and water and bring to a low simmer; simmer about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook rice according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together ground beef mixture, rice, and 1/4 cup cheese. Spread into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with remaining cheese and bake until cheese is melted and bubbly, about 10 to 15 minutes .",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with your favorite toppings such as chopped tomatoes or avocado slices, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
