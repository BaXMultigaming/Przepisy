  "ingredients": [
    "3 large eggs",
    "1.25 cups white sugar, or more to taste",
    "0.5 cup all-purpose flour",
    "0.5 cup corn syrup",
    "6 tablespoons unsalted butter, melted",
    "0.5 teaspoon salt",
    "0.5 teaspoon lemon juice",
    "1.5 cups semisweet chocolate chips",
    "1.5 cups chopped pecans",
    "1 (9 inch) unbaked pie shell"
  ],
  "steps": [
    {
      "text": "Gather ingredients and preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zZ8X7eRAFt1rs5IlnIae840V5rA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15850-chocolate-chip-pecan-pie-VAT-step-01-9ebef9e25eb1464da1c7ec47f2fd9b37.jpg"
      ],
      "image": "assets/images/15850/step_01.webp"
    },
    {
      "text": "Beat eggs in a large mixing bowl with an electric mixer until light and fluffy. Add sugar, flour, corn syrup, melted butter, salt, and lemon juice; mix until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xom1b2iKPueDf6qzOexkkO3xuhk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15850-chocolate-chip-pecan-pie-VAT-step-02-ae0fa7bd8f6e4994bd996fc704998b2e.jpg"
      ],
      "image": "assets/images/15850/step_02.webp"
    },
    {
      "text": "Stir in chocolate chips and pecans, then pour mixture into the pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vSuKGUcScOWzEO2os01oN6RbD0E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15850-chocolate-chip-pecan-pie-VAT-step-03-c2599177b4824438aeae42d4d2f7d52a.jpg"
      ],
      "image": "assets/images/15850/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until crust is golden and filling is set, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uuEaHqvGfJnHi54q2sUbMmUr5q4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15850-chocolate-chip-pecan-pie-VAT-step-04-b-7728fcfffa7946068c65ce39e40789cb.jpg"
      ],
      "image": "assets/images/15850/step_04.webp"
    },
    {
      "text": "Remove from the oven and let cool and set before serving.",
      "section": null,
      "name": null,
      "url": null,
