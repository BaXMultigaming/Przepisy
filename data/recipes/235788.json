  "ingredients": [
    "0.75 cup confectioners' sugar",
    "0.33333334326744 cup peanut butter",
    "1 baked (9-inch) pie crust",
    "2 cups milk",
    "0.5 cup white sugar",
    "0.33333334326744 cup all-purpose flour",
    "2 egg yolks, beaten",
    "0.125 teaspoon salt",
    "2 teaspoons butter",
    "1 teaspoon vanilla extract",
    "1 (4 ounce) container frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Stir confectioners' sugar and peanut butter together in a bowl until crumbly. Remove 2 tablespoons peanut butter mixture to a small bowl and reserve as a garnish. Spread remaining peanut butter mixture into the bottom of the pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, white sugar, flour, egg yolks, and salt together in a saucepan over medium heat until mixture begins to bubble and thicken, 5 to 10 minutes. Remove from heat and stir in butter and vanilla. Pour milk mixture over peanut butter mixture and cool pie completely in refrigerator, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread whipped topping over chilled pie and sprinkle reserved 2 tablespoons peanut butter mixture over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
