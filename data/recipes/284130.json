  "title": "Vegan Banana-Nut-Carob Muffins",
  "description": "These vegan banana muffins with walnuts and carob chips are a healthy, yummy way to start your day.",
  "authors": [
    "Guarin Family"
  ],
  "date_published": "2021-02-03T20:12:58-05:00",
