  "ingredients": [
    "1 zucchini, cut into 1/4-inch slices",
    "1 clove garlic, peeled",
    "1 egg, beaten",
    "2 tablespoons all-purpose flour",
    "2 tablespoons dry bread crumbs, or more as needed",
    "2 tablespoons olive oil, or more as needed"
  ],
  "steps": [
    {
      "text": "Rub zucchini slices with garlic; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beaten egg, flour, and bread crumbs separately into 3 small bowls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn zucchini slices in flour, dusting off excess. Dip in egg, then press in bread crumbs to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium-high heat and pan-fry breaded zucchini in batches in hot oil until lightly browned on both sides, about 5 minutes.",
      "section": null,
      "name": null,
