  "ingredients": [
    "1 cup dried red beans",
    "1.5 cups white sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yp10fQFbUJF61FaOoX9WNohJasA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/238507-anko-sweet-red-bean-paste-ddmfs-4x3-step-01-1280-bcc347f1f02d47b0a14e0cb8d1a748b1.jpg"
      ],
      "image": "assets/images/238507/step_01.webp"
    },
    {
      "text": "Place beans in a saucepan and cover with 2 cups water; bring to a boil and cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yo9Fwwta2gl81GOIxWI9ivRNL4w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/238507-anko-sweet-red-bean-paste-ddmfs-4x3-step-02-1281-3811138b9df34662b04162d4fb3d6f60.jpg"
      ],
      "image": "assets/images/238507/step_02.webp"
    },
    {
      "text": "Drain beans and transfer to a clean saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yY7mwfLI-zQiH3u28VQ4pNKyYSE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/238507-anko-sweet-red-bean-paste-ddmfs-4x3-step-03-1282-e6d49e17af344d71b4076be9ea0a5fa7.jpg"
      ],
      "image": "assets/images/238507/step_03.webp"
    },
    {
      "text": "Cover with 2 to 3 cups water and bring to a boil. Reduce the heat to low, cover, and simmer, adding more water as needed, until beans are soft and can be crushed between your fingers, 1 1/2 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jC1DgB4ybYl8bVYt8LYNmZGHxIo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/238507-anko-sweet-red-bean-paste-ddmfs-4x3-step-04-1375-2d79efcb727c4f858903bbf3daf01094.jpg"
      ],
      "image": "assets/images/238507/step_04.webp"
    },
    {
      "text": "Drain beans and return to the saucepan. Add sugar and set over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Eaeeq0bE0apiZrNPPSF9acyjo78=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/238507-anko-sweet-red-bean-paste-ddmfs-4x3-step-05-1376-b8d9b50880b3424397fa04a81da86b2b.jpg"
      ],
      "image": "assets/images/238507/step_05.webp"
    },
    {
      "text": "Cook, stirring constantly, until sugar melts and beans form a loose, shiny paste, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YkL6VLSgLFPjj45ZjjIpvxWm59Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/238507-anko-sweet-red-bean-paste-ddmfs-4x3-step-06-1404-2223bb05cb4541fcbbba56ad9026eb98.jpg"
      ],
      "image": "assets/images/238507/step_06.webp"
    },
    {
      "text": "Immediately transfer paste to a container to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NbZyKOLwPxJ85erEOwGJoAFxvRI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/238507-anko-sweet-red-bean-paste-ddmfs-4x3-step-07-1406-f53c8724976846238be5027f6e07b619.jpg"
