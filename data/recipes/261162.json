  "ingredients": [
    "2 tablespoons vegetable oil",
    "1 clove garlic, minced, or more to taste",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "salt to taste",
    "1 (4 ounce) package crumbled feta cheese",
    "3 sheets frozen puff pastry, thawed",
    "1 large egg, beaten",
    "1 tablespoon milk",
    "2 tablespoons sesame seeds"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Add garlic and cook until fragrant, 1 to 2 minutes. Stir in spinach and cook until warmed through, 3 to 5 minutes; season with salt and mix well. Transfer to a bowl; mix in feta cheese until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bli5xsHWfxh0PGIMhLsC-qYwd8s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261162-spinach-rolls-with-puff-pastry-ddmfs-step2-0123-5affbe43da5b4b1baed917eade0c0f1d.jpg"
      ],
      "image": "assets/images/261162/step_01.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay 1 sheet of puff pastry on a lightly floured surface and cut in half lengthwise. Roll 1 half out with a rolling pin so it is wide enough to fold twice lengthwise. Mix egg and milk together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0iFLMyplDqwAhwiIDWcQNnAhAd4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261162-spinach-rolls-with-puff-pastry-ddmfs-step3-0126-dc8bb988ea4d4ea79f003350e7ec8d7f.jpg"
      ],
      "image": "assets/images/261162/step_03.webp"
    },
    {
      "text": "Spread 1/6 of the spinach mixture lengthwise in the center of puff pastry. Roll one side over the filling and brush other side with egg mixture. Roll over again to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/u3_-QZKILN7gh1NkArKWLQoGNZY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261162-spinach-rolls-with-puff-pastry-ddmfs-step5-0128-4ac720c8f067491e9874b05e2ec1c690.jpg"
      ],
      "image": "assets/images/261162/step_04.webp"
    },
    {
      "text": "Brush top of roll with egg mixture and sprinkle with sesame seeds. Cut roll into 6 equal-sized rolls. Repeat with the remaining puff pastry. Place cut rolls onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dxLRdz5-yzquE8EKYdVei8RoKaI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261162-spinach-rolls-with-puff-pastry-ddmfs-step8-0133-600c4455ae3a4fcf92d48fefe9e4be8e.jpg"
      ],
      "image": "assets/images/261162/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until spinach rolls are puffed up and golden, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n4i9yqva-UplGwQ_B3u1AxZoTpg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261162-spinach-rolls-with-puff-pastry-ddmfs-step9-0150-1a1ac69976704847971c9f8a3dae4251.jpg"
      ],
      "image": "assets/images/261162/step_06.webp"
    }
