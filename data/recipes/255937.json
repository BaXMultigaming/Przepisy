  "ingredients": [
    "3 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons ground ginger",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon pumpkin pie spice",
    "3 eggs",
    "3 cups milk",
    "0.5 cup molasses",
    "0.5 cup coconut oil, melted",
    "2 teaspoons vanilla extract",
    "1 teaspoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Mix flour, baking powder, ginger, cinnamon, salt, baking soda, and pumpkin pie spice together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a separate bowl until smooth. Mix in milk, molasses, coconut oil, and vanilla extract. Whisk flour mixture into milk mixture until batter is combined; a few lumps are okay.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a griddle lightly with oil; preheat over medium-low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter by large spoonfuls onto the griddle and cook until bubbles form and the edges are dry, about 4 minutes. Flip and cook until browned on the other side, about 3 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
