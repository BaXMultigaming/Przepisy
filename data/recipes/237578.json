  "ingredients": [
    "6 cups leftover mashed potatoes",
    "4 cups all-purpose flour",
    "0.75 cup dry farina cereal (such as Cream of Wheat®)",
    "3 eggs",
    "3 egg yolks",
    "2 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Mix potatoes, flour, cereal, eggs, egg yolks, and salt together in a bowl using your hands until the mixture comes together into a workable dough. Roll dough into 4- to 5-inch long logs with the diameter of a quarter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil, add the dough logs, and cook until the dumplings float, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
