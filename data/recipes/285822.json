  "ingredients": [
    "1 pound fresh strawberries, hulled and sliced",
    "1 tablespoon white sugar, or more to taste",
    "2 (16 ounce) containers sour cream",
    "2 (7.6 ounce) cans table cream (such as Nestle Media Crema®)",
    "1 (14 ounce) can sweetened condensed milk (such as Nestle La Lechera®)",
    "1 (8 ounce) package cream cheese, softened",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine sliced strawberries and sugar in a bowl, toss to coat, set aside, and let strawberries macerate, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip sour cream, table cream, sweetened condensed milk, cream cheese, and vanilla with an electric mixer in a separate bowl until well combined; the mixture will be thin. Gently fold strawberries into the cream mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for 4 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
