  "ingredients": [
    "1.25 cups confectioners' sugar, plus extra for dusting",
    "0.75 cup almond flour",
    "0.25 cup all-purpose flour, sifted",
    "4 egg whites",
    "0.33333334326744 cup melted butter",
    "0.5 cup Nutella® hazelnut spread"
  ],
  "steps": [
    {
      "text": "In a mixing bowl, combine confectioners' sugar, almond flour and sifted all-purpose flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in egg whites and melted butter until well combined. Refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F. Grease and flour a mini muffin pan; divide batter equally among 24 muffin cups or in muffin pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on center rack for 12 minutes. Let cool for 10 minutes in pan on rack; remove from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a toothpick to create a small hole in each cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon Nutella® into piping bag; fill each hole with 1/2 tsp of Nutella® hazelnut spread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish tops with remaining Nutella® and sprinkle with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
