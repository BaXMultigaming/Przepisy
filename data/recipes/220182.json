  "ingredients": [
    "1.5 pounds extra-lean ground beef",
    "0.5 onion, diced",
    "1 green pepper, diced",
    "2 cloves garlic, minced",
    "2 cups water, divided",
    "0.75 cup ketchup",
    "2 tablespoons brown sugar",
    "1 teaspoon Dijon mustard",
    "1.5 teaspoons salt, or to taste",
    "0.5 teaspoon ground black pepper",
    "1 dash Worcestershire sauce",
    "1 pinch cayenne pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/airb8WjGZqVWkMUjPLNmrWNmSoQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220182-HomemadeSloppyJoes-Step-01-5929884546574e609ec7889d92314400.jpg"
      ],
      "image": "assets/images/220182/step_01.webp"
    },
    {
      "text": "Place ground beef and onion in a large skillet over medium heat; cook and stir until beef is browned and crumbled, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HeHIzqxeRQeX4CfauYoowT5XjUA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220182-HomemadeSloppyJoes-Step-02-70e9eec23bfc4516bfcda8e71397b8d6.jpg"
      ],
      "image": "assets/images/220182/step_02.webp"
    },
    {
      "text": "Stir in green pepper and garlic; cook and stir until softened, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z1pIjpIzafpISJyKCE6ajFnVoqI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220182-HomemadeSloppyJoes-Step-03-49dd046e32744971accfb1917190da4f.jpg"
      ],
      "image": "assets/images/220182/step_03.webp"
    },
    {
      "text": "Add 1 cup water and stir, scraping the pan to dissolve any brown flavor bits from the bottom of the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r7SX8yCsIWmHQmWDPDpnqHU99ps=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220182-HomemadeSloppyJoes-Step-04-511e60a9331f43a68e1eaf925c9095f7.jpg"
      ],
      "image": "assets/images/220182/step_04.webp"
    },
    {
      "text": "Stir in ketchup, brown sugar, Dijon mustard, salt, black pepper, and Worcestershire sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WNdDyj34X6VU1QNdt70cLRL3lSQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220182-HomemadeSloppyJoes-Step-05-322b9e430dce432ea9af54fd86c3ebba.jpg"
      ],
      "image": "assets/images/220182/step_05.webp"
    },
    {
      "text": "Add remaining 1 cup water and bring mixture to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DqxttQoaoobLIw_Q1yHfMON0pu8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220182-HomemadeSloppyJoes-Step-06-9d65e50a902145f3ad2f621eb53027e0.jpg"
      ],
      "image": "assets/images/220182/step_06.webp"
    },
    {
      "text": "Reduce heat to low and simmer, stirring occasionally, until liquid has evaporated and mixture is thick, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SOfn0Qs_8nvhx1CriAuxgsq9ZOA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220182-HomemadeSloppyJoes-Step-07-591e4049277549e99230cfb980e34d6d.jpg"
      ],
      "image": "assets/images/220182/step_07.webp"
    },
    {
      "text": "Season with salt, black pepper, Worcestershire sauce, and cayenne pepper. Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yBWCYBYJTHu2BtFIMmSC_NABTyQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220182-HomemadeSloppyJoes-beauty-4x3-6edf75ff81ff4192955f95a7af4b8e99.jpg"
      ],
      "image": "assets/images/220182/step_08.webp"
    }
