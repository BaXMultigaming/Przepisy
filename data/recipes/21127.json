  "title": "Baked Apples",
  "description": "These baked apples with brown sugar, butter, and cinnamon are very simple to make and delicious topped with vanilla ice cream for a cozy fall dessert.",
  "authors": [
    "LuCynda"
  ],
  "date_published": "2000-09-16T20:45:45-04:00",
  "date_modified": "2026-06-04T14:37:14-04:00",
