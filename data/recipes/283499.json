  "ingredients": [
    "2 pounds potatoes, washed",
    "5 medium tomatoes, chopped",
    "1 cup ramp, wild leek",
    "1 (6 ounce) container crumbled feta cheese",
    "1 tablespoon olive oil, or as needed",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain. Cool; cut potatoes in half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C) with rack in center position. Lightly brush a baking sheet with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomatoes, ramps, and feta in a bowl; season with salt and black pepper. Place about 1 tablespoon feta mixture on each potato half; transfer to the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is lightly browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
