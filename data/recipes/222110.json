  "ingredients": [
    "1.25 cups all-purpose flour",
    "1 cup white whole wheat flour",
    "2 teaspoons ground ginger",
    "1 teaspoon baking soda",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon salt",
    "0.75 cup unsalted butter",
    "0.75 cup white sugar",
    "1 egg",
    "1 tablespoon water",
    "0.25 cup molasses",
    "3 tablespoons natural (raw) sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Sift together all-purpose flour and whole-wheat flour, ginger, baking soda, cinnamon, cloves, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and 3/4 cup sugar with an electric mixer in a large bowl until smooth. Beat in egg, then stir in water and molasses. Gradually stir in flour mixture until just incorporated. Roll dough into walnut-sized balls and place 2 inches apart onto ungreased baking sheets; flatten slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until cookies are golden brown, 8 to 10 minutes. Allow cookies to cool on baking sheet for 5 minutes before removing to a wire rack to cool completely. Store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
