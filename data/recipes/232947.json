  "ingredients": [
    "1 pound lean ground beef",
    "0.5 cup chopped celery",
    "0.25 cup chopped onion",
    "0.5 (10.75 ounce) can condensed tomato soup",
    "2.5 tablespoons ketchup",
    "2 tablespoons packed brown sugar",
    "1.5 teaspoons white vinegar",
    "0.75 teaspoon Worcestershire sauce",
    "1 tablespoon taco seasoning mix",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "8 hot dogs",
    "8 hot dog buns, split and toasted"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tP-QVNNctqtwAFEkyhC28EfbJxc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232947-not-so-sloppy-hot-dogs-VAT-006-step-01-1f4268a36d104323bd3e5b6cfbc89421.jpg"
      ],
      "image": "assets/images/232947/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Add celery and onion; cover skillet and cook until celery and onion are tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/upa8j_jrJNosRqO_rzmjtPGc4II=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232947-not-so-sloppy-hot-dogs-VAT-007-step-02-06af9784764a4c64a66eb71503427bb6.jpg"
      ],
      "image": "assets/images/232947/step_02.webp"
    },
    {
      "text": "Stir tomato soup, ketchup, brown sugar, vinegar, and Worcestershire sauce into ground beef mixture; season with taco seasoning, garlic powder, and salt. Simmer mixture, stirring frequently, until flavors have blended, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/itQqqTKfl2IPi-Gun8XkAlSWb9E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232947-not-so-sloppy-hot-dogs-VAT-008-step-03-40c12afc0c1f48e69e292423886a171b.jpg"
      ],
      "image": "assets/images/232947/step_03.webp"
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a boil; boil hot dogs in the boiling water until cooked through, 5 to 10 minutes. Remove hot dogs from water using tongs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_medLKngaXqeveBwnO1LgRxlkbc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232947-not-so-sloppy-hot-dogs-VAT-009-step-04-c1ef834eb7c24a678cdb4540edb0dcfd.jpg"
      ],
      "image": "assets/images/232947/step_04.webp"
    },
    {
      "text": "Place each hot dog into a toasted bun; top each hot dog with ground beef mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pfLpjd0CHbQ8nDxgnhB7PLS406Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232947-not-so-sloppy-hot-dogs-VAT-010-step-05-dcab9b75296648b68de30145102c6f56.jpg"
