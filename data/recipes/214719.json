  "ingredients": [
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.25 cup butter, softened",
    "3 eggs, beaten",
    "0.25 cup minced onion",
    "0.25 cup diced green bell pepper",
    "0.25 cup diced sweet red bell pepper",
    "1 cup grated sharp Cheddar cheese",
    "1 cup mushrooms, chopped"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 375 degrees F (190 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, salt, and garlic powder together in a small bowl. Set aside. Whisk together butter and eggs until well combined, then stir in the flour mixture. Fold in the onion, green bell pepper, red bell pepper, Cheddar cheese, and mushrooms. Mix well, the batter will be stiff. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 minutes to 1 hour. Cool in the pan for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
