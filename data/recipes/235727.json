  "ingredients": [
    "8 ounces bacon",
    "4 stalks celery, minced",
    "0.5 cup mayonnaise",
    "0.25 cup minced yellow onion",
    "1.5 tablespoons sweet pickle relish",
    "1.5 tablespoons prepared yellow mustard",
    "2 teaspoons chile-garlic sauce (such as Sriracha®)",
    "1.5 teaspoons dried dill weed",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon paprika",
    "0.25 teaspoon salt",
    "12 hard boiled eggs, shells removed"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until crispy, about 10 minutes. Drain on paper towels; crumble once cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bacon, celery, mayonnaise, onion, relish, mustard, chili garlic sauce, dill, Worcestershire sauce, black pepper, paprika, and salt in a large bowl; add eggs. Break up eggs with a potato masher; stir salad until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl with plastic wrap; refrigerate at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
