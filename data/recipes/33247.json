  "ingredients": [
    "0.75 pound sashimi grade tuna steak, diced",
    "0.5 cup diced cucumber",
    "1 avocados - peeled, pitted and diced",
    "0.25 cup chopped green onion",
    "1.5 teaspoons red pepper flakes",
    "1 tablespoon toasted sesame seeds",
    "1.5 teaspoons lemon juice",
    "2 teaspoons sesame oil",
    "0.5 cup soy sauce"
  ],
  "steps": [
    {
      "text": "In a medium bowl, combine the tuna, cucumber, avocado, green onion, red pepper flakes and sesame seeds. Pour in the lemon juice, sesame oil and soy sauce, and stir carefully to blend so as not to mash the avocado. Place this bowl into a larger bowl that has been filled with ice. Chill in the refrigerator for 15 minutes, but no longer - the terrific freshness of the fish will be lost.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once chilled, remove the bowl from the ice, and invert onto a serving plate. Serve with toasted bread or your favorite crackers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
