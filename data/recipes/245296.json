  "ingredients": [
    "0.75 cup white sugar",
    "0.25 cup butter, softened",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.25 cup cocoa powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, butter, egg, and vanilla together in a large bowl. Mix flour, cocoa, baking soda, and salt in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat flour mixture into sugar mixture slowly until well-combined, about 2 minutes. Stir chocolate chips into cookie dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon cookie dough onto the baking sheet, spaced about 2-inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are crisp, 10 to 12 minutes. Cool on the baking sheet for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
