  "ingredients": [
    "1 (16 ounce) package spaghetti",
    "0.5 cup canola oil",
    "4.5 tablespoons sesame oil",
    "4.5 tablespoons honey",
    "3 tablespoons soy sauce",
    "1 teaspoon salt",
    "1 teaspoon crushed red pepper flakes",
    "0.5 cup dry-roasted peanuts",
    "0.5 cup chopped green onion"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain and transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine canola oil, sesame oil, honey, soy sauce, salt, and pepper flakes in a microwave-safe bowl; mix to combine. Microwave on high powder for 30 seconds. Remove from the microwave and mix in peanuts and green onions. Pour over noodles and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
