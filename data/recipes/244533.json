  "ingredients": [
    "0.5 cup warm water (110 degrees F/45 degrees C)",
    "1 teaspoon white sugar",
    "2.25 teaspoons active dry yeast",
    "3 cups all-purpose flour",
    "2 cups water",
    "0.5 cup butter, melted",
    "1 teaspoon salt",
    "0.25 cup white sugar",
    "1 tablespoon vanilla extract",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Combine 1/2 cup warm water and 1 teaspoon sugar in a very large mixing bowl; add yeast. Let stand until yeast softens and begins to form a creamy foam, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour, 2 cups water, melted butter, and salt to yeast mixture; stir until smooth. Cover the bowl with plastic wrap and refrigerate, 8 hours to overnight; dough will rise quite a bit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to make waffles, stir 1/4 cup sugar, vanilla, and baking soda into batter until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions. Lightly grease the hot iron.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, pour in about 1/4 cup batter for each waffle. Cook until waffles are golden brown and the iron stops steaming, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
