  "ingredients": [
    "16 ounces ground meatloaf mix (beef, veal, pork)",
    "1 large egg, beaten",
    "0.5 cup grated BelGioioso Romano cheese",
    "1 tablespoon chopped fresh parsley",
    "0.5 clove garlic, minced",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.75 cup fresh breadcrumbs",
    "0.5 cup lukewarm water",
    "4 BelGioioso Mild Provolone cheese slices",
    "1 baguette, cut into 8 slices, split",
    "0.5 cup onion slices, pan-grilled",
    "0.5 cup sun-dried tomatoes, very thinly sliced"
  ],
  "steps": [
    {
      "text": "Combine ground meats with egg, BelGioioso Romano, parsley, garlic, salt and pepper in mixing bowl. Blend in breadcrumbs. Slowly add water, mixing until moist. Shape meatball mixture into 2-ounce patties. Refrigerate patties until ready to cook.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill or pan-grill meatball burgers over medium heat on lightly oiled grill. Cook thoroughly on each side. Add 1 slice of cheese, halved to fit, atop each burger. Cook 1 minute longer to melt cheese. Toast bread, cut side down on grill. Serve each cheeseburger with 2 tablespoons grilled onions and 2 tablespoons sun-dried tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
