  "ingredients": [
    "0.33333334326744 cup butter",
    "2 teaspoons minced garlic",
    "1 tablespoon all-purpose flour",
    "1 cup whole milk",
    "1 pinch dried oregano",
    "1 pinch dried basil",
    "1 pinch dried parsley"
  ],
  "steps": [
    {
      "text": "Melt butter in a small saucepan over medium heat. Add garlic; cook and stir until fragrant, about 45 seconds. Whisk in flour; cook and stir until flour loses its raw smell, about 45 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually whisk in milk, oregano, basil, and parsley, then bring to a simmer. Continue cooking, stirring constantly, until thick, about 5 minutes.",
      "section": null,
