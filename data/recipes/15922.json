  "ingredients": [
    "1 cup drained cottage cheese",
    "1 large egg",
    "1 cup all-purpose flour",
    "0.25 cup half-and-half",
    "2 tablespoons white sugar",
    "1.75 teaspoons baking powder",
    "1 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "4 cups vegetable oil for frying, or as needed",
    "3 tablespoons confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Beat together cottage cheese and egg in a medium bowl. Stir in flour, half-and-half, sugar, baking powder, nutmeg, and salt; mix until batter is just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 2 inches oil in a deep pot to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter by rounded tablespoons into hot oil and fry until golden brown on all sides, 3 to 4 minutes. Drain on a paper towel-lined plate and sprinkle with confectioners' sugar. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
