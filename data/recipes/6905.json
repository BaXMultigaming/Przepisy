  "ingredients": [
    "2 cups all-purpose flour",
    "0.25 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 cup butter, chilled",
    "1 apple - peeled, cored and shredded",
    "0.5 cup milk",
    "2 tablespoons milk",
    "2 tablespoons white sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, ¼ cup sugar, baking powder, baking soda, and salt in a bowl; cut in butter until crumbly. Stir in shredded apple and ½ cup milk to form a soft dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a lightly floured surface and knead gently, 8 to 10 times. Pat into two 6-inch circles; place on the prepared baking sheet. Brush tops with 2 tablespoons milk; sprinkle with 2 tablespoons sugar and cinnamon. Score each dough circle into 6 pie-shaped wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and risen, about 15 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
