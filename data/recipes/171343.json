  "ingredients": [
    "2 tablespoons olive oil",
    "0.5 onion, chopped",
    "2 teaspoons minced garlic",
    "2 cucumbers, peeled, seeded and chopped",
    "1 cup vegetable broth",
    "0.5 cup milk",
    "2 tablespoons soy sauce",
    "2 teaspoons curry powder",
    "1 teaspoon dried parsley",
    "1 teaspoon crushed red pepper flakes",
    "1 teaspoon cayenne pepper",
    "1 teaspoon sesame oil"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large saucepan over medium heat. Add onion and garlic; cook and stir until very soft, about 10 minutes. Stir in cucumbers, vegetable broth, milk, soy sauce, curry powder, parsley, pepper flakes, cayenne pepper, and sesame oil; bring to a simmer over medium-high heat. Reduce heat to medium-low, cover, and simmer 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a blender halfway with hot soup. Cover and hold lid down with a potholder; pulse a few times before leaving on to purée until creamy yet slightly grainy. Pour into a pot. Repeat with remaining soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
