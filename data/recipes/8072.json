  "ingredients": [
    "3 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "1 cup milk",
    "1 teaspoon coconut extract",
    "1 teaspoon rum flavored extract",
    "1 teaspoon butter flavored extract",
    "1 teaspoon lemon extract",
    "1 teaspoon vanilla extract",
    "3 cups white sugar",
    "1 cup butter, softened",
    "0.5 cup shortening",
    "5 large eggs, beaten",
    "0.5 cup white sugar",
    "0.25 cup water",
    "0.5 teaspoon coconut extract",
    "0.5 teaspoon rum flavored extract",
    "0.5 teaspoon butter flavored extract",
    "0.5 teaspoon lemon extract",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 10-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and baking powder in a medium bowl; set aside. Combine milk and extracts in a liquid measure; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar, butter, and shortening in a large bowl with an electric mixer until light and fluffy. Add eggs one at a time, beating well after each addition. Beat in flour mixture alternately with milk mixture in batches, beginning and ending with flour mixture. Spoon mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 1 1/2 to 1 3/4 hours. Cool in the pan on a wire rack for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While cake is cooling, make glaze: Combine sugar, water, and extracts in a saucepan. Bring to a boil, stirring until sugar is dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn cake out onto the wire rack. Place waxed paper under the rack to catch glaze drippings. Slowly spoon glaze over the top of hot cake. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
