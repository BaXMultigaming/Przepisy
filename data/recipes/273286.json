  "ingredients": [
    "2 teaspoons coconut oil, or as needed",
    "0.5 cup twice-sifted coconut flour",
    "1 teaspoon cream of tartar",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon sea salt",
    "1.3333333730698 cups mashed ripe bananas",
    "3 large eggs",
    "0.33333334326744 cup extra-virgin coconut oil, warmed slightly",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C) using the convection setting. Grease 2 cookie sheets with 1 teaspoon coconut oil each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix coconut flour, cream of tartar, baking soda, and salt together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mashed bananas, eggs, 1/3 cup coconut oil, and vanilla extract in a separate bowl. Beat with an electric mixer until creamy. Slowly add the flour mixture while continuing to mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of cookie dough onto the greased cookie sheets. Flatten cookies using the back of the spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer wet, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
