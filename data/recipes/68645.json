  "ingredients": [
    "1 loaf French bread, halved lengthwise and sliced into 2 inch slices",
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup margarine",
    "1 (4 ounce) can deviled ham meat spread",
    "1 teaspoon salt",
    "0.25 teaspoon dill weed",
    "1 (3 ounce) can sliced mushrooms, drained"
  ],
  "steps": [
    {
      "text": "Preheat oven to broiler setting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix the cream cheese, margarine, deviled ham meat spread, salt, dill weed, and mushrooms together until smooth. Spread mixture evenly over bread slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil on top oven rack for 3 to 5 minutes, or until lightly browned. Watch carefully to prevent burning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
