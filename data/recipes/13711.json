  "title": "Homemade Fresh Pumpkin Pie",
  "description": "Delicious homemade pumpkin pie made with mashed, cooked pumpkin. Skip the canned stuff and make this classic Thanksgiving pumpkin pie from scratch.",
  "authors": [
    "Randy Scott"
  ],
  "date_published": "1998-10-27T13:45:00-05:00",
