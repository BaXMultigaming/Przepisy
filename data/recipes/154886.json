  "ingredients": [
    "1 (16 ounce) package bulk pork breakfast sausage",
    "4 cups all-purpose flour",
    "0.25 cup white sugar",
    "0.25 cup brown sugar",
    "4 teaspoons baking powder",
    "0.5 teaspoon salt",
    "4 eggs",
    "2.5 cups milk",
    "0.25 cup vegetable oil",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Prepare a baking dish with cooking spray. Preheat the baking dish in the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brown the sausage in a skillet over medium heat; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the flour, white sugar, brown sugar, baking powder, and salt in a large bowl. Stir in the eggs, milk, vegetable oil, and vanilla to form a batter. Add the sausage and stir. Pour into the preheated baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until a toothpick inserted into the center of the dish comes out clean, about 25 minutes. Allow to cool 10 minutes before cutting to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
