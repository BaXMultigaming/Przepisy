  "ingredients": [
    "8 ounces cream cheese, softened",
    "0.33333334326744 cup white sugar",
    "3 eggs",
    "0.5 cup vegetable oil",
    "0.5 cup milk",
    "1 teaspoon lemon zest",
    "2.25 cups all-purpose flour",
    "0.33333334326744 cup white sugar",
    "0.33333334326744 cup packed brown sugar",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 9x5x3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cheese, 1/3 cup sugar, and 1 egg together well. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat remaining 2 eggs in mixing bowl until frothy. Mix in oil, milk, and lemon rind.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl measure in flour, 1/3 cup sugar, brown sugar, soda, salt, walnuts. Stir to mix well. Pour all at once into mixing bowl. Stir with milk batter until moistened. Spoon 1/2 batter into greased 9x5x3 inch loaf pan. Spoon on cheese mixture. Cover with remaining batter by dropping small spoonfuls here and there.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour until it tests done. Cool 15 minutes in pan before turning out very carefully to rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
