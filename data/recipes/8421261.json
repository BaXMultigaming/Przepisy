  "ingredients": [
    "1.5 cups self-rising flour",
    "1 cup plain Greek yogurt",
    "0.5 teaspoon Italian seasoning",
    "0.25 teaspoon granulated garlic",
    "1 pinch salt",
    "1.5 ounces Colby-Monterey Jack cheese, shredded",
    "1.5 ounces sharp Cheddar cheese, shredded",
    "3 ounces mozzarella cheese, shredded"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees C (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, yogurt, Italian seasoning, garlic, and salt together in a large bowl until it forms a ball. Transfer to a lightly floured work surface and knead until smooth, adding more flour as necessary to keep dough from sticking, 2 to 3 minutes. Shape mixture into 1-inch balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer dough balls and cheese in a small (5-inch) nonstick springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bread has risen and is baked through, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
