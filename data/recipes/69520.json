  "ingredients": [
    "7 cups rolled oats",
    "1 cup wheat germ",
    "1 cup unsweetened flaked coconut",
    "0.5 cup unsalted sunflower seeds",
    "0.5 cup sesame seeds",
    "1 cup chopped almonds",
    "0.5 cup vegetable oil",
    "0.5 cup honey",
    "0.5 cup boiling water",
    "0.25 cup brown sugar",
    "0.5 teaspoon salt",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the oats, wheat germ, coconut, sunflower seeds and almonds. In a separate bowl, mix together the oil, honey, boiling water, brown sugar, salt and vanilla. Pour the liquid ingredients into the dry ingredients, and stir until evenly coated. Spread in a thin layer on a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 60 to 90 minutes in the preheated oven. Stir every 30 minutes, until lightly toasted and fragrant. Granola will crisp up more when cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
