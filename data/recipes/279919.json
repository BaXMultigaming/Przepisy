  "ingredients": [
    "1 pound eggplant",
    "2 tablespoons lemon juice",
    "2 tablespoons tahini",
    "2 cloves garlic",
    "0.125 teaspoon ground cumin",
    "0.125 teaspoon red chile powder",
    "1 tablespoon extra-virgin olive oil",
    "0.5 tablespoon plain yogurt, or more to taste",
    "salt to taste",
    "1 pinch paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Lightly oil a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Halve eggplants and brush cut sides with olive oil. Place face-down onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until softened, 20 to 25 minutes. Remove from oven and let cool, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop flesh out of skins and place in a mesh strainer. Discard skins. Press down on flesh to remove liquid or drippings. Transfer eggplant flesh to a food processor. Add lemon juice, tahini, garlic, cumin, and chile powder. Drizzle olive oil on top of everything. Blend well, 45 seconds to 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in plain yogurt and season with salt. Serve with a sprinkle of paprika over top for garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
