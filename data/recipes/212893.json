  "ingredients": [
    "3 quince, unpeeled, washed, halved and cored",
    "18 whole cloves",
    "1.5 cups water",
    "0.5 cup port wine",
    "3 cinnamon sticks",
    "0.33333334326744 cup white sugar",
    "0.33333334326744 cup heavy cream, whipped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press 3 cloves into each quince half; place quince, cut-sides down, into a roasting pan. Add water, wine, and cinnamon sticks to the pan; sprinkle sugar over fruit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 35 to 40 minutes. Flip quince halves; continue baking until tender, about 10 minutes more. Cool quince slightly, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve each quince half with 1 tablespoon juice from the roasting pan; dollop halves with whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
