  "ingredients": [
    "cooking spray",
    "8 large eggs",
    "8 large egg whites",
    "2 cups milk",
    "0.33333334326744 cup pure maple syrup",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "1 (1 pound) loaf whole wheat bread, cubed",
    "2 cups fresh blueberries",
    "0.33333334326744 cup sliced almonds",
    "2 tablespoons dark brown sugar"
  ],
  "steps": [
    {
      "text": "Spray a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, egg whites, milk, maple syrup, vanilla, and cinnamon together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread cubes in the prepared pan. Pour egg mixture over the bread. Scatter blueberries evenly over the top and sprinkle with almonds and brown sugar. Cover with plastic wrap and refrigerate for 4 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to bake, preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove plastic wrap from the baking pan. Bake in the preheated oven until golden brown , 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
