  "ingredients": [
    "2 cups all-purpose flour",
    "0.667 cup white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon baking soda",
    "0.75 teaspoon ground cinnamon",
    "1 large egg, beaten",
    "1 cup applesauce",
    "3 tablespoons butter, melted",
    "1.333 cups chopped walnuts",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, sugar, baking powder, baking soda, and cinnamon in a large bowl. Beat together egg, applesauce, and butter in a separate bowl. Stir applesauce mixture into flour mixture just until combined. Fold in walnuts and raisins; pour batter into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the loaf comes out clean, about 45 minutes. Allow to cool before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
