  "ingredients": [
    "2 wooden skewers, or as needed",
    "12 cipollini onions, peeled",
    "0.5 cup coarsely chopped fresh basil",
    "1 tablespoon olive oil",
    "1 teaspoon seasoned salt (such as LAWRY'S®)"
  ],
  "steps": [
    {
      "text": "Fill a shallow dish with water; soak wooden skewers in water for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place onions, basil, olive oil, and seasoned salt in a large bowl; toss to coat onions. Refrigerate until flavors blend, 30 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread onions onto the prepared skewers, weaving basil between onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook skewers on the preheated grill until onions are sweet and tender, about 10 minutes, flipping once.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
