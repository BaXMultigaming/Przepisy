  "ingredients": [
    "6 slices bacon",
    "4 eggs, beaten",
    "1.5 cups light cream",
    "0.25 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "0.5 teaspoon pepper",
    "2 cups chopped fresh spinach",
    "2 cups chopped fresh mushrooms",
    "0.5 cup chopped onions",
    "1 cup shredded Swiss cheese",
    "1 cup shredded Cheddar cheese",
    "1 (9 inch) deep dish pie crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whip together eggs, cream, nutmeg, salt, and pepper. Stir in bacon, spinach, mushrooms, onions, 3/4 cup Swiss cheese, and 3/4 cup Cheddar cheese. Transfer to the pie crust. Top with remaining cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered in the preheated oven 35 minutes, or until bubbly and lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
