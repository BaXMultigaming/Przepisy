  "title": "Chocolate Chip Banana Bread",
  "description": "This easy chocolate chip banana bread recipe makes 2 deliciously moist loaves with sweet morsels of chocolate and crunchy walnuts in every bite!",
  "authors": [
    "Betty Karda"
  ],
  "date_published": "2000-06-03T22:29:55-04:00",
