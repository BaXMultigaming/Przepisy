  "ingredients": [
    "2 cups chopped, cooked chicken",
    "0.5 (4 ounce) can chopped green chilies",
    "1 (7 ounce) can prepared green chile salsa",
    "2 cups whipping cream",
    "0.5 teaspoon salt",
    "oil for frying",
    "12 corn tortillas",
    "1.5 cups shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together chicken, chilies, and salsa in a large bowl until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together whipping cream and salt in a wide, shallow dish until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large, heavy skillet over medium-high heat. Fry each tortilla in hot oil until blistering, 2 to 4 seconds, then immediately dip into cream mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill fried tortillas with chicken mixture. Roll and place flap-side down in a baking dish. Pour remaining cream mixture over tortillas and sprinkle with cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered in the preheated oven until cheese is melted, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
