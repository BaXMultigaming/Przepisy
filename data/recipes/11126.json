  "title": "Dough Ornament Recipe",
  "description": "Salt dough ornaments are easy and fun with this 3-ingredient recipe. Learn how to make these salt dough ornaments to give as holiday keepsakes.",
  "authors": [
    "Phyllis"
  ],
  "date_published": "1998-11-22T18:28:51-05:00",
  "date_modified": "2026-01-20T18:05:17-05:00",
  "prep_time": "PT15M",
