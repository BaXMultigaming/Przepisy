  "ingredients": [
    "2 cups white sugar",
    "1.25 cups vegetable oil",
    "4 eggs",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "2 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon salt",
    "3 cups grated carrots",
    "1 cup chopped pecans",
    "4 cups confectioners' sugar",
    "8 ounces cream cheese, softened",
    "0.5 cup butter, softened",
    "1 teaspoon vanilla extract",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-sJBmqR7mixZIiHCDkQONnYxi78=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7402-carrot-cake-DDMFS-4x3-step-01-1-f3f419efc1974d7692961701d1dadfdb.jpg"
      ],
      "image": "assets/images/7402/step_01.webp"
    },
    {
      "text": "Beat white sugar, oil, eggs, and 2 teaspoons vanilla together in a large bowl with an electric mixer until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BZYV3p-yiwp7747_cUd4lsok3A0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7402-carrot-cake-DDMFS-4x3-step-03-1-932399d078864595acd775234f23055a.jpg"
      ],
      "image": "assets/images/7402/step_02.webp"
    },
    {
      "text": "Mix in flour, baking soda, baking powder, cinnamon, and salt; stir in carrots, then fold in 1 cup pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JbJQAW9lkUB48IUus8-QvfKIJqo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7402-carrot-cake-DDMFS-4x3-step-05-1-8cbbfb73b0984b7db68968abb72c8479.jpg"
      ],
      "image": "assets/images/7402/step_03.webp"
    },
    {
      "text": "Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9wBLFuk_MYVCcDcjgPeM9IRcvlY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7402-carrot-cake-DDMFS-4x3-step-06-1-84caece310e541f8acb60f4c8f32967c.jpg"
      ],
      "image": "assets/images/7402/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 40 minutes. Cool in the pan for 10 minutes, then turn out onto a wire rack and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EXovn3O3-fh_SNl-3wiDk_Ot0cE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7402-carrot-cake-DDMFS-4x3-step-07-1-358b749203344c22a13bb74553bdad7f.jpg"
      ],
      "image": "assets/images/7402/step_05.webp"
    },
    {
      "text": "Beat confectioners' sugar, cream cheese, butter, and 1 teaspoon vanilla together in a large bowl with an electric mixer until frosting is smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-3O6gXfpaCPz4Obk5LJJX5G0Wt8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7402-carrot-cake-DDMFS-4x3-step-08-1-c10c09d86df14b5b89becf44dec3acf9.jpg"
      ],
      "image": "assets/images/7402/step_06.webp"
    },
    {
      "text": "Stir in 1 cup chopped pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jvtprLxIIMEX-NdOzKHhSNsgIgA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7402-carrot-cake-DDMFS-4x3-step-09-1-ab18d938d9b642c1b920b8c508757a8e.jpg"
      ],
      "image": "assets/images/7402/step_07.webp"
    },
    {
      "text": "Frost cooled cake. Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_CvLWNGO-ICUrfdkOmgUZYmrKSI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7402-carrot-cake-DDMFS-4x3-3e7c34c1048e444f989192a700134bef.jpg"
      ],
      "image": "assets/images/7402/step_08.webp"
    }
