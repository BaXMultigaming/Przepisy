  "ingredients": [
    "4 cups all-purpose flour",
    "2 cups shortening",
    "5 tablespoons cold water"
  ],
  "steps": [
    {
      "text": "Cut the shortening into cubes, and toss into flour. Take your hands and crumble it up into a fine, pebbly, grainy sort of dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add water, enough to make a soft dough. Form into a ball, and chill for about an hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When chilled, knead it a couple of times on a floured surface. Roll it out, and proceed to fill with your choice of pie fillings.",
