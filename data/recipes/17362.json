  "ingredients": [
    "6 small yams",
    "6 tablespoons butter",
    "6 teaspoons honey",
    "3 teaspoons white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook yams in boiling water until tender, about 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange yams in the prepared baking dish. Cut a slit down the middle of each yam and dab 1 tablespoon butter into each slit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon 1 teaspoon honey into each yam; sprinkle each with 1/2 teaspoon sugar to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
