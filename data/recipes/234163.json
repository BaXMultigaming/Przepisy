  "ingredients": [
    "non-stick cooking spray",
    "1 cup all-purpose flour",
    "1 cup quick-cooking rolled oats",
    "3 tablespoons packed brown sugar",
    "1.5 teaspoons baking powder",
    "0.75 teaspoon ground ginger, divided",
    "0.25 teaspoon salt",
    "0.66666668653488 cup fat-free milk",
    "0.33333334326744 cup cooking oil",
    "1 egg, beaten",
    "0.75 cup chopped pear",
    "0.25 cup chopped walnuts",
    "1 tablespoon oat bran"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly spray 12 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, oats, brown sugar, baking powder, 1/4 teaspoon ground ginger, and salt together in a bowl; form a well in the center of flour mixture. Whisk milk, oil, and egg together in a small bowl and pour into well. Stir until batter is just moistened; fold in pear and walnuts. Fill prepared muffin cups with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oat bran and remaining 1/2 teaspoon ground ginger together in a small bowl; sprinkle over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean and tops are brown, 18 to 20 minutes. Cool in the pan for 5 minutes before removing from muffin cups. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
