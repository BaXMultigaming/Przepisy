  "ingredients": [
    "cooking spray",
    "1 tablespoon olive oil",
    "1 cup chopped fresh asparagus",
    "0.25 cup chopped green bell pepper",
    "2 tablespoons chopped red onion",
    "6 eggs",
    "0.5 cup milk",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray 12 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat olive oil in a skillet over medium heat. Add asparagus, green bell pepper, and onion; cook and stir until vegetables are softened, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eKPk-uw8h9ytrCvgMdJ7Oqc8jT8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231480-muffin-pan-frittatas-ddmfs-Step1-1262-4aef847b567e4e7da8f169ed3255a8ec.jpg"
      ],
      "image": "assets/images/231480/step_02.webp"
    },
    {
      "text": "Whisk eggs, milk, salt, and black pepper together in a bowl. Stir cooked vegetables and Cheddar cheese into egg mixture; spoon about 1/4 cup of mixture into each muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ryQO8D2Kkt0G2GFxTBVMTgxZtyA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231480-muffin-pan-frittatas-ddmfs-Step3-1267-cda41338a53c4ce1882f7f118fb3e805.jpg"
      ],
      "image": "assets/images/231480/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until frittatas are set in the middle and lightly browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M-9GoErcCSuZt38Jr2byPxRSDwI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231480-muffin-pan-frittatas-ddmfs-Step4-1276-669f320a506b46109b3493848a8d448b.jpg"
