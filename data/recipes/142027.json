  "ingredients": [
    "1 (16 ounce) bag coleslaw mix",
    "2 tablespoons diced onion",
    "0.66666668653488 cup creamy salad dressing (such as Miracle Whip™)",
    "0.5 cup white sugar",
    "3 tablespoons vegetable oil",
    "1 tablespoon white vinegar",
    "0.5 teaspoon poppy seeds",
    "0.25 teaspoon salt"
  ],
