  "ingredients": [
    "24 baby potatoes, scrubbed and halved",
    "3 tablespoons olive oil",
    "1 (.7 ounce) package dry Italian-style salad dressing mix"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking dish or rimmed sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a large resealable plastic bag. Add olive oil and Italian dressing mix, seal the bag, and shake until potatoes are coated evenly. Transfer mixture to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until tender, flipping potatoes halfway through cooking time, about 30 minutes.",
      "section": null,
