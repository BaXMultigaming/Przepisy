  "ingredients": [
    "3 cups sifted all-purpose flour",
    "0.75 cup white sugar",
    "0.5 teaspoon salt",
    "3 egg yolks",
    "1 cup butter, softened",
    "1 lemon, zest grated",
    "1.75 cups applesauce",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a 9x9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat in egg yolks, butter, and lemon zest until dough is thoroughly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix applesauce, cinnamon, and cloves together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press half the dough into the prepared baking pan; spread applesauce mixture over dough in a layer. Top with remaining dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake is browned, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
