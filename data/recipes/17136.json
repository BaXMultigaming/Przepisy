  "ingredients": [
    "6 chicken thighs",
    "1 (16 ounce) can cranberry sauce",
    "1 (8 ounce) bottle Russian-style salad dressing",
    "1 packet dry onion soup mix"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken pieces in a lightly greased 9x13 inch baking dish. In a large bowl combine the cranberry sauce, salad dressing and soup mix and mix well. Coat chicken pieces with this mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover dish and bake at 350 degrees F (175 degrees C) for 1 1/2 to 1 3/4 hours, or until chicken is cooked through and juices run clear. Remove cover for the last 15 minutes of baking time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
