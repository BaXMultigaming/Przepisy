  "ingredients": [
    "4 stalks fresh rhubarb, trimmed and chopped",
    "1 sweet onion (such as Vidalia®), chopped",
    "1 (12 fl oz) can almond-fruit flavored soda (such as Dr Pepper®)",
    "1 cup apple cider vinegar",
    "1 cup brown sugar",
    "0.25 cup molasses",
    "1 tablespoon Worcestershire sauce",
    "2 teaspoons liquid smoke flavoring",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground dried chipotle pepper",
    "0.25 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Combine rhubarb, sweet onion, soda, apple cider vinegar, brown sugar, molasses, Worcestershire sauce, cinnamon, allspice, salt, black pepper, cloves, ground chipotle, garlic powder, and liquid smoke in a saucepan; bring to a boil, then reduce heat to low. Simmer until rhubarb and onion are very soft, about 45 minutes, stirring often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the sauce into a blender, filling the pitcher no more than halfway full. Hold down the lid of the blender with a folded kitchen towel; pulse a few times, then puree until smooth. Puree in batches if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
