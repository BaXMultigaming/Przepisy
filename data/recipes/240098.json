  "ingredients": [
    "2 large Roma (plum) tomatoes, halved",
    "1 large green bell pepper, halved and seeded",
    "1 white onion, halved",
    "1 head garlic, halved crosswise",
    "2 tablespoons olive oil, or as needed",
    "0.25 teaspoon garlic powder, or to taste",
    "sea salt to taste",
    "ground black pepper to taste",
    "1.5 cups mayonnaise",
    "1 teaspoon ground dried chipotle pepper"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat, and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub tomato halves, bell pepper halves, onion halves, and garlic halves with olive oil; season with garlic powder, sea salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook vegetables on preheated grill, turning regularly, until wrinkled and slightly charred, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put grilled vegetables into a blender bowl with mayonnaise and dried chipotle pepper; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
