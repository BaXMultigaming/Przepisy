  "ingredients": [
    "0.25 cup lemon juice",
    "0.25 cup chicken broth",
    "4 tablespoons olive oil, divided",
    "1 tablespoon Dijon mustard",
    "1 tablespoon fresh lemon zest",
    "2 cloves garlic, minced",
    "1 cube chicken bouillon",
    "1 teaspoon dried thyme",
    "1.5 tablespoons all-purpose flour",
    "0.5 teaspoon salt",
    "4 (4 ounce) skinless, boneless chicken breast halves",
    "0.5 tablespoon unsalted butter",
    "1 lemon, cut into thin slices"
  ],
  "steps": [
    {
      "text": "Combine lemon juice, chicken broth, 2 tablespoons olive oil, Dijon mustard, lemon zest, garlic, chicken bouillon, and thyme in a small bowl. Mix together thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and salt on a small dish. Coat chicken with flour on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter and remaining olive oil in a large nonstick skillet over high heat. Cook chicken until lightly browned, about 3 minutes per side. Reduce heat to low and pour broth mixture and lemon slices over chicken. Cover and simmer until no longer pink in the centers, about 20 minutes. Remove from heat and serve with lemon slices on top, spooning the broth over the chicken.",
      "section": null,
