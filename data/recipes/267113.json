  "ingredients": [
    "1 tablespoon olive oil",
    "4 Roma tomatoes, thinly sliced",
    "1 tablespoon minced garlic",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon crushed red pepper",
    "0.5 teaspoon salt",
    "1 (14 ounce) package prepared pizza crust",
    "0.5 pound bulk hot Italian sausage",
    "0.5 yellow onion, thinly sliced",
    "0.5 bulb fennel, thinly sliced",
    "0.5 cup baby spinach leaves",
    "0.5 cup ricotta cheese",
    "0.25 cup shaved Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a frying pan over medium heat. Add olive oil. Add tomatoes, garlic, Italian seasoning, red pepper, and salt. Cook, stirring often, until tomatoes have mostly broken down, about 5 minutes. Spread tomato mixture over the pizza crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the same pan over medium-high heat. Add sausage and cook until browned, about 6 minutes. Remove cooked sausage from the pan and set aside, reserving grease in the pan. Add onion and fennel to the pan and cook until softened, about 5 minutes. Add spinach and cook until leaves begin to wilt, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread sausage and vegetable mixture over tomato-covered crust. Scatter dollops of ricotta cheese on top. Sprinkle with shaved Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and top is beginning to brown, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
