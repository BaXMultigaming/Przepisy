  "ingredients": [
    "1 teaspoon unsalted butter, or as needed",
    "2 skinless, boneless chicken breasts, cubed",
    "3 cups finely chopped broccoli",
    "2 (10.5 ounce) cans condensed cream of chicken soup",
    "1 cup shredded Cheddar cheese",
    "1 cup shredded Parmesan cheese, divided",
    "0.5 cup shredded mozzarella cheese",
    "0.5 cup sour cream",
    "1 pinch ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather ingredients, preheat the oven to 350 degrees F (175 degrees C), and butter the bottom and sides of a 9x13-inch dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CKlJAtIAzaCKtIfzMwAiOv8ffNU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/279837-cheesy-chicken-and-broccoli-casserole-step-1-362-3x4-6fb3e135eefd406292a901486a1be68f.jpg"
      ],
      "image": "assets/images/279837/step_01.webp"
    },
    {
      "text": "Bring a pot of water to a boil. Add chicken and continue to boil until no longer pink, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NiwH8p1nu85jphB3M4CXBoqRDW4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/279837-cheesy-chicken-and-broccoli-casserole-step-2-366-3x4-994bb8114aac47a3a4971081cc309add.jpg"
      ],
      "image": "assets/images/279837/step_02.webp"
    },
    {
      "text": "Meanwhile, combine broccoli, cream of chicken soup, Cheddar cheese, 1/2 cup Parmesan cheese, mozzarella cheese, sour cream, and pepper in a large bowl. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/68eOo7U5FHL4x7EUJc-KHGbZLSU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/279837-cheesy-chicken-and-broccoli-casserole-step-3-371-3x4-5a3b9df12984415faa88dbbdb380741b.jpg"
      ],
      "image": "assets/images/279837/step_03.webp"
    },
    {
      "text": "Drain chicken and add to broccoli mixture. Mix well. Pour into the prepared baking dish and spread evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YODJik7l1l8TjipJOvsAoPSWz1Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/279837-cheesy-chicken-and-broccoli-casserole-step-5-374-3x4-4fc54d8c2c2645018cea51c11241187c.jpg"
      ],
      "image": "assets/images/279837/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Add remaining Parmesan cheese on top and continue to bake until cheese is melted, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Vq9C5j0HzgCZPZl0uW3uZ401FiU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/279837-cheesy-chicken-and-broccoli-casserole-DDMFS-4x3-c1006af6f35549d0ac9f11b723da0b0f.jpg"
      ],
      "image": "assets/images/279837/step_05.webp"
    }
