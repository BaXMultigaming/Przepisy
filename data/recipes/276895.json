  "ingredients": [
    "1 cup white sugar",
    "1 cup cooked, mashed sweet potato",
    "0.5 cup olive oil",
    "0.33333334326744 cup water",
    "2 eggs, beaten",
    "1.6666667461395 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin pan or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/u_cspoWfh5m3lZ3DeRBpP8EmyPg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276895-delicious-sweet-potato-muffins-VAT-step-01-eeb1ded0d7c940b2942367a72e1ca8c8.jpg"
      ],
      "image": "assets/images/276895/step_01.webp"
    },
    {
      "text": "Combine sugar, sweet potato, olive oil, water, and eggs in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DvOPqeIMTtNuucyDybczEyW-nqA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276895-delicious-sweet-potato-muffins-VAT-step-02-8a35a167758b4c409a924888521b1da7.jpg"
      ],
      "image": "assets/images/276895/step_02.webp"
    },
    {
      "text": "Combine flour, cinnamon, baking soda, baking powder, and salt in a separate bowl. Add flour mixture and pecans to sweet potato mixture. Gently fold together until just moist, being careful not to overmix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xQT8fxQFWGui9oz6KltOQiRk69E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276895-delicious-sweet-potato-muffins-VAT-step-03-c2496dc6743a4b919cd6f3630c72232a.jpg"
      ],
      "image": "assets/images/276895/step_03.webp"
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8THe4acds2zDupc3SkiQ7PPlYYs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276895-delicious-sweet-potato-muffins-VAT-step-04-123a029281a246b7b34d2ecb67452d14.jpg"
      ],
      "image": "assets/images/276895/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 20 to 25 minutes. Cool on wire rack.",
      "section": null,
      "name": null,
      "url": null,
