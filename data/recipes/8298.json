  "ingredients": [
    "0.5 cup butter, softened",
    "1 cup packed brown sugar",
    "1 (18.25 ounce) package butter pecan cake mix",
    "2 tablespoons water",
    "2 cups chopped pecans",
    "2 eggs",
    "0.5 cup butter, softened",
    "2 eggs",
    "1 cup milk",
    "1 cup white sugar",
    "1 cup light corn syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reserve 3/4 cup cake mix for second layer. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the first layer: In a large bowl, combine 1/2 cup margarine or butter, brown sugar, cake mix (minus 3/4 cup), water, pecans and 2 eggs. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter into pan. Bake at 325 degrees F (165 degrees C) for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the second layer: In a large bowl, combine 1/2 cup butter or margarine, 2 eggs, milk, sugar, corn syrup and reserved 3/4 cup cake mix. Mix well and pour over first layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C), for 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
