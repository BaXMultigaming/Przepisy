  "ingredients": [
    "1 cup white sugar",
    "1 cup vegetable oil",
    "4 eggs",
    "0.5 cup brown sugar",
    "1 teaspoon vanilla extract, or to taste",
    "3 cups grated zucchini",
    "1.5 cups all-purpose flour",
    "1.5 cups whole wheat flour",
    "0.5 cup flaxseed meal",
    "0.5 cup unsweetened baking cocoa (such as Ghirardelli®)",
    "2 teaspoons ground cinnamon",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons baking soda",
    "1 teaspoon salt",
    "0.5 teaspoon ground cardamom",
    "1 pint blueberries",
    "2 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 2 loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk white sugar, oil, eggs, brown sugar, and vanilla extract together in a large bowl; fold in grated zucchini. Add 1 ½ cups all-purpose flour, whole wheat flour, flaxseed meal, cocoa, cinnamon, baking powder, baking soda, salt, and cardamom; mix until batter is combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine blueberries and 2 tablespoons all-purpose flour in a small bowl; fold into batter. Divide batter between the prepared loaf pans, filling each ⅔ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
