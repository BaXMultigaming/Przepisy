  "title": "Chicken Paprikash",
  "description": "This chicken paprikash recipe with its colorful paprika-seasoned sour cream sauce is a variation of a classic chicken and dumpling casserole.",
  "authors": [
    "ErinWebster"
  ],
  "date_published": "2019-04-03T23:44:00-04:00",
