  "ingredients": [
    "1 cooking spray",
    "1 pound jumbo shrimp, peeled and deveined",
    "1 teaspoon lemon-pepper seasoning",
    "2 onions, cut into strips",
    "2 green bell peppers, cut into strips",
    "2 tablespoons olive oil",
    "1 (1 ounce) package fajita seasoning",
    "8 flour tortillas"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a large sheet pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix shrimp and lemon-pepper seasoning together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss onions and bell pepper strips with olive oil and fajita seasoning in a large bowl until thoroughly coated. Arrange shrimp on one side of the prepared pan and vegetables on the other.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until shrimp are bright pink on the outside and the meat is opaque, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stack tortillas on a microwave-safe plate and cover with a wet paper towel. Heat in the microwave for 45 seconds. Serve with shrimp fajitas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
