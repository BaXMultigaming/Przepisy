  "ingredients": [
    "6 skinless, boneless chicken breast halves",
    "seasoning salt to taste",
    "1 tablespoon olive oil",
    "1 (16 ounce) container sour cream",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 (1 ounce) package dry onion soup mix"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle the chicken breasts with seasoning salt to taste. In a large skillet, brown the chicken in olive oil, on both sides, until they are golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Then place the chicken in a 9x13 inch baking dish. In a medium size bowl, combine the sour cream, chicken soup and dry onion soup mix. Pour the mixture over the chicken and bake in the preheated oven for 25 to 30 minutes. Let cool and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
