  "steps": [
    {
      "text": "Bring 2/3 cup water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender and water has been absorbed, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium heat. Sauté kale and garlic in hot oil until kale is wilted, about 5 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir quinoa into kale mixture and add sesame oil; cook until flavors blend, about 5 more minutes. Add 1 tablespoon water to mixture to prevent sticking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
