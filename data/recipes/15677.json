  "ingredients": [
    "1 (9 inch) prepared graham cracker crust",
    "1 (14 ounce) can sweetened condensed milk",
    "3 egg yolks",
    "0.5 cup lemon juice",
    "3 egg whites",
    "5 teaspoons white sugar"
  ],
  "steps": [
