  "ingredients": [
    "2 (14 ounce) cans diced tomatoes with onion and garlic, undrained",
    "2 (14 ounce) cans beef broth",
    "3 cups water",
    "1 teaspoon Italian seasoning",
    "1 (16 ounce) package frozen cooked Italian-style meatballs",
    "2 cups frozen Italian-blend vegetables",
    "1 cup small star-shaped dried pasta",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Combine tomatoes, beef broth, water, and Italian seasoning in a large pot; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add frozen meatballs, Italian-blend vegetables, and pasta; bring to a boil, then reduce heat to medium-low. Cook until meatballs are heated through and pasta is tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide soup among bowls; garnish with Parmesan cheese.",
      "section": null,
