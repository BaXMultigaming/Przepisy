  "ingredients": [
    "0.75 cup brown sugar",
    "0.25 cup butter",
    "1 egg",
    "1 cup all-purpose flour",
    "2 ounces white chocolate, chopped, divided",
    "2 ounces dark chocolate, chopped, divided",
    "1 tablespoon cocoa powder",
    "0.5 teaspoon baking powder",
    "0.5 cup miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and butter in a bowl; beat until creamy. Beat in egg. Mix in flour, 1/2 of the chopped chocolate, cocoa powder, and baking powder until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of the dough onto a cookie sheet, allowing enough room for the cookies to spread. Flatten slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are done but tops are a bit gooey, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven. Push remaining chocolate and mini marshmallows into the tops. Continue baking until tops are set, about 5 minutes more. Be careful to remove cookies before marshmallows burn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
