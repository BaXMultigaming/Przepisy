  "ingredients": [
    "2 skinless, boneless chicken breast halves",
    "1 cup salt",
    "2 tablespoons vegetable oil",
    "1 onion, finely chopped",
    "2 cloves garlic, finely chopped",
    "5 tablespoons light soy sauce",
    "2 tablespoons sesame oil",
    "2 sprigs fresh cilantro"
  ],
  "steps": [
    {
      "text": "Place chicken and salt in a bowl. Evenly rub salt into chicken. Refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a steamer basket into a saucepan and fill with water to just below the bottom of the steamer. Rinse chicken and place into the basket. Bring water to a boil; cover and steam chicken until juices run clear, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a skillet over medium heat. Stir in onion; cook until tender, 3 to 4 minutes. Mix in garlic; cook until fragrant, about 1 minute. Stir in soy sauce and sesame oil, then remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon sauce over chicken and garnish with cilantro to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
