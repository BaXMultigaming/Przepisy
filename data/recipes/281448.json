  "ingredients": [
    "2 limes, juiced",
    "2 tablespoons olive oil",
    "2 tablespoons fajita seasoning",
    "1 pound skinless, boneless chicken breast halves",
    "2 large yellow bell peppers",
    "2 large red bell peppers",
    "10 (6 inch) flour tortillas, warmed"
  ],
  "steps": [
    {
      "text": "Whisk lime juice, olive oil, and fajita seasoning together in a bowl and pour into a resealable plastic bag. Add chicken breasts, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DgxySga2188ksybFFVHffIWxVhE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281448-grilled-chicken-fajitas-mfs-step-1-3fea69fc307c42489f7c4789dcdc23b0.jpg"
      ],
      "image": "assets/images/281448/step_01.webp"
    },
    {
      "text": "Preheat an outdoor grill to medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut bell peppers in half and discard inner membranes and seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qEJCjtlp7Mz21xm_FTsDejQxXUQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281448-grilled-chicken-fajitas-mfs-step-2-21d8e6ce8117463db2ed9cadf8cd6276.jpg"
      ],
      "image": "assets/images/281448/step_03.webp"
    },
    {
      "text": "Remove chicken from marinade and shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken and peppers (cut-side down) on the preheated grill. Cook, turning occasionally until chicken is no longer pink in center, juices run clear, and peppers have nice grill marks on them, about 15 minutes. An instant-read thermometer inserted into center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cCzMmtbWUvpnmUhgDHcunQB4wUM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281448-grilled-chicken-fajitas-mfs-step-4-81d67c3a56464ed8917db719955806a2.jpg"
      ],
      "image": "assets/images/281448/step_05.webp"
    },
    {
      "text": "Cut peppers and chicken into strips and serve on tortillas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8IVwI_KagA3NC1T-uSFAJlaM6vQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/281448-grilled-chicken-fajitas-mfs-step-5-fc46155c3b8a448bbe172ca6fa02154f.jpg"
