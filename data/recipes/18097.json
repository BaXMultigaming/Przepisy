  "ingredients": [
    "2 pounds ground beef",
    "2 eggs",
    "0.5 cup tomato sauce",
    "0.75 cup fresh crumbled bread",
    "0.25 cup grated Parmesan cheese",
    "2 cloves garlic, minced",
    "2 tablespoons dried parsley",
    "1 teaspoon dried oregano",
    "6 slices ham",
    "6 medium slices mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the beef, eggs, tomato sauce, bread crumbs, cheese, garlic, parsley and oregano. Mix well and form into an 8x10 inch rectangle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the ham over the rectangle mixture, and then the cheese over the ham. Roll up jelly-roll style so that you end up with a rolled loaf about 5x8 inches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place roll seam side down into a 5x9 inch loaf pan and bake at 350 degrees F (175 degrees C) for 75 minutes. Drain excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
