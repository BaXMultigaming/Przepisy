  "ingredients": [
    "1 pound ground beef",
    "0.5 cup diced onion",
    "1 (16 ounce) jar spaghetti sauce, or more to taste",
    "0.5 (8 ounce) package cream cheese, softened",
    "0.5 (8 ounce) container sour cream",
    "cooking spray",
    "1 (12 ounce) package wide egg noodles",
    "1.5 cups shredded mozzarella cheese",
    "1.5 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium heat. Cook and stir beef and onion in the hot skillet until beef browns and onion softens, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add spaghetti sauce, cream cheese, and sour cream to the skillet. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a 5-quart slow cooker with cooking spray. Layer noodles, beef mixture, and cheeses in the slow cooker. Repeat layers as necessary until cooker is full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on High for 2 hours. Switch to Low and cook until noodles are soft and cheeses are melted, about 2 hours more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
