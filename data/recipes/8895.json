  "ingredients": [
    "1 cup uncooked white rice",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1.875 cups water",
    "1 (1 ounce) package dry onion soup mix",
    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread rice in the bottom of a 9x13 inch baking dish. Rinse chicken and pat dry; arrange chicken pieces on top of rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix soup and water together and pour over chicken and rice. Sprinkle dry onion soup mix on top. Cover and seal TIGHTLY with foil. Bake in the preheated oven for 1 to 1 1/2 hours. Enjoy!",
