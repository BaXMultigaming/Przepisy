  "ingredients": [
    "1 cinnamon-raisin English muffin, halved",
    "3 baby carrots, shredded",
    "1 pinch ground nutmeg",
    "1 tablespoon crunchy peanut butter",
    "1 tablespoon whipped cream cheese",
    "0.25 cup clover sprouts"
  ],
  "steps": [
