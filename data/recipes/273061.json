  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon white sugar",
    "0.25 teaspoon baking powder",
    "0.125 teaspoon salt",
    "4 ounces butter, softened",
    "3 tablespoons cold water",
    "0.75 cup hot water",
    "0.5 cup white sugar",
    "3 eggs",
    "2 tablespoons evaporated milk",
    "0.25 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease 12 small (3 1/2-inch) fluted brioche pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, baking powder, and salt together in a mixing bowl. Add butter and cold water; mix until dough forms into a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough on a lightly floured work surface with a lightly floured rolling pin to 1/8-inch thickness. Cut dough into rounds and press lightly into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix hot water and sugar in a bowl until sugar melts. Whisk in eggs; pour in evaporated milk and vanilla extract and mix well. Divide egg mixture between dough shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until egg is almost firm in the middle, 14 to 16 minutes. Let cool 10 minutes before transferring to a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
