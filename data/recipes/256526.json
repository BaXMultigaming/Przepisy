  "ingredients": [
    "1.5 cups all-purpose flour, divided",
    "1 egg",
    "0.25 cup ranch dressing mix (such as Hidden Valley®)",
    "2 chicken breasts",
    "1 cup vegetable oil",
    "0.5 cup mayonnaise",
    "0.25 cup sriracha sauce",
    "4 potato rolls",
    "16 dill pickle chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1/2 cup flour in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a shallow bowl with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 cup flour in a bowl; mix in ranch dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Split chicken breasts to create 4 pieces. Coat each piece with plain flour, dip in egg, and coat with flour-ranch mixture. Place on a wire rack set over a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large saucepan until almost boiling. Add 2 pieces chicken; fry until lightly golden, turning once, about 5 minutes. Return chicken to the wire rack. Repeat with remaining 2 pieces chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake chicken in the preheated oven until juices run clear, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mayonnaise and sriracha sauce together in a small bowl. Spread on rolls. Place 4 pickle slices on each roll. Place 1 piece of chicken on each sandwich.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
