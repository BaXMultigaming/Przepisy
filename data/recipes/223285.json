  "ingredients": [
    "0.5 cup butter",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.25 cup red Zinfandel wine, or more as needed",
    "1.5 cups all-purpose flour",
    "0.33333334326744 cup cocoa powder",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and brown sugar together in a bowl with an electric mixer until smooth, 2 to 3 minutes. Add egg and vanilla extract; beat until combined. Add red wine; beat until fully incorporated. Stir flour, cocoa powder, baking soda, and salt into butter mixture until moistened. Scoop into small mounds on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are crisp, 10 to 12 minutes. Let cool on baking sheet for 10 minutes before transferring to a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
