  "ingredients": [
    "1 (16 ounce) jar pickled beets",
    "0.66666668653488 cup white sugar",
    "0.66666668653488 cup white vinegar",
    "0.25 teaspoon salt",
    "2 whole cloves"
  ],
  "steps": [
    {
      "text": "Drain beet juice from the jar, leaving about 1/2 inch juice in the bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, vinegar, salt, and cloves in a saucepan over medium-high heat. Cook, stirring occasionally, until sugar dissolves into a syrup, about 3 minutes. Remove from heat and let cool, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour syrup over beets in the jar, covering them completely. Seal jar and shake gently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate beets for 2 to 3 days before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
