  "ingredients": [
    "1 cup packed brown sugar",
    "0.75 cup vegetable oil",
    "0.25 cup molasses",
    "1 large egg",
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1 teaspoon ground ginger",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon salt",
    "0.33333334326744 cup white sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JflripCJ-TW75AMVaq1fGE_LEW8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10757-moms-ginger-snaps-ddmfs-step-1-044-1853c2f211494ea8a5676a9a72d12020.jpg"
      ],
      "image": "assets/images/10757/step_01.webp"
    },
    {
      "text": "Mix brown sugar, oil, molasses, and egg together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oh9wGNi6RChyT20ZScJrjYjBxQg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10757-moms-ginger-snaps-ddmfs-step-2-048-c20172e756284b2abeba3c64cbdcb116.jpg"
      ],
      "image": "assets/images/10757/step_02.webp"
    },
    {
      "text": "Combine flour, baking soda, ginger, cinnamon, cloves, and salt together in another large bowl; stir into molasses mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cek3UHGpAFMm983FZ1xz9ijUfOQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10757-moms-ginger-snaps-ddmfs-step-3-050-fc6a880b398a42f0b07a1880074c41c8.jpg"
      ],
      "image": "assets/images/10757/step_03.webp"
    },
    {
      "text": "Roll dough into 1 1/4-inch balls. Roll each ball in white sugar; place 2 inches apart on ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cWvOJTTw7VyMbw8EVtwxwWMioUI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10757-moms-ginger-snaps-ddmfs-step-4-053-c66ef5e450504e6c8936e617643c55ac.jpg"
      ],
      "image": "assets/images/10757/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until center is firm, 10 to 12 minutes. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oL7tRe5a7QI5kWPXy1646IwHF18=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10757-moms-ginger-snaps-ddmfs-step-5-062-800c65e90d674bf8b6481a24a2acea06.jpg"
