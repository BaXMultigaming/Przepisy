  "ingredients": [
    "1 (16 ounce) package cavatappi pasta",
    "1 pound bacon",
    "1 (28 ounce) can crushed tomatoes",
    "1 pound processed cheese food (such as Velveeta®), cubed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add cavatappi and cook, stirring occasionally, until tender yet firm to the bite, 9 to 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the pasta is cooking, place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned but not yet crisp, about 10 minutes. Drain bacon slices on paper towels and then cut into small, bite-sized pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pasta, bacon, crushed tomatoes, and processed cheese together in a large bowl. Transfer to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until hot and bubbly, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
