  "ingredients": [
    "1 russet potato, cubed",
    "1 red potato, cubed",
    "1 sweet potato, peeled and cubed",
    "2 tablespoons olive oil",
    "2 tablespoons balsamic vinegar",
    "2 teaspoons minced fresh thyme",
    "3 cloves garlic, minced",
    "0.25 cup low fat, low sodium chicken broth"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, combine the russet potato, red potato, sweet potato, olive oil, vinegar, thyme, garlic and chicken broth. Toss well to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place into casserole dish and roast uncovered for 40 minutes, or until potatoes are tender.",
