  "ingredients": [
    "1 cup mayonnaise",
    "0.5 cup sour cream",
    "1 teaspoon curry powder",
    "1 small apple, finely chopped",
    "1 tablespoon lemon juice",
    "4 cups cooked chicken breasts, shredded",
    "1 cup chopped celery",
    "1 cup seedless green grapes, halved",
    "0.5 cup chopped pecans",
    "1 (8 ounce) can crushed pineapple in juice, undrained"
  ],
  "steps": [
    {
      "text": "Mix mayonnaise, sour cream, and curry powder in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss apple and lemon juice in a large bowl. Stir in chicken breast meat, celery, green grapes, pecans, and pineapple. Pour mayonnaise mixture over chicken; toss to combine. Cover and refrigerate until chilled.",
      "section": null,
