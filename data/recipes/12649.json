  "ingredients": [
    "6 tablespoons all-purpose flour",
    "2 cups packed brown sugar",
    "1.5 cups evaporated milk",
    "4 tablespoons butter",
    "0.5 teaspoon salt",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan, combine flour and sugar. Stir in milk, butter, salt and vanilla. Cook, stirring constantly, until mixture comes to a boil. Pour into an unbaked pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 400 degrees F (200 degrees C) for 5 minutes. Reduce heat to 350 degrees F (175 degrees C) and continue baking for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
