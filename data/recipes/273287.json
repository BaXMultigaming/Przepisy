  "title": "Healthier Oatmeal Cookies",
  "description": "This healthy spin on oatmeal cookies uses whole wheat flour in place of white flour and coconut oil instead of butter.",
  "authors": [
    "Domenichelli Wines"
  ],
  "date_published": "2020-06-19T00:36:42-04:00",
