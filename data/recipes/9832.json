  "ingredients": [
    "1.75 cups white sugar",
    "0.5 cup butter",
    "0.5 cup milk",
    "4 tablespoons unsweetened cocoa powder",
    "0.5 cup crunchy peanut butter",
    "3 cups quick-cooking oats",
    "1 teaspoon vanilla extract",
    "waxed paper"
  ],
