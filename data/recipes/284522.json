  "ingredients": [
    "1 medium poblano pepper",
    "1 medium jalapeno pepper",
    "2 (14.5 ounce) cans fire-roasted diced tomatoes",
    "1 small white onion, raw",
    "1 clove garlic, minced",
    "0.5 cup cilantro, minced",
    "1 medium lime, juiced",
    "0.25 teaspoon chipotle powder",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate. Rinse poblano and jalapeño peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast peppers and onion on the preheated grill, turning occasionally, until all sides are charred and blistered, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place peppers in a covered bowl for 5 minutes to steam and loosen skins. Scrape skins off peppers using a knife and discard. Slice peppers in half and remove seeds, if desired. Transfer to a food processor or blender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add diced tomatoes, onion, garlic, cilantro, lime juice, chipotle powder, and salt to the peppers; pulse for 15 to 20 seconds until desired consistency. Serve immediately or refrigerate for several hours for flavors to blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
