  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup shredded Cheddar cheese",
    "1 tablespoon baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "0.667 cup milk",
    "0.333 cup butter, softened and cut into pieces",
    "1 large egg",
    "2 tablespoons butter, melted",
    "2 teaspoons dried parsley",
    "1 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease or line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, Cheddar cheese, baking powder, salt, and garlic powder together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7qK6hHw2oqVOhoBWcmoT7tdNoho=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/260622-RedLobsterCheddarBiscuits-Step1-4x3-9ec7ef377f72453f85486c6a5bc1299e.jpg"
      ],
      "image": "assets/images/260622/step_02.webp"
    },
    {
      "text": "Combine milk, ⅓ cup softened butter pieces, and egg in a separate bowl; stir into flour mixture until just combined and chunky, being very careful not to overmix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XlpWEXixfWYl_odz4F9ITQAuBNo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/260622-RedLobsterCheddarBiscuits-Step2-4x3-a06ae9fcb3e545f3ba7d46276556242c.jpg"
      ],
      "image": "assets/images/260622/step_03.webp"
    },
    {
      "text": "Drop batter by tablespoonfuls onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z78ii2khPDfcsTiswjrnezRQlR4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/260622-RedLobsterCheddarBiscuits-Step3-4x3-2b3c526a8ee14c4bbcaf766fcc0ec07e.jpg"
      ],
      "image": "assets/images/260622/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir 2 tablespoons melted butter, parsley, and garlic powder together in a small bowl; brush over top biscuits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a2BEVgaVtV1LRjPIaLwdrMAwaMY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/260622-RedLobsterCheddarBiscuits-Step4-4x3-3c5e85fe16b14408a98efbf72f5497ac.jpg"
      ],
      "image": "assets/images/260622/step_06.webp"
    },
    {
      "text": "Return biscuits to the oven; continue baking until golden brown, about 5 minutes more. Serve warm.",
