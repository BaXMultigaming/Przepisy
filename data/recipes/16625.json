  "title": "Sweet Potato Potato Salad",
  "description": "This sweet potato salad is made with white potatoes and sweet potatoes, mayonnaise, a bit of mustard, celery, and hard-boiled eggs for a unique, tasty salad.",
  "authors": [
    "GRAMZ"
  ],
  "date_published": "1999-12-11T15:14:32-05:00",
