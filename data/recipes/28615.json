  "ingredients": [
    "3 tablespoons butter",
    "1 cup chopped onions",
    "1.5 cups chopped celery",
    "2.5 cups milk",
    "6 tablespoons all-purpose flour",
    "1.5 teaspoons butter",
    "4 ounces Cheddar cheese, sliced",
    "0.5 teaspoon salt",
    "0.5 teaspoon black pepper",
    "0.25 pound crabmeat",
    "0.25 pound lobster meat",
    "0.25 pound medium shrimp",
    "0.25 pound scallops"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a medium baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 3 tablespoons butter in a skillet, and saute the onions and celery until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the milk in a saucepan over medium heat, and mix in the flour and 1 1/2 teaspoons butter until well blended. Gradually blend the cheese into the mixture. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix the onions and celery with the cheese sauce mixture. Toss in the crabmeat, lobster, shrimp, and scallops. Transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered in the preheated oven 25 minutes, or until the seafood is opaque and the surface is lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
