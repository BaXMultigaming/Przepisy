  "ingredients": [
    "2 cups sandhill plums, pitted and peeled",
    "1 cup brown sugar",
    "0.33333334326744 cup confectioners' sugar",
    "0.125 cup all-purpose flour",
    "1 teaspoon cinnamon",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon ground nutmeg",
    "1 unbaked deep-dish pie crust",
    "1 unbaked single pie crust",
    "2 tablespoons milk",
    "0.125 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix plums, brown sugar, confectioners' sugar, flour, cinnamon, vanilla, and nutmeg together in a medium bowl. Transfer to deep-dish pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut regular pie crust into strips and lay over fruit mixture. Brush milk on crust and sprinkle sugar all over.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 40 minutes. Wrap foil over the edges of the pie to prevent burning. Continue to bake, for seven to 10 minutes more.",
      "section": null,
