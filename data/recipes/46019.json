  "ingredients": [
    "4 bananas, peeled and halved lengthwise",
    "0.5 cup peanut butter",
    "2 egg yolks",
    "0.66666698455811 cup white sugar, divided",
    "0.25 cup white vinegar",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Spread peanut butter onto the cut side of the banana halves, and seal the halves back together. Slice into coins, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan over low heat, whisk together the egg yolks and 1/2 cup of the sugar. Stir in the vinegar and butter. Cook, whisking constantly until clear. Whisk in remaining sugar if you like.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the bananas into a serving bowl, and pour the sauce over them. This dish may be served hot or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
