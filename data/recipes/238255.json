  "ingredients": [
    "2 cups cornmeal",
    "1.5 cups white sugar",
    "1 cup milk",
    "1 cup coconut milk",
    "1 cup all-purpose flour",
    "3 eggs",
    "0.33333334326744 cup vegetable oil",
