  "ingredients": [
    "1 cup gluten-free all-purpose flour",
    "0.5 cup almond meal",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup gluten-free rolled oats",
    "0.5 cup packed light brown sugar",
    "0.5 cup white sugar",
    "0.5 cup unsalted butter, melted",
    "2 teaspoons vanilla extract",
    "0.25 teaspoon almond extract",
    "0.33333334326744 cup white sugar",
    "1 tablespoon cornstarch",
    "2 cups pitted and diced apricots",
    "1 tablespoon diced fresh ginger"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch baking dish, line with parchment paper, and grease parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, almond meal, baking soda, and salt together in a bowl. Whisk in oats, brown sugar, and ½ cup white sugar until blended and brown sugar clumps broken up. Pour melted butter, vanilla extract, and almond extract over flour mixture; stir with a spatula until moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press ⅔ flour mixture into bottom of the prepared baking dish; set crust aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk ⅓ cup white sugar and cornstarch together in a small bowl. Add apricots and ginger; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread apricot filling over crust; sprinkle remaining ⅓ flour mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown and crisp and filling is bubbling, 35 to 40 minutes. Cool completely before cutting into bars, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
