  "ingredients": [
    "1 tablespoon ground flax seeds",
    "1 tablespoon oat bran",
    "1 tablespoon quick-cooking oats",
    "1 tablespoon cooked brown rice",
    "12 raisins, or more to taste",
    "0.25 teaspoon ground cinnamon",
    "0.5 cup soy milk, or more as needed"
  ],
  "steps": [
    {
      "text": "Mix ground flax seeds, oat bran, quick-cooking oats, brown rice, raisins, and cinnamon together in a container with a lid. Pour in soy milk; stir to make sure flaxseed mixture is suspended in milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate until oats soften, at least 6 hours. Uncover and stir before serving.",
      "section": null,
