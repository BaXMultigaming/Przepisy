  "title": "Banana Walnut Flax Seed Bread",
  "description": "This moist, whole-wheat banana bread studded with walnuts and flax seeds is great for a sweet snack, breakfast on-the-go, or lunchbox treat.",
  "authors": [
    "lsonderling"
  ],
  "date_published": "2020-03-05T00:13:43-05:00",
