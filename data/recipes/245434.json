  "keywords": [],
  "ingredients": [
    "2 cups whole wheat flour",
    "1 cup flaxseed meal",
    "0.25 cup wheat germ",
    "2 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "0.33333334326744 teaspoon sea salt",
    "2 cups chopped walnuts",
    "4 eggs",
    "2 cups brown sugar",
    "0.66666668653488 cup sunflower seed oil",
    "0.33333334326744 cup roasted walnut oil",
    "0.25 cup plain yogurt",
    "5 large ripe bananas, coarsely mashed, or more to taste",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Butter two 8x4-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk whole wheat flour, flaxseed meal, wheat germ, baking soda, cinnamon, and salt together in a large bowl. Stir walnuts into dry ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and brown sugar in a separate bowl with an electric mixer until thick and pale, about 3 minutes. Add sunflower seed oil, walnut oil, and yogurt; beat to combine. Stir in mashed bananas and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour egg mixture over dry ingredients and mix briefly, until just moistened. Divide batter between loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake loaves in the preheated oven until a toothpick inserted into the centers comes out clean, about 1 hour and 15 minutes. Remove pans from the oven and let sit 5 minutes, then remove loaves to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
