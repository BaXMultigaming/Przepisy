  "ingredients": [
    "1 cup butter or margarine, softened",
    "1 cup sugar",
    "1 (3 ounce) package cream cheese, softened",
    "1 egg yolk, reserving egg white",
    "3 tablespoons ReaLemon® lemon juice from concentrate",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "2.25 cups unsifted flour",
    "1 egg white",
    "2 cups finely chopped nuts",
    "1 (3 ounce) package cream cheese, softened",
    "0.25 cup sugar",
    "1 egg yolk",
    "1 tablespoon ReaLemon® lemon juice from concentrate",
    "1 drop Yellow food coloring"
  ],
  "steps": [
    {
      "text": "Combine all ingredients except egg white, flour, nuts and Lemon Cheese Filling. With mixer, beat until well blended. Beat in flour. Wrap dough in plastic wrap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape into 1-inch balls. With mixer, beat egg white lightly. Dip balls in egg white; roll in nuts. Place 2 inches apart on ungreased baking sheets. Press thumb deep into center of each cookie; fill with Lemon Cheese Filling (recipe below).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated 375 degrees oven 10 minutes or until filling is set. Cool slightly; remove from baking sheets. Store tightly covered in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lemon Cheese Filling Directions: Beat cream cheese, sugar, egg yolk, ReaLemon® and 1 drop of yellow food coloring, if desired, until well blended and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
