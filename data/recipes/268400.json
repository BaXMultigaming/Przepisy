  "ingredients": [
    "1 cup buttermilk",
    "1 cup rolled oats",
    "0.5 cup raisins",
    "1 cup whole wheat flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "3 tablespoons wheat germ",
    "0.33333334326744 cup butter",
    "0.25 cup packed light brown sugar",
    "1 tablespoon honey",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Combine buttermilk, rolled oats, and raisins in a bowl. Cover and refrigerate 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Liberally grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove buttermilk mixture from the refrigerator. Mix flour, baking powder, baking soda, salt, and wheat germ together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and brown sugar together in a large mixing bowl until light. Add honey and egg and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour mixture and buttermilk mixture in alternating batches to the mixing bowl with the butter mixture; stir until batter is evenly moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter evenly into the prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and golden brown, 22 to 28 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
