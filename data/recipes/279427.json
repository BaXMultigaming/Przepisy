  "ingredients": [
    "1 (15.25 ounce) package spice cake mix",
    "1 (10.75 ounce) can tomato soup (such as Campbell's®)",
    "0.5 cup milk",
    "3 eggs",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch cake pan and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cake mix, tomato soup, milk, eggs. and cinnamon together in a bowl until well combined. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 28 to 33 minutes. Cool on a wire rack for 5 minutes. Run a table knife around the edges to loosen. Invert carefully onto a serving plate or cooling rack. Let cool completely.",
      "section": null,
