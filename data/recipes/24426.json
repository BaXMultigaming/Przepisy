  "ingredients": [
    "0.5 cup butter flavored shortening",
    "0.67 cup brown sugar",
    "0.33 cup white sugar",
    "1 egg",
    "0.25 teaspoon vanilla extract",
    "0.25 teaspoon almond extract",
    "1.5 cups rolled oats",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup candy-coated milk chocolate pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the shortening, brown sugar and white sugar until smooth. Beat in the egg and vanilla until well blended. Combine the oats, flour, baking powder and salt; stir into the creamed mixture. Mix in the candy-coated chocolate pieces. Drop by rounded tablespoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 minutes in the preheated oven, until light golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
