  "ingredients": [
    "2 (3 ounce) packages orange flavored gelatin (such as JELL-O®)",
    "2 cups boiling water",
    "1 pint orange sherbet",
    "1 (10 ounce) can mandarin oranges, drained"
  ],
  "steps": [
