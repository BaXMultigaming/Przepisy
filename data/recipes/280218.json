  "ingredients": [
    "1 serving cooking spray",
    "3.5 cups all-purpose flour",
    "2.5 cups white sugar",
    "1.5 tablespoons pumpkin pie spice",
    "2 teaspoons baking soda",
    "1.5 cups canned pumpkin puree",
    "4 eggs",
    "0.66666668653488 cup milk",
    "0.5 cup canola oil",
    "1 (12 ounce) package fresh cranberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat two 9x5-inch loaf pans with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, pumpkin pie spice, and baking soda in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin purée, eggs, milk, and oil in a separate bowl; beat into flour mixture until well combined. Fold in cranberries. Divide batter between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Cool in the pans for 10 minutes, then transfer to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
