  "ingredients": [
    "1 quart oil for frying",
    "20 wooden sticks",
    "1 cup all-purpose flour",
    "0.5 cup self-rising flour",
    "0.25 cup white sugar",
    "1 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "1 teaspoon salt",
    "1.25 cups buttermilk",
    "1 egg, beaten",
    "2 tablespoons lard or shortening, melted",
    "20 hot dogs"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer to 370 degrees F (185 degrees C). Soak the wooden sticks in water so they will not burn easily.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, self-rising flour, sugar, baking powder, baking soda, and salt in a large bowl. Make a well in the center and add buttermilk, beaten egg, and lard; stir until batter is smooth. Set aside to rest briefly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, insert a wooden stick into the center of each hot dog to use as a handle. Pat hot dogs dry with a paper towel to help batter stick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each hot dog into batter and allow excess to drip off. If batter is not sticking, roll hot dogs in a little bit of flour first.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry hot dogs, a few at a time, in hot oil until golden brown and heated through, 5 to 6 minutes. If hot dogs are very brown on the outside and cold on the inside, oil is too hot. Adjust temperature as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
