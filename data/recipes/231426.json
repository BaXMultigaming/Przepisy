  "ingredients": [
    "1 tablespoon olive oil",
    "1 large onion, chopped",
    "3 large cloves garlic, minced",
    "2 (28 ounce) cans tomato sauce",
    "1 (28 ounce) can diced tomatoes",
    "0.75 cup Merlot wine",
    "1 (6 ounce) can tomato paste",
    "3 tablespoons chicken bouillon granules",
    "3 tablespoons dried basil leaves",
    "3 tablespoons Italian seasoning",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large saucepan over medium heat. Add onion and garlic; cook and stir until onion translucent, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomato sauce, diced tomatoes, wine, tomato paste, chicken bouillon granules, basil, Italian seasoning, salt, and pepper; bring to a boil, reduce heat to low, and simmer, stirring frequently, 1 hour.",
      "section": null,
      "name": null,
      "url": null,
