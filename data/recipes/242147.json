  "ingredients": [
    "0.5 cup butter, melted",
    "1 cup white sugar",
    "3 large egg whites, lightly beaten",
    "1 teaspoon ground cinnamon",
    "1 pinch cayenne pepper, or to taste",
    "4 cups pecan halves"
  ],
  "steps": [
