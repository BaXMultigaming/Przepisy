  "ingredients": [
    "1 cup butter, at room temperature",
    "0.75 cup brown sugar",
    "0.33333334326744 cup white sugar",
    "0.25 cup instant coffee powder",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "0.75 cup cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup white sugar",
    "24 dark chocolate wafers"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, brown sugar, 1/3 cup sugar, and coffee powder in a large bowl; beat with an electric mixer until creamy. Blend in eggs and vanilla extract. Mix in flour, cocoa powder, baking soda, and salt together until dough is uniform.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/2 cup sugar onto a shallow plate. Shape dough into 2-inch balls and roll in the sugar until coated. Arrange on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set, about 10 minutes. Immediately press a dark chocolate wafer into each cookie. Let cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
