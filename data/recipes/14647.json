  "ingredients": [
    "4 pounds beef brisket",
    "salt to taste",
    "1 teaspoon freshly ground black pepper",
    "1 teaspoon garlic powder",
    "1 cup barbecue sauce",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (160 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle both sides of brisket with salt, pepper, and garlic powder. Place in a Dutch oven or large roasting pan with a cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven, covered, without adding water, for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove brisket from the pan and slice. Return slices to pan. Mix BBQ sauce with water; pour over sliced brisket. Cover the pan and cook for 1 more hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
