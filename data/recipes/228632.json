  "ingredients": [
    "1 tablespoon vegetable oil",
    "4 (6 ounce) pork tenderloins",
    "1 (16 ounce) package sauerkraut, drained",
    "1 cup water",
    "6 fluid ounces apple juice",
    "2 teaspoons fennel seed",
    "12 red new potatoes, halved"
  ],
  "steps": [
    {
      "text": "Heat oil in a pressure cooker over medium heat; brown pork tenderloins in the hot oil, about 5 minutes per side. Distribute sauerkraut around the pieces of pork and pour in water and apple juice; sprinkle with fennel seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover pressure cooker and bring to full pressure; cook for 15 minutes. Remove from heat and release the pressure according to manufacturer's instructions. Place potatoes into the cooker, reseal, and bring back up to full pressure over medium heat; cook at full pressure for 5 more minutes. Remove from heat, release pressure, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
