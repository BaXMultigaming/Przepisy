  "ingredients": [
    "1 pound ground venison",
    "8 saltine crackers, crumbled",
    "1 large egg, beaten",
    "2 tablespoons brown sugar, divided",
    "0.5 teaspoon spicy brown mustard",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon dried minced onion flakes",
    "0.25 teaspoon dried cilantro",
    "0.25 teaspoon ground thyme",
    "1 dash cinnamon",
    "1 dash paprika",
    "3 tablespoons ketchup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together venison, crackers, egg, and 1 tablespoon brown sugar in a bowl. Season with mustard, garlic powder, onion flakes, cilantro, thyme, cinnamon, and paprika; mix well. Pat mixture into a 9x9-inch pan, or a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven to an internal temperature of 160 degrees F (70 degrees C), about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together ketchup with remaining 1 tablespoon brown sugar. Spread on top of the meatloaf and place back in the oven for 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
