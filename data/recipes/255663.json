  "ingredients": [
    "0.5 cup coconut flour",
    "2 egg whites",
    "0.25 cup water",
    "1 cup almond meal",
    "0.25 cup grated Parmesan cheese",
    "1 teaspoon Italian seasoning",
    "1 teaspoon ground black pepper",
    "4 zucchini, quartered lengthwise",
    "1 teaspoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour coconut flour into a bowl. Whisk egg whites and water together in a separate bowl. Combine almond meal, Parmesan cheese, Italian seasoning, and black pepper in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge zucchini, in batches, in coconut flour using tongs. Dip into beaten egg whites; toss in almond meal mixture until coated. Arrange battered zucchini on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until slightly golden, about 20 minutes. Garnish with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
