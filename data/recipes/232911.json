  "ingredients": [
    "1 pound pearl onions",
    "3 tablespoons butter",
    "3 tablespoons all-purpose flour",
    "1 pinch ground nutmeg",
    "1.5 cups light cream",
    "0.5 teaspoon salt",
    "ground black pepper to taste",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Place onions into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat; cook and stir flour and nutmeg in melted butter for about 5 minutes; season with salt and pepper. Add cream to flour mixture; cook and stir until bubbly and thick, about 5 minutes more. Stir onion and parsley into cream sauce until heated through, 2 to 3 minutes.",
      "section": null,
