  "ingredients": [
    "3 egg whites",
    "0.75 cup white sugar",
    "2.5 cups shredded coconut, divided",
    "0.25 cup gluten-free all-purpose baking flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together egg whites and sugar in a large bowl with an electric mixer until soft and creamy, about 2 minutes. Stir in 2 cups shredded coconut and gluten-free flour slowly until combined into a dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into walnut-sized balls. Roll balls in remaining 1/2 cup shredded coconut until evenly coated and place 2 inches apart on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden, about 30 minutes. Cool on the baking sheets for 1 minute before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
