  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup butter, cut into 12 cubes, frozen",
    "1 tablespoon sugar",
    "1 teaspoon salt",
    "6 tablespoons ice water"
  ],
  "steps": [
    {
      "text": "Place 1 cup flour into a food processor with the blade attachment. Sprinkle frozen butter cubes over flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YR4YVrKxOt2qpuwQDv0wqC36Fqk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/258748-ddmfs-buttercrust-pastry-dough-step1-1942-9923908147cf4da2befa50c93350f99a.jpg"
      ],
      "image": "assets/images/258748/step_01.webp"
    },
    {
      "text": "Cover with remaining 1 cup flour, sugar, and salt. Pulse in short bursts until butter is broken down into small pieces, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hgQwQ-Wm_BeCZNnlNKIKvP5_BZo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/258748-ddmfs-buttercrust-pastry-dough-step2-1943-dd3bc3dc4e4b4e0494fe0f69ab3086d2.jpg"
      ],
      "image": "assets/images/258748/step_02.webp"
    },
    {
      "text": "Drizzle in ice water. Pulse with longer pulses until mixture turns pale yellow and resembles bread crumbs, 10 to 12 seconds. Scrape down the sides with a spatula. Pulse 1 to 2 more times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7KnNYUslBshCDFy5QCoVi7d_lN0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/258748-ddmfs-buttercrust-pastry-dough-step3-1944-8fd005fbaa4b45729dead9a4758bf005.jpg"
      ],
      "image": "assets/images/258748/step_03.webp"
    },
    {
      "text": "Transfer mixture onto a work surface and gather into a ball. Flatten slightly and wrap in plastic wrap. Chill in the refrigerator for at least 1 hour to overnight before rolling out.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0em9ex738-DRZeYMDhSIBbs0G7Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/258748-ddmfs-buttercrust-pastry-dough-3X4-2056-84dfe1f69f0146f48cf843df1f5d80b0.jpg"
      ],
      "image": "assets/images/258748/step_04.webp"
    }
  ],
