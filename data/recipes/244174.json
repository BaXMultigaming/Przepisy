  "ingredients": [
    "cooking spray",
    "1.5 cups oats",
    "0.33333334326744 cup packed brown sugar",
    "0.25 cup oat bran",
    "0.25 cup chia seeds",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon dried orange peel",
    "0.25 teaspoon salt",
    "2 cups milk",
    "2 eggs",
    "3 tablespoons honey",
    "1.5 tablespoons butter, melted",
    "1.5 teaspoons vanilla extract",
    "1 cup chopped fresh strawberries",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Spray an 8x8-inch glass baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, brown sugar, oat bran, chia seeds, baking powder, cinnamon, orange peel, and salt together in a bowl. Whisk milk, eggs, honey, butter, and vanilla extract together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer strawberries into the prepared baking dish; top with oat mixture. Pour milk mixture over oat mixture and top with blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned and set, 23 to 28 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
