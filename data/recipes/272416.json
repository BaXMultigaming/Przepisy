  "ingredients": [
    "3 cups white sugar",
    "2.6666667461395 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1.5 teaspoons salt",
    "1 teaspoon ground cinnamon",
    "1 teaspoon pumpkin pie spice",
    "1 (15 ounce) can pumpkin puree",
    "1 cup vegetable oil",
    "4 eggs",
    "0.66666668653488 cup water, room temperature",
    "0.5 cup pecans, roughly chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 8x4-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, flour, baking soda, salt, cinnamon, and pumpkin pie spice together in a bowl. Add pumpkin purée, vegetable oil, eggs, and water; mix well. Fold in pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide mixture between the 2 prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Cool in the pans for 10 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
