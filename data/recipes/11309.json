  "ingredients": [
    "0.5 cup butter",
    "1.5 cups graham cracker crumbs",
    "1.5 cups flaked coconut",
    "1.5 cups chopped walnuts",
    "2 cups semisweet chocolate chips",
    "1.5 cups miniature marshmallows",
    "1 (14 ounce) can sweetened condensed milk",
    "2 (1 ounce) squares semisweet chocolate"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 9 x 13 inch baking pan melt the butter and sprinkle the graham cracker crumbs over the melted butter. Mix together and press onto bottom of pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer coconut, nuts, chocolate chips and marshmallows over crust. Drizzle the condensed milk evenly over all.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 25 to 30 minutes or until golden brown. Remove from oven and drizzle with the melted chocolate. Cool completely and cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
