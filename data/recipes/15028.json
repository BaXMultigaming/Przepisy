  "title": "Chicken and Broccoli Braid",
  "description": "This clever recipe makes innovative use of prepared crescent roll dough. A cheesy chicken and chopped broccoli mixture fills the center.",
  "authors": [
    "Kelly Grimes"
  ],
  "date_published": "1999-12-18T15:06:25-05:00",
