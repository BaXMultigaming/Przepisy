  "ingredients": [
    "2 cups diced, cooked chicken meat",
    "1 cup fresh broccoli, chopped",
    "0.5 cup red bell pepper, chopped",
    "1 clove crushed garlic",
    "1 cup shredded Cheddar cheese",
    "0.5 cup mayonnaise",
    "2 teaspoons dried dill weed",
    "0.25 teaspoon salt",
    "2 tablespoons slivered almonds",
    "0.25 cup diced onion",
    "2 (8 ounce) packages refrigerated crescent rolls",
    "1 egg white, beaten"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees F).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, toss together chicken, broccoli, red bell pepper, garlic, Cheddar cheese, mayonnaise, dill weed, salt, almonds and onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll crescent roll dough, and arrange flat on a medium baking sheet. Pinch together perforations to form a single sheet of dough. Using a knife or scissors, cut 1 inch wide strips in towards the center, starting on the long sides. There should be a solid strip about 3 inches wide down the center, with the cut strips forming a fringe down each side. Spread the chicken mixture along the center strip. Fold the side strips over chicken mixture, alternating strips from each side. Pinch or twist to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush braided dough with the egg white. Bake in the preheated oven 25 to 28 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
