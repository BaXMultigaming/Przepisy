  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken pieces in a single layer in a lightly greased 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine the ketchup, water, brown sugar and dry soup mix. Carefully pour over the chicken, making sure that all of the pieces are covered.",
