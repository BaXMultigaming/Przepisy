  "ingredients": [
    "2 (10 ounce) cans chunk chicken, drained",
    "0.75 cup hot pepper sauce (such as Frank's RedHot®)",
    "2 (8 ounce) packages cream cheese, softened",
    "1 cup ranch dressing",
    "1.5 cups shredded Cheddar cheese",
    "1 bunch celery, cut into 4-inch pieces",
    "1 (8 ounce) box chicken-flavored crackers"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oLgRv70Nfj42j9ZRq5mwEcKZOAU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68461-buffalo-chicken-dip--DDMFS-step-01-0925-2b75675b9dfa4df186d328e6e5ca61fc.jpg"
      ],
      "image": "assets/images/68461/step_01.webp"
    },
    {
      "text": "Heat chicken and hot pepper sauce in a skillet over medium heat until heated through, 3 to 5 minutes. Stir in cream cheese and ranch dressing. Cook and stir until well blended and warm, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g4RZMqBtSNeCgfNYEo2-R2DmAiM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68461-buffalo-chicken-dip--DDMFS-step-01-1-0926-104808ff7e864e89bbe2ca8ce1e581cc.jpg"
      ],
      "image": "assets/images/68461/step_02.webp"
    },
    {
      "text": "Mix in 1/2 of the Cheddar cheese, and transfer the mixture to a slow cooker. Sprinkle the remaining cheese over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3pbiEk2gmU9UmODXtXbeiSAFpeI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68461-buffalo-chicken-dip--DDMFS-step-02-0927-d4774893f40f4eff89fdcbc5dfbf7f14.jpg"
      ],
      "image": "assets/images/68461/step_03.webp"
    },
    {
      "text": "Cover and cook on Low until dip is hot and bubbly, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SHVI3VKAckmOwCWcmfml-b7oc-o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68461-buffalo-chicken-dip-DDMFS-step-03-0958-65694d8ab14646a48152f69b7ced4f7b.jpg"
      ],
      "image": "assets/images/68461/step_04.webp"
    },
    {
      "text": "Serve warm with celery sticks and crackers for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qD1AQXTSK1KG3A1c9EGIMK42W_M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68461-buffalo-chicken-dip-VAT-Beauty-4x3-4af30e487c6840e383a8dc3beea5f7e2.jpg"
