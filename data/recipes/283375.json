  "ingredients": [
    "0.25 cup unsalted butter",
    "0.25 cup white sugar",
    "0.25 cup brown sugar",
    "0.5 cup heavy cream",
    "0.5 teaspoon sea salt"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan. Add white and brown sugars; bring to a boil, stirring constantly. Stir in cream and return to a boil; boil, stirring constantly, for exactly 2 minutes. Remove from heat; stir in salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool glaze completely, 30 to 45 minutes. Chill in the refrigerator, 8 hours to overnight.",
