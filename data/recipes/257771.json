  "ingredients": [
    "1 cup water",
    "0.5 cup uncooked short-grain white rice",
    "0.25 cup rice wine vinegar",
    "2 tablespoons pickled ginger, with juice",
    "1 tablespoon mayonnaise",
    "1 tablespoon soy sauce",
    "1 tablespoon white sugar",
    "2 teaspoons wasabi powder, or to taste",
    "1 teaspoon sesame oil",
    "2 cups shredded imitation crabmeat",
    "1 avocado, cubed",
    "0.5 English cucumber, cut into 1-inch strips",
    "3 sheets nori, crumbled"
  ],
  "steps": [
    {
      "text": "Bring water and rice to a boil in a small saucepan. Reduce heat to low, cover, and simmer until rice is tender, about 20 minutes. Let cool, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rice wine vinegar, pickled ginger juice, mayonnaise, soy sauce, sugar, wasabi powder, and sesame oil together in a bowl. Pour over cooled rice; mix to coat and break up clumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dice pickled ginger. Fold ginger, crabmeat, avocado, cucumber, and nori gently into rice. Chill until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
