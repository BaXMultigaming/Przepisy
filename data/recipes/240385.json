  "ingredients": [
    "cooking spray",
    "0.75 cup milk",
    "0.75 cup all-purpose flour",
    "3 large eggs",
    "0.25 teaspoon salt",
    "2 tablespoons unsalted butter",
    "1 apple - peeled, cored, and cut into 1/4-inch pieces",
    "1 tablespoon lemon juice",
    "1 tablespoon white sugar",
    "0.5 (5.2 ounce) package garlic and herb cheese spread (such as Boursin®), crumbled"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray a pie plate with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend milk, flour, eggs, and salt together in a blender or food processor until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a 10-inch skillet over medium heat. Cook and stir apple in hot butter until tender, about 5 minutes. Stir lemon juice and sugar into apples until sugar dissolves; pour apple mixture into prepared pie plate. Top with crumbled cheese spread and pour batter over apples and cheese into pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and set, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
