  "ingredients": [
    "6 ounces NO YOLKS® Extra Broad Noodles",
    "1 pound ground beef",
    "1 small onion, chopped",
    "1 clove garlic, minced",
    "0.5 teaspoon oregano",
    "0.5 teaspoon salt",
    "1 (15 ounce) can tomato sauce",
    "0.33333334326744 cup water",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook noodles at a boil until tender yet firm to the bite, 7 to 9 minutes, or according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat and brown beef with onion, garlic, oregano, and salt. Stir in tomato sauce, water, and cooked noodles. Pour into a casserole dish and top with shredded Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until casserole is bubbling, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
