  "ingredients": [
    "0.5 cup shortening",
    "0.75 cup packed brown sugar",
    "0.5 cup molasses",
    "3 drops anise oil",
    "1 egg",
    "0.5 teaspoon baking soda",
    "1 tablespoon hot water",
    "3.5 cups all-purpose flour",
    "0.25 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.125 teaspoon white pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the shortening and brown sugar until smooth. Mix in molasses, anise oil, and egg. Dissolve baking soda in hot water, and stir into the mixture. Combine the flour, salt, cinnamon, ginger and white pepper; blend into the molasses mixture until uniform. Knead for a minute until easy to work with. Shape dough into 1 inch balls, and place 1 inch apart onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 to 12 minutes in the preheated oven, until slightly browned on the bottom. Do not over bake, or they will be very hard. Store cooled cookies in an airtight container at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
