  "ingredients": [
    "nonstick cooking spray",
    "3 large skinless, boneless chicken breast halves",
    "2 teaspoons smoked paprika",
    "0.25 teaspoon seasoning salt, or to taste",
    "0.25 teaspoon barbeque seasoning, or to taste",
    "ground black pepper to taste",
    "1 (18 ounce) bottle barbeque sauce",
    "0.25 cup Worcestershire sauce",
    "1 teaspoon mesquite-flavored liquid smoke"
  ],
  "steps": [
    {
      "text": "Spray a slow cooker with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken with smoked paprika, seasoning salt, barbecue seasoning, and pepper; place in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix barbecue sauce, Worcestershire sauce, and liquid smoke together in a small bowl. Pour over chicken, making sure chicken is completely covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook until meat can be shredded with a fork, about 6 hours on Low or 4 hours on High.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken and pull. Return to the cooker and mix well with the barbecue sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let sit 5 to 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
