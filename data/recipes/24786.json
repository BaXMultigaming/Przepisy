  "ingredients": [
    "6 skinless, boneless chicken breast halves",
    "salt and pepper to taste",
    "paprika to taste",
    "0.5 cup dry white wine",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 (4.5 ounce) can sliced mushrooms, drained",
    "1 cup sour cream",
    "0.25 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Sprinkle chicken breasts lightly with salt, pepper, and paprika to taste. Place in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, combine wine, condensed soup, and mushrooms. In another bowl, mix together sour cream and flour. Stir sour cream mixture into mushrooms and wine. Pour over chicken in the slow cooker. Sprinkle with additional paprika, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook on Low for 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
