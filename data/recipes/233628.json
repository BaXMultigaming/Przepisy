  "ingredients": [
    "1 tablespoon butter for greasing, or as needed",
    "0.75 cup white sugar",
    "0.25 cup vegetable oil",
    "0.25 cup mayonnaise",
    "2 eggs",
    "3 bananas, mashed",
    "1.25 cups all-purpose flour",
    "0.5 cup quick cooking oats",
    "0.25 cup ground flax",
    "0.25 cup wheat germ",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "0.75 cup miniature semisweet chocolate chips",
    "0.75 cup walnuts, chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease 12 muffin cups with butter or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, oil, mayonnaise, and eggs together until creamy and light yellow. Mix in bananas until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, oats, flax, wheat germ, baking soda, baking powder, and salt into banana mixture until smooth. Mix in chocolate chips and walnuts. Spoon batter into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and the tops spring back when lightly pressed, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
