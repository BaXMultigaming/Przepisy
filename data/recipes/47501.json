  "ingredients": [
    "2 lemons, juiced",
    "6 cloves garlic, peeled and minced",
    "1 sprig fresh parsley, chopped",
    "salt and pepper to taste",
    "3 pounds squid, cleaned and sliced into rounds",
    "4 stalks celery, chopped",
    "1 (2.25 ounce) can pitted black olives"
  ],
  "steps": [
    {
      "text": "Mix together lemon juice, garlic, and parsley in a medium bowl. Season with salt and pepper; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a medium pot of water to a boil. Stir in squid and cook until tender, about 3 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add boiled squid, celery, and olives to lemon juice mixture; stir to evenly combine. Cover and chill in the refrigerator until serving.",
