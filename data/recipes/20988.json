  "ingredients": [
    "1 quart vanilla ice cream",
    "3 cups crushed cornflakes cereal",
    "1 teaspoon ground cinnamon",
    "3 egg whites",
    "2 quarts oil for frying"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/32XlCJwclzSKI8kqkqUAo0rb7Xc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20988-Fried-Ice-Cream-DDMFS-4x3-Ingredients-febe38accb1041d89d8bf52bf6753938.jpg"
      ],
      "image": "assets/images/20988/step_01.webp"
    },
    {
      "text": "Scoop ice cream into eight 1/2-cup-sized balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IyTaudFOw1s8PpXeu4_T9IQOBS8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20988-Fried-Ice-Cream-DDMFS-4x3-Step-01-b44df6b0ed3e4f27ada6591b209314cf.jpg"
      ],
      "image": "assets/images/20988/step_02.webp"
    },
    {
      "text": "Place on a baking sheet and freeze until firm, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4W-fncblI13DcO1b3CZ8LlMbDaY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20988-Fried-Ice-Cream-DDMFS-4x3-Step-02-3262e412921f4a059995a70c5ed86973.jpg"
      ],
      "image": "assets/images/20988/step_03.webp"
    },
    {
      "text": "Combine cornflakes and cinnamon in a shallow dish. Beat egg whites until foamy in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_pmJ-zMvLz4-fpR0NPNrzt-XYTc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20988-Fried-Ice-Cream-DDMFS-4x3-Step-03-A-d03d189b61754330abc3cc87cfa264ed.jpg"
      ],
      "image": "assets/images/20988/step_04.webp"
    },
    {
      "text": "Roll ice cream balls in egg whites.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l8mcRpucotK2hPQeLZ7HuHmyk3g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20988-Fried-Ice-Cream-DDMFS-4x3-Step-04-e78dd979aad54dc8b2c394acb8bf7d6a.jpg"
      ],
      "image": "assets/images/20988/step_05.webp"
    },
    {
      "text": "Then roll in crushed cornflakes, covering ice cream completely. Repeat if necessary. Freeze again until firm, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Fvjhd_egtBg2rUzNaCsj64Wb6iM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20988-Fried-Ice-Cream-DDMFS-4x3-Step-05-A-f8e9f9f5ccad4257a15fb5f0200c90ce.jpg"
      ],
      "image": "assets/images/20988/step_06.webp"
    },
    {
      "text": "Heat oil in a deep-fryer or large, heavy saucepan to 375 degrees F (190 degrees C). Using a basket or slotted spoon, fry ice cream balls 1 or 2 at a time in hot oil until golden and crispy, 10 to 15 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cnCDs-Yt3RPLClQAuzg6yztKdh8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20988-Fried-Ice-Cream-DDMFS-4x3-Step-06-7a016b7bad97417e8798aa44b6d5d0a3.jpg"
      ],
      "image": "assets/images/20988/step_07.webp"
    },
    {
      "text": "Drain quickly on paper towels and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zvB79rMNWcVQhI3aHEx6ZDffdQQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20988-Fried-Ice-Cream-DDMFS-4x3-bac5a4a2800b4ff5a308c59bc3bae17a.jpg"
      ],
      "image": "assets/images/20988/step_08.webp"
    }
