  "ingredients": [
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "1 (1.25 ounce) package beef with onion soup mix",
    "1 (4.5 ounce) can mushrooms, drained",
    "1 cup water",
    "1 pound sirloin tips, cubed",
    "1 (16 ounce) package wide egg noodles"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine condensed soup, soup mix, mushrooms, and water in a 13x9-inch casserole dish. Mix thoroughly and add beef tips. Turn to coat well. Bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While beef tips are cooking, bring a large pot of lightly salted water to a boil. Add noodles and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve beef tips and sauce over noodles.",
