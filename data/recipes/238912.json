  "ingredients": [
    "1.5 cups whole wheat flour",
    "0.5 cup packed brown sugar",
    "1 tablespoon pumpkin pie spice",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking powder",
    "0.5 cup coconut oil",
    "2 eggs",
    "0.5 teaspoon vanilla extract",
    "0.75 cup pumpkin puree",
    "0.5 cup shredded zucchini"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a muffin tin or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, brown sugar, pumpkin pie spice, baking soda, salt, and baking powder together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk coconut oil, eggs, and vanilla extract together in a separate bowl. Add to flour mixture; stir until just combined. Fold pumpkin puree and zucchini into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop batter into the prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center has a few moist crumbs attached, 18 to 24 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
