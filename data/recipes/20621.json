  "ingredients": [
    "1.5 pounds lean ground beef",
    "0.75 cup fresh bread crumbs",
    "0.5 cup ketchup",
    "0.33333334326744 cup tomato juice",
    "0.25 cup diced onion",
    "2 eggs, beaten",
    "2 teaspoons prepared mustard",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.125 teaspoon crushed red pepper",
    "0.5 cup ketchup",
    "4 teaspoons brown sugar",
    "1 teaspoon prepared mustard"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 9x5-inch loaf pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make meatloaf: In a large bowl, mix ground beef, bread crumbs, ketchup, tomato juice, onion, eggs, mustard, salt, pepper, and crushed red pepper together until well combined. Press mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make topping: In a separate bowl, mix ketchup, brown sugar, and mustard together until smooth. Spread mixture over meatloaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink, 35 to 45 minutes. Drain off fat. Let rest for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
