  "ingredients": [
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "1.5 cups milk",
    "1 cup diced cooked ham",
    "3 eggs, beaten",
    "0.75 cup baking mix (such as Bisquick ®)",
    "0.5 cup chopped onion",
    "0.5 cup shredded sharp Cheddar cheese",
    "0.5 cup shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a 10-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press spinach in an even, compact layer into the bottom of the prepared pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk, ham, eggs, baking mix, onion, Cheddar cheese, and Monterey Jack cheese together in a bowl; pour over the spinach layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until quiche is set in the middle, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
