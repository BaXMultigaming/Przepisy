  "ingredients": [
    "2 (29 ounce) cans sweet potatoes, drained",
    "0.33333334326744 cup butter, melted",
    "2 tablespoons white sugar",
    "2 tablespoons brown sugar",
    "0.5 cup milk",
    "2 eggs, beaten",
    "1 tablespoon orange juice",
    "0.33333331346512 cup chopped pecans",
    "0.33333334326744 cup brown sugar",
    "2 tablespoons all-purpose flour",
    "2 teaspoons butter, melted"
  ],
  "steps": [
    {
      "text": "Lightly grease a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sweet potatoes: Place drained sweet potatoes in a large bowl and mash with a potato masher until smooth. Mix in melted butter and both sugars. Stir in milk, eggs, and orange juice until well combined. Transfer to the prepared slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make topping: Combine pecans, brown sugar, flour, and melted butter in a small bowl. Spread topping over sweet potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on High for 3 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
