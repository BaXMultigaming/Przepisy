  "ingredients": [
    "0.25 cup cold butter, cut into small pieces",
    "0.5 cup all-purpose flour",
    "0.25 cup packed brown sugar",
    "1 teaspoon ground cinnamon",
    "0.5 cup quick cooking oats",
    "1.25 cups white sugar",
    "0.5 cup butter, softened",
    "2 eggs",
    "3 ripe bananas, mashed",
    "0.5 cup buttermilk",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "2 teaspoons pumpkin pie spice",
    "2 teaspoons baking powder",
    "0.5 teaspoon ground cinnamon",
    "1 cup chopped nuts"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease 2 loaf pans, 8 1/2 x 4 1/2 inches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the streusel topping, mix 1/4 cup of cut-up butter, 1/2 cup flour, brown sugar, 1 teaspoon cinnamon, and oats in a bowl until crumbly. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream the sugar and butter together in a bowl, and stir in the eggs. Add the bananas, buttermilk, and vanilla extract, and stir until the mixture is well blended. Beat in the flour, pumpkin pie spice, baking powder, cinnamon, and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop the batter into the prepared loaf pans. Sprinkle the top of each loaf with half the streusel topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour and 15 minutes, until the loaves have risen and the topping is browned. Let the banana bread cool in the pans for 5 minutes before turning out onto a wire rack to finish cooling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
