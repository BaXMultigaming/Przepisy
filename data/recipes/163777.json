  "ingredients": [
    "1 cup packed light brown sugar",
    "2 tablespoons dry mustard powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon cayenne pepper",
    "1 pound sliced bacon"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil and set a wire rack over the foil. Use a baking sheet that has sides to catch the grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/US8-dynFxTmBs4OZL2ntbR2-al8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/163777-spiced-bacon-twists-DDMFS-step-01-0772-0b2b96be713d4c4489ebe9a383690082.jpg"
      ],
      "image": "assets/images/163777/step_01.webp"
    },
    {
      "text": "In a small bowl, stir together the brown sugar, mustard powder, cinnamon, nutmeg, and cayenne pepper. Press each slice of bacon into the mixture until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hZBI_Nu1Bk86KAxkg0OCdCqV4XQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/163777-spiced-bacon-twists-DDMFS-step-02-0774-24b29ad09fbb42babb89df52fc93a702.jpg"
      ],
      "image": "assets/images/163777/step_02.webp"
    },
    {
      "text": "Twist each strip a few times and place on the prepared baking rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nzSZ7Vv-b7wJsR_0fMPy_5xtJ6I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/163777-spiced-bacon-twists-DDMFS-step-03-0775-f35634339c57471990215ff346890ad3.jpg"
      ],
      "image": "assets/images/163777/step_03.webp"
    },
    {
      "text": "Bake until bacon is browned and crisp enough to hold its shape, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JLqn9R2b9rQld5Nz7srOLnYOWns=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/163777-spiced-bacon-twists-DDMFS-step-04-0829-5f0d9f271f9141499ffe00d413c19ea0.jpg"
