  "ingredients": [
    "3 cups basmati rice",
    "1 tablespoon vegetable oil",
    "2 teaspoons salt, divided",
    "1 cup vegetable oil",
    "2 potatoes, cubed",
    "1 large carrot, cubed",
    "1 whole chicken, cut into 8 pieces",
    "2 onions, minced",
    "2 ripe tomatoes, minced",
    "2 tablespoons tomato paste",
    "2 tablespoons crushed fresh ginger root",
    "2 tablespoons green curry paste",
    "2 tablespoons soy sauce",
    "2 cloves garlic, minced",
    "1 teaspoon ground turmeric",
    "1 teaspoon ground black pepper",
    "1 cube chicken bouillon",
    "1 tablespoon lime juice",
    "1 tablespoon vegetable oil",
    "1 onion, sliced",
    "0.5 cup raisins",
    "1 teaspoon soy sauce",
    "3 hard-boiled eggs, peeled and quartered",
    "1 large lemon, sliced",
    "1 green onion, chopped"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o-ktAaDs-7UhvJf1Ai7YhjGYtSI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246560-fried-chicken-biryani-filipino-style-VAT-step-01-42f3c4c4303a47cd863de7114fdd6281.jpg"
      ],
      "image": "assets/images/246560/step_01.webp"
    },
    {
      "text": "Place rice in a large bowl and cover with water. Let soak for 20 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wO6IThHVVEfQopbwi7GMcDSLU_k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246560-fried-chicken-biryani-filipino-style-VAT-step-02-3e6e6a8280b14e45bcf3e8c73bed0e1a.jpg"
      ],
      "image": "assets/images/246560/step_02.webp"
    },
    {
      "text": "Bring a large pot of water to a boil; add 1 tablespoon oil and 1 teaspoon salt. Add rice; simmer until partially cooked through and still firm, 5 to 7 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7hyAoqbefFrPbWajZo_hgg02j3c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246560-fried-chicken-biryani-filipino-style-VAT-step-03-b63772c8b7914180bd911a3c8b371e72.jpg"
      ],
      "image": "assets/images/246560/step_03.webp"
    },
    {
      "text": "Heat 1 cup oil in a large pot over medium-high heat. Add potatoes and carrot; sauté until golden, about 2 minutes. Use a slotted spoon to transfer vegetables to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kALVyxJGhbx9R6H5fSNNI-3Ypbo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246560-fried-chicken-biryani-filipino-style-VAT-step-04-6c59cf6d1ac349928aedeb80a1c70120.jpg"
      ],
      "image": "assets/images/246560/step_04.webp"
    },
    {
      "text": "Add chicken pieces to remaining hot oil in the pot; fry until golden brown, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rGLe_fkZGkQKnesNPQQQE6QBi9o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246560-fried-chicken-biryani-filipino-style-VAT-step-05-f4577287ff4a480cb75b5a4dc415debd.jpg"
      ],
      "image": "assets/images/246560/step_05.webp"
    },
    {
      "text": "Stir onions, tomatoes, tomato paste, ginger, curry paste, soy sauce, garlic, turmeric, remaining 1 teaspoon salt, black pepper, and chicken bouillon into chicken in the pot. Cover and simmer until flavors combine, about 5 minutes. Stir in lime juice. Return potatoes and carrot to the pot. Cook and stir for 1 minute. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RUMhyMcvNxMs9dgI3JAs_7jXE2Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246560-fried-chicken-biryani-filipino-style-VAT-step-06-6c488b09701846c2a410cffdb1277eb0.jpg"
      ],
      "image": "assets/images/246560/step_06.webp"
    },
    {
      "text": "Place 1/3 of the rice in the bottom of another large pan. Cover with 1/2 of the chicken mixture. Continue layering remaining rice and chicken mixture. Cover and cook over very low heat until rice is tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Fkn6_hVeYp67aZUgv67De18ZeCw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246560-fried-chicken-biryani-filipino-style-VAT-step-07-77967d3d755b464a9911572460287d81.jpg"
      ],
      "image": "assets/images/246560/step_07.webp"
    },
    {
      "text": "Transfer chicken-rice mixture to a large serving plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LCaVzck2dMHLWoxnVVIfCgrzLLk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246560-fried-chicken-biryani-filipino-style-VAT-step-08-964f1d9209044080918be0bb7d3bc84e.jpg"
      ],
      "image": "assets/images/246560/step_08.webp"
    },
    {
      "text": "Make garnish: Heat oil in a large skillet over medium-high heat. Add sliced onion; cook and stir until golden brown, about 5 minutes. Stir in raisins and soy sauce; cook for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KQO06s_cBlL8jF5ZFFj96m7Z-Sc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246560-fried-chicken-biryani-filipino-style-VAT-step-09-c13759ac0d534a77b1aef967ee386975.jpg"
      ],
      "image": "assets/images/246560/step_09.webp"
    },
    {
      "text": "Scatter onion mixture over chicken-rice mixture. Top with hard-boiled eggs, lemon slices, and green onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eUxSUXg40LlAHGsvtjs1i1Y2R4Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-246560-fried-chicken-biryani-filipino-style-VAT-step-10-0b4f5b0caedb42d1bf952cb47bb83a10.jpg"
      ],
      "image": "assets/images/246560/step_10.webp"
    }
  ],
