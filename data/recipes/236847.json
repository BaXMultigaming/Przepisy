  "ingredients": [
    "1 pound ground beef",
    "1 cup crushed saltine crackers",
    "0.5 cup chopped onion",
    "0.5 cup chopped green bell pepper",
    "0.33333334326744 cup milk",
    "1 egg",
    "1 tablespoon Worcestershire sauce",
    "2 cloves garlic, chopped",
    "1 teaspoon ground black pepper",
    "1 teaspoon seasoned salt",
    "0.5 cup ketchup",
    "0.5 cup brown sugar",
    "4 cups mashed potatoes",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, saltine crackers, onion, green bell pepper, milk, egg, Worcestershire sauce, garlic, black pepper, and seasoned salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ketchup and brown sugar together in a bowl. Spoon ketchup mixture into the bottom of each muffin cup of a 6-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill muffin cups with beef mixture, leaving 1/2-inch space on the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, about 30 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C). Drain fat from muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top each 'cupcake' with mashed potatoes and Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue baking until cheese is melted, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
