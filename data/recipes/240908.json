  "ingredients": [
    "2 cups white sugar",
    "0.5 cup butter",
    "0.5 cup milk",
    "1 (10 ounce) package cinnamon chips",
    "0.5 cup chocolate-hazelnut spread (such as Nutella®)",
    "3 cups old-fashioned rolled oats"
  ],
  "steps": [
    {
      "text": "Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, butter, and milk in a saucepan; bring to a boil and cook for 2 minutes. Remove saucepan from heat and stir in cinnamon chips and chocolate-hazelnut spread until melted. Fold oats into mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop mixture by walnut-size spoonfuls onto the prepared baking sheets.",
      "section": null,
      "name": null,
