  "ingredients": [
    "1 cup molasses",
    "0.75 cup hot water",
    "0.75 teaspoon baking soda",
    "1 egg, beaten",
    "1 (9 inch) pie shell",
    "1.5 cups all-purpose flour",
    "1 cup packed brown sugar",
    "0.25 cup shortening"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine molasses, hot water, and baking soda together in a medium bowl; whisk in beaten egg until well combined. Pour mixture into deep dish pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GHrHWnoG7XpuGNK-txenKNub-LA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15853-my-grandmas-shoo-fly-pie-step-1-1153-8f4f39f45ae14c40b86ebf85cb01f26f.jpg"
      ],
      "image": "assets/images/15853/step_02.webp"
    },
    {
      "text": "Combine flour and brown sugar in a separate medium bowl; cut in shortening until mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xF4-her-NN2PJfIUj6a13g7Vm2A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15853-my-grandmas-shoo-fly-pie-step-3-1155-743afb19ab9d458aa5c72a63b664050f.jpg"
      ],
      "image": "assets/images/15853/step_03.webp"
    },
    {
      "text": "Sprinkle on top of pie filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q9SQfME5SJGA12VTDoqYWlNgtb0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15853-my-grandmas-shoo-fly-pie-step-4-1156-ec3c15bbec014f4898921d806f659924.jpg"
