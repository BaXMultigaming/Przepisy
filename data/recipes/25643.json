  "ingredients": [
    "1.25 pounds ground beef",
    "4 (4 ounce) links Italian sausage, casings removed",
    "1 egg, beaten",
    "1 small green bell pepper, chopped",
    "1 onion, chopped",
    "0.5 cup dry hot wheat cereal",
    "0.5 cup milk",
    "1 dash Worcestershire sauce",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chop sausage finely. In a large bowl combine beef, sausage, egg beat, bell pepper, onion, cereal, milk, Worcestershire sauce, salt and pepper. Mix together and press into a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour, or until cooked through. Drain grease from loaf pan periodically during baking. Let stand 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
