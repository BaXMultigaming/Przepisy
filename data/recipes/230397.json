  "ingredients": [
    "2 cups chicken broth",
    "1 cup quinoa",
    "3 tablespoons olive oil",
    "0.5 cup coarsely chopped mint leaves",
    "0.5 cup dry-roasted almonds, unsalted",
    "0.5 cup dried cranberries",
    "1 cup coarsely chopped kale",
    "0.5 cup sliced carrots",
    "0.5 cup sliced celery",
    "1 scallion, thinly sliced",
    "18 grape tomatoes, halved",
    "1 lemon, juiced",
    "0.5 teaspoon lemon zest",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring the chicken broth to a boil in a saucepan over high heat. Add quinoa, reduce heat to medium-low, cover, and simmer until the quinoa is tender and the liquid has been absorbed, about 13 minutes. Stir in olive oil; fluff quinoa with a fork. Set aside to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mint, almonds, dried cranberries, kale, carrots, celery, scallion, grape tomatoes, lemon juice, and lemon zest. Season to taste with salt and ground black pepper.",
