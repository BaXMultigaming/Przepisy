  "title": "Chocolate Trifle",
  "description": "This pretty chocolate trifle with layers of fudgy brownies, rich and creamy chocolate pudding, and fluffy whipped topping is chilled to perfection.",
  "authors": [
    "Wayne"
  ],
  "date_published": "2000-03-05T17:45:31-05:00",
