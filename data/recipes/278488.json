  "ingredients": [
    "0.25 cup mayonnaise",
    "0.25 cup ketchup",
    "0.25 cup raw honey",
    "3 tablespoons apple cider vinegar",
    "2 tablespoons diced red onion",
    "0.25 teaspoon salt",
    "freshly ground black pepper to taste",
    "0.5 cup olive oil",
    "1 (8 ounce) package mixed salad greens",
