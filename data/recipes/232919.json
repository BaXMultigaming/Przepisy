  "ingredients": [
    "1 tablespoon butter",
    "2 teaspoons olive oil",
    "1 small onion, diced",
    "0.75 cup heavy whipping cream",
    "3 eggs",
    "salt and ground black pepper to taste",
    "0.75 cup shredded mozzarella cheese",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish or pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter and olive oil in a skillet over medium-high heat; add onion. Cook and stir until softened, about 10 minutes; transfer onion to a plate to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cream, eggs, salt, and black pepper in a bowl; stir in mozzarella cheese, Parmesan cheese, and onion. Pour mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until eggs are set and a knife inserted in the center comes out clean, about 35 minutes. It should be light brown around the edges but not brown on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
