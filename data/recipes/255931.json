  "ingredients": [
    "3 Golden Delicious apples - peeled, cored, and thinly sliced",
    "0.66666668653488 cup water",
    "2 teaspoons cold butter, cut into small pieces",
    "1.5 teaspoons all-purpose flour",
    "1 teaspoon cornstarch",
    "0.5 cup brown sugar",
    "0.25 teaspoon ground cinnamon",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer apple slices on the bottom of an 8-inch glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix water, butter, flour, and cornstarch together in a bowl until no lumps remain. Stir in brown sugar, cinnamon, and salt until smooth; pour mixture over apples in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring every 10 to 15 minutes, until soft and juicy, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
