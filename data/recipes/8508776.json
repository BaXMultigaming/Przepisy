  "ingredients": [
    "2 cups chicken broth",
    "3 ounces angel hair pasta",
    "1 tablespoon butter",
    "1 clove garlic, minced",
    "0.5 teaspoon Italian seasoning",
    "0.25 cup heavy cream",
    "0.75 cup finely shredded Parmesan cheese",
    "1 teaspoon minced fresh parsley, or to taste"
  ],
  "steps": [
    {
      "text": "Bring chicken broth in a saucepan to a boil over medium-high heat. Cook angel hair pasta in the boiling broth, stirring occasionally, until tender yet firm to the bite, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta, reserving 1/4 cup of chicken broth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium-low heat; add garlic and cook until fragrant, about 30 seconds. Stir in Italian seasoning, reserved 1/4 cup chicken broth, and whipping cream. Add Parmesan cheese and stir until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in angel hair pasta; toss to coat. Garnish with freshly minced parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
