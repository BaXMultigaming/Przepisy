  "ingredients": [
    "2.25 cups milk",
    "1 cup heavy whipping cream",
    "0.75 cup white sugar",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-8vzmIMjtgs7mrkRA7YjmxS0C_4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-RM-233928-how-to-make-vanilla-ice-cream-ddmfs-ingredients-3x4-d350de1bab194ee28917262fdbcc1ef9.jpg"
      ],
      "image": "assets/images/233928/step_01.webp"
    },
    {
      "text": "Stir milk, cream, and sugar together in a saucepan over low heat until sugar has dissolved; heat just until hot and a small ring of foam appears around the edge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KU08y6PyWXF4JwR4e7KUs1KK_7I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-RM-233928-how-to-make-vanilla-ice-cream-ddmfs-step1-3x4-f47e7825869f42feb70a0231e45dddfc.jpg"
      ],
      "image": "assets/images/233928/step_02.webp"
    },
    {
      "text": "Transfer cream mixture to a pourable container such as a large measuring cup; stir in vanilla extract. Chill cream mixture thoroughly, 2 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ntNhDTyCwCBnr4vPYpnSPMTqY24=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-RM-233928-how-to-make-vanilla-ice-cream-ddmfs-step2-3x4-e1e295ceceb0413ab4ab2eeb802770b1.jpg"
      ],
      "image": "assets/images/233928/step_03.webp"
    },
    {
      "text": "Pour cold cream mixture into an ice cream maker and freeze according to manufacturer's instructions, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rpxe7gW5pTFEswJT47HMpfbPXxw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-RM-233928-how-to-make-vanilla-ice-cream-ddmfs-step3-3x4-57f5827d94cd40edbd2c593700b30b56.jpg"
      ],
      "image": "assets/images/233928/step_04.webp"
    },
    {
      "text": "Serve ice cream immediately when softly frozen or place a piece of plastic wrap directly onto ice cream and place in the freezer to firm and ripen, 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qcmrf5DD55Q8y7pgGPvwQyukO5U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-RM-233928-how-to-make-vanilla-ice-cream-ddmfs-step4-1-3x4-3d81a4e418f34e9bbd3037bb9c90f3c1.jpg"
      ],
      "image": "assets/images/233928/step_05.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xA0NsqO_lNpSFT3wsgw4LEgzJmM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-RM-233928-how-to-make-vanilla-ice-cream-ddmfs-3x4-c5b61f092fe14296b52ca364b1446800.jpg"
      ],
      "image": "assets/images/233928/step_06.webp"
    }
