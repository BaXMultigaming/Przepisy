  "ingredients": [
    "1 cup heavy cream",
    "2 teaspoons vanilla extract",
    "4 egg yolks",
    "0.33000001311302 cup white sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
