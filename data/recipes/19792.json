  "ingredients": [
    "1 cup white sugar",
    "3 tablespoons unsweetened cocoa powder",
    "0.5 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.75 cup evaporated milk",
    "1 teaspoon vanilla extract",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "In a medium saucepan, combine sugar, cocoa, salt and cinnamon. Stir to mix and to eliminate lumps.",
