  "ingredients": [
    "2 cups white sugar",
    "1 cup vegetable oil",
    "3 eggs",
    "1 teaspoon vanilla extract, or more to taste",
    "2 cups shredded zucchini",
    "3 cups all-purpose flour",
    "1 tablespoon ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 teaspoon ground nutmeg",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon ground cloves",
    "0.5 cup chopped walnuts",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, oil, eggs, and vanilla extract together in a large bowl until smooth; fold in zucchini. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cinnamon, salt, baking soda, nutmeg, baking powder, and cloves together in a separate bowl; gradually stir into sugar mixture until well combined. Fold in walnuts and raisins until incorporated. Divide batter between the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
