  "ingredients": [
    "1 (14 ounce) bottle ketchup",
    "3 tablespoons dark brown sugar",
    "2 tablespoons white vinegar",
    "1 teaspoon prepared yellow mustard (such as French's®)",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon ground cloves",
    "2 (16 ounce) packages cocktail-size smoked link sausages (such as Hillshire Farm Lit'l Smokies ®)"
  ],
  "steps": [
    {
      "text": "Stir the ketchup, brown sugar, vinegar, mustard, cinnamon, and cloves together in a saucepan over low heat; cook until completely warmed, about 5 minutes. Add the sausages and continue cooking until the sausages are heated through, stirring occasionally, about 25 minutes.",
