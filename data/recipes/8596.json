  "title": "Mediterranean Lemon Chicken",
  "description": "Lemon and garlic are practically emblematic of the sunny Mediterranean, and this dish offers them with oregano in a delightful basting sauce for baked chicken.",
  "authors": [
    "NIBLETS"
  ],
  "date_published": "1999-05-01T11:31:36-04:00",
