  "ingredients": [
    "1 cup low-fat mayonnaise",
    "1 cup low-fat sour cream",
    "4 ounces Gorgonzola cheese, crumbled",
    "1 tablespoon chopped fresh dill",
    "1 clove garlic, peeled",
    "salt and pepper to taste",
    "2 teaspoons unflavored gelatin"
  ],
  "steps": [
    {
      "text": "In a food processor, blend mayonnaise, sour cream, Gorgonzola cheese, dill, garlic, salt, and pepper until smooth. Sprinkle gelatin into mixture and let soften for approximately 5 minutes. Blend to mix in gelatin. Cover and chill in the refrigerator until ready to serve.",
