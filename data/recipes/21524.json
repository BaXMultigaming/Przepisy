  "ingredients": [
    "0.25 cup butter",
    "9 large onions, sliced",
    "1 (7 ounce) bag sour cream-and-onion-flavored potato chips, crushed",
    "1 cube beef bouillon",
    "0.5 cup water",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium-high heat. Saute onions until tender. Transfer to prepared dish and top with crushed potato chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve bouillon in water and mix with mushroom soup; pour over chips and onions. Top with cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
