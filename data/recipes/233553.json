  "ingredients": [
    "1 (8 ounce) package Neufchatel cheese",
    "1 cup milk",
    "0.75 cup grated Parmesan cheese",
    "0.5 teaspoon garlic salt",
    "1 small loaf French bread, cut into cubes"
  ],
  "steps": [
    {
      "text": "Stir Neufchatel cream cheese in milk in a saucepan over medium-low heat until melted, 2 to 3 minutes. Add Parmesan cheese and garlic salt. Cook and stir until the Parmesan melts, 2 to 3 minutes more. Serve with bread cubes.",
