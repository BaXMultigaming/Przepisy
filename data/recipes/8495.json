  "ingredients": [
    "nonstick cooking spray",
    "4 skinless, boneless chicken breast halves",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "6 slices Swiss cheese",
    "4 slices cooked ham",
    "0.5 cup seasoned bread crumbs"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C). Coat a 7x11-inch baking dish with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i1yML8qaMvOZNSXKBaKRCz2TIT4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8495-Chicken-Cordon-Bleu-mfs-STEP-001-9b903da48905450a9ed5925ee80fd58d.jpg"
      ],
      "image": "assets/images/8495/step_01.webp"
    },
    {
      "text": "Pound chicken breasts to 1/4 inch thickness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M3PJCr2vm0zjg-8IoD-rlnb0BFM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8495-Chicken-Cordon-Bleu-mfs-STEP-002-93b627563d22435183ae66fa0effc5ff.jpg"
      ],
      "image": "assets/images/8495/step_02.webp"
    },
    {
      "text": "Sprinkle each piece of chicken on both sides with salt and pepper. Place 1 Swiss cheese slice and 1 ham slice on top of each breast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a4z5U7TqyBEODl-TQUFoSCEF8YE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8495-Chicken-Cordon-Bleu-mfs-STEP-003-63f2aec28fde4cde8d60a9381c04257f.jpg"
      ],
      "image": "assets/images/8495/step_03.webp"
    },
    {
      "text": "Roll up each breast and secure with toothpicks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_YVxP578XNmORshUGOe5xUdAAKk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8495-Chicken-Cordon-Bleu-mfs-STEP-005-66541bd87f9240849acea2637a8fc91e.jpg"
      ],
      "image": "assets/images/8495/step_04.webp"
    },
    {
      "text": "Place in the prepared baking dish and sprinkle chicken evenly with bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MgEKtuOlw9FCBPl96fmnqhhCoq0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8495-Chicken-Cordon-Bleu-mfs-STEP-010-f975fc22e17e410f983fb682e10926b4.jpg"
      ],
      "image": "assets/images/8495/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hmTzSGObiIAHVWY3JRRW7-zyruw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8495-Chicken-Cordon-Bleu-mfs-STEP-012-ccf3c3f3e10a4d2f907f1148cd875951.jpg"
      ],
      "image": "assets/images/8495/step_06.webp"
    },
    {
      "text": "Remove from the oven, and place 1/2 Swiss cheese slice on top of each breast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i9jx95xhn2POweQmi2MrKMTyTgY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8495-Chicken-Cordon-Bleu-mfs-STEP-013-500d2ceeb2764f3183304183489e5661.jpg"
      ],
      "image": "assets/images/8495/step_07.webp"
    },
    {
      "text": "Return to the oven until cheese has melted, 3 to 5 minutes. Remove toothpicks and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5HglrNLUT16KFaiEe1mlQYWN-Mc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8495-chicken-cordon-bleu-i-DDMFS-4x3-7dc7fc3c6c37438badf35f188172bd09.jpg"
