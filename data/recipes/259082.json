  "ingredients": [
    "0.5 cup white sugar",
    "0.5 cup butter",
    "0.5 cup shortening",
    "1 tablespoon almond extract",
    "2.5 cups all-purpose flour",
    "2 tablespoons colored sugar, or as desired",
    "2 tablespoons sprinkles, or as desired",
    "2 tablespoons guava paste, or as desired"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, butter, and shortening together in a bowl using an electric mixer until creamy. Mix in almond extract. Add flour in batches, kneading the dough to thoroughly combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into walnut-size balls and place 2 inches apart onto baking sheets. Make a well in each cookie with a wooden spoon handle. Sprinkle colored sugar, sprinkles, and guava paste into the wells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden, 16 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
