  "ingredients": [
    "2 pounds sliced zucchini",
    "0.25 cup chopped onion",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 cup sour cream",
    "1 cup grated carrots",
    "1 (6 ounce) package chicken-flavored dry bread stuffing mix",
    "1 stick unsalted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil. Cook zucchini and onion in boiling water for 5 minutes; drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine condensed soup, sour cream, and carrots in a large bowl; stir in zucchini and onion until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine stuffing mix and melted butter in a bowl; spread ½ into a 9x13-inch baking dish. Spoon zucchini mixture over stuffing; top with remaining ½ stuffing mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until stuffing is golden brown, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
