  "title": "Easy Pumpkin Pie Squares",
  "description": "A crust with oats and brown sugar topped with spiced pumpkin, baked and cut into bars for these festive pumpkin pie squares. Just like the pie but cuter and easier.",
  "authors": [
    "JRR"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
