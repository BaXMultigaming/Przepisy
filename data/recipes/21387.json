  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 cup brown sugar",
    "1 cup all-purpose flour",
    "0.5 cup rolled oats",
    "2 eggs",
    "0.75 cup white sugar",
    "1 (15 ounce) can pumpkin",
    "1 (12 fluid ounce) can evaporated milk",
    "0.5 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together butter and brown sugar. Mix in flour. Fold in oats. Press into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes, until toasted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat eggs with white sugar. Beat in pumpkin and evaporated milk. Mix in salt, cinnamon, ginger, and cloves. Pour over baked crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes, until set. Let cool before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
