  "ingredients": [
    "0.25 cup white wine vinegar",
    "0.5 teaspoon Dijon mustard",
    "0.5 cup extra-virgin olive oil",
    "1 small clove garlic, minced",
    "salt and freshly ground black pepper to taste",
    "7 cups mixed salad greens",
    "1 tablespoon minced fresh parsley",
    "1 teaspoon minced fresh chives",
    "1 teaspoon minced fresh tarragon"
  ],
  "steps": [
    {
      "text": "Whisk together white wine vinegar and mustard in a small bowl. Slowly drizzle in olive oil while whisking. Mix in garlic, salt, and pepper. Chill vinaigrette in the refrigerator until ready to toss with the salad greens.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash and thoroughly dry mixed salad greens. Place in a large, chilled salad bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir dressing, and drizzle some of it on the greens and toss. Add enough dressing to coat the leaves, but not puddle in the bottom of the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle fresh parsley, chives, and tarragon over the salad and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
