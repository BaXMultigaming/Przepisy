  "ingredients": [
    "0.5 cup butter, softened",
    "0.25 cup sweet potato puree",
    "0.5 cup white sugar",
    "1 cup packed brown sugar",
    "0.5 cup orange juice",
    "4 egg whites",
    "2 teaspoons vanilla extract",
    "1 teaspoon baking soda",
    "2 teaspoons hot water",
    "3 cups all-purpose flour",
    "2 cups semisweet chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, sweet potato, white sugar, brown sugar, and orange juice with an electric mixer in a large bowl until smooth. Add eggs whites one at a time, allowing each egg to blend into butter mixture before adding the next. Beat in vanilla extract. Dissolve baking soda in hot water in a small bowl. Add to sweet potato batter. Stir in flour, chocolate chips, and walnuts. Roll dough into walnut-sized balls and place 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until edges are nicely browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
