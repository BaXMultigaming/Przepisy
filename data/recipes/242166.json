  "ingredients": [
    "1 (16 ounce) package fudge stripe cookies",
    "1 cup buttermilk",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "3 bananas, cut into 1/2-inch pieces",
    "1 (8 ounce) container frozen whipped topping (such as Cool Whip®), thawed",
    "1 (8 ounce) can mandarin oranges, drained"
  ],
  "steps": [
    {
      "text": "Break 2/3 of the fudge stripe cookies into quarters.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat buttermilk and pudding mix together in a large bowl until slightly thickened. Stir quartered cookies into pudding. Fold bananas, whipped topping, and oranges into pudding mixture. Top with remaining whole cookies.",
      "section": null,
