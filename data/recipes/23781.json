  "ingredients": [
    "2.5 cups sliced canned beets, juice reserved",
    "0.5 cup apple cider vinegar",
    "2 tablespoons sugar",
    "2 whole cloves",
    "3 black peppercorns",
    "1 bay leaf",
    "0.5 teaspoon salt",
    "1 small onion, sliced"
