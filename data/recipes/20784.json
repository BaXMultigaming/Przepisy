  "title": "Ice Cream Cake",
  "description": "This homemade ice cream cake has a generous layer of cake and ice cream. Top with fudge topping or crushed chocolate cookies for a delicious dessert.",
  "authors": [
    "winnie the pooh"
  ],
  "date_published": "2000-03-20T00:01:51-05:00",
