  "ingredients": [
    "1 cup gluten-free all purpose baking flour*",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup raw sugar",
    "0.5 cup So Delicious® Dairy Free Cashew Milk",
    "0.5 cup vegetable or coconut oil",
    "5 tablespoons lemon juice",
    "1 tablespoon lemon zest",
    "1 cup raw unsalted cashew pieces, roughly chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Lightly oil a 9-inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the dry ingredients, except for the cashews, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all the liquids together (cashew milk, vegetable oil, lemon juice, lemon zest).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the wet ingredients into the dry and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with the cashews all over the cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in a preheated 350-degree oven and bake for 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow to cool for about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
