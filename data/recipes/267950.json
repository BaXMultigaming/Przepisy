  "ingredients": [
    "cooking spray (such as Baker's Joy®)",
    "2 large ripe bananas",
    "0.33333334326744 cup white sugar",
    "2 eggs",
    "0.25 cup whole milk",
    "0.5 (3 ounce) package strawberry-flavored gelatin (such as Jell-O®)",
    "2 cups whole wheat flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a loaf pan with cooking spray; dust with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash bananas in a large bowl with a fork. Add sugar and mix until smooth. Add eggs, milk, and strawberry gelatin; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine whole wheat flour, baking powder, and salt in a separate bowl. Add 1/2 of the flour mixture to the egg mixture; mix until moist. Add remaining flour mixture and mix until batter is just moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter in the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
