  "title": "Struffoli",
  "description": "These crispy Italian struffoli balls are coated in a warm honey glaze and decorated with colorful sprinkles for a festive sweet and sticky treat.",
  "authors": [
    "Jess"
  ],
  "date_published": "2020-06-19T00:01:53-04:00",
