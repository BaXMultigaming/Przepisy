  "ingredients": [
    "1 cup mayonnaise",
    "0.5 cup light corn syrup",
    "0.125 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1.5 teaspoons soy sauce",
    "0.5 teaspoon ground ginger",
    "1 pinch white sugar"
  ],
  "steps": [
    {
      "text": "In a food processor or blender, mix the mayonnaise, corn syrup, salt, and pepper until blended. Mix in the soy sauce, ginger, and sugar. Blend well and adjust seasoning to taste. Chill 2 hours to blend flavors.",
