  "ingredients": [
    "1 cup all-purpose flour",
    "0.75 cup white sugar",
    "2 tablespoons unsweetened cocoa powder",
    "1.5 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.5 cup 2% low-fat milk",
    "2 tablespoons vegetable oil",
    "1 teaspoon vanilla extract",
    "1 cup firmly packed brown sugar",
    "0.25 cup unsweetened cocoa powder",
    "1.75 cups boiling water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, white sugar, cocoa powder, baking powder, and salt in a 9-inch square baking pan; stir well. Add milk, oil, and vanilla extract; stir until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together brown sugar and cocoa powder in a small bowl; sprinkle over batter. Pour boiling water over batter but do not stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake springs back when lightly touched in the center, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
