  "ingredients": [
    "2 (8.5 ounce) packages cornbread mix",
    "2 tablespoons brown sugar",
    "2 eggs",
    "1.5 cups milk",
    "1 cup grated Cheddar cheese",
    "9 hot dogs, cut in half"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cornbread mix and brown sugar together in a large bowl. Whisk eggs and milk in a small bowl until smooth. Fold eggs and cheese into cornbread mixture until moistened. Spoon mixture into muffin tins about 2/3 full. Add 1 hot dog half to each muffin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 14 to 18 minutes.",
      "section": null,
      "name": null,
