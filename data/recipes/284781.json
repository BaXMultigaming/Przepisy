  "ingredients": [
    "0.5 tablespoon unsalted butter",
    "1 large egg",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in an 8-inch nonstick skillet or seasoned cast iron skillet over medium heat. Crack the egg into the skillet and cook undisturbed until the egg white is firm and set, but the yolk is still runny and intact, about 1 1/2 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently flip the egg with a spatula being careful not to break the yolk. Cook for another 15 to 20 seconds or to your desired doneness, being sure that the yolk remains liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the egg to a plate, season with salt and pepper, and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
