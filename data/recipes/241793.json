  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 bunch kale",
    "2 tablespoons olive oil",
    "1 tablespoon sriracha hot sauce",
    "2 teaspoons lime juice",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash kale; remove and discard ribs. Dry leaves thoroughly, using a salad spinner if available, making sure no moisture remains. Tear leaves into 2- to 3-inch pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, Sriracha, lime juice, and salt together in a large bowl. Add kale; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide kale between the prepared baking sheets, making sure no pieces overlap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes, flip any pieces getting too browned on the bottom; continue baking until kale is crisp, about 15 minute more. Cool kale chips before serving, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
