  "ingredients": [
    "1 pound lean ground beef",
    "3 tablespoons bold taco seasoning",
    "6 large eggs",
    "0.33 cup heavy cream",
    "0.25 teaspoon granulated garlic",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9-inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break up ground beef into a 10-inch skillet over medium heat; sprinkle on bold taco seasoning. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Place beef in the bottom of the prepared pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, cream, and granulated garlic together in a bowl until well combined; pour eggs over beef. Sprinkle grated Cheddar cheese evenly over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the center of the preheated oven until the eggs are set and cheese is melted, about 30 minutes. Remove from the oven and place on a cooling rack for about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
