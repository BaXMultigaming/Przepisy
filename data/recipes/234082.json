  "ingredients": [
    "0.75 cup butter",
    "1 white onion, diced",
    "1 green bell pepper, diced",
    "1 (8 ounce) package sliced fresh mushrooms",
    "0.66666668653488 cup all-purpose flour",
    "6 cups milk",
    "1 (10.5 ounce) can beef consomme",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 (8 ounce) package provolone cheese, diced",
    "0.75 pound sliced roast beef, chopped"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C-9A2S6uDEy3Lztuo4M5wQNq4Kw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234082-philly-cheese-steak-soup-VAT-step-01-29a9443baea342ab851e8b9e92d889b0.jpg"
      ],
      "image": "assets/images/234082/step_01.webp"
    },
    {
      "text": "Melt butter in a large, heavy-bottomed pot or Dutch oven over medium heat. Add onion, bell pepper, and mushrooms; cook and stir until tender, about 5 minutes. Add flour; cook and stir until flour golden, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NoLLf3bALa87o5qXXPEBg9nsv5c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234082-philly-cheese-steak-soup-VAT-step-02-a233b2e495244ccdb5bba16312e055da.jpg"
      ],
      "image": "assets/images/234082/step_02.webp"
    },
    {
      "text": "Gradually whisk in milk; bring to a simmer. Cook until thickened, stirring often, about 5 minutes. Reduce heat to medium-low. Add beef consommé; season soup with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4M4PVlvGDRJVm_Tc8e5mYYQxBug=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234082-philly-cheese-steak-soup-VAT-step-03-10b5f4c52e194661919293df2cf3771d.jpg"
      ],
      "image": "assets/images/234082/step_03.webp"
    },
    {
      "text": "Slowly stir in provolone cheese until melted, 3 to 5 minutes. Off heat, stir in roast beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WUO90fChzbg1PadttQ_HArBHF8A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234082-philly-cheese-steak-soup-VAT-step-04-a537f2ff49f7463fb3b814bb85578df8.jpg"
