  "ingredients": [
    "2 quarts oil for frying",
    "2.25 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon nutmeg",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon salt",
    "0.5 cup white sugar",
    "2 large eggs",
    "0.25 cup firmly packed light brown sugar",
    "2 tablespoons vegetable oil",
    "0.25 cup milk",
    "1 cup unsweetened applesauce",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Heat 2 quarts oil in a deep fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, sift flour, baking powder, baking soda, cinnamon, nutmeg, cloves, and salt together onto a piece of waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, eggs, and brown sugar together in a bowl with an electric mixer on medium speed until fluffy; beat in 2 tablespoons vegetable oil. Stir in flour mixture, alternating with milk, beginning and ending with flour mixture, until well blended. Stir in applesauce and vanilla extract until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully drop batter by level tablespoons, 3 or 4 at a time, into hot oil; do not overcrowd deep fryer or oil may overflow. Fry, flipping once with tongs, until golden, about 3 minutes. Transfer to paper towels to drain. Cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
