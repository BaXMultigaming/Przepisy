  "ingredients": [
    "2 cups shredded Cheddar cheese",
    "1 tablespoon all-purpose flour",
    "0.25 cup heavy cream",
    "4 slices bacon",
    "2 cups mayonnaise",
    "1.5 cups milk"
  ],
  "steps": [
    {
      "text": "In a medium saucepan over low heat, whisk together the cheese, flour and cream until melted and sauce-like. Remove from heat and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, whisk together cooled cheese sauce, bacon, mayonnaise and milk until evenly blended. Serve over fresh salads.",
      "section": null,
