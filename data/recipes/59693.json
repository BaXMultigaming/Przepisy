  "ingredients": [
    "14 slices bacon",
    "1.25 pounds imitation crabmeat, flaked",
    "1 (16 ounce) package frozen green peas",
    "0.75 cup mayonnaise, or to taste",
    "2 teaspoons onion powder",
    "1.5 cups diced tomatoes"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown and crisp. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the imitation crab, bacon and peas. Stir onion powder into mayonnaise, and then stir into the crab mixture until well blended. Cover and refrigerate. Top with diced tomatoes before serving.",
      "section": null,
