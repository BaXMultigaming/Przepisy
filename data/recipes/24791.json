  "ingredients": [
    "5.5 pounds chicken wings, split and tips discarded",
    "1 (12 fluid ounce) can or bottle chile sauce",
    "0.25 cup fresh lemon juice",
    "0.25 cup molasses",
    "2 tablespoons Worcestershire sauce",
    "3 drops hot pepper sauce",
    "1 tablespoon salsa",
    "2.5 teaspoons chili powder",
    "1 teaspoon garlic powder",
    "2 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Place chicken in slow cooker. In a medium bowl combine the chile sauce, lemon juice, molasses, Worcestershire sauce, hot pepper sauce, salsa, chili powder, garlic powder and salt. Mix together and pour mixture over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in slow cooker on Medium Low setting for 5 hours.",
