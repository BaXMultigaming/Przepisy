  "ingredients": [
    "cooking spray",
    "2.6666667461395 cups white sugar",
    "0.66666668653488 cup butter-flavored shortening",
    "4 large eggs",
    "1.75 cups applesauce",
    "0.66666668653488 cup water",
    "1 teaspoon baking soda",
    "1 teaspoon vanilla extract",
    "3.3333332538605 cups all-purpose flour",
    "2 teaspoons ground cinnamon",
    "1.5 teaspoons salt",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground cloves",
    "1.5 cups raisins",
    "0.66666668653488 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a fluted cake pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and shortening together in a bowl using an electric mixer until smooth and creamy; beat in eggs until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine applesauce, water, and baking soda in a saucepan over medium heat; stir until heated through, about 2 minutes. Stir applesauce mixture into shortening mixture; add vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cinnamon, salt, baking powder, and ground cloves together in a bowl. Gradually stir applesauce mixture into flour mixture until just combined. Fold in raisins and walnuts. Pour into prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and a toothpick inserted in the center of the cake comes out clean, about 1 hour. Cool in the pan for 10 minutes and transfer cake to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
