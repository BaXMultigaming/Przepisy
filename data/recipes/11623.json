  "ingredients": [
    "nonstick cooking spray",
    "1 pound brown sugar",
    "4 eggs",
    "2 cups all-purpose flour",
    "1 cup chopped pecans",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F ( 200 degrees C ). Coat a 15x10x1-inch jellyroll pan with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and eggs in a heavy saucepan; cook over medium heat, stirring constantly, until sugar is dissolved. Off heat, stir in flour, pecans, vanilla, and salt until well combined; transfer mixture to the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Cool completely on a wire rack, then cut into 36 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
