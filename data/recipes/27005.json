  "ingredients": [
    "0.75 pound cooked turkey meat",
    "2 stalks celery",
    "2 green onions",
    "0.5 red bell pepper",
    "3 tablespoons mayonnaise",
    "2 tablespoons prepared Dijon-style mustard",
    "1 tablespoon cider vinegar",
    "1 teaspoon white sugar",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
