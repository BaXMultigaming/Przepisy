  "ingredients": [
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup whole milk",
    "1 cup shredded Cheddar cheese",
    "6 tablespoons butter, melted",
    "0.5 cup frozen chopped spinach - thawed, drained and squeezed dry",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 12-cup muffin tin or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk, Cheddar, melted butter, spinach, and egg together in a large mixing bowl until evenly blended. Slowly stir in flour mixture to form a batter. Spoon about 2 tablespoons into each prepared muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
