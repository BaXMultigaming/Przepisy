  "ingredients": [
    "2.5 quarts water",
    "1 pound dried brown lentils",
    "1 cup baby spinach, or to taste",
    "0.5 cup diced onion",
    "0.5 cup diced celery",
    "0.5 cup diced carrots",
    "3 cloves garlic, minced",
    "2 teaspoons salt",
    "1 teaspoon onion powder",
    "0.25 teaspoon ground black pepper",
    "3 dashes liquid aminos (such as Bragg®)"
  ],
  "steps": [
    {
      "text": "Place water, lentils, spinach, onion, celery, carrots, garlic, salt, onion powder, pepper, and liquid aminos in a large soup pot. Bring to a rapid boil, then turn down to a simmer. Cover and cook until lentils are done but not mushy, 25 to 30 minutes. Taste and adjust seasoning.",
