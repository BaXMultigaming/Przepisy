  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "1 cup pumpkin puree",
    "0.5 cup confectioners' sugar",
    "2 teaspoons pumpkin pie spice",
    "1 (8 ounce) container frozen whipped topping (such as Cool Whip®), thawed"
  ],
  "steps": [
    {
      "text": "Beat cream cheese in a large bowl with an electric mixer until smooth; beat in pumpkin purée until well combined. Beat in confectioners' sugar and pumpkin pie spice until evenly mixed. Fold in whipped topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl with plastic wrap and refrigerate for flavors to blend, about 2 hours.",
      "section": null,
      "name": null,
