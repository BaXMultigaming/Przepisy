  "ingredients": [
    "3 cups water",
    "2 tablespoons chicken bouillon granules",
    "2 bunches broccoli, chopped",
    "0.5 onion, minced",
    "2 cups milk",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup margarine",
    "5 tablespoons all-purpose flour",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Bring water and chicken bouillon granules to a boil in a large pot. Add broccoli and onion; cook at a boil until tender, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, cream cheese, margarine, and flour in a second large pot over medium heat. Cook and stir until margarine melts and mixture begins to thicken, about 5 minutes. Stir in Cheddar cheese until melted completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour broccoli mixture into cheese mixture; stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
