  "ingredients": [
    "cooking spray",
    "2 cups gluten-free all-purpose flour",
    "1 cup white sugar",
    "1 teaspoon baking powder",
    "0.5 cup butter, softened",
    "3 eggs",
    "0.66666668653488 cup milk",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9-inch round cake pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, and baking powder in a bowl until well mixed. Add butter; beat with an electric mixer until creamy. Add eggs one at a time, beating well after each addition. Pour in milk and vanilla extract; beat until creamy, 1 to 2 minutes. Pour batter into the prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
