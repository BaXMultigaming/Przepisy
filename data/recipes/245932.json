  "ingredients": [
    "0.25 cup olive oil",
    "2 cloves garlic, crushed",
    "1 (14 ounce) package Hillshire Farm® Smoked Sausage, diagonally cut into 1/4-inch slices",
    "1 large red bell pepper, sliced thin",
    "1 small yellow onion, sliced thin",
    "1 (10 ounce) package frozen broccoli, thawed",
    "0.5 cup chicken broth or water",
    "0.5 cup tomato sauce",
    "2 cups instant rice",
    "0.5 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Heat olive oil and crushed garlic in a large skillet. Stir in smoked sausage slices and cook until browned on all sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pepper, onion, broccoli, chicken broth, and tomato sauce. Simmer until vegetables are tender and the liquid is absorbed, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the meantime, cook rice according to package instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cooked rice into the skillet, sprinkle with cheese, and serve.",
