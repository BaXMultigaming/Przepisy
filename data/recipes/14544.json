  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "0.5 (16 ounce) bottle Italian-style salad dressing",
    "0.25 teaspoon lemon pepper",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Rinse chicken and pat dry. Place in a shallow glass bowl and pour salad dressing over it. Cover and refrigerate for at least 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil grill and preheat to medium high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken breasts from marinade. Season with lemon pepper and salt to taste. Grill over medium high heat for 10 to 15 minutes on each side, or until chicken is cooked through and juices run clear.",
