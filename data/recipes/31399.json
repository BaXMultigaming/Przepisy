  "ingredients": [
    "4 matzo crackers, crushed",
    "3 eggs, beaten",
    "0.33333298563957 cup applesauce",
    "0.25 cup white sugar",
    "1 teaspoon salt, divided",
    "0.5 teaspoon lemon juice",
    "3 Granny Smith apples - cored, peeled and chopped",
    "0.5 cup dried cranberries",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place crushed matzo crackers in a medium bowl and add enough water to cover. Let stand for 2 minutes, then drain off excess water. Do not squeeze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add beaten eggs, applesauce, 1/4 cup sugar, salt, and lemon juice to soaked crackers; stir to combine. Mix in apples and dried cranberries until incorporated. Spread evenly into a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together remaining 1/4 cup sugar and cinnamon in a small bowl until well combined; sprinkle over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is golden and apples are soft, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
