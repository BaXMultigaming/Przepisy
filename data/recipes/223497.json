  "ingredients": [
    "1 cup ice cubes",
    "1 cup cubed, seeded watermelon",
    "0.5 cup coconut water (liquid from inside coconut)",
    "0.25 cup cherries, pitted",
    "1 teaspoon granular sucralose sweetener (such as Splenda®)"
  ],
  "steps": [
    {
      "text": "Place ice in a blender; add watermelon, coconut water, cherries, and sweetener. Cover blender; blend until slushy, about 1 minute. Pour into 2 glasses to serve.",
