  "title": "Nat's Vegan Strawberry Muffins",
  "description": "Use up your summertime strawberry harvest in these easy vegan muffins made with applesauce, walnuts, and flaxseed meal.",
  "authors": [
    "Natalie"
  ],
  "date_published": "2020-04-03T17:29:25-04:00",
