  "ingredients": [
    "1 (9 inch) pie crust pastry",
    "2 cups eggnog",
    "1 cup white sugar",
    "0.25 cup cornstarch",
    "2 eggs",
    "2 egg whites",
    "1 tablespoon vanilla extract, or to taste",
    "1 tablespoon ground nutmeg, or to taste",
    "1 tablespoon ground cinnamon, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Press pie crust into a 9-inch pie dish and cut excess crust from edges; fill with rice or pie weights.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggnog, sugar, cornstarch, eggs, egg whites, vanilla extract, nutmeg, and cinnamon together in a bowl until smooth; pour into crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until pie is set in the middle, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
