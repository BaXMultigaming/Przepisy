  "ingredients": [
    "2 large leeks",
    "2 tablespoons unsalted butter",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Remove the root ends and dark green tops of the leeks and discard. Cut leeks into 1/2 inch slices. Place in a bowl of cold water and let sit for 5 minutes. The leek slices will float to the top while any sand will sink to the bottom. Using a slotted spoon, transfer leek slices to a colander and shake off excess water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skilled over medium heat. Add leek slices and cook undisturbed for 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flip slices over and season with salt and pepper. Cook for 8 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
