  "ingredients": [
    "cooking spray (such as Pam®)",
    "2 cups diced cooked ham",
    "2 tablespoons butter, or as needed",
    "7 slices bread, crusts removed",
    "0.5 pound American cheese, cubed",
    "3 cups milk",
    "6 eggs, beaten",
    "0.75 teaspoon dry mustard",
    "0.75 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lA_H3KJN3P_WSwMSIMweODs9Q8I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_229517_ChristmasMorningEggCasserole_Shot1_12123-468ad94eaf5043a4b72c53427410b29b.jpg"
      ],
