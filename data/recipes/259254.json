  "ingredients": [
    "1 cup heavy whipping cream",
    "0.5 (8 ounce) container mascarpone cheese",
    "1 teaspoon vanilla extract, or more to taste",
    "2 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Beat together cream, mascarpone, and vanilla in a large bowl with an electric mixer until smooth and creamy. Add sugar gradually, mixing continuously until frosting is smooth and stiff peaks form, about 5 minutes. Use immediately or store covered in the refrigerator.",
