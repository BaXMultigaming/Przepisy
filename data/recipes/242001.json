  "ingredients": [
    "vegetable oil cooking spray",
    "1.6666667461395 cups all-purpose flour",
    "2.5 teaspoons baking powder",
    "1 tablespoon stevia sugar substitute",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon sea salt",
    "0.25 teaspoon nutmeg",
    "0.66666668653488 cup skim milk",
    "1 egg, lightly beaten",
    "0.25 cup reduced-calorie margarine, melted",
    "1 cup minced apple"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Prepare 12 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, stevia, cinnamon, sea salt, and nutmeg together in a large bowl. Beat skim milk, egg, and margarine together in a separate bowl; add to flour mixture and stir just until the dry mixture is moistened. Gently fold minced apple through the batter. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until lightly browned on the tops, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
