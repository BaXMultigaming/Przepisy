  "title": "Lebanese Mountain Bread",
  "description": "This Lebanese mountain flatbread dough is stretched very thin and quickly cooked in a hot cast iron skillet. Perfect for wraps or dipping in hummus.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2017-07-12T00:33:12-04:00",
  "date_modified": "2026-03-02T05:18:18-05:00",
