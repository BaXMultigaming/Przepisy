  "ingredients": [
    "1 pound frozen skinless, boneless chicken breast halves",
    "1 (1 ounce) packet taco seasoning mix",
    "0.5 cup salsa",
    "0.5 cup low-sodium chicken broth"
  ],
  "steps": [
    {
      "text": "Place chicken breasts in a multi-functional cooker (such as Instant Pot). Sprinkle all sides with taco seasoning. Pour salsa and chicken broth on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Close and lock the lid. Select Poultry setting; set the timer for 15 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer’s instructions, about 20 minutes. Unlock and remove the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred chicken and serve as desired.",
