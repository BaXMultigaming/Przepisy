  "ingredients": [
    "16 cups sliced cucumbers",
    "1 onion, sliced",
    "2 tablespoons salt",
    "1.5 cups white sugar",
    "0.5 cup apple cider vinegar"
  ],
  "steps": [
    {
      "text": "Toss cucumbers, onion, and salt together in a bowl; let stand 2 hours. Drain thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar and vinegar together in a saucepan over medium-low heat; cook and stir until sugar dissolves, 5 to 10 minutes. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour vinegar mixture over cucumbers and onion; toss to coat. Transfer to large resealable plastic freezer bags; store in the freezer.",
