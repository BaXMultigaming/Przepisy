  "ingredients": [
    "1.5 (8 ounce) packages cream cheese, softened",
    "1 small Vidalia or other sweet onion, minced",
    "1 (2.5 ounce) package thinly sliced smoked beef, chopped",
    "1 (2.25 ounce) can pimento-stuffed green olives, chopped",
    "2 dashes Worcestershire sauce, or to taste",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Combine cream cheese, onion, beef, olives, and Worcestershire sauce in a bowl until evenly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-JCQffe8W_YimkED62A-naL7WX0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/155754-traditional-christmas-cheese-ball-VAT-step-01-fd489040285045a092e9ab9e458a3f66.jpg"
      ],
      "image": "assets/images/155754/step_01.webp"
    },
    {
      "text": "Form mixture into a semi-ball shape in the bowl. Cover bowl with plastic wrap; refrigerate until firm, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BpWpYjHaAgNoU1xWLFkKDJ_lRY0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/155754-traditional-christmas-cheese-ball-VAT-step-02-c973e70ffad6498f833b4c6eb9650e4d.jpg"
      ],
      "image": "assets/images/155754/step_02.webp"
    },
    {
      "text": "Place a large sheet of waxed paper on a flat surface; sprinkle with walnuts. Roll cheese ball in walnuts until completely covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2x-3ZEJskTEMpbrXNe-_VsgKzVQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/155754-traditional-christmas-cheese-ball-VAT-step-03-d191fa38d133495ea20b8fa4413da323.jpg"
      ],
      "image": "assets/images/155754/step_03.webp"
    },
    {
      "text": "Transfer to a serving plate or rewrap with waxed paper and refrigerate until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p50zHQmHzBiuFt1NFhw7b86rf2o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/155754-traditional-christmas-cheese-ball-VAT-step-04-36fcdb71cbeb4fa792cc43353ef37050.jpg"
