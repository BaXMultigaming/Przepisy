  "ingredients": [
    "1 tablespoon olive oil",
    "1 tablespoon butter",
    "0.5 sweet yellow onion (such as Vidalia®), thinly sliced",
    "4 patty pan squash, sliced to 1/2-inch-thick pieces",
    "3 cloves garlic, crushed, or more to taste",
    "1 dash lemon pepper",
    "1.5 cups packed fresh spinach",
    "0.25 cup chopped fresh parsley",
    "1 tablespoon chopped fresh basil",
    "0.5 lemon, juiced",
    "1.5 teaspoons grated Parmesan cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WyBIhv38fM_aIhKOVo4eqTM6smQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-Sauteed-Patty-Pan-Squash_244465_step-1-8a00d2e8a1e748f1b7ee00aefbdb2d57.jpg"
      ],
      "image": "assets/images/244465/step_01.webp"
    },
    {
      "text": "Heat olive oil and butter in a skillet over medium-high heat until foaming, 1 to 2 minutes. Add onion and sauté until tender and translucent, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/86Wk8Pdc2j1GyUt6yG-jySDbnlY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-Sauteed-Patty-Pan-Squash_244465_step-2-37b55be2952b436ea3216c6b2484478e.jpg"
      ],
      "image": "assets/images/244465/step_02.webp"
    },
    {
      "text": "Add squash and garlic; season with lemon pepper. Sauté mixture until squash is easily pierced with a fork, 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gYM5u_qFNbQdVgpfKZzlcrzBLgI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-Sauteed-Patty-Pan-Squash_244465_step-3-b083ff3f5baf4ec9af91ecdfc0db48d2.jpg"
      ],
      "image": "assets/images/244465/step_03.webp"
    },
    {
      "text": "Mix spinach, parsley, and basil into squash mixture; sauté until spinach wilts, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5EyhGPGpB6InUjR76gNpHjnx73U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-Sauteed-Patty-Pan-Squash_244465_step-4-57e590b9316344018e890da6d2b3c4e7.jpg"
      ],
      "image": "assets/images/244465/step_04.webp"
    },
    {
      "text": "Squeeze lemon juice over mixture and sprinkle in Parmesan cheese; stir well. Season mixture with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FJkBVQs3fwaEBJygoeBYRTKHX6k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-Sauteed-Patty-Pan-Squash_244465_step-5-9d375a2551ae438381ea3f2897d804ca.jpg"
