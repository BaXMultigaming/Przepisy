  "ingredients": [
    "cooking spray",
    "2.25 cups all-purpose flour",
    "1 cup white sugar",
    "1 cup unsalted butter, softened",
    "1 large egg",
    "0.75 cup raspberry jam"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat an 8-inch square cake pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat flour, sugar, butter, and egg in a large bowl with an electric mixer until mixture resembles coarse crumbs. Set aside 2 cups crumb mixture; firmly press remaining mixture into bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread jam over crumb mixture to within ½-inch from edges; sprinkle reserved 2 cups crumb mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden brown, 40 to 50 minutes. Cool completely before cutting into 25 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
