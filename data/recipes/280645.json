  "ingredients": [
    "1.25 cups rice vinegar",
    "1 teaspoon white sugar",
    "1.5 cups chopped strawberries",
    "1 pint jar"
  ],
  "steps": [
    {
      "text": "Heat vinegar and sugar in a small saucepan to just below boiling. Stir until sugar is dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place strawberries in a sterilized pint jar and lightly press with a muddler or the back of a spoon to release a bit of juice. Pour in vinegar and wipe the rim with a clean cloth. Seal and let sit in a cool, dark place until flavors develop, about 3 days. Shake jar gently once a day. Infuse longer for a more concentrated flavor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain the infused vinegar into a sterile bottle or jar through a cheesecloth or coffee filter. Seal.",
      "section": null,
