  "ingredients": [
    "2 quarts blackberries",
    "0.5 cup white sugar",
    "3 tablespoons quick-cooking tapioca",
    "2 cups biscuit baking mix",
    "0.75 cup milk",
    "0.5 cup water",
    "1 tablespoon butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine blackberries, ½ cup sugar, and tapioca in a bowl; pour into the prepared baking dish. Combine baking mix and milk in a separate bowl; drop batter by the spoonful over cobbler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, boil water and remaining ½ cup sugar in a small saucepan over high heat; stir in butter and vanilla extract. Reduce heat to medium-low; simmer syrup 5 minutes. Drizzle vanilla syrup over cobbler; continue baking in the oven until syrup evaporates, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
