  "ingredients": [
    "0.25 cup unsalted butter, melted",
    "2 teaspoons vanilla extract",
    "0.25 teaspoon salt",
    "1 cup brown sugar",
    "1 cup white sugar",
    "4 pounds sweet potatoes, peeled and sliced",
    "2 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Combine butter, vanilla extract, and salt in a bowl. Mix brown sugar and white sugar together in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer potatoes and sugar mixture in the bottom of a slow cooker. Pour the butter mixture over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until tender, about 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove 1/3 of the cooking liquid from the slow cooker and pour into a saucepan; whisk in cornstarch. Bring to a boil and cook until thick, about 5 minutes. Pour over potatoes and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
