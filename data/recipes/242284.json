  "ingredients": [
    "1.5 cups white sugar",
    "1 cup soy sauce",
    "1 cup water",
    "2 tablespoons ground ginger",
    "3 cloves garlic, diced",
    "0.75 teaspoon ground cinnamon",
    "0.25 teaspoon ground black pepper",
    "1.5 pounds chicken drumettes"
  ],
  "steps": [
    {
      "text": "Combine sugar, soy sauce, and water in an 8-quart pot; stir until sugar is dissolved. Turn heat to medium-high; add ginger, garlic, cinnamon, and black pepper and stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring mixture to a boil and add chicken drumettes. Once mixture begins to boil again, reduce heat to medium-low, and partially cover pot with a lid tilted to allow steam to escape. Simmer until chicken is no longer pink in the center and teriyaki sauce is thickened, at least 1 hour.",
      "section": null,
