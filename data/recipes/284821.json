  "ingredients": [
    "2 pounds ground chicken",
    "1 large egg, beaten",
    "1 tablespoon vegetable oil",
    "1.5 teaspoons blackened seasoning",
    "1 teaspoon liquid smoke flavoring",
    "1 teaspoon garlic powder",
    "6 leaves fresh basil, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground chicken, egg, oil, blackened seasoning, liquid smoke flavoring, garlic powder, and basil in a large bowl. Mix to combine, but be careful not to over handle the ground chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a 1-cup measuring cup to form and portion 4 patties. Place into a cast iron skillet. Press patties with the back of the measuring cup to form burgers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through and no longer pink in the centers, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
