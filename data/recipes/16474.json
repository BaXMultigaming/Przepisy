  "ingredients": [
    "2 tablespoons water",
    "1 teaspoon cornstarch",
    "2 tablespoons olive oil",
    "1 tablespoon soy sauce",
    "3 tablespoons vegetable oil",
    "1 red bell pepper, chopped",
    "1 zucchini, sliced",
    "1 carrot, sliced",
    "1.3333300352097 cups bean sprouts",
    "0.66666698455811 cup fresh corn kernels",
    "4 green onions, sliced",
    "1 clove crushed garlic"
  ],
  "steps": [
    {
      "text": "Whisk together water and cornstarch in a small bowl. Mix in olive oil and soy sauce until combined; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a skillet or wok over medium-high heat. Sauté bell pepper, zucchini, and carrot in hot oil for about 5 minutes. Stir in bean sprouts, corn, green onions, and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in soy sauce mixture. Cook and stir until vegetables are tender but crisp, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
