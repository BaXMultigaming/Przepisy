  "ingredients": [
    "2 thin slices Black Forest ham, or to taste",
    "0.25 cup baby spinach, or to taste",
    "1 (6 inch) whole wheat sandwich round, split",
    "1 cup mixed salad greens, or to taste",
    "2 tablespoons salad dressing, or to taste",
    "2 tablespoons cream cheese, softened",
    "2 tablespoons sour cream",
    "2 teaspoons white sugar",
    "0.125 teaspoon vanilla extract",
    "1 cup seedless green grapes",
    "1 tablespoon chopped pecans",
    "1 teaspoon brown sugar"
  ],
  "steps": [
    {
      "text": "Layer ham and spinach on sandwich round.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss salad greens and dressing together in a small bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, sour cream, white sugar, and vanilla in a small bowl; add grapes and toss until evenly coated. Sprinkle pecans and brown sugar on top; toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sandwich, green salad, and grape salad in the tiffin (bento) box compartments.",
