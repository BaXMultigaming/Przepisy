  "ingredients": [
    "1 cup dates, pitted and chopped",
    "1 cup boiling water",
    "1.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "3 teaspoons unsweetened cocoa powder",
    "1 cup white sugar",
    "0.5 cup butter",
    "2 eggs",
    "0.5 cup chopped walnuts",
    "1 cup semisweet chocolate chips, divided"
  ],
  "steps": [
    {
      "text": "In a small bowl, combine dates with boiling water. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix flour, soda, salt, and cocoa. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar until light and fluffy. Add eggs. Add flour mixture alternating with cooled date mixture. Fold in chopped nuts and 1/2 cup of chocolate chips into mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter into prepared pan. Sprinkle remaining 1/2 cup of chocolate chips over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 to 60 minutes, or until a toothpick inserted into the middle of the cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
