  "ingredients": [
    "2 (15.5 ounce) cans garbanzo beans, drained",
    "0.5 cup water",
    "0.25 cup tahini (sesame-seed paste)",
    "0.25 cup fresh lemon juice",
    "2 tablespoons olive oil",
    "1 canned chipotle pepper in adobo sauce",
    "2 cloves garlic",
    "1.5 teaspoons cumin",
    "1 (7 ounce) jar roasted red bell peppers, drained",
    "0.5 cup chopped cilantro",
    "6 oil-packed sun-dried tomatoes, drained",
    "0.5 teaspoon salt",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Blend garbanzo beans, water, tahini, lemon juice, olive oil, chipotle pepper, garlic, and cumin in a food processor until smooth. Add red peppers, cilantro, sun-dried tomatoes, salt, and pepper; pulse to coarsely chop and blend. Transfer to a serving bowl.",
