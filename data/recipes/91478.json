  "ingredients": [
    "1 (5 ounce) can light tuna in water, drained",
    "1 egg",
    "0.66666668653488 cup quick-cooking oats",
    "3 tablespoons barbeque sauce",
    "3 tablespoons chopped green onion",
    "0.5 teaspoon hot pepper sauce, or to taste",
    "0.5 teaspoon dried savory",
    "1 pinch salt",
    "2 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "In a medium bowl, stir together the tuna, egg and oats until blended. Mix in the barbeque sauce, green onion, hot pepper sauce, savory, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oil in a large skillet over medium heat. Spoon tablespoonfuls of the tuna mixture into the pan, and flatten slightly. Smaller patties hold together better. Cook until browned on each side, about 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
