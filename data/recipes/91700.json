  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix with pudding",
    "0.33333334326744 cup butter or margarine, softened",
    "3 eggs, divided",
    "1 cup chopped pecans, toasted",
    "1 cup butterscotch-flavored chips",
    "1 (14 ounce) can EAGLE BRAND® Sweetened Condensed Milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. In large bowl, beat cake mix, butter and 1 egg at medium speed until crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press evenly into greased 13x9-inch baking pan. Bake 15 minutes. Remove from oven; sprinkle with pecans and butterscotch chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In small bowl, beat sweetened condensed milk, remaining 2 eggs and vanilla. Pour evenly over chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25 to 30 minutes longer or until center is set. Cool thoroughly. Cut into bars. Store covered at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
