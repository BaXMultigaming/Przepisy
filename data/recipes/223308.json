  "ingredients": [
    "0.75 cup butter, softened",
    "0.75 cup peanut butter",
    "0.75 cup white sugar",
    "0.75 cup brown sugar",
    "1.5 cups all-purpose flour",
    "1.5 cups rolled oats",
    "1.5 teaspoons vanilla extract",
    "2 eggs",
    "2 teaspoons salt",
    "0.5 cup peanut butter, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease a jelly-roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, 3/4 cup peanut butter, white sugar, and brown sugar together in a large bowl until creamy. Add flour, oats, vanilla extract, eggs, and salt; stir until just mixed. Spread batter into the prepared jelly-roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 20 minutes. Cool brownies in the pan for 10 to 15 minutes. Spread 1/2 cup peanut butter on top of brownies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
