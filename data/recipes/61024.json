  "ingredients": [
    "1.5 cups water",
    "0.33333334326744 cup rice vinegar",
    "0.25 cup lemon juice",
    "2.5 tablespoons soy sauce",
    "2 tablespoons orange juice",
    "1 cup packed brown sugar",
    "2 tablespoons chopped green onion",
    "1 tablespoon grated orange zest",
    "0.5 teaspoon minced fresh ginger root",
    "0.5 teaspoon minced garlic",
    "0.25 teaspoon red pepper flakes",
    "3 tablespoons cornstarch",
    "2 tablespoons water",
    "2 large skinless, boneless chicken breasts, cut into 1/2-inch cubes",
    "1 cup all-purpose flour",
    "0.25 teaspoon salt",
    "0.25 teaspoon pepper",
    "3 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VqXGXnL5Wo9sTh3bgokhjlhZ7z8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/61024-asian-orange-chicken-DDMFS-step-01-0234-b1a164125a9843259b5f0c3167957a10.jpg"
      ],
      "image": "assets/images/61024/step_01.webp"
    },
    {
      "text": "Combine water, rice vinegar, lemon juice, soy sauce, and orange juice for sauce into a saucepan over medium-high heat. Stir in brown sugar, green onion, orange zest, ginger, garlic, and pepper flakes; bring to a boil. Remove from heat, and cool for 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DHhPn8o3cPwapidlzU7jzV2x8Pk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/61024-asian-orange-chicken-DDMFS-step-02-0240-ad79fa9ca8964a2ca371ecb840aaca1f.jpg"
      ],
      "image": "assets/images/61024/step_02.webp"
    },
    {
      "text": "Place chicken in a resealable plastic bag. Pour in 1 cup cooled sauce. Seal the bag, and refrigerate for at least 2 hours. Reserve the remaining sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lGhrSEc4HBobNwwSZzOR_E6Imm0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/61024-asian-orange-chicken-DDMFS-step-03-0259-6ee20813dc85428189c192238e0c8fa5.jpg"
      ],
      "image": "assets/images/61024/step_03.webp"
    },
    {
      "text": "Mix flour, salt, and pepper in another resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4SjGWz4InIaiXsESo59L5VZOqeE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/61024-asian-orange-chicken-DDMFS-step-04-0245-74c5c03746ee4155b278e7bc8ddc0ece.jpg"
      ],
      "image": "assets/images/61024/step_04.webp"
    },
    {
      "text": "Remove chicken from the marinade and place into the bag of seasoned flour. Seal the bag and shake to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Od_zegigP3iGxe22V8lPiFqAZhw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/61024-asian-orange-chicken-DDMFS-step-05-0365-64a90b810c8d4cea8350d8c5c9eb15c6.jpg"
      ],
      "image": "assets/images/61024/step_05.webp"
    },
    {
      "text": "Heat the olive oil in a large skillet over medium heat. Cook chicken in the hot skillet until browned on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UFcPOnlhvE_jMxjnNT72c2BfqXc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/61024-asian-orange-chicken-DDMFS-step-06-0381-b9530d6d29ef4878aecc962dfe0ebd4c.jpg"
      ],
      "image": "assets/images/61024/step_06.webp"
    },
    {
      "text": "Remove to a paper towel-lined plate and cover with aluminum foil. Wipe out the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/euHw3WXKugz5avjFsgFqjNr-Fxc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/61024-asian-orange-chicken-DDMFS-step-07-0384-9ce3a0d102e843d78a67362571777735.jpg"
      ],
      "image": "assets/images/61024/step_07.webp"
    },
    {
      "text": "Pour reserved sauce into the skillet and bring to a boil over medium-high heat. Mix together cornstarch and water until completely smooth. Stir into the boiling sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NpJ9PYqVhjs5ucyQxEubzLDzr3U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/61024-asian-orange-chicken-DDMFS-step-08-0393-767d7a8c77e54121bad6f0708afc20fc.jpg"
      ],
      "image": "assets/images/61024/step_08.webp"
    },
    {
      "text": "Reduce heat to medium-low, add the chicken, and simmer, stirring occasionally, until cooked through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NzfMtveJFO_c-QbFNbfRi6EEH8Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/61024-asian-orange-chicken-DDMFS-step-09-0399-0e359ec18f664300bb58ac8888098024.jpg"
      ],
      "image": "assets/images/61024/step_09.webp"
    },
    {
      "text": "Serve over rice and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pyQjSyy3bkncGY_1CMr4PoK5x7A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/61024-asian-orange-chicken-DDMFS-4x3-e08bb8afce844d0c9ef7d7276e9a9125.jpg"
      ],
      "image": "assets/images/61024/step_10.webp"
    }
