  "ingredients": [
    "0.25 cup dry lentils",
    "3 tablespoons olive oil",
    "0.25 teaspoon ground paprika",
    "0.25 teaspoon ground rainbow peppercorns",
    "0.25 teaspoon ground turmeric",
    "0.25 teaspoon red pepper flakes",
    "0.25 teaspoon ground mace",
    "0.25 teaspoon ground coriander",
    "0.25 teaspoon crushed rose petals",
    "4.25 cups water",
    "0.25 cup buckwheat groats, rinsed",
    "1 teaspoon salt",
    "1.5 ounces baby spinach leaves",
    "0.5 cup shredded cooked beets",
    "0.5 cup shredded carrots",
    "2 tablespoons finely chopped green onions",
    "1 teaspoon apple cider vinegar"
  ],
  "steps": [
    {
      "text": "Place lentils into a bowl and cover with several inches of cool water; let stand at least 2 hours. Drain and rinse.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix olive oil, paprika, pepper, turmeric, red pepper flakes, mace, coriander, and rose petals together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine lentils and 4 1/4 cups water in a pot and bring to a boil; cook until lentils are tender yet firm to the bite, 15 to 18 minutes. Add buckwheat groats and return water to a boil; add salt. Cook lentils and buckwheat for 10 minutes; remove from heat, cover pot, and let sit until all water is absorbed, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour lentils and buckwheat into a large bowl; add spinach, beets, carrots, and green onions. Pour seasoned oil mixture over lentil mixture and stir to coat. Drizzle apple cider vinegar over salad and stir to coat. Refrigerate for flavors to blend, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
