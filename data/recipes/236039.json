  "ingredients": [
    "cooking spray",
    "9 large eggs",
    "4 cups egg whites",
    "1 pound turkey ham, diced",
    "2 cups chopped spinach",
    "2 red bell peppers, diced",
    "2 green bell peppers, diced",
    "2 fresh jalapeno peppers, seeded and diced",
    "1 tablespoon minced garlic",
    "1 tablespoon Italian seasoning",
    "2 teaspoons onion powder",
    "0.25 teaspoon cayenne pepper",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 24 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl. Beat in egg whites until smooth. Stir in turkey ham, spinach, bell peppers, jalapeño peppers, garlic, Italian seasoning, onion powder, cayenne pepper, salt, and black pepper. Ladle egg mixture into the prepared muffin cups, about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until centers are set, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
