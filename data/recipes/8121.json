  "ingredients": [
    "0.5 cup margarine",
    "0.5 cup shortening",
    "1 cup peanut butter",
    "3 tablespoons evaporated milk",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon butter flavored extract",
    "1 pound confectioners' sugar",
    "2 bananas"
  ],
  "steps": [
    {
      "text": "Combine margarine, shortening, peanut butter, milk, vanilla, and butter flavoring. Add confectioners' sugar and beat until creamy. Add more milk, if needed, 1 teaspoon at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread icing over one layer of a yellow cake. Slice bananas on top. Place second layer on top and frost top and sides.",
