  "ingredients": [
    "0.25 cup brown sugar",
    "0.25 cup white sugar",
    "0.25 cup oats",
    "1 teaspoon all-purpose flour",
    "1 pinch ground cinnamon",
    "1 cup chopped rhubarb",
    "1 cup blueberries",
    "0.5 cup all-purpose flour",
    "0.33333334326744 cup oats",
    "1 pinch ground cinnamon",
    "1 pinch ground nutmeg",
    "0.5 cup melted butter, divided"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zed1bsWT8TULLpVDsDdRCNriSSM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242193-bluebarb-blueberry-rhubarb-crisp-ddmfs-01-17607-71e4799faaef4df18e15d01d34e314e9.jpg"
      ],
      "image": "assets/images/242193/step_01.webp"
    },
    {
      "text": "Whisk brown sugar, white sugar, 1/4 cup oats, 1 teaspoon flour, and a pinch of cinnamon together in a bowl. Add rhubarb and blueberries; stir to coat. Pour mixture into a small baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RKe3y5vTOBp3-wud0B40G_-nxF0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242193-bluebarb-blueberry-rhubarb-crisp-ddmfs-03-17610-b98cfc71a8d54264b4745c0aa6722b4b.jpg"
      ],
      "image": "assets/images/242193/step_02.webp"
    },
    {
      "text": "Stir 1/2 cup flour, 1/3 cup oats, cinnamon, and nutmeg together in a bowl; add enough butter to create a crumbly topping, about 1/2 of the butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3HlZqC_mmRendFkt7xOFxUVzQ0w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242193-bluebarb-blueberry-rhubarb-crisp-ddmfs-03-17612-ce17a154ef7a45dda3a41b39c806cee8.jpg"
      ],
      "image": "assets/images/242193/step_03.webp"
    },
    {
      "text": "Sprinkle crumbly topping over rhubarb mixture, and drizzle remaining butter over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/phOjblXfgIMTxi-sZ5jIfREfoIU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242193-bluebarb-blueberry-rhubarb-crisp-ddmfs-05-17619-9c2c73a1059342e78ded7097b7dcf0a2.jpg"
      ],
      "image": "assets/images/242193/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until golden and bubbling, 20 to 30 minutes. Cool for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
