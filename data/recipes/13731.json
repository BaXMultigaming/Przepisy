  "title": "Pumpkin Roll",
  "description": "This pumpkin roll recipe is easy to make for an elegant holiday dessert featuring soft spiced pumpkin cake rolled around sweet cream cheese filling.",
  "authors": [
    "Jackie"
  ],
  "date_published": "1999-08-22T18:47:12-04:00",
