  "ingredients": [
    "1 cup water",
    "2.5 tablespoons black tea leaves",
    "4.5 tablespoons white sugar",
    "0.25 cup evaporated milk",
    "crushed ice",
    "1 tablespoon milk, divided"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a small saucepan. Remove from heat and add black tea; let steep about 10 minutes or to desired strength.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain tea into a container and discard leaves. Add sugar and evaporated milk; stir until sugar is dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill 2 glasses with ice. Pour tea over ice. Top each glass with 1 1/2 teaspoon milk.",
