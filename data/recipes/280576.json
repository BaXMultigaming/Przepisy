  "ingredients": [
    "7 ounces shiitake mushrooms, stems removed",
    "3 tablespoons reduced-sodium soy sauce",
    "2 tablespoons olive oil",
    "1 tablespoon lemon juice",
    "1 pound sea scallops, patted dry",
    "2 tablespoons olive oil",
    "1 tablespoon lemon juice",
    "2 cloves garlic, minced",
    "2 teaspoons Italian seasoning",
    "8 wooden skewers"
  ],
  "steps": [
    {
      "text": "Combine mushrooms, soy sauce, 2 tablespoons olive oil, and 1 tablespoon lemon juice in a bowl; stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine scallops, 2 tablespoons olive oil, 1 tablespoon lemon juice, garlic, and Italian seasoning in a separate bowl; stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Soak wooden skewers in water while mushrooms and scallops marinate, 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, thread mushrooms and scallops onto separate skewers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until mushrooms soften and scallops are opaque, about 3 minutes per side. Cook mushrooms 1 to 2 minutes more if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
