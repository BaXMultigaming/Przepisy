  "ingredients": [
    "1.5 cups white sugar",
    "1 cup shortening",
    "0.5 cup pumpkin puree",
    "2 eggs",
    "1.5 cups all-purpose flour",
    "1.5 cups whole wheat flour",
    "1 tablespoon cream of tartar",
    "1.5 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon ground cloves",
    "0.25 cup white sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 1/2 cup sugar and shortening in a large bowl; beat with an electric mixer until creamy. Beat in pumpkin puree and eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all-purpose flour, whole wheat flour, cream of tartar, baking soda, cinnamon, nutmeg, ginger, allspice, and cloves together in a bowl. Fold into shortening mixture until a sticky dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1/4 cup sugar in a shallow bowl. Shape spoonfuls of dough into small balls. Roll in sugar and place 2 inches apart on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 8 minutes. Transfer to wire racks to cool completely, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
