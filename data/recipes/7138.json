  "ingredients": [
    "4.5 cups all-purpose flour",
    "0.25 cup shortening",
    "0.25 cup white sugar",
    "2.5 teaspoons salt",
    "1.5 tablespoons active dry yeast",
    "1.5 cups cold water",
    "1 tablespoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Mix together flour, sugar, salt, and instant yeast in a bowl. Add shortening and mix well. Mix in water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a lightly floured surface. Knead by hand for 20 minutes, or by machine for 12 to 14 minutes. Toss dough with vegetable oil in a bowl; cover the bowl and let proof for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into 24 rounds, and place on a greased baking tray. Cover and let proof for 45 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 12 to 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
