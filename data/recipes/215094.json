  "ingredients": [
    "2 teaspoons canola oil",
    "1 cup basmati rice, rinsed",
    "1 (2 inch) piece fresh ginger, minced",
    "1 lemon, juiced and zested",
    "2 cups chicken broth",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a pot over medium heat; add rice, ginger, and lemon zest and cook about 1 minute. Add lemon juice and chicken broth; bring to a boil. Cover the pot; simmer until liquid absorbed and rice tender, 18 to 20 minutes. Season with salt and pepper.",
