  "ingredients": [
    "1 canned chipotle pepper in adobo sauce",
    "0.25 cup water",
    "0.5 pound boneless pork loin roast",
    "0.5 pound skinless, boneless chicken breast halves",
    "1 (15.5 ounce) can white hominy, drained",
    "1 (4 ounce) can chopped green chilies",
    "1 medium onion, chopped",
    "1 clove garlic, minced",
    "2 (14.5 ounce) cans chicken broth",
    "1 teaspoon dried oregano",
    "1 teaspoon ground cumin",
    "0.25 teaspoon ground black pepper to taste",
    "1 bay leaf"
  ],
  "steps": [
    {
      "text": "Place the chipotle chile and water into a blender, and puree until smooth. Pour into a slow cooker, and add the pork, chicken, hominy, green chilies, onion, garlic, and chicken broth. Season with oregano, cumin, pepper, and the bay leaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook on Low 6 to 7 hours until the meats are tender. Remove the bay leaf before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
