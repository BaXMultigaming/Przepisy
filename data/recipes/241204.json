  "ingredients": [
    "1 pound ground beef",
    "0.5 cup chopped onion",
    "1 (10.75 ounce) can golden mushroom soup",
    "1 (10 ounce) package frozen cut green beans",
    "1 cup chopped canned tomatoes",
    "1 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "1 dash ground black pepper",
    "3 cups frozen bite-size potato nuggets (such as Tater Tots®)"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef and onion together in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mushroom soup, green beans, tomatoes, oregano, salt, and pepper with the beef mixture; bring to a boil and top with potato nuggets. Place a cover on the skillet, reduce heat to medium-low, and simmer until the green beans and potato nuggets are heated through, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
