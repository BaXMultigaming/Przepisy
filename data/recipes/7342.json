  "ingredients": [
    "1 cup raisins",
    "2 cups water",
    "0.5 cup butter",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 cup chopped walnuts",
    "1.75 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease one 10 x 10 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan boil the raising with the water for 10 minutes. Add the butter or margarine and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the same pan add the flour, soda, salt, sugar, cinnamon, nutmeg, and chopped nuts (optional), mix well and pour batter into a lightly greased 10x10 inch baking pan",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 35 minutes. Serves 8 to 12.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
