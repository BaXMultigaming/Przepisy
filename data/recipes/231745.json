  "ingredients": [
    "1 (18.25 ounce) box Duncan Hines® Red Velvet Cake Mix",
    "6 tablespoons butter",
    "2 large eggs",
    "1 teaspoon lemon zest",
    "1 cup powdered sugar",
    "1 teaspoon cornstarch"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cake mix, cooled butter, eggs, and lemon zest by hand in large mixing bowl until well blended and a dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix powdered sugar and cornstarch together with a fork in a shallow dish until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into 1-inch balls and roll in powdered sugar mixture. Place about 2 inches apart onto cool, ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake one sheet at a time in the center of the preheated oven until set, 9 to 11 minutes. Cool for 1 minute on the baking sheet, then transfer to a wire rack to cool completely, about 15 more minutes. Repeat to bake remaining cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
