  "ingredients": [
    "3.5 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "1.5 teaspoons salt",
    "1 teaspoon ground cinnamon",
    "0.75 teaspoon baking powder",
    "4 eggs",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "2 cups grated zucchini",
    "1 cup raisins",
    "1 cup chopped walnuts",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C) with rack in lowest position. Grease and lightly flour two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, salt, cinnamon, and baking powder together in a bowl until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl until smooth; gradually beat in sugar until well combined. Stir in oil; add flour mixture, alternating with zucchini. Stir in raisins, walnuts, and vanilla extract until incorporated. Divide batter between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 55 minutes. Cool for 10 minutes in the pans, then turn out onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
