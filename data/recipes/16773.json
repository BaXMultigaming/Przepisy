  "ingredients": [
    "0.25 cup confectioners' sugar",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup unsalted butter, softened",
    "1 large egg",
    "0.25 teaspoon vanilla extract",
    "1 (15.25 ounce) package yellow cake mix"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Place confectioners' sugar into a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5Mc997C3Vd-ptmvf1bLhwMuWqCk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-16773-gooey-butter-cookies-VAT-step-01-7cda4f168ac84910832fe19c094b86a7.jpg"
      ],
      "image": "assets/images/16773/step_01.webp"
    },
    {
      "text": "Beat cream cheese and butter with an electric mixer in a medium bowl until creamy. Stir in egg and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0djtBWYCauXl7W0zXLf7mjXcosI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-16773-gooey-butter-cookies-VAT-step-02-f3850388257a47a18fdb91f09e7b9f5e.jpg"
      ],
      "image": "assets/images/16773/step_02.webp"
    },
    {
      "text": "Add cake mix and stir until well blended. Roll dough into 1-inch balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rI3jjSOEfedHAgSk3zXrEF9g380=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-16773-gooey-butter-cookies-VAT-step-03-ece37d8345fd49ce844b42bb3218e29f.jpg"
      ],
      "image": "assets/images/16773/step_03.webp"
    },
    {
      "text": "Roll balls in confectioners' sugar to coat; place 1 inch apart onto an ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Qa1IQHNqSgTkLPTLB_MfEfEW3Ps=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-16773-gooey-butter-cookies-VAT-step-04-b4c4814d8b834efdb9799c23277b222f.jpg"
      ],
      "image": "assets/images/16773/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until set, 10 to 13 minutes.",
      "section": null,
      "name": null,
      "url": null,
