        "https://www.allrecipes.com/thmb/4gxfNQwo4UnyKZck7G3L2VpTlxg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-16773-gooey-butter-cookies-VAT-step-05-73d9a01b0508499395111d4b288e0181.jpg"
