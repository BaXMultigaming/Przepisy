  "ingredients": [
    "2 tablespoons olive oil",
    "1 tablespoon butter",
    "2 zucchini, quartered lengthwise and then cut crosswise into 1/2-inch pieces",
    "1 small sweet onion, diced",
    "0.5 green bell pepper, diced",
    "2 cloves garlic, minced",
    "1 cup corn kernels",
    "0.33333334326744 cup half and half",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.5 cup shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Heat oil and butter in a large skillet over medium heat until butter melted. Add zucchini, onion, bell pepper, and garlic; cook until zucchini begins to soften, about 5 minutes. Stir in corn, half-and-half, salt, and black pepper. Cover, reduce heat to low, and simmer 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, sprinkle Monterey Jack cheese over top. Cover skillet until cheese melts, 2 to 3 minutes.",
