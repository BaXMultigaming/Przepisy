  "ingredients": [
    "1 Reynolds® Oven Bag, large size",
    "1 tablespoon all-purpose flour",
    "8 ounces fresh baby spinach",
    "1 small onion, finely chopped",
    "4 (4 ounce) halibut steaks",
    "2 tablespoons butter, melted",
    "1 clove garlic, minced",
    "0.25 teaspoon salt",
    "0.25 teaspoon black pepper",
    "1 lemon, thinly sliced",
    "0.25 teaspoon Crushed red pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F. Add flour to a Reynolds® Large Oven Bag. Shake. Place bag in 2-quart rectangular baking dish at least 2 inches deep.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place spinach in bag; sprinkle with onion. Top with fish. Stir together the butter, garlic, salt, and black pepper. Brush over fish. Arrange lemon slices over fish. Close bag with tie (found inside package). Cut six 1/2-inch slits in top of bag to allow steam to escape. Tuck ends of bag in dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place dish in oven, allowing room for bag to expand during cooking without touching heating elements, wall, or racks. Bag should not hang over dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut open top of oven bag carefully. Remember: Always support bag with the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve fish with spinach and lemon, and spoon any juices over the top. Sprinkle with crushed red pepper, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
