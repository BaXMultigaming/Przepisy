  "ingredients": [
    "0.75 cup margarine, divided",
    "1 medium head cabbage, cored and sliced thin",
    "1 onion, sliced",
    "1 (16 ounce) package uncooked spaghetti",
    "1 cup small curd cottage cheese",
    "1 tablespoon white sugar",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a large skillet over medium-low heat, melt 3 tablespoons margarine. Add cabbage and onions. Cover and cook, stirring occasionally, until tender and browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cooked pasta into cabbage and add remaining margarine. Stir in cottage cheese and sugar; cook until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
