  "ingredients": [
    "1 pound lean ground beef",
    "1 cup soft, fresh breadcrumbs",
    "1 egg, beaten",
    "2 tablespoons milk",
    "2 tablespoons onion, chopped",
    "1 clove garlic, minced",
    "1 teaspoon salt",
    "0.5 teaspoon pepper",
    "0.66666668653488 cup Heinz® Chili Sauce",
    "0.66666668653488 cup red currant jelly"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Gently blend ground beef, bread crumbs, egg, milk, onion, garlic, salt, and pepper until evenly combined. Form into about 40 bite-sized meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place meatballs on a foil-lined, rimmed baking sheet; bake in the preheated oven for 20 minutes or until cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chili sauce and jelly in a saucepan set over medium heat. Cook, stirring, until jelly dissolves, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked meatballs to sauce; reduce heat to medium-low and simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
