  "steps": [
    {
      "text": "Season beef with salt, pepper, and paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brown seasoned beef and onion in oil until all sides are brown. Cover with water and simmer for 3 to 4 hours or until tender. Add water whenever level goes below the ingredients.",
