  "ingredients": [
    "4 (3 ounce) fillets mahi mahi",
    "1 teaspoon adobo seasoning",
    "1 dash lime juice",
    "1 cup chopped fresh cilantro",
    "1 medium tomato, diced",
    "0.5 red onion, chopped",
    "2 scallions, thinly sliced",
    "2 tablespoons lime juice",
    "cooking spray",
    "8 (6 inch) corn tortillas",
    "1 avocado, sliced"
  ],
  "steps": [
    {
      "text": "Season mahi mahi lightly with adobo seasoning and 1 dash of lime juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cilantro, tomato, onion, scallions, and 2 tablespoons lime juice together in a medium bowl for pico de gallo. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly coat a nonstick skillet with cooking spray; heat on medium-high heat. Cook mahi mahi until golden brown, about 2 minutes per side. Reduce heat to low; cook, covered, until fish flakes easily with a fork, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place corn tortillas between damp paper towels; microwave on medium until heated through, 30 seconds to 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1/2 mahi mahi fillet on each tortilla. Top each with 2 slices avocado, and 1 scoop pico de gallo.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
