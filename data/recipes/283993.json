  "ingredients": [
    "0.25 cup fresh lemon juice",
    "2 tablespoons honey",
    "2 teaspoons Worcestershire sauce",
    "4 cloves garlic, chopped",
    "2 pounds boneless, skinless chicken thighs",
    "cooking spray",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine lemon juice, honey, Worcestershire sauce, and garlic in a non-reactive dish. Add chicken; turn to coat all sides. Cover and marinate in the refrigerator, turning occasionally, for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Spray a shallow roasting pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from the marinade and shake off excess. Arrange chicken on the prepared roasting pan. Pour remaining marinade over top. Sprinkle with pepper and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, basting occasionally with marinade, for 20 minutes. Bake without basting until the juices run clear, another 20 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
