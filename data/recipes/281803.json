  "title": "Ground Chicken Chili",
  "description": "Thick and robust, this white ground chicken chili recipe is made with ground chicken, corn, peppers, beans, and herbs. It has a creamy, beer-based sauce.",
  "authors": [
    "Dean"
  ],
  "date_published": "2014-04-22T23:03:01-04:00",
