  "ingredients": [
    "2 tablespoons butter",
    "12 ounces chopped cooked ham",
    "1 medium onion, chopped",
    "3 cloves garlic, minced",
    "0.5 medium head cabbage, cored and chopped",
    "1 cup chicken broth",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium-high heat. Add ham and onion; cook, stirring occasionally, until onion is translucent, about 8 minutes. Add garlic and cook until fragrant, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cabbage; cook and stir for 5 minutes. Add broth and season with salt and pepper. Cover and cook for 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Uncover and continue to cook until cabbage is tender, about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
