  "ingredients": [
    "1 pound ground beef",
    "1 (1 ounce) package taco seasoning mix",
    "12 (5 inch) corn tortillas",
    "1 cup shredded Monterey Jack cheese",
    "0.5 cup chopped onion",
    "2 cups shredded iceberg lettuce",
    "1 large tomato, diced",
    "1 (8 ounce) jar salsa",
    "1 (8 ounce) container sour cream"
  ],
  "steps": [
    {
      "text": "Build a campfire and allow the fire to burn until a bed of hot coals has accumulated. Rake the coals into a flat bed on one side of the fire.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook ground beef in a large skillet over medium-high heat until browned, stirring to crumble. Discard excess fat; stir taco seasoning into beef according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat inside of a pie iron with cooking spray. Place 1 corn tortilla on one side, top with 1 scoop ground beef, sprinkle with Monterey Jack cheese, add chopped onion; place 1 (more) corn tortilla on top. Close pie iron.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook taco over moderate campfire coals until tortillas have crisped and browned and taco is hot in center. Serve with lettuce, tomato, salsa, and sour cream. Repeat with remaining ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
