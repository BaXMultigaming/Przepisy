  "ingredients": [
    "2 acorn squash, halved and seeded",
    "0.25 cup frozen orange juice concentrate, thawed",
    "2 tablespoons butter",
    "4 teaspoons brown sugar",
    "1 teaspoon ground nutmeg",
    "0.125 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a baking dish with about 1/2 inch water. Place squash halves cut side down in the dish. Bake 40 minutes in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk orange juice, butter, brown sugar, nutmeg, and cinnamon together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn squash halves cut side up. Drizzle evenly with orange juice sauce. Continue baking until squash is tender, about 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
