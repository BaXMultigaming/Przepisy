  "ingredients": [
    "1 cup shredded zucchini",
    "1 cup shredded apple",
    "0.75 cup brown sugar",
    "2 eggs, lightly beaten",
    "0.5 cup olive oil",
    "1 teaspoon vanilla extract",
    "1 cup whole wheat flour",
    "0.5 cup all-purpose flour",
    "2 tablespoons unsweetened cocoa powder",
    "1.25 teaspoons baking soda",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon baking powder",
    "0.5 cup semi-sweet chocolate chunks",
    "0.5 cup pepitas (raw pumpkin seeds)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine zucchini, apple, brown sugar, eggs, olive oil, and vanilla extract in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift whole wheat flour, all-purpose flour, cocoa powder, baking soda, salt, and baking powder together into a separate bowl; gently stir into zucchini-apple mixture until fully incorporated. Transfer batter to the prepared baking dish; sprinkle chocolate chunks and pepitas over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 25 minutes. Cool before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
