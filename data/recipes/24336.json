  "ingredients": [
    "0.5 cup brown sugar",
    "0.25 cup butter",
    "0.5 cup white sugar",
    "0.5 cup water",
    "2 teaspoons vinegar",
    "1 pinch salt",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Generously butter a 10x15-inch baking pan (with sides).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1GDo-8IlVUV1UCoZAbtiAoaEuic=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-24336-butterscotch-candy-VAT-step-01-481428b9f8a54d6e9cbca00d6e77c8ce.jpg"
      ],
      "image": "assets/images/24336/step_01.webp"
    },
    {
      "text": "In a medium saucepan over medium heat, combine brown sugar, butter, white sugar, water, vinegar, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yvl1cOLC3aVDaj66dbtE_9j1AwM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-24336-butterscotch-candy-VAT-step-02-48a0ccb440884104af8d0483bc0452a5.jpg"
      ],
      "image": "assets/images/24336/step_02.webp"
    },
    {
      "text": "Cover and bring to a boil. Remove lid and heat, without stirring, to 270 to 290 degrees F (132 to 143 degrees C), or until a small amount of syrup dropped into cold water forms hard but pliable threads.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bT5mImPWkmnf3xYO4O-RgKx_hQ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-24336-butterscotch-candy-VAT-step-03-9f9b6b89ff944d69afe5e82fc577928a.jpg"
      ],
      "image": "assets/images/24336/step_03.webp"
    },
    {
      "text": "Pour in vanilla, but do not stir. Remove from the heat and pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XsWcbpMLKk0eM24_ZZ8bwjP69sE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-24336-butterscotch-candy-VAT-step-04-252599fa211045128474e3b68300d741.jpg"
      ],
      "image": "assets/images/24336/step_04.webp"
    },
    {
      "text": "Let cool slightly before cutting into squares and allowing candy to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2QZST2eV43eqRos-rOSQtp8L3y4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-24336-butterscotch-candy-VAT-step-05-fb3fe14eff144254b41e21f081b58197.jpg"
