  "ingredients": [
    "3 cups all-purpose flour",
    "2 teaspoons baking soda",
    "6 tablespoons unsweetened cocoa powder",
    "2 teaspoons vanilla extract",
    "2 cups cold water",
    "1 cup white sugar",
    "1 cup sugar substitute",
    "1 teaspoon salt",
    "2 tablespoons distilled white vinegar",
    "0.66666668653488 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 9 x 13 inch pan, or three 8 inch round pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, soda, cocoa, sugar, sugar substitute, and salt. Stir in vanilla, water, vinegar, and oil. Pour batter into prepared pan(s).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cake in a rectangular pan or three round pans for 35 minutes, or until done. Cool.",
      "section": null,
