  "keywords": [],
  "ingredients": [
    "1 (12 ounce) box vanilla wafer cookies (such as Nilla®)",
    "1 cup semisweet chocolate chips",
    "0.25 cup light corn syrup",
    "0.75 cup dark rum (such as Meyer's®)",
    "1 cup confectioners' sugar, plus more for dusting"
  ],
  "steps": [
    {
      "text": "Process cookies in a food processor into fine crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9qsiH2LRnHNKwm9hXM2SVrKNhY4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6589443-The-Best-rum-balls-ddmfs-02-10967-e94d3465ebf949cfa4c164e6da4658fa.jpg"
      ],
      "image": "assets/images/230145/step_01.webp"
    },
    {
      "text": "Heat chocolate and corn syrup together in a medium saucepan over low heat. Cook, stirring often, until chocolate is smooth, about 5 minutes. Remove from heat; stir in rum and confectioners' sugar until smooth. Fold in cookie crumbs; dough will be sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/90F67wt8PDopeiZf5eM1HTSGWI4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6589443-The-Best-rum-balls-ddmfs-04-10981-bb5e3ed13898446da70a487e9fad9b30.jpg"
      ],
      "image": "assets/images/230145/step_02.webp"
    },
    {
      "text": "Refrigerate mixture until dough is firm, about 15 minutes. Cover 2 plates with waxed paper; dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5FG6RkQAdSx3hVUkPfGkL8v25bo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6589443-The-Best-rum-balls-ddmfs-05-11073-8a31625f020d4696946564070757adf8.jpg"
      ],
      "image": "assets/images/230145/step_03.webp"
    },
    {
      "text": "Roll dough into 1-inch balls; place on the prepared plates. Dust with confectioners' sugar. Refrigerate until firm, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LpS5OSEYmc5vm3HvOofVY90f7vs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6589443-The-Best-rum-balls-ddmfs-07-11072-d97cac7ed7d94a13a458643a594c6829.jpg"
      ],
      "image": "assets/images/230145/step_04.webp"
    },
    {
      "text": "Transfer to a resealable bag with more confectioners' sugar. Seal the bag and gently shake to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QyCabGVC1Pq4b1qFUMXKbvaDYUM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6589443-The-Best-rum-balls-ddmfs-08-11076-2e2b0f9aca144508b2266fcb73adbc09.jpg"
      ],
      "image": "assets/images/230145/step_05.webp"
    }
  ],
