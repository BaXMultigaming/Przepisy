  "title": "The Best Rum Balls",
  "description": "The best rum balls recipe uses only four ingredients: rum, vanilla wafers, chocolate, and confectioners&#39; sugar for adult rum balls that everyone wants.",
  "authors": [
    "Matt Story"
  ],
  "date_published": "2017-04-12T09:00:37-04:00",
