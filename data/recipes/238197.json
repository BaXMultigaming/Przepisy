  "ingredients": [
    "2 cups hot water",
    "1 cup sugar",
    "1 tablespoon butter",
    "2 cups sliced peeled peaches",
    "1 cup flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Stir water, sugar, and butter together in a pot over medium-high heat until sugar dissolves and mixture is syrupy, 5 to 10 minutes. Add peaches and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a bowl. Stir in milk until a stiff batter forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop large spoonfuls of batter into boiling peach syrup. Cover the pot, reduce the heat to medium, and cook until a toothpick inserted into the center of the dumplings comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
