  "ingredients": [
    "2.5 cups all-purpose flour",
    "1.5 cups rolled oats",
    "3 tablespoons white sugar",
    "2 tablespoons baking powder",
    "1.5 teaspoons salt",
    "4 eggs, separated",
    "1.5 cups buttermilk",
    "1 cup milk",
    "0.5 cup butter, melted",
    "1.5 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, oats, sugar, baking powder, and salt in a large bowl; set aside. Beat egg yolks together in a bowl; add buttermilk, milk, and butter. Beat until well combined. Beat buttermilk mixture into flour mixture until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites and vanilla extract together in a bowl until soft peaks form; fold 1/2 into buttermilk batter until combined. Repeat with remaining 1/2 egg whites.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle batter into the preheated waffle iron; cook until waffles are golden and crisp and iron stop steaming, about 5 minutes. Transfer to a paper towel-lined plate to prevent sogginess. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
