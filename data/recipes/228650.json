  "ingredients": [
    "1 tablespoon olive oil",
    "3 skinless, boneless chicken breast halves",
    "1 large onion, chopped",
    "2 cloves garlic, minced",
    "5.25 cups chicken broth",
    "3 (15 ounce) cans cannellini (white kidney) beans, rinsed and drained",
    "2 (4 ounce) cans chopped green chiles",
    "1 tablespoon dried oregano",
    "1 teaspoon ground cumin",
    "2 pinches cayenne pepper, or to taste",
    "0.25 cup chopped fresh cilantro, or to taste",
    "0.5 cup shredded Monterey Jack cheese, or to taste",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a Dutch oven over medium heat. Cook chicken, onion, and garlic in hot oil until chicken is browned on both sides, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZM1uzrqJYPFSSm3eoO4xcX5fkkM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228650-EasyWhiteChickenChili-ddmfs-Step1-0240-54e10727c8b44938ba9626c8d0c605bb.jpg"
      ],
      "image": "assets/images/228650/step_01.webp"
    },
    {
      "text": "Transfer chicken to a cutting board; cut into 1-inch pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fXYPFOF-_piXdpmbnz3986pLXGQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228650-EasyWhiteChickenChili-ddmfs-Step2-0243-cc942a568dde4908a0b0b6d6295b4c14.jpg"
      ],
      "image": "assets/images/228650/step_02.webp"
    },
    {
      "text": "Return chicken pieces to the Dutch oven. Add chicken broth, cannellini beans, green chiles, oregano, cumin, and cayenne pepper. Bring the mixture to a simmer and cook until the chicken is cooked through, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LVmzcLZzquwuXvEz_XAnMjxmvwQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228650-EasyWhiteChickenChili-ddmfs-Step3-0244-79292e210b2444269d5ce8f01818891f.jpg"
      ],
      "image": "assets/images/228650/step_03.webp"
    },
    {
      "text": "Divide cilantro among 4 bowls. Ladle chili over cilantro and top with cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0DHoXR3_-wHnK31uI5Al097WOh8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228650-EasyWhiteChickenChili-ddmfs-Step4-0297-4629ba04b6db487682b2adb56acf64e9.jpg"
      ],
      "image": "assets/images/228650/step_04.webp"
    },
    {
      "text": "Season with salt to serve.",
