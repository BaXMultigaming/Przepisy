  "ingredients": [
    "2 cups milk",
    "4 large eggs",
    "1 cup grated Parmesan cheese",
    "0.75 cup biscuit baking mix",
    "0.25 cup butter, softened",
    "1 (10 ounce) package chopped frozen broccoli, thawed and drained",
    "8 ounces shredded Cheddar cheese",
    "1 cup cubed cooked ham"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 10-inch quiche dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wgmckO70ssjExVakJTANAmBQo9s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23389-EasyQuiche-mfs-step1-0500-d11f68c174f64f63a12cf10c6f5b3599.jpg"
      ],
      "image": "assets/images/23389/step_01.webp"
    },
    {
      "text": "Beat milk, eggs, Parmesan cheese, baking mix, and butter together in a large bowl until well combined; batter will be lumpy. Stir in broccoli, Cheddar cheese, and ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ITp1fNzeDv-eOBEVGUbNmkWz1y0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23389-EasyQuiche-mfs-step2-0501-285f94c05fd4476a9c03bbb8c4c06745.jpg"
      ],
      "image": "assets/images/23389/step_02.webp"
    },
    {
      "text": "Pour into the prepared quiche dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KUAAFKx3ZFIV7MxZeFC5J2ERkhg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23389-EasyQuiche-mfs-step3-0503-11372eb6e3194ebdb946aa62f784d054.jpg"
      ],
      "image": "assets/images/23389/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until eggs are set and the top is golden brown, about 50 minutes,",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t_glnqcWzj9HwFI2loby0AMOJkA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23389-EasyQuiche-mfs-step4-0536-539dea93abde40d1a10c966e70b8316f.jpg"
      ],
