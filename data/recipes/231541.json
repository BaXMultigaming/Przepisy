  "ingredients": [
    "cooking spray",
    "1 (15 ounce) can pumpkin puree",
    "1.25 cups skim milk",
    "0.75 cup granular sucralose sweetener (such as Splenda®)",
    "0.5 cup egg substitute",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch pie dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kI24p2m6B39IWXa4qOlag3Gh1QI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231541-EasyCrustlessPumpkinPie-gw-ddmfs-4x3-step-01-3959-e7ec4d8a61ed48a99cffb45f7443efbd.jpg"
      ],
      "image": "assets/images/231541/step_01.webp"
    },
    {
      "text": "Beat pumpkin puree, milk, sweetener, egg substitute, vanilla, cinnamon, ginger, and nutmeg in a bowl until smooth; pour into the prepared pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Uog70PqnqFBzhGoun17UZjg0-Mw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231541-EasyCrustlessPumpkinPie-gw-ddmfs-4x3-step-04-3962-c747faf1ae554913904539cfb176b2ef.jpg"
      ],
      "image": "assets/images/231541/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until the center is set, about 30 minutes. Remove from the oven and cool completely before serving.",
