  "ingredients": [
    "0.5 cup butter",
    "1 cup sugar",
    "4 eggs",
    "5 slices white bread, cut into 1 inch cubes",
    "1 (20 ounce) can crushed pineapple, drained",
    "0.33333334326744 cup brown sugar, packed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 6x10 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream the butter and sugar together in a mixing bowl until light and fluffy. Beat in the eggs one at a time. Stir in the bread cubes and pineapple until well blended. Pour the mixture into the prepared baking dish. Sprinkle brown sugar evenly over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until bread points on top are golden brown, 45 to 60 minutes. Cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
