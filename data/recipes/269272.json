  "ingredients": [
    "0.75 cup all-purpose flour",
    "1.5 tablespoons white sugar",
    "0.75 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground cinnamon",
    "1 ripe banana",
    "0.5 cup sourdough starter",
    "0.5 cup sour cream",
    "1 egg, lightly beaten",
    "2 tablespoons butter, softened",
    "0.5 teaspoon vanilla extract",
    "0.5 cup milk, or as needed",
    "1 tablespoon butter, melted, divided"
  ],
  "steps": [
    {
      "text": "Whisk flour, sugar, baking soda, salt, and cinnamon together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash banana in another bowl. Stir in sourdough starter, sour cream, egg, 2 tablespoons butter, and vanilla extract. Add to the flour mixture and stir until just combined. Mix in milk gradually until batter is pourable but some lumps remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a griddle over medium-high heat. Grease lightly with melted butter. Pour 1/4 cup batter onto the griddle for each pancake, keeping them 2 inches apart. Cook until bubbles form and the edges are dry, about 2 1/2 minutes. Flip and cook until browned on the other side, about 1 minute. Repeat with remaining butter and batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
