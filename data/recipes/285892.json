  "ingredients": [
    "nonstick cooking spray",
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup unsalted butter, melted",
    "2 large eggs, beaten",
    "2 tablespoons freshly squeezed lemon juice",
    "1 tablespoon lemon, zested",
    "0.5 teaspoon almond extract",
    "0.5 teaspoon vanilla extract",
    "0.75 cup sweetened dried cranberries, divided",
    "0.5 cup white chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking dish with parchment paper and spray with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, and salt together in a large bowl. Mix together butter, eggs, lemon juice, lemon zest, almond extract, and vanilla extract in another bowl until well combined. Add wet ingredients to the bowl with the dry ingredients and stir until well mixed. Mix in 1/2 cup of the cranberries and white chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter into the prepared baking dish. Sprinkle remaining 1/4 cup of cranberries evenly over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges are golden and the center is set, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove blondies from the oven to cool on a wire rack completely before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
