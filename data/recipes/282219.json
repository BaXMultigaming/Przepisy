  "total_time": "PT75M",
  "yield": [
    "4",
    "8 potato skins"
  ],
  "categories": [
    "Appetizer"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "4 large baking potatoes, scrubbed",
    "3 tablespoons olive oil",
    "1 tablespoon grated Parmesan cheese",
    "0.5 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon ground paprika",
    "0.125 teaspoon ground black pepper",
    "1.5 cups shredded sharp Cheddar cheese",
    "8 slices cooked bacon, crumbled",
    "0.5 cup sour cream",
    "4 stalks green onion, sliced"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9_WmmrLTb_6LEoZgxF57aF5jY3M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-282219-loaded-baked-potato-skins-VAT-step-01-74d20231b409419ca3400ce01650a3b9.jpg"
      ],
      "image": "assets/images/282219/step_01.webp"
    },
    {
      "text": "Prick potatoes several times with a fork and place onto a baking sheet. Bake in the preheated oven until potatoes are easily pierced with a fork, 50 minutes to 1 hour. Remove from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6qtS8ybAaeDq3R4C305_qJbOPAw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-282219-loaded-baked-potato-skins-VAT-step-03-1forkpiercingthebakedpotatoes-e2cdd8cb8e704629a2122b01edd5d78a.jpg"
      ],
      "image": "assets/images/282219/step_02.webp"
    },
    {
      "text": "When potatoes are cool enough to handle, cut them lengthwise and scoop out flesh to within 1/4-inch of skin. Reserve flesh for another use. Place skins back onto the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0PF47vqBe6tV9UtE5hyA-BV89zs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-282219-loaded-baked-potato-skins-VAT-step-04-c2f0809280a84e8d97baf563fa34e2d1.jpg"
      ],
      "image": "assets/images/282219/step_03.webp"
    },
    {
      "text": "Combine olive oil, Parmesan cheese, salt, garlic powder, paprika, and pepper in a small bowl; brush over both sides of skins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vsSnzjaqBPlGqMbcXBBebB9aIfo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-282219-loaded-baked-potato-skins-VAT-step-05-40e25e47ebe04afb9e60707def06808f.jpg"
      ],
      "image": "assets/images/282219/step_04.webp"
    },
    {
      "text": "Return to the oven and bake until very crisp, about 10 minutes, turning skins halfway though.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mQOqH9Eml8CnMVziLIDdg5pRAPY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-282219-loaded-baked-potato-skins-VAT-step-06-dae6ed872bc84bebb133a111c9d5bb25.jpg"
      ],
      "image": "assets/images/282219/step_05.webp"
    },
    {
      "text": "Sprinkle skins with Cheddar cheese and bacon. Return to the oven and bake until cheese is melted, about 2 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LOTatiFUHEF8C4iDGst0NhFPYBY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-282219-loaded-baked-potato-skins-VAT-step-07-c3255f2283bf4a07afc801aa22edc962.jpg"
      ],
      "image": "assets/images/282219/step_06.webp"
    },
    {
      "text": "Serve topped with sour cream and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J03rNigte24vKZg3dmhy-eObGlE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-282219-loaded-baked-potato-skins-VAT-step-08-1-d97a358948304379bc3f231bd95b7b1f.jpg"
      ],
      "image": "assets/images/282219/step_07.webp"
    }
  ],
