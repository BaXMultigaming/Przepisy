  "title": "Loaded Baked Potato Skins",
  "description": "These loaded potato skins are topped with Cheddar cheese, bacon, sour cream, and scallions. Nobody will resist this easy-to-make appetizer.",
  "authors": [
    "Kimm"
  ],
  "date_published": "2014-12-30T22:12:42-05:00",
  "date_modified": "2026-01-02T16:36:30-05:00",
  "prep_time": "PT10M",
