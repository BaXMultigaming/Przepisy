  "ingredients": [
    "2 cups cornmeal",
    "0.5 cup white sugar",
    "1 tablespoon all-purpose flour",
    "1 teaspoon salt",
    "3 cups water",
    "0.25 cup butter",
    "1.5 cups milk",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cornmeal, sugar, flour, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water to a boil in a saucepan and add butter. Stir until melted and blended. Remove from heat and let cool until lukewarm, at least 15 minutes. Add milk and eggs and mix well. Stir in the cornmeal mixture just until combined. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is dry, about 45 minutes. Let cool for 45 minutes before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
