  "ingredients": [
    "1.25 cups white sugar",
    "0.5 cup butter",
    "2 eggs, beaten",
    "1 teaspoon baking soda",
    "0.25 cup sour cream",
    "1 cup mashed bananas",
    "1.5 cups cake flour",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar together in a large bowl with an electric mixer until light and fluffy. Add eggs and beat well. Dissolve soda in sour cream and add it to butter mixture; beat well. Mix in mashed bananas; add cake flour and mix until just incorporated. Stir in vanilla extract. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
