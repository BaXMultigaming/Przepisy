    "Dinner"
  ],
  "cuisines": [
    "Italian"
  ],
  "regions": [
    "Italian"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "4 cups water",
    "1.5 teaspoons kosher salt, or to taste",
    "1 cup uncooked coarse-ground polenta",
    "1 tablespoon butter",
    "0.5 cup finely grated Parmigiano-Reggiano cheese",
    "1.5 cups ricotta cheese",
    "0.667 cup finely grated Parmigiano-Reggiano cheese",
    "4 ounces grated mozzarella cheese",
    "1 teaspoon kosher salt, or to taste",
    "0.25 teaspoon ground black pepper",
    "1 pinch cayenne pepper, or to taste",
    "1 large egg, beaten",
    "2 tablespoons chopped Italian parsley",
    "1 tablespoon olive oil",
    "3 cups hot prepared meat sauce, or more to taste",
    "1 tablespoon chopped Italian parsley, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tY7YyZdVMTkrv3JHEGnwX5VlW6w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8368382-polenta-lasagna-loaf-VAT-ingredients-8bb3ded996284d4b822d46dc778b8934.jpg"
      ],
      "image": "assets/images/8368382/step_01.webp"
    },
    {
      "text": "Prepare polenta: Bring water and salt to a boil over high heat. Whisk polenta into the boiling water and continue whisking until it starts to thicken, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/axj7I5mmMQR1Behtnr0yYJErnhw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8368382-polenta-lasagna-loaf-VAT-step-02-2-8bb8841689a74868801132b1b963b77f.jpg"
      ],
      "image": "assets/images/8368382/step_02.webp"
    },
    {
      "text": "Reduce heat to medium-low and simmer, stirring often, until polenta is soft and has lost its grainy texture, 25 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O3nifcbenmMVuqEzROezy68JB0Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8368382-polenta-lasagna-loaf-VAT-step-03-1-c0f6b33298314644ab81686110118bce.jpg"
      ],
      "image": "assets/images/8368382/step_03.webp"
    },
    {
      "text": "Remove polenta from the stove and quickly whisk in butter and Parmigiano-Reggiano cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EYNi3n27mOJsm_XiAzg9Oo6nE_o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8368382-polenta-lasagna-loaf-VAT-step-04-2-bb6ddca3faf24a3daf18409d8484e0db.jpg"
      ],
      "image": "assets/images/8368382/step_04.webp"
    },
    {
      "text": "Transfer polenta to a silicone baking liner (or oiled foil or parchment paper). Spread it out evenly almost to the edges into an 8x13-inch rectangle. Cover with plastic wrap and smooth out the top with your hands. Place a baking sheet on top and press slightly to further flatten.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5V9uDOgTr1Em8ZNh_JytO-w3gRs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8368382-polenta-lasagna-loaf-VAT-step-05-b6466e94e2fd4231bca4d783733d2f9a.jpg"
      ],
      "image": "assets/images/8368382/step_05.webp"
    },
    {
      "text": "Slide the silicone liner and polenta onto the baking sheet and place in the refrigerator until firm, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vT6yPAPeOYnsYg7-vrRYZS3pENQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8368382-polenta-lasagna-loaf-VAT-step-06-124e1134fd1948688fcdc3d991604e0d.jpg"
      ],
      "image": "assets/images/8368382/step_06.webp"
    },
    {
      "text": "Remove polenta from the refrigerator and cut, from one long edge to the other, into 8-inch long strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SYf4JyS_hUw5dcsnNfMaUyZJM8Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8368382-polenta-lasagna-loaf-VAT-step-07-4bf55dadf26f47ffb164d7e3f9c40cb3.jpg"
      ],
      "image": "assets/images/8368382/step_07.webp"
    },
    {
      "text": "Prepare filling: Stir ricotta, Parmigiano-Reggiano, mozzarella, salt, pepper, cayenne, egg, and parsley in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6SD7e7En6iLLJMiYgj71L5pmHy4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8368382-polenta-lasagna-loaf-VAT-step-08-3201755fc4244f6c996c86488101c13c.jpg"
      ],
      "image": "assets/images/8368382/step_08.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a loaf pan with 1 tablespoon oil. Place one strip of polenta into the bottom of the prepared loaf pan. Spread 1/3 of the filling on top as evenly as you can. Top with about 1 cup hot meat sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RIkwuIjmUiCSjZYj2Y614Fawgyw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8368382-polenta-lasagna-loaf-VAT-step-10-8bec36c3365c4d38bc81dcf6b542d8a8.jpg"
      ],
      "image": "assets/images/8368382/step_09.webp"
    },
    {
      "text": "Repeat polenta-filling-sauce layers twice more. Place the last piece of polenta on top, then gently shake and tap the pan to settle the contents. Place the loaf pan on top of a sheet pan to catch any spills while baking. Loosely wrap the top of the loaf pan with foil, making sure it's not touching the polenta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FWYn65Ks9KqzCxSJX4V8p94FA7o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8368382-polenta-lasagna-loaf-VAT-step-11-19b561df85c841e89868405162934604.jpg"
      ],
      "image": "assets/images/8368382/step_10.webp"
    },
    {
      "text": "Bake in the preheated oven until bubbly, about 1 hour. Remove from the oven, discard foil, and let rest for at least 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-UmRDSBKJs3sdT-INThFEaBSGG0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8368382-polenta-lasagna-loaf-VAT-step-12-9f3627ff9ca742dea39480382e93efaf.jpg"
      ],
      "image": "assets/images/8368382/step_11.webp"
    },
    {
      "text": "Divide onto 6 plates. Garnish with parsley and serve with additional sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2nDyMs-2bJUyAPA-Eu1jbJpDTdA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8368382-polenta-lasagna-loaf-VAT-4x3-6-67c5fa9cef8c49248a93a28af23c4a71.jpg"
      ],
      "image": "assets/images/8368382/step_12.webp"
    }
  ],
