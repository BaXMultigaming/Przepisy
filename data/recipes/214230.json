  "ingredients": [
    "2 cooked chicken breast halves, chopped",
    "0.5 cup mayonnaise, or to taste",
    "2 green onions, chopped",
    "0.5 cup sweetened dried cranberries (such as Ocean Spray® Craisins®)",
    "0.25 green apple, shredded",
    "0.25 cup chopped pecans",
    "1 tablespoon lime juice",
    "0.25 teaspoon dried dill weed",
    "1 pinch salt and black pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Stir chicken and mayonnaise together in a medium bowl until evenly coated. Stir in green onions, dried cranberries, apple, pecans, lime juice, dill weed, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve immediately or refrigerate for several hours or overnight (the flavor just gets better).",
