  "ingredients": [
    "2 teaspoons butter",
    "1 pint cherry tomatoes",
    "1 teaspoon dried basil",
    "0.5 teaspoon white sugar",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium-high heat. Add cherry tomatoes, basil, and sugar. Cook for about 30 seconds, then season to taste with salt and pepper. Continue cooking for a few seconds more until tomatoes have just started to blister.",
