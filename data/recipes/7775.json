  "ingredients": [
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "2 teaspoons baking soda",
    "1.5 teaspoons salt",
    "6 tablespoons unsweetened cocoa powder",
    "10 tablespoons margarine, melted",
    "2 tablespoons distilled white vinegar",
    "2 teaspoons vanilla extract",
    "2 cups water",
    "4 cups confectioners' sugar",
    "3 tablespoons unsweetened cocoa powder",
    "0.5 cup margarine",
    "6 tablespoons water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, white sugar, baking soda, salt, and 6 tablespoons of cocoa into a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle melted margarine and the vinegar over the flour mixture. Add the vanilla and cold water and stir well to remove lumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 35 minutes. Spread with chocolate frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the chocolate frosting: Combine confectioner's sugar, 6 tablespoons water, 3 tablespoons cocoa, and 1/2 cup of margarine. Heat until melted and stir until smooth add vanilla and nuts if desired, and spread over cake.",
