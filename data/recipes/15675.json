  "ingredients": [
    "0.25 cup fresh orange juice",
    "2 cloves garlic, minced",
    "1 tablespoon olive oil",
    "1 tablespoon fresh lime juice",
    "1 teaspoon orange zest",
    "1 teaspoon minced fresh ginger root",
    "0.5 teaspoon chopped fresh oregano",
    "0.25 teaspoon hot pepper sauce",
    "1.5 skinless, boneless chicken breasts"
  ],
  "steps": [
    {
      "text": "Combine orange juice, garlic, olive oil, lime juice, orange zest, ginger, oregano, and hot pepper sauce in a blender. Blend into a marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken breasts in a nonporous glass dish or bowl. Pour marinade over chicken, cover dish or bowl, and refrigerate to marinate, at least 2 hours, or up to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to broil or preheat grill to medium-high heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from marinade (disposing of any leftover marinade) and grill or broil 6 inches from the heat source until chicken is cooked through and no longer pink inside, about 7 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
