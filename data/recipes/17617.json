  "ingredients": [
    "1 (12 ounce) package vanilla wafers, crushed",
    "1 cup whipping cream",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup confectioners' sugar",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Crumble cookies into a 9x9 inch pan and set aside. In a medium bowl, whip cream and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate mixing bowl, whip together cream cheese and confectioners' sugar until smooth and fluffy. Fold whipped cream into cream cheese mixture and spoon over crumbled cookies. Spread pie filling over top and refrigerate overnight.",
