  "ingredients": [
    "2 eggs",
    "2 egg yolks",
    "1 tablespoon all-purpose flour",
    "1 (15 ounce) can pumpkin puree",
    "1 cup half-and-half",
    "1 cup milk",
    "0.5 cup white sugar",
    "1 teaspoon salt",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter six custard cups or ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix eggs, egg yolks, and flour together in a bowl until smooth. Whisk pumpkin puree, half-and-half, milk, sugar, salt, vanilla extract, cinnamon, nutmeg, and ginger into egg mixture until smooth; spoon into prepared custard cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange custard cups onto a large baking pan. Pour enough water around the custard cups to fill pan halfway.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until custards are set but still jiggle in the middle, about 40 minutes. Serve at room temperature or chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
