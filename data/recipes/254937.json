  "ingredients": [
    "1.5 cups whole wheat flour",
    "0.5 cup oats",
    "0.5 cup brown sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "0.75 cup applesauce",
    "6 ounces Greek yogurt",
