  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, oats, brown sugar, baking powder, and salt in a large bowl; stir in applesauce, yogurt, 1/4 cup skim milk, vegetable oil, and egg. If the dough us a bit too dry, add extra milk 1 tablespoon at a time. Batter should be about the consistency of a thick oatmeal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold blueberries and walnuts into the batter. Spoon into prepared muffin cups until almost full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into the center comes out clean, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
