  "ingredients": [
    "cooking spray",
    "2 (4 ounce) packages crushed buttery round crackers (such as Ritz®)",
    "0.5 cup chopped parsley",
    "5 saltine crackers, crushed",
    "0.5 teaspoon celery salt",
    "1 clove minced garlic",
    "4 sea scallops, chopped",
    "0.5 cup chopped imitation crabmeat",
    "0.25 cup butter, melted",
    "0.25 cup white cooking wine",
    "20 jumbo shrimp, peeled and deveined"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Coat a baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HdevzljReg68j8EU_m7GBaecpXg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/267033-baked-stuffed-shrimp-recipe-VAT-Step-01-9db3c5fa5c0f41fb9246799b4d56e20a.jpg"
      ],
      "image": "assets/images/267033/step_01.webp"
    },
    {
      "text": "Mix crushed round crackers, parsley, saltines, celery salt, and garlic in a large bowl. Add scallops, crabmeat, melted butter, and wine; mix stuffing well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bHUFMAjXwf-w8Xr9UBd-ahuXRpQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/267033-baked-stuffed-shrimp-recipe-VAT-Step-02-8350b0111a73422baae12571ebd2daa6.jpg"
      ],
      "image": "assets/images/267033/step_02.webp"
    },
    {
      "text": "Place a shrimp on a flat work surface. Slice horizontally through the middle, careful not to cut through to the other side. Open the 2 sides and spread them out like an open book. Repeat with remaining shrimp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NCP4hsPT6iCjSl66I7opsJfguPg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/267033-baked-stuffed-shrimp-recipe-VAT-Step-03-c5ec787fee1d44d58bb6592d015903c7.jpg"
      ],
      "image": "assets/images/267033/step_03.webp"
    },
    {
      "text": "Stuff each shrimp with a heaping tablespoon stuffing and place back-side up in the prepared baking dish. Add 1 to 2 tablespoons water to the bottom of the baking dish to keep shrimp moist during baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qfLmhHpDiwalSFADE7PmOtpFMyg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/267033-baked-stuffed-shrimp-recipe-VAT-Step-04-7d8818f6da1b455f80ce2abe24d10cb2.jpg"
      ],
      "image": "assets/images/267033/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until shrimp are opaque and stuffing begins to brown, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TXH33EDWEc3ZiY6axBcTdGF86eY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/267033-baked-stuffed-shrimp-recipe-VAT-Step-05-49e998375a834b898ef59e001d800d16.jpg"
      ],
      "image": "assets/images/267033/step_05.webp"
    }
  ],
