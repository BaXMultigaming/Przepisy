  "ingredients": [
    "1 teaspoon vegetable oil",
    "1 onion, chopped",
    "3 cloves garlic, chopped",
    "0.75 cup quinoa",
    "1.5 cups vegetable broth",
    "1 teaspoon ground cumin",
    "0.25 teaspoon cayenne pepper",
    "salt and ground black pepper to taste",
    "1 cup frozen corn kernels",
    "2 (15 ounce) cans black beans, rinsed and drained",
    "0.5 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VQ7KyGvemearhGNAVMessgNwSOM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/49552_Quinoaandblackbeans_ddmfs_step1_4x3_2704-b2fad467430a41e880e2419c41849bc2.jpg"
      ],
      "image": "assets/images/49552/step_01.webp"
    },
    {
      "text": "Heat oil in a large saucepan over medium heat. Add onion and garlic; cook and stir until lightly browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cI3GoZzBuOsENxLqvWOAZ2s60hE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/49552_Quinoaandblackbeans_ddmfs_step2_4x3_2717-ce682cc0fa034d83853af194f5a0a736.jpg"
      ],
      "image": "assets/images/49552/step_02.webp"
    },
    {
      "text": "Mix quinoa into onion mixture and cover with vegetable broth; season with cumin, cayenne pepper, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZC3zl8UZQ3sxTTyEP_N0Avf6vsE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/49552_Quinoaandblackbeans_ddmfs_step3_4x3_2719-e07dc6ef9fc244db9b4b034f327a0668.jpg"
      ],
      "image": "assets/images/49552/step_03.webp"
    },
    {
      "text": "Bring to a boil; cover, reduce heat, and simmer until quinoa is tender and broth is absorbed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D_T3ihcnuQJNi4vzaG-CVoWcAxA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/49552_Quinoaandblackbeans_ddmfs_step4_4x3_2723-5fd396a851c84d8b8fe5d5d8424aefbe.jpg"
      ],
      "image": "assets/images/49552/step_04.webp"
    },
    {
      "text": "Stir in frozen corn and continue to simmer until heated through, about 5 minutes. Mix in black beans and cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x2kENDwDQQdWG3Srz0ExMWTID64=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/49552_Quinoaandblackbeans_ddmfs_4x3_2745-46315412dc4f42fab1296ebee4765507.jpg"
