  "ingredients": [
    "1 cup white wine",
    "1 tablespoon butter",
    "1 tablespoon all-purpose flour",
    "7 ounces Gruyere cheese, cubed",
    "7 ounces sharp Cheddar cheese, cubed",
    "7 ounces Emmentaler cheese, cubed"
  ],
  "steps": [
    {
      "text": "Heat wine in a small saucepan over low heat until simmering.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N0cKNKPn_skh732_VBXS3ti5YLI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/45657-best-formula-three-cheese-fondue-VAT-step-01-2f2757322aeb4f2e9940de12f570f59f.jpg"
      ],
      "image": "assets/images/45657/step_01.webp"
    },
    {
      "text": "Meanwhile, melt butter in a medium saucepan over medium-low heat. Whisk in flour until a thick paste forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c-OGuw2eKcq353dkTOJGwT0bnfU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/45657-best-formula-three-cheese-fondue-VAT-step-02-e8f3c7aabae2438c94fbc92464a9886d.jpg"
      ],
      "image": "assets/images/45657/step_02.webp"
    },
    {
      "text": "Whisk in wine until mixture is smooth. Gradually stir in Gruyère, Cheddar, and Emmentaler cheese until melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_sRWZJQf_wBDS3K9CxRpFkMGZtk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/45657-best-formula-three-cheese-fondue-VAT-step-03-1a464589f3774eb7bae7e6432f8d8f09.jpg"
      ],
      "image": "assets/images/45657/step_03.webp"
    },
    {
      "text": "Transfer cheese mixture into fondue pot. Keep warm over a low flame.",
      "section": null,
      "name": null,
