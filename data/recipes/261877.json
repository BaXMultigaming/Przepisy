  "ingredients": [
    "1 tablespoon flaxseed meal",
    "2 tablespoons lukewarm water",
    "2 cups all-purpose flour",
    "1.5 cups white sugar",
    "1 tablespoon ground cinnamon",
    "1.5 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 pinch salt",
    "4 overripe bananas, mashed",
    "0.5 cup vegetable oil",
    "0.33333334326744 cup unsweetened soy milk",
    "1.5 teaspoons vanilla extract",
    "0.25 cup chopped walnuts",
    "0.25 cup raisins"
  ],
  "steps": [
    {
      "text": "Combine flaxseed meal and water in a cup and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a fluted tube pan (such as Bundt®) and dust with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, cinnamon, baking powder, baking soda, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bananas, oil, soy milk, and vanilla extract in a second bowl. Add flaxseed mixture and stir to combine. Fold in flour mixture in batches, but do not overmix. Fold in nuts and raisins. Fill batter into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick comes out clean, 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
