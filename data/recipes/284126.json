  "ingredients": [
    "1 tablespoon canola oil",
    "1 pound turkey sausage links, chopped",
    "1 (10 ounce) can diced tomatoes and green chiles (such as RO*TEL®)",
    "8 ounces campanelle pasta",
    "2 cups low-sodium chicken broth",
    "0.5 cup Greek yogurt",
    "1 tablespoon onion powder",
    "1 teaspoon garlic powder",
    "0.5 teaspoon ground black pepper",
    "1 cup shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Add sausage, diced tomatoes and green chiles, campanelle, chicken broth, Greek yogurt, onion powder, garlic powder, and pepper. Stir and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low, cover, and simmer until pasta is tender yet firm to the bite, 15 to 20 minutes. Remove from the heat and stir in 1/2 of the Monterey Jack cheese. Sprinkle remaining cheese on top and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
