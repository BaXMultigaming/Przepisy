  "ingredients": [
    "3 eggs",
    "1 tablespoon cider vinegar",
    "0.25 cup olive oil",
    "0.25 cup honey",
    "1.5 cups buttermilk, at room temperature",
    "1 teaspoon salt",
    "1 tablespoon xanthan gum",
    "0.33333334326744 cup cornstarch",
    "0.5 cup potato starch",
    "0.5 cup soy flour",
    "2 cups white rice flour",
    "1 tablespoon active dry yeast"
  ],
