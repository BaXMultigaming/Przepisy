  "ingredients": [
    "1 (2 pound) spaghetti squash, halved and seeded",
    "0.5 cup butter, cut into 10 equal pieces",
    "0.25 cup brown sugar, divided",
    "2 tablespoons ground cinnamon, divided"
  ],
  "steps": [
    {
      "text": "Preheat toaster oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place spaghetti squash halves on a compact baking sheet. Place 5 pieces of butter into each half. Sprinkle 2 tablespoons brown sugar and 1 tablespoon cinnamon over each half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until soft, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove squash from oven and scrape insides with a fork into a loose pile of strands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake until flavors combine, about 10 minutes more. Let cool before serving, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
