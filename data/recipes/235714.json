  "ingredients": [
    "0.25 cup balsamic vinegar",
    "1 tablespoon finely chopped dried cranberries",
    "1 teaspoon white sugar",
    "1 teaspoon Dijon mustard",
    "0.5 teaspoon salt",
    "1 clove garlic, peeled and smashed",
    "freshly ground black pepper",
    "0.5 cup extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "Whisk vinegar, cranberries, sugar, mustard, salt, garlic, and pepper together in a bowl until the sugar and salt are completely dissolved. Stream oil into the mixture while whisking continually; continue whisking until the oil emulsifies into the vinegar.",
