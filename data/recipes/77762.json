  "ingredients": [
    "1 pound lean ground beef",
    "1 tablespoon toasted sesame seeds",
    "2 (10.5 ounce) cans beef consomme",
    "2 cups water",
    "2 cups fresh bean sprouts",
    "0.25 cup diced red bell pepper",
    "0.5 cup sliced fresh mushrooms",
    "4 green onions, diced"
