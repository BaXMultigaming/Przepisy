  "ingredients": [
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 (10.75 ounce) can water",
    "1 cup mushrooms, diced",
    "1 packet dry onion soup mix",
    "2 tablespoons vegetable oil",
    "4 pork chops"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mushroom soup, water, mushrooms, and onion soup mix in a medium bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium-high heat. Add pork chops and cook until until browned on both sides, about 3 to 4 minutes per side. Transfer to a 9x9-inch baking dish and cover with mushroom soup mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 1/2 hours, or until internal pork temperature reaches 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
