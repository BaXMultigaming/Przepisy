  "ingredients": [
    "1 tablespoon salt",
    "1 (3 pound) whole chicken, cut into pieces",
    "0.5 cup lemon juice",
    "1 cup grated fresh coconut",
    "1 hot chile pepper, minced"
  ],
  "steps": [
    {
      "text": "Sprinkle chicken with salt and place pieces on a broiler pan. Broil for about 10 minutes, turn and broil for another 5 minutes or until chicken is cooked, but still moist.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bone, and finely chop cooked chicken pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl combine the chicken, lemon juice, coconut, and hot peppers. Chill for at least one hour and serve.",
