  "ingredients": [
    "2 cups whole wheat flour",
    "2 teaspoons baking soda",
    "1 teaspoon pumpkin pie spice",
    "0.5 teaspoon salt",
    "0.5 cup vanilla yogurt",
    "0.25 cup vegetable oil",
    "0.33333334326744 cup honey",
    "1 teaspoon vanilla extract",
    "2 tablespoons orange juice",
    "1 cup carrot, peeled and shredded",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease 14 muffin cups, or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, pumpkin pie spice, and salt in a bowl. Whisk together yogurt, vegetable oil, honey, vanilla extract, and orange juice in a separate bowl. Gently fold carrots into the yogurt mixture. Stir yogurt mixture into the flour mixture until just combined. Gently fold raisins into the batter. Scoop batter into prepared muffin cups until nearly full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 12 to 13 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
