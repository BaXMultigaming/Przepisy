  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 390 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat Cornish hen dry with paper towels and season with salt and pepper on all sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place hen into the air fryer basket and cook in the preheated air fryer for 15 minutes. Spray the top with nonstick spray and cook until no longer pink at the bone and the juices run clear, about 15 more minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer hen to a cutting board and let rest for 10 minutes. Carve and serve.",
