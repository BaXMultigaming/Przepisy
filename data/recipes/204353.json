  "ingredients": [
    "1 (16 ounce) package Hillshire Farm® Smoked Sausage",
    "1 (10.75 ounce) can cream of mushroom soup",
    "2.5 cups milk",
    "8 ounces uncooked penne pasta",
    "1.5 cups French-fried onions, divided",
    "1 cup shredded Cheddar cheese, divided",
    "1 cup frozen peas"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F. Cut sausage into 1/4-inch slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat for 3 minutes. Add sausage; cook and stir for 3 to 4 minutes or until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soup and milk in a 13x9-inch baking dish. Stir in uncooked pasta, sausage, 1/2 cup French-fried onions, 1/2 cup cheese and peas. Cover baking dish tightly with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 45 minutes. Remove foil and top with remaining 1 cup French-fried onions and 1/2 cup cheese. Bake for 3 minutes or until cheese is melted. Let stand 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
