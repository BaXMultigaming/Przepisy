  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.75 cup white sugar",
    "0.5 cup vegan margarine (such as Earth Balance®)",
    "1 teaspoon vanilla extract",
    "2 tablespoons coconut milk"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/41tkBUalx2-GFh84RaC446jyQM8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261803-perfect-vegan-sugar-cookies-ddmfs-step1-3x4-11522-9489d2c3717d4b1bbcd38e8667bfaeb1.jpg"
      ],
      "image": "assets/images/261803/step_01.webp"
    },
    {
      "text": "Sift flour, baking soda, and salt into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/peqCIqRbTzXyOgDXmC6Qbq0ly9c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261803-perfect-vegan-sugar-cookies-ddmfs-step3-3x4-11526-27431e1d4c224cdba5daf8399145dfdd.jpg"
      ],
      "image": "assets/images/261803/step_02.webp"
    },
    {
      "text": "Beat sugar and vegan margarine in a mixing bowl with an electric mixer until creamy, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vgE7ebGbJvvU5mwPJvNr-7UAT-w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261803-perfect-vegan-sugar-cookies-ddmfs-step4-3x4-11533-ba645c0e624c4b2499af225b211fb728.jpg"
      ],
      "image": "assets/images/261803/step_03.webp"
    },
    {
      "text": "Mix in vanilla. Stir in flour mixture until incorporated, then add coconut milk, 1 tablespoon at a time, until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uK8gS1_k95D1TaRvLwFFT3krKHo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261803-perfect-vegan-sugar-cookies-ddmfs-step5-3x4-11537-f726f5f048c54186b644d8e27645e963.jpg"
      ],
      "image": "assets/images/261803/step_04.webp"
    },
    {
      "text": "Wrap dough in plastic wrap and refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M0ePf78Y-CPbgyMuLog_RYoc7nY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261803-perfect-vegan-sugar-cookies-ddmfs-step6-3x4-11538-fc75feaca9034aef9ef34aac5204d65e.jpg"
      ],
      "image": "assets/images/261803/step_05.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gN890yyQAxE4K9ucFI6mzTfwrwQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261803-perfect-vegan-sugar-cookies-ddmfs--f897171372b54d3e846198426ee9bee9.jpg"
      ],
      "image": "assets/images/261803/step_06.webp"
    },
    {
      "text": "Roll chilled dough on a floured surface to a thickness of 1/4 to 1/2 inch. Dip a cookie cutter in flour and cut out cookies, re-flouring as needed. Place cookies onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5lOgHdE8q6HkcAEjIZVrkt51-Rg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261803-perfect-vegan-sugar-cookies-ddmfs-step8-3x4-11573-7339431b3f874dd6bb4927557476e0a3.jpg"
      ],
      "image": "assets/images/261803/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until just turning golden, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W_FFds1OD8D1zG38tG8LwC1rLbA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261803-perfect-vegan-sugar-cookies-ddmfs-step9-3x4-11575-ae6f53f58afb4a06ad6c8312cf25aa7b.jpg"
      ],
      "image": "assets/images/261803/step_08.webp"
    }
