  "ingredients": [
    "0.25 cup olive oil",
    "2 tablespoons minced garlic, or more to taste",
    "1.5 cups 2% milk",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "2 teaspoons water",
    "0.5 teaspoon cornstarch"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a saucepan over medium-low heat. Add garlic, cook and stir until fragrant, 1 to 2 minutes. Add milk, salt, and pepper; stir constantly until simmering, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk water and cornstarch together in a bowl until smooth. Add water-cornstarch mixture to sauce; stir continuously until sauce is thickened to desired consistency, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
