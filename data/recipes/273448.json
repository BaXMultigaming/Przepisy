  "ingredients": [
    "0.5 stick butter",
    "2 cups converted long-grain white rice",
    "1 (32 fluid ounce) container chicken broth",
    "0.5 lemon, juiced",
    "1 teaspoon salt",
    "3 bay leaves"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S0dTDyLS0207G30kYdT9Ra2Txo0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-273448-my-moms-greek-lemon-rice-VAT-step-01-badcd6801fd64490b389d727f4556573.jpg"
      ],
      "image": "assets/images/273448/step_01.webp"
    },
    {
      "text": "Melt butter in a pot over low heat. Pour in rice and stir to coat in butter. Let simmer on low heat, stirring occasionally, until toasted but not burnt, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uqA-i3rdjgGDULuVgLmRKLak6fA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-273448-my-moms-greek-lemon-rice-VAT-step-02-352da1192371452f99fb385f654a41f1.jpg"
      ],
      "image": "assets/images/273448/step_02.webp"
    },
    {
      "text": "Pour chicken broth, lemon juice, salt, and bay leaves into rice mixture. Bring to a rapid boil; continue to boil for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ncaVb1EgTD3_QFUDiWClc-I3v3w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-273448-my-moms-greek-lemon-rice-VAT-step-03-1d2381ba95914202b0247b12badd94ca.jpg"
      ],
      "image": "assets/images/273448/step_03.webp"
    },
    {
      "text": "Reduce heat to a simmer, cover, and let simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VkLE3Ed15OUA3p3Y2HcJy61cGWY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-273448-my-moms-greek-lemon-rice-VAT-step-04-A-f5c4bb860aae41b58913b0dd52fe20fd.jpg"
      ],
      "image": "assets/images/273448/step_04.webp"
    },
    {
      "text": "Remove from heat and let sit, covered, for 10 minutes. Fluff with a fork and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Dly6GoM4paMrjgFT7wOqmsrNwpc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-273448-my-moms-greek-lemon-rice-VAT-step-05-cd5ed47e0c8b474eb0733c47c07f5113.jpg"
      ],
      "image": "assets/images/273448/step_05.webp"
    }
