  "ingredients": [
    "1 (15 ounce) can chickpeas, drained",
    "0.25 cup water",
    "2 tablespoons tahini",
    "1 tablespoon fresh lime juice, or to taste",
    "1 teaspoon sea salt, or to taste",
    "1 clove garlic, roughly chopped",
    "0.5 teaspoon ground cumin",
    "1.5 large ripe avocados, pitted and peeled",
    "1 bunch spinach leaves",
    "2 tablespoons extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "Place chickpeas, water, tahini, lime juice, salt, garlic, and cumin in a food processor. Puree until smooth, about 2 minutes. Add avocados, spinach, and olive oil; puree until creamy, 2 to 3 minutes.",
