  "ingredients": [
    "3 egg yolks",
    "1 tablespoon lemon juice",
    "0.25 teaspoon Dijon mustard",
    "1 dash hot pepper sauce (e.g. Tabasco™)",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M4KOgu-vk2ijuDTVStNjDyOoXGY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/84214-blender-hollandaise-sauce-ddmfs-4x3-01-9fc8c8d3888349fa9949dabcbf713bf0.jpg"
      ],
      "image": "assets/images/84214/step_01.webp"
    },
    {
      "text": "Combine egg yolks, lemon juice, mustard, and hot pepper sauce in the container of a blender; cover and blend for about 5 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I-L6cKsjGA2PRR6LaL4rctsraCE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/84214-blender-hollandaise-sauce-ddmfs-4x3-02-356542d4ad4d4fd49f9093db5641b27e.jpg"
      ],
      "image": "assets/images/84214/step_02.webp"
    },
    {
      "text": "Place butter in a glass measuring cup. Heat butter in the microwave for about 1 minute, or until hot and completely melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PLlRE3ZhX_Yy8kIIJboi0t7-oy0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/84214-blender-hollandaise-sauce-ddmfs-4x3-03-4cf5fe98b2394f688c14d7e7c75dcbd4.jpg"
      ],
      "image": "assets/images/84214/step_03.webp"
    },
    {
      "text": "Turn the blender on; pour melted butter in a slow, steady stream until sauce is thick and smooth, about 15 to 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FfVx3yHRigZ99TqNotax2QGpcN8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/84214-blender-hollandaise-sauce-ddmfs-4x3-04-6d5914ee46c54785b4ac5268ecf2a528.jpg"
      ],
      "image": "assets/images/84214/step_04.webp"
    },
    {
      "text": "Serve and enjoy!",
