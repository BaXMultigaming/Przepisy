  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, pudding mix, eggs, water, and oil in a large bowl. Beat at medium speed for 2 minutes. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 50 to 60 minutes. Let cake cool in pan for 10 minutes then remove from pan and let cool completely.",
