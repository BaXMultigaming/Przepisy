  "ingredients": [
    "2 teaspoons olive oil",
    "4 garlic cloves, minced",
    "2 tablespoons butter",
    "3 cups chicken broth, or more as needed",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon salt",
    "0.5 pound spaghetti",
    "1 cup grated Parmesan cheese",
    "0.75 cup heavy cream",
    "1.5 tablespoons dried parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QXmfg5iZBelrOf_tDU4_KP5ZROQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-269500-creamy-garlic-pasta-Step-01-a57244d2b85a44bb95bf39bf1e70d51f.jpg"
      ],
      "image": "assets/images/269500/step_01.webp"
    },
    {
      "text": "Heat olive oil in a medium pan over medium heat. Add garlic and stir until fragrant, 1 to 2 minutes. Add butter and stir constantly until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VjjM_1Lj7mLoqmvVhKB-TuIYSPg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-269500-creamy-garlic-pasta-Step-03-377d445d11bb4945b11c8bddd4431136.jpg"
      ],
      "image": "assets/images/269500/step_02.webp"
    },
    {
      "text": "Pour in 3 cups chicken broth; add pepper and salt. Bring to a boil. Add spaghetti and cook, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Add more chicken broth if pasta starts to stick to the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Nm74a4gBA38VKnpWZE2clokjoNU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-269500-creamy-garlic-pasta-Step-05-3a483b939f5f45c6bf67a1d1874f88e4.jpg"
      ],
      "image": "assets/images/269500/step_03.webp"
    },
    {
      "text": "Add Parmesan cheese, cream, and parsley and mix until thoroughly combined. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IrY572TXic4UXXVn8EetsarI3S0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-269500-creamy-garlic-pasta-Beauties-4x3-f404628aad2a435a9985b2cf764209b5.jpg"
      ],
