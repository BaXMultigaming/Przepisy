  "ingredients": [
    "4 potatoes, peeled and sliced",
    "0.5 cup chopped onion",
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "2 teaspoons salt",
    "1.5 cups milk",
    "0.5 teaspoon dried parsley, or to taste",
    "1 pinch ground paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes, onion, and butter in a large microwave-safe dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and salt in a bowl; sprinkle over potatoes and gently toss until vegetables are coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk over the potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the microwave on high setting until potatoes are tender, about 15 minutes, stirring every 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow potatoes to rest for 5 minutes before sprinkling with parsley and paprika for serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
