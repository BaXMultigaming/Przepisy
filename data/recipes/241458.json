  "ingredients": [
    "1 tablespoon canola oil",
    "1 teaspoon cumin seeds",
    "1 red onion, chopped",
    "5 cloves garlic, minced",
    "1 tablespoon coriander seeds, ground",
    "1 (15 ounce) can chickpeas (garbanzo beans), drained and rinsed, or more to taste",
    "1 cup water",
    "1 red potato, cubed",
    "2 tablespoons minced fresh cilantro, divided",
    "0.5 teaspoon salt",
    "0.5 teaspoon coarsely ground black pepper",
    "1 tomato, cubed"
  ],
  "steps": [
    {
      "text": "Heat oil in a large saucepan over medium-high heat; saute cumin seeds for 10 seconds. Add onion and garlic; saute until onion is dark brown, 5 to 8 minutes. Add coriander; cook and stir for 20 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chickpeas, water, potato, 1 teaspoon cilantro, salt, and pepper into onion mixture; bring to a boil. Reduce heat to low, cover saucepan, and simmer until potato is tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomato into chickpea stew; increase heat to medium and simmer until heated through, 1 to 2 minutes. Sprinkle remaining cilantro over stew.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
