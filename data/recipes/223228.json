  "ingredients": [
    "vegetable oil for frying",
    "1 cup all-purpose flour",
    "0.5 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.25 cup milk",
    "2 eggs, beaten",
    "2 cups Italian seasoned bread crumbs",
    "8 walleye fillets"
  ],
  "steps": [
    {
      "text": "Heat 1/8 inch of vegetable oil in two large cast-iron or heavy-duty frying pans over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange three separate pie plates or shallow bowls for breading the fish. Combine flour, salt and pepper in one bowl, milk and eggs in another, and bread crumbs in the third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat each fillet in the flour mixture, then dredge them in egg wash, then coat them well with bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 4 fillets in each frying pan. Cook until golden brown, about 5 to 7 minutes per side. Drain on paper towels and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
