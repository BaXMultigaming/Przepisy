  "ingredients": [
    "1 cup graham cracker crumbs",
    "3 tablespoons white sugar",
    "3 tablespoons butter",
    "2 (8 ounce) packages cream cheese",
    "1.25 cups white sugar",
    "3 tablespoons cornstarch",
    "1 (16 ounce) container sour cream",
    "1.5 teaspoons vanilla extract",
    "5 tablespoons amaretto liqueur",
    "0.5 teaspoon salt",
    "4 eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together graham cracker crumbs and 3 tablespoons white sugar. Add melted butter and mix well. Press into the bottom of a 9-inch springform pan. Bake in preheated oven for 10 minutes, set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine cream cheese, sugar, and cornstarch, and mix until smooth. Add sour cream, vanilla, amaretto liqueur, and salt. Mix until well blended. On low speed of an electric mixer, add eggs one at a time, mixing well after each addition. Pour batter over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Remove from oven. Loosen around edges with a knife and cool on a wire rack while still in pan. Refrigerate for at least 4 hours; remove from pan when completely chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
