  "ingredients": [
    "1 (16 ounce) package pound cake mix",
    "1 egg",
    "2 tablespoons butter, melted",
    "2 teaspoons pumpkin pie spice",
    "1 (8 ounce) package cream cheese, softened",
    "1 (16 ounce) can pumpkin puree",
    "1 (14 ounce) can sweetened condensed milk",
    "2 eggs",
    "2 teaspoons pumpkin pie spice",
    "0.5 teaspoon salt",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cake mix, 1 egg, butter, and 2 teaspoons pumpkin pie spice on low with an electric mixer in a large bowl until crumbly. Press mixture into the bottom of a 10x15-inch jelly roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese in another bowl with an electric mixer until fluffy. Gradually beat in pumpkin puree, sweetened condensed milk, 2 eggs, 2 teaspoons pumpkin pie spice, and salt until smooth. Pour pumpkin mixture over cake mix crust and sprinkle with walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until set, 30 to 35 minutes. Allow to cool to room temperature and refrigerate until chilled. Cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
