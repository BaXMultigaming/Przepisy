  "title": "Yummy Pumpkin Cheesecake Bars",
  "description": "Pound cake mix makes a dense and moist crust for this creamy and smooth pumpkin cheesecake bar.",
  "authors": [
    "Kathy Scholz"
  ],
  "date_published": "2018-06-08T10:07:01-04:00",
