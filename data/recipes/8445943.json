  "title": "Make-Ahead Freezer Breakfast Burritos",
  "description": "Make these vegetarian breakfast burritos ahead and freeze for an easy, on-the-go meal that's warmed in a microwave when ready to serve.",
  "authors": [
    "Maren Ellingboe King"
  ],
  "date_published": "2022-08-24T15:32:06-04:00",
