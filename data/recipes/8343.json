  "ingredients": [
    "2 (21 ounce) cans apple pie filling",
    "1 tablespoon white sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground allspice",
    "1 (18.25 ounce) package spice cake mix",
    "0.75 cup butter",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour apple pie filling into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, cinnamon, nutmeg, and allspice together in a small bowl until well combined; sprinkle over pie filling. Cover filling with dry cake mix; dot with butter, then scatter pecans on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is browned and filling bubbles on the sides, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
