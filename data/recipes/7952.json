  "title": "Carol&#39;s Butter Pecan Cake",
  "description": "This butter pecan cake is a rich 3-layer cake made from scratch with sweet buttery frosting and chopped pecans in every bite.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-06-19T11:34:39-04:00",
