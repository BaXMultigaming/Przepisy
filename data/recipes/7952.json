  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1.25 cups butter",
    "2 cups chopped pecans",
    "3 cups sifted all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "2 cups white sugar",
    "4 eggs",
    "1 cup milk",
    "2 teaspoons vanilla extract",
    "0.25 cup butter",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "4 cups sifted confectioners' sugar",
    "0.33333334326744 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour three 9-inch layer pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IJPPVANMAsW6tmzGS5bSiOILjt4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7952-carols-butter-pecan-cake-DDMFS-01-14671-90956da654a3474f9456445b9a03dd6c.jpg"
      ],
      "image": "assets/images/7952/step_01.webp"
    },
    {
      "text": "Melt 1/4 cup butter in a heavy skillet over medium heat. Add pecans; cook and stir until browned, 10 to 15 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M8C7WOO4vN7onIhKdU0TtbuesCI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7952-carols-butter-pecan-cake-DDMFS-02-14679-66c8ccc4f41e4ddcaf7fad2c275deefe.jpg"
      ],
      "image": "assets/images/7952/step_02.webp"
    },
    {
      "text": "Sift flour, baking powder, and 1/2 teaspoon salt; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xwWkV3klujXgyVTh22fX0JLarA8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7952-carols-butter-pecan-cake-DDMFS-03-14673-c68f3f839f9c44978622de2774fab399.jpg"
      ],
      "image": "assets/images/7952/step_03.webp"
    },
    {
      "text": "Cream 1 cup butter and 2 cups white sugar in a large mixing bowl until light and fluffy. Blend in eggs, one at a time, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l28ybmgSzmhN_py_VBTiGKxQK94=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7952-carols-butter-pecan-cake-DDMFS-03-14675-c9a1c1c75b7d44b097f13038fe495d5e.jpg"
      ],
      "image": "assets/images/7952/step_04.webp"
    },
    {
      "text": "Add flour mixture alternately with milk and vanilla extract, beginning and ending with dry ingredients. Blend well after each addition. Fold in 1 1⁄3 cups of the pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MNwfOCV-p0MfD-mmbV9JX_aL70U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7952-carols-butter-pecan-cake-DDMFS-05-14681-dcfe2a22aa964bff93fa92e365b6caa3.jpg"
      ],
      "image": "assets/images/7952/step_05.webp"
    },
    {
      "text": "Pour batter into the prepared pans. Bake in the preheated oven until cake is golden brown and springs back when lightly touched in center, 25 to 30 minutes. Allow cakes to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y4W6mX7ifWl5Zx1AlzeODre8FKw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7952-carols-butter-pecan-cake-DDMFS-06-14738-60ef31696894441a822364a70abdc019.jpg"
      ],
      "image": "assets/images/7952/step_06.webp"
    },
    {
      "text": "To make the pecan frosting: Beat 1/4 cup butter in a mixing bowl until light and fluffy. Add 1 teaspoon vanilla extract, 1/4 teaspoon salt, 4 cups confectioners' sugar, and 1/3 cream; beat until smooth and spreadable, adding more cream if needed. Fold in remaining 2/3 cup pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/04ggY-cu7U-z1gQxfzstvhWM5vU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7952-carols-butter-pecan-cake-DDMFS-07-14685-338a026471284d48869fdc93c001dbe8.jpg"
      ],
      "image": "assets/images/7952/step_07.webp"
    },
    {
      "text": "Spread frosting between layers of cooled cake and on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iL9ftMwV7Sz0h2SPo0ewwwpCt2Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7952-carols-butter-pecan-cake-DDMFS-08-14689-f8f57654376c404f983962a3e958166c.jpg"
      ],
      "image": "assets/images/7952/step_08.webp"
    }
  ],
