  "ingredients": [
    "3 cups all-purpose flour",
    "1 cup raisins",
    "0.5 cup white sugar",
    "2 tablespoons white sugar",
    "1 tablespoon caraway seeds",
    "1 tablespoon baking powder",
    "1 teaspoon salt",
    "0.25 teaspoon baking soda",
    "1.75 cups buttermilk",
    "1 egg",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, raisins, 1/2 cup plus 2 tablespoons sugar, caraway seeds, baking powder, salt, and baking soda in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk buttermilk and egg together in a small bowl. Stir into flour mixture. Fold butter into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 30 minutes.",
