  "ingredients": [
    "1 (750 milliliter) bottle red wine",
    "0.5 cup rum",
    "1 pint strawberries, hulled and sliced",
    "1 orange, sliced in rounds",
    "1 lemon, sliced",
    "1 lime, sliced",
    "9 whole cloves",
    "1 apple, cored and sliced",
    "1 liter lemon-lime flavored carbonated beverage"
  ],
  "steps": [
    {
      "text": "Combine wine and rum in a large pitcher; add strawberries, orange, lemon, and lime. Push cloves into apple slices; add to pitcher. Cover the pitcher with plastic wrap; refrigerate 4 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and discard cloves from apple slices; return apples to pitcher.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill tall glasses halfway with sangria mixture; top off with soda and gently stir. Garnish with marinated fruit; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
