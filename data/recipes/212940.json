  "ingredients": [
    "2 tablespoons olive oil",
    "1 onion, diced",
    "2 cloves garlic, crushed",
    "1 (2 inch) piece fresh ginger, peeled and thinly sliced",
    "2.25 pounds chicken wings, split and tips discarded",
    "1 tablespoon fish sauce",
    "5.25 cups chicken broth",
    "1 cup glutinous sweet rice",
    "salt and pepper to taste",
    "1 green onion, chopped",
    "1 lemon, sliced",
    "1 teaspoon fish sauce for sprinkling, if desired"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uIV85pRy6pMUv1HpDZFCBDLcGFc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212940-Chicken-Arroz-Caldo-Chicken-Rice-Porridge-ddmfs-step-0-fedc595d7bf64d6dae5c996581e0497c.jpg"
      ],
      "image": "assets/images/212940/step_01.webp"
    },
    {
      "text": "Heat oil in a large pot over medium heat. Cook and stir onion, garlic, and ginger in hot oil until fragrant, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R8OrleaJ8nnJpoxSSZpftNGbKFM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212940-Chicken-Arroz-Caldo-Chicken-Rice-Porridge-ddmfs-step-1-fc572a35cfa842109a7cf9a78f8bc9fb.jpg"
      ],
      "image": "assets/images/212940/step_02.webp"
    },
    {
      "text": "Add chicken wings; cook and stir for 1 minute. Stir in fish sauce, cover, and cook another 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IC3vcpik4Xl2r3_lqI9WdZgVSd0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212940-Chicken-Arroz-Caldo-Chicken-Rice-Porridge-ddmfs-step-2-1b119268967348eea0ffc7e5349024b7.jpg"
      ],
      "image": "assets/images/212940/step_03.webp"
    },
    {
      "text": "Pour chicken broth into the pot. Stir in sweet rice and bring mixture to a boil. Cover and cook for 10 minutes, stirring occasionally to prevent rice from sticking to the bottom of the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FzCne0UyzySHmfVbanBsrfLWpSw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212940-Chicken-Arroz-Caldo-Chicken-Rice-Porridge-ddmfs-step-3-4d5e73e91e684d2892a1b0446530774b.jpg"
      ],
      "image": "assets/images/212940/step_04.webp"
    },
    {
      "text": "Season with salt and pepper. Portion soup into bowls and garnish with green onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VUlwie4vmbhU1fyP-OHufOLQ6Ho=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212940-Chicken-Arroz-Caldo-Chicken-Rice-Porridge-ddmfs-step-5-c61c4f9adf4f4732b1e3c4d55d9aecb8.jpg"
      ],
      "image": "assets/images/212940/step_05.webp"
    },
    {
      "text": "Serve with lemon slices and additional fish sauce, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bAZ6uxLp1WSsfqp0BzVAVfz7d8s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/212940-Chicken-Arroz-Caldo-Chicken-Rice-Porridge-ddmfs-4x3-694b22859e6848458d30e4276a027ecb.jpg"
