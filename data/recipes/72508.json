  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 medium onion, chopped",
    "2 tablespoons dried oregano",
    "1 tablespoon salt",
    "1 teaspoon ground cumin",
    "2 bay leaves",
    "2 stalks celery, chopped",
    "2 green bell peppers, chopped",
    "2 jalapeno peppers, chopped",
    "3 cloves garlic, chopped",
    "2 (4 ounce) cans chopped green chile peppers, drained",
    "2 (12 ounce) packages vegetarian burger crumbles",
    "3 (28 ounce) cans whole peeled tomatoes, crushed",
    "0.25 cup chili powder",
    "1 tablespoon ground black pepper",
    "1 (15 ounce) can kidney beans, drained",
    "1 (15 ounce) can garbanzo beans, drained",
    "1 (15 ounce) can black beans",
    "1 (15 ounce) can whole kernel corn"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_B1QoT6u1nBdDvirjzhplwr_V2M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/72508-The-Best-Vegetarian-Chili-In-The-World-DDMFS-Step-01-56112a97735249ff88733911517f28bb.jpg"
      ],
      "image": "assets/images/72508/step_01.webp"
    },
    {
      "text": "Heat olive oil in a large pot over medium heat. Stir in onion and season with oregano, salt, cumin, and bay leaves. Cook and stir until onion is tender; stir in celery, green bell peppers, jalapeños, and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e8GjFXjjhKmDr0xHAfdpzLiebLc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/72508-The-Best-Vegetarian-Chili-In-The-World-DDMFS-Step-02-1d39e5c1e0774f80bcec2f65eafdfab8.jpg"
      ],
      "image": "assets/images/72508/step_02.webp"
    },
    {
      "text": "Add green chile peppers and cook until heated through. Stir in vegetarian burger crumbles; reduce heat to low, cover pot, and simmer for 5 minutes",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xYL7N8k8ywJRWjAatcQf_Q0CZmw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/72508-The-Best-Vegetarian-Chili-In-The-World-DDMFS-Step-03-a710c46145f14d50a419de9865ef18f0.jpg"
      ],
      "image": "assets/images/72508/step_03.webp"
    },
    {
      "text": "Stir in tomatoes; season with chili powder and black pepper. Stir in kidney beans, garbanzo beans, and black beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5-ZOxnmrgg9nQPj8Dodzr2HNVBQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/72508-The-Best-Vegetarian-Chili-In-The-World-DDMFS-Step-04-511ab096465b4ba184a8fb3c050d01ce.jpg"
      ],
      "image": "assets/images/72508/step_04.webp"
    },
    {
      "text": "Bring to a boil, reduce heat to low, and simmer for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cXBeHtIPlruFTr6qxoHd9IrJk-E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/72508-The-Best-Vegetarian-Chili-In-The-World-DDMFS-Step-05-56591b1dc3d6474681624637c3d46271.jpg"
      ],
      "image": "assets/images/72508/step_05.webp"
    },
    {
      "text": "Stir in the corn, and continue cooking for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pou7fStwJD0YFJaNlV0aBsOr0bE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/72508-The-Best-Vegetarian-Chili-In-The-World-DDMFS-Step-06-be417370783a4dd0a8dfe2a05ad5fbf5.jpg"
      ],
      "image": "assets/images/72508/step_06.webp"
    },
    {
      "text": "Serve and enjoy.",
