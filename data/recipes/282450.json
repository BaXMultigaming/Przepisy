  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup white sugar",
    "1 large egg, beaten",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "1 (9 inch) unbaked pie crust",
    "1.25 cups chopped pecans",
    "1 cup light corn syrup",
    "3 large eggs",
    "0.25 cup white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, sugar, egg, vanilla extract, and salt for pie together in a bowl until creamy. Spread evenly over the bottom of the unbaked pie crust, then sprinkle pecans evenly over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine corn syrup, eggs, sugar, and vanilla for topping together in a bowl. Beat until smooth. Pour over pecan layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pecan layer is golden brown, 35 to 45 minutes. Let cool on a wire rack. Serve slightly warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
