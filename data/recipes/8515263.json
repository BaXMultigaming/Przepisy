  "ingredients": [
    "cooking spray",
    "2 cups long-grain white rice",
    "2 cups water",
    "1 (15 ounce) can cream of mushroom soup",
    "1 (15 ounce) can cream of chicken soup",
    "0.5 yellow onion, chopped",
    "0.5 red bell pepper, chopped",
    "1 (1-ounce) package onion soup mix",
    "1 teaspoon chopped fresh oregano",
    "4 chicken thighs",
    "1.5 teaspoons all-purpose seasoning"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P7JmlP-E0tfocn8GXmzgaaqZoJA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8515263-no-peek-chicken-DDMFS-step-01-1359-bbfa6c906ba246a08e7a7f6608fb1cad.jpg"
      ],
      "image": "assets/images/8515263/step_01.webp"
    },
    {
      "text": "Whisk uncooked rice, water, chicken soup, mushroom soup, onion, bell pepper, onion soup mix, and oregano in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nwBMGAIrK6-R-I_RRcfQLqB0a1A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8515263-no-peek-chicken-DDMFS-step-02-1361-66474e4410e14f63906bdd848d53c2ce.jpg"
      ],
      "image": "assets/images/8515263/step_02.webp"
    },
    {
      "text": "Pour rice mixture into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EZ1007xIavPwPwDJLMjuheZU1Bs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8515263-no-peek-chicken-DDMFS-step-03-1362-57fdb9add6494c698dbff6cff64c4886.jpg"
      ],
      "image": "assets/images/8515263/step_03.webp"
    },
    {
      "text": "Sprinkle chicken thighs with seasoning salt and arrange on top of rice mixture. Cover dish tightly with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UkhiA5JkwFUJmP-zf-qP4mNHnUw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8515263-no-peek-chicken-DDMFS-step-04-1363-cc1be667ec9446e59288c4577bfabbdc.jpg"
      ],
      "image": "assets/images/8515263/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven, keeping tightly covered, for 1 hour 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
