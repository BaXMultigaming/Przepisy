  "ingredients": [
    "2 ears fresh sweet corn, husks removed",
    "0.5 cup chopped cilantro",
    "1 lime, juiced",
    "0.5 teaspoon ground cumin",
    "1 pinch salt",
    "1 tablespoon olive oil",
    "0.5 head red cabbage, shredded",
    "1 jalapeno pepper, seeded and diced",
    "0.25 cup crumbled queso fresco"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook corn on the preheated grill until charred on all sides, about 15 minutes. Transfer corn to a cutting board; cut kernels from cobs when cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine cilantro, lime, cumin, salt, and black pepper in a large bowl; whisk in olive oil until emulsified.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cabbage, corn, and jalapeño to the bowl; toss to coat. Crumble queso fresco over slaw; toss well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
