  "ingredients": [
    "2 pounds beef short ribs, cut flanken-style",
    "2 tablespoons white sugar",
    "2 tablespoons steak seasoning",
    "0.33333334326744 cup soy sauce",
    "2 tablespoons white vinegar",
    "2 tablespoons maple syrup",
    "1 teaspoon cayenne pepper, or to taste",
    "1 teaspoon sesame oil",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Season short ribs with sugar and steak seasoning; rub over both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk soy sauce, vinegar, maple syrup, 2 teaspoons cayenne pepper, sesame oil, ginger, and red pepper flakes together in a small bowl to make marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour marinade into a large resealable plastic bag. Add short ribs. Seal and let marinate in the refrigerator, 1 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove short ribs from marinade; discard marinade. Grill short ribs until well-browned, about 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
