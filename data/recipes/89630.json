  "ingredients": [
    "1 (16 ounce) package orzo pasta",
    "1 (15 ounce) can chickpeas, rinsed and drained",
    "1 (15 ounce) can kidney beans, rinsed and drained",
    "1 (15 ounce) can black beans, rinsed and drained",
    "1 bunch green onions, chopped",
    "1 small red onion, finely chopped",
    "1 small red bell pepper, chopped",
    "1 small yellow bell pepper, chopped",
    "1 (8.75 ounce) can whole kernel corn, drained",
    "1 cup chopped cilantro leaves",
    "salt to taste",
    "pepper to taste",
    "6 tablespoons canola oil",
    "5 limes, juiced"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook orzo in the boiling water, stirring occasionally until tender yet firm to the bite, about 10 minutes. Drain; transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chickpeas, kidney beans, black beans, green onions, red onion, bell peppers, corn, cilantro, salt, and black pepper to the bowl. Drizzle oil and lime juice over salad, toss to coat. Refrigerate to chill before serving, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
