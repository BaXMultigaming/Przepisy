  "ingredients": [
    "12 large hard-cooked eggs, peeled and chopped",
    "0.5 cup light mayonnaise",
    "0.5 cup low-fat sour cream",
    "0.25 cup real bacon bits",
    "3 tablespoons Dijon mustard",
    "2 tablespoons prepared horseradish",
    "2 tablespoons chopped red onion",
    "0.25 teaspoon paprika",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Mix eggs, mayonnaise, sour cream, bacon bits, Dijon, horseradish, onion, paprika, salt, and pepper together in a bowl until well combined. Serve immediately, or refrigerate until ready to serve.",
