  "ingredients": [
    "3 pounds onions, sliced",
    "0.5 cup butter, melted",
    "7 slices French or Italian bread, cut into 1 inch cubes",
    "4.5 cups chicken broth"
  ],
  "steps": [
    {
      "text": "Place sliced onions and butter into slow cooker, and mix until onions are thoroughly coated. Stir in bread and chicken broth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook on LOW for 10 to 18 hours or on HIGH 4 to 5 hours, stirring occasionally. Stir well during last hour.",
      "section": null,
      "name": null,
      "url": null,
