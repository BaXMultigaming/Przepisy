  "ingredients": [
    "1 (4 ounce) package cream cheese, softened",
    "0.25 cup vanilla yogurt",
    "0.16666667163372 cup white sugar",
    "3 large strawberries, diced",
    "1 (8 ounce) package refrigerated dinner roll dough"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, yogurt, and sugar in a bowl until smooth; fold in strawberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate crescent roll dough into 8 triangles; arrange on a flat work surface. Spoon cream cheese mixture into middle of each triangle; roll dough around filling, starting at the smallest end. Pinch to seal; place in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden-brown, 13 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
