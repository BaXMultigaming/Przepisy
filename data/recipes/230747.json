  "ingredients": [
    "4 large russet potatoes",
    "2 teaspoons vegetable oil",
    "3 tablespoons butter",
    "1 tablespoon minced green onion",
    "salt and freshly ground black pepper to taste",
    "1 pinch cayenne pepper, or to taste",
    "0.5 cup shredded white Cheddar cheese",
    "0.5 cup heavy cream",
    "1 egg yolk",
    "1 tablespoon butter, melted",
    "1 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub potatoes with vegetable oil; place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a paring knife easily inserts into center of a potato, about 1 hour. Cool until easy to handle, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut 1/3 off each potato lengthwise; reserve. Scoop flesh to about 1/8-inch of potato skins; transfer flesh to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine potato flesh, 3 tablespoons butter, and green onion until butter melted; season with salt, black pepper, and cayenne pepper. Stir in Cheddar cheese until melted. Stir in cream and egg yolk until combined; season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 reserved small piece potato skin inside bottom of each larger potato shell. Divide and fill each potato with cheese mixture. Gently press surface of filling with a fork to create texture. Brush tops with 1 tablespoon melted butter; sprinkle with paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown on top, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1Cobb1_i9crR7UIJdGXs9MAJNXM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/959418-4310e229a15544b8815c792d7fda5812.jpg"
      ],
