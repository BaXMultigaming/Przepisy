  "ingredients": [
    "2 whole wheat, Greek-style pita breads",
    "2 tablespoons olive oil",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each pita bread into 8 wedges and brush with olive oil. Sprinkle cinnamon and sugar on top and place wedges on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crispy on the edges and slightly soft in the middle, 12 to 14 minutes; they will harden as they cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve immediately or store in an airtight container after cooling.",
      "section": null,
      "name": null,
