  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook bow tie pasta at a boil, stirring occasionally, until cooked through yet firm to the bite, about 12 minutes; drain. Rinse pasta in cold water until cool; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss pasta, tomatoes, green bell pepper, yellow bell pepper, cucumber, black olives, and celery together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour Italian-style dressing over pasta mixture; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill salad for 20 minutes before serving.",
