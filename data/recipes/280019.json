  "ingredients": [
    "cooking spray",
    "2 large onions, sliced",
    "1 (1.5 ounce) package dry French onion soup mix",
    "1.3333333730698 cups diced cooked bacon",
    "6 large potatoes, peeled and sliced",
    "3.5 cups shredded Cheddar cheese",
    "2.5 cups heavy cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly coat a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 layer sliced onions in the prepared baking dish; sprinkle with some soup mix, 1 layer bacon pieces, 1 layer potato slices, 1 layer cheese, and some cream. Continue layering onions, soup mix, bacon pieces, potato slices, cheese, and cream, ending with a cheese layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat a piece of aluminum foil with cooking spray; cover the baking dish with foil, coated-side down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes and onions are tender, 40 to 50 minutes. Remove foil; continue baking until nicely browned and bubbly, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
