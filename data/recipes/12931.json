  "ingredients": [
    "9 cups chicken broth",
    "6 cloves roasted garlic",
    "0.5 cup chopped tomatoes",
    "0.5 yellow onion, chopped",
    "2 fresh jalapeno peppers, sliced into rings",
    "1 teaspoon dried oregano",
    "0.5 yellow onion, sliced",
