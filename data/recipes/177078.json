  "ingredients": [
    "1 tablespoon olive oil",
    "3 pounds skinless chicken thighs",
    "salt and ground black pepper to taste",
    "0.5 cup fresh cilantro, coarsely chopped, divided",
    "2 (15.5 ounce) cans black beans, rinsed and drained",
    "2 large sweet potatoes, cut into chunks",
    "1 red bell pepper, cut into strips",
    "1 cup hot salsa",
    "0.5 cup chicken broth",
    "3 large cloves garlic, chopped",
    "2 teaspoons ground cumin",
    "0.5 teaspoon ground allspice",
    "lime wedges, for garnish"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large skillet. Season chicken with salt and pepper; sprinkle 1/4 cup cilantro over chicken thighs. Cook chicken in hot oil until browned, 3 to 5 minutes per side. Arrange chicken in the bottom of a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place black beans, sweet potatoes, and red bell pepper on top of chicken. Mix together salsa, chicken broth, 1/4 cup cilantro, garlic, cumin, and allspice in a bowl; pour into the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 4 hours. Garnish with lime wedges to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
