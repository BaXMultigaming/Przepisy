  "title": "Chantal's New York Cheesecake",
  "description": "This New York cheesecake recipe makes a rich, creamy, and smooth vanilla filling baked on a buttery graham cracker crust for an irresistible dessert.",
  "authors": [
    "Chantal Rogers"
  ],
  "date_published": "1999-06-04T16:26:00-04:00",
