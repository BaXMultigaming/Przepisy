  "ingredients": [
    "15 graham crackers, crushed",
    "2 tablespoons butter, melted",
    "4 (8 ounce) packages cream cheese",
    "1.5 cups white sugar",
    "0.75 cup milk",
    "4 eggs",
    "1 cup sour cream",
    "0.25 cup all-purpose flour",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix graham cracker crumbs and melted butter together in a medium bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xnGjXgFY7W12LgiNa0LLJ2uOVnM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8350-chantals-new-york-ddmfs-cheesecake-step1-201-52659eb7e931494b8e8e0a5b1b4c07b7.jpg"
      ],
      "image": "assets/images/8350/step_02.webp"
    },
    {
      "text": "Press onto the bottom of the prepared pan to make a packed crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MeD_34zTvrr62pVDDEwKmCsXDwU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8350-chantals-new-york-ddmfs-cheesecake-step2-204-f2155a0b33544977a7d938c68178ba9b.jpg"
      ],
      "image": "assets/images/8350/step_03.webp"
    },
    {
      "text": "Mix cream cheese and sugar together in a large bowl until smooth. Blend in milk, then mix in eggs, one at a time, until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LX8-cteMDP9M6rwY1ArW4LWFtvU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8350-chantals-new-york-ddmfs-cheesecake-step4-220-e088e428e41d4089acef42278e806120.jpg"
      ],
      "image": "assets/images/8350/step_04.webp"
    },
    {
      "text": "Add sour cream, flour, and vanilla; mix until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_vkHtBgNfkCcPkFqsznAo61fjJU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8350-chantals-new-york-ddmfs-cheesecake-step5-225-834a8bd2055845559cd0ec576cbac552.jpg"
      ],
      "image": "assets/images/8350/step_05.webp"
    },
    {
      "text": "Pour filling onto prepared crust. Bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_RAJf2yJi1oKFKYBwPM3keNW2DI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8350-chantals-new-york-ddmfs-cheesecake-step6-234-3072dfcadbff49108808d93f62230cf2.jpg"
      ],
      "image": "assets/images/8350/step_06.webp"
    },
    {
      "text": "Turn the oven off; let cheesecake cool in the oven with the door closed for 5 to 6 hours to prevent cracking. Chill in the refrigerator until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v8JZdIICA1oerzX0L-KzyW2w9hM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8350-chantals-new-york-cheesecake-DDMFS-4x3-426569e82b4142a6a1ed01e068544245.jpg"
      ],
      "image": "assets/images/8350/step_07.webp"
    }
