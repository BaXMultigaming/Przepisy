  "ingredients": [
    "0.5 cup chopped walnuts",
    "2 cooked rotisserie chicken breasts, cubed",
    "1 cup seedless red grapes, halved",
    "0.5 cup dried cranberries",
    "0.5 Granny Smith apple, cored and cubed",
