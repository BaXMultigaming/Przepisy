  "ingredients": [
    "0.33333334326744 cup reduced-sodium soy sauce",
    "0.25 cup brown sugar",
    "2 tablespoons gochujang (Korean hot pepper paste)",
    "1 teaspoon sesame oil",
    "0.5 teaspoon ginger paste",
    "0.5 teaspoon garlic paste",
    "2 green onions, chopped",
    "1 pound chicken wings",
    "1 teaspoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soy sauce, brown sugar, gochujang, sesame oil, ginger paste, garlic paste, and green onions in a large saucepan and bring to a boil over medium-high heat. Reduce heat and simmer until slightly thickened, about 4 minutes. Turn heat off and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken wings in a large bowl. Add vegetable oil and massage into the chicken until evenly coated. Place wings in the basket of the air fryer and cook for 10 minutes. Flip wings and cook for 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip wings into the sauce mixture and stir to coat. Return wings to the basket of the air fryer and cook 2 minutes. Coat wings into the sauce again. Return to air fryer basket and cook for 2 more minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
