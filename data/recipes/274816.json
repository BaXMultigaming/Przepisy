  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup whole wheat flour",
    "1 cup old-fashioned oats",
    "0.5 cup wheat germ",
    "1 tablespoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "6 tablespoons cold butter",
    "1 (15 ounce) can 100% pure pumpkin puree",
    "1 cup milk",
    "0.5 cup brown sugar",
    "1 egg, lightly beaten",
    "1 teaspoon vanilla extract",
    "2 tablespoons raw sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 cookie sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flours, oats, wheat germ, baking powder, cinnamon, salt, and nutmeg together in a medium bowl. Cut in butter with a pastry blender until mixture resembles coarse sand.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin, milk, brown sugar, egg, and vanilla extract in a small bowl. Add to the flour mixture and mix until dough is moistened and just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough evenly between the prepared baking sheets. Flatten into 8-inch circles 1/2- to 3/4-inch high. Score each circle into 6 wedges with a butter knife. Sprinkle with raw sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 14 to 17 minutes. Be careful not to overbake. Cool on the cookie sheets for 10 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
