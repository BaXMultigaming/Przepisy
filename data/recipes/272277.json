  "ingredients": [
    "10 ounces elbow macaroni",
    "1 cup mayonnaise",
    "1 cup sour cream",
    "1 carrot, diced",
    "1 rib celery, diced",
    "0.5 cup cubed Cheddar cheese",
    "0.5 green bell pepper, diced",
    "10 slices bread-and-butter pickles, diced",
    "2 tablespoons diced red onion",
    "1 tablespoon diced banana peppers",
    "1 tablespoon salad seasoning mix (such as McCormick® Salad Supreme Seasoning)",
    "1 teaspoon Dijon mustard",
    "0.25 teaspoon salt",
    "0.25 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain pasta; cool for about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise, sour cream, carrot, celery, Cheddar cheese, bell pepper, pickles, onion, banana peppers, salad seasoning, mustard, salt, and sugar in a large bowl; add macaroni and toss to coat. Chill salad before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
