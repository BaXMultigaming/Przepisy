  "ingredients": [
    "1 tablespoon olive oil",
    "1 (16 ounce) package ground turkey",
    "0.5 cup spicy salsa",
    "1 (1.25 ounce) package dry taco seasoning mix",
    "1 (16 ounce) can refried beans",
    "1 (8 ounce) package tortilla chips",
    "0.5 cup enchilada sauce",
    "6 slices American cheese",
    "1 (8 ounce) can sliced black olives"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium heat. Add ground turkey and cook until no pink remains, about 5 minutes. Mix in salsa and taco seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer turkey mixture, refried beans, tortilla chips, enchilada sauce, and American cheese in a 9x13-inch pan. Top with olives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
