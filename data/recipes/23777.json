  "ingredients": [
    "1.5 cups white sugar",
    "0.25 cup cornstarch",
    "2 cups water",
    "1 (3 ounce) package peach flavored Jell-O® mix",
    "4 cups fresh peaches - peeled, pitted, and sliced",
    "2 (9 inch) pie shells, baked"
  ],
  "steps": [
    {
      "text": "Combine sugar and cornstarch in a medium saucepan over medium heat. Add water and bring to a boil. Continue to boil for 3 minutes, stirring constantly. Stir in peach gelatin mix until dissolved. Remove from heat and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine peaches and cooled gelatin mixture in a large bowl. Gently stir until peach slices are coated with gelatin. Pour evenly into 2 baked pie shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pies in the refrigerator until filling is set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
