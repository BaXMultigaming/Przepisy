  "ingredients": [
    "1 (6 ounce) package chicken-flavor stuffing mix",
    "1.5 cups hot water",
    "0.25 cup butter, cut into pieces",
    "4 skinless, boneless chicken breasts",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "0.33333298563957 cup milk"
  ],
  "steps": [
    {
      "text": "To make the stuffing: Combine seasoning packet from the stuffing mix with hot water and butter in a large bowl; let stand until butter melts. Stir in stuffing crumbs, just to moisten, and let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange chicken breasts down the center of a 8x12-inch baking dish. Mix soup and milk together; pour mixture over chicken breasts. Spoon some stuffing on top of chicken and place remaining stuffing along the sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink in the center and the juices run clear, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
