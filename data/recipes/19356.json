  "ingredients": [
    "0.5 pound Italian sausage",
    "4 (6.5 ounce) cans tomato sauce",
    "1 (14.5 ounce) can diced tomatoes",
    "2 bay leaves",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon garlic powder",
    "1 teaspoon dried basil",
    "1 teaspoon dried oregano",
    "salt and pepper to taste",
    "1 (8 ounce) package spaghetti"
  ],
  "steps": [
    {
      "text": "Cook and stir sausage in a large skillet over medium heat until browned. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomato sauce, diced tomatoes, bay leaves, Italian seasoning, garlic powder, basil, oregano, salt, and pepper to Italian sausage in the skillet. Simmer sauce over medium-low heat for at least 1 hour, or longer for deeper flavor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook spaghetti in boiling water until tender yet firm to the bite, 8 to 10 minutes. Drain and transfer to a large serving bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pasta to simmering sauce; toss until evenly coated. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
