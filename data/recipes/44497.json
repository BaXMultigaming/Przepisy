  "ingredients": [
    "0.66666668653488 cup white sugar",
    "2 cups heavy cream",
    "1 (14 ounce) can sweetened condensed milk",
    "5 large eggs",
    "1 cup milk",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat sugar in a small nonstick saucepan over medium heat until completely dissolved; shake and swirl the pan until sugar has caramelized and is a dark golden brown color; pour into a 1 1/2-quart baking dish, and swirl to coat the bottom of the dish evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream, condensed milk, eggs, milk, and vanilla in a blender; blend on high for one minute. Pour mixture over caramelized sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the baking dish into a deep roasting pan; pour in enough boiling water to come 1 inch up the sides of the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until flan is set, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
