  "ingredients": [
    "2 ripe persimmons, pureed",
    "1 teaspoon baking soda",
    "2 cups all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "1 cup white sugar",
    "0.5 cup butter",
    "1 large egg",
    "1 cup raisins",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xpJw2GRv-LaKw1Q7tK1NmIyyZko=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10043-persimmon-cookies-i-VAT-step-01-01251a10e15441c89a567eeabb3803e2.jpg"
      ],
      "image": "assets/images/10043/step_01.webp"
    },
    {
      "text": "Place persimmon pulp in a small bowl; stir in baking soda until dissolved and set aside. Sift flour, cinnamon, cloves, nutmeg, and salt into a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o8gLtHV9n9cVKfuNFi-dTX4iDBs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10043-persimmon-cookies-i-VAT-step-02-da6407dee89b4807847314559159aba2.jpg"
      ],
      "image": "assets/images/10043/step_02.webp"
    },
    {
      "text": "Beat sugar and butter with an electric mixer in a separate large bowl until smooth. Beat in egg and persimmon mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yaodVZodddvZuwX4vHfz6ff6YMw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10043-persimmon-cookies-i-VAT-step-03-fb725200c8d04423b07f2bdb7a75ebe1.jpg"
      ],
      "image": "assets/images/10043/step_03.webp"
    },
    {
      "text": "Add flour mixture and stir until just combined. Fold in raisins and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pX3ouKHzbpta4rXaCfVKEkj8ZjE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10043-persimmon-cookies-i-VAT-step-04-28ed9ed17d63426cb91471b83e2e065a.jpg"
      ],
      "image": "assets/images/10043/step_04.webp"
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ohRfvb8wpI3Ztz3eaw9yFsaJwdc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10043-persimmon-cookies-i-VAT-step-05-2083b209cb2a47f9a5a377dc2d8d4490.jpg"
      ],
      "image": "assets/images/10043/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PHrCmCv-DiXhCQQ1QyHdTNpxDbw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10043-persimmon-cookies-i-VAT-step-06-8f99eeec257f49c4815ba72d1d198b99.jpg"
      ],
      "image": "assets/images/10043/step_06.webp"
    },
    {
      "text": "Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ocFhQbJlvTfP2Ocg7MbrMzHhaXI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10043-persimmon-cookies-i-VAT-step-07-f585e078b2df4eb59b92877844c6c69e.jpg"
