  "title": "Persimmon Cookies",
  "description": "These moist persimmon cookies made with pureed persimmon pulp, raisins, walnuts, cinnamon, nutmeg, and cloves are a flavorsome fall treat.",
  "authors": [
    "P. Tindall"
  ],
  "date_published": "1997-10-23T17:00:18-04:00",
