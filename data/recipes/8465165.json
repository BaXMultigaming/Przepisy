  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "12 large shrimp, peeled and deveined",
    "canola oil for frying",
    "0.25 cup self-rising flour",
    "0.25 cup potato starch",
    "0.5 teaspoon kosher salt",
    "1 pinch cayenne pepper",
    "0.5 cup cold sparkling water",
    "0.5 cup prepared dashi stock",
    "0.25 cup mirin",
    "0.25 cup soy sauce",
    "1 pinch white sugar, or to taste",
    "grated daikon radish"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WBEclIcx_CJh9lKUxinX9_UIkvM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8465165-chef-johns-shrimp-tempura-step-01-476194cf03ba4f54a44eba0b7544dda5.jpg"
      ],
      "image": "assets/images/8465165/step_01.webp"
    },
    {
      "text": "Dry peeled and deveined shrimp on paper towels. Flip each shrimp over and make shallow cuts through to make sure they won't curl up when frying. Refrigerate until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6CMpUUrUoJiSkQYHO4AXOH7JPPM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8465165-chef-johns-shrimp-tempura-step-02-633123e8fe754f999010e7f2bf059e60.jpg"
      ],
      "image": "assets/images/8465165/step_02.webp"
    },
    {
      "text": "Heat oil in a deep fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bq9twY-4KNFM-LGczcFBw_-AnbM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8465165-chef-johns-shrimp-tempura-step-03-371d40500fcc4296ad78260d4f300692.jpg"
      ],
      "image": "assets/images/8465165/step_03.webp"
    },
    {
      "text": "Combine self-rising flour, potato starch, salt, and cayenne in a bowl with a whisk. Add cold water and whisk until flour disappears and a crepe-like batter is achieved. Coat shrimp in batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5SD_3qRE5oBNccPjuKtG18blMYU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8465165-chef-johns-shrimp-tempura-step-04-8a43b94b55c8465f8c87715c5fb38dc2.jpg"
      ],
      "image": "assets/images/8465165/step_04.webp"
    },
    {
      "text": "Fry shrimp in small batches, no more than 6 at a time, making sure they don't stick together, until golden brown and crisp, about 3 minutes. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gfrWsjAW9Kd9XdxKE-1y4uDtHOI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8465165-chef-johns-shrimp-tempura-step-05-055c985269414b3b98129aa8cd49367a.jpg"
      ],
      "image": "assets/images/8465165/step_05.webp"
    },
    {
      "text": "Stir together dashi broth, mirin, soy sauce, and sugar for sauce. Grate daikon radish over. Taste and adjust as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SApI3Wu7L0iqJXV8LzFY-QPFsvY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8465165-chef-johns-shrimp-tempura-step-06-a26c3d8d46e44d30aafddaa3dbb9f082.jpg"
      ],
      "image": "assets/images/8465165/step_06.webp"
    },
    {
      "text": "Serve shrimp with dipping sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yJQXdSJi5VW7bu50og-vSRBfFJo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8465165-chef-johns-shrimp-tempura-hero-02-4x3-586da119c9cc43ce9504d36c9821b53f.jpg"
      ],
      "image": "assets/images/8465165/step_07.webp"
    }
  ],
