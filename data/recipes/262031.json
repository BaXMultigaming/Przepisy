  "ingredients": [
    "4 Yukon gold potatoes, cubed",
    "1 cup frozen corn",
    "olive oil",
    "1 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon chili powder",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried marjoram",
    "0.25 teaspoon ground paprika",
    "0.25 teaspoon ground cinnamon",
    "1 pinch ground black pepper",
    "2 cups cubed cooked spiral ham"
  ],
  "steps": [
    {
      "text": "Place potatoes in a microwave-safe bowl and add water to cover. Add corn. Cook in the microwave on high for 5 minutes and stir. Microwave 5 minutes more. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a saucepan over medium heat. Add garlic; pour in potatoes and corn and stir until coated in oil. Mix in garlic powder, salt, chili powder, oregano, marjoram, paprika, cinnamon, and black pepper. Cook until potatoes are soft and browned on the outside, about 10 minutes. Add ham; cover and cook until ham is heated through, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
