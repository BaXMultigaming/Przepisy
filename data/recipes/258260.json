      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dough to a large piece of parchment paper. Shape into a log with your hands. Wrap parchment paper around the log, twisting ends shut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
