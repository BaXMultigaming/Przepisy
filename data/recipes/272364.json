  "ingredients": [
    "0.25 cup oil",
    "2 pounds lamb chops",
    "3 pods green cardamom",
    "2 bay leaves",
    "1 cinnamon stick",
    "1 teaspoon cumin seeds",
    "1 pod black cardamom",
    "6 large onions, thinly sliced",
    "6 cloves garlic, minced",
    "1 tablespoon minced fresh ginger root",
    "2 teaspoons red chile powder",
    "0.5 teaspoon ground turmeric",
    "salt to taste",
    "3 green chile peppers, halved and seeded",
    "2 tomatoes, chopped",
    "0.25 cup water",
    "1 tablespoon chopped fresh cilantro, or to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Brown lamb chops on all sides, about 5 minutes. Transfer to a plate; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in green cardamom pods, bay leaves, cinnamon stick, cumin seeds, and black cardamom pod until fragrant, about 1 minute. Add onions, garlic, and ginger; cook until onions are golden brown, about 10 minutes. Stir in chili powder, turmeric, and salt; cook for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add lamb chops, chile peppers, tomatoes, and water; simmer over low heat until lamb is tender, all water has evaporated, and onions have disintegrated into a thick gravy, about 40 minutes. Garnish servings with cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
