  "ingredients": [
    "1 pound ground beef",
    "1 (24 ounce) jar prepared marinara sauce",
    "2 cups fire-roasted frozen corn",
    "0.75 cup shredded pepper Jack cheese",
    "1 (11 ounce) package refrigerated breadstick dough"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook ground beef, stirring and breaking up lumps, in a large cast iron skillet until browned, about 10 minutes. Stir in pasta sauce and corn. Bring to a boil, then stir in cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll breadstick dough and loosely weave on top of filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and bubbly, 20 to 25 minutes. Let stand for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
