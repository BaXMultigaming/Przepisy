  "ingredients": [
    "1 (2 pound) pork tenderloin",
    "2 cloves garlic, minced",
    "6 potatoes, peeled and cubed",
    "1 cup baby carrots",
    "4 cubes chicken bouillon",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Place pork in the slow cooker and sprinkle with garlic. Arrange potatoes, carrots, and bouillon cubes around pork. Add water.",
      "section": null,
