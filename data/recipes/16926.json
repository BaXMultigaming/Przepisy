  "ingredients": [
    "1 cup chopped onions",
    "1 cup chopped celery",
    "1 cup chopped carrots",
    "2 teaspoons minced garlic",
    "2 tablespoons vegetable oil",
    "2.5 cups water",
    "2 tomatoes, diced",
    "1 (14.5 ounce) can peeled and diced tomatoes with juice",
    "1 (10.75 ounce) can chicken broth",
    "0.25 cup uncooked barley",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "In a large saucepan over medium heat, combine onions, celery, carrots, garlic, and oil and sauté until all vegetables are almost tender, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add water, fresh tomatoes, canned tomatoes, chicken broth, barley, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir thoroughly and bring to a boil. Reduce heat to low and simmer until barley is tender, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
