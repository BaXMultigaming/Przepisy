  "ingredients": [
    "cooking spray",
    "1 pound bulk spicy breakfast sausage",
    "1 onion, chopped",
    "1 cup white cornmeal",
    "0.5 cup all-purpose flour",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1 cup buttermilk",
    "0.5 cup vegetable oil",
    "2 eggs, lightly beaten",
    "1 (15 ounce) can black-eyed peas, drained",
    "1 (8 ounce) package shredded Cheddar cheese",
    "0.75 cup cream-style corn",
    "1 (4.5 ounce) can chopped green chile peppers",
    "0.25 cup chopped pickled jalapeño peppers"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sausage and onion in a large skillet over medium heat, stirring until sausage is crumbly and no longer pink, about 5 minutes. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cornmeal, flour, salt, and baking soda together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk buttermilk, oil, and eggs together in a small bowl. Add to cornmeal mixture, stirring just until moistened. Stir in sausage mixture, black-eyed peas, Cheddar cheese, corn, chile peppers, and jalapeños. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
