  "ingredients": [
    "0.33333334326744 cup hoisin sauce",
    "0.25 cup barbeque sauce",
    "1 tablespoon minced fresh ginger root",
    "2 tablespoons sesame oil, divided",
    "3 cups cooked, chopped turkey meat",
    "salt and pepper to taste",
    "0.5 cup diced green onions, divided",
    "4 English muffins, split"
  ],
  "steps": [
    {
      "text": "Preheat the broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan over medium heat, whisk together hoisin sauce, barbeque sauce, ginger and 1 tablespoon sesame oil. Mix in turkey, salt, pepper and green onions, gently tossing until all ingredients are well blended. Cook approximately 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix the remaining sesame oil and remaining green onions. Brush the cut sides of the English muffins lightly with the mixture. Place the muffin halves face up on a medium baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil English muffins 2 minutes, or until lightly toasted. Remove from heat and top with turkey mixture. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
