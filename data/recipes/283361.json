  "title": "Curried Sweet Potato, Carrot, and Apple Soup",
  "description": "This curried sweet potato soup with carrots and apples can be served either hot or chilled and the flavors just get better after it overnights in the fridge.",
  "authors": [
    "emccabe"
  ],
  "date_published": "2015-02-01T17:09:03-05:00",
