  "ingredients": [
    "1.75 pounds beef sirloin steak",
    "0.33333334326744 cup olive oil",
    "3 tablespoons red wine vinegar",
    "2 tablespoons lemon juice",
    "1 teaspoon Worcestershire sauce",
    "1 clove garlic, minced",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.75 cup crumbled blue cheese",
    "8 cups romaine lettuce - rinsed, dried, and torn into bite-size pieces",
    "2 tomatoes, sliced",
    "1 small green bell pepper, sliced",
    "1 carrot, sliced",
    "0.5 cup sliced red onion",
    "0.25 cup sliced pimento-stuffed green olives"
  ],
  "steps": [
    {
