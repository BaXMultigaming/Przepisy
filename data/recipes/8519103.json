  "ingredients": [
    "1 (3.5 ounce) package instant ramen noodles (exclude seasoning packet)",
    "1 tablespoon unsalted butter",
    "1 clove garlic, minced",
    "0.25 teaspoon red chili flakes",
    "1 teaspoon brown sugar",
    "1 tablespoon soy sauce",
    "0.25 cup reserved pasta water",
    "1 large egg, lightly beaten",
    "2 teaspoons everything bagel seasoning",
    "green onions, thinly sliced"
  ],
  "steps": [
    {
      "text": "Cook ramen in boiling water to al dente following package directions. Drain and reserve ¼ cup of the water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Add garlic and cook, stirring constantly, until golden and fragrant, about 1 minute. Stir in chili flakes, brown sugar, and soy sauce and simmer for 1 minute. Add noodles and a bit of ramen cooking water and toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Push noodles to the side and crack egg into the skillet. Cook, stirring gently, until nearly set, then toss with the pasta and any additional water, if desired, to thin sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a bowl and garnish with everything bagel seasoning and green onions, if using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
