  "ingredients": [
    "1 tablespoon butter",
    "1 large sweet potato, scrubbed and shredded",
    "1 onion, chopped",
    "2 tablespoons brown sugar",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon chipotle chile powder"
  ],
  "steps": [
    {
      "text": "Melt butter in a nonstick skillet over medium-high heat. Add sweet potatoes and onion; cover and cook, stirring occasionally, until sweet potatoes are tender and onion is translucent, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in brown sugar, garlic powder, and chipotle chile powder; cook, uncovered, until potatoes are golden brown on the bottom, about 5 minutes. Flip; cook until browned on other side.",
      "section": null,
      "name": null,
      "url": null,
