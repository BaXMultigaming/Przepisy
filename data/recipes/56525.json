  "ingredients": [
    "2 eggs, beaten",
    "0.5 cup half-and-half cream",
    "0.75 cup white sugar",
    "2 teaspoons all-purpose flour",
    "0.5 teaspoon salt",
    "1 tablespoon molasses",
    "1 cup light corn syrup",
    "1 teaspoon vanilla extract",
    "1.5 tablespoons brandy",
    "1 cup coarsely chopped pecans",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat eggs together with half-and-half. Mix in sugar, flour, salt, molasses, corn syrup, vanilla, and brandy. Stir in pecans. Pour into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 40 to 50 minutes, or until done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
