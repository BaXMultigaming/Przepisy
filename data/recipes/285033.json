  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a large rimmed baking sheet with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss broccoli, bread crumbs, olive oil, garlic powder, lemon zest, salt, black pepper, and pepper flakes on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 10 minutes. Toss broccoli and continue to roast until golden brown around the edges and slightly crisp but not mushy, about 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven. Immediately drizzle with lemon juice, then sprinkle with Parmesan cheese and serve.",
