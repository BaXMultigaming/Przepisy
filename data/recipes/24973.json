  "ingredients": [
    "2 cups all-purpose flour",
    "1.5 cups white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "0.66666668653488 cup margarine",
    "2 eggs, beaten",
    "0.66666668653488 cup milk",
    "1 cup blackberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine flour, sugar, baking powder and salt. Cut in margarine until mixture resembles coarse crumbs. Set aside 3/4 cup of crumb mixture, to be used as a topping for the cake. Mix eggs and milk together and then blend into remaining mixture in bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter into prepared pan. Sprinkle blackberries evenly over the top. Sprinkle reserved crumb mixture over fruit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes, or until a toothpick inserted into the center of the cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
