  "ingredients": [
    "8 cups chicken broth",
    "4 skinless, boneless chicken breast halves",
    "1 (24 ounce) package frozen corn",
    "1 red onion, diced",
    "1.25 cups barbeque sauce",
    "4 cloves garlic, minced",
    "1.5 teaspoons salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon garlic salt",
    "0.5 cup shredded mozzarella cheese, or to taste",
    "0.5 cup chopped fresh cilantro, or to taste"
  ],
  "steps": [
    {
      "text": "Combine chicken broth, chicken, corn, onion, barbeque sauce, garlic, salt, black pepper, and garlic salt in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 5 hours. Remove chicken from slow cooker and cut into bite-size pieces; return to slow cooker and stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle soup into serving bowls and top each serving with mozzarella cheese and cilantro.",
