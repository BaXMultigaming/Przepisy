  "ingredients": [
    "0.33333298563957 cup olive oil",
    "3 tablespoons distilled white vinegar",
    "1.5 tablespoons lime juice",
    "1 tablespoon white sugar",
    "1 teaspoon dried thyme leaves",
    "0.75 teaspoon ground allspice",
    "0.5 teaspoon cinnamon",
    "0.5 teaspoon salt",
    "0.33333298563957 teaspoon ground cayenne pepper",
    "1 scotch bonnet chile pepper, minced",
    "0.25 cup minced green onions with tops",
    "2 cloves garlic, minced",
    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "In a large dish, mix the olive oil, vinegar, lime juice, sugar, thyme, allspice, cinnamon, salt, and cayenne pepper. Stir in the scotch bonnet pepper, green onions, and garlic. Pierce chicken on all sides with a fork, and place in the dish. Cover, and marinate up to 24 hours in the refrigerator, turning occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil grill grate. Discard marinade, and grill chicken 8 minutes on each side, or until juices run clear.",
