  "ingredients": [
    "2 cups chopped onion",
    "1 tablespoon vegetable oil, or as needed",
    "4 (14.5 ounce) cans chicken broth",
    "2 cups roughly chopped carrots",
    "2 tablespoons chopped fresh parsley",
    "2 teaspoons dried oregano",
    "2 teaspoons red pepper flakes",
    "0.5 teaspoon garlic powder",
    "3 (15 ounce) cans black beans, drained and rinsed",
    "1 cup frozen corn",
    "2 cups cooked white rice"
  ],
  "steps": [
    {
      "text": "Heat a 3-quart saucepan over medium-high heat. Saute onion in vegetable oil until tender, about 5 minutes. Remove from heat. Stir in broth, carrots, parsley, oregano, red pepper flakes, and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil over high heat. Reduce heat, cover, and simmer until carrots are fork-tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mash 1 1/2 to 2 cups of beans in a small bowl. Stir whole and mashed beans into the broth. Add corn. Cook until heated through, 5 to 7 minutes. Serve soup over rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
