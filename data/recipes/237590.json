  "keywords": [],
  "ingredients": [
    "0.75 cup brown sugar or dark brown sugar",
    "3 cups Silk® Original or Vanilla Coconutmilk",
    "4 eggs or equivalent egg substitute",
    "1 teaspoon cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "2 tablespoons coconut extract",
    "0.25 cup coconut or dark rum",
    "2 cups flaked coconut (sweetened or unsweetened), divided",
    "1 (1 pound) loaf whole grain bread, cut into 1-inch cubes"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat a 9x13 pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk together sugar, Silk, eggs, (or egg substitute), spices, salt, coconut extract and rum, if using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in 1 1/2 cups flaked coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently stir in bread cubes until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon mixture into prepared pan, cover with plastic wrap and let sit for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pan on a cookie sheet and bake for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with remaining 1/2 cup flaked coconut and bake for an additional 25 minutes, or until center springs back.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
