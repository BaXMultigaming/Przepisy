  "title": "Coconut Bread Pudding from Silk®",
  "description": "Sugar, spice, and rum (if you like) with coconut and whole grain bread make a rich and delicious bread pudding.",
  "authors": [
    "Silk"
  ],
  "date_published": "2014-05-01T16:47:09-04:00",
