  "ingredients": [
    "4.5 cups cooked and mashed sweet potatoes",
    "1 cup white sugar",
    "0.5 cup butter, melted",
    "0.33333334326744 cup milk",
    "2 eggs, beaten",
    "0.5 teaspoon vanilla extract",
    "1 cup light brown sugar",
    "0.5 cup all-purpose flour",
    "0.33333334326744 cup butter",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mashed sweet potatoes, sugar, 1/2 cup melted butter, milk, eggs, and vanilla extract together in a large bowl; spread into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar and flour together in a small bowl; cut in 1/3 cup butter until mixture is crumbly, then stir in pecans. Sprinkle streusel mixture over sweet potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
