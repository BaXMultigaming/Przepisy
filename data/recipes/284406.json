  "ingredients": [
    "2 slices bacon",
    "4 small crookneck (yellow) squash",
    "0.25 cup chopped Vidalia® onion",
    "2 tablespoons white sugar",
    "1 tablespoon salt",
    "2 teaspoons ground black pepper",
    "1 cup water, or as needed to cover"
  ],
  "steps": [
    {
      "text": "Cut bacon into 1/4-inch-thick strips (lardons); set aside. Slice squash and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir bacon lardons in a large saucepan over medium heat until crispy, 5 to 7 minutes. Add squash, onion, sugar, salt, and pepper to bacon and drippings in the pan. Add enough water to cover. Cook over medium-low heat for 45 minutes. Much of the water will evaporate; add more if needed.",
