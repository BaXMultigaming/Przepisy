  "ingredients": [
    "cooking spray",
    "1 teaspoon ghee (clarified butter)",
    "0.5 (8 ounce) package mushrooms, sliced",
    "0.25 cup chopped fresh spinach",
    "0.25 cup sliced cherry tomatoes",
    "2 medium green onions, sliced",
    "salt and ground black pepper to taste",
    "6 large eggs",
    "0.5 cup shredded Cheddar cheese",
    "2 tablespoons chopped fresh parsley",
    "1 tablespoon freshly grated Parmesan cheese",
    "2 teaspoons Italian seasoning"
  ],
  "steps": [
    {
      "text": "Spray a slow cooker generously with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt ghee in a skillet over medium heat. Add mushrooms, spinach, cherry tomatoes, and green onions. Sauté until soft, about 5 minutes. Season with salt and pepper. Transfer to the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, Cheddar cheese, parsley, Parmesan cheese, and Italian seasoning together. Pour egg mixture over vegetables in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until set, 1 to 2 hours on High, or 3 to 4 hours on Low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
