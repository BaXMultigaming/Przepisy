  "ingredients": [
    "1 tablespoon dried parsley, divided",
    "1 tablespoon dried basil, divided",
    "4 skinless, boneless chicken breast halves",
    "4 cloves garlic, thinly sliced",
    "0.5 teaspoon salt",
    "0.5 teaspoon crushed red pepper flakes",
    "2 tomatoes, sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle 1 teaspoon parsley and 1 teaspoon basil evenly over the bottom of the baking dish. Arrange chicken breast halves in the dish, and sprinkle evenly with garlic slices. In a small bowl, mix the remaining 2 teaspoons parsley, remaining 2 teaspoons basil, salt, and red pepper; sprinkle over chicken. Top with tomato slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake covered in the preheated oven 25 minutes. Remove cover, and continue baking 15 minutes, or until chicken juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
