  "ingredients": [
    "2 cups graham cracker crumbs",
    "0.25 cup white sugar",
    "0.5 cup melted butter",
    "1 (14 ounce) can sweetened condensed milk",
    "2 cups flaked coconut",
    "1 (12 ounce) package semisweet chocolate chips, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs, sugar, and melted butter in a bowl; mix to combine and pat into the bottom of a 9x13 inch baking pan. Bake in the preheated oven for 15 minutes. Keep the oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine condensed milk and flaked coconut; spread over the crust and continue to bake for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread melted chocolate over coconut layer. Set aside to cool and let chocolate harden, about 1 hour. Cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
