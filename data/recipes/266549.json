  "ingredients": [
    "1 (20 ounce) can pineapple chunks in juice, drained, juice reserved",
    "3 tablespoons whole-milk plain Greek yogurt",
    "1 teaspoon honey, or to taste",
    "0.25 teaspoon grated lime zest",
    "1 cup fresh blueberries"
