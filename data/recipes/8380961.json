  "ingredients": [
    "10 ounces cherry or grape tomatoes, rinsed and dried",
    "1 teaspoon olive oil",
    "0.5 teaspoon Italian seasoning",
    "0.25 teaspoon sea salt",
    "0.13 teaspoon freshly ground black pepper",
    "0.13 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut a piece of parchment paper to fit slightly larger than your air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss together tomatoes, olive oil, Italian seasoning, salt, pepper and garlic powder in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place parchment paper into the air fryer basket, then add tomatoes. Roast for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tomatoes to a bowl using a spatula. Carefully lift parchment paper out of air fryer and top tomatoes with any remaining juices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
