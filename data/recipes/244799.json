  "ingredients": [
    "1 cup prune juice",
    "3 tablespoons vanilla Greek yogurt",
    "1 cup fresh spinach, or to taste",
    "1 cup frozen blueberries, or to taste",
    "6 frozen strawberries",
    "0.5 sliced frozen peach",
    "2 tablespoons flax seeds"
  ],
  "steps": [
    {
      "text": "Pour prune juice into a blender. Layer Greek yogurt, spinach, blueberries, strawberries, peach, and flax seeds in the blender, in this order. Start blender on low speed and gradually increase speed until smoothie is well blended.",
