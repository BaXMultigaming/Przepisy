  "ingredients": [
    "1 cup all-purpose flour",
    "1.5 teaspoons baking soda",
    "0.25 teaspoon salt",
    "1.25 cups skim milk",
    "0.5 cup molasses",
    "1 egg, beaten",
    "2 tablespoons vegetable oil",
    "2 cups bran flakes cereal",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease a 12 cup muffin pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, sift together flour, baking soda, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate medium bowl, mix skim milk, molasses, egg, and vegetable oil. Mix in the bran cereal. Thoroughly stir in the flour mixture and raisins. Transfer to the prepared muffin pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 minutes in the preheated oven, until a knife inserted in the center of a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
