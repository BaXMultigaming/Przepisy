        "https://www.allrecipes.com/thmb/vXQtsudqbm6N8L7n9Sg9FMQYySY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236302-baked-zucchini-fries-DDMFS-28846-beauty-4x3-fe8a4bd533634d35908f7eefac0baa05.jpg"
