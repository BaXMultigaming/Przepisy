  "ingredients": [
    "0.5 cup dry bread crumbs",
    "0.5 teaspoon salt",
    "1 pound sea scallops",
    "2 tablespoons butter",
    "1 tablespoon olive oil",
    "0.25 cup dry white wine",
    "2 tablespoons lemon juice",
    "1 teaspoon minced fresh parsley",
    "1 clove garlic, minced"
  ],
  "steps": [
    {
      "text": "Combine bread crumbs and salt in a large resealable plastic bag. Add scallops, a few at a time, and shake to coat. Repeat with remaining scallops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter with olive oil in a large skillet over medium-high heat; sauté scallops until browned and opaque, 1 1/2 to 2 minutes per side. Transfer scallops to a plate; keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir wine, lemon juice, parsley, and garlic into skillet; bring to a boil. Simmer until thickened, about 5 minutes. Pour lemon-wine sauce over scallops; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
