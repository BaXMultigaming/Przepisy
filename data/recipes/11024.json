  "ingredients": [
    "1 cup peanut butter",
    "0.5 cup butter, softened",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 large egg",
    "3 tablespoons milk",
    "1 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "0.75 teaspoon baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0-IbXc_qlVo0yjitijagvkmVw0M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11024-joeys-peanut-butter-cookies-Step-01-1-150ee4acf36440a492042a88ad720415.jpg"
      ],
      "image": "assets/images/11024/step_01.webp"
    },
    {
      "text": "Beat peanut butter, butter, white sugar, and brown sugar together in a large bowl with an electric mixer until well blended. Beat in egg until well combined. Mix in milk and vanilla. Combine flour, baking powder, and salt in a separate bowl; stir into peanut butter mixture until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KoVkJxCcnjPTsCQp2wtzOJDR76k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11024-joeys-peanut-butter-cookies-Step-02-1-2adf34ce4d48474d97a5669c233f9f63.jpg"
      ],
      "image": "assets/images/11024/step_02.webp"
    },
    {
      "text": "Roll tablespoonfuls of dough into balls. Place cookies 2 inches apart onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vbPQK2SUDYrgjVVV6A4boDLKFUA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11024-joeys-peanut-butter-cookies-Step-03-1-ccfc92e82c324059a0a3aac9591e7c9d.jpg"
      ],
      "image": "assets/images/11024/step_03.webp"
    },
    {
      "text": "Press each ball once with fork tines.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VGuUmN9UyS7qagfURnGqJ6S9JyI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11024-joeys-peanut-butter-cookies-Step-04-1-cc8c47d572c94c3da920c3b0921a1270.jpg"
      ],
      "image": "assets/images/11024/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y9fVhwBVSLfk4gIrSYx6G4BLvvA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11024-joeys-peanut-butter-cookies-Step-05-1-739343ac07a647e1973ae61922b5f229.jpg"
