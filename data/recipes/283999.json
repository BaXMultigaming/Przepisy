  "ingredients": [
    "cooking spray",
    "0.33333334326744 cup minced onion",
    "0.33333334326744 cup Italian bread crumbs",
    "0.33333334326744 cup half-and-half",
    "0.25 cup grated Parmesan cheese",
    "2 large eggs",
    "1 large egg yolk",
    "2 cloves garlic, minced",
    "1 tablespoon chopped fresh basil",
    "1 tablespoon chopped fresh parsley",
    "0.25 teaspoon dried oregano",
    "1.25 pounds ground round beef",
    "0.5 pound ground Italian sausage",
    "1 teaspoon kosher salt",
    "0.5 teaspoon ground black pepper",
    "2 (24 ounce) jars marinara sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a rimmed baking sheet with foil. Spray foil lightly with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onion, bread crumbs, half-and-half, Parmesan cheese, eggs, egg yolk, garlic, basil, parsley, and oregano in a large bowl; stir until well combined. Add ground round and sausage and sprinkle evenly with salt and pepper. Mix well until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dampen hands with water and form mixture into 18 golf ball-sized meatballs. Arrange meatballs on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer meatballs to a large pot and add marinara sauce. Simmer over low heat for at least 2 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
