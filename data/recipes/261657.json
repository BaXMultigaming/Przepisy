  "ingredients": [
    "1 cup feta cheese",
    "1 cup sour cream",
    "1 cup cottage cheese",
    "0.5 (8 ounce) package cream cheese (such as Philadelphia®), softened",
    "2 eggs",
    "1 (8 ounce) package phyllo dough",
    "1 cup milk",
    "1 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a baking sheet lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix feta cheese, sour cream, cottage cheese, cream cheese, and eggs together in a bowl. Whisk milk and oil together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush milk-oil mixture over 3 sheets of phyllo dough and stack together. Place some of the cheese mixture in a straight line on one end of the dough. Roll up tightly to form a spiral shape. Transfer spiral to the baking sheet. Repeat with remaining milk-oil mixture, phyllo dough, and cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake burek in the preheated oven until golden brown, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
