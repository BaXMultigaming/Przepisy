  "ingredients": [
    "non-stick cooking spray",
    "4 cups rolled oats",
    "1 cup sliced almonds",
    "0.5 cup granular sucralose sweetener with brown sugar (such as Splenda® Brown Sugar Blend)",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground cinnamon",
    "1 cup applesauce",
    "2 tablespoons white sugar",
    "4 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C). Lightly spray large baking sheet with non-stick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, almonds, sweetener, salt, and cinnamon in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir applesauce and sugar together in a small saucepan; bring to a simmer over medium heat and immediately remove from heat. Stir vanilla into the applesauce mixture; pour over the oats mixture and toss to coat. Spread the mixture onto the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until golden brown, stirring occasionally, 20 to 30 minutes. Place baking sheet on a cooling rack until granola is completely cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
