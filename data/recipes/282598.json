  "ingredients": [
    "3 cups quick-cooking oats",
    "1 cup packed brown sugar",
    "3 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "1 cup whole milk",
    "0.5 cup unsalted butter, melted",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "0.5 cup dried cranberries",
    "0.5 cup pecans, chopped",
    "0.5 cup white chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, brown sugar, baking powder, cinnamon, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, butter, eggs, and vanilla extract together in a separate bowl. Combine with the oat mixture and stir in cranberries, pecans, and white chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
