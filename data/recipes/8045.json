  ],
  "steps": [
    {
      "text": "Prepare cake mix according to directions. Fill each cone about 3/4 full of batter, up to first ridge. Place cones in the cups of a cupcake pan or on cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 400 degrees F (205 degrees C) for 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 10 chocolate chips on top of each warm cone, and in a minute or two spread melted chocolate over top. Decorate with candies.",
      "section": null,
