  "ingredients": [
    "0.5 cup butter, softened",
    "1 egg",
    "0.25 cup packed brown sugar",
    "0.33333334326744 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "1.5 teaspoons water",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "24 thin chocolate covered mint cookies",
    "24 pecan halves"
  ],
  "steps": [
    {
      "text": "In a large mixing bowl, cream the butter, white and dark sugars. Beat in the egg, water and vanilla. In a separate bowl, sift together the flour, baking soda, and salt. Blend flour mixture into the butter mixture, and stir well. Wrap dough in waxed paper and chill at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease cookie sheets. Cover each thin mint with 1 tablespoon of dough. Place on cookie sheet and top with a pecan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 for 10 to 12 minutes. Let cool slightly on cookie sheet before removing to racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
