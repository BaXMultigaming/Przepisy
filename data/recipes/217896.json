  "ingredients": [
    "1.75 cups rice flour",
    "1 cup soy flour",
    "0.5 cup white sugar",
    "1.5 teaspoons salt",
    "1 (15 ounce) can pumpkin puree",
    "0.5 cup oil",
    "2 eggs, lightly beaten",
    "0.5 cup infant rice cereal",
    "1.5 tablespoons baking powder",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease 12 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk rice flour, soy flour, sugar, and salt together in a bowl; stir in pumpkin, oil, and eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix rice cereal and baking powder together in a bowl; stir into pumpkin mixture until batter is combined. Fold in chocolate chips. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
