  "ingredients": [
    "2 (15 ounce) cans fat-free refried beans",
    "1 (7.75 ounce) can jalapeno salsa (such as El Pato®)",
    "1 (12 ounce) bag tortilla chips",
    "1 (8 ounce) package shredded pepper Jack cheese",
    "1 green bell pepper, chopped",
    "1 onion, chopped",
    "1 (8 ounce) package shredded lettuce",
    "1 (4 ounce) can sliced black olives"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven broiler. Set an oven rack about 6 inches from the heat source. Line a rimmed baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pBfv0YrA-VpdZp6BSgdzzQs4cnM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-257521-aarons-famous-vegetarian-nachos-VAT-step-01-ab7386e777bc4b219b69504361887e00.jpg"
      ],
      "image": "assets/images/257521/step_01.webp"
    },
    {
      "text": "Combine refried beans and salsa in a saucepan over medium heat; cook and stir until blended and heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w3s80XYBdWUJCglspVmHsbR_9MM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-257521-aarons-famous-vegetarian-nachos-VAT-step-02-133f206d9acf4695bd00fb9fabcbdd3e.jpg"
      ],
      "image": "assets/images/257521/step_02.webp"
    },
    {
      "text": "Arrange tortilla chips on the prepared baking sheet. Spoon refried bean mixture over chips. Sprinkle with pepper Jack cheese, green bell pepper, and onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y9aSLwZ2wAsEThwpax1XHwPAgZc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-257521-aarons-famous-vegetarian-nachos-VAT-step-03-965ef3257ac64d298ae452245443d6b7.jpg"
      ],
      "image": "assets/images/257521/step_03.webp"
    },
    {
      "text": "Cook under the preheated broiler until cheese is melted, 3 to 5 minutes. Garnish with lettuce and olives.",
      "section": null,
