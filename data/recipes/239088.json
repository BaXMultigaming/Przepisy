  "ingredients": [
    "0.5 (15 ounce) can sliced peaches, drained",
    "0.5 cup water",
    "0.5 cup milk",
    "0.5 cup quick-cooking oats",
    "2 tablespoons packed brown sugar",
    "0.25 teaspoon ground cinnamon, or more to taste",
    "1 pinch salt"
  ],
  "steps": [
