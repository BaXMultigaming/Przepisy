  "title": "French Baguettes",
  "description": "This bread machine French bread recipe yields homemade, oven-baked baguettes great for sandwiches and bruschetta or serving alongside cheese plates.",
  "authors": [
    "Judy Taubert"
  ],
  "date_published": "1998-11-13T19:55:19-05:00",
