  "ingredients": [
    "3 cups all-purpose flour",
    "2.25 teaspoons active dry yeast",
    "1.5 teaspoons salt",
    "1 teaspoon white sugar",
    "1.25 cups warm water",
    "1 tablespoon olive oil",
    "1 tablespoon cornmeal, or more as needed",
    "0.5 cup chopped dry-pack sun-dried tomatoes",
    "1 tablespoon dried basil",
    "2 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Combine 2 cups flour, yeast, salt, and sugar in a large bowl. Add warm water and olive oil; stir with a wooden spoon until well blended. Slowly mix in remaining 1 cup flour until dough holds together and isn't sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl with plastic wrap and refrigerate until doubled in size, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dust a baking sheet with cornmeal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Punch dough down and stir in sun-dried tomatoes, basil, and garlic using a wooden spoon or with your hands. Form dough into a loaf and place on the prepared baking sheet. Let dough rise in a warm area of the kitchen for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until loaf is golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
