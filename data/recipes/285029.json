  "ingredients": [
    "2 cups panko bread crumbs",
    "1 teaspoon everything bagel seasoning",
    "0.5 teaspoon garlic salt",
    "0.5 teaspoon ground turmeric",
    "0.5 teaspoon ground black pepper",
    "4 (4 ounce) mahi mahi fillets",
    "2 tablespoons grapeseed oil",
    "nonstick cooking spray",
    "1 teaspoon chopped fresh parsley",
    "1 medium lemon, cut into 4 wedges"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix panko, bagel seasoning, garlic salt, turmeric, and pepper together in a shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place mahi mahi fillets onto a platter and drizzle with grapeseed oil. Dip each fillet into the panko mixture to coat, then place in a single layer in the air fryer basket. Spray with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer until fish flakes easily with a fork, 12 to 15 minutes, flipping halfway through. Remove from the air fryer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with parsley and lemon wedges. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
