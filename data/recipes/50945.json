  "ingredients": [
    "0.5 cup butter or margarine, softened",
    "0.5 cup natural peanut butter",
    "0.5 cup honey",
    "1 egg",
    "1 tablespoon vanilla extract",
    "1 cup sifted whole wheat flour",
    "0.5 cup dry milk powder",
    "0.5 cup wheat bran",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the butter and peanut butter until smooth. Mix in the honey, egg and vanilla. Combine the whole wheat flour, dry milk powder, wheat bran and baking soda; stir into the peanut butter mixture. Drop by teaspoonfuls onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven, or until edges begin to brown. Remove from baking sheet to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
