  "ingredients": [
    "0.25 cup Dijon mustard",
    "8 (4 ounce) pieces round steak, pounded 1/4 inch thick",
    "0.5 cup minced onion",
    "2 teaspoons paprika",
    "2 teaspoons salt",
    "2 teaspoons freshly ground black pepper",
    "8 slices bacon",
    "3 tablespoons canola oil",
    "1 (12 ounce) can beef broth",
    "1.25 cups water",
    "2 tablespoons cornstarch",
    "1 cup warm water",
    "0.25 cup sour cream"
  ],
  "steps": [
    {
      "text": "Spread 1/2 tablespoon mustard over one side of each piece of steak; sprinkle onion, paprika, salt, and pepper evenly over the steaks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RuesN_lfdJVPv7C1H-G9QzpodRo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/149686_GermanBeefRouladen_step1_4x3_ddmfs_0870-1e5947581921404b8bf19387fdf5e96a.jpg"
      ],
      "image": "assets/images/149686/step_01.webp"
    },
    {
      "text": "Lay one slice of bacon on each piece; roll up steaks jelly roll-style and secure with toothpicks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fwt6QkWtNVJVqmjswBzWVe7BZek=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/149686_GermanBeefRouladen_step1_4x3_ddmfs_0873-bbf57cdc4d0a42d794837a0c9536295a.jpg"
      ],
      "image": "assets/images/149686/step_02.webp"
    },
    {
      "text": "Heat canola oil in a skillet over medium heat; cook beef rouladen on all sides until browned. Add broth and water; bring to a boil. Reduce heat to medium-low; cover and simmer until tender, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TqmJAIVUsDhQX5IylLh2wirvkLc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/149686_GermanBeefRouladen_step2_4x3_ddmfs_0899-b477234a846341969cb9b78e6d53d9ae.jpg"
      ],
      "image": "assets/images/149686/step_03.webp"
    },
    {
      "text": "Remove beef rouladen; strain broth mixture and return liquid to the skillet. Whisk cornstarch and 1 cup of water together until smooth; slowly pour cornstarch mixture into the skillet, stirring continually until the sauce has thickened, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/L-HgF_NzdnCI9gQAN3wQxK_ugYk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/149686_GermanBeefRouladen_step3_4x3_ddmfs_0903-2861627484cb48278602bc58cced6e2c.jpg"
      ],
      "image": "assets/images/149686/step_04.webp"
    },
    {
      "text": "Stir in sour cream; return rolls to the sauce and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
