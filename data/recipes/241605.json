  "ingredients": [
    "1 cup ketchup",
    "6 fluid ounces tomato-vegetable juice cocktail (such as V8®), or more to taste",
    "0.75 cup molasses",
    "2 tablespoons Meyer lemon juice",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon brown sugar",
    "1 tablespoon minced fresh onion",
    "1 tablespoon minced garlic",
    "2 teaspoons ground black pepper"
  ],
  "steps": [
    {
      "text": "Stir ketchup, tomato-vegetable juice cocktail, molasses, Meyer lemon juice, Worcestershire sauce, brown sugar, onion, garlic, and black pepper together in a bowl.",
