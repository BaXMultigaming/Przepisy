  "ingredients": [
    "1.5 cups white sugar",
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1.5 teaspoons ground cinnamon",
    "0.25 teaspoon ground cloves",
    "2 eggs",
    "0.33000001311302 cup vegetable oil",
    "1 cup chopped pecans",
    "1 (21 ounce) can apple pie filling"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the sugar, flour, baking soda, cinnamon and cloves. Add the eggs and oil, mix until well blended, then stir in the pecans and apple filling. Spread the batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 55 to 60 minutes, or until a toothpick inserted into the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
