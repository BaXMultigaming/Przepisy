  "ingredients": [
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "2 eggs, beaten",
    "1 (8 ounce) package cream cheese, softened",
    "1 cup white sugar",
    "0.5 cup heavy whipping cream",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, baking powder, and baking soda together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs with an electric mixer in a bowl on medium speed until light and frothy. Beat cream cheese in a large bowl with an electric mixer until fluffy. Add sugar and mix to form a smooth paste. Add beaten eggs and beat with an electric mixer until a smooth creamy batter forms, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold cream and blueberries into the batter and mix until just combined. Add flour mixture and fold in just until absorbed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed and muffins are lightly browned, about 20 minutes. Cool in the tin for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
