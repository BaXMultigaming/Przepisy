  "ingredients": [
    "2 cups coconut water, or as needed",
    "1 cup basmati rice",
    "salt, or as desired",
    "1.5 tablespoons chopped fresh cilantro",
    "2 teaspoons unsalted butter"
  ],
  "steps": [
    {
      "text": "Bring 1 cup coconut water to a boil in a saucepan. Add basmati rice and salt, cover, and reduce heat to simmer. Stir occasionally, adding more coconut water as needed, until rice is soft but not mushy, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove rice from heat, stir in cilantro and butter, and cover again. Let stand until coconut water is absorbed and flavors have blended, about 5 minutes more.",
