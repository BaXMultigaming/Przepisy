  "ingredients": [
    "7 large potatoes, peeled and cubed",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "1 cup sour cream",
    "0.25 cup butter",
    "2 tablespoons chopped green onions",
    "2 teaspoons salt",
    "0.25 teaspoon black pepper",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil. Add potatoes; cook until tender, about 15 minutes. Drain and mash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mashed potatoes, spinach, sour cream, butter, green onions, salt, and black pepper in a large bowl; spoon into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Top with Cheddar cheese; continue baking until cheese is melted, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
