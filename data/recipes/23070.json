  "ingredients": [
    "0.5 cup chopped onion",
    "1.5 pounds lean ground beef",
    "1 (16 ounce) can sauerkraut, drained and pressed dry",
    "2 (8 ounce) cans refrigerated crescent rolls",
    "1 (8 ounce) package shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brown onion and ground beef in a large skillet over medium-high heat. Drain extra fat out of skillet, then stir in drained sauerkraut. Heat through and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press 1 package of crescent roll dough into the bottom of a lightly greased 9x13-inch baking dish. Spread beef mixture on top, then lay 2nd package of crescent roll dough over the top of beef mixture. Press dough seams together and sprinkle all with cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 25 to 30 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
