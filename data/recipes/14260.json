  "ingredients": [
    "1 cup dry brown lentils",
    "1 cup diced carrots",
    "1 cup red onion, diced",
    "2 cloves garlic, minced",
    "1 bay leaf",
    "0.5 teaspoon dried thyme",
    "2 tablespoons lemon juice",
    "0.5 cup diced celery",
    "0.25 cup chopped parsley",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 cup olive oil"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mXPerGCMLOyIdjIE-GEUzTlZFYo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14260-Mediterranean-Lentil-Salad-DDMFS-Step-01-17125-ea093003f07045d095779f8ac1a5f51b.jpg"
      ],
      "image": "assets/images/14260/step_01.webp"
    },
    {
      "text": "Combine lentils, carrots, onion, garlic, bay leaf, and thyme in a saucepan. Add enough water to cover by 1 inch; bring to a boil, reduce heat and simmer uncovered for 15 to 20 minutes or until lentils are tender but not mushy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/43m9DmShiQ9ssV68mokxL2rkqR0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14260-Mediterranean-Lentil-Salad-DDMFS-Step-02-17130-cecd33cc04294dff9432f4cc4af2e760.jpg"
      ],
      "image": "assets/images/14260/step_02.webp"
    },
    {
      "text": "Drain lentils and vegetables and remove bay leaf. Add olive oil, lemon juice, celery, parsley, salt and pepper. Toss gently to mix and serve at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
