  "total_time": "PT50M",
  "yield": [
    "60",
    "10 (1-pint) jars"
  ],
  "categories": [
    "Side Dish"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "10 pounds fresh small beets, stems removed",
    "2 cups white sugar",
    "1 tablespoon pickling salt",
    "1 quart white vinegar",
    "0.25 cup whole cloves, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iZZ0py1jGGdfQ_MTuXKQkLyPbiw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/38109-Pickled-Beets--DDMFS-Step1-11803-8abdc715a1d745b48e5c1d76169b4e30.jpg"
      ],
      "image": "assets/images/38109/step_01.webp"
    },
    {
      "text": "Place beets in a large stockpot with water to cover. Bring to a boil, and cook until tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/smPP3LQD-P0_Zgc1DYEVQ3XJnbo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/38109-Pickled-Beets--DDMFS-Step2-11804-53e9b911b13d49a6995911332c21d90e.jpg"
      ],
      "image": "assets/images/38109/step_02.webp"
    },
    {
      "text": "Meanwhile, inspect 10 pint-sized jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until beets are ready. Wash new, unused lids and rings in warm soapy water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d6XZCnx56FFSQOhk6SYMPBHyngI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/38109-Pickled-Beets--DDMFS-Step3-11805-a96e858e66e14012aaf3aa7226349edf.jpg"
      ],
      "image": "assets/images/38109/step_03.webp"
    },
    {
      "text": "Drain beets, reserving 2 cups of beet water. When beets are cool enough to handle, peel and discard skins. Fill each sterilized jar with beets. Evenly divide cloves among the jars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Kiq9jG0fAFiYQ2AL8bJQ-A2H4x0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/38109-Pickled-Beets--DDMFS-Step4-11815-a6159138ae02450fa30e5e92820c25ad.jpg"
      ],
      "image": "assets/images/38109/step_04.webp"
    },
    {
      "text": "Combine sugar, 2 cups of beet water, vinegar, and pickling salt in a large saucepan; bring to a rapid boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TPuCTRLfKRwf80WGxdm7TmXjYXI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/38109-Pickled-Beets--DDMFS-Step4-11820-e43fec83e1ee418f8fbaa5acbbb32dd7.jpg"
      ],
      "image": "assets/images/38109/step_05.webp"
    },
    {
      "text": "Pour the hot brine over the beets in the jars, and seal the lids.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8FsGbwohjgysefVA-Wxrai2LFBw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/38109-Pickled-Beets--DDMFS-Step4-11821-dea3576757ca45afbeb650a23b889717.jpg"
      ],
      "image": "assets/images/38109/step_06.webp"
    },
    {
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil over high heat, then carefully lower the jars into the pot using a holder. Leave a 2-inch space between the jars. Pour in more boiling water if necessary until the water level is at least 1 inch above the tops of the jars. Bring the water to a full boil, cover the pot, and process for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Sn9W1NeCQDrC0K7NiTwAKK-7NyY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/38109-Pickled-Beets--DDMFS-Step4-11823-24e351694bcf491d9403c64bb5dc3a00.jpg"
      ],
      "image": "assets/images/38109/step_07.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0mQpX76ZT89_2WMP3lmO7-lP_Ko=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/38109-pickled-beets-DDMFS-4x3-82c76398fe2f49b5b829b13cde4615c5.jpg"
      ],
      "image": "assets/images/38109/step_08.webp"
    }
  ],
