  "ingredients": [
    "5 dried red chile peppers, or to taste",
    "2 medium onions, cut into chunks",
    "2 tablespoons chopped fresh cilantro",
    "1 tablespoon vegetable oil, or more as needed",
    "1 tablespoon chopped garlic",
    "1 tablespoon ground coriander",
    "2 teaspoons lemon zest",
    "2 teaspoons ground cumin",
    "2 teaspoons shrimp paste",
    "2 teaspoons paprika",
    "1 teaspoon whole black peppercorns",
    "1 teaspoon lemon grass powder",
    "1 teaspoon ground turmeric",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Blend chile peppers, onions, cilantro, oil, garlic, coriander, lemon zest, cumin, shrimp paste, paprika, peppercorns, lemon grass, turmeric, and salt in a blender until a smooth, paste-like consistency is reached.",
