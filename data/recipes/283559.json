  "ingredients": [
    "2 pounds fresh green beans, trimmed",
    "0.5 cup balsamic vinegar",
    "0.33333334326744 cup extra-virgin olive oil",
    "1 small sweet onion, thinly sliced",
    "1 clove garlic, minced",
    "2 teaspoons chopped fresh parsley",
    "1 teaspoon white sugar",
    "1 teaspoon salt",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil over high heat. Add green beans and cook, uncovered, until soft but still firm to the bite, 7 to 10 minutes. Check often so beans don't overcook.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk vinegar, olive oil, onion, garlic, parsley, sugar, salt, and pepper together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain green beans and mix with dressing while still warm. Allow to marinate at room temperature for at least 1 hour. Serve at room temperature or chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
