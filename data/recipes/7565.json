  "ingredients": [
    "1 (18.25 ounce) package devil's food cake mix",
    "1 (5.9 ounce) package instant chocolate pudding mix",
    "1 cup sour cream",
    "1 cup vegetable oil",
    "0.5 cup warm water",
    "4 eggs",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Generously grease a 12-cup Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cake mix, pudding mix, sour cream, oil, water, and eggs in a large bowl until smooth and well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7L_m10C2Qze1BVSPOPNyH89-K0g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/320-TooMuchChocolateCake-ddmfs-step1-3854-68c6f1270ded4d369baeed4224e66d1f.jpg"
      ],
      "image": "assets/images/7565/step_02.webp"
    },
    {
      "text": "Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q0Qwen0LQ4h9X_Bn88xF3XnOlA0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/320-TooMuchChocolateCake-ddmfs-step2-3856-c88c096c16434d19aade676e6f9e011e.jpg"
      ],
      "image": "assets/images/7565/step_03.webp"
    },
    {
      "text": "Pour batter into the prepared Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tFmXeARXNUty632QpedFdiwXkEI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/320-TooMuchChocolateCake-ddmfs-step3-3864-ee29788c18d648b2a8a170773519ced6.jpg"
      ],
      "image": "assets/images/7565/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until top is springy to the touch and a toothpick inserted into center of cake comes out clean, 50 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/azp9n8cb4VmKqUmkflMskyHdPkY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/320-TooMuchChocolateCake-ddmfs-step4-4x3-38643915-dcd7c8e0f11a409684688b3d457c2ebb.jpg"
      ],
      "image": "assets/images/7565/step_05.webp"
    },
    {
      "text": "Cool cake thoroughly in the pan for at least 1 ½ hours before inverting onto a plate. Sprinkle powdered sugar on top if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jWqfZch51Dc3u2pTx63N9w1o-hI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/320-TooMuchChocolateCake-ddmfs-step5-4x3-38643921-a3d893307db247b4ab9da516c717e869.jpg"
