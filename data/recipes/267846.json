  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup butter, softened",
    "3 ounces cream cheese, softened",
    "0.75 cup brown sugar",
    "0.5 cup chopped pecans",
    "1 egg",
    "1 tablespoon butter, softened",
    "1 teaspoon vanilla extract",
    "1 dash salt"
  ],
  "steps": [
    {
      "text": "Combine flour, 1/2 cup butter, and cream cheese in a bowl; cover and chill for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll chilled dough into 24 balls; press into the cups of a mini muffin tin to make pastry shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, pecans, egg, 1 tablespoon butter, vanilla extract, and salt in a bowl; spoon 1/2 to 3/4 teaspoonfuls filling into each pastry shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
