  "ingredients": [
    "1 lime",
    "3 mangoes, peeled and cubed",
    "0.5 cup water",
    "1 tablespoon chile-lime seasoning (such as Tajin®)",
    "2 teaspoons white sugar"
  ],
  "steps": [
    {
      "text": "Cut lime into 6 slices. Cut each slice in half and place 2 slices in the bottom of each ice pop mold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set aside 1/3 cup of the diced mango. Place remaining mango in a blender. Add water, chile-lime seasoning, and sugar; blend until smooth. Stir in reserved mango.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide mixture between the molds. Freeze for 8 hours, or overnight. Run molds under cold water for 10 to 15 seconds to release pops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
