  "ingredients": [
    "3 thick slices whole grain bread",
    "0.25 cup coconut",
    "0.25 cup chia seeds",
    "0.25 cup half-and-half",
    "2 eggs",
    "1 tablespoon white sugar",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "2 teaspoons unsalted butter, or as needed",
    "0.5 cup fresh raspberries",
    "0.5 cup vanilla yogurt",
    "2 ounces maple syrup, or to taste"
  ],
  "steps": [
    {
      "text": "Cut each bread slice into 4 even sticks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix coconut, chia seeds, half-and-half, eggs, sugar, cinnamon, vanilla extract, and salt together in a bowl until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat and add butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip bread sticks in the batter until completely coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook coated bread sticks in the hot butter until browned, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place raspberries in a microwave-safe bowl; heat in microwave until softened, about 1 minutes. Mix yogurt into raspberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip French toast sticks in raspberry-yogurt sauce and top with maple syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
