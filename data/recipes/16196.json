  "ingredients": [
    "1.5 pounds top round steak, cut into strips",
    "salt and pepper to taste",
    "0.5 onion, chopped",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 (8 ounce) can canned mushrooms",
    "0.25 cup water",
    "1 tablespoon dried chives",
    "1 clove garlic, minced",
    "1 teaspoon Worcestershire sauce",
    "1 cube beef bouillon",
    "0.25 cup white wine",
    "1 tablespoon all-purpose flour",
    "1 (16 ounce) container sour cream",
    "0.5 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Place the beef in the bottom of a slow cooker, and season with salt and pepper to taste. Place onion on top of beef, and then add mushroom soup, mushrooms, and water. Season with chives, garlic, Worcestershire sauce, and bouillon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix together the wine with the flour. Pour over the beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook on Low for 6 to 7 hours. Stir in the sour cream and parsley, and continue cooking for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
