  "ingredients": [
    "1.5 cups quick-cooking rolled oats",
    "0.5 cup white sugar",
    "3.5 tablespoons cocoa powder",
    "1 pinch kosher salt",
    "1 pinch cayenne pepper",
    "0.25 cup unsalted butter, softened",
    "0.25 cup coconut oil, at room temperature",
    "1 teaspoon vanilla extract",
    "2 tablespoons strong brewed coffee",
    "0.5 cup unsweetened grated coconut, or as needed"
  ],
  "steps": [
    {
      "text": "Heat a pan over medium heat and add oats. Toss and shake until fragrant and lightly toasted, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, cocoa powder, salt, cayenne, butter, coconut oil, vanilla extract, and coffee in a bowl. Add the oats and mix until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Portion dough into balls using a sorbet scoop. Roll balls in grated coconut and transfer to a parchment-lined baking pan. Let them firm up in the fridge for 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
