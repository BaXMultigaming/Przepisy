  ],
  "steps": [
    {
      "text": "Cut chicken into bite-size pieces. Wrap with about 1/3 slice of bacon, thread onto toothpick, and top with pineapple chuck. Marinate for 4 hours or longer in teriyaki sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place marinated appetizers onto parchment lined baking sheets. Bake for 20 minutes, or until chicken is done and bacon golden brown. Drain on paper towels. Serve hot.",
      "section": null,
