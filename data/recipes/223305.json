  "ingredients": [
    "4 cups peeled and sliced fresh peaches",
    "1 cup fresh blackberries",
    "1 cup white sugar",
    "1 tablespoon lemon juice",
    "1 teaspoon ground cinnamon",
    "0.5 cup butter, melted",
    "1.25 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix peaches, blackberries, 1/4 cup sugar, lemon juice, and cinnamon in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour melted butter into a 9x13-inch glass baking dish, tilting to coat the bottom and sides evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, remaining 1 cup sugar, baking powder, and salt in another large bowl; mix in milk, stirring until just moist. Pour batter into the prepared baking dish; distribute fruit mixture evenly over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 45 minutes.",
      "section": null,
