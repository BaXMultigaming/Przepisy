  "ingredients": [
    "0.75 tablespoon very hot water",
    "0.75 teaspoon Himalayan pink salt, or to taste",
    "2 cups raw almonds",
    "1 tablespoon olive oil",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 325 to 350 degrees F (165 to 175 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water and 3/4 teaspoon pink salt together in a small bowl until salt mostly dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place almonds in a medium bowl; stir in salt water until coated. Transfer almonds to the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated air fryer for 6 to 7 minutes. Stir almonds, return to the air fryer, air fry until almonds turn brown inside, 5 to 6 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return almonds to same mixing bowl; stir in olive oil and salt until completely coated. Allow to cool before serving,",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
