  "steps": [
    {
      "text": "Combine coriander seeds, cumin seeds, mustard seeds, anise seeds, fenugreek seeds, and allspice berries in a skillet over medium heat; toast until fragrant and spices slightly darken in color, about 10 minutes. Remove spices from the skillet; cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add spices and turmeric to a spice grinder; pulse until ground. Store in an airtight container at room temperature.",
