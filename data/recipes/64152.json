  "ingredients": [
    "1 cup white sugar",
    "3 tablespoons shortening",
    "1 egg",
    "0.75 cup milk",
    "1.75 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1.5 cups blueberries",
    "2 cups confectioners' sugar",
    "0.66666668653488 cup butter, softened",
    "0.5 cup pasteurized egg",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8- or 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together white sugar and shortening in a large bowl with an electric mixer until smooth; mix in egg until incorporated. Stir in milk. Sift in flour and baking powder; mix well. Fold in blueberries. Spread batter evenly in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together confectioners' sugar and butter in a medium bowl with an electric mixer until smooth. Beat in egg gradually, then stir in vanilla. Chill in the refrigerator until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve chilled sauce over warm pudding.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
