  "ingredients": [
    "2 tablespoons butter, or more to taste",
    "2 onions, diced",
    "1 clove garlic, minced",
    "1.5 tablespoons curry powder",
    "2.5 teaspoons salt",
    "1 teaspoon ground turmeric",
    "1 teaspoon cayenne pepper",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon ground ginger",
    "0.5 cinnamon stick",
    "1 pound ground beef",
    "2 potatoes, diced",
    "2 tomatoes, diced"
  ],
  "steps": [
    {
      "text": "Melt butter in a large wok or skillet over high heat; saute onions and garlic until onions are almost transparent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine curry powder, salt, turmeric, cayenne pepper, black pepper, ginger, and cinnamon in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ground beef into onion mixture and cook, breaking beef into small crumbles, until beef is cooked through and browned, 5 to 7 minutes. Add curry mixture to ground beef mixture and stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix potatoes and tomatoes into ground beef mixture, reduce heat to medium, cover wok, and cook until potatoes are tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
