  "title": "Pistachio White Chocolate Chip Cookies",
  "description": "The usual goodness of chocolate chip cookies but made better by replacing the chips with white chocolate chips and adding chopped pistachios. These make a beautiful presentation.",
  "authors": [
    "Wendy"
  ],
  "date_published": "2020-06-18T23:06:02-04:00",
