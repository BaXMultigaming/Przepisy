  "ingredients": [
    "2 cups all-purpose flour",
    "2 tablespoons unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup butter",
    "1.5 cups white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2.5 cups shredded zucchini",
    "2 tablespoons white sugar",
    "1 cup chopped walnuts",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a jelly roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cocoa powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and 1 1/2 cups sugar with an electric mixer in a large bowl until smooth. Add the eggs one at a time, mixing until completely incorporated. Add vanilla extract with last egg. Mix in flour with a light hand. Fold in zucchini until just combined. Pour batter into the prepared pan. Sprinkle the remaining 2 tablespoons sugar, chocolate chips, and walnuts on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is dry and the edges have started to pull away from the sides of the pan, about 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
