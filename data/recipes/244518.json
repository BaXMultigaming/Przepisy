  "ingredients": [
    "2 large eggs",
    "1 (12 fluid ounce) can evaporated milk",
    "12 fluid ounces coconut milk",
    "6 fluid ounces sweetened condensed milk",
    "4 fluid ounces dark rum",
    "0.5 cup white sugar",
    "0.5 cup melted butter",
    "0.25 cup raisins",
    "2 teaspoons vanilla extract",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground cinnamon",
    "1 loaf bread, torn in pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl until frothy. Add evaporated milk, coconut milk, sweetened condensed milk, rum, sugar, melted butter, raisins, vanilla, nutmeg, and cinnamon to eggs in the bowl; mix well. Fold in bread. Pour mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and edges are beginning to look dry, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
