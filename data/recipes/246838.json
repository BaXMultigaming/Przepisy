  "ingredients": [
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1.5 cups white sugar",
    "0.75 cup butter, at room temperature",
    "0.75 cup queso fresco, at room temperature",
    "1 egg",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, baking powder, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, and queso fresco together in a large bowl. Add egg; mix well until combined. Mix in vanilla extract. Slowly mix in flour mixture, 1 cup at a time, until dough is thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape tablespoonfuls of dough into balls and place 1-inch apart on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 9 to 11 minutes. Cool on the baking sheets for 2 minutes. Transfer to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
