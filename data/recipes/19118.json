  "ingredients": [
    "1 cup evaporated milk",
    "1 cup white sugar",
    "3 egg yolk, beaten with 1 teaspoon water",
    "0.5 cup margarine",
    "1 teaspoon vanilla extract",
    "1 cup chopped pecans",
    "1 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "In a large saucepan combine evaporated milk, sugar, egg yolks, margarine and vanilla. Cook over low heat, stirring constantly, until thick. Remove from heat and stir in pecans and coconut. Spread on cake while still warm.",
