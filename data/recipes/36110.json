  "ingredients": [
    "1 pound ground beef",
    "1 pound smoked sausage, cut into 1/4-inch slices",
    "1 onion, chopped",
    "3 stalks celery, chopped",
    "1 clove garlic, chopped",
    "1 medium head cabbage, chopped",
    "1 (14.5 ounce) can stewed tomatoes",
    "14.5 fluid ounces water",
    "1 cup uncooked rice",
    "1 pinch garlic salt, or to taste"
  ],
  "steps": [
    {
      "text": "Combine ground beef, smoked sausage, onion, celery, and garlic in a large stock pot over medium-high heat. Cook and stir until beef is evenly browned, about 5 minutes. Stir in cabbage, tomatoes, water, and rice. Season with garlic salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil; reduce heat to low. Cover and cook, stirring once, until rice is tender, 35 to 40 minutes.",
      "section": null,
      "name": null,
