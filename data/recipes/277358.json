  "steps": [
    {
      "text": "Preheat an air fryer to 390 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each jalapeño half with cream cheese and wrap with a halved bacon strip. Tuck in bacon ends or use toothpicks to secure.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place jalapeño poppers inside the air fryer basket, working in batches to avoid overcrowding if necessary.",
