  "ingredients": [
    "1 recipe pastry for a 9 inch single crust pie",
    "3 eggs",
    "1.5 cups pecan halves",
    "1 cup real maple syrup",
    "0.25 cup butter",
    "1 cup heavy whipping cream",
    "1 teaspoon vanilla extract",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the nuts evenly over pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together butter or margarine, vanilla, and flour. Beat the eggs well, and blend into the flour mixture. Add salt, maple syrup, and cream. Pour filling over the nuts in the pie shell. Make sure the nuts are covered, so they will not burn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 50 to 60 minutes, or until knife inserted in center come out clean. Let cool at least 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
