  "ingredients": [
    "1 pound lean ground beef",
    "1 (28 ounce) can whole peeled tomatoes, undrained and chopped",
    "2 cups water",
    "1 (1 ounce) package dry onion soup mix",
    "1 teaspoon dried oregano",
    "2 cups macaroni",
    "0.33333334326744 cup grated Parmesan cheese",
    "0.5 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Brown ground beef in a large skillet over medium heat until cooked through and no longer pink, 5 to 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomatoes, water, soup mix, and oregano into ground beef; bring to a boil. Add macaroni, cover and simmer until macaroni is tender, about 20 minutes, stirring occasionally. Stir in Parmesan cheese; top with mozzarella cheese.",
      "section": null,
