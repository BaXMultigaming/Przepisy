  "ingredients": [
    "3 large Bermuda onions, sliced into 1/3-inch rings",
    "1 cup sifted all-purpose flour",
    "1 cup buttermilk",
    "1 egg, beaten",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups corn oil, or as needed"
  ],
  "steps": [
    {
      "text": "Soak onion rings in a bowl of ice water for 1 hour; drain and pat dry with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, buttermilk, egg, baking soda, and salt together in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip onion rings in batter, working in batches; fry battered onion rings in the hot oil until browned, about 5 minutes. Remove with a slotted spoon and drain on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
