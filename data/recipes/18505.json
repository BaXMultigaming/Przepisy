  "title": "Funnel Cakes",
  "description": "This funnel cake recipe makes the best crisp, fried funnel cakes just like the old-fashioned ones served at county fairs with lots of powdered sugar.",
  "authors": [
    "TARMIA"
  ],
  "date_published": "2000-05-26T19:47:17-04:00",
