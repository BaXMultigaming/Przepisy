  "ingredients": [
    "1 quart vegetable oil for frying, or as needed",
    "1.5 cups milk",
    "2 large eggs",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.75 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Heat oil to 375 degrees F (190 degrees C) in a heavy skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kxjYubqH0yvkKKs24Mcx-MV7Xuk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-funnel-cakes-DDMFS-4x3-step-01-029232cb6df14040a58046ef5f9215e9.jpg"
      ],
      "image": "assets/images/18505/step_01.webp"
    },
    {
      "text": "Beat milk and eggs together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7dKtKHG0CbCeF6GoVYhRE7Mx_As=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-funnel-cakes-DDMFS-4x3-step-02-42765b03f80b45d0999aa99c36576345.jpg"
      ],
      "image": "assets/images/18505/step_02.webp"
    },
    {
      "text": "Combine flour, baking powder, cinnamon, and salt in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EB6a_BL8T4p3c5syf-GBUE5HbEw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-funnel-cakes-DDMFS-4x3-step-03-1bf03e1980294e2b9ed33020f1c063e9.jpg"
      ],
      "image": "assets/images/18505/step_03.webp"
    },
    {
      "text": "Stir into egg mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LZLme-WqhrWKZw6nniF4fnmvk5k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-funnel-cakes-DDMFS-4x3-step-04-d19d0eeb67e24586a79827af77ee7db2.jpg"
      ],
      "image": "assets/images/18505/step_04.webp"
    },
    {
      "text": "Use your finger to cover the funnel hole; pour in 1 cup of batter. Starting in the center of the skillet, remove your finger and move the funnel in a swirling motion to make a 6- or 7-inch round.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r6AbUeicLtMpJ6qTMByDPOel96U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-funnel-cakes-DDMFS-4x3-step-05-56824264ea1e4a82b7f248554b61c4e2.jpg"
      ],
      "image": "assets/images/18505/step_05.webp"
    },
    {
      "text": "Fry in hot oil until bottom is golden brown; flip funnel cake and continue cooking until golden brown all over, about 1 minute per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H5rM_e_jDdaKqDYbBs2kTMJ6z3I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-funnel-cakes-DDMFS-4x3-step-06-6e0a3f25b61b4d7391d28aa271edfaea.jpg"
      ],
      "image": "assets/images/18505/step_06.webp"
    },
    {
      "text": "Drain on paper towels. Continue cooking remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BCI9mikoETq3DzrbodplgzLclZU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-funnel-cakes-DDMFS-4x3-step-09-941a5d7b279641119f46797756a4911a.jpg"
      ],
      "image": "assets/images/18505/step_07.webp"
    },
    {
      "text": "Sprinkle with confectioners' sugar and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VzftpSvEMHTNxeXDb2IPEqZQQrw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-funnel-cakes-DDMFS-4x3-6c4355ae427c407f933978cb13d6fa72.jpg"
      ],
      "image": "assets/images/18505/step_08.webp"
    }
  ],
