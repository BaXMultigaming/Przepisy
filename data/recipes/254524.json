  "steps": [
    {
      "text": "Heat oil in a saucepan over medium heat. Add ground beef and cumin; cook and stir until meat is lightly browned, 5 to 10 minutes. Stir in chopped tomatoes, chopped onion, diced bell pepper, and minced garlic; cook and stir until meat is browned and vegetables are soft, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine quartered tomatoes, chunked onion, water, bell pepper, vinegar, garlic cloves, Worcestershire sauce, basil, oregano, parsley, cilantro, paprika, soy sauce, hot sauce, brown sugar, and salt in a blender; blend to desired thickness, adding more water to thin sauce as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sauce into ground beef mixture; cover and cook until sauce reaches desired consistency, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
