  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 pound ground beef",
    "1 teaspoon ground cumin",
    "1.5 tomatoes, chopped",
    "0.33333334326744 onion, chopped",
    "0.25 bell pepper, diced",
    "3 cloves garlic, minced",
    "1.5 tomatoes, quartered",
