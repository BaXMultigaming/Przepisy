  "ingredients": [
    "2 tablespoons soy sauce",
    "0.25 cup toasted sesame seeds",
    "2 tablespoons all-purpose flour",
    "0.25 teaspoon salt",
    "1 pinch ground black pepper",
    "4 skinless, boneless chicken breast halves",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place soy sauce in a 9x13-inch baking dish. On a piece of wax paper, mix together sesame seeds, flour, salt, and pepper. Dip chicken pieces in soy sauce to coat, then dredge in sesame seed mixture. Arrange in baking dish in a single layer, then drizzle with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for approximately 40 minutes, or until chicken is cooked through and tender and juices run clear. Baste with drippings once during cooking time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish chicken with extra sesame seeds if desired, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
