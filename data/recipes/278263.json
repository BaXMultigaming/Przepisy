  "ingredients": [
    "cooking spray",
    "1 cup white sugar",
    "4 tablespoons melted butter",
    "0.75 tablespoon baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.75 tablespoon white vinegar",
    "1.5 cups all-purpose flour",
    "1 large egg",
    "0.75 cup milk",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar and butter together until sugar is mostly dissolved. Stir in baking powder, baking soda, and salt. Add vinegar. Pour in flour slowly; make a small indent in the flour. Crack egg into the indent. Mix batter slightly and gradually pour in milk, mixing until just combined. Fold in Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the muffin cups until 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the center of the preheated oven until a toothpick inserted into a muffin comes out clean, about 15 minutes. Cool in the tin for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
