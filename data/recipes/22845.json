  "ingredients": [
    "1 pound lean ground beef",
    "1 pound ground pork",
    "1 onion, chopped",
    "3 potatoes, peeled and diced",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 tablespoon poultry seasoning",
    "1 pinch brown sugar",
    "0.5 cup water",
    "1 tablespoon all-purpose flour",
    "1 tablespoon butter",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Cook beef and pork in a large skillet over medium heat until browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir onion, potatoes, cinnamon, nutmeg, poultry seasoning, brown sugar, and water into ground meats. Cover, reduce heat to low, and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour, butter, salt, and pepper and cook until thickened, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
