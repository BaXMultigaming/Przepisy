  "title": "Sock it to Me Cake",
  "description": "This sock it to me cake is easy to make with a butter cake mix baked in a Bundt pan and drizzled with a sweet glaze for a gorgeous presentation.",
  "authors": [
    "Becky"
  ],
  "date_published": "1998-05-16T11:47:32-04:00",
