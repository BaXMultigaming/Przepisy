  "title": "Enchanted Sour Cream Chicken Enchiladas",
  "description": "Sour cream and chicken fill these quick and easy enchiladas.",
  "authors": [
    "Kate"
  ],
  "date_published": "2007-11-13T18:50:22-05:00",
