  "ingredients": [
    "0.5 pound ground beef",
    "0.5 pound ground pork",
    "0.5 cup rolled oats",
    "1 slice bread, shredded",
    "1 large egg",
    "0.25 small onion, diced",
    "1 stalk green onion, sliced",
    "3 tablespoons dry onion soup mix",
    "2 tablespoons chopped fresh basil",
    "1 tablespoon soy sauce",
    "1 tablespoon minced fresh ginger root",
    "0.5 tablespoon sesame oil",
    "1 (15 ounce) package slider-size burger buns"
  ],
  "steps": [
    {
      "text": "Gently mix beef, pork, oats, bread, egg, onion, green onion, soup mix, basil, soy sauce, ginger, and sesame oil together. Form 10 slider-sized patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a frying pan over medium-high heat. Add patties and pan-fry until meat is browned and no longer pink in the centers, flipping as needed, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While patties fry, toast slider buns in a toaster until lightly browned, 30 seconds to 1 minute each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add patties to toasted buns and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
