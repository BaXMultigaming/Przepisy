  "ingredients": [
    "2 tablespoons vegetable oil",
    "2 pounds venison stew meat",
    "3 medium onions, chopped",
    "2 cloves garlic, minced",
    "3 cups water",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon salt",
    "0.5 teaspoon dried oregano",
    "1 large bay leaf",
    "7 small potatoes, peeled and quartered",
    "1 pound carrots, cut into 1 inch pieces",
    "0.25 cup all-purpose flour",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Heat oil in a large, heavy pot over medium heat. Add venison; cook and stir until well browned, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TwxWPFRPbTE-YbDS35cnuc2bm6U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13440-venison-stew-VAT-step-01-8ae6a4ca3b5341d8a0ac5d80519eb227.jpg"
      ],
      "image": "assets/images/13440/step_01.webp"
    },
    {
      "text": "Add onions and garlic; cook and stir until translucent, about 5 minutes. Stir in water, Worcestershire sauce, salt, oregano, and bay leaf. Cover and simmer until venison is tender, 1 ½ to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y1W2x-kfqPsgRaipiBLoIQdeskU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13440-venison-stew-VAT-step-02-224fe895aa3e442b8d8f1fc40ab29055.jpg"
      ],
      "image": "assets/images/13440/step_02.webp"
    },
    {
      "text": "Stir in potatoes and carrots; cook until tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KeD5kqR7fUsCBGZTMrka-_8t2Js=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13440-venison-stew-VAT-step-03-112e0bfd78394da2be2b2dfab719a941.jpg"
      ],
      "image": "assets/images/13440/step_03.webp"
    },
    {
      "text": "Stir flour and water together in a small bowl; pour into stew and cook until thick, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G1oXZlrsIzgX60ZK_2WoGPGHEGQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13440-venison-stew-VAT-step-04-bc1eb02fd6d945db9f88815984db5609.jpg"
      ],
      "image": "assets/images/13440/step_04.webp"
    },
    {
      "text": "Remove bay leaf before serving and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vbbYCUDhDEim7BiprOTILAr-z4Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13440-venison-stew-VAT-Beauty-4x3-0146bc02f50a42bfb63c8f07bdca9ca8.jpg"
