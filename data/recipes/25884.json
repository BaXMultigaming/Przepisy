  "ingredients": [
    "1 pound Italian sausage",
    "1 (8 ounce) can tomato sauce",
    "2 (10 ounce) packages frozen chopped spinach, thawed and drained",
    "2 cups cottage cheese",
    "0.5 cup grated Parmesan cheese",
    "1 egg, beaten",
    "2 cups shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Brown sausage in skillet over medium high heat. Drain fat from skillet and stir in tomato sauce. Set mixture aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the spinach, cottage cheese, Parmesan cheese and egg. Mix well and spread mixture in the bottom of a 9x13 inch baking dish. Spoon sausage mixture over spinach mixture and top with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
