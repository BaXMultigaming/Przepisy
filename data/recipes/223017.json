  "ingredients": [
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "2 cups blueberries",
    "1 cup buttermilk",
    "0.5 cup vegetable oil",
    "2 eggs",
    "1 tablespoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, blueberries, buttermilk, oil, eggs, baking powder, cinnamon, and salt in a large bowl, stirring after each addition. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
