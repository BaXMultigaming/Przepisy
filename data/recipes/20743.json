  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 teaspoon white sugar",
    "0.25 teaspoon salt",
    "1 cup milk",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Combine flour, sugar and salt in a bowl. Make a well in the center of the flour and add the milk and egg. Beat well to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle or frying pan over medium high heat. Pour the batter onto the griddle, using approximately 1/4 cup for each crepe. Tilt the pan with a circular motion so that the batter coats the surface evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the crepe for about 2 minutes, until the bottom is light brown. Loosen with a spatula, turn and cook the other side. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
