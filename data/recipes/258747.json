  "ingredients": [
    "1 cup water",
    "0.33333334326744 cup cornmeal",
    "0.25 cup whole milk",
    "0.25 cup coconut milk",
    "3 tablespoons white sugar",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground cinnamon",
    "2 tablespoons raisins"
  ],
  "steps": [
    {
      "text": "Combine water, cornmeal, whole milk, coconut milk, white sugar, vanilla extract, salt, nutmeg, and cinnamon in a blender; blend until smooth. Transfer to a saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring cornmeal mixture to a boil, whisking occasionally, until it begins to thicken, about 5 minutes. Reduce heat when slow bubbles form; continue cooking, stirring frequently, until desired thickness, about 5 minutes. Stir in raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat, cover, and cool slightly before serving, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
