  "ingredients": [
    "0.5 cup shortening",
    "0.5 cup brown sugar",
    "0.5 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.75 cup all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.125 teaspoon salt",
    "0.25 cup chopped walnuts",
    "1 cup cornflakes cereal",
    "1 cup quick cooking oats"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the shortening, brown sugar and white sugar. Stir in the egg and vanilla. Sift together the flour baking powder and salt, add to the creamed mixture and mix well. Finally, stir in the nuts, corn cereal and quick oats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by heaping spoonfuls onto the prepared cookie sheets. Press down slightly with a fork. Bake for 12 to 15 minutes in the preheated oven. Remove from cookie sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
