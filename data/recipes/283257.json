  "ingredients": [
    "2 cups chicken broth, or more as needed",
    "1 cup whole milk, divided",
    "2 teaspoons poultry seasoning",
    "1 teaspoon ground turmeric",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon granulated garlic",
    "0.5 teaspoon ground paprika",
    "0.25 teaspoon black pepper",
    "1 pinch cayenne pepper",
    "1 cup cream",
    "1 cup all-purpose flour, or more as needed"
  ],
  "steps": [
    {
      "text": "Combine 2 cups chicken broth, 1/2 cup milk, poultry seasoning, turmeric, onion powder, garlic, paprika, pepper, and cayenne in a saucepan over medium heat; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream, flour, and remaining milk in a bowl. Add a ladle or two of hot broth mixture and whisk quickly to combine. Pour the mixture back into the saucepan; whisk together and bring to a boil. Cook until thickened, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add additional broth or flour to adjust consistency. Check seasoning and adjust as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
