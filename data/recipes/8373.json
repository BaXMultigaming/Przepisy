  "ingredients": [
    "1 cup butter",
    "1 cup all-purpose flour",
    "1.5 cups white sugar",
    "1 teaspoon baking soda",
    "2 eggs",
    "2 cups chopped walnuts",
    "1 cup pureed dates"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter. Add sugar, eggs, dates and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour with baking soda. Add to date mixture and combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread into 9x13 inch pan. Bake at 350 degrees F (175 degrees C) for 30 minutes. Cool and cut into bars.",
