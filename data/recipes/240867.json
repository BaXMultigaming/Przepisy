  "ingredients": [
    "0.75 cup brown rice syrup",
    "0.5 cup coconut oil",
    "1 cup natural peanut butter",
    "1 teaspoon vanilla extract",
    "3 cups oats, or more to taste",
    "1 cup raisins",
    "0.5 cup unsweetened flaked coconut"
  ],
  "steps": [
    {
      "text": "Combine brown rice syrup and coconut oil in a saucepan over medium heat; cook and stir until melted and boiling, 3 to 4 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add peanut butter and vanilla to the syrup mixture and stir until smooth. Stir in oats, raisins, and coconut until well combined. Refrigerate mixture until cool, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form cooled mixture into balls. Freeze balls until set, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
