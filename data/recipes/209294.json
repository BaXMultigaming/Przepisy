  "ingredients": [
    "1 pint fresh blueberries",
    "1 pint fresh strawberries, sliced",
    "3 bananas, sliced",
    "1.5 cups white sugar",
    "1 teaspoon lemon juice",
    "1 tablespoon ground cinnamon",
    "2 teaspoons ground nutmeg",
    "0.5 cup all-purpose flour",
    "0.5 cup vital wheat gluten",
    "1 double crust ready-to-use pie crust"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the blueberries, strawberries, and sliced bananas into a mixing bowl. Sprinkle with the sugar, lemon juice, cinnamon, nutmeg, flour, and gluten; mix gently. Pour the fruit mixture into the pie shell, cover with the top crust, and pinch the seams shut. Cut slits in the top crust with a knife to create slots for the steam. Place the pie onto a baking sheet to catch drips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
