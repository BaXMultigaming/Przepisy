  "ingredients": [
    "1.25 (16 ounce) packages frozen corn kernels",
    "1 (8 ounce) package cream cheese",
    "0.5 cup butter",
    "0.5 cup milk",
    "1 tablespoon white sugar",
    "salt and pepper to taste"
  ],
  "steps": [
