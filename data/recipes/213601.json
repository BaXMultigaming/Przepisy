  "ingredients": [
    "2 cups uncooked brown rice",
    "2 cups water",
    "1 teaspoon salt",
    "1 (12 fluid ounce) can evaporated milk",
    "0.5 cup pure maple syrup",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 tablespoon vanilla extract",
    "0.5 teaspoon rum extract"
  ],
  "steps": [
    {
      "text": "Bring the rice, water, and salt to a boil in a pot; cover, reduce heat to medium-low, and simmer until the rice is tender and the liquid has been absorbed, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the evaporated milk, maple syrup, cinnamon, nutmeg, vanilla extract, and rum extract into the cooked rice. Continue simmering until the mixture thickens, about 5 minutes. Remove from heat and cover until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
