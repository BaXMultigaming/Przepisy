  "ingredients": [
    "2.25 cups dried split peas",
    "2 quarts cold water, plus more as needed",
    "1.5 pounds ham bone",
    "2 onions, thinly sliced",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 pinch dried marjoram",
    "3 stalks celery, chopped",
    "3 carrots, chopped",
    "1 potato, diced"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y8C4XAcG5K8sVjpImTtg-pBhmH0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13384-split-pea-soup-ddmfs-ingredients-3x4-0449-24a4800bef934acba2b18362f146e604.jpg"
      ],
      "image": "assets/images/13384/step_01.webp"
    },
    {
      "text": "Place peas in a large stockpot and cover with several inches of cold water; let soak, 1 hour to overnight. Drain, rinse, and return peas to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EsaNuTqtArwDRa-a7o5nWHCRVO0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13384-split-pea-soup-ddmfs-step-02-3x4-0461-59e6f844725f47e7a13a510931fc714c.jpg"
      ],
      "image": "assets/images/13384/step_02.webp"
    },
    {
      "text": "Add 2 quarts of cold water, ham bone, onion, salt, pepper, and marjoram to the stockpot. Cover, bring to a boil, and simmer for 1 ½ hours, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fY8OXp2qTBerdUL-5FzMSoMzoGY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13384-split-pea-soup-ddmfs-step-04-3x4-0547-d172a4203ba345dbbb109ac2d01182f8.jpg"
      ],
      "image": "assets/images/13384/step_03.webp"
    },
    {
      "text": "Remove ham bone; cut off meat, dice, and return meat to soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/25IUf1ufsrq9JGJe-6rcorJt9xk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13384-split-pea-soup-ddmfs-step-05-3x4-0550-e9aabe983bae4dbe8351ba71574daab5.jpg"
      ],
      "image": "assets/images/13384/step_04.webp"
    },
    {
      "text": "Add celery, carrots, and potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/66N0tz4R-zRt64eJE_tC5_IGgoU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13384-split-pea-soup-ddmfs-step-06-3x4-0554-0c062a86187747c7a879fd1a9f7cae49.jpg"
      ],
      "image": "assets/images/13384/step_05.webp"
    },
    {
      "text": "Cook slowly, uncovered, until vegetables are tender, about 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6Fa1bGG64kMovTYih27j-EV__2I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13384-split-pea-soup-ddmfs-step-07-3x4-0557-4459eb61d99b43cda0e505f4ad863c5c.jpg"
      ],
      "image": "assets/images/13384/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
