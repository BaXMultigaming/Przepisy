  "title": "Divine Spaghetti Sauce",
  "description": "An all-day spaghetti sauce. This long-simmered goodness is made with ground beef, tomatoes, mushrooms, onions, garlic, and more. Serve with pasta.",
  "authors": [
    "Lana"
  ],
  "date_published": "2000-02-14T13:15:14-05:00",
  "date_modified": "2022-11-30T13:07:19-05:00",
