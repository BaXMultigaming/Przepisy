  "keywords": [],
  "ingredients": [
    "1 pound lean ground beef",
    "2 (28 ounce) cans whole peeled tomatoes",
    "2 (6 ounce) cans tomato paste",
    "1 large onion, chopped",
    "4 stalks celery, chopped",
    "2 green bell peppers, chopped",
    "1 red bell pepper, chopped",
    "15 fresh mushrooms, sliced",
    "5 tablespoons Italian seasoning",
    "1 teaspoon dried red pepper flakes",
    "4 bay leaves",
    "2 tablespoons chopped fresh basil",
    "3 cloves garlic, minced",
    "1 pound spaghetti"
  ],
  "steps": [
    {
      "text": "Brown beef in a large skillet over medium heat until no longer pink; cut up any remaining chunks of beef and reserve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine whole tomatoes and paste in a large saucepan; mash until smooth. Cover and heat on low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Quickly sear onion and celery in a large skillet over medium heat until transparent; add to the tomato sauce in the saucepan. Sauté bell peppers and mushrooms in the same skillet for a few minutes, but do not allow them to become soft; add to tomato sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add Italian seasoning, dried red pepper flakes, bay leaves, basil, and garlic to tomato sauce; add beef and mix. Remove cover, simmer over low heat and continue to simmer all day, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sauce to pasta; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
