  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "1 cup sour cream",
    "1 (1 ounce) package ranch dressing mix",
    "1 teaspoon garlic salt",
    "1 teaspoon garlic powder",
    "1.5 cups chopped romaine lettuce",
    "0.5 cup chopped tomatoes",
    "0.5 cup crumbled blue cheese, or more to taste",
    "0.5 cup cooked real bacon bits",
    "1 tablespoon chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Combine cream cheese, sour cream, ranch dressing mix, garlic salt, and garlic powder in a blender or food processor; mix well. Spread mixture into the bottom of a 9-inch pie plate. Top with lettuce, tomatoes, blue cheese, bacon, and chives.",
