  "ingredients": [
    "nonstick cooking spray",
    "1 (15.25 ounce) package spice cake mix",
    "1 (15 ounce) can pumpkin puree",
    "2 teaspoons pumpkin pie spice",
    "1 cup powdered sugar",
    "4 tablespoons almond milk",
    "0.5 teaspoon pumpkin pie spice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray donut pans with nonstick cooking spray. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cake mix, pumpkin, and pumpkin pie spice together in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a pastry bag with the mixture and fill greased donut cups halfway full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the centers comes out clean, 10 to 12 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While donuts cool, mix powdered sugar, almond milk, and pumpkin pie spice for glaze together until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip donuts in glaze and place back on the wire rack until set, 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
