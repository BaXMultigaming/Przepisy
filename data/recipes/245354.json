  "ingredients": [
    "6 cups unsweetened vanilla-flavored almond milk",
    "6 large egg yolks",
    "0.66666668653488 cup coconut sugar",
    "0.5 cup cornstarch",
    "1 teaspoon sea salt",
    "1 cup toasted unsweetened shredded coconut",
    "0.25 cup butter",
    "1 tablespoon bourbon vanilla extract",
    "3 bananas, sliced"
  ],
  "steps": [
    {
      "text": "Mix almond milk, egg yolks, coconut sugar, cornstarch, and salt together in a large saucepan and, stirring constantly, bring to a boil. Cook and stir almond milk mixture until it thickens, 1 to 2 minutes. Stir shredded coconut, butter, and vanilla extract into milk mixture. Remove saucepan from heat and allow pudding to cool to room temperature.",
