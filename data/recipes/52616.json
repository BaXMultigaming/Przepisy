  "ingredients": [
    "1.25 cups fresh gooseberries",
    "1 cup white sugar",
    "1 recipe pastry for double-crust pie",
    "2 tablespoons all-purpose flour",
    "1 pinch salt",
    "1 cup sour cream",
    "2 eggs, beaten",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine gooseberries and sugar in a medium bowl. Set aside for 15 minutes. Press 1 pie crust into bottom and up sides of a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour and salt together in a separate bowl; add sour cream, eggs, and vanilla extract. Stir in gooseberry mixture until well combined; spoon filling into pie crust. Place remaining 1 crust over top. Crimp edges to seal; cut some decorative ventilation slits into top crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 55 minutes. Cool to room temperature; refrigerate until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
