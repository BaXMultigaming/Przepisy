  "ingredients": [
    "2.5 quarts whole tomatoes",
    "0.25 yellow onion, diced",
    "0.75 cup extra-virgin olive oil , divided",
    "salt and freshly ground black pepper to taste",
    "2 cups fresh tomato juice",
    "2 cloves garlic, minced",
    "1 green bell pepper, finely chopped",
    "1 red bell pepper, finely chopped",
    "2 banana peppers, finely chopped",
    "2 cups chicken broth",
    "0.25 cup white sugar",
    "3 tablespoons butter",
    "0.5 cup heavy cream",
    "0.25 cup chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tomatoes and onion on a rimmed baking sheet; drizzle with about 1/4 cup olive oil. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until well browned and softened, about 15 minutes. Let cool until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining olive oil and tomato juice in a saucepan over medium-low heat. Add garlic and the roasted onion; cook until softened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chop the roasted tomatoes and add to the soup. Add bell peppers, banana peppers, chicken broth, sugar, and butter. Simmer until vegetables are very tender, about 20 minutes. Remove from heat and puree until smooth in a blender or using an immersion blender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return bisque to the pan and add cream. Simmer over low heat until heated through, about 15 minutes. Garnish with basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
