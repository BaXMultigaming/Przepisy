  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup white whole wheat flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 tablespoons unsalted butter",
    "0.75 cup natural creamy peanut butter",
    "0.66666668653488 cup brown sugar",
    "0.75 cup milk, or more as needed",
    "1 egg, beaten",
    "1 teaspoon vanilla extract",
    "1 cup peeled and diced apple",
    "1 cup peanut butter chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flours, baking powder, baking soda, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small saucepan. Stir in peanut butter and brown sugar. Remove from heat and add milk, egg, and vanilla extract. Add butter mixture to the flour mixture, mixing until just blended. Add more milk, 1 tablespoon at a time, if the batter seems dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add apple and peanut butter chips, stirring gently to distribute. Divide the batter evenly among the muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
