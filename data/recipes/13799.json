  "ingredients": [
    "0.5 cup vegetable oil",
    "0.33333298563957 cup chopped onion",
    "5 cloves garlic, minced",
    "0.5 cup all-purpose flour",
    "4 teaspoons nutritional yeast",
    "4 tablespoons light soy sauce",
    "2 cups vegetable broth",
    "0.5 teaspoon dried sage",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XrOEjhYiV1zH6dl1eoMDmFMODQk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13799-vegetarian-gravy-VAT-step-01-23dacb190d2045ca9973f506c66427d4.jpg"
      ],
      "image": "assets/images/13799/step_01.webp"
    },
    {
      "text": "Heat oil in a medium saucepan over medium heat. Stir in onion and garlic. Cook and stir until onion has softened and turned translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N5rwidADj6vGdeWDdmoL5hMvFKU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13799-vegetarian-gravy-VAT-step-02-754e0dd8a30d41b09173b8190cd3d1af.jpg"
      ],
      "image": "assets/images/13799/step_02.webp"
    },
    {
      "text": "Stir in flour, nutritional yeast, and soy sauce to form a smooth paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TcGR1gAe7twCS1f6i8h2yawcr64=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13799-vegetarian-gravy-VAT-step-03-a398c46aec614c50a3c715232f84c841.jpg"
      ],
      "image": "assets/images/13799/step_03.webp"
    },
    {
      "text": "Gradually whisk in broth. Season with sage, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AtNYlhwVKRXv3BSw6EQbBaNSSKc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13799-vegetarian-gravy-VAT-step-04-1e4e47800d4c4610b87ba519a6294439.jpg"
      ],
      "image": "assets/images/13799/step_04.webp"
    },
    {
      "text": "Bring to a boil. Reduce heat, and simmer, stirring constantly, for 8 to 10 minutes, or until thickened. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iICw2vWs3YElAyTvpKKizWVmY14=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13799-vegetarian-gravy-VAT-step-05-27d779f9007e4dc68df36178439e75e1.jpg"
