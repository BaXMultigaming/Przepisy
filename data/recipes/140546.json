  "ingredients": [
    "6 medium sweet potatoes, peeled and chopped",
    "2 cups chicken or vegetable stock",
    "1 cup water, or as needed",
    "1 tablespoon minced fresh ginger",
    "1 lime, juiced",
    "2 cups milk or cream, or as needed"
  ],
