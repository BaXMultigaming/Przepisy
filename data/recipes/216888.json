  "title": "Good New Orleans Creole Gumbo",
  "description": "Traditional Creole gumbo made with roux, shrimp, sausage, and crabmeat. Delicious served over hot cooked rice.",
  "authors": [
    "Mddoccook"
  ],
  "date_published": "2020-06-18T23:44:10-04:00",
