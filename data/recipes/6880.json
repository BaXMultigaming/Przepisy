  "ingredients": [
    "4 cups shortening for frying",
    "4 cups all-purpose flour",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1.5 cups warm water (110 degrees F/45 degrees C)"
  ],
  "steps": [
    {
      "text": "Heat shortening in a heavy saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZeJVnsOPejsPHLMkc9xyw5OfjkI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6880-fry-bread-step-1-69-a2d7b553d6c44871bc888a656d35d5bb.jpg"
      ],
      "image": "assets/images/6880/step_02.webp"
    },
    {
      "text": "Stir in warm water and knead until soft but not sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aJokPMJmCz6teVXxCo-S65aCN8U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6880-fry-bread-step-2-72-81afaad1fb0c4444acfef06f92b7d61c.jpg"
      ],
      "image": "assets/images/6880/step_03.webp"
    },
    {
      "text": "Shape dough into twelve 3-inch diameter ball. Flatten into 1/2-inch-thick patties, and make a small hole in the center of each patty.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1VUJGNUxzhJvKrBOSvd9LV1nHXs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6880-fry-bread-step-3-74-f3aa717206c547378e71d3b695376bba.jpg"
      ],
      "image": "assets/images/6880/step_04.webp"
    },
    {
      "text": "Fry in 1-inch deep hot shortening one at a time until golden brown, 1 to 2 minutes per side. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
