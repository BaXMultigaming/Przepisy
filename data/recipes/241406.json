  "ingredients": [
    "1 (15 ounce) can sliced beets, drained with 1/2 cup liquid reserved",
    "1.5 cups white sugar",
    "3 eggs",
    "0.5 cup olive oil",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.75 cup unsweetened cocoa powder",
    "1.5 teaspoons baking soda",
    "0.5 teaspoon salt",
    "0.5 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease three 8x4x2-inch bread pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend beets and reserved liquid in a blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat pureed beets, sugar, eggs, olive oil, and vanilla extract together in a large bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour cocoa powder, baking soda, and salt together in a separate bowl; add to the beet mixture and stir into a smooth batter. Fold chocolate chips into the batter. Pour batter into prepared bread pans to about 3/4-full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into the center comes out clean, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
