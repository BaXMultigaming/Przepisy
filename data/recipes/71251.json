  "ingredients": [
    "2 pounds ground turkey",
    "1 cup milk",
    "1 cup Italian seasoned bread crumbs",
    "2 eggs",
    "1 teaspoon salt",
    "0.25 teaspoon pepper",
    "0.75 pound Colby cheese, cut into 1/2-inch cubes",
    "0.5 cup ketchup"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix the turkey, milk, bread crumbs, and eggs by hand. Season with salt and pepper. Fold the cheese cubes into the mixture. Transfer to a loaf pan, and top with ketchup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 1 hour in the preheated oven, to an internal temperature of 180 degrees F (85 degrees C).",
