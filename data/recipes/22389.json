  "ingredients": [
    "5 cups bread cubes",
    "1.5 cups milk",
    "4 large eggs",
    "0.25 cup white sugar, divided",
    "0.25 teaspoon salt",
    "1 teaspoon vanilla extract",
    "1 tablespoon margarine, softened",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y6WpfGxcP4OYYz8NH_fXI3bmucU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22389-french-toast-casserole-VAT-step-01-528c9f1b463440dc8e6de8e9f4429953.jpg"
      ],
      "image": "assets/images/22389/step_01.webp"
    },
    {
      "text": "Line the bottom of the prepared pan with bread cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xMa8Ora_nt7Ui71rj5ClXwd9Obg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22389-french-toast-casserole-VAT-step-02-5d54c51ff72c490c8ec038ceb87aef56.jpg"
      ],
      "image": "assets/images/22389/step_02.webp"
    },
    {
      "text": "Beat milk, eggs, 2 tablespoons sugar, salt, and vanilla together in a large bowl until well combined; pour over bread cubes and stir to coat. Dot with butter; let stand for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Gy0Y6KYf1AG4rHJ9rrCD3dLHAvc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22389-french-toast-casserole-VAT-step-03-5718e7e53a5b4a6a865f9138156eef0b.jpg"
      ],
      "image": "assets/images/22389/step_03.webp"
    },
    {
      "text": "Combine remaining 2 tablespoons sugar with cinnamon; sprinkle over top of casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NySJOw3V6UcurkTyTDevAOVuihQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22389-french-toast-casserole-VAT-step-04-6f0b79aea85141f2b37bcf5d10b4d72c.jpg"
      ],
      "image": "assets/images/22389/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until the center is set and top is golden, about 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qZ2A5bY8XqGzyYcAKZg0y18ft-U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22389-french-toast-casserole-VAT-step-05-38113c2942f14fb89d65407dfd90cbf5.jpg"
      ],
      "image": "assets/images/22389/step_05.webp"
    },
