  "title": "Authentic Enchiladas Verdes",
  "description": "This authentic chicken enchilada recipe features warm tortillas and shredded meat topped with salsa verde made with tomatillos, serranos, and garlic.",
  "authors": [
    "PattiVerde"
  ],
  "date_published": "2003-03-28T12:43:33-05:00",
  "date_modified": "2026-06-20T22:49:08-04:00",
