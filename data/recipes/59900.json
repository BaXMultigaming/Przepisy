    "4"
  ],
  "categories": [
    "Dinner"
  ],
  "cuisines": [
    "Mexican"
  ],
  "regions": [
    "Mexican"
  ],
  "breadcrumbs": [],
  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "2 bone-in chicken breast halves",
    "2 cups chicken broth",
    "0.5 white onion, halved, divided",
    "2 teaspoons salt",
    "2 cloves garlic, divided",
    "1 pound fresh tomatillos, husks removed",
    "5 serrano peppers",
    "1 pinch salt",
    "0.25 cup vegetable oil",
    "12 corn tortillas",
    "1 cup crumbled queso fresco",
    "0.5 white onion, chopped",
    "1 bunch fresh cilantro, chopped"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RwMLrSArBdOIg3VIWNtjO_c2JCY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59900_Authentic_Enchiladas_Verdes_DDMFS_Step_1_5654-c85b57dcb60e4ecf9e1a9f8dfc8d5535.jpg"
      ],
      "image": "assets/images/59900/step_01.webp"
    },
    {
      "text": "Combine chicken, broth, one quarter onion, salt, and 1 clove garlic in a medium saucepan; bring to a boil. Cook until chicken is no longer pink in the center and the juices run clear, about 20 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KQ_oCJtlqajsEoiNAHJJ72GRrfw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59900_Authentic_Enchiladas_Verdes_DDMFS_Step_2_5656-73665b36cd754d2da25b5e19f29aa734.jpg"
      ],
      "image": "assets/images/59900/step_02.webp"
    },
    {
      "text": "Remove chicken to a large bowl to cool. Reserve broth; discard onion and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4sFgl3f8FxogjM03yCJaXeqKtTk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59900_Authentic_Enchiladas_Verdes_DDMFS_Step_3_5675-7c74e6b9aa5e428b9fc6dac28fbdc77a.jpg"
      ],
      "image": "assets/images/59900/step_03.webp"
    },
    {
      "text": "When cool enough to handle, shred chicken with your hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qhkNFoTVCtdoxFFomw3ejiDnvII=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59900_Authentic_Enchiladas_Verdes_DDMFS_Step_4_5687-4ff8128a9bd64d7d86666339dd6cf6c1.jpg"
      ],
      "image": "assets/images/59900/step_04.webp"
    },
    {
      "text": "Place tomatillos and serrano peppers in a medium pot and cover with water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eV1QRDcuQ-IgbmZDxllAghRijHQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59900_Authentic_Enchiladas_Verdes_DDMFS_Step_5_56545660-7bf62fc308454cc2bb6faf702ca7e2dc.jpg"
      ],
      "image": "assets/images/59900/step_05.webp"
    },
    {
      "text": "Bring to a boil and cook until tomatillos turn from bright green to dull, army green.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vTdZ2AYswTENMFpClPJrJ2Bnftk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59900_Authentic_Enchiladas_Verdes_DDMFS_Step_6_5676-5d67921af7d64726b24b274c0b93b776.jpg"
      ],
      "image": "assets/images/59900/step_06.webp"
    },
    {
      "text": "Strain tomatillos and peppers and place in a blender. Add remaining one quarter onion, remaining 1 clove garlic, and a pinch of salt. Pour in enough reserved broth to cover vegetables in the blender by about 1 inch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3PkokacmwcIz2wW-HLQLt8mVUjM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59900_Authentic_Enchiladas_Verdes_DDMFS_Step_8_5682-7a190d202fb24c10a0d536b3158ed4f9.jpg"
      ],
      "image": "assets/images/59900/step_07.webp"
    },
    {
      "text": "Blend until completely puréed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yKAra_9YezK43sNVWTFA4Qirplg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59900_Authentic_Enchiladas_Verdes_DDMFS_Step_10_5683-2eddcee8e4f24422b2d852e832d13b8b.jpg"
      ],
      "image": "assets/images/59900/step_08.webp"
    },
    {
      "text": "Pour salsa into a medium saucepan and bring to a low boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/llT2TvGkN5MpG5M-WiD0l-juchY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59900_Authentic_Enchiladas_Verdes_DDMFS_Step_8_5686-3d68fd69af6f4955841c97e9236b7a0e.jpg"
      ],
      "image": "assets/images/59900/step_09.webp"
    },
    {
      "text": "Heat oil in a small frying pan over medium-high heat until very hot. Lightly fry tortillas, one at time, in hot oil. Remove to paper towels to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LTife2cNrNnW6mt_ojGU_UlnM6I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59900_Authentic_Enchiladas_Verdes_DDMFS_Step_11_5691-168197bddc9346ecaf93c1719ffeac68.jpg"
      ],
      "image": "assets/images/59900/step_10.webp"
    },
    {
      "text": "Dip tortillas in low-boiling salsa until they become soft again. Place onto plates, 3 per person.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dEmiYJQOZ_qmLmf6lUobHEfo6VU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59900_Authentic_Enchiladas_Verdes_DDMFS_Step_12_5693-dcf475a105fb42528a07b5224e887ab0.jpg"
      ],
      "image": "assets/images/59900/step_11.webp"
    },
    {
      "text": "Fill or cover tortillas with shredded chicken, then top with salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ngvkkGykCvtflpb34_EUAThEdI4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59900_Authentic_Enchiladas_Verdes_DDMFS_Step_13_5695-48e73f2322a7479091a511c33695fd77.jpg"
      ],
      "image": "assets/images/59900/step_12.webp"
    },
    {
      "text": "Sprinkle with queso fresco, onion, and cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0ddQnosijvRAWmySDbwN232yCao=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/59900_Authentic_Enchiladas_Verdes_DDMFS_Step_14_5697-32375225f1f343128ab9b49cf8348193.jpg"
      ],
      "image": "assets/images/59900/step_13.webp"
    }
  ],
