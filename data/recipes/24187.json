  "ingredients": [
    "1 (1 pound) loaf frozen bread dough",
    "1 tablespoon extra virgin olive oil",
    "0.5 tablespoon dried basil leaves",
    "0.5 tablespoon dried minced onion flakes",
    "0.5 tablespoon dried oregano",
    "1 (8 ounce) package sliced pepperoni sausage",
    "1 (6 ounce) package shredded mozzarella cheese",
    "1 large egg, lightly beaten"
  ],
  "steps": [
    {
      "text": "Allow frozen bread dough to thaw in the refrigerator, 8 hours to overnight. Place dough in a large, lightly greased bowl. Cover the bowl with a dish towel and place in a warm space until doubled in size, 2 to 3 hours. Punch down dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into a 12x18-inch rectangle on the prepared baking sheet. Brush dough lightly with olive oil. Sprinkle with basil, onion flakes, and oregano. Layer with pepperoni to within 1/2 inch of the edges. Top with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beginning with the longest edge, roll dough into a thin cylinder and seal the seam. Brush with beaten egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 35 minutes. Cut into bite-sized pieces to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
