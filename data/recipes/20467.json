  "ingredients": [
    "2.25 cups white sugar",
    "2 tablespoons all-purpose flour",
    "6 eggs",
    "1 cup buttermilk",
    "1 cup flaked coconut",
    "1 cup chopped pecans",
    "0.5 cup margarine, melted",
    "2 prepared 8 inch pastry shells"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and flour in a small bowl. Whisk eggs together in a large bowl; whisk in sugar mixture until smooth. Stir in buttermilk, coconut, pecans, and margarine; pour into unbaked pie crusts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes.",
      "section": null,
      "name": null,
