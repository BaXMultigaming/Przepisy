  "ingredients": [
    "2 ripe bananas, peeled",
    "1 Hachiya persimmon, peeled",
    "0.75 cup white sugar",
    "0.33333334326744 cup coconut oil, melted",
    "1 egg",
    "2 teaspoons vanilla extract",
    "1.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 tablespoon white sugar",
    "1.5 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line 6 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash bananas and persimmon together in the bowl of a stand mixer. Add 3/4 cup sugar, coconut oil, egg, and vanilla extract, 1 at a time, mixing well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and salt together in a separate bowl. Stir flour mixture into banana mixture using a spoon just until batter is combined. Fill each muffin cup 3/4-full with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1 tablespoon sugar and cinnamon together in a bowl; sprinkle over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, 18 to 23 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
