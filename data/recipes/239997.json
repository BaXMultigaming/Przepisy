  "title": "Banana and Persimmon Cinnamon Muffins",
  "description": "Banana and persimmon muffins with a cinnamon and sugar topping are a tasty breakfast treat for the fall months.",
  "authors": [
    "Anna Silvani-Morrison"
  ],
  "date_published": "2020-06-19T00:01:20-04:00",
