  "ingredients": [
    "1 pound thick cut bacon",
    "1 pound lean ground beef",
    "0.5 pound sage pork sausage",
    "1 clove garlic, crushed",
    "1 large onion, cut into 1/2-inch pieces",
    "1 cup dark brown sugar",
    "1 cup real maple syrup",
    "1 cup ketchup",
    "0.25 cup prepared yellow mustard",
    "0.5 cup chipotle sauce",
    "1 (16 ounce) can baked beans",
    "1 (16 ounce) can kidney beans",
    "1 (16 ounce) can black beans",
    "1 (16 ounce) can pinto beans",
    "1 (16 ounce) can great Northern beans",
    "1 (16 ounce) can cannellini beans",
    "1 tablespoon chili powder",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Place bacon in a Dutch oven over medium-high heat and cook until evenly brown. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beef, sausage, and garlic in a Dutch oven and cook over medium-high heat until well done. Drain grease. Mix in onion and cook until tender. Stir in brown sugar, syrup, ketchup, mustard, and chipotle sauce. Reduce heat to medium-low. Bring to a boil and cook for 20 minutes, stirring often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bacon, baked beans, kidney beans, black beans, pinto beans, great Northern beans, and cannellini beans in a Dutch oven. Continue cooking for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil. Season beans with chili powder and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the Dutch oven on a prepared baking sheet on the lowest rack of a preheated oven. Bake for 30 minutes. Let stand 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
