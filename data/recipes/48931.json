  "ingredients": [
    "6 onions, sliced",
    "1 (4 pound) bottom round roast",
    "salt and pepper to taste",
    "1 tablespoon white vinegar",
    "1 bay leaf",
    "1 cup water",
    "1 tablespoon all-purpose flour"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
