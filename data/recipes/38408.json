  "ingredients": [
    "2 slices bacon",
    "8 small zucchini, cut into 1/2 inch slices",
    "0.5 red onion, thinly sliced",
    "1 pinch salt",
    "2 medium tomatoes, cut into wedges",
    "0.125 teaspoon dried basil",
    "ground black pepper to taste",
    "0.25 cup crumbled blue cheese"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet. Cook over medium-high heat until evenly brown. Crumble, and return to pan. Add zucchini, onion, and salt to the bacon; cook, stirring frequently, until zucchini is tender-crisp. Add tomato wedges, basil, and ground black pepper; heat, stirring gently, until tomatoes are warm.",
      "section": null,
