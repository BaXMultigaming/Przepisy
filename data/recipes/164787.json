  "title": "Real Welsh Rarebit",
  "description": "Welsh rarebit is a smooth cheese sauce flavored with mustard and beer served over toast and broiled until bubbly for a fancy version of cheese on toast.",
  "authors": [
    "MOMFISH"
  ],
  "date_published": "2019-04-02T02:50:23-04:00",
