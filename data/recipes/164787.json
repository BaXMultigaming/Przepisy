  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "0.25 cup butter",
    "0.25 cup all-purpose flour",
    "0.5 teaspoon salt",
    "0.25 teaspoon pepper",
    "0.25 teaspoon dry mustard",
    "0.25 teaspoon Worcestershire sauce",
    "2 drops hot pepper sauce (such as Tabasco®)",
    "1 cup whole milk",
    "0.5 cup beer",
    "0.5 pound Cheddar cheese, shredded",
    "6 slices bread"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ou3djjdrU0OzEDwR87f74w9Io1M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-164787-Real-Welsh-Rarebit-DDMFS-4x3-step-01-a6d22adc212e49f1b1d95d0577e8315a.jpg"
      ],
      "image": "assets/images/164787/step_01.webp"
    },
    {
      "text": "Melt butter in a saucepan over low heat. Stir in flour, salt, pepper, mustard, Worcestershire sauce, and hot pepper sauce. Cook and stir until smooth and bubbly, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8FavBAmmm9gpVbLmTIMaLxQTQMc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-164787-Real-Welsh-Rarebit-DDMFS-4x3-step-02-23454ba62c37494f83adf1974311dc4d.jpg"
      ],
      "image": "assets/images/164787/step_02.webp"
    },
    {
      "text": "Remove the saucepan from the heat. Gradually stir in milk, then return to heat and stir continuously until mixture comes to a boil. Slowly pour in beer; cook and stir for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2b2AjBOV5uepyk1s8EY_O_v45DU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-164787-Real-Welsh-Rarebit-DDMFS-4x3-step-03-7e83d31f743a4de4bfa31fc3b52e7255.jpg"
      ],
      "image": "assets/images/164787/step_03.webp"
    },
    {
      "text": "Melt Cheddar cheese into mixture in small portions until completely incorporated. Set the oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zP9pEjnDHpWmn3_udglSG5upbEI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-164787-Real-Welsh-Rarebit-DDMFS-4x3-step-04-1-00ef93fba677406ba89899770b553f68.jpg"
      ],
      "image": "assets/images/164787/step_04.webp"
    },
    {
      "text": "Toast bread slices on 1 side. Arrange on a baking sheet with the untoasted side facing up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V6rXZ8wCf_HmhGhdsGt1ahAKIJI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-164787-Real-Welsh-Rarebit-DDMFS-4x3-step-05-f0da07178a244db9b64ad55b8f9e5df6.jpg"
      ],
      "image": "assets/images/164787/step_05.webp"
    },
    {
      "text": "Spoon cheese sauce over untoasted side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X8-esuY1PKHFS0nE_4EfUxs5J7A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-164787-Real-Welsh-Rarebit-DDMFS-4x3-step-06-1-6a1f47e2550a4729a0f80cec0390ad8e.jpg"
      ],
      "image": "assets/images/164787/step_06.webp"
    },
    {
      "text": "Cook under the preheated broiler until cheese sauce is bubbling and golden, 2 to 3 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OClURnU8JjCIha4Vw275pgY3IaQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-164787-Real-Welsh-Rarebit-DDMFS-4x3-step-07-c5241f1909464818b145685364c7cbea.jpg"
      ],
      "image": "assets/images/164787/step_07.webp"
    }
