  "ingredients": [
    "1 (15.25 ounce) can whole kernel corn, drained",
    "1 cup shredded sharp Cheddar cheese",
    "1 (4.5 ounce) can chopped green chiles, undrained",
    "0.5 cup sour cream",
    "0.5 cup mayonnaise",
    "0.25 cup crumbled feta cheese",
    "1 package McCormick® White Chicken Chili Seasoning Mix",
    "2 tablespoons chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all ingredients, except cilantro, in a large bowl until well blended. Spoon into a lightly greased 1 1/2- to 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 minutes or until heated through. Sprinkle with cilantro. Serve with corn chips or tortilla chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
