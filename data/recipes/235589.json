  "title": "Chef John&#39;s Creamy Mushroom Soup",
  "description": "This mushroom soup is creamy, rich, and deliciously savory thanks to the caramelization of the mushrooms in butter that unlocks their earthy flavor.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2013-11-21T18:17:49-05:00",
  "date_modified": "2026-03-11T18:11:07-04:00",
