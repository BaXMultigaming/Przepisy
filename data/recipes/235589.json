  "ingredients": [
    "0.25 cup unsalted butter",
    "2 (16 ounce) packages sliced fresh mushrooms",
    "1 pinch salt",
    "1 medium yellow onion, diced",
    "1.5 tablespoons all-purpose flour",
    "4 cups chicken broth, or more to taste",
    "1 cup water, or more to taste",
    "6 sprigs fresh thyme, tied in a bundle with kitchen twine",
    "2 cloves garlic, peeled",
    "1 cup heavy whipping cream",
    "1 salt and freshly ground black pepper to taste",
    "1 teaspoon fresh thyme leaves for garnish, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mNavFvZiJXouZLtboPVARcvgPuA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235589-ChefJohnsCreamyMushroomSoup-mfs-Step1-4x3-e312f64a6cca42b8801ea54b96e6ab0a.jpg"
      ],
      "image": "assets/images/235589/step_01.webp"
    },
    {
      "text": "Melt butter in a large soup pot over medium-high heat. Add mushrooms and 1 pinch salt; cook until mushrooms release their juices, 5 to 10 minutes. Reduce heat to medium-low; continue cooking, stirring often, until juices evaporate and mushrooms are caramelized, 15 to 25 minutes. Set aside a few attractive mushroom slices for garnish later, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion to mushrooms; cook and stir until onion is soft and translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3NxGEFg0uCdE9QHAaGj6fbuj0yQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235589-ChefJohnsCreamyMushroomSoup-mfs-Step2-4x3-474e9df2b7514cde9b935f03849cf267.jpg"
      ],
      "image": "assets/images/235589/step_03.webp"
    },
    {
      "text": "Stir in flour; cook, stirring often, to remove raw flour taste, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in 4 cups chicken broth and 1 cup water; add thyme bundle and garlic cloves. Reduce heat to low; simmer for 1 hour. Remove and discard thyme bundle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TKdOuY--jAEo78lvTdUVFa8EQK8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235589-ChefJohnsCreamyMushroomSoup-mfs-Step3-4x3-13d7d12eb3b040c3b1cf0c688a13b40f.jpg"
      ],
      "image": "assets/images/235589/step_05.webp"
    },
    {
      "text": "Fill blender halfway with soup. Cover and hold lid down with a potholder; pulse a few times before leaving on to blend until smooth and thick. Pour into a pot. Repeat with remaining soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9F4x7E2ALGUzqyuKfUl_Rbr9IZA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235589-ChefJohnsCreamyMushroomSoup-mfs-Step6-4x3-ff8fc4ea64de4934a06c053c1c88d292.jpg"
      ],
      "image": "assets/images/235589/step_06.webp"
    },
    {
      "text": "Stir in cream; if too thick, add a little chicken broth or water. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/diztv3B4lhFKQgMfUeiXLPEA-_M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235589-ChefJohnsCreamyMushroomSoup-mfs-Step7-4x3-56ed2cd2bdd34967bcfde33fd25f4930.jpg"
      ],
      "image": "assets/images/235589/step_07.webp"
    },
    {
      "text": "Divide soup among bowls; garnish with reserved mushroom slices and thyme leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DOgMge2dJv0Plavei2oPjvUm7o8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235589-chef-johns-creamy-mushroom-soup-DDMFS-4x3-14854a8dc51c4c4c80cc5631299a873b.jpg"
      ],
      "image": "assets/images/235589/step_08.webp"
    }
