  "ingredients": [
    "1.5 pounds lean ground beef",
    "0.5 onion, finely chopped",
    "0.5 cup shredded Colby Jack or Cheddar cheese",
    "1 egg",
    "1 (1 ounce) envelope dry onion soup mix",
    "1 clove garlic, minced",
    "1 tablespoon garlic powder",
    "1 teaspoon soy sauce",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon dried parsley",
    "1 teaspoon dried basil",
    "1 teaspoon dried oregano",
    "0.5 teaspoon crushed dried rosemary",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lUfalFxiXoT7akl6TZyhr5WmGBk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72657-best-hamburger-ever-ddmfs-4x3-step-01-ingredients-a8e347a97d0541f3a96e02ff7001a04f.jpg"
      ],
      "image": "assets/images/72657/step_01.webp"
    },
    {
      "text": "Meanwhile, combine ground beef, onion, cheese, egg, onion soup mix, minced garlic, garlic powder, soy sauce, Worcestershire sauce, parsley, basil, oregano, rosemary, salt, and pepper in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SX9j98LHQqb1kOrAxVIyu9icPsA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72657-best-hamburger-ever-ddmfs-4x3-step-02a-b6bcbf8d07424686b3b974c3ceeaf249.jpg"
      ],
      "image": "assets/images/72657/step_02.webp"
    },
    {
      "text": "Use your hands to form the mixture into 4 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zao2wrkFXksAl2m53Cg8L3FnIBQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72657-best-hamburger-ever-ddmfs-4x3-step-03-8e6bb9c5be3c45f3afcb118aa768d8ea.jpg"
      ],
      "image": "assets/images/72657/step_03.webp"
    },
    {
      "text": "Cook patties on the preheated grill until no longer pink in the center and the juices run clear, about 4 to 5 minutes per side.",
