  "title": "Bacon Macaroni and Cheese",
  "description": "This recipe makes a rich and creamy baked mac and cheese with penne pasta, bacon, onion, and garlic in a creamy white sauce loaded with Cheddar.",
  "authors": [
    "Abbey Robb"
  ],
  "date_published": "1999-07-03T10:24:09-04:00",
  "date_modified": "2025-08-08T15:27:57-04:00",
