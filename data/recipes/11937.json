    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 slices bacon",
    "8 ounces penne pasta",
    "1 onion, chopped",
    "1 clove garlic, minced",
    "3 cups shredded Cheddar cheese",
    "2 tablespoons butter",
    "3 tablespoons all-purpose flour",
    "2 cups milk"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RkvJ3bzVLmQxlbjzH3D3fADuAQQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11937-baked-macaroni-and-cheese-i-VAT-step-01-c4283940e456418db2866e86b7af3e69.jpg"
      ],
      "image": "assets/images/11937/step_01.webp"
    },
    {
      "text": "Cook pasta in a large pot with boiling salted water until al dente. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mHsouVGDHCCAQjflb3-6UKM3ftc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11937-baked-macaroni-and-cheese-i-VAT-step-02-fedadd49fa7643ec9fc7b24f896ecea8.jpg"
      ],
      "image": "assets/images/11937/step_02.webp"
    },
    {
      "text": "Meanwhile, place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Remove bacon, drain on paper towels, then crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i8jh6gypbEPQ4l9KU2hSERQ8v8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11937-baked-macaroni-and-cheese-i-VAT-step-03-5e52020374b04faeaa71ea28afc33472.jpg"
      ],
      "image": "assets/images/11937/step_03.webp"
    },
    {
      "text": "Add onion and garlic into the skillet; cook and stir in bacon grease until softened and fragrant. Remove from heat and add chopped cooked bacon; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E0vmbsoZ_zpXdwt3yNsBDyZlqWc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11937-baked-macaroni-and-cheese-i-VAT-step-04-d375447a5bdc43e0bac7271aea5529b1.jpg"
      ],
      "image": "assets/images/11937/step_04.webp"
    },
    {
      "text": "To make the sauce: Melt butter in a medium saucepan over low heat; add flour and stir constantly for 2 minutes. Gradually add milk and continue stirring until thickened. Stir in 2 cups of the grated Cheddar cheese until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VobRH_1fngauqkLHcKBuRMDW4YA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11937-baked-macaroni-and-cheese-i-VAT-step-05-3cb8c1af9d914d6681ed2d960a7cdce6.jpg"
      ],
      "image": "assets/images/11937/step_05.webp"
    },
    {
      "text": "Combine cooked pasta, bacon and onion mixture, and white sauce; pour into a 2-quart casserole dish. Sprinkle remaining 1 cup grated Cheddar cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZsUoLXe4FWJK9RZSWMj59u0_rpw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11937-baked-macaroni-and-cheese-i-VAT-step-06-7a5e6882dd074f83b775fb47578dc08c.jpg"
      ],
      "image": "assets/images/11937/step_06.webp"
    },
    {
      "text": "Bake uncovered in preheated oven until cheese on top is melted and brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K3p9s3s5-UEP1bhBEtsIZsBZ4bU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11937-baked-macaroni-and-cheese-i-VAT-step-07-e017f568f3b545d6bf9957180a2ff275.jpg"
      ],
      "image": "assets/images/11937/step_07.webp"
    },
    {
      "text": "Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0yDHqmzpse6AfED2sf7-xV2-RPI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11937-baked-macaroni-and-cheese-i-VAT-Beauty-4x3-491e72e580a843fd909ff2b57e696808.jpg"
      ],
      "image": "assets/images/11937/step_08.webp"
    }
  ],
