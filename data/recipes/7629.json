  "ingredients": [
    "0.75 cup butter, softened",
    "1.5 cups white sugar",
    "1 cup egg yolks",
    "1 teaspoon vanilla extract",
    "1.75 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.75 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour two 8 inch round pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour, baking powder, and salt in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar together in a mixing bowl. Add egg yolks and vanilla; beat until fluffy. Add milk to butter mixture in 2 parts alternately with flour mixture in 3 parts, beginning and ending with flour mixture. Spread in prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for about 25 to 30 minutes, or until an inserted wooden pick comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
