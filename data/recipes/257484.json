  "ingredients": [
    "1 (16 ounce) box mochiko (sweet rice flour)",
    "2 cups white sugar",
    "2 teaspoons baking powder",
    "0.25 teaspoon ground cinnamon",
    "3 eggs",
    "2 teaspoons vanilla extract",
    "1 (14 ounce) can coconut milk",
    "1 (12 fluid ounce) can evaporated milk",
    "0.5 cup unsalted butter, melted and cooled"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mochiko, sugar, baking powder, and cinnamon together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and vanilla extract together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix eggs into the mochiko mixture. Pour in coconut milk and evaporated milk; mix well. Fold in melted butter until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the greased pan. Tap pan on a flat work surface to settle the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, about 50 minutes. Let cool before slicing, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
