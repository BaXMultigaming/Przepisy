  "ingredients": [
    "2 pounds lean ground beef",
    "0.5 large onion, diced",
    "1 tablespoon crushed red pepper",
    "3 tablespoons garlic powder",
    "1 tablespoon seasoned pepper",
    "2 (4 ounce) cans mushroom pieces, drained",
    "1 (28 ounce) can baked beans",
    "2 (15.25 ounce) cans kidney beans with liquid",
    "2 (6 ounce) cans tomato paste",
    "0.25 cup white sugar",
    "3 carrots, sliced",
    "3 stalks celery, sliced",
    "1 green bell pepper, diced",
    "1 red bell pepper, diced",
    "2 jalapeno chile peppers, diced",
    "0.25 cup Canadian beer",
    "2 tablespoons crushed red pepper",
    "hot sauce",
    "0.25 cup barbeque sauce"
  ],
  "steps": [
    {
      "text": "In a large skillet over medium heat, brown ground beef together with onion, crushed red pepper, garlic powder, and seasoned pepper. Drain off the fat, and place the mixture into a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mushrooms, baked beans, kidney beans with liquid, tomato paste, sugar, carrots, celery, peppers, beer, and barbeque sauce into the slow cooker. Season with hot sauce and more crushed red pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook on Low for 4 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
