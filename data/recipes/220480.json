  "ingredients": [
    "cooking spray",
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "1.25 cups vegetable oil",
    "3 eggs",
    "1 teaspoon vanilla extract",
    "4 apples - peeled, cored and chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, salt, cinnamon, and baking soda together in a large bowl. Whisk oil, eggs, and vanilla extract together in a separate bowl; stir into flour mixture until combined. Fold in chopped apples until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
