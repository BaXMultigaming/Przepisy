  "ingredients": [
    "8 large eggs",
    "2 ripe avocados, mashed",
    "1 tablespoon fresh lemon juice",
    "0.5 teaspoon sea salt, or to taste",
    "0.125 teaspoon chipotle chili powder"
  ],
  "steps": [
    {
      "text": "Place eggs in a medium pot and cover with a few inches of water. Cover and place over high heat. Bring water to a full (but gentle) boil and cook, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain water and immediately run cold water over eggs. Transfer eggs to an ice bath and allow to chill for 10 minutes. Refrigerate eggs until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel and roughly chop the hard-boiled eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add avocado to a mixing bowl with lemon juice, salt, and chipotle powder. Mash, leaving it slightly chunky if desired. Add chopped eggs and stir well to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
