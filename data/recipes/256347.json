  "ingredients": [
    "4 cups water",
    "2 cups dry pinto beans, rinsed",
    "1 large onion, chopped",
    "0.5 cup salsa",
    "0.5 cup roughly chopped cilantro, or to taste",
    "1 jalapeno pepper, minced",
    "4 cloves garlic, minced",
