  "steps": [
    {
      "text": "Combine water, pinto beans, onion, salsa, cilantro, jalapeño, garlic, tomato bouillon, vegetable bouillon, chili powder, paprika, cumin, and black pepper in a multi-functional pressure cooker (such as Instant Pot). Close and lock the lid. Select Bean/Chili function; set timer for 45 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Unlock and remove lid.",
