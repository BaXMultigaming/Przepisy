  "ingredients": [
    "2 cups water",
    "2 cups uncooked instant rice",
    "2 (10 ounce) cans chunk chicken, drained",
    "1 (16 ounce) package frozen chopped broccoli",
    "1 pound processed cheese food, cubed",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 cup milk",
    "0.25 cup butter, cubed",
    "1 small white onion, chopped"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6EPX45WUkarYjyH9MPN_HRRvtE4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25490-Broccoli-Rice-Cheese-and-Chicken-Casserole-DDMFS-Step-01-1389-d80dbced82e440d4b9fb59a4f151842b.jpg"
      ],
      "image": "assets/images/25490/step_01.webp"
    },
    {
      "text": "Bring water to a boil in a medium saucepan; stir in rice, cover, and remove from heat. Let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TqVfx6eL9Qe7eHvJZTVyNL3NTrY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25490-Broccoli-Rice-Cheese-and-Chicken-Casserole-DDMFS-Step-02-1390-7db7979bc2b648f2ba92e6245db2c33c.jpg"
      ],
      "image": "assets/images/25490/step_02.webp"
    },
    {
      "text": "Combine prepared rice, chicken, broccoli, processed cheese, mushroom soup, chicken soup, milk, butter, and onion in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SDQKFG4d0tbRlgL3QuRMkYNgNyI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25490-Broccoli-Rice-Cheese-and-Chicken-Casserole-DDMFS-Step-03-1392-ecacefffd5fa4a1d9a2315fc92e9318c.jpg"
      ],
      "image": "assets/images/25490/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, about 30 to 35 minutes, stirring halfway through cooking to help cheese melt evenly.",
      "section": null,
      "name": null,
