  "ingredients": [
    "1 cup brown sugar",
    "1 cup unbleached all-purpose flour",
    "1 cup whole wheat flour",
    "0.75 cup dried cranberries",
    "0.5 cup shredded sweetened coconut",
    "0.25 cup ground flax seed",
    "1 tablespoon ground cinnamon",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt",
    "0.75 pound carrots, shredded",
    "1 large Granny Smith apple, shredded",
    "1 cup crushed pineapple, drained",
    "3 large eggs",
    "0.5 cup vegetable oil",
    "0.5 cup applesauce",
    "0.5 cup coarsely chopped pecans",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 12 large muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, all-purpose flour, whole wheat flour, cranberries, coconut, flax seeds, cinnamon, baking soda, and salt in a bowl. Stir in carrots and apple to combine. Stir in pineapple, eggs, oil, applesauce, pecans, and vanilla extract until just combined. Divide batter among the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
