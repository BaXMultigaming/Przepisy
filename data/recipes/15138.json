  "ingredients": [
    "4 cups thinly sliced apples",
    "0.5 cup white sugar",
    "0.5 cup chopped pecans",
    "0.5 teaspoon ground cinnamon",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup evaporated milk",
    "0.33333334326744 cup butter, melted",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Generously grease a 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange apples in an even layer in the prepared baking dish. Combine ½ cup sugar, ½ cup pecans, and cinnamon in a bowl; sprinkle over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1 cup sugar, flour, baking powder, and salt in a bowl until well mixed. Whisk evaporated milk, melted butter, and beaten egg together in a separate bowl until combined; stir into flour mixture until smooth. Pour batter over apples; sprinkle with remaining ¼ cup pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
