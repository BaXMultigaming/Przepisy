  "ingredients": [
    "3 eggs, beaten",
    "0.75 cup white sugar",
    "0.75 cup butter, softened",
    "1.5 cups all-purpose flour",
    "2 teaspoons vanilla extract",
    "1 teaspoon anise extract",
    "cooking spray",
    "0.25 cup powdered sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat a pizzelle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, sugar, and butter together using an electric mixer. Add flour and extracts; beat until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray the inside of iron lightly with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter by teaspoonfuls into the center of each pizzelle grid. Close lid and bake until steam stops and cookies are light golden brown, 45 to 60 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel pizzelle off using a fork and lay flat on a newspaper. Sprinkle with powdered sugar while warm and let sit for 1 minute. Dust the other side. Repeat with remaining batter to make about 30 cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
