  "ingredients": [
    "1 (5.5 ounce) box Idahoan® Steakhouse Cheesy Hashbrowns",
    "0.5 cup buttermilk",
    "1 cup sliced bacon, diced",
    "1 small onion, diced",
    "3 eggs, beaten",
    "0.5 cup Swiss cheese, shredded"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare Idahoan Steakhouse Cheesy Hashbrown Potatoes, following packaging directions, replacing the 1/2 cup milk with 1/2 cup buttermilk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium size skillet, cook bacon and onion until bacon is crisp. Drain and set aside to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in eggs, Swiss cheese, and bacon-onion mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle crunchy onion topping on top of potatoes. Let stand 5 minutes then serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
