  "ingredients": [
    "2 tablespoons vegetable oil",
    "4 potatoes, thinly sliced",
    "1 pound boneless skinless chicken breasts, cut into cubes",
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "1 onion, chopped",
    "0.5 cup milk",
    "0.25 teaspoon garlic powder",
    "2 cups frozen broccoli, carrots and cauliflower combination",
    "0.5 teaspoon dried parsley",
    "0.25 teaspoon dried marjoram",
    "0.25 teaspoon dried basil",
    "0.33333334326744 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Heat oil in a large frying pan over medium-high heat. Add potatoes; cook and stir frequently until tender-crisp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chicken; cook and stir until browned. Reduce heat to medium; stir in condensed soup, onion, milk, and garlic powder. Arrange vegetables on top; sprinkle with parsley, marjoram, and basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and simmer over low heat until chicken is cooked through, and vegetables are tender, about 5 minutes. Remove from heat and stir in Parmesan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
