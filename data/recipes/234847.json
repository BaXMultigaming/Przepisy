  "ingredients": [
    "0.5 cup water",
    "0.5 cup ketchup",
    "1 large onion, halved and sliced",
    "0.25 cup low sodium soy sauce",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon extra-virgin olive oil",
    "1 tablespoon honey, or more to taste",
    "1 tablespoon all-purpose flour",
    "0.5 teaspoon garlic powder",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon poultry seasoning",
    "1 (4 to 6 pound) whole chicken"
  ],
  "steps": [
    {
      "text": "Stir water, ketchup, onion, soy sauce, Worcestershire sauce, olive oil, honey, flour, garlic powder, black pepper, and poultry seasoning together in an oven-safe Dutch oven. Simmer over medium heat, stirring occasionally, until flavors blend, about 5 minutes. Cool for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in the Dutch oven and turn to coat with ketchup mixture. Spoon 1/4 of the mixture, including onions, into the chicken cavity. Place chicken breast-side down; cover with an oven-proof lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake chicken in the preheated oven, basting once, for 45 minutes. Uncover the Dutch oven and increase heat to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn chicken breast-side up and bake until chicken has browned, about 15 more minutes. Let chicken stand for about 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
