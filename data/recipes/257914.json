  "ingredients": [
    "3 small taro roots, peeled and halved",
    "2.5 cups ice, or to taste, divided",
    "1 cup milk",
    "0.75 cup water",
    "0.25 cup white sugar",
    "1.5 teaspoons honey, divided",
    "0.25 cup tapioca pearls (boba)"
  ],
  "steps": [
    {
      "text": "Place taro roots in a small pot; cover with water. Bring to a boil. Cook taro until tender, about 12 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine taro roots with 1/2 cup ice in a bowl. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooled taro roots, remaining 2 cups ice, milk, 3/4 cup water, sugar, and 1/2 teaspoon honey in a blender; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring 2 cups water to a boil in a saucepan. Add tapioca pearls; stir gently until they start floating to the surface. Cook for 12 to 15 minutes. Remove from heat, cover, and let stand until tender, 12 to 15 minutes more. Drain. Stir in remaining 1 teaspoon honey.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide blended mixture between 2 glasses. Divide tapioca pearls between the glasses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
