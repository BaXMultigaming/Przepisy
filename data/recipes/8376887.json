  "ingredients": [
    "5 ounces ladyfingers",
    "1 cup mascarpone cheese",
    "0.33 cup strong brewed coffee, room temperature",
    "1 teaspoon amaretto liqueur (such as Disaronno®)",
    "0.5 cup powdered sugar",
    "0.25 cup unsweetened cocoa powder, or as needed"
  ],
  "steps": [
    {
      "text": "Place ladyfingers in a food processor and blitz until they are reduced to powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place mascarpone cheese into a bowl and mix in coffee and amaretto liqueur. Add powdered sugar with a spatula until well combined. Next add powdered ladyfingers and stir again to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Take about 1 teaspoon of dough and roll into a ball. Roll each ball in cocoa powder and place them on a tray lined with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill truffles in the refrigerator for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
