  "title": "Swedish Meatballs I",
  "description": "These meatballs are made with ground beef mixed with onion and dry cream of wheat. They&#39;re baked until browned, mixed with sauce, and baked until hot.",
  "authors": [
    "Jessica"
  ],
  "date_published": "2000-01-01T22:55:59-05:00",
