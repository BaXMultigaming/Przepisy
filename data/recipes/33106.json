  "ingredients": [
    "1 cup quick cooking oats",
    "0.5 cup all-purpose flour",
    "0.5 cup whole wheat flour",
    "0.25 cup packed brown sugar",
    "0.75 tablespoon baking powder",
    "0.25 cup dry non-fat milk powder",
    "1.25 teaspoons salt, divided",
    "0.5 tablespoon ground cinnamon",
    "0.125 teaspoon cream of tartar",
    "0.33333298563957 cup vegetable oil",
    "2 eggs, beaten",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Preheat a lightly greased griddle over medium low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix quick cooking oats, flour, whole wheat flour, brown sugar, baking powder, dry milk powder, salt, cinnamon and cream of tartar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, beat together vegetable oil and eggs. Pour into the oats mixture, alternating with water, and mix thoroughly, creating a batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter, 1/4 cup at a time, onto the prepared griddle. Cook on both sides until golden brown, flipping when the surface begins to bubble.",
      "section": null,
      "name": null,
      "url": null,
