  "ingredients": [
    "8 (10 ounce) packages rotini pasta",
    "1 (24 ounce) jar prepared marinara sauce",
    "1 cup water",
    "0.5 cup prepared pizza sauce",
    "0.5 cup milk",
    "10 frozen cooked meatballs, thawed",
    "0.25 cup grated Parmesan cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rotini, marinara sauce, water, pizza sauce, and milk together in a bowl. Pour into a deep baking dish; pasta should be completely submerged in sauce. Cover dish tightly with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes; uncover and arrange meatballs on top, pushing them partially into pasta and sauce; cover tightly with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until pasta is tender yet firm to the bite, 20 to 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Uncover; sprinkle with Parmesan cheese; return to oven for 5 minutes. Remove and let cool 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
