  "ingredients": [
    "2 tablespoons olive oil",
    "1.5 cups sliced brown or white mushrooms",
    "1 large yellow onion, diced",
    "3 cloves garlic, minced or crushed",
    "1 red bell pepper, diced",
    "salt to taste",
    "freshly ground black pepper to taste",
    "pinch of cayenne pepper",
    "4 slices smoked ham",
    "0.5 cup shredded Monterey Jack cheese for the top",
    "12 ounces ricotta cheese",
    "2 ounces Monterey Jack cheese, grated",
    "0.5 ounce finely grated Parmigiano-Reggiano (1/2 cup packed if grated on a microplane)",
    "1 teaspoon kosher salt, or to taste",
    "0.25 teaspoon freshly ground black pepper",
    "1 pinch nutmeg",
    "2 tablespoons freshly chopped Italian parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Png4LZeAESvTkoepsfmqlu98jxI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8531314-three-cheese-ham-involtini-ingredients-2-3e6e336a25394141acb05aa0b748bb35.jpg"
      ],
      "image": "assets/images/8531314/step_01.webp"
    },
    {
      "text": "Heat olive oil in a skillet over medium-high heat. Add mushrooms, onions, and a large pinch of salt. Sauté, stirring occasionally, until mushrooms start to turn golden brown and onions are transparent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/StW1h2Jktm_40Jdy0KdFOgXkv4c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8531314-three-cheese-ham-involtini-VAT-step-02-97053a7d36804fda91096d859a918ade.jpg"
      ],
      "image": "assets/images/8531314/step_02.webp"
    },
    {
      "text": "Make space in the center of the pan, add garlic, and cook until fragrant, about 30 seconds, adding more olive oil if needed. Add bell peppers and sauté until they just start to soften, about 2 minutes. Season with black pepper, cayenne, and more salt to taste if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d-ivjnlVWcH0dow-BCSE40E_sik=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8531314-three-cheese-ham-involtini-VAT-step-03-0fb7e21baf024f8f8f1e872ef0e135fd.jpg"
      ],
      "image": "assets/images/8531314/step_03.webp"
    },
    {
      "text": "Remove from heat, transfer to a baking dish or pan, and preheat the oven to 400 degrees F (200 degrees F).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MI889j3n6AiuBrzsyjRKTt2aPKg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8531314-three-cheese-ham-involtini-VAT-step-04-53a846110da645d992d220a51b7d2053.jpg"
      ],
      "image": "assets/images/8531314/step_04.webp"
    },
    {
      "text": "Combine ricotta, Parmesan, and Monterey Jack cheese in a bowl. Season with parsley, salt, pepper, and nutmeg. Mix well until all ingredients are incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gvvlcZF7wW4rbQxYfeF1luIXC70=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8531314-three-cheese-ham-involtini-VAT-step-05-a335a531b56c457fbc33bdd1cedc6def.jpg"
      ],
      "image": "assets/images/8531314/step_05.webp"
    },
    {
      "text": "Divide filling between 4 slices of ham, and roll each up into a tube.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hQ4Sr-LQOHtBuHdT77eP8gynCXg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8531314-three-cheese-ham-involtini-VAT-step-06-167bcf120a9c438ab4bf53c8ddf20b15.jpg"
      ],
      "image": "assets/images/8531314/step_06.webp"
    },
    {
      "text": "Set on top of vegetable mixture, and top with grated Monterey Jack cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-oDFcOS3PrGElUK4tsjydIQWyHA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8531314-three-cheese-ham-involtini-VAT-step-07-84181d81a44f4727ab9ffe7b1442beea.jpg"
      ],
      "image": "assets/images/8531314/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and everything is heated through, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Sd6lJW9TFrsSZA2jrQFivMtFOt4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8531314-three-cheese-ham-involtini-VAT-step-09-6d3f75e93daa48a6a1bc983a57b2ba9b.jpg"
      ],
      "image": "assets/images/8531314/step_08.webp"
    },
    {
      "text": "Garnish with parsley if you like and serve hot!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vt5YRbQ6L3D9Xg_tFk_HyXqRHxg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8531314-three-cheese-ham-involtini-VAT-4x3-3-bcf40457fdab4d50b6814d1b3cccfaf0.jpg"
      ],
      "image": "assets/images/8531314/step_09.webp"
    }
