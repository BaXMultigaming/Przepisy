  "ingredients": [
    "0.5 cup vegetable oil",
    "0.33333334326744 cup soy sauce",
    "0.25 cup red wine vinegar",
    "2 tablespoons lemon juice",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon dry mustard",
    "1 clove garlic, minced",
    "0.25 teaspoon ground black pepper",
    "1.5 pounds flank steak"
  ],
  "steps": [
    {
      "text": "Whisk vegetable oil, soy sauce, red wine vinegar, lemon juice, Worcestershire sauce, mustard, garlic, and black pepper together in a bowl; pour into a resealable plastic bag. Add flank steak to the bag, coat with the marinade, squeeze bag to remove excess air, and seal the bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Marinate in the refrigerator 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steak from the bag and shake off excess marinade. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the steak until beginning to firm and is hot and slightly pink in the center, 5 to 7 minutes per side. An instant-read thermometer inserted into the center should read at least 140 degrees F (60 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rest steak 5 to 10 minutes before slicing across the grain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
