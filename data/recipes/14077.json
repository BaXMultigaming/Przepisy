  "ingredients": [
    "1 (16 ounce) package tri-colored pasta assortment",
    "1 cup chopped broccoli",
    "1 cup cauliflower, chopped",
    "0.5 cup shredded carrots",
    "1 cup sliced celery",
    "0.25 cup diced red onion",
    "0.25 cup diced yellow pepper",
    "0.25 cup sliced black olives",
    "0.5 (16 ounce) bottle vegetarian Caesar-style salad dressing",
    "2 tablespoons grated Parmesan cheese",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to boil, add pasta, and boil until al dente, about 8 to 12 minutes. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place broccoli, cauliflower, carrot, celery, red onions, yellow peppers, and black olives in a large mixing bowl. Pour Caesar salad dressing over vegetables and stir to coat. Sprinkle Parmesan cheese, pepper, garlic powder, and paprika over the vegetable mixture; stir well. Add cooked pasta and stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve warm or refrigerate pasta salad until chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
