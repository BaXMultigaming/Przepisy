  "ingredients": [
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon salt",
    "1 cup chicken broth",
    "1 cup cubed potato",
    "0.5 cup chopped carrot",
    "0.25 cup sliced green onions",
    "1 cup half-and-half",
    "0.75 cup frozen corn, thawed"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium heat; stir flour, basil, pepper, and salt into butter and pour in chicken broth. Cook and stir broth mixture until thickened and boiling, 5 to 7 minutes. Stir potato, carrot, and green onions into broth mixture; bring to a boil. Reduce heat and simmer until potatoes are mostly tender, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir half-and-half and corn into broth mixture; cook and stir until chowder is heated through, about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
