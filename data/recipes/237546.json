  "ingredients": [
    "1 (12 ounce) can fully cooked luncheon meat (such as SPAM®), chopped",
    "1.5 cups whole wheat all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon paprika",
    "1 cup milk",
    "1 cup shredded Cheddar cheese",
    "6 tablespoons butter, melted",
    "0.5 cup chopped fresh spinach",
    "1 egg",
    "0.25 cup chopped onion",
    "5 basil leaves, chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium heat; cook and stir luncheon meat until browned on all sides, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, baking soda, salt, garlic powder, pepper, and paprika together in a bowl. Mix luncheon meat, milk, Cheddar cheese, butter, spinach, egg, onion, and basil together in a separate bowl; slowly stir into flour mixture just until batter is mixed. Pour batter into muffin cups until each is 3/4-full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, about 33 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
