  "ingredients": [
    "2 cups Original Bisquick® mix",
    "0.75 cup milk",
    "0.25 cup butter, melted",
    "0.5 cup shredded Cheddar cheese",
    "0.33333334326744 cup butter, melted",
    "0.25 teaspoon salt",
    "0.25 teaspoon OLD BAY® Seasoning",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon parsley flakes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the biscuits: In a medium bowl, stir together Bisquick, milk, melted butter, and Cheddar until a soft dough forms. Drop dough by spoonfuls to create eight biscuits on an ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 16 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make the topping: In a small bowl, stir together melted butter, salt, Old Bay, garlic powder, and parsley flakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove biscuits from the oven and immediately brush with topping. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
