  "ingredients": [
    "1 cup brown sugar",
    "0.5 cup butter, softened",
    "1 teaspoon vanilla extract",
    "1 large egg",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "1 cup plain yogurt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together brown sugar, butter, and vanilla in a large bowl until light and fluffy. Beat in egg until smooth. Combine flour, baking soda, and baking powder; stir into the batter alternately with yogurt. Spread the batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the crown comes out clean, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
