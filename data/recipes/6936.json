  "ingredients": [
    "3 cups all-purpose flour",
    "0.5 cup white sugar",
    "3 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "1 teaspoon salt",
    "0.75 teaspoon ground cinnamon",
    "1 cup raisins",
    "1 egg",
    "0.25 cup melted butter",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 9x5x3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl measure flour, sugar, baking powder, soda, salt, cinnamon, and raisins. Stir thoroughly. Make a well in center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In small bowl beat egg until frothy. Mix in melted butter and milk. Pour into well. Stir just enough to moisten. Scrape into greased 9x5x3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in 350 degree F (175 degree C) oven for 1 hour. Serve plain or toasted with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
