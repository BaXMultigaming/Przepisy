  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup butter, softened",
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups rolled oats",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, white sugar, and brown sugar in a large bowl with an electric mixer until light and fluffy. Beat in one egg at a time, then stir in vanilla. Gradually stir in flour mixture. Fold in oats and chocolate chips. Drop by rounded teaspoonfuls onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in batches in the preheated oven until set, 8 to 10 minutes. Allow cookies to cool on baking sheets for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
