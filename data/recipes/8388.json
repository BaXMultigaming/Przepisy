  "ingredients": [
    "1.5 cups all-purpose flour",
    "1.5 cups white sugar",
    "0.5 cup butter",
    "0.5 cup sour cream",
    "3 eggs",
    "1 pinch baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease and flour a 8x4-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar together in a large bowl until light and fluffy. Add sour cream and eggs; mix well. Add flour and a pinch of soda, mix until just incorporated. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center of cake comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
