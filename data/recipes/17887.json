  "ingredients": [
    "4 (1 ounce) squares unsweetened chocolate",
    "1 (8 ounce) package cream cheese",
    "4 cups confectioners' sugar",
    "1 tablespoon vanilla extract",
    "0.125 teaspoon salt",
    "2 tablespoons evaporated milk"
  ],
  "steps": [
    {
      "text": "Have all ingredients at room temperature. Melt chocolate in a double boiler or microwave oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat cream cheese until fluffy. Pour melted chocolate into cream cheese and mix on medium speed until well blended. Add vanilla and salt. Slowly mix in confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrape the sides of the bowl and increase mixer speed to medium-high. Slowly add evaporated milk until frosting is spreading consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
