  "ingredients": [
    "1 pound ground beef",
    "0.25 cup onion, chopped",
    "1 (16 ounce) package frozen mixed vegetables",
    "1 (14.5 ounce) can diced tomatoes, drained",
    "1 (14.5 ounce) can Italian diced tomatoes, drained",
    "2 potatoes, peeled and chopped",
    "1 cup sliced fresh or frozen okra",
    "1 tablespoon ketchup",
    "salt and pepper to taste",
    "water"
  ],
  "steps": [
    {
      "text": "In a skillet over medium heat, cook and stir ground beef and onion until beef is evenly browned and onion is tender. Drain grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer beef-onion mixture to a slow cooker. Stir in frozen vegetables, diced tomatoes, Italian diced tomatoes, potatoes, okra, ketchup, salt, and pepper. Pour in enough water to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
