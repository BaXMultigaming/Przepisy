  "title": "Cranberry Cheesecake",
  "description": "This cranberry cheesecake has a rich and creamy filling and a gorgeous cranberry glaze. Top with sugared cranberries for an elegant holiday dessert.",
  "authors": [
    "LauraF"
  ],
  "date_published": "2020-06-19T00:33:49-04:00",
  "date_modified": "2026-04-15T19:58:01-04:00",
  "prep_time": "PT30M",
