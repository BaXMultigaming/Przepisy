  "ingredients": [
    "2 cups shortening",
    "8 cups confectioners' sugar",
    "0.5 teaspoon salt",
    "2 teaspoons clear imitation vanilla extract",
    "6 fluid ounces heavy cream"
  ],
  "steps": [
    {
      "text": "Cream shortening until fluffy. Add confectioner's sugar and continue creaming until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add salt, vanilla, and whipping cream blend on low speed until moistened. Add additional whipping cream if necessary (up to 2 ounces). Beat at high speed until frosting is fluffy.",
