  "ingredients": [
    "2 English (hothouse) cucumbers, diced",
    "1 teaspoon salt",
    "0.5 cup diced red onion",
    "1 small red bell pepper, diced",
    "2 limes, zested and juiced",
    "0.25 cup chopped fresh cilantro",
    "1 tablespoon white sugar",
    "0.5 teaspoon curry powder",
    "4 dashes hot pepper sauce",
    "2 avocados - peeled, pitted and diced"
  ],
  "steps": [
    {
      "text": "Place the cucumber slices into a colander set in the sink, and sprinkle with salt. Set aside and allow to drip.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a salad bowl, mix together the red onion, red bell pepper, lime zest and juice, cilantro, sugar, curry powder, and hot pepper sauce until thoroughly combined and the sugar has dissolved. Drain the cucumber slices, and pat them dry with paper towels. Stir the cucumbers into the salad. Gently toss the avocados with the salad and serve.",
      "section": null,
