  "ingredients": [
    "0.66666668653488 cup butter, softened",
    "1 cup white sugar",
    "1.5 teaspoons almond extract",
    "1 egg, beaten",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9 inch round cake pan or pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the butter, sugar and almond extract until light and fluffy using an electric mixer. Blend in the egg. Combine the flour and baking powder; stir into the mixture using a sturdy spoon until dough forms a ball. Press the dough into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 40 minutes in the preheated oven, until the top is light golden brown. When cool, slice into wedges to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
