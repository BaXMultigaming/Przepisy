  "ingredients": [
    "4 ounces fresh mushrooms, sliced",
    "1 cup sliced leeks",
    "2 tablespoons margarine",
    "2 tablespoons olive oil",
    "0.5 cup dry sherry",
    "3 (10.5 ounce) cans condensed beef broth",
