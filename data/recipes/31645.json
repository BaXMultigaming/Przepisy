  "ingredients": [
    "4 tablespoons butter",
    "4 cups thinly sliced celery",
    "3 tablespoons all-purpose flour",
    "1 teaspoon salt",
    "1 cup milk",
    "1 (4.5 ounce) can chopped mushrooms, drained",
    "2 tablespoons chopped green bell peppers",
    "1 (2 ounce) jar chopped pimento peppers",
    "1 cup shredded Cheddar cheese",
    "1 cup soft bread crumbs",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a medium baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 4 tablespoons butter in a medium saucepan over medium heat. Add celery and cook until tender, about 5 minutes. Move celery to the side and mix in flour and salt. Pour in milk and cook, stirring constantly, until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in mushrooms, bell peppers, and pimento peppers, then stir in cheese until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, blend bread crumbs and 2 tablespoons melted butter. Transfer celery mixture to the prepared baking dish and sprinkle bread crumb mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
