  "ingredients": [
    "4 onions, chopped",
    "4 cloves garlic, minced",
    "1 green bell pepper, chopped",
    "0.5 cup vegetable oil",
    "16 cups chopped tomatoes",
    "0.25 cup white sugar",
    "0.25 cup chopped parsley",
    "2 tablespoons dried oregano",
    "2 tablespoons dried basil",
    "2 tablespoons salt",
    "0.75 teaspoon ground black pepper",
    "1 (6 ounce) can tomato paste"
  ],
  "steps": [
    {
      "text": "Sauté together onion, garlic, green pepper, and oil in a slow cooker. Cook until onion is transparent.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomatoes, sugar, parsley, oregano, basil, salt, and black pepper. Cook on Low for 2 to 3 hours. Stir frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let sauce cool. Pour sauce into quart-size freezer containers. Store in freezer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Defrost the sauce in the refrigerator overnight or in the microwave. Transfer sauce to a saucepan over medium heat and stir in one 6-ounce can tomato paste per quart. Continue to cook, stirring frequently, until heated through.",
