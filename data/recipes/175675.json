  "ingredients": [
    "1 tablespoon butter",
    "3 skinless, boneless chicken breast halves",
    "1 pinch ground black pepper",
    "1 small red onion, sliced",
    "1 tablespoon dried parsley",
    "0.5 cup applesauce",
    "0.25 cup white wine",
    "2 tablespoons mustard",
    "0.25 cup half-and-half cream",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Melt the butter in a skillet over medium heat. Season the chicken on both sides with pepper; cook the chicken breasts in the butter until no longer pink in the center and the juices run clear, 6 to 7 minutes each side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Remove the breasts from the pan and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together the onion, parsley, applesauce, wine, mustard, and half-and-half in the pan; bring the mixture to a boil and cook about 5 minutes. Return the chicken to the pan; add the walnuts. Allow to cook until the chicken is warm, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
