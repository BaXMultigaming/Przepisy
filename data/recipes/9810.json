  "ingredients": [
    "3 cups peanut butter",
    "2 cups white sugar",
    "2 cups packed brown sugar",
    "1 cup margarine or butter, softened",
    "6 eggs",
    "1.5 teaspoons corn syrup",
    "1.5 teaspoons vanilla extract",
    "9 cups rolled oats",
    "4 teaspoons baking soda",
    "0.5 pound candy-coated milk chocolate pieces",
    "0.5 pound semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat peanut butter, white sugar, brown sugar, and butter in a large bowl with an electric mixer until smooth. Beat in eggs, two at a time, then stir in corn syrup and vanilla. Mix in oats and baking soda until well blended. Stir in chocolate candies and chocolate chips. Roll dough into 2-inch balls and place 3 inches apart onto ungreased cookie sheets. Flatten slightly with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 12 to 15 minutes. Cool on cookie sheets for briefly, before transferring to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
