  "title": "Lemon-Glazed Blueberry Cupcakes",
  "description": "A sweet lemon glaze is spread over these blueberry cupcakes as they bake, creating a unique topping with an interesting crunch.",
  "authors": [
    "TerryWilson"
  ],
  "date_published": "2020-06-19T00:42:50-04:00",
