  "ingredients": [
    "1.5 cups white sugar",
    "0.5 cup unsalted butter, softened",
    "2 large eggs, at room temperature",
    "0.5 teaspoon vanilla extract",
    "2.25 cups all-purpose flour",
    "4 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup blueberries",
    "1 cup milk",
    "1 cup powdered sugar",
    "3 tablespoons water",
    "2 teaspoons lemon juice",
    "0.5 teaspoon lemon zest"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 24 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sugar and butter in a large bowl; beat with an electric mixer until light and fluffy. Add eggs and vanilla extract and beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift 2 cups flour, baking powder, and salt together into another bowl. Toss blueberries with remaining flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat flour mixture into the creamed butter and sugar on medium speed, alternating with milk, beating batter briefly after each addition. Fold in blueberries. Divide batter among the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops look dry, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk powdered sugar, water, lemon juice, and zest together to make a thick but spreadable glaze. Remove cupcakes from the oven and spread 1 tablespoon glaze over each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return cupcakes to the oven and continue baking until golden brown, 8 to 10 minutes more. Remove from the pans and cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
