  "ingredients": [
    "2 pounds skinless, boneless chicken breasts, cut into 1-inch pieces",
    "1 onion, chopped",
    "1 (20 ounce) can pineapple tidbits with juice",
    "1 (10 ounce) bottle Korean bulgogi marinade",
    "0.5 cup gochujang (Korean hot pepper paste), or to taste",
    "1 (8 ounce) package shredded carrots",
    "1 (8 ounce) package shredded broccoli stalks",
    "0.5 bunch fresh cilantro, chopped"
  ],
  "steps": [
    {
      "text": "Place chicken and onion in a slow cooker. Stir in pineapple, bulgogi marinade, and gochujang.",
