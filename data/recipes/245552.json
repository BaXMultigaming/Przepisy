    "1 large frozen banana",
    "1 tablespoon plain yogurt",
    "1 tablespoon peanut butter",
    "1 tablespoon tahini",
    "1 tablespoon flax seed meal",
    "1 tablespoon almond flour",
    "1 tablespoon wheat germ",
    "1 scoop protein powder"
