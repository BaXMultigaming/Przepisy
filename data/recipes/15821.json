  "ingredients": [
    "1.5 cups white sugar",
    "1 (7 ounce) jar marshmallow creme",
    "0.66666668653488 cup evaporated milk",
    "0.25 cup butter",
    "0.25 teaspoon salt",
    "2 cups milk chocolate chips",
    "1 cup semisweet chocolate chips",
    "0.5 cup chopped nuts",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Line an 8-inch square pan with aluminum foil; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kUdJbgkpQeZAqNl8E-Ob_DSYXfQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15821-aunt-teens-creamy-chocolate-fudge-VAT-step-01-abd08a412cdd41d4b2e716ea2eeea727.jpg"
      ],
      "image": "assets/images/15821/step_01.webp"
    },
    {
      "text": "Combine sugar, marshmallow cream, evaporated milk, butter, and salt together in a large saucepan over medium heat; bring to a full boil and cook for 5 minutes, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NDrNBFgrZKksboHtfU0xSX2Jmro=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15821-aunt-teens-creamy-chocolate-fudge-VAT-step-02-04fea726503842eea6ef005534fcd1ed.jpg"
      ],
      "image": "assets/images/15821/step_02.webp"
    },
    {
      "text": "Remove from heat and add milk chocolate chips and semisweet chocolate chips; stir until chocolate is melted and mixture is smooth. Stir in nuts and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ixiim64pnrxczfNTF6DUXB1e-hw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15821-aunt-teens-creamy-chocolate-fudge-VAT-step-03-c13762b97d4b48bab403be895796d966.jpg"
      ],
      "image": "assets/images/15821/step_03.webp"
    },
    {
      "text": "Pour into prepared pan; chill in refrigerator for 2 hours, or until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/diAV2Rn5Zm1_OhTn1DlZow5_jFw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-15821-aunt-teens-creamy-chocolate-fudge-VAT-step-04-037f1badad2c46b19c056c9d8855153c.jpg"
