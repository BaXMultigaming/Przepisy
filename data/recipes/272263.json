  "ingredients": [
    "1.5 cups all-purpose einkorn flour",
    "1.5 teaspoons white sugar",
    "1 teaspoon baking powder",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon salt",
    "1 cup buttermilk",
    "2 eggs",
    "4 tablespoons melted butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Sift flour, sugar, baking powder, cinnamon, and salt together into a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk buttermilk, eggs, 1/4 cup melted butter, and vanilla extract together in a bowl; slowly stir in flour mixture until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a griddle over medium-high heat; grease with butter. Drop 1/4 cup batter onto the griddle; cook until bubbles form around edges and pancake is brown on bottom, 2 to 3 minutes. Flip; cook until brown on other side, 2 to 3 minutes more. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
