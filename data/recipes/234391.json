  "ingredients": [
    "4 (4 ounce) pork chops",
    "1 cup frozen cranberries",
    "3 canned figs, 1/4 cup juice reserved",
    "0.5 cup apple juice",
    "2 tablespoons brown sugar",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon dried rosemary"
  ],
  "steps": [
    {
      "text": "Heat a skillet over medium-high heat. Sear pork chops in the hot skillet until lightly browned, about 1 minute per side. Transfer seared pork chops to the slow cooker.",
      "section": null,
