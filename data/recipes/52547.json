    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently toss together blackberries, raspberries, blueberries, and white sugar in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hT-f2TS1RNnNSvSBVmYzDkoaqjM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/52547-Triple-Berry-Crisp-DDMFS-step-2-da632978f7534350a7512bd5a992b183.jpg"
      ],
      "image": "assets/images/52547/step_03.webp"
    },
    {
      "text": "Combine flour, oats, brown sugar, cinnamon, and nutmeg in a separate large bowl. Cut in butter with 2 knives or a pastry blender until crumble mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ghJ0jMYgbSUPYQu3KNYFiQQzwIw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/52547-Triple-Berry-Crisp-DDMFS-step-4-1bb0aa73d5ec43bfb8ad517b64570c8b.jpg"
      ],
      "image": "assets/images/52547/step_04.webp"
    },
    {
      "text": "Press 1/2 of the crumble into the bottom of a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EuIir09rF9zxVdpZfONNc-hvz8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/52547-Triple-Berry-Crisp-DDMFS-step-5-62eb6945e4024a7c89af6aa53627eb3e.jpg"
      ],
      "image": "assets/images/52547/step_05.webp"
    },
    {
      "text": "Cover with berry mixture. Sprinkle remaining crumble over berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/phAgxhSUZwew3EEUyNm8Uy08nc8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/52547-Triple-Berry-Crisp-DDMFS-step-7-b569979d6fa04ffea441e175a96ebc86.jpg"
      ],
      "image": "assets/images/52547/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until fruit is bubbly and the top is golden brown, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2nst6FsCXtOms8AWLgaftlhF4ks=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/52547-Triple-Berry-Crisp-DDMFS-step-8-a0e58e08e9504b1d880083cadbdac2dc.jpg"
      ],
      "image": "assets/images/52547/step_07.webp"
