  "ingredients": [
    "1 pound fresh asparagus, trimmed and cut into 1 inch pieces",
    "1 (14.5 ounce) can chicken broth, divided",
    "0.5 cup chopped onion",
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "1 teaspoon salt",
    "1 pinch ground black pepper",
    "1 cup milk",
    "0.5 cup sour cream",
    "1 teaspoon fresh lemon juice"
  ],
  "steps": [
    {
      "text": "Combine asparagus, 1/2 cup chicken broth, and onion in a large saucepan; cover and bring to a boil over high heat. Reduce heat to medium-low and simmer, uncovered, until asparagus is tender, about 12 minutes. Transfer the mixture to a blender; puree until smooth and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AJZUtFHtnw9V-eMR84RWu6qJGlY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13114-CreamOfFreshAsparagusSoupii-ddmfs-Step-1-0375-4x3-ecc1099f807745c588dafd1ddaa55f21.jpg"
      ],
      "image": "assets/images/13114/step_01.webp"
    },
    {
      "text": "In the same saucepan, melt butter over medium-low heat. Stir in flour, salt, and pepper; cook, stirring constantly, for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ffFMox4ekWdvlcaZU5cFNvyWdl4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13114-CreamOfFreshAsparagusSoupii-ddmfs-Step-2-0380-7db11451dda64165a8558dde73bdc10e.jpg"
      ],
      "image": "assets/images/13114/step_02.webp"
    },
    {
      "text": "Increase heat to medium; add remaining chicken broth, stirring constantly, until the mixture boils. Stir in pureed asparagus and milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TwYz5teH1DXkm2LBnPjrRV1yAI0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13114-CreamOfFreshAsparagusSoupii-ddmfs-Step-4-0386-4x3-345471997bb4467da65d1075cda0fa1c.jpg"
      ],
      "image": "assets/images/13114/step_03.webp"
    },
    {
      "text": "Place sour cream in a small bowl and stir in a ladleful of hot soup until blended; pour into the soup and stir in lemon juice. Warm soup through to serving temperature, without boiling. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m4KlJh2q3s0Xoqo3hNH1ddFgWH8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13114-CreamOfFreshAsparagusSoupii-ddmfs-4X3-0398-06f6cc41fb94431b88f02efeb82b3a00.jpg"
      ],
      "image": "assets/images/13114/step_04.webp"
    }
