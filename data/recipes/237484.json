  "ingredients": [
    "0.5 pound bacon",
    "3 heads broccoli, or more to taste, chopped",
    "1 red onion, diced",
    "0.75 cup raisins",
    "0.75 cup chopped salted cashews",
    "1 cup mayonnaise",
    "0.5 cup brown sugar",
    "2 tablespoons red wine vinegar"
  ],
  "steps": [
    {
      "text": "Prepare the salad: Cook bacon in a large skillet and over medium-high heat, turning occasionally, until crisp, about 10 minutes. Drain bacon slices on paper towels and crumble once cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bacon, broccoli, red onion, raisins, and cashews together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the dressing: Whisk mayonnaise, brown sugar, and vinegar together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss together: Drizzle dressing over the broccoli mixture in small amounts, mixing the salad between additions to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
