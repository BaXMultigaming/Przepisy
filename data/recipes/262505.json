  "ingredients": [
    "cooking spray",
    "2 large ripe bananas",
    "0.66666668653488 cup packed dark brown sugar",
    "0.5 cup molasses",
    "0.5 cup vegetable oil",
    "2 eggs",
    "0.25 cup milk",
    "2 cups all-purpose flour",
    "2 teaspoons ground ginger",
    "1.5 teaspoons ground cinnamon",
    "1.25 teaspoons baking soda",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground allspice",
    "0.25 teaspoon salt",
    "2 tablespoons milk",
    "1 tablespoon light corn syrup",
    "1 tablespoon butter, melted",
    "1.5 cups confectioners' sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Spray a 9x5-inch loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare the banana bread: Mash bananas in a large bowl with a fork. Add brown sugar, molasses, oil, eggs, and 1/4 cup milk. Stir until combined. Stir flour, ginger, cinnamon, baking soda, cloves, allspice, and salt together in another bowl. Stir flour mixture into the banana mixture until just incorporated. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 60 to 70 minutes. Let cool completely, at least 30 minutes. Turn bread out of the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the glaze: Combine 1 tablespoon milk, corn syrup, and butter in a bowl. Add confectioners' sugar and stir. Add vanilla and enough remaining milk to achieve a drizzling consistency. Pour glaze over the cooled bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
