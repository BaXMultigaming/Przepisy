  "ingredients": [
    "3 tablespoons light soy sauce",
    "3 tablespoons dark soy sauce",
    "3 tablespoons red wine vinegar",
    "1 teaspoon hot chili oil",
    "1 teaspoon minced fresh ginger root",
    "0.5 teaspoon white sugar",
    "1 clove garlic, chopped",
    "0.25 teaspoon minced green onion, or to taste"
  ],
  "steps": [
    {
      "text": "Whisk light soy sauce, dark soy sauce, red wine vinegar, chili oil, ginger, sugar, garlic, and green onion together in a bowl; pour into a sealable container, seal, and refrigerate 1 hour.",
