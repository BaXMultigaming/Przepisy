  "ingredients": [
    "2 eggs",
    "1 large ripe banana, mashed",
    "1 cup quick-cooking rolled oats",
    "0.5 cup unsalted raw sunflower seeds",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup nonfat dry milk powder",
    "0.5 cup chopped pitted dates",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts",
    "0.5 cup chopped dried apricots",
    "0.5 cup toasted wheat germ",
    "0.33333334326744 cup pure maple syrup",
    "0.25 cup whole-wheat pastry flour"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Lightly oil a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the eggs, banana, oats, sunflower seeds, cinnamon, milk powder, dates, raisins, walnuts, apricots, wheat germ, maple syrup, and whole-wheat pastry flour together in a large bowl until thoroughly combined; spread the mixture evenly into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes; set aside to cool. Cut into 9 bars and wrap with plastic to store.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
