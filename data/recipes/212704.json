  "ingredients": [
    "1 teaspoon butter, or as needed",
    "2 tablespoons olive oil",
    "0.25 cup diced yellow onion",
    "0.25 cup chopped celery",
    "0.25 cup chopped scallions",
    "1 medium pear, cored and diced",
    "0.25 teaspoon minced garlic",
    "2 (6 ounce) boxes dry bread stuffing mix",
    "0.25 cup chopped fresh parsley",
    "1 (32 ounce) container chicken broth"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Butter a 9x13-inch baking dish.",
