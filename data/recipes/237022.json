  "ingredients": [
    "cooking spray",
    "12 eggs",
    "0.5 cup milk",
    "0.5 cup sour cream",
    "0.5 teaspoon salt",
    "1.75 cups chopped cooked ham",
    "0.75 cup chopped red bell pepper",
    "0.75 cup sliced fresh mushrooms",
    "0.75 cup sliced green onion",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat a 13x9-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, milk, sour cream, and salt together in a large bowl until well blended. Mix ham, bell peppers, mushrooms, and green onion into egg mixture; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 50 minutes. Cover top of dish with Cheddar cheese; continue baking until cheese is melted, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
