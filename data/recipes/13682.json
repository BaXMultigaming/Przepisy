  "ingredients": [
    "2.5 cups all-purpose flour",
    "2 cups whole wheat flour",
    "2 cups white sugar",
    "1 tablespoon baking powder",
    "2 teaspoons baking soda",
    "4 eggs, beaten",
    "2 cups pumpkin puree",
    "2 teaspoons salt",
    "1 cup butter, softened"
  ],
  "steps": [
    {
      "text": "Butter two 9x5 inch loaf pans. Preheat oven to 350 degrees (175 degrees C). Place oven rack in lower 1/3 of oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the white flour, whole wheat flour, sugar, baking powder and baking soda. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, combine the pumpkin, eggs and salt. Add to flour mixture and blend in softened butter or margarine one tablespoon at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide mixture between 2 pans. Bake until golden and cake tester comes out clean, about 45 minutes. Invert onto racks and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
