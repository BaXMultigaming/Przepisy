  "ingredients": [
    "1 cup hot black tea",
    "0.75 cup raisins",
    "1 tablespoon milk",
    "6 tablespoons unsalted butter",
    "0.5 cup white sugar",
    "0.33333334326744 cup light brown sugar",
    "2 large eggs",
    "1.3333333730698 cups self-rising flour",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "0.25 cup light brown sugar",
    "2 teaspoons margarine",
    "2 tablespoons golden syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 355 degrees F (180 degrees C). Grease a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine hot black tea and raisins in a bowl; let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain raisins and transfer to a food processor. Add milk and blend to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, sugar, and brown sugar in a bowl. Whisk in eggs. Add flour, vanilla, and cinnamon; mix to combine. Stir in blended raisins and baking soda, then pour into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a skewer inserted near the center comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the pudding is cooking, combine brown sugar, margarine, and golden syrup for topping in a nonstick saucepan over medium-low heat. Cook and stir until the sauce brims over with foamy bubbles. Turn off the heat, but continue to stir until the bubbles go down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the pudding from the oven. Pour the toffee topping over the warm pudding to ensure even spreading. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
