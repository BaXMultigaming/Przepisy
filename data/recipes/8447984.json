  "ingredients": [
    "0.5 tablespoon vegetable oil",
    "0.25 cup all-purpose flour",
    "3 tablespoons almond milk",
    "1.5 tablespoons brown sugar",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon cinnamon",
    "0.25 teaspoon vanilla extract",
    "1 dash salt",
    "3 tablespoons shredded zucchini",
    "0.5 tablespoon chopped walnuts"
  ],
  "steps": [
    {
      "text": "Stir oil, flour, almond milk, brown sugar, baking powder, cinnamon, vanilla, and salt together in an 8- to 12-ounce microwave-safe mug until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat zucchini dry with 2 paper towels. Add zucchini and walnuts to mug; stir until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave, uncovered, on high power for 1½ to 2 minutes. Serve in the mug.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
