  "ingredients": [
    "1 cup butter, melted",
    "1 cup white sugar",
    "0.5 cup brown sugar",
    "1 tablespoon vanilla extract",
    "4 eggs",
    "0.75 cup all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "1 teaspoon salt",
    "0.5 cup buttermilk, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter, white sugar, and brown sugar together in a bowl; add vanilla extract and mix well. Stir eggs, 1 at a time, into butter mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cocoa powder, and salt together in a separate bowl. Stir flour mixture, alternating with buttermilk, into butter mixture until batter is smooth, adding more buttermilk if needed to thin out batter. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
