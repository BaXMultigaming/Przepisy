  "steps": [
    {
      "text": "Place cauliflower florets, 2 teaspoons oil, and garlic in a medium bowl; toss to coat. Place in a single layer in an air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the air fryer at 360 degrees F (180 degrees C), for 10 minutes, shaking the basket halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return cauliflower to the bowl and toss with remaining 1 teaspoon oil. Add Parmesan cheese, almonds, bread crumbs, and thyme; toss to coat. Return cauliflower mixture to the air fryer basket and cook until mixture is crisp and browned, about 5 minutes more.",
      "section": null,
