  "title": "Summer Vegetable Ratatouille",
  "description": "This vegetable ratatouille requires lots and lots of vegetables and lots of cutting and cubing, but it's well worth the effort, plus it freezes well!",
  "authors": [
    "Rani"
  ],
  "date_published": "1999-08-28T19:09:11-04:00",
