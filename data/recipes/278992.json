  "ingredients": [
    "1 pound carrots, cut into 1-inch pieces",
    "2 tablespoons honey",
    "1 tablespoon chopped fresh ginger",
    "1 clove garlic, chopped",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine carrots, honey, ginger, garlic, salt, and black pepper in a saucepan over medium heat; stir until carrots are coated with honey. Cook until simmering, about 5 minutes. Reduce heat to low, cover, and steam carrots until tender, 10 to 15 minutes.",
