  "ingredients": [
    "1.5 pounds fresh tuna steaks, minced",
    "0.5 cup dry bread crumbs",
    "0.25 cup finely chopped green onion",
    "0.25 cup grated carrot",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon chopped fresh cilantro",
    "1 teaspoon sesame oil",
    "1 tablespoon ketchup",
    "1 tablespoon lite soy sauce",
    "0.5 teaspoon ground cumin",
    "0.25 teaspoon salt",
    "0.25 teaspoon black pepper",
    "1 egg, beaten",
    "6 hamburger buns",
    "6 lettuce leaves - rinsed and dried",
    "2 medium tomatoes, sliced"
  ],
  "steps": [
    {
      "text": "In a bowl, thoroughly mix minced tuna, bread crumbs, green onion, carrot, ginger, cilantro, sesame oil, ketchup, soy sauce, cumin, salt, pepper, and egg. Cover, and refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form tuna mixture into 6 patties, and place in a broiler pan on top oven rack. Cook, uncovered, 4 minutes per side, or until easily flaked with a fork. Serve on hamburger buns with lettuce and tomato.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
