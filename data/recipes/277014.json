  "ingredients": [
    "3 tablespoons vegetable oil",
    "1.5 pounds skinless, boneless chicken breasts, cut into strips",
    "0.5 cup chopped onion",
    "2 cloves garlic, minced",
    "1 (28 ounce) can whole peeled tomatoes",
    "1 (8 ounce) can tomato sauce",
    "1 cup green bell pepper strips",
    "2 teaspoons salt",
    "0.5 teaspoon dried basil",
    "0.125 teaspoon cayenne pepper",
    "1.5 cups uncooked instant rice"
  ],
  "steps": [
    {
      "text": "Heat oil in a pot over medium heat. Add chicken, onion, and garlic; cook until chicken is browned and onion and garlic are softened, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomatoes, tomato sauce, bell pepper, salt, basil, and cayenne pepper; bring to boil. Cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in rice, cover, and remove from the heat. Let stand until rice is tender, about 5 minutes. Stir before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
