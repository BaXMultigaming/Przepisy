  "ingredients": [
    "3.5 pounds sweet potatoes, peeled and cubed",
    "0.25 cup butter or margarine, melted",
    "0.5 cup packed brown sugar",
    "1.25 cups cinnamon red hot candies",
    "0.75 cup water",
    "1 (10 ounce) package miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Place the sweet potatoes into a large saucepan with enough water to cover. Bring to a boil, and cook over medium heat until tender, about 25 minutes. Drain water, and place potatoes in a large casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the butter, brown sugar, red hot candies, and water. Pour over the sweet potatoes in the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour in the preheated oven, until sweet potatoes are soft, and the candies are melted. After this, you may top with marshmallows, and return the dish to the oven for 10 minutes to toast them.",
      "section": null,
      "name": null,
      "url": null,
