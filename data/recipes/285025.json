  "ingredients": [
    "0.5 cup orange juice",
    "3 tablespoons white sugar",
    "1 (750 milliliter) bottle red wine",
    "1 cup orange slices",
    "0.5 cup sliced plums",
    "0.5 cup sliced fresh strawberries",
    "0.25 cup brandy",
    "1.5 cups club soda",
    "3 cups ice, or as needed",
    "8 sprigs fresh mint"
  ],
  "steps": [
    {
      "text": "Stir orange juice and sugar together in a pitcher until sugar dissolves. Add wine, oranges, plums, strawberries, and brandy.",
