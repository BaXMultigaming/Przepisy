  "ingredients": [
    "1 cup cold milk",
    "1 (15 ounce) can solid pack pumpkin puree",
    "2 (3.5 ounce) packages instant vanilla pudding mix",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon ground cloves",
    "4 ounces cream cheese, softened",
    "1 tablespoon milk",
    "1 tablespoon white sugar",
    "1.5 cups frozen whipped topping, thawed",
    "1 (9 inch) prepared graham cracker crust"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XwGjkynUh07HIVIIfrr6hwF9sDE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12482-double-layer-pumpkin-pie-VAT-step-01-c4eb47f3688f4958b57b0e6637ce9ba0.jpg"
      ],
      "image": "assets/images/12482/step_01.webp"
    },
    {
      "text": "Pour milk for pumpkin layer into large bowl. Add pumpkin puree, pudding mix, cinnamon, ginger, and cloves and whisk until thoroughly mixed. Let sit until thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZSNL3QuqgC_xjZhnBuvXmla_PoE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12482-double-layer-pumpkin-pie-VAT-step-02-bb65b9c9de8b46578db393b3e82d67b6.jpg"
      ],
      "image": "assets/images/12482/step_02.webp"
    },
    {
      "text": "Meanwhile, beat cream cheese, milk, and sugar for cheesecake layer in a large bowl with an electric mixer until smooth. Gently stir in whipped topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ro-YEOg_wgv_N2KBXc7-G5yHD1I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12482-double-layer-pumpkin-pie-VAT-step-03-2-9cf10bb78332418f9aeb287371a94651.jpg"
      ],
      "image": "assets/images/12482/step_03.webp"
    },
    {
      "text": "Spoon into graham cracker crust and spread into an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J8Ia-RIco0A1yqMw35DxjBGr_8M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12482-double-layer-pumpkin-pie-VAT-step-04-22694d9543794792a9689f024353083c.jpg"
      ],
      "image": "assets/images/12482/step_04.webp"
    },
    {
      "text": "Spread thickened pumpkin mixture over top. Cover and refrigerate until set, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LI9FkQLitXhQOb4aiHGMm6ky55I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12482-double-layer-pumpkin-pie-VAT-step-05-2-fb34aa07253b418cac9000512a36f769.jpg"
