  "ingredients": [
    "1 sweet potato, peeled and diced",
    "1 carrot, peeled and diced",
    "0.5 onion, sliced",
    "4 cloves garlic, unpeeled",
    "2 tablespoons olive oil",
    "2 links kielbasa sausage",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sweet potato, carrot, onion, and garlic in a medium roasting pan. Drizzle with oil, salt, and pepper; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until vegetables begin to soften, about 20 minutes. Poke sausage links with a fork and place on top of vegetables. Roast until sausages are no longer pink in the center, about 20 minutes. An instant-read thermometer inserted into the center should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with the garlic cloves, squeezed hot out of their skins on each serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
