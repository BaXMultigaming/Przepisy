  "ingredients": [
    "cooking spray",
    "1 (10 ounce) can reduced-fat crescent rolls",
    "0.33333334326744 cup brown sugar",
    "1 teaspoon ground cinnamon",
    "1 (3 ounce) package Neufchatel cheese, softened",
    "3 eggs",
    "0.25 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease the bottom and sides of a 2-quart baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pull crescent roll dough out of the can; slice dough into 1/2-inch pieces. Arrange over the bottom of the baking dish. Sprinkle brown sugar and cinnamon on top. Drop teaspoonfuls of the Neufchatel cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and milk together in a small bowl. Pour into the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the center is set, 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
