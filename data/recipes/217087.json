  "ingredients": [
    "0.5 cup caramel topping",
    "0.5 teaspoon ground cinnamon",
    "6 large baking apples, peeled and cut into 1/2-inch slices",
    "0.66666668653488 cup all-purpose flour",
    "0.5 cup packed brown sugar",
    "0.5 cup cold butter, cut into small pieces",
