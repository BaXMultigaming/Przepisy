  "ingredients": [
    "2 cups elbow macaroni",
    "0.5 cup onion, finely chopped",
    "0.5 cup finely chopped green bell pepper",
    "0.25 cup finely chopped carrot",
    "0.25 cup sweet relish",
    "1 hard-boiled egg, chopped",
    "0.25 cup creamy salad dressing (such as Miracle Whip®)",
    "2 tablespoons sweet relish juice",
    "0.25 cup reduced-fat sour cream",
    "2 tablespoons low-fat milk",
    "2 tablespoons white sugar",
    "1 teaspoon dried dill weed",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain well; rinse with cold water and drain again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine macaroni, onion, bell pepper, carrot, 2 tablespoons relish juice, and egg in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk creamy salad dressing and 2 tablespoons relish juice together in a bowl until well combined; whisk in sour cream, milk, sugar, dill, salt, and black pepper until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold dressing gently into macaroni mixture until evenly coated. Refrigerate to let flavors blend, 4 to 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
