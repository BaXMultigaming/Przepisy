  "ingredients": [
    "2 tablespoons warm water",
    "5 saffron threads, or more to taste",
    "1 cup couscous",
    "1 cup vegetable broth",
    "1 celery stalk, diced",
    "0.25 cup dried currants",
    "2 tablespoons extra-virgin olive oil",
    "1 tablespoon lemon juice",
    "1 teaspoon harissa, or to taste",
    "0.5 teaspoon ground cumin",
    "sea salt to taste"
  ],
  "steps": [
    {
      "text": "Combine warm water and saffron together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix couscous and vegetable broth together in a saucepan; bring to a boil. Remove saucepan from heat, cover saucepan, and let sit for 5 minutes. Fluff couscous with a fork and transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir saffron mixture, celery, currants, olive oil, lemon juice, harissa, cumin, and sea salt into couscous. Refrigerate until chilled, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
