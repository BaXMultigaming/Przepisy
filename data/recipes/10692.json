  "ingredients": [
    "1 cup butter",
    "0.75 cup light brown sugar",
    "0.75 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2.75 cups all-purpose flour",
    "0.33333334326744 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.75 cup semisweet chocolate chips",
    "0.75 cup milk chocolate chips",
    "0.5 cup white chocolate chips",
    "7 chocolate hard candies, crushed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter, brown sugar and white sugar until smooth. Mix in the eggs one at a time, then stir in the vanilla. Combine the flour, cocoa powder and baking soda; stir into the butter mixture until well blended. Mix in the semisweet chocolate chips, milk chocolate chips, white chocolate chips, and crushed candies so they are evenly distributed. Drop by heaping teaspoonfuls onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 6 to 8 minutes in the preheated oven, or until tops are no longer shiny.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
