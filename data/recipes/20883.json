  "ingredients": [
    "cooking spray",
    "48 wonton wrappers",
    "1 pound bulk pork sausage",
    "1 cup shredded Monterey Jack cheese",
    "1 cup shredded Cheddar cheese",
    "1 cup ranch salad dressing",
    "0.5 cup chopped black olives, drained"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray two 24-cup mini muffin tins with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place wonton wrappers into the prepared muffin cups; press gently into the bottom and up the sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 minutes. Remove from the oven and let cool in the pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix sausage, Monterey Jack, Cheddar, ranch dressing, and olives together in a medium bowl. Divide mixture evenly among cooled wonton cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake, watching closely to ensure wontons do not burn, until filling is bubbly and slightly brown, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
