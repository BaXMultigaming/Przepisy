  "title": "Wonton Wrapper Appetizers",
  "description": "These sausage wontons are the perfect appetizer! Crispy wonton cups are loaded with cheese, sausage, olives, and ranch for a burst of flavor in every bite.",
  "authors": [
    "Kim"
  ],
  "date_published": "2000-03-30T16:53:32-05:00",
