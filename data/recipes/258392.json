  "ingredients": [
    "1 cup frozen corn kernels, thawed",
    "2 teaspoons vegetable oil",
    "2 large avocados, peeled and pitted",
    "1 tomato, finely chopped",
    "3 tablespoons fresh lime juice",
    "2 tablespoons finely chopped onions",
    "2 cloves garlic, minced",
    "2 teaspoons chopped pickled jalapeno peppers",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground cumin"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Combine corn and oil in a shallow pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring once or twice, until lightly browned, 8 to 10 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash 1 avocado and coarsely chop the remaining one.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine corn, mashed avocado, chopped avocado, tomato, lime juice, onions, garlic, jalapeno peppers, salt, and cumin in a bowl.",
