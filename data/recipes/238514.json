  "ingredients": [
    "1 teaspoon margarine, or as needed, softened",
    "0.75 cup almond milk",
    "1 tablespoon vinegar",
    "1.25 cups rice flour",
    "0.5 cup brown sugar",
    "0.25 cup amaranth flour",
    "0.25 cup soy flour",
    "0.25 cup flax seed meal",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon sea salt",
    "2 large bananas, mashed",
    "1 egg, beaten",
    "1 tablespoon coconut oil, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch square metal baking dish with margarine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix almond milk and vinegar together in a cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix rice flour, brown sugar, amaranth flour, soy flour, flax seed meal, baking powder, baking soda, and sea salt together in a large mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat bananas, almond milk mixture, egg, and coconut oil together in a separate bowl; add to rice flour mixture and stir until dry ingredients are completely moistened. Spread the mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
