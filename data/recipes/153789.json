  "ingredients": [
    "1 (18.25 ounce) package spice cake mix",
    "1 (3.4 ounce) package instant vanilla pudding",
    "1 cup pumpkin puree",
    "0.5 cup water",
    "0.5 cup vegetable oil",
    "3 eggs",
    "2 teaspoons pumpkin pie spice",
    "2 cups cold milk",
    "2 (3.4 ounce) packages cheesecake flavor instant pudding and pie filling",
    "2 cups whipped topping",
    "1 cup chopped toasted pecans",
    "1 cup English toffee bits"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3k1iWwng0gthpafXt7YBt8781Oo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/153789-easy-pumpkin-trifle-VAT-step-01-65702498e4dc4a4fb481ec25ec9db420.jpg"
      ],
      "image": "assets/images/153789/step_01.webp"
    },
    {
      "text": "Combine cake mix, vanilla pudding mix, pumpkin, water, oil, eggs, and pie spice in a large mixing bowl; pour into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zeZwZjJcjxMm0sM6esrAa2uJYew=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/153789-easy-pumpkin-trifle-VAT-step-02-c318a02052094dc0bc98a17c0fb13519.jpg"
      ],
      "image": "assets/images/153789/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven for 45 to 50 minutes. Allow to cool to room temperature on a wire rack. Cut the cake into 1-inch cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1ER9RdvSUoxOYBh_NY_42KXsMk8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/153789-easy-pumpkin-trifle-VAT-step-03-fc0dd5b31fa24e5e99e17ca98bb81087.jpg"
      ],
      "image": "assets/images/153789/step_03.webp"
    },
    {
      "text": "Whisk milk and cheesecake pudding mix together in a bowl. Allow to set, about 2 minutes. Fold whipped topping into pudding mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3B0DbHCMw31lgallbLwJc6T2BWQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/153789-easy-pumpkin-trifle-VAT-step-04-5af2bc1b919e40c78c9f56618dad5d12.jpg"
      ],
      "image": "assets/images/153789/step_04.webp"
    },
    {
      "text": "Layer 1/3 of the cake cubes into the bottom of a large bowl; top with 1/3 of the cream mixture and sprinkle with 1/3 of the pecans and toffee bits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RmHH3HK2oHyGlTVmAp_oURi0O_I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/153789-easy-pumpkin-trifle-VAT-step-05-36f554099e2842a0be991aa3c4653c12.jpg"
      ],
      "image": "assets/images/153789/step_05.webp"
    },
    {
      "text": "Repeat layering until all ingredients are uses. cover and refrigerate for at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z8ciCyFSu7fUAwWdwQpxLMGY3YI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/153789-easy-pumpkin-trifle-VAT-step-06-a53ed7bac9c24703845cc14eb24627b4.jpg"
      ],
      "image": "assets/images/153789/step_06.webp"
    }
  ],
