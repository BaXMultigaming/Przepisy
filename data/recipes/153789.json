  "title": "Easy Pumpkin Trifle",
  "description": "This easy pumpkin trifle layers cubes of spice cake with creamy pudding, whipped topping, pecans, and toffee bits for a delightful holiday dessert.",
  "authors": [
    "Stacey Lynch"
  ],
  "date_published": "2019-04-03T23:45:25-04:00",
