    "1 cup white sugar",
    "1 cup milk",
    "1 cup butter, melted",
    "1 (28 ounce) can sliced cling peaches in heavy syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
