  "title": "Blueberry-Apple Crunch",
  "description": "This blueberry-apple crunch is a simple dessert that only cooks for 10 minutes in the microwave for a quick, hearty treat.",
  "authors": [
    "kathyE"
  ],
  "date_published": "2020-06-18T23:56:40-04:00",
