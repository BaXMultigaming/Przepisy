  "ingredients": [
    "1 cup all-purpose flour",
    "0.75 cup packed brown sugar",
    "0.5 cup rolled oats",
    "0.25 cup graham cracker crumbs",
    "1 teaspoon ground cinnamon",
    "0.5 cup melted butter",
    "3.5 cups peeled and sliced apples",
    "1.5 cups blueberries",
    "1 tablespoon lemon juice",
    "0.25 cup white sugar",
    "2 tablespoons cornstarch",
    "1 cup cold water",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Grease a microwave-safe 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, brown sugar, oats, graham cracker crumbs, and cinnamon together in a bowl; stir in butter until well mixed. Press 1/2 the oat mixture into the prepared casserole dish. Spread apples and blueberries over oat mixture; drizzle with lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir white sugar and cornstarch together in a microwave-safe bowl; mix in water and vanilla extract until smooth. Heat sugar mixture in the microwave, stirring every 45 seconds, until sauce is thick and nearly clear, 2 to 4 minutes. Pour sauce over fruit layer and sprinkle remaining oat mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat in microwave at 70 percent power until fruit is tender and juice is bubbling, 8 to 10 minutes. Cool slightly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
