    "1 cup rolled oats",
    "0.5 cup natural peanut butter",
    "0.33333334326744 cup honey",
    "0.25 cup chopped dark chocolate",
    "2 tablespoons flax seeds",
    "2 tablespoons chia seeds",
    "1 tablespoon chocolate-flavored protein powder, or to taste"
