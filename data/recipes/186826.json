  "ingredients": [
    "2 tablespoons dried chives",
    "1 tablespoon dried basil",
    "1 tablespoon paprika",
    "1 tablespoon white sugar",
    "1 tablespoon dried parsley",
    "2 teaspoons onion powder",
    "2 teaspoons garlic powder",
    "2 teaspoons celery salt",
    "1.5 tablespoons dried cilantro",
    "1 teaspoon finely ground black pepper",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon cayenne pepper",
    "0.25 teaspoon ground turmeric",
    "0.25 teaspoon monosodium glutamate (MSG)",
    "3 tablespoons lemon juice",
    "3 tablespoons horseradish sauce",
    "1 tablespoon prepared yellow mustard",
    "2 cups mayonnaise"
  ],
  "steps": [
    {
      "text": "Stir together the chives, basil, paprika, sugar, parsley, onion powder, garlic powder, celery salt, cilantro, pepper, allspice, ginger, cayenne pepper, turmeric, monosodium glutamate, and lemon juice in a microwave-safe bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the microwave on High for 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the horseradish sauce and mustard; allow to cool 5 minutes; fold in the mayonnaise. Chill in refrigerator at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
