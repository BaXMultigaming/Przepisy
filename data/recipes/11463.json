  "ingredients": [
    "1 (18.25 ounce) package lemon cake mix",
    "2 cups frozen whipped topping, thawed",
    "1 egg, beaten",
    "0.5 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "In a large bowl, combine cake mix, whipped topping, and egg; mix until well combined. Cover and refrigerate for at least 3 hours or overnight. (Or wrap the dough in plastic and freeze.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to bake, preheat the oven to 350 degrees F (175 degrees C). Grease two cookie sheets or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1-inch balls, then roll each ball in confectioners' sugar to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are set but not browned, 10 to 12 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
