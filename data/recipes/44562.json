  "ingredients": [
    "3.5 cups apples - peeled, cored, and coarsely chopped",
    "2 cups white sugar",
    "0.5 cup water",
    "2 eggs, lightly beaten",
    "1 cup margarine, melted",
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "2 teaspoons ground cinnamon",
    "0.25 teaspoon salt",
    "1 cup raisins",
    "1 cup chopped walnuts",
    "2 cups confectioners' sugar",
    "3 tablespoons hot water",
    "1.5 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mix the apples and sugar. Let stand about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour two 10x15 inch baking pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the water into the bowl with apples. Blend eggs and margarine in a small bowl, and mix with the apples. Mix in the flour, baking soda, cinnamon, and salt. Stir in the raisins and walnuts. Transfer to the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 1 hour in the preheated oven, or until a toothpick inserted in the center comes out clean. Cool slightly before turning out of pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, blend confectioners' sugar, hot water, and vanilla extract. Drizzle over the cakes while still warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
