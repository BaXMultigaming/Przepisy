  "ingredients": [
    "6 large russet baking potatoes",
    "2 tablespoons canola oil",
    "0.75 teaspoon garlic salt",
    "0.75 teaspoon chili powder",
    "0.5 teaspoon ground black pepper",
    "6 tablespoons sour cream",
    "6 tablespoons green onions, chopped",
    "6 tablespoons grated sharp Cheddar cheese",
    "6 tablespoons diced cooked bacon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss potatoes with oil in a large bowl until well coated. Add garlic salt, chili powder, and pepper and continue to toss until spices are evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes directly on the center rack of the preheated oven. Bake for 15 minutes, then reduce heat to 350 degrees F (175 degrees C). Continue baking until a toothpick inserted in the center of a potato offers little resistance, about 40 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice each baked potato lengthwise down the center, add sour cream, green onions, Cheddar cheese, and bacon. Serve piping hot.",
      "section": null,
      "name": null,
      "url": null,
