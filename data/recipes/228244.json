  "ingredients": [
    "1 cup white sugar",
    "0.5 cup white vinegar",
    "1 teaspoon salt",
    "0.5 teaspoon mustard seed",
    "0.25 teaspoon celery seed",
    "0.25 teaspoon ground turmeric",
    "2 large English cucumbers, thinly sliced",
    "1 large onion, diced"
  ],
  "steps": [
    {
      "text": "Stir sugar and vinegar together in a large microwave-safe bowl until sugar dissolved; stir in salt, mustard seeds, celery seeds, and turmeric. Stir in cucumbers and onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on high, stirring twice, until cucumbers are tender and onion is translucent, 7 to 8 minutes. Chill before serving.",
      "section": null,
      "name": null,
      "url": null,
