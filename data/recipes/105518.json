  "ingredients": [
    "1 (20 ounce) package 15-bean soup mix (seasoning packet not used)",
    "2.5 cups cubed ham",
    "1 ham bone",
    "5 large carrots, chopped",
    "3 stalks celery, chopped",
    "1 large onion, chopped",
    "1 (14.5 ounce) can diced tomatoes, undrained",
    "3 cups vegetable broth",
    "1 (12 fluid ounce) can low-sodium vegetable juice",
    "3 tablespoons lemon juice",
    "2 tablespoons Worcestershire sauce",
    "2 tablespoons Dijon mustard",
    "1 tablespoon chili powder",
    "1 tablespoon dried parsley",
    "1 teaspoon ground black pepper",
    "3 large bay leaves",
    "7 cups fat-free reduced-sodium chicken broth",
    "1 teaspoon kosher salt, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EuTXLI5pMf_QCoUJFFA2ruVlMu0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/105518-the-best-bean-and-ham-soup-ddmfs-Step-01-47ae393473e4433aa7da068bc33dbda8.jpg"
      ],
      "image": "assets/images/105518/step_01.webp"
    },
    {
      "text": "Place beans into a large container and cover with several inches of cool water; let soak, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain beans and transfer to a large pot. Fill with enough water to cover by about 1 inch; bring to a boil over medium heat. Reduce the heat to low and simmer for 30 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KBXyt2Ztd6w2eD_Po-kP7bXQGoo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/105518-the-best-bean-and-ham-soup-ddmfs-Step-03-9c31a4cb54e349258de6989720cf1932.jpg"
      ],
      "image": "assets/images/105518/step_03.webp"
    },
    {
      "text": "Add ham, ham bone, carrots, celery, onion, and undrained diced tomatoes to the pot. Stir in vegetable broth, vegetable juice, lemon juice, Worcestershire sauce, Dijon, chili powder, parsley, pepper, and bay leaves. Pour in enough chicken broth to cover ingredients and simmer over low heat, stirring occasionally and adding more chicken broth as needed, for about 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ext-miPQ7iqncc2Mv90Oln6Ks2g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/105518-the-best-bean-and-ham-soup-ddmfs-Step-04-9304a39289e646f0a4bb7a1b0c47e99f.jpg"
      ],
      "image": "assets/images/105518/step_04.webp"
    },
    {
      "text": "Remove and discard ham bone and season soup with salt. Continue to simmer for 1 to 2 hours. Remove bay leaves before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IucbO4VZOAPG3aNybEwaAOTBgdk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/105518-the-best-bean-and-ham-soup-ddmfs-Step-05-8ef7fd6d7483466a866dadd74c09c104.jpg"
      ],
      "image": "assets/images/105518/step_05.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w8UtSL7mI0xHfNA4gNTqSuUwpVs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/105518-the-best-bean-and-ham-soup-ddmfs-Beauty-3x4-89a0dc45d3bb4da19fbd3786abc33804.jpg"
      ],
