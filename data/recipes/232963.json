  "ingredients": [
    "2 cups butter",
    "1 cup white sugar",
    "2 egg yolks",
    "1 egg white",
    "2 tablespoons almond extract",
    "4.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter in a large bowl with an electric mixer until light and fluffy. Slowly beat in sugar until noticeably lighter in color. Add egg yolks, one at a time, beating well after each addition before adding the next. Beat in egg white and almond extract. Beat in flour in small amounts; continue beating until fully incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press dough onto the prepared baking sheet using a cookie press.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 8 to 10 minutes. Cool cookies on the baking sheet for 1 minute before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
