  "ingredients": [
    "3 tablespoons Dijon mustard",
    "3 tablespoons butter, melted",
    "5 teaspoons honey",
    "0.5 cup fresh bread crumbs",
    "0.5 cup finely chopped pecans",
    "3 teaspoons chopped fresh parsley",
    "6 (4 ounce) fillets salmon",
    "salt and pepper to taste",
    "6 lemon wedges"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). In a small bowl, mix together the mustard, butter, and honey. In another bowl, mix together the bread crumbs, pecans, and parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JAvXoFYL4gEuftJA9Nx8eODax5A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9336-alaska-salmon-bake-with-pecan-crunch-coating-VAT-step-01-b8f1102cebde49218f26206d99644367.jpg"
      ],
      "image": "assets/images/9336/step_01.webp"
    },
    {
      "text": "Season each salmon fillet with salt and pepper. Place on a lightly greased baking sheet. Brush with mustard-honey mixture. Cover the top of each fillet with bread crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iKajNbSEbqAlV5cvDITIX1edFpc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9336-alaska-salmon-bake-with-pecan-crunch-coating-VAT-step-02-78fb270006f84a498af4f7e446d76d5d.jpg"
      ],
      "image": "assets/images/9336/step_02.webp"
    },
    {
      "text": "Bake for 10 minutes per inch of thickness, measured at thickest part, or until salmon just flakes when tested with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Lr6dkg4gcAS8u2p2yVBg_PfN9OA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9336-alaska-salmon-bake-with-pecan-crunch-coating-VAT-step-03-a536f96875a84664b48b11f053dad308.jpg"
      ],
      "image": "assets/images/9336/step_03.webp"
    },
    {
      "text": "Serve garnished with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
