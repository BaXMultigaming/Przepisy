  "ingredients": [
    "2 (2 pound) boneless pork loin roast",
    "seasoning salt to taste",
    "2 cups apple juice",
    "0.5 cup apple butter",
    "0.25 cup brown sugar",
    "2 tablespoons water",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season the pork loins with seasoning salt, and place them in a 9x13 inch baking dish or small roasting pan. Pour apple juice over the pork, and cover the dish with a lid or aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour in the preheated oven. While the pork is roasting, mix together the apple butter, brown sugar, water, cinnamon, and cloves. Remove pork roasts from the oven, and spread with apple butter mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and return to the oven for 2 hours, or until fork-tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
