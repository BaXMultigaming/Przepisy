  "ingredients": [
    "1 cup sour cream",
    "0.75 cup whole milk",
    "0.66666668653488 cup superfine sugar",
    "3 eggs, beaten",
    "1 tablespoon baking powder",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground ginger",
    "1 cup chopped canned pears",
    "1 cup canned crushed pineapple, drained",
    "1 (16 ounce) can sweet potatoes, drained and cut into chunks",
    "4 cups French bread cubes",
    "0.33333334326744 cup packed light brown sugar",
    "0.25 cup all-purpose flour",
    "1 teaspoon freshly grated orange zest",
    "0.25 cup unsalted butter, melted",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Butter a 1 quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk together the sour cream, milk, sugar, eggs, baking powder, ginger and vanilla. Stir in the pears, pineapple and sweet potatoes just to coat, then add the bread cubes and mix until evenly distributed. Pour into the prepared baking dish. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, stir together the brown sugar, flour and orange zest. Briefly stir in the butter and pecans. Sprinkle over the top of the bread pudding.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes in the preheated oven, until evenly puffed up and browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
