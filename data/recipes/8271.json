  "ingredients": [
    "1 (10 ounce) package frozen raspberries, thawed",
    "2 tablespoons white sugar",
    "2 tablespoons orange liqueur",
    "1.75 cups heavy whipping cream, divided",
    "6 ounces white chocolate, chopped",
    "1 drop red food coloring"
  ],
  "steps": [
    {
      "text": "Process berries in a blender or food processor until smooth. Strain mixture into a small bowl and discard seeds. Add sugar and liqueur; stir until sugar dissolves. Makes 1 cup raspberry sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm 1/4 cup cream and white chocolate in a heavy saucepan over low heat, stirring constantly, until chocolate melts; let mixture cool until lukewarm. Stir in 1 tablespoon raspberry sauce and food coloring. Transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 1/2 cups cream in a chilled glass or metal bowl with an electric mixer until soft peaks form; fold into melted chocolate mixture, 1/3 at a time, until no streaks remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer into parfait dishes and serve with remaining raspberry sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
