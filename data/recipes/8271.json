  "title": "Raspberry White Chocolate Mousse",
  "description": "This white chocolate mousse with raspberry sauce is made with heavy cream and white chocolate chips for a deliciously light and fluffy layered dessert.",
  "authors": [
    "Stacey Walery"
  ],
  "date_published": "1998-11-15T23:41:45-05:00",
