  "ingredients": [
    "1 tablespoon sliced almonds, or to taste",
    "0.5 cup white sugar",
    "0.25 cup rum",
    "0.25 cup butter",
    "2 plantains, peeled and sliced",
    "1 pinch ground cinnamon, or to taste"
  ],
  "steps": [
    {
      "text": "Cook and stir almonds in a skillet over medium-high heat until golden and toasted, 2 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, rum, and butter together in a microwave-safe bowl. Cover the bowl with a lid or plastic wrap and microwave until hot, stirring once, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place plantain slices in rum sauce, sprinkle with cinnamon, cover the bowl, and microwave until plantains are hot and tender, 1 to 2 minutes more. Top with toasted almonds.",
      "section": null,
