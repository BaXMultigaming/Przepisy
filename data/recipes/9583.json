  "title": "Linzer Torte Cookies",
  "description": "These Linzer torte cookie bars are a version of the classic Austrian dessert. You can make them as cookie bars with a lattice top or use cookie cutters if desired.",
  "authors": [
    "k anderson"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
