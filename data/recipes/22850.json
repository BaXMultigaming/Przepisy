  "ingredients": [
    "2.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups white sugar",
    "1.25 cups margarine",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "0.25 cup white sugar for decoration"
  ],
  "steps": [
    {
      "text": "Stir flour, baking soda, and salt together in a medium bowl. Beat sugar and margarine together with an electric mixer in a large bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qCi-bGymO9lJDC9jxUX01W2mXh4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22850-ChewySugarCookies-mfs-Step1-0050-4x3-6bf95a727d28443eb9ea98cebe068f5b.jpg"
      ],
      "image": "assets/images/22850/step_01.webp"
    },
    {
      "text": "Beat first egg into mixture. Beat second egg into mixture along with vanilla extract; add flour mixture and stir until dough is just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bsfqpaK5yuSBAcLnmTXb4aB6QXI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22850-ChewySugarCookies-mfs-Step2-0075-4x3-1c1e3077a7424ba5894995107ad46ce5.jpg"
      ],
      "image": "assets/images/22850/step_02.webp"
    },
    {
      "text": "Wrap dough in plastic wrap and chill for 30 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into walnut-sized balls; roll in 1/4 cup of sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vpEkbGzfbr3o9oTdsgX1xU38r4M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22850-ChewySugarCookies-mfs-Step3-0111-4x3-8e1b8ca33530428dbd498b8cc20b723a.jpg"
      ],
      "image": "assets/images/22850/step_05.webp"
    },
    {
      "text": "Place cookies 2 inches apart onto ungreased cookie sheets and flatten slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DGE0Z9jC5evqqXyUeG4xFNh3eLo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22850-ChewySugarCookies-mfs-Step4-0115-4x3-58b21c6f5b6442799d2bbb22c560688f.jpg"
      ],
      "image": "assets/images/22850/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until lightly browned at the edges, about 8 to 10 minutes. Allow cookies to cool on the cookie sheets for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tGHNepoxDQGWXK7eI0G2OQ-JKaM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22850-ChewySugarCookies-mfs-MFS-2X3-0134-47933f33047a407d95af9f7c07cc4049.jpg"
      ],
      "image": "assets/images/22850/step_07.webp"
    }
