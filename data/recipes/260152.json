  "ingredients": [
    "cooking spray",
    "0.75 cup white sugar",
    "6 tablespoons unsalted butter, melted",
    "1 teaspoon vanilla extract",
    "2 large eggs",
    "0.25 cup cornstarch",
    "1 tablespoon unsweetened cocoa powder",
    "1 pinch salt",
    "1.25 cups chopped dark chocolate"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, butter, and vanilla in a large bowl; beat with an electric mixer until smooth and creamy. Add eggs one at a time, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornstarch, cocoa powder, and salt in a bowl and sift over the sugar-butter mixture. Beat in slowly with a wooden spoon or spatula until all ingredients are incorporated well. Fold in chopped chocolate and let batter rest for 5 minutes. Pour brownie batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the middle comes out clean, about 20 minutes. Remove from oven. Let cool completely before cutting into squares, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
