  "ingredients": [
    "1 cup margarine, softened",
    "1 cup white sugar",
    "1 cup brown sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.33300000429153 cup unsweetened cocoa powder",
    "3 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O3U1dnHSwuj_0cfS-OnUGJVq2tY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26237-double-chocolate-chip-cookies-VAT-Ingredients-step-01-24174101dba44d41ba1587e31d11d9e7.jpg"
      ],
      "image": "assets/images/26237/step_01.webp"
    },
    {
      "text": "In a medium bowl, cream together the margarine, white sugar, and brown sugar until smooth. Beat in the eggs one at a time, then stir in the vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RaiqWEBbhP8bxQBeKiu01vqTOXY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26237-double-chocolate-chip-cookies-VAT-step-02-1-a4ff00296960479fbfe8c533f9aefde8.jpg"
      ],
      "image": "assets/images/26237/step_02.webp"
    },
    {
      "text": "Sift in the flour, baking soda, salt, and cocoa powder; mix well. Stir in the chocolate chips",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x2CD2pt79Lz5k-RucrP8IAh2v9c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26237-double-chocolate-chip-cookies-VAT-step-02-2-b6fd040bf0f24e4baa3d0f8690064c78.jpg"
      ],
      "image": "assets/images/26237/step_03.webp"
    },
    {
      "text": "Roll tablespoonfuls of cookie dough into balls and place them 1 inch apart onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EgfdLmJbbZ-NVbtxzByVYqE0v8c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26237-double-chocolate-chip-cookies-VAT-step-02-4-a7b37b5c3302419c8a47c0c9f86fb522.jpg"
      ],
      "image": "assets/images/26237/step_04.webp"
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven. Allow cookies to cool on baking sheet for 2 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UvOvYYNmUxh1pUb2P-S7Q2HFuqk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26237-double-chocolate-chip-cookies-VAT-step-03-01137635c8f74696816a3de568bf0b92.jpg"
      ],
      "image": "assets/images/26237/step_05.webp"
    }
  ],
