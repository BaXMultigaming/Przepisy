  "ingredients": [
    "1.5 cups ketchup",
    "1 cup strong brewed coffee",
    "0.25 cup brown sugar",
    "0.25 cup cider vinegar",
    "2 tablespoons Worcestershire sauce",
    "2 tablespoons vegetable oil",
    "0.5 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Combine ketchup, coffee, brown sugar, vinegar, Worcestershire sauce, oil, and cayenne in a medium nonreactive saucepan over medium heat. Bring to a boil, stirring to dissolve sugar. Reduce heat and simmer, stirring occasionally, until slightly thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and cool. Transfer to a tightly covered container and store in the refrigerator.",
