  "ingredients": [
    "1 pint ricotta cheese",
    "1 egg",
    "2 teaspoons garlic powder",
    "2 teaspoons onion powder",
    "2 teaspoons Italian-style seasoning",
    "1 pound shredded mozzarella cheese, divided",
    "1 (16 ounce) jar spaghetti sauce",
    "1 pound deli sliced roast beef"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the ricotta cheese, egg, garlic powder, onion powder, Italian-style seasoning and half the mozzarella cheese and mix well. Place a spoonful of mixture onto a slice of roast beef and roll. Repeat with remaining beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1/2 cup of the spaghetti sauce on the bottom of a 9x13 inch casserole dish. Place the beef rolls in the baking dish seam side down. Pour the remaining sauce over the beef rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake covered at 375 degrees F (190 degrees C) for 40 minutes, add the remaining mozzarella cheese over the top and bake for an additional 3 minutes, uncovered, until cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
