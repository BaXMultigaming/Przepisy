  "ingredients": [
    "0.5 tablespoon sesame oil",
    "1 onion, diced",
    "1.5 pounds cooked, cubed chicken meat",
    "2 tablespoons soy sauce",
    "2 large carrots, diced",
    "2 stalks celery, diced",
    "1 large red bell pepper, diced",
    "0.75 cup fresh pea pods, halved",
    "0.5 large green bell pepper, diced",
    "6 cups cooked white rice",
    "2 large eggs, scrambled",
    "0.33333334326744 cup soy sauce"
  ],
  "steps": [
    {
      "text": "Heat sesame oil in a large skillet over medium heat. Add onion and sauté until soft. Add cooked chicken and 2 tablespoons soy sauce; stir-fry for 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in carrots, celery, red bell pepper, pea pods, and green bell pepper; stir-fry for 5 minutes. Mix in cooked rice until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in scrambled eggs and 1/3 cup soy sauce; cook until heated through and serve hot.",
