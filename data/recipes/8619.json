  "ingredients": [
    "1 (2 to 3 pound) whole chicken, cut into pieces",
    "2 teaspoons garlic powder",
    "1.5 cups prepared barbecue sauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in a shallow baking dish and sprinkle with garlic powder. Cover and bake 1 hour at 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove baking dish from oven and drain any fat from dish. Pour the barbecue sauce evenly over the chicken and bake uncovered for 30 minutes at 350 degrees F (175 degrees C). Remove and serve.",
