  "ingredients": [
    "2 tablespoons unsalted butter",
    "2 tablespoons all-purpose flour",
    "1 (14 ounce) can beef broth",
    "2 tablespoons ketchup",
    "2 teaspoons Worcestershire sauce",
    "2 teaspoons Dijon mustard",
    "0.5 teaspoon onion powder",
    "0.25 teaspoon garlic powder",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a small saucepan over medium heat. Whisk in flour and stir until the mixture becomes paste-like and light golden brown, about 5 minutes. Whisk in beef broth gradually. Cook and stir until no lumps remain, about 2 minutes. Add ketchup, Worcestershire sauce, Dijon mustard, onion powder, garlic powder, salt, and black pepper. Cook and whisk until gravy thickens, about 5 minutes more.",
