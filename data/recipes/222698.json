  "ingredients": [
    "2 cups water",
    "1 cup lentils",
    "1 potato, peeled and cubed",
    "1 red bell pepper, chopped",
    "1 onion, chopped",
    "2 tablespoons minced garlic",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 cup chopped fresh cilantro",
    "0.25 cup chopped green onion"
  ],
  "steps": [
    {
      "text": "Combine water and lentils in a saucepan over medium heat; bring to a boil and cook for about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir potato, red bell pepper, onion, garlic, salt, and pepper into lentils; continue cooking until potato and lentils are tender and cooked through, about 15 minutes more. Garnish with cilantro and green onion to serve.",
