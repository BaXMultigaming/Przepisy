  "ingredients": [
    "1 pound ground beef",
    "0.5 onion, chopped",
    "2 red bell peppers, cut into 2 inch pieces",
    "1 (15 ounce) can baked beans",
    "1 tablespoon dry fajita seasoning",
    "1 (8.5 ounce) package corn bread mix",
    "1 egg",
    "0.33333334326744 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble ground beef into a large cast-iron skillet over medium-high heat; cook, stirring frequently, until evenly brown. Drain grease. Add onion to the skillet; cook and stir until onion is translucent. Add bell peppers, beans, and fajita seasoning; cook and stir until heated through. Spread into an even layer in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornbread mix, egg, and milk in a bowl according to package directions; spoon over beef mixture, spreading evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into cornbread layer comes out clean, about 20 minutes. Cool before serving, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
