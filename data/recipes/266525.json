  "ingredients": [
    "1 (16 ounce) package spaghetti",
    "0.5 pound sliced fresh mushrooms",
    "1 tablespoon olive oil",
    "2 cloves garlic",
    "3 eggs",
    "0.5 cup freshly grated Parmesan cheese divided"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place mushrooms in a dry skillet over medium heat. Cook until they begin to brown and release moisture, 3 to 5 minutes. Add oil and garlic. Fry until softened, about 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs together in a bowl. Add 1/2 of the Parmesan cheese. Mix well and stir into cooked mushroom mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve spaghetti topped with mushroom sauce and remaining Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
