  "ingredients": [
    "1.5 cups dry pancake mix",
    "0.5 cup flax seed meal",
    "1 cup skim milk",
    "2 eggs",
    "1 cup fresh or thawed frozen blueberries"
  ],
  "steps": [
    {
      "text": "Place a large nonstick skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together pancake mix and flax seed meal in a large bowl. Whisk together milk and eggs in a measuring cup until well combined; pour into pancake mix mixture and stir until batter is just moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon 1/4 cupfuls batter onto the hot skillet. Sprinkle with as many blueberries as desired. Cook until bubbles appear on the surface, then flip and cook until browned on the other side. Repeat with remaining batter and blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
