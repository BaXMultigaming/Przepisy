  "ingredients": [
    "3 eggs",
    "1 (14 ounce) can sweetened condensed milk",
    "3 tablespoons chocolate-flavored syrup",
    "2.5 tablespoons instant coffee granules",
    "16 fluid ounces non-dairy creamer",
    "1 teaspoon vanilla extract",
    "1 teaspoon almond extract",
    "1.25 cups brandy"
  ],
  "steps": [
    {
      "text": "In an electric blender, combine eggs, sweetened condensed milk, chocolate syrup and coffee granules. Blend for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add creamer, vanilla extract, almond extract and brandy to the mixture in the electric blender. Blend for 12 minutes. Refrigerate the mixture overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain the Irish Cream through a cheesecloth, then serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
