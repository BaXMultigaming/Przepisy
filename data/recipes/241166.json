  "ingredients": [
    "cooking spray",
    "2 (16 ounce) packages cottage cheese",
    "10 eggs, beaten",
    "1 pound shredded Monterey Jack cheese",
    "1 (4 ounce) can diced green chiles",
    "0.5 cup butter, melted",
    "0.5 cup all-purpose flour",
    "0.5 cup cooked crumbled bacon",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 10x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cottage cheese, beaten eggs, Monterey Jack cheese, green chiles, melted butter, flour, bacon, and baking powder in a large bowl until well combined; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Reduce heat to 350 degrees F (175 degrees C) and continue baking until a toothpick inserted into the center of casserole comes out clean, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
