  "title": "Southern-Style French Onion Soup",
  "description": "Make this easy French onion soup recipe for steaming bowls of savory broth, tender onions, crisp-gone-soggy bread, and melty mozzarella cheese.",
  "authors": [
    "Stephanie"
  ],
  "date_published": "2000-02-14T12:54:28-05:00",
