  "ingredients": [
    "0.75 cup white sugar",
    "2 teaspoons cornstarch",
    "1 (12 fluid ounce) can fat-free evaporated milk",
    "0.5 cup semisweet chocolate chips",
    "1 cup plain lowfat yogurt",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine sugar and cornstarch in a medium saucepan. Stir in evaporated milk and chocolate chips. Cook over medium heat, stirring constantly, until chocolate is melted and mixture is thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the saucepan from heat and stir in yogurt and vanilla. Refrigerate until chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chilled mixture into an ice cream maker. Freeze according to the manufacturer's instructions.",
