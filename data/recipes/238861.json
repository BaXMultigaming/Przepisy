  "ingredients": [
    "1 cup water",
    "0.5 cup buckwheat groats, rinsed",
    "8 asparagus spears",
    "0.33333334326744 cup pesto",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring 1 cup water to a boil in a saucepan. Add buckwheat; stir once. Reduce heat and simmer until buckwheat is tender yet firm to the bite, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add asparagus, cover, and steam until tender, 2 to 6 minutes. Remove from steamer; cut into 1/2-inch pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine asparagus and pesto in a bowl; mix until coated. Add buckwheat; toss to combine. Top with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
