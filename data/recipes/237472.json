  "ingredients": [
    "2 tablespoons butter, softened",
    "2 thick slices French bread",
    "6 thin slices Brie cheese, or more to taste",
    "12 fresh thyme leaves, or to taste",
    "1 pinch cracked black pepper",
    "6 slices pear (such as Bosc)",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Generously butter one side of each slice of bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread slices butter-side down into hot skillet. Arrange Brie cheese slices on top of each piece of bread. Sprinkle thyme and cracked black pepper over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pear slices in a single layer over the Brie cheese on one slice of bread and top with a pinch of salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flip the slice of bread without pears onto the slice of bread with the pear slices. Continue cooking sandwich until cheese and pear are heated through and cheese is melted, 2 to 3 minutes per side. Transfer to a plate and cut into halves.",
      "section": null,
      "name": null,
