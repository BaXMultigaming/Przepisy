  "title": "Corned Beef Jerky",
  "description": "Use a dehydrator to make this easy corned beef jerky that&#39;s great for snacking or camping.",
  "authors": [
    "Soup Loving Nicole"
  ],
  "date_published": "2022-06-30T17:10:24-04:00",
