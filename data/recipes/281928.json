  "ingredients": [
    "1 (32 fluid ounce) container vegetable broth",
    "4 cups peeled and cubed sweet potatoes",
    "1 (15 ounce) can reduced-sodium black beans, rinsed and drained",
    "1 cup mild picante sauce",
    "1 (12 ounce) jar roasted red peppers, coarsely chopped",
    "0.25 cup chopped cilantro",
    "1 tablespoon smoked paprika",
    "2 medium limes, juiced"
  ],
  "steps": [
    {
      "text": "Combine vegetable broth and sweet potatoes in a pot over medium-high heat. Bring to a boil and cook until sweet potatoes are softened, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine black beans and picante sauce in a blender; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the black bean mixture and roasted red peppers to the soup. Reduce heat. Add cilantro, smoked paprika, and lime juice. Stir soup and cook until heated through, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
