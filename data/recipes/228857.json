    "publisher-tested"
  ],
  "ingredients": [
    "0.5 cup butter",
    "8 onions, sliced",
    "2 cloves garlic, crushed",
    "1 teaspoon dried thyme",
    "0.5 teaspoon salt, or to taste",
    "0.5 teaspoon ground black pepper, or to taste",
    "1 cup red wine",
    "1 tablespoon sherry",
    "2 tablespoons all-purpose flour",
    "2 quarts beef broth",
    "1 French baguette, cut into 1/2-inch thick slices",
    "2 tablespoons olive oil, or as needed",
    "6 slices Swiss cheese",
    "6 slices provolone cheese"
  ],
  "steps": [
    {
      "text": "Melt butter in a large stockpot over medium heat. Cook and stir onions, garlic, thyme, salt, and pepper in hot butter until onions are soft and brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vM3wGugDvge6vNxwp8F4WWjLEHc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22885-restaurant-style-french-onion-soup-step-1-d7d8dd8c6e4e42178ec1ab88eb2180b7.jpg"
      ],
      "image": "assets/images/228857/step_01.webp"
    },
    {
      "text": "Pour in red wine and sherry; bring to a boil. Reduce heat to low and simmer until you can no longer smell alcohol cooking off, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rB90CVgDCLWiZ2cg8HJwd1KME1U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22885-restaurant-style-french-onion-soup-step-2-8a659564ab8f4ad6810de610000c88ce.jpg"
      ],
      "image": "assets/images/228857/step_02.webp"
    },
    {
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle onion mixture with flour and stir until coated; cook for 10 minutes. Pour in broth, stir to blend in flour, and simmer until slightly thickened, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qPeEnJ7mYAYZxRHJAHdX36Rl3Fs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22885-restaurant-style-french-onion-soup-step-3-547e8f0744f945738c4be454bca6edfd.jpg"
      ],
      "image": "assets/images/228857/step_04.webp"
    },
    {
      "text": "While soup is simmering, arrange baguette slices on a baking sheet and drizzle with olive oil. Bake baguette slices in the preheated oven until golden brown, 12 to 14 minutes, flipping slices halfway through baking. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UxZyiaKwQqHXdissuk-UCCqW31E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22885-restaurant-style-french-onion-soup-step-6-3a37185888454235acdbd4833b4ec2be.jpg"
      ],
      "image": "assets/images/228857/step_05.webp"
    },
    {
      "text": "Set an oven rack about 8 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle soup into 6 oven-proof crocks, filling them about 3/4 full. Place 1 or 2 toasted baguette slices over each soup serving, then top each with a Swiss cheese and provolone slice. Carefully place filled crocks onto a sturdy baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-q1P5WYtoREuO8ICuM_mpTGconc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22885-restaurant-style-french-onion-soup-step-7-3adecc1508124fcda75c9de6da7298d3.jpg"
      ],
      "image": "assets/images/228857/step_07.webp"
    },
    {
      "text": "Cook soup under the preheated broiler until cheese is browned and bubbly, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VDTkHVMAo0TLy345eHGG-v-V08A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228857-restaurant-style-french-onion-soup-DDMFS-4x3-b6d3c7258efb486c90b9bbfdc3de1447.jpg"
      ],
      "image": "assets/images/228857/step_08.webp"
    }
  ],
