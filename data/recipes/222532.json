  "ingredients": [
    "1 quart vegetable oil for frying, or as needed",
    "0.5 cup all-purpose flour",
    "0.5 cup self-rising cornmeal",
    "0.5 onion, minced",
    "0.5 cup milk",
    "1 egg, beaten",
    "1 stalk celery, minced",
    "2 cloves garlic, minced",
    "1 pinch Cajun seasoning, or to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, cornmeal, onion, milk, egg, celery, garlic, and Cajun seasoning in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop ping pong ball-sized balls of batter, about 5 at a time, into the hot oil. Fry until golden brown, about 5 minutes. Remove hush puppies with a slotted spoon and drain on a paper towel-lined plate. Repeat with remaining batter.",
