  "ingredients": [
    "1 tablespoon butter",
    "2 cups fresh strawberries, hulled and halved",
    "0.25 cup granular sucrolose sweetener (such as Splenda®)",
    "1 tablespoon balsamic vinegar",
    "4 scoops low-fat vanilla ice cream"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Add the strawberry halves, sucrolose sweetener, and balsamic vinegar. Cook until the strawberries are heated through and darkened to a ruby red.",
