  "ingredients": [
    "2 tablespoons vegetable oil, divided",
    "0.5 onion, sliced",
    "0.5 green bell pepper, sliced",
    "salt to taste",
    "4 flour tortillas",
    "0.5 pound cooked steak, cut into 1/4-inch thick pieces",
    "1 cup shredded Mexican cheese blend"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PfiP0ydBM1bwKDDO18Tt9IvuEIo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234481-fajita-quesadillas-VAT-step-01-178c4c7abc234074968ef91474c432ac.jpg"
      ],
      "image": "assets/images/234487/step_01.webp"
    },
    {
      "text": "Heat 2 teaspoons oil in a 10-inch skillet over medium heat. Add onion and bell pepper; cook and stir until softened, 5 to 10 minutes. Season with salt and transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I26sC93P5FHPT7tZzFAGuaBev-Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234481-fajita-quesadillas-VAT-step-02-198bb07de63c49b7996d6566e83a267f.jpg"
      ],
      "image": "assets/images/234487/step_02.webp"
    },
    {
      "text": "Brush 1 side of each tortilla with remaining oil. Place 1 tortilla, oil-side down, in the same skillet; sprinkle with 1/2 the steak, 1/2 the onion mixture, and 1/2 the Mexican cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/deWSMKyz_sxCahXBmyoxKc9Orkk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234481-fajita-quesadillas-VAT-step-03-e1c498e0213048cf93c7282ae6cbd2e3.jpg"
      ],
      "image": "assets/images/234487/step_03.webp"
    },
    {
      "text": "Place a second tortilla, oil-side up, onto cheese layer, pressing down with a spatula to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GcAmYQDlbpK1boVweVZhyOJuPI8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234481-fajita-quesadillas-VAT-step-04-83927b30d0e84b8bb668cc89577675bc.jpg"
      ],
      "image": "assets/images/234487/step_04.webp"
    },
    {
      "text": "Cook quesadilla over medium heat until cheese melts and tortillas are browned, 3 to 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kVkqL9uSXbnFRMgtffMJx-VWzeg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234481-fajita-quesadillas-VAT-step-05-e5122a51dd2949998ea97046a989777a.jpg"
      ],
      "image": "assets/images/234487/step_05.webp"
    },
    {
      "text": "Remove quesadilla from skillet and cut into wedges. Repeat with remaining ingredients for second quesadilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JdwU8Z7R6Pzq0WMC7uCTVUwEVeQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234481-fajita-quesadillas-VAT-step-06-4e4093477bd84f36ab61203208032755.jpg"
