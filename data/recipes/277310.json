  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 pound ground beef",
    "1 (14 ounce) package classic coleslaw mix",
    "1 large onion, chopped",
    "2 (14 ounce) cans beef broth",
    "1 (28 ounce) can crushed tomatoes in puree",
    "1 cup water",
    "0.5 cup light brown sugar",
    "1 tablespoon fresh lemon juice",
    "1 teaspoon salt",
    "0.33333334326744 cup long-grain rice"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Add coleslaw mix and onion; cook for 4 minutes. Add broth, tomatoes, water, brown sugar, lemon juice, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring mixture to a boil, add rice, and reduce heat to medium-low. Cover and let simmer until rice is tender, about 45 minutes.",
      "section": null,
