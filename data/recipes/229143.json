  "ingredients": [
    "5 quarts popped popcorn",
    "2 cups unsalted cashews",
    "2 cups packed brown sugar",
    "1 cup unsalted butter",
    "0.5 cup light corn syrup",
    "1 teaspoon salt",
    "0.25 teaspoon cream of tartar",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 200 degrees F (95 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine popcorn and cashews in a large roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, butter, corn syrup, salt, and cream of tartar in a large saucepan; bring to a boil, stirring constantly, until a candy thermometer inserted into middle of syrup, not touching bottom of saucepan, reads 260 degrees F (127 degrees C), 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove syrup from heat; stir in baking soda. Pour over popcorn and cashews; stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring every 20 minutes, until sugar mixture has baked and caramelized onto popcorn and cashews, about 1 hour. Spread cashew caramel corn onto a parchment paper-lined baking sheet to cool. Form into balls while still warm, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
