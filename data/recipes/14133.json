  "ingredients": [
    "2 cups water",
    "5 small potatoes, peeled and halved",
    "6 cups green onions, cut into 3 inch lengths",
    "1.5 pounds fresh green beans, cut into 1-inch lengths",
    "12 baby carrots",
    "2 tablespoons butter",
    "1 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "2 cups fresh shelled green peas",
    "2 cups half-and-half",
    "3 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a large pot. Add potatoes. Reduce heat; simmer until potatoes are tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onions, green beans, carrots, butter, salt, and black pepper to the pot; simmer until tender, then add peas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine half-and-half and flour in a medium bowl until smooth; stir into simmering vegetables. Cook, stirring constantly, until soup is slightly thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
