  "ingredients": [
    "1 pound skinless, boneless chicken breast halves, cut into bite size pieces",
    "1 cup lemonade",
    "2 tablespoons olive oil",
    "1 tablespoon lime juice",
    "1.5 teaspoons Worcestershire sauce",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "1 bay leaf",
    "1 (12 ounce) package corn tortillas",
    "2 large tomatoes, chopped",
    "1 head lettuce, shredded",
    "1 (8 ounce) package shredded sharp Cheddar cheese",
    "1 (8 ounce) jar salsa",
    "1 (8 ounce) container sour cream"
  ],
  "steps": [
    {
      "text": "Combine chicken, lemonade, olive oil, lime juice, and Worcestershire sauce in a large skillet over medium heat. Stir in garlic powder, onion powder, and bay leaf. Simmer until chicken is tender and juices run clear, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, warm the tortillas in the oven or microwave until soft. When chicken is fully cooked, transfer to serving bowl. Place chopped tomatoes, lettuce, cheese, salsa, and sour cream in serving dishes. Each person can create their own wrap, using their preferred ingredients.",
      "section": null,
      "name": null,
      "url": null,
