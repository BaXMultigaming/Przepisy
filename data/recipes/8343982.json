  "ingredients": [
    "1.5 cups strawberries, halved",
    "1 cup chopped rhubarb",
    "1 cup water",
    "1 cup white sugar",
    "2 tablespoons cornstarch",
    "2 tablespoons water"
  ],
  "steps": [
    {
      "text": "Combine strawberries and rhubarb in a blender; blend on low speed until smooth, 20 to 30 seconds. Strain through a mesh sieve placed over a bowl; discard solids and reserve juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup water and sugar in a saucepan over medium-high heat; bring to a boil, whisking constantly. Stir in reserved strawberry-rhubarb juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cornstarch and 2 tablespoons water together in a small bowl until smooth; add to juice mixture and cook, whisking constantly, until thickened, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
