  "ingredients": [
    "cooking spray",
    "3 cups shredded mozzarella cheese, divided",
    "0.5 (8 ounce) package cream cheese, softened",
    "4 large eggs",
    "0.33333334326744 cup heavy whipping cream",
    "0.25 cup grated Parmesan cheese",
    "0.5 teaspoon Italian seasoning",
    "0.25 teaspoon garlic powder",
    "0.5 cup marinara sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a pie dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press 2 cups mozzarella cheese into the bottom and sides of the prepared pie dish for the crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and eggs with an electric mixer until smooth. Stir in cream, Parmesan, Italian seasoning, and garlic powder. Pour into the pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and top with marinara sauce and remaining 1 cup mozzarella. Bake until bubbly, 10 to 12 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let sit for 10 minutes before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
