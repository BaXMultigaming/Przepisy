  "ingredients": [
    "1 cup milk",
    "0.25 cup all-purpose flour",
    "0.5 cup shortening",
    "0.5 cup butter",
    "1 cup white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "In a small saucepan, combine the milk and flour. Cook over medium high heat until boiling. Remove from heat and set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When the milk mixture is cool, add the butter, shortening, sugar and vanilla. Beat with an electric mixer for 10 to 12 minutes, scraping the bottom of the bowl occasionally. Keep frosted cakes refrigerated until 1/2 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
