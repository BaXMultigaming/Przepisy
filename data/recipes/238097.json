  "ingredients": [
    "1 head cabbage",
    "2 tablespoons light olive oil",
    "2 tablespoons minced garlic",
    "0.5 teaspoon salt, or to taste",
    "0.5 teaspoon ground black pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lRkLOrnoy4OAvH4tOkogyrTgO-s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-238097-cabbage-steaks-DDMFS-4x3-step-01-e4e1d2d0d4714adbba31038b79349326.jpg"
      ],
      "image": "assets/images/238097/step_01.webp"
    },
    {
      "text": "Cut the bottom off of the cabbage and set it so the flat end is on the cutting board; cut into 1-inch thick slices. Arrange slices in a single layer in a large sheet pan or casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z_WA42gb2-uqNqPZRkS35lxVJOs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-238097-cabbage-steaks-DDMFS-4x3-step-02-8a39b0e09fa1461a92362c2b868a6711.jpg"
      ],
      "image": "assets/images/238097/step_02.webp"
    },
    {
      "text": "Drizzle oil over cabbage slices and sprinkle with garlic. Season cabbage with salt and pepper. Cover the pan or dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zQF2b7u1SPDSu40u1X12liaTXcg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-238097-cabbage-steaks-DDMFS-4x3-step-03-62014e8652454103a97e5325f189e4e4.jpg"
      ],
      "image": "assets/images/238097/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until cabbage core is easily pierced with a fork, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uquXx4xqxID2Bsv0UA9uSG9kdyo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-238097-cabbage-steaks-DDMFS-4x3-step-04-d38a81b9448a4dec9b130c4c530d9c62.jpg"
