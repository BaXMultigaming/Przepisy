  "ingredients": [
    "1 cup pineapple juice",
    "0.5 cup packed brown sugar",
    "0.33333334326744 cup light soy sauce",
    "2 pounds chicken breast tenderloins or strips",
    "skewers"
  ],
  "steps": [
    {
      "text": "In a small saucepan over medium heat, mix pineapple juice, brown sugar, and soy sauce. Remove from heat just before the mixture comes to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken tenders in a medium bowl. Cover with the pineapple marinade, and refrigerate for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat grill for medium heat. Thread chicken lengthwise onto wooden skewers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil the grill grate. Grill chicken tenders 5 minutes per side, or until juices run clear. They cook quickly, so watch them closely.",
      "section": null,
      "name": null,
      "url": null,
