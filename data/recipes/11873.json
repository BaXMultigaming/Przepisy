  "ingredients": [
    "19 ounces cheese tortellini",
    "0.5 cup julienned red bell pepper",
    "3 cloves garlic, minced",
    "0.5 cup butter",
    "2 cups heavy whipping cream",
    "0.25 cup ground walnuts",
    "2 teaspoons dried basil",
    "1 tablespoon thinly sliced green onion"
  ],
  "steps": [
    {
      "text": "Prepare tortellini according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in a skillet, saute red pepper and garlic in butter or margarine until pepper is crisp and tender. Stir in cream and cook for 8 to 10 minutes or until slightly thickened. Add walnuts, basil and onion and heat through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain tortellini, add to sauce and toss to coat. Serve with your favorite garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
