  "ingredients": [
    "1 cup brown sugar",
    "1 cup rolled oats",
    "1 cup all-purpose flour",
    "0.5 cup butter, melted",
    "3 cups apples - peeled, cored and chopped",
    "0.5 cup white sugar",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
