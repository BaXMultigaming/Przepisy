  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup sour cream",
    "0.25 cup heavy cream",
    "1 tablespoon lemon pepper",
    "1 teaspoon dried dill weed",
    "8 ounces flaked smoked salmon",
    "0.25 cup chopped green onions"
  ],
  "steps": [
    {
      "text": "Combine cream cheese, sour cream, heavy cream, lemon pepper, and dill in a bowl until smooth. Fold in smoked salmon and green onions until evenly dispersed. Refrigerate before serving for 1 hour.",
