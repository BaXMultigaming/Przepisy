  "ingredients": [
    "3 sweet potatoes",
    "0.5 cup crushed pineapple with juice",
    "0.25 cup packed light brown sugar",
    "3 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place whole sweet potatoes in a large pot and cover with water; boil until soft. Transfer to a cutting board; when cool enough to handle, remove skins. Cut into bite-sized pieces; transfer to prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add crushed pineapple, brown sugar, and butter to baking dish; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until casserole mushy with no excess water in dish, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
