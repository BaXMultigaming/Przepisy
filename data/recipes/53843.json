  "ingredients": [
    "3 tablespoons butter",
    "0.25 cup shallots, minced",
    "1 pinch sugar",
    "2 cups frozen corn kernels",
    "2 tablespoons water",
    "0.5 cup whipping cream",
    "1 pinch ground nutmeg",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Add shallots and sugar, and saute for 2 to 3 minutes. Stir in corn and water, and cook until tender, about 5 minutes. Gradually stir in cream, and cook until cream is reduced and sauce thickens, about 8 minutes. Season with nutmeg, salt, and pepper.",
