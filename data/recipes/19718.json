  "ingredients": [
    "6 eggs",
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "2 cups milk",
    "0.125 teaspoon ground white pepper, if desired",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Hjyf8b36zi-GSxT-F-Y1cpWxgq0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19718-creamed-eggs-DDMFS-step01-8d1f624f3ca8453ea7f4d9a97fa2566a.jpg"
      ],
      "image": "assets/images/19718/step_01.webp"
    },
    {
      "text": "Place eggs in a saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove from hot water, cool, peel and chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dqZvmRnQKrx5EgV8WJhs06jkSBM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19718-creamed-eggs-DDMFS-step02-27648a5cfb284d22b6b8ee7025fa4e1f.jpg"
      ],
      "image": "assets/images/19718/step_02.webp"
    },
    {
      "text": "Melt butter in a saucepan over medium heat; stir in flour until smooth. Gradually mix in milk so that no lumps form and stir constantly until mixture comes to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FKJSQn3j5Hdi7-ICvPscAhkEeX4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19718-creamed-eggs-DDMFS-step03-5b0d8c7f16404482b1722f74c1555323.jpg"
      ],
      "image": "assets/images/19718/step_03.webp"
    },
    {
      "text": "Stir white pepper, salt, black pepper, and chopped eggs into the sauce; stir until eggs are heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i13bUYWPUlG8YmlKQbAtiF5kNRk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19718-creamed-eggs-DDMFS-step04-900f5114a1e44449879424a172ff7f9f.jpg"
      ],
      "image": "assets/images/19718/step_04.webp"
    }
