  "ingredients": [
    "cooking spray",
    "20 frozen white dinner rolls",
    "1 (3.5 ounce) package cook and serve butterscotch pudding mix",
    "0.5 cup butter, melted",
    "0.5 cup brown sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Spray a fluted tube pan, such as Bundt, with cooking spray. Place frozen rolls in the pan. Sprinkle with pudding mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine melted butter, brown sugar, and cinnamon in a small bowl. Pour over the rolls. Cover the pan with a tea towel and let rise overnight, about 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place the fluted tube pan on a baking sheet as mixture will boil over in the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the buns are golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
