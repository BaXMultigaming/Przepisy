  "ingredients": [
    "0.5 cup mayonnaise",
    "2 teaspoons Sriracha sauce",
    "1 teaspoon ketchup",
    "1 (12 ounce) container fully cooked luncheon meat (such as SPAM®), sliced into fries"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together mayonnaise, Sriracha, and ketchup in a small bowl. Set dipping sauce aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place luncheon meat fries into the air fryer basket without overcrowding. Work in batches if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 6 minutes. Flip fries using tongs and continue cooking to desired crispness, about 4 minutes more. Transfer to a paper towel-lined plate to remove excess oil. Serve with dipping sauce.",
