  "ingredients": [
    "1 cup white sugar",
    "0.5 cup shortening",
    "0.5 cup milk",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 very ripe banana, mashed",
    "0.5 cup chopped walnuts",
    "1 teaspoon lemon juice",
    "2 cups confectioners' sugar",
    "0.5 ripe banana",
    "2 tablespoons butter, melted",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "0.25 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and shortening together in a large bowl until smooth. Stir in milk and 1 teaspoon vanilla. Whisk flour, baking soda, and ½ teaspoon salt together in a bowl; stir into sugar mixture. Stir in 1 banana, walnuts, and 1 teaspoon lemon juice. Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes. Cool bars in the pan on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat confectioners' sugar, ½ banana, butter, 1 teaspoon vanilla, ½ teaspoon salt, and ¼ teaspoon lemon juice in a bowl with an electric mixer until smooth; spread over cooled bars, then cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
