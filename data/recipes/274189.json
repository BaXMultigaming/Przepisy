  "ingredients": [
    "4 ripe bananas, peeled and frozen",
    "0.25 cup cocoa powder",
    "3 tablespoons powdered sugar",
    "1 teaspoon vanilla extract",
    "1 teaspoon instant coffee granules"
  ],
  "steps": [
    {
      "text": "Combine bananas, cocoa powder, powdered sugar, vanilla extract, and instant coffee in a powerful blender such as a Vitamix®. Using the tamper, blend until all ingredients are incorporated. Serve immediately or freeze in a freezer-safe container for 3 hours for a firmer texture.",
