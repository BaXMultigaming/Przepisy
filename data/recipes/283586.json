  "ingredients": [
    "1 (16 ounce) package spaghetti",
    "0.25 cup sesame seeds",
    "0.25 cup tamari",
    "0.25 cup sesame oil",
    "2.5 tablespoons balsamic vinegar",
    "2 tablespoons sucanat",
    "0.25 teaspoon chili paste",
    "0.25 cup chopped green onions"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the pasta is cooking, heat sesame seeds in a dry skillet over medium heat until golden brown and fragrant, stirring occasionally, 3 to 5 minutes. Remove from the heat and immediately transfer to a plate to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk tamari, sesame oil, balsamic vinegar, sucanat, and chili paste together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta and transfer to a large bowl. Add dressing, sesame seeds, and green onions. Refrigerate for at least 3 hours or overnight before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
