  "ingredients": [
    "1.25 gallons apple cider vinegar",
    "1 (28 ounce) bottle ketchup",
    "5.5 ounces chili pepper flakes",
    "4 ounces cayenne pepper",
    "3 ounces ground paprika",
    "2 ounces ground black pepper"
  ],
  "steps": [
