  "ingredients": [
    "1 cup sugar",
    "1 cup water",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 tablespoon vanilla extract",
    "2 pints strawberries, hulled and sliced"
  ],
  "steps": [
    {
      "text": "In a saucepan, stir together the sugar and water. Bring to a boil, and cook for about 10 minutes, or until it becomes syrupy. Mix in the nutmeg and cinnamon, and remove from the heat. Stir in the vanilla. Allow to cool for a few minutes, then pour over sliced strawberries.",
