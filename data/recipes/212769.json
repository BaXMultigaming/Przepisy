  "ingredients": [
    "1.5 cups all-purpose flour",
    "1.25 teaspoons baking soda",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 tablespoon butter, softened",
    "1 cup packed brown sugar",
    "1 cup solid pack pumpkin puree",
    "0.5 cup whole cranberry sauce",
    "1 egg",
    "1 banana, mashed"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Sift flour, baking soda, salt, cinnamon, and nutmeg into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the butter, brown sugar, pumpkin, cranberry sauce, egg, and banana with an electric mixer in a bowl until smooth. Gradually stir in the flour mixture, mixing until just combined. Pour batter into a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
