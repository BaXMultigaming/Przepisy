  "ingredients": [
    "1.5 cups white sugar",
    "1 cup butter, softened",
    "6 egg yolks",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon lemon extract",
    "0.5 teaspoon orange extract",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon cream of tartar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease or line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a bowl with an electric mixer until light and fluffy. Beat egg yolks, vanilla extract, lemon extract, and orange extract together in another bowl. Add egg yolk mixture to butter mixture; beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, and cream of tartar together in a bowl. Stir flour mixture into butter mixture until dough is well-blended. Roll dough into walnut-size balls and place on prepared baking sheets. Press dough balls to slightly flatten.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden around the edges and set, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
