  "ingredients": [
    "3.5 cups diced zucchini",
    "0.5 cup chopped celery",
    "1 cup diced carrots",
    "0.5 cup diced onion",
    "0.5 cup margarine",
    "1 tablespoon all-purpose flour",
    "1.75 cups milk",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1.25 cups water",
    "2 cubes chicken bouillon",
    "0.5 cup dry white wine",
    "0.5 cup sour cream"
  ],
  "steps": [
    {
      "text": "In a large stock pot saute zucchini, celery, carrots and onion in margarine, until done (approximately 20 minutes).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small mixing bowl combine flour and milk. Mix until smooth and then add to stock pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook soup until thickened and then puree in a blender or food processor until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour pureed soup back into stock pot and add cream of mushroom soup, water, bouillon cubes and sour cream. If desired also add white wine. Simmer until heated through and then serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
