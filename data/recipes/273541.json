  "ingredients": [
    "2 small bananas",
    "1 medium avocado, pitted and peeled",
    "2 large eggs",
    "0.5 cup milk",
    "2 cups whole wheat flour",
    "0.5 cup light brown sugar",
    "0.25 cup white sugar",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon salt",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together bananas and avocado in a mixing bowl using an electric mixer. Pour in eggs and milk; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk whole wheat flour, brown sugar, white sugar, baking soda, cinnamon, and salt together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour flour mixture into banana mixture slowly and mix until incorporated. Add walnuts and mix for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
