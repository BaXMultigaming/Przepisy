  "ingredients": [
    "0.5 cup butter, softened",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 cup packed brown sugar",
    "1 teaspoon baking powder",
    "2 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "1 cup sour cream",
    "1 cup chopped salted cashews",
    "0.5 cup butter",
    "2 cups confectioners' sugar",
    "3 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Blend together 1/2 cup butter, brown sugar, egg, vanilla, and sour cream. Add in the baking powder, soda, and flour. Stir in the nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by teaspoonfuls onto buttered baking sheets. Cook at 375 degrees F (190 degrees C) for 8 to 10 minutes. Remove from oven, and cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make the Icing: Heat 1/2 cup butter or margarine in a saucepan until it is light amber colored. Remove pan from heat, and stir in confectioners' sugar and the milk. I sometimes have to use more milk to get the icing smooth and creamy. Frost cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
