  "ingredients": [
    "8 cups chicken broth",
    "3 tablespoons soy sauce",
    "2 teaspoons sesame oil",
    "2 teaspoons rice wine vinegar",
    "2 teaspoons lemon juice",
    "2 teaspoons minced garlic",
    "1.5 teaspoons chile-garlic sauce (such as Sriracha®)",
    "salt to taste",
    "8 cups water",
    "20 wontons"
  ],
  "steps": [
    {
      "text": "Combine chicken broth, soy sauce, sesame oil, rice wine vinegar, lemon juice, garlic, chile-garlic sauce, and salt in a large pot over medium heat; bring to a simmer and cook until hot, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the broth simmers, bring water to a boil in a separate pot. Cook wontons in boiling water until heated through, about 5 minutes. Remove from water with a slotted spoon and add to the soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
