  "ingredients": [
    "0.5 cup plain yogurt",
    "1 tablespoon mayonnaise",
    "0.25 teaspoon lemon juice",
    "1 teaspoon dried tarragon",
    "1 teaspoon dried dill",
    "0.75 cup shredded mozzarella cheese",
    "1 tablespoon grated Parmesan cheese, optional",
    "4 (4 ounce) salmon fillets, skin removed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Prepare a glass baking dish by spraying with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together yogurt, mayonnaise, lemon juice, tarragon, dill, mozzarella, and Parmesan in a small bowl. Place fish fillets into prepared baking dish, and spread evenly with cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until fish flakes when tested with a fork, about 15 minutes.",
