  "ingredients": [
    "1.25 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "1 pinch salt",
    "0.5 cup white sugar",
    "6 tablespoons lightly packed brown sugar",
    "0.25 cup unsalted butter, softened",
    "1 egg",
    "2 ripe bananas, mashed",
    "0.33333334326744 cup buttermilk",
    "0.5 cup chocolate chips, or to taste",
    "1 (3 ounce) package cream cheese, softened",
    "3 tablespoons butter, softened",
    "1 teaspoon vanilla extract",
    "2 cups confectioners' sugar, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, brown sugar, and 1/4 cup butter in another bowl; beat with an electric mixer until creamy. Beat in egg. Mix in mashed bananas. Add flour mixture in 3 batches, alternating with buttermilk, stirring after each addition. Fold chocolate chips into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 20 minutes. Cool cupcakes on a wire rack, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and 3 tablespoons butter in a bowl until smooth. Add vanilla extract. Beat in confectioners' sugar, 1 cup at a time, until frosting is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread frosting over cupcakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
