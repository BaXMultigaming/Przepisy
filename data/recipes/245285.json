  "ingredients": [
    "vegetable oil for frying",
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "1 teaspoon salt",
    "0.75 cup water"
  ],
  "steps": [
    {
      "text": "Heat oil in a large saucepan to 350 degrees F (175 degrees C). Oil should be at least 1-inch deep.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, and salt together in a large bowl. Add water, a little at a time, until a ball forms and the dough doesn't stick to your hands, about 5 minutes; you may not use the full amount.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Tear off plum-sized pieces of dough and flatten into 1/2-inch disks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry pieces of dough in hot oil until brown on both sides, about 3 minutes. Drain on paper towels or napkins before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
