  "ingredients": [
    "cooking spray",
    "5 bananas",
    "1 cup plain yogurt",
    "0.75 cup white sugar",
    "0.5 cup butter, at room temperature",
    "0.5 cup applesauce",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "3.5 cups whole wheat flour",
    "1 tablespoon ground cinnamon",
    "2 teaspoons baking powder",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "1 cup mini chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 2 mini muffin tins with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bananas in the bowl of a stand mixer fitted with the paddle attachment until smooth. Blend in yogurt, sugar, butter, applesauce, eggs, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix whole wheat flour, cinnamon, baking powder, baking soda, and salt together in a large bowl. Pour into banana mixture; stir until moistened. Fold chocolate chips into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop batter into the prepared muffin tins, filling each cup 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
