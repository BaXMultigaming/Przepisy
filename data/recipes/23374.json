  "ingredients": [
    "2 cups white sugar",
    "0.5 cup shortening",
    "4 eggs",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "1 cup unsweetened cocoa powder",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 cup chopped walnuts",
    "1 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Beat sugar and shortening together in a large bowl using an electric mixer until smooth; beat in eggs, one at a time, then stir in vanilla. Combine flour, cocoa powder, baking powder and salt in a large bowl; stir into shortening mixture. Stir in walnuts. Cover dough; chill for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place confectioners' sugar in a shallow bowl. Roll dough into walnut-sized balls, then roll in confectioners' sugar; place 2 inches apart on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies spread slightly and appear crackled on top, 10 to 12 minutes. Cool on baking sheets for 5 minutes, then transfer to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
