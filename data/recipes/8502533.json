  "ingredients": [
    "3 apples - peeled, cored and sliced",
    "0.25 cup water",
    "2 tablespoons brown sugar",
    "3 teaspoons pure maple syrup",
    "2 teaspoons ground cinnamon",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Pour water into a large skillet. Arrange apple slices in the skillet. Add brown sugar, maple syrup, cinnamon, and vanilla extract to the skillet; stir to combine.",
