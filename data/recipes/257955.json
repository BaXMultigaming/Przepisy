  "ingredients": [
    "5 habanero peppers",
    "1 tablespoon olive oil",
    "1 onion, chopped",
    "2 cloves garlic, chopped",
    "2 tablespoons lime juice",
    "2 tablespoons brown sugar",
    "2 tablespoons apple cider vinegar",
    "1 tablespoon tequila",
    "2 teaspoons salt",
    "2 teaspoons mustard powder",
    "1 teaspoon ground allspice"
  ],
  "steps": [
    {
      "text": "Wear gloves to remove stems and seeds from habanero peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium heat. Cook and stir onion and garlic in the hot skillet until onion is translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onion mixture, habanero peppers, lime juice, brown sugar, apple cider vinegar, tequila, salt, mustard powder, and allspice in a blender. Purée until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
