  "ingredients": [
    "0.5 cup white sugar",
    "2 large eggs",
    "5 tablespoons unsalted butter, melted",
    "0.75 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 lemon, juiced and zested",
    "0.25 teaspoon vanilla extract",
    "0.33333334326744 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Blend sugar and eggs in a large bowl. Add melted butter and blend well. Blend in flour, baking powder, lemon juice, lemon zest, and vanilla on low speed. Cover the bowl with a dish towel and let sit at room temperature for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Butter and flour madeleine molds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk batter and spoon into the prepared molds, 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Remove madeleines from the molds to a wire rack to cool completely. Dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
