  "ingredients": [
    "0.25 cup white sugar",
    "0.25 cup all-purpose flour",
    "2 tablespoons unsweetened cocoa powder",
    "1 teaspoon ground cinnamon, optional",
    "1 pinch salt",
    "3 tablespoons milk",
    "2 tablespoons unsalted butter, melted",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Whisk together sugar, flour, cocoa powder, cinnamon, and salt in a microwave-safe mug.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add milk, melted butter, and vanilla and mix well with a spatula, making sure the dry ingredients at the bottom get incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on high for 1 minute. Brownie will still be moist in the middle. If brownie appears too fudgy, microwave for another 30 seconds until desired consistency is reached. Do not microwave for more than 2 minutes total. The longer you cook it, the more cake-like the brownie becomes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool for 5 minutes before eating, if you can wait that long!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
