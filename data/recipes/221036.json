  "ingredients": [
    "0.5 pound cooked ham, cut into chunks",
    "0.25 medium onion, sliced",
    "3 tablespoons low-fat creamy salad dressing (such as Miracle Whip Light®)",
    "2 teaspoons honey",
    "1 teaspoon prepared mustard",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon dry mustard powder",
    "0.5 teaspoon paprika",
    "0.125 teaspoon salt",
    "0.125 teaspoon ground white pepper",
    "1 dash hot pepper sauce (such as Tabasco®), or to taste",
    "12 slices bread"
  ],
  "steps": [
    {
      "text": "Process ham and onion in a food processor until very finely chopped.",
