  "ingredients": [
    "1 tablespoon olive oil",
    "2 pounds boneless lamb shoulder, cut into 1 1/2 inch pieces",
    "0.5 teaspoon salt, or to taste",
    "freshly ground black pepper to taste",
    "1 large onion, sliced",
    "2 carrots, peeled and cut into large chunks",
    "1 parsnip, peeled and cut into large chunks",
    "4 cups water, or as needed",
    "3 large potatoes, peeled and quartered",
    "1 tablespoon chopped fresh rosemary",
    "1 cup coarsely chopped leeks",
    "1 tablespoon chopped fresh parsley for garnish"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HGuuNHNwDV_m_ExNQIf-XNNIxWA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-100292-irish-stew-VAT-4x3-step-01-aef641a9371445a3bb01edb8cc09b4ba.jpg"
      ],
      "image": "assets/images/100292/step_01.webp"
    },
    {
      "text": "Heat oil in a large stockpot or Dutch oven over medium heat. Add lamb pieces and cook, stirring gently, until evenly browned. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wB-Q_JZqeAX3ZFbcvIoJyD286L8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-100292-irish-stew-VAT-4x3-step-02-02e173dada91419ba0b87965b3834fa5.jpg"
      ],
      "image": "assets/images/100292/step_02.webp"
    },
    {
      "text": "Stir in onion and cook for a few minutes. Stir in water and add carrots and parsnips (if using). Cover and bring to a boil; reduce heat to low and simmer until lamb is tender, about 45 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kIvX1t9j-DkSYnZUS2YcBe_J2IY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-100292-irish-stew-VAT-4x3-step-03-d60d4a6969684cf4ab1c64b922da0da7.jpg"
      ],
      "image": "assets/images/100292/step_03.webp"
    },
    {
      "text": "Stir in potatoes, and simmer for 15 to 20 minutes, before adding leeks and rosemary. Continue to simmer uncovered, until potatoes are tender but still whole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rjNN75BCUpSHdloQSkpzAZDS4hc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-100292-irish-stew-VAT-4x3-step-04-d7672f39eaa6427aa9b7ee4c23482f7b.jpg"
      ],
      "image": "assets/images/100292/step_04.webp"
    },
    {
      "text": "Serve piping hot in bowls garnished with fresh parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SC0j8FqKIr53frfcRP6e25H6jqs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-100292-irish-stew-VAT-4x3-step-05-72bbacd0370246a3bdc5c8eb7a83a872.jpg"
      ],
      "image": "assets/images/100292/step_05.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
