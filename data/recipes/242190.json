  "ingredients": [
    "2 pounds carrots, sliced",
    "1 onion, chopped",
    "1 green bell pepper, chopped",
    "1 (10.75 ounce) can condensed tomato soup",
    "1 cup white sugar",
    "0.75 cup white vinegar",
    "0.5 cup vegetable oil",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon dry mustard",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring a pot of lightly salted water to a boil. Cook carrots in the boiling water until soft yet firm to the bite, about 10 minutes; drain. Transfer carrots to a large container with a lid; add onion and bell pepper. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomato soup, sugar, vinegar, oil, Worcestershire sauce, mustard, salt, and black pepper in a large saucepan over medium heat; cook and stir until sugar is completely dissolved, about 5 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour soup mixture over vegetables. Cover the container and refrigerate vegetables, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
