  "ingredients": [
    "4 large eggs",
    "0.25 cup white sugar",
    "1 teaspoon vegetable oil",
    "1.5 cups all-purpose flour, plus more for kneading",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "1 cup white sugar",
    "1 teaspoon ground cinnamon",
    "1 cup vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vSNHea58f06iQhevUxGYwXvma0s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10502-bunuelos-VAT-step-01-6aaae9af459a433190e8c749dfb36cee.jpg"
      ],
      "image": "assets/images/10502/step_01.webp"
    },
    {
      "text": "Beat eggs and 1/4 cup sugar in a large bowl until thick and lemon-colored; mix in 1 teaspoon vegetable oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qA1NKQR6HeefGuOx7FhkLt-PD7o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10502-bunuelos-VAT-step-02-5167eade70344840b52de76807078edd.jpg"
      ],
      "image": "assets/images/10502/step_02.webp"
    },
    {
      "text": "Combine 1 ½ cups of flour, baking powder, and salt; gradually add to egg mixture, mixing well until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UasydZDHLvYV7V9MADNP675b6ts=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10502-bunuelos-VAT-step-03-03a1e002e4514e97a2b14399a19274b4.jpg"
      ],
      "image": "assets/images/10502/step_03.webp"
    },
    {
      "text": "Turn dough out onto a floured board and knead thoroughly until dough is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HzydeZ8H58e0U-WIjGYqXhhMUps=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10502-bunuelos-VAT-step-04-3f7f9cc0be3b4d2faaf523b489083423.jpg"
      ],
      "image": "assets/images/10502/step_04.webp"
    },
    {
      "text": "Shape dough into 16 even-sized balls. Flatten and roll each one into a very thin circle about 5 inches in diameter. Let stand uncovered on waxed paper for about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XwYevC-uYJ9d1mQIJVEYfJIrjPo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10502-bunuelos-VAT-step-05-a27141cb8ba044e6b158935b7e5b9f67.jpg"
      ],
      "image": "assets/images/10502/step_05.webp"
    },
    {
      "text": "Meanwhile, combine 1 cup sugar and cinnamon in a small bowl until evenly mixed; set aside. Heat oil in a deep pan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_562YW52GBeykfNk1HNb0ppPVQ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10502-bunuelos-VAT-step-06-3d3638a4f29e48d7bfe011ef43e340f1.jpg"
      ],
      "image": "assets/images/10502/step_06.webp"
    },
    {
      "text": "Lower one circle of dough carefully into the hot oil; fry until golden, turning once, about 30 seconds on each side. Transfer to a paper towel-lined plate to drain; sprinkle with cinnamon-sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QwepBqacWyVeCOu-eg0_RppEuAQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10502-bunuelos-VAT-step-07-ad81061f0ad94bbcb0c56db1c65effe7.jpg"
      ],
      "image": "assets/images/10502/step_07.webp"
    },
    {
      "text": "Repeat with remaining dough. Serve or cool completely and store in airtight containers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5qQSnm58wrTOuYpCle4lSVRyXmk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-10502-bunuelos-VAT-step-08-3495c4b8f45e47008253aa6c0bb76d82.jpg"
      ],
      "image": "assets/images/10502/step_08.webp"
    }
  ],
