  "ingredients": [
    "2 cups low-sodium chicken broth",
    "0.66666668653488 cup water",
    "0.5 (16 ounce) package frozen cheese tortellini",
    "1 cup chopped watercress",
    "2 scallions, sliced",
    "3 drops hot red pepper sauce",
    "2 tablespoons grated Romano cheese",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Stir broth and water together in a pot; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir frozen tortellini into broth mixture and cook, occasionally stirring, until tortellini floats to the top and filling is hot, 6 to 8 minutes. Stir watercress and scallions into broth mixture and cook until watercress wilts, about 2 minutes. Add hot pepper sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with Romano cheese and black pepper to serve.",
      "section": null,
