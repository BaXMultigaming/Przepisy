  "ingredients": [
    "8 lasagna noodles",
    "3 tablespoons butter",
    "0.75 cup milk",
    "0.25 cup chopped pimento peppers",
    "0.5 teaspoon dried basil",
    "3 cups diced, cooked chicken meat",
    "0.5 cup grated Parmesan cheese",
    "0.5 cup chopped green bell pepper",
    "0.5 cup chopped onion",
    "2 (10.75 ounce) cans condensed cream of chicken soup",
    "1 (6 ounce) can sliced mushrooms, drained",
    "1 (16 ounce) package creamed, small curd cottage cheese",
    "2 cups shredded processed cheese"
  ],
  "steps": [
    {
      "text": "Cook noodles in a large pot of boiling water until done. Rinse, and drain. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan, saute green pepper and onions in butter or margarine over medium heat. Stir in undiluted soup, milk, mushrooms, pasteurized cheese, pimento, and basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place half of the noodles in 13 x 7 x 2 inch baking dish. Layer with half of the cream sauce, 1/2 cottage cheese, 1/2 diced chicken, and 1/2 Parmesan cheese. Repeat layers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
