  "title": "Sarah's Chicken Lasagna",
  "description": "Chicken, cottage cheese, Parmesan and a creamy, cheesy sauce layer with noodles--no tomatoes in this nontraditional lasagna.",
  "authors": [
    "Sarah Young"
  ],
