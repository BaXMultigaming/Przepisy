  "ingredients": [
    "1.25 pounds Brussels sprouts",
    "1 tablespoon vegetable oil",
    "4 ounces bacon, sliced",
    "0.33333334326744 cup cider vinegar",
    "1 lemon, juiced",
    "2 tablespoons brown sugar",
    "1 pinch cayenne pepper",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Slice each Brussels sprout in half and cut each half into strips; discard cores. Transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a skillet over medium heat. Add bacon; cook and stir until browned and crisp, 8 to 10 minutes. Stir in vinegar, lemon juice, and brown sugar; season with cayenne pepper, salt, and black pepper. Increase heat to high; boil 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour hot bacon mixture over Brussels sprouts; toss until completely coated. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
