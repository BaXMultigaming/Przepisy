        "https://www.allrecipes.com/thmb/pWD3zAugjdHn_DyNbZxF8CP6jNA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17771-Maryland-crab-cakes-i-ddmfs-Step2-0822-36e73ed518184cd1876a4f91faed47a5.jpg"
