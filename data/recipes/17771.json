  "ingredients": [
    "1 pound crabmeat",
    "2 slices white bread, crusts trimmed",
    "1 large egg, beaten",
    "1 tablespoon Old Bay Seasoning TM",
    "1 tablespoon mayonnaise",
    "1 teaspoon Dijon-style prepared mustard",
    "1 teaspoon Worcestershire sauce",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Place crab meat in a large bowl and remove any remaining shell pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break bread into small pieces and add to crab meat. Add beaten egg, Old Bay seasoning, mayonnaise, mustard, and Worcestershire sauce to the bowl. Mix by hand to avoid overworking crab meat; you want to keep the lumps of meat as much as possible. Form into 6 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_deF3LJwxlRjXBT8paNk34bUZcs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17771-Maryland-crab-cakes-i-ddmfs-Step1-0818-60e7baa2a181451f88995aa3997817cb.jpg"
      ],
      "image": "assets/images/17771/step_02.webp"
    },
    {
      "text": "Heat butter in a skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry patties in hot butter until golden brown, about 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
