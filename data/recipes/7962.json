  "ingredients": [
    "1 cup self-rising flour",
    "0.5 cup butter, cut into 1-inch chunks",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.625 cup chopped walnuts",
    "1 cup chopped raisins",
    "1.5 cups grated apple",
    "3 eggs",
    "0.25 cup pineapple juice",
    "1 tablespoon grated lime zest"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the flour in a bowl and mix well; rub in the butter until the pieces are the size of small peas. Stir in the cinnamon and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the walnuts, raisins, and apples. Add the grated lime rind, eggs, and pineapple juice. Beat well until thoroughly combined. Spoon the mixture into the prepared pan and smooth the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for about 1 1/4 hours, or until a tester inserted in the center of the cake comes out clean. Turn out and cool on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
