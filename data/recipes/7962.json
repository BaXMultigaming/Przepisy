  "title": "Apple Cake II",
  "description": "This apple cake, filled with raisins, walnuts, sweet grated apple, and spices, is sweetened with fruit juice instead of sugar.",
  "authors": [
    "Giselle Manaog"
  ],
  "date_published": "1998-08-24T08:17:09-04:00",
