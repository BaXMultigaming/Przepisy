  "ingredients": [
    "1 large turnip, peeled and cubed",
    "2 tablespoons butter",
    "1 pinch salt and ground black pepper",
    "2 large apples - peeled, cored, and diced",
    "2 tablespoons brown sugar",
    "1 pinch ground cinnamon",
    "0.25 cup all-purpose flour",
    "0.25 cup brown sugar",
    "2 tablespoons butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place turnip in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 15 to 20 minutes. Drain and transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash turnip, 2 tablespoons butter, salt, and pepper together until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss apples with 2 tablespoons brown sugar and cinnamon in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1/2 the turnips in prepared dish; top with 1/2 the apples. Repeat with remaining turnips and apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 1/4 cup brown sugar, and 2 tablespoons butter by hand in a bowl until resembles coarse crumbs; sprinkle over casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through and bubbling, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
