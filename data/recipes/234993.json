  "ingredients": [
    "2 pounds apples - peeled, cored, and cut into 1-inch chunks",
    "1 cup fresh cranberries",
    "0.25 cup white sugar",
    "3 tablespoons water",
    "0.5 teaspoon ground cinnamon",
    "1 pinch salt",
    "1.5 teaspoons lemon juice"
  ],
  "steps": [
    {
      "text": "Stir apples, cranberries, sugar, water, cinnamon, and salt together in a saucepan. Bring to a boil, reduce heat to low, and cook until apples and cranberries are tender, about 20 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir lemon juice into cranberry mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash cranberry mixture with a wooden spoon or fork to make a chunky sauce.",
