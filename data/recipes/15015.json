  "ingredients": [
    "1 (8 ounce) wheel Brie cheese",
    "3 tablespoons apricot preserves",
    "0.5 (17.5 ounce) package frozen puff pastry, thawed",
    "1 egg white"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a baking sheet or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice Brie cheese wheel in half so you have 2 circles of cheese. Spread preserves on the cut side of one circle of Brie; arrange remaining circle of Brie rind-side up on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap the entire wheel of Brie with one sheet of puff pastry; transfer onto the prepared baking sheet seam-side down. Brush puff pastry with egg white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the reheated oven until pastry in golden brown, about 30 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
