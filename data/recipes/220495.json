  "ingredients": [
    "1.5 cups heavy whipping cream",
    "2 tablespoons confectioners' sugar",
    "2 teaspoons vanilla extract",
    "1 (9 ounce) package chocolate wafer cookies",
    "0.25 cup grated chocolate"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
