  "title": "Pear Jam",
  "description": "This homemade pear jam flavored with warm spices is sure to become a favorite spread; preserve in pretty glass jars for a fabulous food gift.",
  "authors": [
    "foodinmybelly"
  ],
  "date_published": "2020-06-18T23:50:59-04:00",
