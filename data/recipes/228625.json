  "total_time": "PT40M",
  "yield": [
    "64",
    "8 (½-pint) jars"
  ],
  "categories": [
    "Jam / Jelly"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "4.5 cups mashed ripe pears",
    "0.25 cup lemon juice",
    "3 tablespoons powdered fruit pectin",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground nutmeg",
    "7.5 cups white sugar",
    "1 teaspoon butter",
    "8 half-pint canning jars with lids and rings, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G4uWj6pf-JLU0jc96TCvOjVLHDs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228625-PearJam-ddmfs-Step1-3x4-8424-75ba6ae9b12944988d0a1f129ac7deb5.jpg"
      ],
      "image": "assets/images/228625/step_01.webp"
    },
    {
      "text": "Mix pears, lemon juice, fruit pectin, cinnamon, cloves, allspice, and nutmeg in a large heavy pot; bring to a boil, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lSohelZhN7MpQ2bh95DOTUcBslM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228625-PearJam-ddmfs-Step3-3x4-8449-0ff3b89b941d460ebcf9e793966cc2a9.jpg"
      ],
      "image": "assets/images/228625/step_02.webp"
    },
    {
      "text": "Add sugar all at once, stirring, and bring back to a full rolling boil. Boil for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H915603v_udUyI1jM6X3AhRJXQM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228625-PearJam-ddmfs-Step5-3x4-8465-9486c8e6c4854ee3af3725c3a9a844d9.jpg"
      ],
      "image": "assets/images/228625/step_03.webp"
    },
    {
      "text": "Mix in butter to settle foam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gRrIzkiZ0T_qDlC1xWE0DlctS2Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228625-PearJam-ddmfs-Step5-3x4-8469-4060555c5ddf45dfa290527d32f5b60b.jpg"
      ],
      "image": "assets/images/228625/step_04.webp"
    },
    {
      "text": "Sterilize the jars and lids in boiling water for at least 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jL7LX28DtcQmnNSZ7O4o5Ep6Pkg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228625-PearJam-ddmfs-Step6-3x4-8477-7546524f3ec44a6091f3c42d8a434974.jpg"
      ],
      "image": "assets/images/228625/step_05.webp"
    },
    {
      "text": "Pack the pear jam into the hot, sterilized jars, filling the jars to within 1/4 inch of the top. Run a knife or a thin spatula around the insides of the jars after they have been filled to remove any air bubbles. Wipe the rims of the jars with a moist paper towel to remove any food residue. Top with lids, and screw-on rings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iORT7HiSj5XxvfnhPVS3Gn_U-jU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228625-PearJam-ddmfs-Step8-3x4-8484-7864af671acf4fd3b546fe6f72db3b62.jpg"
      ],
      "image": "assets/images/228625/step_06.webp"
    },
    {
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars into the boiling water using a holder. Leave a 2-inch space between the jars. Pour in more boiling water if necessary to bring the water level to at least 1 inch above the tops of the jars. Bring the water to a rolling boil, cover the pot, and process for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Eptr5vEQt_fVy_q484V_Sczbgs4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228625-PearJam-ddmfs-Step10-3x4-8489-5f166405386e4715a2ea697eea319db0.jpg"
      ],
      "image": "assets/images/228625/step_07.webp"
    },
    {
      "text": "Remove the jars from the stockpot and place onto a cloth-covered or wood surface, several inches apart, until cool. Once cool, press the top of each lid with a finger, ensuring that the seal is tight (lid does not move up or down at all). Store in a cool, dark area for up to one year.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rfmlY17HpCk4aakV5DFZDDwqx2w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228625-PearJam-ddmfs-Step11-3x4-8494-b554f7d1ee6b45069fd378e109673b44.jpg"
      ],
      "image": "assets/images/228625/step_08.webp"
    }
  ],
