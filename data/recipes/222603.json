  "ingredients": [
    "1 cup butter, softened",
    "1 cup white sugar",
    "1 cup light brown sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "0.5 cup cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup semi-sweet chocolate chips",
    "0.25 cup confectioner's sugar, for dusting"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and brown sugar with an electric mixer in a large bowl until smooth. Beat in one egg until completely incorporated; beat in last egg along with vanilla extract. Combine flour, cocoa, baking soda, and salt in a bowl. Stir flour mixture into butter mixture until just incorporated; mix in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 2-inch balls, or drop spoonfuls of dough 2 inches apart, onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until edges of cookies are firm, 10 to 12 minutes. Remove to wire racks. Dust warm cookies with confectioners' sugar, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
