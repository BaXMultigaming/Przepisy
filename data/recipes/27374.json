  "ingredients": [
    "0.66666668653488 cup warm water",
    "1 (.25 ounce) package instant yeast",
    "0.5 teaspoon salt",
    "1 teaspoon white sugar",
    "0.25 teaspoon dried oregano",
    "1.75 cups all-purpose flour",
    "6 slices bacon, chopped",
    "0.5 cup green onion, thinly sliced",
    "6 eggs, beaten",
    "salt and pepper to taste",
    "0.5 cup pizza sauce",
    "0.25 cup grated Parmesan cheese",
    "2 ounces thinly sliced salami"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour warm water into a mixing bowl. Stir in yeast, salt, sugar, and oregano. Mix in 1 cup flour, and then stir in remaining flour. Cover with plastic wrap, and set aside to rest for 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While dough is resting, prepare topping. Place bacon in a large, deep skillet. Cook over medium heat until evenly brown. Stir in green onions, and cook for 1 minute. Add eggs to the pan; cook, stirring frequently, until mixture has the consistency of scrambled eggs. Season with salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread dough out evenly onto a lightly greased pizza tray, and spread pizza sauce over dough. Top with bacon and eggs, Parmesan cheese, and salami.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 to 25 minutes, or until golden brown on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
