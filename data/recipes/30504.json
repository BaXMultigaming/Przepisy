  "ingredients": [
    "4 large baking potatoes, quartered",
    "2 tablespoons olive oil",
    "2 teaspoons freshly ground black pepper",
    "2 teaspoons garlic powder",
    "2 teaspoons dried rosemary",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill to medium-high, indirect heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes into a large pot and cover with water; bring to a boil. Cook over medium-high heat until tender, about 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer potatoes to a large bowl. Add olive oil, black pepper, garlic powder, rosemary, and salt; mix until potatoes are evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook potatoes, skin-sides down, on the preheated grill over indirect heat for about 15 minutes, leaving olive oil mixture in the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer potatoes to a serving plate; drizzle with reserved olive oil mixture.",
      "section": null,
      "name": null,
      "url": null,
