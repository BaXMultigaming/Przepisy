  "ingredients": [
    "6 pork chop cutlets",
    "1 teaspoon garlic powder",
    "1 teaspoon seasoning salt",
    "0.25 cup all-purpose flour",
    "2 large eggs, beaten",
    "2 cups dry bread crumbs",
    "0.25 cup olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season pork chops with garlic powder and seasoning salt. Dredge chops in flour; shake off excess. Dip into beaten egg. Lift up so excess egg drips back in the bowl. Press into bread crumbs to coat both sides. Place the breaded chops, unstacked, onto a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat; add pork chops and cook until well browned, about 5 minutes per side. Transfer pork chops into a 9x13-inch baking dish and cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pork chops are cooked through, 60 to 90 minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
