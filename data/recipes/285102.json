  "ingredients": [
    "1 tablespoon salted butter",
    "1 tablespoon minced fresh ginger",
    "0.75 cup water",
    "sea salt to taste",
    "0.5 cup uncooked jasmine rice",
    "ground black pepper to taste",
    "2 small lime wedges"
  ],
  "steps": [
    {
      "text": "Melt butter in a small pot over medium-high heat. Add ginger; cook and stir until fragrant, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add water and a pinch of sea salt; bring to a boil. Stir in rice, cover, and reduce heat to a gentle simmer. Cook until tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fluff rice with a fork and season with salt and pepper. Serve with lime wedges.",
