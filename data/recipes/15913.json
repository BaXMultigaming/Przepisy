  "ingredients": [
    "1 cup eggnog",
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "2 eggs, beaten",
    "2 teaspoons rum flavored extract",
    "1 teaspoon vanilla extract",
    "2.25 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease the bottom of a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend eggnog, sugar, butter, eggs, rum extract, and vanilla together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, salt, and nutmeg together in a separate bowl; add to eggnog mixture and stir just enough to moisten. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of loaf comes out clean, about 40 to 60 minutes. Let cool in the pan for 10 minutes before removing to a wire rack to cool completely. Wrap tightly in plastic wrap or foil, and store in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
