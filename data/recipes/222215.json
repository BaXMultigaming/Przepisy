  "ingredients": [
    "1 (12 ounce) package elbow macaroni",
    "4 hard-cooked eggs, chopped",
    "3 stalks celery, minced",
    "1 (6 ounce) package frozen peas, thawed",
    "2 cups low fat mayonnaise (such as Hellmann's® Low Fat)",
    "0.25 cup white sugar",
    "3 tablespoons prepared yellow mustard",
    "2 teaspoons white vinegar",
    "0.75 teaspoon celery seed",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and rinse under cold water until cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, celery, and peas in a large bowl. Whisk mayonnaise, sugar, mustard, vinegar, celery seed, and salt together in a separate bowl until sugar dissolves; pour over egg mixture. Stir in macaroni until thoroughly coated with dressing. Cover and refrigerate before serving, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
