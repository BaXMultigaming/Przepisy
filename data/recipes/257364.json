  "ingredients": [
    "1 tablespoon white sugar",
    "1 teaspoon kosher salt",
    "1 lime wedge",
    "1 jalapeno pepper, seeded and roughly chopped",
    "1.5 teaspoons white sugar",
    "0.5 cup freshly squeezed orange juice",
    "0.25 cup mezcal",
    "3 tablespoons freshly squeezed lime juice"
