  "ingredients": [
    "2 cups gluten-free pancake mix",
    "0.25 cup butter, room temperature",
    "2 tablespoons white sugar",
    "0.66666668653488 cup milk",
    "0.5 teaspoon almond extract",
    "0.25 cup raspberry jam",
    "0.66666668653488 cup confectioners' sugar",
    "2 tablespoons milk, or more as needed",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pancake mix, butter, and sugar in a bowl; stir until crumbly. Stir in 2/3 cup milk and 1/2 teaspoon almond extract until fully incorporated; the dough will be sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded tablespoonfuls onto the prepared baking sheet, spaced about 2 inches apart. Make a shallow indentation in center of each dough ball using the back of a teaspoon. Fill each center with 1 teaspoon jam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 10 to 12 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine confectioners' sugar, 3 tablespoons milk, vanilla extract, and remaining 1/4 teaspoon almond extract; mix until smooth. Drizzle glaze over Danish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
