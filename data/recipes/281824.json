  "ingredients": [
    "1 large egg",
    "1 cup all-purpose flour",
    "7 fluid ounces milk",
    "0.33333334326744 cup chocolate chips",
    "0.25 cup vegetable oil",
    "1 tablespoon white sugar",
    "2 teaspoons baking powder",
    "0.25 teaspoon vanilla extract",
    "0.125 teaspoon salt",
    "nonstick cooking spray"
  ],
  "steps": [
    {
      "text": "Beat egg in a large bowl with an electric mixer until fluffy. Add flour, milk, chocolate chips, oil, sugar, baking powder, vanilla extract, and salt; beat just until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat a Belgian waffle iron with cooking spray; preheat according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour about ¾ cup batter onto hot waffle iron; cook until golden brown. Repeat with remaining batter. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
