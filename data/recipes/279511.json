  "ingredients": [
    "nonstick cooking spray",
    "1 (5 ounce) bone-in, center-cut pork chop",
    "1 tablespoon mayonnaise",
    "0.25 cup garlic- and herb-seasoned panko bread crumbs",
    "0.5 (6 ounce) package cheddar-broccoli rice mix (such as Knorr®)",
    "0.75 cup water",
    "2 tablespoons whipping cream",
    "1 tablespoon grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Spray a 6x8-inch casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat one side of the pork chop with mayonnaise and press panko into the mayonnaise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour rice mix into the prepared casserole dish. Add water and cream; stir to combine. Place pork chop, coated-side up, into the dish and top with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, about 20 minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
