  "ingredients": [
    "1 cup boiling water",
    "1 (6 ounce) package cherry-flavored gelatin (such as Jell-O®)",
    "1 (16 ounce) can jellied cranberry sauce",
    "1 apple - peeled, cored, and diced, or more to taste",
    "0.75 cup chopped walnuts, or to taste",
    "1 (20 ounce) can crushed pineapple with juice"
  ],
  "steps": [
    {
      "text": "Stir boiling water and cherry gelatin together in a bowl until gelatin is completely dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat cranberry sauce in a saucepan over medium heat until melted; stir into gelatin mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir apples and walnuts into the cranberry sauce mixture; add pineapple with juice and mix well. Refrigerate until set, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
