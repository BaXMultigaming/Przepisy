  "ingredients": [
    "1 (12 fluid ounce) can evaporated milk",
    "1.5 cups milk",
    "1 cup white sugar",
    "0.25 cup cornstarch",
    "1 egg, beaten",
    "2 teaspoons vanilla extract",
    "1 (12 ounce) package vanilla wafers",
    "4 banana, sliced"
  ],
  "steps": [
    {
      "text": "Combine evaporated milk, milk, sugar, cornstarch, and egg in a saucepan over medium heat. Cook and stir until thick. Remove pudding from heat; add vanilla and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange a layer of wafers in a large bowl or casserole dish. Pour pudding over wafers and top with banana slices. Refrigerate until chilled, about 1 hour.",
