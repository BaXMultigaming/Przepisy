  "ingredients": [
    "1 cup vodka",
    "1 teaspoon crushed red pepper flakes",
    "2 tablespoons olive oil",
    "0.75 pound prosciutto, chopped",
    "1 large clove garlic, minced",
    "2 tablespoons chopped fresh parsley",
    "2 tablespoons chopped fresh basil",
    "salt and pepper to taste",
    "1 (28 ounce) can roma tomatoes, with juice",
    "2 (8 ounce) cans tomato sauce",
    "1 cup water",
    "1 cup heavy cream"
  ],
  "steps": [
    {
      "text": "In a small bowl, combine vodka and red pepper flakes. Set aside for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat. Add prosciutto, garlic, parsley, basil, salt, and pepper; sauté until prosciutto is evenly browned. Pour in vodka mixture and simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crush Roma tomatoes and add to sauce with canned tomato sauce and water. Simmer for 15 minutes. Stir in heavy cream and cook for 2 more minutes.",
      "section": null,
      "name": null,
      "url": null,
