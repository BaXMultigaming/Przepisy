  "ingredients": [
    "cooking spray",
    "1 cup buttermilk",
    "1 (1.25 ounce) package taco seasoning mix, divided",
    "0.125 teaspoon cayenne pepper",
    "1 cup bread crumbs",
    "1 cup grated Parmesan cheese",
    "0.25 cup all-purpose flour",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a broiler pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk buttermilk, 1 teaspoon taco seasoning, and cayenne pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix remaining taco seasoning, bread crumbs, Parmesan cheese, flour, onion powder, salt, and black pepper together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken in buttermilk mixture; press into bread crumb mixture to coat. Place chicken on the prepared broiler pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink in center and coating is crispy, 30 to 35 minutes. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
