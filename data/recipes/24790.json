  "ingredients": [
    "1 (2 to 3 pound) whole chicken, cut into pieces",
    "0.125 cup extra virgin olive oil",
    "1 cup chicken stock",
    "1 clove garlic, crushed",
    "1 teaspoon dried oregano",
    "salt and pepper to taste",
    "0.25 cup grated Romano cheese",
    "3 tablespoons balsamic vinegar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken pieces in a 9x13 inch baking dish. Pour oil and stock over chicken and sprinkle with garlic. Season with oregano, salt and pepper and top with cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for about 45 to 60 minutes, or until chicken is cooked through and no longer pink inside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour vinegar over chicken and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
