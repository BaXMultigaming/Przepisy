  "ingredients": [
    "4 eggs, separated",
    "0.33333334326744 cup lemon juice",
    "1 tablespoon butter",
    "1 teaspoon lemon zest",
    "1.5 cups white sugar",
    "0.5 cup sifted all-purpose flour",
    "0.5 teaspoon salt",
    "1.5 cups milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg yolks, lemon juice, butter, and lemon zest together in a large bowl with an electric mixer until thick and lemon colored.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uPtm02ZP4Y-yRFWXPo27dBSxk8o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7665-LemonPuddingCake-ddmfs-Step1-4x3-2467-72f81856fe40428980d53ffe79fba289.jpg"
      ],
      "image": "assets/images/7665/step_02.webp"
    },
    {
      "text": "Combine sugar, flour, and salt; add alternately with milk to lemon mixture, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4iYIj4D3UDSiBCljIIvQ0lY0jO4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7665-LemonPuddingCake-ddmfs-Step2-4x3-2470-e540efd2a361457fae16d29cc8fe5ce4.jpg"
      ],
      "image": "assets/images/7665/step_03.webp"
    },
    {
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until stiff.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7uHG4sdHjq-WxtrNv57dGk4bwxI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7665-LemonPuddingCake-ddmfs-Step3-4x3-2472-b9d4900bae9c4e2eb703d8c8cd97a288.jpg"
      ],
      "image": "assets/images/7665/step_04.webp"
    },
    {
      "text": "Gently blend egg whites into batter on low speed with an electric mixer. Pour into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FySCFGvL6fHdc5quR4XN4K-MCM8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7665-LemonPuddingCake-ddmfs-Step5-4x3-2485-66746c37274f4b29ac0a859781b9909a.jpg"
      ],
      "image": "assets/images/7665/step_05.webp"
    },
    {
      "text": "Place a pan of hot water in the preheated oven; set the baking dish into the pan; bake for 45 minutes. For best results, serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/37Me5hVBW1zfvqDsoVH3JRYNM9I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7665-Lemon-Pudding-Cake-ddmfs-4x3-2634-f0a57bcf22fb403192a8ef490c2a7696.jpg"
