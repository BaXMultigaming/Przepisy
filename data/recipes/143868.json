  "ingredients": [
    "6 large ripe peaches - peeled, pitted and sliced",
    "1 tablespoon fresh lemon juice",
    "2 (8 ounce) containers vanilla yogurt",
    "1 teaspoon lemon zest",
    "1 (10 inch) prepared angel food cake"
  ],
  "steps": [
    {
      "text": "Toss peach slices with lemon juice in a bowl; transfer 1 cup to a blender and blend until smooth. Set remaining peach slices aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir peach purée, yogurt, and lemon zest together in a bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer ½ cake cubes in bottom of a glass dish; top with ½ peach slices, ½ yogurt mixture, and remaining ½ cake cubes. Arrange remaining ½ peach slices on top, reserving 5 or 6 slices for garnish; cover with remaining ½ yogurt mixture. Arrange reserved peach slices on top. Refrigerate trifle until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
