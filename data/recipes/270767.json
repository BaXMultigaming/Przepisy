  "ingredients": [
    "2 tablespoons olive oil",
    "0.25 cup minced onion",
    "2 cubes vegetable bouillon",
    "1 teaspoon yellow curry powder",
    "0.5 teaspoon oregano",
    "2 cups pearl (Israeli) couscous",
    "2.5 cups water"
  ],
  "steps": [
    {
      "text": "Heat oil in a saucepan over medium heat. Add onion, bouillon cubes, curry powder, and oregano. Cook, breaking up bouillon cubes, until onion is soft, about 5 minutes. Add couscous and mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add water to the saucepan and bring to a boil. Cover and reduce heat to low. Simmer, stirring frequently, until couscous is soft, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
