  "ingredients": [
    "1 (8 ounce) package uncooked elbow macaroni",
    "1 pound processed cheese, cubed",
    "1 (15 ounce) can mixed vegetables, drained",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 pound kielbasa sausage, sliced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add macaroni and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine macaroni, processed cheese, mixed vegetables, mushroom soup, 1/2 of a soup can of water and sausage. Transfer to a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, covered with aluminum foil, for 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
