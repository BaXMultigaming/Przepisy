  "ingredients": [
    "1 pound ground beef",
    "1 tablespoon soy sauce",
    "0.5 clove garlic, chopped",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "1 tablespoon vegetable oil",
    "2 medium carrots, chopped",
    "0.5 medium green bell pepper, chopped",
    "0.5 sweet onion (such as Vidalia®), chopped",
    "1 cup cooked rice, or more to taste",
    "1 tablespoon butter",
    "1 large egg, beaten"
  ],
  "steps": [
    {
      "text": "Cook ground beef, soy sauce, garlic, pepper, and salt in a large skillet over medium-high heat until browned and crumbly, 5 to 7 minutes. Transfer to a plate; drain grease from the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in the same skillet over medium heat. Add carrots, bell pepper, and onion; cook until tender, 15 to 20 minutes. Add beef back to the skillet with cooked rice; stir to combine, and heat until warmed through, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Push beef and vegetable mixture to the sides of the pan; melt butter in the center. Cook and stir egg in melted butter until set, 3 to 4 minutes. Mix egg into beef and vegetable mixture until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
