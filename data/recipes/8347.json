  "ingredients": [
    "1 (18.25 ounce) package chocolate cake mix",
    "0.25 cup butter",
    "2 cups white sugar",
    "6 tablespoons unsweetened cocoa powder",
    "1 cup heavy whipping cream",
    "1 tablespoon vanilla extract",
    "0.25 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Bake a box chocolate cake as directed. While hot from the oven, poke holes over entire cake with a fork. While the cake is cooking prepare the fudge sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the fudge sauce: In a saucepan, combine butter, sugar, cocoa and cream. Stir over medium heat until a full boil starts. Cook at a full boil for 2 minutes. Stir in vanilla. Pour while hot over warm cake. Sprinkle with chopped walnuts. Serve alone or with ice-cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
