  "ingredients": [
    "1 pastry for a 9-inch pie crust",
    "1.5 cups white sugar",
    "2 eggs",
    "0.5 teaspoon salt",
    "1.5 cups sweetened flaked coconut",
    "0.5 cup milk",
    "6 tablespoons butter, softened",
    "0.25 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Press pie crust pastry into a 9-inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together sugar, eggs, and salt in a large bowl until smooth. Mix together coconut, milk, butter, and flour in a separate bowl until well combined; stir into sugar mixture. Pour mixture into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Allow to cool completely for pie to fully set up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
