  "ingredients": [
    "1 tablespoon butter",
    "1 cup quinoa",
    "2 cups chicken broth",
    "1 (14.5 ounce) can fire-roasted diced tomatoes with garlic",
    "salt and ground black pepper to taste",
    "1 pinch cayenne pepper, or to taste",
