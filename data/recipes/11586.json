  "ingredients": [
    "0.75 cup applesauce",
    "0.25 cup packed brown sugar",
    "0.25 cup white sugar",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "1 cup rolled oats",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F ( 175 degrees C ). Lightly grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir applesauce, brown sugar, and white sugar together in a bowl. Sift flour, baking powder, salt, and cinnamon into a separate bowl; stir into applesauce mixture. Add rolled oats, raisins, and chopped nuts, if desired. Stir until combined. Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 10 minutes. Allow cookies to cool slightly before removing from the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
