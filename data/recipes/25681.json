  "ingredients": [
    "1 cup lowfat evaporated milk",
    "0.25 cup all-purpose flour",
    "1.5 pounds chicken leg meat",
    "0.75 pound small fresh button mushrooms",
    "2 potatoes, peeled and cubed",
    "2 cups pearl onions",
    "2 large carrots, coarsely chopped",
    "2.25 cups frozen green peas, thawed",
    "1 cup chicken broth",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 teaspoon dried marjoram",
    "0.25 teaspoon dried rosemary",
    "0.25 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "In a small bowl stir together evaporated milk and flour until smooth. Place chicken, mushrooms, potatoes, onions, carrots and peas in slow cooker. Pour in milk mixture and broth. Season with salt, pepper, marjoram and rosemary. Cook on low 6 hours. Stir in parsley just before serving.",
