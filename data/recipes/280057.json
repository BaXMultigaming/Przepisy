  "ingredients": [
    "0.66666668653488 cup unsweetened cocoa powder",
    "0.25 teaspoon salt",
    "1 cup water",
    "0.5 cup white sugar",
    "1 teaspoon pure vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine cocoa powder and salt in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and sugar to a boil in a saucepan, stirring until sugar is dissolved. Whisk in cocoa mixture slowly until incorporated. Reduce heat to medium; simmer, stirring occasionally, until sauce thickens slightly, about 3 minutes. Remove from heat and stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sauce into a storage container and let cool at room temperature, uncovered, until thickened. Cover and store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
