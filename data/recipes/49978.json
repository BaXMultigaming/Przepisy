  "ingredients": [
    "4 Vidalia onions",
    "4 cubes beef bouillon",
    "4 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel onions and core out centers. Drop 1 beef bouillon cube into each onion core, followed by 1 tablespoon butter. Wrap each onion tightly with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until desired doneness is reached, 30 to 60 minutes. Be careful not to puncture the foil, or the juices will drip out, and onion will burn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
