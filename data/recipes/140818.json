  "ingredients": [
    "1 (12 ounce) package frozen cranberries",
    "1 (8 ounce) can crushed pineapple, drained",
    "1 cup chopped pecans",
    "1 (10 ounce) package miniature marshmallows",
    "1 cup sugar",
    "1 pint heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Put cranberries in a food processor and blend until well chopped. Transfer cranberries to a large bowl, and mix in pineapple, pecans, marshmallows and sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat cream with an electric mixer until stiff peaks form. Fold whipped cream into cranberry mixture. Chill until ready to serve. (Or, freeze for 2 hours before serving.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
