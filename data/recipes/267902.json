  "ingredients": [
    "0.75 cup water",
    "0.75 cup brown sugar",
    "0.25 cup freshly squeezed orange juice",
    "1 cinnamon stick",
    "1 teaspoon grated fresh ginger",
    "1 teaspoon grated orange zest",
    "0.125 teaspoon salt",
    "0.125 teaspoon ground cloves",
    "0.125 teaspoon ground allspice",
    "1 (12 ounce) bag fresh cranberries"
  ],
  "steps": [
    {
      "text": "Combine water, brown sugar, orange juice, cinnamon stick, ginger, orange zest, salt, cloves, and allspice in a medium saucepan; bring to a boil. Reduce heat and simmer until sugar is dissolved, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in cranberries and return to a boil over medium heat. Cook until cranberries start to burst and mixture thickens slightly, 8 to 10 minutes; sauce will thicken further upon cooling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cranberry sauce to a bowl; remove and discard cinnamon stick. Store in the refrigerator until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
