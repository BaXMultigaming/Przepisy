  "ingredients": [
    "3 cups vegetable broth",
    "2 tablespoons uncooked white rice",
    "1 bunch sorrel, stemmed and rinsed",
    "0.5 cup heavy cream",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a large saucepan, bring broth to a boil over medium-high heat. Stir in rice, reduce heat, and simmer for about 8 minutes. Stir in sorrel and return to a boil. Remove from heat and puree in batches in a blender or food processor or using an immersion blender.",
