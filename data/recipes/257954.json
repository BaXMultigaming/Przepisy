  "ingredients": [
    "2 pounds whole fish, scaled and cleaned, or more to taste",
    "1 lemon, juiced",
    "8 cups water",
    "4 green bananas, chopped",
    "1 pound pumpkin, cut into 1-inch pieces, or more to taste",
    "2 potatoes, chopped",
    "2 ears corn, cut into 1-inch pieces",
    "4 ounces carrots, cut into 1/2-inch pieces",
    "0.5 cup chopped okra",
    "4 scallions, chopped",
    "1 hot chile pepper",
    "2 cloves garlic, chopped",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "4 sprigs fresh thyme, leaves stripped"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p6DRg5eJM69A_KX84yx4iC6RZ_I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-257954-caribbean-fish-soup-DDMFS-4x3-step-01-2d1123f6bb254e78a289dc226c33dd45.jpg"
      ],
      "image": "assets/images/257954/step_01.webp"
    },
    {
      "text": "Rinse fish with lemon juice; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Cg7WI23WfMQHoO4ppQTcH_Z0zn8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-257954-caribbean-fish-soup-DDMFS-4x3-step-02-d6fcfc31019542a9952d651a42530f07.jpg"
      ],
      "image": "assets/images/257954/step_02.webp"
    },
    {
      "text": "Bring water to a boil in a large pot. Add fish; reduce to a simmer and cook until soft, about 30 minutes. Use a slotted spoon to remove fish to a plate, reserving broth in the pot. Let fish cool; remove bones, keeping large pieces of flesh intact.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5kRlJKqnRuZTR6hUSfk4VM9-uNM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-257954-caribbean-fish-soup-DDMFS-4x3-step-04-29aa740815944594bddbe2403f5a3f8e.jpg"
      ],
      "image": "assets/images/257954/step_03.webp"
    },
    {
      "text": "Bring broth to a boil. Add green bananas, pumpkin, potatoes, corn, carrots, okra, scallions, chile pepper, garlic, salt, black pepper, and thyme. Return to a boil. Reduce heat to low and simmer until potatoes are almost tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AwOEecFoSfQL42jLDwFdLz-QwZw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-257954-caribbean-fish-soup-DDMFS-4x3-step-05-ef15bb6db3fe4932824cab7dfec66504.jpg"
      ],
      "image": "assets/images/257954/step_04.webp"
    },
    {
      "text": "Stir in fish pieces and simmer until flavors combine, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xK2AM7DdBAlRfpG0xn_7axP-h2I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-257954-caribbean-fish-soup-DDMFS-4x3-step-06-1b3a29b027034198ab62be294a22a3cb.jpg"
      ],
      "image": "assets/images/257954/step_05.webp"
    },
    {
      "text": "Remove soup from heat and let stand before serving, about 30 minutes. Discard chile pepper.",
      "section": null,
      "name": null,
      "url": null,
