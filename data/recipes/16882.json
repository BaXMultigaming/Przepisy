  "title": "Chili Casserole",
  "description": "Red taco sauce is used in this casserole of browned ground beef combined with celery, corn, and tomatoes. It is baked with egg noodles and topped with cheese.",
  "authors": [
    "Sara"
  ],
  "date_published": "2000-01-11T19:05:40-05:00",
