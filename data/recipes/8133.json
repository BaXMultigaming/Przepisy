  "ingredients": [
    "4 tablespoons all-purpose flour",
    "1 cup milk",
    "0.5 cup shortening",
    "0.5 cup margarine",
    "1 cup white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "In a small saucepan, mix milk into flour gradually to prevent lumps. Cook, stirring constantly over low heat until thick. Cover with waxed paper and cool completely. To speed up the cooling process, set the pot in a bowl of ice water and stir until cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In mixer bowl, combine shortening and margarine, and beat 4 minutes. Add sugar; beat 4 minutes. Add cooled paste and vanilla; beat well.",
      "section": null,
