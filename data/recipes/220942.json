  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "cooking spray",
    "1 (18.25 ounce) package yellow cake mix",
    "3 eggs",
    "1.25 cups water",
    "0.33333334326744 cup vegetable oil",
    "3 eggs",
    "2 tablespoons cornstarch",
    "6 tablespoons white sugar",
    "1 cup heavy whipping cream",
    "1 cup whole milk",
    "0.5 tablespoon butter",
    "1 teaspoon vanilla extract, or to taste",
    "1 pinch salt",
    "4 ounces dark chocolate, chopped",
    "1 teaspoon butter",
    "0.5 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray two 8-inch cake pans with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir yellow cake mix, 3 eggs, water, and vegetable oil in a bowl until moistened. Beat with an electric mixer on medium speed for 2 minutes, scraping bowl occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MQpbbKkpDxQk_P-Zez6WrHH6rfw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220942-chef-johns-boston-cream-pie-VAT-step-02-54a1ec188130400ba7b25a3e8aafa46f.jpg"
      ],
      "image": "assets/images/220942/step_02.webp"
    },
    {
      "text": "Divide cake batter between the two prepared cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sJpz_noy2JRn1vn8QU8XpNhXLik=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220942-chef-johns-boston-cream-pie-VAT-step-03-9dcbcad6841b4e0791596c5cee554727.jpg"
      ],
      "image": "assets/images/220942/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until cakes have risen and are lightly golden brown, 33 to 38 minutes. Check for doneness after 25 minutes. A toothpick inserted into the center of the cakes should come out clean. Allow cakes to cool for about 10 minutes before removing from the pans. Cool cakes completely, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1FLKxfw0Ff-L3DPdX18jON6eefo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220942-chef-johns-boston-cream-pie-VAT-step-04-95f79fadacf241a2a732be31aebcd92a.jpg"
      ],
      "image": "assets/images/220942/step_04.webp"
    },
    {
      "text": "Whisk 3 eggs, cornstarch, and sugar in a large bowl until well mixed and lemon colored, 2 to 3 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZLT-NuER5FzebF1SqGS9qX4XPzo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220942-chef-johns-boston-cream-pie-VAT-step-05-d18e0c7f0eeb40f8a084cc135b482b98.jpg"
      ],
      "image": "assets/images/220942/step_05.webp"
    },
    {
      "text": "Heat 1 cup heavy whipping cream, whole milk, and 1/2 tablespoon butter in a large saucepan over medium heat until it just begins to boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PZhDv7x3VJM4arx7bh9wz9JZ7Q8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220942-chef-johns-boston-cream-pie-VAT-step-06-f3b607c305c1417e91248163bd46b2b9.jpg"
      ],
      "image": "assets/images/220942/step_06.webp"
    },
    {
      "text": "Reduce heat to low; pour egg mixture into cream mixture and whisk until thick, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bKGDs44n3p-ih0PpaYvg_SCLa2s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220942-chef-johns-boston-cream-pie-VAT-step-07-f70d924c42c64e4c8ce53a3f6c1f95b8.jpg"
      ],
      "image": "assets/images/220942/step_07.webp"
    },
    {
      "text": "Pour egg and cream mixture through a fine mesh strainer into a large bowl; discard any chunks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/boKTbB7X3RGEe7Kbuh7U_DIwHiU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220942-chef-johns-boston-cream-pie-VAT-step-08-5449b67104514216bb13313b934fdce3.jpg"
      ],
      "image": "assets/images/220942/step_08.webp"
    },
    {
      "text": "Whisk vanilla and salt into the egg and cream mixture until combined. Cover with a layer of plastic wrap pressed against the surface. Chill in the refrigerator to form a pastry cream texture, 3 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iV5BNk-ZbIHYb3yNpOnGHrLjdvU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220942-chef-johns-boston-cream-pie-VAT-step-09-32846cecf817407eb5ab36ff55808f97.jpg"
      ],
      "image": "assets/images/220942/step_09.webp"
    },
    {
      "text": "Place chocolate in a large bowl. Heat 1 teaspoon butter and 1/2 cup heavy whipping cream in a saucepan over medium heat until butter is melted. Pour cream mixture over chocolate and whisk until smooth. Set aside until cooled, but still pourable, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s7Us1MLreFeorP-5TkdK16hlrqs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220942-chef-johns-boston-cream-pie-VAT-step-10-772795bee35f4d7eb6660bb887254998.jpg"
      ],
      "image": "assets/images/220942/step_10.webp"
    },
    {
      "text": "Place one cake layer on a plate, flat side up. Spread pastry cream to within 1-inch of the cake edge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oPrKzooSo4oQZSzGkl0Ki6eniRk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220942-chef-johns-boston-cream-pie-VAT-step-11-bb94731d60af4c44b0bceaf35136e39b.jpg"
      ],
      "image": "assets/images/220942/step_11.webp"
    },
    {
      "text": "Place second cake layer on top, rounded side up. Press gently to push pastry cream to the edge. Pour chocolate mixture over the top of the cake and spread so it drips over the edge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0oqOlkal4vW5cb78DUd-Tpiizi0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220942-chef-johns-boston-cream-pie-VAT-step-12-0c43d1d3359844758e71da1108345f21.jpg"
      ],
      "image": "assets/images/220942/step_12.webp"
    },
    {
      "text": "Slice and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B2qQWOh0VT3Ph_ArhdHNUa3sDy8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220942-chef-johns-boston-cream-pie-VAT-Beauty-4x3-4a4690bdf5f54963a4342a777c76e751.jpg"
      ],
      "image": "assets/images/220942/step_13.webp"
    }
  ],
