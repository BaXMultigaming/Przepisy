  "title": "Chef John’s Boston Cream Pie",
  "description": "This Boston cream pie is quick and easy to make with cake mix, a silky homemade pastry cream, and glossy chocolate ganache for a beautiful dessert.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2020-06-18T23:48:08-04:00",
  "date_modified": "2026-07-30T14:15:43-04:00",
  "prep_time": "PT30M",
  "cook_time": "PT40M",
  "total_time": "PT310M",
  "yield": [
    "8",
    "1 (8-inch) 2-layer cake"
  ],
  "categories": [
    "Dessert"
  ],
  "cuisines": [
    "New England",
    "American"
  ],
  "regions": [
    "New England",
