  "ingredients": [
    "2 large eggs",
    "2 (10 ounce) packages frozen chopped broccoli, thawed",
    "1 onion, chopped",
    "1 cup mayonnaise",
    "1 cup condensed cream of mushroom soup",
    "1 cup shredded Cheddar cheese",
    "0.5 cup butter, cut into pieces",
    "0.75 cup crushed buttery round crackers (such as Ritz®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl; whisk in broccoli, onion, mayonnaise, condensed soup, Cheddar cheese, and butter until well combined. Spoon into a 2-quart casserole dish; sprinkle with crushed crackers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until hot and bubbly, 30 to 40 minutes.",
