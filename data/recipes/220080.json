  "ingredients": [
    "1 (16 ounce) package Johnsonville® Ground Italian Sausage",
    "48 large fresh mushrooms",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup dry bread crumbs",
    "2 tablespoons finely chopped fresh parsley",
    "3 garlic cloves, minced",
    "1 tablespoon lemon juice",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line baking sheets with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble and cook sausage in a skillet over medium heat until no longer pink and lightly browned; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and discard mushroom stems; arrange caps on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooked sausage, cream cheese, bread crumbs, parsley, garlic, and lemon juice in a bowl; stir until blended. Spoon sausage mixture into mushroom caps; sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until mushrooms are tender and lightly browned, 14 to 16 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
