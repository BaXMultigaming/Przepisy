  "ingredients": [
    "2 cups dried pinto beans",
    "4 quarts water, or more as needed",
    "4 (1 ounce) slices pork jowl, or more to taste",
    "2 tablespoons white sugar",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Wash pinto beans thoroughly and place in a large stockpot. Add 4 quarts water, pork jowl, sugar, salt, and pepper. Bring to a rolling boil over high heat. Reduce heat to a simmer; cook until beans are tender and tasty, 3 to 4 hours. Add water throughout cooking as needed; do not let the beans cook dry.",
