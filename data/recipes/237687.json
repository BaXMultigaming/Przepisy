  "ingredients": [
    "5 (5 ounce) cans chunk light tuna in water, drained and flaked",
    "0.5 cup sweetened dried cranberries (such as Craisins®)",
    "0.5 cup finely chopped carrot",
    "0.25 cup chopped green onions",
    "0.25 cup finely chopped cilantro",
    "1 tablespoon sesame seeds",
    "1.5 teaspoons ground ginger",
    "1.5 teaspoons ground red chile pepper",
    "0.75 teaspoon kosher salt",
    "0.5 cup light mayonnaise",
    "0.25 cup Asian chile paste (such as sambal oelek)",
    "2 tablespoons sesame oil",
    "1 tablespoon light soy sauce",
    "1 tablespoon honey"
  ],
  "steps": [
    {
      "text": "Mix tuna, cranberries, carrot, green onions, cilantro, sesame seeds, ginger, ground chile pepper, and kosher salt together in a large bowl.",
