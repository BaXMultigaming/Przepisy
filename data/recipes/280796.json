  "ingredients": [
    "2 tablespoons extra-virgin olive oil",
    "0.5 lemon, juiced",
    "1 teaspoon seafood seasoning (such as Old Bay®)",
    "0.25 teaspoon white sugar",
    "0.125 teaspoon cayenne pepper",
    "salt to taste",
    "1 pound shrimp, shelled and deveined"
  ],
  "steps": [
    {
      "text": "Combine olive oil, lemon juice, seafood seasoning, sugar, cayenne, and salt in a small bowl; stir until marinade is well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread shrimp on metal skewers and pat dry. Brush with marinade and refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook shrimp on the hot grill until the edges begin to turn white, 1 to 2 minutes. Turn and continue grilling until shrimp is white and no longer translucent, 1 to 2 minutes longer. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
