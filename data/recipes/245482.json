  "ingredients": [
    "1 tablespoon ground cayenne pepper",
    "1 tablespoon ground jalapeno pepper",
    "1 tablespoon ground habanero pepper",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "0.125 teaspoon white sugar",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon ground cinnamon",
    "12 chicken wings, thawed if frozen"
  ],
  "steps": [
    {
      "text": "Combine cayenne pepper, jalapeno pepper, habanero pepper, oregano, salt, sugar, black pepper, and cinnamon in a small bowl; mix well to make dry rub.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken wings in a large resealable bag or container. Add dry rub mixture to wings; seal container and shake well until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the chicken wings on the preheated grill, turning occasionally, until the chicken is well-browned and no longer pink, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
