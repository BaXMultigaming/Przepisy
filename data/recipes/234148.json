  "ingredients": [
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "0.5 cup butter, softened",
    "1 egg",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup chocolate chips, or to taste",
    "4 graham crackers, crushed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk white sugar, brown sugar, butter, and egg together in a large bowl. Stir flour, baking soda, and salt into sugar mixture until batter is just mixed; fold in chocolate chips. Roll dough into 1-inch balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour graham cracker crumbs into a resealable bag. Place each dough ball, 1 at a time, into the bag and shake until completely coated in graham cracker crumbs. Arrange coated dough balls on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are lightly browned on the edges and have 'cracks' in the middle, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
