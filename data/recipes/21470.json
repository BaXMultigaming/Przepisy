  "ingredients": [
    "12 ounces spaghetti",
    "1 tablespoon olive oil",
    "1 (10 ounce) package frozen chopped spinach, thawed",
    "0.25 cup water",
    "1 tablespoon fresh lemon juice",
    "garlic powder to taste",
    "3 pounds bay scallops, raw",
    "salt and pepper to taste",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook in boiling water until tender yet firm to the bite, 8 to 10 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat olive oil in a medium skillet over medium heat. Sauté spinach in hot oil until heated through. Stir in water, lemon juice, and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add scallops and cook until opaque, about 3 minutes. Be careful not to overcook. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer spaghetti to a serving dish. Pour scallops and sauce over the top. Sprinkle with Parmesan cheese to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
