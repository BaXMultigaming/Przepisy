  "ingredients": [
    "0.5 cup whole-milk plain kefir (such as Lifeway®)",
    "1 tablespoon hot sauce",
    "1.5 pounds chicken tenders",
    "2 (3.25 ounce) packages pork rinds, crushed",
    "3 ounces finely grated Parmesan cheese",
    "1.5 teaspoons garlic powder",
    "0.75 teaspoon cantanzaro herbs (such as Savory Spice Shop®) or Italian seasoning",
    "0.5 teaspoon sweet smoked paprika"
  ],
  "steps": [
    {
      "text": "Combine kefir and hot sauce in a shallow bowl. Add chicken tenders and marinate for 30 minutes to 1 hour, or longer if preferred.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour crushed pork rinds into a resealable shallow container. Mix in Parmesan cheese, garlic powder, cantanzaro herbs, and paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the air fryer to 390 degrees F (200 degrees C), about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain chicken from kefir mixture and dredge through the pork rind mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry in the preheated fryer for a total of 17 minutes, turning chicken at the halfway point.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
