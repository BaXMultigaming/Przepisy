  "ingredients": [
    "6 medium oranges",
    "3 cups cooked, mashed sweet potatoes",
    "1 cup white sugar",
    "1 cup unsalted butter, softened",
    "0.25 cup orange juice",
    "2 large eggs, lightly beaten",
    "1 teaspoon vanilla extract",
    "1 tablespoon grated orange zest",
    "1 cup brown sugar",
    "1 cup chopped pecans",
    "0.5 teaspoon all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut 1/2 inch off one end of each orange and spoon out flesh. Place orange shells into a deep casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sweet potatoes, white sugar, 1/2 cup softened butter, orange juice, eggs, vanilla, and orange zest in a large bowl with an electric mixer until smooth. Spoon into orange shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1/2 cup butter, brown sugar, pecans, and flour in a small saucepan over medium heat. Cook, stirring occasionally, until sugar dissolves and butter melts, 3 to 4 minutes; spoon mixture over oranges. Add 1/2 inch water around orange shells in the casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
