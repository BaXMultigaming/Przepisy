  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 2-quart casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, both soups, tuna, rice, celery, onion, bell pepper, garlic, oregano, parsley, black pepper, and salt in a large bowl and mix until well incorporated. Pour into the prepared dish and cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until rice is tender, about 1 hour and 30 minutes. Let cool slightly before serving, about 10 minutes.",
      "section": null,
