  "ingredients": [
    "2.5 pounds chuck steak",
    "4 (32 fluid ounce) containers vegetable stock",
    "4 (16 ounce) cans beer",
    "0.5 cup olive oil",
    "1 tablespoon ground paprika",
    "1.5 teaspoons ground white pepper",
    "1 medium head cabbage, chopped",
    "2 large onions, chopped",
    "2 medium carrots, chopped, or more to taste",
    "0.5 medium head garlic, peeled and minced",
    "1 cup basmati rice",
    "0.66666668653488 cup wild rice",
    "3 (15 ounce) cans tomato puree",
    "1 (15 ounce) can diced tomatoes",
    "0.33333334326744 cup white sugar",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Cut chuck steak into cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine vegetable stock and beer in a Dutch oven and bring to a boil. Add chuck steak and return to a boil; skimming off and discarding any foam from the top. Add olive oil, paprika, and pepper. Reduce heat and simmer until meat is very tender, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cabbage, onions, carrots, garlic, basmati and wild rice; simmer for 30 minutes. Add tomato puree, diced tomatoes, and sugar; simmer for another 30 minutes. Season with salt and pepper and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
