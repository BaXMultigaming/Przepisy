  "ingredients": [
    "1 pound spicy bulk pork sausage",
    "1 pound lean ground beef",
    "1 (28 ounce) can diced tomatoes",
    "1 onion, chopped",
    "1 (6 ounce) can tomato paste",
    "2 tablespoons distilled white vinegar",
    "2 teaspoons chili powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon red pepper flakes, or more to taste",
    "10 cups shredded cabbage"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage and beef in the hot skillet until browned and crumbly, 7 to 10 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir diced tomatoes, onion, tomato paste, vinegar, chili powder, salt, and red pepper flakes into sausage mixture. Fold in cabbage. Reduce heat to medium-low and cook, stirring occasionally, until cabbage is tender, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
