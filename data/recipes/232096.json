  "ingredients": [
    "1.5 pounds sweet Italian sausage",
    "2 cups 1/2-inch pieces celery",
    "2 pounds zucchini, cut into 1/2-inch slices",
    "2 (28 ounce) cans diced tomatoes",
    "2 green bell peppers, cut into 1/2-inch slices",
    "1 cup chopped onion",
    "2 teaspoons salt",
    "1 teaspoon white sugar",
    "1 teaspoon dried oregano",
    "1 teaspoon Italian seasoning",
    "1 teaspoon dried basil",
    "0.25 teaspoon garlic powder",
    "6 tablespoons grated Parmesan cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Add sausage; cook and stir until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Stir in celery; cook and stir until softened, about 10 minutes. Transfer to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir zucchini, diced tomatoes, bell peppers, onion, salt, sugar, oregano, Italian seasoning, basil, and garlic powder into sausage mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 4 to 6 hours. Garnish each serving with 1 tablespoon Parmesan cheese.",
      "section": null,
      "name": null,
