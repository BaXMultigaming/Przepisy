  "ingredients": [
    "1 (1.5 pound) skinless center-cut salmon fillet, cut into 4 pieces",
    "1 cup milk",
    "0.25 cup fine bread crumbs",
    "2 tablespoons grated Parmesan cheese",
    "1 egg",
    "0.25 cup butter, melted",
    "1 tablespoon prepared yellow mustard",
    "1 tablespoon honey"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a baking sheet with cooking spray; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fillets in a baking dish; pour milk on top and soak, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir bread crumbs and Parmesan cheese together in a wide, shallow dish. Beat egg in a separate dish until frothy. Remove fillets from milk; shake off excess. Dip each fillet into egg, then gently press into bread crumb mixture to coat, shaking off excess. Arrange coated fillets on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fillets easily flake with a fork, about 15 minutes, flipping halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine butter, mustard, and honey in a bowl; drizzle over fillets before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
