  "ingredients": [
    "6 skinless, boneless chicken breast halves - cut into 1/2 inch strips",
    "1 large red bell pepper, seeded and sliced into strips",
    "1 large onion, coarsely chopped",
    "0.5 cup chicken broth",
    "0.25 cup soy sauce",
    "1 tablespoon ground cumin",
    "3 cloves garlic, minced",
    "0.5 teaspoon red pepper flakes",
    "salt and pepper to taste",
    "2 tablespoons cornstarch",
    "0.66666668653488 cup creamy peanut butter",
    "1 tablespoon soy sauce",
    "0.25 cup lime juice",
    "3 green onion, chopped",
    "0.25 cup chopped fresh cilantro",
    "0.5 cup chopped roasted peanuts"
  ],
  "steps": [
    {
      "text": "Place the chicken breast strips, bell pepper and onion into a slow cooker. Pour in the chicken broth and 1/4 cup of soy sauce, then season with cumin, garlic, red pepper flakes, salt and pepper. Stir to blend, then cover and cook on Low for 4 1/2 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove 1 cup of the liquid from the slow cooker, and mix this with the cornstarch, peanut butter, 1 tablespoon of soy sauce and lime juice. This should blend into a fairly thick sauce. Stir the sauce back into the slow cooker, and place the lid on the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 30 minutes. Garnish with green onions, cilantro and peanuts before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
