  "ingredients": [
    "0.25 cup whole wheat flour",
    "0.25 cup white sugar",
    "1 tablespoon unsweetened cocoa powder",
    "0.25 teaspoon baking powder",
    "0.125 teaspoon baking soda",
    "1 pinch salt",
    "1 tablespoon unsweetened applesauce",
    "1 tablespoon water, or more as needed",
    "2 teaspoons white vinegar",
    "1 teaspoon vanilla extract",
    "1 tablespoon vegan chocolate chips",
    "1 tablespoon chopped walnuts"
  ],
  "steps": [
    {
      "text": "Whisk whole wheat flour, sugar, cocoa powder, baking powder, baking soda, and salt together in a mug. Mix in applesauce, 1 tablespoon water, vinegar, and vanilla extract. Add more water if needed to reach a cake batter consistency. Stir in chocolate chips and walnuts.",
