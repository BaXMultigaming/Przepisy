  "ingredients": [
    "0.25 cup butter, softened",
    "0.25 cup honey",
    "3 tablespoons brown sugar",
    "1 egg yolk",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon gingerbread spice mix",
    "1 pinch salt",
    "0.5 cup Nutella® hazelnut spread",
    "3 tablespoons confectioners' sugar",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "In a bowl, mix together butter, honey and brown sugar. Mix in egg yolk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, mix together flour, baking soda, gingerbread spice mix and salt; add to butter mixture and knead for 1 minute. Cover with plastic wrap; and refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 320 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a sheet of parchment paper, roll out dough to 1/6-inch thickness. Using small gingerbread-man cookie cutter or other small shaped-item (such as a glass), cut out gingerbread men.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer gingerbread men to parchment paper-lined baking sheet; bake on center rack for 8 to 9 minutes or until slightly golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cool on rack for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1 1/4 tsp Nutella® hazelnut spread on the back of one gingerbread man then sandwich with another gingerbread man.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Repeat with remaining gingerbread men and Nutella® hazelnut spread. Mix together confectioners' sugar and lemon juice, adding juice to the sugar, a 1/2 tsp at a time, to make smooth paste. Transfer to piping bag and decorate cookies with icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
