  "title": "Gingerbread Men Cookies with Nutella® hazelnut spread",
  "description": "A must-do holiday tradition, these tasty gingerbread figures are even better with a layer of Nutella® hazelnut spread. Enjoy!",
  "authors": [
    "Nutella hazelnut spread"
  ],
  "date_published": "2020-03-05T00:17:09-05:00",
