  "title": "Jan Hagel Cookies",
  "description": "Jan Hagel cookies are a favorite Dutch Christmas tradition. These flaky, crispy cookies are made with butter, egg, sugar, and walnuts.",
  "authors": [
    "ROBIN JOYE"
  ],
  "date_published": "1997-12-21T15:07:52-05:00",
