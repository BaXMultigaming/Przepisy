  "ingredients": [
    "1 cup unsalted butter, softened",
    "1 cup white sugar",
    "2 cups all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "1 large egg, separated, divided",
    "1 teaspoon water",
    "0.5 cup finely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Set out two rimmed baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar with an electric mixer in a mixing bowl until light and fluffy. Mix in egg yolk until thoroughly combined and creamy. Add flour and cinnamon and mix until dough is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 2/3 of the dough over one baking sheet; spread remaining dough over half of the second baking sheet. Press down on dough with your fingers, then score with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg white and water together in a small bowl; brush lightly over dough. Sprinkle walnuts over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and immediately cut into 24 squares or rectangles. Let cool completely on the baking sheets, then remove and separate cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
