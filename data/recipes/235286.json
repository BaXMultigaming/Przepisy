  "ingredients": [
    "1.3333333730698 cups raw sugar",
    "0.75 cup virgin coconut oil",
    "0.25 cup grapeseed oil",
    "4 eggs",
    "4 limes, zested",
    "1.5 cups whole wheat flour",
    "1.3333333730698 cups all-purpose flour",
    "0.75 cup flaked coconut",
    "2 tablespoons ground flaxseed",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 cup milk",
    "0.25 cup fresh lime juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 10 Texas-size muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, coconut oil, and grapeseed oil together in a bowl. Add eggs and lime zest; whisk until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk whole wheat flour, all-purpose flour, flaked coconut, flaxseed, baking powder, and salt together in a bowl. Stir milk and lime juice together in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk mixture into sugar mixture. Gently fold flour mixture into sugar mixture until batter is just combined. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned and a toothpick inserted in the center comes out clean, about 40 minutes. Transfer muffins to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
