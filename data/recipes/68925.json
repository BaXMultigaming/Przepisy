  "ingredients": [
    "2 pounds salmon fillets",
    "2 cloves garlic, crushed",
    "1 teaspoon dried dill weed",
    "salt to taste",
    "ground black pepper to taste",
    "6 green onions, chopped",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon on a large piece of aluminum foil; season with garlic, dill, salt, and black pepper. Seal salmon in foil. Place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Top with green onions and Cheddar cheese; continue baking until cheese is melted and salmon flakes easily with a fork, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
