  "ingredients": [
    "4 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "1 cup butter",
    "1 cup shortening",
    "3 cups white sugar",
    "6 large eggs",
    "0.75 cup milk",
    "1 teaspoon lemon extract",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease and flour a 9-inch fluted tube pan (such as a Bundt®).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, and salt together in a bowl; sift the flour mixture twice into a separate bowl. Cream butter, shortening, and sugar in another large bowl until smooth; stir eggs and milk into creamed mixture until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually mix flour into moist ingredients to make a smooth batter; stir lemon and vanilla extracts into batter. Continue mixing until no sugar granules are visible. Pour batter into prepared tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is springy and cake is set in the center, about 90 minutes. Let cake cool in the pan until sides separate from pan; turn out onto a rack to finish cooling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
