  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 teaspoon salt",
    "2 teaspoons baking powder",
    "1 cup white sugar",
    "0.5 cup butter",
    "1 cup milk",
    "1 teaspoon vanilla extract",
    "4 cups pitted sour cherries",
    "0.5 cup white sugar",
    "1.25 cups cherry juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 10x10-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl, combine flour, salt, baking powder and 1 cup sugar; stir. Add butter, milk and vanilla; beat with electric mixer for 2 minutes, or until smooth. Pour mixture into pan and cover evenly with cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat cherry juice in microwave or in small saucepan, until just simmering. Sprinkle 1/2 cup of sugar over cherries, and pour hot cherry juice on top. Bake 40 to 45 minutes, or until pick inserted in center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
