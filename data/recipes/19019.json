  "title": "Cherry Dump Pudding Cake",
  "description": "This one-bowl recipe is easy to make! The batter is topped with sour cherries and cherry juice, then baked.",
  "authors": [
    "Stephanie Auld"
  ],
  "date_published": "2000-07-12T11:56:32-04:00",
