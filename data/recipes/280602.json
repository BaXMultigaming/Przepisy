  "ingredients": [
    "2 cups all-purpose flour",
    "4 teaspoons Clabber Girl® Baking Powder",
    "1 tablespoon sugar",
    "1.5 teaspoons kosher salt",
    "1 teaspoon baking soda",
    "0.75 cup buttermilk",
    "2 eggs",
    "Spice Islands® Sesame Seeds, optional"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F. Spray a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, whisk together flour, baking powder, sugar, salt and baking soda.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add buttermilk and eggs and beat on low speed 30 seconds until combined, then beat 1 minute on high speed. Dough will be sticky and will have the appearance of frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With wet hands, scoop out 6 to 8 even portions of dough and place them on prepared baking sheet, mounding the dough slightly into a bun shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Re-wet fingers and smooth the tops and sides of each bun. If desired, sprinkle with sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 15 minutes or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow to cool. Slice buns lengthwise. Serve with burgers, chicken, fish, veggies or whatever you like!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
