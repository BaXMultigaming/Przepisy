  "ingredients": [
    "1 teaspoon vegetable oil",
    "10 ounces raisins",
    "10 fluid ounces strong hot tea",
    "12 ounces self-rising flour",
    "4 ounces white sugar",
    "1 teaspoon ground allspice",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Oil a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine raisins and tea in a bowl. Steep for about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, and allspice together in a second bowl. Add the raisin-tea mixture and egg. Gently combine using a rubber spatula; do not overmix. Scoop mixture into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
