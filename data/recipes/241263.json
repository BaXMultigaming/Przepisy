  "ingredients": [
    "2 tablespoons Montreal steak seasoning",
    "1 tablespoon salt",
    "1 tablespoon dried thyme",
    "1 tablespoon dried rosemary",
    "1 (2 1/2 pound) beef roast, or more to taste",
    "1 (1 ounce) packet dry au jus mix",
    "1 (1 ounce) package French onion soup mix",
    "1 cup water",
    "1 cup Malbec red wine"
  ],
  "steps": [
    {
      "text": "Combine steak seasoning, salt, thyme, and rosemary together in a bowl; rub onto the roast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat and place roast in skillet; cook until roast is browned on all sides, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the roast in the slow cooker and add au jus mix and onion soup mix. Pour water and Malbec over roast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 5 hours (or cook on Low for 8 to 9 hours).",
      "section": null,
