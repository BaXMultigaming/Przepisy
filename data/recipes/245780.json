  "ingredients": [
    "2 9-inch refrigerated pie crusts",
    "3 cups elderberries",
    "1.5 cups sour cream",
    "1.5 cups white sugar",
    "0.5 cup all-purpose flour",
    "1 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
