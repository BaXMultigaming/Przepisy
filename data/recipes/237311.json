  "ingredients": [
    "1 (16 ounce) package elbow macaroni",
    "0.5 cup butter",
    "salt and ground black pepper to taste",
    "1 (16 ounce) package shredded Cheddar cheese, divided",
    "1 (5 ounce) can evaporated milk",
    "2 eggs, well beaten",
    "2 cups whole milk",
    "1 (10.5 ounce) can condensed Cheddar cheese soup (such as Campbell's®)",
    "1 pinch paprika, or as desired"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AylJ9xLADQvI_ee5H51my9xWkB4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237311-slow-cooker-mac-and-cheese-recipe-VAT-038-Step-1-B-2646d414eee44f6ba521778f64f512df.jpg"
      ],
      "image": "assets/images/237311/step_01.webp"
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in macaroni pasta and return to a boil. Cook pasta uncovered, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and transfer pasta to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hcrgur02oUeu-vU7f7dxs6YtXIM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237311-slow-cooker-mac-and-cheese-recipe-VAT-002-Step-02-fffdd85243a64843b16fa457143002f3.jpg"
      ],
      "image": "assets/images/237311/step_02.webp"
    },
    {
      "text": "Stir butter into pasta until melted; season with salt and black pepper. Sprinkle about ½ Cheddar cheese over pasta; stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vaejHHSCPOWdulHe8YAkyc7mOZA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237311-slow-cooker-mac-and-cheese-recipe-VAT-005-Step-03-20562b4cb89346e19ae530f7b40418cd.jpg"
      ],
      "image": "assets/images/237311/step_03.webp"
    },
    {
      "text": "Whisk evaporated milk and eggs together in a bowl until smooth; stir into pasta mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xMyMreRoYRHuaZ7tlJXkJFC1of0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237311-slow-cooker-mac-and-cheese-recipe-VAT-006-Step-04-19825eb2c082445aa18a3832f5128f3a.jpg"
      ],
      "image": "assets/images/237311/step_04.webp"
    },
    {
      "text": "Whisk whole milk and condensed soup together in a bowl until smooth; stir into pasta mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r7khVhl0QnMqvdm5oGSp9rBPPTg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237311-slow-cooker-mac-and-cheese-recipe-VAT-007-Step-05-83de1195d7ac4e5ab83a52e8de5732bc.jpg"
      ],
      "image": "assets/images/237311/step_05.webp"
    },
    {
      "text": "Sprinkle remaining ½ Cheddar cheese over pasta mixture; sprinkle with paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cFIXVXpQuh02VS_K08tFIthEJPQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237311-slow-cooker-mac-and-cheese-recipe-VAT-008-Step-06-dae27157c3e84ec9a6f926d8ab60e369.jpg"
      ],
      "image": "assets/images/237311/step_06.webp"
