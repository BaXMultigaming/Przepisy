  "ingredients": [
    "5 pounds potatoes, peeled and quartered",
    "0.25 cup butter",
    "6 cloves garlic, minced",
    "2 cups low-fat milk",
    "1 cup freshly grated Parmesan cheese",
    "0.25 cup chopped fresh parsley",
    "1 teaspoon sea salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a small saucepan over medium-low heat. Add garlic and sauté until soft, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain potatoes and return to the pot. Add garlic-butter mixture, milk, Parmesan cheese, parsley, salt, and pepper; mash until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
