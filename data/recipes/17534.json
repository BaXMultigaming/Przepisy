  "ingredients": [
    "2 pounds ground beef",
    "1 onion, chopped",
    "2 (15 ounce) cans ranch-style beans",
    "1 (15.25 ounce) can whole kernel corn",
    "1 (14.5 ounce) can peeled and diced tomatoes with juice",
    "1 (10 ounce) can diced tomatoes with green chile peppers",
    "1 (1.25 ounce) package taco seasoning mix"
  ],
  "steps": [
    {
      "text": "Combine ground beef and onion in a large pot over medium-high heat; sauté until meat is browned and crumbly and onion is tender, 5 to 10 minutes; drain excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in beans, corn, tomatoes with juice, tomatoes with green chile peppers, and taco seasoning; mix well. Reduce heat to medium and cook until heated through, about 15 minutes.",
      "section": null,
      "name": null,
