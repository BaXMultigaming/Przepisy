  "ingredients": [
    "2 tablespoons olive oil",
    "1 cup shredded carrot",
    "1 cup chopped onion",
    "5 cloves garlic, minced",
    "6 cups vegetable broth",
    "1 (16 ounce) package dry lentils",
    "1 (24 ounce) jar chunky-style salsa",
    "1 pinch cayenne pepper, or to taste",
    "salt and ground black pepper to taste",
    "1 bunch kale, chopped"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat. Cook, stirring together carrots, onions, and garlic until softened, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add broth to the pot. Stir lentils and salsa into broth. Bring to a boil, cover, and simmer until lentils are soft, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season lentil mixture with cayenne pepper, salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir kale into lentil mixture. Cook, covered, until kale is just wilted, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
