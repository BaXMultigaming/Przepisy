  "title": "Chicken Chile Verde",
  "description": "A delicious variation on the classic Mexican chile verde, this recipe calls for chicken pieces to be slow-simmered in a fresh tomatillo-chile sauce.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-04-04T17:21:10-04:00",
