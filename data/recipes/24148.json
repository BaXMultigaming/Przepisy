  "ingredients": [
    "3 tablespoons butter, divided",
    "2 cups chopped fresh broccoli",
    "1 onion, minced",
    "1 teaspoon minced garlic",
    "1 (9 inch) unbaked pie crust",
    "1.5 cups shredded mozzarella cheese",
    "4 eggs, well beaten",
    "1.5 cups milk",
    "0.5 teaspoon black pepper",
    "1 teaspoon salt",
    "1 tablespoon butter, melted"
  ],
