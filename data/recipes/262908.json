  "ingredients": [
    "1 tablespoon olive oil",
    "1 onion, diced",
    "0.5 tablespoon minced garlic",
    "0.5 tablespoon ground ginger",
    "1 teaspoon cumin",
    "3 cups water",
    "1 cup moong dal (split husked mung beans)",
    "1 teaspoon coriander",
    "1 teaspoon salt",
    "1 teaspoon garam masala",
    "0.5 teaspoon cayenne pepper",
    "1 pinch ground turmeric",
    "1 tablespoon lemon juice",
    "1 tablespoon chopped cilantro"
  ],
  "steps": [
    {
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Sauté function. Heat olive oil; add onion, garlic, ginger, and cumin. Cook until tender, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, moong dal lentils, coriander, salt, garam masala, cayenne pepper, and turmeric in the pot. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 15 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Unlock and remove lid. Stir in lemon juice and cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
