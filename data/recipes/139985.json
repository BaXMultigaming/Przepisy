  "ingredients": [
    "0.5 cup minced onion",
    "2 jalapeno peppers, seeded and minced",
    "0.25 cup diced red bell pepper",
    "0.25 cup minced dill pickle",
    "4 large tomatoes, seeded and diced",
    "1 tablespoon fresh lime juice",
    "0.25 cup chopped cilantro",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a medium bowl, combine onion, jalapeño pepper, bell pepper, dill pickle, and diced tomatoes. Stir in lime juice and cilantro; season to taste with salt and pepper. Cover, and refrigerate at least 1 hour before serving, preferably overnight.",
