  "ingredients": [
    "1 cup sifted all-purpose flour",
    "0.25 cup white sugar",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup beer",
    "2 tablespoons butter, melted",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Whisk flour, sugar, baking powder, and salt together in a large bowl. Whisk in beer, melted butter, and egg just until blended; a few lumps are okay.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet or griddle over medium heat. Coat with vegetable oil or cooking spray. Drop batter by 1/4 cupfuls onto the skillet and cook until bubbles appear on pancake tops. Flip and cook until browned on the other side. Repeat with remaining batter.",
