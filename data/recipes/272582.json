  "ingredients": [
    "1 pound ground chicken",
    "1 egg, beaten",
    "0.25 cup low-fat cream cheese",
    "0.25 cup grated Parmesan cheese",
    "4 cloves garlic, grated",
    "1.5 tablespoons olive oil",
    "1 tablespoon dry bread crumbs",
    "2 teaspoons chopped fresh basil",
    "1 teaspoon crushed red pepper",
    "1 teaspoon garlic powder",
    "0.5 teaspoon sea salt",
    "0.5 teaspoon black pepper",
    "0.5 teaspoon dried parsley",
    "0.5 teaspoon dried oregano",
    "1 cup chopped fresh mozzarella, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground chicken, egg, cream cheese, Parmesan cheese, garlic, olive oil, bread crumbs, basil, red pepper, garlic powder, salt, pepper, parsley, and oregano in a freezer-safe bowl and mix well. Place in the freezer for 15 minutes to make the mixture firmer and easier to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form into 14 equally sized meatballs using an ice cream scoop. Add a piece of mozzarella cheese to the center of each meatball, making sure cheese is covered by meat. Place meatballs on a nonstick baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the centers and juices run clear, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
