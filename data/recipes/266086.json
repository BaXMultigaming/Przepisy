  "ingredients": [
    "3 cups filtered water",
    "1 cup white sugar",
    "0.25 cup dried red hibiscus flowers",
    "0.125 cup dried white hibiscus flowers",
    "0.33333334326744 cup freshly squeezed grapefruit juice",
    "1 tablespoon chopped fresh mint",
    "0.33333334326744 cup pomegranate seeds"
  ],
  "steps": [
    {
      "text": "Heat water to a low boil. Add sugar and hibiscus flowers; stir until the sugar has dissolved. Remove from heat and allow to cool. Strain; discard hibiscus flowers. Add grapefruit juice and mint and mix well. Refrigerate until cold, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chilled mixture into an ice cream maker and churn according to manufacturer's instructions. Add pomegranate seeds 5 minutes before the granita reaches the soft-serve stage.",
