  "ingredients": [
    "4 (4 ounce) tuna steaks",
    "4 teaspoons olive oil",
    "4 teaspoons white vinegar",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon ground coriander",
    "1 teaspoon ground cumin",
    "0.5 teaspoon dried tarragon"
  ],
  "steps": [
    {
      "text": "Place tuna steaks in a bowl. Add olive oil, vinegar, garlic powder, onion powder, coriander, cumin, and tarragon and mix well. Cover with aluminum foil and marinate in the refrigerator for 2 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Transfer tuna steaks to a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tuna is cooked through and flakes easily with a fork, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
