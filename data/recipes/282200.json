  "ingredients": [
    "1 (7 pound) whole turkey breast",
    "0.5 cup chicken broth",
    "0.25 cup unsalted butter, melted",
    "1 teaspoon kosher salt",
    "0.5 teaspoon poultry seasoning",
    "2 tablespoons unsalted butter",
    "2 teaspoons kosher salt",
    "2 teaspoons paprika",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat a smoker to 275 degrees F (135 degrees C). Add hickory chips according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chicken broth, melted butter, salt, and poultry seasoning in a small bowl. Inject solution evenly throughout breast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt remaining 2 tablespoons of butter in a small dish. Brush evenly over breast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine salt, paprika, garlic powder, onion powder, and black pepper in a small bowl. Sprinkle rub over entire breast, making sure to coat all sides evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place breast in the preheated smoker and smoke for 3 hours or until internal temperature reaches 160 degrees F (71 degrees C). Remove from smoker and let rest for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
