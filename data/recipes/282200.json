  "title": "Smoked Turkey Breast",
  "description": "This smoked turkey breast gets a buttery injection and is coated with a flavorsome paprika and garlic spice rub before it's smoked over wood chips.",
  "authors": [
    "Soup Loving Nicole"
  ],
  "date_published": "2020-11-02T05:31:41-05:00",
