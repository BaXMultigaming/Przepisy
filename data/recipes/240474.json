  "ingredients": [
    "2.5 cups milk",
    "1.5 cups cornmeal",
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "1.5 tablespoons baking powder",
    "1 teaspoon salt",
    "2 eggs, beaten",
    "0.5 cup coconut oil, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk and cornmeal together so the cornmeal is completely wet; let soak for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, sugar, baking powder, and salt together in a bowl with a whisk; add cornmeal mixture, eggs, and coconut oil and stir until smooth. Pour the batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
