  "ingredients": [
    "1.5 tablespoons miso paste",
    "2 tablespoons rice vinegar",
    "1.25 tablespoons honey",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon sesame oil",
    "1.5 teaspoons lime juice",
    "1 teaspoon toasted sesame seeds"
  ],
