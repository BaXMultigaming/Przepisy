  "ingredients": [
    "0.5 cup white sugar",
    "0.5 cup light brown sugar",
    "0.125 cup sifted all-purpose flour",
    "0.25 teaspoon salt",
    "0.25 cup milk",
    "0.25 cup margarine",
    "1 egg yolk",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan, combine white sugar, brown sugar, flour and salt. Pour in milk and add margarine. Heat, stirring constantly, until sugar dissolves and margarine is melted. Remove from heat and set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk egg yolk, egg and vanilla until smooth. Whisk in cooled sugar mixture. Pour into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 minutes in the preheated oven, then reduce the temperature to 250 degrees F (120 degrees C) and bake for an additional 25 minutes, or until top is puffed and edges are golden brown. Allow to cool before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
