  "ingredients": [
    "0.5 cup natural, salted peanut butter",
    "0.25 cup maple syrup",
    "1 tablespoon flaxseed meal",
    "2 teaspoons vanilla extract",
    "2 teaspoons ground cinnamon",
    "4 cups rolled oats",
    "0.5 cup shredded coconut, or to taste",
    "0.25 cup pumpkin seeds, or to taste",
    "0.25 cup raisins, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 1 large or 2 smaller baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix peanut butter, maple syrup, flaxseed meal, vanilla extract, and cinnamon together in a large bowl. Add oats and coconut and mix until completely combined. Transfer mixture to the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until toasted and fragrant, about 10 minutes. Add pumpkin seeds and stir the granola. Continue baking until evenly browned and dry to the touch, about 9 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let granola cool slightly. Add raisins. Store granola in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
