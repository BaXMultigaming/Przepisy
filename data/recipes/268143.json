  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 cup white sugar",
    "2 eggs",
    "1 cup sour cream",
    "1 (8.5 ounce) package corn bread mix",
    "0.5 cup milk",
    "1 (15.25 ounce) can whole kernel corn, drained",
    "1 (14.5 ounce) can cream-style corn"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 3-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar together using a hand mixer until creamy. Add eggs one at a time, beating well after each addition. Mix in sour cream. Alternate adding in corn bread mix and milk; beat well after each addition. Fold in corn kernels and cream-style corn. Pour mixture into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pudding is set and light brown in color, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
