  "ingredients": [
    "1 egg, beaten",
    "1 cup eggnog",
    "2 tablespoons white sugar",
    "2 pinches ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Fill an 8x8-inch baking dish with 1 inch of water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg, eggnog, and sugar together in a bowl. Pour into two small baking dishes. Sprinkle tops with nutmeg. Place the baking dishes into the dish with water. Add more water if necessary to reach halfway up the sides of the smaller baking dishes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until tops are set, 35 to 45 minutes. Cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
