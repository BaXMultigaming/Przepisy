  "ingredients": [
    "1 cup vegetable oil",
    "0.5 cup white vinegar",
    "1 tablespoon honey",
    "1 tablespoon prepared Dijon-style mustard",
    "2 teaspoons minced garlic",
    "2 teaspoons salt",
    "0.5 teaspoon ground black pepper",
    "4 drops hot sauce"
