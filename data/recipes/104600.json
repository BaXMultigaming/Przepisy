  "ingredients": [
    "1 pound chicken wings",
    "2 tablespoons white sugar",
    "0.5 cup soy sauce",
    "0.25 cup rice wine",
    "3 tablespoons chili garlic sauce",
    "1 tablespoon sesame oil",
    "2 cloves garlic, minced",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Rinse and pat dry the chicken wings. Whisk together the sugar, soy sauce, rice wine, chili garlic sauce, sesame oil, and garlic in a large bowl, then add the chicken wings and toss to evenly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled skillet over medium heat. Stir in the chicken wings, sauce, and water. Cover and cook until the chicken wings are no longer pink at the bone, turning the chicken wings occasionally, about 15 minutes. Remove lid and continue cooking until the sauce has thickened, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
