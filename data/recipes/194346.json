  "ingredients": [
    "24 OREO Cookies, crushed",
    "0.25 cup butter or margarine, melted",
    "4 (8 ounce) packages PHILADELPHIA Cream Cheese, softened",
    "1 cup sugar",
    "2 tablespoons flour",
    "1 teaspoon vanilla",
    "1 (8 ounce) package BAKER'S Semi-Sweet Chocolate, melted",
    "4 eggs",
    "0.5 cup blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix crumbs and butter; press onto bottom of 13x9-pan lined with foil. Bake 10 min.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, sugar, flour and vanilla with mixer until blended. Add chocolate; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add eggs, 1 at a time, mixing on low after each just until blended. Pour over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 45 minutes or until center is almost set. Cool. Refrigerate 4 hours. Use foil to lift cheesecake from pan. Top with berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
