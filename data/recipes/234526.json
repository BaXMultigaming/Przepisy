  "ingredients": [
    "1 (46 fluid ounce) bottle ketchup",
    "1 quart fresh blackberries",
    "2 cups blackberry jelly",
    "2 cups white sugar",
    "1 cup raspberry balsamic vinegar",
    "1 cup light corn syrup",
    "1 (6 ounce) can tomato paste",
    "0.5 cup frozen limeade concentrate",
    "0.5 cup cider vinegar",
    "2 tablespoons finely ground sea salt",
    "2 tablespoons bourbon whiskey",
    "1 tablespoon garlic powder",
    "1 tablespoon ground ginger",
    "1 tablespoon ground dried chipotle pepper",
    "1 tablespoon red pepper flakes",
    "1 tablespoon finely ground black pepper",
    "2 teaspoons liquid smoke flavoring",
    "1 teaspoon teriyaki sauce",
    "1 teaspoon hot pepper sauce",
    "3 habanero peppers"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2c4MwVFsvH2Y4NCEqt7zO_i19Qs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234526-blackberry-habanero-bbq-sauce-DDMFS-Step1-8ab499fa9f67457e9b26a554292b1577.jpg"
      ],
      "image": "assets/images/234526/step_01.webp"
    },
    {
      "text": "Combine ketchup, blackberries, blackberry jelly, sugar, raspberry balsamic vinegar, corn syrup, tomato paste, limeade concentrate, cider vinegar, salt, bourbon, garlic powder, ginger, ground chipotle pepper, red pepper flakes, black pepper, liquid smoke, teriyaki sauce, and hot pepper sauce in a large pot over medium-high heat; bring to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rNeNABRq5YR0cPLW9E0Og1g4s9o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234526-blackberry-habanero-bbq-sauce-DDMFS-Step2-11e5085d630f45e9b0dcb10f922b3fdc.jpg"
      ],
      "image": "assets/images/234526/step_02.webp"
    },
    {
      "text": "Reduce heat to medium-low; simmer for 10 minutes. Add 3 whole habanero peppers; simmer until sauce is thickened, about 20 minutes more. Discard habanero peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a-v58yr8kjqRfAstx8OTs33bff4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234526-blackberry-habanero-bbq-sauce-DDMFS-Step3-f2d65a963b7740e8b7d663789a82007a.jpg"
      ],
      "image": "assets/images/234526/step_03.webp"
    },
    {
      "text": "Fill a blender no more than halfway with barbecue sauce. Cover and hold down lid with a towel; pulse a few times before leaving on to blend. Pour into a bowl. Repeat with remaining sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vHqbakaebd-2u_ZbXNkET_hYieg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234526-blackberry-habanero-bbq-sauce-DDMFS-Step4-799d8d5463294615a32781400fa23981.jpg"
