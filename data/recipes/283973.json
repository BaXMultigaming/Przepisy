  "ingredients": [
    "1 pound ground beef",
    "0.25 cup bread crumbs",
    "3 tablespoons soy sauce",
    "2 tablespoons brown sugar",
    "2 tablespoons garlic, minced",
    "2 large egg whites",
    "1 (15 ounce) can crushed pineapple",
    "0.5 cup soy sauce",
    "0.25 cup brown sugar",
    "1 pinch garlic salt, or to taste",
    "ground black pepper to taste",
    "0.5 cup cold water",
    "2 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, bread crumbs, 3 tablespoons soy sauce, 2 tablespoons brown sugar, minced garlic, and egg whites in a bowl. Form into 1-ounce meatballs. Transfer to the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes. An instant-read thermometer inserted into centers should read at least 160 degrees F (71 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine pineapple, ½ cup soy sauce, ¼ cup brown sugar, garlic salt, and black pepper in a saucepan over medium heat. Bring to a boil, then reduce to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cold water and cornstarch together in a small bowl; stir into sauce. Simmer and stir until desired thickness, 3 to 5 minutes. Add meatballs; cook until heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
