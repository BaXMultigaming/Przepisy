  "title": "Caribbean Canadian Glazed Chicken",
  "description": "An amber marinade of molasses, pineapple juice, rum, mustard, garlic and ketchup gilds this Caribbean chicken feast.",
  "authors": [
    "Lesley Prince"
  ],
  "date_published": "2000-02-25T10:15:31-05:00",
