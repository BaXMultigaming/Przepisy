  "ingredients": [
    "cooking spray",
    "1 cup rolled oats",
    "0.66666668653488 cup almond milk",
    "1 large ripe banana, mashed",
    "2 tablespoons cocoa powder",
    "2 tablespoons maple syrup",
    "1 teaspoon baking powder",
    "0.5 teaspoon vanilla extract",
    "0.125 teaspoon salt",
    "2 tablespoons vegan chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray two 8-ounce ramekins with cooking spray on the bottom and sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, almond milk, banana, cocoa powder, maple syrup, baking powder, vanilla extract, and salt in a blender. Blend until all is combined well, 30 to 60 seconds. Fill mixture into the prepared ramekins and sprinkle each with 1 tablespoon chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
