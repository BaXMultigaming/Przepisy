  "ingredients": [
    "1 pound Brussels sprouts, trimmed and halved",
    "4 slices bacon, cut into 1/2-inch pieces",
    "1 tablespoon avocado oil",
    "0.5 teaspoon smoked paprika",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "0.13 teaspoon freshly ground black pepper",
    "1 tablespoon freshly grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss together Brussels sprouts, bacon, avocado oil, smoked paprika, garlic powder, salt, and pepper in a bowl. Spread out in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry for 12 minutes, stirring every 4 minutes, until Brussels sprouts are cooked throughout and bacon is browned. Place into a serving dish and sprinkle Parmesan cheese over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
