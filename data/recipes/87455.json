  "ingredients": [
    "4 egg whites",
    "1 pinch salt",
    "0.25 teaspoon cream of tartar",
    "1.3333333730698 cups sugar",
    "0.5 teaspoon grated lemon zest"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large clean glass or metal bowl, whip the egg whites with salt and cream of tartar until they can hold a soft peak. Gradually sprinkle in the sugar while continuing to whip to stiff peaks. Fold in the lemon zest. Drop by heaping spoonfuls onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 minutes in the preheated oven, or until they peel off of the sheet without resistance. Cool on wire racks, then store in an airtight container at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
