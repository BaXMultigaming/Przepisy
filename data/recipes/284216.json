  "ingredients": [
    "1.5 cups all-purpose flour",
    "1.5 cups quick oats",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup (2 sticks) Becel® salted margarine sticks",
    "1.25 cups light brown sugar",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "1 cup semi-sweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees ). Combine flour, oats, baking soda, and salt in medium bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat Becel® Sticks with brown sugar in large bowl with electric mixer until creamy, about 3 minutes. Beat in egg and vanilla until blended. Gradually beat in flour mixture just until blended. Stir in chocolate chips. Drop dough by tablespoonfuls on ungreased baking sheets, 2 inches (5 cm) apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake just until edges are golden, about 8 minutes. Cool sheets 2 minutes on wire rack; remove cookies from sheets and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
