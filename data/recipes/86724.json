  "ingredients": [
    "1 (16 ounce) package uncooked linguine pasta",
    "2 tablespoons olive oil",
    "0.75 cup butter",
    "3 cloves garlic, chopped",
    "2 tablespoons fresh thyme leaves",
    "5 roasted red peppers, drained and coarsely chopped"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add linguine and olive oil, cook for 8 to 10 minutes, until al dente, and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 2 tablespoons butter in a saucepan over medium heat. Stir in garlic, and cook until golden brown. Mix in remaining butter, thyme, and roasted red peppers. Continue to cook and stir until heated through. Serve over the cooked pasta.",
      "section": null,
