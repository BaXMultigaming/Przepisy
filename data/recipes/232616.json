  "ingredients": [
    "1 (20 ounce) can DOLE® Crushed Pineapple, undrained",
    "1 (4 serving size) package instant pistachio flavor pudding mix",
    "1 cup miniature marshmallows",
    "0.5 cup chopped pecans",
    "1.5 cups thawed whipped topping"
  ],
  "steps": [
    {
      "text": "Combine undrained pineapple and pudding mix in a large bowl. Mix in marshmallows and pecans until well blended. Gently stir in whipped topping. Cover and refrigerate for at least 1 hour before serving.",
