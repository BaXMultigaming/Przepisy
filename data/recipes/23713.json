  "ingredients": [
    "1 pound dry penne pasta",
    "1 tablespoon butter",
    "6 skinless, boneless chicken breast halves - cut into 1 inch cubes",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon salt",
    "1 (8 ounce) bottle Caesar salad dressing",
    "0.25 cup red wine vinegar",
    "0.5 cup grated Parmesan cheese",
    "1 head romaine lettuce - rinsed, dried and shredded",
    "1 large tomato, chopped"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add penne pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add chicken, pepper and salt. Cook 10 minutes or until chicken is cooked through. Remove skillet from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix together salad dressing, vinegar and cheese. Toss together pasta, chicken, lettuce, and dressing mixture. Place in large serving bowl, and sprinkle with tomato. Garnish with croutons and Parmesan curls, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
