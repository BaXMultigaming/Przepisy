  "ingredients": [
    "1 quart oil for frying",
    "0.75 cup all-purpose flour",
    "0.5 cup milk",
    "1 egg",
    "ground cayenne pepper to taste",
    "seasoned salt to taste",
    "salt and pepper to taste",
    "1 cup chopped conch meat",
    "2 stalks celery, chopped",
    "0.5 onion, chopped",
    "0.5 green bell pepper, chopped",
    "2 cloves garlic, chopped",
    "2 tablespoons ketchup",
    "2 tablespoons lime juice",
    "1 tablespoon mayonnaise",
    "1 tablespoon hot sauce",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the fritters: Mix flour, milk, and egg in a large bowl until smooth. Season with cayenne pepper, seasoned salt, salt, and pepper. Mix in conch meat, celery, onion, bell pepper, and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop the batter by rounded tablespoons into hot oil in batches; fry until golden brown on all sides, about 5 minutes. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the dipping sauce: Mix ketchup, lime juice, mayonnaise, hot sauce, salt, and pepper together in a small bowl. Serve dipping sauce on the side with fritters.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
