  "ingredients": [
    "0.5 cup butter",
    "0.25 cup unsweetened cocoa powder",
    "0.75 cup white sugar",
    "2 large eggs",
    "1 tablespoon water",
    "1.25 cups all-purpose flour",
    "0.25 teaspoon salt",
    "0.66666668653488 cup chopped pecans",
    "0.33333334326744 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat the waffle iron.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over low heat. Remove from heat and stir in cocoa until smooth. Mix in sugar, eggs, and water. Beat in flour and salt until well combined. Stir in nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 1 heaping spoonful batter into each well of the preheated waffle iron, cover, and cook until waffles are cooked through. Sprinkle confectioners' sugar over warm waffle brownies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
