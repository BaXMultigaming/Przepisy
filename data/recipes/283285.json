  "ingredients": [
    "2 tablespoons white wine vinegar",
    "1.5 tablespoons Dijon mustard",
    "1.5 tablespoons prepared horseradish",
    "salt and ground black pepper to taste",
    "0.25 cup olive oil",
    "3 cups shredded cabbage",
    "1 cup thinly sliced red onion",
    "1 cup grated carrots",
    "10 slices rye bread",
    "2 tablespoons Dijon mustard, or to taste",
    "1 pound deli sliced corn beef, or more to taste"
  ],
  "steps": [
    {
      "text": "Prepare coleslaw: whisk vinegar, Dijon, horseradish, salt, and pepper together in a large bowl. Continue to whisk while adding oil in a stream; whisk until dressing has emulsified.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cabbage, onion, and carrots to the dressing; toss until well combined. Cover and chill in the refrigerator, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare sandwiches: spread each bread slice with mustard. Lay 5 slices on a work surface. Arrange coleslaw and corned beef over top, cover with remaining bread slices. Press together firmly, cut, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
