  "ingredients": [
    "3 cups rolled oats",
    "0.75 cup brown sugar",
    "2 teaspoons ground cinnamon (such as McCormick® Roasted Saigon Cinnamon)",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 cup milk",
    "0.5 cup melted butter",
    "0.25 cup maple syrup",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "0.25 cup dried cranberries, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, brown sugar, cinnamon, baking powder, and salt together in a bowl. Beat in milk, butter, maple syrup, eggs, and vanilla extract; fold in cranberries. Spread mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
