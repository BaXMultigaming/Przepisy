  "title": "Spiced Chocolate Chip Banana Cookie Bars",
  "description": "This banana cookie bar recipe is very moist and filled with chocolate chips, rum flavoring, vanilla extract, ginger, cinnamon, and nutmeg.",
  "authors": [
    "Lonewolf419"
  ],
  "date_published": "2020-06-19T00:26:13-04:00",
