    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 tablespoon butter",
    "1 tablespoon vegetable oil",
    "3 cloves garlic, chopped",
    "1 tablespoon all-purpose flour",
    "1 cup heavy whipping cream",
    "0.5 cup chicken broth",
    "0.5 cup freshly grated Parmesan cheese",
    "2 ounces cream cheese, softened"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qCFHIQX7zJaQ52gOpZWfiEsl0go=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229277-garlic-cream-sauce-over-chicken-breasts-3x4-step1-4049-f6b6344df6564a099efa8cda7ab33b76.jpg"
      ],
      "image": "assets/images/229277/step_01.webp"
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken breasts with oregano, basil, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0HFuiiWj4ywB-paDhXBnWbDoKGw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229277-garlic-cream-sauce-over-chicken-breasts-3x4-step2-4050-cc450fc016a64c8f801ce47d04eda67f.jpg"
      ],
      "image": "assets/images/229277/step_03.webp"
    },
    {
      "text": "Cook on the preheated grill until no longer pink in the center and the juices run clear, 5 to 6 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Remove from the grill and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B5W3YO7tHE9SnjL7bMuLL1vcgsc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229277-garlic-cream-sauce-over-chicken-breasts-3x4-step3-4056-8cf9ce08548b49d099ac973e7f88887e.jpg"
      ],
      "image": "assets/images/229277/step_04.webp"
    },
    {
      "text": "While the chicken is cooking, heat butter and oil in a saucepan over medium heat until butter melts. Add garlic and sauté until fragrant, about 2 minutes. Whisk in flour until incorporated, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/--tmlZl95suMoGcTVRT27ihisBc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229277-garlic-cream-sauce-over-chicken-breasts-3x4-step5-4084-0e1cc20f92f44cc7904656ef3af8d0b2.jpg"
      ],
      "image": "assets/images/229277/step_05.webp"
    },
    {
      "text": "Whisk in cream and broth; cook, stirring constantly until mixture thickens, 3 to 5 minutes. Add Parmesan and cream cheese; cook, stirring occasionally, until both have melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HGDiUDW7arEGQOuaK628rtTX0GA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229277-garlic-cream-sauce-over-chicken-breasts-3x4-step7-4102-abfbc277a3df4b0badbca741bf532bcf.jpg"
      ],
      "image": "assets/images/229277/step_06.webp"
    },
    {
      "text": "Spoon sauce over chicken breasts and serve remaining sauce on the side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vtgmyMKlIIUJihQ3XTtAh5HeVXI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229277-garlic-cream-sauce-over-chicken-breasts-3x4-step8-4114-b9508738333f40948a071543ff1c257a.jpg"
      ],
      "image": "assets/images/229277/step_07.webp"
    }
