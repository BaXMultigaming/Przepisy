  "title": "Garlic Cream Sauce over Chicken Breasts",
  "description": "A creamy sauce for chicken made with heavy cream, Parmesan, cream cheese, and garlic takes simply seasoned, grilled chicken breasts to a whole new level.",
  "authors": [
    "Carolyn Sheppard"
  ],
  "date_published": "2018-06-08T10:05:18-04:00",
  "date_modified": "2026-06-02T21:22:49-04:00",
