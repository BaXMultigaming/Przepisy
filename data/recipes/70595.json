  "ingredients": [
    "0.5 cup unsweetened cocoa powder",
    "2 cups white sugar",
    "0.25 teaspoon salt",
    "1 tablespoon light corn syrup",
    "1 cup milk",
    "1 tablespoon vanilla extract",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "In a medium saucepan, stir together cocoa powder, sugar, and salt. Mix in corn syrup and milk until well blended. Add butter, and heat to between 235 and 240 degrees F (112 to 116 degrees C), or until a small amount of syrup dropped into cold water forms a soft ball that flattens when removed from water and placed on a flat surface. Occasionally stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat, and beat with a wooden spoon until mixture is thick and loses its gloss. Stir in vanilla, and pour into a buttered 9x9-inch baking dish. Let cool until set. Cut into small squares to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
