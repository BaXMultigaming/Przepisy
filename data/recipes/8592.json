  "ingredients": [
    "2 whole skinless, boneless chicken breasts",
    "salt and pepper to taste",
    "1 cup mayonnaise",
    "1 cup chopped fresh basil",
    "2 cloves crushed garlic",
    "3 stalks celery, chopped",
    "0.66666668653488 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Season chicken with salt and pepper. Roast at 375 degrees F (190 degrees C) for 35 minutes, or until juices run clear. Let cool, and chop into chunks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a food processor, puree the mayonnaise, basil, garlic, and celery.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the chunked chicken, pureed mixture, and Parmesan cheese; toss. Refrigerate, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
