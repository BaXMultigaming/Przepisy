  "ingredients": [
    "20 unbaked frozen dinner rolls",
    "1 cup brown sugar",
    "0.25 cup instant vanilla pudding mix",
    "2 teaspoons ground cinnamon",
    "0.75 cup raisins",
    "0.33333298563957 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Lightly grease a 10-inch Bundt pan. Place frozen rolls into the prepared pan and sprinkle with brown sugar, pudding mix, and cinnamon. Top with raisins. Pour melted butter over rolls. Cover the pan with a clean, damp dish cloth and let sit at room temperature for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 25 minutes. Turn rolls out onto a serving plate and serve warm.",
