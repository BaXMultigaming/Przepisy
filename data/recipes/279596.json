  "ingredients": [
    "1 cup soy sauce",
    "0.75 cup white sugar",
    "0.5 red onion, thinly sliced",
    "1 tablespoon sesame seeds",
    "1 tablespoon sesame oil",
    "1 teaspoon chopped garlic",
    "1 teaspoon ground ginger",
    "3 pounds boneless country-style ribs"
  ],
  "steps": [
    {
      "text": "Mix together soy sauce and sugar in a microwave-safe bowl and microwave on high for 2 minutes. Stir in onion, sesame seeds, sesame oil, garlic, and ginger until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice pork into 1/4-inch cutlets and place in a marinating pan or dish, spreading out evenly. Pour soy sauce marinade over pork and refrigerate for at least 4 to 5 hours; overnight is better if you cut them thicker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pork from marinade and spread evenly on a nonstick, oven-proof pan. Reserve marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into center of pork reaches 160 degrees F (71 degrees C), 15 to 20 minutes. Remove from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave remaining marinade on high until it begins to boil, about 2 minutes. Pour over pork to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
