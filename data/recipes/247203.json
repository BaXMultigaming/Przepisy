  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.75 cup cold water",
    "1 tablespoon vegetable oil",
    "oil for frying"
  ],
  "steps": [
    {
      "text": "Combine flour, baking powder, and salt in a bowl. Stir in cold water and vegetable oil until dough comes together into a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set dough on a floured surface. Pinch off ten pieces the size of golf balls, roll into balls, and flatten each into a round. Make a small hole in the center of each round.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a deep skillet with oil to 3/4 inch; heat over medium-high heat. Add dough rounds in batches and fry until golden brown, about 20 seconds per side. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
