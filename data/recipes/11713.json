  "ingredients": [
    "1 (16 ounce) package penne pasta",
    "0.25 cup low fat margarine",
    "2.5 cups shredded reduced fat Colby cheese",
    "1 (28 ounce) can diced tomatoes with green chile peppers",
    "1 tablespoon white sugar",
    "0.5 teaspoon salt"
  ],
