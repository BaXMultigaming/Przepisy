  "ingredients": [
    "0.5 pound skinless, boneless chicken breast",
    "0.5 cup all-purpose flour",
    "1 teaspoon adobo seasoning",
    "0.5 teaspoon granulated garlic",
    "2 cups corn flakes cereal",
    "1 teaspoon taco seasoning mix",
    "1 serving cooking spray"
  ],
  "steps": [
    {
      "text": "Trim chicken breast of any visible fat and cut into bite-sized pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, adobo seasoning, and garlic in a resealable plastic bag. Shake well. Add chicken pieces and toss to coat. Refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C) for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cornflakes to the bowl of a food processor and process to the texture of flour, about 20 seconds. Measure out 1/2 cup. Season cornflake 'flour' with taco seasoning and mix well. Transfer into a resealable plastic bag and add seasoned chicken. Shake well. Transfer chicken pieces to the air fryer basket. Lightly coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry for 5 minutes. Shake the basket and spray chicken again with cooking spray. Air fry for 5 minutes more. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
