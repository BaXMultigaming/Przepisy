  "ingredients": [
    "0.5 ripe avocado",
    "0.25 cup mayonnaise",
    "2 ciabatta rolls",
    "1 tablespoon olive oil, divided",
    "2 slices provolone cheese",
    "1 cup whole fresh spinach leaves, divided",
    "0.25 pound thinly sliced mesquite smoked turkey breast",
