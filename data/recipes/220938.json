  "ingredients": [
    "1 (18.25 ounce) package lemon cake mix",
    "4 eggs",
    "0.5 cup vegetable oil",
    "1 cup apricot nectar",
    "2 cups confectioners' sugar",
    "0.5 cup lemon juice, or as needed",
    "1 teaspoon lemon zest, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a 9x13-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix lemon cake mix, eggs, and vegetable oil in a bowl until thoroughly combined. Stir apricot nectar into the batter and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the cake is lightly browned at the edges and the top springs back when lightly pressed, about 30 minutes. A toothpick inserted into the center of the cake should come out clean or with moist crumbs. Check for doneness after 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool cake completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix confectioners' sugar with lemon juice, mixing juice in about 1 tablespoon at a time, until the frosting is fluid and easy to spread. Frosting should run slightly but not be a thin runny glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread frosting on cooled cake and sprinkle with lemon zest to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
