    "1 cup rye flour",
    "2.25 cups bread flour",
    "0.5 cup cornmeal",
    "1.5 tablespoons white sugar",
    "1.5 tablespoons dried thyme",
    "1.5 teaspoons salt",
    "1 cup water",
    "2 cups grated carrots",
    "3 tablespoons vegetable oil"
