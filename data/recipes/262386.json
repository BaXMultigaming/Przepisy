  "ingredients": [
    "cooking spray",
    "2 cups cubed ham",
    "2 cups cubed Gouda cheese",
    "3 hard-boiled eggs, chopped",
    "12 empanada pastry discs",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C). Grease 2 baking sheets with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ham, Gouda cheese, and hard-boiled eggs in a bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange pastry disks on a flat surface; dab a little water around the rims. Place a large tablespoonful of ham and cheese mixture in the center; fold pastry over and press edge with a fork to seal well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place empanadas on the prepared baking sheets. Brush with beaten egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 20 to 25 minutes. Let cool for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
