  "ingredients": [
    "1.5 cups white sugar",
    "0.75 cup all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking powder",
    "0.75 cup butter, melted",
    "3 eggs",
    "1 teaspoon vanilla extract",
    "2 cups chocolate-coated caramel-peanut nougat candy (such as Snickers®), chopped, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, flour, cocoa powder, salt, and baking powder together in a mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter, eggs, and vanilla extract together in a separate bowl; add butter mixture to the bowl with the flour mixture and stir batter until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/2 the batter into the prepared baking pan. Top with 1/2 the candy bar pieces. Spread remaining batter on top, covering candy completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are brown and center is set, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove brownies from the oven and spread remaining candy bar pieces on top, lightly pressing them in while the brownies are still hot. Let brownies cool completely before serving, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
