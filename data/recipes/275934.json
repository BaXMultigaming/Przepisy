  "ingredients": [
    "2 potatoes, cut into bite-sized chunks",
    "2 sweet potatoes, cut into bite-sized chunks",
    "3 tablespoons butter",
    "2 pinches salt",
    "0.5 cup dates, pitted and chopped",
    "0.25 cup pumpkin seeds",
    "1 tablespoon brown sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Place potatoes and sweet potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer just until fork-tender, about 15 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Sprinkle potatoes and sweet potatoes with salt and cook until beginning to brown, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in dates, pumpkin seeds, brown sugar, and cinnamon. Cook and stir until dates are warm and pumpkin seeds begin to brown, 1 to 2 minutes. Remove from heat and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
