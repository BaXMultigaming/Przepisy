  "ingredients": [
    "0.5 cup butter",
    "2 cups milk",
    "1 cup all-purpose flour",
    "2 eggs",
    "2 tablespoons white sugar",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Place butter in a 9x13-inch baking dish and place in the preheating oven until melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk, flour, eggs, sugar, and salt together in a bowl until batter is smooth. Pour melted butter from baking dish into batter and beat until smooth. Pour batter into the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
