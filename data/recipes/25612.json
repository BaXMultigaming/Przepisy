      "image": "assets/images/25612/step_04.webp"
    },
    {
      "text": "Beat in sour cream and water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GvBasuQ9suBl4QB9TiIu2XKIKmE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25612-NoFailPoundCake-ddmfs-Step5-3x4-7751-9f9831d354e04ff4a767564b8d9bfd88.jpg"
