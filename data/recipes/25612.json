  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "3 large eggs",
    "1 teaspoon vanilla extract",
    "1 teaspoon lemon extract",
    "1 (8 ounce) container sour cream",
    "0.66670000553131 cup water",
    "1 (15.25 ounce) package yellow cake mix",
    "1 cup all-purpose flour"
  ],
