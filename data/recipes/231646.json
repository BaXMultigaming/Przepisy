  "ingredients": [
    "1 cup diced celery",
    "5 tablespoons butter",
    "1 onion, chopped",
    "0.5 green bell pepper, chopped",
    "6 tablespoons all-purpose flour",
    "1 (10.75 ounce) can cream of mushroom soup",
    "1 (10.75 ounce) can milk",
    "1 (6 ounce) can mushrooms",
    "3 cups diced cooked turkey",
    "1 (4 ounce) jar chopped pimento peppers",
    "0.5 cup slivered almonds",
    "salt to taste",
    "1 cup soft bread crumbs",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add celery and cook until tender, 5 to 10 minutes. Drain well and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add onion and bell pepper; cook and stir until softened, 5 to 10 minutes. Whisk flour into the onion mixture until a paste forms. Add condensed mushroom soup, milk, and drained mushrooms; cook and stir until smooth and thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in turkey, cooked celery, pimentos, almonds, and salt. Cook and stir until heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the mixture into a 2-quart casserole dish. Top with bread crumbs and sprinkle with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the casserole is bubbly and the cheese is melted and golden, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
