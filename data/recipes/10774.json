  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.75 cups rolled oats",
    "1 cup white sugar",
    "0.5 cup raisins",
    "0.5 cup semisweet chocolate chips",
    "0.5 cup chopped walnuts",
    "0.5 cup melted shortening",
    "0.5 cup melted butter",
    "1 egg",
    "0.25 cup milk",
    "1 tablespoon molasses"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl stir together flour, cinnamon, baking soda and salt. Stir in remaining ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoon 1-1/2 inches apart on ungreased sheets (Make the cookies small). Bake for 12 minutes or until brown.",
