  "ingredients": [
    "2 tablespoons chili oil",
    "3 hot chile peppers",
    "2 cloves garlic",
    "1 pound skinless, boneless chicken breast halves - cut into bite-size pieces",
    "1.5 teaspoons white sugar",
    "1 teaspoon garlic salt",
    "1 teaspoon black pepper",
    "1 cup fresh mushrooms",
    "1 cup chopped onions",
    "5 tablespoons oyster sauce",
    "1 bunch fresh basil leaves"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add chile peppers and garlic; cook until fragrant and just beginning to brown. Add chicken, sugar, garlic salt, and black pepper; cook until chicken is no longer pink but not cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add mushrooms, onion, and oyster sauce; cook until onion is tender and chicken juices run clear. Off heat, stir in basil. Let sit before serving for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
