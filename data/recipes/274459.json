  "ingredients": [
    "2.5 cups graham cracker crumbs",
    "0.5 cup white sugar",
    "0.66666668653488 cup melted butter",
    "2 cups mini chocolate chips",
    "0.5 cup chopped walnuts",
    "14 graham crackers",
    "2 cups miniature marshmallows",
    "0.33333334326744 cup chocolate syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix graham cracker crumbs and sugar together in a bowl. Add melted butter and toss until combined. Press mixture into the bottom of a 9x13-inch baking pan in an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread chocolate chips evenly over the graham cracker mixture. Sprinkle walnuts over chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay 7 graham crackers evenly into the pan, then pour the mini marshmallows on top of the graham crackers in an even layer. Lay remaining graham crackers over marshmallows, then drizzle chocolate syrup on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Let cool at least 30 minutes before cutting and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
