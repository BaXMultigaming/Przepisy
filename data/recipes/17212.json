  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "2 (10.5 ounce) cans condensed cream of chicken soup",
    "0.5 cup grated Parmesan cheese",
    "0.25 cup mayonnaise",
    "1 teaspoon curry powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place chicken into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix condensed soup, Parmesan, mayonnaise, and curry powder together in a bowl until well combined; pour over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake in the preheated oven for 25 minutes. Uncover and continue to bake until chicken is no longer pink in the center and the juices run clear, 10 to 15 more minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
