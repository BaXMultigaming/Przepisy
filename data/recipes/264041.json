  "ingredients": [
    "cooking spray",
    "1 pint fresh blueberries",
    "2 teaspoons white sugar",
    "0.5 teaspoon cornstarch",
    "0.5 teaspoon water",
    "4 tablespoons butter, cut into 4 pieces",
    "2 cups lemon cake mix"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray 4 ramekins with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place blueberries into a bowl. Add sugar, water, and cornstarch. Stir gently until well mixed, 30 seconds to 1 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide the blueberries evenly among the ramekins, filling them about 3/4 to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a large, microwave-safe bowl until melted, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir lemon cake mix into the butter to combine; mixture will still be a little dry and lumpy. Scoop about 1/2 cup of the mixture into each ramekin. Spray tops lightly with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are lightly browned, 25 to 30 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
