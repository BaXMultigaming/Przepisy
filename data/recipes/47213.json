  "ingredients": [
    "8 cups spelt flour",
    "4.25 cups milk",
    "0.5 cup sesame seeds",
    "1 tablespoon blackstrap molasses",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine spelt flour, milk, sesame seeds, molasses, baking soda, and salt in a large bowl until well blended; divide batter evenly between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 1 hour and 10 minutes.",
