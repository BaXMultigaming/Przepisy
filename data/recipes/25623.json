  "ingredients": [
    "0.5 cup butter, softened",
    "3.5 cups confectioners' sugar",
    "1 pinch salt",
    "2 tablespoons orange juice",
    "2 tablespoons light corn syrup",
    "2 teaspoons vanilla extract",
    "2 drops orange food coloring"
  ],
  "steps": [
    {
      "text": "In a large bowl, beat softened butter, confectioners' sugar and salt until smooth. Add orange juice, corn syrup and vanilla. Beat until smooth and creamy. Tint with orange food coloring.",
