  "ingredients": [
    "1 (14 ounce) can hearts of palm, drained and chopped",
    "1 tablespoon avocado oil",
    "1 teaspoon seafood seasoning (such as Old Bay®)",
    "1 pinch salt and ground black pepper to taste",
    "0.25 cup vegan mayonnaise (such as Vegenaise®)",
    "1 stalk celery, minced",
    "0.5 shallot, minced",
    "1 lemon, zested and juiced",
    "2 teaspoons capers",
    "0.5 teaspoon dried dill weed",
    "0.5 teaspoon sesame seeds",
    "2 sandwich rolls, split",
    "2 teaspoons olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat hearts of palm dry and place in a medium bowl. Toss with avocado oil and coat with seafood seasoning; season with salt and pepper. Transfer to a baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together vegan mayonnaise, celery, shallot, lemon zest, juice of 1/4 lemon, capers, dill, and sesame seeds in a large bowl until well combined; season with salt. Add roasted hearts of palm and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush the tops of sandwich rolls with olive oil. Toast in a large skillet over medium-high heat until lightly browned, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add hearts of palm mixture evenly to each toasted roll to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
