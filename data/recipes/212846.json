  "ingredients": [
    "4 cups M&M'S® Brand MINIS® Chocolate Candies",
    "1 (18 ounce) package refrigerated sugar cookie dough",
    "0.66666668653488 cup all-purpose flour",
    "1 (16 ounce) can vanilla frosting",
    "1 (14 ounce) package red licorice laces"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead the flour into the cookie dough until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll the dough out to 1/4-inch thickness. By hand, or using a Christmas light cookie cutter, cut out shapes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With a spatula, gently transfer the cookies to a baking sheet. Using a drinking straw, press a hole at the top of each cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 minutes. Transfer to a wire rack and let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate different colors of M&M'S® Brand Chocolate Candies, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread vanilla frosting on top of each cookie. Arrange a solid color of M&M'S® Brand Chocolate Candies on top of each cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let the cookies dry for 30 minutes. Run licorice laces through each hole, connecting the cookies into one continuous strand.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
