  "ingredients": [
    "0.5 cup fine Italian bread crumbs",
    "0.25 cup grated Parmesan cheese",
    "1 teaspoon dried parsley",
    "0.5 teaspoon garlic salt",
    "0.5 teaspoon ground black pepper",
    "0.5 cup olive oil",
    "16 large sea scallops"
  ],
  "steps": [
    {
      "text": "Mix bread crumbs, Parmesan cheese, parsley, garlic salt, and black pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour olive oil into a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse scallops under cold water, then dip into the olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press scallops into bread crumb mixture. Gently toss between your hands so any bread crumbs that haven't stuck can fall away. Place the breaded scallops onto a plate while breading the rest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the scallops in the refrigerator to allow the breading to set, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat, and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush the scallops lightly with more olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill on the preheated grill until golden brown on both sides, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
