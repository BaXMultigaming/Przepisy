  "ingredients": [
    "3 tablespoons chopped onion",
    "1 tablespoon vegetable oil",
    "1 (10.75 ounce) can condensed tomato soup",
    "1 teaspoon chili powder",
    "0.5 teaspoon salt",
    "1 teaspoon Worcestershire sauce",
    "1.5 cups egg noodles",
    "1.25 cups shredded sharp Cheddar cheese",
    "1 (5 ounce) can tuna, drained"
  ],
  "steps": [
    {
      "text": "Cook noodles in a pot of boiling water until done. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, saute onion in oil. Add undiluted soup, chili powder, salt, and Worcestershire sauce. Simmer 5 minutes. Mix in noodles, 1 cup cheese, and tuna. Spoon into a greased 1 quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 30 minutes. While still hot, sprinkle with remaining 1/4 cup cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
