  "ingredients": [
    "2 cups biscuit mix",
    "0.67 cup milk",
    "0.5 cup shredded Cheddar cheese",
    "2 tablespoons butter, melted",
    "0.125 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Measure biscuit mix into a large bowl. Stir in milk and cheese until a soft dough forms. Drop 9 spoonfuls of the dough onto prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 8 to 10 minutes, until golden brown. While biscuits bake stir together butter and garlic powder. Remove biscuits from oven and brush with butter mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
