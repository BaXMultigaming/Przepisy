  "title": "Michelle&#39;s Soft Sugar Cookies",
  "description": "These soft sugar cookies make the best holiday cutouts using simple pantry ingredients. They are made with margarine and have a light vanilla flavor",
  "authors": [
    "MISSMR94"
  ],
  "date_published": "1999-01-11T09:44:43-05:00",
