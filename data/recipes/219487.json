  "ingredients": [
    "0.5 cup vegetable oil",
    "0.5 cup white sugar",
    "0.25 cup wine vinegar",
    "1 tablespoon soy sauce",
    "2 (3 ounce) packages ramen noodles (without flavor packets), lightly crushed",
    "1 cup sesame seeds",
    "0.5 cup slivered almonds",
    "1 head napa cabbage, chopped",
    "1 bunch green onions, chopped"
  ],
  "steps": [
    {
      "text": "Make the dressing: Whisk oil, sugar, vinegar, and soy sauce together in a bowl until sugar dissolves. Refrigerate until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread broken ramen noodles onto a baking sheet with sesame seeds and almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring often and watching carefully to prevent burning, until lightly browned, about 15 minutes. Remove from the oven and let cool for 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To serve, mix cabbage, green onions, and toasted ramen mixture together in a salad bowl until thoroughly combined. Add dressing and toss to coat.",
