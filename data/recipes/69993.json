  "ingredients": [
    "0.5 cup chicken broth",
    "0.25 cup white wine",
    "0.5 lemon, juiced",
    "1 tablespoon minced shallot",
    "1 clove garlic, minced",
    "0.25 cup butter",
    "1 pound sea scallops",
    "1 tablespoon olive oil",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet over medium heat, mix the chicken broth, wine, lemon juice, shallot, and garlic. Cook and stir until most of the liquid has been reduced. Stir in the butter until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush the scallops with olive oil, and season with salt and pepper. Arrange on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil the scallops in the preheated oven about 2 minutes on each side, or until opaque. Serve with the wine sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
