  "ingredients": [
    "4 ears fresh corn",
    "2 tablespoons butter",
    "1 small sweet onion, diced",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Cut corn kernels from cob. Melt butter in a medium skillet over medium heat. Sauté corn kernels just until tender, then mix in onion. Continue to sauté until onion is just beginning to turn crispy. Season with salt and pepper. Enjoy warm or cold.",
