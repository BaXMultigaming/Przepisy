  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup oat bran",
    "1 tablespoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup brown sugar",
    "0.25 cup butter, softened",
    "1 egg, beaten",
    "1 teaspoon vanilla extract",
    "1 cup mashed ripe bananas",
    "0.5 cup almond milk",
    "0.5 cup chopped fresh cranberries",
    "1 cup coarsely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 muffin tins with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, oat bran, baking powder, baking soda, and salt together into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, butter, egg, and vanilla extract together in a bowl until smooth. Beat in bananas, almond milk, and cranberries. Fold in flour mixture. Stir walnuts into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each muffin liner with 1 tablespoon batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes. Transfer to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
