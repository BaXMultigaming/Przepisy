  "ingredients": [
    "3 cups sliced fresh strawberries",
    "0.5 cup white sugar",
    "1 tablespoon cornstarch",
    "1 teaspoon ground cinnamon",
    "0.75 cup all-purpose flour",
    "0.25 cup packed light brown sugar",
    "2 tablespoons white sugar",
    "2 tablespoons quick-cooking oats",
    "1.5 teaspoons ground cinnamon, divided",
    "0.25 teaspoon salt",
    "0.5 cup unsalted butter, melted, divided",
    "0.125 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sliced strawberries into a bowl. Add sugar, cornstarch, and cinnamon; mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, both sugars, oats, 1/2 teaspoon cinnamon, and salt for topping in another bowl until combined. Add 1/4 cup melted butter and stir until thoroughly combined and crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1/4 cup melted butter, milk, and remaining 1 teaspoon cinnamon in a small dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the strawberry mixture into the prepared baking dish and sprinkle crumb mixture over top. Pour butter mixture over the crumb topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven on the convection setting until topping is golden brown, 30 to 40 minutes. Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
