  "ingredients": [
    "0.25 cup butter",
    "1 head cabbage, cored and chopped",
    "1 large onion, diced",
    "1 (12 ounce) package farfalle (bow tie) pasta",
    "2 tablespoons water",
    "1.5 cups cooked ham, cut into bite-size pieces",
    "2 pinches white sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium-low heat; cook and stir cabbage and onion until very tender, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in bow tie pasta and return to a boil. Cook pasta until tender but still slightly firm, about 12 minutes. Drain well and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water and cooked ham into cabbage mixture; heat through. Thoroughly mix in sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently stir bow tie pasta into the ham and cabbage and heat through.",
      "section": null,
