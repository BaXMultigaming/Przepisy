  "ingredients": [
    "1 (1 pound) loaf French bread",
    "2 cups shredded Cheddar cheese",
    "2 cups chopped cooked ham",
    "1 (8 ounce) container sour cream",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup chopped green onions",
    "0.25 cup chopped green chile peppers",
    "2 small jalapeno peppers, chopped, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut top off bread loaf; keep top in one piece, and reserve for later use. Hollow out loaf to make room for filling; chop hollowed out bread for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Cheddar cheese, ham, sour cream, cream cheese, green onions, green chiles, and jalapeños in a bowl; spoon into hollowed bread loaf. Top loaf with reserved bread top; wrap loaf with 2 pieces aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is cooked through and bubbling, about 1 hour 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
