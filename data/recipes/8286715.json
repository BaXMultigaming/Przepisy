  "ingredients": [
    "cooking spray",
    "1 pound lean ground turkey",
    "0.5 cup Italian-style seasoned bread crumbs",
    "0.5 cup grated Parmesan cheese",
    "1 large egg",
    "1 tablespoon Italian seasoning",
    "1 teaspoon chopped garlic",
    "1 teaspoon ground black pepper",
    "1 teaspoon salt",
    "1 (8 ounce) can tomato sauce",
    "0.5 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 9-inch square baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together turkey, bread crumbs, Parmesan cheese, egg, Italian seasoning, garlic, pepper, and salt in a medium bowl until well combined. Form mixture into a loaf and place in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Pour tomato sauce over the meatloaf and bake for 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle mozzarella cheese over top and bake until cheese is melted and an instant-read thermometer inserted into the center of the meatloaf reads at least 160 degrees F (71 degrees C), about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
