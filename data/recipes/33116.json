  "ingredients": [
    "0.5 cup whole wheat flour",
    "0.5 cup all-purpose flour",
    "2 tablespoons brown sugar",
    "2 tablespoons baking powder",
    "0.75 teaspoon salt",
    "1.5 cups quick cooking oats",
    "2 cups soy milk",
    "3 eggs, beaten",
    "0.25 cup olive oil",
    "0.5 cup frozen blueberries"
  ],
  "steps": [
    {
      "text": "Preheat a lightly oiled griddle over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix whole wheat flour, all-purpose flour, brown sugar, baking powder, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix oats and soy milk. Whisk in eggs and olive oil. Pour into the flour mixture all at once. Continue mixing until smooth. Gently fold in blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter about 1/4 cup at a time onto the prepared griddle. Cook 1 to 2 minutes, until bubbly. Flip, and continue cooking until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
