  "ingredients": [
    "0.75 cup white sugar",
    "0.5 cup solid coconut oil",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup chocolate chips",
    "1 cup sweetened coconut flakes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line baking sheets with parchment paper or nonstick baking mats",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and coconut oil together until light and fluffy. Mix in egg and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a medium bowl. Mix into the oil and sugar mixture. Stir in chocolate chips and coconut flakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop cookie dough by the tablespoon onto the prepared baking sheets, leaving about 1 1/2 inches between each cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the cookies have turned slightly brown and are set, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
