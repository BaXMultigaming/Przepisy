  "ingredients": [
    "3 cups cooked, mashed sweet potatoes",
    "1 cup white sugar",
    "0.5 cup milk",
    "0.33333334326744 stick unsalted butter, cut into pieces and softened",
    "2 large eggs, slightly beaten",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "1 cup brown sugar",
    "0.33333334326744 cup all-purpose flour",
    "1 cup chopped pecans",
    "1 cup shredded coconut",
    "0.33333334326744 stick unsalted butter, cut into pieces and softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 1 1/2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mashed sweet potatoes, white sugar, milk, butter, eggs, vanilla extract, and salt together; transfer potato mixture to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar and flour for topping together in a large bowl. Add pecans, coconut, and butter; mix until well combined. Sprinkle over the casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is golden brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
