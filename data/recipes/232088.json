  "ingredients": [
    "1 head cauliflower, cut into florets",
    "0.5 cup whipped cream cheese",
    "2 cloves garlic, minced",
    "1 teaspoon seasoned salt (such as LAWRY'S®), or to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook cauliflower in boiling water until tender, about 6 minutes; drain. Pat cauliflower dry with paper towel to remove as much moisture as possible.",
