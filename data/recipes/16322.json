  "ingredients": [
    "2 (9 inch) pie shell",
    "4 eggs, beaten",
    "1.5 cups white sugar",
    "0.5 cup butter, melted and cooled",
    "1 tablespoon distilled white vinegar",
    "1 tablespoon vanilla extract",
    "1 teaspoon lemon juice",
    "1 cup chopped pecans",
    "1 cup shredded coconut",
    "1 cup golden raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl combine eggs, sugar, and butter. Beat until smooth. Add vinegar, vanilla, and lemon juice. Mix thoroughly. Fold in pecans, coconut, and raisins. Pour mixture into pie shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 40 minutes or until completely set in center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
