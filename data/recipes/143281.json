  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup butter, softened",
    "1 cup confectioners' sugar",
    "0.5 teaspoon raspberry extract",
    "1 tablespoon seedless raspberry jam"
  ],
  "steps": [
    {
      "text": "Beat cream cheese and butter in a bowl with an electric mixer until smooth. Add confectioners' sugar and raspberry extract; beat until smooth. Fold in raspberry jam.",
