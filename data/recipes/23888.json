  "ingredients": [
    "1 pound ground turkey, browned",
    "1 cup medium salsa",
    "1 cup frozen corn kernels",
    "1 cup water",
    "2 (14 ounce) cans great Northern beans, rinsed and drained",
    "12 ounces pepper jack cheese, cubed"
  ],
  "steps": [
    {
      "text": "In a large pot over medium-high heat, cook ground turkey until browned and crumbly, 7 to 10 minutes. Drain and discard grease.",
