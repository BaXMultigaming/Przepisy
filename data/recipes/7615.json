  "ingredients": [
    "1/2 cup butter",
    "1/2 cup unsweetened applesauce",
    "2 large eggs",
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "2 teaspoons ground cinnamon",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "4 cups diced apple without peel"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lm7wFeNiQ71a-1nrXsrtTcqEuEs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7615-apple-cake-ddmfs-step1-3x4-10312-7abdddf0111b49318d5e0f9a8f64d215.jpg"
      ],
      "image": "assets/images/7615/step_01.webp"
    },
    {
      "text": "Beat butter, applesauce, and eggs together in a large bowl with an electric mixer until foamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GnxVL1vbAyUBkDNXUCnJ1qGbLCk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7615-apple-cake-ddmfs-step2-3x4-10315-27ff7c0041ff4e589f47293f58ed5c7d.jpg"
      ],
      "image": "assets/images/7615/step_02.webp"
    },
    {
      "text": "Add flour, brown sugar, cinnamon, vanilla, baking powder, baking soda, and salt; mix until well combined. Stir in apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bTaFegsi3iBBjYe6zE04IQ-z_z4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7615-apple-cake-ddmfs-step4-3x4-10317-e17c9c67d41948e8bab3b59a7fcc0bc8.jpg"
      ],
      "image": "assets/images/7615/step_03.webp"
    },
    {
      "text": "Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9mbqHywhwxRVv2-xNmnTFGxTe5c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7615-apple-cake-ddmfs-step5-3x4-10318-313c3cca665f49e7b06d83a361595840.jpg"
      ],
      "image": "assets/images/7615/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, 25 to 30 minutes. Cool in the pan for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8pU-OGPBPw1gXekcdUwRv83paNI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7615-apple-cake-ddmfs-step7-3x4-10368-ab6e29c890e74d92ad8bf74f19c52548.jpg"
