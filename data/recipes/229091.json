  "ingredients": [
    "4 (4 ounce) skinless, boneless salmon fillets",
    "0.5 cup vegan margarine (such as Smart Balance®), melted",
    "1 lemon, halved",
    "0.25 cup balsamic vinegar",
    "2 tablespoons soy sauce",
    "2 tablespoons white sugar",
    "0.5 teaspoon minced garlic",
    "0.5 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip salmon fillets in melted margarine, covering both sides. Place in a baking dish. Squeeze lemons evenly over each fillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk balsamic vinegar, soy sauce, sugar, and garlic together in a bowl; spoon over salmon fillets. Sprinkle with parsley; drizzle any remaining butter over fillets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish is opaque and flakes easily with a fork, about 30 minutes. Remove from oven and cover with aluminum foil for 3 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
