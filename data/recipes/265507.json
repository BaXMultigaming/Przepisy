  "ingredients": [
    "1 (16 ounce) package light brown sugar",
    "2 sticks butter, at room temperature",
    "3 eggs",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "1 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a fluted tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and butter in a large bowl; beat with an electric mixer until creamy. Beat in eggs one at a time, mixing well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, and salt together in a separate bowl. Stir vanilla and almond extract into buttermilk. Add flour and buttermilk mixtures alternately to creamed butter mixture, beating well between additions. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
