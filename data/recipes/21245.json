  "ingredients": [
    "1 small head cabbage, shredded",
    "4 potatoes, peeled and sliced",
    "salt to taste",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "0.5 (10.75 ounce) can water",
    "1 small onion, diced",
    "4 pork chops"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a layer of shredded cabbage into baking dish and then a layer of sliced potatoes. Repeat cabbage and potatoes and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Simmer the soup, water and diced onion. Pour over cabbage and potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet, brown each pork chop in a small amount of oil and place on top of mixture. Bake for 1 1/2 hours uncovered or until chops are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
