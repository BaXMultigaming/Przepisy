  "ingredients": [
    "1 (14 ounce) package coleslaw mix, divided",
    "1 (10 ounce) bag shredded carrots, divided",
    "6 ounces shiitake mushrooms, sliced",
    "3 cloves garlic, minced",
    "0.75 cup hoisin sauce, divided",
    "3 tablespoons reduced-sodium soy sauce",
    "0.75 pound boneless pork loin roast",
    "12 (6 inch) flour tortillas",
    "1 bunch green onions, chopped",
    "2 tablespoons sesame oil"
  ],
  "steps": [
    {
      "text": "Place 1/2 of the coleslaw mix and 1/2 of the carrots in a slow cooker. Add mushrooms; toss to combine. Stir in garlic. Add 1/2 cup hoisin sauce and soy sauce and stir to combine. Place pork on top of vegetables. Cover and cook on Low until pork is fork-tender, 4 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred pork using 2 forks. Add remaining coleslaw mix, carrots, and 1/4 cup hoisin sauce to the slow cooker; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tortillas on a skillet over medium-high heat, about 10 seconds per side. Divide pork mixture among tortillas. Top with green onions and sesame oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
