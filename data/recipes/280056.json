  "ingredients": [
    "1 cup packed light brown sugar",
    "1 cup applesauce",
    "1 large egg",
    "1.5 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1.5 cups frozen raspberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar, applesauce, and egg in a bowl until well combined. Add flour, baking soda, cinnamon, and salt; stir until just combined. Fold in raspberries gently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a disher scoop to portion uniform amounts of batter into the prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until muffins are golden brown and a toothpick inserted into the center comes out clean, 15 to 20 minutes. Remove muffins from the tin immediately and cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
