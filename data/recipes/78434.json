  "ingredients": [
    "2 teaspoons lemon pepper",
    "0.5 teaspoon dried marjoram",
    "1 teaspoon dried basil",
    "0.125 teaspoon dried thyme",
    "1 teaspoon dried rosemary",
    "0.25 cup white wine",
    "1 cup water",
    "2 tablespoons olive oil",
    "2 tablespoons Italian salad dressing",
    "2 cloves garlic, minced",
    "1 lemon, juiced",
    "1 tablespoon lemon zest",
    "6 medium potatoes, peeled and quartered"
  ],
  "steps": [
    {
      "text": "In a small bowl, mix the lemon pepper, marjoram, basil, thyme, and rosemary. In a separate bowl, mix the wine, water, olive oil, dressing, garlic, lemon juice, lemon zest, and 1/2 the seasoning mixture. Pour into a medium glass baking dish. Place potatoes in the dish, coat with the mixture, and sprinkle with remaining seasonings. Cover, and refrigerate 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake potatoes 1 hour and 15 minutes in the preheated oven, basting once half way through the bake time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
