  "title": "California Roll",
  "description": "A California roll is a fresh take on traditional Japanese rice rolls. Filled with avocado, crab, and cucumber, these make a fun, filling meal.",
  "authors": [
    "Allrecipes"
  ],
  "date_published": "2020-06-18T23:51:23-04:00",
