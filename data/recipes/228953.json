    "publisher-tested"
  ],
  "ingredients": [
    "4 cups water",
    "2 cups uncooked white rice",
    "0.5 cup seasoned rice vinegar",
    "1 teaspoon white sugar, or to taste",
    "1 teaspoon salt, or to taste",
    "0.25 pound cooked crab meat, drained of excess liquid and shredded",
    "1 tablespoon mayonnaise",
    "5 sheets nori (dry seaweed)",
    "1 avocado, sliced",
    "0.25 cup red caviar, such as tobiko",
    "1 English cucumber, seeded and sliced into strips",
    "2 tablespoons drained pickled ginger, for garnish",
    "2 tablespoons soy sauce, or to taste",
    "1 tablespoon wasabi paste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eIyDohjSAPciwSR9xHsZ2DTcFiI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-228953-CaliforniaRoll-ddmfs-Step1-3x4-7210-eee7aebcbe6c429b902cfac28976d4a7.jpg"
      ],
      "image": "assets/images/228953/step_01.webp"
    },
    {
      "text": "Wrap a sushi rolling mat completely in plastic wrap and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XInPTxLC-ZaOXX2eNMMqTacrAoQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-228953-CaliforniaRoll-ddmfs-Step2-3x4-7211-bdc9c52b9572473492bc8332a5636b38.jpg"
      ],
      "image": "assets/images/228953/step_02.webp"
    },
    {
      "text": "Bring water and rice to a boil in a saucepan over high heat. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 20 to 25 minutes. Transfer rice to a bowl and cut in vinegar using a rice paddle or wooden spoon. Season with sugar and salt. Allow to cool to room temperature, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Pp_kjZd9FR-30e94dKVB8RQuz0c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-228953-CaliforniaRoll-ddmfs-Step3-3x4-7212-78223e16c17c4b54a60aa05b03fbdbb9.jpg"
      ],
      "image": "assets/images/228953/step_03.webp"
    },
    {
      "text": "Combine crab meat with mayonnaise in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EzQtseV4Zh5rYfu2ix5snsqD4QI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-228953-CaliforniaRoll-ddmfs-Step4-3x4-7215-34e6b3598b1e4ce2bccbb14f637ab1c5.jpg"
      ],
      "image": "assets/images/228953/step_04.webp"
    },
    {
      "text": "Place nori sheet on a flat work surface. Spread a thin layer of rice on top of nori.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rHLtTEEU46DewNV1v_2kzZGfwEw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-228953-CaliforniaRoll-ddmfs-Step6-3x4-7218-a1a04f74b92f4c6ca8f80f4dab557a7a.jpg"
      ],
      "image": "assets/images/228953/step_05.webp"
    },
    {
      "text": "Place nori, rice side down, on the prepared rolling mat. Place 2 to 3 avocado slices on top of the nori in one layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FqLy_FPVVfoX1LjM7iaYzELnotI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-228953-CaliforniaRoll-ddmfs-Step7-3x4-7220-0575617faca04a55b25bb1bf408a1723.jpg"
      ],
      "image": "assets/images/228953/step_06.webp"
    },
    {
      "text": "Top with 2 to 3 tablespoons of the crab mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/txD65w67I7qDObjG7ARZUB0JpuQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-228953-CaliforniaRoll-ddmfs-Step8-3x4-7222-cc7f5c1f24f446e5a18280f24084a59b.jpg"
      ],
      "image": "assets/images/228953/step_07.webp"
    },
    {
      "text": "Spoon 1 to 2 teaspoons tobiko lengthwise on one side of the avocado-crab mixture, and 2 cucumber strips on the other side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MIufS_tI7Kh9TdoUtrB4tlZ-xIY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-228953-CaliforniaRoll-ddmfs-Step9-3x4-7226-8e5d36c2a01a4fcd8f2b4775b88f3839.jpg"
      ],
      "image": "assets/images/228953/step_08.webp"
    },
    {
      "text": "Using the mat as a guide, carefully roll the California roll into a tight log. Remove the rolling mat. Top roll with more tobiko, cover with plastic wrap, and gently press the tobiko into the top of the roll.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_6QjBAaZcS2jD3Pg1q6VhJ8nyBk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-228953-CaliforniaRoll-ddmfs-Step11-3x4-7234-af8ed4373ca54dd382c0dd53042121f8.jpg"
      ],
      "image": "assets/images/228953/step_09.webp"
    },
    {
      "text": "Remove the plastic and cut into 6 even pieces using a wet knife. Repeat with remaining sheets of nori and filling. Serve garnished with pickled ginger, soy sauce, and wasabi paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t5GethjrEsN2_AZU6G9BRkEUhU0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-228953-CaliforniaRoll-ddmfs-3x4-7242-00f66632c593466ab42d6c4a26eb6588.jpg"
      ],
      "image": "assets/images/228953/step_10.webp"
    }
  ],
