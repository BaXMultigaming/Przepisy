  "ingredients": [
    "2 cups confectioners' sugar",
    "0.5 pound finely ground blanched almonds",
    "2 egg whites",
    "0.5 teaspoon salt",
    "0.5 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Blend confectioners' sugar, finely ground almonds, egg whites, salt, and almond extract in a food processor until smooth and mixture holds its shape, scaping down the sides of the bowl as needed. The marzipan will be slightly sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn marzipan out on work surface dusted with confectioners' sugar; knead briefly until smooth. Shape marzipan into a log and wrap tightly with plastic wrap. For best results, chill marzipan until firm, about 24 hours, before shaping or rolling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
