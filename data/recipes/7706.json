  "ingredients": [
    "1 cup white sugar",
    "0.25 cup butter",
    "1 egg",
    "2 cups cooked pinto beans, mashed",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.5 teaspoon ground allspice",
    "0.5 cup chopped pecans",
    "1 cup golden raisins",
    "2 cups diced apple without peel"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease one 9- or 10-inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar together. Add beaten egg and mix well. Stir in mashed cooked beans and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, salt, cinnamon, cloves, and allspice together. Add pecans, raisins, and apple to the flour mixture. Stir to coat. Pour flour mixture into the creamed mixture and stir until just combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
