  "ingredients": [
    "1 head purple cauliflower, cut into small florets",
    "1 medium lemon, zested and juiced",
    "1 cup grated Gouda cheese",
    "4 cloves garlic, minced",
    "1 tablespoon olive oil, or as needed",
    "salt and cracked black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place cauliflower into a covered container. Add a bit of lemon zest if desired and all of the lemon juice. Add enough oil to lightly coat florets. Add garlic, olive oil, salt, and pepper. Cover the container and shake well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Leave at room temperature to marinate for 1 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cauliflower to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until florets turn dark purple and start to brown, about 30 minutes. Sprinkle with Gouda cheese and bake for 5 more minutes. Serve immediately or save for later.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
