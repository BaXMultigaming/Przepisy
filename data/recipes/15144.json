  "ingredients": [
    "1 cup butter",
    "0.5 cup confectioners' sugar",
    "2 cups all-purpose flour",
    "1 teaspoon lemon zest",
    "0.5 teaspoon salt",
    "1 egg, beaten",
    "0.67 cup white sugar",
    "1.5 teaspoons lemon zest",
    "3 tablespoons lemon juice",
    "1.5 tablespoons butter"
  ],
  "steps": [
    {
      "text": "In a medium bowl, cream together butter and confectioners' sugar until light. Stir in the lemon peel, flour and salt. Cover bowl, and chill for about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flatten teaspoons of dough onto cookie sheets, and bake for 5 to 8 minutes, until light brown. Remove from baking sheets to cool on racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the filling, combine the beaten egg, sugar, lemon zest, lemon juice and butter in the top of a double boiler. Stir until thick. Sandwich cookies with 1 teaspoon of filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
