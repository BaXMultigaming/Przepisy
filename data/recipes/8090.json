  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "4 eggs",
    "1 ounce red food coloring",
    "0.5 cup vegetable oil",
    "1 cup water",
    "1 tablespoon distilled white vinegar",
    "1 tablespoon unsweetened cocoa powder",
    "1 cup cold milk",
    "1 (8 ounce) package cream cheese",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "1 (8 ounce) container frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cake mix, 1 box pudding mix, eggs, oil, food coloring, water, vinegar, and cocoa. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 35 to 40 minutes. Let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the frosting: Beat milk and cream cheese together until smooth. Beat in pudding mix until combined. Fold in whipped topping until no streaks remain. Spread frosting over the cooled cake. Refrigerate until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
