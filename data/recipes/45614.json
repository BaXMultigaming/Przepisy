  "ingredients": [
    "1 teaspoon vegetable oil",
    "3 slices bacon, diced",
    "1 medium onion, finely chopped",
    "1 cup tomato sauce",
    "0.5 cup black rum",
    "1 lemon, juiced",
    "0.33333298563957 cup brown sugar",
    "1 dash chili sauce"
  ],
  "steps": [
    {
      "text": "Place vegetable oil, bacon, and onion in a medium skillet over medium high heat. Cook until bacon is evenly brown and onion is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomato sauce and rum into the skillet with bacon and onion, and reduce heat. Simmer about 2 minutes. Mix in lemon juice, brown sugar, and chili sauce. Continue to simmer about 8 minutes.",
      "section": null,
