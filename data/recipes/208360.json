  "ingredients": [
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon ground cayenne pepper",
    "4 skinless, boneless chicken breast halves",
    "2 tablespoons olive oil",
    "1 red onion, minced",
    "2 tablespoons lime juice",
    "1 avocado, diced"
  ],
  "steps": [
    {
      "text": "Stir together 1 teaspoon salt, 1/4 teaspoon black pepper, and cayenne pepper in a small bowl until well combined; rub evenly into chicken breasts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat; cook chicken in hot oil until no longer pink in the center and the juices run clear, 5 to 7 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together onion, avocado, and lime juice in a medium bowl until combined; season with salt and pepper. Spoon over chicken breasts to serve.",
