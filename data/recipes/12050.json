  "ingredients": [
    "8 ounces pasta",
    "4 tablespoons olive oil",
    "2 tablespoons red wine vinegar",
    "0.5 cup whole corn kernels, cooked",
    "4 tomatoes, chopped",
    "0.5 cup chopped green onions",
    "1 teaspoon dried basil",
    "salt to taste",
    "ground black pepper to taste",
    "1 tablespoon grated Parmesan cheese",
    "2 teaspoons chopped fresh basil"
  ],
  "steps": [
    {
      "text": "In a large pot with boiling salted water cook pasta until al dente. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in a large bowl whisk together the olive oil, red wine vinegar, and dried basil. Add salt and pepper to taste. Stir in the tomatoes, corn kernels, and scallions. Let sit for 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss pasta with tomato mixture. Sprinkle with grated parmesan cheese. Garnish with fresh basil, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
