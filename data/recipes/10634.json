  "title": "Swedish Nut Bars",
  "description": "This very special cookie recipe delivers a Swedish-style treat with only four ingredients: eggs, sugar, walnuts, and almond extract.",
  "authors": [
    "Rosina"
  ],
  "date_published": "1998-03-06T02:20:44-05:00",
