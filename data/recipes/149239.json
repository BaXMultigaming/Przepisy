  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
