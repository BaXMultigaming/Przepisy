  "ingredients": [
    "1 cup butter",
    "1 (14 ounce) can sweetened condensed milk",
    "2.375 cups self-rising flour",
    "1.0625 cups unsweetened cocoa powder",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 (12 fluid ounce) can or bottle cola-flavored carbonated beverage"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter and dust with flour a 10 inch bundt tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream the butter or margarine till light and fluffy. Beat in the condensed milk. Combine the flour, cocoa powder, baking powder, and baking soda; mix into the creamed mixture alternately with the cola.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 45 minutes, or until the cake tests done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
