  "ingredients": [
    "1 (6 pound) bone-in ham",
    "1 pound brown sugar",
    "1 (8 ounce) jar yellow mustard",
    "24 dinner rolls, split"
  ],
  "steps": [
    {
      "text": "Place ham in a large pot or slow cooker and fill with enough water to cover. Bring to a boil, then reduce heat to low and simmer until fall-apart tender, 8 to 10 hours. Remove ham from water and allow to cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pull ham apart into shreds and place in the slow cooker. Stir in brown sugar and mustard. Cover and cook on Low until heated through, about 1 hour. Serve on dinner rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
