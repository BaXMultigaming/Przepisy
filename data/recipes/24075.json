  "title": "Chicken and Spinach Alfredo Lasagna",
  "description": "This creamy white chicken lasagna with shredded chicken, spinach, Alfredo sauce, and three Italian cheeses is a delicious twist on classic lasagna.",
  "authors": [
    "Sue"
  ],
  "date_published": "2019-04-02T02:42:27-04:00",
