  "ingredients": [
    "1 pound ground beef",
    "1 medium onion, chopped",
    "0.5 teaspoon chili powder",
    "1 (10.75 ounce) can Campbell's® Condensed Fiesta Nacho Cheese Soup",
    "8 taco shells, warmed",
    "1 cup shredded lettuce",
    "1 medium tomato, chopped"
  ],
  "steps": [
    {
      "text": "Cook and stir beef, onion, and chili powder in a 10-inch skillet over medium-high heat until beef is crumbly and well browned. Pour off any fat.",
