  "ingredients": [
    "1 (16 ounce) package penne pasta",
    "0.75 pound sliced pepperoni sausage",
    "2 tablespoons minced shallots",
    "1 clove garlic, minced",
    "4 medium tomato - peeled, seeded and chopped",
    "1 cup heavy whipping cream",
    "0.25 cup chopped fresh parsley",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Cook penne according to the package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, sauté pepperoni until crispy, 5 to 8 minutes. Drain all but 1 tablespoon grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add shallot and garlic to grease in the skillet. Cook until translucent. Stir in tomatoes and simmer for about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in cream and cook until reduced, about 8 minutes. Add parsley and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pasta and toss. Garnish with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
