  "ingredients": [
    "4 pounds tri-tip roast",
    "4 cloves garlic, peeled and very thinly sliced",
    "0.33333331346512 cup salt",
    "0.33333334326744 cup black pepper",
    "0.33333334326744 cup garlic salt"
  ],
  "steps": [
    {
      "text": "Using a sharp knife, cut small slits in the top of the roast; insert garlic slices into the slits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eV-BQMQbSkplrrDdEuh6xmABuaY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/139269-GrilledTriTip-ddmfs-Step1-0938-d75d74147abd4ef4bd64817db1cee141.jpg"
      ],
      "image": "assets/images/139269/step_01.webp"
    },
    {
      "text": "Mix salt, pepper, and garlic salt together in a small bowl; rub all over the tri-tip and refrigerate for at least 1 hour or up to 1 day. Remove tri-tip from the refrigerator about 20 minutes before grilling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gvCfpmXy3G5OhYBaq1EtowHKQmg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/139269-GrilledTriTip-ddmfs-Step2-0939-84baeada123c4101a167248cd1d21108.jpg"
      ],
      "image": "assets/images/139269/step_02.webp"
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the meat directly above the flame to sear the meat and lock in the juices, about 5 to 10 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BE12xX1YLf6dyA_GHwKSmrKbWlg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/139269-GrilledTriTip-ddmfs-Step3-0943-d72340b029bc4957a0947c5311daae4f.jpg"
      ],
      "image": "assets/images/139269/step_04.webp"
    },
    {
      "text": "Turn the grill down to medium heat and continue to cook, turning occasionally, for another 25 to 30 minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C) for medium-rare. Let stand, covered loosely with aluminum foil, for 5 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
