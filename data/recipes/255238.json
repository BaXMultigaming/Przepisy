  "ingredients": [
    "1 (32 ounce) carton gluten-free chicken broth",
    "1 pound skinless, boneless chicken thighs",
    "1 (14.5 ounce) can fire-roasted diced tomatoes",
    "1 onion, chopped",
    "2 carrots, chopped",
    "2 stalks celery, chopped",
    "0.5 cup water",
    "2 teaspoons minced garlic",
    "1 teaspoon dried basil leaves",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon red pepper flakes",
    "1 cup frozen mixed vegetables",
    "0.25 cup uncooked long-grain rice"
  ],
  "steps": [
    {
      "text": "Combine chicken broth, chicken thighs, diced tomatoes, onion, carrots, celery, water, garlic, basil, salt, pepper, and red pepper flakes in a slow cooker. Stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until chicken is tender and the flavors combine, about 7 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir to break up chicken. Add frozen vegetables and rice. Cover again and cook on High until rice is tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
