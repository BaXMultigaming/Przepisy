  ],
  "steps": [
    {
      "text": "Whisk water, milk, eggs, vegetable oil, and salt together in a bowl. Slowly whisk flour into wet ingredients until incorporated. Let batter rest for 1 hour; stir again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter by large spoonfuls onto the preheated griddle and cook until bubbles form and edges are dry, 2 to 4 minutes. Flip and cook until browned on the other side, 2 to 4 more minutes. Repeat with remaining batter.",
