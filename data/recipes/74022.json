  "ingredients": [
    "3 tomatoes, seeded and finely diced",
    "0.5 honeydew melon, peeled and finely diced",
    "1 cantaloupe, peeled and finely diced",
    "1 cup minced red onion",
    "0.5 jalapeno pepper, minced",
    "0.5 cup chopped fresh cilantro",
    "3 tablespoons fresh orange juice",
    "0.5 cup finely chopped almonds",
    "0.5 teaspoon salt",
    "2 tablespoons fresh lime juice"
  ],
  "steps": [
    {
      "text": "In a large serving bowl, stir together the tomatoes, honeydew melon, cantaloupe, red onion, jalapeno and cilantro. Stir in the orange juice, almonds, salt and lime juice. Refrigerate for at least 4 hours before serving for best flavor.",
