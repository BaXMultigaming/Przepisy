  "ingredients": [
    "5 apples, peeled and sliced",
    "1 (16 ounce) can whole-berry cranberry sauce",
    "1 cup oats",
    "2 tablespoons brown sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 cup unsweetened applesauce",
    "0.25 cup soy milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix apples and cranberries in an 8-inch square baking dish. Mix oats, brown sugar, and cinnamon in a bowl; stir in applesauce and soy milk until clumps form. Spoon oat mixture over apple mixture, pressing down slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned and bubbling, about 45 minutes.",
      "section": null,
      "name": null,
