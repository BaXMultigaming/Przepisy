  "ingredients": [
    "1 cup semisweet chocolate chips",
    "0.25 cup butter",
    "1 tablespoon instant coffee powder",
    "1 egg",
    "1 egg yolk",
    "0.67 cup all-purpose flour",
    "0.5 cup white sugar",
    "0.125 teaspoon baking soda",
    "1 tablespoon coffee-flavored liqueur",
    "1 teaspoon vanilla extract",
    "0.67 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the 8x8 inch baking pan, melt the butter and chocolate chips on the stove top, over medium heat, stirring constantly. Remove from the heat, and stir in the coffee, egg and yolk. Sift together the flour, sugar, and baking soda, stir into the chocolate mixture. Then stir in the vanilla and coffee liqueur.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 to 25 minutes in the preheated oven. Cool slightly and dust with confectioners' sugar. Cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
