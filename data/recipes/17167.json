  "ingredients": [
    "1 pound spaghetti",
    "4 tablespoons olive oil",
    "1 (2 ounce) can anchovy fillets, chopped",
    "3 cloves garlic, crushed",
    "1 cup fine bread crumbs",
    "1 cup chopped fresh parsley",
    "ground black pepper to taste",
    "4 tablespoons freshly grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat olive oil in a medium skillet over medium heat. Add anchovies and garlic; cook and stir continuously until anchovies sizzle and garlic is fragrant, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in bread crumbs and turn off heat. Stir in parsley and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss anchovy sauce with hot pasta and sprinkle with Parmesan cheese; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
