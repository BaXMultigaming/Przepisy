  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a casserole dish with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 10 to 20 minutes. Drain and return to the pot. Add vegan butter and mash to the desired consistency. Add almond milk, maple syrup, orange juice, vanilla extract, cinnamon, nutmeg, and salt. Pour into the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pecans, brown sugar, flour, vegan butter, and maple syrup in a bowl and sprinkle over casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until hot, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
