  "ingredients": [
    "cooking spray",
    "6 cups cubed whole wheat bread",
    "2 cups fat free half-and-half",
    "1 (15 ounce) can pumpkin puree",
    "1.5 cups white sugar",
    "3 eggs, lightly beaten",
    "0.5 cup raisins",
    "0.5 cup chopped pecans",
    "3 tablespoons butter, melted",
    "2 teaspoons pumpkin pie spice",
    "1 teaspoon grated orange zest"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly coat a 7x11-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread cubes in the prepared baking dish; pour half-and-half on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin purée, sugar, eggs, raisins, pecans, butter, pumpkin pie spice, and orange zest in a large bowl; pour over bread cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the middle is set and edges are golden, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
