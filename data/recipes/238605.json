  "ingredients": [
    "1 (12 ounce) package ground Italian sausage",
    "0.5 cup onion, diced",
    "1 (16 ounce) jar Classico Fresh Four Cheese Alfredo Sauce",
    "3 fresh sage leaves, finely chopped",
    "0.125 teaspoon freshly ground black pepper",
    "0.25 cup chopped green onion",
    "1 (10 ounce) can refrigerated biscuit dough, baked according to package instructions"
  ],
  "steps": [
    {
      "text": "Cook sausage in a large skillet over medium heat until no longer pink, following cooking instructions indicated on the packaging. Add diced onion and continue to cook until onion softens and turns transparent. Drain fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in Alfredo sauce, sage, and black pepper. Bring to a simmer, stirring occasionally; reduce heat and simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve over fresh biscuits and top with green onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
