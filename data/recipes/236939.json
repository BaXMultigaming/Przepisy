  "steps": [
    {
      "text": "Heat 1 teaspoon olive oil in a saucepan over medium heat. Cook salmon in the hot oil until cooked through and flakes easily with a fork, 5 to 7 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 2 tablespoons olive oil in a separate saucepan over medium heat; add garlic and cook until fragrant, about 1 minute. Add tomatoes; cook until heated through, about 5 minutes. Pour balsamic vinegar into tomato mixture; add basil. Cook and stir tomato mixture until flavors blend, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
