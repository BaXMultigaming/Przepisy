  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 cup butter, softened",
    "0.75 cup packed light brown sugar",
    "0.25 cup white sugar",
    "1 (3.4 ounce) package instant butterscotch pudding mix",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "12 ounces semisweet chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the flour and baking soda. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the butter, brown sugar, white sugar, pudding mix, and vanilla. Beat until creamy. Add the eggs and mix well. Gradually stir in the flour mixture. Stir in the chocolate chips and the chopped nuts. Drop from teaspoon onto ungreased cookie sheets about 1 inch apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
