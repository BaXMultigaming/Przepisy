  "ingredients": [
    "0.25 cup olive oil, divided",
    "1 (8 ounce) package angel hair pasta",
    "1 teaspoon chopped garlic",
    "1 pound large shrimp - peeled and deveined",
    "2 (28 ounce) cans Italian-style diced tomatoes, drained",
    "0.5 cup dry white wine",
    "0.25 cup chopped parsley",
    "3 tablespoons chopped fresh basil",
    "3 tablespoons freshly grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water and 1 tablespoon olive oil to a boil. Add pasta and cook until al dente; drain and rinse.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining olive oil in a 10-inch skillet over medium heat. Cook garlic, stirring constantly, until the garlic is tender, about 1 minute. Add shrimp, and cook for 3 to 5 minutes. Remove shrimp and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomatoes, wine, parsley, and basil; continue cooking, stirring occasionally, until liquid is reduced by half, about 8 to 12 minutes. Add shrimp and continue cooking until the shrimp are heated through, about 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve the shrimp mixture over the pasta. Sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
