  "ingredients": [
    "2 tablespoons butter",
    "1 small onion, chopped",
    "1 stalk celery, chopped",
    "1 medium carrot, chopped",
    "2 medium potatoes, cubed",
    "1 medium butternut squash - peeled, seeded, and cubed",
    "1 (32 fluid ounce) container chicken stock",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pCItmZSzDtqvEcgzAU-tv2h0BfE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/77981-butternut-squash-soup-ii-ddmfs3139-4x3-step-01-ba5cbc8753464620b3d9d1e471ad4e5f.jpg"
      ],
      "image": "assets/images/77981/step_01.webp"
    },
    {
      "text": "Melt butter in a large pot over medium heat, and cook onion, celery, carrot, potatoes, and squash until lightly browned, about 5 minutes. Pour in enough chicken stock to cover vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cH9IreMl-vLR2AVO2ZgzYeVY_VI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/77981-butternut-squash-soup-ii-ddmfs-3157-4x3-step-02-e5870929f7004ac2ae8c80d93e61fa29.jpg"
      ],
      "image": "assets/images/77981/step_02.webp"
    },
    {
      "text": "Bring to a boil over medium-high heat. Reduce heat to low, cover pot, and simmer until all vegetables are tender, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cfy2p_56xAKNqeL156R8C8cyUqY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/77981-butternut-squash-soup-ii-ddmfs-3160-4x3-step-03-6b1500fac4f0428fb5e0d1acc2651d42.jpg"
      ],
      "image": "assets/images/77981/step_03.webp"
    },
    {
      "text": "Transfer soup to a blender and process until smooth. Return to the pot and mix in any remaining stock to reach desired consistency. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VeDndOqzpyxy5Fv6ylx2bV_0HhM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/77981-butternut-squash-soup-ii-ddmfs-3208-4x3-step-04-18a7396e2d9b41aea28e18d192ec7f37.jpg"
      ],
      "image": "assets/images/77981/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EPaxxTzlDs9iy6si2K6cfuYuY4c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/77981-butternut-squash-soup-VAT-Beauty-4x3-4eeb7a73250a4dbcb91ee77e2faaba7a.jpg"
