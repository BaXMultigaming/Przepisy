  "ingredients": [
    "1 (9 inch) unbaked single pie crust",
    "3 cups chopped fresh rhubarb",
    "1.25 cups white sugar, divided",
    "1 cup half-and-half",
    "3 large eggs, separated, divided",
    "2 tablespoons all-purpose flour",
    "1 pinch salt",
    "0.25 teaspoon cream of tartar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press pie crust into a 9-inch pie dish; spread rhubarb evenly over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1 cup sugar, half-and-half, egg yolks, flour, and salt together in a bowl until smooth; pour over rhubarb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is browned and filling is set, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Just before pie is finished baking, beat egg whites in a glass, metal, or ceramic bowl until foamy. Gradually add remaining 1/4 cup sugar and cream of tartar, continuing to beat until meringue is glossy and stiff peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pie from the oven; spoon meringue over top, covering the entire filling. Make decorative swirls in meringue using a spoon or spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven; bake until meringue is lightly browned, about 10 minutes. Cool for 10 to 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
