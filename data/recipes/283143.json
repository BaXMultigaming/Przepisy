  "steps": [
    {
      "text": "Preheat the oven to 200 degrees F (95 degrees C). Preheat an air fryer to 400 degrees F (200 degrees C) for 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip together coffee creamer, eggs, and salt in a shallow bowl or deep plate. Dip each slice of brioche into the mixture, shaking off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray the air fryer basket with nonstick spray. Working in batches, place bread in the basket, making sure slices do not overlap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce air fryer to 350 degrees F (175 degrees C) and fry French toast for 7 minutes, flipping at the halfway mark. Repeat with remaining bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Keep cooked French toast warm in oven until batches are complete.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
