  "ingredients": [
    "1 pound thin asparagus",
    "1 tablespoon olive oil",
    "1 tablespoon everything bagel seasoning",
    "1 pinch salt to taste",
    "4 lemon wedges"
  ],
  "steps": [
    {
      "text": "Rinse and trim asparagus, cutting off any woody ends. Place asparagus on a plate and drizzle with olive oil. Toss with bagel seasoning until evenly combined. Place asparagus in the air fryer basket in a single layer. Work in batches if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the air fryer to 390 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry until slightly soft, tossing with tongs halfway through, 5 to 6 minutes. Taste and season with salt if needed. Serve with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
