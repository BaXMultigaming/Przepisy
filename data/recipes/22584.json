  "ingredients": [
    "1 cup butter",
    "2.25 cups brown sugar",
    "1 cup light corn syrup",
    "1 (14 ounce) can sweetened condensed milk",
    "1 teaspoon vanilla extract",
    "1 pound milk chocolate",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Grease an 8x8-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a heavy 4-quart saucepan over medium heat. Stir in brown sugar, corn syrup, and sweetened condensed milk. Cook, stirring constantly, until the mixture reaches 242 to 248 degrees F (116 to 120 degrees C), or until a small amount dropped into cold water forms a firm but pliable ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and stir in vanilla extract. Pour caramel into the prepared pan. Let caramel cool and set completely. Cut into 1-inch squares, then refrigerate until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate and butter in a double boiler or in a microwave-safe bowl, stirring until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chilled caramel squares into melted chocolate and place on waxed paper. Let stand until set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
