  "title": "Chocolate-Covered Caramels",
  "description": "Make rich, chocolate-covered caramels from scratch. These soft, chewy treats are perfect for gifting, holidays, or anytime candy cravings.",
  "authors": [
    "Cheryl Johnson"
  ],
  "date_published": "2000-10-09T14:08:22-04:00",
