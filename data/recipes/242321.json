  "ingredients": [
    "0.75 cup white sugar",
    "0.5 cup packed brown sugar",
    "0.5 cup butter, softened",
    "0.5 cup vanilla ice cream",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "0.5 cup malt powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup white chocolate chunks"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, brown sugar, and butter with an electric mixer in a large bowl until light and fluffy. Beat ice cream, egg, and vanilla extract into butter mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, malt powder, baking soda, and salt together in a bowl. Add flour mixture to butter mixture and stir until just combined. Drop spoonfuls of dough 2 inches apart onto baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until lightly browned, about 8 minutes. Cool cookies on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
