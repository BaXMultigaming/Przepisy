  "ingredients": [
    "2 tablespoons honey",
    "2 bananas, mashed",
    "0.25 cup vegetable oil",
    "0.5 cup milk",
    "2 teaspoons vanilla extract",
    "1 cup cornmeal",
    "1 cup whole wheat pastry flour",
    "1 tablespoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "1.5 cups chopped walnuts",
    "1 banana, sliced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 8x8 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the honey, mashed bananas, canola oil, milk and vanilla into a blender or food processor; puree until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together cornmeal, whole wheat flour, baking powder, soda and cinnamon. Stir flour mixture into banana mixture until blended. Fold in walnuts and sliced bananas. Pour into prepared pan.",
