  "ingredients": [
    "1 teaspoon white sugar",
    "2 fluid ounces cognac",
    "1 fluid ounce orange-flavored liqueur (such as Cointreau®)",
    "0.5 fluid ounce lemon juice",
    "1 cup ice cubes"
  ],
  "steps": [
