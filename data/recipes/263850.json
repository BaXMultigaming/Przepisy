  "ingredients": [
    "2 cups torn romaine lettuce",
    "6 fresh figs, quartered",
    "1 large ripe but firm pear, peeled and thinly sliced",
    "0.25 cup toasted pecans, chopped",
    "0.25 cup shredded Gruyere cheese",
    "1 small red onion, thinly sliced",
    "3 tablespoons extra-virgin olive oil",
    "3 tablespoons balsamic vinegar",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine romaine lettuce, figs, pear, pecans, Gruyere cheese, and onion in a large bowl. Drizzle evenly with olive oil and vinegar. Season with salt and pepper. Toss lightly and serve.",
