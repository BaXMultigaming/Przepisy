  "ingredients": [
    "1 (8 ounce) bag corn puffs (such as O-Ke-Doke®)",
    "1 cup salted peanuts",
    "1 cup butter",
    "1 cup packed brown sugar",
    "0.5 cup light corn syrup",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Combine corn puffs and peanuts in a large roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring butter, brown sugar, and corn syrup to a boil in a heavy 2-quart saucepan. Cook and stir for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LbMmKxNgtMbREL9dNfV9Vz3Dy14=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259226-puffed-caramel-corn-ddfsm-Step1-5940-26755c5e24024ece8e75eed09f072819.jpg"
      ],
      "image": "assets/images/259226/step_02.webp"
    },
    {
      "text": "Remove from heat; stir in baking soda until mixture foams up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gXbyL_sW6BNj7rIMcs88-9y-f94=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259226-puffed-caramel-corn-ddfsm-Step2-5961-3ecb89d374f347c4a8c9623d519d921e.jpg"
      ],
      "image": "assets/images/259226/step_03.webp"
    },
    {
      "text": "Pour over corn puff mixture and toss well using rubber spatulas. Bake in the preheated oven, stirring every 10 to 15 minutes, until a cooled piece of corn is crunchy, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kRpGqLay2OmeAwI_Pn771p3IB5Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259226-puffed-caramel-corn-ddfsm-Step3-5966-f555f2357239419d9fe93d4f35fe2fdb.jpg"
      ],
      "image": "assets/images/259226/step_04.webp"
    },
    {
      "text": "Spread on waxed paper to cool. Break apart and store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
