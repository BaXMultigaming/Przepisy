    "publisher-tested"
  ],
  "ingredients": [
    "2 cups warm water (110 degrees F/45 degrees C)",
    "2 tablespoons white sugar",
    "2 (.25 ounce) packages active dry yeast",
    "6 cups bread flour",
    "0.5 cup grated Romano cheese",
    "0.25 cup olive oil",
    "1 tablespoon salt",
    "1 tablespoon dried basil",
    "1 tablespoon dried oregano",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DTj6v-ZwQ23bRWfjnkijb0x66tc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6784-ItalianHerbBread-ddmfs-Step1-3x4-8057-363ad9c1a25d41678482b6dc9b6ee98c.jpg"
      ],
      "image": "assets/images/6784/step_01.webp"
    },
    {
      "text": "Mix warm water, sugar, and yeast together in a large bowl; let sit until mixture is foamy, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AOasV3CL_AQlg2WEb2ZeAw28_ic=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6784-ItalianHerbBread-ddmfs-Step2-3x4-8064-89da20166d9b436582f39dac093c0ec0.jpg"
      ],
      "image": "assets/images/6784/step_02.webp"
    },
    {
      "text": "Stir 3 cups flour, Romano cheese, olive oil, salt, basil, oregano, garlic powder, and onion powder into yeast mixture. Gradually mix in remaining 3 cups flour until incorporated; dough will be stiff.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j-oNHEvNoqjwsYW3lR_Xi-Id7cM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6784-ItalianHerbBread-ddmfs-Step3-3x4-8065-0c51800258ec461ba6b251f5affaf700.jpg"
      ],
      "image": "assets/images/6784/step_03.webp"
    },
    {
      "text": "Knead dough on a lightly floured surface until smooth and rubbery, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m5V8N8aSMjShmh8pgkmrKudmwrI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6784-ItalianHerbBread-ddmfs-Step4-3x4-8067-57d4e09a2dc7423cb82f1e1f7c318445.jpg"
      ],
      "image": "assets/images/6784/step_04.webp"
    },
    {
      "text": "Place dough into an oiled bowl and turn until the surface is coated. Cover with a damp dish towel and let rise until doubled in volume, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R3wZ1NZZaCrGk-iXc7rYF94ttiw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6784-ItalianHerbBread-ddmfs-Step6-3x4-8141-fcaa0626442344f89e81639151feb580.jpg"
      ],
      "image": "assets/images/6784/step_05.webp"
    },
    {
      "text": "Punch dough down to release air; shape into two loaves. Place each loaf into a greased 9x5-inch loaf pan. Let rise until doubled in volume, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yEXHN9jnCSd5MMOrAqneSeYo3D0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6784-ItalianHerbBread-ddmfs-Step9-3x4-8173-2a5048a437574ef6a91de68deb56763f.jpg"
      ],
      "image": "assets/images/6784/step_06.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 35 minutes. Remove loaves from the pans and let cool on wire racks for at least 15 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E-Lc6552uRB0U774rdtjif6oad8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6784-ItalianHerbBread-ddmfs-Step10-3x4-81748229-68611b0ee5904e0d907f05c5282fcd31.jpg"
      ],
      "image": "assets/images/6784/step_08.webp"
    }
