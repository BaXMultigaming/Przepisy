  "title": "Italian Herb Bread",
  "description": "This delicious herb bread is made with a winning combination of Italian herbs plus a good helping of Romano cheese. The dough can also be used for pizza.",
  "authors": [
    "Ann Barr"
  ],
  "date_published": "1998-06-29T13:36:53-04:00",
