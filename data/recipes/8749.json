  "ingredients": [
    "6 skinless, boneless chicken breast halves",
    "1 (8 ounce) bottle Italian-style salad dressing",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 cup chicken broth",
    "1 (8 ounce) package cream cheese",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon dried thyme",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a slow cooker, combine the chicken breasts and Italian-style dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook on Low for 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain off the juices, and shred the chicken meat. In a medium bowl, mix the soup, broth, cream cheese, basil, thyme, salt, and pepper. Pour over the chicken in the slow cooker. Continue cooking on Low for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
