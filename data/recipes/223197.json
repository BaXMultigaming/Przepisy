  "ingredients": [
    "1.5 pounds cherry or grape tomatoes, diced",
    "0.5 cup finely diced onion",
    "1 jalapeno chile peppers, seeded and minced",
    "2 cloves garlic, minced",
    "1 serrano chile pepper, seeded and minced",
    "2 tablespoons lime juice",
    "0.5 bunch fresh cilantro, chopped",
    "2 tablespoons minced fresh mint leaves",
    "1 teaspoon salt, or to taste",
    "0.25 teaspoon dried oregano",
    "1 pinch cayenne pepper, or more to taste",
    "1 pinch white sugar"
  ],
  "steps": [
    {
      "text": "Place tomatoes in a strainer; drain for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomatoes, onion, jalapeño, garlic, and serrano in a large bowl; pour lime juice over top. Stir in cilantro, mint, 1 teaspoon salt, oregano, cayenne pepper, and sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for 1 hour. Season with salt before serving.",
      "section": null,
      "name": null,
