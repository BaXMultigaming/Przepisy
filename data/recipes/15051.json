  "ingredients": [
    "8 large eggs",
    "1 cup milk",
    "0.5 cup shredded Cheddar cheese",
    "0.5 cup shredded mozzarella cheese",
    "3 ounces cooked ham, diced",
    "1 tablespoon dried minced onion",
    "0.5 teaspoon seasoning salt"
  ],
