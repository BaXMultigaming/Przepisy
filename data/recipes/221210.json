  "ingredients": [
    "1 meaty ham bone",
    "3 potatoes, cubed",
    "1 (8 ounce) package baby carrots",
    "1 (6 ounce) can tomato paste",
    "1 tablespoon chicken bouillon granules",
    "2 teaspoons Creole seasoning",
    "2 teaspoons Italian seasoning",
    "6 cups water, or as needed to cover"
  ],
  "steps": [
    {
      "text": "Place ham bone, potatoes, and carrots into a slow cooker. Top with tomato paste, chicken bouillon granules, and Creole and Italian seasonings.",
