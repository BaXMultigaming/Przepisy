  "ingredients": [
    "1.5 cups brown sugar",
    "1.5 cups ketchup",
    "0.5 cup red wine vinegar",
    "0.5 cup water",
    "1 tablespoon Worcestershire sauce",
    "2.5 tablespoons dry mustard",
    "2 teaspoons paprika",
    "2 teaspoons salt",
    "1.5 teaspoons black pepper",
    "2 dashes hot pepper sauce"
  ],
