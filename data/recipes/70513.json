  "ingredients": [
    "1.5 pounds ground beef",
    "1 small onion, finely chopped",
    "1 egg",
    "0.5 cup bread crumbs",
    "0.25 cup bacon bits",
    "garlic salt to taste",
    "4 hamburger buns, split and toasted"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the ground beef, onion, egg, bread crumbs, and bacon bits. Season with garlic salt. (I like to use a lot.) Divide into four balls, and pat into patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil the grate, and place patties onto the grill. Cook for about 5 minutes per side, or until firm and no longer pink in the center. Serve on toasted buns with your favorite hamburger toppings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
