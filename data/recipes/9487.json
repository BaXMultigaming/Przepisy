  "ingredients": [
    "1.75 cups white sugar",
    "0.25 cup dark corn syrup",
    "0.25 cup butter",
    "1 tablespoon cold water",
    "2 teaspoons cornstarch",
    "3 eggs",
    "1.25 cups chopped pecans",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "1 (9 inch) unbaked pie shell"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lwUfOJ659FL5WRQVh99ncfBvoIY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9487-pecan-pie-step1-ddmfs-step01-cc40b8f9db93495c9e911076431fb36a.jpg"
      ],
      "image": "assets/images/9487/step_01.webp"
    },
    {
      "text": "Combine sugar, corn syrup, butter, water, and cornstarch together in a medium saucepan over medium heat. Bring to a boil; remove from heat and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UGi9WhZSZR5DNvEJ4i54rqo5I9Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9487-PecanPie-MFS-Step1-1fff0cfe117e49d78ba704ba4c1b486a.jpg"
      ],
      "image": "assets/images/9487/step_02.webp"
    },
    {
      "text": "Beat eggs in a large bowl with an electric mixer until frothy. Gradually beat in sugar-syrup mixture. Stir in pecans, vanilla extract, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sRh_-lyHm9cujU74QkrIEco8KF8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9487-PecanPie-MFS-Step3-702f070141914acab2c15717cf297753.jpg"
      ],
      "image": "assets/images/9487/step_03.webp"
    },
    {
      "text": "Pour mixture into pie shell. Bake in the preheated oven until filling sets, 45 to 50 minutes. If the edges brown too quickly, loosely cover them with foil or a pie shield halfway through baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zxy0mJPYtNsLXTWdJXETbzL65LE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9487-PecanPie-MFS-Step4-fa8a506fc7684fdea8949342fd9059dd.jpg"
      ],
      "image": "assets/images/9487/step_04.webp"
    },
    {
      "text": "Let the pie cool at room temperature for at least 2 hours before slicing so the filling fully sets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DNx1CvM58s_LeMW_xPIF31Smeb0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9487-pecan-pie-DDMFS-4x3-41008a350a8543c78a08d400d2fb8a5a.jpg"
      ],
      "image": "assets/images/9487/step_05.webp"
    }
  ],
