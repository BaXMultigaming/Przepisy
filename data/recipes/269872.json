  "ingredients": [
    "1 (11.5 ounce) jar sweet pickles",
    "3 ounces pimento-stuffed Spanish Manzanilla olives",
    "2 bunches seedless red grapes",
    "10 ounces sliced Colby-Jack cheese",
    "2 small apples, sliced",
    "0.5 seedless cucumber, sliced",
    "3 ounces buttery round crackers (such as Keebler® Toasteds® Buttercrisp)",
    "3 ounces Havarti cheese slices",
    "2.75 ounces mixed nuts (such as Seapoint Farm® Energy Blend)"
  ],
  "steps": [
    {
      "text": "Place pickles in a 6-1/4x3-1/2-inch rectangular serving dish; place olives in a 16x2-inch olive tray. Arrange both on a large cutting board and surround with grapes, Colby-Jack cheese, apple slices, cucumber, crackers, Havarti cheese, and mixed nuts.",
