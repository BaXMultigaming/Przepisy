  "ingredients": [
    "1 loaf French bread",
    "0.25 cup butter, room temperature",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat grill to medium.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice loaf lengthwise without cutting completely through the bread. Spread half of the butter on inside surfaces; season with salt and pepper. Coat the outside of the bread with remaining butter; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place loaf cut-side down on the grill; toast until browned, checking often, 3 to 5 minutes. Close loaf using tongs. Grill surface until crispy, checking often, 3 to 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer loaf to a cutting board using tongs; slice into 10 diagonal slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
