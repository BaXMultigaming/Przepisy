  "ingredients": [
    "2 cups all-purpose flour",
    "4 teaspoons baking powder",
    "0.5 teaspoon salt",
    "3 tablespoons lard",
    "0.66000002622604 cup milk",
    "2 cups water",
    "1 cup white sugar",
    "1 pint blueberries"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mix flour, baking powder and salt. Rub in lard with fingers. Stir in milk to make a soft dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a deep skillet, boil water. Reduce heat to a simmer and stir in sugar until dissolved. Stir in blueberries. Drop dough by rounded spoonfuls into simmering blueberry syrup. Cover and simmer 10 minutes. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
