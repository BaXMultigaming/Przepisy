  "ingredients": [
    "3 tablespoons butter",
    "6 cups miniature marshmallows",
    "0.5 cup peanut butter",
    "5 cups toasted oat cereal"
  ],
  "steps": [
    {
      "text": "Spray a 13 x 9 inch pan on bottom and sides with non-stick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl in microwave, melt margarine. Add marshmallows, stir to coat. Microwave on high 1 1/2 minutes or until smooth when stirred for 45 seconds. Stir in peanut butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cereal all at once and stir quickly to coat. With buttered spatula, press into prepared pan. Cool and cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
