  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup rolled oats",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1 egg, beaten",
    "0.5 cup milk",
    "0.25 cup light olive oil",
    "0.5 cup sugar",
    "0.5 pint chopped fresh strawberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix flour, oats, baking powder, baking soda, cinnamon and salt. In a separate bowl, whisk together egg, milk, olive oil and sugar. Mix in strawberries. Stir strawberry mixture into oat mixture just until evenly moist. Spoon into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 18 to 20 minutes in the preheated oven, until a knife inserted in the center of a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
