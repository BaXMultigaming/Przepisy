  "ingredients": [
    "0.25 cup butter",
    "2 cloves garlic, minced",
    "6 peeled and deveined large shrimp (21 to 25 per lb)",
    "6 mushrooms, stems removed",
    "2 tablespoons shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter and garlic in a skillet over medium heat until butter begins to bubble. Add shrimp; cook until they just turn pink, about 3 minutes. Place 1 shrimp into each mushroom cap; place mushroom caps into a small baking dish. Spoon garlic butter into mushroom caps; sprinkle each with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until mushrooms are tender and cheese is golden and bubbly, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
