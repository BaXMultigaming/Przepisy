  "ingredients": [
    "3 tablespoons vegetable oil",
    "1 cup uncooked long-grain rice",
    "0.25 cup chopped onion",
    "1 teaspoon garlic salt",
    "0.5 teaspoon ground cumin",
    "2 cups chicken broth",
    "0.5 cup tomato sauce"
