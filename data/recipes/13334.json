  "ingredients": [
    "1 (29 ounce) can diced tomatoes",
    "2 (14.5 ounce) cans chicken broth",
    "2 (14 ounce) cans great Northern beans, undrained",
    "3 cups water",
    "1 (14 ounce) can chopped spinach, drained",
    "1 (8 ounce) can tomato sauce",
    "8 slices crisp cooked bacon, crumbled",
    "1 tablespoon minced garlic",
    "1 tablespoon dried parsley",
    "1.5 teaspoons salt",
    "1 teaspoon garlic powder",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon dried basil",
    "0.5 pound seashell pasta",
    "Romano cheese"
  ],
  "steps": [
    {
      "text": "Combine tomatoes, chicken broth, beans, water, spinach, tomato sauce, crumbled bacon, garlic, parsley, salt, garlic powder, pepper, and basil in a large stockpot. Bring to a boil. Cover, reduce heat, and simmer for 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pasta and cook, uncovered, until pasta is tender yet firm to the bite, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle soup into individual bowls. Sprinkle with Romano cheese to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
