  "ingredients": [
    "1 box Barilla® Pronto™ Rotini",
    "0.5 cup Marsala cooking wine",
    "0.5 cup Barilla® Mushroom Sauce",
    "0.75 cup baby bella (crimini) mushrooms, sliced",
    "0.5 cup grated pecorino cheese",
    "2 tablespoons chopped fresh parsley",
    "Salt and black pepper to taste"
  ],
  "steps": [
    {
      "text": "Pour whole box of pasta into a large skillet (approximately 12 inches in diameter). Pour 2 1/2 cups of cold water into the pan, ensuring that the water covers the pasta. Add mushrooms and wine and turn the burner to high, then set your timer for 10 minutes (optional: add a bit of salt to taste).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on high, stirring occasionally, until almost all of the liquid has evaporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sauce and gently heat through, stirring to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and stir in cheese and parsley. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
