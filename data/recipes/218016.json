  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 cup white sugar",
    "0.33333334326744 cup softened butter",
    "1 cup milk",
    "2 cups fresh blackberries",
    "2 cups boiling water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 cup sugar and butter together in a large bowl with an electric mixer until light and fluffy; add flour mixture, alternating with milk, until no large lumps remain. Transfer batter to a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange blackberries over batter; sprinkle with remaining 1 cup sugar. Pour boiling water over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until batter is set and berries are soft, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
