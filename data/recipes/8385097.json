  "ingredients": [
    "2 tablespoons butter, softened",
    "1 clove garlic, crushed",
    "2 tablespoons grated Parmesan cheese",
    "ground black pepper to taste",
    "0.25 large baguette, sliced",
    "1 teaspoon chopped fresh parsley, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat a grill to high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together butter, garlic, Parmesan cheese, and pepper in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the butter mixture generously on the baguette slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place slices on the preheated grill and cook until butter is melted and bread is lightly brown, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with parsley and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
