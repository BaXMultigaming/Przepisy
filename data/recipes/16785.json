  "ingredients": [
    "1.25 pounds ground smoked ham",
    "1 pound ground pork",
    "1 pound lean ground beef",
    "1 cup milk",
    "2 eggs",
    "1.5 cups graham cracker crumbs",
    "1 (10.75 ounce) can tomato soup",
    "0.25 cup cider vinegar",
    "1 cup packed brown sugar",
    "1 teaspoon mustard powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the ham, pork OR sausage, and the ground beef. Stir in the milk, eggs and graham cracker crumbs and mix well. Form into large balls about 2 inches in diameter and place them in a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate medium bowl, combine the soup, vinegar, brown sugar and mustard powder. Mix well and pour over the meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees for 1 hour or until internal meat temperature reaches 160 degrees F (73 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
