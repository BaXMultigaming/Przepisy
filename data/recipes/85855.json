  "ingredients": [
    "1 pound cherry tomatoes",
    "1 red onion, finely chopped",
    "1 tablespoon balsamic vinegar",
    "1 teaspoon chopped fresh red chile pepper",
    "1 teaspoon crushed garlic",
    "1 pinch Italian seasoning",
    "1 teaspoon white sugar",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a saucepan over medium-low heat, combine cherry tomatoes, red onion, balsamic vinegar, chile pepper, garlic, Italian seasoning, sugar, salt, and pepper. Simmer for about 15 minutes, then mash the tomatoes to release the juices. Continue to cook, stirring occasionally, until the sauce is thick, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow to cool, then cover and refrigerate until needed.",
