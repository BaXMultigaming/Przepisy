  "ingredients": [
    "2 pounds pork sausage",
    "1.5 cups buttermilk baking mix",
    "16 ounces shredded Cheddar cheese",
    "0.5 cup diced onion",
    "0.5 cup chopped celery",
    "0.5 teaspoon garlic powder"
  ],
