  "ingredients": [
    "1 tablespoon olive oil",
    "0.25 large red onion, diced",
    "0.5 cup red bell pepper, diced",
    "2 cloves cloves garlic, minced",
    "0.25 cup Gorgonzola cheese, crumbled",
    "4 ounces cream cheese, softened",
    "0.25 cup heavy cream",
    "0.25 cup milk",
    "1 (14.5 ounce) can diced tomatoes",
    "1.5 cups tomato juice",
    "2 teaspoons dried basil",
    "1 teaspoon white sugar",
    "0.25 teaspoon ground white pepper"
  ],
  "steps": [
    {
      "text": "Heat oil in a medium saucepan over medium heat. Add the onion, pepper, and garlic; cook and stir 4 to 5 minutes or until vegetables are soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the cheeses, cream, and milk; heat mixture until cheeses melt and the mixture is simmering.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the tomatoes (including their liquid), tomato juice, basil, sugar, and pepper. Continue to simmer mixture for 15 to 20 minutes while stirring constantly. Do not boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
