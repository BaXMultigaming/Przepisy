  "ingredients": [
    "1 cup white rice flour",
    "0.75 cup teff flour",
    "0.5 cup cornstarch",
    "0.5 cup sweet rice flour",
    "1 teaspoon baking soda",
    "1 teaspoon xanthan gum",
    "1 teaspoon salt",
    "1 cup butter, softened",
    "0.75 cup white sugar",
    "0.75 cup packed brown sugar",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "2 cups semisweet chocolate chips (such as Nestle® Toll House®)",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white rice flour, teff flour, cornstarch, sweet rice flour, baking soda, xanthan gum, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, brown sugar, and vanilla extract together in a bowl until smooth and creamy. Add eggs, 1 at a time, beating well after each addition. Slowly beat flour mixture into creamed butter mixture until dough is just mixed; fold in chocolate chips and walnuts. Drop dough by round spoonful onto the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are golden brown, 9 to 11 minutes. Let stand for 2 to 3 minutes on the baking sheet before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
