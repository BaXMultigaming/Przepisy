  "ingredients": [
    "3 pounds apples - peeled, cored, and sliced",
    "1 tablespoon butter, cut into small pieces",
    "2 tablespoons lemon juice",
    "1 cup all-purpose flour",
    "1 cup rolled oats",
    "1.5 cups brown sugar",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Butter a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread apple slices evenly in the prepared pan. Dot with butter pieces; sprinkle with lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, oats, sugar, cinnamon, and salt together in a large bowl. Cut 1/2 cup butter into oat mixture until mixture resembles coarse crumbs; spread over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is browned and apples are soft and tender, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
