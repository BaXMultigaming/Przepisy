  "ingredients": [
    "3 pounds turnips, peeled and cut into 2-inch cubes",
    "1 (32 ounce) carton low-sodium vegetable broth",
    "0.25 cup olive oil",
    "0.33333334326744 cup low-fat milk",
    "1 teaspoon salt",
    "1 teaspoon za'atar",
    "0.5 teaspoon black pepper",
    "1 tablespoon fresh mint leaves"
  ],
  "steps": [
    {
      "text": "Put turnips and broth in a large saucepan. If necessary, add water to cover vegetables. Bring to a boil; reduce heat and simmer, covered, until tender, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain; return vegetables to the pan. Drizzle with oil. Let stand, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat 1/3 cup milk in a small saucepan over low heat until very warm. Mash turnips until light and fluffy. Stir in warm milk, salt, za'atar, and pepper. Stir in additional milk as desired. Sprinkle with fresh mint just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
