  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 teaspoon salt",
    "1 teaspoon baking soda",
    "1 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat a heavy based flat griddle or skillet on medium to low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour and salt in a bowl and sift in baking soda; make a well in the center, and pour in the buttermilk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Work quickly to mix into a wet dough; knead very lightly on a well floured surface. Form into a flattened circle, about 1/2 inch thick and cut into quarters with a floured knife. The dough will be quite sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle a little flour over the base of the hot pan and cook the farls for 6 to 8 minutes on each side or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
