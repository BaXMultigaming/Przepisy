  "ingredients": [
    "1 (18 ounce) package brownie mix",
    "2 large eggs",
    "0.5 cup canola oil",
    "0.25 cup water",
    "1 (15.25 ounce) package white cake mix",
    "1.3333333730698 cups water",
    "3 large egg whites",
    "2 tablespoons canola oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 48 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make brownie batter: Whisk together brownie mix, eggs, oil, and water in a large bowl until fully incorporated, about 50 strokes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make cake batter: Beat cake mix, water, egg whites, and oil in a separate bowl with an electric mixer on low speed until combined. Increase speed to medium and beat for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon brownie batter into the prepared muffin cups, about 1/3 full. Spoon cake batter over brownie batter until each muffin cup is about 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and the tops spring back when lightly pressed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
