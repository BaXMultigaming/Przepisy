      "image_sources": []
    },
    {
      "text": "Stir sherry into the mixture. Season with ketchup, paprika, and Worcestershire sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in shrimp and heat thoroughly. Serve hot.",
