  "ingredients": [
    "0.25 cup butter",
    "0.25 cup all-purpose flour",
    "0.5 teaspoon salt",
    "1.5 cups milk",
    "0.25 cup dry sherry, or to taste",
    "3 tablespoons ketchup",
    "1 pinch paprika",
    "1 dash Worcestershire sauce",
    "2 (6 ounce) cans small shrimp, drained"
  ],
  "steps": [
    {
      "text": "Combine butter, flour, and salt in a saucepan. Cook for 2 minutes. Slowly pour in milk and bring mixture to a boil.",
      "section": null,
      "name": null,
