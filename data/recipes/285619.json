  "ingredients": [
    "3 medium potatoes, scrubbed",
    "0.25 cup olive oil",
    "1 slice vegan Cheddar cheese (such as Daiya®)",
    "1 tablespoon minced garlic",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.25 teaspoon chopped fresh chives, or to taste"
  ],
  "steps": [
    {
      "text": "Poke vent holes in the potatoes. Microwave on high for 13 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, put olive oil, vegan cheese, garlic, salt, and pepper in a small pot over medium-low heat. Heat until cheese is fully melted and garlic is cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let potatoes cool slightly. Halve them and scoop the flesh out into the pot. Discard skins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash potatoes and cheese sauce together until fully incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
