  "ingredients": [
    "1 cup sliced almonds",
    "0.33333298563957 cup olive oil",
    "0.25 cup fresh cranberries",
    "3 tablespoons red wine vinegar",
    "2 tablespoons water",
    "1 tablespoon Dijon mustard",
    "0.5 teaspoon minced garlic",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 pound mixed salad greens",
    "0.5 red onion, thinly sliced",
    "4 ounces crumbled blue cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange almonds in a single layer on a baking sheet. Toast in the preheated oven until nuts begin to brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil, cranberries, vinegar, water, Dijon mustard, garlic, salt, and black pepper in a blender or the bowl of a food processor; blend until vinaigrette is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss mixed greens, almonds, onion, and blue cheese with vinaigrette in a large bowl until evenly coated.",
