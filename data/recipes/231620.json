  "ingredients": [
    "4 (15.5 ounce) cans mashed sweet potatoes",
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "0.5 cup milk",
    "2 eggs, beaten",
    "1 tablespoon ground cinnamon",
    "1 teaspoon vanilla extract",
    "1.5 cups brown sugar",
    "1 cup chopped pecans",
    "1 cup flaked coconut",
    "0.5 cup butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mashed sweet potatoes, white sugar, 1/2 cup butter, milk, eggs, cinnamon, and vanilla together in a large bowl until smooth; transfer to a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, pecans, coconut, and 1/2 cup butter in a bowl; spread atop the filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake casserole in preheated oven until topping is golden brown, about 30 minutes.",
