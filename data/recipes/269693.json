  "ingredients": [
    "1 cup butter, softened",
    "0.75 cup brown sugar",
    "0.75 cup white sugar",
    "1 egg",
    "1 tablespoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1.5 cups rolled oats",
    "1 cup bittersweet chocolate chips",
    "1 cup toffee candy bits",
    "1 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar in a large bowl with an electric mixer until creamy. Beat in egg and vanilla extract; stir in flour and baking soda. Fold in oats, chocolate chips, toffee, and cranberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop heaping tablespoonfuls of dough onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 12 to 15 minutes. Transfer cookies to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
