  "ingredients": [
    "1.5 cups milk",
    "1.5 cups half-and-half",
    "6 large eggs",
    "1 tablespoon maple syrup",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 (1 pound) loaf French bread, cut into 1-inch slices",
    "1 cup light brown sugar",
    "1 cup coarsely chopped pecans",
    "0.5 cup unsalted butter, softened",
    "2 tablespoons maple syrup"
  ],
  "steps": [
    {
      "text": "Mix milk, half-and-half, eggs, maple syrup, vanilla, cinnamon, and nutmeg together in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer bread slices in a greased 9x13-inch baking dish. Pour egg mixture over the bread slices. Cover and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Remove French toast from the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, pecans, butter, and maple syrup together; spread topping evenly over the French toast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until puffed and golden brown, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
