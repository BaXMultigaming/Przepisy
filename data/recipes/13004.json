  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "3 medium red bell peppers",
    "1 tablespoon olive oil",
    "1 medium onion, chopped",
    "2 cloves garlic, minced",
    "4 large tomatoes - peeled, seeded and chopped",
    "2 teaspoons paprika",
    "1.5 teaspoons dried thyme",
    "0.125 teaspoon white sugar",
    "6 cups chicken broth",
    "1 pinch ground cayenne pepper",
    "1 dash hot pepper sauce",
    "salt and pepper to taste",
    "2 tablespoons butter",
    "1.5 tablespoons all-purpose flour",
    "6 tablespoons sour cream"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cMb388c4UVJtXHHqctdcTcSb-OU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13004-roasted-red-pepper-and-tomato-soup-DDMFS-179-4x3-step-01-2c99706dacce4ecf9893f4ac5c038006.jpg"
      ],
      "image": "assets/images/13004/step_01.webp"
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub oil on peppers and put them under the broiler until blackened, turn to get all sides. Put into paper bag and seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gnulXPp5zlcaUnmkTKQ5dxuXTgU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13004-roasted-red-pepper-and-tomato-soup-DDMFS-180-4x3-step-03-1382a725e0a0438289ae3277353616a1.jpg"
      ],
      "image": "assets/images/13004/step_03.webp"
    },
    {
      "text": "Let rest for 15 minutes, then peel will come right off and core and seeds will fall out.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HyJ2RFkxeK3r-YRAhGiFYHG89q0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13004-roasted-red-pepper-and-tomato-soup-DDMFS-205-4x3-step-04-52b0af12951e4f18a2f185e04c7d73e7.jpg"
      ],
      "image": "assets/images/13004/step_04.webp"
    },
    {
      "text": "Chop peppers. Reserve one chopped pepper; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jsx7MgU5Z80XEEQTyBeG60oCf3E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13004-roasted-red-pepper-and-tomato-soup-DDMFS-206-4x3-step-05-c3505c8837f94bbc8ea315af9ddfc83a.jpg"
      ],
      "image": "assets/images/13004/step_05.webp"
    },
    {
      "text": "Heat oil in a stockpot over medium heat. Add onion and garlic; cook and stir until onion is translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/67FTFM-tWxBiUl0QlFc1HStXcyY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13004-roasted-red-pepper-and-tomato-soup-DDMFS-207-4x3-step-06-938a514c6aec44c1907c84d400bdbeec.jpg"
      ],
      "image": "assets/images/13004/step_06.webp"
    },
    {
      "text": "Stir in tomatoes, peppers, paprika, thyme, and sugar. Reduce the heat to medium-low and cook until tomato juices have evaporated, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eipFS_tGObHEz47l09RExrKBRO8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13004-roasted-red-pepper-and-tomato-soup-DDMFS-208-4x3-step-07-47d236e67d7649e28cfb7d6ecb243505.jpg"
      ],
      "image": "assets/images/13004/step_07.webp"
    },
    {
      "text": "Stir in broth, cayenne, hot pepper sauce, salt, and pepper; bring to a boil. Reduce the heat, partially cover, and simmer until vegetables are tender, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZPC_WzSRKqPaSTtohYnnEwk0Sdw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13004-roasted-red-pepper-and-tomato-soup-DDMFS-210-4x3-step-09-fc7af1dbc1bb46a2bd9aa5f94f963b2b.jpg"
      ],
      "image": "assets/images/13004/step_08.webp"
    },
    {
      "text": "Place a strainer over a large bowl; pour soup into the strainer, letting liquid accumulate in the bowl. Do not clean the stockpot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cyu97Ogcc9G_gt07nsraHlkddDQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13004-roasted-red-pepper-and-tomato-soup-DDMFS-215-4x3-step-10-73ca3454de154a228fa4176500a25b26.jpg"
      ],
      "image": "assets/images/13004/step_09.webp"
    },
    {
      "text": "Pour solids from the strainer into a food processor or blender; purée until fairly smooth. Add purée to broth in the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4uQyqnTOpgwNZh3Sa5dx5aDmxN4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13004-roasted-red-pepper-and-tomato-soup-DDMFS-217-4x3-step-11-563a16fc3fe1417eb05c31355bf3489c.jpg"
      ],
      "image": "assets/images/13004/step_10.webp"
    },
    {
      "text": "Melt butter in the stockpot over medium heat. Whisk in flour and stir until mixture becomes paste-like, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c3flOWxYtJw_HPZDazGI7wrokmc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13004-roasted-red-pepper-and-tomato-soup-DDMFS-219-4x3-step-13-a812476580634b218e4f4ca3343c6408.jpg"
      ],
      "image": "assets/images/13004/step_11.webp"
    },
    {
      "text": "Gradually stir in broth-purée mixture and bring to a boil. Stir in remaining chopped peppers, reduce the heat, and simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lVQO95QuaJ38_5lbYgO9v-9-pT8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13004-roasted-red-pepper-and-tomato-soup-DDMFS-221-4x3-step-15-2f4b487e1db7484bb7439be435c4a5c8.jpg"
      ],
      "image": "assets/images/13004/step_12.webp"
    },
    {
      "text": "Stir the soup before ladling into six bowls and topping each with 1 tablespoon of sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XAqjNPWaYZytjhkYIgyQPYSlgjs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13004-roasted-red-pepper-and-tomato-soup-DDMFS-220-4x3-step-14-57eef2a302ae4ea0b22c74b37f084f4f.jpg"
      ],
      "image": "assets/images/13004/step_13.webp"
    }
  ],
