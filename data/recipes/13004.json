  "title": "Roasted Red Pepper and Tomato Soup",
  "description": "This creamy roasted red pepper and tomato soup is deliciously savory with a bit of heat from cayenne and hot pepper sauce to warm you up on a cold night.",
  "authors": [
    "Carol Crane"
  ],
  "date_published": "1999-02-03T15:17:58-05:00",
  "date_modified": "2026-04-22T22:00:14-04:00",
  "prep_time": "PT30M",
