  "ingredients": [
    "1 pound thick sliced bacon",
    "1.5 cups half-and-half cream",
    "2 cups flour",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon salt",
    "0.25 pinch white sugar",
    "2 cups vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Place bacon strips in a shallow dish, crisscrossing in a star pattern; add half-and-half. Soak bacon for 30 minutes to 2 hours but no more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, black pepper, salt, and sugar in a separate shallow dish until blended; set aside. Remove bacon from half-and-half; shake off excess. Press each strip into flour mixture to coat; transfer to a plate and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a deep skillet over medium-low heat. Add bacon carefully in batches; fry until browned and cooked to desired degree of crispness, 2 to 3 minutes. Drain on a paper towel.",
      "section": null,
      "name": null,
      "url": null,
