  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "0.33333334326744 cup cocoa powder",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
