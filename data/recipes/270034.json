  "ingredients": [
    "2 (8 ounce) skinless, boneless chicken breasts",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon garlic powder",
    "1 (8 ounce) package reduced-fat cream cheese (Neufchatel)",
    "1 (8 ounce) container sour cream",
    "0.5 cup Buffalo wing sauce (such as Frank's® Red Hot)",
    "0.5 cup shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Season chicken breasts with salt, pepper, and garlic powder. Place in the slow cooker and cover with the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until chicken is cooked through, about 3 hours. Drain accumulated juices. Shred chicken using a hand mixer. Add cream cheese, sour cream, Buffalo wing sauce, and Cheddar cheese. Cook on Low for 1 more hour. Stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
