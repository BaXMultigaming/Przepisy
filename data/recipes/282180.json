  "ingredients": [
    "2 pounds beef oxtail, cut into pieces",
    "6 cups water",
    "1 (14 ounce) can beef broth (such as Swanson®)",
    "1 large onion, chopped",
    "2 cloves garlic, minced, or more to taste",
    "0.5 teaspoon onion salt",
    "salt and ground black pepper to taste",
    "6 medium unpeeled red potatoes, cubed",
    "1 cup sliced carrots",
    "1 cup sliced fresh mushrooms",
    "0.5 medium green bell pepper, chopped",
    "1 bunch green onions, chopped"
  ],
  "steps": [
    {
      "text": "Mix oxtail, water, broth, onion, garlic, onion salt, salt, and pepper together in a large Dutch oven. Bring to a boil. Cover, turn heat down to a simmer, and cook until meat falls from the bone, about 2 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir potatoes, carrots, mushrooms, bell pepper, and green onions into the pot. Cover and let simmer until vegetables are tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
