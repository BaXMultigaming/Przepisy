  "ingredients": [
    "1 quart vegetable oil for frying",
    "1 cup white sugar",
    "2 eggs",
    "2 tablespoons vegetable oil",
    "0.75 cup milk",
    "0.25 cup white vinegar",
    "1 teaspoon baking soda",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Heat about 1 quart oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, eggs, and 2 tablespoons oil together in a mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk, vinegar, and baking soda into a liquid measuring cup; milk will become foamy. Add to sugar mixture; mix well. Mix in flour, baking powder, salt, and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter by teaspoonfuls into the hot oil until golden, about 1 minute per side, working in batches. Drain doughnuts on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
