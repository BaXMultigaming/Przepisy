  "ingredients": [
    "3 pounds chicken wings",
    "1 pinch garlic powder",
    "1 pinch cayenne pepper",
    "1.3333333730698 cups white sugar",
    "1 cup white vinegar",
    "0.5 cup chicken broth",
    "2 tablespoons ketchup",
    "2 tablespoons soy sauce"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash chicken wings and pat dry. Sprinkle lightly with garlic powder and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, turning every few minutes, until crispy on the outside and no longer pink at the bone and the juices run clear, 20 to 25 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the wings are grilling, whisk sugar, vinegar, chicken broth, ketchup, and soy sauce together in a large saucepan over medium-high heat. Bring to a boil. Cook until sauce is rendered to 1/2 of the original volume.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place wings in a large baking dish and drizzle sauce over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until flavors have intermingled, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
