  "title": "Grilled Sweet and Sour Chicken Wings",
  "description": "Crispy grilled chicken wings coated in a sticky sweet and sour sauce are sure to be a crowd-pleasing appetizer for your next party.",
  "authors": [
    "Laura"
  ],
  "date_published": "2011-08-24T22:21:11-04:00",
