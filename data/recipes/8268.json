  "title": "Whipping Cream Pound Cake",
  "description": "This recipe uses cake flour and margarine to deliver a moist, rich, and fine-textured pound cake.",
  "authors": [
    "Toni Wiggins"
  ],
  "date_published": "1999-07-01T00:37:00-04:00",
