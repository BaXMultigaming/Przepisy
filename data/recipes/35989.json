  "ingredients": [
    "20 pounds ground pork",
    "0.5 cup ground paprika",
    "0.25 cup garlic salt",
    "2 tablespoons salt",
    "1 tablespoon ground black pepper",
    "1 cup vegetable oil",
    "1 tablespoon anise seed",
    "1 tablespoon fennel seed",
    "0.125 cup red pepper flakes"
  ],
  "steps": [
    {
      "text": "Combine pork, paprika, garlic salt, salt, and black pepper in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place oil, anise seed, fennel seed, and red pepper flakes into a blender or food processor; blend well. Pour over pork mixture and mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate until flavors blend, about 24 hours. Freeze sausage in resealable plastic bags in desired portions.",
