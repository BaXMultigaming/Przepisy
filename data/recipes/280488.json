  "ingredients": [
    "1 serving cooking spray",
    "2 cups all-purpose flour",
    "1 cup old-fashioned oats",
    "1 cup brown sugar",
    "0.125 teaspoon ground cinnamon",
    "0.5 cup cold unsalted butter",
    "2 (8 ounce) packages cream cheese, softened",
    "2 cups white sugar",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "1 teaspoon vanilla butter and nut flavoring",
    "0.125 teaspoon ground cinnamon",
    "2 cups thinly sliced rhubarb"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, oats, brown sugar, and cinnamon in a bowl. Cut in butter until coarse and crumbly. Press into the bottom of the prepared pan to form a crust, reserving about 1/3 cup for topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese, sugar, eggs, vanilla extract, vanilla butter and nut flavoring, and cinnamon together in a bowl until smooth. Stir in rhubarb. Pour filling on top of crust. Sprinkle with the reserved crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick or knife inserted into the center comes out clean, 45 to 50 minutes. Remove from the oven and let cool completely before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
