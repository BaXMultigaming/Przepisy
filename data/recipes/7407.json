  "ingredients": [
    "1 cup butter",
    "2.75 cups white sugar",
    "4 large eggs",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 cups sour cream",
    "1.5 cups chopped walnuts",
    "2 tablespoons ground cinnamon",
    "2 teaspoons vanilla extract",
    "4 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease one 10 inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl cream together the butter or margarine and 2 cups of the sugar until fluffy. Add the vanilla and the eggs one at time beating mixture well after each egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour with baking powder, baking soda, and salt. Add alternately with sour cream to egg mixture. Beating just enough after each addition to keep batter smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine walnuts, cinnamon, and remaining 3/4 cup of sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon 1/3 of the batter into prepared pan, sprinkle with 1/3 of the walnut mixture. Repeat layers two more times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 70 minutes or until center is done. Let cake cool in pan for 10 minutes then remove pan and let cake continue cooling on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
