  "title": "Cinnamon Coffee Cake I",
  "description": "You can make this tasty cake lower in fat by using 1/2 cup butter, 1/2 cup applesauce, non-fat sour cream, and egg beaters.",
  "authors": [
    "Jackie Lindberg"
  ],
  "date_published": "1998-03-03T22:26:56-05:00",
