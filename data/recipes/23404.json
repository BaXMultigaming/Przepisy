  "ingredients": [
    "2 tablespoons olive oil",
    "1 medium onion, diced",
    "1 clove garlic, minced",
    "1 (14.5 ounce) can Italian-style diced tomatoes, undrained",
    "1 tablespoon dried basil leaves",
    "0.75 teaspoon white sugar",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.5 cup heavy cream",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a saucepan over medium heat. Add onion; cook until translucent, about 5 minutes, stirring in garlic during the last 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WNEJzjg_WHFNRa39cn4NrbLQyYY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23404-tomato-cream-sauce-for-pasta-mfs-step-1-4x3-f2f1b00922a04ca4bb4f9a3c242097e0.jpg"
      ],
      "image": "assets/images/23404/step_01.webp"
    },
    {
      "text": "Add undrained tomatoes, basil, sugar, oregano, salt, and black pepper; stir to combine as it comes to a boil. Continue to boil until most of the liquid evaporates, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VMUdO-nf5JWREhquyboj6__jDwE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23404-tomato-cream-sauce-for-pasta-mfs-step-2-4x3-eec8f14767ab4ce4acec963b774032f3.jpg"
      ],
      "image": "assets/images/23404/step_02.webp"
    },
    {
      "text": "Off heat, add cream and butter; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R4Gq5JXXHqQ2oHQzsyhOFXym_LE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23404-tomato-cream-sauce-for-pasta-mfs-step-3-4x3-14c8c88727284b64b674e0494f3a74f1.jpg"
      ],
      "image": "assets/images/23404/step_03.webp"
    },
    {
      "text": "Return to the stove; simmer over low heat for 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
