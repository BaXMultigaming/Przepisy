      ],
      "image": "assets/images/47954/step_01.webp"
    },
    {
      "text": "Combine water and rice in a small saucepan; bring to a boil. Reduce heat to low and simmer until tender, about 20 minutes. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
