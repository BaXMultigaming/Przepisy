  "ingredients": [
    "cooking spray",
    "1 egg",
    "1 egg white",
    "salt and ground black pepper to taste",
    "1 pinch garlic powder, or to taste",
    "1 pinch adobo seasoning, or to taste",
    "1 stalk celery, chopped",
    "3 slices ham, or to taste",
    "0.33333334326744 cup shredded Cheddar cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray 3 large muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix egg and egg white together in a bowl. Add salt, pepper, garlic powder, and adobo seasoning. Add celery; beat to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press ham slices snugly into the bottom of each muffin cup. Pour the egg and celery mixture on top. Cover with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, checking frequently, until eggs are set, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
