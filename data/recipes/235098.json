  "ingredients": [
    "1 banana, broken into chunks",
    "3 whole frozen strawberries, or more to taste",
    "0.75 cup milk",
    "0.5 cup plain yogurt",
    "0.25 cup pumpkin puree",
    "2 tablespoons creamy peanut butter",
    "1 tablespoon brown sugar",
    "0.25 teaspoon ground cinnamon",
    "1 pinch ground nutmeg",
    "8 ice cubes, or as desired",
    "0.25 cup whipped cream, or more to taste",
    "1 pinch ground cinnamon"
  ],
  "steps": [
    {
      "text": "Blend banana, strawberries, milk, yogurt, pumpkin puree, peanut butter, brown sugar, 1/4 teaspoon cinnamon, and nutmeg in a blender until smooth; add ice cubes and again blend until smooth. Pour smoothie into 4 glasses and top with whipped cream and a pinch of cinnamon.",
