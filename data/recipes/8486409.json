  "title": "Crispy Fried Poached Eggs",
  "description": "This truly wow-worthy dish combines smooth silky egg yolks with a crispy tasty crust. Top with pickled onions and scallions",
  "authors": [
    "Annie Campbell"
  ],
  "date_published": "2022-09-29T15:55:05-04:00",
  "date_modified": "2024-07-16T15:02:29-04:00",
  "prep_time": "PT20M",
