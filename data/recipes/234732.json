  "ingredients": [
    "1.5 cups butter",
    "1 cup sugar",
    "2 egg yolks",
    "3 cups flour",
    "1 teaspoon vanilla",
    "60 pecan halves"
  ],
  "steps": [
    {
      "text": "Beat butter and sugar together in a bowl using an electric mixer until creamy. Beat egg yolks into butter mixture and gradually beat flour into butter mixture until dough forms. Beat in vanilla. Cover bowl with plastic wrap and refrigerate dough for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll chilled dough into walnut-sized balls and place 2 inches apart onto baking sheets. Flatten balls slightly and press an indentation into the center of each flattened ball. Fill each indentation with 1 pecan half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 12 to 15 minutes. Cool on cookie sheet for 5 minutes and transfer to a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
