  "title": "Pound Cake Cookies",
  "description": "Pound cakes cookies topped with a pecan or a bit of jam are a truly decadent treat!",
  "authors": [
    "Kim"
  ],
  "date_published": "2020-06-18T23:56:25-04:00",
