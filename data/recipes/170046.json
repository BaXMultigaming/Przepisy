  "ingredients": [
    "8 slices bread",
    "2 cups white sugar",
    "1 cup unsalted butter, melted",
    "0.75 cup low-fat milk",
    "3 large eggs, beaten",
    "1 (20 ounce) can pineapple chunks, undrained",
    "3 tablespoons powdered sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut bread into 1-inch cubes. Transfer to a baking sheet and spread in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast in the preheated oven, stirring occasionally, until lightly browned, 8 to 10 minutes. Remove from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, milk, and eggs in a large bowl until well combined. Stir in undrained pineapple and toasted bread; toss until coated. Pour mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve warm with a sprinkle of powdered sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
