  "ingredients": [
    "4 cups vegetable broth",
    "2 cups water",
    "1.5 cups dried red beans, rinsed",
    "1.25 cups brown rice, rinsed well",
    "1 medium onion, chopped",
    "1 medium green bell pepper, chopped",
    "3 stalks celery, sliced",
    "1 tablespoon Creole seasoning",
    "4 cloves garlic, minced",
    "2 teaspoons hot sauce (such as Louisiana®)",
    "1 teaspoon dried thyme",
    "1 teaspoon dried oregano",
    "2 bay leaves",
    "0.25 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Place broth, water, beans, rice, onion, bell pepper, celery, Creole seasoning, garlic, hot sauce, thyme, oregano, and bay leaves in the bottom of a multi-functional pressure cooker (such as Instant Pot®). Stir to combine. Close and lock the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Select high pressure according to manufacturer's instructions; set timer for 50 minutes. Allow 20 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 15 minutes. Remove the lid, stir, and let stand for 10 minutes to thicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide among serving dishes and garnish with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
