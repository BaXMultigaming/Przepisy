  "ingredients": [
    "2 tablespoons extra-virgin olive oil",
    "1 clove garlic, crushed",
    "3 black Italian olives, pitted and chopped, or more to taste",
    "1 teaspoon capers",
    "1 anchovy fillet in oil, drained",
    "7 ounces passata (crushed tomatoes)",
    "0.5 cup water",
    "1 sprig chopped fresh parsley",
    "salt to taste",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oIrJq2GEaF4ryOy95SUIci2mBMU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265087-uova-in-purgatorio-eggs-in-purgatory-DDMFS-step-01-1794-e8e9e143a5eb4892b7ce9dd004b5de4f.jpg"
      ],
      "image": "assets/images/265087/step_01.webp"
    },
    {
      "text": "Heat oil in a skillet over low heat. Add garlic, olives, capers, and anchovy; cook for 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cGu1IB1HCx3Qim9fdVybjq5zWNY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265087-uova-in-purgatorio-eggs-in-purgatory-DDMFS-step-02-1795-ee522fb6c2b2422e833c59d99e65ab31.jpg"
      ],
      "image": "assets/images/265087/step_02.webp"
    },
    {
      "text": "Add tomato sauce and water, bring to a boil, and simmer until flavors combine, about 10 minutes. Add parsley and season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cx-sbvJx5WcTTx6QXrIOKa9E_g4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265087-uova-in-purgatorio-eggs-in-purgatory-DDMFS-step-03-1798-b00f5ff005c5487eaccf068cb5b09aae.jpg"
      ],
      "image": "assets/images/265087/step_03.webp"
    },
    {
      "text": "Gently add eggs directly into tomato sauce without breaking the yolks. Cook until eggs are just cooked, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bdC18qRBU3xzvPup8QJmUC4tTp4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/265087-uova-in-purgatorio-eggs-in-purgatory-DDMFS-step-05-1800-5838232bf3514f15a9dc99d851326a4c.jpg"
