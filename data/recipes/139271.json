  "ingredients": [
    "4 slices cooked ham",
    "4 slices sourdough bread",
    "2 tablespoons cream cheese, softened",
    "0.25 cup drained crushed pineapple",
    "2 slices provolone or Swiss cheese",
    "2 eggs",
    "0.5 cup milk",
    "2 tablespoons white sugar",
    "1 teaspoon butter",
    "1 tablespoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Spread cream cheese on two slices of bread. Layer 2 slices of ham, 2 tablespoons of pineapple, and one slice of cheese over the cream cheese. Then top each sandwich with one more slice of bread. Cut off crusts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a shallow bowl, whisk together eggs, milk and sugar. Briefly dip both sides of sandwiches in egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter and oil in a large skillet over medium heat. Place sandwiches in skillet, and fry on each side until golden brown and cheese is melted, about 5 minutes per side. Drain on paper towels and cool for 3 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
