  "ingredients": [
    "1 cup almond flour",
    "0.25 cup water",
    "2 eggs",
    "1 tablespoon maple syrup",
    "0.25 teaspoon salt",
    "1 teaspoon oil, or as needed"
  ],
  "steps": [
