  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "1 cup shredded Monterey Jack cheese",
    "1 (4 ounce) can diced jalapeno peppers",
    "3 green onions, diced",
    "2 cloves garlic, pressed",
    "1 (16 ounce) package wonton wrappers",
    "1 quart vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Mix cream cheese, Monterey Jack cheese, jalapeño peppers, green onions, and garlic in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GLTQxmSKNmGDpm82p_ZnUN1Wrbg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22612-jalapeno-cheese-puffs-VAT-step-01-58d6299e83e340db888dd91f8e085f75.jpg"
      ],
      "image": "assets/images/22612/step_01.webp"
    },
    {
      "text": "Fill wonton wrappers with approximately 1 teaspoon of cream cheese mixture each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dkrCFDOcrAfbl7JW_8mEmnudJfc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22612-jalapeno-cheese-puffs-VAT-step-02-0c82b45bd0d645b4b09b31b13ca6ab5e.jpg"
      ],
      "image": "assets/images/22612/step_02.webp"
    },
    {
      "text": "Fold wrappers into triangles and press the edges with a moistened fork to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yh-sOnIk6mwG4rRp9LDgTzxm3P8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22612-jalapeno-cheese-puffs-VAT-step-03-e3e5db979ddf41eb8b23738d4676246d.jpg"
      ],
      "image": "assets/images/22612/step_03.webp"
    },
    {
      "text": "Heat oil over medium-high heat in a large, deep skillet. Drop 4 wontons at a time into the oil and quickly fry, turning once. Remove when golden brown and drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oi38haHcgyQ5CMU3XR0s0f6FdhE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22612-jalapeno-cheese-puffs-VAT-step-04-70367ba7bd144ba4a64f77492ce671e6.jpg"
