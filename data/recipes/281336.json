  "ingredients": [
    "16 ounces shortbread cookies",
    "3 large eggs",
    "0.5 cup white sugar",
    "1 (15 ounce) container ricotta cheese",
    "1 (8 ounce) package cream cheese, softened",
    "1 teaspoon vanilla extract",
    "0.33333334326744 cup finely chopped dried apricots",
    "0.5 cup sour cream",
    "0.5 cup apricot preserves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Process shortbread cookies in the bowl of a food processor until finely ground. Press into a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and sugar together in a bowl. Add ricotta cheese, cream cheese, and vanilla extract. Mix well. Stir in apricots and spread over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed up and the edges are slightly brown, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine sour cream and apricot jam in a bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the cheesecake from the oven and spread jam topping on top while still hot. Chill until set, 1 to 2 hours. Cut into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
