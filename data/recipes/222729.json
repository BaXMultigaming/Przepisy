  "ingredients": [
    "1 tablespoon red wine vinegar",
    "0.5 shallot, diced",
    "salt and ground black pepper to taste",
    "2 tablespoons extra-virgin olive oil",
    "4 cups mixed greens",
    "2 baby cucumbers, sliced",
    "2 cups strawberries, hulled",
    "1 pinch sea salt"
