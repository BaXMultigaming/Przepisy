  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, confectioners' sugar, and salt in a bowl. Add oil and mix well. Press crust mixture into the baking pan with your hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix white sugar, tofu, lime juice, flour, soy milk, and salt together using an electric mixer until well blended. Pour filling over the crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set and center jiggles only slightly, 25 to 30 minutes. Let cool before cutting into bars.",
