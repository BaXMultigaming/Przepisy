  "ingredients": [
    "1 teaspoon butter",
    "8 ounces fresh mushrooms, sliced",
    "6 ounces cream cheese, softened",
    "6 skinless, boneless chicken breast halves",
    "1 cup brown sugar",
    "0.5 cup Dijon mustard",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Sauté mushrooms until tender. Reduce heat to low, and stir in cream cheese until melted. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pound chicken breasts thin with a meat mallet. Spread with mushroom mixture, and roll up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix together brown sugar and Dijon mustard. Press mustard mixture onto chicken. Roll chicken in chopped walnuts. Place in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 15 to 20 minutes, or until chicken is no longer pink and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
