  "ingredients": [
    "2 dried ancho chilies, stemmed and seeded",
    "6 eggs, beaten",
    "0.25 cup shrimp powder",
    "1 cup vegetable oil for frying",
    "0.5 white onion, coarsely chopped",
    "1 cup water, or more as needed",
    "2 cloves garlic, minced",
    "1.5 chicken bouillon cubes",
    "1 (16 ounce) jar nopales (cactus), drained and rinsed",
    "0.5 cup chopped fresh cilantro, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l2E0kc8WvQJoUbdMF9u_MHZGU-M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228322-tortas-de-camaron-VAT-005-step-01-3664b2b1f4814457b0335943b5f8a1e5.jpg"
      ],
      "image": "assets/images/228322/step_01.webp"
    },
    {
      "text": "Soak ancho chilies in a large bowl of warm water until tender, about 20 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S90nLbJqoSMhTUpo2jH0iR-EhOw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228322-tortas-de-camaron-VAT-006-step-02-02chilesdrained-77370d0fb0f84acc90d7b91082225d65.jpg"
      ],
      "image": "assets/images/228322/step_02.webp"
    },
    {
      "text": "Whisk beaten eggs and shrimp powder together in a medium bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XeElm09LoKzkNu05nIYtAgPyzdU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228322-tortas-de-camaron-VAT-007-step-03-02handnotinframe-451b4b7418c64f649625211bcd29ff59.jpg"
      ],
      "image": "assets/images/228322/step_03.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium heat; pour egg mixture into small 2-inch circles in hot oil. Fry until golden brown, about 3 minutes per side. Transfer fried egg patties to a plate. Repeat with remaining egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O5_ljtAxzWzzrXAUi48CspScjJg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228322-tortas-de-camaron-VAT-008-step-04-01eggscookinginpan-581de7e3513443ffaa3f7ac31ab3ad2e.jpg"
      ],
      "image": "assets/images/228322/step_04.webp"
    },
    {
      "text": "Blend ancho chilies, onion, water, and garlic in a blender until smooth. Add more water if needed to make a soup consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RnPockPBwoU5lZiGqfoXu0amP08=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228322-tortas-de-camaron-VAT-009-step-05-757884f1ecc940128b48c96582cc9e69.jpg"
      ],
      "image": "assets/images/228322/step_05.webp"
    },
    {
      "text": "Pour mixture into a large pot over medium heat; add chicken bouillon and fried egg patties. Cook and stir until bouillon is dissolved, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iNxq0mSnyoMq3kdOUU3Toro4ZQQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228322-tortas-de-camaron-VAT-010-step-06-01stirring-034bca787b0348ff928fd784772e4409.jpg"
      ],
      "image": "assets/images/228322/step_06.webp"
    },
    {
      "text": "Add nopales, reduce heat to low, and cook until soup is heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uC43KHzpbsLaqz0GtbFxTCjcN5Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228322-tortas-de-camaron-VAT-011-step-07-141f296d281848878cc34e03b9f3feed.jpg"
      ],
      "image": "assets/images/228322/step_07.webp"
    },
    {
      "text": "Garnish with cilantro to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a3GAOIlDOStke5aTq_ImviQBjGI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228322-tortas-de-camaron-VAT-012-step-08-15c8e9e07466495c87e7b62cf5948d0f.jpg"
      ],
      "image": "assets/images/228322/step_08.webp"
    }
