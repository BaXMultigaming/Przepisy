  "ingredients": [
    "1 quart oil for frying",
    "1 egg",
    "0.25 cup milk",
    "2 cups all-purpose flour",
    "2 teaspoons dry mesquite flavored seasoning mix",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon ground cayenne pepper",
    "2 pounds cube steak, cut into bite-sized pieces"
  ],
  "steps": [
    {
      "text": "Heat the oil in a deep fryer or heavy skillet to 365 degrees F (185 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, beat together the egg and milk. In a resealable plastic bag, mix the flour, mesquite seasoning, salt, pepper, garlic powder, and cayenne pepper. Dip the steak pieces in the egg mixture, then place in the plastic bag, seal, and shake to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the hot oil, fry the coated steak pieces in small batches until golden brown, about 5 minutes. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
