  "ingredients": [
    "1.5 cups molasses",
    "1.5 cups honey",
    "1.5 cups white sugar",
    "0.5 cup butter, cut into pieces",
    "1.5 teaspoons grated lemon zest",
    "1 teaspoon ground anise seed",
    "1 teaspoon ground ginger",
    "1 teaspoon ground nutmeg",
    "0.75 teaspoon ground cloves",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon ground cardamom",
    "2 tablespoons baking soda",
    "1 tablespoon water",
    "6 cups all-purpose flour",
    "0.25 cup cocoa powder",
    "1 tablespoon baking powder",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "Bring molasses, honey, and sugar to a simmer in a large saucepan over medium heat, then remove from heat and cool for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter, lemon zest, anise, ginger, nutmeg, cloves, cinnamon, and cardamom into molasses mixture. Dissolve baking soda in water, then stir into molasses mixture. Sift 6 cups flour, cocoa powder, and baking powder together into a large bowl; stir in molasses mixture and eggs until smooth. Stir in remaining 3 cups flour until a stiff dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 4 pieces (to make it more manageable). Roll out dough on a well floured surface to ¼-inch thick; cut into shapes with a cookie cutter. Transfer to ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned around the edges, 8 to 10 minutes. Cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
