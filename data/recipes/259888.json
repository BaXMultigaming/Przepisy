  "ingredients": [
    "1.5 cups pineapple juice",
    "2 tablespoons honey",
    "2 tablespoons ketchup",
    "2 tablespoons brown sugar",
    "1 tablespoon low-sodium soy sauce",
    "1 tablespoon hoisin sauce",
    "2 cloves garlic, minced",
    "1 tablespoon finely chopped fresh ginger root"
