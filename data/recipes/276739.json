  "ingredients": [
    "1 cup butter, softened",
    "1 (3 ounce) package cream cheese, softened",
    "1 cup white sugar",
    "1 egg yolk",
    "1.5 teaspoons finely grated lemon zest",
    "1 teaspoon lemon extract",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KJWrlbJkB7g0UfnVBML_C6ty0rc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276739-lemon-spritz-cookies-DDMFS-step-01-02f080aa4a0144f0ab45f0fc9ecbe8af.jpg"
      ],
      "image": "assets/images/276739/step_01.webp"
    },
    {
      "text": "Beat butter and cream cheese together in a bowl using an electric mixer until creamy. Mix in sugar until light and fluffy. Add egg yolk, lemon zest, lemon extract, and vanilla extract. Mix well. Add flour and salt gradually until dough is combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dVxgnFgHnqIgIAPpch136VKDsZU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276739-lemon-spritz-cookies-DDMFS-step-02-d0b7f44df26a4d5e94fd79240cdc2564.jpg"
      ],
      "image": "assets/images/276739/step_02.webp"
    },
    {
      "text": "Shape dough into small logs; place a log into a cookie press and press out onto ungreased cookie sheets. Repeat with remaining dough logs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2-pW7dNFREoKvOEk3ftOAcV9PW8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276739-lemon-spritz-cookies-DDMFS-step-03-3cb1bc6e027b4da59b2e019f98feb259.jpg"
      ],
      "image": "assets/images/276739/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 12 to 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/grXrjWfztgsD-tZPA8W0A1MmpFw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276739-lemon-spritz-cookies-DDMFS-step-04-a02ae44212624a77b1a2f25554ce7e8f.jpg"
