  "ingredients": [
    "1 (16 ounce) package frozen bite-size potato nuggets (such as Tater Tots®)",
    "1 (8 ounce) package shredded Cheddar cheese",
    "0.5 cup heavy whipping cream",
    "1 tablespoon gochujang (Korean hot pepper paste), or more to taste",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 370 degrees F (188 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook potato nuggets in the preheated air fryer until crispy and heated through, about 15 minutes, shaking the air fryer basket halfway through cooking time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat a saucepan over medium-high heat. Add Cheddar cheese and cream; whisk until cheese is melted, about 5 minutes. Add gochujang and salt and stir until combined. Drizzle sauce over potato nuggets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
