  "ingredients": [
    "6 ears fresh corn on the cob, husked",
    "6 tablespoons sweet butter, softened",
    "1 teaspoon fresh thyme",
    "1 teaspoon fresh parsley",
    "1 teaspoon fresh rosemary",
    "1 teaspoon fresh basil",
    "1 teaspoon white sugar",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Soak corn in a bowl of water for 15 minutes; drain. Place corn on individual pieces of aluminum foil large enough to completely enclose.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, thyme, parsley, rosemary, basil, sugar, and salt in a bowl; rub evenly onto corn. Wrap ears tightly in foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, turning often, until tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
