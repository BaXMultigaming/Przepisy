  "ingredients": [
    "5 cups peeled, cored, and sliced tart apples",
    "2 teaspoons white sugar",
    "0.5 teaspoon ground cinnamon",
    "1.5 cups brown sugar",
    "0.75 cup all-purpose flour",
    "0.5 cup butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place apples in an ungreased 7x11-inch baking dish. Sprinkle with sugar and cinnamon; stir to thoroughly combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, flour, and butter in a bowl; sprinkle over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apples are bubbly and topping is lightly browned, 45 to 60 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
