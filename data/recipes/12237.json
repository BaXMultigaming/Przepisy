  "title": "Rhubarb Cobbler",
  "description": "This rhubarb cobbler has a delicious rhubarb filling and buttery biscuit dough topping. Bake until hot and bubbling for a gorgeous springtime dessert.",
  "authors": [
    "J Saunders"
  ],
  "date_published": "1998-06-29T19:48:00-04:00",
