  "ingredients": [
    "4 (1 ounce) squares unsweetened chocolate",
    "0.5 cup butter",
    "0.5 teaspoon salt",
    "3 cups white sugar",
    "1 (12 fluid ounce) can evaporated milk"
  ],
  "steps": [
    {
      "text": "Fill the lower pot of a double boiler halfway with water and bring to a boil. Melt chocolate, butter, and salt together in the upper pot. Add sugar, 1/2 cup at a time, stirring after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually add evaporated milk, a little at a time, and continue stirring until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve hot over ice cream. Extra sauce may be stored in the refrigerator and reheated in the microwave.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
