  "ingredients": [
    "0.5 cup butter",
    "1 whole chicken, cut into pieces",
    "3 teaspoons salt, divided",
    "0.75 teaspoon ground black pepper, divided",
    "0.75 cup all-purpose flour",
    "3 cups chopped yellow onions",
    "2 cups chopped carrots",
    "1 cup chopped celery",
    "3 cloves garlic, chopped",
    "3 tablespoons all-purpose flour",
    "3 cups chicken broth",
    "0.25 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium-high heat. Season chicken pieces with 1 teaspoon salt and 1/2 teaspoon pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 3/4 cup flour in a shallow dish. Dredge chicken in flour, place in the skillet, and brown on all sides. Set chicken aside, and drain skillet, reserving about 1 tablespoon butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce skillet heat to medium-low, and stir in onions, carrots, celery, and garlic. Cook until tender, 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in 3 tablespoons flour, and cook 5 minutes more. Pour in chicken broth, season with cayenne pepper, and remaining salt and pepper. Bring to a boil, and reduce heat to low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return chicken to the skillet, cover, and continue cooking until chicken juices run clear and gravy has thickened, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
