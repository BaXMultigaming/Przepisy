  "ingredients": [
    "4 eggs, lightly beaten",
    "2 tablespoons grated Parmesan cheese",
    "2 tablespoons olive oil",
    "1 zucchini, sliced 1/8- to 1/4-inch thick",
    "garlic powder, or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Stir eggs and Parmesan cheese together in a medium bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium-high heat. Add zucchini and cook, stirring occasionally, until softened and lightly browned, about 7 minutes. Season with garlic powder, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium; pour egg mixture over zucchini. Cook, stirring gently, about 3 minutes. Remove the skillet from heat, cover, and let sit until eggs are set, about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
