  "ingredients": [
    "cooking spray",
    "4 beets, peeled and cut into 3/4-inch cubes",
    "2 new potatoes, peeled and cut into 3/4-inch cubes",
    "2 parsnips, peeled and cut into 3/4-inch cubes",
    "2 turnips, peeled and cut into 3/4-inch cubes",
    "1 rutabaga, peeled and cut into 3/4-inch cubes",
    "2 tablespoons olive oil",
    "salt and ground black pepper to taste",
    "0.33333334326744 cup vegetable broth",
    "2 tablespoons balsamic vinegar",
    "1 pinch Italian seasoning, or to taste",
    "1 (4 ounce) package goat cheese, crumbled"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss beets, potatoes, parsnips, turnips, and rutabaga with olive oil, salt, and pepper in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread seasoned vegetables over prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast vegetables in the preheated oven until beets are easily pierced with a fork, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir vegetable broth, balsamic vinegar, and Italian seasoning together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour broth mixture over vegetables and continue roasting until liquid has evaporated, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer roasted vegetables to a bowl and toss with goat cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
