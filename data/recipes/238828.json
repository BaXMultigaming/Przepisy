  "ingredients": [
    "cooking spray",
    "3.3333332538605 cups Original Bisquick® mix",
    "1 cup milk",
    "1 (14 ounce) jar pizza sauce",
    "1 (7 ounce) package sliced pepperoni",
    "1 (8 ounce) package shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 9x13-inch (3-quart) glass baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Bisquick mix and milk in a medium bowl until soft dough forms. Drop 1/2 of dough by the spoonful evenly into the bottom of the prepared baking dish (dough will not completely cover the bottom of the dish).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle about 1 cup pizza sauce over dough. Arrange 1/2 of the pepperoni slices evenly over the sauce. Top with 1 cup cheese. Repeat layers with remaining dough, pizza sauce, pepperoni, and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, biscuits in the center are cooked, and cheese in the center is bubbly, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
