  "ingredients": [
    "1 cup salad oil",
    "0.75 cup sugar",
    "0.5 cup ketchup",
    "0.25 cup vinegar",
    "salt and pepper to taste",
    "2 eggs",
    "1 pound bacon",
    "1 pound fresh spinach, torn",
    "1 (4 ounce) can water chestnuts, drained and chopped",
    "1 cup fresh bean sprouts",
    "8 mushrooms, sliced"
  ],
  "steps": [
    {
      "text": "In a bowl, mix oil, sugar, ketchup and vinegar. Season with salt and pepper. Cover and chill at least 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place egg in a pot with enough cold water to cover. Bring to a boil and remove from heat. Cover pot and let egg stand in hot water for 10 to 12 minutes. Remove from water, cool, peel and slice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a skillet over medium heat and cook until evenly brown. Drain and crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix eggs, bacon, spinach, water chestnuts, bean sprouts and mushrooms. Toss with dressing just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
