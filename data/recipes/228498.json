  "ingredients": [
    "3 pounds baby back ribs, trimmed",
    "salt and ground black pepper, to taste",
    "0.5 cup water",
    "0.5 onion, sliced",
    "1 clove garlic, minced",
    "1 (18 ounce) bottle barbeque sauce"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
