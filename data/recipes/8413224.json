  "ingredients": [
    "4 Roma tomatoes",
    "0.5 teaspoon salt, or to taste",
    "0.5 teaspoon ground black pepper, or to taste",
    "0.5 teaspoon dried Italian herb seasoning",
    "0.5 cup freshly grated Parmesan cheese",
    "1 tablespoon fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat a broiler according to manufacturer's recommendations. Line a baking sheet or small sheet pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice tomatoes in half crossways. Slice thin slices off of the round part of the tomato halves so they will sit straight on the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tomato halves on the prepared pan and sprinkle with salt, pepper, and Italian seasoning to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place seasoned tomatoes under the broiler and broil about 4 minutes. Be sure to watch carefully, so they won't burn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle 1 tablespoon grated Parmesan cheese on each tomato half, and return to the broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil until Parmesan cheese is melted and bubbly, 45 seconds to 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer broiled tomatoes on a plate or serving platter and garnish with fresh parsley, if desired. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
