  "ingredients": [
    "1 cup milk",
    "0.25 cup vegetable oil",
    "1 egg",
    "1.25 cups quick cooking oats",
    "1 cup all-purpose flour",
    "0.33333334326744 cup white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 cup blueberries, rinsed and drained"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, oil, and egg together in a bowl until evenly blended. Stir oats, flour, sugar, baking powder, and salt together in a separate bowl, making a well in the center. Pour milk mixture into well and stir just until batter is combined; fold in blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 20 to 25 minutes. Cool in the tin for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
