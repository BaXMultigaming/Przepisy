  "ingredients": [
    "2.5 cups baking mix (such as Bisquick®)",
    "2 tablespoons white sugar",
    "1 teaspoon ground cinnamon",
    "0.66666668653488 cup milk",
    "0.5 cup raisins",
    "0.66666668653488 cup confectioners' sugar",
    "1 teaspoon warm water",
    "0.25 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk baking mix, white sugar, and cinnamon together in a bowl; stir in milk until dough is just combined. Fold raisins into dough. Knead dough about 10 times and roll out to 1/2-inch thickness. Cut round biscuits using a biscuit cutter or cookie cutter; arrange on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir confectioners' sugar, water, and vanilla extract together until glaze is smooth; drizzle over warm biscuits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
