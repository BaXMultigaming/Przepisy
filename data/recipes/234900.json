  "ingredients": [
    "4 cups all-purpose flour",
    "0.75 teaspoon baking soda",
    "0.75 teaspoon salt",
    "2 cups white sugar",
    "1 cup drained crushed pineapple",
    "1 cup vegetable shortening (such as Butter Flavor Crisco®)",
    "3 eggs, beaten",
    "1 tablespoon lemon extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, crushed pineapple, shortening, eggs, and lemon extract together in a bowl until thoroughly mixed. Add flour mixture to pineapple mixture; stir until just combined. Drop dough by teaspoonfuls 2 inches apart onto baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in batches in the preheated oven until tops are lightly browned, 12 to 15 minutes per batch. Transfer to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
