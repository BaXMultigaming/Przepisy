  "title": "Chocolate Banana Cream Pie",
  "description": "A creamy layered pie; the layers include chocolate, bananas, and vanilla pudding with coconut. Easy, and very yummy.",
  "authors": [
    "MARBALET"
  ],
  "date_published": "1999-03-17T08:06:38-05:00",
