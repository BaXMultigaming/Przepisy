  "ingredients": [
    "1.5 cups mayonnaise",
    "0.25 cup chopped dill pickle",
    "3 tablespoons capers, drained and chopped",
    "2.5 tablespoons fresh lime juice",
    "2 tablespoons chopped jalapeno pepper",
    "0.5 teaspoon chopped fresh parsley",
    "2 dashes hot pepper sauce (such as Tabasco®)",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Mix together mayonnaise, dill pickle, capers, lime juice, jalapeño pepper, parsley, hot pepper sauce, and salt in a bowl. Cover the bowl with plastic wrap and refrigerate for 1 hour before serving.",
