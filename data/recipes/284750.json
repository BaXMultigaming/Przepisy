  "ingredients": [
    "8 cups crumbled cornbread",
    "4 cups cubed stale bread",
    "1 cup butter, melted",
    "2 large onions, chopped",
    "1.5 cups chopped celery",
    "2 cups turkey broth, or as needed",
    "1.5 cups chopped cooked turkey",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "4 large hard-cooked eggs, chopped",
    "0.25 cup chopped, cooked turkey giblets",
    "4 tablespoons self-rising flour",
    "4 tablespoons chopped fresh parsley",
    "2 teaspoons chopped fresh sage, or to taste",
    "2 large bay leaves",
    "salt and ground black pepper to taste",
    "3 large eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x13-inch baking dishes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornbread and stale bread cubes in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add onions and celery; cook and stir until translucent, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion mixture, turkey broth, chopped turkey, soup, hard-cooked eggs, giblets, and flour to cornbread mixture; stir until all cornbread wet. Stir in parsley, sage, bay leaves, salt, and pepper. Add beaten eggs; stir to combine. Mixture should be \"soupy.\" Divide evenly and pour into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through and set, 1 hour to 1 hour and 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
