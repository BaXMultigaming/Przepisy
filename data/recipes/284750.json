  "title": "Mama's Southern Cornbread Dressing",
  "description": "This Southern cornbread dressing combines Thanksgiving favorites like turkey, giblets, and cornbread into a side dish that everyone will enjoy.",
  "authors": [
    "Mary Lynne Williams"
  ],
  "date_published": "2011-11-20T19:09:29-05:00",
