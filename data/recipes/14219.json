  "title": "Summer Potato Salad",
  "description": "Make this summer potato salad by pouring lemony dressing over warm potatoes, then mixing with scallions, parsley, and celery, and chilling before serving.",
  "authors": [
    "jen"
  ],
  "date_published": "1999-08-13T17:54:08-04:00",
