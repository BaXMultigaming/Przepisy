  "ingredients": [
    "3 eggs",
    "1.5 cups white sugar",
    "1 cup canola oil",
    "1 tablespoon vanilla extract",
    "2 cups grated zucchini",
    "1.5 cups unbleached all-purpose flour",
    "1.5 cups white whole-wheat flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.75 teaspoon salt",
    "1 tablespoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease and flour 2 4x8-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, sugar, canola oil, vanilla extract, and zucchini together in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, sift together unbleached flour, white whole-wheat flour, baking soda, baking powder, salt, and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the dry ingredients into the zucchini mixture, a little at a time, stirring until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the batter into the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bread is lightly browned and a toothpick inserted into the center comes out clean, 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
