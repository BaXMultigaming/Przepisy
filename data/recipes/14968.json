  "ingredients": [
    "2 cups ketchup",
    "1 cup packed brown sugar",
    "2 tablespoons Worcestershire sauce",
    "1 pound bacon",
    "2 (8 ounce) cans water chestnuts, drained"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RxX0G9GHC_tpbPg-xOJDXvqChos=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14968-bacon-wrapped-water-chestnuts-iii-DDMFS-step-1-3aa4d415fadd4a22b8f699e76267b864.jpg"
      ],
      "image": "assets/images/14968/step_01.webp"
    },
    {
      "text": "Combine ketchup, brown sugar, and Worcestershire sauce in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9eTFi3ZwX-I-oJwUqHQbul6ZsrY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14968-bacon-wrapped-water-chestnuts-iii-DDMFS-step-2-69a84555c01d497ebde496be827a654b.jpg"
      ],
      "image": "assets/images/14968/step_02.webp"
    },
    {
      "text": "Cut bacon strips in half. Wrap one slice of bacon around each chestnut and secure with a toothpick. Arrange water chestnut wraps in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DG6k0HFUoAyW3Xx7F6qlrmHSMzQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14968-bacon-wrapped-water-chestnuts-iii-DDMFS-step-3-9bd594dfd12f4e8e9b5b2d6bcb3140e4.jpg"
      ],
      "image": "assets/images/14968/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 10 to 15 minutes. Remove water chestnut wraps from the oven and drain some grease. Pour ketchup sauce over wraps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Fu-CaHoRXe5o4vcSlezWMwPgTKI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14968-bacon-wrapped-water-chestnuts-iii-DDMFS-step-4-f96f5d982b4b4ffeb06c1e00f01f8fbc.jpg"
      ],
      "image": "assets/images/14968/step_04.webp"
    },
    {
      "text": "Bake until bacon is crispy and sauce thickens, 30 to 35 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ISQwVKsGRwouOFu0EKvbg4ZL0Kk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14968-bacon-wrapped-water-chestnuts-iii-DDMFS-step-5-9ef3979492b54e0d867647566a86c771.jpg"
