  "ingredients": [
    "2.5 cups self-rising flour",
    "1.5 cups canola oil",
    "1.5 cups white sugar",
    "1.25 cups buttermilk",
    "2 large eggs",
    "1 teaspoon white vinegar",
    "1 teaspoon baking soda",
    "1 teaspoon vanilla extract",
    "1 teaspoon unsweetened cocoa powder",
    "2 (14 ounce) cans sweetened condensed milk",
    "1 cup dark brown sugar",
    "6 tablespoons butter",
    "2 teaspoons vanilla extract",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease three 9-inch round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, canola oil, white sugar, buttermilk, eggs, vinegar, baking soda, 1 teaspoon vanilla extract, and cocoa powder in a large bowl until evenly distributed, 2 to 5 minutes. Divide batter among the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 20 minutes. Cool in pans about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sweetened condensed milk, dark brown sugar, butter, 2 teaspoons vanilla extract, and salt in a saucepan over medium heat; bring to a boil, stirring constantly until thick, 3 to 5 minutes. Cool frosting, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cooled cakes from pans; spread frosting onto cake layers. Stack layers; frost top and sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
