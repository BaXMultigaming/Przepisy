  "ingredients": [
    "1 pound ground beef",
    "1 pound ground turkey",
    "1 pound ground Italian sausage",
    "1 large onion, diced",
    "2 eggs",
    "0.5 cup Italian-style seasoned bread crumbs",
    "0.5 cup quick cooking oats",
    "2 tablespoons Italian-style seasoning",
    "1 cup vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground meats, onion, eggs, bread crumbs, oats, and seasoning in a large bowl until well combined. Shape into 24 (2-inch-diameter) meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat enough vegetable oil in a large sauté pan to be 1/2 inch deep. Cook meatballs in hot oil until browned, about 5 minutes. Transfer to a glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes. An instant-read thermometer inserted into the center should read 165 degrees F (75 degrees C).",
      "section": null,
      "name": null,
      "url": null,
