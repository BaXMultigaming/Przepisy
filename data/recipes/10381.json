  "title": "Soft Oatmeal Raisin Cookies",
  "description": "This recipe uses plain yogurt to deliver an oatmeal-raisin cookie that really is moist and chewy.",
  "authors": [
    "Tamara"
  ],
  "date_published": "1998-01-16T14:44:28-05:00",
