  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 cup plain yogurt",
    "1 tablespoon fat free butter flavored granules",
    "0.5 cup packed brown sugar",
    "0.5 cup white sugar",
    "2 egg whites",
    "1.5 teaspoons vanilla extract",
    "1 cup raisins",
    "1.5 cups quick cooking oats",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Set oven rack in the middle and preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour, salt and baking soda. Set aside. In a large bowl, mix yogurt, butter-flavored granules (Butter Buds), brown sugar and granulated sugar until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add egg whites and vanilla, mix until just combined. Add flour mixture and mix until just moistened. Stir in oatmeal and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by level tablespoon onto to cookie sheet lightly sprayed with non-stick spray. Bake for 8 minutes. Press center of cookie; if it springs back, it is done. Store in airtight container, these cookies do not keep well at room temperature. Store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
