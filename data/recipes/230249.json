  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange eggplant rounds on a baking sheet;lightly coat with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake eggplant rounds in preheated oven until hot, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flip the eggplant rounds; top with Parmesan cheese in an even layer to cover. Return eggplant to oven and bake until the cheese is melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop a dollop of tomato sauce into the center of each eggplant round; top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until Cheddar cheese is bubbling, about 5 minutes more. Season with salt and pepper to serve.",
