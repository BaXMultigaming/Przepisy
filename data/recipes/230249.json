  "ingredients": [
    "0.5 large eggplant, sliced into thin rounds",
    "0.5 cup grated Parmesan cheese",
    "1 tablespoon extra virgin olive oil",
    "0.33333334326744 cup tomato sauce",
    "0.33333334326744 cup shredded Cheddar cheese",
