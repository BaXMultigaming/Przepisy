  "ingredients": [
    "1 (18.25 ounce) package chocolate cake mix",
    "0.5 cup butter, softened",
    "2 eggs",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together cake mix, butter, and eggs in a large bowl until smooth and well blended. Mix in chocolate chips until incorporated. Drop by spoonfuls onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set, 8 to 10 minutes. Cool cookies on the baking sheets for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
