  "ingredients": [
    "1.5 cups barbeque sauce",
    "5 tablespoons orange juice",
    "0.25 cup orange blossom honey",
    "1 teaspoon grated orange zest",
    "1 teaspoon cooking sherry",
    "0.5 teaspoon cayenne pepper",
    "0.25 teaspoon ground cloves",
    "2 pounds shredded rotisserie chicken",
    "1 (16 ounce) package whole wheat hamburger buns"
  ],
  "steps": [
    {
      "text": "Combine barbecue sauce, orange juice, honey, orange zest, sherry, cayenne, and cloves in a large saucepan over medium-low heat. Stir until warm, 3 to 5 minutes. Add chicken; cook, stirring occasionally, until heated through, about 15 minutes. Serve on hamburger buns.",
