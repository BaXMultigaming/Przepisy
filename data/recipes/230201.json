  "ingredients": [
    "2 large pears",
    "1 teaspoon maple syrup, or to taste",
    "2 tablespoons brown sugar",
    "2 tablespoons butter",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HCRgDTC8bx1_64i-hFMsLwP2T90=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230201-baked-pears-VAT-step-01-e011077706ff464ab56bde86d4dd0a10.jpg"
      ],
      "image": "assets/images/230201/step_01.webp"
    },
    {
      "text": "Cut top quarter of pears off; create a well by scooping out the core, being careful not to puncture the bottom of the pear. Arrange pears in a shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s6xZcHjWC7JelgsFOZ0bkUyBkg0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230201-baked-pears-VAT-step-02-159839da17f44e44b8c88f7f26cdd887.jpg"
      ],
      "image": "assets/images/230201/step_02.webp"
    },
    {
      "text": "Drizzle maple syrup over pears. Place 1 tablespoon brown sugar and 1 tablespoon butter in each pear; sprinkle with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p-oQ6htZL5Hzq63XnzWUMFGzvq0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230201-baked-pears-VAT-step-03-16a3c901e86f4171a901d1c632f8bb55.jpg"
      ],
      "image": "assets/images/230201/step_03.webp"
    },
    {
      "text": "Bake in preheated oven until pears are easily pierced with a fork, 35 to 50 minutes.",
      "section": null,
