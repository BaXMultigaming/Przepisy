  "ingredients": [
    "2 cups white sugar",
    "1.25 cups miniature marshmallows",
    "0.66666668653488 cup evaporated milk",
    "0.5 cup butter",
    "1 dash salt",
    "1.25 cups cherry baking chips",
    "1 teaspoon vanilla extract",
    "2 cups semisweet chocolate chips",
    "0.75 cup chunky peanut butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Generously grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5sogKOgmJkJfdMXu9igGZAGTwJk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-34194-cherry-mash-candy-VAT-step-01-e76e79da2f684729a9e6c46d729a9e86.jpg"
      ],
      "image": "assets/images/34194/step_01.webp"
    },
    {
      "text": "Stir sugar, marshmallows, milk, butter, and salt together in a large saucepan over medium heat; simmer until mixture reaches soft ball stage, 240 degrees F (115 degrees C), about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wNN9AugkdXCeXtHAfNbGAc3RxNE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-34194-cherry-mash-candy-VAT-step-02-647d9686a44747168e4b0c142cdd2b12.jpg"
      ],
      "image": "assets/images/34194/step_02.webp"
    },
    {
      "text": "Turn off heat. Add cherry chips and vanilla; stir until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FMlyGIinRrVssYFB43Y_FgQOwiY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-34194-cherry-mash-candy-VAT-step-03-1-f4b3b034fbe74af0a27602445cd5e924.jpg"
      ],
      "image": "assets/images/34194/step_03.webp"
    },
    {
      "text": "Pour mixture into prepared pan, and let cool until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A_C6ABRjt9LqP8-jbtoIdQTpCk4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-34194-cherry-mash-candy-VAT-step-04-3d6dbffe14be40e2b127f93a1dc514f8.jpg"
      ],
      "image": "assets/images/34194/step_04.webp"
    },
    {
      "text": "Melt chocolate chips and peanut butter together in a microwave-safe glass or ceramic bowl in 15-second intervals, stirring after each interval, 1 to 3 minutes; pour over cherry mixture and spread evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/14Bu-NDucdxW0Rr8jJSVag0b3iQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-34194-cherry-mash-candy-VAT-step-05-2-ee0ca56669db47b29731eb2b3980151a.jpg"
      ],
      "image": "assets/images/34194/step_05.webp"
    },
    {
      "text": "Allow to cool completely before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nG0siKRDt0RIHw4L_F8oWrOMPxY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-34194-cherry-mash-candy-VAT-step-06-569d9a29b7e64b76a1f2b031c245a2fc.jpg"
