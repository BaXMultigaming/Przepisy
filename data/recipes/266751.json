  "ingredients": [
    "3 medium ripe bananas, mashed",
    "1 large ripe banana, mashed",
    "0.33333334326744 cup butter, melted",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.75 cup dark brown sugar",
    "0.75 cup all-purpose flour",
    "0.75 cup whole wheat flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.75 teaspoon ground cinnamon, or more to taste",
    "0.25 teaspoon ground nutmeg, or more to taste",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bananas, melted butter, egg, and vanilla extract in a bowl. Sift in brown sugar. Mix well and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift all-purpose flour, whole wheat flour, baking powder, baking soda, cinnamon, nutmeg, and salt into a separate bowl. Slowly fold flour mixture into the banana mixture, being careful not to overmix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop batter evenly into the muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 27 minutes. Remove from the muffin tin and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
