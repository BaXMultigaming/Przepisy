  "ingredients": [
    "4.5 cups potatoes - peeled and cubed",
    "4 slices bacon",
    "1 cup cubed Cheddar cheese",
    "0.5 cup sweet pickle relish",
    "0.25 cup chopped onion",
    "0.25 cup sliced pimiento-stuffed green olives",
    "0.33333334326744 cup mayonnaise",
    "0.125 teaspoon celery salt",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place the potatoes into a large pot and cover with salted water. Bring to a boil over high heat, then reduce heat to medium-low, cover, and simmer until tender, about 20 minutes. Drain thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place the bacon in a large, deep skillet, and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain the bacon slices on a paper towel-lined plate, then crumble. Set the bacon aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the potatoes, Cheddar cheese, relish, onion, and olives in a large bowl. Stir in the mayonnaise, celery salt, and black pepper. Transfer the mixture into the prepared baking dish, and sprinkle with bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the potatoes are browned and the cheese is melted, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
