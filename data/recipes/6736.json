  "title": "Tomato Bread",
  "description": "This homemade tomato bread made with easy baking ingredients, tomato juice, garlic, and herbs is a delicious savory bread with pizza-like flavor.",
  "authors": [
    "Jerry La Cross"
  ],
  "date_published": "1998-05-31T14:59:13-04:00",
