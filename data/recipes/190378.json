  "ingredients": [
    "4 slices multigrain bread",
    "2 eggs",
    "0.75 cup milk",
    "1 teaspoon orange juice",
    "2 teaspoons grated orange zest",
    "1 teaspoon vanilla extract",
    "1 teaspoon white sugar",
    "0.25 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.25 tablespoon ground nutmeg",
    "2 teaspoons light butter"
  ],
  "steps": [
    {
      "text": "Place bread in a flat bottomed dish. Whisk together the eggs, milk, orange juice, orange zest, vanilla, sugar, salt, cinnamon, and nutmeg in a mixing bowl. Pour egg mixture over bread, and refrigerate until bread absorbs the liquid, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large non-stick skillet over medium heat. Place bread into skillet. Cook until golden, about 3 minutes per side.",
