  "ingredients": [
    "1.6666667461395 cups all-purpose flour",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.75 cup butter, softened",
    "0.75 cup packed brown sugar",
    "0.33333334326744 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2 cups milk chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour, baking powder, baking soda, and salt; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the butter, brown sugar, and white sugar until smooth. Beat in the egg and vanilla. Gradually stir in the sifted ingredients, then stir in the chocolate chips. Drop by rounded tablespoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes in preheated oven. Allow cookies to cool on baking sheet for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
