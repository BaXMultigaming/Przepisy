  "ingredients": [
    "1 packet CARNATION BREAKFAST ESSENTIALS® Rich Milk Chocolate Powdered Drink Mix",
    "1 cup milk",
    "1 cup plain yogurt",
    "0.5 cup graham cracker crumbs",
    "0.5 cup miniature marshmallows, or more to taste"
  ],
  "steps": [
    {
      "text": "Mix milk, drink mix packet, and yogurt together in a bowl until smooth and well combined.",
