  "ingredients": [
    "0.25 cup distilled white vinegar",
    "0.33333334326744 cup vegetable oil",
    "0.33333334326744 cup soy sauce",
    "1 lime, juiced",
    "0.5 lemon, juiced",
    "0.25 cup sherry",
    "2 tablespoons ground mustard",
    "2 teaspoons honey",
    "4 cloves garlic, crushed",
    "0.33333334326744 cup brown sugar",
    "2 tablespoons lemon pepper",
    "1 teaspoon dried oregano",
    "1 teaspoon rosemary",
    "1 teaspoon salt",
    "6 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Stir vinegar, oil, soy sauce, lime juice, lemon juice, sherry, mustard, and honey together in a large bowl. Add garlic, brown sugar, lemon pepper, oregano, rosemary, and salt. Place chicken in marinade. Cover, and marinate in the refrigerator 8 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil the grill grate. Place chicken on the grill (discard marinade). Cook 6 to 8 minutes per side, until juices run clear. An instant-read thermometer inserted into the thickest part of breast should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
