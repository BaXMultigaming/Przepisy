  "ingredients": [
    "1 pound rotini pasta",
    "5 small zucchini, sliced",
    "0.33333334326744 cup olive oil",
    "4 cloves garlic, minced",
    "1 pinch crushed red pepper flakes",
    "0.33333334326744 cup chopped fresh parsley",
    "0.5 cup grated Parmesan cheese",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta in boiling water until tender yet firm to the bite, 8 to 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a medium saucepan with lightly salted water. Add zucchini and bring to a boil; cook until zucchini is tender, about 3 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat olive oil in a large skillet over medium heat. Sauté garlic and red pepper flakes in hot oil until fragrant. Add zucchini and parsley. Cook, stirring occasionally, until parsley is wilted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pasta and toss until well combined. Sprinkle with cheese. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
