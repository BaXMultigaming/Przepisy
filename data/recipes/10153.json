  "ingredients": [
    "0.66666668653488 cup butter",
    "1 cup white sugar",
    "2 teaspoons vanilla extract",
    "2 eggs",
    "2.5 cups all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Cream together the butter or margarine, sugar and vanilla. Add the eggs. In a separate bowl, mix dry ingredients. Gradually add to the creamed mixture and blend. Chill until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For each cookie: Roll: 1 ball for the body (1 inch), 1 ball for the head (3/4 inch), 4 small balls for arms/legs (1/2inch), 2 smaller balls for ears, and 1 tiny ball for the nose. Arrange on ungreased cookie sheet. With tooth pick, draw eyes and mouth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 6 minutes or until set. Let cool 1 minute, then remove from cookie sheet. Optional: Make a ribbon around their necks using licorice whips (after baking).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
