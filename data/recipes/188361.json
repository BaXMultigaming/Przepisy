  "title": "Cocoa Banana Bars",
  "description": "These pretty, marbled bar cookies are very moist with a rich banana and chocolate flavor.",
  "authors": [
    "Lisa"
  ],
  "date_published": "2020-06-18T23:39:00-04:00",
