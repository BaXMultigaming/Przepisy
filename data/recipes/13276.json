  "title": "Soup La Angelena",
  "description": "This is a vegetarian soup containing barley, rice, and potatoes in a broth filled with a wide variety of fresh garden vegetables ranging from onions and carrots to green beans, petite peas, and broccoli florets.",
  "authors": [
    "William Uncle Bill Anatooskin"
  ],
  "date_published": "1999-05-24T08:14:22-04:00",
  "date_modified": "2022-08-04T11:52:07-04:00",
