  "ingredients": [
    "1 (3 ounce) package chicken flavored ramen noodles",
    "0.25 cup butter",
    "0.5 cup sesame seeds, toasted",
    "0.5 cup blanched slivered almonds",
    "1 large head napa cabbage, shredded",
    "6 green onions, chopped",
    "0.25 cup vegetable oil",
    "0.25 cup rice wine vinegar",
    "1 tablespoon soy sauce",
    "1 tablespoon sesame oil",
    "0.125 cup white sugar"
  ],
  "steps": [
    {
      "text": "Crush noodles, place them in a medium skillet and brown in butter over medium heat. Add almonds and sesame seeds. Stir often to prevent burning. Add seasoning mix from noodles and cool. Toss in a large bowl with cabbage and onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare the dressing by whisking together the vegetable oil, rice vinegar, soy sauce, sesame oil and sugar. Pour over salad, toss and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
