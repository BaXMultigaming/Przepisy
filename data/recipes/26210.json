  "title": "Persimmon Cookies III",
  "description": "Great for Christmas Cookies! A spicy and moist cookie made from persimmon pulp. Raisins and nuts make them extra special.",
  "authors": [
    "MARY ANN PUTMAN"
  ],
  "date_published": "2020-06-18T23:06:53-04:00",
