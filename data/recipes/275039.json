  "ingredients": [
    "2 teaspoons canola oil",
    "1 sweet onion, thinly sliced",
    "2 teaspoons chopped fresh rosemary",
    "0.33333334326744 teaspoon freshly ground black pepper, or to taste",
    "0.5 teaspoon salt",
    "1.5 tablespoons water",
    "1 prepared whole wheat pizza crust",
    "1 (8 ounce) round Brie cheese, thinly sliced",
    "1 cup fresh raspberries",
    "1 fresh peach, sliced",
    "0.25 cup chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly oil a pizza stone or a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat canola oil in a skillet over medium heat. Saute onion in the hot oil until soft, 5 to 7 minutes. Add rosemary, pepper, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer onion mixture carefully to an electric blender, add water, and puree gently. Spread puree on prepared crust. Top with Brie cheese, raspberries, and peach slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden and cheese is bubbly, 6 to 8 minutes. Top with fresh basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
