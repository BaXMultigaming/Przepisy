  "ingredients": [
    "1.25 cups graham cracker crumbs",
    "6 tablespoons butter, melted",
    "0.25 cup white sugar",
    "0.75 cup cold water",
    "0.5 cup white sugar",
    "1 (.25 ounce) package unflavored gelatin",
    "1 cup sour cream",
    "1 (8 ounce) container blueberry-flavored yogurt",
    "0.5 teaspoon vanilla extract",
    "0.5 cup heavy whipping cream",
    "1 cup blueberries"
  ],
  "steps": [
    {
      "text": "Combine graham cracker crumbs, melted butter, and ¼ cup sugar in a medium bowl. Reserve ¼ cup crust mixture; press remaining crust mixture into the bottom of a 10x6x2-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cold water, ½ sugar, and gelatin in a small saucepan over medium-low heat; cook and stir until gelatin and sugar dissolve, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sour cream and yogurt in a large bowl; gradually stir in gelatin mixture, then stir in vanilla. Refrigerate mixture until partially set, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat heavy cream in a glass or metal bowl until soft peaks form; fold in sour cream mixture. Stir in blueberries until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread blueberry cream evenly over crust; sprinkle reserved ¼ graham cracker mixture over top. Chill in the refrigerator, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
