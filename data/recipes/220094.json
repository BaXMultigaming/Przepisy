    "publisher-tested"
  ],
  "ingredients": [
    "1 teaspoon olive oil for brushing",
    "2 large eggs",
    "2 tablespoons water",
    "1 cup grated Parmesan cheese",
    "1 cup Italian-seasoned bread crumbs",
    "salt and ground black pepper to taste",
    "2 large eggplants, peeled and sliced into 1/2-inch rounds",
    "2 tablespoons olive oil",
    "1 pound ground beef",
    "48 ounces chunky tomato sauce (such as Prego®)",
    "2 cups shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 2 baking sheets and a 9x13-inch baking dish with 1 teaspoon olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and water together in a shallow dish. Combine Parmesan cheese, bread crumbs, salt, and pepper in a separate shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/douR3YtJtAfYt7wdVHvSE0aHP3Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220094-EggplantLasagna-ddms-4x3-step1-131e7657fcc24d6eb87ddd7b33796fc9.jpg"
      ],
      "image": "assets/images/220094/step_02.webp"
    },
    {
      "text": "Dip eggplant slices into egg mixture, then press into bread crumb mixture. Gently tap off any excess crumbs. Arrange breaded eggplant slices on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qV4dB1yJdD0ONdK54zsFl1IECys=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220094-EggplantLasagna-ddms-4x3-step2-33dfdd5ba45e4e03bc06bcf0787fdab1.jpg"
      ],
      "image": "assets/images/220094/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until the bottoms are golden brown, 20 to 25 minutes. Flip eggplant and continue baking until tender, 20 to 25 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2dxH1pATyGSuGGcJXJtjEiJkMA8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220094-EggplantLasagna-ddms-4x3-step3-86e7fffe743c4b4ab95b85f05bc38bfa.jpg"
      ],
      "image": "assets/images/220094/step_04.webp"
    },
    {
      "text": "Increase the oven temperature to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 2 tablespoons olive oil in a skillet over medium-high heat. Stir in ground beef; season with salt and pepper. Cook and stir until beef is browned and crumbly, about 10 minutes. Drain excess grease. Stir tomato sauce into ground beef; bring to a simmer, then set sauce aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ln47eg9RCC1bG8G0RjPpOJQ2ZV0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220094-EggplantLasagna-ddms-4x3-step4-3f8b324a677f47b8a412d774fec65ec6.jpg"
      ],
      "image": "assets/images/220094/step_06.webp"
    },
    {
      "text": "Place 1/3 of the eggplant slices on the bottom of the prepared baking dish. Pour 1/3 of the meat sauce on top of eggplant layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SeUt9vDS3Rx0A0KGSl48dM2t3pQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220094-EggplantLasagna-ddms-4x3-step5-489dfc95c2f144b08258ade82270ccd9.jpg"
      ],
      "image": "assets/images/220094/step_07.webp"
    },
    {
      "text": "Sprinkle 1/3 of the mozzarella cheese on top of sauce layer. Repeat this step 2 more times, finishing with a layer of mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lPKd1pqAWG9L7yKjg4HqgLREgo0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220094-EggplantLasagna-ddms-4x3-step6-f8abca76884c4d5fba0d5ae47013cb40.jpg"
      ],
      "image": "assets/images/220094/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and sauce is bubbling, 10 to 15 minutes. Cool for 5 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7DBOUq6k1HooFE2j8v5i15NRUH0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220094-eggplant-lasagna-ddmfs-3X4-0585-c075d85237b24529aef5039b541f9af8.jpg"
      ],
      "image": "assets/images/220094/step_09.webp"
    }
  ],
