  "title": "Eggplant Lasagna",
  "description": "This eggplant lasagna is made with slices of tender roasted eggplant instead of noodles, layered with sauce and cheese for a comforting low carb meal.",
  "authors": [
    "GENKIANNA"
  ],
  "date_published": "2019-04-03T23:51:34-04:00",
