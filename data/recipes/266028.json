  "ingredients": [
    "2 (7 ounce) packages fresh udon noodles",
    "1.5 tablespoons honey",
    "1 tablespoon soy sauce",
    "1 tablespoon sriracha sauce",
    "0.5 tablespoon rice vinegar",
    "2 strips bacon, chopped",
    "1.5 cups chopped kimchi",
    "1 clove garlic, minced",
    "1 teaspoon toasted sesame oil",
    "4 scallions, diagonally sliced"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook udon in boiling water, stirring occasionally, until noodles are tender yet firm to the bite, 3 to 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix honey, soy sauce, Sriracha, and rice vinegar together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a large pan over high heat until fat is rendered but bacon is not yet crispy, 2 to 3 minutes. Add kimchi and garlic; cook for 1 minute. Add honey-soy sauce mixture, udon noodles, and sesame oil; stir well. Remove from the heat and transfer to a plate. Top with scallions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
