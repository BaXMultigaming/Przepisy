  "ingredients": [
    "0.5 cup mayonnaise",
    "0.25 cup Thai-style sweet chili sauce",
    "3 dashes Sriracha hot chile sauce, or to taste",
    "0.5 cup cornstarch, or as needed",
    "1 pound medium shrimp, peeled and deveined",
    "oil for frying",
    "8 lettuce leaves",
    "1 bunch green onion, chopped, or to taste"
  ],
  "steps": [
