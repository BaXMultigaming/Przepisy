  "ingredients": [
    "2.25 pounds white asparagus",
    "salt to taste",
    "0.25 cup butter, divided",
    "1 pinch white sugar",
    "7 ounces sliced ham"
  ],
  "steps": [
    {
      "text": "Peel asparagus spears from top to bottom with a vegetable peeler, starting below the tips. Cut off woody ends with a knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place asparagus spears in a large, wide saucepan and pour in enough lightly salted water to just cover. Bring water to a boil; add 1 tablespoon butter and sugar. Reduce heat; simmer until spears are tender and easily pierced with a knife, 15 to 25 minutes. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt remaining 3 tablespoons butter in a small pot over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap each asparagus spear with a slice of ham. Arrange on a serving plate; drizzle melted butter on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
