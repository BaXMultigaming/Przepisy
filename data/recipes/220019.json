  "ingredients": [
    "0.33333334326744 cup vegetable oil",
    "0.33333334326744 cup all-purpose flour",
    "3 cups water",
    "0.75 pound smoked sausage, quartered lengthwise and sliced",
    "1.5 cups cubed cooked chicken",
    "2 cups sliced okra",
    "1 cup chopped onion",
    "0.5 cup chopped green bell pepper",
    "0.5 cup chopped celery",
    "4 cloves garlic, minced",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Heat the vegetable oil in a saucepan over medium-high heat. Whisk in the flour to form a thick paste until smooth, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium and continue cooking, whisking constantly, until the flour turns a dark reddish-brown roux, about 15 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour water into a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the roux, sausage, chicken, okra, onion, bell pepper, celery, garlic, salt, black pepper, and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low for 6 to 7 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Skim off fat with a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
