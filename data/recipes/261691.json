  "ingredients": [
    "0.5 cup sliced almonds, divided",
    "0.5 cup packed brown sugar",
    "1 tablespoon Dijon mustard",
    "1 (8 ounce) round Brie cheese",
    "1 French baguette",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coarsely chop 1/4 cup almonds and place into a small bowl. Add brown sugar and mustard; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut Brie round horizontally in half. Place 1 half, cut-side up, in the center of a round baking stone. Spread 1/2 of the brown sugar mixture evenly over the top. Cover with remaining Brie half, cut-side up. Spread remaining brown sugar mixture on top. Sprinkle with remaining 1/4 cup almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut baguette diagonally into slices. Arrange slices around Brie and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until baguette slices are golden brown and Brie begins to soften, 8 to 10 minutes. Let baked Brie stand for about 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
