  "ingredients": [
    "1.5 pounds pork cutlets, cut into bite-sized pieces",
    "3 tablespoons cornstarch",
    "1 teaspoon sesame oil",
    "1 serving nonstick cooking spray",
    "0.25 cup white sugar",
    "0.25 cup rice vinegar",
    "4 tablespoons ketchup",
    "2 tablespoons soy sauce"
  ],
  "steps": [
    {
      "text": "Place pork, cornstarch, and sesame oil in a bowl and toss to coat. Let sit for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat the air fryer to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray the basket of the air fryer with cooking spray. Place pork in the basket of the air fryer and spray top of pork with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook for 10 minutes. Shake the basket and cook pork until desired crispness, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the pork is cooking, combine sugar, vinegar, ketchup, and soy sauce in a saucepan over medium-high heat. Whisk constantly until sugar is dissolved and mixture comes to a boil. Reduce heat to low and keep sauce warm until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pork to a bowl. Pour sauce on top of the pork and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
