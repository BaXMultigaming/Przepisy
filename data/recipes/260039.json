  "ingredients": [
    "1.3333333730698 cups coarsely chopped pecans",
    "1.25 cups butter, divided",
    "3 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "2 cups white sugar",
    "4 eggs",
    "1 cup milk",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Combine pecans and 1/4 cup butter in a baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pecans in the preheated oven until toasted and fragrant, about 20 minutes. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1 cup butter and sugar in a large bowl; beat with an electric mixer until creamy. Beat in eggs one at a time. Mix in flour mixture, alternating with milk and vanilla extract, until batter is smooth. Fold in pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce oven temperature to 325 degrees F (165 degrees C). Grease a fluted tube pan (such as Bundt®).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
