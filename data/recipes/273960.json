  "ingredients": [
    "cooking spray",
    "1 (1 pound) loaf sourdough bread, sliced",
    "2 cups shredded Cheddar cheese, divided",
    "0.5 cup diced sweet onion",
    "1 cup diced green bell pepper",
    "1 cup diced yellow bell pepper",
    "1 cup diced red bell pepper",
    "12 ounces cooked and crumbled bacon",
    "8 eggs",
    "1 cup sour cream",
    "0.5 teaspoon dry mustard",
    "1 tablespoon herb seasoning blend (such as Spice Merchant® Great Lakes blend)",
    "0.25 teaspoon salt",
    "0.25 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "Spray a 9x13-inch glass baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay slices of bread in the bottom of the prepared pan in a single layer, trimming and filling in gaps as necessary. Spread 1 cup Cheddar cheese, onion, green bell pepper, yellow bell pepper, red bell pepper, and bacon on top, in that order.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, sour cream, mustard, seasoning blend, salt, and pepper together in a bowl until well combined. Pour mixture over bread, making sure to soak the top layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover baking pan and refrigerate strata at least 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Uncover strata and bake in the preheated oven for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle remaining Cheddar cheese evenly on top and return to the hot oven. Bake until Cheddar cheese is melted, 10 to 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let strata stand 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
