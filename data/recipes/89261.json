  "ingredients": [
    "nonstick cooking spray",
    "4 tilapia fillets",
    "3 tablespoons fresh lemon juice",
    "1 tablespoon butter, melted",
    "1 clove garlic, finely chopped",
    "1 teaspoon dried parsley flakes",
    "1 dash pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a baking dish with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse tilapia fillets under cool water, and pat dry with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C1LBVxcBkpTA2ctvU0kzPwTNpnA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/89261-lemon-garlic-tilapia-step-1-70-f2d635b0aa0b40fc87624b126c3836ef.jpg"
      ],
      "image": "assets/images/89261/step_02.webp"
    },
    {
      "text": "Place fillets in the prepared baking dish. Pour lemon juice over fillets, then drizzle butter on top. Sprinkle with garlic, parsley, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6qPN1hBnbpOBxDzCBdTdfGVfYv8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/89261-lemon-garlic-tilapia-step-3-72-0227e6a956ed4362bdf865f9a01442c2.jpg"
      ],
      "image": "assets/images/89261/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until fish is white and flakes when pulled apart with a fork, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PgPKq1WgnlyqCxTnQvM5QmLK-Qc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/89261-lemon-garlic-tilapia-DDMFS-4x3-febefb0fdfe34d4ea855eaeac04fc470.jpg"
