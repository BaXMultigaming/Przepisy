  "ingredients": [
    "1 cup all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup milk",
    "1 egg",
    "2 tablespoons vegetable oil",
    "1 tablespoon maple syrup",
    "2 teaspoons ground cinnamon",
    "1 teaspoon nutmeg",
    "1 teaspoon ground cloves",
    "2 teaspoons vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Mix flour, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, egg, 2 tablespoons vegetable oil, maple syrup, cinnamon, nutmeg, and cloves together in a separate bowl. Stir milk mixture into flour mixture until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 2 teaspoons vegetable oil on a griddle over medium heat; pour about 1/4 cup batter onto the hot griddle. Cook until bubbles begin to form on top of pancakes, 3 to 5 minutes. Flip and cook until second side is golden brown, 3 to 5 more minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
