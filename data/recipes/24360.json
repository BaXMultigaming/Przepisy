  "ingredients": [
    "4 cups diced potatoes",
    "1 cup chopped celery",
    "3 green onions, sliced",
    "3 tablespoons vinegar",
    "3 tablespoons vegetable oil",
    "0.25 teaspoon salt",
    "0.25 teaspoon pepper",
    "0.5 teaspoon dried dill weed",
    "0.75 cup sour cream",
    "2 dill pickles, chopped",
    "1 tomato, cut into wedges"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes. Drain and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine potatoes, celery and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl combine vinegar, oil, salt, pepper and dill weed. Pour over potatoes and toss gently. Refrigerate for several hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in sour cream, and pickles just before serving. Garnish with tomato wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
