  "ingredients": [
    "1.5 pounds fresh tuna steaks, 1 inch thick",
    "2 tablespoons Cajun seasoning",
    "2 tablespoons olive oil",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Generously coat tuna steaks on both sides with Cajun seasoning.",
      "section": null,
      "name": null,
