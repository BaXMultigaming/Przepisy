  "ingredients": [
    "4 large fresh tomatoes",
    "4 ounces goat cheese",
    "1 tablespoon chopped bottled roasted red peppers",
    "2 tablespoons olive oil",
    "2 tablespoons bread crumbs",
    "1 tablespoon torn fresh basil leaves",
    "kosher salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice the tops off of the tomatoes and hollow out by removing the seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix the goat cheese and chopped red peppers together. Spoon an equal amount of the cheese mixture into each hollowed out tomato. Place stuffed tomatoes upright in a baking dish. Top each tomato evenly with the bread crumbs and torn basil. Drizzle with olive oil and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place under broiler for 5 to 10 minutes until bread crumbs are lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
