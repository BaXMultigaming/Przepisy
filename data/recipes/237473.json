  "ingredients": [
    "2.5 cups cold water",
    "0.5 cup kosher salt (such as Diamond Crystal®)",
    "0.33333334326744 cup white sugar",
    "1 pound center-cut salmon fillet, pin bones removed"
  ],
  "steps": [
    {
      "text": "Whisk together cold water, salt, and sugar in a large bowl until sugar and salt are completely dissolved. Set brine aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut salmon along one side of the center connective tissue to the skin but not through. Turn the knife parallel to the cutting board and cut salmon meat from skin. Repeat on the remaining side; discard skin and connective tissue. Cut each fillet into 1/4-inch slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches of 5, place slices in brine for 3 minutes. Use a slotted spoon to remove cured slices to a wire rack; blot gently with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange cured salmon in a single layer on a platter, cover with plastic wrap, and refrigerate until chilled, 2 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
