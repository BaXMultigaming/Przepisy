  "ingredients": [
    "0.5 pound bacon, diced",
    "0.5 pound ground beef",
    "1 onion, diced",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "0.25 cup ketchup",
    "0.25 cup barbeque sauce",
    "2 tablespoons prepared yellow mustard",
    "2 tablespoons molasses",
    "2 teaspoons chili powder",
    "0.5 teaspoon ground black pepper",
    "2 (16 ounce) cans pork and beans",
    "1 (16 ounce) can kidney beans, rinsed and drained",
    "1 (16 ounce) can butter beans, rinsed and drained"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium heat. Add bacon, ground beef, and onion; cook until bacon and ground beef completely browned, 7 to 10 minutes. Drain any excess fat; transfer to a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir white sugar, brown sugar, ketchup, barbecue sauce, mustard, molasses, chili powder, and black pepper together in a bowl; pour over bacon mixture. Add pork and beans, kidney beans, and butter beans; mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until liquid thickens, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
