  "ingredients": [
    "1 (16 ounce) package uncooked rigatoni pasta",
    "0.25 cup butter",
    "1 clove garlic, crushed",
    "0.5 cup cubed sharp Cheddar cheese",
    "0.5 cup cubed Gouda cheese",
    "0.25 cup grated Parmesan cheese",
    "0.25 cup blue cheese dressing",
    "0.5 cup milk",
    "paprika to taste",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil, and cook the rigatoni pasta 8 to 10 minutes, until al dente. Drain, and return pasta to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the pot with the pasta, mix the butter, garlic, Cheddar cheese, Gouda cheese, and Parmesan cheese. Cook and stir over low heat. Be careful not to have too much heat, as the cheese will get stringy. Gradually mix in the blue cheese dressing and milk. Continue to cook and stir until the pasta is well coated. Season with paprika, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
