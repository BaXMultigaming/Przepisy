  "ingredients": [
    "1 teaspoon olive oil",
    "1 cup diced zucchini",
    "0.5 cup minced onion",
    "1 clove garlic, peeled and minced",
    "2 cups diced fresh tomatoes",
    "2 tablespoons chopped fresh basil",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "4 (6 ounce) halibut steaks",
    "0.33333334326744 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Lightly grease a shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a medium saucepan over medium heat and stir in zucchini, onion, and garlic. Cook and stir 5 minutes or until tender. Remove saucepan from heat and mix in tomatoes, basil, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange halibut steaks in a single layer in the prepared baking dish. Spoon equal amounts of the zucchini mixture over each steak. Top with feta cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 15 minutes in the preheated oven, or until fish is easily flaked with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
