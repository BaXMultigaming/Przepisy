  "ingredients": [
    "2.25 cups all-purpose flour",
    "0.33333298563957 cup white sugar",
    "2 teaspoons baking soda",
    "0.25 cup margarine, softened",
    "0.5 cup egg substitute",
    "1 cup lowfat buttermilk",
    "2 tablespoons frozen orange juice concentrate",
    "1 tablespoon vanilla extract",
    "1 cup grated carrots",
    "0.5 cup raisins, plumped and drained",
    "6 tablespoons lowfat cream cheese, softened",
    "2 tablespoons nonfat sour cream",
    "0.33333298563957 cup white sugar",
    "0.5 cup finely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the flour, 1/3 cup of sugar, and baking soda. Add the margarine, buttermilk, egg substitute, orange juice, and vanilla, mix until smooth, then stir in the carrots and raisins. Fill each of the prepared muffin cups 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix together the cream cheese, sour cream, and remaining 1/3 cup of sugar, until smooth, then stir in the walnuts. Drop a spoonful of the cream cheese mixture onto the top of each cup of muffin batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 20 to 25 minutes, or until golden brown. Remove from the pan and place on a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
