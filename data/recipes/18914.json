  "ingredients": [
    "1 small onion, chopped",
    "1 small green bell pepper, chopped",
    "2 cloves garlic, chopped",
    "1 tablespoon fresh cilantro leaves",
    "1 teaspoon annatto or achiote powder",
    "1 tablespoon olive oil",
    "0.5 cup diced ham",
    "1 (16.5 ounce) can red beans, drained",
    "1 cup peeled and diced potatoes",
    "0.5 cup peeled and diced pumpkin",
    "1 cup water",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "In a blender or food processor, puree onion, bell pepper, garlic, cilantro, and annatto powder. Set mixture aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large, heavy saucepan over medium heat. Pour in olive oil and saute ham with pureed mixture for 10 minutes, until browned. Mix in beans, potatoes, pumpkin, water, and salt. Reduce heat to low and simmer, stirring occasionally, for approximately 25 minutes, until mixture thickens and potatoes and pumpkin are tender.",
      "section": null,
