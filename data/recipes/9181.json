  "ingredients": [
    "2 cups dried parsley",
    "1 cup rubbed sage",
    "0.5 teaspoon ground sage",
    "0.5 cup dried rosemary, crushed",
    "0.5 cup dried marjoram",
    "2 tablespoons salt",
    "1 tablespoon ground black pepper",
    "2 teaspoons onion powder"
