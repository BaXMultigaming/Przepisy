  "ingredients": [
    "1 (18 ounce) package extra-firm tofu, slice 1/2-inch thick",
    "1 tablespoon olive oil",
    "salt and ground black pepper to taste",
    "1 green onion, thinly sliced",
    "2 tablespoons soy sauce",
    "2 tablespoons Sriracha hot sauce, or to taste",
    "1.5 teaspoons sesame oil",
    "1 teaspoon chile-garlic sauce",
    "1 teaspoon sesame seeds",
    "0.5 teaspoon minced garlic"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange tofu slices onto a baking sheet. Brush olive oil over the top of each slice. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned on top, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make sauce: Stir together green onion, soy sauce, Sriracha, sesame oil, chile-garlic sauce, sesame seeds, and garlic in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon sauce over tofu slices. Continue baking until sauce is warmed, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
