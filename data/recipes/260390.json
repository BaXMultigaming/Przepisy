  "ingredients": [
    "10 tablespoons unsalted butter, divided",
    "3 cups rolled oats",
    "2 eggs",
    "0.5 cup white sugar",
    "1 teaspoon vanilla sugar",
    "1 teaspoon baking powder",
    "1.5 cups finely chopped, pitted dates"
  ],
  "steps": [
    {
      "text": "Melt 9 tablespoons butter in a small saucepan over low heat; mix in oats. Remove from heat and let cool, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix eggs, sugar, vanilla sugar, and baking powder together in a large bowl; stir in dates-oat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a baking sheet with remaining 1 tablespoon butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use 2 teaspoons to place little mounds of oat-date mixture 2 inches apart onto the baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned on the top and bottom, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
