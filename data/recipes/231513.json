  "ingredients": [
    "2 cups packed brown sugar",
    "1 cup shortening",
    "0.33333334326744 cup milk",
    "1 egg",
    "1 teaspoon vanilla extract",
    "4 cups quick cooking oats",
    "1.75 cups all-purpose flour, or more if needed",
    "1 teaspoon baking soda",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, shortening, milk, egg, and vanilla in a bowl until mixture is creamy. Stir in oats, flour, baking soda, and salt. Drop spoonfuls of dough onto ungreased baking sheets.",
