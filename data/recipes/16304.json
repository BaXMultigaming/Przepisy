  "ingredients": [
    "10 ounces egg noodles",
    "1.5 pounds ground beef",
    "1 (14.5 ounce) can peeled and diced tomatoes with juice",
    "1 teaspoon salt",
    "1 tablespoon white sugar",
    "1.5 cups sour cream",
    "3 ounces cream cheese",
    "0.5 onion, chopped",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet over medium heat, brown the ground beef. Add the tomatoes with juice, salt and sugar and simmer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate medium bowl, combine the sour cream, cream cheese and onion and mix well. In a 9x13 inch baking dish, place half of the egg noodles, then all of the meat mixture, then the cream mixture. Top with the remaining noodles and sprinkle with the cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
