  "title": "Husband's Delight",
  "description": "This ground beef casserole is layered with egg noodles and a mixture of sour cream, cream cheese, and onions, then topped with cheddar and baked.",
  "authors": [
    "Cathy"
  ],
  "date_published": "1999-11-23T12:39:30-05:00",
