  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 cup brown sugar",
    "0.5 cup white sugar",
    "0.5 cup tahini",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1.125 cups all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1.5 cups chocolate chips",
    "1 cup chopped nuts"
  ],
  "steps": [
    {
      "text": "Cream butter, brown sugar, and white sugar in a bowl until fluffy. Beat in tahini. Add eggs and vanilla extract and continue to beat an additional 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, salt, baking powder, and baking soda in a separate bowl. Add flour mixture to butter mixture and beat until just combined. Add chocolate chips and nuts. Cover and refrigerate dough overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop out cookies into 1-inch balls using a cookie scoop and place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges start to brown lightly, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
