  "ingredients": [
    "8 roma (plum) tomatoes, halved",
    "12 cloves garlic, peeled",
    "4 tablespoons olive oil",
    "0.25 cup chopped fresh basil leaves",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tomato halves snugly side by side in a shallow baking dish. Insert whole cloves of garlic between tomatoes. Brush olive oil over the top and sprinkle with basil. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered in the preheated oven until tomatoes have softened and are sizzling in the pan with the edges slightly charred, 35 to 45 minutes. Serve hot.",
