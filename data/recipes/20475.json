  "ingredients": [
    "1 (21 ounce) can cherry pie filling",
    "1 (15 ounce) can crushed pineapple with juice",
    "1 (18.25 ounce) package butter cake mix",
    "2.5 cups flaked coconut",
    "1 cup pecan halves",
    "1 cup margarine, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cherry pie filling into a 9x13-inch baking dish; top with pineapple but do not stir. Sprinkle cake mix over pineapple; sprinkle coconut over cake mix. Sprinkle pecans over coconut; pour melted margarine over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, about 40 minutes.",
      "section": null,
