  "ingredients": [
    "2 egg yolks",
    "0.25 cup butter or margarine, melted",
    "0.25 cup boiling water",
    "1.5 tablespoons lemon juice",
    "0.25 teaspoon salt",
    "1 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Whisk egg yolks lightly in the top of a double boiler over simmering water. Slowly whisk in melted butter, then gradually whisk in boiling water. Cook, stirring, until thickened. Remove the double boiler top from the base.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually whisk in lemon juice. Season with salt and cayenne. Cover and keep hot over warm water until serving.",
      "section": null,
