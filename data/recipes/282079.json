  "ingredients": [
    "2 cups all-purpose flour",
    "0.25 cup powdered sugar",
    "2 tablespoons cornstarch",
    "2 teaspoons lemon zest",
    "0.125 teaspoon salt",
    "0.25 cup unsalted butter, cut into chunks",
    "2 tablespoons vegetable oil",
    "1 cup chopped fresh strawberries",
    "1.3333333730698 cups white sugar",
    "4 large eggs",
    "0.33333334326744 cup all-purpose flour",
    "0.25 cup lemon juice",
    "0.125 teaspoon salt",
    "2 tablespoons powdered sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 cups flour, ¼ cup confectioners’ sugar, cornstarch, lemon zest, and ⅛ teaspoon salt in the bowl of a food processor; pulse to combine. Add butter and oil; pulse until incorporated and crumbly. Press into an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place strawberries in the bowl of a food processor; pulse until smooth. Strain mixture through a fine-mesh-sieve into a bowl; discard solids.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1 ⅓ cups white sugar, eggs, ⅓ cup flour, lemon juice, and ⅛ teaspoon salt into strawberry purée until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour strawberry filling into hot crust; bake until filling is just set, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool on a wire rack, about 30 minutes. Chill in the refrigerator, about 2 hours. Dust with 2 tablespoons confectioners' sugar; cut into 16 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
