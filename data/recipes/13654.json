  "ingredients": [
    "12 fresh mushrooms",
    "0.5 pound ground beef",
    "1 tablespoon minced onion",
    "1 clove garlic, minced",
    "1 tablespoon butter",
    "0.25 cup bread crumbs",
    "salt and pepper to taste",
    "0.25 cup heavy cream",
    "0.25 cup butter, melted",
    "1 teaspoon chili powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and chop mushroom stems.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, onion, and garlic in a saucepan over medium heat. Cook until beef is no longer pink; drain. Mix in chopped mushroom stems, 1 tablespoon butter, bread crumbs, salt, and pepper. Cook, stirring frequently, for 5 minutes. Remove from heat, and stir in cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip mushroom caps in 1/4 cup melted butter and stuff generously with meat mixture. Arrange stuffed mushrooms in a baking dish. Sprinkle with chili powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
