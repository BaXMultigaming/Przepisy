  "ingredients": [
    "0.5 pound ground beef",
    "1 tablespoon butter",
    "0.5 cup diced onion",
    "2 tablespoons taco seasoning",
    "1 (8 ounce) can tomato sauce",
    "1 cup chicken broth",
    "0.5 (15.25 ounce) can corn, drained",
    "0.5 (15 ounce) can black beans, rinsed and drained",
    "0.5 (5.6 ounce) package Spanish rice mix (such as Knorr®)",
    "0.25 cup salsa",
    "cooking spray",
    "0.5 cup shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium-high heat. Cook and stir ground beef until browned and crumbly, about 6 minutes. Drain off any grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add butter and onion to the skillet. Saute until onion is softened and fragrant, about 5 minutes. Sprinkle in taco seasoning and pour in tomato sauce. Stir to combine. Add broth, corn, black beans, Spanish rice mix, and salsa; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a casserole dish with nonstick cooking spray. Pour the beef mixture into the casserole dish. Top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and filling is bubbling, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
