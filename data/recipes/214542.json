  "ingredients": [
    "0.75 pound mahi mahi fillets",
    "1 teaspoon toasted sesame oil",
    "0.25 teaspoon garlic pepper seasoning",
    "1 tablespoon sesame seeds, toasted",
    "1.5 teaspoons grated fresh ginger"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 400 degrees F (200 degrees C). Spray a shallow baking dish with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat mahi mahi dry with paper towels. Drizzle with sesame oil, and season with garlic pepper. Press grated ginger and toasted sesame seeds onto both sides of the fish to coat. Place fish on the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the fish flakes easily with a fork, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
