  "ingredients": [
    "1 cup brown sugar",
    "0.25 cup all-purpose flour",
    "1.75 cups whole milk",
    "2 egg yolks, beaten",
    "0.25 cup butter"
  ],
  "steps": [
    {
      "text": "In a medium saucepan over medium heat, stir together brown sugar and flour. Stir in milk. Bring to a boil and boil for 1 minute. Remove from heat and stir in egg yolks and butter until smooth. Pour into serving dishes and chill 3 hours or overnight in the refrigerator.",
