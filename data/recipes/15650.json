  "ingredients": [
    "1 small sweet onion, sliced",
    "8 cloves garlic, crushed",
    "0.75 cup low sodium soy sauce",
    "0.5 cup vinegar",
    "1 (3 pound) whole chicken, cut into pieces"
  ],
  "steps": [
    {
      "text": "Place chicken in a slow cooker. In a small bowl mix the onion, garlic, soy sauce, and vinegar, and pour over the chicken. Cook on Low for 6 to 8 hours.",
