  "ingredients": [
    "1 tablespoon olive oil",
    "1 onion, thinly sliced",
    "1 leek, thinly sliced",
    "1 potato, cubed",
    "0.5 cup broccoli florets",
    "0.33333334326744 cup shredded cabbage",
    "2 cups vegetable broth",
    "salt and freshly ground black pepper to taste"
