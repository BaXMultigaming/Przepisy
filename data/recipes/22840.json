  "ingredients": [
    "6 slices bacon",
    "1 pint sour cream",
    "0.5 cup mayonnaise",
    "0.25 cup prepared horseradish",
    "1 lemon, juiced",
    "0.5 teaspoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Place the bacon in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine sour cream, mayonnaise, horseradish, and lemon juice. Stir well. Stir in bacon; cover and refrigerate for 1 hour. Stir and top with parsley before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
