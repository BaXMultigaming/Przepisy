  "ingredients": [
    "1 cup unsweetened almond milk",
    "2 tablespoons maple syrup",
    "0.5 teaspoon cornstarch",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine almond milk, maple syrup, and cornstarch in a small saucepan. Whisk until all the cornstarch is dissolved. Continue to stir frequently over medium heat until the mixture comes to a slow boil. Remove from heat and whisk in vanilla.",
