  "ingredients": [
    "1 tablespoon butter",
    "2 tablespoons cornmeal for dusting",
    "1 cup all-purpose flour",
    "0.5 cup semolina flour",
    "0.5 cup cornmeal",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "4 cups chopped fresh spinach",
    "3 cups buttermilk",
    "1 cup brine-packed feta cheese, crumbled",
    "4 eggs, lightly beaten",
    "0.66666668653488 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Butter 9x13-inch baking pan; sprinkle 2 tablespoons cornmeal on bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift all-purpose flour, semolina flour, 1/2 cup cornmeal, baking powder, and salt together in a bowl. Whisk spinach, buttermilk, feta cheese, eggs, and vegetable oil together in a separate large bowl. Stir flour mixture into spinach mixture just until pourable batter forms. Pour batter into prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
