  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Coat a baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Greek yogurt, Parmesan cheese, seasoned salt, garlic powder, and ground black pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange chicken breasts in a single layer in the prepared baking pan. Spread Greek yogurt mixture on top of chicken; sprinkle bread crumbs on top.",
