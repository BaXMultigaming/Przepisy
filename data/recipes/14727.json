  "ingredients": [
    "0.25 cup soy sauce",
    "0.33333334326744 cup packed brown sugar",
    "0.33333334326744 cup plum jam",
    "0.75 cup black cherry soda",
    "1 (1 pound) pork tenderloin"
  ],
  "steps": [
    {
      "text": "In a small sauce pan, mix together soy sauce, brown sugar, and jam over low heat until sugar has dissolved. Reserve 1/4 cup of sauce for basting the tenderloin while grilling. Combine remaining sauce with soda in a large plastic resealable bag; place meat in bag, and seal. Marinate in the refrigerator for at least 4 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat grill for medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil preheated grill, and discard marinade. Cook tenderloin for 15 to 20 minutes, or until an instant-read thermometer inserted into the center reads 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove meat from grill, and allow to rest for 5 minutes before slicing into 1/4 inch thick medallions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
