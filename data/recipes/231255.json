  "ingredients": [
    "1.5 cups converted long-grain white rice",
    "3 cups water",
    "1 pound ground beef",
    "2 cups water",
    "1 (20 ounce) jar pasta sauce (such as Ragu®)",
    "1 (10 ounce) can tomato soup",
    "3.5 pounds cabbage, cut into bite-size pieces",
    "1 onion, chopped",
    "salt and ground black pepper to taste",
    "1 dash hot pepper sauce"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TdpgOENlGIlkgXvZjx-TUMQXAgM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231255-cabbage-roll-soup-VAT-005-step-01-fc43b561373b47cda9395e88663d76db.jpg"
      ],
      "image": "assets/images/231255/step_01.webp"
    },
    {
      "text": "Bring converted rice and 3 cups water to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until the rice is tender and the liquid has been absorbed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KYJPKpMKQSTv4SD9AYquktjMZ1k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231255-cabbage-roll-soup-VAT-006-step-02-fbda0e8cac7f428f954f1b358cc90d7c.jpg"
      ],
      "image": "assets/images/231255/step_02.webp"
    },
    {
      "text": "Heat a large soup pot over medium-high heat. Cook and stir beef in the hot pan until browned and crumbly, 5 to 7 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vnDTMOqXnmANMtLAYEUJOsT2uXk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231255-cabbage-roll-soup-VAT-007-step-03-81e2904f13f94db8bc468dd0d62e1a02.jpg"
      ],
      "image": "assets/images/231255/step_03.webp"
    },
    {
      "text": "Stir 2 cups water, cooked rice, pasta sauce, tomato soup, cabbage, onion, salt, black pepper, and hot sauce into beef. Bring soup to a boil, reduce heat to medium-low, and cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8T12swn5h6LCUF-QZmpvp6WTxC4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231255-cabbage-roll-soup-VAT-008-step-04-37843932ba3b48f0ae61711bd98ab9b6.jpg"
      ],
      "image": "assets/images/231255/step_04.webp"
    },
    {
      "text": "Simmer until cabbage is soft and tender, stirring occasionally, about 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NLqzmjep_9EvsbQqMHWXZydlFcY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231255-cabbage-roll-soup-VAT-009-step-05-5bd686244a63425bac26dc16afbaf2a7.jpg"
