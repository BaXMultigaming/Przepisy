  "ingredients": [
    "0.25 cup all-purpose flour",
    "2 pounds beef round steak, cut into strips",
    "2 tablespoons vegetable oil",
    "1 (14.5 ounce) can cream of mushroom soup",
    "1 (14.5 ounce) can Cheddar cheese soup",
    "0.5 small onion, chopped",
    "1 tablespoon chopped green bell pepper, or more to taste",
    "1 clove garlic, minced",
    "1 teaspoon Worcestershire sauce",
    "0.5 teaspoon browning sauce (such as Kitchen Bouquet®), or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place flour into a bowl. Dredge round steak strips in flour to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a large skillet over medium heat; brown strips of round steak in the hot oil, 7 to 8 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer beef strips to a slow cooker. Add cream of mushroom soup, Cheddar cheese soup, onion, green bell pepper, garlic, Worcestershire sauce, and browning sauce; stir. Season mixture with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High and cook for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
