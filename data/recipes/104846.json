  "ingredients": [
    "1 medium onion, chopped",
    "0.25 cup pimento-stuffed green olives",
    "1 clove garlic",
    "2 tablespoons pickled jalapeno slices",
    "1 cup sweet green pickle relish",
    "1 cup mayonnaise",
    "25 buttery round crackers, crushed",
    "5 saltine crackers, crushed",
    "1 pinch curry powder"
  ],
  "steps": [
    {
      "text": "Place the onion, olives, garlic and jalapenos into the container of a food processor. Pulse until finely chopped. In a bowl, stir together the mayonnaise, relish, buttery round crackers and saltine crackers. Mix in the contents of the food processor and season with curry powder. Chill overnight before serving with seafood or vegetables.",
