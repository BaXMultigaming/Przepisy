  "ingredients": [
    "4.5 cups sifted all-purpose flour",
    "1 cup unsweetened cocoa powder",
    "3 teaspoons baking soda",
    "0.5 teaspoon salt",
    "3 cups white sugar",
    "3 cups water",
    "1 cup vegetable oil",
    "3 tablespoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, cocoa powder, baking soda, and salt in a large bowl. Add sugar and mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in water, oil, and vanilla; mix thoroughly until batter is smooth. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
