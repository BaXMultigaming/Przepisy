  "ingredients": [
    "1 tablespoon vegetable oil",
    "4 (4 ounce) pork loin chops, 1/2 inch thick",
    "3 teaspoons seasoning salt",
    "2 teaspoons ground black pepper",
    "1 onion, cut into strips",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
