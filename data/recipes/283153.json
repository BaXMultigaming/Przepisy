  "ingredients": [
    "4 (4 ounce) boneless, skinless chicken thighs",
    "0.5 teaspoon light adobo seasoning",
    "ground black pepper to taste",
    "1 cup Dijon mustard",
    "0.25 cup salted butter, melted",
    "1 cup dry bread crumbs, or as needed",
    "0.25 cup grated Parmesan cheese",
    "nonstick cooking spray",
    "1 teaspoon minced fresh parsley, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place a rack on a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Trim any fat off of chicken thighs and season with a light coating of adobo and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Dijon and melted butter together in a shallow bowl until you have a glossy, buttery mixture. Combine bread crumbs and Parmesan cheese in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken thighs in the Dijon mixture until evenly coated, then dredge in the bread crumb mixture. Transfer thighs to the prepared baking sheet and spray the tops with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven without flipping until no longer pink in the centers, 30 to 35 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with parsley to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
