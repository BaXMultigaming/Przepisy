  "ingredients": [
    "0.66666668653488 cup sour cream",
    "4 ounces cream cheese, softened",
    "0.33333334326744 cup mayonnaise",
    "1.5 tablespoons everything bagel seasoning, or to taste"
  ],
  "steps": [
    {
      "text": "Combine sour cream, cream cheese, and mayonnaise in the bowl of a mini food processor. Blend for 15 to 20 seconds; scrape down the sides of the bowl and add in bagel seasoning. Blend another 10 seconds and taste, adding more seasoning if desired. The flavor will develop the longer it sits.",
