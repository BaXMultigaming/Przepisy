  "ingredients": [
    "1 cup all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon dried oregano",
    "0.125 teaspoon black pepper",
    "2 eggs, lightly beaten",
    "0.67 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease a rimmed pizza pan or baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together flour, salt, oregano and black pepper. Mix in eggs and milk; stir well. Pour batter into prepared pan and tilt until evenly coated. Arrange toppings of choice on top of batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 to 25 minutes, until crust is set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove crust from oven. Drizzle on pizza sauce and sprinkle on cheese. Bake until cheese is melted, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
