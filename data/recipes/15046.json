  "ingredients": [
    "12 fresh peaches, pitted and sliced",
    "1 cup water",
    "1 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "1 (18.25 ounce) package white cake mix",
    "1 (8 ounce) package cream cheese",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread peach slices evenly in the bottom of a 9x13-inch baking dish. Stir water and sugar together in a small bowl until dissolved; pour mixture over peaches. Sprinkle cinnamon over peaches, then cake mix. Top cake mix with pats of cream cheese, then butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
