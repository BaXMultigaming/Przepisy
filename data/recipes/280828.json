  "ingredients": [
    "2.5 cups white sugar",
    "3 large eggs, lightly beaten",
    "3 ripe bananas, mashed",
    "1 teaspoon vanilla extract",
    "1 teaspoon lemon juice",
    "2 cups fresh blueberries",
    "1.5 cups chopped strawberries",
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking powder",
    "1 dash ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and eggs together in a large bowl. Add bananas, vanilla extract, and lemon juice; gently stir in blueberries and strawberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, cinnamon, baking powder, and nutmeg together in a bowl; fold into berry mixture until just blended. Divide batter between the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour and 10 minutes. Cool in the pans, 20 minutes. Invert loaves carefully onto a cooling rack; cool, 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
