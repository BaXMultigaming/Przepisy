  "ingredients": [
    "2 tablespoons olive oil",
    "1 onion, chopped",
    "2 large sweet potatoes, peeled and chopped",
    "3 carrots, chopped",
    "4 large cloves garlic, minced",
    "1 tablespoon garam masala",
    "0.25 teaspoon seasoned salt",
    "0.125 teaspoon cayenne pepper",
    "salt and ground black pepper to taste",
    "2 (16 ounce) cans chicken broth",
    "3 cups water",
    "4 cups chopped fresh spinach",
    "1.5 cups red lentils"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a pot over medium-low heat. Add onion and cook until translucent, about 5 minutes. Add sweet potatoes, carrots, garlic, garam masala, seasoned salt, cayenne pepper, salt, and pepper. Cook for 5 minutes. Add broth and water. Bring to a boil and cook until flavors start to blend, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add spinach and lentils; bring to a boil. Reduce heat to low and simmer until lentils are soft, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
