  "title": "Apple Jelly",
  "description": "This homemade apple jelly is easy to make with tender crushed apples for a delicious fruity treat on warm toast, roast pork, or cheese.",
  "authors": [
    "DelightfulDines"
  ],
  "date_published": "2020-06-18T23:51:07-04:00",
