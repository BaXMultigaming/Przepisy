  "ingredients": [
    "3 cups packed brown sugar",
    "0.75 cup shortening",
    "0.75 teaspoon cream of tartar",
    "4 eggs",
    "1 teaspoon vanilla extract",
    "5 cups all-purpose flour",
    "0.75 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the sugar, shortening and eggs. Add vanilla and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, mix together the flour, baking soda, and cream of tartar. Add to brown sugar mixture and stir until it is a soft dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out, cut with cookie cutters and bake for 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
