  "ingredients": [
    "18 ounces dried apricots",
    "1.75 cups water",
    "1 tablespoon cornstarch",
    "1 tablespoon orange liqueur",
    "1.75 cups white sugar",
    "1 recipe pastry for a 9 inch double crust pie"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice the dried apricots in half. Rinse them with water. Place them in a sauce pan with the water, bring to a boil and cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the cornstarch with the orange liqueur and about 1 tablespoon of the apricots' cooking liquid. Mix until smooth then stir into the cooked apricots. Add the white sugar and combine. Pour mixture into the unbaked pie shell and seal with the top crust. Brush milk over top crust for color, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 400 degrees F (205 degrees C) for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
