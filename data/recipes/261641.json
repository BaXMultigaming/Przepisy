  "ingredients": [
    "2 teaspoons coconut oil",
    "3.5 cups almond flour",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "2 large ripe bananas",
    "0.25 cup coconut oil, melted and cooled",
    "2 large eggs"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
