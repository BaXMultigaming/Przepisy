  "ingredients": [
    "1.75 cups unsweetened almond milk",
    "1 pinch salt",
    "1 cup old-fashioned oats",
    "0.5 cup mashed sweet potatoes",
    "2 tablespoons ground flax seed",
    "0.5 teaspoon ground cinnamon, or to taste",
    "0.25 teaspoon ground ginger, or to taste",
    "0.125 teaspoon ground cloves, or to taste",
    "1 tablespoon honey",
    "0.5 tablespoon salted butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine almond milk and salt in a saucepan; bring to a boil over medium-high heat. Stir in oats, sweet potatoes, flax seeds, cinnamon, ginger, and cloves. Reduce heat to medium; cook, stirring often, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, stir in honey, butter, and vanilla extract.",
