  "ingredients": [
    "1 quart canola oil for frying",
    "1 (20 ounce) package chocolate sandwich cookies with creme filling",
    "2 cups dry pancake mix",
    "1 cup water",
    "0.5 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer to 375 degrees F (190 degrees C).",
