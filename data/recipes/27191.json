  "ingredients": [
    "12 eggs",
    "0.33333298563957 cup Ranch-style salad dressing",
    "0.5 (8 ounce) package cream cheese, softened",
    "0.5 cup chopped onion",
    "1 dill pickle, finely chopped"
  ],
  "steps": [
    {
      "text": "Place eggs in a large saucepan and cover with cold water. Bring to a boil; immediately remove from heat. Cover and let eggs stand in hot water, 10 to 12 minutes. Remove eggs from hot water, cool under cold running water, and peel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice eggs in half lengthwise; transfer yolks to a medium bowl. Mash yolks with dressing; fold in cream cheese. Stir in onion and pickle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Generously fill hollowed egg whites with egg yolk mixture. Chill until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
