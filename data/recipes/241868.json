  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons ground cardamom",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup white sugar",
    "0.66666668653488 cup butter, softened",
    "0.5 cup brown sugar",
    "2 eggs",
    "1 cup buttermilk",
    "1 cup peeled and chopped apples",
    "0.5 cup brown sugar",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cardamom, baking powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, butter, and 1/2 cup brown sugar together in a bowl until creamy. Add buttermilk and eggs; beat until smooth. Gradually add flour mixture, mixing until just-combined. Fold in apples and pour batter into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir 1/2 cup brown sugar and pecans together in a bowl; sprinkle over batter. Cover the baking dish with plastic wrap and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Uncover the baking dish and let stand at room temperature until slightly warmer, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cake in the preheated oven until topping is browned, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
