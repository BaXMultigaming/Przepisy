  "title": "Apple Cardamom Overnight Cake",
  "description": "This delicious overnight cake combines apples, brown sugar, and cardamom to create a moist, flavorful and fragrant breakfast or anytime cake.",
  "authors": [
    "Debbie22"
  ],
  "date_published": "2020-06-19T00:02:38-04:00",
