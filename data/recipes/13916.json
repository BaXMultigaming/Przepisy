  "ingredients": [
    "1.25 pounds spinach",
    "0.25 cup all-purpose flour",
    "3 eggs, beaten",
    "0.75 cup shredded Cheddar cheese",
    "0.5 cup dried bread crumbs",
    "2 tablespoons chopped fresh parsley",
    "0.25 cup butter, melted",
    "1 cup milk",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 2 quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Clean spinach thoroughly. Remove all excess water. Chop spinach. Arrange spinach and flour in layers, nestle beaten eggs about midway between the layers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cheese and bread crumbs. Mix in optional parsley, if desired. Sprinkle over top of spinach. Mix butter or margarine, milk, salt and pepper. Pour over all ingredients. Bake at 350 degrees F (175 degrees C) oven for 50 minutes to one hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
