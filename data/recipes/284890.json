  "ingredients": [
    "2 tablespoons freshly squeezed lemon juice",
    "1.5 teaspoons Dijon mustard",
    "0.5 teaspoon salt, or to taste",
    "0.5 teaspoon freshly ground black pepper",
    "0.25 cup olive oil",
    "2 medium ripe avocados",
    "1 medium red grapefruit"
  ],
  "steps": [
    {
      "text": "Combine lemon juice, Dijon, 1/2 teaspoon salt, and 1/2 teaspoon pepper in a small bowl. Slowly whisk in olive oil until vinaigrette is emulsified.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut avocados in half, remove pits, and carefully peel off skin. Cut each half into 4 thick slices. Toss in vinaigrette to prevent them from turning brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel grapefruit skin and all the white pith with a large, sharp knife. Cut between membranes to release the grapefruit segments.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange avocado slices evenly around the edge of a large platter, then arrange grapefruit segments in the center. Spoon vinaigrette over top, then sprinkle with more salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
