  "ingredients": [
    "1 large turnip, peeled and cubed",
    "3 white potatoes, peeled and cubed",
    "0.25 cup milk",
    "3 tablespoons unsalted butter",
    "1 teaspoon white sugar",
    "0.75 teaspoon salt",
    "0.25 teaspoon pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place turnip and potatoes in a large pot with enough water to cover, and bring to a boil. Cook 25 to 30 minutes, until tender. Remove from heat, and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix milk, 2 tablespoons butter, and sugar with the turnip and potatoes. Season with salt and pepper. Mash until slightly lumpy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer turnip mixture to a small baking dish. Dot with remaining butter. Cover loosely, and bake 15 minutes in the preheated oven. Remove cover, and continue baking about 8 minutes, until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
