  "ingredients": [
    "2.5 cups mochiko (glutinous rice flour)",
    "2 teaspoons baking powder",
    "2 cups white sugar",
    "4 eggs",
    "1 (29 ounce) can pumpkin puree",
    "1 (14 ounce) can sweetened condensed milk",
    "1 cup butter, melted",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together mochiko, baking powder, and sugar in a large bowl. Combine eggs, pumpkin puree, condensed milk, butter, and vanilla extract in a separate bowl. Stir egg mixture into mochiko mixture. Pour into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 1 hour. Allow to cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
