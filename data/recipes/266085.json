  "ingredients": [
    "1 pound frozen large shrimp (21-25 count) - thawed, peeled, and deveined",
    "1 teaspoon hot smoked paprika",
    "kosher salt to taste",
    "4 cloves garlic",
    "0.25 cup extra-virgin olive oil",
    "2 tablespoons dry sherry",
    "1 tablespoon chopped Italian flat-leaf parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F1ibuQmlYUAUsJz_NfKfhJyrbwg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/266085-spanish-garlic-shrimp-DDMFS-step-01-4650b87a5ecd4db9bed0a09dde7996ad.jpg"
      ],
      "image": "assets/images/266085/step_01.webp"
    },
    {
      "text": "Place shrimp in a large bowl and season with paprika and kosher salt; mix well to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SwCVWybnN6_mbw3G0o9ulgh4tTA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/266085-spanish-garlic-shrimp-DDMFS-step-02-41af73e899d84470b0d675828efdb85d.jpg"
      ],
      "image": "assets/images/266085/step_02.webp"
    },
    {
      "text": "Slice garlic into thin slices. Heat oil in a skillet over medium heat; add garlic and cook until golden, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JQnrSh6xppfocEr4xHN_DwG_AZw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/266085-spanish-garlic-shrimp-DDMFS-step-03-d92bd67864b048bdb539b1852fbf571b.jpg"
      ],
      "image": "assets/images/266085/step_03.webp"
    },
    {
      "text": "Add shrimp and increase heat to high. Toss and turn shrimp with tongs until starting to curl but still undercooked, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jOy2VYo3CSnLBhbZQpgtFd-YcpY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/266085-spanish-garlic-shrimp-DDMFS-step-04-4c9fce372a5e42f3845028228380d26e.jpg"
      ],
      "image": "assets/images/266085/step_04.webp"
    },
    {
      "text": "Pour in sherry. Cook, stirring continuously, until sauce comes up to a boil and shrimp is cooked through, about 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EcqkmsKq8hs_2DbQD4M7EP9zqz0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/266085-spanish-garlic-shrimp-DDMFS-step-05-67ae9e66ee0a4d07a552bba6ff8fd4e6.jpg"
      ],
      "image": "assets/images/266085/step_05.webp"
    },
    {
      "text": "Remove from heat. Stir in parsley.",
