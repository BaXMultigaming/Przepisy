  "ingredients": [
    "0.33333334326744 cup soy sauce",
    "0.25 cup olive oil",
    "0.25 cup brown sugar",
    "2 teaspoons lemon pepper",
    "2 cloves garlic, minced",
    "1 pound skin-on salmon fillet"
