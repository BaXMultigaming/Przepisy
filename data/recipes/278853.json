  "ingredients": [
    "1.75 pounds small red potatoes, halved",
    "1.5 pounds carrots, cut into 3-inch pieces",
    "3 tablespoons olive oil",
    "1 tablespoon honey",
    "1 teaspoon lemon zest",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "0.25 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss potatoes and carrots in a large bowl with olive oil. Add honey, lemon zest, oregano, salt, and pepper; toss to coat. Spread onto a large rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven, stirring occasionally, until tender, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
