  "ingredients": [
    "1 cup yellow cornmeal",
    "0.5 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground paprika",
    "1.5 cups buttermilk",
    "3 tablespoons melted butter",
    "1 egg, slightly beaten"
  ],
  "steps": [
    {
      "text": "Preheat and lightly grease a waffle iron according to the manufacturer’s instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cornmeal, flour, baking powder, baking soda, salt, and paprika together in a bowl. Stir buttermilk, butter, and egg together in a separate bowl; stir into flour mixture until batter is just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle 1/2 to 3/4 cup batter into the preheated waffle iron; cook waffle according to manufacturer’s instructions until golden brown, about 5 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
