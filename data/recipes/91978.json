  "ingredients": [
    "1 onion, finely chopped",
    "0.25 cup honey Dijon mustard",
    "4 (6 ounce) fillets catfish fillets",
    "garlic salt and pepper to taste",
    "dried parsley flakes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix together the onion and mustard. Season the catfish fillets with garlic salt and pepper. Place on a baking tray and coat with the onion and honey. Sprinkle parsley flakes over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 minutes in the preheated oven, then turn the oven to broil. Broil until golden, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
