  "title": "Cast Iron Skillet Buttermilk Cornbread",
  "description": "White and yellow cornmeal are combined with lard and buttermilk and baked in a cast iron skillet in this traditional Southern cornbread.",
  "authors": [
    "Dannielle Randall"
  ],
  "date_published": "2019-04-02T03:06:30-04:00",
