  "ingredients": [
    "2 large eggplant",
    "3 tablespoons tahini",
    "3 tablespoons lemon juice",
    "3 cloves garlic, minced",
    "2 teaspoons salt",
    "0.75 teaspoon smoked paprika",
    "0.5 teaspoon cumin",
    "0.25 cup extra virgin olive oil",
    "3 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Poke holes into eggplant with a fork for steam to escape while grilling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook eggplant on the preheated grill until skins are charred, flipping occasionally, about 30 minutes. Transfer to a baking pan, cover, and steam for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully remove and discard stems and skin. Transfer flesh to a colander; drain for 20 minutes. Press out any remaining moisture with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggplant in the bowl of a food processor. Add tahini, lemon juice, garlic, salt, smoked paprika, and cumin; pulse until smooth. Add oil and parsley; pulse until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
