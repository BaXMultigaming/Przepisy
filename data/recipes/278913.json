  "ingredients": [
    "cooking spray",
    "1 cup mango chunks",
    "2 pounds ground beef",
    "0.5 cup bread crumbs",
    "3 cloves garlic, minced",
    "1 (1 ounce) package dry golden onion soup mix (such as Lipton®)",
    "1 tablespoon adobo seasoning",
    "1 teaspoon ground thyme",
    "1 teaspoon ground ginger",
    "1 teaspoon sea salt",
    "0.5 teaspoon ground black pepper",
    "2 eggs",
    "1 (18 ounce) bottle barbeque sauce",
    "1 cup mango chunks",
    "1 cup canned pineapple chunks",
    "0.5 cup white sugar",
    "1 tablespoon soy sauce",
    "1 tablespoon yellow mustard",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly spray a rimmed baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree mango chunks using an electric blender or food processor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ground beef in a large mixing bowl; add bread crumbs, garlic, soup mix, adobo, thyme, ginger, salt, and pepper. Mix thoroughly. Add eggs, followed by pureed mango; mix again. Shape into 1 1/2-inch meatballs and place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and no longer pink in the centers, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix barbeque sauce, mango, pineapple, sugar, soy sauce, mustard, and cinnamon for sauce together in a medium mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove meatballs from the oven and drain excess oil/grease. Increase oven temperature to 400 degrees F (200 degrees C). Pour sauce over meatballs and return to the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
