  "ingredients": [
    "1 cup semisweet chocolate chips",
    "4 tablespoons butter",
    "0.5 cup sour cream",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "2.75 cups confectioners' sugar"
  ],
  "steps": [
