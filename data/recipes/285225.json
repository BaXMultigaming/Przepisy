  "title": "Spicy Salmon Marinade",
  "description": "This white wine, rosemary, and garlic marinade is given a kick with crushed red pepper and hot sauce. Feel free to increase the spiciness by adding more hot sauce.",
  "authors": [
    "France Cevallos"
  ],
  "date_published": "2003-09-24T16:44:02-04:00",
