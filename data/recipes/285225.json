  "ingredients": [
    "1 (1 1/2-pound) skin-on center-cut salmon fillet",
    "6 fluid ounces dry white wine",
    "1 tablespoon olive oil",
    "1 clove garlic, minced",
    "1 teaspoon crushed red pepper flakes",
    "1 teaspoon hot sauce",
    "0.5 teaspoon dried rosemary",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Cut fish into 4 portions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together wine, olive oil, garlic, pepper flakes, and hot sauce in a small bowl. Pour over salmon and seal bag closed, letting out excess air. Place in refrigerator for 1 hour, turning after 30 minutes. Remove salmon from the marinade, letting excess drip off, and place on a plate to stand at room temperature for 15 minutes. Discard any remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon flesh-side down on the hot grill. Close the lid and grill for 3 minutes. Flip and grill an additional 3 to 4 more minutes. Sprinkle with salt before serving, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
