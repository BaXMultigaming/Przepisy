  "ingredients": [
    "0.5 cup chopped walnuts, or to taste",
    "0.5 (12 ounce) bag semisweet chocolate chips",
    "1 teaspoon unsweetened cocoa powder",
    "0.25 cup tapioca flour",
    "0.25 cup sorghum flour",
    "0.25 cup teff flour",
    "0.33333334326744 cup unsweetened cocoa powder",
    "1 teaspoon xanthan gum",
    "1 pinch salt",
    "0.5 cup butter, room temperature",
    "1 cup white sugar",
    "2 eggs, beaten",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E-l9yqt471KVUAE_gP_r6P1FgQs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-228330-the-best-gluten-free-brownies-everseriously-VAT-step-01-40d477f8420c49c3a3c233f332eba088.jpg"
      ],
      "image": "assets/images/228330/step_01.webp"
    },
    {
      "text": "Toss walnuts and chocolate chips with 1 teaspoon cocoa powder in a bowl until well coated; set aside. Mix tapioca flour, sorghum flour, teff flour, 1/3 cup cocoa powder, xanthan gum, and salt together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6Wxg5QWQgaZKDfaYte-Q-fK5E3A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-228330-the-best-gluten-free-brownies-everseriously-VAT-step-02-4997f5a364284b0ea99e3873a06e5f57.jpg"
      ],
      "image": "assets/images/228330/step_02.webp"
    },
    {
      "text": "Beat butter and sugar together in a separate large bowl until creamy and lighter in color. Stir in eggs and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mWuhqRIHJszv11RzrHXgtNv-PeU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-228330-the-best-gluten-free-brownies-everseriously-VAT-step-03-e3c51aaf94ac47bb9bef28241ee400b5.jpg"
      ],
      "image": "assets/images/228330/step_03.webp"
    },
    {
      "text": "Gradually add flour mixture to butter mixture until fully incorporated. Fold in nuts and chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q4Dg23VOHOLNu8gqOrFS2bKrQUo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-228330-the-best-gluten-free-brownies-everseriously-VAT-step-04-e1ba41831f144edaac69d7ed07102b1c.jpg"
      ],
      "image": "assets/images/228330/step_04.webp"
    },
    {
      "text": "Spread batter into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K7vqRFz_ByParPGM7vZcG3SGEeI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-228330-the-best-gluten-free-brownies-everseriously-VAT-step-05-44f113c953424a29a25018c7bb700a91.jpg"
      ],
      "image": "assets/images/228330/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until the top is dry and the edges have started to pull away from the sides of the pan, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bjf4qUZbnn4trRoPA27ItOPirBo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-228330-the-best-gluten-free-brownies-everseriously-VAT-step-06-ff71555412704383b7769aa8267ae39f.jpg"
      ],
      "image": "assets/images/228330/step_06.webp"
    }
