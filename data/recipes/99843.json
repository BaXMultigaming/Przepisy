  "ingredients": [
    "nonstick cooking spray",
    "1 pound ground turkey",
    "1 egg",
    "0.25 cup chopped fresh parsley",
    "0.75 cup dry bread crumbs",
    "0.5 teaspoon adobo seasoning",
    "1 pinch salt",
    "1 pinch pepper",
    "0.75 cup shredded Cheddar cheese, divided"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a loaf pan with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground turkey, egg, parsley, bread crumbs, adobo, and salt and pepper in a large bowl. Mix well. Press half of the turkey mixture into the bottom of the prepared loaf pan. Sprinkle 1/2 cup cheese in a mound down the center of the pan; top with the remaining meat to form a loaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and cooked through, about 1 hour. Sprinkle the remaining 1/4 cup cheese on top during the last 5 minutes of baking. Allow cooked meatloaf to rest for at least 5 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
