  "ingredients": [
    "1 cup butter",
    "0.5 cup shortening",
    "3 cups white sugar",
    "5 egg whites",
    "5 egg yolks",
    "4 tablespoons unsweetened cocoa powder",
    "3 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup milk",
    "2 teaspoons vanilla extract",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 10 inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, cocoa and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream margarine and shortening. Gradually add sugar while beating. Add egg yolks one at a time and beat well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour mixture alternately with milk. Add vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, beat egg whites until stiff. Fold into cake batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into a greased and floured tube pan. Sprinkle nuts on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour and 15 minutes. Do not over bake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
