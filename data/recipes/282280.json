  "ingredients": [
    "5 medium zucchini",
    "1 (12 ounce) package Impossible Burger",
    "0.66666668653488 cup Italian-seasoned bread crumbs",
    "0.33333334326744 cup diced fresh tomato",
    "0.33333334326744 cup minced Pecorino-Romano cheese",
    "1 large egg",
    "2 tablespoons chopped flat-leaf (Italian) parsley",
    "1 tablespoon minced onion",
    "2 large cloves garlic, crushed",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut ends from zucchini; halve zucchini lengthwise. Scrape and hollow out seedy flesh, leaving about ½ inch flesh on bottom and sides of zucchini. Discard scraped-out flesh. Place zucchini into a 10x15-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine meatless ground beef, tomato, bread crumbs, Pecorino-Romano, egg, parsley, onion, garlic, salt, and black pepper in a bowl using clean or gloved hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stuff hollowed-out zucchini with meatless ground beef mixture; sprinkle with mozzarella.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and zucchini are tender, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
