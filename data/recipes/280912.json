  "ingredients": [
    "3 tablespoons olive oil",
    "1.5 pounds salmon fillets, cut into 4-ounce portions",
    "1 cup chopped packed fresh flat-leaf parsley",
    "2 tablespoons lemon juice",
    "2 cloves garlic",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.33333334326744 cup walnut pieces",
    "3 tablespoons chopped toasted walnuts",
    "1 lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Drizzle 1 tablespoon oil in a 9x13-inch baking dish. Arrange salmon in the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Process parsley, lemon juice, garlic, salt, pepper, and remaining 2 tablespoons oil in a food processor until evenly chopped. Add 1/3 cup walnut pieces; process until combined and walnuts are still a bit chunky. Spread onto salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until salmon flakes easily with a fork, 20 to 25 minutes. Garnish with chopped walnuts and serve with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
