  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a round baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chicken, cream of chicken soup, cream of mushroom soup, chile peppers, onion, and taco seasoning in a large bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay 1 tortilla in the prepared baking dish. Top with 1/3 cup of the chicken mixture; cover with some Cheddar cheese. Repeat layers with remaining tortillas, chicken mixture, and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, uncovered, until heated through, about 30 minutes.",
      "section": null,
