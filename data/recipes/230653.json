  "ingredients": [
    "4 cups whole wheat flour",
    "2 tablespoons baking powder",
    "0.25 cup white sugar",
    "2 teaspoons salt",
    "1.5 cups applesauce",
    "0.75 cup peanut oil",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, sugar, and salt together in a large bowl. Stir applesauce, peanut oil, and water into flour mixture until dough pulls away from the sides of the bowl. Drop golf ball-sized spoonfuls of dough onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until biscuits are browned, 10 to 12 minutes.",
