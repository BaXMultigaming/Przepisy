  "ingredients": [
    "0.5 cup red wine vinegar",
    "2 teaspoons white sugar",
    "0.5 teaspoon black pepper",
    "1 teaspoon dried dill weed",
    "0.25 cup mayonnaise",
    "5 cucumbers, scored and thinly sliced",
    "1 stalk celery, thinly sliced",
    "0.5 red onion, chopped",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Stir together vinegar, sugar, pepper, and dill in a large bowl until the sugar has dissolved. Stir in the mayonnaise until smooth, then add cucumbers, celery, and red onion until evenly coated with the dressing. Cover and refrigerate at least 1 hour. Season to taste with salt and stir once again before serving.",
