  "ingredients": [
    "1 (12 ounce) jar apricot preserves",
    "1 (12 ounce) bottle hickory-flavored barbecue sauce",
    "0.25 cup water",
    "0.5 teaspoon crushed red pepper",
    "24 ounces frozen cocktail-size meatballs"
  ],
  "steps": [
    {
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot®) and select Saute function. Add apricot preserves, barbecue sauce, water, and crushed red pepper and whisk together. Add meatballs and stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Close and lock the lid; turn venting knob to sealing. Select high pressure according to manufacturer's instructions; set timer for 5 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange meatballs on a platter with toothpicks and additional crushed red pepper, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
