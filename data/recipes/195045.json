  "title": "The Best Spaghetti Casserole",
  "description": "An easy spaghetti casserole to make for a fun twist on pasta night. Sour cream adds richness to noodles with beef and tomato sauce, baked with cheese.",
  "authors": [
    "Noonie Finch Hodges"
  ],
  "date_published": "2019-04-02T02:51:52-04:00",
  "date_modified": "2026-03-23T11:59:13-04:00",
  "prep_time": "PT20M",
