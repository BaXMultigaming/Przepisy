    "Italian"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "cooking spray",
    "1 (16 ounce) package spaghetti",
    "1 (8 ounce) package cream cheese, at room temperature",
    "1 (16 ounce) container fat-free sour cream",
    "2 cups shredded mozzarella cheese, divided",
    "2 tablespoons olive oil",
    "2 pounds ground beef",
    "0.25 cup chopped onion",
    "2 teaspoons finely chopped garlic",
    "2 teaspoons Italian seasoning",
    "salt and black pepper to taste",
    "½ teaspoon ground black pepper",
    "2 (26.5 ounce) cans meatless spaghetti sauce",
    "0.5 cup Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MAIbx3j0rhj8dqJaDlhcDqHqf_A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/195045-the-best-spaghetti-casserole-DDMFS-001-36ec519924604340a6ca8138a303ab07.jpg"
      ],
      "image": "assets/images/195045/step_01.webp"
    },
    {
      "text": "Boil spaghetti in generously salted water until cooked through but still firm to the bite, 8 to 10 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/icf04uubM-hQSMZpd71K8F7Zaik=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/195045-the-best-spaghetti-casserole-DDMFS-003-f8b87a5f9841473da9c1495749b2ec02.jpg"
      ],
      "image": "assets/images/195045/step_02.webp"
    },
    {
      "text": "While pasta cooks, stir cream cheese, sour cream, and 1 cup of mozzarella cheese together until combined; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mCQtRetouIGaIf_BwkXS7aO4Gy0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/195045-the-best-spaghetti-casserole-DDMFS-002-eba52aae004e4f9eb1d6df0dccb36c95.jpg"
      ],
      "image": "assets/images/195045/step_03.webp"
    },
    {
      "text": "Heat olive oil in a large high-sided skillet over medium-high heat. Add beef in large chunks and cook, undisturbed, until lightly browned, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k_hT3BdYYpEe_y4Yh4v5LdhnOCE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/195045-the-best-spaghetti-casserole-DDMFS-004-de1a51632b254e8db6ce78fe9966c79a.jpg"
      ],
      "image": "assets/images/195045/step_04.webp"
    },
    {
      "text": "Add onion, garlic, Italian seasoning, salt, and pepper. Continue to cook, breaking up meat into smaller pieces with a wooden spoon and stirring occasionally, until almost cooked through, about 3 minutes. Remove from heat and tilt the pan to pool grease onto one side, trying to keep the beef mixture on the other. Use a large spoon to remove grease; discard grease once cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cFT2VaJ3MCakzsw_ac4pebltDCk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/195045-the-best-spaghetti-casserole-DDMFS-005-20595b5ca0234fd0a62a99e6f18ba07d.jpg"
      ],
      "image": "assets/images/195045/step_05.webp"
    },
    {
      "text": "Add marinara to beef mixture in skillet; stir until combined. Add reserved spaghetti. Fold and stir until well coated in sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RsscjFYSQsvxPMjz0kFQ6sbLjFw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/195045-the-best-spaghetti-casserole-DDMFS-006-fe50c7f1ec884347ab70a199599aa6bc.jpg"
      ],
      "image": "assets/images/195045/step_06.webp"
    },
    {
      "text": "Transfer ½ of the pasta mixture to prepared baking dish. Spread sour cream mixture evenly over pasta mixture in baking dish, then top with remaining pasta mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H_V6IgVluNKuFXX94uXFYzlNxMc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/195045-the-best-spaghetti-casserole-DDMFS-008-cb39265da79547ce8885e699fdfc8782.jpg"
      ],
      "image": "assets/images/195045/step_07.webp"
    },
    {
      "text": "Sprinkle remaining 1 cup mozzarella evenly over spaghetti mixture. Cover loosely with aluminum foil and place baking dish on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hYqFqpdz_5WKrMdAePskeNZHz3o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/195045-the-best-spaghetti-casserole-DDMFS-011-f51199a48fc543abb66921e6c993849f.jpg"
      ],
      "image": "assets/images/195045/step_08.webp"
    },
    {
      "text": "Bake in preheated oven until cheese has melted, about 30 minutes. Remove aluminum foil and sprinkle top with Parmesan cheese. Increase oven temperature to broil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UtQP2bjA-BDwU1fngfAcBMotBE8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/195045-the-best-spaghetti-casserole-DDMFS-012-3b11b5cc39154da2bac2abbd00bf86e9.jpg"
      ],
      "image": "assets/images/195045/step_09.webp"
    },
    {
      "text": "Broil until cheese has started to turn golden brown, 3 to 4 minutes. Sprinkle with parsley and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y3PaJQJ0Ggmo-Wo2pPCzhPL5EjE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/195045-the-best-spaghetti-casserole-DDMFS-014-560e5d7e0f3a4ee88cc9687d805e94b0.jpg"
      ],
      "image": "assets/images/195045/step_10.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JM099y6qK3gfTMLCfOVzsjFLVwQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/195045-the-best-spaghetti-casserole-DDMFS-018-4x3-e25a497a78c445c2bde0433d7e3931ea.jpg"
      ],
      "image": "assets/images/195045/step_11.webp"
    }
  ],
