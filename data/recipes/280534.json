  "ingredients": [
    "1 ripe plantain",
    "4.5 tablespoons shredded mild Cheddar cheese",
    "2 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Cut plantain into 3 pieces, keeping the peel on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a pot of water to a boil and boil plantain until peel starts to bubble, 3 to 5 minutes. Remove from heat and cool until easily handled. Peel and mash plantain. Separate into 3 equal-sized golf balls. Place each ball into a piece of plastic wrap and form into a 6-inch round. Place 1 1/2 tablespoon Cheddar cheese into each round, fold over, and pinch edges together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a medium size skillet on medium-high heat. Pan-fry stuffed plantains until lightly browned, 2 to 3 minutes. Flip plantains and fry for an additional 2 to 3 minutes. Drain on paper towels to absorb excess oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
