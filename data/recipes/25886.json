  "ingredients": [
    "4 (1/2 pound) strip steaks, cut 1/2 inch thick",
    "salt to taste",
    "freshly ground black pepper to taste",
    "1 teaspoon dry mustard, divided",
    "0.25 cup margarine",
    "3 tablespoons lemon juice",
    "2 teaspoons minced fresh chives",
    "1 teaspoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Pound steaks to be 1/4 inch thick, and sprinkle each side with salt, black pepper, and 1/8 teaspoon mustard; rub into the meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt margarine in a large skillet over medium-high heat. Fry 2 of the steaks for 2 minutes on each side, and transfer to a hot serving plate. Repeat with remaining 2 steaks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add lemon juice, chives, Worcestershire sauce, and remaining mustard to the pan, and bring to a boil. Return the steaks to the pan to heat through, and coat with sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
