  "ingredients": [
    "1 head cauliflower, cut into florets",
    "1 onion, cut into chunks",
    "3 cloves garlic, halved",
    "5 cups vegetable stock",
    "1 (14 ounce) can coconut milk",
    "1 tablespoon curry paste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cauliflower, onion, and garlic on a baking sheet; bake in the preheated oven until golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring vegetable stock, coconut milk, and curry paste to a boil in a large saucepan over high heat. Add the roasted vegetables; reduce heat to medium-low, cover, and simmer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a blender halfway with cauliflower soup mixture. Cover and hold the lid down with a potholder; pulse a few times before leaving on to blend. Pour into a pot. Repeat with remaining soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
