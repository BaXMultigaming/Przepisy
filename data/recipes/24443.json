        "https://www.allrecipes.com/thmb/-D6eoQDJRAp9XT81prHSxgQkDqg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-24443-candy-cane-cookies-iii-VAT-step-10-a76a387a6d594f4eaa4ab703757b27ae.jpg"
