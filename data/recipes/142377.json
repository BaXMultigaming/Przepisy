  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil. Spray foil with a light coating of cooking spray, and place salmon on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix feta, mayonnaise, cream cheese, Dijon, onion powder, vinegar, garlic powder, salt, pepper, and paprika together in a bowl until smooth. Spread mixture over salmon, then sprinkle bread crumbs over top, covering completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
