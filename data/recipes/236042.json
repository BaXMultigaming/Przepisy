  "ingredients": [
    "1 pound bacon, cut into 1-inch pieces",
    "1 pound cubed fully cooked ham",
    "1 small white onion, diced",
    "6 cups fat-free milk",
    "2 (10.75 ounce) cans condensed cream of potato soup",
    "4 cups frozen Southern-style hash brown potatoes",
    "1.5 teaspoons garlic salt",
    "1 teaspoon ground black pepper",
    "2 cups shredded sharp Cheddar cheese",
    "4 green onions, thinly sliced"
  ],
  "steps": [
    {
      "text": "Cook and stir bacon and ham together in a large pot over medium-high heat until some of the bacon fat renders, 7 to 10 minutes. Add the onion and continue cooking until the bacon and ham are browned and the onion translucent, 5 to 7 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk and potato soup into the pot; add potatoes, garlic salt, and pepper. Reduce heat to medium-low and cook mixture at a simmer, stirring frequently, until heated through and slightly thickened, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle soup into bowls and top with Cheddar cheese and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
