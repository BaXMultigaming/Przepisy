  "ingredients": [
    "1.5 cups cider vinegar",
    "1 cup chopped onion",
    "1 large Granny Smith apple - peeled, cored and chopped",
    "1 cup golden raisins",
    "0.75 cup white sugar",
    "0.25 cup lemon juice",
    "1 green chile pepper, seeded and minced",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon lemon zest",
    "1 teaspoon ground coriander seed",
    "0.125 teaspoon ground cloves",
    "4 Fuyu persimmons, peeled and chopped"
  ],
  "steps": [
    {
      "text": "Combine cider vinegar, onion, apple, raisins, sugar, lemon juice, green chile, ginger, lemon zest, coriander, and cloves in a large saucepan. Bring to a boil over medium heat, stirring occasionally. Reduce heat to medium-low and simmer until mixture thickens, stirring frequently, about 25 minutes. Add persimmons and simmer until the persimmons are tender, about 5 to 10 minutes.",
      "section": null,
      "name": null,
