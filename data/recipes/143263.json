  "ingredients": [
    "0.5 cup dry lentils",
    "1 cup water",
    "0.5 pound ground turkey",
    "1 cup water",
    "1 (1.25 ounce) package taco seasoning mix",
    "1 head iceberg lettuce, chopped",
    "1 avocado - peeled, pitted and diced",
    "1 tomato, diced",
    "1 (15 ounce) can pitted black olives, chopped",
