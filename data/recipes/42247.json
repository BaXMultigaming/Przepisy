  "ingredients": [
    "3 tablespoons crushed black peppercorns",
    "2 (8 ounce) beef top sirloin steaks",
    "1 tablespoon lemon pepper",
    "1 teaspoon salt",
    "5 tablespoons butter",
    "0.5 cup red wine",
    "2 cloves garlic, minced",
    "3 tablespoons brandy",
    "1 shallot, chopped",
    "0.25 cup chopped green onions",
    "0.5 cup heavy cream",
    "1 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Press crushed peppercorns into both sides of each steak; season with lemon pepper and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium-high heat. Add wine and garlic; cook 1 minute. Add steaks; cook until desired doneness, about 5 minutes per side. Reduce heat to low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour brandy on steaks. Carefully light with a match; let flames burn off. Sprinkle shallot and green onions around steaks, followed by cream. Cook, stirring sauce, until hot. Transfer steaks to plates. Season sauce with sugar; spoon over steaks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
