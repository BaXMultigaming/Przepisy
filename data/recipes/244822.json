  "ingredients": [
    "1 eggplant, peeled and sliced",
    "1 small head cauliflower, chopped",
    "0.25 cup olive oil",
    "1 teaspoon curry powder",
    "1 teaspoon ground cumin",
    "0.5 teaspoon garlic salt",
    "6 fresh basil leaves, sliced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Prepare a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggplant and cauliflower in a large bowl with a lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, curry powder, ground cumin, garlic salt, and basil together in a bowl; pour over eggplant and cauliflower. Place lid on bowl with eggplant mixture and shake until well coated. Arrange eggplant and cauliflower on prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
