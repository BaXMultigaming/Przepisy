  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt",
    "2 teaspoons ground cinnamon",
    "2 cups white sugar",
    "4 eggs",
    "1.3329999446869 cups vegetable oil",
    "4 cups grated carrots",
    "0.75 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan. Sift flour, baking powder, baking soda, salt, and cinnamon together in a large bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and eggs together in a large bowl until thick and pale. Stir in oil. Gradually mix in the flour mixture until combined. Fold in carrots and walnuts. Spread batter evenly in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the cake comes out clean, about 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
