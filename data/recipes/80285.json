  "steps": [
    {
      "text": "Place water, ham hock, linguiça, and onion in a Dutch oven over high heat; bring to a boil. Reduce heat to medium-low, cover, and simmer for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove meat from ham hock, chop, and return to soup. Stir in potatoes, celery, carrots, stewed tomatoes, tomato sauce, and garlic. Cover; simmer for 1 ½ hours, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in kidney beans and cabbage; cook until cabbage has softened, about 10 minutes.",
