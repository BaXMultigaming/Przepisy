  "ingredients": [
    "2 pounds Roma tomatoes, halved lengthwise",
    "0.5 cup olive oil",
    "1 clove garlic, crushed",
    "1 tablespoon dried oregano",
    "1 teaspoon white sugar",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange tomatoes, cut-side up, in a shallow baking dish; drizzle with olive oil and sprinkle garlic, oregano, sugar, and salt evenly on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn tomatoes over and continue baking until caramelized and very soft, 1 to 1 1/2 hours. Remove from the oven and set aside to cool to room temperature, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer tomato mixture to a blender or food processor; purée until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
