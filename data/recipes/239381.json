  "title": "Shannon's Oven Pancake",
  "description": "Oven-baked pancakes are perfect for a lazy weekend breakfast. This recipe uses pumpkin pie spice in a tribute to autumn flavors.",
  "authors": [
    "Shannon"
  ],
  "date_published": "2020-06-19T00:00:47-04:00",
