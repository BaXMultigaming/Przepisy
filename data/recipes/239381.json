  "ingredients": [
    "2 tablespoons white sugar",
    "2 tablespoons brown sugar, divided",
    "1 cup all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon pumpkin pie spice",
    "1 pinch salt",
    "1 tablespoon butter, cut into large chunks",
    "4 eggs",
    "1 cup milk",
    "1 teaspoon vanilla extract",
    "0.125 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir white sugar and 1 tablespoon brown sugar together in a small bowl. Stir flour, cinnamon, pumpkin pie spice, and salt together in a separate bowl with a whisk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put butter in an 8-inch cake pan and melt in preheated oven, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle remaining brown sugar over the melted butter in the cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, milk, vanilla extract, and almond extract together in a larger bowl with an electric mixer; stir into the flour mixture until you have a smooth batter. Pour the batter over the butter and brown sugar in the cake pan. Sprinkle white and brown sugar mixture over the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
