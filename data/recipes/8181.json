  "ingredients": [
    "14 graham crackers, crushed",
    "0.5 cup white sugar",
    "0.5 cup melted butter",
    "1 (3 ounce) package lemon flavored Jell-O®",
    "water",
    "1 (12 fluid ounce) can evaporated milk, chilled",
    "1 cup white sugar",
    "2 lemons, juiced",
    "1 cup crushed pineapple, drained",
    "0.5 cup graham cracker crumbs",
    "0.25 cup maraschino cherries, drained and chopped"
  ],
  "steps": [
    {
      "text": "Combine 14 crushed graham crackers, ½ cup sugar, and melted butter in a bowl. Mix until evenly moistened; press into the bottom of a 9 x 13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix lemon gelatin with 1 cup boiling water together in a separate bowl. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whip evaporated milk, 1 cup sugar, and lemon juice in another bowl until sugar dissolves. Whip in cooled gelatin into milk mixture: stir in pineapple.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour lemon mixture over crust in pan. Sprinkle with ½ cup crushed graham crackers and chopped maraschino cherries. Chill in the refrigerator for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
