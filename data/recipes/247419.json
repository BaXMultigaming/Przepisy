  "ingredients": [
    "6 Original Snack Factory® Pretzel Crisps®",
    "3 large marshmallows, halved",
    "0.25 cup semisweet chocolate chips",
    "2.25 teaspoons butter"
  ],
  "steps": [
    {
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a small pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange Snack Factory® Pretzel Crisps® on prepared pan. Top each with a marshmallow half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil until the marshmallows are golden brown, 30 seconds to 1 minute. Remove and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chocolate chips and butter in the top of a double boiler over hot water on medium heat. Stir until chips are melted and mixture is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle chocolate over the marshmallows.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
