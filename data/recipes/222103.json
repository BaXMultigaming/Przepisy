  "ingredients": [
    "6 slices day-old whole wheat bread",
    "0.5 cup raisins",
    "1 large apple, peeled and chopped",
    "2 tablespoons butter, melted",
    "4 eggs, beaten",
    "2 cups low-fat milk",
    "0.5 cup white sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break bread into small pieces into an 8-inch square baking dish. Mix in raisins and apple. Drizzle with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, milk, sugar, cinnamon, and vanilla extract in a mixing bowl. Beat until well mixed. Pour over bread and lightly push down with a fork until bread is covered and soaking up egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a kettle of water to a boil. Place bread pudding baking dish into a large roasting pan. Carefully pour boiling water around pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a knife inserted into the middle of pudding comes out mostly clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
