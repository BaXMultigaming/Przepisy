  "ingredients": [
    "12 fresh chicken wing drumettes",
    "0.5 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "1 tablespoon butter",
    "0.25 cup honey",
    "2 teaspoons rice vinegar",
    "1 tablespoon sriracha sauce"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 360 degrees F (182 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken wings in a bowl and sprinkle with salt and garlic powder, tossing to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place wings in the air fryer basket. Set timer for 25 minutes and cook wings, shaking basket every 7 to 8 minutes. When timer ends, turn air fryer off and let wings stand in the basket for 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a small saucepan over medium heat. Whisk honey, rice vinegar, and sriracha sauce into butter and bring to a boil. Reduce heat and simmer sauce over medium-low heat for 8 to 10 minutes, whisking occasionally. Turn off heat and set aside; sauce will thicken as it cools.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss cooked wings and sauce together in a bowl. Reserve extra sauce to serve alongside wings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
