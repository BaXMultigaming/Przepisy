  "ingredients": [
    "3 cups apple juice",
    "2.5 cups unsweetened pineapple juice",
    "2 cups cranberry juice",
    "0.25 cup brown sugar",
    "2 cinnamon sticks",
    "2 teaspoons whole cloves",
    "2 teaspoons ground allspice"
  ],
  "steps": [
    {
      "text": "Stir the apple juice, pineapple juice, and cranberry juice together with the brown sugar in a large pan. Place the cinnamon sticks, cloves, and ground allspice into a large teaball or cheesecloth bag. Place the spice bag into the pan with the juice mixture. Heat the juice mixture over medium-high heat about 10 minutes. Serve hot.",
