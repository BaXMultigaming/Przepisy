  "ingredients": [
    "0.5 yellow onion, sliced",
    "4 pork chops",
    "26 ounces condensed cream of mushroom soup",
    "0.25 cup water",
    "2 cubes beef bouillon"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BwNO9KOz6dgR5b0n30cGa3Izd7w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277019-baked-pork-chops-with-cream-of-mushroom-soup-DDMFS-step-1-BG-7388-2a70dfddad2a4d5cb5678c8d1a24ed4a.jpg"
      ],
      "image": "assets/images/277019/step_01.webp"
    },
    {
      "text": "Place onion slices on the bottom of a glass baking dish. Lay pork chops over onions. Cover chops evenly with condensed soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5GKEu4vVawgTot49vYD2dqLEwa8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277019-baked-pork-chops-with-cream-of-mushroom-soup-DDMFS-step-4-BG-7394-516b237660e64d928234c833f543fe56.jpg"
      ],
      "image": "assets/images/277019/step_02.webp"
    },
    {
      "text": "Add water and bouillon, breaking up the bouillon cubes to spread flavor. Cover the baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/of1H9Fi7ZbL0HZ6_5L2d0uorPyU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277019-baked-pork-chops-with-cream-of-mushroom-soup-DDMFS-step-6-BG-7401-d826d25e46504d388da81bcc63c41a6a.jpg"
      ],
      "image": "assets/images/277019/step_03.webp"
    },
    {
      "text": "Bake pork chops in the preheated oven, stirring gravy once or twice, until no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the center of a chop should read at least 145 degrees F (63 degrees C).",
