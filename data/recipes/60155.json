  "ingredients": [
    "1 cup white sugar",
    "0.25 cup all-purpose flour",
    "1 teaspoon salt",
    "0.5 teaspoon pepper",
    "0.5 teaspoon dry mustard",
    "2 cups water",
    "0.5 cup soy sauce",
    "0.5 cup vinegar",
    "2 pounds pork spareribs, cut into bite size pieces",
    "1 tablespoon vegetable oil",
    "2 cloves garlic, chopped"
  ],
