  "ingredients": [
    "1 cup butter, softened",
    "1 cup sifted confectioners' sugar",
    "2 cups all-purpose flour",
    "0.5 teaspoon ground cardamom",
    "12 almonds, split"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter and sugar together in a large bowl until smooth; stir in flour and cardamom until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pinch off tablespoons of dough; roll into thin ropes. Join ends together into circles; place 1 almond half on seams where circles join. Place on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, about 20 minutes. Cookies should remain white, but may turn golden at edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
