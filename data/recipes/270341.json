  "ingredients": [
    "2 medium sweet potatoes, sliced into 1/4-inch rounds",
    "1 tablespoon olive oil",
    "1 (8 ounce) round Brie cheese, cut into 1-inch chunks",
    "1 package Grimm’s Fine Foods Sausage Bites (such as Mennonite Style Farmer Sausage Bites)",
    "0.25 cup dried cranberries",
    "0.25 cup pecans",
    "2 tablespoons fresh rosemary, chopped",
    "Honey for drizzling"
  ],
  "steps": [
    {
      "text": "Heat oven to 425 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss sweet potato rounds with olive oil and arrange in a single layer on a sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 minutes or until cooked through (smaller rounds cook faster).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top sweet potato rounds with a slice of Brie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice Grimm's Sausage Bites and add 3 to 4 pieces to each sweet potato round.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with cranberries, chopped pecans, and fresh rosemary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Apply a drizzle of honey to each round.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
