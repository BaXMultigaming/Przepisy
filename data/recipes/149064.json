  "ingredients": [
    "cooking spray",
    "1 cup light corn syrup",
    "1 cup sugar",
    "1 cup peanut butter",
    "6 cups Kellogg's® Rice Krispies® cereal or Kellogg's® Cocoa Krispies™ cereal",
    "1 cup semisweet chocoalte chips",
    "1 cup butterschotch chips"
  ],
  "steps": [
    {
      "text": "Spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the bars: Combine corn syrup and sugar in 3-quart saucepan. Cook over medium heat, stirring frequently, until sugar dissolves and mixture begins to boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and stir in peanut butter until well combined. Add rice cereal and stir until well coated. Press mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the topping: Melt chocolate and butterscotch chips in a 1-quart saucepan over low heat, stirring constantly. Spread evenly over cereal mixture. Let stand until firm, about 20 minutes. Cut into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
