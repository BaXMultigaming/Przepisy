  "ingredients": [
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "2 cups mashed bananas",
    "1 cup vegetable oil",
    "0.5 cup unsweetened applesauce",
    "1 (8 ounce) can crushed pineapple",
    "3 large eggs",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 8x4-inch loaf pans.",
      "section": null,
      "name": null,
