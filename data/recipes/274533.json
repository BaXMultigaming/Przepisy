  "ingredients": [
    "1.25 cups all-purpose flour",
    "0.5 cup butter",
    "0.33333334326744 cup white sugar",
    "0.75 cup fruit preserves",
    "0.5 cup chocolate chips",
    "0.25 cup honey",
    "2 tablespoons butter",
    "0.75 cup quick-cooking oats",
    "0.33333334326744 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, 1/2 cup butter, and sugar together until combined. Spread over the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix preserves and chocolate chips in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine honey and 2 tablespoons butter in a saucepan over medium heat; cook and stir until melted. Stir in oats and almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread preserve mixture on top of the partially baked crust, then top with the oat mixture. Bake until lightly browned, 15 to 20 minutes. Let cool before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
