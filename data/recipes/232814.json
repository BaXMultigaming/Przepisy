  "ingredients": [
    "0.5 cup red wine vinegar",
    "0.5 cup white sugar",
    "1.5 tablespoons water",
    "1.5 tablespoons butter",
    "0.5 teaspoon salt",
    "1 egg, beaten",
    "1 (15 ounce) can mandarin oranges, drained",
    "1 (10 ounce) package baby spinach",
    "1 (6 ounce) package sliced fresh mushrooms",
    "4 slices cooked bacon, crumbled",
    "0.33333334326744 cup toasted slivered almonds",
    "0.25 red onion, sliced and separated into rings",
    "0.25 cup croutons, or as desired"
  ],
  "steps": [
    {
      "text": "Combine vinegar, sugar, water, butter, and salt together in a saucepan; bring to a boil. Cook and stir until sugar dissolves and mixture is bubbling, about 1 minute. Remove from heat; cool to room temperature, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg into vinaigrette; return saucepan to low heat and simmer until thickens, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Mandarin oranges, spinach, mushrooms, bacon, almonds, red onion, and croutons in a large bowl; add vinaigrette and toss to coat.",
      "section": null,
