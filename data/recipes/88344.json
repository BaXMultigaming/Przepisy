  "ingredients": [
    "2.5 pounds chicken drumettes",
    "2 large potatoes, cut into large chunks",
    "2 carrots, cut into 2 inch pieces",
    "1 large onion, cut into 8 pieces",
    "4 cloves garlic, crushed",
    "0.25 cup water",
    "0.5 cup soy sauce",
    "2 tablespoons white sugar",
    "3 tablespoons gochujang (Korean hot pepper paste)"
  ],
  "steps": [
    {
      "text": "In a large pot over medium heat, mix the chicken, potatoes, carrots, onion, sugar, and garlic. Pour in water and soy sauce, and stir in sugar and hot pepper paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil, reduce heat to low, and simmer 45 minutes, until chicken juices run clear, vegetables are tender, and liquid has thickened.",
