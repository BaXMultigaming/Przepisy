  "ingredients": [
    "0.5 cup milk",
    "1 egg",
    "1 tablespoon all-purpose flour",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "5 bone-in, skin-on chicken breast halves",
    "2 cups crushed cornflakes cereal"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk, egg, flour, garlic powder, salt, and black pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge each chicken breast in milk mixture; roll in cornflakes to coat. Transfer to a baking sheet or dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until no longer pink at the bone and the juices run clear, about 45 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
