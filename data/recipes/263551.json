  "ingredients": [
    "1 (16 ounce) package fusilli pasta",
    "1.5 tablespoons butter",
    "2 shallots, minced",
    "1 cup heavy whipping cream",
    "4 cups fresh spinach",
    "0.5 cup Gorgonzola cheese",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook fusilli in boiling water, occasionally stirring, until tender yet firm to the bite, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the meantime, melt butter in a skillet over medium heat and cook shallots until soft and translucent, 3 to 5 minutes. Pour in cream and cook until heated through, 3 to 5 minutes. Add spinach and crumble in Gorgonzola cheese. Season with salt and pepper and cook until spinach is wilted and sauce has thickened, about 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain fusilli and toss with sauce. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
