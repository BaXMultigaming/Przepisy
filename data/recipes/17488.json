  "ingredients": [
    "6 eggs",
    "1 cup milk",
    "1 cup all-purpose flour",
    "2 tablespoons butter, melted",
    "1.5 cups white sugar",
    "0.75 cup buttermilk",
    "0.5 cup butter",
    "2 tablespoons light corn syrup",
    "1 teaspoon baking soda",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a 9x13 inch baking pan with the melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggs, milk and flour in a blender and whip until smooth. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 minutes, or until golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small saucepan, combine sugar, buttermilk, butter, corn syrup, baking soda; boil for 7 minutes. Remove from heat and stir in vanilla. Spoon over slices of pancake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
