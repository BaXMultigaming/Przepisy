  "ingredients": [
    "1 (18.25 ounce) package brownie mix (such as Betty Crocker®)",
    "0.66666668653488 cup vegetable oil",
    "2 eggs",
    "0.25 cup water",
    "12 chocolate sandwich cookies (such as Oreo®)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 12 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brownie mix, oil, eggs, and water together in a bowl until smooth. Spoon about 1 tablespoon batter into each muffin cup. Place 1 cookie into each muffin cup and top with more batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the side of the brownie comes out clean, 20 to 23 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
