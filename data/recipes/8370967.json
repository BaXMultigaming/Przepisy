  "ingredients": [
    "0.33 cup 1% milk",
    "8 ounces fresh strawberries, hulled",
    "4 ounces strawberry ice cream",
    "1 tablespoon strawberry syrup, divided",
    "1 tablespoon whipped cream",
    "1 large strawberry for garnish"
  ],
  "steps": [
    {
      "text": "Combine milk, strawberries, and strawberry ice cream in a blender. Blend on high until smooth, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle 1 1/2 teaspoons strawberry syrup on the inside of a glass jar. Pour in milkshake. Garnish with whipped cream and remaining strawberry syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Take reserved strawberry and carefully cut at an angle but do not cut completely through. Place strawberry on the rim of the glass. Insert a straw and enjoy!",
