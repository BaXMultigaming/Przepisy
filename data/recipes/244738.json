  "ingredients": [
    "2 pounds peeled Idaho potatoes, chopped",
    "3 tablespoons butter, softened",
    "0.33333334326744 cup half-and-half",
    "1 tablespoon chipotle peppers in adobo sauce",
    "2 tablespoons Hidden Valley® Original Ranch® Salad Dressing & Seasoning Mix",
    "1 pinch Salt to taste",
    "1 pinch Pepper to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes in large pan with water over high heat and boil until tender but still firm, about 15-20 minutes. Heat butter, half-and-half and peppers in saucepan over low heat until combined. Drain potatoes and place in mixer with butter sauce. Add dressing mix and process until smooth. Season with salt and pepper.",
