  "ingredients": [
    "4 bananas, peeled",
    "0.5 cup brown sugar, firmly packed",
    "0.25 cup orange or pineapple juice",
    "3 tablespoons sherry",
    "1 dash nutmeg",
    "2 tablespoons butter",
    "0.5 cup chopped almonds or macadamia nuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the bananas into a small glass baking dish. Stir together the brown sugar, juice, and sherry; pour over the bananas, then sprinkle with nutmeg. Melt the butter in a small pan over medium heat. Stir in chopped nuts, and cook until lightly browned, about 4 minutes. Pour over the banana mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 15 minutes until the bananas are tender, and have become lightly glazed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
