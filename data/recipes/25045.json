  "ingredients": [
    "1 cup butter, softened",
    "1 cup white sugar",
    "3 eggs",
    "1 teaspoon vanilla extract",
    "1 tablespoon frozen orange juice concentrate",
    "2.6659998893738 cups all-purpose flour",
    "1 cup cornmeal",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "0.66000002622604 cup sweetened dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter and sugar until smooth. Beat in the eggs one at a time, then stir in the vanilla and orange juice concentrate. Combine the flour, cornmeal, baking powder, cinnamon, nutmeg and cloves; stir into the sugar mixture. Fold in the dried cranberries. Drop by rounded teaspoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 minutes in the preheated oven. Allow cookies to cool on baking sheet for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
