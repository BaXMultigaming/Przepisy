  "ingredients": [
    "2 cups white sugar",
    "0.5 cup margarine, softened",
    "2 eggs",
    "2 cups all-purpose flour",
    "1 cup buttermilk",
    "0.5 cup unsweetened cocoa",
    "2 teaspoons baking soda",
    "1 cup boiling water",
    "0.25 cup chocolate chips, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, margarine, and eggs together in a large bowl until smooth and creamy. Add flour, buttermilk, cocoa, and baking soda and mix. Stir boiling water into mixture just until batter is mixed. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 30 to 35 minutes. Sprinkle chocolate chips over cake and let sit until chocolate begins to melt; spread over cake, creating an instant chocolate frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
