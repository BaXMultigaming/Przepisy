  "ingredients": [
    "1 cup cornmeal",
    "1 cup cold water",
    "1 teaspoon salt",
    "3 cups boiling water",
    "1 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "In a mixing bowl combine cornmeal, cold water and salt. Grease a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring the remaining 3 cups of water to a rolling boil and stir in the cornmeal mixture. Bring the mixture back to a boil while stirring constantly. Reduce heat to a simmer and stir in the cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let the mixture simmer for 20 to 30 minutes; stirring frequently. Allow the polenta to simmer until it becomes very thick. Spread the mixture into the loaf pan and refrigerate at least 4 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
