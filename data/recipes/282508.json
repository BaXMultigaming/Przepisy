  "ingredients": [
    "1 tablespoon olive oil",
    "2.5 pounds skinless, boneless chicken breast halves",
    "2.5 pounds skinless, boneless chicken thighs",
    "2 (7 ounce) cans diced green chile peppers, divided",
    "1 large onion, diced",
    "1 whole head garlic, peeled and chopped",
    "3 tablespoons ground cumin",
    "2 large limes, juiced, divided",
    "1 tablespoon salt",
    "1 tablespoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place oil in the bottom of a slow cooker. Add chicken breasts and thighs, 1 can of chile peppers, onion, garlic, cumin, 1/2 of the lime juice, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until chicken is falling apart, about 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken and shred with 2 forks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return chicken to the slow cooker. Add remaining chile peppers and lime juice; stir. Test flavor and season with salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
