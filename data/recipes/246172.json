  "ingredients": [
    "0.33333334326744 cup soy sauce",
    "2 green onions, chopped, dark green parts separated from white and light green parts",
    "0.25 yellow onion, thinly sliced",
    "3 tablespoons white sugar",
    "3 cloves garlic, minced",
    "2 tablespoons toasted sesame seeds",
    "1 tablespoon sesame oil",
    "0.25 teaspoon Korean red pepper flakes",
    "0.25 teaspoon minced fresh ginger",
    "0.125 teaspoon ground black pepper",
    "1.5 pounds beef sirloin steak, cut very thin using kitchen shears",
    "1 teaspoon honey, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
