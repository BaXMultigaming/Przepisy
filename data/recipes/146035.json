  "ingredients": [
    "1 tablespoon vegetable oil",
    "2 tablespoons grated fresh ginger",
    "2 teaspoons red curry paste",
    "1 stalk lemon grass, minced",
    "4 cups chicken broth",
    "3 tablespoons fish sauce",
    "1 tablespoon light brown sugar",
    "3 (13.5 ounce) cans coconut milk",
    "0.5 pound fresh shiitake mushrooms, sliced",
    "1 pound medium shrimp - peeled and deveined",
    "2 tablespoons fresh lime juice",
    "salt to taste",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-64ZG9W5jTLD-M3qi939qADRsOY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-146035-the-best-thai-coconut-soup-ddmfs-ingredients-3x4-1661-c1c7604597a3477da7bc0ea0c8c08758.jpg"
      ],
      "image": "assets/images/146035/step_01.webp"
    },
    {
      "text": "Heat oil in a large pot over medium heat. Add ginger, curry paste, and lemongrass; cook and stir in the hot oil for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q3DQVenboL9r3PDh4ToyPQcGog8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-146035-the-best-thai-coconut-soup-ddmfs-step1-3x4-1665-d76e586bbfee401690cf731bdfc8a3f3.jpg"
      ],
      "image": "assets/images/146035/step_02.webp"
    },
    {
      "text": "Gradually stir in chicken broth, then stir in fish sauce and brown sugar; reduce heat to low and simmer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Pj9a9nIqLtwleKUWkB8tcGD3N4k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-146035-the-best-thai-coconut-soup-ddmfs-step2-3x4-1676-63776d5f0b624fcbbc2eb55e4539599c.jpg"
      ],
      "image": "assets/images/146035/step_03.webp"
    },
    {
      "text": "Add coconut milk and mushrooms; cook and stir until mushrooms are soft, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BJdQ7IWnzTHykoMxlxqVRlybCu0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-146035-the-best-thai-coconut-soup-ddmfs-step3-3x4-1685-6cdb534536b547afbc20248525eac7b9.jpg"
      ],
      "image": "assets/images/146035/step_04.webp"
    },
    {
      "text": "Add shrimp; cook until no longer translucent, about 5 minutes. Stir in lime juice; season with salt and garnish with cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4i5hxzlgGtNHSp6qxHvZUge4bs4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-146035-the-best-thai-coconut-soup-ddmfs-step5-3x4-1704-ad5557fa3bb44c23b5b4ec1bf74d261f.jpg"
      ],
      "image": "assets/images/146035/step_05.webp"
    },
    {
      "text": "Enjoy!",
