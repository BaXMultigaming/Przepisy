  "title": "Marbled Pumpkin Cheesecake",
  "description": "This pumpkin cheesecake, with a gingersnap crust and creamy pumpkin filling with a marbled swirl, makes it a perfect holiday dessert.",
  "authors": [
    "Renee"
  ],
  "date_published": "2000-10-18T16:20:33-04:00",
