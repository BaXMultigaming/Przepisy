  "ingredients": [
    "12 eggs",
    "2 tablespoons mayonnaise",
    "1 teaspoon Chinese hot prepared mustard",
    "2 teaspoons yellow mustard",
    "salt and pepper to taste",
    "paprika, for garnish"
  ],
  "steps": [
    {
      "text": "Place eggs in a large saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove from hot water, cool and peel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice eggs in half lengthwise and remove yolks. Place yolks in a medium bowl, and mash together with mayonnaise, Chinese hot prepared mustard, yellow mustard, salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill the hollowed egg whites with the egg yolk mixture. Garnish with paprika. Chill in the refrigerator until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
