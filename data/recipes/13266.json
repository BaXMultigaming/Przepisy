  "ingredients": [
    "1 (15 ounce) can creamed corn",
    "1 cup peeled and cubed potatoes",
    "1 cup chopped carrots",
    "0.5 onion, chopped",
    "1 teaspoon celery seed",
    "0.5 teaspoon ground black pepper",
    "2 (14.5 ounce) cans vegetable broth",
