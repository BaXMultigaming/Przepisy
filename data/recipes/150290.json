  "ingredients": [
    "2.25 cups packed brown sugar",
    "1.5 cups margarine, softened",
    "0.75 cup white sugar",
    "3 eggs",
    "2 teaspoons almond extract",
    "1 teaspoon vanilla extract",
    "3 cups all-purpose flour",
    "3 cups regular rolled oats",
    "1.5 teaspoons baking soda",
    "0.75 teaspoon salt",
    "1.5 cups sweetened flaked coconut",
    "4 (1 ounce) squares white chocolate, chopped",
    "1 (3.5 ounce) jar coarsely chopped macadamia nuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease two cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, margarine, and white sugar together in a mixing bowl until light and fluffy. Beat in eggs, one at a time, until thoroughly blended. Stir in almond and vanilla extracts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, oats, baking soda, and salt together in a mixing bowl until well blended; stir into sugar mixture. Mix in coconut, white chocolate, and macadamia nuts until evenly blended. Drop dough by tablespoonfuls spaced 1 inch apart on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until centers are set and edges are golden brown, about 15 minutes. Cool 3 minutes on cookie sheets before transferring to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
