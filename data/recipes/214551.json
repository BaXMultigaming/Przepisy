  "ingredients": [
    "2 tablespoons olive oil",
    "1 cup finely chopped baby carrots",
    "1 onion, finely chopped",
    "2 cloves garlic, minced",
    "1 pound lean ground beef",
    "1.5 cups whole milk, divided",
    "1 (28 ounce) can crushed tomatoes",
    "1 (6 ounce) can tomato paste",
    "1 teaspoon dried basil",
    "1 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon crushed red pepper flakes",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large skillet over medium heat. Add carrots, onion, and garlic; cook and stir until tender, about 10 minutes. Add ground beef; cook, stirring and breaking up meat, until browned, 5 to 7 minutes. Drain off excess fat from the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in 1 cup milk; bring to a simmer. Reduce heat to medium-low and cook until milk is absorbed, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer beef mixture to a slow cooker and set to High. Stir in crushed tomatoes, tomato paste, basil, oregano, salt, pepper, and red pepper flakes. Cover and cook on High for 2 hours. Stir in remaining ½ cup milk and Parmesan; cook for 2 more hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
