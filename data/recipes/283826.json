  "ingredients": [
    "cooking spray",
    "1 (16 ounce) package boneless, skinless chicken tenders",
    "4 teaspoons unsalted butter, softened",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground paprika",
    "0.33333334326744 cup lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Spray an 8x11-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken tenders in a single layer in the prepared pan. Spread butter on the tenders, then evenly sprinkle with salt and paprika. Drizzle with lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until chicken is no longer pink in the center, 25 to 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
