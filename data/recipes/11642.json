  "ingredients": [
    "0.5 cup butter",
    "1 cup white sugar",
    "2 egg",
    "2.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon ground nutmeg",
    "1 tablespoon milk"
  ],
  "steps": [
    {
      "text": "In a medium bowl, cream the butter and sugar together. Stir in eggs, and beat well. Sift together the flour, baking powder and nutmeg. Add dry ingredients to the creamed mixture alternately with the milk. Divide dough in half. Cover and chill for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a lightly floured surface, roll out the dough to 1/4 inch thickness. Cut with cookie cutters and place onto the prepared cookie sheets. Bake for 8 minutes in the preheated oven, cookies should brown slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
