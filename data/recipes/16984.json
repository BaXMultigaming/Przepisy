  "title": "Turkey in a Smoker",
  "description": "This smoked turkey recipe makes a moist, tender turkey full of hickory flavor for an impressive, slow-cooked centerpiece perfect for Thanksgiving.",
  "authors": [
    "Doug"
  ],
  "date_published": "1999-10-23T15:05:42-04:00",
