  ],
  "ingredients": [
    "1 (10 pound) whole turkey, neck and giblets removed",
    "4 cloves garlic, crushed",
    "2 tablespoons seasoned salt",
    "0.5 cup butter",
    "2 (12 fluid ounce) cans cola-flavored carbonated beverage",
    "1 medium apple, quartered",
    "1 medium onion, quartered",
    "1 tablespoon garlic powder",
    "1 tablespoon salt",
    "1 tablespoon ground black pepper",
    "2 cups hickory wood chips, or more as needed"
  ],
  "steps": [
    {
      "text": "Preheat a smoker to 225 to 250 degrees F (110 to 120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat turkey dry thoroughly with paper towels—inside and out. This removes excess moisture and also helps skin crisp during roasting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NMj0BHXHSEEqLjruSQQln2oaR5U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16984-Turkey-In-A-Smoker-ddmfs-055-step1-13735b278e6d4133b35fbb0fb4c60895.jpg"
      ],
      "image": "assets/images/16984/step_02.webp"
    },
    {
      "text": "Rub crushed garlic over the outside of the turkey, and sprinkle with seasoned salt. Transfer to a disposable roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kBE60mLPmZS4phLkyL_0oh_rLiU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16984-Turkey-In-A-Smoker-ddmfs-056-step2-eb9b820e5dc64cefb4cbe03e11a0e12d.jpg"
      ],
      "image": "assets/images/16984/step_03.webp"
    },
    {
      "text": "Fill the turkey cavity with butter, cola, apple, onion, garlic powder, salt, and pepper. Cover turkey loosely with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qsp34qPee7IrJmbjDD_DogBwNNY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16984-Turkey-In-A-Smoker-ddmfs-058-step4-6e77025093de4fc6bb607d7b1ede10b3.jpg"
      ],
      "image": "assets/images/16984/step_04.webp"
    },
    {
      "text": "Add wood chips to the smoker according to the manufacturer's directions. Place the roasting pan in the preheated smoker. Smoke the turkey, basting every 1 to 2 hours with juices from the bottom of the roasting pan, for 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XkkT2161pnIsOwezeCOplRyIXdw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16984-Turkey-In-A-Smoker-ddmfs-058-step5-7a88f7acd966449d98d14e7bf717fa9e.jpg"
      ],
      "image": "assets/images/16984/step_05.webp"
    },
    {
      "text": "Add more wood chips if desired. Continue smoking and basting, until turkey is no longer pink at the bone and the juices run clear, about 4 to 5 more hours. An instant-read thermometer inserted into the thickest part of the thigh, near the bone, should read 180 degrees F (80 degrees C). Remove from the smoker, tent loosely with foil, and let rest for 20 minutes before carving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OO-NAR3nHj-arnaUlOawMyagmG0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16984-Turkey-In-A-Smoker-ddmfs-084-4x3-1-b1fc2e6b35484a2a9310d22874d6c41e.jpg"
      ],
      "image": "assets/images/16984/step_06.webp"
    }
  ],
