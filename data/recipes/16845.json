  "ingredients": [
    "1.5 pounds ground beef",
    "1 (16 ounce) can refried beans",
    "4 cups shredded Cheddar-Monterey Jack cheese blend",
    "1 (8 ounce) container sour cream",
    "1 cup guacamole",
    "1 cup salsa",
    "1 (2.25 ounce) can black olives, chopped",
    "0.5 cup chopped tomatoes",
    "0.5 cup chopped green onions"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and set aside to cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread beans on the bottom of a 9x13-inch glass dish or a serving platter. Sprinkle 2 cups of shredded cheese on top of beans. Spoon beef on top of cheese. Spread sour cream carefully on top of beef. Spread guacamole on top of sour cream. Pour salsa over guacamole and spread evenly. Sprinkle with remaining 2 cups shredded cheese. Sprinkle black olives, tomatoes, and green onions on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve immediately, or refrigerate overnight and serve cold.",
      "section": null,
      "name": null,
      "url": null,
