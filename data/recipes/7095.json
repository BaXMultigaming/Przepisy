  "ingredients": [
    "3 cups all-purpose flour",
    "1 tablespoon baking powder",
    "0.33333334326744 cup white sugar",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 egg, lightly beaten",
    "2 cups buttermilk",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, sugar, salt, and baking soda in a large bowl. Blend egg and buttermilk together; add all at once to the flour mixture and mix just until moistened. Stir in butter. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is golden brown, about 65 to 70 minutes. A toothpick inserted into the bread should come out clean. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
