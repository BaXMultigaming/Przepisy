  "ingredients": [
    "0.5 cup chopped almonds",
    "2 cups milk chocolate chips",
    "1 tablespoon shortening"
  ],
  "steps": [
    {
      "text": "Line a 9x13-inch baking pan with parchment paper; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast chopped almonds in a skillet over medium heat, stirring often, until golden brown. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate chips and shortening into a metal bowl set over a pan of simmering water until melted and smooth. Off heat, stir in ½ toasted almonds. Spread into the prepared baking pan; sprinkle with remaining ½ almonds. Chill until solid, about 30 minutes. Break into bite-sized pieces to serve.",
      "section": null,
