  "ingredients": [
    "1.5 cups shortening",
    "1.5 cups peanut butter",
    "2 cups packed brown sugar",
    "3 eggs",
    "2 teaspoons vanilla extract",
    "3 cups quick cooking oats",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 Degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In mixing bowl, cream the shortening and peanut butter. Add the brown sugar, eggs, and vanilla. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, flour, baking powder, and salt. Add to creamed mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chocolate chips and mix in well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by the rounded teaspoonful unto ungreased baking sheet. Flatten slightly with the bottom of a glass. Bake for 12 minutes or until done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
