  "title": "Side of the Trail Cookies",
  "description": "Use this recipe to make chocolate chip cookies that are great to take along on hikes or walks.",
  "authors": [
    "Girl Scout Troop 301 Penn Lake"
  ],
  "date_published": "1997-11-24T12:43:45-05:00",
