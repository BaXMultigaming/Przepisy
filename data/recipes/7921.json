  "title": "Applesauce Rum-Raisin Cake",
  "description": "This easy cake is made with whole wheat flour and applesauce, along with rum-soaked raisins and chopped walnuts.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-06-14T12:20:54-04:00",
