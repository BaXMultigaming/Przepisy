  "ingredients": [
    "0.5 cup golden raisins",
    "0.5 cup raisins",
    "0.33333334326744 cup dark rum",
    "0.5 cup butter, softened",
    "1 cup white sugar",
    "2 eggs",
    "1 cup all-purpose flour",
    "1 cup whole wheat flour",
    "1 tablespoon cornstarch",
    "2 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "1 tablespoon unsweetened cocoa powder",
    "0.5 cup chopped walnuts",
    "1.5 cups applesauce"
  ],
  "steps": [
    {
      "text": "Place all the raisins in a small bowl with the rum and let sit overnight or at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat butter and sugar with an electric mixer until light and fluffy. Beat in the eggs one at a time; mix in applesauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, stir together the flours, cornstarch, baking soda, cinnamon, nutmeg, salt, and cocoa. Gradually add flour into the batter, mixing until fully incorporated. Stir in the raisins, along with any rum that was not absorbed, and the walnuts. Turn batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a tester inserted in the middle of the cake comes out clean, about 25 minutes. Cool on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
