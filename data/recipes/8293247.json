  "ingredients": [
    "nonstick cooking spray",
    "1 pound ground beef",
    "1 pound ground pork",
    "6 medium mushrooms, minced",
    "0.5 medium onion, diced",
    "0.5 cup shredded mozzarella cheese",
    "1 large egg",
    "1 clove garlic, minced",
    "1 tablespoon dried oregano",
    "1.5 teaspoons dried basil",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 pinch red pepper flakes",
    "6 slices bacon, cut in half",
    "2 cups tomato sauce",
    "3 tablespoons reduced-sugar ketchup",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil",
    "1 teaspoon garlic powder",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together ground beef, ground pork, mushrooms, onion, mozzarella cheese, egg, garlic, oregano, basil, salt, pepper, and red pepper flakes in a large bowl until well combined. Form into a loaf shape and place in the middle of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together tomato sauce, ketchup, oregano, basil, garlic powder, salt, and pepper for sauce in a small bowl; pour over the meatloaf. Place bacon slices on top of the meatloaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until bacon is cooked and meatloaf is no longer pink in the center, about 45 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
