  "ingredients": [
    "butter for greasing",
    "9 eggs",
    "1.5 cups white sugar",
    "2 pounds ricotta cheese",
    "1 teaspoon vanilla extract",
    "2 cups heavy whipping cream",
    "1 cup cooked white rice",
    "1 (15 ounce) can crushed pineapple, drained"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Butter a 9x13-inch baking dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DpwxuUIR4Ux751C6vXIFgYdHdSY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12124-italian-rice-pie-i-VAT-step-01-841833f19e7e40b284d5ed76f21bdbce.jpg"
      ],
      "image": "assets/images/12124/step_01.webp"
    },
    {
      "text": "Beat eggs in very large bowl. Add sugar, mixing well. Stir in ricotta cheese and vanilla until smooth and creamy; stir in heavy cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SIHgrCnBnqYa6u6Sh-3JmakVeLA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12124-italian-rice-pie-i-VAT-step-02-b044f01f311c41f88dd5804bee3b7671.jpg"
      ],
      "image": "assets/images/12124/step_02.webp"
    },
    {
      "text": "Fold in cooked rice and crushed pineapple; pour into prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KHXeiKrm9n9ICAYDLOVywKWEYsE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12124-italian-rice-pie-i-VAT-step-03-54e2fa8f9d4442c497b747a00f78cc40.jpg"
      ],
      "image": "assets/images/12124/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until top is golden brown and a knife inserted into the center comes out clean, at least 1 hour. Refrigerate until thoroughly cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X2VBUtmh0u347fFf0dImAXmKogE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12124-italian-rice-pie-i-VAT-step-04-d97f389ad83746d98e583e1df31944ca.jpg"
