  "title": "Italian Rice Pie",
  "description": "This sweet rice pie made with lots of eggs, heavy cream, ricotta, vanilla, and cooked rice is a traditional and delicious Italian Easter dessert.",
  "authors": [
    "Star Pooley"
  ],
  "date_published": "1998-04-15T20:45:05-04:00",
