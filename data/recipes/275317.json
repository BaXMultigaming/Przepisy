  "ingredients": [
    "1 pound fresh green beans, trimmed",
    "0.5 cup water, or more as needed",
    "3 cloves garlic, minced",
    "1 tablespoon extra-virgin olive oil",
    "0.5 teaspoon dried basil",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place green beans in a microwave-safe glass dish. Add water, garlic, oil, basil, salt, and pepper and mix together. Cover the dish with a lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on high power for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Check water level, adding more if needed, and stir green beans. Replace the lid and microwave until tender-crisp, 3 to 5 minutes more.",
      "section": null,
