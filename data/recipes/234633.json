  "ingredients": [
    "2 butternut squash, halved and seeded",
    "1 cup water, or as needed",
    "0.75 cup sour cream",
    "0.5 cup butter",
    "1 tablespoon brown sugar",
    "0.5 teaspoon ground cinnamon",
    "salt and ground black pepper to taste",
    "2 sprigs fresh parsley, or as desired",
    "1 tablespoon sour cream"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BrhEqrUXjzoAfpbNj3N83vTpGj4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234633-mashed-butternut-squash-VAT-step-01-6798e28a80ca448a9de9e344a4d5628e.jpg"
      ],
      "image": "assets/images/234633/step_01.webp"
    },
    {
      "text": "Pierce butternut squash skin with a small knife and place cut-side down in a baking dish; pour in enough water for a depth of 1/2 inch. Cover dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z9-0vgGnCLqaXX-NplzvU-Gf9dk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234633-mashed-butternut-squash-VAT-step-02-b50dd6d559ff454397dc96902a9d17ce.jpg"
      ],
      "image": "assets/images/234633/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until squash is tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AwTN9_TWraGpjaLyRS-wvvr5Bug=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234633-mashed-butternut-squash-VAT-step-03-6bb23f5f8e7a44ff9ec457a38e7ac88f.jpg"
      ],
      "image": "assets/images/234633/step_03.webp"
    },
    {
      "text": "Scoop squash into a bowl; add 3/4 cup sour cream, butter, brown sugar, cinnamon, salt, and pepper. Mash mixture using a potato masher or fork until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/55FbCPztebplu90pSajX97t3pDo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234633-mashed-butternut-squash-VAT-step-04-af9b9251dd6b4ea9a59478f1f577e3f1.jpg"
      ],
      "image": "assets/images/234633/step_04.webp"
    },
    {
      "text": "Garnish with parsley and 1 tablespoon sour cream, if desired. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zKhN7n96a6Wy9Zpv2x_tuE6KHrI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234633-mashed-butternut-squash-VAT-step-05-c7be9021693f4f798e15415d007f15ed.jpg"
