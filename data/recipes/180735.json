  "title": "Vegan Shepherd's Pie",
  "description": "This hearty vegan shepherd's pie is made with plant-based ground beef and vegan cheese substitutes for a flavorful casserole that's sure to satisfy.",
  "authors": [
    "VeggieChefLaura"
  ],
  "date_published": "2019-04-02T02:51:19-04:00",
  "date_modified": "2025-02-25T14:16:36-05:00",
