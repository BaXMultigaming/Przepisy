    "British"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "5 russet potatoes, peeled and cut into 1-inch cubes",
    "0.5 cup vegan mayonnaise",
    "0.5 cup soy milk",
    "0.25 cup olive oil",
    "3 tablespoons vegan cream cheese substitute (such as Tofutti ®)",
    "2 teaspoons salt",
    "1 tablespoon vegetable oil",
    "1 large yellow onion, chopped",
    "2 carrots, chopped",
    "3 stalks celery, chopped",
    "0.5 cup frozen peas",
    "1 tomato, chopped",
    "1 teaspoon Italian seasoning",
    "1 clove garlic, minced, or more to taste",
    "1 pinch ground black pepper to taste",
    "1 (14 ounce) package vegetarian ground beef substitute",
    "0.5 cup shredded Cheddar-style soy cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2HR6E4JdItjLNByDxtW5oNsQdmc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-180735-traditional-style-vegan-shepherds-pie-VAT-step-01-e8fa8750c06948e59feb898d6405cca7.jpg"
      ],
      "image": "assets/images/180735/step_01.webp"
    },
    {
      "text": "Place potatoes in a pot, cover with cold water, and bring to a boil over medium-high heat. Turn the heat to medium-low, and boil potatoes until tender, about 25 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9WEdZlU8Ib51_0SBviByfdDUDkA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-180735-traditional-style-vegan-shepherds-pie-VAT-step-02-b4a147ff58d64e0f89a80567aa688332.jpg"
      ],
      "image": "assets/images/180735/step_02.webp"
    },
    {
      "text": "Stir vegan mayonnaise, soy milk, olive oil, vegan cream cheese, and salt into potatoes, and mash with a potato masher until smooth and fluffy. Set mashed potatoes aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6pdhN1NRBpyIlDjKrBXVvanIwsI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-180735-traditional-style-vegan-shepherds-pie-VAT-step-03-aa5b59fb65924732a9a08c5976fb8c3b.jpg"
      ],
      "image": "assets/images/180735/step_03.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C), and spray a 2-quart baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ntq4xoeYkjIjem7r0n7UP3BuOGU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-180735-traditional-style-vegan-shepherds-pie-VAT-step-04-2e7638bab77a4e8f80fd93e66077d0ad.jpg"
      ],
      "image": "assets/images/180735/step_04.webp"
    },
    {
      "text": "Heat vegetable oil in a large skillet over medium heat. Add onion, carrots, celery, frozen peas, and tomato; cook and stir until softened, about 10 minutes. Stir in Italian seasoning, garlic, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m6G7uuE-nSUHK71OvUsSUn2rz0k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-180735-traditional-style-vegan-shepherds-pie-VAT-step-05-ef2198901803468c804d80e1c8cebf94.jpg"
      ],
      "image": "assets/images/180735/step_05.webp"
    },
    {
      "text": "Reduce heat to medium-low and crumble plant-based ground beef into the skillet with vegetables. Cook and stir, breaking up the meat substitute, until the mixture is hot, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yg3tPgL-q2esFmUeTEl85r8FGMY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-180735-traditional-style-vegan-shepherds-pie-VAT-step-06-433da21781e1455398e1cb526a145ff2.jpg"
      ],
      "image": "assets/images/180735/step_06.webp"
    },
    {
      "text": "Spread vegetarian meat substitute mixture into the bottom of the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wL-lIKj50WMNd5u1wVsSjoTYEAk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-180735-traditional-style-vegan-shepherds-pie-VAT-step-07-decf045013a9498abcb11f7b832b3185.jpg"
      ],
      "image": "assets/images/180735/step_07.webp"
    },
    {
      "text": "Top with prepared mashed potatoes, smoothing them into an even layer. Sprinkle potatoes with shredded soy cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0td0YVjEWgaRY7kmwIR1RTMjoMs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-180735-traditional-style-vegan-shepherds-pie-VAT-step-08-5623a9571a97460fbad2da0b4dd42dd0.jpg"
      ],
      "image": "assets/images/180735/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven until the cheese is melted and slightly browned and the casserole is hot, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sMe7X21V6327XfsC4SSVTnKkyvk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-180735-traditional-style-vegan-shepherds-pie-VAT-step-09-3fe5de5941494ab7b7761beb1a39dec6.jpg"
      ],
      "image": "assets/images/180735/step_09.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w259Cq1NJwFBnKhkkFqVzK1wddo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-180735-traditional-style-vegan-shepherds-pie-VAT-4x3-1-adc03ea164ce4e469ffba34bc945232a.jpg"
      ],
      "image": "assets/images/180735/step_10.webp"
    }
