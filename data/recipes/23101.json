  "ingredients": [
    "2 pounds lean ground beef",
    "2 eggs",
    "1.5 cups dry bread crumbs",
    "0.25 cup ketchup",
    "1 teaspoon monosodium glutamate (MSG)",
    "0.5 cup warm water",
    "1 (1 ounce) package dry onion soup mix",
    "2 slices bacon",
    "1 (8 ounce) can tomato sauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine the beef, eggs, crumbs, ketchup, MSG, water and soup mix. Mix well and spoon mixture into loaf pan. Cover with 2 strips of bacon, then cover with tomato sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
