  "title": "Sarah's Roasted Red Pepper Dip",
  "description": "A sweet and tangy dip made with freshly roasted red bell peppers and a little heat. It's great with crudites or tortilla chips.",
  "authors": [
    "sarah with an h"
  ],
  "date_published": "2018-06-08T09:47:37-04:00",
