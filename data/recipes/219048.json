  "ingredients": [
    "0.25 cup vegetable oil",
    "4 pounds pork shoulder, cut into several large pieces",
    "3 tablespoons kosher salt",
    "1 onion, chopped",
    "1 clove garlic, crushed",
    "3 tablespoons lime juice",
    "1 tablespoon chili powder",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon ground cumin",
    "4 (14.5 ounce) cans chicken broth"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8U8bqG5IaSJJyJ9owPPbwu7ERhM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219048-slow-cooker-pork-carnitas-step1-625copy-c9a9cc8036294039a159c1ed9b71cc03.jpg"
      ],
      "image": "assets/images/219048/step_01.webp"
    },
    {
      "text": "Heat vegetable oil in a large Dutch oven over high heat. Season pork shoulder pieces with salt, then arrange in the Dutch oven. Cook until browned on all sides, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KMfkOO-GGpk0D8jNh6csG886-Do=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219048-slow-cooker-pork-carnitas-step2-627copy-dc3b4b43a1864dec87d21fbbebc903a7.jpg"
      ],
      "image": "assets/images/219048/step_02.webp"
    },
    {
      "text": "Stir in onion, garlic, lime juice, chili powder, oregano, and cumin. Pour in chicken broth; bring to a boil. Reduce heat to medium-low, cover, and simmer until pork is very tender, about 2 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kFlXDdkYsLpA67YZisDDTNoLYrw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219048-slow-cooker-pork-carnitas-step3-682copy-13cb4b3b8cdb4d408f8d2eca4133f075.jpg"
      ],
      "image": "assets/images/219048/step_03.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pork shoulder to a large baking sheet; reserve cooking liquid. Drizzle a small amount of cooking liquid over pork pieces and lightly season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pork in the preheated oven until browned, about 30 minutes. Drizzle more cooking liquid every 10 minutes; use two forks to shred pork as it browns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Sxp43Cj13U5J6MGJWylmZ8RsuMk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219048-slow-cooker-pork-carnitas-step4-688copy-a14555cabbfa412381d541e01a199fb4.jpg"
      ],
      "image": "assets/images/219048/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
