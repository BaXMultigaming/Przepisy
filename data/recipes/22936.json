  "ingredients": [
    "1 butternut squash",
    "1 cup white sugar",
    "1.5 cups milk",
    "1 teaspoon vanilla extract",
    "1 pinch salt",
    "2 tablespoons all-purpose flour",
    "3 eggs",
    "0.25 cup margarine, melted",
    "0.5 (16 ounce) package vanilla wafers, crushed",
    "0.5 cup margarine, melted",
    "1 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SZHJ9gZqCe1YdQBIzGAsBSQt3Lw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22936-butternut-squash-casserole-VAT-step-01-1aa23a9e470c4141959839f910409508.jpg"
      ],
      "image": "assets/images/22936/step_01.webp"
    },
    {
      "text": "Put butternut squash in the microwave and cook on high, until soft, 2 to 3 minutes. Cut in half, scoop out seeds and cube.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P74KXFEqORybfmXL9GNL71mOMrQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22936-butternut-squash-casserole-VAT-step-02-4dc606235f2b48efbc5ef5af357d9209.jpg"
      ],
      "image": "assets/images/22936/step_02.webp"
    },
    {
      "text": "Bring a large pot of water to a boil. Add squash and cook until tender, about 15 minutes. Drain and mash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TUd2bM1v43gc2vxd_xiEoujeizs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22936-butternut-squash-casserole-VAT-step-03-65219a16639f419faff69b77d7e34d29.jpg"
      ],
      "image": "assets/images/22936/step_03.webp"
    },
    {
      "text": "Combine 3 cups mashed butternut squash, white sugar, milk, vanilla extract, salt, flour, eggs and 1/4 cup melted butter in a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/po3uE6iqJxB4MQQ3pS6uMR13qAM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22936-butternut-squash-casserole-VAT-step-04-dcf0801a72094acd9ede2eb482d6af84.jpg"
      ],
      "image": "assets/images/22936/step_04.webp"
    },
    {
      "text": "Bake in preheated oven until set, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UoX2zlRpEYXAnKqDE9NrzXcT0Nk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22936-butternut-squash-casserole-VAT-step-05-bd223c0a99eb4cce9053854d0b827742.jpg"
      ],
      "image": "assets/images/22936/step_05.webp"
    },
    {
      "text": "Combine crushed vanilla wafers, 1/2 cup melted butter, and brown sugar in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Hz4mx9N9S3A7I5LMKPNPADL3uGs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22936-butternut-squash-casserole-VAT-step-06-5d10821329694323af321441028b9ee7.jpg"
      ],
      "image": "assets/images/22936/step_06.webp"
    },
    {
      "text": "Crumble over top of cooked casserole and return to oven to brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jrljf2ypS2T9LFZMWY9vk8J8MNU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22936-butternut-squash-casserole-VAT-step-07-c7c67c986ba24d1b907309ddb7ef500e.jpg"
      ],
      "image": "assets/images/22936/step_07.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
