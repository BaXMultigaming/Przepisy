        "https://www.allrecipes.com/thmb/E19ly4J3S7y3Uzs71vLsOlGIHpA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22936-butternut-squash-casserole-VAT-Beauty-4x3-570c04984c924ee1b2a8244448749455.jpg"
