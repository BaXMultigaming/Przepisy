  "ingredients": [
    "6.5 cups frozen blueberries",
    "0.33333334326744 cup brown sugar",
    "1 teaspoon lemon zest",
    "1.25 cups brown sugar",
    "0.75 cup all-purpose flour",
    "0.5 cup rolled oats",
    "6 tablespoons unsalted butter, room temperature and cut into chunks",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make filling: Combine blueberries, brown sugar, and lemon zest in a large bowl. Pour filling into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make topping: Combine brown sugar, flour, oats, butter, cinnamon, salt, and nutmeg in a medium bowl; rub mixture between your fingers until crumbly. Sprinkle topping evenly over blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crumble is lightly browned and bubbly, 40 to 45 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
