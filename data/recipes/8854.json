  "ingredients": [
    "1 pound chopped fresh broccoli",
    "1.5 cups cubed, cooked chicken meat",
    "1 (10.5 ounce) can condensed cream of broccoli soup",
    "0.33333334326744 cup milk",
    "0.5 cup shredded Cheddar cheese",
    "2 tablespoons dried bread crumbs",
    "1 tablespoon butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place broccoli in a saucepan with enough water to cover. Bring to a boil and cook until tender, about 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the cooked broccoli in a 9 inch pie plate. Top with the chicken. In a bowl, mix the soup and milk, and pour over the chicken. Sprinkle with Cheddar cheese. Mix the melted butter with the bread crumbs, and sprinkle over the cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
