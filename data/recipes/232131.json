  "ingredients": [
    "2 cups whole wheat flour",
    "2 tablespoons white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2.25 cups buttermilk",
    "2 large eggs",
    "4 tablespoons vegetable oil, divided"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Mpo9xlvo7fVJR0wqJ1TXHgOnL5M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232131-100-percent-whole-wheat-pancakes-ddmfs-step1-3x4-6246-66ff86f4dff34fa8b3fd6c70abf3f321.jpg"
      ],
      "image": "assets/images/232131/step_01.webp"
    },
    {
      "text": "Whisk flour, sugar, baking powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tFmnK-omWHT_MLaYS_kXKIBIVlw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232131-100-percent-whole-wheat-pancakes-ddmfs-step2-3x4-6248-9f01edaeb72447b498f83d386a23ca87.jpg"
      ],
      "image": "assets/images/232131/step_02.webp"
    },
    {
      "text": "Whisk buttermilk, eggs, and 3 tablespoons oil together in a separate bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZMVjgJTWWQhUJYejmgg4VEW7qWA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232131-100-percent-whole-wheat-pancakes-ddmfs-step3-3x4-6249-3f101695e8f74f5693994ec407081471.jpg"
      ],
      "image": "assets/images/232131/step_03.webp"
    },
    {
      "text": "Pour wet ingredients into dry ingredients and stir until just combined; batter may seem a bit thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LhI5WmO9r8iF-9D81vs981hzrgk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232131-100-percent-whole-wheat-pancakes-ddmfs-step4-3x4-6250-5cbe444d96c148a1b1ab695a702989d8.jpg"
      ],
      "image": "assets/images/232131/step_04.webp"
    },
    {
      "text": "Heat remaining 1 tablespoon oil in a cast iron skillet over medium-low heat for 5 minutes. Working in batches, pour 1/3 cup of batter for each pancake into the hot skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter into circles with a spoon; cook until browned on the bottom and bubbles appear on top, 1 1/2 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flip and cook until set in the middle and browned on the other side, about 2 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
