  "ingredients": [
    "1 cup olive oil",
    "5 tablespoons red wine vinegar",
    "0.25 cup sour cream",
    "1.5 teaspoons salt",
    "0.5 teaspoon mustard powder",
    "0.25 cup white sugar",
    "2 teaspoons chopped fresh parsley",
    "1 clove garlic, minced",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Whisk oil, vinegar, sour cream, salt, mustard, sugar, parsley, garlic, and pepper together in a bowl. Refrigerate at least 6 hours before serving.",
