  "ingredients": [
    "5 cups whole milk",
    "10 parsnips, peeled and cubed",
    "1 teaspoon salt, or more to taste",
    "0.25 cup butter",
    "1 teaspoon dried thyme",
    "0.5 teaspoon ground black pepper, or more to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
