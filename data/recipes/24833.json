  "ingredients": [
    "1.25 cups chicken broth",
    "1 cup uncooked couscous",
    "3 tablespoons extra virgin olive oil",
    "2 tablespoons fresh lime juice",
    "1 teaspoon red wine vinegar",
    "0.5 teaspoon ground cumin",
    "2 (15 ounce) cans black beans, drained",
    "8 green onions, chopped",
    "1 red bell pepper, seeded and chopped",
    "1 cup frozen corn kernels, thawed",
    "0.25 cup chopped fresh cilantro",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Pbkm1-1MJ_n_oN1ZVrBBNTt6cUY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24833-black-bean-and-couscous-salad-step-1-BG-8388-2-7e08850733004eb48489a83e11062c8d.jpg"
      ],
      "image": "assets/images/24833/step_01.webp"
    },
    {
      "text": "Bring broth to a boil in a 2-quart or larger saucepan. Stir in couscous, cover the pot, and remove from heat. Let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8DODas5FvLhy9C8NBm8S2rzEFZg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24833-black-bean-and-couscous-salad-step-2-BG-8399-2-3b872f37df95419eb5a395f8bcef347a.jpg"
      ],
      "image": "assets/images/24833/step_02.webp"
    },
    {
      "text": "Whisk together olive oil, lime juice, vinegar, and cumin in a large bowl. Add beans, green onions, red bell pepper, corn, and cilantro; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h5SxPbxPV9LDe16rslcFRb_xm6M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24833-black-bean-and-couscous-salad-step-4-BG-8417-2-6d8f035bb98841329837145befc746a0.jpg"
      ],
      "image": "assets/images/24833/step_03.webp"
    },
    {
      "text": "Fluff couscous well, breaking up any chunks. Add to vegetables in the bowl and mix well. Season with salt and pepper. Serve at once or refrigerate until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zlrsY7KkdUZalUcF0WK5CPJpYBA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24833-black-bean-and-couscous-salad-beauty-4x3-BG-8459-bfed7bc27dfb43a2b615a18552c5c56a.jpg"
