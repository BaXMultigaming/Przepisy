  "ingredients": [
    "6 eggs, beaten",
    "1 cup honey",
    "1 cup packed brown sugar",
    "0.5 cup canola oil",
    "1 teaspoon vanilla extract",
    "4 cups all-purpose flour",
    "2 cups whole wheat flour",
    "2 tablespoons ground cinnamon",
    "2 teaspoons baking powder",
    "2 teaspoons baking soda",
    "2 teaspoons salt",
    "4 cups grated zucchini",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease three 8x4-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, honey, brown sugar, oil, and vanilla extract together in a large bowl. Combine all-purpose flour, whole wheat flour, ground cinnamon, baking powder, baking soda, and salt in a separate bowl; stir into egg mixture until moistened. Gently stir in zucchini and walnuts until combined. Divide batter between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into centers comes out clean, 50 to 60 minutes. Briefly cool in the pans before removing to a wire rack to cool completely. Wrap loaves in plastic wrap or store in resealable plastic bags.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
