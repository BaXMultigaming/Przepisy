  "ingredients": [
    "5 tablespoons all-purpose flour",
    "0.25 teaspoon salt",
    "1 cup white sugar",
    "2.5 cups heavy whipping cream",
    "1 recipe pastry for a 9 inch single crust pie",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar and salt together. Add the whipping cream and mix thoroughly. Pour batter into one unbaked 9\" pie shell. Sprinkle top with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 45 minutes to 60 minutes or until bubbly all over the top. Store the baked pie in the refrigerator.",
