  "ingredients": [
    "cooking spray",
    "15 craft sticks",
    "15 medium apples",
    "2 cups white sugar",
    "1.5 cups water",
    "1 cup light corn syrup",
    "8 drops red food coloring"
  ],
  "steps": [
    {
      "text": "Lightly coat baking sheets with nonstick cooking spray. Insert craft sticks into bottom of apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F0trNumwi2DRSHzlRpP1PWDCgtE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21134-candied-apples-ii-VAT-step-02-43558260d2c0495788761096b59c336c.jpg"
      ],
      "image": "assets/images/21134/step_01.webp"
    },
    {
      "text": "Combine sugar, water, and corn syrup in a medium saucepan over medium-high heat. Bring to a boil; continue boiling, without stirring, until mixture registers 300 to 310 degrees F (149 to 154 degrees C) on a candy thermometer, or until a small amount dropped into cold water forms hard, brittle threads.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nxum_z5_n-2b0vN_NYWv-CfrNsU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21134-candied-apples-ii-VAT-step-03-569adedbccc04c9dbac09e29b443e95b.jpg"
      ],
      "image": "assets/images/21134/step_02.webp"
    },
    {
      "text": "Remove from heat; stir in food coloring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/npBNQUlLL7tgYNAXxVAPKbeddEw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21134-candied-apples-ii-VAT-step-04-1-f438a2b697da4a0eb7d905c4d88e7d76.jpg"
      ],
      "image": "assets/images/21134/step_03.webp"
    },
    {
      "text": "Holding each apple by its stick; dip into syrup, turning to coat evenly. Place on the prepared baking sheet to harden, stem-side down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OkMussgQlwPRlbhmU6CEZ9auCTg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21134-candied-apples-ii-VAT-step-05-d4038be40ac94949b4d3b694d0024a84.jpg"
