  "ingredients": [
    "0.75 cup butter",
    "0.75 cup white sugar",
    "0.25 cup packed brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2 (1 ounce) squares unsweetened chocolate",
    "0.25 teaspoon salt",
    "2 cups all-purpose flour",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Cream the butter until light. Gradually beat in the white and brown sugar ( on low speed with a mixer if using one ) until creamy and light. Beat in the egg and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the chocolate in a small, heavy saucepan over very low heat. Stir chocolate into the butter mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly stir in the salt and flour. Combine thoroughly. Stir in walnuts, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape into walnut-sized balls. Make an indentation with your thumb in each cookie. Bake at 350 degrees F (180 degrees C) for 10 to 12 minutes until just done. Cool on rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
