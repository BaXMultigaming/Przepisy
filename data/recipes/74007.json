  "ingredients": [
    "4 medium yellow squash",
    "0.5 cup extra virgin olive oil",
    "2 cloves garlic, crushed",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut squash horizontally into 1/4-inch to 1/2-inch thick slices so that you have nice long strips that won't fall through the grill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a small pan, and add garlic cloves. Cook over medium heat until the garlic starts to sizzle and become fragrant. Brush slices of squash with garlic oil and season to taste with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill squash slices for 5 to 10 minutes per side, or until they reach the desired tenderness. Brush with additional garlic oil, and turn occasionally to prevent sticking or burning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
