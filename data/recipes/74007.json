  "title": "Grilled Yellow Squash",
  "description": "Delicious grilled squash brushed with fresh garlic and olive oil is an easy and tasty way to prepare all the summer squash you have in your garden.",
  "authors": [
    "Sarah Stephan"
  ],
  "date_published": "2019-04-02T02:46:31-04:00",
