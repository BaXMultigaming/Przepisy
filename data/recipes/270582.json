  "ingredients": [
    "4 medium Yukon Gold potatoes, sliced into 1/4-inch rounds",
    "2 tablespoons olive oil",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 tablespoons malt vinegar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place 2 baking sheets in the oven and heat for about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss sliced potatoes in a bowl with olive oil, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove baking sheets from the oven and arrange potato slices on top in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are golden on the bottom, about 30 minutes. Remove from oven, drizzle with vinegar, and serve immediately.",
