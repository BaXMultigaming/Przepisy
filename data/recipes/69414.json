  "ingredients": [
    "1 (10 ounce) package frozen chopped spinach, thawed and squeezed dry",
    "1 cup sharp Cheddar cheese",
    "0.33333334326744 cup dry bread crumbs",
    "1 egg, beaten",
    "1 pound cod fillets",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix the spinach, 1/2 cup Cheddar cheese, about 5 tablespoons dry bread crumbs, and the egg. Spread the mixture into the bottom of a small baking dish. Arrange the cod fillets on top of the spinach mixture, and season with salt and pepper. Top with the remaining Cheddar cheese and bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and bake 20 minutes in the preheated oven, or until fish flakes easily with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
