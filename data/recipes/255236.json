  "ingredients": [
    "1 whole chicken",
    "1 pinch salt",
    "water to cover",
    "1 lemon, halved",
    "2 stalks celery, sliced",
    "1 small onion, chopped",
    "2 carrots, sliced, or more to taste",
    "2 cups all-purpose flour",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place chicken and 1 pinch salt in a large pot; cover with water. Bring to a boil, skimming any scum off the surface with a slotted spoon. Add lemon, celery, onion, and carrots. Simmer broth over medium heat until chicken starts to fall off the bone, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/L5HKUS6BH1-fLffJC48dHFWCtAg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255236-BetterThanCracherBarrellChickenNDumplings-ddmfs-Step1-0878-d1701aa689b1430484fed7a4378b7696.jpg"
      ],
      "image": "assets/images/255236/step_01.webp"
    },
    {
      "text": "Discard lemon. Remove chicken from the pot; let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour, salt, and pepper in a large bowl. Make a well in the center. Ladle in 2 to 3 scoops of hot broth. Mix in flour with a spoon until dough comes together into a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t6GI3axo5jepss90czmrYP1gtNo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255236-BetterThanCracherBarrellChickenNDumplings-ddmfs-Step2-0879-47fd248463e84786bd9df14e31c2d5a8.jpg"
      ],
      "image": "assets/images/255236/step_03.webp"
    },
    {
      "text": "Turn dough out onto a floured surface. Knead carefully until smooth. Roll out into a large rectangle; cut into small rectangular dumplings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RkzL6GfsHul8dQW23fnlVt0yax4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255236-BetterThanCracherBarrellChickenNDumplings-ddmfs-Step3-0885-667f17fb6ed74b67948fb3980aaac190.jpg"
      ],
      "image": "assets/images/255236/step_04.webp"
    },
    {
      "text": "Drop dumplings one at a time into the simmering broth. Cook, stirring occasionally, until tender, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nlnCPyksuyk0Nvv4kobJdc4sdGM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255236-BetterThanCracherBarrellChickenNDumplings-ddmfs-Step4-0890-b942fdcf692f441b86183db90849b9db.jpg"
      ],
      "image": "assets/images/255236/step_05.webp"
    },
    {
      "text": "Bone chicken and chop into pieces. Add to the pot; cook until heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yCLQMh2y5nIXcbZTNFgpaFedU80=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255236-BetterThanCracherBarrellChickenNDumplings-ddmfs-3X4-0898-890ae8a0b50e4c5b8814ae84eda77db7.jpg"
      ],
