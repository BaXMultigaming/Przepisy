  "ingredients": [
    "2 (12 fluid ounce) cans evaporated milk",
    "1 (4.3 ounce) package instant vanilla pudding mix",
    "0.5 teaspoon almond extract",
    "0.5 teaspoon pumpkin pie spice",
    "1 pound cinnamon rolls, torn into pieces",
    "1.5 cups raisins",
    "0.25 cup pecans",
    "0.25 cup butter, cut into small pieces"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 3-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix evaporated milk, pudding mix, almond extract, and pumpkin pie spice together in a large bowl. Add cinnamon rolls, raisins, and pecans and mix until well combined. Let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cinnamon roll mix to a casserole dish and dot with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, about 1 hour. Let cool for 10 to 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
