  "ingredients": [
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1.25 cups milk",
    "0.5 cup shredded Cheddar cheese",
    "1.5 cups macaroni"
  ],
  "steps": [
    {
      "text": "Cook pasta in a large pot of boiling salted water until al dente. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together condensed soup and cheese. Using the empty soup can, measure 1 can of milk; mix into the soup mixture. Stir in cooked pasta. Dump into a greased casserole dish, and cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C) until hot and bubbly, about 30 minutes.",
