  "ingredients": [
    "1.3333333730698 cups white sugar",
    "0.75 cup melted butter",
    "0.25 cup water",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "0.75 cup all-purpose flour",
    "0.75 cup unsweetened cocoa powder",
    "1 (3.5 ounce) package instant chocolate pudding mix",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup dark chocolate chips",
    "0.25 cup mini chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, and water together in a large bowl; add eggs 1 at a time, beating well after each addition. Stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cocoa powder, pudding mix, baking powder, and salt together in another bowl. Add flour mixture, 1/2 cup at a time, to butter mixture, stirring batter well after each addition. Stir dark chocolate chips and mini chocolate chips into batter. Pour batter into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the brownies comes out slightly sticky with chocolate, 20 to 30 minutes. Cool in baking dish for 10 minutes before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
