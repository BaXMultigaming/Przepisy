  "ingredients": [
    "0.75 cup uncooked short-grain white rice",
    "1.5 cups water",
    "2 cups 2% milk",
    "1 teaspoon maple flavored extract",
    "0.5 cup white sugar",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground cinnamon",
    "1 pinch ground cloves",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Combine the rice and water in a saucepan over medium heat. Bring to a boil, and let simmer over low heat for 20 minutes, or until all of the water has been absorbed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in 1 3/4 cups of the milk, sugar and maple flavoring, bring to a boil, and let simmer over medium heat until thick and creamy, about 15 minutes. Stir in the remaining milk, nutmeg, cinnamon, cloves and butter. Cook stirring over low heat for another 5 minutes. Pour into a casserole dish, or serving bowls, and let stand for 5 minutes before serving. This can be served cold also.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
