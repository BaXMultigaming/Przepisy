  "ingredients": [
    "1 (8 pound) bone-in smoked ham",
    "2 oranges, juiced",
    "3 tablespoons brown sugar",
    "1 tablespoon dry mustard",
    "1 tablespoon whole cloves, or as needed"
  ],
  "steps": [
    {
      "text": "Place ham in a large pot; cover with water. Soak in the refrigerator to remove salt, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a roasting pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine orange juice, brown sugar, and dry mustard in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain ham; pat dry. Place ham in the prepared roasting pan. Score outside of ham in a diagonal pattern; coat with orange juice mixture. Insert cloves at cross marks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through and glaze is well browned, about 2 hours. Rest before carving, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
