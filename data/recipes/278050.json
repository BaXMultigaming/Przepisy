  "ingredients": [
    "4 cups heavy cream",
    "4 teaspoons black truffle oil",
    "1 cup grated Parmesan cheese",
    "4 teaspoons butter",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine heavy cream and truffle oil in a saucepan over high heat; bring to a boil. Stir in Parmesan cheese, butter, salt, and pepper. Cook, stirring frequently, until the sauce has a smooth and creamy consistency, about 5 minutes.",
