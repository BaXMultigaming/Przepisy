  "ingredients": [
    "2 tablespoons olive oil",
    "3 cloves garlic, minced",
    "2 tablespoons chopped onion",
    "4 (3.5 ounce) links Italian sausage, sliced",
    "8 cups chicken stock",
    "1 teaspoon dried oregano",
    "1 tablespoon dried basil",
    "0.25 cup chopped fresh parsley",
    "2 cups uncooked white rice",
    "0.5 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Phpv1xbhSw-2JjjgHCne-sDUj9M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16820-italian-style-winter-soup-step-01-70cca252b030458ea10e4b0b7f23e196.jpg"
      ],
      "image": "assets/images/16820/step_01.webp"
    },
    {
      "text": "Heat oil in a large pot over medium heat. Add garlic and onion and cook, stirring, for 3 minutes, or until tender. Add sausage, browning well on all sides, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7JFwi-6PhAxktNfco5IYIRSUZo4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16820-italian-style-winter-soup-step-02-a2f7ecf0acc748c6806d0713db29067e.jpg"
      ],
      "image": "assets/images/16820/step_02.webp"
    },
    {
      "text": "Add chicken stock, oregano, basil, and parsley. Bring to a boil, reduce heat to low and simmer 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FW2KgizJXQZ2b78-utjemwySeFw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16820-italian-style-winter-soup-step-03-e06d870ce39840d98201f2d08c63b541.jpg"
      ],
      "image": "assets/images/16820/step_03.webp"
    },
    {
      "text": "Add rice and simmer 30 minutes longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3U9lcCMAVq5xhbCDLHdG5laHhYw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16820-italian-style-winter-soup-step-04-019c6b370b2b47529ed254dea37e71de.jpg"
      ],
      "image": "assets/images/16820/step_04.webp"
    },
    {
      "text": "Add cream, stirring well. Remove from heat and let soup rest briefly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z7lgzZjBmtPbDnIXIfJaG7wy__o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16820-italian-style-winter-soup-step-05-5ffe582d39dd48c3a7e8074edc978d7a.jpg"
