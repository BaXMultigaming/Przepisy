  "ingredients": [
    "1 (3 pound) beef chuck roast, cut into 6 to 8 chunks",
    "salt and ground black pepper to taste",
    "2 tablespoons vegetable oil",
    "0.5 cup beef broth",
    "0.25 cup apple cider vinegar",
    "0.25 cup fresh lime juice",
    "4 chipotle peppers in adobo sauce, chopped",
    "5 cloves garlic, chopped",
    "1 tablespoon ground cumin",
    "1 tablespoon dried oregano",
    "0.25 teaspoon ground cloves",
    "3 large bay leaves"
  ],
  "steps": [
    {
      "text": "Season beef chunks with salt and black pepper on all sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QLSCpzw__vmC4L2F6NbC0q3iXao=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246835-barbacoa-style-shredded-beef-ddmfs-step-1-0780-e1029f9075c34a02b17d7b882fe9d8a8.jpg"
      ],
      "image": "assets/images/246835/step_01.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add beef in batches; cook and stir until browned, 4 to 5 minutes per batch. Transfer beef to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/da_fL31OhaWXsxlPRnwxxPyqQrI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246835-barbacoa-style-shredded-beef-ddmfs-step-2-0783-817fa138500644cba39830b3a536eb7c.jpg"
      ],
      "image": "assets/images/246835/step_02.webp"
    },
    {
      "text": "Combine broth, vinegar, lime juice, chipotles, garlic, cumin, oregano, and cloves in a bowl; season with salt and black pepper. Pour over beef in the slow cooker; stir in bay leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HHZOjdZbgypLbp4nPjYnuVLWCT4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246835-barbacoa-style-shredded-beef-ddmfs-step-3-0781-d6ca28f0d36c473db828449e88ccbbbf.jpg"
      ],
      "image": "assets/images/246835/step_03.webp"
    },
    {
      "text": "Cover the slow cooker; cook on Low until beef is fork-tender, 8 to 10 hours. Discard bay leaves. Transfer beef to a cutting board; shred using two forks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RyG2aX5ueduqtC_RHRsL6j5XPkw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246835-barbacoa-style-shredded-beef-ddmfs-step-4-0949-72979a1ac59647d4a477953fba7617b4.jpg"
      ],
      "image": "assets/images/246835/step_04.webp"
    },
    {
      "text": "Return beef to the slow cooker; stir to coat with sauce. Set aside to marinate before serving, at least 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WGIhbIlnys3Okf3DhUuCseL5wKs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/246835-barbacoa-style-shredded-beef-ddmfs-4x3-0966-4d2ace2554044992b4236fdef1e256f4.jpg"
      ],
      "image": "assets/images/246835/step_05.webp"
    }
  ],
