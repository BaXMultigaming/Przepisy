  "ingredients": [
    "0.5 cup fresh bread crumbs",
    "0.5 cup finely chopped pecans",
    "3 teaspoons chopped fresh parsley",
    "0.25 cup olive oil",
    "0.25 cup soy sauce",
    "0.25 cup brown sugar",
    "2 teaspoons lemon pepper",
    "1 teaspoon dried thyme",
    "1 teaspoon dried basil",
    "1 teaspoon dried parsley",
    "0.5 teaspoon garlic powder",
    "6 (4 ounce) fillets salmon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs, pecans, and fresh parsley together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, soy sauce, brown sugar, lemon pepper, thyme, basil, dried parsley, and garlic powder together in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the brown sugar glaze generously over each piece of salmon. Cover the top of each fillet with bread crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until salmon flakes easily with a fork, 10 to 15 minutes depending on thickness.",
      "section": null,
