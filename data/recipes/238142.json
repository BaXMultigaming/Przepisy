  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "2 eggs",
    "1 cup quick oats",
    "1 cup chocolate chips",
    "0.5 cup blueberry jam"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a large baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and baking soda together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a bowl with an electric mixer until light and fluffy; add eggs and beat until creamy and smooth. Add oats, chocolate chips, and blueberry jam; beat until evenly distributed. Mix flour mixture into blueberry jam mixture until just combined. Drop spoonfuls of dough, 2-inches apart, on prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 10 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
