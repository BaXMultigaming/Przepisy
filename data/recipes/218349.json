  "ingredients": [
    "1 (3 pound) beef brisket",
    "1 teaspoon garlic salt",
    "1 teaspoon unseasoned meat tenderizer (such as Adolph's®)",
    "1 (14.5 ounce) can beef gravy",
    "0.5 cup Italian salad dressing",
    "1 (6 ounce) jar sliced mushrooms, drained",
    "1 (1 ounce) package dry onion soup mix"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Season beef brisket with garlic salt and meat tenderizer; place in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix beef gravy, Italian salad dressing, mushrooms, and onion soup mix in a bowl. Pour mixture over beef brisket. Cover tightly with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until very tender, 4 to 5 hours.",
