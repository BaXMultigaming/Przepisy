  "ingredients": [
    "4 ounces dark chocolate, chopped",
    "3 eggs, separated",
    "1 tablespoon Irish cream liqueur",
    "1 cup whipped cream",
    "chocolate shavings"
  ],
  "steps": [
    {
      "text": "Melt chocolate in a small saucepan over low heat. Remove from heat and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg yolks in a large bowl; stir in cooled melted chocolate and Baileys. Fold in 1/2 of the whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a separate bowl until stiff; fold into chocolate mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon mousse into serving glasses and garnish with remaining whipped cream and chocolate shavings before serving.",
      "section": null,
