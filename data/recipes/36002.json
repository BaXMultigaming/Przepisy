  "ingredients": [
    "1 small onion, chopped",
    "7 cloves garlic",
    "0.5 cup olive oil",
    "0.5 cup vinegar",
    "0.5 cup soy sauce",
    "2 tablespoons chopped fresh rosemary",
    "2 tablespoons Dijon-style prepared mustard",
    "2 teaspoons salt",
    "1 teaspoon black pepper",
    "1 (2 pound) tri-tip steak",
    "oil for greasing"
  ],
  "steps": [
    {
      "text": "Place onion, garlic, olive oil, vinegar, soy sauce, rosemary, mustard, salt, and pepper into the bowl of a food processor. Process until marinade is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place steak in a large resealable plastic bag. Pour marinade over steak; seal the bag and refrigerate for about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill for high heat. Brush the grate with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steak from marinade and place on the prepared grill grate; discard marinade. Cook on the preheated grill to desired doneness or about 7 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
