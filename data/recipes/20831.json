  "ingredients": [
    "32 ounces plain yogurt",
    "1 large English cucumber, peeled and shredded",
    "5 cloves garlic, minced",
    "3 tablespoons distilled white vinegar",
    "0.25 cup extra virgin olive oil",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Place a cheese cloth over a medium bowl and strain the yogurt 6 hours in the refrigerator, or over night.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain as much excess liquid from the cucumber and garlic as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the yogurt, cucumber, garlic, vinegar, olive oil and salt. Stir until a thick mixture has formed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
