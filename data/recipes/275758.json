  "ingredients": [
    "1 yellow onion, chopped",
    "3 ribs celery, chopped",
    "2 carrots, chopped",
    "2 leeks, chopped",
    "4 cloves garlic, diced",
    "12 cups water",
    "1 cup chopped fresh parsley",
    "2 teaspoons dried thyme",
    "2 teaspoons dried oregano",
    "2 bay leaves",
    "salt and ground black pepper to taste",
    "0.25 cup soy sauce",
    "3 teaspoons liquid smoke",
    "1 teaspoon vegan Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Saute onion in a large nonstick soup pot over medium heat for 5 minutes. Add celery, carrots, leeks, and garlic; saute for 10 minutes. Add water, parsley, thyme, oregano, bay leaves, salt, and pepper. Bring to a boil, lower heat to medium-low, and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add soy sauce, liquid smoke, and vegan Worcestershire sauce; simmer for 1 hour. Remove and discard vegetables and bay leaves with a slotted spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
