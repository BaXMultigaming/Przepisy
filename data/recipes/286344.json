  "ingredients": [
    "3 tablespoons pure maple syrup",
    "1 tablespoon white miso paste",
    "1 teaspoon low-sodium soy sauce",
    "0.5 teaspoon everything bagel seasoning",
    "0.25 teaspoon garlic powder",
    "4 (4 ounce) frozen salmon fillets"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 390 degrees F (200 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine maple syrup, miso paste, soy sauce, bagel seasoning, and garlic powder in a shallow rimmed container. Lay salmon fillets, skin-side up, into the marinade. Marinate for a minimum of 10 minutes. Transfer marinated salmon fillets into an air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook salmon in the preheated air fryer for 5 minutes. Reduce air fryer temperature to 370 degrees F (187 degrees C) and air-fry until fish flakes easily with a fork, about 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
