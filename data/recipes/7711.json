  "title": "Orange Juice Cake",
  "description": "This moist orange juice cake is a citrusy twist on rum cake, made with yellow cake mix, pudding, and a buttery orange glaze.",
  "authors": [
    "Debbie Rowe"
  ],
  "date_published": "1998-05-28T23:33:24-04:00",
