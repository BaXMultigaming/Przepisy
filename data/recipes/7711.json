  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "1 cup cold water",
    "0.5 cup vegetable oil",
    "4 eggs",
    "0.75 cup orange juice",
    "0.75 cup white sugar",
    "0.5 cup butter",
    "confectioners sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a large Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, pudding mix, water, oil, and eggs together in a large bowl. Mix with an electric mixer on medium speed until combined, about 2 minutes. Pour batter into Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into cake comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine juice, sugar, and butter in a medium saucepan. Bring to a boil for about 2 minutes; cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Poke holes all over the top of the warm cake with a fork or skewer. Pour the warm orange glaze evenly over the cake while still in the pan. Cool for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Invert the cake onto a serving plate. Dust with confectioners’ sugar, if desired, before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
