  "ingredients": [
    "2 cups all-purpose flour",
    "0.75 cup white sugar",
    "1 teaspoon salt",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "2 cups quick-cooking oats",
    "1 cup dried cherries",
    "0.5 cup chopped walnuts",
    "0.5 cup pancake syrup",
    "1 cup applesauce",
    "0.75 cup vegetable oil",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, white sugar, salt, baking powder, and baking soda in a large bowl. Stir in oats, cherries, walnuts, and pancake syrup. Make a well in the center; pour in applesauce, vegetable oil, and vanilla extract. Mix until dough comes together. Press dough into a 10x15-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 20 to 25 minutes. Cool before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
