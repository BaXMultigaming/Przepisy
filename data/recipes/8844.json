  "ingredients": [
    "2 skinless, boneless chicken breasts",
    "2 cloves garlic, chopped",
    "2 tablespoons dried rosemary",
    "1 tablespoon lemon juice",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover chicken breasts with garlic, then sprinkle with rosemary, lemon juice, and salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in a 9x13-inch baking dish and bake in the preheated oven until done and juices run clear, about 25 minutes (baking time will depend on the thickness of your chicken breasts). An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
