  "ingredients": [
    "3 eggs",
    "2 cups grated zucchini",
    "1.6666666269302 cups packed brown sugar",
    "0.75 cup vegetable oil",
    "2 teaspoons vanilla extract",
    "3 cups all-purpose flour",
    "3 teaspoons ground cinnamon",
    "1.5 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl until smooth. Add zucchini, brown sugar, oil, and vanilla; mix well. Stir in flour, cinnamon, baking powder, baking soda, and salt until well combined. Stir in raisins and walnuts until evenly distributed. Divide batter between the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
