  "ingredients": [
    "6 tablespoons butter, melted",
    "2 tablespoons Worcestershire sauce",
    "1.5 teaspoons seasoned salt",
    "0.75 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "3 cups crispy rice cereal squares (such as Rice Chex ®)",
    "3 cups crispy corn cereal squares (such as Corn Chex®)",
    "1.5 cups crispy wheat cereal squares (such as Wheat Chex®)",
    "2 cups bite-sized pretzels",
    "1.5 cups Parmesan-flavored goldfish crackers",
    "1 cup bite-sized garlic-flavored bagel chips",
    "1 cup peanuts"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Hhw8KXNO5OOfI8-ZZ41Nyged-aU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233047-soccer-chex-mix-DDMFS-step-01-c232956b1e744ff4996b5763051c4758.jpg"
      ],
      "image": "assets/images/233047/step_01.webp"
    },
    {
      "text": "Mix butter, Worcestershire sauce, seasoned salt, garlic powder, and onion powder in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CtT6dgQRQw8Etw6RojGuawpeKno=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233047-soccer-chex-mix-DDMFS-step-02-28323d50cc604ff7b022456cf3468e8e.jpg"
      ],
      "image": "assets/images/233047/step_02.webp"
    },
    {
      "text": "Combine rice cereal squares, corn cereal squares, wheat cereal squares, pretzels, goldfish crackers, bagel chips, and peanuts in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7r5FXKzIkX8FD0RX6b7aLLiJlCE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233047-soccer-chex-mix-DDMFS-step-03-be1eec14bd2e40f9b4cb25d309d5768d.jpg"
      ],
      "image": "assets/images/233047/step_03.webp"
    },
    {
      "text": "Mix about 1/4 of the cereal mixture with 1/4 of the butter mixture in a separate bowl until coated; continue adding more cereal mixture and more butter mixture until cereal mixture is fully coated in butter mixture. Pour onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2Zwl_s0cBv7-4U8w5olj-cI9oyI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233047-soccer-chex-mix-DDMFS-step-04-417e486320a14220ad67f2a8a79466e0.jpg"
      ],
      "image": "assets/images/233047/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven, stirring every 15 minutes, until butter mixture is baked into cereal mixture, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
