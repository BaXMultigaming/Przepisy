  "ingredients": [
    "1 cup butter, softened",
    "1 (3 ounce) package cream cheese, softened",
    "1 cup white sugar",
    "1 egg yolk",
    "0.5 teaspoon vanilla extract",
    "2.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, cream cheese, and sugar together in a large bowl with an electric mixer until light and fluffy. Beat in egg yolk and vanilla. Stir in flour until well blended. Drop dough by spoonfuls or use a cookie press to place onto prepared cookie sheets. If using floral cookie press design, make an indentation in the center with a thimble, fill with preserves, or press candy into center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Cookies will still be pale. Cool cookies on baking sheets. They will harden slightly as they cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
