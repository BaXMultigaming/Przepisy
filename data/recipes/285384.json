  "ingredients": [
    "4 (4 ounce) salmon fillets",
    "0.25 cup soy sauce",
    "2 tablespoons avocado oil",
    "2 tablespoons chili-garlic sauce, or more to taste",
    "2 teaspoons grated fresh ginger",
    "1 teaspoon honey, or to taste",
    "0.5 teaspoon sesame oil",
    "1 medium lime, juiced",
    "2 cups cooked brown rice",
    "1 cup matchstick carrots",
    "1 cup snow peas, trimmed",
    "1 medium avocado, sliced",
    "0.5 medium red bell pepper, julienned",
    "3 stalks green onion, chopped",
    "0.25 cup natural creamy peanut butter",
    "1 tablespoon rice wine vinegar",
    "0.5 teaspoon garlic powder",
    "1 tablespoon water, or as needed",
    "2 teaspoons sesame seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a sheet pan with aluminum foil and place salmon fillets on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir soy sauce, avocado oil, chili-garlic sauce, ginger, honey, sesame oil, and lime juice together in a small bowl; brush over salmon fillets. Set remaining sauce aside for dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake salmon in the center of the preheated oven until it flakes easily with a fork, about 15 minutes. Remove from the oven and let cool, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide rice evenly between 4 bowls and top with salmon fillets. Distribute carrots, snow peas, avocado, and bell peppers evenly between the bowls; sprinkle green onion over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir reserved soy sauce mixture with peanut butter, rice wine vinegar, and garlic powder; add water until dressing reaches desired consistency. Drizzle over the bowls and sprinkle with sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
