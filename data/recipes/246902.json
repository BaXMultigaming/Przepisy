  "ingredients": [
    "8 cups diced rhubarb (1-inch pieces)",
    "1 red onion, cut into 8 equal wedges",
    "9 cloves garlic",
    "1 cup beer",
    "1 cup brown sugar",
    "0.5 cup ketchup",
    "0.25 cup balsamic vinegar",
    "2 tablespoons Worcestershire sauce",
    "2 tablespoons chili powder",
    "1 tablespoon liquid smoke",
    "2 teaspoons salt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread rhubarb, onion, and garlic on a baking sheet. Roast in the preheated oven until tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer roasted rhubarb, onion, and garlic to a blender; blend until very smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour rhubarb purée into a large pot; stir in beer, brown sugar, ketchup, balsamic vinegar, Worcestershire sauce, chili powder, liquid smoke, salt, cinnamon, and cayenne pepper. Simmer over medium heat, stirring occasionally, until sugar dissolves and flavors combine, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
