  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.33333334326744 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 cup butter, softened",
    "0.75 cup brown sugar",
    "0.25 cup white sugar",
    "1 egg",
    "1.5 tablespoons milk",
    "1.5 teaspoons vanilla extract",
    "2 tablespoons red food coloring",
    "1 cup dark chocolate chips, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/axKuf9OfVqQILbEkMbVNXPhkuPU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241360-red-velvet-chocolate-chip-cookies-VAT-005-step-01-e3fa39403e3c4ac7b40f0ec02feca5f3.jpg"
      ],
      "image": "assets/images/241360/step_01.webp"
    },
    {
      "text": "Whisk flour, cocoa powder, baking soda, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q0Ma4AK35XNtMD5e1mQo7EGOzzo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241360-red-velvet-chocolate-chip-cookies-VAT-006-step-02-e2baed4df41e4627972bc7fced7a0f40.jpg"
      ],
      "image": "assets/images/241360/step_02.webp"
    },
    {
      "text": "Beat butter with an electric mixer until fluffy, about 2 minutes; beat in brown sugar and white sugar until smooth, about 1 minute. Beat egg, milk, and vanilla extract into butter mixture; beat in food coloring until uniformly colored.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FoeBeDbDY22VDSRdGmDPjumfj-I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241360-red-velvet-chocolate-chip-cookies-VAT-007-step-03-6eb30e4fe3ac43f19fa0bf1a76f32748.jpg"
      ],
      "image": "assets/images/241360/step_03.webp"
    },
    {
      "text": "Stir flour mixture into butter mixture gradually with electric mixer on low speed until combined; stir in 1 cup chocolate chips. Cover bowl with plastic wrap; place in the refrigerator for 1 hour or up to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ug_sObHEVwzVPcJ2-2oGJ7tt8_g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241360-red-velvet-chocolate-chip-cookies-VAT-008-step-04-f9e0cf7aa3b5483389fb629f782460e0.jpg"
      ],
      "image": "assets/images/241360/step_04.webp"
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper. Roll dough into 2-inch balls; place on prepared baking sheets and flatten slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CANyJKdETH_mmkixvlEqNg1fTGc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241360-red-velvet-chocolate-chip-cookies-VAT-010-step-06-b2dac24d16784e70aa6070b0a2fec548.jpg"
      ],
      "image": "assets/images/241360/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, about 10 minutes. Sprinkle cookies with a few additional chocolate chips; allow to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DSK667ZuGnns5hpdSBiEP4zsFcA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241360-red-velvet-chocolate-chip-cookies-VAT-011-step-07-6bf0799b999441b8b184bc1a38b5b864.jpg"
      ],
      "image": "assets/images/241360/step_06.webp"
    }
