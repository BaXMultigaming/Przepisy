  "title": "Vegan Oatmeal Raisin Cookies",
  "description": "Oatmeal raisin cookies get a vegan makeover in this recipe made with soy milk and shortening instead of their dairy counterparts.",
  "authors": [
    "spwallace35"
  ],
  "date_published": "2020-06-19T00:36:36-04:00",
