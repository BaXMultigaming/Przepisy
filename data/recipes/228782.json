  "ingredients": [
    "3 cups white sugar",
    "0.75 cup margarine",
    "0.66666668653488 cup evaporated milk",
    "1 (12 ounce) bag semisweet chocolate chips",
    "1 (7 ounce) jar marshmallow cream",
    "1 cup chopped walnuts",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S3JFquX9u8BI6jQbVTnTKP6juJk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228782-The-Original-Fantasy-Fudge-DDMFS-Step-01-816b1169543d4767b8912b07024bd496.jpg"
      ],
      "image": "assets/images/228782/step_01.webp"
    },
    {
      "text": "Grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uzjmF1s_hkb-4miqLT7vI8Hpl6E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228782-The-Original-Fantasy-Fudge-DDMFS-Step-01-1-6a9036301f534d56a344bcf1f284c613.jpg"
      ],
      "image": "assets/images/228782/step_02.webp"
    },
    {
      "text": "Mix sugar, butter, and evaporated milk in a large, heavy saucepan over medium heat, stirring to dissolve sugar. Bring mixture to a full boil and cook for 5 minutes, stirring constantly, until mixture is slightly thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1mOQm6Ufbakw3UeWHRNEXqYq7FI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228782-The-Original-Fantasy-Fudge-DDMFS-Step-02-84cc8b2ab6614aefb6172c3d4a33e4f8.jpg"
      ],
      "image": "assets/images/228782/step_03.webp"
    },
    {
      "text": "Remove from the heat and add chocolate chips; stir until chocolate chips are melted and mixture is thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S-FuwD6eJDQX95jeGu62LBnUIwE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228782-The-Original-Fantasy-Fudge-DDMFS-Step-03-b9a68d9a2fa5406baebae6bbfdd86744.jpg"
      ],
      "image": "assets/images/228782/step_04.webp"
    },
    {
      "text": "Stir in marshmallow creme until incorporated. Mix in walnuts and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/njmPdduFuJvSwy8pMqcaYEGn0Os=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228782-The-Original-Fantasy-Fudge-DDMFS-Step-05-8d35a04312774c4d8704b6ce3a4b7e48.jpg"
      ],
      "image": "assets/images/228782/step_05.webp"
    },
    {
      "text": "Transfer fudge to the prepared pan and use an offset spatula to spread out evenly and flatten.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/STTp2DVkzoFtNhUxTC-5IjJMxiM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228782-The-Original-Fantasy-Fudge-DDMFS-Step-06-bcbeb560015c4f878ea67a802f8652dc.jpg"
      ],
      "image": "assets/images/228782/step_06.webp"
    },
    {
      "text": "Let cool for at least 1 hour before cutting into squares. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LxleDciUZfqtm0Bho7-9Y3j9y0s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-228782-The-Original-Fantasy-Fudge-DDMFS-4x3-eeb55a285fa24e3ea953fd8b70c20057.jpg"
