  "ingredients": [
    "4 cups chicken stock",
    "1 ham hock",
    "3 cups shredded cabbage",
    "2 cups thinly sliced potatoes",
    "1 teaspoon cream or milk",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine the stock, ham hock, and cabbage in a large stockpot; bring to a boil. Reduce heat to low; cover and cook until the potatoes are soft, about 30 minutes. Carefully separate the meat from the bone of the ham hock and dispose of the bone, adding the meat back to the soup. Stir in the cream; season with salt and pepper.",
