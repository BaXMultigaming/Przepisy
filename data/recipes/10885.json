  "title": "Peanut Butter Candy Blossoms",
  "description": "Peanut butter candy blossoms take peanut butter cookie dough and wrap it around Snickers® candy bars to create a delightful treat.",
  "authors": [
    "Carole Zee"
  ],
  "date_published": "1998-05-19T18:27:49-04:00",
