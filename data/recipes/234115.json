  "ingredients": [
    "1.5 pounds cubed beef stew meat",
    "2 tablespoons butter",
    "1 large onion, cut into 1-inch cubes",
    "1.5 cups baby carrots",
    "1.5 cups diced potatoes",
    "3 bay leaves",
    "1 (10.75 ounce) can tomato soup",
    "1.5 (10.75 ounce) cans water",
    "1 tablespoon steak sauce (such as A1®)",
    "1 (1 ounce) package dry onion soup mix (such as Lipton®)",
    "0.5 teaspoon lemon pepper seasoning"
  ],
  "steps": [
    {
      "text": "Place beef stew meat and butter into the bottom of a slow cooker. Put onion, baby carrots, potatoes, and bay leaves atop the beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomato soup, water, steak sauce, and onion soup mix together in bowl; pour over the beef and vegetables in the slow cooker. Sprinkle lemon pepper seasoning over the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low 8 to 10 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
