        "https://www.allrecipes.com/thmb/N0QuzNTGSkiy_XkcpoQ1wbOZFuo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26609-HamburgerPotatoCasserole-4x3-40cecd45e669470cad0ef91a040657ae.jpg"
