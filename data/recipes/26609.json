  "ingredients": [
    "1 pound lean ground beef",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "0.75 cup milk",
    "0.5 cup chopped onion",
    "salt and ground black pepper to taste",
    "3 cups peeled and thinly sliced potatoes",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8Ty9Vl3u4rD0eqYF73Pjs1ZgxQg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26609-HamburgerPotatoCasserole-step-01-3fb6eafa94ec4504b6923a9b23ca837c.jpg"
      ],
      "image": "assets/images/26609/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zRBu08kkDi6b6BXhcSVaJsm5F-I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26609-HamburgerPotatoCasserole-step-02-76a03897d1de4287ba655bed4b61e326.jpg"
      ],
      "image": "assets/images/26609/step_02.webp"
    },
    {
      "text": "Mix condensed soup, milk, onion, salt, and pepper in a medium bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EtsT8JAHbvZhxWTE-NaL2CdXyFg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26609-HamburgerPotatoCasserole-step-03-c6e29350574d43e6b4508c1b11e09bdd.jpg"
      ],
      "image": "assets/images/26609/step_03.webp"
    },
    {
      "text": "Alternately layer the potatoes, soup mixture, and browned ground beef in a 2-quart baking dish. Cover the dish tightly with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_E11ZPo3hMZN5TV4QrKQfzXA_Pk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26609-HamburgerPotatoCasserole-step-04-dac8e34c531c49f39bdeae7e9cefebb7.jpg"
      ],
      "image": "assets/images/26609/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until potatoes are tender, about 1 to 1 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6smMUllFEay41H5ntHq2Sqsy-N8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26609-HamburgerPotatoCasserole-step-05-98847f7bb30643e6bcdfde1a2d8304ee.jpg"
      ],
      "image": "assets/images/26609/step_05.webp"
    },
    {
      "text": "Remove foil, sprinkle Cheddar cheese on top, and continue baking until cheese is melted and bubbly, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MTr9JXiIGSYHx4Hw7fCnASEINvo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26609-HamburgerPotatoCasserole-step-06-e45be2f8ef99461b873514e3a5b5d6ac.jpg"
      ],
      "image": "assets/images/26609/step_06.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
