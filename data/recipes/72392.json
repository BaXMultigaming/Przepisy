  "ingredients": [
    "1 (10 ounce) package fresh spinach leaves",
    "0.5 cup sour cream",
    "0.5 cup shredded pepperjack cheese",
    "4 cloves garlic, minced",
    "4 skinless, boneless chicken breast halves - pounded to 1/2 inch thickness",
    "1 pinch ground black pepper",
    "8 slices bacon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place spinach in a large glass bowl, and heat in the microwave for 3 minutes, stirring every minute or so, or until wilted. Stir in sour cream, pepperjack cheese, and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay the chicken breasts out on a clean surface, and spoon some of the spinach mixture onto each one. Roll up chicken to enclose the spinach, then wrap each chicken breast with two slices of bacon. Secure with toothpicks, and arrange in a shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered for 35 minutes in the preheated oven, then increase heat to 500 degrees F (260 degrees C), or use the oven's broiler to cook for an additional 5 to 10 minutes to brown the bacon.",
      "section": null,
      "name": null,
      "url": null,
