  "ingredients": [
    "1 wedge lemon",
    "1 tablespoon white sugar, or as needed",
    "2 fluid ounces lemon-flavored vodka",
    "1 fluid ounce lemon juice",
    "1 fluid ounce lemon simple syrup",
    "0.5 fluid ounce orange-flavored liqueur (such as Cointreau®)",
    "1 cup ice cubes, or as needed"
  ],
  "steps": [
    {
      "text": "Run lemon wedge around the rim of a cocktail glass to dampen, then dip in sugar to coat.",
