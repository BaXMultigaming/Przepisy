  "ingredients": [
    "1 (15 ounce) can pumpkin purée",
    "1 (12 fluid ounce) can evaporated milk",
    "1 cup white sugar",
    "3 large eggs",
    "4 teaspoons pumpkin pie spice",
    "1 (15.25 ounce) package yellow cake mix",
    "0.75 cup unsalted butter, melted",
    "1.5 cups chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ff5HAbKcCYjUIdldeKW-P_l-pzw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Great-Pumpkin-Desert-8404-step-1-0989807ccaaf49598ccd8bc55d474a93.jpg"
      ],
      "image": "assets/images/8404/step_01.webp"
    },
    {
      "text": "Mix pumpkin puree, evaporated milk, sugar, eggs, and pumpkin pie spice together in a bowl until well combined. Pour into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sO5GbTonI3tU9W3cLb5RPOoQeJI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Great-Pumpkin-Desert-8404-step-3-c166acb2ddf94132be8c0e04d60cbc7f.jpg"
      ],
      "image": "assets/images/8404/step_02.webp"
    },
    {
      "text": "Sprinkle dry cake mix evenly over top; drizzle butter and sprinkle walnuts evenly over cake mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RhScDDVHF8kNbdtttuZ2wpHeqms=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Great-Pumpkin-Desert-8404-step-6-5d4245e7325a40cc943c2e33c119e77b.jpg"
      ],
      "image": "assets/images/8404/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 1 hour. Let cool completely before cutting into 24 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4KrjwPHtnPz1OB8gKyIpdlPu7fQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Great-Pumpkin-Desert-8404-step-7-3b1bc15e0a5f41d485241d5082eef348.jpg"
      ],
      "image": "assets/images/8404/step_04.webp"
    }
