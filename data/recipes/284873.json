  "title": "Easy Shrimp Chow Mein",
  "description": "This super easy shrimp chow mein is simmered with a sweet soy sauce blend and vegetables, making it even better than takeout.",
  "authors": [
    "kim"
  ],
  "date_published": "2003-08-26T20:16:19-04:00",
