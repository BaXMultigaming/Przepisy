  "ingredients": [
    "3 pounds broccoli, cut into florets",
    "1 pound cooked bacon, crumbled",
    "0.5 red onion, diced",
    "0.5 cup baby Roma tomatoes, quartered",
    "1 (8 ounce) package shredded sharp Cheddar cheese",
    "0.75 cup mayonnaise",
    "0.66666668653488 cup grated Parmesan cheese",
    "0.5 cup sour cream",
