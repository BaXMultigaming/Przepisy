  "ingredients": [
    "4 eggs",
    "2.5 cups white sugar",
    "0.5 teaspoon salt",
    "6 cups milk",
    "3 cups evaporated milk",
    "2 tablespoons vanilla extract",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Beat eggs until foamy. Whisk in sugar until thickened. Gradually whisk in salt, 6 cups milk, evaporated milk, vanilla, and water. Pour into the freezer canister of an ice cream maker. Fill to the fill line with more milk if necessary. Freeze according to the manufacturers' directions.",
