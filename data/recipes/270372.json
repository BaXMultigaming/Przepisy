  "ingredients": [
    "1.5 cups shredded Cheddar cheese blend",
    "2 (10.5 ounce) cans condensed cream of chicken soup",
    "2 cups sour cream",
    "0.5 cup melted butter",
    "0.5 cup onion, chopped",
    "1 (32 ounce) package shredded hash brown potatoes",
    "3 cups coarsely crushed corn flakes",
    "2 tablespoons melted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Cheddar cheese, cream of chicken soup, sour cream, 1/2 cup melted butter, and onions in a large bowl. Gently fold in hash browns and spread out in the prepared baking dish. Cover evenly with crushed corn flakes and drizzle with 2 tablespoons melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
