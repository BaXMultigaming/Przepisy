  "ingredients": [
    "1 teaspoon curry powder",
    "2 teaspoons Worcestershire sauce",
    "1 teaspoon garlic salt",
    "0.25 teaspoon ground cayenne pepper",
    "3 tablespoons maple syrup",
    "0.66000002622604 cup golden currants",
    "2 cups corn chips",
    "2 cups crispy corn cereal squares",
    "2 cups mini pretzels",
    "1 cup popped popcorn"
  ],
  "steps": [
    {
      "text": "Preheat oven to 275 degrees F (135 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan over medium high heat, mix together curry powder, Worcestershire sauce, garlic salt, cayenne pepper, maple syrup and golden currants. Bring to a boil and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, toss together corn chips, crispy corn cereal squares, mini pretzels and popped popcorn. Pour in curry powder mixture and toss gently to attain an even coating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 30 minutes, or until crisp and lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
