  "ingredients": [
    "2.5 cups all-purpose flour",
    "2 cups white sugar",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground cloves",
    "1 cup pumpkin puree",
    "0.5 cup vegetable oil",
