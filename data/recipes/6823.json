  "title": "Walnut Raisin Scones",
  "description": "Lemon peel provides a lovely counterpoint to the walnuts and raisins in these buttermilk scones.",
  "authors": [
    "JJOHN32"
  ],
  "date_published": "1998-08-07T13:16:16-04:00",
