  "ingredients": [
    "2 (8 ounce) packages refrigerated crescent rolls",
    "2 (8 ounce) packages cream cheese, softened",
    "0.33333334326744 cup mayonnaise",
    "1 (1.4 ounce) package dry vegetable soup mix (such as Knorr®)",
    "1 cup radishes, sliced",
    "0.33333334326744 cup chopped green bell pepper",
    "0.33333334326744 cup chopped red bell pepper",
    "0.33333334326744 cup chopped yellow bell pepper",
    "1 cup broccoli florets",
    "1 cup cauliflower florets",
    "0.5 cup chopped carrot",
    "0.5 cup chopped celery"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread crescent roll dough out into an 11x14-inch jelly roll pan; pinch perforations and seams together to make a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly golden brown, about 10 minutes. Let cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese, mayonnaise, and vegetable soup mix together in a bowl. Spread cream cheese mixture over the crust. Sprinkle pizza with radishes, bell peppers, broccoli, cauliflower, carrot, and celery, pressing vegetables into the cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut pizza into squares, cover with plastic wrap, and refrigerate 8 hours to overnight to blend flavors.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
