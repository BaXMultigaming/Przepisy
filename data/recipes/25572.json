  "ingredients": [
    "1 (18.25 ounce) package devil's food cake mix",
    "1 (3.9 ounce) package instant chocolate pudding mix",
    "4 eggs",
    "1 cup sour cream",
    "0.5 cup vegetable oil",
    "0.5 cup water",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt pan. Have all ingredients at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cake mix and pudding mix together in a large bowl. Make a well in the center and pour in eggs, sour cream, oil, and water. Beat on low speed until blended. Scrape bowl, and beat 4 minutes on medium speed. Stir in chocolate chips. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 50 to 60 minutes. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
