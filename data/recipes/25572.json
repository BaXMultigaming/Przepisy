  "title": "Double Chocolate Brownie Cake",
  "description": "This moist brownie cake is easy to make with cake mix, instant chocolate pudding, sour cream, and chocolate chips for a delicious chocolaty treat!",
  "authors": [
    "ECHOSZERO"
  ],
  "date_published": "2019-04-03T23:28:28-04:00",
