  "title": "Not Your Mother's Pumpkin Bread",
  "description": "This is something special! A nutty pumpkin bread with spices and cream sherry!",
  "authors": [
    "Noel P"
  ],
  "date_published": "2020-06-18T23:05:00-04:00",
