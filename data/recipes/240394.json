  "ingredients": [
    "2.25 cups all-purpose flour",
    "2 tablespoons baking powder",
    "1 tablespoon pumpkin pie spice",
    "0.5 teaspoon salt",
    "2 cups white sugar",
    "1.75 cups mashed pumpkin",
    "0.5 cup vegetable oil",
    "2 eggs",
    "1 cup dried cranberries",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9 1/2-inch fluted cake pan (such as Bundt®).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, pumpkin pie spice, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, pumpkin, vegetable oil, and eggs together in a bowl until smooth. Slowly beat flour mixture into pumpkin mixture until batter is smooth. Fold in cranberries and walnuts. Pour into prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cake comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
