  "ingredients": [
    "3 cups cauliflower florets",
    "3 cups broccoli florets",
    "1 cup coarsely chopped onion",
    "4 cloves garlic",
    "1 tablespoon vegetable oil",
    "3 tablespoons salted butter",
    "3 tablespoons all-purpose flour",
    "3 cups vegetable broth",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon cracked black pepper",
    "0.5 teaspoon dried thyme",
    "4 cups packed fresh spinach"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a shallow baking pan with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange cauliflower, broccoli, onion, and garlic in a single layer on the prepared pan. Drizzle with oil; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until tender and lightly browned, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Add flour; cook and stir 1 minute. Add broth, roasted vegetables, salt, pepper, and thyme. Bring to a boil, stirring constantly. Reduce heat and simmer, covered, 10 minutes, adding spinach during the last 4 minutes to wilt. Cool slightly; puree in a blender or with an immersion blender. Serve hot. Or chill, covered, up to 3 days, and reheat for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
