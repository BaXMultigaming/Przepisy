  "ingredients": [
    "1 cup butter, softened",
    "1 cup packed brown sugar",
    "1.75 cups all-purpose flour",
    "2 cups rolled oats",
    "0.75 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 cup chopped walnuts",
    "0.75 cup fruit preserves, any flavor"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the butter and brown sugar until smooth. Combine the flour, oats, baking soda and cinnamon; stir into the creamed mixture. Mix in the walnuts. Set aside 2 cups of the mixture. Press remaining mixture evenly into the bottom of the prepared pan. Spread preserves over the base and crumble the reserved oat mixture over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes until golden. Cool before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
