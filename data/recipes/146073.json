  "ingredients": [
    "2 cups plain yogurt",
    "1 egg, beaten",
    "0.33300000429153 cup molasses",
    "1 cup raisins",
    "0.5 cup wheat germ",
    "1 cup quick cooking oats",
    "3 tablespoons butter, melted",
    "1.5 cups whole wheat flour",
    "1.25 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon ground cloves",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together the yogurt, egg, molasses, raisins, wheat germ, oats, and butter in a large bowl until evenly mixed. Sift the flour, baking soda, cinnamon, ginger, cloves, and salt on top of the molasses mixture. Fold the flour mixture into the molasses until a batter has formed. Pour batter into muffin cups, filling to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into the middle of a muffin comes out clean, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
