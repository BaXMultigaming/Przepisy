  "title": "Boneless Buffalo Wings",
  "description": "These boneless wings are made with strips of skinless chicken breasts dipped in egg and seasoned flour, then fried until juicy, crispy, and golden.",
  "authors": [
    "BETTYCOOK"
  ],
  "date_published": "2019-04-02T02:49:39-04:00",
