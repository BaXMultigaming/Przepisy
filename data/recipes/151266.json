  "ingredients": [
    "oil for deep frying",
    "1 cup unbleached all-purpose flour",
    "2 teaspoons salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon paprika",
    "0.25 teaspoon garlic powder",
    "1 egg",
    "1 cup milk",
    "3 skinless, boneless chicken breasts, cut into 1/2-inch strips",
    "0.25 cup hot pepper sauce",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TZ0tTFmg6dt2SdoWaHXeTwKashI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/151266-boneless-buffalo-wings-DDMFS-Step-01-377-68be350d1ed94c5dae9a512d16831215.jpg"
      ],
      "image": "assets/images/151266/step_01.webp"
    },
    {
      "text": "Combine flour, salt, black pepper, cayenne pepper, paprika, and garlic powder in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XUeE9RXTH6BnVtDvQkhj4yO_VD0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/151266-boneless-buffalo-wings-DDMFS-Step-02-378-4ffe138fd5e44f22928aa7986a24d7c3.jpg"
      ],
      "image": "assets/images/151266/step_02.webp"
    },
    {
      "text": "Whisk egg and milk together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ok_M87U2-rViFzAE5OwmGPJKAIc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/151266-boneless-buffalo-wings-DDMFS-Step-03-379-54e1c9bd47af4d029ab04502d4cd7e62.jpg"
      ],
      "image": "assets/images/151266/step_03.webp"
    },
    {
      "text": "Dip each piece of chicken in egg mixture, then roll in flour mixture. Repeat so that each piece of chicken is double-coated. Refrigerate breaded chicken for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YO0TGjHLuQpRqfk1CHuao3NN1Cg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/151266-boneless-buffalo-wings-DDMFS-Step-05-383-3261bb023c7d46d4986b92dd31e5f0cf.jpg"
      ],
      "image": "assets/images/151266/step_04.webp"
    },
    {
      "text": "Fry chicken in hot oil in batches. Cook until golden brown and juices run clear, 5 to 6 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lMdKT5G00x3emRFWY409W-bVL2E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/151266-boneless-buffalo-wings-DDMFS-Step-06-387-8ceadc4e39bb4667961c7ead0a5e919b.jpg"
      ],
      "image": "assets/images/151266/step_05.webp"
    },
    {
      "text": "Combine hot sauce and butter in a microwave-safe bowl. Heat sauce in the microwave until melted, 20 to 30 seconds. Pour sauce over fried chicken; mix to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SEpDgfLh2UpKoXxuEkb5HD2u3DQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/151266-boneless-buffalo-wings-DDMFS-Step-07-390-614def1d3dbd47e58ca31078a85f5639.jpg"
      ],
      "image": "assets/images/151266/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2xyo81ibKdZDGpuKvYPbmBOQ5-I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/151266-boneless-buffalo-wings-DDMFS-4x3-403-e644c300766146e8b9b7054e792891b6.jpg"
      ],
      "image": "assets/images/151266/step_07.webp"
    }
