  "ingredients": [
    "6 tablespoons butter",
    "3 medium onions, thinly sliced",
    "1 tablespoon all-purpose flour",
    "1 (14.5 ounce) can chicken stock",
    "0.5 cup red wine",
    "2 teaspoons Dijon mustard",
    "1 teaspoon Worcestershire sauce",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/74Ox2kFDZgHPLybzJ_3H--DvXRI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220517_OnionGravyforBritishBangersandMash_ddmfs_Shot1_3x4_3986-0cb8c7c95b6a490392bb2d120aa071b5.jpg"
      ],
      "image": "assets/images/220517/step_01.webp"
    },
    {
      "text": "Melt butter in a heavy-bottomed pan over medium heat. Add onion; cook and stir until softened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GaJtBaw07KrU9NpHQJu9NiVHZGA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220517_OnionGravyforBritishBangersandMash_ddmfs_Shot2_3x4_3997-9284967212364aa7b75d9501577d5034.jpg"
      ],
      "image": "assets/images/220517/step_02.webp"
    },
    {
      "text": "Reduce heat to low; cover, and cook until onions are caramelized, stirring occasionally, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K_8LuLs18cTWOKZJG8orQ6mDDwU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220517_OnionGravyforBritishBangersandMash_ddmfs_Shot3_3x4_3999-c0895fc813f04c6d83e7db458cf5cd12.jpg"
      ],
      "image": "assets/images/220517/step_03.webp"
    },
    {
      "text": "Stir in flour until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xoh4zCvk5_GmTwqwTaVEnol4734=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220517_OnionGravyforBritishBangersandMash_ddmfs_Shot4_3x4_4000-f179bc4460ce4794b7044a4f815cec56.jpg"
      ],
      "image": "assets/images/220517/step_04.webp"
    },
    {
      "text": "Stir in chicken stock, red wine, Dijon mustard, and Worcestershire sauce; simmer until sauce is thickened, stirring frequently, about 15 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
