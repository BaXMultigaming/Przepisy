  "ingredients": [
    "0.25 cup frozen orange juice concentrate, thawed",
    "2 tablespoons lemon juice",
    "2 tablespoons rice vinegar",
    "1 tablespoon grated orange zest",
    "1 tablespoon garlic powder",
    "1 teaspoon ground nutmeg",
    "1 cup packed brown sugar",
    "2 (14 ounce) packages little smoked cocktail sausages",
    "1 tablespoon cornstarch",
    "2 tablespoons water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the orange juice concentrate, lemon juice, rice vinegar, orange zest, garlic powder, nutmeg, and brown sugar; stir to dissolve the sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the cocktail sausages into the orange mixture to coat; pour the sausages and sauce into an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly, 30 to 40 minutes. Stir every 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, whisk the cornstarch and water to make a smooth paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the sausages from the sauce with a slotted spoon and place into a serving dish. Pour the sauce into a saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set the sauce over medium heat and cook until simmering; stir the cornstarch mixture into the sauce, and whisk until smooth and thickened, about 2 minutes. Pour the sauce over the cocktail sausages to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
