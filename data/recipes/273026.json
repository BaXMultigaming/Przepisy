  "ingredients": [
    "1 pound fresh asparagus, trimmed",
    "2 tablespoons olive oil",
    "3 cloves garlic, pressed through a garlic press",
    "0.25 teaspoon freshly cracked mixed peppercorns",
    "1.5 cups shredded Gouda cheese",
    "freshly cracked Himalayan pink salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread asparagus on the prepared baking sheet. Drizzle with oil; season with garlic, and black pepper. Toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 12 to 15 minutes. Set asparagus aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange spears so they're touching; sprinkle Gouda cheese down center of spears. Broil until cheese melts, 3 to 5 minutes. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
