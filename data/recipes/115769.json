  "ingredients": [
    "1 (3 pound) rabbit, cleaned and cut into pieces",
    "1 tablespoon ground black pepper",
    "1.75 teaspoons salt",
    "0.25 cup vegetable oil",
    "1 onion, chopped",
    "1 cup water",
    "0.75 cup ketchup",
    "1.5 tablespoons Worcestershire sauce",
    "4 teaspoons white sugar",
    "1 tablespoon paprika",
    "1 clove garlic, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season rabbit pieces with pepper and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a large skillet over medium-high heat. Add rabbit; cook in hot oil until brown on all sides. Place in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onion, water, ketchup, Worcestershire sauce, sugar, paprika, and garlic in a medium bowl; mix well, then pour over rabbit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered in the preheated oven, basting frequently, until very tender, about 90 minutes. An instant-read thermometer inserted into the meat nearest the bone should read at least 160 degrees F (72 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
