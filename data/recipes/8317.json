  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup quick cooking oats",
    "0.5 teaspoon baking powder",
    "0.66666698455811 cup packed brown sugar",
    "0.5 cup butter",
    "1 cup fruit preserves",
    "0.5 cup confectioners' sugar",
    "2 tablespoons milk",
    "1.5 teaspoons vanilla extract",
    "1 (8 ounce) package cream cheese",
    "2 cups frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In medium bowl, combine flour, oats, baking powder, sugar and butter. Mix until crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reserve 1 cup crumb mixture, set aside. With remaining crumbs, pat onto bottom and sides of 9 inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread fruit preserves over unbaked crust and top with reserved crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 20 to 25 minutes, or until golden brown. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine cream cheese, vanilla, milk and confectioners sugar. Blend until smooth. Fold in the whipped topping. Spoon into baked pie crust. Store in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
