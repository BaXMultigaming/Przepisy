  "ingredients": [
    "4 tablespoons vegetable oil",
    "2 onions, peeled and chopped",
    "2 cups thinly sliced celery",
    "1.5 pounds beef chuck, trimmed and cut into thin 1 inch slices",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 tablespoons soy sauce",
    "1 cup water",
    "2 teaspoons cornstarch"
  ],
  "steps": [
    {
      "text": "In a large skillet, heat 2 tablespoons of oil over medium heat. Slowly cook and stir onions and celery until golden brown; remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the same skillet, heat the remaining 2 tablespoons of oil. Place beef slices in the skillet and heat until well browned. Stir in salt, pepper, soy sauce and water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and simmer for 30 to 40 minutes. Return the onion and celery mixture to the skillet and simmer for another 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine the water and cornstarch. Pour the mixture into skillet. Stirring constantly, heat until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
