  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "1.5 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon salt",
    "1 cup almond milk",
    "2 large eggs",
    "0.25 cup canola oil",
    "0.5 cup oat bran",
    "1.25 cups huckleberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, cinnamon, baking soda, ginger, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour almond milk, eggs, and canola oil into a large bowl. Stir in oat bran with a wire whisk and blend well. Add flour mixture and mix until just incorporated into the batter. Fold in huckleberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned on top, about 20 minutes. Remove from the oven and let stand for 5 minutes before transferring to a serving platter or wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
