  "ingredients": [
    "1.5 cups sweet potato puree",
    "0.66666668653488 cup milk",
    "1 egg, lightly beaten",
    "2 tablespoons melted butter",
    "1.5 cups all-purpose flour",
    "2 tablespoons brown sugar",
    "1.5 tablespoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground ginger",
    "0.125 teaspoon ground cloves",
    "0.125 teaspoon salt",
    "1 cup maple syrup",
    "0.5 cup cranberry sauce",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sweet potato, milk, egg, and butter together in a bowl. Whisk flour, brown sugar, baking powder, 1 teaspoon cinnamon, nutmeg, ginger, cloves, and salt together in a separate large bowl. Add potato mixture to flour mixture; stir until batter is just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle batter into the preheated waffle iron and cook until waffles are golden and crisp, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir maple syrup, cranberry sauce, and 1/2 teaspoon cinnamon together in a saucepan over medium heat. Cook, stirring occasionally, until well-combined and heated through, 5 to 10 minutes. Pour syrup over cooked waffles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
