  "ingredients": [
    "2 teaspoons paprika",
    "1 teaspoon ground thyme",
    "1 teaspoon cumin",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon black pepper",
    "0.25 teaspoon salt",
    "2 teaspoons vegetable oil",
    "2 (6 ounce) skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Mix paprika, thyme, cumin, cayenne, onion powder, black pepper, and salt together in a bowl; transfer to a large plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the air fryer to 360 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub oil over each chicken breast until fully coated, then press into spice mixture until all sides are coated. Let sit for 5 minutes while the air fryer preheats. Place into the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry chicken until no longer pink in the center and the juices run clear, about 20 minutes, flipping halfway through. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken to a plate and let rest for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
