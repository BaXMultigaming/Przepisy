  "ingredients": [
    "cooking spray",
    "1 teaspoon vegetable oil, or as needed",
    "2 tablespoons freshly grated Parmesan cheese",
    "0.5 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon paprika",
    "0.25 teaspoon ground black pepper",
    "2 pounds red potatoes, halved",
    "1 tablespoon vegetable oil, or as needed",
    "0.25 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a 9x13-inch baking pan or cast iron skillet with cooking spray; pour in about 1 teaspoon vegetable oil to coat the bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Parmesan, salt, garlic powder, paprika, and pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HMCXMeQW7M-t32_i5rVAd0Fln90=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233393-oven-roasted-parmesean-potatoes-step-1-e4771b119f44427d9d470f34c71a3331.jpg"
      ],
      "image": "assets/images/233393/step_02.webp"
    },
    {
      "text": "Blot dry the cut-side of potatoes with a paper towel to remove any moisture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/57XseE8wskNDupW_N0tZPXDyfKk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233393-oven-roasted-parmesean-potatoes-step-2-5ca55ef79fd0416fb5da009f5c0485d3.jpg"
      ],
      "image": "assets/images/233393/step_03.webp"
    },
    {
      "text": "Place potatoes in a bowl and drizzle with 1 tablespoon vegetable oil; toss until potatoes are lightly coated. Sprinkle potatoes with Parmesan mixture; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hDu4YGVhC5mUvKXai_I24sNJRs8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233393-oven-roasted-parmesean-potatoes-step-3-ce9694401bbf4e2aaabd1446755541a6.jpg"
      ],
      "image": "assets/images/233393/step_04.webp"
    },
    {
      "text": "Arrange potatoes, cut-side down, on the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Qf4lz6vsR7hokkRqZqnJ_wQhV2w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233393-oven-roasted-parmesean-potatoes-step-4-626fb5f8a009432b965c3c7d507425c1.jpg"
      ],
      "image": "assets/images/233393/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven for 15 to 20 minutes. Flip potatoes and continue baking until golden and crispy, 15 to 20 more minutes. Serve with sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_iRBDIXKyWMW3vJ2Gg5GBr6SHK0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233393-oven-roasted-parmesean-potatoes-step-5-e4843423b87642ff98e7befc5889814e.jpg"
      ],
      "image": "assets/images/233393/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w2F2tUTqPJExnxOnJ-f-vexwxPM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233393-oven-roasted-parmesan-potatoes-DDMFS-4x3-48e56bab2d1d4a05a6ecbe53564a7f6d.jpg"
      ],
      "image": "assets/images/233393/step_07.webp"
    }
