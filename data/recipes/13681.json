  "ingredients": [
    "4 cups mashed sweet potatoes",
    "4 eggs, beaten",
    "0.5 cup white sugar",
    "0.5 pint heavy cream",
    "2 tablespoons vanilla extract",
    "1.25 cups chopped pecans",
    "1 cup packed brown sugar",
    "0.5 cup all-purpose flour",
    "0.25 pound butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sweet potatoes, eggs, white sugar, heavy cream, and vanilla extract in a bowl; transfer to the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pecans, brown sugar, flour, and butter; mix until crumbly. Sprinkle over sweet potato mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
