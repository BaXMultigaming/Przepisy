  "ingredients": [
    "4 (6 ounce) sushi-grade ahi tuna steaks",
    "1.5 teaspoons blackened seasoning",
    "2 tablespoons teriyaki sauce",
    "1 tablespoon white sesame seeds",
    "1 tablespoon black sesame seeds",
    "2 tablespoons grapeseed oil"
  ],
  "steps": [
    {
      "text": "Rinse tuna and pat dry. Place in a prep dish and sprinkle both sides with blackened seasoning. Brush teriyaki sauce on all sides of the tuna to glaze it.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix white and black sesame seeds together in a shallow dish. Dredge tuna in the sesame seeds until all sides are coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a cast iron skillet over high heat until smoking. Arrange tuna in the pan and cook for 30 to 45 seconds. Flip and cook for another 3o to 45 seconds; do not overcook!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Quickly transfer tuna to a cutting board and cut into 1/4-inch thick slices. Arrange tuna on individual plates, overlapping slices slightly. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
