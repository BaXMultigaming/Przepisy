  "ingredients": [
    "1 (16 ounce) package small seashell pasta",
    "1 cup mayonnaise",
    "0.25 cup distilled white vinegar",
    "0.66666668653488 cup white sugar",
    "2.5 tablespoons prepared yellow mustard",
    "1.5 teaspoons salt",
    "0.5 teaspoon ground black pepper",
    "1 large Vidalia or sweet onion, chopped",
    "2 stalks celery, chopped",
    "1 green bell pepper, seeded and chopped",
    "0.25 cup grated carrots",
    "1 pound diced cooked ham"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta, and cook until al dente, 8 to 10 minutes. Drain pasta, but do not rinse. Let stand 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the dressing, combine the mayonnaise, vinegar, sugar, mustard, salt, and pepper in a bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the onion, celery, bell pepper, carrots, and ham in a large bowl. Stir in the dressing. Add the pasta and toss gently to blend all ingredients. Chill at least 4 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
