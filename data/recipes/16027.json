  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "2 teaspoons chopped garlic",
    "1 teaspoon salt",
    "1 (14 ounce) can artichoke hearts, drained and chopped",
    "0.33000001311302 cup chopped black olives",
    "8 green onions, chopped",
    "3 ounces sun-dried tomatoes, softened and chopped",
    "0.25 cup chopped parsley",
    "1 tablespoon chopped fresh chives"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mix cream cheese, garlic and salt; stir and blend in artichoke hearts and olives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add green onions, tomatoes, parsley and chives; gently mix together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for several hours or overnight to blend flavors; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
