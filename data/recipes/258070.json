  "title": "Spargel-Antipasti mit Lachs (White Asparagus and Smoked Salmon)",
  "description": "White asparagus is plated over smoked salmon and drizzled with fragrant parsley oil in this appetizer perfect for a special dinner for two.",
  "authors": [
    "Leckerschmecker"
  ],
  "date_published": "2020-06-19T00:21:21-04:00",
