  "ingredients": [
    "1 cup graham cracker crumbs",
    "0.75 cup butter, melted",
    "2 tablespoons white sugar",
    "2 (8 ounce) packages whipped cream cheese",
    "0.75 cup sugar",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 24 muffin cups with foil liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the crust: Mix graham cracker crumbs, melted butter, and sugar together in a bowl. Press crumbs into the bottoms of the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the filling: Beat cream cheese, sugar, eggs, and vanilla in a bowl until smooth. Divide filling between muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cupcake tops are golden around the edges and slightly cracked, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top cooled cupcakes with cherry pie filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
