  "ingredients": [
    "1.25 cups graham cracker crumbs",
    "0.33333334326744 cup butter or margarine, melted",
    "0.25 cup sugar",
    "2 (8 ounce) packages cream cheese, softened",
    "1 (14 ounce) can EAGLE BRAND® Sweetened Condensed Milk",
    "3 large eggs",
    "0.25 cup lemon juice",
    "1 (8 ounce) container sour cream, at room temperature",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T2TsK4Cr3w6PCWzURXW3Fd2dRJM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/63954creamy-baked-cheesecake-DDMFS-001-step1-2bb6afa6bd544504a4e502acf89583f1.jpg"
      ],
      "image": "assets/images/63954/step_01.webp"
    },
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs, butter, and sugar in a large bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FVgmS3hTKs3g2hksut820I59DH8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/63954creamy-baked-cheesecake-DDMFS-001-step3-673e1dfcd07549d5892b9897f68f030c.jpg"
      ],
      "image": "assets/images/63954/step_03.webp"
    },
    {
      "text": "Press mixture firmly onto the bottom of a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_UGdnQThlbOiuMFlR4Q2h2zcsEw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/63954creamy-baked-cheesecake-DDMFS-001-step4-261567809e0d4fd3994b382055cc30e9.jpg"
      ],
      "image": "assets/images/63954/step_04.webp"
    },
    {
      "text": "Beat cream cheese in a large bowl with an electric mixer on medium speed until fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WGJUaU00cJSznenUUgzIHa0-mFY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/63954creamy-baked-cheesecake-DDMFS-001-step5-fa3dc5eacbec4d8682ea461aa090e96e.jpg"
      ],
      "image": "assets/images/63954/step_05.webp"
    },
    {
      "text": "Gradually beat in condensed milk until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y7q4epSemDABbYKOX4aaG49_iu8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/63954creamy-baked-cheesecake-DDMFS-001-step6-ed94827f183d4737843491a3bc37267b.jpg"
      ],
      "image": "assets/images/63954/step_06.webp"
    },
    {
      "text": "Add eggs and lemon juice; mix well. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/90oifvBD_c-b8PDDUFEyvWVmUPk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/63954creamy-baked-cheesecake-DDMFS-001-step10-5bd69518c73a4848b6fb52e7ff5e9503.jpg"
      ],
      "image": "assets/images/63954/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until center is set, 50 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S1ToyMfkoLbYJj_VDAMcR-fN3WM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/63954creamy-baked-cheesecake-DDMFS-001-step11-1508e47f37e74251b2fb569f23b1805d.jpg"
      ],
      "image": "assets/images/63954/step_08.webp"
    },
    {
      "text": "Remove cheesecake from the oven; top with sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9UzXNQl4qlivcfn1UwgsEc-6oN8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/63954creamy-baked-cheesecake-DDMFS-001-step12-0e2e225b4c684c489db1711b605bd633.jpg"
      ],
      "image": "assets/images/63954/step_09.webp"
    },
    {
      "text": "Continue baking until sour cream sets, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KljY-YhToN3Px5TkE4XwmRrr0kE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/63954creamy-baked-cheesecake-DDMFS-001-step13-6fb6eb782bc54f50b03f9247e181d27a.jpg"
      ],
      "image": "assets/images/63954/step_10.webp"
    },
    {
      "text": "Cool cheesecake at room temperature for 1 hour, then chill in the refrigerator for at least 4 hours. Garnish with pie filling before serving. Store leftovers covered in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Pkxifs-UKxit7VNVgS0eAVENMYE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/63954creamy-baked-cheesecake-DDMFS-001-step14-862bff4665c94326aeb51858a4de748d.jpg"
      ],
      "image": "assets/images/63954/step_11.webp"
    }
