  "ingredients": [
    "12 ounces rigatoni pasta",
    "0.5 pound fresh broccoli florets",
    "0.25 cup olive oil",
    "1 tablespoon minced garlic",
    "2 tablespoons pesto",
    "1 cup chopped tomatoes",
    "0.75 cup grated Parmesan cheese",
    "1 pound boneless chicken breast halves, cooked and chopped",
    "salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "In a large pot of salted boiling water, cook pasta until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, blanch broccoli in boiling water; remove with a slotted spoon and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium heat. Add minced garlic and pesto; sauté for 2 minutes. Stir in chopped tomatoes; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, toss cooked pasta with broccoli, cooked chicken, and tomato mixture. Add grated Parmesan cheese, salt, and ground black pepper; mix well and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
