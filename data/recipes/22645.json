  "ingredients": [
    "4 cups white sugar",
    "1 (12 fluid ounce) can evaporated milk",
    "1 cup light brown sugar",
    "0.5 cup butter",
    "1 (7 ounce) jar marshmallow creme",
    "1 (16 ounce) jar peanut butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_O1MP2TpRVIysMd7Ysa3hdBCB3E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22645-creamy-peanut-butter-fudge-step-01-b4114eabd94b4e809a67c11ba6812419.jpg"
      ],
      "image": "assets/images/22645/step_01.webp"
    },
    {
      "text": "Combine white sugar, evaporated milk, brown sugar, and butter in a medium saucepan over medium heat. Stir constantly until it comes to a boil. Boil for 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GeQc_uRBIrQa8m-ZC2DvoA93cIA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22645-creamy-peanut-butter-fudge-step-02-02-291fd102a7794be18a7ec7c02de0b954.jpg"
      ],
      "image": "assets/images/22645/step_02.webp"
    },
    {
      "text": "Remove from the heat and stir in marshmallow cream until well incorporated and melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WoSTVnySuBALo147pUIvkgf3bp0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22645-creamy-peanut-butter-fudge-step-03-bf373fe32d6841d989054ef5f47c51e5.jpg"
      ],
      "image": "assets/images/22645/step_03.webp"
    },
    {
      "text": "Stir in peanut butter and vanilla until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BV2nz3fTXFTe_09xYEvUkrsQJ20=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22645-creamy-peanut-butter-fudge-step-04-4a1dd06258ec460286e3d71dfec9c180.jpg"
      ],
      "image": "assets/images/22645/step_04.webp"
    },
    {
      "text": "Spread in the prepared pan. Let cool for 30 minutes before cutting into 24 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZuazkbgJXbscFlRFIFP71lyZo24=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22645-creamy-peanut-butter-fudge-step-05-ab27022c197b494ba3428d92effce4bb.jpg"
      ],
