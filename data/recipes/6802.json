  "ingredients": [
    "2 eggs",
    "1 cup buttermilk",
    "0.25 cup corn oil",
    "1.5 cups shredded Cheddar cheese, divided",
    "1 (8 ounce) can cream-style corn",
    "1 large onion, chopped",
    "2 fresh jalapeno peppers, seeded and minced",
    "1 cup cornmeal",
    "0.5 cup all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IQtY_66uraugeycUreLr-gnaU6Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6802-mexican-style-cornbread-DDMFS-step-1-BG-2800-2ebca22961a34198a022328cce645c82.jpg"
      ],
      "image": "assets/images/6802/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square pan or a cast iron skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a small bowl; mix in buttermilk and corn oil. Stir in 1 cup shredded cheese, creamed corn, onion, and jalapeños.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sZAt0mwUTwy35uGFFaJ8dCx4VbI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6802-mexican-style-cornbread-DDMFS-step-3-BG-2813-693156795fcb4d82a3a7c2d802bd6a4c.jpg"
      ],
      "image": "assets/images/6802/step_03.webp"
    },
    {
      "text": "Whisk cornmeal, flour, baking powder, baking soda, and salt together in a large bowl; stir in egg mixture until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HBcTaOEsK7UT53zRssDGcNGgTtA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6802-mexican-style-cornbread-DDMFS-step-5-BG-2819-71dc41d9423c4a3285770530e234331c.jpg"
      ],
      "image": "assets/images/6802/step_04.webp"
    },
    {
      "text": "Pour batter into the prepared pan; sprinkle remaining 1/2 cup cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4a4bZZPU2ZnVXkFtuBef7sPNV2w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6802-mexican-style-cornbread-DDMFS-step-6-BG-2822-c45b9895348142cd8c76baac5f8391c8.jpg"
      ],
      "image": "assets/images/6802/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until top is golden brown and a toothpick inserted in the center comes out clean, about 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/stHAO_qcWYB8qH8JWmrbnk0DyUE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6802-mexican-style-cornbread-DDMFS-step-7-BG-2850-504be740f93f4d27977b7bd5acc8285f.jpg"
