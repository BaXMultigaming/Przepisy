  "ingredients": [
    "2 pounds baby back pork ribs",
    "1 teaspoon salt, or to taste",
    "1 tablespoon canola oil",
    "0.5 onion, cut into quarters",
    "0.5 cup soy sauce",
    "0.5 cup light soy sauce",
    "0.5 cup rice wine",
    "0.25 cup orange juice",
    "0.25 cup minced fresh ginger root",
    "1 head garlic, chopped",
    "1 jalapeno pepper, chopped",
    "1 bunch scallions, trimmed and chopped"
  ],
  "steps": [
    {
      "text": "Wash ribs; pat dry. Liberally salt ribs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over high heat. Add ribs; cook, turning occasionally, until browned on all sides, 6 to 8 minutes. Transfer to a 3-quart slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion, soy sauce, light soy sauce, rice wine, orange juice, ginger, garlic, and jalapeño to a blender; cover and blend until combined. Pour sauce over ribs; cover slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High until meat easily pulls away from the bone, 3 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Place ribs on a baking sheet or roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook ribs under the preheated broiler until nicely charred but not burned, about 5 minutes. Garnish with scallions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
