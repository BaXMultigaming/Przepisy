  "ingredients": [
    "1 cup white rice flour",
    "0.75 cup butter",
    "0.5 cup confectioners' sugar",
    "0.25 cup potato starch",
    "0.25 cup tapioca starch",
    "3 cups finely chopped rhubarb",
    "2.25 cups white sugar",
    "3 eggs, well-beaten",
    "0.33333334326744 cup white rice flour",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup rice flour, butter, confectioners' sugar, potato starch, and tapioca starch in a bowl until crumbly and evenly combined; press into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is bubbling, about 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine rhubarb, white sugar, eggs, ⅓ cup rice flour, and salt in a bowl until well combined; spoon topping over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is bubbling, about 35 minutes.",
      "section": null,
