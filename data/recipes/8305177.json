  "steps": [
    {
      "text": "Fill a heat-safe glass mug with boiling water; let stand a few minutes to warm the mug. Discard water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add coffee, coffee liqueur, and vodka to the mug; stir gently to combine. Drizzle half-and-half over the drink. Place truffle on a spoon or thread onto a decorative pick; balance on the glass rim.",
