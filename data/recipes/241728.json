  "ingredients": [
    "3 pounds fresh green beans, trimmed",
    "4 slices bacon",
    "1 cup butter",
    "4 cloves garlic, minced",
    "0.5 teaspoon lemon zest"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place green beans in a pot and cover with water; bring to a boil. Reduce heat to medium-low and simmer until beans start to soften, about 10 minutes. Drain water, leaving beans in the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-koqYFxukgTzgho2d4Lep3ndGys=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241728-bacon-garlic-green-beans-DDMFS-step-01-f78f5d20e94d4c358268079f4705bc09.jpg"
      ],
      "image": "assets/images/241728/step_02.webp"
    },
    {
      "text": "Place bacon strips on a microwave-safe plate and cook in the microwave until crisp, about 2 minutes. Cool and crumble bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter and bacon into beans in the pot and return to medium heat; cook and stir until butter melts, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sh2apNblJBPcWBogB6xD4kdet3s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241728-bacon-garlic-green-beans-DDMFS-step-02-924e93f38a7e4d3f84412e6238d6e4c6.jpg"
      ],
      "image": "assets/images/241728/step_04.webp"
    },
    {
      "text": "Add garlic; cook and stir until fragrant, 3 to 4 minutes. Top with lemon zest and stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tLW7q_t-9W9g1L313YL3Hz7Xn3Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241728-bacon-garlic-green-beans-DDMFS-step-04-8066dfc6e2fc4dcc9a4e7e1d8ae8db6d.jpg"
      ],
      "image": "assets/images/241728/step_05.webp"
    }
