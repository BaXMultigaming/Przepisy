  "ingredients": [
    "2 (6 ounce) fillets red snapper",
    "0.25 teaspoon garlic powder",
    "salt and ground black pepper to taste",
    "0.25 cup picante sauce",
    "0.5 lime, juiced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Place a sheet of aluminum foil onto a baking sheet, and grease lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fillets onto the foil, and sprinkle with garlic powder, salt, and pepper. Spoon picante sauce over fillets, and squeeze lime juice over the top. Bring the sides of the foil together, and fold the seam to seal in the fish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 15 to 20 minutes, or until fish flakes easily with a fork.",
