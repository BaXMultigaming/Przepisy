  "ingredients": [
    "1 pound fresh green beans, trimmed and cut into 1 inch pieces",
    "0.25 cup vegetable oil",
    "4 cloves garlic, finely chopped",
    "1 tablespoon black mustard seed",
    "1 dried red chile pepper, crushed",
    "1 teaspoon salt",
    "0.5 teaspoon white sugar",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil. Cook green beans briefly in the boiling water, removing after 3 to 4 minutes. Drain, rinse with cold water, and drain again. Blot dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Stir in garlic and mustard seed; sauté until golden brown, 1 to 2 minutes. Stir in chile pepper, then add beans, salt, and sugar. Cook and stir until beans are tender, about 8 minutes. Season with pepper to serve.",
