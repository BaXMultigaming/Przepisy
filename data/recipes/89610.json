  "ingredients": [
    "1 cup orzo pasta",
    "2 tablespoons extra virgin olive oil",
    "0.5 red onion, chopped",
    "2 cloves garlic, minced",
    "1 cup chopped carrot",
    "1 small zucchini, quartered and sliced",
    "2 tablespoons balsamic vinegar",
    "salt and pepper to taste",
    "1 lemon, juiced"
