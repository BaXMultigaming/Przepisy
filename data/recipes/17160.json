  ],
  "breadcrumbs": [],
  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "0.66666668653488 cup warm milk (110 degrees F/45 degrees C)",
    "1 tablespoon active dry yeast",
    "2.5 cups bread flour",
    "0.33333334326744 cup white sugar",
    "0.33333334326744 cup butter, softened",
    "1 large egg",
    "0.5 tablespoon salt",
    "0.66666668653488 cup diced candied citron",
    "0.33333334326744 cup currants",
    "0.33333334326744 cup golden raisins",
    "0.33333334326744 cup red candied cherries, quartered",
    "6 ounces marzipan",
    "1 tablespoon confectioners' sugar",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QSRKIMQa5DeRLEz71E3hPQwbrzw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17160-christmas-stollen-VAT-step-01-f1b40688cc3a4187be00f1ba6fb6506a.jpg"
      ],
      "image": "assets/images/17160/step_01.webp"
    },
    {
      "text": "Place warm milk and yeast in a bowl. Let stand until creamy, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JbdlHu1avcQjleAsFrvzOZ-47M8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17160-christmas-stollen-VAT-step-02-0d8f74b770bd4fda8ebea669b1d5057d.jpg"
      ],
      "image": "assets/images/17160/step_02.webp"
    },
    {
      "text": "Place yeast mixture, 2 cups bread flour, white sugar, butter, egg, and salt in a large mixing bowl; stir well to combine. Add remaining flour, 1/4 cup at a time, stirring well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pSqTWBSnqXx6j08FMnpVUtqsPKc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17160-christmas-stollen-VAT-step-03-f8a1b906e9f4456ebe913178dca80555.jpg"
      ],
      "image": "assets/images/17160/step_03.webp"
    },
    {
      "text": "When dough has pulled together, turn it out onto a lightly floured surface; knead in candied citron, currants, golden raisins, and cherries. Continue kneading until smooth, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t6-mmDwkXjnCSMOrjXeWVk-n04I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17160-christmas-stollen-VAT-step-04-9a1d5cf354354fd788dcbe06aa2732ec.jpg"
      ],
      "image": "assets/images/17160/step_04.webp"
    },
    {
      "text": "Lightly oil a large bowl, place the dough in the bowl, and turn to coat with oil. Cover with a damp cloth and let rise in a warm place until doubled in volume, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XpjkHl6Il_W1htMG7giTr7hJHlA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17160-christmas-stollen-VAT-step-05-43a7d02c1b2d416a9120956d092fb09b.jpg"
      ],
      "image": "assets/images/17160/step_05.webp"
    },
    {
      "text": "Lightly grease a baking sheet. Deflate dough and turn it out onto a lightly floured surface. Roll marzipan into a rope and place in the center of the dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d8DSILMR_G1TLc8K-FEc7QGwl4g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17160-christmas-stollen-VAT-step-06-43be9bee7fcd4dc99326127437204c67.jpg"
      ],
      "image": "assets/images/17160/step_06.webp"
    },
    {
      "text": "Fold dough over to cover it; pinch the seams together to seal. Place the loaf, seam-side down, on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r1Y99cF_PQBHuFMhy7fab4a8v80=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17160-christmas-stollen-VAT-step-07-0238a84713674feaa6b2bdfc16cb1b92.jpg"
      ],
      "image": "assets/images/17160/step_07.webp"
    },
    {
      "text": "Cover with a damp cloth and let rise until doubled in volume, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g8DNk4rffG9jU91Ydu8hqZAs-7s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17160-christmas-stollen-VAT-step-08-42c0a528e9624166b7bf71ebb9f82c7b.jpg"
      ],
      "image": "assets/images/17160/step_08.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Bake stollen in the preheated oven for 10 minutes, then reduce heat to 300 degrees F (150 degrees C) and bake for a further 30 to 40 minutes, or until golden brown and the bottom of the loaf sounds hollow when tapped.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W3JSr_NKOm-piaqiHt8i_aP9WKg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17160-christmas-stollen-VAT-step-09-39e5fd5eec14405e809610fdc853f049.jpg"
      ],
      "image": "assets/images/17160/step_09.webp"
    },
    {
      "text": "Let cool on a wire rack, then dust with confectioners' sugar and sprinkle with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CHCMm6LN0i99l7JhNSCy4kwVq9I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17160-christmas-stollen-VAT-step-10-5ca0b10a6a8e433dbee792b284a902ce.jpg"
      ],
      "image": "assets/images/17160/step_10.webp"
    }
  ],
