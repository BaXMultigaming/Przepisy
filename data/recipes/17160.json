  "title": "Christmas Stollen",
  "description": "Stollen is a German yeasted bread baked with dried fruit and candied citron peel; a sweet marzipan filling makes it a special treat at Christmastime.",
  "authors": [
    "Lee Smith"
  ],
  "date_published": "2000-01-11T14:11:11-05:00",
