  "ingredients": [
    "cooking spray",
    "2 cups sourdough starter, at room temperature",
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "0.66666668653488 cup oil",
    "2 teaspoons baking powder",
    "1 scant teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "1 cup brown sugar",
    "0.25 cup butter, softened",
    "2 teaspoons ground cinnamon",
    "2 tablespoons melted butter, at room temperature",
    "2 tablespoons milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sourdough starter, flour, sugar, oil, baking powder, salt, and cinnamon in a bowl; beat with an electric mixer until smooth and thick. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, softened butter, and cinnamon in a bowl until evenly moistened. Sprinkle topping over the cake batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix melted butter, milk, and vanilla in a bowl with a fork until smooth. Drizzle glaze over the coffee cake while the cake is still hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
