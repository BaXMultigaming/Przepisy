  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "1 (15.25 ounce) can fruit cocktail, undrained",
    "1.5 cups flaked coconut, divided",
    "2 large eggs",
    "0.5 cup packed brown sugar",
    "0.5 cup chopped walnuts",
    "0.5 cup unsalted butter",
    "0.5 cup white sugar",
    "0.5 cup evaporated milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, undrained fruit cocktail, 1 cup coconut, and eggs in a large bowl. Beat with an electric mixer on medium speed for 2 minutes. Pour batter into the prepared pan, then sprinkle brown sugar and walnuts evenly over the surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When the cake is almost done, combine butter, white sugar, and evaporated milk in a saucepan; bring to a boil. Boil for 1 minute, then stir in remaining 1/2 cup coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon hot coconut mixture over warm cake.",
      "section": null,
      "name": null,
      "url": null,
