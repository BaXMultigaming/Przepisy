  "ingredients": [
    "2 cups broccoli",
    "2 cups cauliflower",
    "2 eggs",
    "1 cup shredded Cheddar cheese, divided",
    "0.5 cup mayonnaise",
    "0.5 cup chopped onion",
    "0.5 cup butter, melted",
    "1 (15 ounce) package seasoned croutons, crushed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place broccoli and cauliflower in separate saucepans, cover with water, and bring to a boil; cook until tender, 3 to 4 minutes. Drain and arrange in an 11x7-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zW3YCnA8d_WeLwZJDX8qLk9FfdQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234281-broccoli-cauliflower-casserole-ddmfs-Step1-1268-f8051ed8e6b246839cf27526df7d0afc.jpg"
      ],
      "image": "assets/images/234281/step_02.webp"
    },
    {
      "text": "Beat eggs in a bowl until creamy. Stir in 1/2 cup Cheddar cheese, mayonnaise, and onion; pour over vegetables. Pour melted butter on top and sprinkle with remaining 1/2 cup Cheddar cheese. Scatter crushed croutons evenly on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5ajlghxl1wx6q6RA-ixtORDqqTA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234281-broccoli-cauliflower-casserole-ddmfs-Step3-1274-f50bee2c534a450c97bb5f89cfbe238f.jpg"
      ],
      "image": "assets/images/234281/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until browned and bubbling, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tec6EZbpDHtJTfn8MzHsmzLXAGk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234281-broccoli-cauliflower-casserole-ddmfs-4X3-1313-103a06259d6344c996c112fc431c977d.jpg"
