  "ingredients": [
    "2 cups graham cracker crumbs",
    "0.66666668653488 cup chopped peanuts",
    "0.5 cup butter, melted",
    "1 (8 ounce) package cream cheese, softened",
    "0.33333334326744 cup peanut butter",
    "1 cup confectioners' sugar",
    "1 (16 ounce) package frozen whipped topping, thawed",
    "2 (3.9 ounce) packages instant chocolate pudding mix",
    "2.5 cups skim milk",
    "0.66666668653488 cup peanuts",
    "0.25 cup grated semisweet chocolate"
  ],
  "steps": [
    {
      "text": "Mix together graham cracker crumbs, chopped peanuts, and melted butter or margarine. Press into the bottom of a 9 x 13 inch pan. Bake at 350 degrees F (175 degrees C) for 8 to 10 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cream cheese, peanut butter, and confectioners' sugar until creamy. Fold in half of the nondairy whipped topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, combine pudding mixes with the skim milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the peanut butter mixture over the cooled crust. Spoon pudding over peanut butter layer, and spread remainder of the cool whip over pudding. Sprinkle with cocktail peanuts, and grated chocolate. Refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
