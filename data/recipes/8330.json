  "ingredients": [
    "2 cups white sugar",
    "2 cups all-purpose flour",
    "2 eggs",
    "0.5 cup chopped walnuts",
    "2 teaspoons baking soda",
    "2 teaspoons vanilla extract",
    "1 (20 ounce) can crushed pineapple with juice",
    "1 (8 ounce) package cream cheese",
    "1.75 cups confectioners' sugar",
    "0.5 cup chopped walnuts",
    "0.5 cup butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix flour, sugar, 1/2 cup nuts and baking soda. Add eggs, pineapple and 2 teaspoons vanilla . Beat until smooth and pour into 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 40 to 50 minutes. Spread icing on hot cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the icing: In a large bowl, cream butter or margarine, cream cheese, 1 teaspoon vanilla and confectioners sugar until light and fluffy. Fold in 1/2 cup nuts. Spread on hot cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
