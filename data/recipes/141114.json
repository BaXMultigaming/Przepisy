  "ingredients": [
    "1 cup vegetable oil",
    "1 cup all-purpose flour",
    "1 pound andouille or smoked sausage, sliced 1/4 inch thick",
    "2 celery stalks, chopped",
    "1 large green bell pepper, chopped",
    "1 large onion, chopped",
    "4 cloves garlic, minced",
    "salt and pepper to taste",
    "1 pinch Creole seasoning, or to taste",
    "6 cups chicken broth",
    "1 bay leaf",
    "1 rotisserie chicken, boned and shredded"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z4BWGf9w0tBVD4biqbZgJ4jdaGM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-141114-Cajun-Chicken-and-Sausage-Gumbo-ddmfs-4x3-ingredients-5535e32c647147cd9b161edbfbc37f2c.jpg"
      ],
      "image": "assets/images/141114/step_01.webp"
    },
    {
      "text": "Heat oil in a stockpot over medium heat; whisk in flour until roux is smooth and has cooked to the color of chocolate milk, about 8 to 10 minutes. Be careful not to burn the roux. If you see black specks in the mixture, it's best to start over.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BziofvAl0O-HI8Tx3_wGX_knZt8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-141114-Cajun-Chicken-and-Sausage-Gumbo-ddmfs-4x3-step-01-cc7edb7e3d0f48519a1f992175b61c43.jpg"
      ],
      "image": "assets/images/141114/step_02.webp"
    },
    {
      "text": "Add sausage, celery, bell pepper, and onion into the roux; cook and stir 5 minutes. Add garlic; continue to cook and stir another 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xPh8T2khwy7Y2m_jfPrlff0UGWc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-141114-Cajun-Chicken-and-Sausage-Gumbo-ddmfs-4x3-step-02-557fd6dd5bea4f019d78ec9ed4e9b599.jpg"
      ],
      "image": "assets/images/141114/step_03.webp"
    },
    {
      "text": "Season with salt, pepper, and Creole seasoning; stir well to blend. Pour in chicken broth and add bay leaf. Bring to a boil over high heat; reduce heat to medium-low and simmer, uncovered, for 1 hour, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aP9P8SDPW94MRwCS69_jFwlwd3o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-141114-Cajun-Chicken-and-Sausage-Gumbo-ddmfs-4x3-step-03-436b00b978f04e079ca18af36efb302f.jpg"
      ],
      "image": "assets/images/141114/step_04.webp"
    },
    {
      "text": "Stir in the chicken and simmer 1 hour more. Skim off any foam that floats to the top during this time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_wZmYRzjNSYWv-JWZQzpXS4Jb_4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-141114-Cajun-Chicken-and-Sausage-Gumbo-ddmfs-4x3-step-05-7e42f8efa592480f8d69e4356677f00e.jpg"
      ],
      "image": "assets/images/141114/step_05.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-An41tRUWfLeO5VcSlmHgy3uyVQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-141114-Cajun-Chicken-and-Sausage-Gumbo-ddmfs-4x3-beauty-0da2b06cb8e143d3919463aeb6b3495a.jpg"
      ],
      "image": "assets/images/141114/step_06.webp"
    }
