  "ingredients": [
    "1 medium sugar pumpkin",
    "1 tablespoon vegetable oil",
    "1 teaspoon salt",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground cinnamon",
    "4 eggs, lightly beaten",
    "1 cup honey, warmed slightly",
    "0.5 cup milk",
    "0.5 cup heavy whipping cream",
    "1 recipe pastry for a 9 inch single crust pie"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a jelly roll pan with aluminum foil; lightly oil the foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut pumpkin in half; remove seeds. Lightly oil cut surfaces; place cut-sides down on the prepared jelly roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until flesh is fork-tender, about 45 minutes. Cool until just warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase the oven temperature to 400 degrees F ( 205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrape out pumpkin flesh into a bowl; mash by hand or purée in small batches in a blender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pie dough into the bottom and up sides of a 9-inch pie plate; flute edges",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 cups pumpkin purée, salt, ginger, and cinnamon, in a large bowl; beat in eggs, honey, milk, and cream. Pour filling into pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted 1 inch from the edge of pie comes out clean, 50 to 55 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
