  "ingredients": [
    "4 skinless, boneless chicken breast halves - cut into strips",
    "2 eggs, beaten",
    "0.5 cup Parmesan cheese",
    "1 pinch salt",
    "1 pinch ground black pepper",
    "0.5 cup white wine",
    "4 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Season chicken with salt and pepper to taste. In a shallow plate, spread Parmesan cheese. Divide chicken into three parts and dip seasoned chicken in eggs, then coat well with Parmesan cheese. Repeat until all of the chicken pieces are well coated (if you run short on egg and Parmesan, add one more egg and more Parmesan as needed).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet, melt butter or margarine over medium high heat. Cook chicken, stirring frequently, until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat and add wine. Cover and simmer over low heat for 20 minutes",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
