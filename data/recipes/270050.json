  "ingredients": [
    "0.75 teaspoon salt",
    "0.5 teaspoon Italian seasoning",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon chili powder",
    "0.25 teaspoon garlic powder, divided",
    "0.125 teaspoon paprika",
    "0.125 teaspoon onion powder",
    "1.5 pounds pork chops",
    "2 tablespoons butter",
    "1 tablespoon olive oil",
    "3 tablespoons lime juice",
    "2 teaspoons garlic powder"
  ],
  "steps": [
    {
      "text": "Mix salt, Italian seasoning, black pepper, chili powder, 1/4 teaspoon garlic powder, paprika, and onion powder together in a bowl. Sprinkle spice mixture generously on both sides of pork chops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter and olive oil in a large, heavy skillet over medium heat. Cook pork until no longer pink in the center and golden brown on both sides, about 5 minutes per side. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C). Transfer pork chops to a serving plate, reserving juices in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add lime juice and remaining garlic powder to the same skillet and mix into leftover juices. Stir to combine and pour over the pork chops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
