  "title": "Germantown Cookies",
  "description": "Chewy buttery cookies with pecans, oats and coconut. These are flavored with vanilla and a hint of orange.",
  "authors": [
    "Kaddy"
  ],
  "date_published": "2020-06-18T23:07:45-04:00",
