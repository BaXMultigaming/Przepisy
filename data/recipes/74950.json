  "title": "My Amish Friend's Caramel Corn",
  "description": "This is the best caramel corn recipe! Popcorn and peanuts (or mixed nuts if desired) are tossed in a sugary coating for the tastiest treat ever.",
  "authors": [
    "ANITALOUISE"
  ],
  "date_published": "2004-08-04T23:20:51-04:00",
