  "ingredients": [
    "7 quarts plain popped popcorn",
    "2 cups dry roasted peanuts",
    "2 cups brown sugar",
    "1 cup margarine",
    "0.5 cup light corn syrup",
    "1 teaspoon salt",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Grease two rimmed baking sheets. Place 1/2 of the popped popcorn and 1/2 of the peanuts onto each prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SVPW6Jf6fqnMQVpIIPq0QBoz-ZY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74950-my-amish-friends-caramel-corn-VAT-step-01-0105b9c297534772bcedd7fdd93052f0.jpg"
      ],
      "image": "assets/images/74950/step_01.webp"
    },
    {
      "text": "Bring brown sugar, margarine, corn syrup, and salt to a boil in a saucepan over medium heat, stirring occasionally to blend. Once boiling, boil for 5 minutes, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KMyNSVHm9kdyn1SOsowoC_XtY4o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74950-my-amish-friends-caramel-corn-VAT-step-02-8b90843447404429ac2210137adef196.jpg"
      ],
      "image": "assets/images/74950/step_02.webp"
    },
    {
      "text": "Remove from the heat and stir in vanilla and baking soda; mixture will be light and foamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9Zn2Yq2T881Fcbt92xNnfTX3O1c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74950-my-amish-friends-caramel-corn-VAT-step-03-94a4dbb58b514857a2a085c043fb03bd.jpg"
      ],
      "image": "assets/images/74950/step_03.webp"
    },
    {
      "text": "Immediately pour hot liquid over popcorn and nuts. Stir until pretty well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SVPW6Jf6fqnMQVpIIPq0QBoz-ZY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74950-my-amish-friends-caramel-corn-VAT-step-01-0105b9c297534772bcedd7fdd93052f0.jpg"
      ],
      "image": "assets/images/74950/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 1 hour, removing the pans and giving them each a good stir every 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XYsVb94fe6lAJ31q4Wk4ffW6rRM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74950-my-amish-friends-caramel-corn-VAT-step-05-f5da40c3aa9f46589029d9fac05305ed.jpg"
      ],
      "image": "assets/images/74950/step_05.webp"
    },
    {
      "text": "Line your countertop with waxed paper. Remove popcorn and nuts from the oven; dump onto waxed paper and separate any large clumps. Allow to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eJMekF9P7CZ8BWfMkO3Mm03_jPk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74950-my-amish-friends-caramel-corn-VAT-step-06-c2f5bb1613d2413182bf174dd9b3ef6d.jpg"
      ],
      "image": "assets/images/74950/step_06.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aOqbWLm_Fz7osybsrGwoRYB0eYg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74950-my-amish-friends-caramel-corn-VAT-Beauty-4x3-ba1b595482e0453cb75c67ca3c174b97.jpg"
      ],
      "image": "assets/images/74950/step_07.webp"
    }
  ],
