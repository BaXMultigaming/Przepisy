  "ingredients": [
    "2.25 cups self-rising flour",
    "0.25 teaspoon baking soda",
    "0.5 cup butter-flavored shortening (such as Crisco®)",
    "1 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour and baking soda together in a large bowl. Cut in shortening with 2 knives or pastry blender until mixture resembles coarse crumbs, making a well in the center. Pour buttermilk into well; stir until a soft ball forms. Turn dough out onto a lightly floured surface and knead for 2 to 3 minutes. Roll dough out into a 1/2-inch thick rectangle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut out 12 biscuits with a biscuit cutter; transfer to a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are light brown and sides begin to darken, about 10 minutes. Cool biscuits completely on a wire rack, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
