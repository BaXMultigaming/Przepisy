  "ingredients": [
    "1 cup plain fat-free Greek yogurt, or to taste",
    "0.25 cup mayonnaise",
    "0.25 cup apple cider vinegar",
    "2 tablespoons Madras curry powder",
    "1 tablespoon honey",
    "0.5 teaspoon onion powder",
    "salt and ground black pepper to taste",
    "6 cups chopped broccoli",
    "1.25 cups dried currants",
    "0.5 cup roasted sunflower seeds"
  ],
  "steps": [
    {
      "text": "Whisk Greek yogurt, mayonnaise, vinegar, curry powder, honey, onion powder, salt, and pepper together in a bowl. Taste and adjust seasonings to your flavor preference.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine broccoli, currants, and sunflower seeds in a large resealable container. Add 1 to 1 1/2 cups dressing. Cover and shake to coat. Reserve remaining dressing for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill in the refrigerator for 3 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
