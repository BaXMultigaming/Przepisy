  "ingredients": [
    "1.5 cups whole wheat pastry flour",
    "2 tablespoons white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1.5 cups milk, room temperature",
    "0.33333334326744 cup virgin coconut oil, melted",
    "1 large egg, beaten",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to the manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking powder, and salt together in a bowl; make a well in the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk, coconut oil, egg, and vanilla extract together in another bowl. Pour into well in flour mixture; stir until batter is just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
