  "ingredients": [
    "2 tablespoons vegetable oil",
    "2 cloves garlic, minced",
    "1 pound ground pork",
    "1 pound fresh shrimp, peeled and deveined",
    "2 tablespoons soy sauce",
    "0.5 teaspoon white sugar",
    "5 green onions, chopped",
    "1 cup water, or as needed",
    "1 tablespoon cornstarch",
    "1 tablespoon cold water",
    "2 eggs, beaten"
  ],
  "steps": [
    {
      "text": "Heat the oil in a large skillet over medium heat. Add garlic, and cook for a few minutes, just until fragrant. Crumble in the pork; cook and stir until no longer pink, about 5 minutes. Add the shrimp; cook and stir until pink and opaque.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in the soy sauce, sugar and green onions. Pour in 2 cups of water, and bring to a boil. Simmer for 3 minutes. Stir together remaining water and cornstarch. Stir into the skillet gently and allow to simmer until thickened. Turn off the heat to ensure a smooth sauce. Stir in the eggs, and serve immediately over rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
