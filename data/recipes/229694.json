  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.75 cup white sugar",
    "2 teaspoons baking powder",
    "0.125 teaspoon salt",
    "0.5 cup milk",
    "0.25 cup vegetable oil",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1.5 cups blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a loaf pan. Mix flour, sugar, baking powder, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B1nIjCgiXloJOUFvSE2pYFBr8F8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229694-blueberry-loaf-mfs-step-1-157-03362473c0294a4a967a5eeaa8933432.jpg"
      ],
      "image": "assets/images/229694/step_01.webp"
    },
    {
      "text": "Stir milk, oil, egg, and vanilla extract into flour mixture until just blended; gently fold blueberries into batter and pour into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j6kFoYgUlhE9J-v194yA5ywUHO0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229694-blueberry-loaf-mfs-step-3-163-ed8a8bde4b5140fe99ce802bdbf15718.jpg"
      ],
      "image": "assets/images/229694/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 60 to 70 minutes. Cool briefly on a wire rack before inverting carefully onto a serving plate or cooling rack. Let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QNxgOVL4BQT0YX1sEYptE127Gz8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229694-blueberry-loaf-ddmfs-3x2-149-3102f88d13f34f7b958dca7f6b065e31.jpg"
