  "ingredients": [
    "2 rib-eye steaks, cut 1 1/2- inch thick",
    "0.5 cup reduced-sodium soy sauce",
    "0.25 cup olive oil",
    "4 teaspoons grill seasoning (such as Montreal Steak Seasoning®)"
  ],
  "steps": [
    {
      "text": "Combine steaks, soy sauce, olive oil, and seasoning in a large resealable bag. Marinate meat for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VWe3HQYCMFRcFuVWXANi9bOaXPE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/271044-AirFryerRibeyeSteak-ddmfs-Step1-0615-28600bd8f37d4529907b322f96f02028.jpg"
      ],
      "image": "assets/images/271044/step_01.webp"
    },
    {
      "text": "Remove steaks from the bag and discard marinade. Pat excess oil off steaks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XSH-0zNyIfI08IRtGWw3Qd8TwNg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/271044-AirFryerRibeyeSteak-ddmfs-Step2-0620-c840d84643714365961337377c7ae2b9.jpg"
      ],
      "image": "assets/images/271044/step_02.webp"
    },
    {
      "text": "Add about 1 tablespoon water to the bottom of the air fryer pan to prevent it from smoking during cooking. Preheat the air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dEdtooUuTI2clgfgrRIb4KaRtV4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/271044-AirFryerRibeyeSteak-ddmfs-Step3-0622-a79f8c994bed4060bced091568341c50.jpg"
      ],
      "image": "assets/images/271044/step_03.webp"
    },
    {
      "text": "Cook steaks in the preheated air fryer for 7 minutes, flip, and cook about 7 minutes more for medium-rare. For a medium, cook 8 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lpqLuimRXXQ4c_vcPSVAEdMDKDw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/271044-AirFryerRibeyeSteak-ddmfs-Step4-0630-bae6f14e5a42459b9dde889861a6f05a.jpg"
      ],
      "image": "assets/images/271044/step_04.webp"
    },
    {
      "text": "Let steaks sit for about 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZX_ShbW-QzdCNEA6c_3ykV8bj3Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/271044-AirFryerRibeyeSteak-ddmfs-Step5-0633-fc7e2f8b6fc245ff9b1f4d3caa40e4a3.jpg"
      ],
      "image": "assets/images/271044/step_05.webp"
    }
