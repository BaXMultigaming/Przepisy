  "ingredients": [
    "1.25 pounds lean ground turkey",
    "1 (28 ounce) can crushed tomatoes",
    "1 (16 ounce) can kidney beans, rinsed and drained",
    "1 (16 ounce) can pinto beans, rinsed and drained",
    "1 cup chicken stock",
    "1 small onion, chopped",
    "1 tablespoon hot sauce (such as Frank's® Redhot®), or more to taste",
    "1 tablespoon chili powder",
    "2 teaspoons salt",
    "1 teaspoon minced garlic",
    "0.5 teaspoon paprika",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon cayenne pepper, or more to taste",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Mix ground turkey, tomatoes, kidney beans, pinto beans, chicken stock, onion, hot sauce, chili powder, salt, minced garlic, paprika, oregano, cayenne pepper, cumin, and black pepper together in a slow cooker; stir to break the turkey into small chunks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low 6 to 8 hours (or High for 4 hours).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
