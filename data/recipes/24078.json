  "title": "Cheesy Spinach Lasagna",
  "description": "One of the easier lasagna recipes with cream cheese, Provolone and cottage cheese, bacon, spinach layered between lasagna noodles.",
  "authors": [
    "WIKSCOGG"
  ],
  "date_published": "2000-08-11T13:32:15-04:00",
