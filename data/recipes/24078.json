  "ingredients": [
    "1 (12 ounce) package lasagna noodles",
    "2 (8 ounce) packages cream cheese",
    "2 eggs",
    "2 cups shredded provolone cheese",
    "0.5 cup creamed cottage cheese",
    "6 slices bacon",
    "1 dash garlic powder",
    "2 (10 ounce) packages frozen chopped spinach"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add lasagna pasta and cook for 8 to 10 minutes or until al dente; drain and rinse with cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, crumble and set aside. Cook spinach according to directions; drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl beat the cream cheese on medium speed with electric mixer. Add eggs and beat until fluffy. Stir in provolone cheese, cottage cheese, bacon and garlic powder. Layer half of lasagna noodles in a greased baking dish. Spread with half of cheese mixture and half of the spinach. Top with the remaining lasagna noodles, spinach and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake in a preheated oven for 30 minutes or until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
