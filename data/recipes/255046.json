  "ingredients": [
    "1 cup almond butter",
    "1 cup packed brown sugar",
    "0.66666668653488 cup shortening",
    "0.33333334326744 cup vegan margarine",
    "1 overripe banana, mashed",
    "2.5 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 tablespoon water, or as needed",
    "3 ounces dark chocolate, chopped",
    "0.5 cup white sugar",
    "36 whole blanched almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix almond butter, brown sugar, shortening, and margarine together in a bowl until creamy. Stir in mashed banana.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, baking powder, and salt in a bowl. Stir into almond butter mixture. Stir in water if dough appears too thick. Fold in dark chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour white sugar onto a shallow dish. Form dough into 1-inch balls and roll in sugar. Arrange 2 inches apart on baking sheets; flatten with a fork. Top each cookie with an almond.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 10 minutes. Cool on the baking sheets for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
