  "ingredients": [
    "3 cups white sugar",
    "4 cups water",
    "0.25 cup instant coffee granules",
    "1 (750 milliliter) bottle vodka",
    "1 vanilla bean"
  ],
  "steps": [
    {
      "text": "In a saucepan, combine sugar, water and instant coffee. Bring to a boil, then let simmer gently for 1 hour. Remove from heat, and cool completely.",
      "section": null,
