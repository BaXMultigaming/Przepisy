  "ingredients": [
    "2.75 cups all-purpose flour",
    "1 tablespoon cornstarch",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1.5 cups brown sugar",
    "1 egg",
    "6 tart apples, grated, or more to taste",
    "1 tablespoon ground cinnamon",
    "1 teaspoon ground cloves",
    "1 cup butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cornstarch, baking soda, and baking powder together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar and egg together in a bowl; stir in apples, cinnamon, and cloves. Blend softened butter into the apple mixture with a fork. Slowly stir flower mixture into the apple mixture until combined. Spoon batter onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly brown, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
