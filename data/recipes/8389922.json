  "ingredients": [
    "2.25 cups water",
    "1 (15 ounce) can pumpkin puree",
    "1 cup packed brown sugar",
    "1 cup white sugar",
    "3 tablespoons pumpkin pie spice",
    "0.667 cup whole milk",
    "6 tablespoons hot brewed espresso",
    "2 tablespoons sweetened whipped cream",
    "1 pinch pumpkin pie spice, or to taste"
  ],
  "steps": [
    {
      "text": "Stir together water, pumpkin, brown and white sugars, and pumpkin pie spice in a medium saucepan. Bring to a boil; reduce heat. Simmer for 10 minutes, stirring occasionally, until slightly thickened. Remove from heat. Cool completely.",
      "section": null,
      "name": "To Make One Pumpkin Spiced Latte:",
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together milk and 3 tablespoons Pumpkin Spiced Latte Concentrate in a microwave-proof 12- to 16-ounce mug.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat in a microwave until hot, but not boiling, about 1 minute. Whisk until frothy. Pour hot espresso into milk mixture; stir gently. Top with whipped cream and a sprinkle of pumpkin pie spice. Makes a 10-ounce latte (1 1/4 cups).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
