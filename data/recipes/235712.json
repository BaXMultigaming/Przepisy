  "ingredients": [
    "0.25 cup fresh lime juice",
    "2 tablespoons honey",
    "1 teaspoon white sugar",
    "1 teaspoon Dijon mustard",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon ground cumin",
    "0.25 cup olive oil",
    "0.25 cup canola oil"
  ],
