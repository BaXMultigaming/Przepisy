  "ingredients": [
    "2 quarts vegetable oil for frying",
    "8 (4 ounce) fillets cod",
    "salt and pepper to taste",
    "1 cup all-purpose flour",
    "2 tablespoons garlic powder",
    "2 tablespoons paprika",
    "2 teaspoons salt",
    "2 teaspoons ground black pepper",
    "1 egg, beaten",
    "1 (12 fluid ounce) can or bottle beer, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_mkc1BeB7l0jtxcOXQtMKqwHPfM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20107-Beer-Batter-Fish-Made-Great-ddmfs-4x3-ingredients-aa30d7c6632341aaa2a9d9a592ddbec9.jpg"
      ],
      "image": "assets/images/20107/step_01.webp"
    },
    {
      "text": "Heat oil in a deep fryer to 365 degrees F (185 degrees C). Rinse cod fillets, pat dry, and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6y-k5BEyKgaUNZtK-v47fXN-H-0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20107-Beer-Batter-Fish-Made-Great-ddmfs-4x3-steps-02-1cf3133900f0464aaf2a01b71a2a2456.jpg"
      ],
      "image": "assets/images/20107/step_02.webp"
    },
    {
      "text": "Mix flour, garlic powder, paprika, salt, and pepper in a large bowl; add egg and stir well to combine. Gradually mix in enough beer to make a thin batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XY3XezsEsep7YDcLYEH2EYTfZeM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20107-Beer-Batter-Fish-Made-Great-ddmfs-4x3-steps-03-abbb880214fa4b9588fbe067f6925b5b.jpg"
      ],
      "image": "assets/images/20107/step_03.webp"
    },
    {
      "text": "Dip cod fillets into the batter to coat. Carefully lower fillets, one at a time, into the hot oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i6t4OB9lOAaW8zvEIxF0lKW496o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20107-Beer-Batter-Fish-Made-Great-ddmfs-4x3-steps-04a-4735c0d038a240a8b43fcf282124f20a.jpg"
      ],
      "image": "assets/images/20107/step_04.webp"
    },
    {
      "text": "Fry several fillets at a time, turning once, until cooked through and golden brown, about 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j-WvhQEc-a8t0nBtnaioj_Si7oU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20107-Beer-Batter-Fish-Made-Great-ddmfs-4x3-steps-05-2d83974c62c241d69b92fa6bef5fcb5b.jpg"
      ],
      "image": "assets/images/20107/step_05.webp"
    },
    {
      "text": "Drain on paper towels. Repeat to cook remaining fillets. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g0Ym8fi1Nc0Ofx4YjY_sb_oEL0I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20107-Beer-Batter-Fish-Made-Great-ddmfs-4x3-hero-ea96d87b5a134f83a28f4534c6e0d805.jpg"
      ],
      "image": "assets/images/20107/step_06.webp"
    }
