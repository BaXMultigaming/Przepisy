  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "nonstick cooking spray",
    "1 cup water",
    "1 chai tea bag",
    "0.5 cup unsweetened applesauce",
    "0.5 cup butter",
    "2 cups all-purpose flour",
    "1.75 cups white sugar",
    "0.5 cup light sour cream",
    "2 eggs",
    "1 teaspoon baking soda",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "0.5 cup butter",
    "0.25 cup milk",
    "4.5 cups confectioners' sugar",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 10x15-inch cake pan thoroughly with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water to a boil in a microwave-safe bowl in a microwave oven or in a pot on the stovetop. Remove from heat and add chai tea bag. Let steep for 10 minutes; remove bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chai tea, applesauce, and butter in a large saucepan. Bring to a boil. Remove from heat and add flour, sugar, sour cream, eggs, baking soda, vanilla extract, and salt and whisk until smooth. Pour batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until a toothpick inserted into the center comes out clean, 22 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cake from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and milk in a large saucepan. Bring to a light boil and remove from heat. Add confectioners' sugar, vanilla extract, and cinnamon; whisk icing until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour icing over warm cake and smooth across the surface. Let cool thoroughly before cutting into 24 pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
