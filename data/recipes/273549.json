  "title": "Texas Sheet Cake with Applesauce and Chai",
  "description": "Chai spices and applesauce star in this Texas sheet cake topped with a sugary cinnamon icing for a fall-inspired dessert that's delicious and easy to make.",
  "authors": [
    "Aimee"
  ],
  "date_published": "2020-06-19T00:37:10-04:00",
