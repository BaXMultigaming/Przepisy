  "ingredients": [
    "5 roma (plum) tomatoes, seeded and chopped",
    "10 green onions",
    "2 fresh jalapeno peppers, seeded",
    "0.25 cup chopped fresh cilantro",
    "2 tablespoons fresh lime juice",
    "2 tablespoons hot pepper sauce",
    "1 teaspoon ground black pepper",
    "1 teaspoon garlic powder",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Pulse tomatoes, green onions, jalapeño peppers, and cilantro in a blender or food processor to desired consistency. Transfer to a serving bowl. Mix in lime juice, hot pepper sauce, black pepper, garlic powder, and salt until well combined.",
