  "ingredients": [
    "3 tablespoons butter",
    "2 small onion, chopped",
    "2 apples - peeled, cored and finely chopped",
    "1 tablespoon curry powder",
    "3 tablespoons all-purpose flour",
    "1 cup hot chicken broth",
    "1 cup milk",
    "8 skinless, boneless chicken breasts",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet. Add onions and apples; sauté until tender. Stir in curry powder; sauté 1 minute. Stir in flour; cook 1 minute. Stir in stock and milk until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, season chicken breasts with salt and black pepper; arrange in a single layer in a 9x13-inch (or larger) baking dish. Pour curry sauce over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken cooked through, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
