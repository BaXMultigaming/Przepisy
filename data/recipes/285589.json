  "title": "Bavarian Pretzels",
  "description": "Chef John's bavarian pretzels come with a soft center and a beautifully browned, crusty exterior, bejeweled with crystals of salt.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2021-09-27T18:00:38-04:00",
  "date_modified": "2024-12-20T13:55:36-05:00",
  "prep_time": "PT45M",
