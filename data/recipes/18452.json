  "ingredients": [
    "1 (20 ounce) can crushed pineapple, drained",
    "1 cup white sugar",
    "2 tablespoons cornstarch",
    "0.25 cup cold water",
    "2 eggs",
    "1 tablespoon vanilla extract",
    "1 tablespoon butter",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x9 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, mix together the pineapple, sugar, cornstarch, water, eggs and vanilla. Pour the mixture into the prepared baking dish. Dot the mixture with butter and sprinkle with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 350 degrees F (175 degrees C) oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
