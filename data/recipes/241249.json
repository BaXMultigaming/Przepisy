  "ingredients": [
    "4 cups water",
    "15 whole cloves",
    "3 cinnamon sticks",
    "8 (1/4 inch thick) slices unpeeled fresh ginger",
    "15 cardamom pods, split",
    "15 whole black peppercorns",
    "10 black tea bags",
    "0.33333334326744 cup brown sugar",
    "2 teaspoons vanilla extract"
