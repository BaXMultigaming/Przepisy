  "ingredients": [
    "2 (1 pound) pork tenderloins",
    "1 teaspoon garlic powder",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 cup barbecue sauce, divided"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
