  "ingredients": [
    "1 cup graham cracker crumbs",
    "0.25 cup white sugar",
    "0.25 cup butter, melted",
    "1 tablespoon unflavored gelatin",
    "0.25 cup cold water",
    "1 cup heavy whipping cream",
    "0.5 cup chopped strawberries",
    "0.33333334326744 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs, ¼ cup sugar, and melted butter in a bowl until evenly moistened; press into the bottom and up the sides of a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly browned and smells toasted, about 12 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Soak gelatin in cold water for 3 minutes; transfer to the top of a double boiler set over simmering water. Cook and stir until gelatin is completely dissolved. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream in a chilled glass or metal bowl with an electric mixer until soft peaks form. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir strawberries and ⅓ cup sugar together in a bowl until evenly coated; pour gelatin mixture over strawberries. Gently fold in whipped cream until incorporated; pour filling into baked pie shell. Chill in the refrigerator until set, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
