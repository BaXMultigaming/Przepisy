  "ingredients": [
    "0.5 (8 ounce) container mascarpone cheese, at room temperature",
    "1 cup half-and-half",
    "0.25 cup espresso",
    "0.25 cup coffee-flavored liqueur (such as Kahlua®)",
    "2.5 tablespoons white sugar",
    "1 tablespoon cocoa powder",
    "0.75 teaspoon vanilla bean paste"
  ],
  "steps": [
    {
      "text": "Whisk mascarpone cheese, half-and-half, espresso, coffee-flavor liqueur, sugar, cocoa powder, and vanilla bean paste gently in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide mascarpone cheese mixture among ice pop molds. Cover and freeze until slightly firm, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Insert ice pop sticks 2/3 of the way into the molds. Freeze until firm, about 4 hours more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Run molds under warm water to release and pull out ice pops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
