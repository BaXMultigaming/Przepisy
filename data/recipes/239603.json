  "ingredients": [
    "1 tablespoon butter",
    "1 (1 ounce) square semisweet baking chocolate",
    "0.33333334326744 cup hot water",
    "1 cup white sugar",
    "2 tablespoons corn syrup",
    "0.5 teaspoon pure vanilla extract",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over low heat. Add chocolate to butter; cook and stir until chocolate melts completely into the butter and the color is consistent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly stream hot water into the chocolate mixture while stirring continually; add sugar and corn syrup. Continue to cook and stir until the sugar dissolves completely into the liquid, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove saucepan from heat and stir vanilla extract and salt into the sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
