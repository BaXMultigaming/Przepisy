  "ingredients": [
    "1.25 cups multigrain flour",
    "1 cup whole wheat flour",
    "0.25 cup sunflower seeds",
    "0.25 cup flax seeds",
    "0.25 cup wheat germ",
    "1 tablespoon white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "0.5 cup cold butter",
    "1 cup milk",
    "1 egg, lightly beaten",
    "0.25 cup sesame seeds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk multi-grain flour, wheat flour, sunflower seeds, flax seeds, wheat germ, sugar, baking powder, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grate cold butter into flour mixture using the largest holes of a cheese grater and mix with a fork until it resembles coarse crumbs. Slowly pour in milk and mix until dough begins to pull away from sides of the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a lightly floured surface and gently knead to form a soft dough, about 10 turns. Pat into an 8-inch square, cut into quarters, and cut each quarter into 3 rectangular pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place each piece of dough onto an ungreased baking sheet, about 1 inch apart; brush with egg and sprinkle with sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
