  "ingredients": [
    "4 (4 ounce) salmon fillets",
    "2 tablespoons olive oil",
    "4 ounces PHILADELPHIA Cream Cheese, cubed",
    "0.25 cup milk",
    "2 tablespoons pesto",
    "1 tablespoon finely chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor drill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush both sides salmon with oil. Cook on the preheated grill, skin-sides down, until easily flakes with a fork, 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, add cream cheese and milk to a saucepan; cook over medium heat until cream cheese completely melted and sauce well blended, stirring constantly, 2 to 3 minutes. Stir in pesto.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top salmon with sauce and parsley to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
