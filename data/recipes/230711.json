  "ingredients": [
    "2 cups all-purpose flour",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.75 cup unsalted butter at room temperature",
    "1 cup packed brown sugar",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "1 jumbo egg",
    "1 egg yolk",
    "2 tablespoons vanilla extract",
    "1.5 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk both amounts of flour, baking soda and salt in a bowl. Beat butter, brown sugar, and pudding mix in another bowl with an electric mixer until blended; beat in egg, egg yolk, and vanilla extract until combined. Stir flour mixture into egg mixture until just combined. Fold in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll the dough into 2-inch balls and place 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until golden brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
