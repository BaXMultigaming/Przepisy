  "ingredients": [
    "1 (16 ounce) package ziti pasta",
    "24 ounces ricotta cheese",
    "1 pound shredded mozzarella cheese",
    "1 egg, beaten",
    "1 (32 ounce) jar spaghetti sauce",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Add ziti pasta and cook for 8 to 10 minutes or until al dente; drain and rinse.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooked ziti, ricotta cheese, mozzarella cheese, egg, and 1 ½ cups spaghetti sauce in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6zr8SsrWP-Xtr2dOirmxMEsk4i4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18031-baked-ziti-ii-ddmfs-step1-0310-4x3-0c246d02d3ec4e23a3929a83aa1b0838.jpg"
      ],
      "image": "assets/images/18031/step_03.webp"
    },
    {
      "text": "Transfer into the prepared baking dish. Top with remaining spaghetti sauce, then sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_QtxCbhG4TN1_O0ZX9-QkoIXgLs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18031-baked-ziti-ii-ddmfs-step3-0313-4x3-4da28a371c024989b70fa684422efc78.jpg"
      ],
      "image": "assets/images/18031/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 30 minutes; let stand for 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oXuLKPsb-Wa_LolmP3JpVl7q2ow=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18031-baked-ziti-ii-DDMFS-4x3-45e614088a504a67b9a9dde7001be4ee.jpg"
      ],
      "image": "assets/images/18031/step_05.webp"
    }
