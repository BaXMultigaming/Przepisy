  "ingredients": [
    "3 cups Southern-style hash brown potatoes, thawed",
    "6 tablespoons butter, melted",
    "0.5 cup heavy cream",
    "3 large eggs",
    "1 pinch cayenne pepper",
    "salt and ground black pepper to taste",
    "1 medium roasted red pepper, diced",
    "5 slices precooked bacon, chopped",
    "0.5 (3 ounce) andouille sausage, diced",
    "0.5 cup shredded smoked Gouda cheese",
    "0.5 cup shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix hash brown potatoes and melted butter together in a bowl. Press mixture into a 9-inch glass pie pan to form a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cream, eggs, cayenne, salt, and pepper together in a bowl; let warm up to room temperature while the crust cooks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove crust from the oven and lower heat to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add red pepper, bacon, and sausage to the cooled crust. Sprinkle Gouda and Cheddar cheeses over top, then pour in egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cool a bit before serving, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
