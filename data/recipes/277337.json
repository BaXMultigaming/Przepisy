  "ingredients": [
    "cooking spray",
    "2.5 cups fresh cranberries",
    "1.25 cups white sugar, divided",
    "1 cup all-purpose flour",
    "0.75 cup butter, melted",
    "2 large eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Spray an 8-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cranberries into the prepared baking dish and sprinkle with 1/4 cup sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together remaining 1 cup sugar, flour, and melted butter in a large bowl. Whisk eggs in a separate bowl, then stir into sugar-flour mixture until smooth. Pour over cranberries in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until berries are bubbling and topping is lightly browned, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
