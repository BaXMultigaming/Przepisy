  "ingredients": [
    "2 cups water",
    "2 cups peeled and diced potatoes",
    "0.5 cup diced carrots",
    "0.5 cup chopped celery",
    "0.25 cup chopped onions",
    "1.5 teaspoons salt",
    "0.25 teaspoon ground black pepper",
    "1 cup cooked ham, cubed",
    "0.25 cup butter",
    "0.25 cup all-purpose flour",
    "2 cups milk",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "In a large saucepan, mix the water, potatoes, carrots, celery, onions, salt and pepper. Bring to boil. Reduce heat and simmer 30 minutes, or until vegetables are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the ham into the vegetable mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan, melt the butter. Stir in the flour until smooth. Slowly pour in the milk. Bring to a boil. Cook and stir 2 minutes, or until thickened. Stir in the Cheddar cheese until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the melted cheese mixture with the vegetable mixture and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
