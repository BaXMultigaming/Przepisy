  "ingredients": [
    "0.5 cup butter",
    "1 cup white sugar",
    "0.75 cup self-rising flour",
    "0.75 cup milk",
    "1 (29 ounce) can sliced peaches in light syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place butter in a deep 2-quart baking dish and place in oven to melt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar and flour in a medium bowl. Stir in milk, a little at a time, until fully incorporated. Pour carefully over melted butter in the dish. Spoon peaches and syrup over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is puffed and golden, about 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
