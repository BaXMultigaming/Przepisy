  "ingredients": [
    "1 cup milk",
    "1 cup water",
    "1 large strip of orange peel",
    "3 whole cloves",
    "1 (3 inch) cinnamon stick",
    "3 whole black peppercorns",
    "1 pinch ground nutmeg",
    "4 teaspoons white sugar",
    "2 teaspoons black tea leaves"
  ],
  "steps": [
    {
      "text": "Combine the milk and water in a saucepan over medium-high heat. Once this mixture has warmed, place the orange peel, cloves, cinnamon stick, peppercorns, nutmeg, sugar and tea leaves into the pan. Bring to a boil, then reduce heat to medium-low, and simmer until the color deepens to your liking. Strain out spices, and pour into cups.",
