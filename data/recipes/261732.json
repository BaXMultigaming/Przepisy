  "ingredients": [
    "cooking spray",
    "1.5 cups soy milk, divided",
    "0.66666668653488 cup white sugar",
    "0.5 cup vegetable shortening",
    "1 teaspoon salt",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1.25 cups cornmeal",
    "1 tablespoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a 9x5-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1/2 cup soy milk, sugar, vegetable shortening, salt, and vanilla extract together in a large bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, cornmeal, and baking powder together in a bowl. Stir flour mixture into sugar mixture, alternating with the remaining 1 cup soy milk. Beat until well blended. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
