  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup unsalted butter, softened",
    "0.75 cup white sugar",
    "0.75 cup brown sugar",
    "2 large eggs",
    "1 tablespoon vanilla extract",
    "2 cups white chocolate chips",
    "1 cup toffee baking bits",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, cocoa powder, baking soda, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together butter, white sugar, and brown sugar. Mix in eggs and vanilla. Mix in sifted dry ingredients, then stir in white chocolate chips, toffee bits, and chopped pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoonfuls of dough 2 inches apart onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 10 minutes. Cool on the baking sheet for briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Repeat Steps 4 and 5 to bake remaining batches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
