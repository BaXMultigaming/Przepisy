    {
      "text": "Toss chicken with 1 tablespoon cornstarch in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QW_DZPLixWfTAhSuExPEQ1IfAE4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9025-bourbon-chicken-ddmfs-step2-3x4-1225-e9445bc0da724418bdc9061cc16fcb69.jpg"
      ],
      "image": "assets/images/9025/step_02.webp"
    },
    {
      "text": "Heat 1 tablespoon oil in a 12-inch skillet over medium-high heat. Add chicken; cook and stir until browned. Transfer to a plate using a slotted spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MGQHjOA--5Pr646zM5Bd4AXloHE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9025-bourbon-chicken-ddmfs-step3-3x4-1243-3c3dd38e37244f4ca33ea5852455bca1.jpg"
      ],
      "image": "assets/images/9025/step_03.webp"
    },
    {
      "text": "Heat remaining 1 tablespoon oil in the same skillet. Add onion, garlic, and ginger; cook and stir until softened and fragrant, 1 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-MXtKZx-_UeXuh9pCmPhl1lbj2Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9025-bourbon-chicken-ddmfs-step5-3x4-1252-c1e47178d552482f828103fd3936488a.jpg"
      ],
      "image": "assets/images/9025/step_04.webp"
    },
    {
      "text": "Whisk remaining 1 tablespoon cornstarch, soy sauce, chicken broth, bourbon, brown sugar, vinegar, and pepper flakes together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OHQG_RafvWpz6z3dhbt6uP2lrP8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9025-bourbon-chicken-ddmfs-step6-3x4-1254-4742c1f1c24345a3ac9b80c30f76e7d0.jpg"
      ],
      "image": "assets/images/9025/step_05.webp"
    },
    {
      "text": "Add soy sauce mixture to the skillet; cook and stir until thickened and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B4c2fScir6IT4gRTK3Q9OWL4Cq0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9025-bourbon-chicken-ddmfs-step7-3x4-1263-ed62f3b72ab04131803b84d30d3166ee.jpg"
      ],
      "image": "assets/images/9025/step_06.webp"
    },
    {
      "text": "Return chicken to the skillet; cook and stir until coated in sauce and heated through, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dbojlsUPT0UiikGz2pkNQMYoBMM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9025-bourbon-chicken-ddmfs-step8-3x4-1266-021f02397d404a55abd17273c6906d64.jpg"
