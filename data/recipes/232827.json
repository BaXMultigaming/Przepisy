  "ingredients": [
    "2.5 pounds red potatoes, quartered",
    "1 cup mayonnaise",
    "1 cup petite green peas",
    "5 hard-boiled eggs, chopped",
    "4 slices cooked bacon, chopped",
    "0.25 cup minced onion",
    "2 tablespoons mustard",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 10 minutes. Drain and set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix potatoes, mayonnaise, peas, eggs, bacon, onion, mustard, salt, and pepper together in a bowl. Refrigerate to allow flavors to blend and bacon to soften, about 1 hour.",
