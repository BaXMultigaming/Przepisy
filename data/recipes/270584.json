  "ingredients": [
    "cooking spray",
    "1.75 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon pumpkin pie spice",
    "0.5 teaspoon salt",
    "0.33333334326744 cup white sugar",
    "0.33333334326744 cup avocado oil",
    "3 tablespoons aquafaba (chickpea water)",
    "0.5 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup vegan margarine (such as Earth Balance®), melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, pumpkin pie spice, and salt together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, avocado oil, and aquafaba together in a bowl until sugar is dissolved. Pour in flour mixture; mix until evenly incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared tin, filling each cup halfway full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and cinnamon in a shallow dish to make the topping. Remove hot muffins from the tin and dip in melted margarine; roll in cinnamon sugar to coat. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
