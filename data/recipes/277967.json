  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C) with a pizza stone or inverted sheet tray on the middle rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow dough to come to room temperature, covered, on the counter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly dust a pizza peel or inverted sheet tray with cornmeal. Roll dough into a 16-inch circle on top. Top dough with marinara sauce, mozzarella, Gouda, Jarlsberg, Parmesan, and basil. Transfer pizza directly on to the preheated stone.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until preferred level of browning is attained, 14 to 16 minutes. Let rest for 5 minutes before slicing into 6 slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
