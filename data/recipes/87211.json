  "ingredients": [
    "1 focaccia bread, quartered",
    "0.5 cup prepared basil pesto",
    "1 cup diced cooked chicken",
    "0.5 cup diced green bell pepper",
    "0.25 cup diced red onion",
    "1 cup shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat a panini grill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice each quarter of focaccia bread in half horizontally. Spread each half with pesto. Layer bottom halves with equal amounts chicken, bell pepper, onion, and cheese. Top with remaining focaccia halves, forming 4 sandwiches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill paninis 5 minutes in the preheated grill, or until focaccia bread is golden brown and cheese is melted.",
