  "steps": [
    {
      "text": "Coat a large skillet with cooking spray and place over medium heat. Fry ham in skillet until browned and heated through, 5 to 6 minutes per side. Drain any excess grease. Add salsa, apricot nectar, apricot preserves, brown sugar, and taco seasoning to skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low and cover skillet. Simmer until sauce is hot and bubbly, turning ham steak once, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer ham steak to a platter and cover with sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
