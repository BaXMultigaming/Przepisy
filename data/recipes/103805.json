  "ingredients": [
    "1.25 cups chopped mixed dried fruit",
    "1.25 cups golden raisins",
    "1 cup water",
    "1 cup margarine",
    "0.75 cup white sugar",
    "1 tablespoon mixed spice",
    "1 tablespoon cinnamon",
    "2 cups all-purpose flour",
    "2 eggs, beaten",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Combine mixed fruit, golden raisins, water, margarine, sugar, mixed spice, and cinnamon in a large saucepan. Bring to a boil, simmer for 1 minute, and remove from heat. Stir in flour, beaten eggs, and baking soda until well combined; pour mixture into a microwave-safe bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook, uncovered, in the microwave on high for 10 minutes. Let pudding stand for 5 minutes before serving.",
      "section": null,
