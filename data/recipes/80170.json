  "ingredients": [
    "11 ounces ground almonds",
    "3 egg whites",
    "1 cup confectioners' sugar",
    "1 teaspoon grated lemon zest",
    "0.75 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and lightly flour cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whip egg whites until soft peaks form. Gradually sprinkle in the sugar and keep whipping until the egg whites can hold a stiff peak, this will take about 5 minutes. Set aside about 1/2 cup of the egg whites. Add the lemon zest and cinnamon to the rest of the meringue, and fold in the almonds until everything is evenly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop mounds by spoonfuls onto the prepared baking sheets. Top each cookie with a smaller dollop of the reserved meringue.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 minutes in the preheated oven, until golden brown. Remove cookies from the baking sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
