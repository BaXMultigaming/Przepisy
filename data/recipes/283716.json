  "ingredients": [
    "2 cups buttermilk",
    "1.5 cups sour cream",
    "1 cup mayonnaise",
    "0.75 cup shredded Parmesan cheese",
    "3 tablespoons white vinegar",
    "1 tablespoon garlic salt",
    "1 tablespoon chopped fresh parsley",
    "1.5 teaspoons ground black pepper"
  ],
  "steps": [
    {
      "text": "Whisk buttermilk, sour cream, mayonnaise, Parmesan cheese, vinegar, garlic salt, parsley, and pepper together in a bowl until combined; some chunks are expected.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a large mason jar and chill until flavors are blended, at least 3 hours.",
