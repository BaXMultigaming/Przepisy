  "ingredients": [
    "6 fresh figs",
    "2 tablespoons mini semi-sweet chocolate chips",
    "0.25 cup blanched slivered almonds",
    "0.5 fluid ounce orange liqueur"
  ],
  "steps": [
    {
      "text": "Preheat your oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each fig in half. (If you cannot find fresh figs and would like to use dried figs, cut a little opening in the top of the fig and make a pocket for the stuffing.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small mixing bowl, combine chocolate chips, almonds, and wine. Spoon about 2 teaspoons of the stuffing mixture into each fig half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on a cookie sheet for 10 minutes.",
      "section": null,
      "name": null,
