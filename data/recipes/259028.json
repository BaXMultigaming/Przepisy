  "ingredients": [
    "0.5 small watermelon, cubed",
    "0.5 red onion, sliced",
    "0.5 cup chopped black olives",
    "0.25 cup crumbled feta cheese",
    "2 tablespoons lime juice",
    "4 leaves mint, thinly sliced, or more to taste",
    "salt and ground black pepper to taste",
    "0.25 cup olive oil"
  ],
  "steps": [
    {
      "text": "Combine watermelon, red onion, olives, and feta cheese in a large bowl.",
      "section": null,
