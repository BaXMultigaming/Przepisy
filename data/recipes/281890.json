  "ingredients": [
    "1 (12 ounce) package fresh cranberries",
    "1.25 cups white sugar",
    "0.25 cup chopped green onion",
    "0.25 cup chopped fresh cilantro",
    "2 tablespoons lemon juice",
    "1 small jalapeno pepper, seeded and minced",
    "0.25 teaspoon ground cumin",
    "1 pinch salt",
    "2 (8 ounce) packages cream cheese"
  ],
  "steps": [
    {
      "text": "Place cranberries in the bowl of a food processor; pulse to chop (or chop by hand); transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, green onion, cilantro, lemon juice, jalapeño, cumin, and salt into cranberries to combine. Cover the bowl with plastic wrap; refrigerate until cranberries have lost some bitter taste, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cream cheese bricks on a plate; top with cranberry salsa. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
