  "ingredients": [
    "1 cup warm water (110 degrees F/45 degrees C)",
    "1 tablespoon white sugar",
    "1 tablespoon brown sugar",
    "2 tablespoons honey",
    "1 teaspoon salt",
    "3 tablespoons crunchy peanut butter",
    "1 tablespoon vegetable oil",
    "1 egg",
    "3 cups bread flour",
    "1.5 teaspoons active dry yeast"
  ],
  "steps": [
    {
      "text": "Place ingredients in bread machine pan in the order suggested by the manufacturer. Select white bread setting. Start.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To bake bread in oven: select dough or manual cycle. Once cycle is complete, shape dough and place in a greased loaf pan. Allow to rise in a warm spot until doubled in size. Bake in a preheated 350 degrees F (175 degrees C) oven for 35 to 45 minutes or until a thermometer inserted in the center of the loaf reads 200 degrees F (95 degrees C).",
