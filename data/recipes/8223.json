  "ingredients": [
    "2.5 cups all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1.5 cups packed brown sugar",
    "0.66666668653488 cup vegetable oil",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "1 cup milk",
    "1.5 cups rhubarb, chopped",
    "0.5 cup sliced almonds",
    "0.33333334326744 cup white sugar",
    "1 tablespoon butter, melted",
    "0.25 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9-inch round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, salt, and baking soda together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, oil, egg, and vanilla with an electric mixer in a large bowl until smooth. Add flour mixture and milk, alternately, until combined. Stir in rhubarb and 1/2 cup almonds until incorporated. Pour into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix white sugar and melted butter together with a fork in a small bowl; stir in 1/4 cup almonds, then sprinkle over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
