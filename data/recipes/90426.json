  "ingredients": [
    "1 (16 ounce) package small uncooked seashell pasta",
    "1.5 cups mayonnaise",
    "0.5 cup milk",
    "2 tablespoons pickle juice",
    "2 teaspoons dried dill weed",
    "1 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "2 (5 ounce) cans tuna packed in water, drained",
    "0.5 cup chopped onion"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil: add pasta. Cook until al dente, 8 to 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, milk, pickle juice, dill, salt, and pepper together in a large bowl. Mix in tuna and onion: toss with cooked pasta. Cover and refrigerate 1 to 2 hours before serving.",
