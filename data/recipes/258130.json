  "title": "Ginger Cookies with Orange Glaze",
  "description": "These deliciously soft, chewy ginger cookies drizzled with an orange glaze are great for bake sales because they hold their shape well.",
  "authors": [
    "racahoon"
  ],
  "date_published": "2020-03-05T00:16:23-05:00",
