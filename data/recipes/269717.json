  "ingredients": [
    "2 (10.5 ounce) cans condensed cream of chicken soup",
    "1.5 cups chopped carrots",
    "1.5 cups chopped celery",
    "1 medium yellow onion, chopped",
    "1 cup chicken stock",
    "0.25 cup chopped fresh parsley",
    "1 teaspoon paprika",
    "1 teaspoon dried oregano",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "2 pounds skinless, boneless chicken breasts",
    "1.5 cups frozen peas",
    "1.5 cups frozen corn"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o6wht41vXY9CeVbVNaqkAiT7X54=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269717-slow-cooker-chicken-pot-pie-DDMFS-step01-ac9e1975b2af4443a6cdc25793ba1de2.jpg"
      ],
      "image": "assets/images/269717/step_01.webp"
    },
    {
      "text": "Stir condensed soup, carrots, celery, onion, chicken stock, parsley, paprika, oregano, salt, and pepper together in a slow cooker until well combined; mixture will be thick. Nestle chicken breasts into the mixture and spoon some over to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TVcimhr7YIo-YJmZ2WQjt9KSGxI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269717-slow-cooker-chicken-pot-pie-DDMFS-step02-dc390a5c52714a038ba59c759fe5c032.jpg"
      ],
      "image": "assets/images/269717/step_02.webp"
    },
    {
      "text": "Cook on Low for 7 1/2 hours. Remove chicken from the slow cooker and shred using two forks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DV7B-KhZKFZQWTr7GElF2ZdTWI0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269717-slow-cooker-chicken-pot-pie-DDMFS-step03-29065e4e89da4f408510771d47059fc0.jpg"
      ],
      "image": "assets/images/269717/step_03.webp"
    },
    {
      "text": "Return shredded chicken to the slow cooker with frozen peas and corn. Continue cooking on Low until vegetables are hot, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kGK3sz7B_aMKdJ2-G3SO9qPAUYE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/269717-slow-cooker-chicken-pot-pie-DDMFS-step04-ce88e42a3d704d629fd0926c91c21355.jpg"
      ],
      "image": "assets/images/269717/step_04.webp"
    }
