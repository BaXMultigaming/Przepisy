  "ingredients": [
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon baking soda",
    "0.33333334326744 cup all-purpose flour",
    "2 tablespoons butter",
    "0.25 teaspoon salt",
    "1 cup chopped walnuts",
    "1 cup packed brown sugar",
    "0.33333334326744 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and vanilla together in mixing bowl. Add in brown sugar, flour, baking soda, salt and walnuts. Mix until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butter in a 9-inch square pan. Pour the batter into the pan and bake for 20 to 25 minutes, until firm to the touch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While bars are still hot, loosen with a spatula and turn out onto wax paper, buttered side up. Dust with confectioners' sugar while warm and cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
