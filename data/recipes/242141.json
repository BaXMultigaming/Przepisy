  "ingredients": [
    "1 (12 ounce) package rigatoni pasta",
    "1 cup fat-free milk",
    "1 ounce crumbled blue cheese",
    "1 (8 ounce) package 1/3-less-fat cream cheese, softened",
    "0.5 cup Buffalo wing sauce",
    "1 teaspoon garlic powder",
    "1 teaspoon paprika",
    "0.25 teaspoon freshly ground black pepper",
    "3 cups chopped cooked chicken breast"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil. Cook rigatoni in the boiling water, stirring occasionally until tender yet firm to the bite, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine milk, blue cheese, and cream cheese in a large skillet over medium-high heat. Cook, stirring frequently, until cheeses melt, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta into a colander; reserve about 1/4 cup cooking liquid and pour into the sauce. Add Buffalo sauce, garlic powder, paprika, and black pepper and stir until smooth. Mix in the pasta and chicken and heat until chicken is warmed through, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
