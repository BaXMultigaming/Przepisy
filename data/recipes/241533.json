  "ingredients": [
    "1 tablespoon olive oil",
    "1 medium onion, diced",
    "3 cups Hillshire Farm® Smoked Sausage, sliced into 1-inch rounds",
    "1 (19 ounce) can chickpeas",
    "1 large sweet potato, diced",
    "3 cloves garlic, minced",
    "1 teaspoon paprika, sweet or smoked",
    "1 teaspoon ground chipotle pepper",
    "0.5 teaspoon ground coriander",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon salt, or to taste",
    "6 cups low-sodium chicken stock",
    "4 cups kale (or spinach)",
    "1 teaspoon Crumbled feta cheese or goat cheese",
    "1 teaspoon Freshly ground black pepper, for garnish"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large pot over medium heat. Add onion; cook until onion releases some moisture, about 5 minutes. Stir in sausage, chickpeas, sweet potato, and garlic; season with paprika, chipotle powder, coriander, cumin, and salt. Cook, stirring occasionally, for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add stock to the pot; bring to a simmer. Cook until sweet potato has softened, 10 to 15 minutes. Stir in kale; cook until wilted, about 1 minute. Top servings with cheese and freshly ground black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
