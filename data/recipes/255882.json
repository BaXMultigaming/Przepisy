  "ingredients": [
    "1.5 cups Quaker® Oats (Quick or Old Fashioned, uncooked)",
    "1 cup all-purpose flour",
    "0.5 cup firmly packed brown sugar",
    "0.5 teaspoon baking soda",
    "10 tablespoons butter or margarine, melted",
    "1 (21 ounce) can apple pie filling",
    "0.75 cup dried cranberries",
    "1.5 teaspoons lemon juice",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Heat oven to 375 degrees F. Lightly spray 8- or 9-inch glass pie plate with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In medium bowl, combine oats, flour, brown sugar and baking soda. Add melted butter; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set aside 3/4 cup oat mixture for topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press remaining oat mixture firmly onto bottom and sides of pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 10 to 12 minutes or until light golden brown. Cool slightly on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using same bowl, stir together pie filling, cranberries, lemon juice and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon filling over hot crust, spreading evenly. Sprinkle reserved oat topping evenly over filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 18 to 22 minutes or until topping is golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
