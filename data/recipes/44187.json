  "ingredients": [
    "1 (12 fluid ounce) can evaporated milk",
    "2 large egg yolks, beaten",
    "1 (14 ounce) can cream of coconut",
    "1 (14 ounce) can sweetened condensed milk",
    "0.5 cup white rum",
    "0.5 cup water",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Combine evaporated milk and egg yolks in the top of a double boiler over simmering water. Cook over medium heat, stirring constantly, until mixture coats the back of a spoon and reaches a temperature of 160 degrees F (71 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yOhZCMW1mzXPHYuUsUWxVKpzeEg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/44187-coquito-step-02-4x3-f357776336444c788583174ca9762376.jpg"
      ],
      "image": "assets/images/44187/step_01.webp"
    },
    {
      "text": "Transfer mixture to a blender. Add cream of coconut, sweetened condensed milk, rum, water, vanilla, cinnamon, and cloves; blend until well combined, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pG1fnFU9hJTVQ-EmUCfa0Ap9fMs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/44187-coquito-step-04-2-4x3-bb809489e5104bb489be3f5e1e20f5c8.jpg"
      ],
      "image": "assets/images/44187/step_02.webp"
    },
    {
      "text": "Pour into a sterilized glass bottle and refrigerate. Serve over ice, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J5Xqu5mA4P2Q68aThs74VJlQ30A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/44187-coquito-vat-4X3-1-8bf148c0ff1a4a5b88660a66c28aa05d.jpg"
      ],
      "image": "assets/images/44187/step_03.webp"
    }
