  "ingredients": [
    "2 cups white sugar",
    "0.75 cup butter",
    "0.66666668653488 cup milk",
    "1 (3.4 ounce) package instant pumpkin-spice pudding mix",
    "3.5 cups quick-cooking oats",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine sugar, butter, and milk in a large saucepan over medium heat; bring to a boil and cook for 2 minutes. Stir in pudding mix, then stir in oats and vanilla extract; cool for 5 minutes.",
