  "ingredients": [
    "0.25 cup butter",
    "4 large carrots, cut into 3-inch x 1/2-inch pieces",
    "4 large parsnips, cut into 3-inch x 1/2-inch pieces",
    "0.75 cup orange juice",
    "0.75 cup chicken stock",
    "2 tablespoons lemon juice",
    "salt and ground black pepper to taste",
    "3 tablespoons chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir carrots and parsnips in melted butter until lightly browned on edges, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir orange juice, chicken stock, lemon juice, salt, and black pepper into carrots and parsnips. Bring to a boil, reduce heat to low, and cover. Simmer until liquid reduces to a syrup, about 10 minutes. Stir often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with more salt and black pepper if needed; sprinkle with chives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
