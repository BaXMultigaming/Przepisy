  "ingredients": [
    "3 cups water",
    "1 (.7 ounce) package dry Italian-style salad dressing mix",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil",
    "1 teaspoon dried parsley",
    "1 teaspoon onion salt",
    "1 teaspoon garlic powder",
    "1 bay leaf",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 (5 pound) rump roast"
  ],
  "steps": [
    {
      "text": "Combine water, salad dressing mix, oregano, basil, parsley, onion salt, garlic powder, bay leaf, salt, and black pepper in a saucepan. Stir well, and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0MbcUlVwGO3tB1f9GQEo4edYENM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16427-slow-cooker-italian-beef-Step-01-6842b4f2e0124acb980117e1edf97736.jpg"
      ],
      "image": "assets/images/16427/step_01.webp"
    },
    {
      "text": "Place rump roast in a slow cooker; pour hot herb mixture over the meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k32VMo6p68HdLSdTewhyi0N0W3Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16427-slow-cooker-italian-beef-Step-03-6677c85b09ff4e3da971dcea0388d154.jpg"
      ],
      "image": "assets/images/16427/step_02.webp"
    },
    {
      "text": "Cover and cook on Low for 10 to 12 hours, or on High for 4 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fZ_GVWZAE0Z7ys597WZ7z3A0k7A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16427-slow-cooker-italian-beef-Step-05-4d060cea6b464b87a73c042d2e1db60a.jpg"
      ],
      "image": "assets/images/16427/step_03.webp"
    },
    {
      "text": "Remove bay leaf; shred beef with a fork and serve with some of the hot gravy.",
