  "ingredients": [
    "2 cups frozen green peas",
    "2 tablespoons butter",
    "1 cup sliced fresh mushrooms",
    "1 small chopped onion",
    "1 tablespoon all-purpose flour",
    "1 cup light cream",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Fill a small saucepan with 1 inch of water. Bring to a boil, add peas, and cook until tender, about 5 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a medium saucepan over medium heat. Add mushrooms and onions, and cook for a few minutes, or until tender. Sprinkle flour over mushrooms, and cook for 1 minute, constantly stirring. Gradually stir in cream and season with salt, pepper, and nutmeg. Cook, stirring until smooth and thick. Stir in peas, and remove from heat. Let stand for a few minutes before serving.",
      "section": null,
