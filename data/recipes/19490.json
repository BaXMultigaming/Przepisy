  "ingredients": [
    "2 tablespoons olive oil",
    "6 green onions, chopped",
    "1 (16 ounce) can canned crabmeat, drained",
    "8 ounces buttery round crackers, crushed",
    "1 egg",
    "1 tablespoon mayonnaise",
    "1 teaspoon dry mustard",
    "1 teaspoon garlic powder",
    "0.5 teaspoon ground cayenne pepper",
    "0.25 teaspoon Old Bay Seasoning TM",
    "salt to taste",
    "1 cup panko (Japanese bread crumbs) or regular dry bread crumbs",
    "0.5 cup olive oil, or as needed"
  ],
  "steps": [
    {
      "text": "Heat 2 tablespoons olive oil in a large skillet over high heat. Sauté green onions in hot oil until tender; set aside to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine crabmeat, sautéed green onions, crushed crackers, egg, mayonnaise, dry mustard, garlic powder, cayenne pepper, garlic powder, Old Bay seasoning, salt, and pepper. Form into ten 1/2-inch-thick patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread crumbs in a shallow bowl. Press patties in bread crumbs to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1/2 cup olive oil in a large skillet over medium-high heat. Cook patties in hot oil until golden brown on each side. Drain briefly on a paper towel-lined plate and serve hot.",
      "section": null,
      "name": null,
      "url": null,
