      "image_sources": [
        "https://www.allrecipes.com/thmb/1tAbxm1KqZ7Bq1T5e-vXfdE562A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19894-moms-ice-cream-dessert-VAT-009-step-02-59e348709b3a4be4b248e96bd2dcfeb9.jpg"
      ],
      "image": "assets/images/19894/step_02.webp"
    },
    {
      "text": "Press mixture into a 9x13-inch baking dish and freeze until cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tlf4Ha7WzlHcqrquGxBEiXH0dA0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19894-moms-ice-cream-dessert-VAT-010-step-03-9f1d0278b33b47b7842b3a23595d10d1.jpg"
      ],
      "image": "assets/images/19894/step_03.webp"
    },
    {
      "text": "Spread softened ice cream over cold crust and freeze until set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VqxNlZDDRHFoZdEhF5epPh21yGs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19894-moms-ice-cream-dessert-VAT-011-step-04-16bc767c665945b995714c6378e84cdb.jpg"
      ],
      "image": "assets/images/19894/step_04.webp"
    },
    {
      "text": "Combine confectioners' sugar, evaporated milk, chocolate chips, 1/2 cup butter and vanilla in large saucepan and bring to a boil over medium heat. Boil for 7 minutes, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PT36i7VoTkpi9HrRU7j3A_vQ2As=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19894-moms-ice-cream-dessert-VAT-012-step-05-3bfbe6a472854d8484a83b55a5f3e5f4.jpg"
