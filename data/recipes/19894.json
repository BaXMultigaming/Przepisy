  "ingredients": [
    "1 (20 ounce) package chocolate sandwich cookies",
    "0.5 cup margarine, melted",
    "1.5 cups chopped Spanish peanuts",
    "0.5 gallon vanilla ice cream, softened",
    "2 cups confectioners' sugar",
    "1 (12 fluid ounce) can evaporated milk",
    "0.66000002622604 cup semisweet chocolate chips",
    "0.5 cup margarine",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
