  "ingredients": [
    "1.5 pounds skinless, boneless chicken breast halves",
    "0.5 cup honey",
    "0.25 cup soy sauce",
    "2 tablespoons ketchup",
    "2 tablespoons dried minced onion",
    "1 tablespoon vegetable oil",
    "0.5 teaspoon garlic powder",
    "3 tablespoons water",
    "2 teaspoons cornstarch",
    "1 teaspoon sesame seeds, or to taste"
  ],
  "steps": [
    {
      "text": "Spread chicken evenly in a slow cooker. Stir together honey, soy sauce, ketchup, onion, oil, and garlic powder in a bowl; pour over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 3 to 4 hours or High for 1 1/2 to 2 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from sauce to a cutting board; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together water and cornstarch in a small bowl until smooth; stir into sauce in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High until sauce is slightly thickened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut chicken into bite-sized pieces; stir into sauce. Sprinkle with sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
