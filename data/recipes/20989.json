  "ingredients": [
    "1.5 cups milk",
    "0.375 cup shortening",
    "2 tablespoons white sugar",
    "1 teaspoon salt",
    "2 tablespoons active dry yeast",
    "4 cups all-purpose flour",
    "1 quart oil for frying",
    "6 tablespoons white sugar",
    "3 tablespoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J7VyqD1JbqD6tIH192Biuopogb8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20989-elephant-ears-DDMFS-4x3-step-01-c7eee68e5b5540b2ad64265ad0b53562.jpg"
      ],
      "image": "assets/images/20989/step_01.webp"
    },
    {
      "text": "Prepare dough: Combine milk, shortening, sugar, and salt in a small saucepan over medium heat. Cook and stir until shortening melts and sugar dissolves. Remove from heat and let cool to lukewarm, 110 degrees F (43 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/utPxES01-dyNtyvtvGm-6ShPU8s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20989-elephant-ears-DDMFS-4x3-step-03-cf5e5d4a3ec14af6af7d1b658a1a31fe.jpg"
      ],
      "image": "assets/images/20989/step_02.webp"
    },
    {
      "text": "Sprinkle yeast into the cooled dough mixture and let sit until foamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D6e6gaOBFYXehS_20X7zILhEjzA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20989-elephant-ears-DDMFS-4x3-step-04-1ea93aa781f24b98b55dff0f7ac4c186.jpg"
      ],
      "image": "assets/images/20989/step_03.webp"
    },
    {
      "text": "Transfer mixture to a large bowl and stir in flour to form a dough. Knead until smooth; cover and let rise 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zI9AFg61_J3eJqn7s0OFjxEzTmM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20989-elephant-ears-DDMFS-4x3-step-05-81e2cba97b9b496b9cf275a136de739f.jpg"
      ],
      "image": "assets/images/20989/step_04.webp"
    },
    {
      "text": "Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C). Roll out 2-inch balls of dough into thin sheets; fry in hot oil until puffed and golden, about 1 to 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U1r63TNPngNDvQTVyheT0YaRTiY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20989-elephant-ears-DDMFS-4x3-step-07-78e353a55c9a4ac2b5e24cbc284ce733.jpg"
      ],
      "image": "assets/images/20989/step_05.webp"
    },
    {
      "text": "Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yJVc8t6Gb2ufod_uxZ6K-HOh-WI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20989-elephant-ears-DDMFS-4x3-step-08-2-00f65a9797c34719a66979871b19a751.jpg"
      ],
      "image": "assets/images/20989/step_06.webp"
    },
    {
      "text": "Prepare topping: Combine sugar and cinnamon in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SITlT3hnNb-edJuzOa3lK1BB-Mc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20989-elephant-ears-DDMFS-4x3-step-02-c320bdc2764b4684bde0ff86a534ab3a.jpg"
      ],
      "image": "assets/images/20989/step_07.webp"
    },
    {
      "text": "Sprinkle topping over warm elephant ears and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/u5XCAadl7PyxJYSO7eP75KI4ZSk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-20989-elephant-ears-DDMFS-4x3-763bfb50e8bf42c1b5bf7c2bb5bf0b10.jpg"
      ],
      "image": "assets/images/20989/step_08.webp"
    }
