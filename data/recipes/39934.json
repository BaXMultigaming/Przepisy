  "ingredients": [
    "0.5 cup butter, melted",
    "0.5 cup brown sugar",
    "24 graham crackers, crushed",
    "1 quart milk",
    "1 pinch salt",
    "3 egg yolks, beaten",
    "1 tablespoon vanilla",
    "1 cup white sugar",
    "0.25 cup cornstarch",
    "3 egg whites",
    "1 teaspoon confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix butter, brown sugar, and 2/3 of the crushed graham crackers. Press lightly into the bottom of a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan over medium heat, mix milk, salt, egg yolks, vanilla, white sugar, and cornstarch. Stirring constantly, cook until thickened, about 12 minutes. Pour into the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat egg whites until soft peaks form, then mix in confectioners' sugar. Spoon over the mixture in the baking dish, and top with remaining crushed graham crackers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 15 minutes in the preheated oven, until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
