  "ingredients": [
    "1 cup butter",
    "1 cup packed brown sugar",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the butter and sugar. Stir in the vanilla, then the flour; mix well. Stir in the chocolate chips. Press into an unprepared jellyroll pan. Bake for 20 minutes in the preheated oven. Cut into bars while hot.",
