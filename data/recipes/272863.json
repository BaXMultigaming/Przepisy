  "ingredients": [
    "1 cup sour cream",
    "0.5 cup all-purpose flour",
    "2 eggs",
    "2 tablespoons white sugar",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1 teaspoon butter, or as needed"
  ],
  "steps": [
    {
      "text": "Blend sour cream, flour, eggs, sugar, salt, and baking soda together with a whisk until smooth.",
      "section": null,
