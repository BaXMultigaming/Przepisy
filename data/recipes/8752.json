  "ingredients": [
    "1 (4 pound) chicken, cut into pieces",
    "0.5 (10.75 ounce) can condensed tomato soup",
    "1 tablespoon garlic powder",
    "3 tablespoons ginger juice",
    "1 teaspoon ground cardamom",
    "0.5 tablespoon curry powder",
    "1 teaspoon salt",
    "1 teaspoon brown sugar",
    "2 tablespoons lemon juice",
    "0.5 cup buttermilk"
  ],
  "steps": [
    {
      "text": "FOR MARINADE: In a large bowl combine the soup, garlic powder, ginger juice, cardamom, curry powder, salt, brown sugar and lemon juice. Mix well. Marinate the chicken in the refrigerator overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "The next day, mix in the buttermilk, then grill the chicken until cooked through. You'll love it!",
      "section": null,
