  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "1 (8 ounce) can crushed pineapple, with juice",
    "2 eggs",
    "0.5 cup vegetable oil",
    "2 very ripe bananas, mashed",
    "1 teaspoon vanilla extract",
    "0.25 cup maraschino cherries, halved",
    "0.25 cup butter, melted",
    "1 teaspoon vanilla extract",
    "3 cups confectioners' sugar",
    "4 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the flour, sugar, baking soda, salt and cinnamon. Make a well in the center and pour in the crushed pineapple, eggs, oil, bananas and 1 teaspoon vanilla. Stir in the cherries. Mix well and pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 35 minutes, or until a toothpick inserted into the center of the cake comes out clean. Frost cake while still warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the frosting: in a medium bowl, combine melted butter, 1 teaspoon vanilla and confectioners' sugar. Beat in milk, one tablespoon at a time, until desired consistency is achieved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
