  "ingredients": [
    "1 cup mashed ripe bananas",
    "0.25 cup honey",
    "0.25 cup unsweetened applesauce",
    "0.25 cup packed brown sugar",
    "0.25 cup plain Greek yogurt",
    "3 tablespoons skim milk",
    "2 tablespoons vegetable oil",
    "1 tablespoon molasses",
    "1 tablespoon white sugar",
    "1.5 cups white whole wheat flour",
    "2.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup frozen blueberries",
    "2 teaspoons all-purpose flour, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease the bottom of 12 muffin cups or use paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat bananas, honey, applesauce, brown sugar, yogurt, milk, oil, molasses, and sugar together in a large bowl using an electric mixer. Gently stir whole wheat flour, baking powder, and salt into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll blueberries and 2 teaspoons flour together in a bowl. Fold floured blueberries into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the centers comes out clean, 15 to 20 minutes. Cool in the tin until safe to handle, about 10 minutes. Quickly remove muffins from tin to prevent sticking; let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
