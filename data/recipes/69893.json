  "ingredients": [
    "2 eggs",
    "0.5 cup unsweetened applesauce",
    "0.25 cup vegetable oil",
    "0.75 cup packed brown sugar",
    "1 teaspoon vanilla extract",
    "3 bananas, mashed",
    "2 cups whole wheat flour",
    "1 teaspoon baking soda",
    "1 tablespoon ground cinnamon",
    "1 cup frozen sliced strawberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 12 large muffin cups, or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk together the eggs, applesauce, oil, brown sugar, vanilla and bananas. Combine the flour, baking soda and cinnamon; Stir into the banana mixture until moistened. Stir in the strawberries until evenly distributed. Spoon batter into muffin cups until completely filled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 minutes in the preheated oven, or until the tops of the muffins spring back when pressed lightly. Cool before removing from the muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
