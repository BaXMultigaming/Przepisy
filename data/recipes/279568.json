  "ingredients": [
    "2 cups chopped onion",
    "5 cloves garlic, minced, or more to taste",
    "1 cup ketchup",
    "1 cup Worcestershire sauce",
    "1 cup brewed coffee",
    "0.5 cup cider vinegar",
    "0.5 cup brown sugar",
    "0.25 cup minced hot chile peppers",
    "3 tablespoons chili powder",
    "2 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Combine onion, garlic, ketchup, Worcestershire, coffee, vinegar, brown sugar, chile peppers, chili powder, and salt in a large saucepan and heat over medium-high heat until simmering. Reduce heat and simmer for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree in a food processor or blender until smooth.",
