  "ingredients": [
    "1 (3 pound) boneless pork loin roast, or more to taste",
    "1 tablespoon barbeque spice rub, or to taste",
    "1 (18 ounce) bottle barbecue sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 225 degrees F (104 degrees C). Place a small rack inside a Dutch oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub pork roast with barbecue spice rub and place on the rack in the Dutch oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook in the preheated oven until roast is fork-tender, about 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred the roast with 2 forks and return meat to the Dutch oven with some of the roasting juices and a generous amount of barbeque sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place on the stovetop and let simmer over medium heat for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
