  "ingredients": [
    "1 cup all-purpose flour",
    "0.25 cup cocoa powder",
    "1 tablespoon pumpkin pie spice",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.75 cup brown sugar",
    "1 cup pumpkin puree",
    "2 large eggs",
    "0.25 cup vegetable oil",
    "0.25 cup sour cream",
    "1 teaspoon vanilla extract",
    "1 cup chocolate chips, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cocoa powder, pumpkin pie spice, baking soda, baking powder, and salt together in a large bowl. Stir in brown sugar until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a well in center of cocoa powder mixture with a spoon. Add pumpkin purée, eggs, vegetable oil, sour cream, and vanilla extract to the well; stir until batter is just blended. Stir in 3/4 cup chocolate chips until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter evenly between the prepared 12 muffin cups. Sprinkle remaining 1/4 cup chocolate chips on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 18 to 22 minutes. Cool in the tin for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
