  "ingredients": [
    "2 large potatoes, peeled and sliced lengthwise",
    "3 carrots, peeled and sliced lengthwise",
    "1 (15 ounce) can sweet peas, drained",
    "3 dill pickles, chopped, or more to taste",
    "1 onion, finely chopped",
    "3 bologna slices, chopped",
    "2 hard-boiled eggs, chopped",
    "2 tablespoons mayonnaise",
    "2 tablespoons sour cream",
    "0.5 teaspoon salt",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes and carrots into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 15 minutes. Drain and rinse with cold water until cold. Dice potatoes and carrots.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine potatoes, carrots, sweet peas, pickles, onion, bologna, and eggs together in a large bowl. Stir mayonnaise, sour cream, salt, and black pepper gently into potato mixture until well combined. Cover bowl with plastic wrap and refrigerate until cold, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
