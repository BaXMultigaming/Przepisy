  "ingredients": [
    "1 cup brown sugar",
    "0.25 cup butter, melted",
    "0.5 teaspoon ground cinnamon",
    "3 cups bread cubes",
    "2 cups milk",
    "2 eggs, beaten"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar, butter, and cinnamon together in a bowl; add bread cubes and toss to coat. Transfer bread cubes mixture to prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and eggs together in another bowl; pour over bread cubes mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and set, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
