  "ingredients": [
    "0.75 cup white sugar, or more to taste",
    "0.25 cup all-purpose flour",
    "0.25 cup cocoa powder",
    "2 cups hot milk",
    "1 egg",
    "2 tablespoons butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Mix sugar, flour, and cocoa powder together in a saucepan. Stir in 1/2 cup milk slowly. Add egg. Stir in remaining milk. Cook over medium heat until thick, 3 to 5 minutes. Remove from heat; add butter and vanilla extract.",
