  "ingredients": [
    "1 pound sirloin steak, cut into bite size strips",
    "1 onion, chopped",
    "1.5 tablespoons all-purpose flour",
    "0.75 teaspoon salt",
    "0.25 teaspoon paprika",
    "0.125 teaspoon ground black pepper",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1.25 cups fat free sour cream",
    "1 (8 ounce) package egg noodles"
  ],
  "steps": [
    {
      "text": "Brown steak strips in a large skillet over medium-high heat; drain excess fat. Add onion and sauté for 5 minutes, or until tender. Stir in flour, salt, paprika, and ground black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in soup; reduce heat to medium-low and simmer for 15 minutes. Stir in sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare egg noodles according to package directions. Serve beef stroganoff over egg noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
