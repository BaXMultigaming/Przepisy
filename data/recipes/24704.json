  "ingredients": [
    "7 (3 ounce) packages assorted fruit flavored Jell-O® mix",
    "4.5 cups boiling water, divided",
    "4.5 cups cold water, divided",
    "1 (12 fluid ounce) can evaporated milk, divided",
    "1 (8 ounce) container frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Coat a 9x13 inch dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9Fi4p4C3fDXyoa6-emYZOWZsZFs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24704-seven-layer-gelatin-salad-VAT-005-step-01-de99d01efa994c76aaf2af8aab51d460.jpg"
      ],
      "image": "assets/images/24704/step_01.webp"
    },
    {
      "text": "Dissolve one package of gelatin in 3/4 cup boiling water. Stir in 3/4 cup cold water. Spoon into pan and refrigerate until almost set, 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KuDrCyZCo81GjV0S1-wR95EvrAg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24704-seven-layer-gelatin-salad-VAT-006-step-02-b74f7d7b4aaf40f6bab81c3334563feb.jpg"
      ],
      "image": "assets/images/24704/step_02.webp"
    },
    {
      "text": "Dissolve another package of gelatin in 1/2 cup boiling water. Stir in 1/2 cup cold water and 1/2 cup evaporated milk. Spoon over first layer and refrigerate until almost set, 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SoB3raSB7npUZCSw7uCbulYeGDg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24704-seven-layer-gelatin-salad-VAT-007-step-03-7edac582528041468fe2bff631cfbec0.jpg"
      ],
      "image": "assets/images/24704/step_03.webp"
    },
    {
      "text": "Repeat steps 2 and 3 until all gelatin is used. Just before serving, top with whipped topping.",
      "section": null,
