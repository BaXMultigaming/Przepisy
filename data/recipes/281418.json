  "ingredients": [
    "1 cup lemon juice",
    "0.25 cup soy sauce",
    "0.25 cup olive oil",
    "2 tablespoons crushed garlic",
    "1 tablespoon seasoned salt",
    "0.5 tablespoon paprika",
    "0.5 tablespoon ground turmeric",
    "3 pounds chicken wings",
    "1 pinch garlic salt, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix lemon juice, soy sauce, olive oil, garlic, seasoned salt, paprika, and turmeric together in a bowl. Add chicken wings; thoroughly massage marinade into the chicken. Transfer chicken and marinade into a 14x8-inch aluminum baking container. Season with garlic salt. Cover the pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 50 minutes. Remove the foil and continue baking until crisp and no longer pink in the centers, about 50 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
