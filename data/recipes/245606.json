  "ingredients": [
    "6 eggs",
    "1.5 cups white sugar",
    "1 cup butter, melted",
    "2 tablespoons vanilla extract",
    "3 (1 ounce) squares bittersweet chocolate (such as Baker’s®), melted",
    "3.5 cups self-rising flour",
    "0.25 cup Dutch process cocoa powder",
    "4 teaspoons baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Beat sugar and eggs together in a bowl using an electric mixer until pale yellow. Add butter and vanilla extract; beat until blended. Pour in chocolate; beat until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cocoa powder, baking powder, and salt together in a bowl; stir into egg mixture until batter is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat pizzelle baker according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of batter onto the preheated pizzelle iron. Bake until browned, 30 to 45 seconds. Remove carefully and transfer to a cooling rack.",
      "section": null,
