  "title": "Chocolate Mint Cookies I",
  "description": "This is a melt in your mouth chocolate cookie that has a chocolate mint frosting. It's delicious and it's easy!",
  "authors": [
    "Susan Black"
  ],
  "date_published": "1998-02-05T16:43:31-05:00",
