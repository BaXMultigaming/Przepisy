  "ingredients": [
    "1 cup raw cashews",
    "1 tablespoon olive oil",
    "0.5 teaspoon lemon-pepper seasoning",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place raw cashews in a bowl. Add olive oil and toss to coat. Sprinkle with lemon pepper seasoning, garlic powder, and salt; toss to coat again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 330 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread out seasoned cashews in the basket of the air fryer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook for 3 minutes. Shake the basket and cook until golden brown, about 4 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cashews to a paper towel lined plate and let cool completely. Store leftovers in an air-tight container.",
      "section": null,
      "name": null,
