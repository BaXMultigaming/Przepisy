  "ingredients": [
    "0.25 cup bread crumbs",
    "2 teaspoons seafood seasoning, such as Old Bay™",
    "1 teaspoon baking powder",
    "1 teaspoon dried parsley",
    "1 teaspoon mustard powder",
    "0.125 teaspoon black pepper",
    "0.75 cup cholesterol-free egg product",
    "2 tablespoons butter, melted",
    "1 tablespoon mayonnaise",
    "1 teaspoon Worcestershire sauce",
    "1 pound lump crab meat"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs, seafood seasoning, baking powder, parsley, mustard powder, and pepper in a medium bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together egg product, butter, mayonnaise, and Worcestershire in a large bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold in crab meat, then fold in bread crumb mixture until well-blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape mixture into twelve 3/4-inch-thick crab cakes and place onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Flip crab cakes; continue to bake until nicely browned, 10 to 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
