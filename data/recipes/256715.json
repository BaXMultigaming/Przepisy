  "ingredients": [
    "8 ounces shredded Cheddar cheese",
    "6 ounces cream cheese, softened",
    "2 cloves garlic, diced",
    "0.5 cup beer",
    "2 teaspoons cornstarch",
    "Paprika",
    "1 (7.2 ounce) package Original Snack Factory® Pretzel Crisps®"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly spray a glass baking dish with non-stick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place shredded cheese, softened cream cheese, garlic cloves, and beer in a food processor. Process until combined and smooth. Add cornstarch and a dash of paprika; process a little more to combine. Spread mixture in prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until bubbling, about 35 minutes. Serve with Snack Factory® Pretzel Crisps®.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
