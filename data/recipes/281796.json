  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place walnuts on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until toasted, 5 to 7 minutes. Remove from the oven and let cool, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While walnuts cool, bring a large pot of water to a boil. Add green beans and cook, 5 to 7 minutes. Drain and rinse with cold water; drain again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer green beans and walnuts to a mixing bowl and add feta, red onion, cranberries, salt, and pepper; gently toss together. Add balsamic dressing to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
