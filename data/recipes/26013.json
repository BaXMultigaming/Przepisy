  "ingredients": [
    "1 (18.25 ounce) package chocolate fudge cake mix",
    "1.3333333730698 cups brewed coffee",
    "2 tablespoons butter",
    "0.5 cup evaporated milk",
    "25 large marshmallows",
    "1 (14 ounce) package flaked coconut",
    "1 (16 ounce) container prepared chocolate fudge frosting"
  ],
  "steps": [
    {
      "text": "Prepare and bake cake mix according to package directions for two 9 inch round pans, except substitute brewed coffee for the water. Cool cakes completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the Filling: In a saucepan over medium heat, combine butter and evaporated milk. Bring to a boil. Add the marshmallows and stir until melted and smooth. Stir in coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Assemble the cake: Place bottom layer on serving plate. Spread with entire coconut filling. Cover top and sides with fudge frosting. Refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
