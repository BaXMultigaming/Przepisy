  "ingredients": [
    "1.75 cups blanched almonds",
    "1 cup shelled unsalted, unroasted pistachios",
    "3 cups confectioners' sugar",
    "1 teaspoon orange blossom water",
    "water as needed"
  ],
  "steps": [
    {
      "text": "Combine almonds and pistachios in a food processor; pulse until finely ground. Add confectioners' sugar and orange blossom water and just enough water to form a smooth paste. Wrap marzipan in aluminum foil and refrigerate until chilled before using.",
