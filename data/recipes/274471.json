  "ingredients": [
    "1.125 cups white sugar, divided, or as needed",
    "0.75 cup butter",
    "4 tablespoons molasses",
    "1 egg",
    "2 cups all-purpose flour",
    "3 teaspoons baking soda",
    "2 teaspoons ground ginger",
    "1.5 teaspoons ground cinnamon, divided, or as needed",
    "1 teaspoon ground cloves",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 cup sugar, butter, molasses, and egg together in a mixing bowl using an electric mixer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, ginger, 1 teaspoon cinnamon, cloves, salt, and nutmeg together in a bowl. Beat into butter mixture until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/8 cup sugar and 1/2 teaspoon cinnamon in a shallow bowl. Roll cookie dough into 1-inch balls. Roll cookies in the sugar-cinnamon mixture to coat. Place on the prepared cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and edges are set, about 11 minutes. Remove from the oven and let cool at least 5 minutes before serving or storing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
