  "ingredients": [
    "18 fluid ounces beer",
    "1 (18 ounce) bottle barbecue sauce",
    "0.5 cup brown sugar",
    "0.25 cup Dijon mustard",
    "2 pounds kielbasa (Polish) sausage, cut into 1/2 inch pieces"
  ],
  "steps": [
    {
      "text": "Combine beer, barbecue sauce, brown sugar, and Dijon mustard in a large skillet over medium heat. Bring to a boil, stirring occasionally; reduce heat to low. Add kielbasa; simmer until browned and glazed, about 1 hour.",
