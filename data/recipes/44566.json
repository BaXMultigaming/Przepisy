  "ingredients": [
    "1 pound ground venison",
    "1 pound pork sausage",
    "1.5 teaspoons mustard powder",
    "1 teaspoon mustard seed",
    "2 teaspoons liquid smoke flavoring",
    "1.5 teaspoons garlic powder",
    "1.5 teaspoons onion salt",
    "1.5 teaspoons meat tenderizer",
    "0.25 cup water, or as needed"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix together the ground venison and pork sausage. Season with mustard powder, mustard seed, liquid smoke, garlic powder, onion salt, and meat tenderizer. Mix in just enough water to make the mixture sticky. Cover, and refrigerate for three days, mixing once a day.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On the fourth day, preheat the oven to 160 degrees F (70 degrees C). Form the mixture into 2 inch rolls, and place them on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 6 hours in the preheated oven, until firm and cooked through. Wrap in plastic wrap, and refrigerate until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
