  "ingredients": [
    "2 medium russet potatoes",
    "cooking spray",
    "2 tablespoons dry white wine",
    "2 tablespoons extra-virgin olive oil",
    "0.5 teaspoon thyme",
    "0.5 teaspoon garlic granules",
    "0.5 teaspoon salt",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Peel and cut the potatoes into 1/2-inch strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a medium bowl with cold water and soak cut potatoes for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with foil and spray with cooking oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the potatoes from the water and dry well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white wine, oil, thyme, garlic, salt, and pepper in a bowl and mix well. Add potatoes and toss to coat. Spread out potatoes on the prepared baking sheet in a single layer without touching.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 15 minutes. Turn and continue roasting, turning occasionally, until potatoes are golden brown, an additional 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
