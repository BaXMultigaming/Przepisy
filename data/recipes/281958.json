  "ingredients": [
    "1.5 cups dark chocolate chips",
    "3 tablespoons unsalted butter, cubed",
    "2 teaspoons maple syrup",
    "1.5 cups miniature marshmallows",
    "1.25 cups lightly salted roasted almonds",
    "0.25 cup unsweetened cocoa powder"
  ],
  "steps": [
    {
      "text": "Place dark chocolate chips, butter, and maple syrup in a heat-safe bowl set over a saucepan with about 1 inch hot water over lowest heat setting until melted; do not stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, line an 8x8-inch baking pan with plastic wrap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly stir melted chocolate mixture with a spatula until shiny and smooth. Off heat, stir in marshmallows and almonds until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Quickly transfer mixture to the prepared pan until evenly distributed. Do not smooth or press down the top; try to preserve a rough texture. Cool to room temperature, about 30 minutes. Wrap in plastic wrap. Refrigerate until firm and well chilled, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift cocoa over top. Cut into 16 squares.",
      "section": null,
      "name": null,
      "url": null,
