    "American"
  ],
  "breadcrumbs": [],
  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "2.5 pounds country-style pork ribs",
    "2 tablespoons kosher salt",
    "1 tablespoon garlic powder",
    "1 teaspoon ground black pepper",
    "1 cup barbeque sauce"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BS_wOIQbIGXh_bT0Wu1E35TfnOU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16448-SimpleBBQRibs-mfs-Step1-0389-b45f970e87154800af7b8c4f4af06ff0.jpg"
      ],
      "image": "assets/images/16448/step_01.webp"
    },
    {
      "text": "Place ribs in a large pot and cover with water. Stir in kosher salt, garlic powder, and pepper, and bring water to a boil over medium heat. Continue to boil until ribs are tender, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uQZ_NIj0hk_kzgd3A26KO38WryI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16448-SimpleBBQRibs-mfs-Step2-0425-e94ae8ad0e184265a00d5db0272b0860.jpg"
      ],
      "image": "assets/images/16448/step_02.webp"
    },
    {
      "text": "While the ribs are boiling, preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ribs from the pot, and place them in a 9x13-inch baking dish. Pour barbecue sauce over ribs. Cover the baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V-XZQUIYwkC_NZIHy09lbu2sbcw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16448-SimpleBBQRibs-mfs-Step3-0428-7d16853da72c43ca9062084a44971f85.jpg"
      ],
      "image": "assets/images/16448/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until the internal temperature of the pork has reached 160 degrees F (70 degrees C), 1 to 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/L1OMtWXpXHhTjTvWiH8vWu-PTt0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16448-SimpleBBQRibs-mfs-Step4-0542-059ef83c97734761a172902a79eb8f18.jpg"
      ],
      "image": "assets/images/16448/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bcm81s6NUyIo7ENmN597buv4MVA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16448-simple-bbq-ribs-DDMFS-4x3-6c6ec5c3ddda485fbc8c855520ae8fc9.jpg"
      ],
      "image": "assets/images/16448/step_06.webp"
    }
  ],
