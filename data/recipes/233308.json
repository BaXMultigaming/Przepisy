  "ingredients": [
    "2 cups heavy whipping cream",
    "1 cup whole milk",
    "0.5 cup white sugar",
    "0.5 teaspoon pure peppermint extract",
    "2 ounces dark chocolate, finely chopped",
    "6 fresh strawberries, diced"
  ],
  "steps": [
    {
      "text": "Mix heavy cream, whole milk, sugar, and peppermint extract in a bowl. Pour mixture into an ice cream maker and freeze until slightly thickened, 25 to 30 minutes (time varies according to ice cream maker specifications). Stir chocolate and strawberries into ice cream mixture; allow to mix until thickened, 3 to 5 more minutes.",
