  "ingredients": [
    "1 cup butter",
    "6 eggs",
    "3 cups white sugar",
    "3 cups all-purpose flour",
    "1 pint heavy whipping cream",
    "1 tablespoon vanilla extract",
    "2 teaspoons lemon extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 10-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With an electric mixer, cream butter and sugar until fluffy. Add eggs, one at a time, and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour, 1 cup at a time, while adding cream, a little at a time, until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add vanilla and lemon flavoring; blend well. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 1/2 hours, or until a toothpick inserted into the center of the cake comes out clean; turn out onto a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
