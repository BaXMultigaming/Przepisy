  "ingredients": [
    "0.5 cup shortening",
    "0.75 cup white sugar",
    "1 egg",
    "0.5 teaspoon almond extract",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup semi-sweet chocolate chips",
    "0.75 cup flaked coconut",
    "0.75 cup candied cherries, chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream shortening and sugar until light and fluffy. Beat in egg and almond extract. Stir in flour, baking powder and salt. When the mixture is creamy, stir in chocolate chips, coconut and cherries. Drop the dough by teaspoonful onto a greased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
