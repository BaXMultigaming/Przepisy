    "2 (10 ounce) packages frozen chopped spinach, thawed and drained",
    "1 cup mayonnaise",
    "1 cup sour cream",
    "0.5 cup bacon bits",
    "3 tablespoons chopped onions",
    "1 (1 ounce) package ranch dressing mix",
    "10 (12 inch) flour tortillas"
