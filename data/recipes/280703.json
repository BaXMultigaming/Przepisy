  "ingredients": [
    "1.125 cups white sugar",
    "1.125 cups brown sugar",
    "1 cup unsalted butter, softened",
    "2 large eggs",
    "0.75 cup peanut butter",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1.6666667461395 cups rolled oats",
    "1 teaspoon baking soda",
    "1 pinch salt",
    "2 cups powdered sugar",
    "4 tablespoons unsalted butter, softened",
    "2 tablespoons milk, or more as needed",
    "2 tablespoons peanut butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 15x10-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream white sugar, brown sugar, butter, and eggs together in a mixing bowl. Mix in peanut butter and vanilla extract. Add flour and blend well. Add oats, baking soda, and salt and mix to combine. Spread into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and the edges start to pull away from the sides of the pan, about 20 minutes. Remove from the oven and let cool or chill in the refrigerator, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While bars cool, blend powdered sugar, butter, milk, and peanut butter together in a bowl, adding more milk to give frosting the desired consistency. Frost cooled bars and cut into 20 pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
