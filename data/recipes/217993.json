  "ingredients": [
    "2 tablespoons vegetable oil",
    "3 summer squash, sliced",
    "1 small onion, diced",
    "4 large eggs, beaten",
    "3 cups shredded Cheddar cheese",
    "2 tablespoons milk",
    "2 tablespoons white sugar",
    "2 tablespoons all-purpose flour",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "6 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Cook squash and onion in hot oil, stirring occasionally, until tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix together eggs, 1 cup Cheddar cheese, milk, sugar, flour, salt, and pepper in a large bowl. Stir in squash mixture and melted butter; transfer to a 2-quart casserole dish. Top with remaining 2 cups Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until casserole is set and cheese is crisp and starting to brown, 35 to 45 minutes. Allow to stand for 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
