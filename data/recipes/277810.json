  "ingredients": [
    "4 cups vegetable oil for frying",
    "5 small russet potatoes",
    "1 cup all-purpose flour",
    "2 teaspoons chili powder",
    "2 teaspoons chicken bouillon granules",
    "2 teaspoons paprika",
    "1 teaspoon ground black pepper",
    "1 teaspoon ground cayenne pepper",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice potatoes into 16 wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, chili powder, chicken bouillon, paprika, black pepper, and cayenne in a 1-gallon resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip potato wedges in milk, then shake them in the flour mixture. Fry in the hot oil until golden brown, 5 to 6 minutes per batch. Let drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
