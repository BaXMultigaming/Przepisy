  "ingredients": [
    "Crisco® Original No-Stick Cooking Spray",
    "3 cups granulated sugar",
    "0.66666668653488 cup PET® Evaporated Milk",
    "0.5 cup butter or margarine",
    "1.6666666269302 cups Jif® Creamy Reduced Fat Peanut Spread",
    "1 (7 ounce) jar marshmallow creme",
    "1 teaspoon vanilla"
  ],
  "steps": [
    {
      "text": "Line a 9x13x2-inch pan with aluminum foil; coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, milk, and butter in a large saucepan on medium heat until comes to a boil, stirring constantly. Boil 5 minutes, stirring constantly. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add peanut butter; stir until combined. Add marshmallow cream and vanilla; beat until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread into the prepared pan. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut into candy-sized pieces. Store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
