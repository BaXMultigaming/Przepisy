  "title": "Maria’s Stuffed Chicken Breasts",
  "description": "Chicken breasts stuffed with a spinach/ricotta/mozzarella mixture, then baked in your favorite spaghetti sauce.",
  "authors": [
    "Maria Fontana"
  ],
  "date_published": "2000-08-08T13:04:04-04:00",
