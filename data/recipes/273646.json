  "ingredients": [
    "4 large russet potatoes, scrubbed",
    "2 tablespoons lemon juice",
    "1 tablespoon olive oil",
    "1 teaspoon finely chopped garlic",
    "1 teaspoon Greek seasoning"
  ],
  "steps": [
    {
      "text": "Pierce potatoes all over with a fork. Microwave until soft, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine lemon juice, olive oil, garlic, and Greek seasoning in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut potatoes in half lengthwise; score flesh and brush with seasoned oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, flesh-sides down, until browned, 10 to 15 minutes.",
      "section": null,
