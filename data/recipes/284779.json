  "ingredients": [
    "1 (8 ounce) package bulk pork sausage",
    "0.5 (8 ounce) package Neufchatel cheese, softened",
    "1 (8 ounce) package refrigerated crescent rolls",
    "1 cup sharp Cheddar cheese, shredded",
    "salt and freshly ground black pepper to taste (optional)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sausage in a skillet until browned and crumbly, 5 to 7 minutes; drain. Add Neufchatel cheese; cook and stir until combined. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll crescent rolls and place 1/2 of the rolls into an 8x8-inch glass baking dish. Make sure to press seams together. Top with sausage-Neufchatel cheese mixture and sprinkle with Cheddar cheese. Top with remaining crescent rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes. Let cool 10 minutes before cutting into 8 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
