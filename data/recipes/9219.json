  "ingredients": [
    "1 (40 ounce) can cut sweet potatoes, undrained",
    "0.75 cup white sugar, or more to taste",
    "0.333 cup unsalted butter, cut into pieces",
    "0.333 cup milk",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "1 cup chopped pecans",
    "0.75 cup packed brown sugar, or more to taste",
    "0.333 cup all-purpose flour",
    "0.333 cup unsalted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TrDwgZ3v_PfM5G45JmLgM3GMBow=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9219-sweet-potato-casserole-i-ingredients-1-dae2867d4b1b4c6f8f093c3df0a5fb41.jpg"
      ],
      "image": "assets/images/9219/step_01.webp"
    },
    {
      "text": "Place sweet potatoes and their liquid in a medium saucepan; bring to a boil over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/u60YH5baLO9zESFQK1W3BhsDew0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9219-sweet-potato-casserole-i-step-02-2-16a57e5cb2614d76870e3b13ad0998bf.jpg"
      ],
      "image": "assets/images/9219/step_02.webp"
    },
    {
      "text": "Remove sweet potatoes from the heat and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rYVHMxkqLSoYmzH3_YFEVOtda8g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9219-sweet-potato-casserole-i-step-03-fdd57cfd32924155bca044309817d155.jpg"
      ],
      "image": "assets/images/9219/step_03.webp"
    },
    {
      "text": "Transfer sweet potatoes to a medium bowl; mash with a fork or potato masher until mostly smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VNPs0IMsgr1zkQu2MO96V0GGEpI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9219-sweet-potato-casserole-i-step-04-cac7adfdac474e1e89ff59f7cf24443c.jpg"
      ],
      "image": "assets/images/9219/step_04.webp"
    },
    {
      "text": "Add white sugar, butter, milk, eggs, and vanilla extract; mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ndDJTjmL3IdviUeJvpAEbHKvpi4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9219-sweet-potato-casserole-i-step-05-1-6435fd1f2066401ab3e61dc086a84e41.jpg"
      ],
      "image": "assets/images/9219/step_05.webp"
    },
    {
      "text": "Spread sweet potato filling evenly in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FoSAIND39RhMMYZOcxhC7CWUKuM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9219-sweet-potato-casserole-i-step-06-b9f8384b68714be3b6fdc221ea6d7af3.jpg"
      ],
      "image": "assets/images/9219/step_06.webp"
    },
    {
      "text": "Mix pecans, brown sugar, flour, and butter in a separate bowl until topping is crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J7kdo1DO4MS8HRmat9xwTzA762w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9219-sweet-potato-casserole-i-step-07-2-eee4687bfddd4cb28600835af5dce8ac.jpg"
      ],
      "image": "assets/images/9219/step_07.webp"
    },
    {
      "text": "Sprinkle over sweet potato filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VmWrDp3U3l4u31PJt4kZRJvqInU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9219-sweet-potato-casserole-i-step-08-2b90c3ac91c94899ab3ae60a01b5b56d.jpg"
      ],
      "image": "assets/images/9219/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven until topping is golden brown and sweet potato filling is heated through, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/937JJZgF_7Hug83U8HKC18EfIjU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9219-sweet-potato-casserole-i-vat-4X3-crop-ec3ad430a579449a9d798e5c071d8289.jpg"
