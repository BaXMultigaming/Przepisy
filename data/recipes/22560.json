  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "2 cups shredded Cheddar cheese",
    "2 (6 ounce) cans crabmeat",
    "4 tablespoons mayonnaise",
    "2 tablespoons Worcestershire sauce",
    "1.5 tablespoons fresh lemon juice",
    "2 teaspoons hot sauce",
    "paprika, for garnish"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/L0xkCHe04BLoGDR5tF0ZSzTgiNg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22560-hot-crab-dip-VAT-step-01-9423658487d943cebecb90c05293fe4e.jpg"
      ],
      "image": "assets/images/22560/step_01.webp"
    },
    {
      "text": "Beat cream cheese in a medium bowl until smooth. Stir in Cheddar cheese, crabmeat, mayonnaise, Worcestershire sauce, lemon juice, and hot sauce until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2gPHVwJsZUYBCxosvjpWS0lb8zA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22560-hot-crab-dip-VAT-step-02-7399c0c52c244a39bbab3b46dc1dde4d.jpg"
      ],
      "image": "assets/images/22560/step_02.webp"
    },
    {
      "text": "Transfer crab mixture to a shallow 9x13-inch or similar-sized baking dish. Garnish with paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y3Ee5YbLaZsjtLJf1RSwU-ZpV80=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22560-hot-crab-dip-VAT-step-03-058e955c523d459b8e6cfea85b3a4fc7.jpg"
      ],
      "image": "assets/images/22560/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown and bubbly, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jxkadskLYNqwvtJFZBsw9uiwEbg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-22560-hot-crab-dip-VAT-4x3-6c2ce375de5f4dcdbacb76dd03c877b0.jpg"
