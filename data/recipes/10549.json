  "ingredients": [
    "0.5 cup butter",
    "1 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.33333334326744 cup unsweetened cocoa powder",
    "0.5 cup all-purpose flour",
    "0.25 teaspoon salt",
    "0.25 teaspoon baking powder",
    "3 tablespoons butter, softened",
    "3 tablespoons unsweetened cocoa powder",
    "1 tablespoon honey",
