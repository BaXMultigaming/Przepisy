  "ingredients": [
    "cooking spray",
    "0.5 cup orange juice",
    "0.25 cup olive oil",
    "6 cloves garlic, minced",
    "2 tablespoons Dijon mustard",
    "2 tablespoons lemon juice",
    "1.5 tablespoons crushed dried oregano",
    "1.5 teaspoons salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon ground cumin",
    "1 teaspoon ground turmeric",
    "3 pounds fingerling potatoes",
    "3 tablespoons chopped fresh thyme"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a 9x13-inch glass baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine orange juice, olive oil, garlic, mustard, lemon juice, oregano, salt, pepper, cumin, and turmeric in a food processor; pulse to get a thick sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in the prepared pan and pour sauce over top. Toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, covered, in the preheated oven for 40 minutes. Uncover and continue to bake until potatoes are tender, about 20 minutes more. Top with fresh thyme.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
