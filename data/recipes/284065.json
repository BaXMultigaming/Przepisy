  "ingredients": [
    "2 medium thin-skinned limes",
    "2 cups ice cold water",
    "1 cup tequila",
    "0.5 cup white sugar",
    "0.25 cup orange-flavored liqueur (such as Cointreau)",
    "0.25 teaspoon kosher salt",
    "3 cups ice, or as needed",
    "6 slices lime"
  ],
