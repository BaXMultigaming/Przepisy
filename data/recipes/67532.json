  "ingredients": [
    "5 cups coarsely chopped mixed fruit (apples, plums, and pears)",
    "1 cup water",
    "0.75 cup apple juice",
    "0.5 cup packed light brown sugar",
    "1 tablespoon apricot preserves",
    "1 teaspoon soy sauce",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon dry mustard"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/biBIiu-6uwC5-QuB79XfFkgsFbI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-67532-duck-sauce-VAT-step-01-ac0aba4487d242ef9e8526ab2af3074f.jpg"
      ],
      "image": "assets/images/67532/step_01.webp"
    },
    {
      "text": "Place plums in a stockpot over medium-high heat. Stir in 1 cup water, apple juice, brown sugar, apricot preserves, soy sauce, garlic powder, and dry mustard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xV6oWJUZNS428lc5pPychrZ6ajw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-67532-duck-sauce-VAT-step-02-aed985e448a34c37b20acd37815d832e.jpg"
      ],
      "image": "assets/images/67532/step_02.webp"
    },
    {
      "text": "Bring to a simmer, stirring frequently to dissolve brown sugar. Reduce the heat and continue simmering until fruit is completely soft, about 40 minutes. Remove from the heat and let cool for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Soplisz50lnGDPaZA9X94T_yvaw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-67532-duck-sauce-VAT-step-03-4d1a50eba13649a09576dad2acbe8d01.jpg"
      ],
      "image": "assets/images/67532/step_03.webp"
    },
    {
      "text": "Transfer cooled mixture to a food processor or blender. Blend until completely smooth, adjusting the consistency with additional water if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5YD36H3k-hTblPrDrY239tsKOhs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-67532-duck-sauce-VAT-step-04-2-9db263fa8d6a4138b0dd80d302e48b2e.jpg"
      ],
      "image": "assets/images/67532/step_04.webp"
    },
    {
      "text": "Cover and refrigerate until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W84hXGPqt858OmIEinP7_NvNjXY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-67532-duck-sauce-VAT-step-05-1bde26e18fc54971b02ca47192427aa4.jpg"
      ],
