  "ingredients": [
    "1 pound pizza dough",
    "2 tablespoons olive oil, divided",
    "1.5 cups sliced fresh mushrooms",
    "2 teaspoons minced garlic",
    "1.5 cups turkey gravy",
    "2 cups chopped cooked turkey",
    "1.5 cups mashed potatoes",
    "2 cups shredded mozzarella cheese",
    "0.25 cup chopped fresh parsley",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon garlic salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Grease or flour a pizza pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough onto the prepared pizza pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 1/2 tablespoons olive oil in a skillet over medium-low heat; cook and stir mushrooms and garlic until mushrooms are tender, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread gravy over pizza dough; top with mushroom mixture, turkey, and spoonfuls of mashed potatoes. Sprinkle mozzarella cheese and parsley over pizza.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk remaining 1/2 tablespoon olive oil with garlic powder and garlic salt; brush over pizza crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until dough is cooked and cheese is melted, 12 to 15 minutes. Cool slightly before serving, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
