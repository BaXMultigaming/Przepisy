  "ingredients": [
    "5 cups chopped fresh rhubarb",
    "3 cups miniature marshmallows",
    "1 cup white sugar",
    "1 (3 ounce) package strawberry flavored Jell-O®",
    "1 (18.25 ounce) package yellow cake mix"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rhubarb, marshmallows, sugar, and Jell-O mix together in a large bowl. Spread evenly in the prepared pan. Mix cake batter according to package directions; pour evenly over ingredients in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Run a knife around outer edges of cake to loosen; turn out onto a large plate while still hot. Let cake cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
