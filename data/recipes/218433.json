  "ingredients": [
    "1 cup white sugar",
    "2.5 cups all-purpose flour",
    "1 tablespoon baking powder",
    "1 teaspoon baking soda",
    "1 tablespoon butter",
    "2 cups pitted sweet cherries",
    "1 tablespoon white sugar",
    "0.5 cup olive oil",
    "4 eggs",
    "1 (6 ounce) container plain yogurt",
    "1 tablespoon olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Whisk 1 cup sugar, flour, baking powder, and baking soda in a mixing bowl until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Cook and stir pitted cherries in the butter until tender, sprinkling them with 1 tablespoon of sugar, 8 to 10 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form a well in the center of the dry ingredients, and pour in 1/2 cup olive oil, eggs, and yogurt; lightly stir the mixture to make a soft dough. Scrape batter into a 9x12-inch baking dish. Drizzle with 1 tablespoon of olive oil (if using), and top with cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake is set and golden on top and a toothpick inserted into the center of the cake comes out clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
