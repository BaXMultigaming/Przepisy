  "ingredients": [
    "0.5 cup all-purpose flour",
    "0.5 teaspoon freshly ground black pepper",
    "0.25 teaspoon salt",
    "0.25 teaspoon cayenne pepper",
    "1.5 pounds fresh shrimp, shelled and deveined without tails",
    "0.5 cup olive oil",
    "4 cloves garlic, minced",
    "1 shallot, chopped",
    "0.5 cup fresh parsley, minced",
    "0.5 teaspoon dried oregano, crushed",
    "2 tablespoons white wine",
    "2 tablespoons brandy"
  ],
  "steps": [
    {
      "text": "Combine flour, black pepper, salt, and cayenne pepper in a small bowl. Dredge shrimp in flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sauté shrimp in olive oil in a large skillet over high heat for 5 minutes, stirring often; transfer to a broiler-safe serving dish using a slotted spoon, leaving oil in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sauté garlic, shallot, parsley, and oregano in same skillet over medium heat for 3 minutes, stirring constantly. Spoon over shrimp. Return skillet to stovetop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat the broiler for medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add wine and brandy to the skillet over medium heat; ignite with a match or lighter. When flames die down, stir to loosen any browned bits on the bottom of the skillet; pour over shrimp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil shrimp in the preheated broiler for about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
