  "ingredients": [
    "1 tablespoon vegetable oil",
    "1.5 cups basmati rice",
    "1.25 (14 ounce) cans chicken stock",
    "1 (14 ounce) can coconut milk",
    "0.75 cup cashew halves",
    "0.5 cup raisins",
    "1 teaspoon salt",
    "1 bay leaf",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground coriander",
    "0.25 teaspoon ground turmeric",
    "1 pinch crushed red pepper flakes"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium-high heat. Stir in rice; cook for 2 minutes. Add chicken stock, coconut milk, cashews, raisins, salt, bay leaf, cumin, coriander, turmeric, and pepper flakes. Bring to a boil, cover, and reduce heat to low. Cook until rice is tender, about 20 minutes.",
