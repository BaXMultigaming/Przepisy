  "title": "American Lasagna",
  "description": "This lasagna recipe is made with layers of homemade meat sauce, tender pasta sheets, ricotta filling, and lots of Parmesan and mozzarella cheese.",
  "authors": [
    "ETHELMERTZ"
  ],
  "date_published": "1999-02-21T17:33:41-05:00",
