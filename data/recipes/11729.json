    "publisher-tested"
  ],
  "ingredients": [
    "1.5 pounds lean ground beef",
    "1 onion, chopped",
    "2 cloves garlic, minced",
    "1 (29 ounce) can diced tomatoes",
    "2 (6 ounce) cans tomato paste",
    "2 tablespoons brown sugar",
    "1 tablespoon chopped fresh basil",
    "2.5 teaspoons salt, divided",
    "1 teaspoon dried oregano",
    "12 dry lasagna noodles",
    "1 pint part-skim ricotta cheese",
    "0.5 cup grated Parmesan cheese",
    "2 large eggs, beaten",
    "2 tablespoons dried parsley",
    "1 pound mozzarella cheese, shredded",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VB80h1I5GPMPfcZ2zLxIJ37QEFk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_11729_AmericanLasagna_Shot1_14438-c7180efb85154b679e1444430d90f32b.jpg"
      ],
      "image": "assets/images/11729/step_01.webp"
    },
    {
      "text": "Cook and stir ground beef, onion, and garlic in a large skillet over medium heat for 5 minutes; drain fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aLf3RQ-IbvVvXVsInAqXZm1U0YU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_11729_AmericanLasagna_Shot2_14439-06deeea9390d4fa29fe40b2326640b32.jpg"
      ],
      "image": "assets/images/11729/step_02.webp"
    },
    {
      "text": "Mix in diced tomatoes, tomato paste, brown sugar, basil, 1 1/2 teaspoons salt, and oregano. Simmer meat sauce, stirring occasionally, for 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9Wm6c4emiWlmwflPpB3VcOh2Ay0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_11729_AmericanLasagna_Shot4_14479-4d9887b7646d4cf4a56d0793827c21a4.jpg"
      ],
      "image": "assets/images/11729/step_03.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook lasagna noodles in boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes; drain. Lay noodles flat on towels; blot dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JsMnfHWL-5e7D_R07C6YPNJJ22U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_11729_AmericanLasagna_Shot6_14464-7338413198df429682028ca83eb248f4.jpg"
      ],
      "image": "assets/images/11729/step_05.webp"
    },
    {
      "text": "Mix together ricotta, 1/2 cup Parmesan cheese, eggs, parsley, and remaining 1 teaspoon salt in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NBrOfCCO9U7c-ZVRG6XoIKObO7Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_11729_AmericanLasagna_Shot7_14474-23c914e2c44b423e8404989f21e51587.jpg"
      ],
      "image": "assets/images/11729/step_06.webp"
    },
    {
      "text": "Layer 1/3 of the noodles in the bottom of a 9x13-inch baking dish. Cover with 1/2 of the ricotta mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bBxVX6zXjQ1sAnXqLf91UxOqkek=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_11729_AmericanLasagna_Shot9_14489-8301b309077640e28594dd5a4e1d89a1.jpg"
      ],
      "image": "assets/images/11729/step_07.webp"
    },
    {
      "text": "Cover the ricotta mixture with 1/2 of the mozzarella cheese, and 1/3 of the meat sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h4QSYwZlF3eAY4lR7GLoGKKHbOQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_11729_AmericanLasagna_Shot11_14492-d531ab9b169e46ada2e8fc7f09773d56.jpg"
      ],
      "image": "assets/images/11729/step_08.webp"
    },
    {
      "text": "Repeat. Top with remaining noodles and meat sauce. Sprinkle 2 tablespoons Parmesan cheese over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l3OBYGeZLKPPLE9Rsjis3SOYm3k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_11729_AmericanLasagna_Shot12_14493-1bcd204e6bb54b2493ed5e9050393da3.jpg"
      ],
      "image": "assets/images/11729/step_09.webp"
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Let stand for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_8vSmE1_ORObCGLJZVWB9ekS22I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_11729_AmericanLasagna_Shot13_14562-c7b4c9a435e3409d99d285c788fc1fee.jpg"
      ],
      "image": "assets/images/11729/step_10.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ik-K_-QbIJKHVuJnTlZtMehsvbc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_11729_AmericanLasagna_3x2_14588-bbd9dd7e466449f992de700eb7026b16.jpg"
      ],
      "image": "assets/images/11729/step_11.webp"
    }
