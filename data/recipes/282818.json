  "ingredients": [
    "0.5 cup unsalted butter",
    "2 large egg yolks",
    "1 tablespoon warm water",
    "1 tablespoon fresh lemon juice",
    "0.75 teaspoon coarse salt",
    "1 pinch ground cayenne pepper"
  ],
  "steps": [
    {
      "text": "Melt butter in a small saucepan over medium heat until bubbly; do not let brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine egg yolks, water, lemon juice, salt, and cayenne pepper in a blender; blend until frothy. Pour in hot butter in a very thin stream, with the blender running, until thick and emulsified. Immediately pour sauce into a serving bowl.",
