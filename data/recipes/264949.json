  "ingredients": [
    "1 pound boneless, skinless chicken breasts",
    "2 teaspoons Hidden Valley® Ranch Seasoning",
    "1 teaspoon chili powder",
    "2 (15 ounce) cans Great Northern white beans, drained and rinsed",
    "3 cups chicken broth",
    "2 (4 ounce) cans canned diced green chiles",
    "1 large onion, diced",
    "0.5 cup heavy cream",
    "0.5 bunch Fresh cilantro",
    "0.25 cup Canned corn",
    "0.25 cup Shredded Cheddar cheese",
    "8 teaspoons Sour cream",
    "2 tablespoons Diced avocados"
  ],
  "steps": [
    {
      "text": "Place chicken breasts in a slow cooker; sprinkle with seasoning mix and chili powder. Top with beans, chicken broth, green chiles (with liquid), and onion; stir. Cover slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High heat for 3 to 4 hours or on Low heat for 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken, shred, and add back to the slow cooker. Stir in heavy cream; cook on High heat just until warmed through and slightly thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve chili warm; top with cilantro, corn, Cheddar cheese, sour cream, and avocados.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
