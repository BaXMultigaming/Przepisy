  "ingredients": [
    "12 eggs",
    "0.5 cup white sugar",
    "2 quarts milk",
    "2 teaspoons vanilla extract",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Place eggs and sugar into a pan; whisk until frothy and light in color. Whisk in 2 cups milk until thoroughly blended. Place the pan over medium heat; cook and stir until mixture thickens and coats the back of a wooden spoon, about 5 minutes. Remove from the heat and allow to stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in remaining 6 cups milk, vanilla extract, and nutmeg. Refrigerate for at least 2 hours to cool thoroughly before serving.",
