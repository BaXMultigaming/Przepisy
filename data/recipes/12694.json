  "ingredients": [
    "2 potatoes - peeled, boiled and mashed",
    "0.66666668653488 cup butter",
    "1 cup white sugar",
    "0.5 teaspoon baking powder",
    "0.125 teaspoon salt",
    "0.5 cup heavy whipping cream",
    "0.5 cup milk",
    "2 teaspoons lemon zest",
    "2 tablespoons lemon juice",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon nutmeg",
    "4 eggs, beaten",
    "2 (9 inch) pie shell"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium mixing bowl mix sugar, baking powder, and salt, then add potatoes and butter or margarine; mix well. Gradually add whipping cream and milk, stirring until well blended. Stir in lemon rind, juice, vanilla, and nutmeg. Add beaten eggs and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into pie shells and put in preheated oven. Bake for 55 minutes or until knife inserted in center comes out clean. Best when served cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
