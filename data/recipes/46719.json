  "ingredients": [
    "6.25 cups cubed whole wheat bread",
    "1.25 cups milk",
    "1 egg, beaten",
    "0.33333334326744 cup butter, softened",
    "0.75 cup raisins",
    "0.25 cup dried mixed fruit",
    "0.5 cup brown sugar",
    "1 tablespoon ground nutmeg",
    "1 tablespoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine bread and milk, and set aside to soak for 5 minutes. Then stir in egg, butter, raisins, mixed fruit, brown sugar, nutmeg, and cinnamon. Mix well. Press the mixture into a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden and firm to touch, about 35 minutes. Leave in baking pan to cool, then cut into squares.",
      "section": null,
