  "title": "Jasmine Rice with Bok Choy",
  "description": "Asian jasmine rice is cooked with sauteed bok choy in chicken broth for a delicious and easy rice side dish.",
  "authors": [
    "Robert in SF"
  ],
  "date_published": "2018-12-08T01:25:22-05:00",
