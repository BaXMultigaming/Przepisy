  "ingredients": [
    "2 slices Pure Farmland® Uncured Turkey Bacon, cut into 1-inch pieces",
    "2 teaspoons extra-virgin olive oil",
    "1 teaspoon minced garlic",
    "1 (14 ounce) package par-baked flatbread pizza crust",
    "1 cup shredded mozzarella cheese",
    "8 grape tomatoes, cut in half",
    "0.25 cup fresh basil leaves",
    "2 teaspoons balsamic glaze"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon pieces in a medium nonstick skillet over medium heat until cooked through and browned, 8 to 10 minutes. Transfer to a plate lined with a paper towel and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine olive oil and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flatbread on a baking sheet and brush with garlic oil. Sprinkle cheese evenly over flatbread. Top with cooked bacon and tomato halves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pizza for 10 minutes or until cheese is melted. Remove from oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place basil leaves on pizza. Drizzle balsamic glaze on top. Cut pizza into slices and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
