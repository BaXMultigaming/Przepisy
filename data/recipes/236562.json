  "ingredients": [
    "1 cup peeled and cubed sweet potato",
    "0.5 teaspoon coconut oil, melted",
    "1.5 teaspoons chopped fresh rosemary",
    "1.5 teaspoons chopped fresh thyme",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sweet potato cubes in a bowl. Drizzle coconut oil over potatoes and toss, using your hands, until each cube is coated. Spread sweet potato cubes onto a baking sheet; season with rosemary, thyme, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are softened, about 20 minutes.",
