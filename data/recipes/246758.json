  "ingredients": [
    "0.5 pound ground beef",
    "0.5 pound ground sausage",
    "0.5 cup diced onion",
    "6 cups chicken broth",
    "2 cups cubed potatoes",
    "1.5 cups finely chopped carrots",
    "2 cloves garlic, minced",
    "1 teaspoon dried parsley",
    "1 teaspoon dried basil",
    "salt and ground black pepper to taste",
    "1.5 cups milk",
    "2 tablespoons all-purpose flour",
    "0.5 cup sour cream",
    "2 cups cubed processed cheese food",
    "1 cup diced tomatoes"
  ],
  "steps": [
    {
      "text": "Combine beef, sausage, and onion in a large skillet over medium heat; cook and stir until browned, about 5 minutes. Drain off grease and transfer to a large pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir broth, potatoes, carrots, garlic, parsley, basil, salt, and black pepper into the beef mixture. Simmer over low heat, covered, until potatoes are tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix milk and flour together in a small bowl. Pour into the pot. Bring back up to a simmer until chowder flavors combine, about 5 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir processed cheese and sour cream into chowder when it is no longer boiling, to prevent curdling. Ladle into serving bowls and top each serving with some diced tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
