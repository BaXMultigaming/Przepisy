  "ingredients": [
    "2 cups water",
    "2 cups raisins",
    "1 cup light molasses",
    "1 cup white sugar",
    "0.66666668653488 cup shortening",
    "3 cups all-purpose flour",
    "1 tablespoon ground cinnamon",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 9-inch tube pan or two 8x4-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water, raisins, molasses, sugar, and shortening to a boil in a saucepan; reduce heat to low and simmer until raisins are plump, about 5 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cinnamon, and baking soda together in a bowl; stir into raisin mixture until well combined; pour into the prepared tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted near the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
