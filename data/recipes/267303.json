  "ingredients": [
    "1 medium red bell pepper, chopped",
    "0.25 cup apple cider vinegar",
    "0.25 cup chopped yellow onion",
    "2 tablespoons vegetable oil",
    "2 tablespoons honey",
    "0.5 teaspoon freshly grated ginger",
    "0.5 teaspoon garlic paste",
    "1 tablespoon vegetable oil",
    "2 peaches, each cut into 8 wedges",
    "0.5 pound kale leaves, veins removed",
    "0.33333334326744 cup goat cheese",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine red bell pepper, vinegar, onion, oil, honey, ginger, and garlic paste in a jar with a lid. Cover jar, shake, and refrigerate dressing 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place peaches and kale leaves on the preheated grill. Toss kale continuously until softened and lightly charred on the edges, about 5 minutes. Cook and turn peaches until grill marks appear, about 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cooked kale in a serving bowl and toss with dressing. Top with cooked peaches and goat cheese. Season with salt and pepper. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
