  "title": "Fried Stuffed Squash Blossoms",
  "description": "These fried squash blossoms from Chef John are filled with goat cheese and Gruyère, then dipped in a light batter and fried until irresistibly crispy and delicious.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2013-09-19T20:44:40-04:00",
  "date_modified": "2026-08-21T11:35:37-04:00",
  "prep_time": "PT20M",
  "cook_time": "PT10M",
  "total_time": "PT60M",
  "yield": [
    "12",
    "12 filled squash blossoms"
  ],
  "categories": [
    "Snack",
