  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups rolled oats",
    "1.5 cups brown sugar",
    "0.5 teaspoon salt",
    "1 teaspoon baking soda",
    "1.5 cups butter, melted",
    "2 cups semisweet chocolate chips",
    "1 (12 ounce) jar caramel ice cream topping",
    "6 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J5xSNWhGJOOYwz11Lhi5Cxo0Lvk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25797-granny-mabels-best-bar-cookies-PICS-step-01-cbc39c089d0b4ba4908f5ae38dd3d8ac.jpg"
      ],
      "image": "assets/images/25797/step_01.webp"
    },
    {
      "text": "Stir flour, oats, brown sugar, salt, and baking soda together in a large bowl. Mix in melted butter until evenly combined. Press half of the mixture into the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZeO9-cXsX-oxGznjomTUk3ph4gQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25797-granny-mabels-best-bar-cookies-PICS-step-02-8396aa93f93b4032822fe320dcd19ae0.jpg"
      ],
      "image": "assets/images/25797/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until lightly toasted, about 10 minutes. Remove from the oven and immediately sprinkle with chocolate chips. Let stand until the chocolate chips soften slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SucmdtCqCyaQ2aT6LcSD_ubFoMA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25797-granny-mabels-best-bar-cookies-PICS-step-03-c454b09e0d594c23867c4cf4ec84a338.jpg"
      ],
      "image": "assets/images/25797/step_03.webp"
    },
    {
      "text": "Mix caramel topping and flour together in a small bowl; drizzle evenly over the chocolate chips. Sprinkle the remaining crust mixture evenly over the caramel layer and press down lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xUVWmCoSb0S03wcvm2kxpUw2mJk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25797-granny-mabels-best-bar-cookies-PICS-step-04-4e3ba0d3006d4475bfa9aabcd37d4eb3.jpg"
      ],
      "image": "assets/images/25797/step_04.webp"
    },
    {
      "text": "Bake for 15 more minutes in the preheated oven. Allow to cool completely before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iXocCvdDnBZhKs3sc53SuM6NpUU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/25797-granny-mabels-best-bar-cookies-PICS-step-05-32a456f999bb44f1b62f771907468113.jpg"
      ],
      "image": "assets/images/25797/step_05.webp"
    }
  ],
