  "ingredients": [
    "1 cup white sugar",
    "2 eggs, lightly beaten",
    "0.5 cup chopped pecans",
    "0.5 cup all-purpose flour",
    "0.5 cup butter, melted",
    "1 cup semisweet chocolate chips",
    "1 (9 inch) pie shell"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooled melted butter or margarine and sugar, eggs, pecans, flour and chocolate chips; mix well. Pour the mixture into the unbaked pastry shell and bake in the preheated oven for about 1 hour. Let cool and serve.",
