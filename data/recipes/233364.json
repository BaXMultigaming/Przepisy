  "ingredients": [
    "1 cup white sugar",
    "0.5 cup water",
    "0.25 cup rose water",
    "3 saffron threads",
    "1 cup unsalted butter",
    "1.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Bring sugar and water to a boil in a saucepan; cook, stirring constantly, until sugar is dissolved, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rosewater and saffron into the sugar mixture; cover the saucepan and remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over low heat; stir flour into melted butter until mixture is a smooth paste. Continue to cook, stirring often, until paste turns golden, 5 to 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly whisk sugar mixture into paste until smooth. Remove the saucepan from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread halva evenly onto a plate or platter. Make a pattern on the top of halva using the back of a spoon or a knife. Cover with plastic wrap and refrigerate until set, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
