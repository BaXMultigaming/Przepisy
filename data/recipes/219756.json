  "ingredients": [
    "2 (3 ounce) fillets salmon, with skin",
    "sea salt to taste",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Rinse salmon fillets and pat dry thoroughly with paper towels; season with sea salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H48G5x6E6VpNOw_1xBVPIF9pJXY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219756-pan-fried-salmon-ddmfs-step-01-c2a6d95d8c27485d82ba4cabf711b64e.jpg"
      ],
      "image": "assets/images/219756/step_01.webp"
    },
    {
      "text": "Heat olive oil in a large skillet over medium-high heat.Cook salmon fillets, skin-side up, in hot oil until flesh is golden brown, 5 to 7 minutes; flip and continue cooking until skin is slightly browned, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oPK5siL1J5WAHCgUDXtGIyY-pjI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219756-pan-fried-salmon-ddmfs-step-02-3cd08c2105564cdda08d494034d677d7.jpg"
      ],
      "image": "assets/images/219756/step_02.webp"
    },
    {
      "text": "Use a slotted spatula to remove salmon, leaving drippings in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I1cSXheKtio2yIzJFxmgO3ny7XM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219756-pan-fried-salmon-ddmfs-step-03-bc39103504eb4594b445bf0efc07144f.jpg"
