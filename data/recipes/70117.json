  "title": "Cornish Hens the Easy Way",
  "description": "Learn how to cook Cornish hens with this easy recipe that seasons the hens with fresh lime, chili powder, and cumin before roasting for a special meal.",
  "authors": [
    "Mary Fortman"
  ],
  "date_published": "2018-03-21T12:35:55-04:00",
