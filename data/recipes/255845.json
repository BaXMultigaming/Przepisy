  "ingredients": [
    "2 tablespoons butter",
    "1 (1 ounce) square unsweetened chocolate",
    "0.5 cup milk",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour, sifted",
    "0.75 cup white sugar",
    "2 teaspoons baking powder",
    "0.125 teaspoon salt",
    "1 cup cold, strong, brewed coffee",
    "0.5 cup brown sugar",
    "0.5 cup white sugar",
    "0.25 cup unsweetened cocoa powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and unsweetened chocolate in a microwave-safe bowl; heat in the microwave until melted, 20 to 30 seconds. Stir milk and vanilla extract into chocolate mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, 3/4 cup white sugar, baking powder, and salt together in a separate bowl; stir in chocolate mixture until batter is smooth. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir coffee, brown sugar, 1/2 cup white sugar, and cocoa powder together in a bowl; pour over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Cool cake in the pan for 10 minutes. Turn cake onto a serving platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
