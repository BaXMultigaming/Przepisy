  "ingredients": [
    "1 quart oil for deep frying",
    "2 (8 ounce) packages cream cheese, softened",
    "1 (12 ounce) package imitation crabmeat",
    "2 tablespoons soy sauce",
    "2 teaspoons sesame oil",
    "1 tablespoon minced garlic",
    "3 tablespoons Worcestershire sauce",
    "1 bunch green onions, finely chopped",
    "1 (14 ounce) package wonton wrappers",
    "2 egg whites"
  ],
  "steps": [
    {
      "text": "Heat oil in a large, heavy saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together cream cheese, imitation crabmeat, soy sauce, sesame oil, garlic, Worcestershire sauce and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place approximately 1 teaspoon of the cream cheese mixture in the center of each wonton wrapper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place egg whites in a small bowl. Using the fingers, spread egg white over two edges of the wonton wrappers. Fold into triangles and press to seal edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In small batches, deep fry the wontons until golden brown, 2 to 4 minutes. Drain on paper towels and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
