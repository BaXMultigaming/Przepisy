  "ingredients": [
    "1 large yellow onion, chopped",
    "2 portobello mushroom caps, chopped",
    "2 pounds bone-in chicken pieces",
    "0.33333334326744 teaspoon garlic salt to taste",
    "0.33333334326744 teaspoon ground black pepper to taste",
    "2 large lemons, juiced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the chopped onion and mushrooms evenly in the bottom of a 9x13 inch baking dish. Arrange chicken pieces over the vegetables, skin side up. Squeeze lemon juice over the chicken pieces, and season with garlic salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake chicken uncovered for 20 minutes in the preheated oven. Carefully turn the pieces over, and continue cooking 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set oven to broil. Cook chicken for 5 minutes, or until chicken skin is crisp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
