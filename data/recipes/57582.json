  "ingredients": [
    "1 unbaked 9 inch pie crust",
    "0.75 cup sugar",
    "2 tablespoons all-purpose flour",
    "0.125 teaspoon salt",
    "1 cup sour cream",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "2 cups diced apples",
    "0.33333334326744 cup sugar",
    "0.33333334326744 cup all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.25 cup chilled butter, diced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Press pie crust into and up the sides of a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 3/4 cup sugar, 2 tablespoons flour, and salt in a medium bowl; stir in sour cream, egg, and vanilla until smooth. Add apples; stir to coat. Transfer to the prepared pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes, then reduce the temperature to 350 degrees F (175 degrees C). Continue baking 15 minutes more; leave oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine 1/3 cup flour, 1/3 cup sugar, and cinnamon in a medium bowl; cut in butter with two knives or pastry blender until mixture resembles fine crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover top of pie with crumb topping; continue baking until topping is lightly browned and apples are tender, about 15 minutes more. Cool pie, then refrigerate until chilled before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
