    "publisher-tested"
  ],
  "ingredients": [
    "4 slices bacon, cut into 1/2-inch pieces",
    "3.5 pounds beef short ribs",
    "salt and ground black pepper to taste",
    "6 sprigs fresh thyme, leaves stripped",
    "1 bay leaf",
    "1 onion, diced",
    "3 cloves garlic, minced",
    "2 tablespoons all-purpose flour",
    "1 cup dry sherry",
    "1 quart beef broth"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EaE_9B64yfXJ-gMkcpiFIa_LgPA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237320-Sherry-Braised-Short-Rib-ddmfs-step-1-311-fb6b32fb8e364da7be21cf1e0669e243.jpg"
      ],
      "image": "assets/images/237320/step_01.webp"
    },
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Transfer bacon to a Dutch oven with a slotted spoon. Reserve drippings in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O305a17IUOSxz7gsTyOvFqtuscU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237320-Sherry-Braised-Short-Rib-ddmfs-step-2-314-ab0a508023bb4dd689cd2f346bc049c4.jpg"
      ],
      "image": "assets/images/237320/step_02.webp"
    },
    {
      "text": "Generously season short ribs with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/17EndFElQOwnHLbvP4e8iBTbxEY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237320-Sherry-Braised-Short-Rib-ddmfs-step-3-316-0297937d7452439cb273b73b2ac3c958.jpg"
      ],
      "image": "assets/images/237320/step_03.webp"
    },
    {
      "text": "Heat drippings in the skillet over high heat; add short ribs. Cook until browned and caramelized on all sides, 3 to 5 minutes per side. Transfer ribs to a Dutch oven; reserve drippings in the skillet. Add thyme and bay leaf to the Dutch oven. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X2Cl9-3CfhF21KzhZ9n4SX0OF48=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237320-Sherry-Braised-Short-Rib-ddmfs-step-4-317-831d8d7cb2164293aba510658d18fbf5.jpg"
      ],
      "image": "assets/images/237320/step_04.webp"
    },
    {
      "text": "Reduce heat to medium. Add onion to the skillet; cook and stir until soft and golden, 5 to 10 minutes. Add garlic; cook and stir until fragrant, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l0zDi8eEwXpzs-5yp6etcwbiUwo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237320-Sherry-Braised-Short-Rib-ddmfs-step-5-318-124d4df91c3f49bc83812fe70b5f4042.jpg"
      ],
      "image": "assets/images/237320/step_05.webp"
    },
    {
      "text": "Whisk flour into onion mixture; stir until mixture becomes paste-like and light golden brown, 1 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5se3YHeRVsCeDB5IEElmU7xCS_I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237320-Sherry-Braised-Short-Rib-ddmfs-step-6-319-de0801d405b440d0ae29a430e372fc92.jpg"
      ],
      "image": "assets/images/237320/step_06.webp"
    },
    {
      "text": "Pour sherry into onion mixture; cook until thick and hot, about 2 minutes. Pour onion-sherry mixture into the Dutch oven; add beef broth and season with salt. Bring to a simmer; cover the Dutch oven with a lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tIM_Wls__3xT0rip5feqhQXLmys=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237320-Sherry-Braised-Short-Rib-ddmfs-step-7-320-5292c032053e44d0a25e293bd6c91164.jpg"
      ],
      "image": "assets/images/237320/step_07.webp"
    },
    {
      "text": "Transfer Dutch oven to the preheated oven; cook until short ribs are fork-tender, about 2 hours. Transfer ribs to a serving dish; reserve sauce in the Dutch oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p61MwYkuvGA3ttQjZ3HV12avkuA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237320-Sherry-Braised-Short-Rib-ddmfs-step-8-394-98085b5312ba4ffa9b897f1a75112d3d.jpg"
      ],
      "image": "assets/images/237320/step_08.webp"
    },
    {
      "text": "Set Dutch oven over high heat; boil sauce until reduced and slightly thickened, about 10 minutes. Spoon reduced sauce over ribs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P-Ka6rUcPZ2dSUZMjvT41Q2W0tA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237320-Sherry-Braised-Short-Rib-ddmfs-step-9-400-b0bbde847b6444f182929f78f90c8e21.jpg"
      ],
      "image": "assets/images/237320/step_09.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1praelT6mj4rnHLjqzswVqP6Di8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/237320-Sherry-Braised-Short-Rib-ddmfs-3x4-440-131e84a2c85b409685ddc4e5c3c89dd6.jpg"
      ],
      "image": "assets/images/237320/step_10.webp"
    }
  ],
