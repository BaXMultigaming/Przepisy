  "ingredients": [
    "4 cups chopped fresh rhubarb",
    "1 pint strawberries, hulled and sliced",
    "1 tablespoon honey",
    "1 cup rolled oats",
    "0.5 cup packed brown sugar",
    "1 teaspoon ground cinnamon",
    "0.25 cup butter, cut into pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rhubarb, strawberries, and honey together in a medium bowl; transfer to a shallow baking dish. Stir oats, brown sugar, and cinnamon together in the same bowl. Mix in butter with a pastry blender until crumbly; spread on top of fruit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, until rhubarb is tender and the topping is toasted, about 40 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
