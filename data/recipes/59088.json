  "ingredients": [
    "1 cup chicken broth",
    "1 tablespoon minced garlic",
    "2 artichoke hearts, sliced into eighths",
    "1.5 tablespoons lemon juice",
    "1.5 tablespoons chopped capers",
    "2 tablespoons butter",
    "2 tablespoons cold water",
    "1 tablespoon cornstarch"
  ],
  "steps": [
    {
      "text": "Bring chicken broth and garlic to a boil in a small saucepan over high heat. Reduce the heat to medium to simmer. Stir in artichoke hearts, lemon juice, and capers; simmer for 3 minutes. Add butter and whisk until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk water and cornstarch together in a small bowl; stir mixture into the sauce and continue cooking until thickened and bubbly, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
