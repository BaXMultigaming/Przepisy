  "ingredients": [
    "1 pound dried chile de arbol peppers, stemmed",
    "4 cups grapeseed oil"
  ],
  "steps": [
    {
      "text": "Inspect twelve 4-ounce jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water for 1 to 2 minutes. Remove from water and dry thoroughly. Wash 12 new, unused lids and rings in warm soapy water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pulse peppers in a food processor until chopped into small pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each jar 3/4 full with chopped peppers, then fill with grapeseed oil to about 1/4 inch below the rim. Stir contents of each jar carefully. Top with lids and screw rings on tightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let sit for at least 8 hours before using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shake each jar before opening to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
