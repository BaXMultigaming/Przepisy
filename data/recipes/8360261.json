  "title": "Homemade Chili Oil",
  "description": "Use this homemade chili oil for cooking or to add a spicy flavor to soups, chili, or other meals. Perfect for gifting!",
  "authors": [
    "zackmania"
  ],
  "date_published": "2022-03-09T10:30:11-05:00",
