  "ingredients": [
    "0.5 cup unsweetened applesauce",
    "0.5 cup white sugar",
    "3 cups old-fashioned oats",
    "1.25 cups 2% milk",
    "2 large eggs, beaten",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 over-ripe banana, mashed",
    "2 teaspoons packed brown sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat applesauce and white sugar together in a bowl. Add oats, milk, eggs, baking powder, and salt to applesauce mixture; beat until evenly mixed. Stir banana into oat mixture. Pour batter into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar and cinnamon together in a small bowl; sprinkle mixture over banana batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm, 30 to 35 minutes. Cool for 5 minutes before slicing into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
