  "ingredients": [
    "2.25 cups all-purpose flour",
    "0.5 cup cocoa powder, or more to taste",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "0.5 cup butter, softened",
    "0.5 cup shortening",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "1 cup semi-sweet chocolate chips, or more to taste",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, cocoa powder, salt, and baking soda together in a large bowl. Whisk white sugar, brown sugar, butter, shortening, eggs, and vanilla extract together in a separate bowl until smooth. Stir sugar mixture into flour mixture until just combined. Fold in chocolate chips and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter, 1 to 2 tablespoons per cookie, onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are browned, 10 to 15 minutes. Cool cookies for 5 minutes on the baking sheet before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
