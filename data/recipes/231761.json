  "ingredients": [
    "1 cup fat free raspberry-flavored yogurt",
    "3 tablespoons vanilla extract",
    "3 tablespoons canola oil",
    "3.25 cups bread flour",
    "1 teaspoon salt",
    "2 tablespoons white sugar",
    "2.25 teaspoons active dry yeast",
    "1 tablespoon water"
