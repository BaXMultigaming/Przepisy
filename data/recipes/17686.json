  "title": "Pineapple Carrot Quick Bread",
  "description": "You won't need to grate carrots by hand for this recipe, because the wet ingredients are combined in the blender.",
  "authors": [
    "Clare Koehler"
  ],
  "date_published": "2000-01-29T02:09:34-05:00",
