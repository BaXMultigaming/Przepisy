  "ingredients": [
    "8 ounces macaroni",
    "2 tablespoons butter",
    "2.5 tablespoons chopped onion",
    "16 ounces cubed processed cheese food",
    "0.75 cup milk",
    "salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Cook macaroni pasta in boiling water until al dente, 8 to 10 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter and onions in a 2-quart microwave-safe covered casserole dish; cook on high in the microwave for 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pasta, cubed cheese, and milk to the casserole dish; stir. Cook on high in the microwave for 11 to 12 minutes, stirring well after 4, 8, and 11 minutes. Mixture will still be runny at this stage. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let stand for 5 to 8 minutes before serving; sauce will thicken as it cools.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
