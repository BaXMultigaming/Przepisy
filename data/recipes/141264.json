  "ingredients": [
    "2 tablespoons olive oil",
    "3 cloves garlic, minced",
    "0.5 onion, chopped",
    "1.5 teaspoons ground ginger",
    "2 teaspoons red pepper flakes",
    "1 red bell pepper, chopped",
    "0.5 zucchini, halved lengthwise and sliced",
    "3 cups fresh mushrooms, coarsely chopped",
    "2 tablespoons cornstarch",
    "0.5 cup honey",
    "1 pound medium shrimp - peeled and deveined",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a wok or large skillet over high heat until it begins to smoke. Stir in garlic, onion, ginger, and red pepper flakes. Quickly cook until the onion softens and just begins to brown. Stir in bell pepper, zucchini, and mushrooms; continue cooking until the zucchini softens, about 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cornstarch into honey until smooth, then add to vegetables, and simmer until thickened, about 2 minutes. Add shrimp, and cook until they turn pink, about 3 minutes. Season to taste with salt and pepper before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
