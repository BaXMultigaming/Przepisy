  "ingredients": [
    "1 (9 inch) unbaked pie crust",
    "1 cup evaporated milk",
    "1 cup canned pumpkin",
    "0.75 cup white sugar",
    "3 eggs",
    "0.25 cup maple syrup",
    "0.25 teaspoon maple-flavored extract",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a 9-inch pie plate with pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine evaporated milk, pumpkin, sugar, eggs, maple syrup, maple extract, cinnamon, salt, vanilla extract, and nutmeg in a bowl. Mix until well blended using an electric mixer. Pour into the pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Reduce heat to 325 degrees F (165 degrees C) and continue baking until a knife inserted into the pie comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
