  "ingredients": [
    "0.75 cup milk",
    "0.33333334326744 cup vegetable oil",
    "1 egg",
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "3 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.75 cup mini semi-sweet chocolate chips",
    "3 tablespoons white sugar",
    "2 tablespoons brown sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_93YjHewuKN3fj8bX1VX_sI40lA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7906-chocolate-chip-muffins-DDMFS-4x3-step-01-55073dfd770f446084af6f1c99c8977a.jpg"
      ],
      "image": "assets/images/7906/step_01.webp"
    },
    {
      "text": "Combine milk, oil, and egg in a small bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LD-szeloGBVrRbptNeH5KJFlWJo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7906-chocolate-chip-muffins-DDMFS-4x3-step-03-2e6a7c6bfe3a42b094c78f20ef12f5dd.jpg"
      ],
      "image": "assets/images/7906/step_02.webp"
    },
    {
      "text": "Combine flour, 1/2 cup sugar, baking powder, and salt together in a large bowl, making a well in the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yj7Y4l7eQZZRoi00oIYjGuug2tE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7906-chocolate-chip-muffins-DDMFS-4x3-step-05-23304bd48bb1426d9e3e5bdee0d85fea.jpg"
      ],
      "image": "assets/images/7906/step_03.webp"
    },
    {
      "text": "Pour milk mixture into well and stir until batter is just combined; fold in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Utupi9IOtzTtr9ntb533WXnYNa4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7906-chocolate-chip-muffins-DDMFS-4x3-step-07-b3218d013994493dae513262f3643ecd.jpg"
      ],
      "image": "assets/images/7906/step_04.webp"
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tmbgPdntmnPNpuCvPuCen_AxIX4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7906-chocolate-chip-muffins-DDMFS-4x3-step-09-2e21c356447044e7b6e191935c475ac6.jpg"
      ],
      "image": "assets/images/7906/step_05.webp"
    },
    {
      "text": "Combine 1 ½ tablespoons white sugar and 1 tablespoon brown sugar in a small bowl; sprinkle on tops of muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ikGtj1eGqWDLZ2RJDzU0ULoH7uE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7906-chocolate-chip-muffins-DDMFS-4x3-step-10-1bdc2fbd7511444b973e43c5200923c7.jpg"
      ],
      "image": "assets/images/7906/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c4qdYf7-D3XF4CILG_XVeTl1kUg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7906-chocolate-chip-muffins-DDMFS-4x3-step-11-efb81bc6733b4181b85dcd9d7984304b.jpg"
      ],
      "image": "assets/images/7906/step_07.webp"
    },
    {
      "text": "Cool in the tin briefly, then transfer to a wire rack. Serve warm or cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3BEjl5t-1wol60cEIiW3r_BzaYY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-7906-chocolate-chip-muffins-DDMFS-4x3-69048f49ea934213a0d1a0059b85fd9b.jpg"
      ],
      "image": "assets/images/7906/step_08.webp"
    }
