  "title": "Cranberry Linzer Cookies",
  "description": "Tender Linzer-style cookies sandwiched together with homemade cranberry jam for an American twist on the classic cookie.",
  "authors": [
    "larkspur"
  ],
  "date_published": "2009-11-18T08:58:38-05:00",
