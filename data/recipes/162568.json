  "ingredients": [
    "2 (10 ounce) bags pre-washed fresh spinach",
    "2 tablespoons garlic, minced",
    "5 tablespoons butter",
    "2 tablespoons lemon juice"
  ],
  "steps": [
    {
      "text": "Rinse the spinach and place the leaves into a microwavable serving dish. Add the butter, garlic and lemon juice. Cover with plastic wrap. Steam in the microwave until the butter is melted and spinach is wilted, about 2 minutes. Remove the plastic wrap and toss to distribute seasoning before serving.",
