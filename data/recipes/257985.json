  "ingredients": [
    "1 cup cornmeal",
    "1 cup all-purpose flour",
    "0.33333334326744 cup white sugar",
    "2.5 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 cup buttermilk",
    "6 tablespoons unsalted butter, melted",
    "1 egg, beaten",
    "1.5 cups fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
