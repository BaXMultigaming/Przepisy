  "title": "Twice Baked Sweet Potatoes",
  "description": "Sweet potatoes are baked and the flesh is combined with cream cheese, brown sugar, margarine, vanilla extract and walnuts. Then the skins are filled with the mixture and baked again.",
  "authors": [
    "SDELATORE"
  ],
  "date_published": "2020-03-04T23:56:17-05:00",
