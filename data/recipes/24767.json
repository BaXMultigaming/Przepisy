  "ingredients": [
    "6 sweet potatoes",
    "2 tablespoons salad oil",
    "1 (8 ounce) package cream cheese, softened",
    "0.33333334326744 cup brown sugar",
    "2 tablespoons margarine",
    "1 tablespoon vanilla extract",
    "0.75 teaspoon salt",
    "0.5 teaspoon pepper",
    "0.33333334326744 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub sweet potato skins with salad oil. Wrap potatoes in aluminum foil and bake in preheated oven for 1 hour, or until soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in a large bowl combine cream cheese, brown sugar, margarine, vanilla, salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut potatoes in half and scoop flesh into the bowl with the other ingredients. Mix well and fold in walnuts. Spoon mixture into potato skins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 5 minutes, or until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
