  "ingredients": [
    "1.5 cups whole wheat flour",
    "3.5 teaspoons baking powder",
    "1 tablespoon white sugar",
    "1 teaspoon salt",
    "1.25 cups milk",
    "1 large egg",
    "3 tablespoons unsalted butter, melted",
    "0.5 cup sliced fresh strawberries"
