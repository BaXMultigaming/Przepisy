  "ingredients": [
    "0.5 cup butter",
    "1 (4.5 ounce) can mushrooms, drained, liquid reserved",
    "1 green bell pepper, chopped",
    "0.5 cup all-purpose flour",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1.5 cups milk",
    "1.25 cups hot water",
    "1.5 teaspoons chicken bouillon powder",
    "4 cooked, boneless chicken breast halves, chopped",
    "4 ounces chopped pimento"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1LTGjLJ1AvaRYQtFX0-JQMOVPS8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8564-chicken-a-la-king-Step-01-8e36630c3d014a23a7ea82dc38826667.jpg"
      ],
      "image": "assets/images/8564/step_01.webp"
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add drained mushrooms and bell pepper and cook, stirring, 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AWBzDlMYG_9oog0yIn029P6wyWA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8564-chicken-a-la-king-Step-03-abc64da0ed9948d59eec968ea0c10b49.jpg"
      ],
      "image": "assets/images/8564/step_02.webp"
    },
    {
      "text": "Remove from the heat. Stir in flour, salt, and black pepper. Cook over low heat, stirring constantly, until mixture is bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xlOOGgcrM39esweSpwkesfNRIJE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8564-chicken-a-la-king-Step-04-a8263ec68ed5421e9d3188462ad0ac51.jpg"
      ],
      "image": "assets/images/8564/step_03.webp"
    },
    {
      "text": "Stir in milk, water, bouillon, and reserved mushroom liquid. Increase heat to medium-high and bring to a boil, stirring constantly. Boil and stir for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/45mp6AFsYffWGYChEF4gaoyzl3c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8564-chicken-a-la-king-Step-06-f3cc34ae1d7a4e968123468a1eda81f4.jpg"
      ],
      "image": "assets/images/8564/step_04.webp"
    },
    {
      "text": "Stir in chicken and pimento and heat through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/siiy8nVOI4sn4ObgQXOKlP6seFc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8564-chicken-a-la-king-Step-08-d0a7068fd29c4a429b8db78444e91e90.jpg"
      ],
      "image": "assets/images/8564/step_05.webp"
