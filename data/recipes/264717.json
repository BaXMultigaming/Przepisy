  "ingredients": [
    "7 cups fresh blueberries",
    "0.5 cup sugar",
    "3 tablespoons lemon juice",
    "2 tablespoons cornstarch",
    "Finely grated zest of 1 lemon",
    "1.5 cups all-purpose flour",
    "3 tablespoons sugar",
    "2.25 teaspoons baking powder",
    "0.25 teaspoon salt",
