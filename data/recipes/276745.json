  "ingredients": [
    "1 cup yellow lentils",
    "1 cup uncooked white rice",
    "1 tablespoon olive oil",
    "2 small carrots, diced",
    "1 stalk celery, diced",
    "0.5 onion, diced",
    "1.5 teaspoons ground coriander",
    "1.5 teaspoons salt",
    "1 teaspoon ground thyme",
    "0.5 teaspoon dried rosemary",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon chili powder",
    "8 cups water",
    "1 lemon, zested and juiced, divided"
  ],
  "steps": [
    {
      "text": "Soak lentils and rice in cold water to cover for at least 30 minutes. Rinse and drain. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot®) and select Saute function. Add oil and saute carrots, celery, and onion until softened, 5 to 7 minutes. Stir in coriander, salt, thyme, rosemary, pepper, and chili powder. Stir in drained rice and lentils. Pour in water; add lemon zest. Close and lock the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Select high pressure according to manufacturer's instructions; set timer for 12 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions for 5 minutes. Unlock and remove the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in lemon juice. Taste and adjust seasonings. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
