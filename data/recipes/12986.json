  "ingredients": [
    "2 large tomatoes, chopped",
    "0.5 cup chopped onion",
    "0.5 teaspoon white sugar",
    "salt and ground black pepper to taste",
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "2 cups milk"
  ],
  "steps": [
    {
      "text": "Bring tomatoes, onion, sugar, salt, and pepper to a simmer in a saucepan over medium heat; cook until onion is soft, 5 to 10 minutes. Strain broth into a bowl; discard any solids.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium-low heat. Stir in flour and cook until fragrant, about 3 minutes. Slowly whisk in milk and cook until thickened, 5 to 7 minutes. Stir in strained tomato broth and cook until heated through, 5 to 6 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
