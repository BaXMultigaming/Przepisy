  "ingredients": [
    "2 cups milk",
    "0.25 cup white sugar",
    "2 egg yolks",
    "1 egg",
    "0.33333334326744 cup white sugar",
    "0.25 cup cornstarch",
    "2 tablespoons butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KaodzG0v_Sc33bWRLQWQbLP30u8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-76043-pastry-cream-DDMFS-step-01-76f05b2b159a418b93dad0aded4ae891.jpg"
      ],
      "image": "assets/images/76043/step_01.webp"
    },
    {
      "text": "Stir together milk and 1/4 cup sugar in a heavy saucepan. Bring to a boil over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/miigqMBZCpXNjVVi6-Bi1HW6EU8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-76043-pastry-cream-DDMFS-step-02-77360d654e144ad5a485baf61762f8ac.jpg"
      ],
      "image": "assets/images/76043/step_02.webp"
    },
    {
      "text": "Whisk together egg yolks and egg in a medium bowl. Stir together 1/3 cup sugar and cornstarch in a separate bowl; stir into eggs until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GXpfgnGoPvMjrcjsNrz427p0z0o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-76043-pastry-cream-DDMFS-step-03-9c992b8df2fd40719dfec9392c5c00e7.jpg"
      ],
      "image": "assets/images/76043/step_03.webp"
    },
    {
      "text": "Pour boiled milk into egg mixture in a thin stream while mixing so eggs do not cook.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nNhWPEZKgbX94T1ShOVTQj04Zak=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-76043-pastry-cream-DDMFS-step-04-bc7ea55dba9948a4bf37e5bd016f9506.jpg"
      ],
      "image": "assets/images/76043/step_04.webp"
    },
    {
      "text": "Return egg mixture to the saucepan; slowly bring to a boil, stirring constantly to prevent curdling and scorching.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jIiWRSn1L7bpS_Dz5ieEyeNVy7o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-76043-pastry-cream-DDMFS-step-05-bb2e37cb2e8e40adb42b64a8cbf915eb.jpg"
      ],
      "image": "assets/images/76043/step_05.webp"
    },
    {
      "text": "When mixture thickens, remove from the heat and stir in butter and vanilla until thoroughly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Dj8r5b2c14t_rsO2vStJDrVMnHo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-76043-pastry-cream-DDMFS-step-06-16cbc512dbdf4614a6ec481275b07fb5.jpg"
      ],
      "image": "assets/images/76043/step_06.webp"
    },
    {
      "text": "Pour into a heat-proof container; place a piece of plastic wrap directly on the surface to prevent a skin from forming. Refrigerate until chilled before using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Gyr9Rt1uYdQcQfUFXr4DTRFWBs8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-76043-pastry-cream-DDMFS-step-07-a052c3e4f7c64c848ae958f59234eafd.jpg"
      ],
      "image": "assets/images/76043/step_07.webp"
    }
