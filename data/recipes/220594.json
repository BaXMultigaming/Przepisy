  "ingredients": [
    "oil for frying",
    "2 cups bitter ale (such as Goose Island Honkers Ale®)",
    "1.75 cups all-purpose flour",
    "0.5 cup sesame seeds",
    "2 tablespoons cornstarch",
    "1 tablespoon baking powder",
    "3 large portobello mushroom caps, cut into 1/2-inch slices"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk ale, flour, sesame seeds, cornstarch, and baking powder together in a large bowl; batter will be thick and slightly lumpy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip mushroom strips into batter, 7 to 8 at a time; shake off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lower mushroom strips carefully into the hot oil in batches. Fry until golden brown, 5 to 6 minutes. Transfer to a paper towel-lined plate to drain. Repeat with remaining mushroom strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
