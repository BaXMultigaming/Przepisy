  "ingredients": [
    "4 medium skinless, boneless chicken breasts, cubed",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 (10.75 ounce) can condensed cream of celery soup",
    "3 cups frozen mixed vegetables",
    "2 teaspoons seasoned salt",
    "1 teaspoon ground white pepper",
    "1 teaspoon onion powder",
    "1 teaspoon garlic powder",
    "3.5 cups milk"
  ],
  "steps": [
    {
      "text": "Combine chicken, condensed soups, frozen vegetables, seasoned salt, white pepper, onion powder, and garlic powder in a large bowl; stir until it is mixed well. Add milk slowly, while stirring, until fully incorporated. Pour into the bottom of a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until chicken is no longer pink in the centers and flavors have melded, 4 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
