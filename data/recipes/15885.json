  "ingredients": [
    "3 tablespoons all-purpose flour",
    "3 tablespoons brown sugar",
    "1 (9 inch) pie shell",
    "5 large fresh peaches - peeled, pitted and halved",
    "1.5 cups evaporated milk",
    "1 egg, beaten",
    "0.66666698455811 cup white sugar",
    "2 teaspoons ground cinnamon",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 3 tablespoons flour and brown sugar in a small bowl; sprinkle into pie shell. Arrange peach halves, cut-sides up, in pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk evaporated milk and egg together in a medium bowl until well combined; pour over peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, remaining 2 tablespoons flour, cinnamon, and nutmeg in a separate bowl; sprinkle over pie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted 1 inch from the edge comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
