  "ingredients": [
    "2 pounds carrots, peeled and chopped",
    "0.5 cup margarine",
    "3 eggs",
    "0.75 cup brown sugar",
    "0.25 cup flour",
    "1.5 teaspoons baking powder",
    "0.75 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a stockpot of salted water to a boil. Cook carrots until tender, 10 to 15 minutes. Remove from heat, and drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place carrots in a food processor with the margarine, and pulse to puree. Add the eggs, brown sugar, flour, baking powder, and baking soda, and process until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour carrot mixture into a 1quart, round baking dish. Place the dish inside a larger dish with 1 inch of water to prevent burning bottom of casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven for 1 hour, or until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
