  "ingredients": [
    "1 (64 fluid ounce) bottle hot pepper sauce (such as Tabasco®)",
    "0.5 cup butter",
    "0.25 cup ground cumin",
    "0.25 cup chili powder",
    "1 tablespoon red pepper flakes",
    "1 tablespoon ground white pepper",
    "1 fresh tabasco chile pepper"
