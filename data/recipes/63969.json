  "ingredients": [
    "1 (14 ounce) can EAGLE BRAND® Sweetened Condensed Milk",
    "0.5 cup unsweetened cocoa",
    "1.5 teaspoons vanilla extract",
    "0.125 teaspoon salt",
    "6.5 cups hot water",
    "3 Mini marshmallows"
  ],
  "steps": [
    {
      "text": "Combine sweetened condensed milk, cocoa, vanilla, and salt in a large saucepan over medium heat; mix well. Slowly stir in hot water; cook until heated through, stirring occasionally. Do not boil. Top with marshmallows. Store covered in the refrigerator.",
