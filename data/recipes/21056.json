  "ingredients": [
    "18 (1 ounce) slices white bread, cubed",
    "8 ounces cooked ham, cubed",
    "2 cups shredded Cheddar cheese",
    "1.5 cups diced Swiss cheese",
    "6 eggs",
    "3.5 cups milk",
    "0.5 teaspoon onion powder",
    "2 cups crushed cornflakes cereal",
    "0.5 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line the bottom of the prepared baking dish with 1/2 of the bread cubes. Sprinkle with ham, Cheddar cheese, and Swiss cheese, and top with remaining bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together eggs, milk, and onion powder in a large bowl. Pour evenly over bread. Cover and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend crushed cornflakes and melted butter in a small bowl. Spread evenly over casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and golden brown, about 40 minutes. Let stand 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
