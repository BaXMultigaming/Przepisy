  "title": "Ham and Cheese Breakfast Casserole",
  "description": "A hearty ham and cheese breakfast casserole with a crispy cornflake topping.",
  "authors": [
    "Kelly"
  ],
  "date_published": "2000-08-17T08:57:18-04:00",
