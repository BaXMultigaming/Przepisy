  "ingredients": [
    "2 small onions",
    "1 small red bell pepper, thinly sliced",
    "1 small yellow bell pepper, thinly sliced",
    "1 small orange bell pepper, thinly sliced",
    "2 tablespoons olive oil",
    "1 teaspoon Italian seasoning",
    "0.75 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 pound sweet Italian sausage links",
    "4 lightly toasted buns",
    "4 slices provolone cheese"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut onions in half from root to stem; cut each half into thirds. Combine onions and bell peppers in a medium bowl. Add olive oil, Italian seasoning, salt, and pepper; toss to combine. Transfer vegetables into the air fryer basket and set the sausage links on top without touching one another.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry for 15 minutes. Turn sausages and air fry for another 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place each sausage in a bun and top with vegetables and provolone cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
