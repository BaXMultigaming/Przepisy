  "ingredients": [
    "1 cup glutinous rice flour (malagkit)",
    "0.5 cup white sugar",
    "0.5 cup water",
    "0.5 cup white sugar",
    "2 tablespoons sesame seeds",
    "4 ounces grated coconut",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Mix the rice flour, 1/2 cup sugar, and the water together in a bowl into a soft dough; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir 1/2 cup sugar and sesame seeds together in a small bowl. Toss the coconut with the salt together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Take a portion of the soft dough and roll it into a ball between the palms of your hands. Pull lengthwise and shape into a tongue. Drop into the boiling water. The cake is ready when it floats. Scoop it out with a strainer and roll it in the sugar and sesame seed mixture. Place it on a serving platter. Repeat with the rest of the dough. Top the cakes with coconut and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
