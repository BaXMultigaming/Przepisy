  "title": "Hearty Meat Lasagna",
  "description": "This classic layered pasta, sauce and cheese dish gets a zesty boost with the addition of chunky, chili sauce.",
  "authors": [
    "Heinz"
  ],
  "date_published": "2011-06-01T17:28:17-04:00",
