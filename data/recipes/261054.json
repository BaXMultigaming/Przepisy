  "ingredients": [
    "0.5 cup prepared horseradish",
    "1 (12 count) package Hawaiian bread rolls, split",
    "12 slices deli roast beef",
    "12 slices deli-sliced Swiss cheese",
    "0.5 cup butter",
    "1 onion, finely chopped",
    "2 tablespoons brown sugar",
    "1 tablespoon spicy brown mustard",
    "1.5 teaspoons Worcestershire sauce",
    "1 pinch garlic powder, or to taste",
    "2 teaspoons poppy seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread horseradish on the bottoms of the Hawaiian bread rolls. Top each with 1 slice roast beef and 1 slice Swiss cheese, then cover with top bread rolls. Place sandwiches in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Wol0m0OdBk44uKJBcwEUHFuQePw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261054-Hawaiin-roll-roast-beef-and-cheese-sandwich-step3-4x3.2670-7112250ef2194d72a95214d501d3af82.jpg"
      ],
      "image": "assets/images/261054/step_02.webp"
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Cook and stir onion, brown sugar, spicy mustard, Worcestershire sauce, and garlic powder in butter until onion is soft and translucent, about 5 minutes. Pour over sandwiches and sprinkle rolls with poppy seeds. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6LBUyRuNZ6mfexJ7RLd7deWWa_Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261054-Hawaiin-roll-roast-beef-and-cheese-sandwich-step4-4x3.2682-8f640fddb15c4e6db805e39947d7637c.jpg"
      ],
      "image": "assets/images/261054/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until heated through, about 25 minutes. Remove foil and continue baking until tops are lightly browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XkKNlam1sA4eTL0l3qh-WkkQU9Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/261054-Hawaiin-roll-roast-beef-and-cheese-sandwich-step5-4x3.2690-f89ba8d4db7e42f6ac674a157b8f6e13.jpg"
      ],
      "image": "assets/images/261054/step_04.webp"
    }
  ],
