  "ingredients": [
    "1 tablespoon canola oil",
    "1 (16 ounce) package kielbasa sausage, sliced into 1/2 inch pieces",
    "1 red onion, chopped",
    "14 ounces baby Brussels sprouts, trimmed and cut in half",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add sausage and onion; cook and stir until onion is translucent, 8 to 10 minutes. Add Brussels sprouts; cook 10 minutes more. Season with salt and black pepper.",
