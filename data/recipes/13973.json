  "ingredients": [
    "0.75 cup white sugar",
    "1 teaspoon celery seed",
    "0.5 teaspoon ground black pepper",
    "1 cup distilled white vinegar",
    "0.25 cup canola oil",
    "1 teaspoon salt",
    "2 cups cucumbers, peeled and thinly sliced",
    "1 onion, sliced into thin rings",
    "2 cups thinly sliced carrots",
    "0.5 cup chopped celery"
  ],
  "steps": [
    {
      "text": "Combine sugar, celery seeds, black pepper, vinegar, oil, and salt in a screw-top jar. Shake well to mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine vegetables in large bowl. Pour dressing over vegetables, and stir gently. Cover, and refrigerate several hours or overnight.",
