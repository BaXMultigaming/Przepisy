    "2 tablespoons white sugar",
    "1 tablespoon freshly squeezed lemon juice"
  ],
  "steps": [
    {
      "text": "Rinse and drain blackberries. Place into a bowl. Add sugar and mix well. Let sit for 30 minutes to allow sugar to draw out blackberry juice.",
      "section": null,
      "name": null,
      "url": null,
