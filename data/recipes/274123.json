  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup whole wheat flour",
    "0.25 cup quick-cooking oats, or to taste",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "4 ripe bananas",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "0.25 cup margarine",
    "0.25 cup milk",
    "1 teaspoon vanilla extract",
    "0.5 cup raisins, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flours, oats, baking soda, cinnamon, and salt in a medium bowl. Mash bananas into the dry ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugars and margarine in a large bowl; beat with an electric mixer until creamy. Mix in milk and vanilla extract. Add the flour mixture and raisins; mix well. Pour batter into 4 mini silicone loaf pans. Place loaf pans on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
