  "ingredients": [
    "1 cup butter, softened",
    "0.25 cup milk",
    "1 teaspoon vanilla extract",
    "2.25 cups all-purpose flour",
    "0.75 cup brown sugar",
    "0.75 cup white sugar",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup chocolate chips",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Mix butter, milk, and vanilla extract together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, white sugar, baking soda, and salt in a separate bowl; slowly mix into butter mixture, beating on low speed with an electric mixer until dough is just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold chocolate chips and walnuts into dough; drop by rounded tablespoon onto waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
