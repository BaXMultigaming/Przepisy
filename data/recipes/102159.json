  "ingredients": [
    "1 (10 pound) fully-cooked spiral cut ham",
    "0.66666668653488 cup brown sugar",
    "0.33333334326744 cup apricot jam",
    "1 teaspoon dry mustard powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ham cut-side down onto a sheet of aluminum foil. Mix brown sugar, apricot jam, and mustard powder together in a small bowl. Brush onto ham using a pastry or barbeque brush. Reserve any leftover glaze. Enclose foil around ham and place on a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast for 2 hours in the preheated oven, or if your ham is a different size, figure 14 minutes per pound. Apply the remaining glaze 20 minutes before the ham is done.",
      "section": null,
      "name": null,
      "url": null,
