  "title": "Malaysian Nasi Lemak",
  "description": "Nasi lemak is Malaysian coconut rice served with hot chile sauce, fried anchovies, fried peanuts, sliced cucumber or tomato, and hard-boiled egg.",
  "authors": [
    "Tuty Jek"
  ],
  "date_published": "2020-06-18T23:11:40-04:00",
