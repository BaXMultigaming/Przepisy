  "ingredients": [
    "1 cup butter, softened",
    "1 cup white sugar",
    "1 cup brown sugar",
    "2 eggs",
    "1 tablespoon instant coffee granules",
    "2 teaspoons vanilla extract",
    "1.75 cups all-purpose flour",
    "0.66666668653488 cup cocoa powder",
    "1 tablespoon ground cinnamon",
    "1 teaspoon cayenne pepper, or more to taste",
    "0.25 teaspoon salt",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon cream of tartar",
    "0.25 teaspoon chili powder",
    "1 cup sweetened flaked coconut",
    "2 cups milk chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, brown sugar, eggs, instant coffee, and vanilla extract together in a large bowl using an electric mixer until fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cocoa powder, cinnamon, cayenne pepper, salt, baking powder, cream of tartar, and chili powder in a separate bowl. Stir flour mixture into the butter mixture slowly until blended. Fold in coconut and chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter by teaspoonfuls onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 10 to 12 minutes. Cool slightly on the baking sheet before transferring to a rack to cool completely, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
