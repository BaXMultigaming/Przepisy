  "ingredients": [
    "2 cups frozen wild blueberries",
    "0.5 cup orange juice",
    "2 tablespoons fresh lemon juice",
    "1 teaspoon lemon zest",
    "0.25 teaspoon ground cinnamon",
    "0.25 cup water",
    "4 teaspoons cornstarch",
    "2 tablespoons dark brown sugar"
  ],
  "steps": [
    {
      "text": "Bring the blueberries, orange juice, and lemon juice to a boil in a small saucepan over medium heat. Stir in the lemon zest and cinnamon; adjust heat to low setting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together the water and cornstarch until there are no lumps. Stir the cornstarch mixture and brown sugar into the blueberry mixture until thickened. Remove from heat and allow to rest for 10 minutes before using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
