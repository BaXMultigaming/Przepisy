  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 1/2 cups flour, 1/3 cup powdered sugar, and butter in a bowl. Pat dough into the prepared pan to form a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake crust in the preheated oven for 20 minutes. Remove from the oven and leave oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk white sugar, eggs, lemon juice, and 3 tablespoons flour together in a bowl and pour filling over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the hot oven until set, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven and cool completely, about 30 minutes. Dust with powdered sugar and cut into 16 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
