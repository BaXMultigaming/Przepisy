  "ingredients": [
    "1 (20 ounce) can crushed pineapple, drained",
    "2 (8 ounce) packages cream cheese, softened",
    "1 cup minced celery",
    "0.5 cup chopped green bell pepper",
    "1 teaspoon minced onion",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Mix drained pineapple, cream cheese, celery, bell pepper, and onion together in a medium bowl until well combined. Divide mixture in half and form into two balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chopped pecans in a shallow dish. Roll each cheese ball in pecans to coat. Cover and chill for at least 2 hours or until firm.",
