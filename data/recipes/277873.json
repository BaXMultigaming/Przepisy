  "ingredients": [
    "2 cups small pretzels",
    "2 cups crispy rice cereal squares (such as Rice Chex®)",
    "1 (12.4 ounce) package cheese-flavored crackers (such as Cheez-It®)",
    "1 cup honey-roasted peanuts",
    "4 tablespoons vegetable oil, or more as needed",
    "3 tablespoons barbeque seasoning",
    "1.5 teaspoons ground paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pretzels, rice cereal squares, cheese-flavored crackers, and peanuts in a large bowl; drizzle oil over top and gently stir with your hands until well coated, adding more oil, if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine BBQ seasoning and paprika in a small bowl; sprinkle over snack mixture, tossing gently until coated. Spread mixture onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 to 20 minutes, stirring halfway through. Cool before serving or storing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
