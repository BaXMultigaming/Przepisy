  "ingredients": [
    "1 pound ground beef",
    "1 (8 ounce) package cream cheese, room temperature",
    "1 (8 ounce) jar prepared salsa",
    "1 (1 pound) loaf processed cheese food, sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the ground beef in a large skillet over medium-high heat. Cook, stirring to crumble, until no longer pink. Drain off grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k3y7ugwfG-ANxxCJLYLsIXKHi6c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/96129-best-football-dip-ever-VAT-step-02-5ab7ff6222524ba68379ce1a1ff728a5.jpg"
      ],
      "image": "assets/images/96129/step_02.webp"
    },
    {
      "text": "Spread the cream cheese in an even layer in the bottom of a 9-inch square baking dish. Spread a layer of salsa over the cream cheese, then cover with a layer of ground beef. Top with slices of processed cheese and cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hDIYJHUWCeXC4gzbmOpyZYAt1_Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/96129-best-football-dip-ever-VAT-step-03-6b090466e2734104b5321abfa02a24ae.jpg"
      ],
      "image": "assets/images/96129/step_03.webp"
    },
    {
      "text": "Bake for 15 minutes in the preheated oven, or until heated through. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YV9E8XbQ9eO6AXRWGsIsXQr29RU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/96129-best-football-dip-ever-VAT-step-04-8c2e4a93cd44465e87cf04b60f7062b3.jpg"
