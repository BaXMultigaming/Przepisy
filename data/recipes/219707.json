  "ingredients": [
    "0.33333334326744 cup self-rising flour",
    "0.75 cup white sugar",
    "3 eggs",
    "1 cup evaporated milk",
    "0.875 cup water",
    "0.25 cup margarine, or more to taste",
    "1 teaspoon vanilla extract",
    "1 pinch ground cinnamon"
  ],
  "steps": [
    {
      "text": "Whisk self-rising flour, sugar, eggs, evaporated milk, and water together in a saucepan placed over medium-high heat. Whisk constantly while bringing mixture to a boil. Reduce heat to medium-low. Whisking constantly, cook pudding at a simmer until thickened, about 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When pudding has thickened, stir in margarine and vanilla extract until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pudding from heat and set aside for about 10 minutes to cool. Sprinkle pudding with cinnamon; serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
