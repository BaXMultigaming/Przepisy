  "ingredients": [
    "1 rutabaga, peeled and cut into 1/4-inch chunks",
    "2 cups water",
    "1 tablespoon vegetable oil",
    "1.5 cups couscous",
    "0.5 cup nutritional yeast",
    "0.25 cup vegetable oil",
    "0.25 cup apple cider vinegar",
    "1.5 teaspoons honey",
    "1 teaspoon Italian seasoning",
    "1 teaspoon dried oregano",
    "1 teaspoon dried dill weed",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon cayenne pepper",
    "1 pinch salt to taste"
  ],
  "steps": [
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer; bring to a boil. Add the rutabaga and steam until just tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring 2 cups water and 1 tablespoon vegetable oil to a boil in a saucepan. Remove from the heat and stir in the couscous. Cover and let stand until the water is absorbed, about 14 minutes; fluff with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk nutritional yeast, 1/4 cup vegetable oil, apple cider vinegar, honey, Italian seasoning, oregano, dill, black pepper, and cayenne pepper in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir couscous and rutabaga into the nutritional yeast dressing. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
