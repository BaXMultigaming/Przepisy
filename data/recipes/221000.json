  "ingredients": [
    "1 (12 fluid ounce) can or bottle beer",
    "2 tablespoons brown sugar",
    "2 tablespoons Dijon mustard",
    "1 (8 pound) bone-in smoked ham"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk beer, brown sugar, and Dijon mustard together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ham cut-side up in a large roasting pan; pour beer mixture over ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until ham begins to brown, about 15 minutes, basting 4 to 5 times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce oven temperature to 350 degrees F (175 degrees C). Cover roasting pan with lid or aluminum foil. Continue to bake until ham is heated through, about 90 minutes more, basting frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove lid and bake until ham is well browned, about 15 minutes more. Allow ham to rest for 10 to 15 minutes before carving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
