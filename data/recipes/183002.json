  "ingredients": [
    "1.25 cups milk",
    "2 large eggs, at room temperature",
    "0.5 teaspoon vanilla",
    "2 tablespoons melted butter",
    "1.25 cups all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "3 tablespoons white sugar",
    "0.25 teaspoon salt",
    "0.5 cup semisweet chocolate chips",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Whisk milk, eggs, and vanilla together in a bowl. Stir in melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cocoa powder, sugar, and salt together in a separate bowl. Pour in wet ingredients and mix until just combined. Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a large skillet with cooking spray and heat over medium-high heat. Working in batches, pour 1/4 cup batter into the hot skillet for each pancake. Cook until bubbles form and pop in the center of each pancake, 2 to 3 minutes. Flip and cook until golden brown on the other side, about 1 minute.",
      "section": null,
