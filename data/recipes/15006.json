  "ingredients": [
    "1 (15 ounce) can garbanzo beans, drained",
    "1 (4 ounce) jar roasted red peppers",
    "3 tablespoons lemon juice",
    "1.5 tablespoons tahini",
    "1 clove garlic, minced",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon cayenne pepper",
    "0.25 teaspoon salt",
    "1 tablespoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "In an electric blender or food processor, purée garbanzo beans, red peppers, lemon juice, tahini, garlic, cumin, cayenne, and salt. Use long pulses to process until mixture is fairly smooth and slightly fluffy, scraping down the sides in between pulses. Transfer to a serving bowl and refrigerate for at least 1 hour or up to 3 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to room temperature and sprinkle with chopped parsley before serving.",
