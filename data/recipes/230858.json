  "ingredients": [
    "1.5 tablespoons extra-virgin olive oil",
    "1 (8 ounce) package sliced fresh mushrooms",
    "1 onion, sliced",
    "1 clove garlic, minced",
    "1.5 tablespoons Italian seasoning",
    "5 eggs",
    "2 tablespoons garlic and herb cheese spread (such as Boursin®)",
    "salt and ground black pepper to taste",
    "0.33333334326744 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a skillet over medium heat; cook and stir mushrooms, onion, and garlic until onion is browned, about 15 minutes. Season with Italian seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs with garlic and herb cheese spread in a bowl. Mixture will be slightly chunky. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour eggs in skillet over mushroom mixture; cook and stir until eggs are nearly set, about 1 minute. Fold mozzarella cheese into eggs until just melted, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
