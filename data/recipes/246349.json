  "ingredients": [
    "1 (3 ounce) package ramen noodles (any flavor)",
    "1 teaspoon chopped fresh parsley, or to taste",
    "1 tablespoon vegetable oil",
    "0.5 onion, chopped",
    "2 large eggs",
    "1 teaspoon water, or as desired",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Bring a pot of water to a boil; add ramen noodles and cook for 3 minutes. Drain water and stir seasoning packet and parsley into noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
