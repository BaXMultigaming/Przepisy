  "ingredients": [
    "1 (18.25 ounce) package lemon cake mix",
    "2 eggs",
    "0.33333298563957 cup vegetable oil",
    "1 cup confectioners' sugar",
    "0.25 teaspoon lemon extract",
    "1 tablespoon milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line baking sheets with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cake mix, eggs, and vegetable oil. Drop by rounded teaspoons onto baking sheets and bake for no more than 8 minutes. Do not overbake! Once all the cookies are done. Remove the foil. You have a no need to clean baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Lemon Icing: Mix together confectioners' sugar, lemon extract, and milk. Mix ingredients together (more or less to your desired liking). When the cookies are warm or completely cooled, place as much icing on them as you like!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
