  "ingredients": [
    "1 pound ground turkey",
    "1 cup black beans, rinsed and slightly crushed",
    "0.75 cup grated Parmesan cheese",
    "0.5 cup Japanese-style bread crumbs (panko)",
    "1 egg",
    "1 (1 ounce) package dry onion soup mix"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground turkey, black beans, Parmesan cheese, bread crumbs, egg, and onion soup mix in a large bowl with your hands. Divide into 6 portions; shape into patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until no longer pink in centers, 5 to 6 minutes per side. An instant-read thermometer inserted into centers should read at least 165 degrees F (75 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
