  "ingredients": [
    "1 (15.25 ounce) package chocolate cake mix",
    "0.5 cup vegetable oil",
    "2 eggs",
    "2 cups butterscotch chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, oil and eggs in a large bowl. Add butterscotch chips and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by tablespoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes until the center is just set. Let stand 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove to wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
