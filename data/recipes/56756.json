  "ingredients": [
    "1.5 cups sugar",
    "1 cup butter",
    "4 eggs",
    "0.25 cup amaretto liqueur",
    "2 teaspoons vanilla extract",
    "4 cups all-purpose flour",
    "3 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1.3333333730698 cups chopped macadamia nuts",
    "1.3333333730698 cups white chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a cookie sheet or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a large bowl until fluffy. Beat in eggs, amaretto, and vanilla. Whisk flour, baking powder, and salt together in a separate bowl; stir into butter mixture. Fold in macadamia nuts and white chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 4 equal parts. Place dough parts on the prepared cookie sheet; form each into a log about 14-inches long and 1 1/2-inches wide.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until very lightly brown, about 25 minutes. Cool and cut diagonally into 1/2-inch slices. Arrange slices on the baking sheet; bake until golden brown, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
