  "ingredients": [
    "0.25 cup olive oil, divided",
    "1 small onion, chopped",
    "2 tablespoons lemon juice",
    "2 cloves fresh garlic, minced",
    "0.25 jalapeno pepper, minced",
    "1 eggplant, cut into cubes",
    "2 tablespoons ground cumin",
    "1 tablespoon paprika",
    "1.5 teaspoons chili powder",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon seasoned salt (such as Johnny's Seasoning Salt®)",
    "4 taco shells"
  ],
  "steps": [
    {
      "text": "Heat 2 tablespoons olive oil in a large skillet over medium-high heat. Add onion, lemon juice, garlic, and jalapeño; bring to a simmer and cook until onion softens, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in eggplant, cumin, paprika, chili powder, black pepper, and seasoned salt; drizzle remaining 2 tablespoons olive oil over top. Cook, stirring occasionally, until eggplant softens and reduces in size, about 15 minutes. Serve in taco shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
