  "ingredients": [
    "1 cup white sugar",
    "1 cup soy sauce",
    "1 cup water",
    "1 teaspoon onion powder",
    "1 teaspoon ground ginger",
    "1 tablespoon lemon juice",
    "4 teaspoons hot chile paste"
  ],
