  "ingredients": [
    "1 (5 pound) beef brisket",
    "seasoned salt to taste",
    "1 cup apple cider",
    "0.5 cup honey",
    "3 tablespoons soy sauce",
    "0.75 cup ketchup",
    "0.25 cup packed brown sugar",
    "0.25 cup apple cider vinegar",
    "2 tablespoons Worcestershire sauce",
    "0.5 teaspoon garlic powder, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season brisket all over with salt; place in a roasting pan. Pour apple cider over brisket; cover tightly with foil. Cook in the preheated oven until tender, about 3 hours. Don't peek.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for low heat and lightly oil the grate. Combine honey, soy sauce, and salt in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer brisket to the preheated grill; cook, turning and basting frequently with honey sauce, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ketchup, sugar, vinegar, Worcestershire sauce, garlic powder, and salt in a saucepan; cook sauce on low heat until flavors meld, about 15 minutes. Do not boil, or sauce will become too vinegary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rest brisket about 10 minutes, then slice and serve with barbecue sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
