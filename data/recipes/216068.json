  "ingredients": [
    "12 chocolate cream-filled sandwich cookies",
    "1 (3.9 ounce) package instant chocolate pudding mix",
    "2 cups milk",
    "1 (3 ounce) package gummy worms candy"
  ],
  "steps": [
    {
      "text": "Place cookies into a resealable plastic bag and crush with a rolling pin to make crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pudding mix and milk together in a bowl, stirring for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle about 1/3 of the crushed cookie crumbs into the bottom of a serving bowl; spoon chocolate pudding over crumbs and smooth out the top. Sprinkle remaining chocolate cookie crumbs on top to resemble dirt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Poke gummy worms halfway into the dirt. Refrigerate until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
