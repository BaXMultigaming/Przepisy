  "ingredients": [
    "1 egg white",
    "3 cups unsalted raw cashews",
    "0.33333334326744 cup white sugar",
    "2 teaspoons ground cumin",
    "2 teaspoons salt",
    "1.5 teaspoons cayenne pepper"
  ],
  "steps": [
    {
      "text": "Whisk egg white in a medium bowl until frothy. Mix in cashews until coated. Let soak for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 250 degrees F (120 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, cumin, salt, and cayenne pepper in a small bowl. Pour over cashews and toss to coat. Spread cashews on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring halfway through, until fragrant, about 40 minutes. Reduce oven temperature to 200 degrees F (93 degrees C). Continue baking, stirring every 20 minutes, until cashews look dry, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cashews to a container and let cool, shaking or stirring occasionally to prevent them from sticking together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
