  "ingredients": [
    "1 cup unsalted butter",
    "0.75 cup white sugar",
    "3 eggs",
    "1 cup cake flour",
    "2 tablespoons dry milk powder",
    "1 tablespoon corn syrup",
    "0.5 lemon, juiced",
    "0.25 teaspoon salt",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon ground nutmeg",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon ground mace"
  ],
  "steps": [
    {
      "text": "Allow butter to reach room temperature. Cream sugar and butter together until light and fluffy. Add eggs one at a time and mix well. Add in flour, powdered milk, and corn syrup. Beat each in well. Add juice of half a lemon, salt, vanilla, nutmeg and mace. Make sure everything is well blended, and pour into a greased loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C) for 45 minutes, checking for doneness by inserting a toothpick and seeing if it comes out clean. You almost want to underbake this.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
