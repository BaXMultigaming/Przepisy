  "ingredients": [
    "1 pound beef stew meat",
    "salt and ground black pepper to taste",
    "0.5 cup chopped Spanish onion",
    "2 cloves garlic, minced",
    "2 cups chopped red potatoes",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (12 ounce) jar sofrito",
    "0.5 cup pitted and halved green olives"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium heat. Add beef; cook until completely browned, about 5 minutes. Season with salt and black pepper; transfer to a slow cooker, retaining some drippings in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat drippings in skillet; add onion and garlic. Sauté until softened, about 5 minutes; add to slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir potatoes, diced tomatoes, sofrito, and olives into beef mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until beef and potatoes fork-tender, 4 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
