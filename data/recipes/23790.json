  "ingredients": [
    "5 eggs, beaten",
    "2 tablespoons milk",
    "1 onion, chopped",
    "2 slices cooked ham, chopped",
    "1 cup shredded Cheddar cheese",
    "1 to taste salt and pepper to taste",
    "0.125 teaspoon garlic powder, or to taste",
    "2.5 tablespoons butter"
  ],
  "steps": [
    {
      "text": "In a large bowl, beat together eggs and milk. Stir in onion, ham, cheese, salt, pepper and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large frying pan or skillet over medium high heat. Add eggs and cook, without stirring, until eggs begin to set. At that point, stir the eggs until roughly scrambled. Keep doing this until eggs are fully cooked, about 10 to 15 minutes. Serve warm.",
      "section": null,
