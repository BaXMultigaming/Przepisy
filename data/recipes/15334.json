  "ingredients": [
    "0.75 cup shortening",
    "1 cup packed brown sugar",
    "0.5 cup white sugar",
    "1 egg",
    "0.25 cup water",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1 tablespoon ground cinnamon",
    "3 cups rolled oats"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the shortening, brown sugar and white sugar. Stir in the egg, water and vanilla. Combine the flour, salt, baking soda and cinnamon, stir into the creamed mixture. Finally, stir in the rolled oats. Drop by rounded spoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in the preheated oven. Cool on baking sheets for a couple of minutes before removing to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
