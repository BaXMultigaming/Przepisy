  "title": "Cha Cha's White Chicken Chili",
  "description": "Cha Cha's chili with chicken and white beans is easy to make with leftover chicken, canned jalapeños and chile peppers, and Monterey Jack cheese.",
  "authors": [
    "Cathy"
  ],
