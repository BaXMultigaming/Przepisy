  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 onion, chopped",
    "1 (4 ounce) can diced jalapeno peppers",
    "1 (4 ounce) can chopped green chile peppers",
    "3 cloves garlic, crushed",
    "2 teaspoons ground cumin",
    "1 teaspoon dried oregano",
    "1 teaspoon ground cayenne pepper",
    "3 (15 ounce) cans white beans",
    "2 (14.5 ounce) cans chicken broth",
    "3 cups chopped cooked chicken breast",
    "1 cup shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7e07f3w352_Ym5tGFoSvrW0mUTA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22302-Cha-Chas-White-Chicken-Chili-ddmfs-ingredients-step-1-705bb03cd7204f2c885975e5ccdecf97.jpg"
      ],
      "image": "assets/images/22302/step_01.webp"
    },
    {
      "text": "Heat oil in a large saucepan over medium-low heat. Add onion; cook and stir until tender, 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TcFSQCaL5p4BaaSIZGLbni3fuyM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22302-Cha-Chas-White-Chicken-Chili-ddmfs-step-2-dcfc44971f8a4661a1ce1a903681bf95.jpg"
      ],
      "image": "assets/images/22302/step_02.webp"
    },
    {
      "text": "Add jalapeño peppers, chile peppers, garlic, cumin, oregano, and cayenne pepper; cook and stir for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uA94UYFg1QKBscTSeguNkAD2RcU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22302-Cha-Chas-White-Chicken-Chili-ddmfs-step-3-ea6ddc5508974ec79ef0958348c6e8b8.jpg"
      ],
      "image": "assets/images/22302/step_03.webp"
    },
    {
      "text": "Stir in beans, chicken broth, and chicken. Simmer for 15 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z6UwmG2wp6g7F19PBqXJ75nRqEA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22302-Cha-Chas-White-Chicken-Chili-ddmfs-step-4-23c2ca513e8a4c5f82479ba639fe6ac2.jpg"
      ],
      "image": "assets/images/22302/step_04.webp"
    },
    {
      "text": "Remove from the heat. Slowly stir in cheese until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QoeoLtNJpiCHEaT1Qg6LgkCZNzw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-22302-Cha-Chas-White-Chicken-Chili-ddmfs-step-5-6d550d3473ad48a6ab8c689004cc7c6b.jpg"
      ],
      "image": "assets/images/22302/step_05.webp"
    },
    {
      "text": "Serve warm. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
