  "ingredients": [
    "0.75 pound bulk pork sausage",
    "5 (6 inch) corn tortillas",
    "1 cup shredded Monterey Jack cheese",
    "1 cup shredded Cheddar cheese",
    "0.25 cup canned chopped green chiles",
    "6 eggs, beaten",
    "0.5 cup heavy whipping cream",
    "0.5 cup ricotta cheese",
    "0.5 teaspoon chili powder",
    "0.25 cup minced fresh cilantro"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Add sausage; cook and stir until crumbly, evenly browned, and no longer pink, about 10 minutes. Drain and discard any excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 4 tortillas in the prepared pie plate, overlapping and extending ½-inch beyond rim; place remaining tortilla in center. Layer sausage, Monterey Jack cheese, Cheddar cheese, and green chiles over tortillas. Beat eggs, heavy cream, ricotta cheese, and chili powder together in a bowl; slowly pour into pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center is set and puffed, about 45 minutes. Sprinkle with cilantro; cut into wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
