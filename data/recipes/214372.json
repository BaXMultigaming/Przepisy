  "ingredients": [
    "2 cups all-purpose flour",
    "3 tablespoons white sugar",
    "4 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 egg",
    "1 cup milk",
    "0.25 cup vegetable oil",
    "1 cup blueberries",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, sugar, baking powder, and salt in a large bowl; make a well in the center. Beat egg, milk, and oil in a separate bowl; pour into the well and stir until flour mixture is just moistened. Do not overmix. Fold in blueberries and walnuts. Spoon batter into the prepared muffin cups to about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 15 to 20 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
