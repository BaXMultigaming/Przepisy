  "ingredients": [
    "2 eggs",
    "1 small onion, minced",
    "2 pounds ground beef",
    "0.5 cup milk",
    "1 teaspoon salt",
    "1 cup cracker crumbs",
    "1.5 cups ketchup",
    "0.75 cup brown sugar",
    "0.5 cup distilled white vinegar",
    "0.25 cup prepared yellow mustard"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a mixing bowl. Add beef, onion, milk, and salt; mix well. Sprinkle in cracker crumbs; mix until combined. Form into 40 meatballs; place in a 9x13-inch baking dish and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk ketchup, brown sugar, vinegar, and mustard together in a bowl; pour over meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until meatballs are no longer pink in the center, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
