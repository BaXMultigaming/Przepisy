  "ingredients": [
    "cooking spray",
    "0.5 cup unsalted butter, melted",
    "0.5 cup light brown sugar",
    "1 large egg",
    "0.25 cup sour cream",
    "0.25 cup white sugar",
    "1 teaspoon vanilla extract",
    "2 ripe bananas",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 (4 ounce) package cream cheese, softened",
    "1 large egg",
    "0.25 cup white sugar",
    "3 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make bread: Combine melted butter, brown sugar, egg, sour cream, white sugar, and vanilla in a large bowl; whisk until smooth. Mash in bananas using a fork. Whisk in flour, baking soda, baking powder, and salt until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_e1vdbRlGi_Bzeet2L8tVUUCbFM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/256401-cream-cheese-banana-bread-ddmfs-step2-0321-2471bfc61ac3452dae9ab1b9bb35d317.jpg"
      ],
      "image": "assets/images/256401/step_02.webp"
    },
    {
      "text": "Make filling: Whisk together cream cheese, egg, white sugar, and flour in a medium bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lO01wbK-neID2i3OFygUdk---gw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/256401-cream-cheese-banana-bread-ddmfs-step3-0322-0e9d65ee673f47f898a60638e9ed1ee8.jpg"
      ],
      "image": "assets/images/256401/step_03.webp"
    },
    {
      "text": "Pour 1/2 of the banana batter into the prepared loaf pan. Spread with cream cheese filling. Pour remaining banana batter on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p_MOOv2UjYlZYlDJdk2q1hdD15c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/256401-cream-cheese-banana-bread-ddmfs-step4-0326-3bfd8db098ab40d7885513ffbdc7635e.jpg"
      ],
      "image": "assets/images/256401/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until top is firm and bounces back when gently pressed, about 50 minutes. Cool in the pan for about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mL3keoY6h06h6Ubo2xnr6LLCqKE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/256401-cream-cheese-banana-bread-ddmfs-step7-0351-c76120ecc9144194b7f305e5d5610e9b.jpg"
      ],
      "image": "assets/images/256401/step_05.webp"
    }
  ],
