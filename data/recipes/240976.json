  "ingredients": [
    "8 cups water",
    "2 cups steel-cut oats",
    "1 dash salt",
    "1 cup whole milk",
    "0.33333334326744 cup brown sugar",
    "1 tablespoon butter, melted",
    "1 teaspoon ground cinnamon",
    "1 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a large pot. Stir oats into boiling water and cook at a boil until the mixture begins to thicken, about 5 minutes. Season oats mixture with salt; stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low and simmer oats until beginning to soften, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk, brown sugar, melted butter, and cinnamon together in a bowl with a whisk until smooth; stir into the oats mixture. Continue cooking the oats until tender, 10 to 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cranberries into the oatmeal to distribute throughout the mixture; cook just until the berries are warmed, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
