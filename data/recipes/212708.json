  "ingredients": [
    "3 acorn squash, halved and seeded",
    "2 tablespoons stick margarine",
    "3 cups peeled, seeded, and chopped Granny Smith apples",
    "1 cup chopped onions",
    "1.5 cups shredded Cheddar cheese",
    "0.5 cup golden raisins",
    "2 tablespoons light brown sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place squash halves, cut-sides down, onto a baking sheet. Add enough water to come ½ inch up sides of the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 minutes. Drain off any remaining water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt margarine in a large skillet over medium heat. Add apples and onions; cook until onions softened and turned translucent, 10 to 15 minutes. Transfer mixture to a bowl to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When squash is cooked, stir Cheddar cheese, raisins, brown sugar, and cinnamon into apple mixture until evenly combined. Flip squash halves on the baking sheet; fill cavities with apple mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the heated oven until filling is hot and cheese is melted, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
