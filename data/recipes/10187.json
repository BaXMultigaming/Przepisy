  "ingredients": [
    "0.5 cup butter",
    "1 cup white sugar",
    "1 egg",
    "1 egg yolk",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.25 cup fresh lime juice",
    "1.5 teaspoons grated lime zest",
    "0.5 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream butter, sugar, egg, and egg yolk until smooth. Stir in lime juice and lime zest. Combine the flour, baking powder, and salt; blend into the creamed mixture. Form dough into 1/2 inch balls, and arrange on the prepared cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 8 to 10 minutes in the preheated oven, or until lightly browned. Cool on wire racks. Sift confectioners' sugar over cookies while still warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
