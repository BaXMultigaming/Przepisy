  "title": "Perfect Fluffy Chocolate Chip Cookies",
  "description": "These fluffy cookies with chocolate chips are super easy to make because you can mix up the dough with a wooden spoon instead of an electric mixer.",
  "authors": [
    "MamaMashedPotatoes"
  ],
  "date_published": "2020-06-19T00:28:08-04:00",
