  "ingredients": [
    "1 cup butter",
    "1.5 cups brown sugar",
    "0.5 cup white sugar",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 eggs, beaten",
    "1.5 teaspoons vanilla extract",
    "3 cups all-purpose flour",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Melt butter with brown sugar in a saucepan over medium heat, stirring constantly. Remove from heat and stir in white sugar, baking soda, and salt. Let mixture cool for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer butter mixture to a large mixing bowl. Add beaten eggs and vanilla extract; mix well. Fold in flour gently, 1 cup at a time, using a wooden spoon. Fold chocolate chips into the thick batter with the spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate cookie dough for 1 hour or freeze for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1-inch balls and arrange on ungreased, nonstick baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges start to turn golden, 8 to 9 minutes. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
