  "ingredients": [
    "0.25 cup vegetable oil",
    "0.5 cup white sugar",
    "4 cups onion, coarsely chopped",
    "0.25 teaspoon salt",
    "ground black pepper to taste",
    "0.5 cup red wine vinegar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_1v9Z3MoSZVNi8DjVfIeG-uhU7w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220546-onion-jam-VAT-step-01-f827fecad16541938b1aa482d4654ec9.jpg"
      ],
      "image": "assets/images/220546/step_01.webp"
    },
    {
      "text": "Heat vegetable oil in a heavy skillet over medium heat. Stir sugar into oil with a wooden spoon, stirring constantly, until mixture is a light caramel color, about 10 minutes. Mixture will be very hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ju9bc9tcm1Xr4lWGPR8FZnJWaTY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220546-onion-jam-VAT-step-02-f7d8b9b94e154ab391083494c34c6b1e.jpg"
      ],
      "image": "assets/images/220546/step_02.webp"
    },
    {
      "text": "Stir onion, salt, and black pepper into sugar mixture. Onions will immediately start to caramelize. Stir frequently over medium heat until sugar has dissolved and onions are browned, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Nr9rUVhtA-au7MKfaVNK9rUK7bE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220546-onion-jam-VAT-step-03-e4aa0127f11c4a82a78ea40dc5121b91.jpg"
      ],
      "image": "assets/images/220546/step_03.webp"
    },
    {
      "text": "Pour red wine vinegar into onion mixture; simmer until mixture reaches a jam consistency, about 30 minutes. Let cool to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pm2zXiNymjWivtBbDffrlu1xERQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220546-onion-jam-VAT-step-04-df4f14e3fbd740b988016658a9f9ad5a.jpg"
      ],
      "image": "assets/images/220546/step_04.webp"
    }
