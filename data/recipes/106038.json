  "ingredients": [
    "1 pound ground beef",
    "2 (15 ounce) cans mixed vegetables",
    "1 (15 ounce) can whole peeled tomatoes",
    "3 cups uncooked elbow macaroni",
    "1 cup water",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat a cast iron Dutch oven over a campfire, and brown the ground beef, 5 to 7 minutes. Drain off the excess grease, then pour in the mixed vegetables, tomatoes, macaroni, and water. Season with salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook until the macaroni is tender, and the stew has reached desired thickness, about 35 minutes more.",
