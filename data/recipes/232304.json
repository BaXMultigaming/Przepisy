  "ingredients": [
    "0.5 cup mayonnaise",
    "2 tablespoons chopped onion",
    "1 tablespoon vinegar",
    "2 teaspoons white sugar",
    "1 teaspoon seafood seasoning (such as Old Bay®)",
    "3 cups shredded cabbage",
    "0.5 cup shredded carrots",
    "0.25 cup chopped green bell pepper"
