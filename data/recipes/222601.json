  "keywords": [],
  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.75 cup white sugar",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 cup vegetable oil",
    "0.25 cup milk",
    "1 egg, lightly beaten",
    "1 tablespoon lemon juice",
    "1 teaspoon vanilla extract",
    "1 cup shredded zucchini",
    "0.5 cup miniature semisweet chocolate chips",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ScM7U-Sd_C_5mzZDC6D8ehX9DcI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222601-zucchini-chocolate-chip-muffins-step-mise_38444-e7e7b88e21dc4fbbbdf37fa666f2b99e.jpg"
      ],
      "image": "assets/images/222601/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking soda, cinnamon, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wrUFA7oJscEeVIZJtONo5oVCItQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222601-zucchini-chocolate-chip-muffins-step2_38445-5b5b6eccd1404a2aaba4a090c577d573.jpg"
      ],
      "image": "assets/images/222601/step_03.webp"
    },
    {
      "text": "Whisk oil, milk, egg, lemon juice, and vanilla extract in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ptCl43LobIijNt4z-uvg43vAuLk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222601-zucchini-chocolate-chip-muffins-step3_38448-7e1764c77346418885c468a0fb5b2939.jpg"
      ],
      "image": "assets/images/222601/step_04.webp"
    },
    {
      "text": "Stir oil mixture into flour mixture until just moistened; fold in zucchini, chocolate chips, and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1AHUCD_v1I0dilKQutwF7rWVw9w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222601-zucchini-chocolate-chip-muffins-step4_38449-13b910d0a6274e42929607e064ed0275.jpg"
      ],
      "image": "assets/images/222601/step_05.webp"
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E8QQruaFjW4XE6nIShUVRLi-Lv8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222601-zucchini-chocolate-chip-muffins-step5_38450-2d7ad9ecaa254d699c47e4e89b9fd918.jpg"
      ],
      "image": "assets/images/222601/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 20 to 25 minutes. Let muffins cool in the tin briefly before transferring to a wire rack to cool completely",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xSUJ2vGAZNYmrg62E3unXoyaZ84=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222601-zucchini-chocolate-chip-muffins-step7_38467-ae8be588c18f4bbf88290ed23148933f.jpg"
      ],
      "image": "assets/images/222601/step_07.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rAjr_raTLuY8XiT_McROMQLHqV4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222601-zucchini-chocolate-chip-muffins-beauty_3x4_38474-4d39f6c027b8480c95d86dcc6f18fdc7.jpg"
      ],
      "image": "assets/images/222601/step_08.webp"
    }
