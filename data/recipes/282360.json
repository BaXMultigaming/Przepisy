  "ingredients": [
    "2 tablespoons salted butter",
    "1 medium onion, chopped",
    "1 cup shredded rotisserie chicken",
    "1 (15.25 ounce) can Mexican-style corn, drained",
    "1 (15 ounce) can black beans, rinsed and drained",
    "1 (14.5 ounce) can chili-seasoned diced tomatoes",
    "1 cup instant brown rice, uncooked",
    "1 (4 ounce) can diced green chiles",
    "1 tablespoon ground cumin",
    "1 teaspoon garlic powder",
    "salt and ground black pepper to taste",
    "1 cup salsa"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a large skillet over medium heat. Add onion and cook and stir until tender, 5 to 7 minutes. Add shredded chicken and cook until heated through, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chicken mixture into a casserole dish. Add corn, beans, tomatoes, rice, chiles, cumin, garlic powder, salt and pepper. Mix all ingredients together in the pan and spread to cover the dish. Spread salsa evenly over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly, about 45 minutes. Serve in bowls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
