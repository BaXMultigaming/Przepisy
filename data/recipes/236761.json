  "ingredients": [
    "2 cups all-purpose flour",
    "1 (15 ounce) can crushed pineapple",
    "1.5 cups white sugar",
    "2 eggs, beaten",
    "1.5 teaspoons baking soda",
    "1 pinch salt",
    "1 cup white sugar",
    "0.75 cup evaporated milk",
    "0.5 cup margarine",
    "1 cup chopped pecans",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C). Grease an 11x14-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, pineapple, 1 1/2 cups white sugar, eggs, baking soda, and salt together in a large bowl; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cake comes out clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup sugar, evaporated milk, and margarine together in a saucepan; bring to a boil for 1 minute. Remove saucepan from heat and stir pecans and vanilla extract into sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pierce the top of the cake with a toothpick and spread pecan topping over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
