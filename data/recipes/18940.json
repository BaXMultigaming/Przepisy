  "ingredients": [
    "2 (3 ounce) packages lime flavored Jell-O® mix",
    "1 quart hot water",
    "1 (46 fluid ounce) can pineapple juice",
    "2 (12 fluid ounce) cans frozen orange juice concentrate, thawed",
    "2 cups white sugar",
    "4.5 cups cold water",
    "2 liters ginger ale"
