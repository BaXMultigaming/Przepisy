  "ingredients": [
    "2.5 tablespoons olive oil",
    "2 boneless skinless chicken breasts, cut into 1/4-inch strips",
    "1 sweet apple - peeled, cored and thinly sliced",
    "1.5 tablespoons garlic salt",
    "1 tablespoon cracked black pepper",
    "1 teaspoon pumpkin pie spice",
    "1.5 teaspoons chopped dried tarragon"
  ],
  "steps": [
    {
      "text": "Heat the olive oil in a large skillet over medium heat, and cook the chicken 5 minutes.",
      "section": null,
