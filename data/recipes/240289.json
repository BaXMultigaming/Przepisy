  "ingredients": [
    "6 potatoes, sliced",
    "3 tablespoons all-purpose flour",
    "0.25 teaspoon salt",
    "3 tablespoons butter, cut into small pieces",
    "0.5 cup onion, chopped",
    "1.5 cups milk",
    "1 pinch paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 1-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread about 1/3 of the potatoes into the bottom of the prepared dish. Mix flour and salt together in a small bowl until combined; sprinkle about 1/3 of the mixture over potatoes. Dot potato layer with about 1/3 of the butter. Sprinkle about 1/3 of the onion over butter and potatoes. Repeat layering two more times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stream milk over potato mixture in the dish. Sprinkle paprika over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is nicely browned, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
