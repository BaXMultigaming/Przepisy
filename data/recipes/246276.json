  "ingredients": [
    "1 cup sugar",
    "1 cup water",
    "0.33333334326744 cup packed fresh rosemary leaves",
    "0.33333334326744 cup coarsely chopped fresh ginger",
    "0.25 teaspoon black pepper",
    "1 cup gin",
    "1 cup rosemary-ginger simple syrup",
    "1 cup sparkling water",
    "0.5 cup fresh lime juice",
    "10 ice cubes"
  ],
  "steps": [
    {
      "text": "Bring all syrup ingredients to a boil in a small saucepan over medium heat. Boil, stirring until sugar has dissolve, about 1 minute. Remove from heat. Let stand, covered, 1 hour at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain through a fine-mesh sieve, pushing down on solids to extract as much liquid as possible. Refrigerate until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine gin, 1 cup of the rosemary-ginger simple syrup, sparkling water, and lime juice in a cocktail shaker. Add ice cubes and shake until well-chilled. Strain 3/4 cup each into 8 glasses and serve.",
      "section": null,
      "name": null,
      "url": null,
