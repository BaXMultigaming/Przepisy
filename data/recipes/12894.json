  "ingredients": [
    "2 (28 ounce) cans diced tomatoes, undrained",
    "2 (28 ounce) cans crushed tomatoes, undrained",
    "4 (6.5 ounce) cans minced clams, undrained",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon dried oregano",
    "1 tablespoon dried basil",
    "0.5 teaspoon onion powder",
    "3 drops hot pepper sauce",
    "8 potatoes, cubed",
    "7 carrots, sliced",
    "1 red bell pepper, chopped",
    "1 green bell pepper, chopped",
    "1 stalk celery, diced",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine diced tomatoes, crushed tomatoes, and clams together with juices in a large stockpot over medium heat. Stir in Worcestershire sauce, oregano, basil, onion powder, and hot pepper sauce. Simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in potatoes, carrots, bell peppers, and celery. Simmer, stirring occasionally, for 2 to 3 hours. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
