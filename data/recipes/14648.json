  "ingredients": [
    "2.5 pounds tip round roast",
    "salt and pepper to taste",
    "1 (15 ounce) can tomato sauce",
    "1 onion, cut into thin strips",
    "2 bay leaves",
    "3 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Spray slow cooker with nonstick cooking spray. Season roast with salt and pepper. Place meat in the pot, fat side up. Pour tomato sauce over roast. Place onion over top. Toss in bay leaves. Cover and cook for 1 hour on High.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "After 1 hour, reduce heat to Low and cook 6 to 8 more hours. Carefully lift meat out of the pot and remove to a warm platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour drippings through a strainer into a medium-sized saucepan and discard material in the strainer. Whisk flour into the liquid. Cook, stirring constantly over medium heat until thickened. Season to taste with salt and pepper; serve alongside roast.",
      "section": null,
      "name": null,
      "url": null,
