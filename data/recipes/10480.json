  "ingredients": [
    "1 cup honey",
    "1 egg",
    "0.75 cup shortening",
    "0.25 cup water",
    "1 teaspoon vanilla extract",
    "3 cups rolled oats",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together shortening, honey, egg, water, and vanilla until creamy. Add combined remaining ingredients; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by rounded teaspoonfuls onto greased cookie sheet. Bake at 350 degrees F (175 degrees C) for 12 to 15 minutes.",
