  "title": "Apple Cake VII",
  "description": "This is a very moist Bundt cake that lets you use up those apples that might be going soft. My family loves this. It is a Fall tradition at our home.",
  "authors": [
    "jillybeans"
  ],
  "date_published": "2000-10-04T14:41:58-04:00",
