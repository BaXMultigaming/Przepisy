  "title": "Spaghetti all&#39;Assassina (Assassin&#39;s Spaghetti)",
  "description": "In this spicy spaghetti all&#39;assassina, spaghetti is cooked raw in tomato sauce.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2023-01-31T09:00:00-05:00",
