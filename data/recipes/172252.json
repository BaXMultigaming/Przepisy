  "ingredients": [
    "8 red potatoes",
    "1 cup mayonnaise",
    "0.5 cup sour cream",
    "1 tablespoon onion powder",
    "1 tablespoon garlic powder",
    "1 teaspoon seasoned salt",
    "1 teaspoon ground black pepper",
    "0.75 cup crumbled cooked bacon",
    "0.5 cup diced red onion",
    "2 cups shredded American cheese",
    "3 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice potatoes with skins on into 1/4 inch thick slices. Place potatoes into a large pot and cover with salted water. Bring to a boil over high heat, then reduce heat to medium-low, cover and simmer until tender, 10 to 15 minutes. Drain and allow to steam dry for a minute or two.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together mayonnaise, sour cream, onion powder, garlic powders, seasoned salt, pepper, bacon, onion, and American cheese in a bowl. Stir in potato slices. Pour mixture into prepared baking dish. Sprinkle top with grated Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and beginning to brown, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
