  "ingredients": [
    "2 pounds chicken drumettes",
    "0.25 cup light corn syrup",
    "0.5 cup soy sauce",
    "0.5 cup white sugar",
    "0.25 cup white wine",
    "1 pinch garlic powder, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay chicken in a single layer in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl combine corn syrup, soy sauce, sugar and wine. Pour over chicken and sprinkle with garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until sauce is hot and bubbly.",
