  "ingredients": [
    "10.5 ounces corn chips",
    "1 cup white sugar",
    "1 cup light corn syrup",
    "1 cup creamy peanut butter",
    "11 (1.55 ounce) bars milk chocolate"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
