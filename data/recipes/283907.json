  "ingredients": [
    "1 tablespoon honey",
    "1 tablespoon olive oil",
    "2 teaspoons Dijon mustard",
    "0.125 teaspoon ground paprika",
    "0.125 teaspoon salt",
    "0.125 teaspoon black pepper",
    "1 (6 ounce) fillet salmon fillet, thawed if frozen and patted dry",
    "0.5 pound fresh asparagus, trimmed"
  ],
  "steps": [
    {
      "text": "Stir together honey, olive oil, mustard, paprika, salt, and pepper in a small bowl. Whisk well to form a slightly thick sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush about 1/2 of the marinade all over both sides of the salmon fillet and place it into the air fryer basket. Air-fry at 400 degrees F (200 degrees C) for 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Open the basket and place the asparagus around the fillet as best you can, being careful not to cover it. Brush remaining sauce all over the asparagus and on top of the salmon fillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry at 400 degrees F (200 degrees C) until salmon is cooked through and asparagus is tender, 6 to 7 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
