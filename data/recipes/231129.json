  "ingredients": [
    "3 large avocados - peeled, pitted, and diced",
    "1 tomato, seeded and chopped",
    "2 green onions, finely chopped",
    "0.5 lime, juiced",
    "1 tablespoon salsa, or more to taste",
    "1 clove garlic, minced",
    "1 teaspoon sour cream",
    "1 teaspoon white vinegar",
    "0.5 teaspoon cayenne pepper",
    "0.25 teaspoon cumin",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Mash avocado in a large bowl. Stir tomato, green onions, lime juice, salsa, garlic, sour cream, vinegar, cayenne pepper, and cumin with the mashed avocado until evenly mixed; season with salt and black pepper.",
