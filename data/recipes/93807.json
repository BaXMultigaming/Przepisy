  "ingredients": [
    "2.5 cups graham cracker crumbs",
    "0.5 cup white sugar",
    "0.5 cup melted butter",
    "3 (8 ounce) packages cream cheese, softened",
    "2 (14 ounce) cans sweetened condensed milk",
    "0.5 cup lemon juice",
    "1 teaspoon vanilla extract",
    "1 (12 ounce) container frozen whipped topping, thawed",
    "2 (21 ounce) cans cherry pie filling"
  ],
  "steps": [
    {
      "text": "Combine graham cracker crumbs, sugar, and melted butter in a bowl until evenly moistened; press into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese in a bowl with an electric mixer until smooth; beat in sweetened condensed milk, lemon juice, and vanilla extract until well blended and smooth. Fold in whipped topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cream cheese filling into crust; smooth top. Top with cherry pie filling. Refrigerate cheesecake until firm, 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
