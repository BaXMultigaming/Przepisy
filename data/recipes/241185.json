  "ingredients": [
    "cooking spray",
    "4 (1 ounce) squares semi-sweet baking chocolate",
    "0.75 cup butter",
    "1.5 cups white sugar",
    "3 eggs, beaten",
    "1 teaspoon vanilla extract",
    "1 cup packed all-purpose flour",
    "0.5 cup pecans",
    "0.5 cup dried cherries",
    "0.5 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking pan with enough aluminum foil to hang over the edges. Spray the foil with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt baking chocolate and butter together in a microwave-safe glass or ceramic bowl in 30-second intervals, stirring after each melting, for 1 to 3 minutes. Stir sugar into chocolate mixture until dissolved. Cool mixture slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix eggs into into chocolate mixture until well mixed; stir in vanilla extract. Stir flour into chocolate mixture just until batter is moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Process pecans and dried cherries in a food processor until chopped; fold into batter with chocolate chips. Spread batter into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until brownies begin to pull away from the edges and are set in the middle, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
