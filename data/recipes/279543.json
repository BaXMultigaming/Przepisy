  "ingredients": [
    "0.75 cup nonfat milk",
    "0.33333334326744 cup nonfat cherry yogurt",
    "0.33333334326744 cup egg substitute",
    "1.75 cups all-purpose flour",
    "1 cup whole wheat flour",
    "0.75 cup granular sucralose sweetener (such as Splenda®)",
    "1 tablespoon baking powder",
    "1 teaspoon salt",
    "2 cups chopped strawberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin tin or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly whisk milk, yogurt, and egg substitute together in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine all-purpose and whole wheat flours, sweetener, baking powder, and salt in a large bowl; stir in strawberries until evenly coated. Stir in milk mixture until batter comes together; evenly divide among the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops bounce back when gently pressed or a toothpick inserted into centers comes out clean, about 25 minutes. Cool for 10 minutes in the tin, then transfer muffins to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
