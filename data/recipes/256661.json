  "ingredients": [
    "4 cups all-purpose flour",
    "1 teaspoon ground turmeric",
    "0.25 teaspoon baking powder",
    "1 pinch white sugar, or to taste",
    "salt to taste",
    "2 cups water",
    "oil for frying",
    "10 pieces drained jackfruit"
  ],
  "steps": [
    {
      "text": "Mix flour, turmeric, baking powder, sugar, and salt in a large bowl. Mix in water until batter is thick.",
