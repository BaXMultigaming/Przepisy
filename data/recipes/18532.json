  "ingredients": [
    "6 Vidalia onions, thinly sliced",
    "0.5 cup unsalted butter",
    "1 cup sour cream",
    "4 eggs, beaten",
    "0.25 cup grated Parmesan cheese",
    "2 tablespoons hot sauce",
    "salt and pepper to taste",
    "2 (9 inch) pie shells, baked",
    "1 pinch paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook onions in a medium skillet in some butter until softened and translucent, stirring often, about 10 minutes. Reserve juices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onions, sour cream, and eggs in a large bowl. Stir in onion juices, ½ cup butter, and ¼ cup Parmesan cheese; season with hot sauce, salt, and black pepper. Make sure all ingredients are well blended; divide between 2 pie shells. Sprinkle remaining ½ cup Parmesan cheese and paprika on top of pies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Reduce oven temperature to 350 degrees F (175 degrees C); continue baking until lightly browned on top, 30 to 40 minutes more. Cool to settle before slicing, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
