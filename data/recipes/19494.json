  "ingredients": [
    "0.5 cup dry white wine",
    "0.5 cup water",
    "2 pounds salmon fillets",
    "2 tablespoons butter, cut into small pieces",
    "1.5 teaspoons dried parsley",
    "1.5 teaspoons chopped garlic",
    "salt and pepper to taste"
  ],
