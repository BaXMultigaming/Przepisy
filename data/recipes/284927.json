  "ingredients": [
    "nonstick cooking spray",
    "0.5 cup panko bread crumbs",
    "0.25 cup plain bread crumbs",
    "2 tablespoons Cajun seasoning",
    "0.25 teaspoon ground black pepper",
    "2 large eggs",
    "1.5 pounds chicken breast tenderloins",
    "0.25 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray an 8x11-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix panko and plain bread crumbs together in a shallow bowl. Add Creole seasoning and pepper; mix thoroughly. Beat eggs in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover tenderloins in flour, then dip in egg mixture, following with a heavy coating of bread crumb mixture. Place the breaded chicken pieces in the greased pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and no longer pink in the centers, about 20 minutes, turning chicken pieces halfway through. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
