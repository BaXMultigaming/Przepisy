  "ingredients": [
    "1 pound ground beef",
    "1 medium onion, chopped",
    "1 (10.5 ounce) can Campbell's® Condensed Cream of Mushroom Soup (Regular or 98% Fat Free)",
    "1 tablespoon ketchup",
    "1 tablespoon Worcestershire sauce",
    "3 cups frozen Tater Tots"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a 10-inch skillet over medium-high heat. Cook and stir ground beef and onion in the hot skillet until beef is browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir condensed soup, ketchup, and Worcestershire into the skillet. Spoon beef mixture into a 12x8-inch shallow baking dish. Arrange tater tots around the edge of casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tater tots are cooked through, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
