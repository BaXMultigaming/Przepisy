  "ingredients": [
    "1 cup butter, softened",
    "0.5 cup firmly packed brown sugar",
    "2 eggs, separated",
    "1.5 teaspoons vanilla extract",
    "2.25 cups all-purpose flour",
    "1.5 cups walnuts, finely chopped",
    "3 tablespoons light corn syrup",
    "2 tablespoons butter, softened",
    "1 teaspoon almond extract",
    "2 drops blue food coloring",
    "1 drop green food coloring",
    "2 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 cup butter and brown sugar together in a large bowl with an electric mixer until light and fluffy. Beat in egg yolks until incorporated, then stir in vanilla. Add flour; mix well. Set dough aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg whites in a shallow dish until foamy. Spread walnuts on a plate or waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll 1 teaspoon dough into a ball; roll in egg whites, then in walnuts. Place on a cookie sheet. Repeat with remaining dough; space 2 inches apart on cookie sheets. Press thumb into each ball until makes an indentation.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat corn syrup, 2 tablespoons butter, almond extract, and food colorings together; gradually stir in confectioners' sugar until fondant mixture incorporated. Roll ½ teaspoon into an egg-shaped ball; repeat with remaining fondant mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fondant eggs into cookie indentations.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
