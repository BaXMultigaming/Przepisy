  "ingredients": [
    "4 portobello mushroom caps",
    "0.25 cup balsamic vinegar",
    "2 tablespoons olive oil",
    "1 tablespoon minced garlic",
    "1 teaspoon dried basil",
    "1 teaspoon dried oregano",
    "salt and pepper to taste",
    "4 (1 ounce) slices provolone cheese",
    "hamburger buns",
    "lettuce, tomato, and red onion for serving"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BEbTXpMSusEWobaK1sphG4a4_Ak=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14497-portobello-mushroom-burgers-DDMFS-4x3-ingredients-cd5417d0ee53424181a9a47793ec18b0.jpg"
      ],
      "image": "assets/images/14497/step_01.webp"
    },
    {
      "text": "Place mushroom caps, smooth side up, in a shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uNDbv5TN0ZrONYUp7z7hMrVa-Eg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14497-portobello-mushroom-burgers-DDMFS-4x3-step-01-8ee1aa1d307a4857a381e30814cbd1cd.jpg"
      ],
      "image": "assets/images/14497/step_02.webp"
    },
    {
      "text": "Whisk together balsamic, oil, garlic, basil, and oregano in a small bowl. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gKRKRe2PI0AOgQaLG0IeRaOzTn4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14497-portobello-mushroom-burgers-DDMFS-4x3-step-02-5229cd520f784958b486a91647643d3b.jpg"
      ],
      "image": "assets/images/14497/step_03.webp"
    },
    {
      "text": "Pour vinaigrette over mushrooms. Let stand at room temperature for 15 minutes or so, turning twice. Preheat grill for medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WjkUCXsk92OUpC4h1zT6TBTAfpY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14497-portobello-mushroom-burgers-DDMFS-4x3-step-03-94f64002cd884a9eaa3baad4b9d907f0.jpg"
      ],
      "image": "assets/images/14497/step_04.webp"
    },
    {
      "text": "Brush grill grates with oil. Place mushrooms on grill, reserving marinade for basting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1Kp9NvSp5V_2wbZICto9yL4UPc8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14497-portobello-mushroom-burgers-DDMFS-4x3-step-04-79248bd61e5942cd9bd226af2c147e4b.jpg"
      ],
      "image": "assets/images/14497/step_05.webp"
    },
    {
      "text": "Grill until just tender, 5 to 8 minutes per side, brushing with marinade frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OI38kGrlSNV3j4YL3CHyo1jaEUo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14497-portobello-mushroom-burgers-DDMFS-4x3-step-05-308a69f9b6f246deae81fe0a0fda135a.jpg"
      ],
      "image": "assets/images/14497/step_06.webp"
    },
    {
      "text": "Top mushrooms with cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tbkfc1NJB8eMiXsj-Jo1kfytGQ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14497-portobello-mushroom-burgers-DDMFS-4x3-step-06-ceb1688c03f14cd9b68adc709913fa49.jpg"
      ],
      "image": "assets/images/14497/step_07.webp"
    },
    {
      "text": "Continue grilling until cheese is melted, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iH9wyHCK2f1MSA_16TWoC2gb5x0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14497-portobello-mushroom-burgers-DDMFS-4x3-step-07-76373ac98b6c4456a9f72d7820e99b84.jpg"
      ],
      "image": "assets/images/14497/step_08.webp"
    },
    {
      "text": "Serve in buns with lettuce, tomato, and red onion, or your favorite toppings. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kzS5y3IpFYVWH1Fg77Amuoe9YQo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14497-portobello-mushroom-burgers-DDMFS-4x3-beauty-9e70e67862014a94991e5cdd5061c97e.jpg"
      ],
      "image": "assets/images/14497/step_09.webp"
    }
