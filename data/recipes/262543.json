  "ingredients": [
    "4 ounces self-rising flour",
    "4 ounces white sugar",
    "1 ounce unsweetened cocoa powder",
    "1 pinch salt",
    "1 egg",
    "0.25 cup milk",
    "2 ounces margarine, melted",
    "1 tablespoon vanilla extract",
    "4 ounces brown sugar",
    "1 ounce unsweetened cocoa powder",
    "0.25 pint warm water"
  ],
  "steps": [
    {
      "text": "Mix flour, sugar, 1 ounce cup cocoa powder, and salt together in a bowl. Add egg, milk, melted margarine, and vanilla extract. Stir well to combine and transfer to a large microwave-safe bowl with sides at least 2 inches high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and 1 ounce cocoa powder in a bowl. Sprinkle on top of the batter in the microwave-safe bowl. Pour warm water gently over the cake; use a fork to gently prick a few holes in the cake to allow water to seep in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the microwave on high power for 5 minutes. Serve with ice cream or custard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
