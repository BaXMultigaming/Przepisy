  "ingredients": [
    "cooking spray",
    "1 tablespoon butter",
    "1 cup chopped green onions",
    "2 cloves garlic, chopped",
    "1.5 cups chopped cooked chicken",
    "1 teaspoon salt",
    "0.5 teaspoon nutmeg",
    "0.5 teaspoon ground black pepper",
    "12 empanada pastry discs",
    "1 egg, lightly beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease 2 baking sheets with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Add chopped green onions and cook until tender, about 4 minutes. Add garlic and cook for 1 minute. Mix in cooked chicken, salt, nutmeg, and black pepper; cook 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange pastry discs on a flat work surface. Dab a little water along the edges. Place a large tablespoonful of chicken mixture in the center; fold pastry over and press with a fork to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer empanadas to the prepared baking sheets. Brush with beaten egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
