    "1 (9 inch) wheel Brie cheese",
    "5 cloves garlic, crushed",
    "1.5 tablespoons red pepper jelly, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
