  "ingredients": [
    "2 (15.25 ounce) cans fruit cocktail, drained",
    "3 large bananas, peeled and sliced",
    "1 (10 ounce) jar maraschino cherries, halved",
    "0.5 pint heavy whipping cream",
    "3 tablespoons white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "In a large bowl, combine fruit cocktail, bananas and cherries. Reserve 3 slices of banana and 1 cherry for garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, whip the cream to soft peaks with an electric mixer. Add sugar and vanilla, and whip to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold the whipped cream into the fruit. Garnish with a fan of banana slices. Place cherry at the bottom of the banana fan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
