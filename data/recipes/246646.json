  "ingredients": [
    "0.75 cup water",
    "0.75 cup white sugar",
    "0.75 cup soy sauce",
    "1 tablespoon sesame oil",
    "1 clove garlic, minced",
    "2 pinches ground ginger",
    "2 pounds beef short ribs, or more to taste"
  ],
  "steps": [
    {
      "text": "Whisk water, sugar, soy sauce, sesame oil, garlic, and ginger together in a large glass or ceramic bowl. Add beef short ribs and toss to evenly coat. Cover the bowl with plastic wrap; marinate in the refrigerator, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Remove short ribs from marinade, allowing excess to drip off; discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until evenly browned, 3 to 4 minutes per side. An instant-read thermometer inserted into centers should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
