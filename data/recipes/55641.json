  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 teaspoon cumin seeds",
    "1 teaspoon minced garlic",
    "1 teaspoon ginger paste",
    "2 medium potatoes, peeled and cubed",
    "0.5 teaspoon ground turmeric",
    "0.5 teaspoon paprika",
    "1 teaspoon ground cumin",
    "0.5 teaspoon garam masala",
    "salt to taste",
    "1 pound cauliflower",
    "1 teaspoon chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Heat the oil in a medium skillet over medium heat. Stir in the cumin seeds, garlic, and ginger paste. Cook about 1 minute until garlic is lightly browned. Add the potatoes. Season with turmeric, paprika, cumin, garam masala, and salt. Cover and continue cooking 5 to 7 minutes stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the cauliflower and cilantro into the saucepan. Reduce heat to low and cover. Stirring occasionally, continue cooking 10 minutes, or until potatoes and cauliflower are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
