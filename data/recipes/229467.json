  "ingredients": [
    "1.125 cups flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking soda",
    "0.5 cup butter, softened",
    "0.25 cup Truvia® Baking Blend, plus",
    "2 tablespoons Truvia® Baking Blend",
    "0.5 teaspoon vanilla",
    "1 large egg",
    "1 cup chocolate chips",
    "0.5 tablespoon molasses (see note)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, salt and baking soda in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, Truvia® Baking Blend and vanilla (and optional molasses) in a separate large mixing bowl. Mix in egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually stir in flour mixture. Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop rounded tablespoons on cookie sheets and press down to slightly flatten.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 9 to 11 minutes or until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
