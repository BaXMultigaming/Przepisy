  "ingredients": [
    "2 cups all-purpose flour",
    "3 tablespoons white sugar",
    "0.75 cup cold butter",
    "2 egg yolks, lightly beaten",
    "0.25 cup cold milk",
    "1 (14 ounce) can sweetened condensed milk",
    "1 teaspoon maple flavoring",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "0.66666668653488 cup coarsely chopped pecans",
    "0.66666668653488 cup coarsely chopped walnuts",
    "0.66666668653488 cup sliced almonds",
    "0.33333334326744 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and sugar in a bowl. Cut in butter until the mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine egg yolks and milk in a small bowl; stir into flour mixture until dough is blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press dough, using lightly floured hands, into the bottom and 1 inch up the sides of a 12-inch tart pan with a removable bottom. Line the unpricked shell with a double thickness of aluminum foil. Place pan on a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine condensed milk, maple flavoring, cinnamon, and salt in a medium bowl. Stir pecans, walnuts, and almonds into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove shell from the oven, leaving oven on, and fill with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return tart to the oven and bake until golden brown, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and cool completely on a wire rack, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate chips in a microwave-safe bowl and heat in a microwave oven until melted, 1 to 3 minutes. Drizzle tart with melted chocolate. Refrigerate until chocolate has hardened and filling is firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
