  "ingredients": [
    "1 (16 ounce) package tri-color rigatoni pasta",
    "2 onions, diced",
    "3 tomatoes, diced",
    "12 ounces provolone cheese, cut into strips",
    "2 green bell peppers, diced",
    "1 (8 ounce) package sliced pepperoni",
    "0.25 cup sliced olives, or to taste",
    "1 cup olive oil",
    "0.5 cup vinegar",
    "2 tablespoons grated Parmesan cheese",
    "1 tablespoon white sugar",
    "0.5 teaspoon dried oregano",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook rigatoni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain and let cool while you make the dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, vinegar, Parmesan cheese, sugar, and oregano together in a bowl until well combined; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pasta, onions, tomatoes, provolone cheese, green bell peppers, pepperoni, and olives in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing over pasta mixture; toss until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
