  "ingredients": [
    "1 pound Brussels sprouts, trimmed",
    "3 tablespoons extra-virgin olive oil",
    "1 teaspoon kosher salt, or to taste",
    "0.5 teaspoon freshly ground black pepper, or to taste",
    "1 tablespoon good quality balsamic vinegar",
    "2 tablespoons honey, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Brussels sprouts, olive oil, salt and pepper in a large bowl; toss to coat. Spread out evenly on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until browned, about 30 minutes, turning after 15 minutes. Remove from oven and drizzle with balsamic vinegar and honey, mixing to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
