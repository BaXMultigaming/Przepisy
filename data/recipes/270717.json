  "ingredients": [
    "1 pound salmon fillets",
    "salt and ground black pepper to taste",
    "0.5 cup mayonnaise",
    "1 teaspoon minced garlic",
    "1 teaspoon chopped fresh dill",
    "0.5 medium lemon, juiced",
    "0.5 cup pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut salmon into smaller, equal-sized portions if needed. Pat dry. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mayonnaise, garlic, dill, and lemon juice together in a bowl. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the pecans in a food processor. Pulse for 1 second and check the size of the pieces. You want it to be not quite powdery, but still with some larger chunks. Continue to pulse in 1-second bursts until desired consistency is achieved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the salmon on a baking sheet. Layer the top of the salmon with aioli, then with pecans, until completely covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
