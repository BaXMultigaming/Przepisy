  "ingredients": [
    "2 teaspoons butter, or as needed",
    "5 eggs, lightly beaten",
    "1 (24 ounce) carton cottage cheese (4% milk fat)",
    "1 pint heavy whipping cream",
    "0.75 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground nutmeg",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a casserole dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir beaten eggs, cottage cheese, cream, sugar, vanilla extract, nutmeg, and salt together in a bowl; pour into prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until set and completely browned on top, about 1 hour. Set aside to cool.",
