  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almonds, sugar, butter, flour, and egg for filling in a food processor; process until fine. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs, sugar, and melted butter for crust in a food processor and process until fine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press graham cracker mixture into the bottom of a 9-inch springform pan. Pour almond filling into the pan and spread evenly. Place sliced pears in a ring around the top of the tart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until almond filling is set and not jiggly, about 40 minutes. Remove from the oven and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt apricot jam in a small saucepan over medium heat. Brush over the top of the tart.",
