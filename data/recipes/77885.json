  "ingredients": [
    "1/2 cup unsalted butter, divided",
    "1 French baguette, cut into 1/3 inch thick slices",
    "4 ounces crumbled blue cheese",
    "salt and pepper to taste",
    "0.5 cup chopped walnuts",
    "0.5 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add ¼ cup butter to a microwave-safe dish; microwave until melted. Brush one side each bread slice with melted butter; place buttered-sides-up on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly toasted, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine blue cheese, remaining ¼ cup softened butter, salt, and black pepper in a small bowl. Spread over toasted bread slices; sprinkle with chopped walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping melted and bubbly, about 6 minutes. Garnish with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
