  "ingredients": [
    "2 (12 ounce) packages frozen hash brown potatoes",
    "0.33333334326744 cup butter, melted",
    "1 cup cooked diced ham",
    "1 cup shredded Monterey Jack cheese",
    "2 eggs",
    "0.5 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Squeeze thawed hash browns to remove excess moisture, then combine with melted butter in a small bowl. Press mixture into the bottom and up the sides of an ungreased 10-inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and arrange ham and cheese evenly over crust. In a small bowl, beat together eggs and cream; pour over ham and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake for 30 minutes, or until custard has completely set.",
      "section": null,
      "name": null,
