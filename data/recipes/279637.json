  "ingredients": [
    "0.5 cup mirin (Japanese sweet wine)",
    "3 tablespoons sake",
    "2 tablespoons soy sauce",
    "1 tablespoon rice wine vinegar",
    "1 teaspoon wasabi powder",
    "12 fresh oysters",
    "6 quail eggs",
    "0.75 teaspoon tobiko (flying fish roe)",
    "6 lemon wedges"
  ],
  "steps": [
    {
      "text": "Whisk together mirin, sake, soy sauce, rice wine vinegar, and wasabi powder in a bowl. Allow mixture to sit at room temperature until sediments sink to the bottom of the bowl, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shuck oysters; place 2 oysters in each shooter glass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle 2 tablespoons mirin mixture into each glass, without disturbing sediments at the bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crack 1 quail egg into each glass. Top each with 1/8 teaspoon tobiko and garnish with lemon wedges. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
