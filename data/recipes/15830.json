  "ingredients": [
    "1 (9 inch) prepared graham cracker crust",
    "3 eggs, separated",
    "1 (14 ounce) can sweetened condensed milk",
    "1 teaspoon grated lime zest",
    "0.33333298563957 cup fresh lime juice",
    "1 cup frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 250 degrees F (125 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large glass or metal bowl, beat egg whites until stiff peaks form. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat egg yolks, then stir in condensed milk, lime rind, and lime juice. Mix well, then fold mixture into beaten egg whites. Pour mixture into graham cracker crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 10 minutes. Chill before serving. Garnish with whipped topping if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
