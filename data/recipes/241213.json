  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1OMDwZ2Rs2hq5tECmqYx9YrurxM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241213-hard-steamed-eggs-VAT-step-01-d450331a90684f8c9e4b62f38c23739d.jpg"
      ],
      "image": "assets/images/241213/step_01.webp"
    },
    {
      "text": "Place a steamer insert into a pot and fill with water to just below the bottom of the steamer. Bring water to just below a boil over medium heat. Gently place the eggs in the steamer insert, cover the pot, and steam for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NtlKyU1kdnA8xae9fOUZC26D0Jk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241213-hard-steamed-eggs-VAT-step-02-1efa13bfdbc2434f90fba9387e23cb1e.jpg"
      ],
      "image": "assets/images/241213/step_02.webp"
    },
    {
      "text": "Immediately transfer eggs to a bowl of ice water until cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d_iinyGLQBgD_zmQDBaEuMqKDIY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241213-hard-steamed-eggs-VAT-step-03-8b25fb3492e846b49cc41ecb6a4ea0a8.jpg"
      ],
      "image": "assets/images/241213/step_03.webp"
    },
    {
      "text": "Make a small crack on the large end of each egg and place eggs back into the ice water for about 20 minutes, then peel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7d7s5mSZLoMvfdaeF4BPwc0Z0B8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/241213-hard-steamed-eggs-VAT-step-04-9e07d872b60145179be3db920398704c.jpg"
