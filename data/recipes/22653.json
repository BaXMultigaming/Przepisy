  "ingredients": [
    "1 cup distilled white vinegar",
    "2 cups white sugar",
    "1 tablespoon salt",
    "6 cups sliced cucumbers",
    "1 cup sliced onions",
    "1 cup sliced green bell peppers"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Gk4V9x6tDMjOh4rzfNtajWdtq8Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22653-HomemadeRefrigeratorPickles-ddmfs-Step1-3x4-8293-902cf8db335247058c1cb988276e708a.jpg"
      ],
      "image": "assets/images/22653/step_01.webp"
    },
    {
      "text": "Inspect several canning jars for cracks and rings for rust, discarding any defective ones. Immerse in simmering water until needed. Wash new, unused lids and rings in warm soapy water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring vinegar, sugar, and salt to a boil in a medium saucepan over medium heat. Boil until sugar dissolves, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nvESz5N8LSXiN8F8b5W-bRgwCss=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22653-HomemadeRefrigeratorPickles-ddmfs-Step2-3x4-8302-a6825127987b45459477ef7914a7a2d4.jpg"
      ],
      "image": "assets/images/22653/step_03.webp"
    },
    {
      "text": "Place cucumbers, onions, and bell peppers into a large glass mixing bowl. Pour brine over top and toss vegetables for several minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_cH2_o_Jj7vJw9Psxk40sweoTw0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22653-HomemadeRefrigeratorPickles-ddmfs-Step4-3x4-8305-0140a471008944be966afe935733a63e.jpg"
      ],
      "image": "assets/images/22653/step_04.webp"
    },
    {
      "text": "Transfer vegetables and brine to the sterilized jars; don’t worry if the brine doesn’t cover the vegetables. Refrigerate for 1 to 4 days before eating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lhQEga_ndGVti0s-CCeCYj9YjDo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22653-HomemadeRefrigeratorPickles-ddmfs-3x4-8321-a3fda4f9d1d94dceb656d50c1ec5560e.jpg"
      ],
      "image": "assets/images/22653/step_05.webp"
    }
