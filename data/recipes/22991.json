  "title": "Spaghetti Pie with Cream Cheese",
  "description": "Really easy and filling spaghetti pie with cream cheese recipe. Serve with a tossed salad and garlic bread. Better than lasagna.",
  "authors": [
    "Gwen Jowers"
  ],
  "date_published": "2000-06-18T20:00:30-04:00",
