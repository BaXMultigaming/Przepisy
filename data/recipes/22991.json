  "ingredients": [
    "1 pound spaghetti",
    "cooking spray",
    "1 pound lean ground beef",
    "1 (26 ounce) jar pasta sauce",
    "0.5 cup chopped green bell pepper",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon garlic powder, or to taste",
    "0.75 cup sour cream",
    "0.5 cup chopped green onions",
    "0.5 (8 ounce) package cream cheese",
    "1.5 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet over medium heat, cook ground beef until brown and crumbly. Drain excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pasta sauce, bell pepper, salt, black pepper, and garlic powder into ground beef in the skillet. Bring to a boil; reduce heat and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine sour cream, green onions, and cream cheese in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cooked spaghetti in the prepared baking dish. Spread with cream cheese mixture; top with meat mixture and sprinkle with Cheddar Cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake in the preheated oven for 25 minutes. Uncover and bake for 5 more minutes until cheese is bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
