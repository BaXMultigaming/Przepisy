  "ingredients": [
    "10 fresh tomatillos, husks removed",
    "2 fresh jalapeno peppers, stems removed",
    "1 bunch fresh cilantro, stems trimmed",
    "3 avocados, peeled and pitted",
    "1 tablespoon garlic powder",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Bring a pot of water to a boil and stir in tomatillos and jalapenos. Boil until tomatillos turn bright green and soft, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cilantro, avocados, cooked tomatillos, and cooked jalapenos into a blender, working in batches if necessary. Blend until smooth, 1 to 2 minutes. Add about 1 tablespoon of tomatillo cooking water, or as needed, if salsa is too thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stop the blender, and season the salsa with garlic powder and salt to taste. Blend again briefly to mix in the seasonings. Transfer to a bowl for serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
