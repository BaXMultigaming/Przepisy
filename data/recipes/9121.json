  "ingredients": [
    "1 cup pumpkin puree",
    "3 eggs",
    "0.5 cup white sugar",
    "1 cup milk",
    "0.5 teaspoon salt",
    "2 teaspoons pumpkin pie spice",
    "2 tablespoons butter",
    "1 (.25 ounce) package unflavored gelatin",
    "0.25 cup water",
    "0.5 cup white sugar",
    "1 (16 ounce) package gingersnap cookies"
  ],
  "steps": [
    {
      "text": "Line one 9 inch pie pan with whole gingersnap cookies, breaking as necessary for fitting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan over medium heat cook pumpkin puree to heat through, stirring frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate the eggs. Combine the egg yolks, 1/2 cup sugar, milk, spices and butter or margarine. Add to pumpkin and cook, stirring frequently until mixture is of custard consistency. Remove mixture from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Soften gelatin in the cold water and stir into the pumpkin until dissolved. Chill mixture until it begins to stiffen (about 1 1/2 hours).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip egg whites with the remaining 1/2 cup sugar until stiff. Fold whipped egg whites into the pumpkin mixture. Spoon mixture into the prepared pan and chill until set (about 3 hours). Serve topped with whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
