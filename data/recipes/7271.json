  "title": "Pumpkin Pie Cake with Yellow Cake Mix",
  "description": "This is a good winter holiday cake. Great when topped with whipped cream or nondairy whipped topping.",
  "authors": [
    "Rosie De Coito"
  ],
  "date_published": "1998-03-13T15:09:13-05:00",
