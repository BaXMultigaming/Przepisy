  "ingredients": [
    "1 pouch Barilla® Ready Pasta Cut Macaroni",
    "2 tablespoons extra-virgin olive oil",
    "Salt and pepper to taste",
    "1 lemon, juiced",
    "1.5 cups cherry tomatoes, halved",
    "1.5 cups broccoli florets, cut into small pieces",
    "0.5 cup sharp Cheddar cheese, shredded",
    "1 cup cooked ham, julienned",
    "2 hard-boiled eggs, chopped"
  ],
  "steps": [
    {
      "text": "Tear corner of Ready Pasta pouch to vent. Heat in the microwave for one minute; place on a plate and let cool down.",
