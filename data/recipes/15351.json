  "ingredients": [
    "2 (10.75 ounce) cans condensed cream of chicken soup",
    "1 whole cooked chicken, cut into pieces",
    "1 (16 ounce) package frozen mixed vegetables, thawed",
    "2 cups cooked rice",
    "0.66666668653488 cup water",
    "0.5 cup crushed buttery round crackers"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine the soup, chicken, cooked vegetables, cooked rice and water. Mix well and spread mixture in a 9x13 inch baking dish. Sprinkle crushed cracker crumbs on top and bake in the preheated oven for about 15 to 20 minutes. Let cool 10 minutes and serve.",
