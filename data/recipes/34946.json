  "ingredients": [
    "1 pound thin asparagus spears",
    "1 tablespoon extra virgin olive oil",
    "1 ounce shaved Parmesan cheese",
    "freshly ground black pepper to taste",
    "0.25 cup balsamic vinegar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place asparagus spears on a baking sheet. Drizzle with olive oil; toss to coat evenly. Arrange asparagus spears in a single layer. Sprinkle Parmesan cheese over asparagus and season with freshly ground black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and asparagus is tender but crisp, 12 to 15 minutes. Serve hot on warm plates, sprinkling with balsamic vinegar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
