  "ingredients": [
    "1 Rock Cornish hens",
    "2 tablespoons vegetable oil",
    "5 stalks celery, chopped",
    "3 large carrots, diced",
    "1 onion, chopped",
    "6 cloves garlic, minced",
    "3 potatoes, peeled and cubed",
    "1 (48 fluid ounce) can chicken broth"
  ],
  "steps": [
    {
      "text": "Remove gizzards from hen and wash hen thoroughly with water. Cut hen into several pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large pot over medium-high heat. Add hen pieces and cook in hot oil until browned on all sides. Add celery, carrots, onion, garlic, and potatoes; cook and stir until onion is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in chicken broth. Use more or less broth to your taste, but make sure to cover all the ingredients in the pot. Bring to a boil, then reduce heat and simmer until vegetables are tender and hen is cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove hen from the pot and remove meat from the bones. Discard bones and return meat to soup. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
