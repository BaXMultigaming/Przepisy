  "ingredients": [
    "1 (16 ounce) package bacon",
    "1 head cauliflower, chopped",
    "1 head broccoli, chopped",
    "1 (8 ounce) package shredded mozzarella cheese",
    "1 small onion, chopped",
    "0.25 cup white sugar",
    "2 tablespoons milk",
    "1.5 cups mayonnaise",
    "0.25 cup grated Parmesan cheese",
    "2 tablespoons vinegar"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels. Crumble bacon slices into small pieces. Reserve 1/2 cup bacon pieces in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining bacon, cauliflower, broccoli, mozzarella cheese, and onion in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar and milk together in a small bowl until sugar is dissolved. Mix in mayonnaise, Parmesan cheese, and vinegar. Pour dressing over cauliflower mixture. Top with reserved bacon. Chill for 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
