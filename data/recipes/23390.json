  "ingredients": [
    "2 egg yolks",
    "5 tablespoons white sugar",
    "1.5 teaspoons vanilla extract",
    "0.5 cup butter, melted",
    "1 teaspoon salt",
    "2.75 cups self-rising flour",
    "2 cups warm milk",
    "2 egg whites"
  ],
  "steps": [
    {
      "text": "In a large bowl, beat together egg yolks and sugar. Beat in vanilla extract, butter and salt. Alternately mix in flour and milk until blended well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, beat egg whites until they have formed soft peaks. Fold egg whites into batter and let stand for 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray preheated waffle iron with non-stick cooking spray. Pour mix onto hot waffle iron. Cook until golden brown and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
