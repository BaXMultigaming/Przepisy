  "ingredients": [
    "2 cups frozen berries and cherries",
    "2 tablespoons white sugar",
    "1 dash salt",
    "1 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Combine fruit, sugar, and salt in a saucepan over medium heat until fruit is thawed and just warmed through, about 5 minutes. Do not boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer fruit mixture to the bowl of a small food processor; pulse until smooth, 15 to 20 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain puréed mixture using a fine-mesh strainer into a bowl, pressing solids with the back of a spoon. Stir lemon juice into coulis; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
