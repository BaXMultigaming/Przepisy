  "title": "Earthquake Cake",
  "description": "This decadent earthquake cake features a coconut and pecan layer topped with a boxed German chocolate cake batter and a sweetened cream cheese mixture.",
  "authors": [
    "DARLENEL"
  ],
  "date_published": "1999-07-15T20:57:09-04:00",
