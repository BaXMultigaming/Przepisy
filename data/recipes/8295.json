  "ingredients": [
    "1 cup flaked coconut",
    "1 cup chopped pecans",
    "1 (18.25 ounce) package German chocolate cake mix",
    "1 1/4 cups water",
    "1/2 cup vegetable oil",
    "3 large eggs",
    "1 (8 ounce) package cream cheese",
    "0.5 cup butter",
    "1 teaspoon vanilla extract",
    "4 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease the bottom and sides of a 9x13-inch baking pan. Layer coconut and pecans in the bottom of pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cake mix, water, oil, and eggs in a large bowl with an electric mixer on medium speed until well combined. Pour over coconut and pecans. Clean the bowl and mixer attachments.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, butter, and vanilla in the bowl until combined. Gradually mix in confectioners' sugar until smooth. Pour over cake batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes; a toothpick will not come out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
