  "ingredients": [
    "2 tablespoons olive oil",
    "2 (16 ounce) packages frozen corn",
    "0.25 cup crumbled cotija cheese",
    "0.25 cup minced red onion",
    "2 tablespoons finely chopped cilantro",
    "3 tablespoons mayonnaise",
    "2 tablespoons sour cream",
    "2 tablespoons lime juice",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon smoked sweet paprika",
    "0.25 teaspoon chili powder",
    "0.25 teaspoon salt",
    "1 pinch ground coriander"
  ],
  "steps": [
    {
      "text": "Heat a 14-inch skillet over medium-high heat. Add olive oil and swirl to coat the bottom of the skillet. Spread frozen corn evenly across the skillet; do not stir. Cook corn for approximately 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine mayonnaise, sour cream, lime juice, cumin, paprika, chili powder, salt, and coriander in a large bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Check the corn; it should be slightly charred. If not, allow to continue cooking for 4 more minutes (stirring is fine at this point.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once corn is sufficiently browned/charred, transfer to the bowl with dressing and toss to coat. Add cotija cheese, red onion, and cilantro and mix until well combined. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
