  "ingredients": [
    "2 tablespoons all-purpose flour",
    "2 9-inch pie crusts",
    "7 cups frozen mixed berries (blackberries, blueberries, and raspberries)",
    "0.75 cup granulated sugar",
    "0.33333334326744 cup arrowroot powder",
    "0.5 teaspoon salt",
    "1 cup rolled oats",
    "1 cup all-purpose flour",
    "0.75 cup packed light brown sugar",
    "1 teaspoon apple pie spice",
    "0.5 teaspoon salt",
    "7 tablespoons cold unsalted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly dust an 11x15-inch half-sheet pan with flour. Carefully place the 2 pie crusts into the bottom of the sheet pan, gently stretching and trimming the crusts to fit the bottom and up the sides of the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine berries, sugar, arrowroot powder, and salt in a large bowl; stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, flour, brown sugar, apple pie spice, and salt in a medium bowl. Use a pastry knife to cut butter into the oat mixture until butter is evenly distributed throughout and the crumble topping mixture resembles small, uneven pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour berry mixture evenly onto the crust and add crumble mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until brown and bubbly, 45 to 55 minutes. Remove and allow to cool for 30 to 45 minutes",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
