  "ingredients": [
    "0.5 cup rice flour",
    "0.5 cup sorghum flour",
    "0.5 cup amaranth",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "1 cup almond milk",
    "0.5 cup unsweetened applesauce",
    "1 egg",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Heat a griddle over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk rice flour, sorghum flour, amaranth, baking powder, and cinnamon together in a bowl. Stir almond milk, applesauce, and egg into flour mixture until batter is just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray griddle with cooking spray. Drop batter by large spoonfuls onto the griddle and cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
