  "ingredients": [
    "cooking spray",
    "2 cups coarsely chopped zucchini",
    "1.5 cups coarsely chopped onions",
    "1 red bell pepper, coarsely chopped",
    "1 pound extra lean ground turkey",
    "0.5 cup uncooked couscous",
    "1 large egg",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon Dijon mustard",
    "0.5 cup barbecue sauce, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray 20 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place zucchini, onions, and red bell pepper into a food processor, and pulse several times until finely chopped but not liquefied. Place the vegetables into a bowl and mix in ground turkey, couscous, egg, Worcestershire sauce, and Dijon mustard until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each prepared muffin cup about 3/4 full. Top each cup with about 1 teaspoon of barbecue sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until juices run clear, about 25 minutes. An instant-read thermometer inserted into the center of muffins should read at least 165 degrees F (74 degrees C). Let stand 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
