  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup Ghirardelli Unsweetened Cocoa",
    "1 tablespoon baking powder",
    "2 tablespoons white sugar",
    "0.5 teaspoon salt",
    "2 cups whole milk",
    "4 large eggs, separated",
    "4 tablespoons canola oil",
    "1.5 cups Ghirardelli Semi-Sweet Chocolate Baking Chips"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to the manufacturer's directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift the flour, cocoa, and baking powder into a bowl. Add the sugar and salt and whisk to thoroughly mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, whisk together the milk, egg yolks, and oil. Add to the flour mixture and whisk gently until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In clean, dry bowl, beat the egg whites with an electric beater at medium speed until they form soft peaks. Fold into the batter and mix in the chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle one-third of the batter onto the center of the waffle iron. Close the top and cook until the waffle is crispy on both sides, about 5 minutes. Repeat with remaining batter. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
