  "ingredients": [
    "1 (8 ounce) package wide egg noodles",
    "0.5 cup butter",
    "0.5 cup heavy whipping cream",
    "1 cup grated Parmesan cheese",
    "1 tablespoon dried parsley",
    "0.25 teaspoon salt",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat butter and cream in a small saucepan over low heat until butter melted. Stir in cheese, parsley, salt, and pepper; keep warm over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain egg noodles; toss with sauce to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
