  "ingredients": [
    "0.5 cup all-purpose flour",
    "1 tablespoon curry powder",
    "2 teaspoons white sugar",
    "1 teaspoon brown sugar",
    "1 teaspoon baking powder",
    "1 teaspoon ground cumin",
    "0.75 teaspoon salt",
    "0.5 teaspoon cayenne pepper",
    "0.25 teaspoon black pepper",
    "2 eggs, lightly beaten",
    "0.5 cup milk",
    "4 cups peeled, shredded sweet potato",
    "2 cups oil for frying, or as needed"
  ],
  "steps": [
    {
      "text": "Combine flour, curry powder, white sugar, brown sugar, baking powder, cumin, salt, cayenne pepper, and black pepper in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together eggs and milk in a separate bowl. Pour into flour mixture and stir until well blended and batter has no lumps. Stir in sweet potatoes until fully combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat enough oil to cover the bottom of a heavy skillet over medium heat. Drop batter by tablespoonfuls into hot oil, using spatula to flatten. Fry until well browned, about 3 to 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain on paper towels and serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
