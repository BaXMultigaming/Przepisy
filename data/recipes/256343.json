  "ingredients": [
    "0.5 cup vegetable oil",
    "0.5 cup all-purpose flour",
    "1 large onion, chopped",
    "0.5 cup finely chopped celery",
    "0.5 cup sliced green onion",
    "0.5 cup chopped fresh parsley",
    "6 cloves garlic, minced",
    "4 cups chicken broth",
    "1 teaspoon salt",
    "0.5 teaspoon ground red chile pepper",
    "2 pounds fresh medium shrimp, peeled and deveined",
    "3 cups hot cooked rice",
    "9 sprigs fresh parsley"
  ],
  "steps": [
    {
      "text": "Combine vegetable oil and flour in a large stockpot over medium heat; cook, stirring often, until roux is dark brown, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir onion, celery, green onion, parsley, and garlic carefully into the hot roux; it may splatter. Cook and stir until onion mixture is tender, about 5 minutes. Pour in broth. Season with salt and red chile pepper. Simmer gumbo, covered, until flavors combine, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir shrimp into the stockpot; cook until pink and opaque, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1/3 cup rice into each serving bowl. Ladle shrimp gumbo on top. Garnish with fresh parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
