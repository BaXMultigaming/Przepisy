  "ingredients": [
    "1 small lemon",
    "5 cloves garlic, minced",
    "2 tablespoons chopped fresh rosemary",
    "1 tablespoon chopped fresh thyme",
    "1 tablespoon chopped fresh parsley",
    "1 tablespoon olive oil",
    "1 teaspoon sea salt",
    "1 teaspoon ground black pepper",
    "0.25 teaspoon onion powder",
    "1 (3 pound) leg of lamb",
    "0.5 cup vegetable broth"
  ],
  "steps": [
    {
      "text": "Grate lemon zest into a mortar; reserve zested lemon. Add garlic, rosemary, thyme, parsley, olive oil, sea salt, black pepper, and onion powder to the mortar; grind into a paste using a pestle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat lamb dry; rub herb mixture all over lamb. Place into a 3-quart slow cooker; squeeze juice of reserved lemon over lamb. Add broth and cover slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
