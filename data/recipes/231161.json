  "ingredients": [
    "1 (1 pound) package washed and chopped collard greens",
    "4 bacon slices, chopped",
    "1 tablespoon salt",
    "1 tablespoon garlic powder",
    "1 tablespoon onion powder",
    "1 tablespoon white sugar",
    "1 pinch cayenne pepper",
    "5 cups water, or as needed"
  ],
  "steps": [
    {
      "text": "Combine collard greens, bacon, salt, garlic powder, onion powder, sugar, and cayenne pepper in a stockpot. Pour in enough water to cover greens completely. Bring to a boil, reduce heat to low, and cook at a simmer until greens are tender, about 2 hours.",
