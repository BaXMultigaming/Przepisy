  "ingredients": [
    "3 tablespoons red wine vinegar",
    "2 tablespoons cornstarch",
    "3 cups chicken broth",
    "0.5 cup water",
    "0.5 cup sliced bamboo shoots, drained",
    "8 dried shiitake mushrooms, rehydrated",
    "1 clove garlic, crushed",
    "1 (1/2 inch) piece fresh ginger root",
    "2 teaspoons soy sauce",
    "0.25 teaspoon red pepper flakes",
    "2 ounces firm tofu, diced",
    "1 egg, beaten",
    "2 green onions, chopped"
  ],
  "steps": [
    {
      "text": "Stir vinegar and cornstarch together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chicken broth, water, bamboo shoots, shiitake mushrooms, garlic, ginger root, soy sauce, and red pepper flakes in a saucepan over medium-high heat. Bring to a boil. Reduce heat to low; cover and simmer for 5 minutes. Remove lid and add tofu. Return to a boil; slowly drizzle in egg while stirring. Stir in cornstarch mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Simmer soup over medium heat until broth has thickened slightly, about 3 minutes. Top with green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
