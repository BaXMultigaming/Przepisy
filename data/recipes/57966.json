  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "1.5 pounds beef top sirloin, thinly sliced",
    "2 cups water",
    "1 cup long grain rice",
    "0.33333334326744 cup white sugar",
    "0.33333334326744 cup rice wine vinegar",
    "2 tablespoons frozen orange juice concentrate",
    "1 tablespoon soy sauce",
    "1 teaspoon salt",
    "2 cups oil for frying",
    "0.25 cup cornstarch",
    "3 tablespoons grated fresh ginger",
    "1.5 tablespoons minced garlic",
    "2 teaspoons orange zest",
    "8 broccoli florets, lightly steamed or blanched"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sX2RUzMj_IwBNvZa6ScnP2_0gYk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-57966-crispy-orange-beef-step-1-a55fad2751dd424e8447dd1a789c3a07.jpg"
      ],
      "image": "assets/images/57966/step_01.webp"
    },
    {
      "text": "Lay beef in a single layer on a baking sheet lined with paper towels. Allow to dry in the refrigerator for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ikHpJh2Ju36K7NBvgzckjM495Z4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-57966-crispy-orange-beef-step-2-7e6c292c2a214c9b92d891f74399df7f.jpg"
      ],
      "image": "assets/images/57966/step_02.webp"
    },
    {
      "text": "Meanwhile, bring water and rice to a boil in a medium saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p4P4ho3txYKsPk6o_wiKhfnSHhk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-57966-crispy-orange-beef-step-3-0c80ea7454f2460aa0ec84bcbf5de076.jpg"
      ],
      "image": "assets/images/57966/step_03.webp"
    },
    {
      "text": "Reduce heat to medium-low, cover, and simmer until rice is tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nwqRpDLrn4rda1W_D1AYQCceQxc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-57966-crispy-orange-beef-step-4-9cc9444aa6bd4207ad33f3539196126c.jpg"
      ],
      "image": "assets/images/57966/step_04.webp"
    },
    {
      "text": "Mix together sugar, rice vinegar, orange juice concentrate, soy sauce, and salt in a small bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F_1TrDU2m6KTdUkV8zVpajBGkxg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-57966-crispy-orange-beef-step-5-ff29c32ae4ff4c45bd10e3f3e7d50bb5.jpg"
      ],
      "image": "assets/images/57966/step_05.webp"
    },
    {
      "text": "Heat oil in a wok over medium-high heat. Toss dried beef in cornstarch to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pMIxaepiJ5PehO21N1RCMSwsZg8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-57966-crispy-orange-beef-step-6-e9c728c2e201401bba46366d78d67df2.jpg"
      ],
      "image": "assets/images/57966/step_06.webp"
    },
    {
      "text": "Fry coated beef in hot oil in small batches until crispy and golden brown; set aside. Drain oil from the wok, leaving about 1 tablespoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b6JeF4aBSg-whpODu9D9o85XI54=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-57966-crispy-orange-beef-step-7-dcde2c14bc9248bbb63da0f4cafc603e.jpg"
      ],
      "image": "assets/images/57966/step_07.webp"
    },
    {
      "text": "Add ginger, garlic, and orange zest to remaining oil in wok.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4729hd6J2JpBv3hQPd262hsp9Ck=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-57966-crispy-orange-beef-step-8-cdeae1587bcd44bd8af4c9a0b3c7163d.jpg"
      ],
      "image": "assets/images/57966/step_08.webp"
    },
    {
      "text": "Cook and stir briefly until fragrant. Pour in soy sauce mixture; bring to a boil and cook until thick and syrupy, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k8OD0CHrQHA7qiQQ03uyoSoeEwE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-57966-crispy-orange-beef-step-9-817cb2cf280c48d19ebabac449288d50.jpg"
      ],
      "image": "assets/images/57966/step_09.webp"
    },
    {
      "text": "Stir in fried beef and cook until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6lxgjck-HSB_XBQ3S8isw3IVV9I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-57966-crispy-orange-beef-step-10-3f78da72aae04145b42ce61bfe227ef8.jpg"
      ],
      "image": "assets/images/57966/step_10.webp"
    },
    {
      "text": "Serve hot over steamed rice and garnish with broccoli.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kI3Zv4V9hCMr8c8i5J7rGgWalPY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-57966-crispy-orange-beef-step-11-f5ca47301cae4b47aadc334c1928092e.jpg"
      ],
      "image": "assets/images/57966/step_11.webp"
    }
  ],
