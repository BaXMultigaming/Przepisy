  "ingredients": [
    "1 large head cauliflower, sliced lengthwise through the core into 4 steaks",
    "0.25 cup olive oil",
    "1 tablespoon fresh lemon juice",
    "2 cloves garlic, minced",
    "1 pinch red pepper flakes, or to taste",
    "salt and ground black pepper to taste"
