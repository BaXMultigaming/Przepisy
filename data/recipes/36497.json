  "ingredients": [
    "2 cups water",
    "1 cup brown rice",
    "1 tablespoon olive oil",
    "0.5 teaspoon salt",
    "1 cup frozen corn kernels",
    "0.5 teaspoon dried cilantro",
    "0.5 teaspoon cumin seed"
  ],
  "steps": [
    {
      "text": "In a saucepan, mix the water, rice, olive oil, and salt, and bring to a boil. Mix in the corn, cilantro, and cumin. Reduce heat, cover, and simmer 45 to 60 minutes, until the liquid has been absorbed.",
