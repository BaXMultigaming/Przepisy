  "ingredients": [
    "cooking spray",
    "6 tablespoons hot pepper sauce",
    "0.33333334326744 cup olive oil",
    "2 tablespoons garlic powder",
    "1 tablespoon freshly ground black pepper",
    "1 tablespoon paprika",
    "1.5 teaspoons salt",
    "8 potatoes, cut into 1/2-inch cubes",
    "2 pounds skinless, boneless chicken breast halves, cut into 1/2-inch cubes",
    "2 cups shredded Mexican cheese blend (such as Great Value Fiesta Blend®)",
    "1 cup crumbled cooked bacon",
    "1 cup diced green onions"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/duwhrqQsCdOANRIpf6vqUH5v2HY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229964-Buffalo-Chicken-and-Roasted-Potato-Casserole-DDMFS-step0-c6561c2aa57a4b9da4d4af0b8051bf29.jpg"
      ],
      "image": "assets/images/229964/step_01.webp"
    },
    {
      "text": "Preheat the oven to 500 degrees F (260 degrees C). Spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat hot pepper sauce, olive oil, garlic powder, black pepper, paprika, and salt in a large skillet over low heat, stirring until thoroughly combined. Turn off heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JEkHQkFXnnB-GePle5VY59ERS38=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229964-Buffalo-Chicken-and-Roasted-Potato-Casserole-DDMFS-step2-8e4546add6da403fb704539dfa5a0a99.jpg"
      ],
      "image": "assets/images/229964/step_03.webp"
    },
    {
      "text": "Toss potatoes in batches with the hot pepper sauce mixture to coat and use a slotted spoon to transfer potatoes to the prepared baking dish. Leave remaining sauce in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Xajcm7hoA6CqHFmKSXASMjwB5Bw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229964-Buffalo-Chicken-and-Roasted-Potato-Casserole-DDMFS-step3-240bef78f66f43b084f47d4ebc158069.jpg"
      ],
      "image": "assets/images/229964/step_04.webp"
    },
    {
      "text": "Mix chicken into remaining sauce and allow to marinate while potatoes roast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OKhI_XrFCfu0yQ7x4B6r_3vofLM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229964-Buffalo-Chicken-and-Roasted-Potato-Casserole-DDMFS-step4-e6cfc1c7df674cdab960670c944560b7.jpg"
      ],
      "image": "assets/images/229964/step_05.webp"
    },
    {
      "text": "Bake potatoes until tender inside and crisp and brown outside, 45 to 50 minutes, stirring every 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fNzD2jamLfqwGLqyYrxvZRInnZw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229964-Buffalo-Chicken-and-Roasted-Potato-Casserole-DDMFS-step5-b1ed02e63360494384c0500d53256edd.jpg"
      ],
      "image": "assets/images/229964/step_06.webp"
    },
    {
      "text": "Reduce oven heat to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread chicken cubes over roasted potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zrSXF2jAmHRWvE1d1q3gfehAcw8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229964-Buffalo-Chicken-and-Roasted-Potato-Casserole-DDMFS-step6-64680986ed5b429fbd897e7b19c9fa3f.jpg"
      ],
      "image": "assets/images/229964/step_08.webp"
    },
    {
      "text": "Sprinkle shredded cheese, cooked bacon, and green onions over chicken. Return to the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xoHKz-wqFD2kNQADIPyheWgahcc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229964-Buffalo-Chicken-and-Roasted-Potato-Casserole-DDMFS-step8-61f60b9eaaaf4603965072ced00bb895.jpg"
      ],
      "image": "assets/images/229964/step_09.webp"
    },
    {
      "text": "Bake in oven until chicken is cooked through and the cheese topping is bubbling, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zffjLIp1JBNaNl4JDvPeVvhOPm0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229964-Buffalo-Chicken-and-Roasted-Potato-Casserole-DDMFS-4x3-1cb5e7777f70413698dec581007be735.jpg"
      ],
      "image": "assets/images/229964/step_10.webp"
    }
  ],
