  "ingredients": [
    "2 pork shoulder (Boston butt) steaks",
    "1 teaspoon garlic powder, or to taste",
    "salt and pepper to taste",
    "1 large onion, sliced",
    "2 cups ketchup",
    "2 cups water"
  ],
  "steps": [
    {
      "text": "Season pork steaks on both sides with garlic powder, salt, and black pepper. Heat a large skillet over medium heat. Add pork steaks; cook until browned on each side, about 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place onion on top of steaks in skillet. Combine ketchup and water in a medium bowl; pour over steaks. Bring to a simmer, reduce heat to medium-low, cover, and cook for about 2 hours. The longer you cook steaks, the better they will taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
