  "ingredients": [
    "3 (14 ounce) cans vegetable broth",
    "0.75 cup wild rice",
    "0.75 cup brown rice",
    "1.5 tablespoons olive oil",
    "2 tablespoons balsamic vinegar",
    "2 tablespoons dry sherry",
    "1 tablespoon minced garlic",
    "0.25 teaspoon kosher salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon ground cardamom",
    "1 cup canned black beans, rinsed and drained",
    "1 (4 ounce) can shiitake mushrooms, drained",
    "0.33333334326744 cup dried cranberries",
    "1 tablespoon dried parsley"
  ],
  "steps": [
    {
      "text": "Combine vegetable broth, wild rice, brown rice, and olive oil in a saucepan; bring to a boil, reduce heat to low, cover with a lid, and simmer for 20 minutes. Stir balsamic vinegar, sherry, garlic, salt, black pepper, and cardamom into rice; cover with a lid and continue simmering until flavors start to combine, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir black beans, mushrooms, cranberries, and parsley into rice mixture; continue cooking over low heat until rice is tender and mixture is hot throughout, 10 to 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
