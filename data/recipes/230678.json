  "ingredients": [
    "3 cups diced rhubarb",
    "1.25 cups white sugar",
    "2 tablespoons all-purpose flour",
    "1 large egg",
    "0.5 teaspoon ground cinnamon",
    "1.5 cups all-purpose flour",
    "1 cup packed light brown sugar",
    "1 cup quick-cooking oats",
    "0.5 teaspoon ground cinnamon",
    "1 cup butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S84CoYkydxLOs7TZl-kPGZ4gSl4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230678-glenns-rhubarb-crumble-ddmfs-01-17639-175974f17bce4af7a03b1858f1010974.jpg"
      ],
      "image": "assets/images/230678/step_01.webp"
    },
    {
      "text": "Combine rhubarb, white sugar, 2 tablespoons flour, egg, and 1/2 teaspoon cinnamon together in a large bowl until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rhDm9jGhGwqaRAOMTPZrMrsrYsk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230678-glenns-rhubarb-crumble-ddmfs-02-17642-98227450969944768d4ad81e46bf8cfb.jpg"
      ],
      "image": "assets/images/230678/step_02.webp"
    },
    {
      "text": "Spread rhubarb mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v6yy3TYEiN0aTOX7j2LKMNFgDY8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230678-glenns-rhubarb-crumble-ddmfs-04-17644-8e18ae491e5d4668a1a69b29c39e575f.jpg"
      ],
      "image": "assets/images/230678/step_03.webp"
    },
    {
      "text": "Mix 1 ½ cups flour, brown sugar, oats, and 1/2 teaspoon cinnamon together in a separate bowl. Cut in butter using a pastry cutter or two forks until topping is crumbly. Sprinkle topping over rhubarb layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kpTK9QeO4ahfBk1q5AWxo95wCnY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230678-glenns-rhubarb-crumble-ddmfs-05-17647-91ddf524bd4d4ae49fdade39f3a2c3c8.jpg"
      ],
      "image": "assets/images/230678/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until hot and bubbling, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HrR0aXpTWhyrODoqrWWn50TFaVY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230678-glenns-rhubarb-crumble-ddmfs-06-17668-619fe953e52b45ba803be90278352cec.jpg"
      ],
      "image": "assets/images/230678/step_05.webp"
