  "ingredients": [
    "1 cup raw cashews",
    "1 cup soy milk",
    "1 tablespoon vanilla extract",
    "4 tablespoons agave nectar, or to taste",
    "2 tablespoons coconut oil",
    "1 pound fresh figs, halved"
  ],
  "steps": [
    {
      "text": "Place cashews in a bowl and cover with cold water and soak for 2 hours to overnight. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soaked cashews, milk, vanilla extract, and agave nectar in a blender; blend until smooth. Add some water or soy milk to thin, if needed. Transfer cashew cream to a serving bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat coconut oil in a skillet over medium heat and saute figs on both sides until softened and warmed, about 4 minutes. Serve with cashew cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
