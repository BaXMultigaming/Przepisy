  "ingredients": [
    "4 (4 ounce) fillets tilapia",
    "2 teaspoons butter",
    "0.5 teaspoon garlic salt, or to taste",
    "0.25 teaspoon seafood seasoning (such as Old Bay®), or to taste",
    "1 lemon, sliced",
    "1 (16 ounce) package frozen cauliflower with broccoli and red pepper",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees F). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tilapia fillets in the bottom of the baking dish, then dot with butter and season with garlic salt and seafood seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/87IEbMWWZYydAv1B8PhgBtu7QJU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70163-easy-baked-tilapia-ddmfs-step-1-0362-3x4-4ef2804334b9438bb6f2380cf0590681.jpg"
      ],
      "image": "assets/images/70163/step_02.webp"
    },
    {
      "text": "Top each fillet with a slice or two of lemon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BrpGGu5NQNE2ROn2DrlW71wiPaE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70163-easy-baked-tilapia-ddmfs-step-2-0365-3x4-a44fc7261499452495a930d8d9d46daa.jpg"
      ],
      "image": "assets/images/70163/step_03.webp"
    },
    {
      "text": "Arrange frozen mixed vegetables around fillets and season lightly with salt and pepper. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3eoVi8I0Gf3UMk_5nEE6hjpdtGI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70163-easy-baked-tilapia-ddmfs-step-3-0367-3x4-554e637c9ab94616bd1338d294fbc03c.jpg"
      ],
      "image": "assets/images/70163/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until vegetables are tender and fish flakes easily with a fork, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
