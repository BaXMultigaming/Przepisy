        "https://www.allrecipes.com/thmb/-2vqGBhx_yxGmX1YNI8OCGtypw4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70163-easy-baked-tilapia-ddmfs-step-4-0404-3x4-34221765e69444a8830c2eedcb4fc55d.jpg"
