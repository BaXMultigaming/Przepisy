  "ingredients": [
    "1 (16 ounce) package dry kidney beans",
    "2 teaspoons salt, divided",
    "3.5 (6 ounce) cans tomato paste",
    "0.25 cup brown sugar",
    "2 tablespoons vinegar",
    "1 tablespoon cornmeal",
    "1 teaspoon ground cumin",
    "0.5 teaspoon hot paprika",
    "0.5 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Place kidney beans in a large saucepan. Cover with water and soak for 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain water from kidney beans. Pour in fresh water to cover by 1-inch; add 1 teaspoon salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook beans over low heat for 2 hours. Remove from heat; drain excess water from pan until it just covers beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomato paste, brown sugar, vinegar, cornmeal, remaining 1 teaspoon salt, cumin, hot paprika, and ginger to beans. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bean mixture over low heat for 2 hours. Stir to loosen any beans on the bottom of the pan. Continue to cook over low heat until bean mixture has reduced and thickened, about 2 hours more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
