  "ingredients": [
    "0.25 cup butter",
    "0.5 cup brown sugar",
    "0.5 teaspoon ground nutmeg",
    "1 teaspoon ground cinnamon",
    "2 tablespoons water",
    "3 cups pecan halves"
  ],
  "steps": [
    {
      "text": "Melt butter in a 4-quart glass casserole dish in the microwave. Stir in brown sugar, nutmeg, cinnamon, and water. Microwave on high for 1 minute, then stir in pecans until well coated. Microwave for 4 to 5 more minutes on high, stirring every minute. Spread cooked nuts out onto parchment or waxed paper to cool.",
