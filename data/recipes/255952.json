  "ingredients": [
    "0.25 pound ground turkey",
    "1 egg, beaten, divided",
    "1 teaspoon minced water chestnuts",
    "1 teaspoon minced green onion",
    "0.5 teaspoon light soy sauce",
    "0.5 teaspoon minced fresh ginger",
    "0.5 teaspoon freshly ground black pepper",
    "0.25 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon red pepper flakes",
    "12 wonton wrappers",
    "vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Combine turkey, 1 tablespoon beaten egg, water chestnuts, green onion, soy sauce, ginger, black pepper, salt, garlic powder, and red pepper flakes in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a 3-inch biscuit cutter to cut wonton wrappers into circles. Place 1 1/2 teaspoon of the turkey filling in the center of each wonton wrapper. Brush one side of each wrapper with beaten egg. Fold wrapper over filling, pleating edges as you seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C). Fry pot stickers, 6 at a time, until browned, 3 to 6 minutes. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
