  "ingredients": [
    "0.75 pound uncooked pasta",
    "1 tablespoon olive oil",
    "1 pound spicy Italian sausage",
    "1 onion, chopped",
    "4 cloves garlic, minced",
    "1 (14.5 ounce) can chicken broth",
    "1 (14.5 ounce) can diced tomatoes",
    "1 teaspoon dried basil",
    "1 (10 ounce) package frozen chopped spinach",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until al dente, 8 to 10 minutes; drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until no longer pink, about 5 minutes. Add onion and garlic to the skillet; cook and stir for 2 minutes. Stir in broth, tomatoes, and basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook over medium heat until liquid reduces slightly, about 5 minutes. Add chopped spinach; cover the skillet, reduce heat, and simmer until spinach is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pasta to the skillet and mix until well combined. Sprinkle with Parmesan cheese; serve warm.",
      "section": null,
      "name": null,
      "url": null,
