  "ingredients": [
    "0.5 lime, juiced",
    "1 tablespoon white sugar",
    "5 mint leaves",
    "ice cubes",
    "2 fluid ounces white rum",
    "4 fluid ounces soda water",
    "1 lime wedge"
  ],
  "steps": [
    {
      "text": "Muddle the lime juice, sugar, and mint leaves together in the bottom of a cocktail glass until the mint has broken down a bit, about 1 minute. Fill the glass with ice cubes. Add the rum and soda water over the ice. Pour the mixture back and forth from from the glass to another glass to mix. Garnish with the lime wedge and enjoy.",
