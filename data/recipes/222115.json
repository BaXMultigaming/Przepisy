  "ingredients": [
    "0.5 cup all-purpose flour",
    "0.25 teaspoon paprika",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon salt",
    "10 chicken wings",
    "2 tablespoons butter",
    "0.25 cup hot sauce",
    "1 clove garlic, minced",
    "1 dash ground black pepper"
  ],
  "steps": [
    {
      "text": "Mix together flour, paprika, cayenne pepper, and salt in a small bowl. Place chicken wings in a large dish and sprinkle flour mixture over them until well coated. Place on baking sheet and refrigerate for 1 hour, uncovered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (204 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake wings in preheated oven until no longer pink at the bone and juices run clear, about 15 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, hot sauce, pepper, and garlic in a small saucepan over low heat. Cook and stir until butter is melted and mixture is well blended, about 3 minutes. Place chicken wings in serving bowl and add hot sauce mixture, mixing well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
