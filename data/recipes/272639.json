  "ingredients": [
    "4 tablespoons butter",
    "4 medium potatoes, diced",
    "1 pound carrots, sliced",
    "1.5 cups finely chopped dill pickles",
    "0.5 cup all-purpose flour",
    "3 tablespoons dill pickle juice",
    "2 tablespoons minced garlic",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon onion salt",
    "1 tablespoon white sugar",
    "1.5 teaspoons dried dill weed",
    "1 teaspoon curry powder",
    "0.5 teaspoon ground white pepper",
    "9 cups chicken broth",
    "2 cups warm milk",
    "2 bay leaves",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a stock pot over medium-low heat. Add potatoes and carrots; cook until beginning to soften, stirring occasionally, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in pickles, flour, pickle juice, garlic, Worcestershire sauce, onion salt, sugar, dill, curry powder, and white pepper. Add broth, milk, and bay leaves; simmer until vegetables are soft and soup reduces slightly, about 1 hour. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
