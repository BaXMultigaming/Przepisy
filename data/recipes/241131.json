  "ingredients": [
    "2 (11 ounce) cans Mexican-style corn, drained",
    "1.5 cups shredded Cheddar-Monterey Jack cheese blend",
    "1 cup light sour cream",
    "1 cup mayonnaise",
    "1 (8 ounce) package 1/3-less-fat cream cheese, softened",
