  "ingredients": [
    "1 pound purple yam root, unpeeled",
    "0.25 cup butter",
    "1 (10 ounce) can sweetened condensed milk",
    "0.25 teaspoon vanilla extract",
    "0.5 (12 fluid ounce) can evaporated milk"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil. Cook yam in the boiling water until tender, about 30 minutes. Drain and cool until easily handled. Peel and thinly grate the flesh.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a wok over medium heat. Stir in condensed milk and vanilla extract. Add grated purple yam. Reduce heat to low and cook, stirring constantly, until mixture is sticky but not dry, about 30 minutes. Pour in evaporated milk; cook and stir for 15 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer yam mixture to a container and cool to room temperature, about 30 minutes. Chill before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
