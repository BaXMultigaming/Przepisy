  "ingredients": [
    "1 bunch broccolini",
    "2 tablespoons olive oil",
    "1 clove garlic, minced",
    "1 lemon wedge",
    "1 pinch red pepper flakes",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place broccolini in a large skillet with about 2 inches of water; bring to a boil and cook until bright green, 1 to 2 minutes. Drain.",
