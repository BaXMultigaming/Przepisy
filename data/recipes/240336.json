  "ingredients": [
    "1 (28 ounce) can crushed tomatoes",
    "1 small onion, chopped",
    "2 tablespoons garam masala",
    "1 tablespoon minced garlic",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon kosher salt",
    "1 tablespoon brown sugar",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground coriander",
    "2 pounds skinless, boneless chicken thighs",
    "0.5 cup plain low-fat Greek yogurt",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Stir tomatoes, onion, garam masala, garlic, ginger, salt, brown sugar, cumin, and coriander together in a slow cooker until well-mixed. Place chicken thighs in tomato mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 3 to 4 hours (or on Low for 6 to 8 hours). Stir yogurt and cilantro into chicken mixture.",
