  "ingredients": [
    "10 pods okra, sliced in 1/4 inch pieces",
    "1 egg, beaten",
    "1 cup cornmeal",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Soak okra in beaten egg in a small bowl for 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rvZpuN48LaScNmJ12y2SWYWGXxU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22176-fried-okra-ddmfs-step1-4x3-0198-07b441eb891d45fe98dee4abb3a15a22.jpg"
      ],
      "image": "assets/images/22176/step_01.webp"
    },
    {
      "text": "Combine cornmeal, salt, and pepper in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EF6PSZ0wvPCYzrtZmfG3XoyQrDw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22176-fried-okra-ddmfs-step2-4x3-0199-c71eee9b09334b3084b834e8d4d59288.jpg"
      ],
      "image": "assets/images/22176/step_02.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Dredge okra in the cornmeal mixture, coating evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7Ok_trBPsNSvyTAj4b-ypT5UGpw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22176-fried-okra-ddmfs-step3-4x3-0200-623b795b28de4d128cd2253a6cf9c2c1.jpg"
      ],
      "image": "assets/images/22176/step_03.webp"
    },
    {
      "text": "Carefully place okra in hot oil; stir continuously. Reduce heat to medium when okra first starts to brown, and cook until golden. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
