  "ingredients": [
    "2 cloves garlic, crushed",
    "1 dried red chile pepper",
    "1 tablespoon olive oil",
    "2 tablespoons fresh lime juice",
    "1 teaspoon whole grain mustard",
    "sea salt to taste",
    "freshly ground black pepper",
    "2 (6 ounce) fillets salmon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a medium baking dish with aluminum foil; lightly grease foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grind garlic, chile pepper, and olive oil together with a mortar and pestle. Add lime juice, mustard, salt, and black pepper; mix until a thick paste forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon fillets in the prepared baking dish; coat with mustard paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until salmon easily flakes with a fork, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
