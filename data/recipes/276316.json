  "ingredients": [
    "1.5 pounds red potatoes, peeled",
    "1.5 cups mayonnaise",
    "1 cup chopped celery",
    "0.5 cup chopped onion",
    "1 tablespoon white vinegar",
    "1 tablespoon prepared yellow mustard",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "4 hard-cooked eggs, chopped",
    "1 teaspoon paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain and let cool enough to handle, 10 to 15 minutes. Cut into cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mayonnaise, celery, onion, vinegar, mustard, salt, and pepper together in a large bowl. Add potatoes and mix to combine. Stir in eggs and sprinkle with paprika.",
      "section": null,
      "name": null,
      "url": null,
