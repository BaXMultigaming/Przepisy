  "ingredients": [
    "1.5 cups mixed frozen berries",
    "1.25 cups unsweetened almond milk",
    "1 banana",
    "4 ounces frozen unsweetened acai pulp (such as Sambazon®)",
    "0.5 cup granola",
    "0.5 cup diced mango",
    "0.5 cup sliced fresh strawberries",
    "1 kiwi, peeled and sliced",
    "2 tablespoons agave syrup"
  ],
  "steps": [
    {
      "text": "Place frozen berries, almond milk, banana, and acai pulp in a blender; blend until smooth. Pour into 2 bowls and top with granola, mango, strawberries, and kiwi slices. Drizzle with agave syrup.",
