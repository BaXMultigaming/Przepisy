  "ingredients": [
    "4 green bell peppers, tops and seeds removed (reserve tops)",
    "1 pound ground beef",
    "0.5 cup chopped onion",
    "1 (14.5 ounce) can diced tomatoes with juice",
    "0.5 cup long grain white rice",
    "0.5 cup water",
    "1 teaspoon Worcestershire sauce",
    "1 pinch salt",
    "1 pinch ground black pepper",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Chop enough reserved green pepper tops to equal 1/4 cup; set aside. Discard remaining tops or use for another purpose.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cCHwaF-9c92stTPnGkkgBfA48mA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228806-baked-stuffed-peppers-step1-134-4x3-55f20f83c8af4612840041dc832af15e.jpg"
      ],
      "image": "assets/images/228806/step_01.webp"
    },
    {
      "text": "Place hollowed-out green peppers in a microwave-safe dish; cover and cook in microwave until bright green and steaming, about 3 minutes. Set peppers aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir ground beef in a skillet with onion and 1/4 cup chopped pepper tops over medium heat until beef is browned, the juices run clear, and the onion is translucent, about 10 minutes. Drain excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G2whVvYWrMINSGFS4vxQWzMxeRc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228806-baked-stuffed-peppers-step2-136-4x3-def765231d014da5a0bc3afd54a78610.jpg"
      ],
      "image": "assets/images/228806/step_03.webp"
    },
    {
      "text": "Pour in diced tomatoes with their juice, rice, water, Worcestershire sauce, salt, and black pepper; bring to a boil. Reduce heat to low, cover skillet, and simmer until rice is tender, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7N8sTyQfyN9o0ZQg53Sabb-CYLg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228806-baked-stuffed-peppers-step3-138-4x3-37ad5f6dd59c477e9cb9c3abbf5e60d5.jpg"
      ],
      "image": "assets/images/228806/step_04.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Cheddar cheese into ground beef-rice mixture and spoon mixture into precooked peppers. Set peppers upright in an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X75uKKg3yAUeXrxrc-q9vbIrjl0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228806-baked-stuffed-peppers-step5-166-4x3-11e5941503d841868f64a964e0a7630d.jpg"
      ],
      "image": "assets/images/228806/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and peppers are tender, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y2HjYkxQCb3U548yDntT4unDfTU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228806-baked-stuffed-peppers-DDMFS-4x3-f6e77c32be3a4d21b96c879ff1524cdc.jpg"
      ],
      "image": "assets/images/228806/step_07.webp"
    }
