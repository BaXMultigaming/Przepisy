  "ingredients": [
    "1 tablespoon butter",
    "3 russet potato, peeled and cubed",
    "1 cup heavy cream",
    "0.5 cup 2% reduced-fat milk",
    "4 cloves garlic, minced",
    "2 tablespoons all-purpose flour",
    "salt and black pepper to taste",
    "1 cup grated medium Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B78ABeNh-XMbx1gJzibmcDyNQSo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-173941-steak-house-au-gratin-potatoes-VAT-step-01-1c3d1d4465f04c0c9e5147da35d551ba.jpg"
      ],
      "image": "assets/images/173941/step_01.webp"
    },
    {
      "text": "Grease one 9x13 inch baking pan with butter. Spread potatoes evenly in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sk-dJ2bIj8UAF0wSAPuu6O6133c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-173941-steak-house-au-gratin-potatoes-VAT-step-02-062135f35e8b4534a874b6e043297889.jpg"
      ],
      "image": "assets/images/173941/step_02.webp"
    },
    {
      "text": "Whisk together heavy cream, milk, garlic, flour, salt, and pepper in a large bowl. Pour cream mixture over the potatoes. Cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-KXh-zhOs2XY4uuPAFEKHjs-xV4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-173941-steak-house-au-gratin-potatoes-VAT-step-03-C-1f5516e6b667416b8c14b5421139e544.jpg"
      ],
      "image": "assets/images/173941/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 20 minutes, then remove the foil. Continue baking until the potatoes are easily pierced with a fork, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/63isG9rRZpkHwKYLCtlZ-hhfmAg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-173941-steak-house-au-gratin-potatoes-VAT-step-04-A-6f6ce422e08c46a19e90d4c6b989405f.jpg"
      ],
      "image": "assets/images/173941/step_04.webp"
    },
    {
      "text": "Remove potatoes from the oven and sprinkle Cheddar cheese on top. Return to oven and bake until the cheese is melted, 5 to 10 minutes. Allow to cool for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sy7QnUMR8Jbxp4rkVWdLqVMxSas=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-173941-steak-house-au-gratin-potatoes-VAT-step-05-A-6bb6fd559de7421299a00c035b4f843e.jpg"
      ],
      "image": "assets/images/173941/step_05.webp"
    }
