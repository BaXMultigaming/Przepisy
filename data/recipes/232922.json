  "ingredients": [
    "0.33333334326744 cup brown sugar",
    "1 teaspoon ground cinnamon",
    "0.66666668653488 cup white sugar",
    "0.5 cup butter, softened",
    "2 eggs",
    "1.5 teaspoons vanilla extract",
    "1.5 cups all-purpose flour",
    "1.75 teaspoons baking powder",
    "0.5 cup milk",
    "1 apple, peeled and chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar and cinnamon together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jM_9JT8AdyKstMCxLRs2xEndALE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232922-Apple-Cinnamon-White-Cake-ddmfs-Step1-5141-be90d99ef3af445399424ad48cb864d7.jpg"
      ],
      "image": "assets/images/232922/step_02.webp"
    },
    {
      "text": "Beat white sugar and butter together in a bowl using an electric mixer until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i3VRfa7nQ8a6iyEuANzEpvBSI1o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232922-Apple-Cinnamon-White-Cake-ddmfs-Step2-5142-962a2fd4b48349d49fb9cea396eda134.jpg"
      ],
      "image": "assets/images/232922/step_03.webp"
    },
    {
      "text": "Beat in eggs, 1 at a time, until incorporated; add vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EtCsQ4wxRl7R0SWhUJJidpb5At4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232922-Apple-Cinnamon-White-Cake-ddmfs-Step3-5145-072f31851f8b4df3b122010fbdf973f7.jpg"
      ],
      "image": "assets/images/232922/step_04.webp"
    },
    {
      "text": "Combine flour and baking powder together in a bowl; stir into creamed butter mixture. Mix milk into batter until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z5dkFVtXo2ji2OBK1CH8iIk_YZI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232922-Apple-Cinnamon-White-Cake-ddmfs-Step4-5149-1b5b8b2499a742549162d635e918aa88.jpg"
      ],
      "image": "assets/images/232922/step_05.webp"
    },
    {
      "text": "Pour half the batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SPKlfXHfAN4ntH34dczdBt9v_xo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232922-Apple-Cinnamon-White-Cake-ddmfs-Step6-5154-2f360667bc7f4b29b411b624c1ccc026.jpg"
      ],
      "image": "assets/images/232922/step_06.webp"
    },
    {
      "text": "Add half the apples and half the brown sugar mixture to the batter. Lightly pat apple mixture into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4tB-R8AgbNpTqt6vRWrIYHnLRiY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232922-Apple-Cinnamon-White-Cake-ddmfs-Step7-5155-9427fa4867ec459fbe1e3fdc6da590d9.jpg"
      ],
      "image": "assets/images/232922/step_07.webp"
    },
    {
      "text": "Pour remaining batter over apple layer; top with remaining apples and brown sugar mixture. Lightly pat apples into batter; swirl brown sugar mixture through apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_qSjDQXmNY4tB6gf-YQ1OKueoSU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232922-Apple-Cinnamon-White-Cake-ddmfs-Step8-5158-f5cbdd9ecca54801840cb04cbf23afd8.jpg"
      ],
      "image": "assets/images/232922/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the loaf comes out clean, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6l2AQblVKugMLG9suKOvLH0HrdE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232922-Apple-Cinnamon-White-Cake-ddmfs-3X4-5164-3c015edf0d6046358046e7f7c7bc5edc.jpg"
      ],
      "image": "assets/images/232922/step_10.webp"
    }
  ],
