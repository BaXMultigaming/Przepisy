  "ingredients": [
    "8 slices bacon, or more to taste",
    "1 large onion, chopped",
    "4 cloves garlic, minced",
    "6 cups chicken broth",
    "4 cups dry black-eyed peas",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels and crumble when cool enough to handle. Keep drippings in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sauté onion and garlic in bacon drippings over medium to medium-high heat until tender, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chicken broth, black-eyed peas, salt, and pepper in the bottom of a slow cooker. Add crumbled bacon, sautéed onion and garlic mixture, and any remaining bacon drippings. Cover and cook on Low until peas are tender, 4 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
