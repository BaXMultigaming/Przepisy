  "ingredients": [
    "2 (10.5 ounce) cans condensed Cheddar cheese soup (such as Campbell's®)",
    "20 fluid ounces chicken broth",
    "1 (10 ounce) can hot enchilada sauce",
    "1 teaspoon Southwest seasoning",
    "0.5 pound shredded cooked rotisserie chicken",
    "2 cups shredded Cheddar-Monterey Jack cheese blend, divided",
    "1 cup cooked brown rice",
    "1 cup whole kernel corn, drained",
    "18 tortilla chips"
  ],
  "steps": [
    {
      "text": "Combine condensed soup, chicken broth, enchilada sauce, and Southwest seasoning in a large pot over medium-high heat. Whisk for about 5 minutes until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken, 1 1/4 cups Cheddar-Monterey Jack cheese, cooked rice, and corn. Mix until well combined. Reduce heat to low and cook until heated through and cheese is melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and ladle into bowls. Top each bowl with remaining cheese and 3 tortilla chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
