  "ingredients": [
    "2 cups all-purpose flour",
    "0.75 cup powdered milk",
    "2 tablespoons white sugar",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "2 cups apple cider",
    "0.25 cup vegetable oil",
    "2 eggs",
    "1 teaspoon vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Sift flour, powdered milk, sugar, baking powder, cinnamon, and baking soda together in a bowl. Whisk apple cider, 1/4 cup vegetable oil, and eggs together in a separate bowl. Stir apple cider mixture into flour mixture until batter is just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 teaspoon vegetable oil in a griddle over medium-high heat. Drop batter by large spoonfuls onto the griddle and cook until bubbles form and the edges are dry, 2 to 3 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
