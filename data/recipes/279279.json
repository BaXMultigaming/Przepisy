  "ingredients": [
    "0.5 cup mayonnaise",
    "0.5 cup milk, or as needed",
    "0.5 medium avocado, diced",
    "1.5 tablespoons ranch dressing mix",
    "1 tablespoon lime juice",
    "1.5 teaspoons dried cilantro",
    "0.25 teaspoon grated lime zest",
    "0.125 teaspoon ground white pepper"
  ],
  "steps": [
    {
      "text": "Combine mayonnaise, milk, avocado, ranch dressing mix, lime juice, dried cilantro, lime zest, and white pepper in the bowl of a food processor; pulse until blended. Blend in extra milk, 1 tablespoon at a time, for a thinner consistency.",
