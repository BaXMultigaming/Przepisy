  "ingredients": [
    "2 tablespoons peanut butter",
    "1 cup white sugar",
    "0.75 cup packed brown sugar",
    "1 cup butter",
    "2 cups all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "1 tablespoon baking soda",
    "3 tablespoons vanilla extract",
    "2 eggs",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the peanut butter, butter, vanilla, and eggs (optional). In another bowl, mix together the sugar, brown sugar, flour, cocoa, and baking soda.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the dry ingredients into large bowl and mix together. Fold the chocolate chips into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoon onto baking sheets. Bake for 10 minutes. Enjoy!!!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
