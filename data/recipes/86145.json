  "ingredients": [
    "1 cup white sugar",
    "4 eggs, beaten",
    "0.25 cup butter, melted",
    "0.25 cup all-purpose flour",
    "1 (20 ounce) can crushed pineapple, in juice",
    "1 pinch ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together sugar, beaten eggs, melted butter, and flour in a medium bowl until well blended. Stir in crushed pineapple with juice until incorporated. Transfer to a small casserole dish. Sprinkle cinnamon over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered in the preheated oven for 1 hour. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
