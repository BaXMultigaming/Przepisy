  "ingredients": [
    "1.5 cups white sugar",
    "0.5 cup palm oil shortening",
    "2 eggs",
    "2.25 cups gluten-free flour blend (such as Namaste Perfect Flour Blend)",
    "4 ripe bananas",
    "0.25 cup buttermilk",
    "1 teaspoon sea salt",
    "0.75 teaspoon baking soda",
    "0.25 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a muffin tin with with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and shortening together in a large bowl with an electric mixer until light and fluffy. Beat in eggs one at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour into the shortening mixture. Add bananas, buttermilk, salt, baking soda, and baking powder; mix until well combined. Spoon batter into the prepared muffin tin, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 22 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
