  "ingredients": [
    "2 tablespoons canola oil",
    "1 small onion, chopped",
    "1 clove garlic, minced",
    "1.5 teaspoons cumin seed",
    "2 tablespoons all-purpose flour",
    "5 medium beets, peeled and quartered",
    "2 tomatoes - peeled, seeded and chopped",
    "1.5 cups water",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Heat a medium saucepan over medium-high heat. Pour in oil and saute onion and garlic until translucent. Mix in cumin seed and saute an additional 2 minutes. Sprinkle in flour and saute 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in beets, tomatoes, water, and salt. Reduce heat to low, cover pan with lid, and allow to simmer 30 to 45 minutes, until beets are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
