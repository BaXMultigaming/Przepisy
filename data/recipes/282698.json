  "ingredients": [
    "0.5 pound chorizo sausage",
    "cooking spray",
    "0.5 cup chopped onion",
    "0.5 cup chopped bell pepper",
    "0.25 cup chopped jalapeno pepper",
    "6 large eggs",
    "3 tablespoons milk",
    "1 teaspoon salt",
    "6 (7 inch) flour tortillas, warmed",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir chorizo in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the chorizo is cooking, spray a large skillet with cooking spray and place over medium heat. Add onion, bell pepper, and jalapeno; cook, stirring occasionally, until lightly browned, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, milk, and salt together in a large bowl. Pour into the skillet with the vegetables and cook until eggs are set, about 5 minutes. Mix in chorizo and remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay warmed tortillas flat and spoon chorizo-egg mixture into the middle. Add cheese and roll into a burrito.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
