  "ingredients": [
    "10 cups puffed wheat cereal",
    "1 cup corn syrup",
    "1 cup white sugar",
    "0.5 cup unsalted butter",
    "6 tablespoons unsweetened cocoa powder",
    "0.25 cup brown sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Grease a 9x13-inch pan. Place cereal in a large heat-proof bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring corn syrup, white sugar, butter, cocoa powder, and brown sugar to a boil in a heavy saucepan. Remove from the heat and stir in vanilla; pour over cereal and stir until very well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press mixture into the prepared pan. Allow to cool completely before cutting into 24 squares, at least 1 hour or up to one day.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
