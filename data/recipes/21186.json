  "ingredients": [
    "3 cups water",
    "1.5 cups quick-cooking brown rice",
    "2 tablespoons peanut oil",
    "1 small yellow onion, chopped",
    "1 small green bell pepper, chopped",
    "1 teaspoon minced garlic",
    "0.25 teaspoon red pepper flakes",
    "3 green onions, thinly sliced",
    "3 tablespoons soy sauce",
    "1 cup frozen petite peas",
    "2 teaspoons sesame oil",
    "0.25 cup roasted peanuts"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a saucepan. Stir in rice. Reduce heat, cover, and simmer until liquid is absorbed, about 20 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_1TkwYcO4eWxY6dx3Wx4Ne4mwvk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21186-vegetable-fried-rice-ddmfs-step-1-4840e243b6a74ca39c40e097a89e8f4f.jpg"
      ],
      "image": "assets/images/21186/step_01.webp"
    },
    {
      "text": "Heat peanut oil in a large skillet or wok over medium heat. Add onions, bell pepper, garlic, and red pepper flakes. Cook, stirring occasionally, for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bs6y0YC78zZq7F5_hHfllJPr-QI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21186-vegetable-fried-rice-ddmfs-step-2-cf59dd896b544d268826027cfd24b1d0.jpg"
      ],
      "image": "assets/images/21186/step_02.webp"
    },
    {
      "text": "Increase heat to medium-high. Stir in cooked rice, green onions, and soy sauce; cook and stir for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GXLGQNX4EPXW2AwFTh1TfJHQtwU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21186-vegetable-fried-rice-ddmfs-step-3-4db5ce4772694cf48389d07648a19540.jpg"
      ],
      "image": "assets/images/21186/step_03.webp"
    },
    {
      "text": "Add peas and cook for 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o8Lb7HCWVs0nNJNnHxhtBXM0uOg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21186-vegetable-fried-rice-ddmfs-step-4copy-bb7f667f7ba941aebf18ab38bf1cabd8.jpg"
      ],
      "image": "assets/images/21186/step_04.webp"
    },
    {
      "text": "Remove from heat. Stir in sesame oil and garnish with peanuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TqiMYN0h1S_0ILWHckfIFrGxv_M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21186-vegetable-fried-rice-ddmfs-3x4-1-59074fe5252e498ea5502c2249f6049b.jpg"
