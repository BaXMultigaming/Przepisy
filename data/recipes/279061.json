  "ingredients": [
    "1 cup pearled farro",
    "1 (13.5 ounce) can unsweetened light coconut milk",
    "0.25 cup unsweetened almond milk",
    "1 tablespoon maple syrup, or more to taste",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 pinch salt",
    "0.25 cup toasted shredded coconut",
    "0.25 cup toasted sliced almonds"
  ],
  "steps": [
    {
      "text": "Combine farro, coconut milk, almond milk, maple syrup, vanilla, cinnamon, nutmeg, and salt in a large pot. Bring mixture to a simmer over medium heat, stirring occasionally. Cover, reduce heat to low, and continue to cook until liquid is mostly absorbed and farro has reached desired doneness, 20 to 25 minutes.",
