  "ingredients": [
    "2 large cucumbers, thinly sliced",
    "2 tablespoons salt",
    "1.5 cups white sugar",
    "1.5 cups distilled white vinegar"
  ],
  "steps": [
    {
      "text": "Place cucumbers in a large bowl; sprinkle with salt. Cover the bowl with a tight-fitting lid or plastic wrap; refrigerate for 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse and drain cucumbers, pressing out as much water as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return cucumbers to the bowl; stir in sugar and vinegar until well combined. Cover the bowl with a tight-fitting lid or plastic wrap; refrigerate for 24 hours more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cucumbers to a freezer container and freeze.",
      "section": null,
