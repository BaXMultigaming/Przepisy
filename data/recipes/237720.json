  "ingredients": [
    "1 bag Minute® Multi-Grain Medley, uncooked",
    "1 serving Non-stick cooking spray",
    "3 large eggs, lightly beaten",
    "0.5 cup sugar",
    "1 ripe banana, mashed",
    "3 tablespoons vegetable oil",
    "0.25 cup milk",
    "1 teaspoon vanilla extract",
    "1 medium zucchini, grated",
    "0.5 cup walnuts, chopped",
    "2 cups baking mix"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F. Prepare Multi-Grain Medley according to package directions. Coat a loaf pan with non-stick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl whisk together eggs, sugar and banana. Stir in rice, oil, milk, vanilla, zucchini (should be about 1 1/2 cups of grated zucchini) and walnuts. Add baking mix and stir just until all ingredients are combined. Pour mixture into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 45 minutes, or until toothpick inserted in center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool 10 minutes then remove from pan and cool on rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
