  "ingredients": [
    "1 (9 inch) unbaked 9 inch pie crust",
    "0.5 cup shredded Swiss cheese",
    "0.5 onion, minced",
    "1 (4.5 ounce) can sliced mushrooms, drained",
    "3 egg yolks",
    "2 egg whites",
    "2 tablespoons all-purpose flour",
    "2 tablespoons milk",
    "0.5 teaspoon chopped fresh thyme",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer cheese, onions and mushrooms inside pie shell. Whisk together egg whites, yolks, flour and milk. Pour egg mixture on top of cheese and vegetables. Poke the layers gently to allow the egg mixture to distribute evenly throughout the quiche. Sprinkle the thyme, salt and pepper on top of the eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes, or until eggs are set and top is golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
