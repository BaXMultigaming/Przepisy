  "ingredients": [
    "0.5 cup butter",
    "2 cups cooked lobster meat",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 tablespoon cornstarch",
    "2 cups light cream, divided",
    "8 slices bread",
    "2 tablespoons butter, or as needed"
  ],
  "steps": [
    {
      "text": "Melt 1/2 cup butter in a large frying pan over medium-low heat; cook and stir lobster into melted butter until heated through, about 5 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cornstarch and about 1 tablespoon cream together in a small bowl until smooth. Pour remaining cream into lobster, stir in cornstarch mixture; cook and stir until cream sauce comes to a simmer and thickens slightly, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast bread and spread with about 2 tablespoons butter. For each serving, pour some creamed lobster over one buttered piece of toast, top with another piece of toast, and pour more creamed lobster over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
