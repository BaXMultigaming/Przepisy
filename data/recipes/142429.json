  "ingredients": [
    "2 tablespoons olive oil",
    "1.5 cups chopped onion",
    "0.75 teaspoon kosher salt, divided",
    "1 cup sour cream",
    "1 cup mayonnaise",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon ground white pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
