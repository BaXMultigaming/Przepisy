  "ingredients": [
    "3 (8 ounce) packages cream cheese, softened",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon hot pepper sauce",
    "0.5 teaspoon minced garlic",
    "1 pound shredded Cheddar cheese",
    "1 cup finely chopped pecans",
    "0.25 cup finely chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UXNxlkDJfHdSM8yY74L1l1XARRE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16600-Best-Cheese-Ball-DDMFS-Step-01-9837cc0566d44853a267f283f8a5bad5.jpg"
      ],
      "image": "assets/images/16600/step_01.webp"
    },
    {
      "text": "Combine cream cheese, Worcestershire sauce, hot pepper sauce, and garlic in a food processor. Blend until smooth and well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wIccDiIDNlQMWCxCLSiYoBlv6no=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16600-Best-Cheese-Ball-DDMFS-Step-02-da20c94accb04a3a95089eb070383a1a.jpg"
      ],
      "image": "assets/images/16600/step_02.webp"
    },
    {
      "text": "Add Cheddar cheese and process until Cheddar is finely chopped but still very visible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4yLrZSkNQm2ou9YWd3Wsh1WBd0o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16600-Best-Cheese-Ball-DDMFS-Step-03-3dc5d6e5742a421d8fd3036f73f72324.jpg"
      ],
      "image": "assets/images/16600/step_03.webp"
    },
    {
      "text": "Remove mixture from the food processor and shape into 3 or 4 balls. Place on a baking sheet or plate and freeze for about 15 minutes to firm slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jMRD06yrsoND-F3Png3Rf5tkZNs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16600-Best-Cheese-Ball-DDMFS-Step-04-8d96d06f75434f4fb085f9a7811037d4.jpg"
      ],
      "image": "assets/images/16600/step_04.webp"
    },
    {
      "text": "Combine pecans and parsley in a shallow bowl. Remove chilled cheese balls from the freezer and roll in the pecan-parsley mixture until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Id0sunk6bVeiIIc2DcQ8WboD3aU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16600-Best-Cheese-Ball-DDMFS-Step-05-2109832354b24c6fb845990c7972b392.jpg"
      ],
      "image": "assets/images/16600/step_05.webp"
    },
    {
      "text": "Serve immediately, or wrap nut-coated cheese balls tightly in plastic wrap and then in aluminum foil. Freeze for up to 1 month.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WWIlTapF-0T9XDtvlf2FqU8Pbww=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16600-Best-Cheese-Ball-DDMFS-Beauty-4x3-8de76f9e1ba148a698c6a97118756909.jpg"
      ],
      "image": "assets/images/16600/step_06.webp"
    }
