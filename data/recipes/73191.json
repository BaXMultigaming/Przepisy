  "ingredients": [
    "4 medium baking potatoes, scrubbed",
    "2 tablespoons olive oil",
    "2 teaspoons garlic salt, or to taste",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour olive oil into a plastic bag. Measure the garlic salt and pepper onto a plate, and stir around a little. Coat each potato with olive oil by placing in the bag, and moving it around. Remove from the bag, and dip into the seasoning. Rub seasoning into the potato to coat. Place the potatoes directly on the oven rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour in the preheated oven, or until the potatoes feel soft when you squeeze them.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
