  ],
  "steps": [
    {
      "text": "Combine vinegar, water, and thyme in a multi-functional pressure cooker (such as Instant Pot). Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 0 minutes. Allow 5 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 3 minutes. Let sit for 1 hour to steep.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain liquid into a clean bottle. Apply to your clean face with cotton pads twice a day, making sure to avoid the eyes.",
      "section": null,
