  "title": "Homemade Potato Skins",
  "description": "These mouthwatering potato skins are baked, then topped with bacon, melty Cheddar cheese, sour cream, and green onions for a perfectly crispy appetizer.",
  "authors": [
    "Brooke"
  ],
  "date_published": "2009-11-22T18:23:12-05:00",
  "date_modified": "2026-01-04T10:24:55-05:00",
