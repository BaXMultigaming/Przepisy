  "title": "Mashed Jalapeño Cilantro Sweet Potatoes",
  "description": "Roasted sweet potato and jalapeño pepper mix with fresh cilantro, butter, and orange juice for a delicious Texas-inspired side dish.",
  "authors": [
    "Terri Harnish"
  ],
  "date_published": "2008-06-08T17:05:06-04:00",
