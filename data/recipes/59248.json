  "ingredients": [
    "1.5 cups raisins",
    "4.75 cups all-purpose flour",
    "4 cups white sugar",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons baking soda",
    "1.5 teaspoons salt",
    "1.5 teaspoons nutmeg",
    "1.5 teaspoons cinnamon",
    "1.5 teaspoons ground cloves",
    "6 eggs",
    "1 (29 ounce) can pumpkin",
    "1 cup unsweetened applesauce",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 C). Grease three 12 cup muffin pans, or line with paper muffin liners. Soak raisins in hot water for ten minutes to plump, then drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the flour, sugar, baking powder, baking soda, salt, nutmeg, cinnamon, and ground cloves. In a separate bowl, mix the eggs, pumpkin, and applesauce, until smooth. Add this mixture to the dry ingredients and stir thoroughly to make a smooth batter. Stir the raisins and walnuts into the batter. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 35 minutes in the preheated oven, or until a toothpick inserted into the center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
