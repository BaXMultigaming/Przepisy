  "ingredients": [
    "3 cups all-purpose flour",
    "0.75 cup white sugar",
    "2 teaspoons baking powder",
    "0.125 teaspoon salt",
    "0.25 cup unsalted butter, softened",
    "0.25 cup shortening",
    "2 eggs, beaten",
    "0.25 cup milk",
    "2 teaspoons vanilla extract",
    "0.25 cup milk",
    "0.75 cup sesame seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the flour, sugar, baking powder and salt. Blend in butter and shortening until the mixture resembles coarse meal. Make a well in the center and add eggs, 1/4 cup of milk and vanilla. Mix until a soft dough forms. Divide the dough into 4 pieces. Roll each piece out into a long snake 1/2 inch in diameter. Cut snakes into 2 inch pieces. Dip each piece in remaining milk, then roll in sesame seeds. Place 1 inch apart onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 to 25 minutes in the preheated oven, or until golden brown. Remove from cookie sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
