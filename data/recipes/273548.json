  "ingredients": [
    "2 cups frozen blueberries",
    "0.25 cup white sugar",
    "2 teaspoons almond extract",
    "1 teaspoon lemon juice",
    "1 teaspoon vanilla extract",
    "0.5 cup all-purpose flour",
    "0.125 cup brown sugar",
    "0.125 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.125 teaspoon salt",
    "0.5 stick cold butter, cubed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss blueberries, sugar, almond extract, lemon juice, and vanilla extract in a medium bowl. Pour into two 6-ounce ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, white sugar, brown sugar, cinnamon, nutmeg, and salt in another medium bowl. Cut in butter with 2 knives or a pastry blender until mixture resembles coarse meal. Sprinkle evenly over blueberry mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is golden brown and blueberries are bubbling, about 25 minutes. Serve hot or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
