  "ingredients": [
    "2.5 cups almond flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon sea salt",
    "0.5 cup grapeseed oil",
    "0.5 cup agave nectar",
    "1 tablespoon vanilla extract",
    "0.5 cup chocolate chips (such as Dagoba® Chocodrops)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk almond flour, baking soda, and salt together in a bowl. Stir grapeseed oil, agave nectar, and vanilla extract together in a separate bowl. Mix oil mixture into almond flour mixture until dough is just combined. Fold chocolate chips into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into 1/2-inch balls and press onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
