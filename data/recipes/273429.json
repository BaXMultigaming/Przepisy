  "ingredients": [
    "cooking spray",
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.75 cup white sugar",
    "3 large eggs",
    "0.5 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "0.75 cup sour cream",
    "1.25 cups crushed chocolate sandwich cookies (such as Oreo®), divided",
    "0.33333334326744 cup white chocolate chips",
    "1 tablespoon powdered sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x4-inch loaf pan. Line with parchment paper, leaving a 2-inch overhang on all sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a medium mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, eggs, oil, and vanilla together in another bowl until well combined. Whisk in sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the sour cream mixture over the flour mixture; mix together with a rubber spatula. Fold in 1 cup crushed cookies. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 40 to 50 minutes. Immediately top with white chocolate chips and remaining crushed cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lift loaf out of the pan using the parchment paper overhang. Allow to cool before dusting with powdered sugar.",
      "section": null,
      "name": null,
      "url": null,
