  "ingredients": [
    "1 (6 ounce) package raspberry flavored Jell-O® mix",
    "2 cups boiling water",
    "1 (16 ounce) can whole berry cranberry sauce",
    "1 (8 ounce) can crushed pineapple, undrained",
    "1 cup chopped celery",
    "1 cup chopped pecans",
    "1 teaspoon orange zest",
    "1 (4 ounce) package cream cheese, softened",
    "0.5 cup whipped topping"
  ],
  "steps": [
    {
      "text": "Place gelatin into a bowl, pour in boiling water, and stir until gelatin dissolves. Mix in cranberry sauce, pineapple, celery, pecans, and orange zest until evenly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sb2bSsLXrYZYAV0lwkeSX6kVuZM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/152405-grandmas-cranberry-orange-gelatin-salad-VAT-step-01-85e5c1f7fa2f413583c0479670722298.jpg"
      ],
      "image": "assets/images/152405/step_01.webp"
    },
    {
      "text": "Pour gelatin mixture into a mold or serving dish. Chill in the refrigerator for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/43oSLitadLJxd2LhRkiJyWT_Ug8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/152405-grandmas-cranberry-orange-gelatin-salad-VAT-step-02-1f91fc9b2e4d4039be9089ad0594187e.jpg"
      ],
      "image": "assets/images/152405/step_02.webp"
    },
    {
      "text": "To make topping, beat cream cheese with 1/2 of the whipped topping. Fold in remaining whipped topping until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y_D1b3A_b9V6gwtq6ZU9B1ADK_M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/152405-grandmas-cranberry-orange-gelatin-salad-VAT-step-03-631915eb761445cdba44843f87ea35cc.jpg"
      ],
      "image": "assets/images/152405/step_03.webp"
    },
    {
      "text": "Unmold gelatin, then spread with topping mixture.",
