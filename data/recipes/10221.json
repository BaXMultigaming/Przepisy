  "ingredients": [
    "0.5 cup shortening",
    "1 cup packed brown sugar",
    "2 eggs",
    "1 cup mashed bananas",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cloves",
    "0.5 cup chopped pecans",
    "3 cups sifted confectioners' sugar",
    "1 tablespoon butter, melted",
    "0.75 teaspoon vanilla extract",
    "3 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream shortening; add brown sugar, beating well. Add eggs and banana; beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking powder, baking soda, salt, and spices. Add to creamed mixture; mix well. Stir in pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded tablespoonfuls, 2 inches apart onto greased cookies sheets. Bake for 12 minutes. Remove to wire racks to cool. Dip half of cooled cookies into Powdered Sugar Icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Icing: Combine 3 cups confectioner's sugar, 1 tablespoon melted butter or margarine, and 3/4 teaspoon vanilla extract. Add milk to yield desired consistency (you may need to add a little extra), beating until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
