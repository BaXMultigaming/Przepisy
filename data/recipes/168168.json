  "ingredients": [
    "4 cups rye flour",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt",
    "1.25 cups buttermilk",
    "1.25 cups packed brown sugar",
    "1 cup white sugar",
    "0.5 cup light corn syrup",
    "0.5 cup molasses",
    "2 eggs",
    "1 tablespoon anise seed",
    "1 tablespoon melted butter"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease 3 small loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine rye flour, baking soda, salt, buttermilk, brown sugar, white sugar, corn syrup, molasses, eggs, anise seed, and melted butter in a large bowl, and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrape the batter into the prepared loaf pans, and bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes. Remove pans from the oven, and cool on their sides for about 15 minutes before loosening the sides of the loaves from the pans. Remove the loaves, and finish cooling on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
