  "title": "Gingerbread Waffles with Hot Chocolate Sauce",
  "description": "Yummy and delicious. These extraordinary waffles are flavored with molasses and spices. Topped with homemade chocolate sauce, they are perfect for a special breakfast treat.",
  "authors": [
    "Michele O'Sullivan"
  ],
  "date_published": "2000-08-06T01:14:48-04:00",
