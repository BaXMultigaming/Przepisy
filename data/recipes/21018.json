  "ingredients": [
    "1 cup light molasses",
    "0.5 cup butter",
    "1.5 teaspoons baking soda",
    "0.5 cup milk",
    "1 egg",
    "2 cups all-purpose flour",
    "1.5 teaspoons ground ginger",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "2 cups boiling water",
    "1 cup white sugar",
    "2 tablespoons cornstarch",
    "0.5 cup unsweetened cocoa powder",
    "1 teaspoon salt",
    "2 teaspoons vanilla extract",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "In a small saucepan, heat molasses and 1/2 cup butter until almost boiling. Remove from heat and let cool slightly. Stir in baking soda, milk and egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, sift together flour, ginger, cinnamon and salt. Make a well in the center and pour in the molasses mixture. Mix until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray preheated waffle iron with non-stick cooking spray. Pour mix onto hot waffle iron. Cook until golden brown. Serve hot with chocolate sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make chocolate sauce: In a saucepan, combine water, 1 cup sugar, cornstarch, cocoa powder and 1 teaspoon salt. Cook over medium heat, stirring constantly, until mixture comes to a boil. Remove from heat and add vanilla and 2 tablespoons butter; stir until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
