  "ingredients": [
    "oil for greasing sheet pan",
    "12 large eggs",
    "0.25 cup milk",
    "1 cup of 'mix ins' e.g. cooked vegetables, cooked bacon, ham, chicken, sausage, sauteed onions, more cheese, or herbs",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease a baking sheet well with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and milk together in a large bowl; add 1 cup mix-ins. Pour mixture into the prepared baking sheet; dot with little Cheddar cheese piles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until eggs are just set, about 15 minutes. Eggs will continue to cook out of the oven—but leave them in too long and they will become rubbery. Slice into squares; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
