  "ingredients": [
    "cooking spray",
    "1 cup almond flour",
    "1 cup coconut sugar",
    "0.75 cup pumpkin puree",
    "0.5 cup coconut oil",
    "0.5 cup dairy-free mini chocolate chips",
    "0.25 cup tapioca flour",
    "1 egg white",
    "1.5 teaspoons pumpkin pie spice",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x9-inch baking pan or glass dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almond flour, coconut sugar, pumpkin puree, coconut oil, dairy-free chocolate chips, tapioca flour, egg white, pumpkin pie spice, cinnamon, and almond extract in a bowl; stir until well mixed. Pour into prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chocolate chips are melted and top is golden brown, about 30 minutes. Cool until set, about 15 minutes. Cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
