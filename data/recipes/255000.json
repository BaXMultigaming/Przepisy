  "ingredients": [
    "0.5 cup white wine, or more to taste",
    "4 (3 ounce) fillets amberjack, dark brown vein removed",
    "1 tablespoon mayonnaise, or more to taste",
    "2 teaspoons seafood seasoning (such as Old Bay®), or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour wine into a glass baking dish. Arrange amberjack fillets on top. Coat with a very thin layer of mayonnaise. Sprinkle seafood seasoning over mayonnaise coating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until amberjack flakes easily with a fork, 20 to 30 minutes.",
