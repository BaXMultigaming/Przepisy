  "ingredients": [
    "3 pints half-and-half cream",
    "3 cups cold brewed coffee",
    "2 cups white sugar",
    "2 tablespoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Stir half-and-half, coffee, sugar, and vanilla extract together in a freezer-safe container. Cover and freeze until coffee mixture solidifies, at least 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Defrost at room temperature for 1 hour. Break coffee mixture apart with a fork to create a slush-like consistency. Transfer to a punch bowl or large pitcher.",
      "section": null,
