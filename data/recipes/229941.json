  "ingredients": [
    "1 gallon water",
    "2 cups kosher salt",
    "1.5 cups dark brown sugar",
    "3 large bay leaves",
    "1 tablespoon whole black peppercorns",
    "2.5 teaspoons dried rosemary",
    "2.5 teaspoons dried thyme",
    "12 whole cloves"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BUkXo2rVesv5tWowfp0Cx0k_4uE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229941-ultimate-turkey-brine-ingredients-94505ff42c3e4c429a40a2ecb8ec5d25.jpg"
      ],
      "image": "assets/images/229941/step_01.webp"
    },
    {
      "text": "Bring water to a boil in a large stockpot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in salt and brown sugar until dissolved; return to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xEBVLVs_rRqb4nbuS2gNMrHwtaE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229941-ultimate-turkey-brine-step-1-01-ed7be903102243f486e35391489143ba.jpg"
      ],
      "image": "assets/images/229941/step_03.webp"
    },
    {
      "text": "Add bay leaves, peppercorns, rosemary, thyme, and cloves. Reduce heat to medium-low and simmer for 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kB--v4Mnb7FKV4_H87rca3n2qF4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229941-ultimate-turkey-brine-step-2-01-e8475df15fa943489c12f994bb8bb541.jpg"
      ],
      "image": "assets/images/229941/step_04.webp"
    },
    {
      "text": "Remove from the heat and let cool completely before using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AKE3VGQgbHtC2JVxTx0LGK_UPvE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229941-ultimate-turkey-brine-step-3-e805fa90fbd44ec1805a6f8a718736eb.jpg"
      ],
      "image": "assets/images/229941/step_05.webp"
    },
    {
      "text": "Place thawed turkey into a large non-reactive container. Pour in cooled brine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AGdysmbrHQjytG4uAiHsDM_w2hI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229941-ultimate-turkey-brine-step-4-01-0781a9a90bc740d7be6bb38b0c6a06f6.jpg"
      ],
      "image": "assets/images/229941/step_06.webp"
    },
    {
      "text": "Pour in enough cool water to cover turkey with liquid. Refrigerate 8 to 12 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xnZ7mk832qnirGfP5mcDKCTkl7s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229941-ultimate-turkey-brine-step-4-02-6f59ca2eb3f940288e4510f1c3f90341.jpg"
      ],
      "image": "assets/images/229941/step_07.webp"
    },
    {
      "text": "Remove turkey from brine and let sit on counter for about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6JW-OckCOXXmwO219ZPgt_4gXpA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229941-ultimate-turkey-brine-step-5-3e85a96478e547f9b50f406581d6ecd9.jpg"
      ],
      "image": "assets/images/229941/step_08.webp"
