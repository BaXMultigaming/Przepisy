  "ingredients": [
    "1.3333333730698 cups spelt flour",
    "0.75 cup unsweetened cocoa powder",
    "2 teaspoons baking powder",
    "0.25 teaspoon baking soda",
    "0.125 teaspoon salt",
    "1.5 cups white sugar",
    "3 tablespoons coconut oil, melted",
    "2 eggs",
    "0.75 teaspoon vanilla extract",
    "1 cup coconut milk",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper or foil liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cocoa powder, baking powder, baking soda, and salt together in a medium bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and coconut oil together in a large bowl with an electric mixer until creamy. Add eggs, one at a time, beating well after each addition; stir in vanilla extract. Add flour mixture, alternating with coconut milk; beat well. Fold in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each ¾ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 17 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
