  "ingredients": [
    "0.5 cup butter, softened",
    "0.75 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 cup milk",
    "1.5 cups blueberries",
    "2 tablespoons all-purpose flour",
    "2 tablespoons brown sugar",
    "0.25 teaspoon ground cinnamon",
    "2 tablespoons butter, chilled"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter and sugar until light and fluffy. Stir in the eggs one at a time, beating well with each addition, then stir in the vanilla. In a separate bowl, stir together 2 cups flour, baking powder, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the flour mixture into egg mixture alternately with milk. Fold in blueberries. Spoon batter into prepared muffin cups. In a small bowl, mix together 2 tablespoons flour, brown sugar and cinnamon. Cut in butter until mixture resembles coarse crumbs. Sprinkle topping over unbaked muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 25 to 30 minutes, until a toothpick inserted into the center of a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
