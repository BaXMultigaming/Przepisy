  "ingredients": [
    "2 (3.4 ounce) packages instant lemon pudding mix",
    "2.5 cups Almond Breeze Unsweetened Vanilla Almondmilk",
    "1 (16 ounce) container frozen whipped topping, thawed",
    "14 ounces angel food cake",
    "2 pounds sliced fresh strawberries",
    "0.66666668653488 cup lemon curd"
  ],
  "steps": [
    {
      "text": "Whisk lemon pudding mixes and almondmilk together for 2 minutes. Fold in 8 oz of whipped topping. Refrigerate for at least 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut angel food cake into small, bite-sized pieces. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, combine remaining 8 oz of whipped topping with lemon curd, folding together again thoroughly combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer half of the angel food cake in the bottom of a large bowl or trifle dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with half of the pudding mixture, half of the sliced strawberries, and half of the lemon curd mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Repeat layers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with fresh strawberries and lemon slices if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Keep refrigerated until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
