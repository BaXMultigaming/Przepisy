  "ingredients": [
    "3 cups all-purpose flour",
    "1 cup flaked coconut",
    "1 teaspoon baking soda",
    "1 cup shortening",
    "0.5 teaspoon salt",
    "1 cup white sugar",
    "0.5 teaspoon baking powder",
    "1 cup packed brown sugar",
    "2 cups rolled oats",
    "2 eggs",
    "2 cups crisp rice cereal",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream shortening, add sugar gradually. Add eggs and vanilla; beat until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, salt, and baking powder together and mix with the first mixture. Add oatmeal, rice cereal, and coconut. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by tablespoons on slightly greased cookie sheet and bake for 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
