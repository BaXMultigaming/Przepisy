  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, cornmeal, water, black pepper, and salt together in a bowl to make a thick batter. Toss in cauliflower florets and mix until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Deep fry cauliflower a few florets at a time until golden brown, about 3 minutes. Transfer to a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1/4 cup vegetable stock with cornmeal in a bowl. Add soy sauce, ketchup, chile-garlic sauce, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a wok or frying pan over high heat. Add onions, chile pepper, garlic, and ginger and stir fry for a few seconds. Add cornmeal mixture and cook 1 to 2 minutes. Add remaining vegetable stock and cook until very thick, about 10 minutes. Remove sauce from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon sauce over fried cauliflower and toss slightly. Garnish with green onions and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
