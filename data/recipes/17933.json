  "ingredients": [
    "0.5 cup butter",
    "2 cups self-rising flour",
    "2 cups white sugar",
    "2 cups milk",
    "3.5 cups blackberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a 9x13-inch baking pan; place in the preheated oven until melted. Leave oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine flour, sugar, and milk in a medium bowl; batter will be slightly lumpy. Pour batter on top melted butter; do not stir together. Drop blackberries into batter. If more crust is desired, add fewer blackberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
