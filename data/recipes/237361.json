  "steps": [
    {
      "text": "Preheat oven to 200 degrees F (95 degrees C). Line a colander with cheese cloth and place over a large pot in the sink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently mix buttermilk and cream together in a 2-quart ceramic casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven for 2 hours and 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour buttermilk mixture into the prepared colander; drain for 45 to 60 minutes. Transfer drained cheese to a bowl and beat with an electric hand mixer until smooth and creamy. Store in the refrigerator.",
