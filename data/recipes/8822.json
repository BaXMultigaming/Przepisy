  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k1n9gDr7vmRK_hxKBqdKbStg2FM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8822-easy-chicken-noodle-casserole-DDMFS-038-4x3-step-01-c92faa549ef44c128cb3ab19aa3e05d9.jpg"
      ],
      "image": "assets/images/8822/step_01.webp"
    },
    {
      "text": "Cook spaghetti in a large pot of salted boiling water until it is al dente, about 8 to 10 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KsdUXOJh9d9Y9VcxQeWlyJASSr4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8822-easy-chicken-noodle-casserole-DDMFS-040-4x3-step-02-c42a43fd55a64879a8f74d617a292d4e.jpg"
      ],
      "image": "assets/images/8822/step_02.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place shredded chicken, cooked spaghetti, condensed soups, water, salt, and pepper in a 9x13-inch baking dish; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Tin8_Rp_0fYLO3rF7BoYOwmHwu0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8822-easy-chicken-noodle-casserole-DDMFS-041-4x3-step-03-8f7135f8a405405980d142a6a0e5e444.jpg"
      ],
      "image": "assets/images/8822/step_03.webp"
    },
    {
      "text": "Sprinkle cheese on top of mixture and bake in preheated oven until cheese is melted and golden brown on top, about 20 to 25 minutes. Let cool briefly before serving.",
      "section": null,
      "name": null,
      "url": null,
