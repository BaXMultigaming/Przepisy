  "ingredients": [
    "1 head (about 2 1/4 pound) cauliflower, trimmed and cut into florets",
    "3 large cloves garlic, thinly sliced",
    "0.25 cup olive oil",
    "2 tablespoons lemon juice",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "2 tablespoons grated Parmesan cheese"
  ],
