  "ingredients": [
    "1 cup butter, softened",
    "0.5 cup confectioners' sugar",
    "1.5 tablespoons vanilla sugar",
    "1 cup all-purpose flour",
    "0.5 cup potato flour",
    "1 drop red food coloring, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With an electric mixer, beat the butter and confectioners' sugar together in a bowl until smooth and creamy; beat in the vanilla sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, whisk the flour with potato flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the flour mixture into the butter mixture, about 1/4 cup at a time, until all the flour is mixed in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the food coloring until the dough is evenly colored.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the dough into a cookie press fitted with a decorative tip.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press out 1 1/2-inch cookies onto an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies in the preheated oven until the bottoms are just lightly browned, about 10 minutes. Allow to cool on the baking sheet for about 5 minutes before removing to finish cooling on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
