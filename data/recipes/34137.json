  "ingredients": [
    "4 skinless, boneless chicken breast halves - pounded to 1/4 inch thickness",
    "1 egg, beaten",
    "0.66666668653488 cup dry bread crumbs",
    "2 tablespoons olive oil",
    "1 lime, juiced",
    "6 tablespoons butter",
    "1 teaspoon minced fresh chives",
    "0.5 teaspoon dried dill weed"
  ],
  "steps": [
    {
      "text": "Coat chicken breasts with egg, and dip in bread crumbs. Place on a wire rack, and allow to dry for about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat. Place chicken into the skillet, and fry for 3 to 5 minutes on each side. Remove to a platter, and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain grease from the skillet, and squeeze in lime juice. Cook over low heat until it boils. Add butter, and stir until melted. Season with chives and dill. Spoon sauce over chicken, and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
