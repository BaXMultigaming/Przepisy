  "ingredients": [
    "1 bunch Swiss chard, stems and leaves separated",
    "3 tablespoons extra-virgin olive oil, divided",
    "0.5 teaspoon kosher salt",
    "0.5 lime"
  ],
  "steps": [
    {
      "text": "Cut chard stems into ½-inch pieces. Stack leaves, roll into a tight cylinder, and slice into ½-inch strips; cut strips in half crosswise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 ½ tablespoons oil in a large nonstick skillet over medium heat. Add stems; cook until mostly tender, about 1 minute. Add leaves; cook 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle remaining 1 ½ tablespoons oil over chard; stir to coat. Cook and stir until leaves are mostly tender, 4 to 5 minutes. Off heat, season with salt. Squeeze lime over chard; stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
