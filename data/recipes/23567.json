  "title": "Slow Cooker Pepper Steak",
  "description": "This slow cooker pepper steak dish has tasty strips of tender sirloin with onion, green pepper, and tomatoes for an easy and comforting dinner.",
  "authors": [
    "MJWAGNER68"
  ],
  "date_published": "2000-11-01T16:22:26-05:00",
