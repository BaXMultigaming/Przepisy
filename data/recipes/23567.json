  "ingredients": [
    "2 pounds beef sirloin, cut into 2 inch strips",
    "0.75 teaspoon garlic powder, or to taste",
    "3 tablespoons vegetable oil",
    "1 cube beef bouillon",
    "0.25 cup hot water",
    "1 tablespoon cornstarch",
    "0.5 cup chopped onion",
    "2 large green bell peppers, roughly chopped",
    "1 (14.5 ounce) can stewed tomatoes, with liquid",
    "3 tablespoons soy sauce",
    "1 teaspoon white sugar",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H3G2xV1mALB_ewTIVbKWP-MTHPE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23567-slow-cooker-pepper-steak-Step-01-0e29b2f2c9bf401aad9ab5dd3b1c9f09.jpg"
      ],
      "image": "assets/images/23567/step_01.webp"
    },
    {
      "text": "Sprinkle beef sirloin strips with garlic powder. Heat vegetable oil in a large skillet over medium heat, and sear beef strips until browned, about 5 minutes per side. Transfer to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3inaLKI7aXIxkqH4phAD5rPHwuM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23567-slow-cooker-pepper-steak-Step-02-c309fad57db04d3080a586f673eb0d6a.jpg"
      ],
      "image": "assets/images/23567/step_02.webp"
    },
    {
      "text": "Dissolve bouillon cube in hot water in a small bowl, then whisk in cornstarch until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XoCqxiNsZD-2rrHILCPJzNL6F68=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23567-slow-cooker-pepper-steak-Step-03-e0835e473f474172b7b3ddd502baf0a9.jpg"
      ],
      "image": "assets/images/23567/step_03.webp"
    },
    {
      "text": "Pour into the slow cooker with beef strips. Stir in onion, green peppers, stewed tomatoes, soy sauce, sugar, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jKZZ9xSqnYWjM29OLHedkTwBCxE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23567-slow-cooker-pepper-steak-Step-04-9e3ab43d12b44d6b889e25e6130b074c.jpg"
      ],
      "image": "assets/images/23567/step_04.webp"
    },
    {
      "text": "Cover and cook on High for 3 to 4 hours, or on Low for 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aS6gMSgfltvbBYrkvq74z4us7OE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23567-slow-cooker-pepper-steak-Beauties-4x3-08926a13d0b8423288bb83bcabc217fb.jpg"
      ],
