  "ingredients": [
    "1 pound ground turkey",
    "0.25 cup dry bread crumbs",
    "1 onion, finely chopped",
    "1 green onion, chopped",
    "1 egg",
    "2 cloves garlic, minced",
    "2 tablespoons parsley paste",
    "1.5 tablespoons Worcestershire sauce",
    "1 tablespoon hot pepper sauce (such as Tabasco®)",
    "0.5 teaspoon salt",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Mix ground turkey, bread crumbs, onion, green onion, egg, garlic, parsley paste, Worcestershire sauce, hot pepper sauce, and salt together in a bowl. Cover bowl with plastic wrap and refrigerate for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form turkey mixture into four patties; arrange in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center and the juices run clear, about 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
