  "ingredients": [
    "1 tablespoon butter",
    "0.25 cup chopped mushrooms",
    "1 tablespoon chopped onion",
    "1 tablespoon chopped green bell pepper",
    "1 cup crushed tomatoes",
    "1 tablespoon capers",
    "6 eggs, beaten",
    "4 slices bread, toasted"
