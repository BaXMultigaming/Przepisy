  "ingredients": [
    "1 pound uncooked medium shrimp - peeled, deveined, and chopped",
    "1 pound peeled crawfish tails, chopped",
    "8 ounces crushed saltine crackers",
    "10 scallions, chopped",
    "2 eggs",
    "2 tablespoons chopped red bell pepper",
    "2 tablespoons mayonnaise",
    "2 tablespoons olive oil",
    "1.5 teaspoons dry mustard",
    "1.5 teaspoons garlic powder",
    "1 teaspoon cayenne pepper",
    "0.5 teaspoon seafood seasoning (such as Old Bay®)",
    "1 cup panko bread crumbs",
    "0.5 cup olive oil"
  ],
  "steps": [
    {
      "text": "Mix shrimp, crawfish, crackers, scallions, eggs, bell pepper, mayonnaise, 2 tablespoons olive oil, dry mustard, garlic powder, cayenne pepper, and seafood seasoning together in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form mixture into patties that are about 3 inches in diameter and 1/2-inch thick. Cover with a light coating of panko bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1/2 cup oil in a deep skillet over medium to medium-high heat. Cook patties in the hot oil until golden brown, about 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
