  "ingredients": [
    "3 large eggs",
    "0.5 cup whole milk",
    "0.5 cup all-purpose flour",
    "3 tablespoons maple syrup",
    "3 tablespoons unsalted butter",
    "2 teaspoons vanilla extract",
    "0.75 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, milk, flour, maple syrup, vanilla, cinnamon, nutmeg, and salt in a blender; blend until smooth and free of lumps, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut butter into 12 equal pieces; place 1 piece in each cup of a 12-cup muffin tin. Place tin in the oven until butter melted, about 1 minute. Divide batter among the prepared cups. Place muffin tin on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place baking sheet in the preheated oven; bake until pancakes are puffed and browned on edges, 10 to 15 minutes. Remove from the oven; cool in the tin for 2 minutes. Run a knife around edges and bottoms of cups to loosen. Serve pancakes immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
