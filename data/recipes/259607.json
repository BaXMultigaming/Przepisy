  "ingredients": [
    "1.5 cups frozen strawberries, divided",
    "1.5 cups soy milk",
    "0.5 cup frozen blueberries",
    "2 large scoops acai powder",
    "1 tablespoon flaxseed oil",
    "2 teaspoons stevia powder"
