  "ingredients": [
    "10 slices white bread, cut into cubes",
    "0.25 cup butter, melted",
    "1 teaspoon ground cinnamon",
    "0.5 cup raisins",
    "6 eggs, beaten",
    "0.75 cup white sugar",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon salt",
    "3 cups hot milk (160 degrees F/71 degrees C)",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly butter one 2 quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread cubes, butter, cinnamon and raisins; mix well and place in baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together the eggs, sugar, vanilla and salt. Add milk, mix well and pour over bread cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with nutmeg and bake for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
