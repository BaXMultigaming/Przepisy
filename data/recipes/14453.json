  "ingredients": [
    "0.5 pound bacon",
    "6 cups fresh broccoli florets",
    "0.5 cup diced onion",
    "0.5 cup dried cherries",
    "0.5 cup sunflower seeds",
    "0.75 cup mayonnaise",
    "1 teaspoon curry powder",
    "2 tablespoons cider vinegar",
    "0.25 cup white sugar"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the bacon, broccoli, onion, dried fruit and sunflower seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together the mayonnaise, curry powder, vinegar and sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing over salad; toss to coat, and marinate over night.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
