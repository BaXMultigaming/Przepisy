  "steps": [
    {
      "text": "Place the sugar, water, lemon zest, cinnamon, and 2 tablespoons of lemon juice into a small saucepan. Bring to a boil; reduce heat to medium-low and simmer 10 minutes. Strain the syrup through a mesh strainer; refrigerate until cold.",
      "section": null,
      "name": null,
