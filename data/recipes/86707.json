      ],
      "image": "assets/images/86707/step_01.webp"
    },
    {
      "text": "Place ribs in a large pot and fill with enough water to cover. Bring to a boil and cook until meat is no longer pink, about 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
