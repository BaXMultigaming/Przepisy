  "ingredients": [
    "2 cups white rice",
    "1 cup brown lentils",
    "1 cup pearled barley",
    "0.25 cup olive oil",
    "2 tablespoons minced garlic",
    "2 tablespoons chicken stock concentrate (such as Better than Bouillon®)",
    "water as needed"
  ],
  "steps": [
    {
      "text": "Rinse rice, lentils, and barley thoroughly and mix in a rice cooker pot; add olive oil, garlic, and stock concentrate and stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour enough water over the mixture to reach the 4 1/2-cup mark on the rice cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press Start and let cook until the rice and lentils are tender, about 30 minutes.",
