  "ingredients": [
    "2 cups baking mix (such as Bisquick ®)",
    "0.33333334326744 cup milk",
    "1 egg",
    "2 tablespoons white sugar",
    "0.125 teaspoon ground cinnamon",
    "0.25 cup butter, melted",
    "0.5 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix baking mix, milk, egg, 2 tablespoons sugar, and cinnamon together in a bowl with a whisk, beating vigorously for 20 strokes. Transfer dough to a floured work surface and knead 5 times. Roll dough into 1/2-inch thickness and cut with a floured doughnut cutter. Place doughnuts onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through and lightly browned, 7 to 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour melted butter into a bowl. Place 1/2 cup sugar in a separate bowl. Dip doughnuts into butter; transfer to sugar and lightly press until doughnuts are coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
