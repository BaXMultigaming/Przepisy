  "ingredients": [
    "olive oil cooking spray",
    "3 medium russet potatoes",
    "2 (4 ounce) cans diced green chiles",
    "2 cups heavy cream",
    "4 tablespoons butter, melted",
    "kosher salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a round, glass pie pan with olive oil cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice the potatoes finely using a mandoline and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Empty both cans of green chiles into a bowl and pulse with an immersion blender. Mix in cream and butter; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer the bottom of the prepared pan with potatoes and spoon over some of the cream mixture. Continue layering until you are out of potatoes. Pour the remaining cream mixture over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tortilla is set, about 1 hour and 15 minutes. Let cool, slice, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
