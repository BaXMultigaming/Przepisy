  "ingredients": [
    "1 tablespoon white sugar",
    "0.75 teaspoon ground cinnamon",
    "2 (15.25 ounce) cans apple pie filling with cinnamon",
    "1 cup cinnamon-flavored applesauce",
    "0.5 cup white sugar",
    "0.25 cup brown sugar",
    "3 tablespoons unsalted butter",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon lemon juice",
    "2 (8 ounce) packages refrigerated crescent roll dough, divided",
    "0.25 cup unsalted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar and cinnamon for topping together in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To prepare the cobbler: Mix apple filling, applesauce, white and brown sugars, butter, vanilla, and lemon juice in a pan over medium heat; cook until thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press 1/2 of the crescent dough into the bottom of the prepared pan to form a crust. Pour apple mixture over the crust and spread remaining crescent dough over top. Brush dough with melted butter and sprinkle with cinnamon-sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden brown, about 25 minutes. Let cool 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
