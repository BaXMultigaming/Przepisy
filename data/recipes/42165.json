  "title": "Vegan Mac and No Cheese",
  "description": "Nutritional yeast gives baked macaroni a cheese-like flavor. Cashews and roasted red peppers round out this satisfying baked side dish.",
  "authors": [
    "AZIAZEL"
  ],
  "date_published": "2019-07-10T02:53:21-04:00",
