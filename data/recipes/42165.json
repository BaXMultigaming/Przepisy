  "ingredients": [
    "1 (8 ounce) package uncooked elbow macaroni",
    "1 tablespoon vegetable oil",
    "1 medium onion, chopped",
    "1 cup cashews",
    "0.33333298563957 cup lemon juice",
    "1.3333300352097 cups water",
    "salt to taste",
    "0.33333298563957 cup canola oil",
    "4 ounces roasted red peppers, drained",
    "3 tablespoons nutritional yeast",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add macaroni, and cook for 8 to 10 minutes or until al dente; drain. Transfer to a medium baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a medium saucepan over medium heat. Stir in onion, and cook until tender and lightly browned. Gently mix with the macaroni.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a blender or food processor, mix cashews, lemon juice, water, and salt. Gradually blend in canola oil, roasted red peppers, nutritional yeast, garlic powder, and onion powder. Blend until smooth. Thoroughly mix with the macaroni and onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 45 minutes in the preheated oven, until lightly browned. Cool 10 to 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
