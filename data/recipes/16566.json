  "title": "Chicken and Ham Casserole",
  "description": "An assemblage of leftover chicken and ham, some noodles and vegetables, a little cheese--just about whatever you have on hand will work in this casserole.",
  "authors": [
    "NIBLETS"
  ],
  "date_published": "1999-04-29T21:58:36-04:00",
