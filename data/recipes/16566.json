  "ingredients": [
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "1 cup milk",
    "0.5 cup cooked, cubed chicken breast meat",
    "0.5 cup cooked and cubed ham",
    "0.5 cup cooked wide egg noodles",
    "0.25 cup chopped celery",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "3 ounces shredded Cheddar cheese",
    "1 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over low heat. Stir in the flour and heat until bubbly. Slowly add the milk, stirring constantly, until mixture is thickened and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and stir in the chicken, ham, noodles, celery, salt and ground black pepper. Transfer this mixture to a 1 1/2 quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 400 degrees F (200 degrees C) for 15 minutes. Remove from oven, sprinkle with the cheese and top with paprika, as desired. Return to oven and bake for 5 to 10 minutes, or until cheese is bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
