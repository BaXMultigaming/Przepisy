  "ingredients": [
    "2 teaspoons olive oil",
    "0.5 cup minced onion",
    "2 cloves garlic, crushed",
    "1 (28 ounce) can crushed tomatoes",
    "2 (6.5 ounce) cans canned tomato sauce",
    "2 (6 ounce) cans tomato paste",
    "0.5 cup water",
    "2 tablespoons white sugar",
    "2 tablespoons chopped fresh parsley",
    "1.5 teaspoons dried basil",
    "1 tablespoon salt",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon fennel seeds",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large, heavy pot over medium heat. Cook and stir onion and garlic in hot oil until tender, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir crushed tomatoes, tomato sauce, tomato paste, and water into onion mixture until smooth; add sugar, parsley, basil, salt, Italian seasoning, fennel, and pepper. Stir well and bring to a simmer; reduce heat to low and cook, stirring occasionally, until thickened, 1 to 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
