  "ingredients": [
    "2 tablespoons butter",
    "4 skinless, boneless chicken breast halves",
    "4 ounces fresh mushrooms, sliced",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1.5 cups water",
    "2 tablespoons chopped fresh parsley",
    "0.25 teaspoon salt",
    "1 pinch ground black pepper",
    "1.5 cups instant rice"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet. Add chicken and mushrooms and cook until browned, about 5 minutes. Stir in soup, water, parsley, salt, and black pepper. Cover and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in uncooked rice and simmer until liquid has been absorbed, about 10 minutes more.",
      "section": null,
