  "ingredients": [
    "6 red potatoes, cubed",
    "2 teaspoons dried parsley",
    "1 teaspoon paprika",
    "1 teaspoon cayenne pepper",
    "1 teaspoon chili powder",
    "1 teaspoon onion salt",
    "1 teaspoon garlic powder",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes. Drain and spread on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine parsley, paprika, cayenne pepper, chili powder, onion salt, and garlic powder in a small bowl. Drizzle potatoes with oil, then sprinkle with spice mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake potatoes in the preheated oven, stirring every 10 minutes, until crisp, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
