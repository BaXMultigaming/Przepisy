  "ingredients": [
    "2 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "2 eggs",
    "0.33333334326744 cup confectioners' sugar",
    "1 cup milk",
    "1 teaspoon vegetable oil",
    "1 teaspoon vanilla extract",
    "2 bananas, chopped",
    "0.5 cup chopped strawberries",
    "0.25 cup vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Sift flour, baking powder, cinnamon, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and confectioners' sugar together in a large bowl. Add milk, 1 teaspoon oil, and vanilla extract; mix well to combine. Add flour mixture; stir until just combined. Gently fold bananas and strawberries into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1/4 cup oil in a large nonstick skillet over medium heat. Scoop 1/4 cup batter at a time into the oil and fry fritters, in batches, until light golden brown, 2 to 3 minutes per side. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
