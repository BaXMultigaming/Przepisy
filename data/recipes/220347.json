  "title": "Sweet and Sour Chicken Tenders",
  "description": "These sweet and sour chicken tenders are pan-fried until crisp, then tossed in a tangy sauce of vinegar, broth, ketchup, and a hint of soy sauce.",
  "authors": [
    "Dawn Schultz"
  ],
  "date_published": "2020-06-18T23:47:36-04:00",
