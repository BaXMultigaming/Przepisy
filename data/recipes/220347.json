  "ingredients": [
    "1 egg, beaten",
    "0.5 cup cornstarch",
    "1 teaspoon garlic salt",
    "10 chicken tenders",
    "1 tablespoon vegetable oil",
    "0.5 cup cider vinegar",
    "0.5 cup white sugar",
    "0.25 cup chicken broth",
    "0.25 cup ketchup",
    "1 tablespoon soy sauce",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beaten egg in a shallow bowl. Place cornstarch and garlic salt into a large resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken in beaten egg, allowing excess to drip off. Drop chicken into cornstarch mixture, seal the bag, and shake until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Cook chicken in hot oil, turning occasionally, until browned, about 5 minutes. Transfer chicken to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together vinegar, sugar, broth, ketchup, soy sauce, and salt in a medium bowl. Pour over chicken in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink in the center and the juices run clear, about 40 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
