  "ingredients": [
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon white sugar",
    "8 tablespoons creamy peanut butter",
    "8 slices whole wheat bread",
    "1 large Gala apple, peeled, cored, and thinly sliced",
    "0.25 cup unsalted butter"
  ],
  "steps": [
    {
      "text": "Mix cinnamon and sugar together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1 tablespoon peanut butter onto each bread slice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange apple slices on 1/2 of the bread slices. Sprinkle cinnamon-sugar mixture evenly over apples. Sandwich remaining bread slices over apples with peanut butter facing down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
