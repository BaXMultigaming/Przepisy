  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "2 cucumbers - peeled, seeded and chopped",
    "1 cup mayonnaise",
    "1 tablespoon fresh lemon juice",
    "0.5 teaspoon dried dill weed",
    "0.5 teaspoon hot pepper sauce"
