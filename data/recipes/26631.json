  "ingredients": [
    "2.5 pounds ground beef",
    "1 cup hickory smoke flavored barbeque sauce",
    "1 onion, finely chopped",
    "1 (6 ounce) package herb-seasoned dry bread stuffing mix",
    "0.5 cup milk",
    "3 eggs, beaten",
    "1 teaspoon minced garlic",
    "1 cup packed brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, 1 cup barbecue sauce, onion, stuffing mix, milk, eggs, and garlic in a large bowl; mix thoroughly. Divide and shape into 2 loaves; place into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1 cup barbecue sauce and brown sugar in a small bowl until well blended; pour glaze over meatloaves. Cover the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 60 to 90 minutes; uncover during the last 15 minutes of bake time. Let sit before slicing, 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
