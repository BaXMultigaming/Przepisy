  "ingredients": [
    "0.5 cup water",
    "2 tablespoons white sugar",
    "1 tablespoon cornstarch",
    "3 egg whites",
    "0.25 teaspoon cream of tartar",
    "1 pinch salt",
    "0.5 teaspoon vanilla extract",
    "6 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Combine water, 2 tablespoons sugar, and cornstarch in a small saucepan. Cook over low heat, stirring constantly, until clear and thickened, about 2 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites, cream of tartar, and salt in a large glass or metal bowl until foamy. Add vanilla. Gradually beat in remaining 6 tablespoons sugar until soft peaks form. Gradually beat in cornstarch mixture until stiff, glossy peaks form. Spread meringue over hot pie filling, sealing to the crust. Brown in the oven as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
