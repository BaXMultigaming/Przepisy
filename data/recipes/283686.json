  "ingredients": [
    "3 tablespoons ground coffee beans",
    "6 ounces water",
    "0.75 cup cold brew coffee",
    "0.25 cup whipping cream",
    "2 tablespoons sweetened condensed milk",
    "0.5 cup ice cubes",
    "1 tablespoon sugar-free chocolate flavoring syrup (such as Torani®)",
    "1 tablespoon whipped cream for garnish"
  ],
  "steps": [
    {
      "text": "In a standard coffee maker, add the ground coffee. Brew enough coffee to make 6 ounces. Allow coffee to chill overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/2 cup chilled coffee, 3/4 cup cold coffee brew, whipping cream, and sweetened condensed milk into a high quality blender (such as Vitamix®. Add ice cubes. Blend for 1 minute at high speed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle a pilsner glass with chocolate syrup. Pour coffee beverage into the glass. Add whipped cream and more chocolate drizzle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drink remaining strong brewed coffee like a shot, then consume this beverage. Be stingy. Don't share. You'll need the caffeine after the lost hour of sleep!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
