  "ingredients": [
    "4 tablespoons packed dark brown sugar",
    "2 tablespoons water",
    "0.5 tablespoon kosher salt",
    "1.5 teaspoons molasses",
    "1 teaspoon ground cumin",
    "1 teaspoon ground cinnamon",
    "0.75 teaspoon ground ginger",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon ground nutmeg",
    "3.5 cups roasted unsalted pumpkin seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk brown sugar, water, salt, molasses, cumin, cinnamon, ginger, cayenne pepper, and nutmeg together in a medium mixing bowl. Add pumpkin seeds and toss until evenly coated. Transfer to the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until crispy, stirring halfway through, 35 to 40 minutes. Remove from the oven, stir, then carefully slide or lift the parchment paper off the baking sheet and set on the counter to cool completely. Break up any clumps with your hands and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
