  "ingredients": [
    "2 teaspoons olive oil",
    "1 teaspoon Italian seasoning",
    "0.25 teaspoon salt",
    "0.13 teaspoon freshly ground black pepper",
    "1 large zucchini, cut into 1/2-inch slices",
    "0.25 cup shredded Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, Italian seasoning, salt, and pepper together in a large bowl. Add zucchini rounds and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place zucchini in the basket of the air fryer in one layer and cook for 5 minutes. Flip zucchini over, sprinkle Parmesan cheese over the top, and cook until cheese is melted and starting to brown, about 5 more minutes.",
