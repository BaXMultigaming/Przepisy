  "ingredients": [
    "1 pound shredded, cooked chicken",
    "1 (15 ounce) can whole peeled tomatoes, mashed",
    "1 (10 ounce) can enchilada sauce",
    "1 (4 ounce) can chopped green chile peppers",
    "1 medium onion, chopped",
    "2 cloves garlic, minced",
    "2 cups water",
    "1 (14.5 ounce) can chicken broth",
    "1 teaspoon cumin",
    "1 teaspoon chili powder",
    "1 teaspoon salt",
    "0.25 teaspoon black pepper",
    "1 bay leaf",
    "1 (10 ounce) package frozen corn",
    "1 tablespoon chopped cilantro",
    "7 corn tortillas",
    "2 tablespoons vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rvrsu9Hkej_F7v1866rUDPekCLc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-89539-slow-cooker-chicken-tortilla-soup-DDMFS-Step-01-01-540eea8210ad48fd9f65fe13db7f09af.jpg"
      ],
      "image": "assets/images/89539/step_01.webp"
    },
    {
      "text": "Place chicken, tomatoes, enchilada sauce, green chiles, onion, and garlic into a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HA16XB73pGiHqytisf3llYswE-4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-89539-slow-cooker-chicken-tortilla-soup-DDMFS-Step-02-fbc65f12fc754539914bcca004f86bf2.jpg"
      ],
      "image": "assets/images/89539/step_02.webp"
    },
    {
      "text": "Pour in water and chicken broth; season with cumin, chili powder, salt, pepper, and bay leaf. Stir in corn and cilantro. Cover and cook on Low for 6 to 8 hours or on High for 3 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tuahrpjOeJcjPdOFHMhq4zWqS1I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-89539-slow-cooker-chicken-tortilla-soup-DDMFS-Step-03-86cf2aa41c254b81b14c71d978924c75.jpg"
      ],
      "image": "assets/images/89539/step_03.webp"
    },
    {
      "text": "When the soup is almost finished, preheat the oven to 400 degrees F (200 degrees C). Lightly brush both sides of tortillas with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ddlRZJdomTGr-Tz9mnSB_5ipeI4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-89539-slow-cooker-chicken-tortilla-soup-DDMFS-Step-04-2d3292b581f24c0b8e363361d0ae8f52.jpg"
      ],
      "image": "assets/images/89539/step_04.webp"
    },
    {
      "text": "Cut tortillas into strips, then spread on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SCBEeXtjS_7iqr8RlbYbX9mBjq0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-89539-slow-cooker-chicken-tortilla-soup-DDMFS-Step-05-b86b62c7196447419f5fe97e6592f866.jpg"
      ],
      "image": "assets/images/89539/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until crisp, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b5C9KGhmEDX5hEmmXYJCz68YQkA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-89539-slow-cooker-chicken-tortilla-soup-DDMFS-Step-06-09fe07d62b654903b979b2d11bb2e963.jpg"
      ],
      "image": "assets/images/89539/step_06.webp"
    },
