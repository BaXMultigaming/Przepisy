  "ingredients": [
    "2.5 pounds red potatoes, cubed",
    "3 tablespoons olive oil",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic salt",
    "0.25 teaspoon ground black pepper",
    "0.25 pinch paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a large baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, onion powder, garlic salt, pepper, and paprika together in a small bowl. Pour over potato cubes, hand-tossing to coat. Place potatoes into the prepared pan, spreading them so that they are evenly dispersed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Stir. Continue to bake until potatoes are crispy brown and tender, 10 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
