  "ingredients": [
    "1 cup boiling water",
    "1 cup dried apricots, chopped",
    "3 tablespoons margarine",
    "0.5 cup cream cheese, softened",
    "1 cup white sugar",
    "2 eggs",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup dates, pitted and chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 9x5x3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour boiling water over apricot pieces in a small bowl. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, combine flour, baking powder, soda, salt, and dates.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream butter or margarine, cream cheese, and sugar. Beat in eggs, one at a time, until smooth. Stir in cooled apricots and water. Pour in flour mixture, and stir until moistened. Turn batter into greased 9x5x3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour, or until it tests done. Let stand 10 minutes. Remove from pan to rack. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
