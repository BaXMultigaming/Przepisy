  "title": "Apricot Cheese Loaf",
  "description": "Dried apricots and dates pack toothsome richness in this bread that also features cream cheese to balance the sweetness.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-08-30T11:53:56-04:00",
