  "ingredients": [
    "1 cup strong brewed coffee",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (12 fluid ounce) can or bottle porter-style beer",
    "2 (6 ounce) cans tomato paste",
    "1 cup beef broth",
    "0.5 cup brown sugar",
    "0.25 cup ketchup-style chili sauce (such as Heinz®)",
    "0.25 cup chopped jalapeno peppers",
    "1 tablespoon ground cumin",
    "1 tablespoon cocoa powder",
    "2 teaspoons ground ancho chile powder",
    "1 teaspoon oregano",
    "1 teaspoon cayenne pepper",
    "1 teaspoon ground coriander",
    "1 teaspoon salt",
    "2 teaspoons vegetable oil",
    "2 pounds extra lean ground beef",
    "2 onions, chopped",
    "3 cloves garlic, minced",
    "0.5 cup cornmeal"
  ],
  "steps": [
    {
      "text": "Pour coffee into a slow cooker and set slow cooker to High; add diced tomatoes, beer, tomato paste, beef broth, brown sugar, chili sauce, jalapeno peppers, cumin, cocoa powder, chile powder, oregano, cayenne pepper, coriander, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Cook and stir ground beef, onions, and garlic in the skillet until the beef is browned completely, 7 to 10 minutes; add to mixture in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly pour cornmeal into the slow cooker while stirring to assure no lumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to Low and cook for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
