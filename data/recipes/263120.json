  "ingredients": [
    "1 bunch cilantro, divided",
    "1 (8 ounce) container reduced-fat sour cream",
    "1 lime, juiced",
    "1 jalapeno pepper, chopped, or to taste",
    "0.5 teaspoon kosher salt",
    "3 tilapia fillets, or more to taste",
    "1 tablespoon onion powder",
    "1 tablespoon herbes de Provence",
    "1 teaspoon ground black pepper",
    "1 teaspoon dried chives",
    "0.5 teaspoon kosher salt",
    "6 (6 inch) corn tortillas",
    "1 lime, halved",
    "1.5 cups shredded cabbage",
    "0.5 cup red onion, chopped",
    "0.5 cup crumbled queso fresco"
  ],
  "steps": [
    {
      "text": "Place most of the cilantro into a blender, reserving the rest for garnish. Add sour cream, lime juice, jalapeno, and salt. Blend until just liquefied. Place sauce in refrigerator until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle tilapia fillets with onion powder, herbes de Provence, pepper, chives, and salt. Grill tilapia until fish flakes easily with a fork, 4 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place each tortilla between 2 damp paper towels. Heat in the microwave, about 20 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred tilapia and arrange down the center of each tortilla. Squeeze lime juice over tilapia and top with cabbage and red onion. Spoon the cilantro sauce over the tacos and top with queso fresco. Garnish with the reserved cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
