    "publisher-tested"
  ],
  "ingredients": [
    "100 grams active sourdough starter",
    "394 grams bread flour",
    "250 grams water",
    "8 grams kosher salt",
    "2 tablespoons rice flour, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v7ub1lsBKOpzCcYzBm8VuupB5NQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/260540-Chef-Johns-Sourdough-Bread-DDMFS-005-step1-3d6ee3316bc64774b1e7b10161d8f184.jpg"
      ],
      "image": "assets/images/260540/step_01.webp"
    },
    {
      "text": "Place starter into a bowl. Add bread flour, water, and salt; mix until well blended and sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nsd71vFgehVJbq_VVuXGC0Yc7e0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/260540-Chef-Johns-Sourdough-Bread-DDMFS-008-step4-aff33432eeca4b968ac4e532365e4474.jpg"
      ],
      "image": "assets/images/260540/step_02.webp"
    },
    {
      "text": "Cover with aluminum foil and let stand for 4 hours at 70 to 75 degrees F (21 to 24 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JfE7LPxcUqB1vlR8pAMjyiuLC3w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/260540-Chef-Johns-Sourdough-Bread-DDMFS-009-step14-f6f062db9b394254b7e9200b311adbe2.jpg"
      ],
      "image": "assets/images/260540/step_03.webp"
    },
    {
      "text": "Uncover dough and use wet hands to fold it over onto itself three to four times. Cover again with foil and let ferment for 2 more hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iZbpmUnlRugkTNJZN5OvX9lTB_0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/260540-Chef-Johns-Sourdough-Bread-DDMFS-011-step11-4494bd71c1a540a8b113c70dea88d575.jpg"
      ],
      "image": "assets/images/260540/step_04.webp"
    },
    {
      "text": "Generously dust a proofing basket (banneton) with rice flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrape dough out onto a lightly floured work surface. Shape into a ball with a smooth, unbroken surface, using just enough flour on the surface to keep it from sticking. Place dough into the prepared basket with the smooth side down. Pinch the rougher edges on the surface together toward the center to smooth them while maintaining a round ball shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/by9ZJwNaRafxAPg_JGAipVyJfLk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/260540-Chef-Johns-Sourdough-Bread-DDMFS-013-step13-864ea677c78a4f2c9303c2807355d3b9.jpg"
      ],
      "image": "assets/images/260540/step_06.webp"
    },
    {
      "text": "Cover and refrigerate for 12 hours to slow the fermentation process.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JfE7LPxcUqB1vlR8pAMjyiuLC3w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/260540-Chef-Johns-Sourdough-Bread-DDMFS-009-step14-f6f062db9b394254b7e9200b311adbe2.jpg"
      ],
      "image": "assets/images/260540/step_07.webp"
    },
    {
      "text": "Remove the banneton from the refrigerator. Let sit in a warm spot until dough springs back slowly and retains a slight indentation when poked gently with a finger, about 3 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a rimmed baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dust surface of dough with flour. Gently invert the banneton over the center of the baking sheet and flip dough out onto the parchment paper. Gently brush off excess rice flour. Score top of dough about 1/8-inch deep with a sharp knife to create a shallow slit running across the center. Mist the entire surface lightly with water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ttPEsr7JdeEBtKvdjUrUIxESlvw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/260540-Chef-Johns-Sourdough-Bread-DDMFS-016-step16-320c27e625f64652a6e9cf3a54adf905.jpg"
      ],
      "image": "assets/images/260540/step_10.webp"
    },
    {
      "text": "Bake in the center of the preheated oven until beautifully browned, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l5MR_LASzMouEuq494IONXIdolA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/260540-Chef-Johns-Sourdough-Bread-DDMFS-017-step17-af7775f975154c06b3851181de17448f.jpg"
      ],
      "image": "assets/images/260540/step_11.webp"
    },
    {
      "text": "Transfer loaf to a wire rack and let cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DCWXlgmQnMJTPiwFiYm_i3hlCbY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/260540-Chef-Johns-Sourdough-Bread-DDMFS-004-4x3-6791a75a5d804ec28424d04756054c5b.jpg"
      ],
      "image": "assets/images/260540/step_12.webp"
    }
  ],
