  "ingredients": [
    "1 pound roma tomatoes, quartered",
    "1 pound sliced button mushrooms",
    "5 cloves garlic, chopped",
    "2 tablespoons extra virgin olive oil",
    "salt and pepper to taste",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon ground cumin",
    "0.25 teaspoon ground coriander",
    "0.25 teaspoon dried oregano leaves",
    "0.25 teaspoon dried marjoram leaves",
    "0.25 teaspoon dried thyme leaves",
    "0.25 teaspoon dried rosemary, crushed",
    "0.25 teaspoon dried sage leaves, crushed",
    "0.25 teaspoon dried basil leaves",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon ground paprika",
    "0.25 teaspoon white sugar",
    "0.25 teaspoon crushed red pepper",
    "2.25 pounds pork chops"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 9x13 inch baking dish, toss tomatoes, mushrooms, garlic, and olive oil with salt and pepper to taste. Mix lightly with hands to coat all ingredients with oil, and spread the tomato-mushroom mixture to the edges of the dish, leaving the center free for the pork chops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 teaspoon salt, 1/2 teaspoon black pepper, cumin, ground coriander, oregano, marjoram, thyme, rosemary, sage, basil, garlic powder, onion powder, ground paprika, sugar, and crushed red pepper in a bowl to make a spice rub.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle the pork chops with the spice rub, working the rub well into both sides of the meat. Place pork chops in the center of the baking dish, surrounded by the tomato and mushroom mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in preheated oven until the pork is no longer pink in the center and mushrooms are tender, about 45 to 50 minutes. An instant-read thermometer inserted into the center of a chop should read 145 degrees F (63 degrees C). Transfer pork chops to a serving dish and top with roasted tomato-mushroom mixture and all pan juices to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
