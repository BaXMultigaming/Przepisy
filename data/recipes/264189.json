  "ingredients": [
    "12 chocolate sandwich cookies (such as Oreo®)",
    "2 (8 ounce) packages cream cheese, softened",
    "2 large eggs, lightly beaten",
    "0.5 cup sour cream",
    "0.5 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "6 chocolate sandwich cookies (such as Oreo®), chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Line a 12-cup muffin tin with paper liners; place 1 cookie into each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese in a medium bowl with an electric mixer until creamy. Gradually add eggs, sour cream, sugar, and vanilla extract, beating well after each addition. Stir in chopped cookies with a spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared tin, filling each cup almost to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 20 to 22 minutes. Transfer cups to a cooling rack. Refrigerate until firm, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
