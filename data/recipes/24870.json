    "2 pounds carrots, sliced",
    "1 (10.75 ounce) can condensed tomato soup",
    "0.25 cup white sugar",
    "0.5 cup white vinegar",
    "0.25 cup canola oil",
    "1 teaspoon prepared mustard",
