  "ingredients": [
    "1 large egg, beaten",
    "2 tablespoons mayonnaise",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon Dijon mustard",
    "1 teaspoon seafood seasoning (such as Old Bay®)",
    "0.5 teaspoon hot pepper sauce",
    "2 tablespoons finely chopped green onion",
    "1 pound lump crabmeat, drained and picked over",
    "3 tablespoons milk",
    "salt and ground black pepper to taste",
    "11 saltine crackers, crushed",
    "1 teaspoon baking powder",
    "4 wedges lemon",
    "olive oil cooking spray"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FVAOy4k-vuNqlN9LLn4m7mGZJdQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277956-air-fryer-crab-cakes-ddmfs-step1-3x4-13030-6d11e7b9ad14437890a087552dbcd331.jpg"
      ],
      "image": "assets/images/277956/step_01.webp"
    },
    {
      "text": "Combine beaten egg, mayonnaise, Worcestershire sauce, mustard, seafood seasoning, and hot pepper sauce in a large bowl. Stir in green onion and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uIC-QO8RaiPeodzCkkPqWwQ3a84=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277956-air-fryer-crab-cakes-ddmfs-step2-3x4-13034-669c8f154e7f40109f7fb39cd6211677.jpg"
      ],
      "image": "assets/images/277956/step_02.webp"
    },
    {
      "text": "Place crabmeat in a medium bowl and break up with a fork. Add milk, salt, and black pepper; toss to coat. Add saltine crackers and baking powder; toss lightly to combine. Add to egg mixture, stirring gently and being careful not to break apart crab lumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Es-kb1pTPnMkTyw_dZTM56fj-6E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277956-air-fryer-crab-cakes-ddmfs-step4-3x4-13040-a5a464c88d0b4227839e1485d666c639.jpg"
      ],
      "image": "assets/images/277956/step_03.webp"
    },
    {
      "text": "Scoop crab with a 1/3-cup measure and form into 8 patties. Place patties on a plate, cover, and refrigerate until firm, 1 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cTYH5OUBWkAklibgZxeZNyWXjXs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277956-air-fryer-crab-cakes-ddmfs-step5-3x4-13044-d262a7351084444c8b637da26eae0c62.jpg"
      ],
      "image": "assets/images/277956/step_04.webp"
    },
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray crab cakes on both sides with cooking spray and place in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mNzvS0H7-D08q_Y8UM19CPQaO_0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277956-air-fryer-crab-cakes-ddmfs-step7-3x4-13099-1ec661d7fbe0434c82b28d86bb7ddf2e.jpg"
      ],
      "image": "assets/images/277956/step_06.webp"
    },
    {
      "text": "Cook in the preheated air fryer for 5 minutes. Turn crab cakes over gently and continue cooking until crispy brown, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HOSu4AFC7-_v2g_FsFN2769OwDg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277956-air-fryer-crab-cakes-ddmfs-step7-3x4-13116-fd0d8054e1a24861bf87f87a76fed835.jpg"
      ],
      "image": "assets/images/277956/step_07.webp"
    }
