  "ingredients": [
    "2 tablespoons fresh lemon juice",
    "1 onion, peeled and sliced",
    "0.25 cup distilled white vinegar",
    "0.5 cup water",
    "2 tablespoons brown sugar",
    "1 tablespoon prepared mustard",
    "0.5 teaspoon ground black pepper",
    "1.5 teaspoons salt",
    "0.25 teaspoon cayenne pepper",
    "0.25 cup vegetable oil",
    "0.5 cup ketchup",
    "2 tablespoons Worcestershire sauce",
    "1.5 teaspoons liquid smoke flavoring"
  ],
  "steps": [
    {
      "text": "In a medium saucepan, mix lemon juice, onion, distilled white vinegar, water, brown sugar, prepared mustard, ground black pepper, salt, cayenne pepper and vegetable oil. Bring to a boil, then simmer uncovered 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ketchup, Worcestershire sauce and liquid smoke flavoring into the mixture. Return to boil, then remove from heat. Refrigerate until ready for use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
