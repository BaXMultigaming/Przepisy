  "ingredients": [
    "2 pounds ground beef",
    "1 small onion, diced",
    "0.25 cup dry bread crumbs, or as needed",
    "0.25 cup freshly grated Parmesan cheese",
    "2 eggs, slightly beaten",
    "4 cloves garlic, minced",
    "1 tablespoon dried oregano",
    "1 tablespoon dried basil",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon dried thyme",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a large baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, onion, bread crumbs, Parmesan cheese, eggs, garlic, oregano, basil, Worcestershire sauce, thyme, salt, and black pepper in a large bowl until just combined. Divide mixture into 4 equal portions; roll each portion into 4 meatballs. Arrange meatballs on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the centers, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
