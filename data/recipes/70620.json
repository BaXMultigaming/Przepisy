  "ingredients": [
    "1 cup chocolate chips",
    "1.5 cups all-purpose flour",
    "0.5 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.25 cup butter",
    "1 egg",
    "0.25 cup milk",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 2-quart casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate chips in a microwave-safe glass measuring cup in 20-second intervals until smooth, stirring after each interval. Let stand for 5 minutes to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, and salt in a medium bowl. Cut in butter with 2 knives or pastry blender until dough is a uniform crumbly texture. Beat egg into melted chocolate, then stir in milk; stir into flour mixture until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cherry pie filling in an even layer in the bottom of the prepared dish. Drop batter by spoonfuls in a random pattern over cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top crust is not doughy when lifted, 40 to 45 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
