  "ingredients": [
    "0.25 cup canola oil",
    "0.33333334326744 cup all-purpose flour",
    "0.25 cup vegetable broth",
    "3 tablespoons tamari sauce",
    "2 cups soy milk",
    "2 tablespoons nutritional yeast",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Whisk flour, vegetable broth, and tamari into hot oil; cook and stir until there are no lumps and mixture becomes paste-like, about 5 minutes. Pour soy milk into the skillet; cook and stir until mixture thickens, about 5 minutes more. Add yeast and black pepper; stir well and serve hot.",
