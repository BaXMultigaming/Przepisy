  "ingredients": [
    "1 gallon dill pickle slices, drained",
    "5 pounds white sugar",
    "2 tablespoons pickling spice",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Remove ½ pickles from container; set aside. Pour about ½ sugar over pickles in the container; pour in 1 tablespoon pickling spice and 1 teaspoon ground cinnamon. Add remaining ½ each pickles, sugar, pickling spice, and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Seal the container; refrigerate for about 24 hours, turning about every 6 hours to help sugar dissolve. Serve when sugar has dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
