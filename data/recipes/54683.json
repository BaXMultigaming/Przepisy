  "ingredients": [
    "3 cups mashed cooked sweet potatoes",
    "1 cup white sugar",
    "2 eggs",
    "2.5 tablespoons butter, melted",
    "0.5 cup milk",
    "0.5 teaspoon salt",
    "1 teaspoon vanilla extract",
    "1 cup packed light brown sugar",
    "1 cup coarsely chopped pecans",
    "0.5 cup all-purpose flour",
    "2.5 tablespoons melted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 9 inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the sweet potatoes, white sugar, eggs, 2 1/2 tablespoons melted butter, milk, salt and vanilla until well blended. Spread evenly in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, stir together the light brown sugar, pecans and flour. Stir in remaining 2 1/2 tablespoons of butter to make the crumb topping. Spread topping over the sweet potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 to 30 minutes in the preheated oven, until topping is browned and crispy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
