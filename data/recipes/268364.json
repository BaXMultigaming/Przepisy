  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "1 tablespoon baking powder",
    "1 pinch salt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground ginger",
    "9 ounces pumpkin puree",
    "0.75 cup soy milk",
    "0.5 cup vegetable oil",
    "1 tablespoon agave nectar",
    "0.5 cup vegan chocolate chips",
    "1 cup unsweetened coconut cream",
    "1 teaspoon vanilla extract",
    "0.5 cup confectioners' sugar",
    "1 cup sweetened flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 12-cup muffin tins or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, salt, cinnamon, nutmeg, and ginger in a large bowl. In a second bowl, whisk together pumpkin puree, soy milk, oil, and agave nectar until evenly blended. Make a well in the flour mixture and pour in pumpkin mixture; stir just until batter is combined. Fold in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 3/4 full. Bake in the preheated oven until tops spring back when lightly pressed, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cream coconut cream, vanilla extract, and confectioners' sugar in a bowl until creamy. Refrigerate until use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cupcakes from the oven and cool in the tins for 5 minutes. Transfer to a wire rack to cool completely, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Frost cooled cupcakes with coconut cream frosting and sprinkle with a thick layer of coconut flakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
