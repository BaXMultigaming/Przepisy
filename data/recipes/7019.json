  "ingredients": [
    "0.5 cup applesauce",
    "0.25 cup margarine, softened",
    "0.5 cup white sugar",
    "0.5 cup light brown sugar",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon ground cinnamon",
    "1 cup semi-sweet chocolate chips",
    "2 tablespoons confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line muffin cups (2-1/2 inches in diameter) with paper bake cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large mixer bowl, beat butter, sugar, brown sugar, egg, and vanilla until well blended. Add applesauce, blend well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, stir together flour, cocoa, baking soda, and cinnamon, if desired. Add to butter mixture, blending well. Stir in chocolate chips. Fill muffin cups 3/4 full with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 22 to 26 minutes or until wooden pick inserted in center comes out almost clean. Cool slightly in pan on wire rack. Sprinkle muffin tops with confectioners' sugar, if desired. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
