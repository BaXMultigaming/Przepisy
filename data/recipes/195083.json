  "ingredients": [
    "1 pound flank steak, cut into bite-size pieces",
    "0.25 cup cornstarch",
    "2 teaspoons olive oil",
    "1 onion, thinly sliced",
    "1 tablespoon minced garlic",
    "3 large green onions, sliced diagonally into 1/2 inch pieces",
    "0.5 cup soy sauce",
    "0.5 cup water",
    "0.5 cup brown sugar",
    "0.5 teaspoon minced fresh ginger root",
    "0.5 cup hoisin sauce"
  ],
  "steps": [
    {
      "text": "Place flank steak and cornstarch into a resealable plastic bag. Shake the bag to evenly coat the flank steak with the cornstarch. Allow to steak rest for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium-high heat. Cook and stir steak until evenly browned, 2 to 4 minutes. Place onion, garlic, flank steak, green onions, soy sauce, water, brown sugar, ginger, and hoisin sauce in a slow cooker. Cook on Low setting for about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
