  "ingredients": [
    "0.5 cup crushed ice",
    "1 tablespoon cranberry sauce (see below)",
    "2 fluid ounces bourbon whiskey",
    "0.5 teaspoon brandy-based orange liqueur (such as Grand Marnier®)",
    "2 dashes aromatic bitters",
    "1 fluid ounce cold water"
  ],
  "steps": [
    {
      "text": "Muddle the crushed ice and cranberry sauce in a rocks glass until the ice has been tinged red. Pour in the whiskey, orange liqueur, bitters, and water. Stir and serve.",
