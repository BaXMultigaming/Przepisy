  "steps": [
    {
      "text": "Heat oil in a saucepan over medium heat. Add garlic; cook and stir until golden, about 1 minute. Mix in flour and cook until you have a thick paste, about 1 minute. Whisk chicken broth in slowly until mixture is smooth, about 2 minutes. Pour in milk and whisk until smooth.",
      "section": null,
      "name": null,
      "url": null,
