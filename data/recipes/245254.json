  "ingredients": [
    "1 tablespoon grapeseed oil",
    "1 tablespoon minced garlic",
    "1 tablespoon all-purpose flour",
    "1 cup chicken broth",
    "1 cup fat-free milk",
    "0.66666668653488 cup grated Parmesan cheese",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
