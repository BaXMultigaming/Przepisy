  "ingredients": [
    "12 ounces fresh or frozen cranberries",
    "0.75 cup white sugar",
    "1 (12 ounce) jar orange marmalade",
    "1 tablespoon lemon juice",
    "0.75 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Place cranberries in a shallow 1 1/2 quart baking dish. Sprinkle with sugar, cover with foil and bake for 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven and sprinkle with walnuts. Re-cover and bake for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven and stir in marmalade and lemon juice. Mix well. Cool to room temperature. Cover tightly and refrigerate at least 3 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
