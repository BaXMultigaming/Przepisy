  "ingredients": [
    "0.5 cup tomato juice",
    "2 eggs, beaten",
    "2 pounds lean ground beef",
    "0.75 cup soft bread crumbs",
    "2 tablespoons snipped fresh parsley",
    "1 clove garlic, minced",
    "0.5 teaspoon dried oregano, crushed",
    "0.25 teaspoon sea salt",
    "0.25 teaspoon ground black pepper",
    "1 (6 ounce) package thinly sliced ham",
    "1 (6 ounce) package sliced mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Combine tomato juice and beaten eggs in a large bowl; stir in ground beef, bread crumbs, parsley, garlic, oregano, salt, and black pepper. Mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape beef mixture into a 10x8-inch rectangle on a piece of aluminum foil or waxed paper. Arrange ham slices on top, leaving a small margin around edges. Tear cheese slices, reserving 1 slice; sprinkle torn cheese over ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully roll up beef mixture starting from one short end using the foil or waxed paper to lift and roll. Seal edges and ends of beef mixture. Place beef roll, seam-side down, in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven about 1 hour 15 minutes. Cut remaining 1 cheese slice into 4 triangles; place on top of roll, overlapping triangles. Bake until cheese melts, about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
