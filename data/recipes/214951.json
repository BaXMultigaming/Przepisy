  "ingredients": [
    "1 cup all-purpose flour",
    "1 tablespoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup skim milk",
    "7 tablespoons unsalted butter",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "1 cup white sugar",
    "1 cup flaked coconut",
    "10 tablespoons brown sugar",
    "0.25 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour one 8-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, 1 tablespoon butter, and vanilla extract in a small saucepan; bring to a boil over medium-high heat. Remove from heat; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a bowl with a hand mixer until light yellow; slowly beat in white sugar on high speed. Stir in flour mixture until only a few large lumps of flour remain. Stir in warm milk mixture, continue stirring until smooth; pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 25 to 30 minutes. Cool in the pans for 10 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 6 tablespoons butter, coconut, brown sugar, and cream in a bowl until evenly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread over cooled cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
