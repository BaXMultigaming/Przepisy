      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour Italian dressing and hot sauce over Brussels sprouts; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Marinate in the refrigerator, stirring occasionally, for 4 hours.",
