  "ingredients": [
    "2 pounds Alaskan king crab legs",
    "1 bunch fresh parsley, chopped",
    "0.5 cup lemon juice",
    "3 tablespoons olive oil",
    "1 (12 ounce) bottle beer (i.e. Newcastle Brown Ale®)",
    "1 onion, quartered",
    "0.5 cup water",
    "2 tablespoons minced garlic"
  ],
  "steps": [
    {
      "text": "Combine crab legs, parsley, lemon juice, and oil in a large bowl. Stir until crab legs are coated. Cover and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring beer, onion, water, and garlic to a rapid boil in a large pot. Place crab legs in a steamer basket and insert into the pot. Discard marinade. Cover and steam until crab is cooked through, 10 to 15 minutes.",
