  "ingredients": [
    "2 cups packed brown sugar",
    "1 cup butter",
    "4 eggs",
    "4 bananas",
    "1 cup sour cream",
    "4 cups sifted cake flour",
    "1 teaspoon baking soda",
    "0.125 teaspoon salt",
    "1 cup chopped walnuts",
    "2 teaspoons vanilla extract",
    "4 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease three (9-inch) round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together brown sugar and 1 cup butter in a large bowl until creamy and smooth. Add eggs one at a time, mixing well after each addition. Beat in mashed bananas and 1 cup sour cream. Stir in flour, baking soda, and salt until well combined. Mix in nuts and 2 teaspoons vanilla until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the centers of cakes comes out clean, 30 to 40 minutes. Allow cakes layers to cool completely on wired racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat confectioners' sugar, remaining 1/2 cup butter, and remaining 1/4 cup sour cream in a large bowl until well combined. Add remaining 1 teaspoon vanilla and beat until frosting is fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer cooled cake layers with frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
