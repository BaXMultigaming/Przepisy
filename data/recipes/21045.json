  "title": "Whipped Sweet Potato Casserole",
  "description": "This whipped sweet potato casserole makes sweet potatoes sweeter with orange juice, brown sugar, and nutmeg that is then topped with marshmallows.",
  "authors": [
    "Bea Gassman"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
