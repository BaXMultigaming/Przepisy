  "ingredients": [
    "2 pounds sweet potato, peeled and cubed",
    "2 tablespoons orange juice",
    "0.75 cup brown sugar",
    "0.125 teaspoon ground nutmeg",
    "2 tablespoons butter, cubed",
    "1 cup miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan cook sweet potatoes in salted water over medium-high heat for 20 minutes, or until done. Drain, and add orange juice, brown sugar, nutmeg, and butter. Whip until smooth. Spread into a medium size casserole dish and top with marshmallows.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for about 10 minutes, or until marshmallows are golden brown.",
      "section": null,
      "name": null,
      "url": null,
