      "image_sources": []
    },
    {
      "text": "Place the cinnamon, allspice and clove into a cheesecloth bag and tie shut. Add to the liquid and simmer 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove spice bag. Just before serving, add fruit juices. Serve steaming hot.",
