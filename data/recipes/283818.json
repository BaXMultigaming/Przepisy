  "ingredients": [
    "cooking spray",
    "1 cup all-purpose flour",
    "1 large egg",
    "2 cups dry bread crumbs",
    "0.25 cup grated Parmesan cheese",
    "2 tablespoons dried rosemary",
    "1 teaspoon ground paprika",
    "salt and ground black pepper to taste",
    "4 (5 ounce) pork loin chops",
    "1 tablespoon olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly oil a baking tray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put flour in a bowl. Beat egg in a second bowl. Mix bread crumbs, Parmesan, rosemary, paprika, salt, and pepper in a third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly salt pork chops. Coat both sides in flour, then in egg, then in bread crumb mixture. Place on the prepared baking tray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, about 20 minutes, turning after 10 minutes. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
