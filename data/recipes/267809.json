  "title": "Layered Oreo Mousse",
  "description": "Two kinds of chocolate create a rich mousse sandwiched between layers of whipped topping and spread over a cream cheese-Oreo crust.",
  "authors": [
    "andidrane93"
  ],
  "date_published": "2020-06-19T00:32:01-04:00",
