  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "2 (2.9 ounce) packages non-instant lemon pudding mix",
    "0.5 cup vegetable oil",
    "4 large eggs",
    "8 ounces sour cream",
    "0.5 cup milk",
    "6 tablespoons freshly squeezed lemon juice",
    "2.5 cups confectioners' sugar",
    "3 tablespoons freshly squeezed lemon juice, or more to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C). Grease 2 loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XS3AcEE5_OQ_LY595olZGpXPwVQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236779-Copycat-Starbucks-Lemon-Bread-Step1-4x3-2916-f7d74d32a3fd42c0a6804a200641659c.jpg"
      ],
      "image": "assets/images/236779/step_01.webp"
    },
    {
      "text": "Combine cake mix, pudding mix, oil, eggs, sour cream, milk, and 6 tablespoons lemon juice into bowl of stand mixer; beat for 2 minutes and pour into prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QGM2zoV1N-ClO_xRhx-v7ZLmUwA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236779-Copycat-Starbucks-Lemon-Bread-Step3-4x3-2931-3e547c5141a444559f85ee47520d41da.jpg"
      ],
      "image": "assets/images/236779/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 50 minutes. Cool in the pans for 20 minutes before removing from pans to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rt8PBY75Ki56ByvhKa0Qv7HxSO0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236779-Copycat-Starbucks-Lemon-Bread-Step4-4x3-2932-2791414ada624fe286ec3c9d681a37ec.jpg"
      ],
      "image": "assets/images/236779/step_03.webp"
    },
    {
      "text": "Whisk confectioners' sugar and 3 tablespoons lemon juice together in a bowl until smooth; spoon evenly over the loaves and let set before slicing, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o2y0Ql2RPhetVJSY0uhqALid24c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236779-Copycat-Starbucks-Lemon-Bread-ddmfs-4x3-2949-58760187461440c88f904cbf5ee81509.jpg"
      ],
      "image": "assets/images/236779/step_04.webp"
    }
