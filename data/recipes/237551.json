  "ingredients": [
    "2 tablespoons coconut oil",
    "0.75 cup unsweetened flaked coconut",
    "0.5 cup coconut flour",
    "sea salt to taste",
    "3 large eggs, beaten",
    "4 (4 ounce) fillets tilapia fillets, or more as needed"
  ],
  "steps": [
    {
      "text": "Heat coconut oil in a skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together unsweetened coconut, coconut flour, and salt on a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush beaten eggs over each tilapia fillet. Press each fillet into coconut mixture until evenly coated. Gently toss between your hands so any excess coconut can fall away. Place coated fillets onto a plate while breading the rest; do not stack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry fillets in hot coconut oil until golden brown and fish flakes easily with a fork, 5 to 7 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
