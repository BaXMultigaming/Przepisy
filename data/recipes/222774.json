  "ingredients": [
    "5 cups cubed whole wheat bread",
    "0.5 cup extra-virgin olive oil",
    "0.25 cup red wine vinegar",
    "0.25 cup lemon juice",
    "0.25 cup chopped fresh parsley",
    "0.5 teaspoon salt",
    "6 large tomatoes, cut in wedges",
    "1 large red onion, diced",
    "0.5 cup black olives",
    "0.5 cup fresh basil",
    "0.5 cup shaved Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spread bread cubes over a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake bread cubes in the preheated oven until lightly browned, about 15 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, vinegar, lemon juice, parsley, and salt in a large bowl. Fold in toasted bread, tomatoes, onion, olives, basil, and Parmesan cheese until vinegar dressing is evenly distributed.",
      "section": null,
