  "title": "Stabilized Whipped Cream",
  "description": "Stabilized whipped cream holds its shape better thanks to the addition of unflavored gelatin; perfect for decorating a dessert pie or frosting a cake.",
  "authors": [
    "ETHELMERTZ"
  ],
  "date_published": "1999-03-03T20:51:34-05:00",
  "date_modified": "2026-06-08T15:00:21-04:00",
  "prep_time": "PT10M",
  "cook_time": "PT0M",
  "total_time": "PT30M",
