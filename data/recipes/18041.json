  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "0.25 cup cold water",
    "1 teaspoon unflavored gelatin",
    "1 cup heavy whipping cream",
    "1 tablespoon white sugar",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s8zAhx6eMubNTDfMohplbLlwp5s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18041-Stabilized-Whipped-Cream-ddmfs-step-1-2c08bb01886c4d128beab8dc6ef6af83.jpg"
      ],
      "image": "assets/images/18041/step_01.webp"
    },
    {
      "text": "Chill mixing bowl and beaters for at least 15 minutes before using. Place water in a small microwave-safe bowl. Sprinkle gelatin over water and allow to soften 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6BEBkRmyo3FytDC1TRXBG6GL0ew=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18041-Stabilized-Whipped-Cream-ddmfs-step-2-791c28b180d44267b946bbf8cd885d3a.jpg"
      ],
      "image": "assets/images/18041/step_02.webp"
    },
    {
      "text": "Heat gelatin mixture in the microwave until gelatin is completely dissolved, about 30 to 45 seconds, stirring after every 15 seconds. Remove from microwave and let stand at room temperature for 5 to 10 minutes; gelatin must be liquid but not warm when added to cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DWUGZumKAtqxZeUHeX3xz5h1aWc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18041-Stabilized-Whipped-Cream-ddmfs-step-3-f287a79bb44f414db752fdfa5019e852.jpg"
      ],
      "image": "assets/images/18041/step_03.webp"
    },
    {
      "text": "Remove bowl and beaters from refrigerator and pour in cream, sugar, and vanilla extract. Beat together just until beater marks begin to show distinctly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dcrbocGh8bFJNSUETm4Y3358WyE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18041-Stabilized-Whipped-Cream-ddmfs-step-4-c32c88012b9e43afa9e7c7210646a1fe.jpg"
      ],
      "image": "assets/images/18041/step_04.webp"
    },
    {
      "text": "Add gelatin mixture to cream, pouring in a steady stream while beating constantly. Beat until stiff peaks form. Use immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6_bO5c_Dm4VAPFrQBI3iKVozzco=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18041-Stabilized-Whipped-Cream-ddmfs-step-5-e9686bb1b6254c24b5294dad513b8c3c.jpg"
      ],
      "image": "assets/images/18041/step_05.webp"
    }
  ],
