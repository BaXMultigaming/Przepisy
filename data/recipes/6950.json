  "title": "Sophie's Zucchini Bread",
  "description": "This zucchini bread recipe combines cinnamon and nuts for an extra dense loaf that is hard to stop eating.",
  "authors": [
    "Laura Stotko"
  ],
  "date_published": "1998-08-10T18:53:36-04:00",
