  "ingredients": [
    "3 cups all-purpose flour",
    "3 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "3 eggs",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "3 teaspoons vanilla extract",
    "3 cups grated zucchini",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, cinnamon, salt, baking soda, and baking powder. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl. Add sugar, oil, and vanilla; mix well. Stir in zucchini, then mix in flour mixture until well combined. Stir in nuts. Pour into 2 ungreased loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the centers of each loaf comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
