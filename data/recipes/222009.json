  "ingredients": [
    "3 cups salsa, divided",
    "1 (8 ounce) package cream cheese, softened",
    "4 stalks green onions, chopped, divided",
    "2.5 cups Cheddar cheese, divided",
    "2.5 cups shredded Monterey Jack cheese, divided",
    "12 (8 inch) flour tortillas"
  ],
  "steps": [
