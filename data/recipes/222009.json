      ],
      "image": "assets/images/222009/step_05.webp"
    },
    {
      "text": "Spread remaining 1 cup salsa over top of enchiladas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CGXf-iYPVUsBLz8sHlq0i6phxFA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222009-3CheeseEnchiladas-mfs-Step5-0155-d6c393df17c249f7a184d822109eff8a.jpg"
