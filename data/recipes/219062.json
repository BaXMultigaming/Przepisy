  "ingredients": [
    "2 pounds frozen boneless chicken breast",
    "10 ounces prepared pizza sauce",
    "1 cup salsa verde (such as Herdez®)",
    "0.5 cup sour cream",
    "6 kaiser rolls",
    "6 ounces shredded Cheddar cheese",
    "6 ounces sour cream",
    "12 dashes hot sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Combine the frozen boneless chicken breast, prepared pizza sauce, and salsa verde in a slow cooker. Cover the cooker, and cook on Low 8 to 10 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use 2 forks to pull the chicken meat apart until completely shredded. Stir 1/2 cup sour cream into the chicken mixture. Place the chicken mixture onto the rolls. Top each sandwich with 1 ounce shredded Cheddar cheese, 1 ounce sour cream, and 2 dashes hot sauce to serve",
