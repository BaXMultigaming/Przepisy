  "ingredients": [
    "0.66666668653488 cup milk",
    "3 eggs at room temperature",
    "0.5 cup all-purpose flour, packed",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon salt",
    "0.25 teaspoon vanilla extract",
    "0.25 teaspoon ground cloves",
    "0.125 teaspoon freshly ground nutmeg",
    "3 tablespoons clarified butter",
    "1 tablespoon confectioners' sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Preheat a cast iron skillet over high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend milk, eggs, flour, cinnamon, ginger, allspice, salt, vanilla extract, cloves, and nutmeg together in a blender until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt clarified butter in the preheated skillet; pour in batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on the middle rack of the preheated oven until golden brown and puffed up to your liking, 20 to 25 minutes. Dust with powdered sugar.",
      "section": null,
      "name": null,
      "url": null,
