  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 cup butter, room temperature",
    "0.75 cup packed brown sugar",
    "0.75 cup white sugar",
    "1 teaspoon vanilla extract",
    "2 large eggs",
    "8 (1.5 ounce) bars milk chocolate candy bar (such as Hershey's®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Butter a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, salt, and baking soda together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, white sugar, and vanilla in a separate bowl with an electric mixer. Beat in eggs, one at a time. Gradually mix in flour mixture. Spread 1/2 of the dough into the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until partially firm, about 10 minutes. Leave oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the partially baked dough with chocolate bars, breaking up as needed to fit. Drop remaining dough over the chocolate as evenly as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake until golden brown, 10 to 15 minutes more. Let cool before cutting into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
