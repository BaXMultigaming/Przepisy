  "ingredients": [
    "1 cup ketchup",
    "0.25 cup white vinegar",
    "0.5 cup brown sugar",
    "2 tablespoons chopped onion",
    "2 teaspoons lemon juice",
    "1 teaspoon Worcestershire sauce",
    "0.25 teaspoon black pepper",
    "0.125 teaspoon ground allspice",
    "1 pinch celery salt",
    "1 pinch mustard powder"
