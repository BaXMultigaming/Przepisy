  "steps": [
    {
      "text": "Cut the crust off of the bread and cut each slice of bread into 3 pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, 1/4 cup of sugar, 4 teaspoons cinnamon, and vanilla extract in a bowl. Dip bread in the egg mixture until it is soaked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place about 6 sticks at a time into a greased skillet set over medium heat. Cook until golden and cooked though, 2 to 3 minutes per side. Continue until all sticks are cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix remaining 1/4 cup sugar and 2 teaspoons cinnamon together in a separate bowl. Transfer each stick into the mixture and turn until fully coated. Place on a platter and serve.",
