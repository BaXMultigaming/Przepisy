  "ingredients": [
    "4 (4 ounce) fillets tilapia",
    "0.25 cup fresh lemon juice",
    "2.5 teaspoons ground coriander",
    "1.5 teaspoons dried parsley",
    "1 roma (plum) tomato, diced"
  ],
  "steps": [
    {
      "text": "Place the tilapia, lemon juice, coriander, and parsley in a bowl; toss until fillets are evenly coated. Refrigerate at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange the fillets in the bottom of the prepared baking dish; top each with tomato. Drizzle remaining marinade over the fillets. Cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 15 minutes. Remove foil and bake uncovered another 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
