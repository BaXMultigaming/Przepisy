  "ingredients": [
    "2.5 pounds cut up chicken pieces",
    "3 tablespoons olive oil",
    "3 tablespoons curry powder",
    "1 (12 ounce) jar chutney",
    "1 red bell pepper, thinly sliced",
    "1 lime, cut into wedges",
    "0.125 cup chopped green onion for topping",
    "0.25 cup chopped peanuts"
  ],
  "steps": [
    {
      "text": "Rinse chicken and pat dry. In a large skillet heat oil until almost hot. Add chicken, skin side down. Brown chicken until lightly browned on both sides. Add curry powder, chutney and red bell pepper. Simmer 30 minutes over medium low heat. Top chicken with lime wedges, chopped scallions and peanuts. Serve immediately.",
