  "ingredients": [
    "0.25 cup white vinegar",
    "0.25 teaspoon black pepper",
    "0.5 teaspoon red pepper flakes",
    "1 teaspoon vegetable oil",
    "2 tablespoons sesame seeds",
    "1 cucumber, thinly sliced",
    "0.5 green onion, sliced",
    "0.5 carrot, julienned"
