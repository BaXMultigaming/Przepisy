  "ingredients": [
    "0.5 pound bacon, cut in half",
    "1 (8 ounce) can water chestnuts",
    "0.75 cup ketchup",
    "0.5 cup packed brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap 1/2 strip of bacon around each water chestnut. Combine ketchup and sugar in a small bowl and mix together; dip each wrapped water chestnut into this mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place water chestnuts in a lightly greased 9x13 inch baking dish and bake covered in the preheated oven for 20 minutes, or until bacon is crisp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
