  "ingredients": [
    "1 (9 inch) unbaked pie crust",
    "1 (10 ounce) package frozen chopped spinach",
    "1 cup plain yogurt",
    "2 eggs",
    "1 tablespoon all-purpose flour",
    "0.25 teaspoon black pepper",
    "4.5 ounces fresh mushrooms, thinly sliced",
    "4 ounces shredded Cheddar cheese",
    "0.25 cup chopped green onions"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Prick pie crust all over with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place spinach in a microwave-safe bowl; microwave until thawed. Drain as much liquid as possible; then dry spinach with paper towels until as dry as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat yogurt, eggs, flour, and black pepper together in a bowl until combined; stir in spinach. Layer sliced mushrooms, Cheddar cheese, and chopped scallions, in that order, into pie crust; top with spinach mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Decrease oven temperature to 350 degrees F (175 degrees C); continue baking 30 minutes more. Cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
