  "ingredients": [
    "0.5 (750 milliliter) bottle champagne",
    "1 cup orange juice",
    "1 cup white sugar",
    "4 slices orange",
    "4 whole cloves",
    "1 teaspoon vanilla extract",
    "4 pears, peeled with stems intact",
    "0.66666668653488 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "In a saucepan over medium heat, combine champagne, orange juice and sugar. Add orange slices, cloves and vanilla. Bring to a boil, and stir until sugar is dissolved. Place pears in saucepan, and reduce heat. Cover, and simmer 15 minutes. Remove cover, and simmer an additional 30 minutes. Remove pears from the liquid, and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat chocolate in a bowl over hot water, stirring until melted. Pour chocolate over the pears, and serve.",
