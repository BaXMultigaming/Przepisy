  "ingredients": [
    "0.5 cup apple cider vinegar",
    "2 tablespoons water",
    "2 tablespoons soy sauce",
    "1 tablespoon brown sugar",
    "1 teaspoon mustard powder",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon ground cinnamon",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine apple cider vinegar, water, soy sauce, brown sugar, mustard powder, onion powder, garlic powder, ground cinnamon, and black pepper together in a saucepan over medium heat. Bring to a boil, then reduce heat and simmer until fragrant, about 45 seconds.",
