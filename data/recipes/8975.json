  "ingredients": [
    "1 egg, beaten",
    "2 ounces dry bread crumbs",
    "2 skinless, boneless chicken breast halves",
    "0.75 (16 ounce) jar spaghetti sauce",
    "2 ounces shredded mozzarella cheese",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a medium baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i-vnB4YttUfU9mof4HgPd1JowLo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8975-chicken-parmigiana-ddmfs-4358-4x3-step-01-2217d2780fde4d0dbdbc4fa2b349c6ca.jpg"
      ],
      "image": "assets/images/8975/step_01.webp"
    },
    {
      "text": "Pour egg into a small shallow bowl. Place bread crumbs in a separate shallow bowl. Dip chicken into egg, then into bread crumbs. Place coated chicken on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ebT-npx8P8iB1Vthd7TJ9u8eM1c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8975-chicken-parmigiana-ddmfs-4363-4x3-step-02-4ba40f388af7457792ae7521b549dd38.jpg"
      ],
      "image": "assets/images/8975/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until no longer pink and juices run clear, about 40 minutes. Remove from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/18Lt4SNr0TkG-RzGEPd1C0rByvo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8975-chicken-parmigiana-ddmfs-4407-4x3-step-03-6c484c8e6bb24f6ea174e7c3cb067227.jpg"
      ],
      "image": "assets/images/8975/step_03.webp"
    },
    {
      "text": "Pour 1/2 of the spaghetti sauce into a 7x11-inch baking dish. Place chicken breasts over the sauce, then cover with remaining sauce. Sprinkle mozzarella and Parmesan cheeses on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xU-pHP6pIoLdJ_f0GL2kAlnA7ao=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8975-chicken-parmigiana-ddmfs-4409-4x3-step-04-842af617e5d74e0d960cdd2f5ea49c2a.jpg"
      ],
      "image": "assets/images/8975/step_04.webp"
    },
    {
      "text": "Continue baking until heated through and cheeses have melted, about 20 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Dkn0r3qChuuvVdIXpTJyU0waXo4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8975-chicken-parmigiana-ddmfs-4421-4x3-step-05-be18a4e3f7b74b3088c3c60b8646ba8c.jpg"
      ],
      "image": "assets/images/8975/step_05.webp"
    }
