  "ingredients": [
    "0.5 cup mayonnaise",
    "0.25 cup ketchup",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon Worcestershire sauce",
    "0.5 teaspoon freshly ground black pepper, or more to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
