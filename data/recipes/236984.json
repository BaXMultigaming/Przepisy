    {
      "text": "Whisk mayonnaise, ketchup, and garlic powder together in a bowl. Add Worcestershire sauce to the mayonnaise mixture and whisk until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PaDqE_0H2z6UJSvJlJdgLdCJvik=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236984-zaxbys-chicken-fingers-dipping-sauce-ddmfs-step2-0738-4x3-ee3d7d62ba0d4cd49b0b76daccf5fcf9.jpg"
      ],
      "image": "assets/images/236984/step_02.webp"
    },
    {
      "text": "Sprinkle enough pepper over the surface of the mayonnaise mixture to cover; stir to incorporate. Repeat sprinkling and stirring of pepper once more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ADC6Pa-dxWnP2JSuiEEgU8ah7rg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236984-zaxbys-chicken-fingers-dipping-sauce-ddmfs-step4-0740-4x3-275c8bb6ca734b79b7dc2fe2c4067313.jpg"
      ],
      "image": "assets/images/236984/step_03.webp"
