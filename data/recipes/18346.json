  "ingredients": [
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "1.25 cups milk, or more as needed",
    "0.5 teaspoon ground black pepper",
    "6 large potatoes, peeled and sliced",
    "1 medium onion, diced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk condensed soup, milk, and pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer potatoes and onion in the prepared casserole dish. Pour soup mixture over top; it should almost cover potatoes and onion. If it doesn’t, add more milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake in the preheated 375 degrees F (190 degrees C) oven until potatoes are tender, about 1 hour, stirring halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
