      ],
      "image": "assets/images/232930/step_02.webp"
    },
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with parchment paper or a silicone mat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Italian cheese blend, parsley, egg, garlic, salt, and pepper into cauliflower until evenly incorporated.",
