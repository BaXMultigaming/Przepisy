  "ingredients": [
    "0.5 head cauliflower, coarsely chopped",
    "0.5 cup shredded Italian cheese blend",
    "0.25 cup chopped fresh parsley",
    "1 large egg",
    "1 teaspoon chopped garlic",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place cauliflower pieces through the feeding tube of the food processor using the grating blade; pulse until all the cauliflower is shredded.",
      "section": null,
      "name": null,
      "url": null,
