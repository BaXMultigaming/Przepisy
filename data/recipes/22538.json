  "ingredients": [
    "4 (4 ounce) fillets salmon",
    "3 tablespoons prepared Dijon-style mustard",
    "salt and ground black pepper to taste",
    "0.25 cup Italian-style dry bread crumbs",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line a shallow baking pan with aluminum foil.",
