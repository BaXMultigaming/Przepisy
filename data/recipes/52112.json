  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup mayonnaise",
    "1 (.7 ounce) package dry Italian salad dressing mix",
    "2 loaves French bread, cut into 1 inch slices",
    "2 medium cucumbers, sliced",
    "1 pinch dried dill weed"
