  "title": "Contadina® Garden Vegetable Pasta Bake",
  "description": "Carrots, red and green bell peppers, mushrooms and mozzarella are baked with spicy sliced sausage and pasta in a rich tomato base.",
  "authors": [
    "Contadina"
  ],
