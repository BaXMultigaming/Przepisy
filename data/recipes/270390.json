  "ingredients": [
    "cooking spray",
    "32 ounces vanilla-flavored almond milk",
    "1.5 cups water",
    "1 (15 ounce) can pumpkin puree",
    "2 tablespoons pure maple syrup",
    "1 tablespoon ground cinnamon",
    "0.5 teaspoon salt",
    "2 cups steel-cut oats",
    "1 cup dried cranberries",
    "2 tablespoons unsalted butter",
    "1.5 cups diced apple, or more to taste",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Lightly spray a slow cooker with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the almond milk, water, pumpkin puree, maple syrup, cinnamon, and salt in the slow cooker. Whisk to combine thoroughly. Add oats, dried cranberries, and butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set your slow cooker to Low and cook for 3 1/2 hours. Stir in diced apples and pecans. Continue cooking on Low for 2 more hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
