  "ingredients": [
    "6 medium zucchini",
    "0.25 medium onion, chopped",
    "0.125 cup green olives, diced",
    "0.125 cup crumbled feta cheese",
    "2 cloves garlic, chopped",
    "2 tablespoons pine nuts",
    "0.5 cup grated Asiago cheese, divided",
    "1 teaspoon dried basil",
    "1 teaspoon dried oregano"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Trim ends from zucchini and cut each squash in half lengthwise. Scrape out centers of squash and place in a mixing bowl. Add onion, olives, feta cheese, garlic, pine nuts, 1/2 the Asiago cheese, basil, and oregano and mix well. Place mixture back into zucchini shells. Top each with a small amount of Asiago cheese and place zucchini boats on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook under the preheated broiler until cheese browns, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
