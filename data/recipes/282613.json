  "title": "Wild Mushroom Stew",
  "description": "Use a combination of your favorite mushrooms in this easy stew recipe for two that starts out in a wok and finishes up in the oven.",
  "authors": [
    "Tao,RN"
  ],
  "date_published": "2010-04-19T22:36:39-04:00",
