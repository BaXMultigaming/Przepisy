  "ingredients": [
    "1 (9 inch) pie crust, baked",
    "1.25 cups white sugar",
    "2 tablespoons all-purpose flour",
    "2 tablespoons cornstarch",
    "0.25 teaspoon salt",
    "1.5 cups milk",
    "4 egg yolks",
    "2 (1 ounce) squares unsweetened chocolate, chopped",
    "1 tablespoon butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "In medium saucepan, combine sugar, flour, cornstarch and salt and whisk to combine. In a medium bowl, whisk milk and egg yolks until smooth. Gradually stir into sugar mixture. Cook over medium heat, stirring constantly, until mixture thickens and comes to a full boil. Boil and stir for one minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and stir in chocolate, butter, and vanilla. Stir until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into pie shell. Place plastic wrap over filling to prevent skin from forming and chill for several hours. Top with meringue or whipped cream and chocolate curls if so desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
