  "ingredients": [
    "1 (16 ounce) package mostaccioli",
    "1 cup heavy cream",
    "0.5 cup butter",
    "1 cup chopped fresh parsley",
    "0.5 cup grated Parmesan cheese",
    "1 teaspoon salt",
    "0.25 teaspoon freshly ground black pepper",
    "0.125 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook mostaccioli in the boiling water until tender yet firm to the bite, 8 to 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat heavy cream and butter in a Dutch oven or large, heavy saucepan over medium heat until butter melts, stirring occasionally; be careful not to bring to a boil. Stir in parsley, Parmesan cheese, salt, black pepper, and garlic powder; toss with mostaccioli. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
