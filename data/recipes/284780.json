  "ingredients": [
    "nonstick cooking spray",
    "2 cups milk",
    "8 large eggs",
    "0.5 teaspoon salt",
    "8 cups cubed bread",
    "4 ounces diced country ham",
    "1.5 cups shredded Cheddar cheese, divided",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 2-quart baking dish with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, eggs, milk, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place about 3/4 of the bread cubes into the prepared baking dish and sprinkle with ham and 1 cup Cheddar cheese. Carefully pour egg mixture over top. Add remaining bread cubes and gently press all over to submerge into the liquid. Once all of the bread is coated by the egg mixture, sprinkle remaining Cheddar cheese over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden brown and set in the middle, about 40 minutes. Allow to cool for 10 minutes before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
