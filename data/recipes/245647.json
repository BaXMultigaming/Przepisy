  "ingredients": [
    "1 cup white sugar",
    "0.5 cup water",
    "0.75 cup heavy whipping cream",
    "3 tablespoons unsalted butter",
    "1 teaspoon sea salt (such as Maldon®)"
  ],
  "steps": [
    {
      "text": "Pour sugar and water into a small saucepan; swirl gently to combine. Heat over medium-low heat until little bubbles form on the side. Increase heat to high and boil until sugar turns amber, 5 to 8 minutes. Remove from heat and carefully whisk in heavy cream. Add butter and salt, stirring to combine. Pour caramel into a glass container; let cool.",
