  "ingredients": [
    "1.5 cups cooked quinoa",
    "1.5 cups pureed peaches",
    "1 cup shredded coconut",
    "0.75 cup almond butter",
    "0.5 cup dark brown sugar",
    "0.25 cup pureed cooked spinach",
    "1.5 teaspoons vanilla extract",
    "2 cups rolled oats",
    "1 cup all-purpose flour",
    "0.5 cup dry milk powder",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.75 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix quinoa, peaches, coconut, almond butter, brown sugar, spinach, and vanilla extract together in a large bowl until well combined. Add oats and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, milk powder, cinnamon, baking soda, baking powder, and salt together in a small bowl. Add the flour mixture to the quinoa mixture. Mix until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop mixture by large spoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated for 15 to 18 minutes. Allow to set for 2 minutes on the baking sheet before transferring cookies to wire racks to continue cooling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
