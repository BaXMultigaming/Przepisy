  "ingredients": [
    "3 tablespoons olive oil",
    "3 tablespoons balsamic vinegar",
    "3 tablespoons mayonnaise",
    "2 tablespoons water",
    "2 cloves garlic, pressed",
    "1 teaspoon Dijon mustard",
    "1 teaspoon brown sugar",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place olive oil, balsamic vinegar, mayonnaise, water, garlic, Dijon mustard, and brown sugar into a blender; blend until the salad dressing is smooth and emulsified, 10 to 15 seconds. Season with salt and black pepper.",
