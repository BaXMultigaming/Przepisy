  "ingredients": [
    "3 thick-cut peppered bacon, cut into 1/2-inch pieces",
    "1 medium chopped Honeycrisp apple",
    "1 teaspoon minced garlic",
    "8 cups torn kale leaves",
    "1 tablespoon cider vinegar",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium heat. Add bacon to hot skillet; cook until crisp and fat is rendered, about 3 minutes. Drain all but 1 tablespoon bacon drippings from skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add apple and cook, stirring occasionally, until tender, about 2 minutes. Stir in garlic and gradually add kale. Cook until tender, stirring occasionally, about 8 minutes. Drizzle with vinegar. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
