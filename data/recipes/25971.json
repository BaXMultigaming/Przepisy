  "ingredients": [
    "2.5 cups all-purpose flour",
    "4 teaspoons baking powder",
    "4 teaspoons ground ginger",
    "1.5 teaspoons ground cinnamon",
    "0.5 teaspoon salt",
    "1 cup butter",
    "1.25 cups packed brown sugar",
    "4 eggs",
    "0.25 cup grated fresh ginger root",
    "1 teaspoon vanilla extract",
    "1 cup milk",
    "2 tablespoons confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9-inch fluted tube pan, such as Bundt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking powder, ground ginger, cinnamon, and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together butter and brown sugar until light and fluffy. Beat in eggs one at a time, then stir in grated ginger root and vanilla. Beat in flour mixture alternately with milk, mixing just until incorporated. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 to 50 minutes, or until a toothpick inserted into the center of the cake comes out clean. Let cool in pan for 10 minutes, then turn out onto a serving plate. Dust lightly with confectioners' sugar before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
