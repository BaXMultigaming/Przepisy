  "ingredients": [
    "1 pound ground beef",
    "1 (1 ounce) packet taco seasoning",
    "5 slices pepper Jack cheese",
    "5 hamburger buns, split",
    "0.25 cup sour cream, or to taste",
    "0.25 cup salsa, or to taste",
    "1 cup chopped fresh cilantro",
    "1 tomato, sliced",
    "1 avocado, sliced",
    "0.5 onion, sliced"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef and taco seasoning together in a bowl with your hands. Separate mixture into 5 equal portions. Form into patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook patties on the preheated grill for 5 minutes. Flip, top with pepper Jack cheese slices, and continue to grill until no longer pink or to desired doneness, about 5 minutes more. An instant-read thermometer inserted into the center of a patty should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread sour cream and salsa on buns. Add patties; top with cilantro, tomato, avocado, and onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
