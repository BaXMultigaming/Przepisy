  "ingredients": [
    "1 (9 ounce) package dried udon noodles",
    "0.5 cup chicken broth",
    "3 tablespoons soy sauce",
    "3 tablespoons peanut butter",
    "3 cloves garlic, minced",
    "2 teaspoons chili oil",
    "1.5 tablespoons minced fresh ginger root",
    "1.5 tablespoons honey",
    "1 whole rotisserie chicken, skinned and boned, meat pulled into large chunks",
    "1 red bell pepper, thinly sliced",
    "0.25 cup green onions, chopped",
    "0.25 cup chopped peanuts",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Bring a large pot with lightly salted water to a boil. Cook udon in boiling water, stirring occasionally, until noodles are tender yet firm to the bite, 10 to 12 minutes. Drain; return to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk chicken broth, soy sauce, peanut butter, garlic, chili oil, ginger, and honey together in a saucepan over medium-high heat; bring to a boil, whisking until peanut butter melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sauce over noodles; stir in chicken and bell pepper and toss until noodles are evenly coated in sauce. Sprinkle with green onions, chopped peanuts, and cilantro; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
