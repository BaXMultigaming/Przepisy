  "title": "Baked Turkey Riggies",
  "description": "This delicious turkey casserole is a perfect way to use up Thanksgiving turkey leftovers.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-11-22T09:00:00-05:00",
  "date_modified": "2024-11-20T14:17:34-05:00",
  "prep_time": "PT15M",
