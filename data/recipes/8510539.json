    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1.5 pounds cooked, chopped turkey meat",
    "0.5 cup chopped pepperoncini peppers",
    "0.5 cup chopped, pitted kalamata olives",
    "1 tablespoon olive oil, or as needed",
    "6 ounces hot Italian sausage, casings removed",
    "1 cup diced onion",
    "1 cup sliced button mushrooms",
    "salt to taste",
    "0.5 cup white wine",
    "2 cups chicken broth",
    "1 (28 ounce) jar prepared marinara sauce",
    "1 cup water",
    "0.5 cup heavy cream",
    "1 pound rigatoni pasta, cooked and drained",
    "8 ounces fresh mozzarella cheese, cubed",
    "0.5 cup grated Parmigiano-Reggiano cheese",
    "chopped Italian flat leaf parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OqxuMmkcRIoXNZZ99kfZgrWdsOg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8510539-baked-turkey-riggies-step-01-31806bedf7a14b2ab6646e5802063558.jpg"
      ],
      "image": "assets/images/8510539/step_01.webp"
    },
    {
      "text": "Chop leftover turkey and place in a mixing bowl. Add pepperoncini peppers and kalamata olives; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/94K1CwOgJLb9c8XQYA9f6T46DYI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8510539-baked-turkey-riggies-step-02-2c633022436f4462bf15541ff4b5e82d.jpg"
      ],
      "image": "assets/images/8510539/step_02.webp"
    },
    {
      "text": "Heat olive oil in a large pot over medium-high heat. Add Italian sausage and cook until sausage is browned and crumbled, breaking it up into small pieces, about 5 minutes. Add diced onions, mushrooms, and salt. Cook until onions are soft and start to get translucent, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AVPW97je2jui7jZ7wjBHspyfGdM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8510539-baked-turkey-riggies-step-03-deadf041116142f0a5aad885c99d8bc7.jpg"
      ],
      "image": "assets/images/8510539/step_03.webp"
    },
    {
      "text": "Deglaze the bottom of the pot with white wine and simmer until wine has evaporated, about 5 minutes. Add chicken broth, marinara sauce, water, and cream. Add turkey mixture and bring to a simmer. Reduce heat to medium low and simmer about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VE23KH1kMNd5q4QKX-0SHljf5Mg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8510539-baked-turkey-riggies-step-04-dda8a9878d694df9bc4ed83b7079fc15.jpg"
      ],
      "image": "assets/images/8510539/step_04.webp"
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook rigatoni in the boiling water, stirring occasionally, about 10 minutes. Drain. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PVouDjODbSo4betrQRxrGouS5iY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8510539-baked-turkey-riggies-step-05-a7f6205b477d4599ac2926638f804c11.jpg"
      ],
      "image": "assets/images/8510539/step_05.webp"
    },
    {
      "text": "Transfer the cooked rigatoni into the sauce pot and mix well. Transfer mixture to a large casserole dish. Dot surface with mozzarella cheese and push inside the pasta mixture. Sprinkle the top with freshly grated Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mN7sU9puKpi_UqtnMJMCBc79jdI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8510539-baked-turkey-riggies-step-06-93237a0d8a4747ceb7c2b456291768b8.jpg"
      ],
      "image": "assets/images/8510539/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until sauce is bubbling around the edges, and the top is nicely browned, 40 to 45 minutes. Remove from oven and let sit for 10 to 15 minutes. Sprinkle with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GXV9qFNR20Sy6rBt-6TRKswE77w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8510539-baked-turkey-riggies-step-07-820ae6c35e3943c4868dbab6badeaa14.jpg"
      ],
      "image": "assets/images/8510539/step_07.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KH8QPJ9k0xH-wHeA3MxbHY3TQxg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8510539-baked-turkey-riggies-hero-03-4x3-ea8cc3c86cdb435e808d99e08d06c631.jpg"
      ],
      "image": "assets/images/8510539/step_08.webp"
    }
  ],
