  "ingredients": [
    "8 ounces mini pretzels",
    "1 cup butter",
    "1 cup light brown sugar",
    "2 cups milk chocolate chips",
    "sea salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line an 11x17-inch baking sheet with aluminum foil or parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pretzels onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and brown sugar in a saucepan over medium-low heat; cook and stir until sugar is dissolved and mixture is thickened, 5 to 8 minutes. Pour mixture over pretzels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 minutes. Sprinkle chocolate chips over pretzel mixture. Bake for 1 minute more. Stir mixture to evenly spread chocolate over pretzels. Lightly sprinkle salt over pretzels. Cool until set, 2 to 3 hours. Break into pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
