  "ingredients": [
    "1 cup shortening",
    "1 cup white sugar",
    "2 eggs",
    "2 cups cake flour",
    "0.5 teaspoon baking powder",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon vanilla extract",
    "1 cup evaporated milk",
    "1 cup mashed bananas",
    "0.33333334326744 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (175 degrees C). Grease one 9 or 10 inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream shortening until light and fluffy. Add sugar gradually. Blend in eggs one at a time, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking powder, baking soda and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add vanilla to the evaporated milk. Alternately add flour mixture and liquid ingredients to cream mixture. Blend in mashed bananas and chopped nuts. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
