  "ingredients": [
    "1.5 cups white sugar",
    "2 eggs",
    "2 cups fruit cocktail",
    "2 teaspoons baking soda",
    "2 cups all-purpose flour",
    "0.25 cup packed brown sugar",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
