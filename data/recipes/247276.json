  "title": "Smoked Chicken Hot Wings",
  "description": "Dry-rubbed smoked hot wings are coated with a buttery hot sauce and grilled until crispy outside and juicy inside for a delicious party appetizer.",
  "authors": [
    "Twayminator"
  ],
  "date_published": "2018-06-27T09:03:00-04:00",
