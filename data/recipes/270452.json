  "ingredients": [
    "cooking spray",
    "1.25 pounds ground turkey",
    "2 eggs, divided",
    "1.25 cups whole wheat bread crumbs, divided",
    "3 scallions, finely chopped",
    "3 tablespoons finely chopped parsley",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon freshly ground black pepper",
    "2 dashes hot sauce",
    "0.25 cup all-purpose flour, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine turkey, 1 egg, 1/4 cup bread crumbs, scallions, parsley, garlic powder, salt, and black pepper in a bowl. Form mixture into 6 patties using a 1/3 cup measuring cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat remaining egg and hot sauce together in a bowl. Pour remaining bread crumbs into another bowl. Pour flour into a third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat patties with flour, egg mixture, and bread crumbs — in that order. Place on the prepared baking sheet. Lightly spray patties with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crisp, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
