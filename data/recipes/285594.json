  "ingredients": [
    "12 ounces Yukon Gold potatoes, peeled and cubed",
    "2 tablespoons butter, divided",
    "1 clove garlic, minced",
    "0.25 cup milk",
    "2 tablespoons crumbled feta cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Add potatoes, reduce heat, and simmer until tender, 15 to 20 minutes. Drain in a colander.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 1 tablespoon butter to the same pot over medium-low heat. Add garlic and saute until golden, 1 to 2 minutes. Pour in milk and return potatoes to the pot. Add feta cheese and remaining butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash potatoes using a potato masher or electric mixer. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
