  "ingredients": [
    "1 tablespoon Greek seasoning",
    "1 teaspoon grated lemon zest",
    "salt and ground black pepper to taste",
    "2 large potatoes, cut into wedges",
    "2 tablespoons olive oil",
    "2 ounces feta cheese, crumbled",
    "2 tablespoons chopped fresh mint"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EgHjvP3xFkFu3o-0SqXYx0d57ms=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242451-baked-greek-fries-VAT-005-step-01-6b85f65694bc40db9b89481a9b2d85c2.jpg"
      ],
      "image": "assets/images/242451/step_01.webp"
    },
    {
      "text": "Mix Greek seasoning, lemon zest, salt, and pepper together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DFJMgyV6T5Onl98Al95_ToLygZY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242451-baked-greek-fries-VAT-006-step-02-b43a41083d774c049ee8f8df35110790.jpg"
      ],
      "image": "assets/images/242451/step_02.webp"
    },
    {
      "text": "Spread potatoes into a single layer on a baking sheet; drizzle with oil and stir until coated. Sprinkle seasoning mixture evenly over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TVwQ2xeu45MKQQXuU8U9BkMfj24=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242451-baked-greek-fries-VAT-007-step-03-a4b10410efa14996a64ab1860944834c.jpg"
      ],
      "image": "assets/images/242451/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until tender when pierced with a fork, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
