  "ingredients": [
    "2.5 cups rolled oats",
    "0.75 cup vegan dark chocolate chips",
    "0.5 cup all-purpose flour",
    "0.5 cup agave nectar",
    "0.5 cup chopped dried cherries",
    "0.33333334326744 cup applesauce",
    "0.25 cup sliced almonds",
    "0.25 cup shredded coconut",
    "0.25 cup sunflower seeds",
    "2 tablespoons packed brown sugar",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Lightly grease a 7x11 1/2-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, chocolate chips, flour, agave nectar, cherries, applesauce, almonds, coconut, sunflower seeds, brown sugar, baking soda, and vanilla extract together in a large mixing bowl. Lightly press mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 18 to 20 minutes. Cool for 10 minutes before cutting into bars. Let bars cool completely before removing from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
