  "ingredients": [
    "2 cups whole wheat flour",
    "0.75 cup all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons pumpkin pie spice",
    "1 teaspoon cinnamon",
    "1 teaspoon salt",
    "1 (15 ounce) can pumpkin puree",
    "3 egg whites",
    "1 egg",
    "1 cup white sugar",
    "0.5 cup brown sugar",
    "0.33333334326744 cup olive oil",
    "2 teaspoons vanilla extract",
    "0.25 cup packed brown sugar",
    "2 tablespoons butter, diced",
    "2 tablespoons oats",
    "0.25 cup chopped walnuts",
    "2 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 12-cup muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together whole wheat flour, all-purpose flour, baking powder, pumpkin pie spice, cinnamon, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin puree, egg whites, and egg in a large bowl; beat with an electric mixer until combined. Mix in white sugar, brown sugar, olive oil, and vanilla extract. Slowly add flour mixture to the pumpkin mixture, stirring until just combined. Fill the prepared muffin cups a little more than 1/2 full with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, diced butter, oats, walnuts, and flour for the streusel in a small bowl. Use a fork or your hands to combine until mixture resembles rough crumbs. Divide crumbs evenly amongst the muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
