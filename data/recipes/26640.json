  "ingredients": [
    "1 (10.75 ounce) can condensed tomato soup",
    "0.5 cup water",
    "1.5 pounds ground beef",
    "1 cup uncooked instant rice",
    "1 tablespoon minced onion",
    "1 teaspoon salt",
    "1 dash ground black pepper"
  ],
  "steps": [
    {
      "text": "Combine tomato soup and water in a medium mixing bowl; mix thoroughly and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, instant rice, onion, salt, pepper and 1/2 cup of the soup mixture in a large mixing bowl; mix thoroughly and shape into 1-inch balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place meatballs in a large skillet over medium heat. Pour in remaining soup mixture and bring to a boil. Simmer for 15 to 20 minutes or until meatballs are thoroughly browned and rice is cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
