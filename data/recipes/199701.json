  "ingredients": [
    "2 cups heavy whipping cream",
    "1 cup milk",
    "0.75 cup white cake mix, sifted",
    "0.5 cup white sugar",
    "2 large egg yolks, beaten",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pyqxAPOp9-khUi2aaxuY5dfogfA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/199701-cake-batter-ice-cream-VAT-005-step-01-61853ca773534ef59d6ec0d64d4459ff.jpg"
      ],
      "image": "assets/images/199701/step_01.webp"
    },
    {
      "text": "Whisk cream, milk, cake mix, sugar, egg yolks, and vanilla together in a saucepan until well blended. Cook, stirring frequently, over medium-low heat until mixture reaches 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7fr4hE_b1sYd8KXG0pt9Sf1UlM0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/199701-cake-batter-ice-cream-VAT-006-step-02-a03595f344d24e1cbbd0a9ad0f79cce6.jpg"
      ],
      "image": "assets/images/199701/step_02.webp"
    },
    {
      "text": "Pour into a heat-proof container and place in the refrigerator or freezer until chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uo5dNY-er8zgX6Tga9n4PvSQ44Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/199701-cake-batter-ice-cream-VAT-008-step-03-e6d997c986d44202ac4db082d0c40a78.jpg"
      ],
      "image": "assets/images/199701/step_03.webp"
    },
    {
      "text": "Pour chilled mixture into an ice cream maker and freeze according to manufacturer's directions until it reaches soft-serve consistency, about 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xMT4If2TfmdDlmWFsHhe3UmbIH0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/199701-cake-batter-ice-cream-VAT-009-step-04-af7a4789212748bba6e5a3ee71e7316c.jpg"
      ],
      "image": "assets/images/199701/step_04.webp"
    },
    {
      "text": "Serve or transfer ice cream to a 1- or 2-quart lidded plastic container; cover surface with plastic wrap and seal. Store ice cream in the freezer for at least 2 hours to ripen or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EjRNfWCrmhCobU9AT1aXVXeQqQ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/199701-cake-batter-ice-cream-VAT-010-step-05-2d638106fbad46e99d231a07de4c34c2.jpg"
      ],
      "image": "assets/images/199701/step_05.webp"
    }
