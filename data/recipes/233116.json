  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup white sugar",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "6 tablespoons butter",
    "0.25 cup boiling water",
    "0.25 cup cold water",
    "2 tablespoons cornstarch",
    "2 cups fresh blueberries",
    "1.5 cups fresh raspberries",
    "0.75 cup white sugar",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, ½ cup sugar, baking powder, and salt in a bowl; mash in butter until crumbly. Stir in ¼ cup boiling water until a dough forms; set topping aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ¼ cup cold water and cornstarch in a separate bowl until cornstarch is dissolved; stir in blueberries, raspberries, ¾ cup sugar, and lemon juice until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer berry filling to a cast-iron skillet; bring to a boil, stirring frequently. Drop topping over hot filling by the spoonful. Place the skillet on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is golden brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
