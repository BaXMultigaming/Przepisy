  "ingredients": [
    "3 cups sifted all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon ground cloves",
    "2 tablespoons ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 tablespoon orange zest",
    "1 cup chopped walnuts",
    "4 eggs",
    "2 cups white sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking powder, cloves, cinnamon, and nutmeg. Stir in the orange rind and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium size bowl, beat eggs and sugar until thick. Blend in flour mixture to make a smooth dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1 inch balls, place onto ungreased baking sheets and bake in the preheated oven for 15 minutes, until light brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
