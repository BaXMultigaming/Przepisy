  "ingredients": [
    "1 cup finely crushed ranch-flavored tortilla chips",
    "0.5 teaspoon chili powder, or to taste",
    "0.25 teaspoon salt",
    "0.25 teaspoon black pepper",
    "1 egg, beaten",
    "1 tablespoon cooking oil",
    "4 (8 ounce) fillets catfish, washed and patted dry"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Line a cooking sheet with aluminum foil and spray lightly with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a shallow dish, mix together crushed chips, chili powder, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, mix egg and oil. Dip catfish in egg and oil mixture, then dredge in chips mixture. Place catfish on foil-lined baking sheet, and sprinkle any leftover chip mixture over the catfish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated oven until catfish is flaky and white in the middle, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
