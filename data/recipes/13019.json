  "ingredients": [
    "1.5 pounds boneless skinless chicken breasts, cut into bite-size pieces",
    "0.5 cup chopped onion",
    "1 clove garlic, minced",
    "3 tablespoons butter",
    "2 cubes chicken bouillon",
    "1 cup hot water",
    "0.75 teaspoon ground cumin",
    "2 cups half-and-half cream",
    "2 cups shredded Monterey Jack cheese",
    "1 (14.75 ounce) can cream-style corn",
    "1 (4 ounce) can diced green chiles",
    "1 dash hot pepper sauce",
    "1 tomato, chopped",
    "0.25 bunch fresh cilantro sprigs, for garnish"
  ],
  "steps": [
    {
      "text": "In a Dutch oven, brown chicken, onion, and garlic in butter until chicken is no longer pink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve the bouillon in hot water; Pour into Dutch oven, and season with cumin. Bring to a boil. Reduce heat to low, cover, and simmer for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in cream, cheese, corn, chilies, and hot pepper sauce. Cook, stirring frequently, until the cheese is melted. Stir in chopped tomato. Garnish with cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
