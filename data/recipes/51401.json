  "ingredients": [
    "4 Vidalia or other sweet onions",
    "2 cups water",
    "0.5 cup white vinegar",
    "1 cup sugar",
    "0.5 cup mayonnaise",
    "1 teaspoon celery salt",
    "saltine crackers"
  ],
