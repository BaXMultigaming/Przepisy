  "ingredients": [
    "3 pounds lamb chops",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon adobo seasoning",
    "cayenne pepper to taste",
    "salt and pepper to taste",
    "1.5 cups duck sauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange lamb chops in a medium baking dish, and evenly coat with Worcestershire sauce, adobo seasoning, and cayenne pepper. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 1 hour in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover lamb chops with duck sauce, and continue baking 15 to 20 minutes, to an internal temperature of 145 degrees F (65 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
