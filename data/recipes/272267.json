  "ingredients": [
    "0.25 cup olive oil",
    "1 tablespoon coconut aminos (soy-free seasoning sauce)",
    "2 teaspoons Montreal steak seasoning",
    "0.5 teaspoon garlic powder",
    "2 strip steaks, cut into 3/4-inch pieces",
    "4 ounces portobello mushrooms, quartered"
  ],
  "steps": [
    {
      "text": "Combine olive oil, coconut aminos, steak seasoning, and garlic powder in a small bowl. Mix well, add steak pieces, and marinate for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 390 degrees F (200 degrees C). Line the bottom of the air fryer basket with perforated parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain steak pieces from marinade. Add steak and quartered portobello mushrooms to the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 5 minutes. Remove basket, toss steak and mushrooms around, and continue cooking for an additional 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
