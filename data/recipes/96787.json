  "ingredients": [
    "1 cup cooked brown rice",
    "1 cup 2% low-fat milk",
    "2 tablespoons dried blueberries",
    "1 tablespoon honey",
    "1 dash cinnamon",
    "1 egg",
    "1 tablespoon butter",
    "0.25 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine cooked brown rice, milk, blueberries, honey, and cinnamon in a small saucepan. Bring to a boil, then reduce heat to low; simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a small bowl. Whisk 6 tablespoons hot rice mixture, 1 tablespoon at a time, into egg to temper until incorporated. Stir tempered egg mixture, butter, and vanilla into rice mixture; continue cooking over low heat to thicken, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
