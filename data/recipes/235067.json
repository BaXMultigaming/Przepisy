  "ingredients": [
    "1 (14.5 ounce) package gingerbread mix",
    "1.25 cups warm water",
    "1 egg",
    "1 (3.4 ounce) package JELL-O Lemon Flavor Instant Pudding",
    "2.5 cups milk"
  ],
  "steps": [
    {
      "text": "Mix gingerbread mix, water and egg in large bowl until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat griddle or large skillet sprayed with cooking spray on medium heat. Pour batter onto griddle, using scant 1/4 cup batter for each pancake. Cook until bubbles form on tops, then turn to brown other sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat pudding mix and milk in microwaveable bowl with whisk 2 min. Microwave on HIGH 1-1/2 min. or until heated through, stirring after 1 min. Serve pancakes with warm lemon sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
