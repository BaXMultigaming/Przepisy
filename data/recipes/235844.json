  "ingredients": [
    "2 large ripe Avocados from Mexico, cut into 1-inch pieces",
    "1 cup all-purpose flour",
    "1 egg",
    "1 tablespoon cornstarch",
    "1 cup cold club soda",
    "0.5 cup ice water",
    "1 pinch Pinch of salt",
    "1 cup Oil for frying"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep pan. Combine the flour, egg, cornstarch, club soda, ice water and salt in a bowl. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip the avocado pieces in the batter, then drop gently into the hot oil. Fry the avocado pieces until they are crispy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and serve with your favorite dipping sauce.",
