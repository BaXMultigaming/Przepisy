  "ingredients": [
    "32 Hillshire Farm Lit'l Smokies®",
    "1 (8 ounce) can refrigerated crescent dough rolls",
    "Mustard or ketchup, if desired"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll dough, separate at perforations, creating 4 rectangles. Press perforations to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With a knife or pizza cutter cut each rectangle lengthwise into 8 strips making a total of 32 strips. Wrap one strip of dough around each Lit'l Smokies stretching dough slightly to look like bandages, leaving tip exposed to create face. Place on ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 12 to 14 minutes. Draw features on tip of Lit'l Smokies to create face. Serve with mustard or ketchup, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
