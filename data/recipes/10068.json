  "ingredients": [
    "1 cup butter",
    "1 cup margarine",
    "1 pound cottage cheese, creamed",
    "4 cups all-purpose flour",
    "0.5 teaspoon salt",
    "4 tablespoons all-purpose flour",
    "2 teaspoons vanilla extract",
    "1 cup shortening",
    "2 cups confectioners' sugar",
    "6 tablespoons marshmallow creme",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Cream together butter, margarine, cottage cheese, salt, and 4 cups of flour to form a dough. Shape into a large square, cover, and chill overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut dough into 4 quarters. Roll each quarter out individually, about 1/8 inch thick; cut into 8-inch strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll over tubes (I use clothespins covered with aluminum foil). Bake in the preheated oven until brown, about 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir milk and 4 tablespoons of flour together over medium-low heat until thick paste forms. Let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat shortening and confectioners' sugar together until fluffy. Add marshmallow cream and vanilla; add cold paste and beat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill tubes with cream filling. Sprinkle with confectioners' sugar just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
