  "ingredients": [
    "6 tablespoons butter",
    "0.25 cup diced onion",
    "0.25 cup diced celery",
    "0.33333334326744 cup all-purpose flour",
    "4 cups turkey broth",
    "0.33333334326744 cup shredded carrots",
    "2 cups chopped leftover roasted turkey",
    "2 cups cooked wild rice",
    "0.25 cup chopped slivered almonds",
    "0.5 teaspoon kosher salt, or to taste",
    "0.5 teaspoon ground black pepper, or to taste",
    "0.5 teaspoon lemon juice",
    "0.75 cup half-and-half"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GFsqdRT4o8C1Rjzb9Bg3RLOotVE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-212664-Turkey-Wild-Rice-Soup-ddmfs-step-1-1fb2870fd43d45808e55ca3ae8c8d0d6.jpg"
      ],
      "image": "assets/images/212664/step_01.webp"
    },
    {
      "text": "Melt butter in a soup pot over medium heat. Add onion and celery; cook and stir until translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5sKdj6nhzB1TUt02aUWjw76x6LE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-212664-Turkey-Wild-Rice-Soup-ddmfs-step-2-2843bf41951046baa1082064bbf13cd0.jpg"
      ],
      "image": "assets/images/212664/step_02.webp"
    },
    {
      "text": "Stir in flour, and cook until it turns a pale, yellowish-brown color, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ORg4pLe4ptnoFuQwn47K_Ei97ek=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-212664-Turkey-Wild-Rice-Soup-ddmfs-step-3-2b34778f036e4773a94c2078b5cc4f72.jpg"
      ],
      "image": "assets/images/212664/step_03.webp"
    },
    {
      "text": "Gradually whisk in turkey stock until smooth and no lumps of flour remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UktP2JccnILcrWcMWuxTZl2asyg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-212664-Turkey-Wild-Rice-Soup-ddmfs-step-4-8224455188b44938896259485c4ad798.jpg"
      ],
      "image": "assets/images/212664/step_04.webp"
    },
    {
      "text": "Stir in carrot and bring mixture to a simmer. Cook, whisking constantly, until stock is thick and smooth and carrots are tender, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5yajDcimkUyLzyYsBWE_UxNgC2Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-212664-Turkey-Wild-Rice-Soup-ddmfs-step-5-ef0336a37a2e4ad6afb4132402717663.jpg"
      ],
      "image": "assets/images/212664/step_05.webp"
    },
    {
      "text": "Stir in turkey, wild rice, almonds, salt, and pepper; simmer until heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Br4EIGJr10fQqPgWOY1Lw5A39-c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-212664-Turkey-Wild-Rice-Soup-ddmfs-step-6-fe618080335f4cc09a88172e84be9d60.jpg"
      ],
      "image": "assets/images/212664/step_06.webp"
    },
    {
      "text": "Stir in lemon juice and half-and-half; heat until just below a boil. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/srAS0nPhUeJPk12Jb2sCp9CSe1Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-212664-Turkey-Wild-Rice-Soup-ddmfs-step-7-1c44d200ffa74088a9c784014b98f0c2.jpg"
