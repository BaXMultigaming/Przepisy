  "ingredients": [
    "2 cups white sugar",
    "2 cups all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "0.5 cup butter",
    "1 cup water",
    "0.5 cup buttermilk",
    "2 eggs, beaten",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease and flour a 9x13 inch pan. Mix together the sugar, flour, cocoa, baking powder, baking soda and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan bring butter and water to a boil. Remove from heat. Stir in flour mixture. Pour in buttermilk, eggs and vanilla; mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cake batter into prepared 9x13 inch baking pan. Bake in preheated oven for 25 minutes or until a toothpick inserted in center comes out clean. Remove cake from oven and frost immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
