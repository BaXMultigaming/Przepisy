  "ingredients": [
    "2 pounds cooked medium shrimp, peeled and deveined without tail",
    "1 green bell pepper, finely chopped",
    "1 red bell pepper, finely chopped",
    "5 cloves garlic, minced",
    "1 sweet onion, diced",
    "chopped fresh cilantro",
    "1 avocado - peeled, pitted and diced",
    "salt and pepper to taste",
    "0.5 cup olive oil",
    "chili pepper flakes"
  ],
  "steps": [
    {
      "text": "Place shrimp in a large mixing bowl with red and green bell peppers, garlic, onion, cilantro, and avocado. Drizzle with olive oil, and season with salt and pepper. Cover, and refrigerate for at least 1 hour to allow flavors to develop. Serve chilled.",
