  "ingredients": [
    "2 (14.5 ounce) cans chicken broth",
    "2 cups converted rice (such as Uncle Ben's®)",
    "1 (4 ounce) can mushroom stems and pieces",
    "0.5 cup water",
    "6 green onions, chopped",
    "2 teaspoons butter, or to taste"
  ],
  "steps": [
    {
      "text": "Combine broth, rice, mushrooms, water, green onions, and butter in a large pot or Dutch oven over medium-high heat. Bring to a boil. Reduce heat to medium-low. Cover and simmer for 20 minutes. Remove from heat and let stand until liquid is absorbed, about 5 minutes.",
