  "ingredients": [
    "2 fluid ounces vanilla vodka",
    "1 fluid ounce hazelnut liqueur",
    "0.5 cup ice cubes",
    "1 fluid ounce raspberry vodka",
    "1 fluid ounce creme de cacao",
    "1 teaspoon chocolate syrup",
    "1 fluid ounce half-and-half cream",
    "2 maraschino cherries"
  ],
  "steps": [
    {
      "text": "Prepare his cocktail by pouring the vanilla vodka and hazelnut liqueur into a rocks glass over ice. Pour the contents of the glass into a cocktail shaker, then pour back into the rocks glass to mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare her cocktail by pouring the raspberry vodka and creme de cacao into a cocktail shaker over ice. Cover, and shake until the outside of the shaker has frosted. Strain into a martini glass rimmed with chocolate syrup, pour in the half-and-half, and garnish with maraschino cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Kiss to mix flavors.",
