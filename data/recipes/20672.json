  "ingredients": [
    "1 (6.5 ounce) jar marinated artichoke hearts, drained and quartered",
    "1 cup mayonnaise",
    "1.5 cups grated Parmesan cheese",
    "1 (8 ounce) package cream cheese, softened",
    "1 (4 ounce) can chopped green chile peppers"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix artichoke hearts, mayonnaise, 1 cup Parmesan cheese, cream cheese, and green chile peppers. Scoop mixture into a pie pan or medium baking pan. Top with remaining 1/2 cup of Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 minutes or until bubbly and slightly browned. Serve warm.",
      "section": null,
      "name": null,
