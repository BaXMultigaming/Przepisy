  "ingredients": [
    "0.75 cup millet",
    "1.5 cups all-purpose flour",
    "0.5 cup yellow cornmeal",
    "1.5 tablespoons poppy seeds",
    "3 tablespoons white sugar",
    "1 tablespoon grated lemon rind",
    "1.25 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup milk",
    "0.25 cup honey",
    "0.25 cup canola oil",
    "1 egg",
    "0.75 teaspoon vanilla extract",
    "1 tablespoon white sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread millet on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring often, until toasted and fragrant, about 10 minutes. Remove from oven and cool, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase oven temperature to 400 degrees F (200 degrees C). Grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix millet, flour, cornmeal, poppy seeds, 3 tablespoons sugar, lemon rind, baking powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, honey, canola oil, egg, and vanilla extract together in a separate bowl. Stir milk mixture into flour mixture until just combined. Pour batter into the prepared muffin cups; sprinkle 1 tablespoon sugar over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean and tops are golden, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
