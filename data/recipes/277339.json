  "ingredients": [
    "2 tablespoons butter",
    "1 onion, chopped",
    "2 tablespoons brown sugar",
    "0.75 cup ketchup",
    "2 tablespoons yellow mustard",
    "1 tablespoon Worcestershire sauce",
    "4 hot dogs",
    "0.5 (8 ounce) package processed cheese food (such as Velveeta®), cubed, or to taste",
    "4 hot dog buns",
    "4 sheets aluminum foil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4HmCzsHYP3gnAZBhD5mu7OpG8As=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277339-surprise-barbecue-hot-dogs-VAT-001-step-01-59059e082a18469a8b6ff8889c2665ff.jpg"
      ],
      "image": "assets/images/277339/step_01.webp"
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Stir in onion and brown sugar and cook until onion is soft but not yet brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5T7qx2igET_04rjolTs6nb_ENLs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277339-surprise-barbecue-hot-dogs-VAT-002-step-02-8ead066646104f73b85f1830a57844a6.jpg"
      ],
      "image": "assets/images/277339/step_02.webp"
    },
    {
      "text": "Add ketchup, mustard, and Worcestershire sauce; bring to a simmer. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hMCW5A3KwJfjiGqKbCuUZj6DkGs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277339-surprise-barbecue-hot-dogs-VAT-003-step-03-55162e9b4c5d4e7ca04046625610fc84.jpg"
      ],
      "image": "assets/images/277339/step_03.webp"
    },
    {
      "text": "Cut a slit through each hot dog and fill with cubes of cheese food. Place dogs in buns and cover meat with onion sauce, about 3 tablespoons each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z86Umu4PoYNBHycwQG547nSXeeA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277339-surprise-barbecue-hot-dogs-VAT-005-step-04-02-6d9f6d5890e345d796f43481f4b5501b.jpg"
      ],
      "image": "assets/images/277339/step_04.webp"
    },
    {
      "text": "Wrap in aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NGcYQsgUkS6ghIHg9UBI5GLxGq0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/277339-surprise-barbecue-hot-dogs-VAT-006-step-05-f14cdf4544c649eeb466cdffae716e29.jpg"
