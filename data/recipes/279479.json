  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup brown sugar, packed",
    "0.5 cup white sugar",
    "1 cup semi-sweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Mix flour, baking soda, and salt together in a bowl. Pour into a 1-quart canning jar. Layer with brown sugar, white sugar, and chocolate chips (in that order), making sure to pack down all the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and decorate the jar as desired. Copy baking instructions onto a tag and attach to the jar.",
