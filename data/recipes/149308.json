  "ingredients": [
    "2 eggs",
    "1 (11 ounce) can cream-style corn",
    "0.25 cup grated Parmesan cheese",
    "0.25 cup vegetable oil",
    "2 tablespoons white sugar",
    "0.25 teaspoon minced garlic",
    "0.25 teaspoon ground black pepper",
    "2 cups sliced yellow squash",
    "0.5 cup biscuit baking mix",
    "0.25 cup chopped onions"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a large bowl until smooth; stir in cream-style corn, Parmesan cheese, oil, sugar, garlic, and black pepper. Fold in squash, biscuit mix, and onion; pour into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and lightly browned, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
