  "ingredients": [
    "2 cups milk",
    "1 cup packed light brown sugar",
    "0.25 cup cornstarch",
    "0.5 teaspoon salt",
    "2 large egg yolks, beaten",
    "1 tablespoon butter",
    "1 teaspoon vanilla extract",
    "1 (9 inch) pie crust, baked"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JlifNLu9fK6TslObu9jykindJAU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12101-grandmas-butterscotch-pie-VAT-step-01-67c456a1965045fd800cde0243ec6c58.jpg"
      ],
      "image": "assets/images/12101/step_01.webp"
    },
    {
      "text": "Combine milk, brown sugar, cornstarch, and salt in the top of a double boiler over simmering water. Cook, stirring constantly, until mixture starts to thicken, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Qm7xRQu7EaMcq9m4UGxegCgDlf8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12101-grandmas-butterscotch-pie-VAT-step-02-dd3518ae3289403e92f1d27fa6f74481.jpg"
      ],
      "image": "assets/images/12101/step_02.webp"
    },
    {
      "text": "Whisk in egg yolks; cook and stir until filling is thickened. Remove filling from heat; stir in butter and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3-yKWCcuMJ4iR2Ih4A3Ds2d6of8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12101-grandmas-butterscotch-pie-VAT-step-03-ad415ef2dbc54d8586cd7428c41d6069.jpg"
      ],
      "image": "assets/images/12101/step_03.webp"
    },
    {
      "text": "Pour filling into baked crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wshE4Yut45rooZ_x-y5jB3l4SjI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12101-grandmas-butterscotch-pie-VAT-step-04-46efaaaee28d4cd39d6d16a41fe4218a.jpg"
      ],
      "image": "assets/images/12101/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until the top begins to brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
