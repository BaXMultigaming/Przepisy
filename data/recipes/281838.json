  "title": "Chicken Piccata Casserole",
  "description": "This chicken piccata casserole recipe features the usual lemon, capers, parsley, butter, and flour but skips splatters because it is baked in the oven.",
  "authors": [
    "Bibi"
  ],
  "date_published": "2020-10-02T04:26:13-04:00",
