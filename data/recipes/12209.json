  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 10.25-ounce cake mix, 1 egg, and ½ cup melted butter in a bowl; pat into a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat remaining 2 eggs, pumpkin, ½ cup sugar, evaporated milk, nutmeg, and cinnamon together in a bowl; pour over cake mix batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining cake mix and remaining ¾ cup sugar in a bowl; cut in ½ cup softened butter with 2 knives or a pastry blender until mixture resembles coarse crumbs. Sprinkle mixture over pumpkin mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 55 minutes.",
      "section": null,
