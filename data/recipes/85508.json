  "ingredients": [
    "oil for frying",
    "0.625 cup all-purpose flour",
    "1 pinch salt",
    "1 teaspoon baking powder",
    "6 ripe bananas",
    "3 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer or heavy-bottomed pan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, salt, and baking powder into a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, mash together bananas and sugar. Gradually mix flour mixture into mashed bananas, stirring until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches if necessary, drop spoonfuls of batter into hot oil and cook, turning once, until browned, 2 to 8 minutes. Drain on paper towels.",
      "section": null,
