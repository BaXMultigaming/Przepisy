  "ingredients": [
    "cooking spray",
    "1.5 cups carrot pulp",
    "0.5 cup applesauce",
    "2 eggs",
    "2 tablespoons brown sugar",
    "1 cup spelt flour",
    "0.25 cup rolled oats",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon ground nutmeg",
    "0.125 teaspoon ground ginger",
    "0.5 cup chopped walnuts",
    "0.33333334326744 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix carrot pulp, applesauce, eggs, and brown sugar together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix spelt flour, oats, cinnamon, baking soda, baking powder, nutmeg, and ginger together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine carrot pulp and flour mixtures until batter is blended and thick. Fold in walnuts and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin tin. Press down and fill each cup to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the muffins comes out clean, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
