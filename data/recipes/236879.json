  "ingredients": [
    "2.5 cups pineapple juice",
    "2.5 cups orange juice",
    "1 cup 151 proof rum (such as Bacardi®)",
    "0.5 cup dark rum (such as Meyer's®)",
    "0.25 cup coconut-flavored rum (such as Malibu®)",
    "0.25 cup fresh lime juice",
    "3 tablespoons grenadine syrup",
    "1 orange, sliced",
    "1 lime, sliced",
    "1 lemon, sliced"
  ],
