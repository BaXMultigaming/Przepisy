  "ingredients": [
    "1 (12 ounce) package frozen cauliflower pizza crust",
    "0.66666668653488 cup frozen roasted corn, thawed",
    "2 teaspoons water, or as needed",
    "2 ounces grated Parmesan cheese",
    "4 tablespoons frozen roasted corn, thawed",
    "4 slices crisp-cooked bacon, finely chopped",
    "2 green onions, sliced",
    "2 tablespoons shredded Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a cookie sheet or pizza pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place crust on the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree 2/3 cup of corn kernels in a blender until smooth. Add water, 1 teaspoon at a time, if needed. Spread the puree evenly across the crust, almost to the edge. Sprinkle 2 ounces Parmesan cheese evenly over the corn puree.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top the corn puree and cheese evenly with 4 tablespoons corn, bacon, and green onions. Sprinkle 2 tablespoons Parmesan cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the crust is golden and crispy, 13 to 15 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
