  "ingredients": [
    "1 cup rolled oats",
    "0.5 cup orange juice",
    "0.5 cup boiling water",
    "0.5 cup butter",
    "0.5 cup packed brown sugar",
    "0.33333298563957 cup white sugar",
    "2 eggs, lightly beaten",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.75 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "1 teaspoon vanilla extract",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease or paper-line muffin pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl soak oats in orange juice and water for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl cream together butter or margarine and sugars. Beat in eggs and oat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, blend flour, baking powder, soda, salt, and nutmeg. Stir into batter. Stir in vanilla and raisins. Spoon batter into prepared muffin pans, filling 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) until golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
