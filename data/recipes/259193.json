  "ingredients": [
    "1 teaspoon vegetable oil",
    "water",
    "1 cup raw pumpkin seeds",
    "1 teaspoon salt",
    "1 tablespoon chili-lime seasoning (such as Tajin®)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Lightly oil a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring 6 cups water to a boil in a saucepan: add pumpkin seeds and salt. Reduce heat to low and simmer for 10 minutes. Strain and pat dry with a paper towel. Spread seeds in a single layer on the prepared baking sheet; sprinkle chili-lime seasoning on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Remove from the oven: stir seeds, spread back into a single layer, and return to the hot oven. Repeat twice more, stirring every 10 minutes, until seeds are golden and crisp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
