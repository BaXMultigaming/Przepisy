  "ingredients": [
    "1 teaspoon oil",
    "1 onion, thinly sliced",
    "0.5 (6 ounce) package Canadian-style bacon, chopped, or to taste",
    "1 head white cabbage, thinly sliced",
    "1 (12 fluid ounce) can or bottle beer"
  ],
  "steps": [
    {
      "text": "Heat oil in a large stockpot over medium heat; cook and stir onion and bacon until fragrant, 2 to 4 minutes. Add cabbage and mix well; pour in beer. Cover stockpot and simmer, stirring occasionally, until cabbage is tender, 10 to 15 minutes.",
