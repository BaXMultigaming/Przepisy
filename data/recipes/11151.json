  "ingredients": [
    "0.5 cup butter",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 egg",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "0.5 teaspoon vanilla extract",
    "1 cup rolled oats",
    "1 cup crisp rice cereal",
    "0.5 cup peanut butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the butter, sugar and egg until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift the flour, baking soda and baking powder. Add this to the butter mixture. Stir in the vanilla, oatmeal, puffed rice cereal, and peanut butter. Mix until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by heaping teaspoons onto ungreased baking sheets and bake at 350 degrees F (175 degrees C) for 10 to 12 minutes or until lightly browned around the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
