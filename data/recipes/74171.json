  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "0.5 cup mayonnaise",
    "0.5 teaspoon curry powder",
    "0.5 pound small cooked shrimp",
    "4 green onions, chopped",
    "2 hard-cooked eggs, grated",
    "salt to taste",
    "1 pinch paprika, for garnish"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mix together the cream cheese, mayonnaise, and curry powder until light and fluffy. Spread onto a serving plate. Arrange shrimp over the top, then sprinkle with green onions, grated egg, salt and paprika in that order. Chill for 1 hour before serving.",
