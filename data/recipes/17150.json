  "ingredients": [
    "2 cups semisweet chocolate chips",
    "1 (14 ounce) can sweetened condensed milk",
    "2 teaspoons vanilla extract",
    "1.5 cups chopped walnuts",
    "1 cup miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Grease an 8x8-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate chips and sweetened condensed milk into a microwave-safe bowl. Cook on high for 2 to 3 minutes, stirring occasionally, until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in vanilla, then fold in walnuts and marshmallows. Spread evenly into the prepared pan. Chill in the refrigerator until firm before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
