  "ingredients": [
    "3 cups chicken broth",
    "2 pounds yams, diced",
    "1 medium onion, chopped",
    "1 tablespoon curry powder",
    "0.25 teaspoon black pepper",
    "0.5 teaspoon salt",
    "0.5 cup uncooked wild rice",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Pour chicken broth into a saucepan with curry powder, salt, pepper, onion powder, and garlic powder. Bring to a boil over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add yams and onion and simmer for about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add rice and cook until rice is tender, another 20 minutes.",
