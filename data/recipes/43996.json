  "ingredients": [
    "1 pound ground beef",
    "1 (28 ounce) can stewed tomatoes",
    "2 (15.25 ounce) cans whole kernel corn",
    "2 (15 ounce) cans whole green beans",
    "1 (15.5 ounce) can canned red beans, drained and rinsed",
