  "ingredients": [
    "1 cup white sugar",
    "0.75 cup butter",
    "0.75 cup milk",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "1.75 cups sifted all-purpose flour",
    "2.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup huckleberries",
    "1 tablespoon all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease 15 muffin cups or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a bowl with an electric mixer until smooth; beat in milk, egg, and vanilla extract until well blended. Combine 1 ¾ cups flour, baking powder, and salt in a separate bowl; stir into batter until just moistened. Toss huckleberries with 1 tablespoon flour in a bowl to coat: fold into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter among the prepared muffin cups, filling each ⅔ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
