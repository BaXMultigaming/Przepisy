  "ingredients": [
    "1 (12 ounce) package radiatore pasta",
    "0.25 cup sesame seeds",
    "0.25 cup salad oil",
    "0.75 cup soy sauce",
    "0.5 cup white wine vinegar",
    "3.5 tablespoons sugar",
    "2 cups cubed, cooked chicken",
    "0.5 cup chopped fresh parsley",
    "0.5 cup coarsely chopped green onion",
    "4 cups torn fresh spinach leaves"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat oil in a small skillet over medium-low heat. Stir in sesame seeds and cook until golden brown. Remove from heat. Stir in soy sauce, vinegar, and sugar. Pour dressing into a sealable container, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together pasta, cooked chicken, and 1 cup dressing (reserve remaining dressing). Cover salad, and refrigerate at least 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Directly before serving, stir in parsley, green onions, and spinach. Toss with remaining dressing, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
