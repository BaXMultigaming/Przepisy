  "ingredients": [
    "2 bunches kale, stemmed and finely chopped",
    "2 carrots, julienned",
    "1 small red onion, minced",
    "0.5 cup dried cranberries",
    "3 tablespoons mayonnaise",
    "2 tablespoons white sugar",
    "2 tablespoons olive oil",
    "2 Key limes, juiced",
    "1 lemon, juiced",
    "0.5 teaspoon salt",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine kale, carrots, onion, and cranberries in a large bowl until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, sugar, oil, Key lime juice, lemon juice, salt, and black pepper together in a separate bowl; pour over kale mixture. Toss until thoroughly coated. Refrigerate for 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
