  "ingredients": [
    "2.5 pounds ground beef",
    "4 cloves garlic, minced",
    "1 (28 ounce) can tomato sauce",
    "0.5 cup stuffed green olives",
    "0.5 cup brine from olive jar",
    "0.5 teaspoon garlic salt",
    "0.5 teaspoon garlic powder",
    "1 tablespoon adobo seasoning",
    "0.5 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "Heat a large pot over medium-high heat until hot. Add beef and garlic; cook and stir until the beef is crumbly and no longer pink. Place cooked beef in a mesh strainer to drain off the grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return beef to the pan and add the tomato sauce, green olives, and olive brine. Season with garlic salt, garlic powder, adobo seasoning, and pepper. Bring to a simmer, then reduce heat to medium-low, cover, and simmer for 45 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
