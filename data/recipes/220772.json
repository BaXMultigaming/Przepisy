  "ingredients": [
    "1 pound ground beef",
    "0.5 yellow onion, chopped",
    "1.5 cups shredded sharp Cheddar cheese",
    "1 (14 ounce) can refried beans",
    "1 (1 ounce) package taco seasoning",
    "6 (9 inch) flour tortillas",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "8 ounces sour cream",
    "0.5 cup salsa, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook ground beef and onion in a skillet over medium heat until beef is completely browned, 7 to 10 minutes. Drain excess grease from the skillet. Stir 1 cup Cheddar cheese, refried beans, and taco seasoning into ground beef; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soup, sour cream, and salsa in a bowl; spread about ½ into the bottom of a 9x13-inch baking dish. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon beef mixture down center of each tortilla; roll tortillas around filling. Arrange rolled tortillas in a single layer in the baking dish, seam-sides down. Pour remaining ½ soup mixture over tortillas. Top with remaining 1 ½ cups Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is bubbly and melted, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
