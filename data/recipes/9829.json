  "ingredients": [
    "2 cups white sugar",
    "0.5 cup milk",
    "0.25 cup butter",
    "2 tablespoons unsweetened cocoa powder",
    "3 cups quick cooking oats",
    "0.5 cup peanut butter",
    "1 teaspoon vanilla extract",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Combine sugar, milk, butter and cocoa in a saucepan and bring to a boil, cooking 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and add remaining ingredients. Stir and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoons onto wax paper, letting stand 30 minutes or when dry and cool. Store in well-sealed container.",
