  "ingredients": [
    "0.25 cup mayonnaise",
    "3 cloves garlic, minced",
    "1 tablespoon lemon juice",
    "0.125 cup olive oil",
    "1 cup sliced red bell peppers",
    "1 small zucchini, sliced",
    "1 red onion, sliced",
    "1 small yellow squash, sliced",
    "2 (4-x6-inch) focaccia bread pieces, split horizontally",
    "0.5 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "In a bowl, mix the mayonnaise, minced garlic, and lemon juice. Set aside in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush vegetables with olive oil on each side. Brush grate with oil. Place bell peppers and zucchini closest to the middle of the grill, and set onion and squash pieces around them. Cook for about 3 minutes, turn, and cook for another 3 minutes. The peppers may take a bit longer. Remove from grill, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread some of the mayonnaise mixture on the cut sides of the bread, and sprinkle each one with feta cheese. Place on the grill cheese side up, and cover with lid for 2 to 3 minutes. This will warm the bread, and slightly melt the cheese. Watch carefully so the bottoms don't burn. Remove from grill, and layer with the vegetables. Enjoy as open faced grilled sandwiches.",
      "section": null,
      "name": null,
      "url": null,
