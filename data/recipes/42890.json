  "ingredients": [
    "2 tablespoons butter",
    "3 fresh mushrooms, sliced",
    "1 tablespoon all-purpose flour",
    "1 cup chicken broth",
    "1 cup chopped cooked turkey",
    "0.5 cup heavy cream",
    "0.33300000429153 cup frozen peas, thawed",
    "salt and pepper to taste",
    "freshly chopped parsley for garnish"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium-low heat; cook until golden brown.",
      "section": null,
      "name": null,
      "url": null,
