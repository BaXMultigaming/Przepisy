    },
    {
      "text": "Add mushrooms; cook until tender, stirring occasionally, about 3 minutes. Stir in flour until smooth. Slowly whisk in chicken broth; cook until slightly thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
