  "ingredients": [
    "0.5 cup teriyaki sauce",
    "0.5 cup orange juice",
    "0.25 cup dry sherry",
    "2 teaspoons minced fresh ginger root",
    "2 cloves garlic, minced",
    "ground black pepper to taste",
    "1 dash ground allspice",
    "6 (3/4 inch) thick pork chops"
  ],
  "steps": [
    {
      "text": "To Make Marinade: In a medium, non-reactive bowl, mix the teriyaki sauce, orange juice, sherry, ginger root, garlic, pepper and allspice. Add pork chops to bowl, cover, and marinate in refrigerator for 6 hours, turning as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chops and marinade from refrigerator. Remove cover and bake in the preheated oven for 30 to 40 minutes, or until internal temperature of meat has reached 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
