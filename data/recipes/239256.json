  "ingredients": [
    "1 cup all-purpose flour",
    "0.75 cup whole wheat flour",
    "1.25 cups sugar",
    "1.5 teaspoons Spice Islands® Pumpkin Pie Spice",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon Argo® Baking Powder",
    "1 cup canned pumpkin",
    "1 apple, cored and shredded",
    "0.33333334326744 cup Mazola® Corn Oil",
    "1 egg",
    "1 teaspoon Spice Islands® Pure Vanilla Extract",
    "0.5 cup dried cranberries*",
    "2 tablespoons flax seed",
    "0.25 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F. Combine all-purpose flour, whole wheat flour, sugar, pumpkin pie spice, baking soda, salt and baking powder in medium bowl. Whisk together pumpkin, apple, oil, egg and vanilla in a large bowl. Add dry ingredients, mixing just until moistened. Stir in cranberries and flax seed. Portion into greased muffin cups or use paper liners. Sprinkle with walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 to 25 minutes or until wooden pick inserted into center comes out clean. Cool in pan on wire rack 5 minutes. Remove from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
