  "ingredients": [
    "1 (12 ounce) package silken soft tofu, drained",
    "1 cup unsweetened soy milk",
    "1 cup white sugar, or to taste",
    "0.25 cup green tea powder (matcha)",
    "2 tablespoons canola oil"
  ],
  "steps": [
    {
      "text": "Place tofu into a blender or the bowl of a food processor; blend until smooth. Add soy milk, sugar, green tea powder, and canola oil; blend until combined.",
