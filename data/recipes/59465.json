  "ingredients": [
    "3 tablespoons butter, divided",
    "3 tablespoons brown sugar",
    "3 tablespoons frozen orange juice concentrate, thawed",
    "3 tablespoons brandy",
    "2 acorn squash, halved and seeded"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Melt 1 tablespoon butter in a 9x13 inch baking dish. Coat pan evenly with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan, mix the remaining butter, brown sugar, frozen orange juice concentrate, and brandy . Bring to a boil, and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place squash halves cut side down in the baking dish, and bake 30 minutes, or until easily pierced with a knife. Turn squash over, and drizzle with the sauce. Continue baking 15 minutes. Cool slightly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
