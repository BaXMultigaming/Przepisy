    "publisher-tested"
  ],
  "ingredients": [
    "3 pounds boneless beef chuck roast, cut into 2-inch cubes",
    "2 teaspoons freshly ground black pepper",
    "1 tablespoon kosher salt",
    "4 tablespoons olive oil, divided",
    "1 pound small shallots",
    "0.5 cup diced onion",
    "4 cloves garlic, minced",
    "1 pinch kosher salt",
    "3 tablespoons tomato paste",
    "0.25 cup red wine vinegar",
    "1 cup white wine",
    "2 teaspoons white sugar",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon ground allspice",
    "1 pinch ground cloves",
    "1 teaspoon dried oregano",
    "2 large bay leaves",
    "2 sprigs fresh rosemary",
    "2 cups beef broth, or more as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8NZdcvc1NCafcv8dBrZnxGNXQP4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8369933-greek-style-beef-stew-VAT-01-6036651a21ee4434b5d9df425e8f1326.jpg"
      ],
      "image": "assets/images/8369933/step_01.webp"
    },
    {
      "text": "Place beef in a bowl and season generously with pepper and kosher salt. Cover and transfer to the refrigerator until ready to use; up to 1 day is fine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B4-4rcomdrUZ4rgjPTuxpJUXFqQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8369933-greek-style-beef-stew-VAT-02-3a7a78fd697d4505b739a8d614a9e08e.jpg"
      ],
      "image": "assets/images/8369933/step_02.webp"
    },
    {
      "text": "Leaving the root ends in place, cut off the shallot tops. Remove and discard skins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j_g9y94bmj_oaVjlVdiILbAEYmw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8369933-greek-style-beef-stew-VAT-03-92b60067dce24726b7a312d6ee7460fc.jpg"
      ],
      "image": "assets/images/8369933/step_03.webp"
    },
    {
      "text": "Heat 2 tablespoons oil in a heavy skillet over high heat. Add ½ of the beef and cook until nicely seared, 4 to 6 minutes per side. Remove to a plate and repeat to sear remaining beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5dPJjOy846Xoxt4pfC_yKhANTgM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8369933-greek-style-beef-stew-VAT-04-7fd62c2ef67e45bebc05852623f00475.jpg"
      ],
      "image": "assets/images/8369933/step_04.webp"
    },
    {
      "text": "Turn off the heat and add 1 tablespoon oil to the empty skillet. Add shallots and let the skillet cool for 2 to 3 minutes. Turn the heat back on to medium and toss shallots until browned, 2 to 4 minutes. Remove shallots to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HSKisRNuVKOpV0MyXKCXserGmzI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8369933-greek-style-beef-stew-VAT-05-a8dd200444454c51a632939798db9889.jpg"
      ],
      "image": "assets/images/8369933/step_05.webp"
    },
    {
      "text": "Add the remaining 1 tablespoon oil to the skillet with onion, garlic, and a pinch of salt; cook and stir for about 1 minute. Stir in tomato paste and cook until toasted, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nJ93YdU8sJU7AFxc7935cLU534g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8369933-greek-style-beef-stew-VAT-06-44b6d40461cf424b94ad8172a52c7143.jpg"
      ],
      "image": "assets/images/8369933/step_06.webp"
    },
    {
      "text": "Add red wine vinegar and white wine and bring to a boil while scraping the browned bits of food off the bottom of the pan with a wooden spoon. Increase heat to medium-high and add sugar, cinnamon, allspice, cloves, oregano, bay leaves, and rosemary sprigs. Stir to combine and cook until reduced by about half, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LK3l-4nBYe5Hgw8w5ikDlxzTNEk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8369933-greek-style-beef-stew-VAT-07-a780d3111a4e434981a9cc1741d5f515.jpg"
      ],
      "image": "assets/images/8369933/step_07.webp"
    },
    {
      "text": "Add browned beef and shallots to the skillet and toss carefully until coated. Pour in 2 cups beef broth and bring to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ELQPrBmiR6YWm2P47-sdsp3WkNg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8369933-greek-style-beef-stew-VAT-08-358f09e5fe2240d0a5ab696cf30cb064.jpg"
      ],
      "image": "assets/images/8369933/step_08.webp"
    },
    {
      "text": "Reduce heat to low or medium-low. Cover and cook at a gentle simmer for 1 hour, then uncover and cook for at least 1 more hour, stirring occasionally to move the beef and shallots around. Add more broth if needed during the cooking time and skim off some fat if preferred.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_wZVQk4wqVSBsWrggpLPwycI5Hk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8369933-greek-style-beef-stew-VAT-09-a0bec830062a4be1a84669591b1cdf0e.jpg"
      ],
      "image": "assets/images/8369933/step_09.webp"
    },
    {
      "text": "The meat is done when a fork slides in easily, but the meat isn't falling apart on its own; it may take longer than 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oNAeUTaAlCJgjYUkWGQqx-E3H6A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8369933-greek-style-beef-stew-VAT-10-153b30db2ab24c53a76100a59edd744e.jpg"
      ],
      "image": "assets/images/8369933/step_10.webp"
    },
    {
      "text": "Taste and adjust seasonings before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RjDSgSCm1YI6U75GVfEfRzAUs8Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8369933-greek-style-beef-stew-VAT-11-16e1c2fb5b1e49d789c78f16bdb84b90.jpg"
      ],
      "image": "assets/images/8369933/step_11.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0kdGMUgwJT0Yzix8IgRIpBOAzLo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8369933-greek-style-beef-stew-VAT-4x3-1-9ac9d7e5f6034d58801768d3dae1532d.jpg"
      ],
      "image": "assets/images/8369933/step_12.webp"
    }
  ],
