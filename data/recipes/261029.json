  "ingredients": [
    "1 teaspoon butter",
    "3 cloves garlic, minced",
    "2.5 cups vegetable broth",
    "3 cups chopped broccoli",
    "1 cup heavy whipping cream",
    "3 cups shredded Cheddar cheese",
    "2 slices bacon, chopped and cooked",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium heat. Cook garlic until tender, about 2 minutes. Add vegetable broth, heavy cream, and broccoli. Bring to a boil; simmer until broccoli is tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add Cheddar cheese gradually, stirring constantly, until completely melted. Stir in bacon pieces. Season with salt and pepper.",
