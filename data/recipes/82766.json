  "ingredients": [
    "1 cup sour cream",
    "1 cup white sugar",
    "2 eggs, beaten",
    "1 teaspoon baking powder",
    "1 pinch salt",
    "1 teaspoon cinnamon",
    "0.5 teaspoon nutmeg",
    "0.5 teaspoon ground cloves",
    "3 tablespoons white vinegar",
    "1 cup raisins",
    "1 unbaked 9 inch pie crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together sour cream and sugar until smooth and creamy. Stir in eggs, baking powder, salt, cinnamon, nutmeg, cloves, vinegar, and raisins; mix until well blended. Pour mixture into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated oven 40 to 50 minutes. Cool in refrigerator before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
