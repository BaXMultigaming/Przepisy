  "ingredients": [
    "0.25 cup vegetable oil",
    "10 ounces dried sweetened cranberries",
    "0.5 cup white sugar, or to taste",
    "0.5 cup water, or more as needed",
    "2 small jalapeno peppers, seeded and finely diced",
    "1 tablespoon lemon juice",
    "2 teaspoons dried cilantro",
    "0.25 teaspoon salt",
    "2 (8 ounce) packages cream cheese, softened"
  ],
  "steps": [
    {
      "text": "Heat a saucepan over medium heat; add oil. Stir cranberries into hot oil and cook until cranberries absorb most of oil, 5 to 10 minutes. Mix sugar, water, jalapeño peppers, lemon juice, cilantro, and salt into cranberries; cook until reduced and softened, 10 to 15 more minutes. Add more water if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pulse cranberry mixture in a food processor or blender until very smooth; cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cooled cranberry mixture and cream cheese together in a bowl until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
