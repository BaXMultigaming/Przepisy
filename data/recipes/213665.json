  "ingredients": [
    "8 cups ketchup",
    "6 ounces chipotle peppers in adobo sauce",
    "0.5 cup apple cider vinegar",
    "0.5 cup molasses",
    "1.5 teaspoons onion powder",
    "1.5 teaspoons garlic powder",
    "1.5 teaspoons ground mustard",
    "1.5 teaspoons smoked paprika",
    "1.5 teaspoons ground coriander",
    "1 tablespoon kosher salt",
    "1.5 teaspoons freshly cracked black pepper",
    "1 cup dark brown sugar",
    "1 cup whiskey (such as Jack Daniel's®)",
    "2 tablespoons liquid hickory smoke flavoring"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
