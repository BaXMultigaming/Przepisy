  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup sour cream",
    "2 tablespoons mayonnaise",
    "1.5 tablespoons lemon juice",
    "2 teaspoons Worcestershire sauce",
    "1 teaspoon dry mustard",
    "garlic powder to taste",
    "0.5 cup shredded Cheddar cheese",
    "0.75 pound fresh crabmeat",
    "3 dashes hot sauce",
    "Old Bay Seasoning TM to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Lightly grease a 1 quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix cream cheese, sour cream, mayonnaise, lemon juice, Worcestershire sauce, dry mustard, garlic powder and about 2 tablespoons of the Cheddar cheese. Fold in crabmeat, hot sauce and 2 tablespoons seafood seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the mixture to the prepared baking dish. Top with remaining Cheddar cheese and seafood seasoning. Bake in the preheated oven 30 minutes, or until bubbly and lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
