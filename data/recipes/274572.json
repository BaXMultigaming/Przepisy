  "ingredients": [
    "2.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.66666668653488 cup milk",
    "1 tablespoon white vinegar",
    "1 teaspoon vanilla extract",
    "1.5 cups white sugar",
    "0.5 cup lard",
    "2 eggs",
    "1 cup pureed fresh strawberries, or more to taste",
    "1 (16 ounce) container vanilla buttercream frosting"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9-inch cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, vinegar, and vanilla extract in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and lard together in a mixing bowl using an electric mixer until creamy. Add eggs and beat to combine. Beat in flour mixture alternately with milk mixture and strawberry puree, making 3 dry and 2 wet additions. Beat for 1 minute. Pour evenly into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop cake pans 2 to 3 times on the countertop to break any air bubbles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the centers of the cakes comes out clean, 30 to 40 minutes. Remove from the oven and let cool on wire racks for 10 minutes. Turn cakes out onto the rack to cool completely, 15 to 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ice cooled cake using vanilla frosting between the layers and on the top and sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
