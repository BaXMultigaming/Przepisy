  "ingredients": [
    "2.25 cups creamy peanut butter",
    "0.5 cup butter",
    "4 cups confectioners' sugar",
    "3 cups crisp rice cereal",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Melt peanut butter and butter together in a medium saucepan over low heat; stir often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UAHJSfJ7gc114XsKVZymp7HHnuc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10670-Peanut-Butter-Balls-ddmfs-Step-2-ec25f6e294d84a2da8a0750bba2dd0a7.jpg"
      ],
      "image": "assets/images/10670/step_01.webp"
    },
    {
      "text": "Mix confectioners' sugar and cereal together in a large bowl until well combined. Pour in peanut butter mixture and stir until well combined; mixture will be crumbly but will hold together when pressed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vO2ROZuK8aJ3JM8Nbp7AYaN4z6o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10670-Peanut-Butter-Balls-ddmfs-Step-3-ef281eaeacfd407a81f018d0935beae0.jpg"
      ],
      "image": "assets/images/10670/step_02.webp"
    },
    {
      "text": "Form into 1-inch balls; place on parchment-lined cookie sheets. Cover with plastic wrap and refrigerate until firm, 3 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eFN5a3rYRE8M-g47YLeO6AYQQAE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10670-Peanut-Butter-Balls-ddmfs-Step-4-569c25931bf745b0b66b7e082540c8f0.jpg"
      ],
      "image": "assets/images/10670/step_03.webp"
    },
    {
      "text": "Melt chocolate in a double boiler over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ygs7812qWS6SNlB4TmqREZ3TkhE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10670-Peanut-Butter-Balls-ddmfs-Step-5-d699be4205ec412b826ad2b687bc9ab7.jpg"
      ],
      "image": "assets/images/10670/step_04.webp"
    },
    {
      "text": "Place 1 peanut butter ball into chocolate; use 2 forks to roll in mixture to coat. Let excess chocolate drip back into the pot; place on a wire rack set over parchment paper. Repeat with remaining peanut butter balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ztg4aJOc5A5fffjth6gW2Kbd11c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10670-Peanut-Butter-Balls-ddmfs-Step-6-c41f44f5e17540c9a396bf34a4bdd8e7.jpg"
      ],
      "image": "assets/images/10670/step_05.webp"
    },
    {
      "text": "Refrigerate until firm before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9SfqyHuj0yFqwQEHZpSDCbcj94I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10670-Peanut-Butter-Balls-ddmfs-4x3-f08556108ad744e5845595503d6fb01d.jpg"
