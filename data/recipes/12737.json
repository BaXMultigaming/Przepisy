  "ingredients": [
    "50 small clams in shell, scrubbed",
    "2 tablespoons extra virgin olive oil",
    "6 cloves garlic, minced",
    "1 cup white wine",
    "2 tablespoons butter",
    "0.5 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oIiq2vB-RIS_X9LX6uVTAHDq8os=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12737-scott-ures-clams-and-garlicddmfs-step-1-f1e4d36c62b74d0984eded7f9cd0884d.jpg"
      ],
      "image": "assets/images/12737/step_01.webp"
    },
    {
      "text": "Wash clams to remove any dirt or sand.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large pot over medium heat. Sauté garlic in hot oil until tender, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oKroUMjXCiCL48Oq3lEyTxM7Z_o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12737-scott-ures-clams-and-garlicddmfs-step-2-5192b571024248c78449a346fe9571f4.jpg"
      ],
      "image": "assets/images/12737/step_03.webp"
    },
    {
      "text": "Pour in white wine; bring to a boil. Cook until wine is reduced by half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z9MvC9GA9lg6I16M3IFmM2ZR0oQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12737-scott-ures-clams-and-garlicddmfs-step-3-f7fc4fcaf23346a88dc41e7c4dfea800.jpg"
      ],
      "image": "assets/images/12737/step_04.webp"
    },
    {
      "text": "Add clams, cover the pot, and steam just until clams start to open. Add butter, cover the pot, and continue cooking until most or all of the clams open. Discard any clams that do not open.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6c8P8zEIjgDix_e2WPIzxsZwz6A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12737-scott-ures-clams-and-garlicddmfs-step-5-e9c963a1466e40cf8944d92790f0a9d0.jpg"
      ],
      "image": "assets/images/12737/step_05.webp"
    },
    {
      "text": "Transfer clams and broth to 2 large bowls. Sprinkle with chopped parsley and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
