  "ingredients": [
    "cooking spray",
    "1 (8 ounce) package cream cheese, softened",
    "1 (6 ounce) can skinless, boneless salmon",
    "0.5 cup diced onion",
    "4 jalapenos, seeded and diced",
    "1 teaspoon chili powder",
    "1 (16 ounce) package wonton wrappers",
    "1 tablespoon olive oil, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Spray a baking dish lightly with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese, salmon, onion, jalapenos, and chili powder together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a teaspoon of the salmon mixture into each wonton wrapper. Dab the edges with water, fold in corners, and pinch together. Brush tops and sides of wontons with olive oil and place into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
