  "ingredients": [
    "6 ounces buttery round crackers, crumbled",
    "1 cup butter, melted",
    "2 tablespoons poppy seeds",
    "8 skinless, boneless chicken breast halves, cooked and cut into bite-sized pieces",
    "2 (10.75 ounce) cans condensed cream of chicken soup",
    "8 ounces sour cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the cracker crumbs, melted butter, and poppy seeds in a bowl. Layer the bottom of a 9x13-inch glass baking dish with 2/3 of the cracker mix. Mix the chicken breast pieces with cream of chicken soup and sour cream until thoroughly combined, and spoon the mixture on top of the crumb crust. Sprinkle remaining 1/3 of the cracker mix over the top of the chicken mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the casserole is hot and bubbling, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
