  "ingredients": [
    "0.5 cup mayonnaise",
    "0.33333334326744 cup white sugar",
    "0.25 cup milk",
    "2 tablespoons lemon juice",
    "1.5 tablespoons white vinegar",
    "2 teaspoons sour cream",
    "0.5 teaspoon freshly ground black pepper, or to taste",
    "1 pinch cayenne pepper, or to taste",
    "1 pound cabbage, cut into wedges",
    "2 carrots",
    "0.25 small onion, chopped, or to taste"
  ],
  "steps": [
    {
      "text": "Combine mayonnaise, sugar, milk, lemon juice, vinegar, sour cream, black pepper, and cayenne pepper in a small bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred cabbage, carrots, and onion in a food processor fitted with the grater attachment. Place vegetables in a large bowl; stir to combine. Stir mayonnaise dressing into cabbage mixture until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl with plastic wrap; refrigerate 2 hours to overnight. Stir before serving.",
      "section": null,
