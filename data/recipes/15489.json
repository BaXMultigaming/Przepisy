  "ingredients": [
    "0.5 cup butter",
    "0.75 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "8 ounces white chocolate, chopped",
    "1 (6.5 ounce) jar macadamia nuts, chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the butter and sugar. Stir in the egg and vanilla. Combine the flour, baking soda and salt, stir into the creamed mixture. Finally, stir in the white chocolate and nuts. Drop cookies by heaping teaspoonfuls onto an ungreased cookie sheet, about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven, until lightly browned. Cool on wire racks. When cool, store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
