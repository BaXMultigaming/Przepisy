  "ingredients": [
    "2 cups all-purpose flour",
    "0.33333334326744 cup white sugar",
    "1 tablespoon baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup cold unsalted butter",
    "0.5 cup heavy whipping cream",
    "2 eggs",
    "0.5 cup diced canned peaches",
    "0.25 cup chopped pecans",
    "1 egg",
    "2 tablespoons water",
    "1 teaspoon raw sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, ⅓ cup white sugar, baking powder, salt, and cinnamon in a large bowl; cut in butter with a pastry blender or 2 knives until pea-sized pieces form. Whisk heavy cream and 2 eggs together in a medium bowl until well combined; stir into flour-butter mixture until well combined. Stir in peaches and pecans until just incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a floured surface; pat into a round disc about ½-inch thick. Cut into 8 equal wedges; place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1 egg and water together in a small bowl; brush over wedges. Sprinkle with 1 teaspoon raw sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake scones in the preheated oven until golden brown, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
