  "ingredients": [
    "3 blackberries",
    "0.5 cup passion fruit juice",
    "3 tablespoons soy sauce",
    "1 tablespoon lemon juice",
    "1 tablespoon honey",
    "1 tablespoon finely chopped fresh parsley",
    "1 pinch sea salt",
    "1 pinch ground black pepper",
    "4 (6 ounce) ahi tuna steaks",
    "0.5 stalk green onion, thinly sliced"
  ],
  "steps": [
    {
      "text": "Crush blackberries in a bowl until smooth. Add passion fruit juice, soy sauce, lemon juice, honey, parsley, sea salt, and pepper and stir until marinade is thoroughly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tuna in a glass dish and pour marinade over top; flip several times to coat. Cover the dish with plastic wrap and marinate in the refrigerator for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove tuna from the marinade and shake off excess. Discard the remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a nonstick skillet over medium-high to high heat. Sear tuna in the hot skillet for 1 to 1 1/2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the skillet and slice into 1/4-inch thick slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
