  "ingredients": [
    "1 (14 ounce) can sweetened condensed milk",
    "0.5 cup key lime juice",
    "0.5 teaspoon grated lime zest",
    "5 ounces vanilla cookies (such as Marias Gamesa®)"
  ],
  "steps": [
    {
      "text": "Pour condensed milk, lime juice, and lime zest into a blender and blend until rich and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange a layer of cookies to cover the bottom of a 9x13-inch glass baking dish. Pour 1/4 of the lime cream over the cookies. Repeat layers to use up all cookies and cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate for 5 to 6 hours, or if you prefer a more chilled dessert, place in the freezer for 2 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
