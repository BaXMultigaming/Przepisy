  "ingredients": [
    "1 (8 ounce) can Pillsbury® Refrigerated Crescent Dinner Rolls",
    "8 thin slices cooked ham",
    "4 thin slices Cheddar cheese, cut into strips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate crescent dough into 8 triangles on a flat work surface. Place 1 slice ham on each triangle; place 2 cheese strips down center of ham. Fold in edges of ham to match dough triangle shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll up each crescent roll, starting at wide end, ending at triangle tip. Place rolls, tips down, on an ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 15 to 19 minutes. Remove from cookie sheet immediately; serve warm.",
      "section": null,
      "name": null,
