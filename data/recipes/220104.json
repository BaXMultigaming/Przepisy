  "title": "Strawberry Cheesecake Bites",
  "description": "Mini strawberry cheesecake bites dipped in melted semisweet chocolate are easy to make with a cream cheese filling and a crushed graham cracker topping.",
  "authors": [
    "Alex"
  ],
  "date_published": "2019-04-02T02:56:10-04:00",
