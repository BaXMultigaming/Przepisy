  "ingredients": [
    "2 teaspoons butter",
    "2 eggs",
    "1 slice sourdough bread, toasted",
    "Dijon mustard",
    "0.5 avocado - peeled, pitted, and sliced",
    "2 tablespoons grated Parmesan cheese, or more to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium heat. Add eggs and cook until whites are mostly firm. Break yolks and continue cooking until eggs are set and no longer runny, 2 to 3 more minutes.",
