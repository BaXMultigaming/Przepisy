  "ingredients": [
    "1 cup chopped onion",
    "0.5 cup chopped fresh cilantro",
    "3 limes, juiced",
    "4 tablespoons soy sauce",
    "2 tablespoons olive oil",
    "4 teaspoons dark brown sugar",
    "2 teaspoons dried oregano",
    "1.5 teaspoons red pepper flakes",
    "1 clove garlic, minced",
    "1 pound skirt steak, fat removed and flattened to 1/8-inch thickness",
    "4 corn tortillas"
  ],
  "steps": [
    {
      "text": "Combine onion, cilantro, lime juice, soy sauce, oil, sugar, oregano, pepper flakes, and garlic in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place steak in a baking pan; pour cilantro-lime marinade on top. Cover the pan with plastic wrap; refrigerate 1 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steak from marinade and shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill to desired doneness, 2 to 4 minutes per side. Rest steak 5 to 10 minutes; slice against the grain into ¼-inch slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add steak to tortillas; top with your favorite toppings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
