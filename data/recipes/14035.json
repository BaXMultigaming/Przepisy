  "ingredients": [
    "0.25 cup vegetable oil",
    "1 onion, chopped",
    "1 teaspoon salt",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon ground turmeric",
    "0.25 teaspoon ground cumin",
    "1 pound potatoes, peeled and cubed",
    "2 tomatoes, chopped"
  ],
  "steps": [
    {
      "text": "Heat oil in a medium skillet. Add onion; cook until lightly browned. Stir in salt, cayenne pepper, turmeric and cumin.",
      "section": null,
