  "ingredients": [
    "7 egg whites",
    "2.5 cups white sugar",
    "2 pounds ground almonds",
    "2 tablespoons almond extract",
    "1 cup chopped almonds",
    "0.33333334326744 cup granulated sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites and sugar until fluffy. Add the ground almond and almond extract, mixing well. Shape dough into walnut sized balls, roll in sugar and put a piece of almond or candied cherry on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees F) until firm. Bottom should be light brown.",
