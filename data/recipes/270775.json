  "ingredients": [
    "1 (16 ounce) package fresh strawberries, pureed",
    "0.5 cup white sugar",
    "1 tablespoon cornstarch",
    "1 lime, zested",
    "2 tablespoons fresh squeezed lime juice",
    "0.125 teaspoon salt",
    "0.25 cup butter",
    "4 egg yolks, beaten"
  ],
  "steps": [
    {
      "text": "Mix strawberry puree, sugar, cornstarch, lime zest, lime juice, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium-low heat. Remove from heat and stir in strawberry mixture until well combined. Add egg yolks, stir, and return to heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook over low heat, stirring constantly, until strawberry curd coats the back of a spoon and is slightly thickened, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
