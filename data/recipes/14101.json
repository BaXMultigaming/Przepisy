  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 500 degrees F (260 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G9zY1-iXZEPnJ_6VJzqnTjTBwWA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14101-Easy-Roasted-Peppers-ddmfs-step-1-311b90f20bdd48fd89978a57b42f7722.jpg"
      ],
      "image": "assets/images/14101/step_01.webp"
    },
    {
      "text": "Cut peppers into quarters. Remove and discard stems, seeds, and membranes. Place skin-side up in a large rimmed baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_cahoP9RiP7mff07FdhudG4JzGo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14101-Easy-Roasted-Peppers-ddmfs-step-2-2e85d9ecaf2941a7a2be2b392845890e.jpg"
      ],
      "image": "assets/images/14101/step_02.webp"
    },
    {
      "text": "Place skin-side up in a large rimmed baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XI9jjw1i4Ab3XWrV_mNXRRQ8I8Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14101-Easy-Roasted-Peppers-ddmfs-step-3-b688a09b60b84811a0e895027c71361d.jpg"
      ],
      "image": "assets/images/14101/step_03.webp"
    },
    {
      "text": "Roast in the preheated oven until the skin blisters and turns black, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FLQvmhScn-VRyr-GlHp3BA0kyOQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14101-Easy-Roasted-Peppers-ddmfs-step-4-c58516e30d524ac7ab453c908031c17b.jpg"
      ],
      "image": "assets/images/14101/step_04.webp"
    },
    {
      "text": "Remove from the oven and transfer peppers to a bowl. Cover with plastic wrap or a tea towel and let sit until cool enough to handle and skins peel away easily, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DQjd1xf55wdca3fhu6d_Xkq1-VA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14101-Easy-Roasted-Peppers-ddmfs-step-5-c6324fa9413f4821a478482e63ab7108.jpg"
      ],
      "image": "assets/images/14101/step_05.webp"
    },
    {
      "text": "Peel and discard skins.",
