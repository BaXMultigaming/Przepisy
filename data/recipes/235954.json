  "ingredients": [
    "1 pound suet",
    "1 pound brown sugar",
    "1 pound sultana raisins",
    "1 pound dark raisins",
    "1 pound dried currants",
    "4 ounces candied mixed fruit peel",
    "4 ounces chopped almonds",
    "0.25 cup ground allspice",
    "3 tablespoons ground nutmeg",
    "1 tablespoon salt",
    "3 pounds apples, grated"
  ],
  "steps": [
    {
      "text": "Melt suet in a saucepan over medium-low heat; strain liquid through a fine-mesh strainer into a bowl and discard solids. Refrigerate liquid until again solid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grate solid suet, measure 12 ounces of grated suet into a bowl, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar, sultana raisins, dark raisins, currants, fruit peel, almonds, allspice, nutmeg, and salt together in a large bowl; add grated suet and stir. Fold grated apple through the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl loosely with aluminum foil and allow it to sit at room temperature, stirring once daily, until fermented, 3 to 5 days. Refrigerate until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
