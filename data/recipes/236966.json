  "ingredients": [
    "1 (2 pound) loaf processed cheese food (such as Velveeta®), cut into 8 pieces",
    "2 (7 ounce) jars pimento peppers, drained and chopped",
    "0.25 cup tarragon vinegar",
    "0.25 cup mayonnaise",
    "0.25 cup unsalted butter",
    "0.25 cup white sugar"
  ],
  "steps": [
    {
      "text": "Combine cheese food, pimento peppers, tarragon vinegar, mayonnaise, butter, and sugar in a large saucepan or Dutch oven over low-heat; cook, stirring occasionally, until the cheese and butter are melted completely, about 20 minutes.",
