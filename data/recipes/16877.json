  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.75 cup ground flax seed",
    "0.75 cup oat bran",
    "1 cup brown sugar",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "2 teaspoons ground cinnamon",
    "0.75 cup skim milk",
    "2 eggs, beaten",
    "1 teaspoon vanilla extract",
    "2 tablespoons vegetable oil",
    "2 cups shredded carrots",
    "2 apples, peeled, shredded",
    "0.5 cup raisins",
    "1 cup chopped mixed nuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease muffin pan or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together flour, flax seed, oat bran, brown sugar, baking soda, baking powder, salt and cinnamon. Add the milk, eggs, vanilla and oil; mix until just blended. Stir in the carrots, apples, raisins and nuts. Fill prepared muffin cups 2/3 full with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 F (175 degrees C) for 15 to 20 minutes, or until a toothpick inserted into the center of a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
