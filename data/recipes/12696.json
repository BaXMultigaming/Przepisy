  "ingredients": [
    "3 large eggs, beaten",
    "0.75 cup white sugar",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "2.5 cups scalded milk",
    "3 drops yellow food coloring",
    "1 (9 inch) frozen pie crust, thawed",
    "1 large egg white, beaten",
    "0.25 teaspoon ground nutmeg",
    "toasted coconut flakes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together eggs, sugar, vanilla, and salt in a large bowl; stir well. Blend in scalded milk. Stir in 3 drops yellow food coloring for more color.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush the bottom and sides of pie crust with beaten egg white to help prevent a soggy crust. Pour custard mixture into pie crust. Sprinkle with nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted near the center comes out clean, 30 to 35 minutes. Sprinkle toasted coconut flakes on top if using. Cool on a wire rack.",
      "section": null,
      "name": null,
