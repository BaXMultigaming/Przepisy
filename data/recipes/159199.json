  "ingredients": [
    "2 tablespoons olive oil",
    "1 small onion, diced",
    "2 cloves garlic, minced",
    "1.5 cups chicken broth",
    "4 teaspoons white sugar",
    "1 tablespoon Dijon mustard",
    "1 tablespoon cider vinegar",
    "4 cups stemmed, torn and rinsed kale",
    "0.25 cup dried cranberries",
    "salt and pepper to taste",
    "0.25 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat. Add onion and garlic; cook and stir until onion softens and turns translucent, about 5 minutes. Add chicken broth, sugar, mustard, and vinegar; bring to a boil over high heat. Stir in kale; cook, covered, until wilted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add dried cranberries; boil, uncovered, until liquid reduces by about half and cranberries soften, about 15 minutes. Season with salt and black pepper. Sprinkle with sliced almonds before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
