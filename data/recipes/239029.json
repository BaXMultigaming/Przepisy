  "ingredients": [
    "1 pound ground beef, or to taste",
    "16 slices pepperoni, or to taste",
    "1 (14.5 ounce) can diced tomatoes",
    "1 cup water",
    "2 (3 ounce) packages beef-flavored ramen noodles",
    "1 green bell peppers, cut into strips",
    "1 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Add ground beef and pepperoni; cook and stir until beef is completely browned, 5 to 7 minutes. Stir in tomatoes, water, and ramen seasoning packets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break ramen noodle blocks in half; add to beef mixture with bell pepper. Cook until noodles soften, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, sprinkle mozzarella cheese over beef mixture, cover the skillet, let sit until cheese melts, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
