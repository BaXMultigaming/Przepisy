  "ingredients": [
    "4 slices thick-cut bacon, sliced into 1/4-inch strips, or more to taste",
    "1 pound Brussels sprouts, trimmed and halved lengthwise",
    "1 clove garlic, thinly sliced, or more to taste",
    "0.5 cup chicken stock",
    "1 tablespoon butter, or to taste",
    "1 tablespoon balsamic vinegar, or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large cast iron skillet over medium heat until just crisp, 5 to 7 minutes. Transfer to a paper towel-lined plate, reserving bacon grease in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5oZQaK_d0FfJoP_TtDvTvufGXTs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235449-SkilletBraisedBrusselsSprouts-mfs-Step-1-f8cb94400ac94eb58dfcf4281e58b30d.jpg"
      ],
      "image": "assets/images/235449/step_01.webp"
    },
    {
      "text": "Place Brussels sprouts in the skillet with the cut-sides down. Increase heat to medium-high and saute in the bacon grease until lightly browned, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fiYrBzchB3YYalkURJ54NNjXU4w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235449-SkilletBraisedBrusselsSprouts-mfs-Step-2-9c4745ad37204a0a9204e50e8c514fd7.jpg"
      ],
      "image": "assets/images/235449/step_02.webp"
    },
    {
      "text": "Add garlic and saute until fragrant, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XCqdtEq47TGLY-WzpTHiPuleaEw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235449-SkilletBraisedBrusselsSprouts-mfs-Step-3-351bd1545d9c408ba4b65859743fe387.jpg"
      ],
      "image": "assets/images/235449/step_03.webp"
    },
    {
      "text": "Pour in chicken stock and cover skillet with a lid; simmer until Brussels sprouts are bright green, 3 to 5 minutes. Remove the lid and continue simmering, until liquid is evaporated and sprouts are at desired tenderness, 3 to 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YzvIX2irADtmQH_tT450UB8CoiQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235449-SkilletBraisedBrusselsSprouts-mfs-Step-4-6e396f8d3e2148a49f8ab7a43186d7fb.jpg"
      ],
      "image": "assets/images/235449/step_04.webp"
    },
    {
      "text": "Remove skillet from the heat. Add bacon, butter, balsamic vinegar, salt, and pepper; stir until butter is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0HOVdJ7RVouY0IZ9rxKUoycUruA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235449-skillet-braised-brussels-sprouts-DDMFS-4x3-14635362dfca472780df3df0e6ad8d79.jpg"
      ],
      "image": "assets/images/235449/step_05.webp"
    }
  ],
