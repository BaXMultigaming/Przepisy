  "ingredients": [
    "1 pound bay scallops, rinsed and patted dry",
    "2 teaspoons smoked paprika",
    "2 teaspoons chili powder",
    "2 teaspoons olive oil",
    "1 teaspoon garlic powder",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon cayenne red pepper"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bay scallops, smoked paprika, chili powder, olive oil, garlic powder, black pepper, and cayenne pepper in a bowl; stir until evenly combined. Transfer to the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry until scallops are cooked through, about 8 minutes, shaking basket halfway through cooking time.",
