  "ingredients": [
    "1.5 cups chopped carrots",
    "1 cup chopped celery",
    "0.5 yellow onion, chopped",
    "1 leek, chopped",
    "1 shallot, diced",
    "6 cups vegetable broth",
    "3 teaspoons vegetable bouillon (such as Better Than Bouillon®)",
    "0.25 cup parsley",
    "2 bay leaves",
    "0.5 teaspoon dried thyme",
    "salt and ground black pepper to taste",
    "1 (16 ounce) package rotini pasta",
    "1 (16 ounce) package chicken-flavored seitan"
  ],
  "steps": [
    {
      "text": "Saute carrots, celery, onion, leek, and shallot in a soup pot over medium-high heat until onion is translucent and carrots lose their crunch, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour broth over vegetables in the pot and bring to a rolling boil. Dissolve bouillon into broth; reduce heat to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add parsley, bay leaves, thyme, salt, and pepper. Cook until carrots are soft, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pasta and seitan and cook until pasta is al dente, another 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
