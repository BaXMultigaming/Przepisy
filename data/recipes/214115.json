  "ingredients": [
    "1.25 cups crushed graham crackers",
    "0.25 cup melted butter",
    "1 pound fresh strawberries, halved lengthwise",
    "0.75 cup white sugar",
    "0.75 cup water",
    "0.5 cup diced rhubarb",
    "3 tablespoons cornstarch",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Mix graham cracker crumbs and melted butter together in a bowl; press into the bottom of a 9-inch pie dish. Line bottom of pie crust with one layer of strawberry halves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place remaining strawberries in a saucepan; crush (there should be about 1 cup of crushed berries). Stir sugar, water, rhubarb, and cornstarch into crushed berries; bring to a boil over medium-low heat, stirring often, until mixture thickens and becomes translucent. Turn off the heat, let mixture stand until slightly cooled, about 2 minutes; stir in lemon juice. Pour mixture over strawberry halves in pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate until completely chilled, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
