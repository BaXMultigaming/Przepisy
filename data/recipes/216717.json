  "ingredients": [
    "1.5 cups water",
    "1 small onion, chopped",
    "1 small tomato, chopped",
    "0.5 cup lentils",
    "1 tablespoon vegetable oil",
    "2 teaspoons ground cumin",
    "1 teaspoon salt",
    "2 small yellow potatoes, cubed"
  ],
  "steps": [
    {
