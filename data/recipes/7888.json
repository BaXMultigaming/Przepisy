  "total_time": "PT0M",
  "yield": [
    "36",
    "3 fruit cakes"
  ],
  "categories": [
    "Dessert"
  ],
  "cuisines": [],
  "regions": [],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 cups ground almonds",
    "3 cups red candied cherries",
    "1.5 cups green candied cherries",
    "1 (8 ounce) package diced candied citron",
    "6 cups golden raisins",
    "8 ounces candied pineapple, diced",
    "1 cup all-purpose flour",
    "1 cup shortening",
    "1 cup all-purpose flour",
    "2.666699886322 cups white sugar",
    "8 egg yolks",
    "4 teaspoons almond extract",
    "0.66670000553131 cup brandy",
    "0.66670000553131 cup milk",
    "4.5 cups all-purpose flour",
    "8 egg whites",
    "1.5 teaspoons cream of tartar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C). Place a pan of water in oven. Grease thoroughly and line with heavy brown paper one set of tier pans (one 9 inch, one 7 inch, and one 5 inch).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine ground almonds and fruits. Dredge with one cup flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together 1 cup flour and shortening. Gradually blend in white sugar. Beat in egg yolks and almond flavoring; beat until very light and fluffy. Mix together brandy and milk; add alternately with 4 1/2 cups flour to creamed mixture. Make 3 dry and 2 liquid additions, combining lightly after each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, beat egg whites with cream of tartar to form stiff but moist peaks. Fold into batter. Fold in floured fruit mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 2 1/2 to 3 1/2 hours, depending on size of pan. Bake each cake until it tests done with a toothpick. Remove from pans, and lift off paper. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
