  "ingredients": [
    "1 cup milk",
    "2 teaspoons ground cinnamon",
    "1 teaspoon vanilla extract",
    "1 teaspoon butter, or as needed",
    "4 slices white bread, divided"
  ],
  "steps": [
    {
      "text": "Whisk milk, cinnamon, and vanilla together in a shallow bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently press two bread slices into milk mixture until lightly coated on both sides (do not soak).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook coated slices in melted butter until golden brown and somewhat firm, 5 to 8 minutes per side. Repeat for remaining bread slices.",
