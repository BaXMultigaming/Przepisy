  "ingredients": [
    "4 slices bacon",
    "2 (15 ounce) cans green beans, drained",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 (8 ounce) can water chestnuts, drained and chopped",
    "0.75 cup milk",
    "ground black pepper to taste",
    "1.3333300352097 cups French-fried onions"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix green beans, condensed soup, water chestnuts, crumbled bacon, milk, and black pepper together in a 1 1/2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir casserole and top with French fried onions. Bake until onions are golden brown, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
