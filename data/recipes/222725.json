  "ingredients": [
    "1 cup white sugar",
    "0.75 cup canola oil",
    "0.5 cup red wine vinegar",
    "1 tablespoon soy sauce",
    "salt and ground black pepper, to taste",
    "1 (3 ounce) package ramen noodles",
    "0.25 cup unsalted butter",
    "1 cup chopped pecans",
    "1 bunch broccoli, coarsely chopped",
    "1 head romaine lettuce, torn into bite-size pieces",
    "4 green onions, chopped"
  ],
  "steps": [
    {
      "text": "Add sugar, oil, vinegar, soy sauce, salt, and black pepper to a jar with a tight-fitting lid; shake until well blended. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break ramen noodles into small pieces; set aside. Discard flavor packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Add pecans and noodles; cook and stir until browned, about 5 minutes. Drain on paper towels; let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss broccoli, romaine lettuce, green onions, pecans, and noodles together in a bowl. Add 1 cup, or more, dressing; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
