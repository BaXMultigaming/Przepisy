  "ingredients": [
    "1 teaspoon butter",
    "1 teaspoon olive oil",
    "12 Brussels sprouts, trimmed and thinly sliced",
    "1 tablespoon lemon juice",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat butter and olive oil in a skillet over high heat until butter is melted and begins to brown, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Brussels sprouts and lemon juice into butter and oil; cook, stirring constantly, until sprouts are just heated through and starting to soften, about 45 seconds. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with salt and pepper and serve.",
      "section": null,
