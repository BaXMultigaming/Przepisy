  "ingredients": [
    "1 tablespoon olive oil",
    "1 pound blanched almonds",
    "0.5 cup white sugar",
    "1 tablespoon ground cinnamon",
    "0.375 teaspoon sweet paprika",
    "0.25 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almonds and olive oil in a bowl; toss to coat. Spread almonds in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until toasted, about 15 minutes. Allow almonds to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While almonds are baking, mix sugar, cinnamon, paprika, and cayenne pepper in a small bowl. Sprinkle spice mixture over almonds and toss again. Spread almonds in a single layer and continue to bake until spices are fragrant, 5 to 10 minutes. Cool before serving.",
      "section": null,
