  "ingredients": [
    "cooking spray",
    "1 sweet potato",
    "2 cups biscuit mix (such as Pioneer®)",
    "1.25 cups brown sugar",
    "1 cup milk",
    "1 zucchini, grated",
    "2 eggs",
    "2 tablespoons margarine",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon vanilla extract, or to taste",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Spray muffin tins with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sweet potato in the microwave until tender, about 6 minutes. Peel and dice sweet potato; transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix biscuit mix, brown sugar, milk, zucchini, eggs, margarine, cinnamon, vanilla extract, and nutmeg into sweet potato. Spoon 1/3 cup batter into each muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
