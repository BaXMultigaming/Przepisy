  "ingredients": [
    "10 ounces ground turkey",
    "3 turkey Italian sausages, casings removed",
    "1 cup chopped green bell pepper",
    "0.66666668653488 cup chopped onion",
    "4 stalks celery, thinly sliced",
    "2 (28 ounce) cans stewed tomatoes",
    "6 zucchini, cut into cubes",
    "4 (10.75 ounce) cans low-sodium chicken broth",
    "1 tablespoon Italian seasoning",
    "0.5 teaspoon sea salt",
    "0.5 teaspoon dried tarragon",
    "0.5 teaspoon garlic powder",
    "ground black pepper to taste",
    "0.25 cup grated Parmesan cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Cook and stir ground turkey, sausage, bell pepper, onion, and celery in a large pot over medium-high heat until meat is no longer pink and vegetables are tender, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomatoes, zucchini, chicken broth, Italian seasoning, sea salt, tarragon, garlic powder, and black pepper into turkey mixture; bring to a boil, reduce heat to low, and simmer until flavors combine, about 1 hour. Ladle soup into bowls and garnish with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
