  "ingredients": [
    "0.5 cup white sugar",
    "0.5 cup milk",
    "2 tablespoons vegetable oil",
    "1 egg",
    "1 cup all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "2 cups fresh cranberries, chopped",
    "0.75 cup all-purpose flour",
