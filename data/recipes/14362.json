  "ingredients": [
    "1.5 cups macaroni",
    "2 tablespoons cider vinegar",
    "1 cup shredded Cheddar cheese",
    "0.5 cup chopped green bell pepper",
    "0.25 cup chopped celery",
    "3 tablespoons thinly sliced green onion",
    "8 cherry tomatoes",
    "1 cup mayonnaise",
    "salt and pepper to taste",
    "0.25 teaspoon Beau Monde ™ seasoning"
  ],
  "steps": [
    {
      "text": "In a large pot of salted boiling water, cook pasta until al dente, rinse under cold water and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine pasta and vinegar. Mix well and allow to sit 15-20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cheese, peppers, celery, green onions, tomatoes, mayonnaise and seasonings. Mix well and refrigerate until chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
