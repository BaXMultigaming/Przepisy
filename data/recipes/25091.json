  "title": "Lemon Square Bars",
  "description": "This lemon bars recipe makes a bright-flavored, zesty lemon filling layered on a homemade buttery crust for the ultimate sweet and tangy treat.",
  "authors": [
    "RCOMP"
  ],
  "date_published": "2000-08-14T18:14:05-04:00",
