  "title": "Back-to-School Cookies",
  "description": "Sugar cookies are shaped into “pencils” and coated in different colors of icing in these fun back-to-school cookies the kids will love.",
  "authors": [
    "Barbara Sauermann"
  ],
  "date_published": "2020-06-19T00:03:35-04:00",
