  "title": "Grandma&#39;s Polish Perogies",
  "description": "These Polish perogies are made with a homemade dough recipe and filled with potatoes and cheese for delicious dumplings that are easy to customize.",
  "authors": [
    "STEPH577"
  ],
  "date_published": "2019-04-02T02:47:25-04:00",
