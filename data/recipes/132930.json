  "ingredients": [
    "1 pound asparagus spears, ends trimmed",
    "0.33333334326744 cup margarine or butter",
    "3 tablespoons sesame seed",
    "1 tablespoon lemon juice, or to taste",
    "1 tablespoon chopped fresh parsley",
    "Salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Place asparagus in a large pot filled with 1 inch water; bring to a boil. Cook until tender but still bright green, about 5 minutes, longer if asparagus spears are thick. Drain; place in a serving dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt margarine in a skillet over medium heat. Add sesame seeds; cook, stirring frequently, until golden brown and toasted, about 2 minutes. Stir in lemon juice and parsley; season with salt and black pepper. Pour sauce over asparagus.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
