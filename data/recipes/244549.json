  "ingredients": [
    "1 cup brown sugar",
    "0.5 cup butter, softened",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "2 cups spelt flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.75 cup cocoa nibs",
    "0.5 cup dried cherries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter together in a bowl using an electric mixer until smooth and creamy; add egg and vanilla extract and beat until smooth. Add flour, baking soda, and salt; beat until dough is blended. Fold cocoa nibs and cherries it batter. Drop batter by the spoonful onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are beginning to brown around the edges, 10 to 12 minutes. Cool cookies on baking sheet for 2 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
