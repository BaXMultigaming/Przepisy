  "title": "Spelt Cherry Cookies",
  "description": "Spelt cookies with dried cherries and cocoa nibs are a tasty alternative to the traditional chocolate chip cookie and are quick and easy to make.",
  "authors": [
    "hgcv"
  ],
  "date_published": "2020-03-05T00:13:27-05:00",
