  "ingredients": [
    "1 cup white sugar",
    "0.5 cup all-purpose flour",
    "1 stick butter, melted",
    "2 eggs, beaten",
    "2 teaspoons vanilla extract",
    "1 cup chopped cocktail peanuts",
    "1 cup chocolate chips",
    "1 (9 inch) unbaked pie shell"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and flour in a large bowl. Mix in butter, eggs, and vanilla extract. Fold in peanuts and chocolate chips. Pour into the pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown but slightly gooey in the center, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
