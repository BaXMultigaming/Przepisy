  "ingredients": [
    "5 cups water",
    "1 (750 milliliter) bottle cake-flavored vodka",
    "1.5 pounds fresh pineapple spears",
    "2 cups white sugar"
  ],
  "steps": [
    {
      "text": "Combine water, vodka, pineapple, and sugar in a multi-functional pressure cooker (such as an Instant Pot). Close and lock the lid. Select high pressure according to the manufacturer's instructions. Set timer for 30 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pineapple to a blender; blend until smooth. Return pineapple to the pot; stir to combine. Pour moonshine into sterilized bottles. Store in a dark place. Chill before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
