  "ingredients": [
    "1 (8.8 ounce) package speculoos cookies (such as Lotus Biscoff®)",
    "0.25 cup butter, melted",
    "0.25 cup oil",
    "0.25 cup brown sugar",
    "0.25 cup white sugar",
    "2 teaspoons honey",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Place cookies in food processor and process to fine crumbs. With processor running on low speed, slowly add butter, oil, brown sugar, white sugar, honey, vanilla extract, and salt. Add water 1 tablespoon at a time until desired consistency is reached.",
