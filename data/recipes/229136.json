  "ingredients": [
    "2 cups whole wheat flour",
    "1.5 cups lowfat margarine",
    "1 cup white sugar",
    "3 apples - peeled, cored, and cut into wedges",
    "3 pears - peeled, cored, and cut into wedges",
    "1 cup blackberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease three 9-inch pie tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, margarine, and sugar together in a large bowl with fingers until mixture is crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide layers of apples and pears evenly between the pie tins; sprinkle blackberries evenly over tops. Sprinkle flour mixture evenly over fruit mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fruit is soft and topping is light brown, about 40 minutes.",
      "section": null,
