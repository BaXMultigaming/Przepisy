  "ingredients": [
    "1 large head cabbage, shredded",
    "1 green bell pepper, diced",
    "1 onion, finely diced",
    "1.5 large carrots, shredded",
    "1 cup white wine vinegar",
    "1 cup vegetable oil",
    "1 cup white sugar"
  ],
  "steps": [
    {
      "text": "Combine cabbage, bell pepper, onion, and carrots in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together vinegar, oil, and sugar in a medium bowl. Pour enough dressing over cabbage mixture to coat; mix well. Cover and refrigerate for 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain any excess liquid, toss, and serve cold.",
