  "ingredients": [
    "4 quarts turkey broth",
    "3 cubes chicken bouillon",
    "1 pound thick-cut bacon, cut into 1-inch square pieces",
    "2 tablespoons minced garlic",
    "0.5 teaspoon ground black pepper",
    "1 pound cubed cooked turkey",
    "1 red onion, sliced",
    "1 cup barley",
    "2 teaspoons chopped fresh rosemary",
    "1 teaspoon salt",
    "1 teaspoon Italian seasoning",
    "1 pound okra, sliced",
    "0.5 bunch fresh parsley, chopped"
  ],
  "steps": [
    {
      "text": "Combine turkey broth and chicken bouillon in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a skillet over medium heat; add garlic and black pepper. Cook and stir until bacon is crispy, about 10 minutes. Transfer to a paper towel-lined plate; blot to remove as much fat as possible.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir bacon mixture into the slow cooker. Add turkey, red onion, barley, rosemary, salt, and Italian seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook, stirring every half hour, on Low for 7 1/2 hours (or high for 3 1/2 hours). Stir okra and parsley into soup and continue cooking for 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool soup to room temperature and refrigerate, 8 hours to overnight. Skim any solid fat off the top and heat soup on the stovetop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
