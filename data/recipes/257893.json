  "title": "Turkey and Okra Soup with Barley and Bacon",
  "description": "Turkey, bacon, and garlic are simmered with herbs in this barley and okra soup in a slow cooker that is a great warm meal on cold evenings.",
  "authors": [
    "Ed Haley"
  ],
  "date_published": "2018-06-08T10:43:05-04:00",
