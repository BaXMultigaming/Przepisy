  "ingredients": [
    "1 (18 ounce) package refrigerated sugar cookie dough",
    "1 (8 ounce) package cream cheese, softened",
    "0.33333334326744 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "1 pint fresh strawberries, sliced",
    "1 pint fresh blueberries",
    "2 bananas, sliced",
    "2 kiwis, peeled and sliced",
    "0.5 cup orange marmalade",
    "2 tablespoons water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 12-inch pizza pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press cookie dough into the prepared pizza pan; prick holes in dough with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 10 to 15 minutes. Allow cookie crust to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, sugar, and vanilla extract in a bowl until smooth; spread over cooled crust. Arrange strawberries, blueberries, bananas, and kiwi decoratively over cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix orange marmalade and water in a small bowl; spoon mixture over fruit. Chill pizza for 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
