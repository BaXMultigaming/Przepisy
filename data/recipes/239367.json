  "ingredients": [
    "1 (10 pound) turkey, completely thawed",
    "Crisco® Original No-Stick Cooking Spray",
    "1 tablespoon salt",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon black pepper",
    "0.5 cup chicken broth",
    "0.5 cup butter",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon onion powder",
    "1 tablespoon garlic powder",
    "1 tablespoon Cajun seasoning",
    "Several dashes hot pepper sauce",
    "2 teaspoons salt",
    "0.25 teaspoon ground cayenne pepper",
    "2 gallons Crisco® Pure Peanut Oil"
  ],
  "steps": [
    {
      "text": "Pat turkey dry with paper towels; coat completely with no-stick cooking spray. Combine rub ingredients in small bowl; rub over turkey.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine spice injection mixture ingredients in small saucepan. Cook and stir over medium heat until butter is melted. Let cool to barely warm. Inject the mixture with spice injector into several spots on both sides of the turkey breast and thighs, making sure not to inject too much into any one spot. Cover and chill overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry according to fryer manufacturer's directions using peanut oil. Reference package for additional information.",
      "section": null,
