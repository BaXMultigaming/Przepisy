  "ingredients": [
    "0.5 cup mayonnaise",
    "0.5 cup sour cream",
    "0.5 cup diced onion",
    "1 tablespoon ketchup",
    "2 teaspoons prepared mustard",
    "1.5 teaspoons Worcestershire sauce",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Whisk mayonnaise, sour cream, onion, ketchup, mustard, and Worcestershire sauce together in a bowl until well combined; season with salt and black pepper. Refrigerate until ready to toss with potatoes.",
