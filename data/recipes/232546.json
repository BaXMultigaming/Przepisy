  "ingredients": [
    "0.5 cup butter",
    "1 small onion, finely diced",
    "1 small carrot, finely diced",
    "1 stalk celery, diced",
    "1 clove garlic, minced",
    "0.5 cup all-purpose flour",
    "4 russet potatoes, diced",
    "2 cooked rotisserie chicken breast halves, shredded",
    "1.5 cups white corn kernels",
    "1.5 cups yellow corn kernels",
    "4 cups chicken stock, divided",
    "2.5 cups half-and-half",
    "1 pinch nutmeg",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan over medium heat; cook and stir onion, carrot, celery, and garlic in hot butter until slightly softened, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UvTovFrgSwNiRNaIa67omINcS68=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232546_EasyChickenandCornChowder_ddmfs_step1_4x3_1800-3f4288778b2f41f28ec1fc0c2258b641.jpg"
      ],
      "image": "assets/images/232546/step_01.webp"
    },
    {
      "text": "Stir flour into mixture to make a paste; cook until lightly browned and flour gives off a slightly toasted smell, about 5 minutes. Watch carefully as flour burns easily. Remove saucepan from heat and set aside to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pXdpVjz6IB3rcqcNjR65MBVNZUo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232546_EasyChickenandCornChowder_ddmfs_step2_4x3_1817-76d53e1abfab453f89c9d641a9b7245b.jpg"
      ],
      "image": "assets/images/232546/step_02.webp"
    },
    {
      "text": "Meanwhile, stir together potatoes, chicken, white and yellow corn, and 3 cups stock in a large soup pot over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk remaining 1 cup stock into vegetables and flour mixture until thoroughly combined. Stir mixture into the soup pot; bring to a simmer. Cook and stir until thick, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_g63-3zGE3AbDuDBBj6C7iBLAtc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232546_EasyChickenandCornChowder_ddmfs_step5_4x3_1825-c22df6990f864187be999fd0d521806d.jpg"
      ],
      "image": "assets/images/232546/step_04.webp"
    },
    {
      "text": "Stir half-and-half, nutmeg, salt, and black pepper into chowder. Bring to a boil, reduce heat to low, and simmer until potatoes are tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wCTxLV4S1VUAKhtH364xj40sGX8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232546_EasyChickenandCornChowder_ddmfs_step7_4x3_1837-cb6df48ca8a04ef4bcd144eeb77d4506.jpg"
      ],
