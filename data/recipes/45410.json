  "ingredients": [
    "1 pound sliced bacon",
    "1.5 pounds ground round",
    "1 (15 ounce) can baked beans with pork",
    "1 (15.5 ounce) can white beans, drained",
    "1 (15.5 ounce) can butter beans, drained",
    "1 cup packed dark brown sugar",
    "1 cup barbeque sauce",
    "1 (1 ounce) envelope dry onion soup mix"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet over medium heat, cook bacon until crisp. Drain, crumble, and set aside. In the same skillet, cook and crumble the ground round until evenly browned. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large deep casserole dish or Dutch oven, combine the bacon, beef, baked beans, white beans, and butter beans. Stir in the brown sugar, barbeque sauce, and onion soup mix until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, for 1 hour in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
