  "ingredients": [
    "0.5 cup butter or margarine",
    "0.5 cup packed brown sugar",
    "4 tablespoons golden syrup or corn syrup",
    "3 cups rolled oats",
    "0.25 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan over low heat, combine the butter, brown sugar and golden syrup. Cook, stirring occasionally, until butter and sugar have melted. Stir in the oats and raisins until coated. Pour into an 7 or 8 inch square baking pan. The mixture should be about 1 inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes in the preheated oven, or until the top is golden. Cut into squares, then leave to cool completely before removing from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
