  "ingredients": [
    "1 pound fresh cranberries",
    "2 cups white sugar",
    "1.5 cups water",
    "2 (3 ounce) packages cherry-flavored gelatin (such as JELL-O®)",
    "1.5 cups chopped celery",
    "1.5 cups chopped, peeled apple",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Stir cranberries, sugar, and water together in a saucepan; cook over medium heat, stirring often, until most of the berries have popped open, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove saucepan from heat. Stir gelatin into the cranberries mixture until dissolved completely; add celery, apple, and pecans and stir. Pour into a glass 13x9-inch dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate until set in the center, 10 to 12 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
