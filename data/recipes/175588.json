  "ingredients": [
    "1 pound confectioners' sugar",
    "2.5 cups all-purpose flour",
    "2.5 teaspoons baking powder",
    "2.5 teaspoons ground cloves",
    "3 eggs, lightly beaten"
  ],
  "steps": [
    {
      "text": "Sift together the sugar, flour, baking powder, and cloves. Make a well in the sugar mixture, and pour the eggs into the well. Work the eggs into the mixture, first with a fork, then with your hands, until you have a smooth dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking sheet with foil. Roll dough into 1 inch balls and place on the prepared baking sheet, 2 inches apart. Flatten each cookie with the bottom of a glass. Cover with a clean dish towel and let rest overnight. Cookies will spread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 15 minutes. Remove cookies from pan immediately as they come out of the oven or they will stick. Cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
