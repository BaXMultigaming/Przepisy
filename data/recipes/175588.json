  "title": "Dead Bones (L'Ossa Morte)",
  "description": "This simple, clove-spiced Sicilian cookie rises overnight and is baked the following day.",
  "authors": [
    "BILLSFRAN"
  ],
  "date_published": "2015-11-19T02:11:39-05:00",
