    "1 (15 ounce) can garbanzo beans, drained, liquid reserved",
    "1 tablespoon lemon juice",
    "1 tablespoon olive oil",
    "1 clove garlic, crushed",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon salt",
    "2 drops sesame oil, or to taste"
