  "ingredients": [
    "1 tablespoon olive oil",
    "0.25 cup vegan mayonnaise (such as Follow Your Heart® Veganaise®)",
    "2 tablespoons water",
    "0.25 cup bread crumbs, or as needed",
    "1 (12 ounce) package tofu, sliced into 1/2-inch pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat the inside of a 9x13-inch baking dish with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mayonnaise and water together in a bowl. Place bread crumbs in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip tofu slices in the mayonnaise mixture; press tofu into the bread crumbs until fully coated. Place coated tofu in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tofu is fully cooked and breading is browned, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
