  "ingredients": [
    "1 (12 inch) pre-baked Italian pizza crust",
    "0.5 cup prepared Thai peanut sauce*",
    "2 tablespoons peanut butter",
    "2 cups shredded chicken*",
    "2 medium carrots, peeled and grated",
    "3 green onions, thinly sliced",
    "0.25 cup chopped roasted peanuts",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Adjust oven rack to lowest position, and heat oven to 450 degrees. Place crust on a cookie sheet. Mix peanut sauce and peanut butter, then spread 2/3 of the sauce over the pizza crust; toss remaining 1/3 of the sauce with the shredded chicken. Spread chicken over pizza.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until the crust is crisp and golden, 10 to 12 minutes. Remove from oven, and top with carrots, green onions, peanuts and cilantro. Cut into 6 slices and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
