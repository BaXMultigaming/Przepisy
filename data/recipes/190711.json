  "ingredients": [
    "6 slices bacon, chopped",
    "3 tablespoons butter",
    "1 red onion, chopped",
    "2 pounds fresh green beans, trimmed and snapped",
    "8 small new potatoes, diced",
    "1 large clove garlic, minced",
    "0.25 cup chicken broth",
    "1.5 teaspoons white balsamic vinegar",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_GitlK4vjXL3yJ79kM4fK1308lM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-190711-southern-green-beans-DDMFS-step-01-1b0590e5a3d3437fbcd5b8aee16c164c.jpg"
      ],
      "image": "assets/images/190711/step_01.webp"
    },
    {
      "text": "Cook chopped bacon in a skillet over medium heat, stirring occasionally, until evenly browned, 8 to 10 minutes. Drain bacon pieces on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vec0ucAZkMSIjXKzbgEqbIt8maU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-190711-southern-green-beans-DDMFS-step-02-5a1e808fce324c34b6b0fe5c6aa630fe.jpg"
      ],
      "image": "assets/images/190711/step_02.webp"
    },
    {
      "text": "Melt butter in a skillet with a lid over medium-low heat. Add onion; cook and stir until onion is translucent, about 5 minutes. Stir in cooked bacon, green beans, potatoes, garlic, and chicken broth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CJRcpkiP5moFG0ZGEFTEb88ri-I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-190711-southern-green-beans-DDMFS-step-03-8bc0c117cf9f4150b57e55f2eb1d7faa.jpg"
      ],
      "image": "assets/images/190711/step_03.webp"
    },
    {
      "text": "Bring to a boil, cover, and simmer over low heat until green beans are tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/59ZZQvc21JIGXSTtGp5YF-J7vdI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-190711-southern-green-beans-DDMFS-step-04-227d40b4247a4843963e39a74170bcad.jpg"
      ],
      "image": "assets/images/190711/step_04.webp"
    },
    {
      "text": "Sprinkle with vinegar, salt, and pepper; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SaK6iVuC8Sm6xRlI-HCn1K3gFDU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-190711-southern-green-beans-DDMFS-beauty-4x3-5eccd9a6483c4cae8de77865858c3162.jpg"
