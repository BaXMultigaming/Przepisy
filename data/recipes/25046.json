  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup unsalted butter, softened",
    "0.75 cup white sugar",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "2 cups jumbo semisweet chocolate chips",
    "1 cup white chocolate chips",
    "1.5 cups chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, and salt together into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar with an electric mixer in a large bowl until smooth. Add eggs, one at a time, mixing well after each addition. Stir in vanilla. Gradually mix in dry ingredients until a soft dough forms. Stir in chocolate chips, white chocolate chips, and walnuts until incorporated. Drop dough by spoonfuls onto ungreased baking sheets, spacing about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden brown, 8 to 11 minutes. Remove from the oven and cool on the baking sheets for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
