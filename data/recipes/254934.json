  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 12 muffin cups with cooking spray or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, baking soda, and salt into a bowl. Combine sugar, cream cheese, table cream, eggs, and 1/4 cup vegetable oil plus 1 teaspoon vegetable oil in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold flour mixture into sugar mixture until batter is smooth. Stir in blueberries. Scoop batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden brown, about 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
