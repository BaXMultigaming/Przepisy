  "ingredients": [
    "4 pounds pork spareribs",
    "1 cup brown sugar",
    "0.5 cup chile sauce",
    "0.25 cup ketchup",
    "0.25 cup soy sauce",
    "0.25 cup Worcestershire sauce",
    "0.25 cup rum",
    "2 cloves garlic, crushed",
    "1 teaspoon dry mustard",
    "1 dash ground black pepper",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut spareribs into serving size portions; wrap in double thickness of foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/15Zqk8_SdeS9k5WtkvHaSvdEymo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22469-Barbecue-Ribs-ddmfs-step-2-014-01960aa954a040b9b99d7fd99895d183.jpg"
      ],
      "image": "assets/images/22469/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven for 1 ½ hours. Unwrap and drain drippings. (I usually freeze drippings to use later in soups.) Place ribs in a large roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XZaEEU_Ddevaj3mOWV9MZePRacU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22469-Barbecue-Ribs-ddmfs-step-3-100-f92ccda1df3442558bdab3e463a364ff.jpg"
      ],
      "image": "assets/images/22469/step_03.webp"
    },
    {
      "text": "Mix brown sugar, chile sauce, ketchup, soy sauce, Worcestershire sauce, rum, garlic, mustard, and pepper together in a bowl. Coat ribs with sauce and marinate at room temperature for 1 hour or refrigerate for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rfc_ojSmAov4CUAdM82Ha2ESoQQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22469-Barbecue-Ribs-ddmfs-step-4-105-2252d75db1714a16a8717ae63a617b1e.jpg"
      ],
      "image": "assets/images/22469/step_04.webp"
    },
    {
      "text": "Preheat the grill to medium heat. Position the grate 4 inches above heat source; grease the grate with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook ribs on the preheated grill for 30 minutes, basting with marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gVocwHi0RMwyjfJ1g6q8VHacxJU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22469-Barbecue-Ribs-ddmfs-4x3-208-0221b0213517493494a29c1c76a8d1cc.jpg"
      ],
