  "ingredients": [
    "0.25 cup butter, softened",
    "0.33000001311302 cup brown sugar",
    "0.25 teaspoon ground cloves",
    "1.5 teaspoons orange juice",
    "6 bananas, peeled and halved lengthwise",
    "0.33000001311302 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 7x11 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, cream together butter and sugar. Stir in cloves and orange juice until smooth. Place the bananas in the prepared dish and spread the butter mixture evenly over the bananas. Sprinkle with coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until bubbly and heated through, 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
