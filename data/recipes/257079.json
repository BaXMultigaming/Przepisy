  "steps": [
    {
      "text": "Combine canola oil, sugar, apple cider vinegar, sesame oil, onion, poppy seeds, sesame seeds, garlic, and paprika in a jar. Close and shake jar until dressing is well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salad greens in a large bowl. Pour in half of the dressing; toss to mix. Arrange mandarin oranges, grape tomatoes, almonds, Gorgonzola cheese, and green onions on top.",
