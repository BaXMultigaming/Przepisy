  "ingredients": [
    "1 (29 ounce) can sliced peaches, drained",
    "5 slices white bread, crusts trimmed",
    "1.5 cups white sugar",
    "2 tablespoons self-rising flour",
    "1 egg, beaten",
    "0.5 cup margarine, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the peaches into the bottom of a buttered 9 inch square baking dish. Cut each slice of bread into 4 strips, and place over the peaches. In a medium bowl, whisk together the sugar, flour, egg and margarine; pour over the bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 to 45 minutes in the preheated oven, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
