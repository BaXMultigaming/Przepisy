  "ingredients": [
    "1 (16 ounce) package dried navy beans",
    "water as needed",
    "2 cups chopped sweet onion",
    "0.25 cup firmly packed brown sugar",
    "0.25 cup molasses",
    "2 tablespoons cider vinegar",
    "2 teaspoons dry mustard",
    "1 clove garlic, minced",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place navy beans into a large container and cover with several inches of cool water; let stand 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain navy beans and put into a pot with 5 cups water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water to a boil; reduce heat and simmer until beans are tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beans, onion, brown sugar, molasses, vinegar, mustard, garlic, nutmeg, and cinnamon in a 2-quart casserole dish with a lid; season with pepper. Place lid on dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, 5 to 7 hours, stirring halfway through and adding water if mixture is too dry. Remove lid and bake until mixture has reduced to desired thickness, about 1 hour more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
