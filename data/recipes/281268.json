  "ingredients": [
    "2 tablespoons extra-virgin olive oil",
    "0.25 cup diced onion",
    "1 clove garlic, chopped",
    "1 pound ground turkey",
    "1 (16 ounce) jar marinara sauce",
    "1 (16 ounce) can fire-roasted diced tomatoes",
    "2 cups zucchini noodles",
    "7 tablespoons ricotta cheese",
    "0.25 cup shredded mozzarella cheese",
    "5 leaves basil, thinly sliced",
    "1 pinch red pepper flakes, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in an oven-safe skillet over medium heat. Add onion and garlic and saute until soft, 2 to 3 minutes. Add ground turkey and cook and stir until browned, crumbly, and no longer pink, 5 to 7 minutes. Pour in marinara sauce and diced tomatoes; let simmer until thick, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Squeeze zucchini noodles to get most of the water out. Add to the skillet and stir to combine. Add ricotta cheese in 1-tablespoon dollops around the skillet. Sprinkle mozzarella cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven for 20 minutes. Remove from the oven and let sit for 5 minutes to set up. Sprinkle with basil and red pepper flakes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
