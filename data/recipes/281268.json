  "title": "Baked Zucchini Noodles with Creamy Ricotta",
  "description": "These weeknight baked zucchini noodles are served with a savory turkey- and tomato-based sauce and topped with creamy ricotta cheese for extra deliciousness.",
  "authors": [
    "mkhurt"
  ],
  "date_published": "2017-01-13T05:43:29-05:00",
