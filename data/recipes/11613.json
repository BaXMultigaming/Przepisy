  "ingredients": [
    "0.75 cup shortening",
    "1 cup packed brown sugar",
    "1 egg",
    "0.5 cup applesauce",
    "2.25 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.75 teaspoon ground cinnamon",
    "1 cup raisins",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F ( 195 degrees C ). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream the shortening, sugar, and egg. Stir in the applesauce. Sift together the flour, baking soda, salt, and cinnamon; stir into the creamed mixture. Then mix in the raisins and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoonfuls onto the prepared cookie sheets. Bake 10 to 12 minutes in the preheated oven. Remove to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
