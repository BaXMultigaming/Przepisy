  "ingredients": [
    "1 (18.25 ounce) package spice cake mix",
    "1 (3.4 ounce) package instant butterscotch pudding mix",
    "4 eggs",
    "1 cup water",
    "0.5 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 10 inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large mixing bowl, combine spice cake, butterscotch pudding mix, eggs, water and oil. Beat with an electric mixer for 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into prepared Bundt pan, and bake at 350 degrees F (175 degrees C), for 55 to 60 minutes, or until cake tests done. Allow cake to cool 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
