  "ingredients": [
    "1 (9 inch) refrigerated pie crust (such as Pillsbury®)",
    "10 small fresh apricots, pitted and quartered",
    "0.33333334326744 cup white sugar",
    "1 cup almond meal",
    "0.5 cup confectioners' sugar",
    "1 egg",
    "0.33333334326744 cup apricot jam, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Roll out pie crust onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss apricots with white sugar in a bowl until evenly coated; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almond meal, confectioners' sugar, and egg in a separate bowl until paste-like; spread onto center of pie crust, leaving ½ inch bare crust around edges. Arrange sugared apricots on top almond paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold ½-inch bare crust edge inward over almond paste and apricots, leaving center of galette uncovered. Crimp crust edges with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden brown, about 40 minutes. Brush melted apricot jam over galette. Slice; serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
