  "ingredients": [
    "1 cup white sugar",
    "0.5 cup unsalted butter, softened",
    "4 large eggs",
    "1 pinch ground cinnamon",
    "1 pinch ground nutmeg",
    "1 (20 ounce) can crushed pineapple with juice",
    "5 slices white bread, torn"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a medium-sized casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter in a mixing bowl with an electric mixer until creamy. Beat in eggs, one at a time, then stir in cinnamon and nutmeg. Mix in crushed pineapple and bread until incorporated; transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and lightly browned on top, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
