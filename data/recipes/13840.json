  "ingredients": [
    "4 tablespoons butter",
    "4 tablespoons all-purpose flour",
    "1.5 cups milk",
    "1 (16 ounce) package frozen peas and onions, thawed",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over low heat. Stir in flour and cook until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase the heat to medium, and slowly stir in milk, 1/2 cup at a time. Cook until thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the peas and onions and cook until hot. Season with salt and pepper.",
