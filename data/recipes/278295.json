  "title": "Air-Fried Greek Yogurt Frittata",
  "description": "Greek yogurt adds lovely texture and tang to this quick and easy air-fried frittata made with aromatic vegetables and spinach.",
  "authors": [
    "Buckwheat Queen"
  ],
  "date_published": "2020-01-29T04:11:43-05:00",
