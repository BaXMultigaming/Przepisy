  "ingredients": [
    "1 pound pork sausage, sliced",
    "0.5 onion, chopped",
    "1 stalk celery, chopped",
    "1 green bell pepper, chopped",
    "0.5 cup uncooked long grain white rice",
    "1 (4.5 ounce) package chicken noodle soup mix",
    "2 cups hot water",
    "0.5 cup slivered almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet over medium-high heat, combine sausage, onion, celery, and bell pepper and sauté for 5 minutes. Drain any excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir dry rice in with sausage and vegetables, then add water and soup mix. Transfer mixture to a lightly greased 2-quart casserole dish and top with almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake in the preheated oven for 90 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
