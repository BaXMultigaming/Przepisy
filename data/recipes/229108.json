  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground ginger",
    "1 cup unsalted butter, softened",
    "0.75 cup white sugar",
    "0.75 cup brown sugar",
    "2 teaspoons vanilla extract",
    "1 large egg",
    "1 (15 ounce) can pumpkin puree",
    "1 (3 ounce) package cream cheese, softened",
    "0.25 cup unsalted butter, softened",
    "1 teaspoon vanilla extract",
    "2 cups powdered sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease two baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lMwI5eofiFk7_z7CWm6KWZ2ydqo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229108-pumpkin-cookies-with-cream-cheese-frosting-the-worlds-best-VAT-step-01-1777172d5ce441c6af3f5e84d5790a78.jpg"
      ],
      "image": "assets/images/229108/step_01.webp"
    },
    {
      "text": "To make the cookies: Whisk flour, baking powder, cinnamon, baking soda, nutmeg, and ginger together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vfdGlyWznPcJLdrJFBYmXFgdY3I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229108-pumpkin-cookies-with-cream-cheese-frosting-the-worlds-best-VAT-step-02-5f76c96f4aac40e4a3f1f6f3ad19d762.jpg"
      ],
      "image": "assets/images/229108/step_02.webp"
    },
    {
      "text": "Beat butter, both sugars, egg, and vanilla with an electric mixer in a separate large bowl until smooth. Beat in pumpkin puree. Gradually stir dry ingredients into pumpkin mixture until combined; batter will be moist.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z0dIyiL2bcZNAdFqatioAjpfF5I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229108-pumpkin-cookies-with-cream-cheese-frosting-the-worlds-best-VAT-step-03-e502f9d4304b469392034b71a6552e03.jpg"
      ],
      "image": "assets/images/229108/step_03.webp"
    },
    {
      "text": "Drop teaspoonfuls of batter about 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t-jKVouDRPb9zIZ1EU3OAytzwxM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229108-pumpkin-cookies-with-cream-cheese-frosting-the-worlds-best-VAT-step-04-032d7562cba740f4b2276307e2520c6d.jpg"
      ],
      "image": "assets/images/229108/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until cookies are lightly browned, 10 to 12 minutes, switching racks halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3D-8Pww1TBJ6KbpJki0TS-iEDFc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229108-pumpkin-cookies-with-cream-cheese-frosting-the-worlds-best-VAT-step-05-61e1a70e14d944aa8902e7515a86f864.jpg"
      ],
      "image": "assets/images/229108/step_05.webp"
    },
    {
      "text": "Remove from the oven and let cool on the sheets for 5 minutes. Transfer cookies to a wire rack and cool completely, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8sEYX2JJQcr0-hMbsSexNLGY1VM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229108-pumpkin-cookies-with-cream-cheese-frosting-the-worlds-best-VAT-step-06-3d6b6b8dee674bb0b82f9ac286254b44.jpg"
      ],
      "image": "assets/images/229108/step_06.webp"
    },
    {
      "text": "While the cookies are cooling, make the frosting: Beat cream cheese, butter, and vanilla in a bowl with an electric mixer until soft and creamy. Beat in powdered sugar, about 1/2 cup at a time, until frosting is smooth and spreadable.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iQ5o9mGB8WgnYxBi6Uh1AmptSh4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229108-pumpkin-cookies-with-cream-cheese-frosting-the-worlds-best-VAT-step-07-9156fba729444e18abec52c6f6d98c03.jpg"
      ],
      "image": "assets/images/229108/step_07.webp"
    },
    {
      "text": "Spread frosting over cooled cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_2vIImc1qwzJggp3KBWtdSes9kc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229108-pumpkin-cookies-with-cream-cheese-frosting-the-worlds-best-VAT-step-08-7a88fce7ec8c432db5279d6a076e09f4.jpg"
      ],
      "image": "assets/images/229108/step_08.webp"
    }
  ],
