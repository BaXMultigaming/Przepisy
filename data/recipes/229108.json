  "title": "Pumpkin Cookies with Cream Cheese Frosting (The World's Best!)",
  "description": "Soft, moist pumpkin cookies with cream cheese frosting are perfect for Halloween, Thanksgiving, or whenever you're craving a sweet taste of fall.",
  "authors": [
    "Sabattis"
  ],
  "date_published": "2020-06-18T23:51:29-04:00",
  "date_modified": "2026-01-21T09:52:57-05:00",
