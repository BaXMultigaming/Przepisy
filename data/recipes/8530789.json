  "ingredients": [
    "1 cup long-grain white rice (such as jasmine or basmati)",
    "1.5 cups water",
    "1 teaspoon unsalted butter or oil",
    "0.75 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/joJ3i7gQKB07nIxO05u4PWl8GRI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8530789-microwave-rice-ddmfs-step-1-4x3-f667c8d75f3b4d879e6ba93fff08e775.jpg"
      ],
      "image": "assets/images/8530789/step_01.webp"
    },
    {
      "text": "Rinse rice using a fine-mesh strainer, gently stirring by hand, until water runs somewhat clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WS12jt7RHZOnqDcbMj-rPqh5B_0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8530789-microwave-rice-ddmfs-step-2--023fb709b1ba41b3a9b8d9cede372193.jpg"
      ],
      "image": "assets/images/8530789/step_02.webp"
    },
    {
      "text": "Thoroughly drain rice and place in a 8-cup microwave safe bowl or container; add water, butter or oil, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GxczjpRZ4dOap7yBWfxy5JKsWwY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8530789-microwave-rice-ddmfs-step-3-3-f53c117ebf24499887b9e8c9fd4c7091.jpg"
      ],
      "image": "assets/images/8530789/step_03.webp"
    },
    {
      "text": "Microwave uncovered on HIGH until water is mostly absorbed and some steam holes appear on the surface, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yfiql7fq4NJIluIncpYj-wxMxTs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8530789-microwave-rice-ddmfs-step-5-3-b6cf07d9deed451682c710d2c485fff6.jpg"
      ],
      "image": "assets/images/8530789/step_04.webp"
    },
    {
      "text": "Cover tightly with microwave safe plastic wrap, lid, or plate; microwave on HIGH for 4 more minutes until rice is tender and water is fully absorbed. Let stand, covered, for 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r0sRiadJnOJrGpQfdG2DEs5QRHo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8530789-microwave-rice-ddmfs-step-4--e5d0aed3f17c4276b8a154bc11b87f44.jpg"
      ],
      "image": "assets/images/8530789/step_05.webp"
    },
    {
      "text": "Uncover; fluff and taste rice using a fork. If rice is not yet tender, cover and microwave on HIGH in 1-minute intervals as needed until rice reaches desired consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q3FqAEuBjRKuIR9ZHkr2XafKtOU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8530789-microwave-rice-ddmfs-step-6-4-2c368afedc884740abe03b6b3757fd54.jpg"
      ],
      "image": "assets/images/8530789/step_06.webp"
    },
    {
      "text": "Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mdJKN537YL_XYTlYAF7uHNZLdFk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8530789-microwave-rice-ddmfs-2x3-25-3256443ff1ba481f94afbd4cac5bf196.jpg"
      ],
      "image": "assets/images/8530789/step_07.webp"
    }
