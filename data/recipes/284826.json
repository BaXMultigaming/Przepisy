  "ingredients": [
    "2 teaspoons olive oil",
    "0.75 cup fresh corn kernels",
    "0.5 red bell pepper, diced",
    "0.5 cup diced red onion",
    "2 cloves garlic, minced",
    "2 tablespoons fresh lime juice",
    "1 teaspoon brown sugar",
    "1 teaspoon lime zest",
    "0.125 teaspoon cayenne pepper",
    "1 green onion, minced",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a medium skillet over medium heat and add corn, bell pepper, and onion. Saute until onion softens slightly and corn is tender, about 2 minutes. Stir in garlic and cook until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in lime juice, brown sugar, lime zest, and cayenne pepper. Remove the relish to a bowl and cool slightly. Stir in green onion and parsley, and serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
