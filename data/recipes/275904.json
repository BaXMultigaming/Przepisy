  "ingredients": [
    "4 pork tenderloin cutlets",
    "1 cup sparkling apple cider, or more as needed",
    "0.25 cup brown sugar",
    "1 teaspoon ground cinnamon",
    "1 (18 ounce) bottle honey barbecue sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Place pork into a slow cooker; pour cider over top to cover. Stir brown sugar and cinnamon into cider until combined, making sure flavorings not on sides of the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until pork shreds easily, 7 to 12 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully transfer pork to a bowl, being careful it doesn't fall apart in cider. Shred using 2 forks; stir in barbecue sauce. Discard slow cooker cooking liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
