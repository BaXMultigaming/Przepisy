  "ingredients": [
    "4 slices bacon, diced",
    "1 onion, chopped",
    "1 (14.75 ounce) can cream-style corn",
    "1.5 cups cubed potatoes",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "3 cups milk",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Sauté bacon and onions together in a large saucepan over medium heat until onions are tender, about 7 minutes. Add corn, potatoes, soup, milk, salt, and pepper. Increase heat to high and bring to a boil. Reduce heat to low, cover, and simmer until potatoes are tender, about 25 to 35 minutes, stirring occasionally.",
