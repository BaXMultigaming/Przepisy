  "ingredients": [
    "1 quart vegetable oil for frying, or as needed",
    "1 small onion, cut into chunks",
    "3 tablespoons grated fresh ginger, or more to taste",
    "2 whole cloves, crushed",
    "5 ripe plantains, diced into 1/3-inch chunks",
    "3 tablespoons ground chile pepper",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the oil is heating, purée onion in a blender until smooth. Stir in ginger and cloves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place plantains in a bowl and pour onion mixture over top. Add chile pepper and salt; mix until plantains are coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry plantains in the hot oil until browned on all sides, about 5 minutes. Remove with a slotted spoon and drain on a paper towel-line plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
