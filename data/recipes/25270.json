  "ingredients": [
    "3 teaspoons vegetable oil, divided",
    "1 slice fresh ginger root, minced",
    "6 green onions, chopped",
    "1 stalk celery, sliced",
    "2 cups bean sprouts",
    "2 mushrooms, sliced",
    "1 green bell pepper, chopped",
    "0.25 cup chopped cooked ham",
    "1 teaspoon salt",
    "6 eggs, beaten"
  ],
  "steps": [
    {
      "text": "Heat 2 teaspoons oil in a large skillet over medium-high heat. Add ginger, green onions, celery, bean sprouts, mushrooms, green pepper, ham, and salt; sauté until vegetables are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine vegetable mixture and beaten eggs in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining 1 teaspoon oil in a medium skillet over medium heat. Pour in egg mixture to form a small omelet. Cook until golden brown on each side. Repeat with remaining egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
