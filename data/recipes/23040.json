  "ingredients": [
    "1 pound unsalted butter",
    "1 pound brown sugar",
    "1 pound confectioners' sugar",
    "1 quart vanilla ice cream, softened",
    "1 tablespoon ground cinnamon",
    "1 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium heat. Stir in brown sugar and confectioners' sugar until smooth.",
