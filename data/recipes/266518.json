  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 sweet onion, chopped",
    "0.5 cup chopped carrot",
    "2 large cloves garlic, minced",
    "1 (8 ounce) package sliced fresh mushrooms",
    "1 (32 fluid ounce) container chicken stock",
    "1 teaspoon salt",
    "0.25 teaspoon fresh ground black pepper",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground turmeric",
    "1 (15 ounce) can lentils, drained and rinsed",
    "1 (5 ounce) package mixed power greens",
    "0.5 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Heat oil in a medium saucepan over medium heat. Add onion, carrots, and garlic; cook and stir until onion is soft and translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add mushrooms; cook and stir 5 minutes. Stir in chicken stock, salt, black pepper, ginger, and turmeric; bring to a boil and cook until carrots are tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in lentils and greens; cook until greens wilt, about 2 minutes. Sprinkle servings with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
