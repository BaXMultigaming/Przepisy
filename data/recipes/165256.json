  "ingredients": [
    "1 (16 ounce) package penne pasta",
    "1.5 cups cubed cooked chicken",
    "2 stalks celery, chopped",
    "1 cup dried cranberries",
    "4 green onions, chopped",
    "1.5 cups creamy poppy seed salad dressing",
    "2 teaspoons lemon juice"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes. Drain, then rinse under cold water until pasta is cold; drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine penne, chicken, celery, cranberries, and green onions in a large bowl; pour in salad dressing and lemon juice and stir until evenly mixed.",
