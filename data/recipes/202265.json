  "title": "Potato, Ham, Broccoli, and Cheese Soup with Baby Dumplings",
  "description": "This broccoli, ham, and cheese soup features potato chunks in a creamy base seasoned with parsley and thyme for a hearty, filling, cold-weather meal.",
  "authors": [
    "Galley Wench"
  ],
  "date_published": "2019-04-02T02:52:03-04:00",
