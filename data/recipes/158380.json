  "ingredients": [
    "1 (16 ounce) package penne rigate",
    "1 tablespoon extra-virgin olive oil",
    "7 cloves roasted garlic",
    "0.5 cup butter",
    "1.5 cups heavy cream",
    "0.25 cup chicken stock",
    "0.5 cup vodka",
    "2 cups grated Parmesan cheese",
    "0.5 cup grated Asiago cheese",
    "kosher salt to taste",
    "ground white pepper to taste",
    "10 leaves fresh basil, torn or shredded"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly-salted water to a boil. Add pasta and cook until al dente, 8 to 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oil in a large skillet over medium heat; cook the garlic in the oil about 3 minutes. Stir in the butter, cream, chicken stock, and vodka; bring to a simmer. Add the Parmesan cheese, Asiago cheese, salt, and pepper; stir. Mix the pasta into the sauce and stir to coat. Allow to simmer about 3 minutes more. Garnish with fresh basil to serve.",
