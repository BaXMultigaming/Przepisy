  "ingredients": [
    "1 (12 ounce) package egg noodles",
    "0.25 cup salted butter",
    "0.5 (8 ounce) package fresh mushrooms, thinly sliced",
    "0.5 cup minced onion",
    "3 cloves garlic, minced",
    "1 pound ground turkey",
    "2 tablespoons all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "2 tablespoons Worcestershire sauce",
    "1 (10.5 ounce) can condensed cream of mushroom soup with roasted garlic",
    "0.33333334326744 cup milk",
    "0.33333334326744 cup water",
    "0.5 cup sour cream"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a large saucepan or deep skillet over medium heat. Add mushrooms, onion, and garlic; cook and stir until soft, 5 to 7 minutes. Stir in ground turkey; cook until browned and crumbly, 5 to 7 minutes. Stir in flour, salt, and black pepper; cook for 5 minutes. Stir in Worcestershire sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in condensed soup, milk, and water; bring to a simmer. Cook, uncovered, for 10 minutes. Add sour cream; stir until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve over warm egg noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
