  "ingredients": [
    "0.25 cup Dijon mustard",
    "0.25 cup honey",
    "1 tablespoon apple cider vinegar",
    "1 teaspoon chopped fresh rosemary",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "2.5 pounds bone-in chicken thighs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Dijon, honey, vinegar, rosemary, salt, and pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken thighs on a large rimmed pan. Brush honey-mustard all over both sides of chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven for 30 minutes, basting every 15 minutes with remaining honey-mustard. Increase oven temperature to 400 degrees F (200 degrees C) and cook until no longer pink at the bone and the juices run clear, about 15 more minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
