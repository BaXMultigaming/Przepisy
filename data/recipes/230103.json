  "ingredients": [
    "1 pound fresh green beans, trimmed and snapped in half",
    "3 tablespoons butter",
    "3 cloves garlic, minced",
    "0.125 teaspoon lemon-pepper seasoning, or more to taste",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
