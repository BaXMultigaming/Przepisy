  "ingredients": [
    "10 wide lasagna noodles",
    "2 (10 ounce) packages chopped frozen broccoli, thawed and drained",
    "1 (15 ounce) container ricotta cheese",
    "2 cups shredded mozzarella cheese",
    "4 green onions, chopped",
    "2 teaspoons dried basil",
    "0.25 teaspoon ground nutmeg",
    "1 (32 ounce) jar spaghetti sauce",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add noodles and cook for 8 to 10 minutes or until al dente; drain and rinse.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine broccoli, ricotta cheese, mozzarella cheese, green onions, basil and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread about 1/2 cup of the broccoli mixture along each noodle. Roll noodles to form spirals. Place in prepared dish. Spoon spaghetti sauce on and around spirals, and top with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
