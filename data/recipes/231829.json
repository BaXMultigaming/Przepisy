  "ingredients": [
    "1 cup unsweetened almond milk",
    "2 cups ice",
    "2 tablespoons unsweetened natural peanut butter",
    "2 tablespoons unsweetened cocoa powder",
    "1 scoop vanilla-flavored whey protein powder",
