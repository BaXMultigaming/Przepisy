  "ingredients": [
    "1 (10.75 ounce) can condensed Cheddar cheese soup",
    "0.5 cup chopped onion",
    "freshly ground black pepper",
    "4 large baking potatoes, scrubbed",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soup and onion in a medium bowl; season with pepper. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut potatoes into 1/4-inch thick slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange one layer sliced potatoes in the bottom of the prepared casserole dish. Spoon one layer of soup mixture over potatoes. Arrange another layer of potatoes on top, followed by more soup mixture. Continue layering until all the potatoes and soup mixture have been used. Sprinkle Cheddar cheese over top of casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes fully cooked and cheese is bubbly, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
