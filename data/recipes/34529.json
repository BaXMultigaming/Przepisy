  "ingredients": [
    "0.5 cup brown sugar",
    "2 tablespoons cornstarch",
    "1 teaspoon mustard powder",
    "1 tablespoon white vinegar",
    "1 cup raisins",
    "0.25 teaspoon grated lemon zest",
    "1 tablespoon lemon juice",
    "1.5 cups water"
  ],
  "steps": [
    {
      "text": "Stir brown sugar, cornstarch and mustard powder together in a saucepan. Slowly stir in vinegar, then add raisins, lemon zest, lemon juice and water. Cook over medium heat, stirring frequently, until mixture comes to a boil.",
