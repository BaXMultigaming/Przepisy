    "12 extra large eggs"
  ],
  "steps": [
    {
      "text": "Fill a stainless steel steamer pot with about 1 inch water and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add eggs to the steamer tray, carefully lower into the pot, cover, and reduce heat. Cook for 10 minutes for medium yolks or 15 minutes for fully-cooked yolks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the steamer tray and rattle eggs around to crack the shells. Transfer eggs to a cold water bath and let sit for 3 to 5 minutes. Remove from water bath.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently crack each egg, roll on a cutting board, then peel the shell off from the fat end towards the point.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
