  "ingredients": [
    "1 (5 pound) bone-in pork butt",
    "8 cloves garlic",
    "4 teaspoons kosher salt",
    "1 tablespoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a pairing knife to cut 8 small slits into the pork, about 1 ½ inches deep. Insert a garlic clove into each slit. Sprinkle pork evenly on all sides with salt and pepper. Place pork, fat-side up, in a 9x13-inch metal baking dish or Dutch oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to 325 degrees F (165 degrees C). Carefully pour 3/4 cup water around the sides of the pork. Cover with foil or a lid and cook for 2 ½ hours. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let stand for 20 minutes. Remove large fat layer and any other large pieces of fat. Pull pork apart and shred.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
