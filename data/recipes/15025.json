  "ingredients": [
    "2 cups sour cream",
    "1 (10.5 ounce) can condensed cream of potato soup",
    "0.25 cup butter",
    "1 (2 pound) package frozen hash brown potatoes",
    "2 cups shredded Cheddar cheese",
    "0.33300000429153 cup chopped green onions",
    "salt and pepper to taste"
