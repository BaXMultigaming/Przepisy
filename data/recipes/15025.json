  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat sour cream, condensed soup, and butter in a small pot over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine potatoes, 1 cup cheese, and green onions in a large mixing bowl. Mix in heated soup mixture. Season with salt and pepper. Pour into a 9x13-inch dish. Sprinkle with remaining cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 45 minutes. Serve warm.",
