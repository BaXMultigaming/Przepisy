  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "1 (16 ounce) jar salsa",
    "2 teaspoons garlic powder",
    "1 teaspoon ground cumin",
    "1 teaspoon chili powder",
    "salt to taste",
    "1 (15 ounce) can pinto beans",
    "1 (11 ounce) can Mexican-style corn"
  ],
  "steps": [
    {
      "text": "Place chicken and salsa in the slow cooker the night before you want to eat this chili. Season with garlic powder, cumin, chili powder, salt, and pepper. Cook on Low for 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "About 3 to 4 hours before you want to eat, remove chicken to a cutting board and shred with 2 forks. Return meat to the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in pinto beans and corn. Simmer until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
