  "ingredients": [
    "1 tablespoon olive oil",
    "1 acorn squash, halved and seeded",
    "1 apple, diced",
    "2 tablespoons diced celery",
    "2 tablespoons water",
    "2 teaspoons minced onion",
    "2 teaspoons butter, cubed",
    "1 teaspoon maple syrup",
    "1 pinch ground cinnamon, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place squash, cut-sides down, onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apple, celery, water, onion, and butter in a small baking dish; cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake squash and apple mixture in the preheated oven until squash and apple mixture are tender, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stuff squash halves with apple mixture; drizzle with maple syrup and sprinkle with cinnamon.",
