  "ingredients": [
    "0.5 cup water",
    "0.25 cup white sugar",
    "2 tablespoons soy sauce",
    "2 tablespoons rice wine vinegar",
    "2 tablespoons ketchup",
    "1 tablespoon lemon juice",
    "1 teaspoon garlic and red chile paste, or more to taste",
    "0.125 teaspoon sesame oil"
  ],
  "steps": [
    {
      "text": "Stir water and sugar together in a bowl to dissolve the sugar; add soy sauce, rice wine vinegar, ketchup, lemon juice, garlic and red chile paste, and sesame oil into the water. Stir the mixture until smooth; refrigerate until ready to serve.",
