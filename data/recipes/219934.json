  "ingredients": [
    "cooking spray",
    "1 cup whole wheat pastry flour",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "1 pinch salt",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon ground ginger",
    "2 large egg whites",
    "0.66666668653488 cup skim milk",
    "0.66666668653488 cup nonfat plain yogurt",
    "1 cup raw sugar",
    "1 tablespoon canola oil",
    "0.25 teaspoon vanilla extract",
    "1 cup chopped peeled apple"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray 12 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk the whole wheat pastry flour, all-purpose flour, baking soda, salt, cinnamon, nutmeg, allspice, and ginger together in a large bowl until evenly combined. Use your fingers to make a well in the center of the dry ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, whisk the egg whites, skim milk, yogurt, raw sugar, canola oil, and vanilla extract until smooth; mix in the chopped apple.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the liquid ingredients into the well in the dry ingredients, and mix to make a thick batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the batter into the prepared muffin cups, filling them about 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake the muffins in the preheated oven until lightly golden brown and a toothpick inserted into the center of a muffin comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool the muffins in their cups for about 5 minutes before removing to finish cooling on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
