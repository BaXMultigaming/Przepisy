  "ingredients": [
    "1.5 cups shredded zucchini",
    "0.75 cup white sugar",
    "0.5 cup vegetable oil",
    "1 egg",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "2 teaspoons lemon zest",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p7PyhaNheYeEnnBPidJuan0RIKk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_58817_LemonZucchiniBread_Shot1_12910-244d92bc703e46b9b5e3578ea00c612c.jpg"
      ],
      "image": "assets/images/58817/step_01.webp"
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease an 8x4-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat shredded zucchini, sugar, oil, and egg together in a mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9O9srruINsuhTxv1zXB4iE0JFgw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_58817_LemonZucchiniBread_Shot2_12913-8dfbf666eb6245c2b5ede3ae9f319f49.jpg"
      ],
      "image": "assets/images/58817/step_03.webp"
    },
    {
      "text": "Sift flour, salt, baking soda, and baking powder into a separate bowl, then stir in cinnamon and lemon zest. Stir flour mixture into zucchini mixture just until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/utiSUbDuhVwfmmglx_j8XqmT7tw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_58817_LemonZucchiniBread_Shot3_12917-5d129bf976794b8c861ef4c3a37a0f05.jpg"
      ],
      "image": "assets/images/58817/step_04.webp"
    },
    {
      "text": "Pour the batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dTyY5AYvMDIHrjx8HHCnlTeDtKc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_58817_LemonZucchiniBread_Shot4_12921-94eed12e3d5f4467b9036183aeab1141.jpg"
      ],
      "image": "assets/images/58817/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, about 45 minutes. Remove from the heat and cool for about 10 minutes before turning out onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5rYd6MQYUORHpPH019oI40Z9p5w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/JF_58817_LemonZucchiniBread_Shot5_12936-cbfc19c760c742eb91ad801d3aef36a5.jpg"
