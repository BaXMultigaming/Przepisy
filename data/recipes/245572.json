  "ingredients": [
    "0.5 cup butter, at room temperature",
    "0.75 cup white sugar",
    "0.25 teaspoon salt",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.75 ounces 70% dark chocolate, melted",
    "1 tablespoon cocoa powder",
    "0.25 teaspoon instant espresso powder",
    "1 cup all-purpose flour",
    "0.5 cup semisweet chocolate chips",
    "0.5 cup roasted hazelnuts, chopped",
    "0.25 cup roasted hazelnuts, finely ground"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter in a large bowl with an electric mixer until light and fluffy. Add sugar and salt; beat until combined. Beat in egg and vanilla extract until well-blended. Blend in melted chocolate, cocoa powder, and espresso. Mix in flour gradually, until batter is smooth. Fold in chocolate chips, chopped hazelnuts, and ground hazelnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop heaping tablespoons of cookie batter 2 inches apart onto baking sheets. Use the back of a wet fork to flatten each cookie slightly, making a crisscross pattern.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and edges start to darken, about 15 minutes. Let cool a few minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
