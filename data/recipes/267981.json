  "ingredients": [
    "cooking spray",
    "1 egg",
    "1 cup peanut butter",
    "0.5 cup plain instant oatmeal",
    "1 medium banana",
    "0.25 cup white sugar",
    "0.25 cup semisweet chocolate chips",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a large bowl. Mix in peanut butter, oatmeal, banana, sugar, chocolate chips, and vanilla. Roll dough into 1-inch balls and place onto the prepared baking sheet. Press on each ball with a spoon to flatten slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 9 to 12 minutes; cookies will look slightly raw. Cool for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
