  "ingredients": [
    "0.75 pound beef stew meat, cut into 1 inch cubes",
    "2 onions, diced",
    "3 cloves garlic, minced",
    "1 large stalk celery, minced",
    "2 carrots, finely chopped",
    "0.25 pound green beans, cut into 1 inch pieces",
    "8 ounces fresh mushrooms, coarsely chopped",
    "3 potatoes, peeled and diced",
    "1 (14.5 ounce) can crushed tomatoes",
    "1 (8 ounce) can tomato sauce",
    "1 bay leaf",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon dried thyme",
    "0.25 teaspoon dried marjoram",
    "2 (14.5 ounce) cans fat-free chicken broth",
    "0.5 cup all-purpose flour",
    "2 (10.5 ounce) cans beef consomme"
  ],
  "steps": [
    {
      "text": "In a slow cooker, combine beef, onions, garlic, celery, carrots, green beans, mushrooms, and potatoes. Pour in tomatoes and tomato sauce. Season with bay leaf, pepper, thyme, and marjoram. Stir together chicken broth and flour. Pour chicken broth mixture and beef consomme into the slow cooker; stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook on Low for 6 to 10 hours. Remove bay leaf before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
