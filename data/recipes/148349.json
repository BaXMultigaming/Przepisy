  "ingredients": [
    "0.5 cup melted butter",
    "1 egg",
    "0.33333334326744 cup brown sugar",
    "1 teaspoon vanilla extract",
    "1 cup flour",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 teaspoon cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon pumpkin pie spice",
    "0.75 cup dried cranberries",
    "0.75 cup pecans",
    "0.75 cup old-fashioned rolled oats"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 11x7-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour melted butter into a mixing bowl. Beat in egg, brown sugar, and vanilla. Sift flour, baking powder, baking soda, salt, cinnamon, nutmeg, and pumpkin pie spice together into a separate mixing bowl; stir flour mixture into butter mixture until thoroughly blended. Mix in cranberries, pecans, and oats until evenly blended. Press mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is dry and the edges slightly pull away from the sides of the pan, 13 to 15 minutes. Cool before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
