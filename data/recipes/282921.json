  "title": "Dutch Oven Peach Cobbler for Camping",
  "description": "Serve this old-fashioned Dutch oven peach cobbler for camping at your next campfire. It takes just a handful of baking ingredients and fresh peaches.",
  "authors": [
    "AllanSimpson"
  ],
  "date_published": "2010-08-09T13:16:53-04:00",
  "date_modified": "2024-12-16T13:28:28-05:00",
