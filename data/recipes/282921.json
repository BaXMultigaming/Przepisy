  "keywords": [],
  "ingredients": [
    "2.25 cups all-purpose flour",
    "2 tablespoons baking powder",
    "0.75 teaspoon ground cinnamon",
    "0.125 teaspoon salt",
    "3 cups white sugar, divided",
    "2.25 cups milk",
    "6 cups sliced fresh peaches",
    "1 cup unsalted butter"
  ],
  "steps": [
    {
      "text": "Light charcoal briquettes in a campfire or outdoor charcoal grill; burn until coals are mostly covered in ash, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, sift flour, baking powder, cinnamon, and salt together in a bowl. Stir in 1 1/2 cups sugar, then stir in milk until batter is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss peaches with remaining 1 1/2 cups sugar in a separate bowl; mix until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rake coals into a flat bed; place a campfire-safe Dutch oven on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add butter to Dutch oven until melted; swirl Dutch oven to coat all sides with melted butter. Pour batter into the pot, add peach mixture to center of the batter. Cover Dutch oven with the lid; place hot charcoal on top of lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until done, about 1 hour, checking every 20 minutes to prevent over-baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
