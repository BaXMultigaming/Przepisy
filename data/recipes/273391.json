  "ingredients": [
    "Pan spray",
    "1.5 pounds zucchini",
    "1 teaspoon kosher salt",
    "1 teaspoon black pepper",
    "1 teaspoon Food Club® Dried Oregano",
    "0.5 teaspoon red pepper flakes",
    "0.5 teaspoon Food Club® Paprika",
    "0.5 cup Food Club® Panko Breadcrumbs",
    "0.25 cup grated Belgioioso® Parmesan cheese",
    "2 tablespoons Food Club® Extra-Virgin Olive Oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 F. Spray an 8-inch or 9-inch round pie dish with pan spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice the zucchini into 1/8- to 1/4-inch slices. Arrange slices in a shingle fashion from the outside edge of the dish to the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the salt, spices, breadcrumbs, and Parmesan cheese. Stir in the oil to coat all the breadcrumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle the breadcrumb mixture over the zucchini. Make sure you get all the nooks and crannies of the zucchini slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in the oven for 30 to 35 minutes or until the breadcrumbs are golden brown and the zucchini is cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
