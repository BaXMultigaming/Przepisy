  "ingredients": [
    "cooking spray",
    "1 cup white sugar",
    "0.5 cup unsweetened applesauce",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "3 very ripe bananas, mashed",
    "0.75 cup chopped walnuts",
    "0.75 cup semisweet chocolate chips",
    "2 cups whole wheat flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon sea salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray an 8-count mini loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, applesauce, egg, and vanilla in a large bowl with a wooden spoon. Add in bananas, walnuts, and chocolate chips and stir to combine. Add flour, baking soda, cinnamon, and salt and stir until completely mixed. Spoon batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick or fork inserted into the center comes out clean, 25 to 30 minutes. Allow to cool for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
