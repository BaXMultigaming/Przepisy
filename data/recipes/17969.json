  "ingredients": [
    "1 cup unbleached flour",
    "1 cup cornmeal",
    "0.25 cup white sugar",
    "1 teaspoon baking soda",
    "0.75 teaspoon salt",
    "1 cup plain nonfat yogurt",
    "2 large eggs, beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease an 8-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cornmeal, sugar, baking soda, and salt together in a large bowl. Stir in yogurt and eggs until just combined; do not overmix. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the center springs back when lightly pressed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
