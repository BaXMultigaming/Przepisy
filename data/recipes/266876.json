  "ingredients": [
    "0.75 cup almonds",
    "0.33333334326744 cup walnuts",
    "4 cups rolled oats",
    "1 cup chopped dried apricots",
    "1 cup dried cranberries",
    "0.5 cup honey",
    "0.5 cup olive oil",
    "0.33333334326744 cup apricot preserves",
    "0.33333334326744 cup wheat germ",
    "0.33333334326744 cup unsalted sunflower seeds",
    "0.33333334326744 cup chia seeds",
    "0.33333334326744 cup milled flax seeds",
    "0.25 cup oat bran",
    "0.25 cup black sesame seeds",
    "2 teaspoons ground cinnamon",
    "1.5 teaspoons vanilla extract",
    "1 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread almonds and walnuts on a rimmed baking sheet. Toast in the preheating oven until fragrant, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer almonds and walnuts to a very large bowl. Add oats, apricots, cranberries, honey, olive oil, apricot preserves, wheat germ, sunflower seeds, chia seeds, flax seeds, oat bran, black sesame seeds, cinnamon, vanilla extract, and nutmeg. Mix well with your hands.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line the baking sheet with parchment paper. Spread granola mixture evenly across.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Stir the mixture; bake for 15 minutes more. Stir once again, then press the mixture down firmly. Return to the oven for 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let granola cool and dry for at least 2 hours. Crumble and transfer to an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
