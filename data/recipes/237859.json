  "ingredients": [
    "2 cups rolled oats",
    "1 cup brown sugar",
    "0.66666668653488 cup whole wheat flour",
    "2 tablespoons chia seeds",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.66666668653488 cup applesauce",
    "3 tablespoons coconut oil",
    "1 cup dried cranberries",
    "0.5 cup chocolate chips",
    "0.25 cup shredded unsweetened coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, brown sugar, flour, chia seeds, cinnamon, baking soda, baking powder, and salt in a bowl. Stir applesauce and coconut oil into oat mixture until dough is evenly mixed. Fold cranberries, chocolate chips, and shredded coconut into dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges of cookies are lightly browned, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
