  "ingredients": [
    "2 pounds lean ground beef",
    "2 (15 ounce) cans kidney beans, drained and rinsed",
    "2 cups water",
    "1 (15 ounce) can tomato sauce",
    "1 (11 ounce) can whole kernel corn, drained",
    "1 (6 ounce) can tomato paste",
    "0.5 red onion",
    "2 jalapeno peppers",
    "1 habanero pepper",
    "2 large cloves garlic",
    "3 tablespoons masa harina flour",
    "4 tablespoons chili powder",
    "1 tablespoon ground cayenne pepper",
    "2 teaspoons white sugar",
    "1.5 teaspoons salt",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Cook and stir ground beef in a large skillet over medium heat until crumbly and evenly browned, 5 to 7 minutes. Drain grease and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beans, water, tomato sauce, corn, and tomato paste in a large pot; bring to a boil. Reduce heat to low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onion, jalapeños, habanero, and garlic in the bowl of a food processor; pulse until finely chopped. Stir onion mixture into bean mixture; stir in ground beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in masa flour until incorporated; season with chili powder, cayenne pepper, sugar, salt, and black pepper; simmer, stirring occasionally, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
