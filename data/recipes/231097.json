  "ingredients": [
    "5 pounds chicken leg quarters",
    "2 gallons water",
    "2 tablespoons minced garlic",
    "2 tablespoons salt",
    "1 tablespoon garlic powder",
    "1 cube chicken bouillon",
    "4 large carrots, peeled and cut into large chunks",
    "4 large potatoes, peeled and cut into large chunks",
    "4 zucchini, cut into large chunks",
    "1 chayote, cut into large chunks",
    "1 large white onion, cut into large chunks",
    "0.5 bunch fresh cilantro, chopped"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FvDyc4LrXRgTwEcZD0VE1sF1cWs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231097-caldo-de-pollo-ddmfs-Step1-7efee12c663f420d93296e04ccbc358c.jpg"
      ],
      "image": "assets/images/231097/step_01.webp"
    },
    {
      "text": "Place chicken legs into a large stockpot; cover with water. Add minced garlic, salt, and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iIyg2VrJlDzBnLNSrkdTsfmy9dk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231097-caldo-de-pollo-ddmfs-Step3-95e6d755ff43455291dfcf125e2eb98b.jpg"
      ],
      "image": "assets/images/231097/step_02.webp"
    },
    {
      "text": "Cover the pot; bring to a boil over high heat. Reduce to a simmer; cook until chicken meat falls off the bones, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/arXVZviR8E8mF3uzQLcWvHUost0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231097-caldo-de-pollo-ddmfs-Step4-8b90abcb4fb34fec805b06c3b5fb484b.jpg"
      ],
      "image": "assets/images/231097/step_03.webp"
    },
    {
      "text": "Stir in chicken bouillon cube until dissolved; add carrots, potatoes, zucchini, chayote, and white onion. Reduce heat to medium-low; simmer until carrots and potatoes are tender, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AHdxwV6npBZXgXzXV6nmuufDp2o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231097-caldo-de-pollo-ddmfs-Step7-e889570cebc04881a1bf902ebe22c906.jpg"
      ],
      "image": "assets/images/231097/step_04.webp"
    },
    {
      "text": "Stir chopped cilantro into soup; simmer for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eXwkVfOZ0kFxlf_h9oUOm_FHjcc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231097-caldo-de-pollo-ddmfs-Step9-4c09ad1036ad432b83c7e20b2a498fda.jpg"
      ],
      "image": "assets/images/231097/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
