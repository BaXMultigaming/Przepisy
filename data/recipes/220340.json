  "ingredients": [
    "2 pounds beef sirloin, cut into chunks",
    "0.25 teaspoon garlic salt, or to taste",
    "salt and ground black pepper to taste",
    "1 (32 ounce) carton beef stock",
    "1 (8 ounce) can tomato sauce",
    "1 cup water",
    "1 cup barley",
    "0.75 cup diced carrots",
    "1 (6 ounce) package sliced fresh mushrooms",
    "0.5 medium onion, diced",
    "4 cloves garlic, minced",
    "2 large bay leaves"
  ],
  "steps": [
    {
      "text": "Season beef with garlic salt, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place seasoned beef into a slow cooker with stock, tomato sauce, water, barley, carrots, mushrooms, onion, garlic, and bay leaves. Stir to combine, then cover and cook on Low until soup thickens and beef is tender, about 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Discard bay leaves before serving.",
      "section": null,
      "name": null,
      "url": null,
