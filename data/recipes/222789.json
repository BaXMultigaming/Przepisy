  "ingredients": [
    "1.5 cups chocolate syrup (such as Hershey's®)",
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "0.5 cup butter",
    "4 eggs",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "2 cups confectioners' sugar",
    "0.5 cup butter",
    "0.25 cup amaretto liqueur",
    "3 drops almond extract",
    "1 cup chocolate chips",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chocolate syrup, flour, white sugar, 1/2 cup butter, eggs, vanilla extract, and salt together in a bowl until smooth; spread into prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is dry and the edges have started to pull away from the sides of the pan, 30 to 45 minutes. Allow to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat confectioners' sugar, 1/2 cup butter, amaretto liqueur, and almond extract in a bowl until smooth; spread over cooled brownies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chocolate chips and 2 tablespoons butter together in a saucepan over low heat until melted and smooth, 1 to 2 minutes. Let cool slightly and drizzle over frosted brownies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
