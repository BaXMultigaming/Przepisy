  "ingredients": [
    "2 cups minced onion",
    "0.5 cup chopped fresh cilantro",
    "0.5 cup seeded, minced jalapeno pepper",
    "0.25 cup minced garlic",
    "1 cup oil",
    "0.75 cup fresh lime juice",
    "0.5 cup Mexican beer",
    "2 tablespoons tequila",
    "1 tablespoon ground black pepper",
    "0.5 tablespoon ground cumin"
  ],
  "steps": [
    {
      "text": "Combine the onion, cilantro, jalapeno pepper, garlic, oil, lime juice, beer, tequila, black pepper, and cumin in a blender; blend until smooth. Marinate fish or shrimp in the refrigerator in this marinade up to 2 hours before grilling.",
