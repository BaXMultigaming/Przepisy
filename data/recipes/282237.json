  "ingredients": [
    "1 (12 ounce) package meatless vegetarian ground beef",
    "1 small yellow onion, chopped",
    "2 cloves garlic, minced",
    "1.5 tablespoons salt",
    "1 teaspoon ground cumin",
    "nonstick canola oil spray",
    "6 medium soft flour tortillas",
    "1 large tomato, diced",
    "0.5 cup crumbled queso fresco",
    "0.25 cup chopped fresh cilantro, or to taste",
    "2 medium limes, cut into wedges"
  ],
  "steps": [
    {
      "text": "Heat a skillet over medium heat. Add Impossible Burger and cook until fully browned, about 10 minutes. Mix in 1/2 of the chopped onion, minced garlic, salt, and cumin. Cook and stir over low heat until fragrant, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a separate skillet with nonstick spray and warm flour tortillas over low heat until lightly toasted, about 30 seconds per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Assemble your tacos with the filling, remaining raw onion, tomato, queso fresco, and cilantro. Squeeze some lime juice over the tacos and serve remaining wedges alongside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
