  "ingredients": [
    "4 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1.5 teaspoons salt",
    "0.5 cup butter, cut into cubes and softened",
    "0.5 cup cold water",
    "1 cup vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X7-tQg4wjEE6G2bDhNHKXf_zUZg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-139948-Jamaican-Fried-Dumplings-ddmfs-4x3-step-01-45338b7215584308a0d088180cb9a393.jpg"
      ],
      "image": "assets/images/139948/step_01.webp"
    },
    {
      "text": "Mix flour, baking powder, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EjbI-dPAHDF1Mv_SMyuuO37mo4w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-139948-Jamaican-Fried-Dumplings-ddmfs-4x3-step-02-23a87824458b4a5a97d7bd32fce693a6.jpg"
      ],
      "image": "assets/images/139948/step_02.webp"
    },
    {
      "text": "Rub in butter until the mixture is crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_Ni4EVuppZuVF4kHpd9S_Al3844=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-139948-Jamaican-Fried-Dumplings-ddmfs-4x3-step-03-6fcbd2166e4a4675984256bf753abccd.jpg"
      ],
      "image": "assets/images/139948/step_03.webp"
    },
    {
      "text": "Mix in water, 1 tablespoon at a time, to form a firm dough; knead briefly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Vx6XvnrKgOJIkrRDUhYMtWU_4IY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-139948-Jamaican-Fried-Dumplings-ddmfs-4x3-step-04-20137d0b7fba46b3a5611fd5cd816310.jpg"
      ],
      "image": "assets/images/139948/step_04.webp"
    },
    {
      "text": "Heat oil in a large heavy skillet over medium heat. Break off pieces of dough and shape them into biscuit-like patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z6csMvorjv_1UwyE07i8828-7NE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-139948-Jamaican-Fried-Dumplings-ddmfs-4x3-step-06-0bcbf83cc0b94085a400235138b9d256.jpg"
      ],
      "image": "assets/images/139948/step_05.webp"
    },
    {
      "text": "Place just enough of the dumplings into the hot oil so they are not crowded; fry until golden brown, about 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dZ3m93Lij_PK6E5wWKjFg-_gFXA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-139948-Jamaican-Fried-Dumplings-ddmfs-4x3-step-07-786b1f8335874ddc918742ba30acac17.jpg"
      ],
      "image": "assets/images/139948/step_06.webp"
    },
    {
      "text": "Remove from the pan and drain on paper towels before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WALskTUIib4jESHGbxudY1bu7xg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-139948-Jamaican-Fried-Dumplings-ddmfs-4x3-step-08-9a15666ec19d4c129bb1827664787a68.jpg"
