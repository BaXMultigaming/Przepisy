  "ingredients": [
    "4 large eggs",
    "2 cups milk",
    "0.75 cup white sugar",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "2 tablespoons unsalted butter, melted",
    "6 slices stale bread",
    "0.5 cup chocolate chips",
    "1 tablespoon chia seeds",
    "0.25 cup brown sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 12-cup muffin tin or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a large bowl just until mixed. Add milk, white sugar, cinnamon, and salt; mix well. Mix in melted butter. Break bread into small pieces into the bowl and mix until well combined and bread is wet. Add chocolate chips and chia seeds; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide mixture evenly between the prepared muffin cups and sprinkle with brown sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
