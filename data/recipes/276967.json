    "1 tablespoon brown sugar",
    "1 tablespoon garlic powder",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon ground thyme"
  ],
  "steps": [
    {
      "text": "Combine beef, kidney beans, corn, water, Cheddar cheese, chocolate, chili powder, cumin, brown sugar, garlic powder, salt, black pepper, and thyme in a slow cooker.",
