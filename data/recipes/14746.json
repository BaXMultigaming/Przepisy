        "https://www.allrecipes.com/thmb/OhiY0OcM2_p9xnvm6oDfXtFD7FQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14746-Mushroom-Pork-Chops-ddmfs-step-03-67becd20b5d94bf3914ca5e6ef314af5.jpg"
      ],
      "image": "assets/images/14746/step_03.webp"
    },
    {
      "text": "Add mushrooms and onion to the same skillet and sauté for one minute.",
      "section": null,
      "name": null,
      "url": null,
