  "ingredients": [
    "4 pork chops",
    "salt and ground black pepper to taste",
    "1 pinch garlic salt, or to taste",
    "0.5 pound fresh mushrooms, sliced",
    "1 onion, chopped",
    "1 (10.75 ounce) can condensed cream of mushroom soup"
  ],
