  "ingredients": [
    "1 tablespoon extra-virgin olive oil",
    "1 large onion, finely chopped",
    "2 cloves garlic, minced",
    "2 pounds broccoli, chopped",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "5 cups vegetable broth",
    "0.25 cup freshly squeezed lemon juice",
    "0.25 cup shredded Cheddar cheese, or as desired"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat; once the oil is hot, reduce heat to low. Cook and stir onion and garlic in hot oil until softened, 3 to 5 minutes. Add broccoli, season with salt and pepper, and stir. Pour vegetable broth and lemon juice into the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Loosely cover the pot and simmer the mixture until the broccoli is tender, about 25 minutes. Puree with an immersion blender until smooth. Garnish with Cheddar cheese to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
