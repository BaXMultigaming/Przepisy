  "ingredients": [
    "2.5 gallons vodka",
    "6 (12 ounce) packages frozen raspberries",
    "4.5 cups white sugar",
    "4 cups water"
  ],
  "steps": [
    {
      "text": "Combine vodka, raspberries, sugar, and water in a large, non-metallic container; press and muddle raspberries until incorporated into mixture. Set mixture aside at room temperature for 5 to 6 days, stirring for 10 to 15 minutes each day.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain mixture multiple times through a fine-mesh strainer or cheesecloth until berries and seeds are removed and liquid is lighter in color.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
