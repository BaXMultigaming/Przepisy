  "ingredients": [
    "0.75 cup white sugar",
    "0.25 cup milk",
    "2.5 tablespoons unsalted butter",
    "1 tablespoon corn syrup",
    "8 ounces chopped marshmallows",
    "2 tablespoons water",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine sugar, milk, butter, and corn syrup in a saucepan over low heat; stir until sugar dissolves. Bring to a boil, then lower heat and simmer for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt marshmallows in the top of a double boiler, melt the marshmallows with the water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir melted marshmallows into the hot syrup mixture until no streaks remain. Remove from the heat and stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
