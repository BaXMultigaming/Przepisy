  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.75 cup canola oil",
    "0.66666668653488 cup confectioners' sugar",
    "1 (14 ounce) can sweetened condensed milk",
    "3 eggs",
    "0.5 cup lemon juice",
    "0.33333334326744 cup white sugar",
    "1 lemon, zested",
    "0.25 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, oil, and sugar in a bowl. Pat into a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden around the edges, about 20 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat sweetened condensed milk, eggs, lemon juice, sugar, lemon zest, and baking powder together until just blended. Pour over the cooled crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake until the filling is set, 13 to 17 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for at least 2 hours before cutting into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
