  "ingredients": [
    "1 pound linguine pasta",
    "3 tomatoes",
    "0.33333334326744 cup olive oil",
    "3 cloves garlic, minced",
    "1 pound mushrooms, sliced",
    "1 teaspoon dried oregano",
    "0.75 cup crumbled feta cheese",
