  "ingredients": [
    "1 tablespoon salt",
    "4 large green bell peppers - tops, seeds, and membranes removed",
    "1 tablespoon olive oil",
    "0.5 cup chopped onion",
    "2 cups cooked rice",
    "1 (15 ounce) can black beans, drained and rinsed",
    "1 (14.5 ounce) can chili-style diced tomatoes",
    "1 teaspoon chili powder",
    "1 teaspoon garlic salt",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon salt",
    "1 (8 ounce) package shredded Mexican cheese blend (such as Sargento® Authentic Mexican)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water and 1 tablespoon salt to a boil. Add green bell peppers and cook until slightly softened, 3 to 4 minutes. This will prevent the bell peppers from becoming crispy as they bake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain bell peppers and arrange cut-side up in a 9x9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KbnbxEpqoRlQtZ09STs1dSEP8QM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231514-vegetarian-mexican-inspired-stuffed-peppers-step1-540-d78b144f0b2b48df8c8e1a3224017ea6.jpg"
      ],
      "image": "assets/images/231514/step_03.webp"
    },
    {
      "text": "Heat olive oil in a skillet over medium heat. Add onion; cook and stir until softened, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cooked onion into a large bowl; add rice, black beans, and tomatoes. Stir in chili powder, garlic salt, cumin, and 1/2 teaspoon salt until well combined. Fold in 1 1/2 cups Mexican cheese blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RelXpV4zf8iTkP_A0-VOyqX30oI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231514-vegetarian-mexican-inspired-stuffed-peppers-step3-544-928c0057dc514ffbac18e916dce506d3.jpg"
      ],
      "image": "assets/images/231514/step_05.webp"
    },
    {
      "text": "Spoon rice mixture evenly into bell peppers; sprinkle with remaining Mexican cheese blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nxA8owXNZvSPTeiu7uraTmWcAlE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231514-vegetarian-mexican-inspired-stuffed-peppers-step4-549-65553ce9063b4b2fa438a4dfcc46e84c.jpg"
      ],
      "image": "assets/images/231514/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and bubbling, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E3Fb_InQzzaBJwaP2W4nCn-nzDs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231514-vegetarian-mexican-inspired-stuffed-peppers-DDMFS-4x3-5be7a1f8b64d4465848ddb9a3aef4084.jpg"
      ],
      "image": "assets/images/231514/step_07.webp"
    }
  ],
