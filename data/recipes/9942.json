  "ingredients": [
    "1.5 cups dates, pitted and chopped",
    "0.25 cup butter",
    "2 eggs",
    "1 cup white sugar",
    "0.25 teaspoon salt",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped walnuts",
    "3 cups crisp rice cereal",
    "0.5 cup flaked coconut",
    "0.33333298563957 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Melt butter or margarine in heavy skillet. Add slightly beaten eggs. Stir in dates, sugar, salt, and vanilla. Cook over low heat stirring constantly until thick and well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Have ready crisp rice cereal and chopped nuts in large bowl. Stir cooked mixture into them until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill. Put, by teaspoonful, on cookie sheet. Chill again. When cold, roll in crisp rice crumb and coconut mixture or powdered sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
