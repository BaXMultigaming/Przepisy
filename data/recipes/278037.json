  "ingredients": [
    "12 ounces sage-flavored bulk pork sausage",
    "2 tablespoons butter",
    "1 medium onion, chopped",
    "2 ribs celery, sliced",
    "6 button mushrooms, sliced",
    "0.25 cup chopped carrots",
    "1 (2 pound) head cauliflower, cut into small florets",
    "0.5 cup chicken broth",
    "0.25 cup freshly chopped parsley",
    "0.5 teaspoon dried thyme leaves",
    "1 pinch salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place sausage into a large skillet and cook over medium-high heat until browned and crumbly, about 5 minutes. Add butter, then stir in onion, celery, mushrooms, and carrots; cook for 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in cauliflower, broth, parsley, thyme, salt, and pepper. Cover and cook 10 minutes. Uncover and cook until liquid is absorbed, about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
