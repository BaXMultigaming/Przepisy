  "ingredients": [
    "1.5 teaspoons active dry yeast",
    "0.5 teaspoon white sugar",
    "0.5 cup lukewarm water",
    "2 cups sifted all-purpose flour",
    "0.5 teaspoon salt",
    "2 tablespoons olive oil",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Stir yeast and sugar into lukewarm water, using a fork. Let stand in a warm place until a creamy layer forms on top of the water, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and salt in a large bowl. Mix olive oil into flour and stir for 2 minutes. Pour yeast mixture and beaten egg into flour mixture and stir to make a stiff dough. Turn dough out onto a floured work surface and knead until springy and smooth, about 8 minutes. Place dough into a floured bowl and cover with a piece of plastic wrap wiped with a thin film of olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let dough rise until doubled, about 1 hour. Punch down and roll out to desired shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
