  "ingredients": [
    "1 (8 ounce) package reduced-fat cream cheese",
    "0.5 (8 ounce) package shredded Cheddar cheese",
    "12 meatless turkey-flavored deli slices (such as Tofurky®), chopped",
    "0.33333334326744 cup dried cranberries",
    "0.25 cup pecans",
    "1 celery stick, chopped",
    "2 green onions, chopped",
    "1 tablespoon chopped fresh chives",
    "salt and ground black pepper to taste",
    "3 large flour tortillas"
  ],
  "steps": [
    {
      "text": "Combine cream cheese and Cheddar cheese in a food processor; process until blended. Add meatless turkey slices, cranberries, pecans, celery, green onions, chives, salt, and black pepper. Process until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cream cheese mixture onto each tortilla and roll up. Serve immediately or refrigerate until serving time.",
