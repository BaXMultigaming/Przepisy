  "ingredients": [
    "1 cup butter",
    "1 cup light brown sugar",
    "1 cup white sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "3 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1.5 cups rolled oats",
    "2 cups white chocolate chips",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the butter, brown sugar and white sugar until smooth. Stir in the eggs, one at a time, and then the vanilla. Sift together the flour, baking powder, baking soda and salt, stir into the creamed mixture. Finally, stir in the rolled oats, white chocolate chips and pecans. Drop by tablespoons onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 to 12 minutes in the preheated oven. Remove from baking sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
