  "steps": [
    {
      "text": "Heat the oil in a skillet over medium heat. Cook the onion in the hot oil until soft, but do not brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the tomato paste, 3 tablespoons water, brown sugar, salt, cumin, mustard, cinnamon, cloves, and vinegar in a pot over medium heat; simmer 2 minutes; stir in the cooked onion. Mix together 1 tablespoon vegetable oil, curry powder, Hungarian paprika, ketchup, and 1 cup water in a bowl; stir into tomato paste mixture; simmer another 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the bratwurst in a large skillet over medium heat until browned. Pour the sauce into the skillet with the bratwurst. Reduce heat to low and cook until sausages reach an internal temperature of 165 degrees F (75 degrees C), about 10 minutes.",
