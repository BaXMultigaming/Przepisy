  "ingredients": [
    "2 (2 pound) packages frozen hash brown potatoes",
    "0.5 cup chopped onion",
    "2 (10.75 ounce) cans condensed cream of chicken soup",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "2 tablespoons chopped fresh chives",
    "0.25 pound butter, melted",
    "1 (8 ounce) container sour cream",
    "0.5 cup shredded sharp Cheddar cheese",
    "1 tablespoon bacon bits",
    "0.5 cup crushed potato chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a six quart casserole dish, mix together the hashbrowns, onion, chicken soup, mushroom soup, chives, butter, sour cream and cheese. Bake covered for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven, sprinkle with bacon and potato chips. Bake uncovered for 15 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
