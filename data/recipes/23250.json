  "title": "Stuffed and Baked Tomatoes",
  "description": "This is a hearty, filling side dish that looks and tastes great. Tomatoes are stuffed with rice, bell pepper, onion, parsley and garlic.",
  "authors": [
    "Krista B"
  ],
  "date_published": "2000-10-26T22:08:30-04:00",
