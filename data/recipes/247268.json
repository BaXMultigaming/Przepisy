  "ingredients": [
    "1 eggplant, peeled and cut into 1/2-inch cubes",
    "salt to taste",
    "0.25 cup olive oil, divided",
    "1 cup finely chopped celery",
    "1 medium onion, finely chopped",
    "1 clove garlic, minced",
    "1.5 cups canned plum tomatoes, drained and coarsely chopped",
    "12 green olives, pitted and coarsely chopped",
    "1.5 tablespoons drained capers",
    "1 tablespoon tomato paste",
    "1 teaspoon minced oregano",
    "2 tablespoons red wine vinegar",
    "2 teaspoons white sugar",
    "1 teaspoon salt",
    "ground black pepper to taste",
    "2 teaspoons minced fresh parsley, or to taste"
  ],
  "steps": [
    {
      "text": "Toss eggplant with salt and place in a colander set over a bowl. Let sit, about 30 minutes. Rinse and pat dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XwQrS8_68DKiK3VPrVpy5V8OCT4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/247268-eggplant-caponata-sicilian-version-step1-299-4x3-77c4b0e6687a470498bfd115586939d6.jpg"
      ],
      "image": "assets/images/247268/step_01.webp"
    },
    {
      "text": "Heat 2 tablespoons olive oil in a large skillet over medium heat. Add celery; cook, stirring often, until softened, about 3 to 4 minutes. Add onion and garlic; cook and stir until onion is soft and lightly golden, about 4 to 5 minutes. Transfer the mixture to a bowl using a slotted spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0ho3pkjTnI-xO-iX6VMHUfWIfAs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/247268-eggplant-caponata-sicilian-version-step2-302-4x3-37faca01823f4e9fb31b41e90b941878.jpg"
      ],
      "image": "assets/images/247268/step_02.webp"
    },
    {
      "text": "Heat remaining 2 tablespoons olive oil in the skillet. Add eggplant and cook, stirring constantly, until lightly browned, 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ApHgYK8y8oRkQVwrEwKsjygkvmg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/247268-eggplant-caponata-sicilian-version-step3-304-4x3-b5e81ac1e0534037870916f6063814af.jpg"
      ],
      "image": "assets/images/247268/step_03.webp"
    },
    {
      "text": "Stir in celery mixture, tomatoes, olives, capers, tomato paste, and oregano. Bring to a boil; reduce heat to low and simmer uncovered until caponata is thickened, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aR3mm_felT49GPa7ysyN93gdhXw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/247268-eggplant-caponata-sicilian-version-step5-309-4x3-c3dfb32f9407484eb22ee5157402af4f.jpg"
      ],
      "image": "assets/images/247268/step_04.webp"
    },
    {
      "text": "Season caponata with vinegar, sugar, salt, and black pepper. Transfer to a serving bowl and garnish with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
