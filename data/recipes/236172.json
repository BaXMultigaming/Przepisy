  "ingredients": [
    "1 cup chocolate chips",
    "1 cup brown sugar",
    "0.875 cup whole wheat flour",
    "0.25 cup cocoa powder",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup soy milk",
    "0.25 cup grapeseed oil",
    "0.25 cup unsweetened applesauce",
    "2 eggs",
    "2 teaspoons apple cider vinegar",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease 12 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk chocolate chips, brown sugar, flour, cocoa powder, baking soda, baking powder, and salt together in a bowl. Whisk soy milk, oil, applesauce, eggs, vinegar, and vanilla extract together in a separate bowl; stir into flour mixture until batter is just combined. Spoon batter into prepared muffin cups until each cup is 3/4-full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
