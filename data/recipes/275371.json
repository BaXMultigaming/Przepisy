  "ingredients": [
    "0.5 cup water",
    "2 teaspoons cornstarch",
    "1 cup blackberries",
    "2 tablespoons stevia sugar substitute (such as Truvia®)",
    "0.125 teaspoon ground cinnamon",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Mix together water and cornstarch in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place blackberries in a small pot and sprinkle with sweetener and cinnamon. Add cornstarch mixture and bring to a boil over medium-high heat. Reduce heat to medium-low and simmer, stirring constantly, until desired thickness is reached, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat, add vanilla, and stir.",
