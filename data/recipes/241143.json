  "ingredients": [
    "1 (4 pound) pork shoulder roast",
    "2 tablespoons coarse kosher salt, or to taste",
    "1 (12 fluid ounce) can or bottle root beer",
    "1 (4 fluid ounce) bottle liquid smoke flavoring, or to taste",
    "4 cloves garlic"
  ],
  "steps": [
    {
      "text": "Place pork roast in a slow cooker, rub with salt, and pour root beer, liquid smoke, and garlic over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 8 to 10 hours. Remove pork to a bowl. Strain liquid through a fine-mesh strainer; discard liquid or save for another use (see Editor's Notes). Add garlic cloves back to pork. Shred pork using two forks. Serve with your favorite BBQ sauce.",
      "section": null,
