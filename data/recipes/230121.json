  "title": "Very Moist and Flavorful Roast Turkey",
  "description": "Stuff a turkey with garlic cloves, apple, onion, and celery pieces and slide bits of butter beneath the skin for a perfectly roasted, juicy bird.",
  "authors": [
    "Andie"
  ],
  "date_published": "2019-04-02T02:59:26-04:00",
  "date_modified": "2024-10-10T10:49:29-04:00",
  "prep_time": "PT20M",
