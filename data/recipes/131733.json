  "ingredients": [
    "1 cup mayonnaise",
    "2 tablespoons white sugar",
    "2 tablespoons lemon pepper seasoning",
    "2 tablespoons finely minced garlic",
    "1 tablespoon minced fresh parsley",
    "1 tablespoon oyster sauce",
    "2 pounds extra large shrimp (16-20), peeled and deveined, tail left on",
    "12 (10 inch) wooden skewers"
  ],
  "steps": [
    {
      "text": "Mix mayonnaise, sugar, lemon-pepper seasoning, garlic, parsley, and oyster sauce together in a large bowl or resealable bag until well combined. Add shrimp, coat with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator, 1 hour to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Soak skewers in water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove shrimp from marinade and shake off excess. Discard remaining marinade. Thread shrimp onto skewers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook shrimp on the preheated grill until pink and firm, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
