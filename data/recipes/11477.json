  "ingredients": [
    "3 cups all-purpose flour",
    "0.5 cup poppy seeds",
    "1.5 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 cup butter, softened",
    "0.66666668653488 cup white sugar",
    "1 egg, separated",
    "2 tablespoons lemon zest",
    "0.25 cup lemon juice",
    "0.33333334326744 cup granulated sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together the flour, poppy seeds, baking powder, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar together in a medium bowl until light and fluffy; beat in egg yolk, lemon zest, and lemon juice. Fold in flour mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough in half and roll each half out on a lightly floured surface until 1/8- to 1/4-inch thick. Cut with cookie cutters and place cookies on the prepared baking sheet. Brush the tops of cookies with beaten egg white and sprinkle with white sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 12 to 15 minutes or until golden, the edges should be light brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
