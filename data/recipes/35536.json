  "ingredients": [
    "4 medium potatoes",
    "4 tablespoons butter, softened",
    "4 tablespoons coarse salt",
    "2 tablespoons garlic powder",
    "1 tablespoon pepper",
    "2 tablespoons Italian seasoning"
  ],
