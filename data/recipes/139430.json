  "ingredients": [
    "4 cloves garlic",
    "1 teaspoon minced fresh ginger",
    "1 onion, roughly chopped",
    "2.5 cups low sodium soy sauce",
    "0.25 cup toasted sesame oil",
    "3 tablespoons Worcestershire sauce",
    "2 tablespoons unseasoned meat tenderizer",
    "1 cup white sugar",
    "2 pounds beef flank steak, trimmed of excess fat"
  ],
  "steps": [
    {
      "text": "Place garlic, ginger, and onion in the bowl of a blender. Add soy sauce, sesame oil, Worcestershire sauce, meat tenderizer, and sugar. Puree until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the marinade into a resealable plastic bag or glass bowl. Score the flank steak and place into the marinade. Marinate overnight in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a grill for medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill steak on preheated grill to desired doneness, about 7 minutes per side for medium.",
      "section": null,
