  "ingredients": [
    "1 tablespoon extra-virgin olive oil",
    "4 large heads baby bok choy, halved lengthwise, or more to taste",
    "0.25 cup chicken stock",
    "3 tablespoons soy sauce"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium-high heat until hot, but not smoking. Add bok choy; cook, flipping once, until just golden, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add stock and soy sauce to the skillet. Cover the skillet, reduce heat to medium, and simmer until bok choy is tender, about 5 minutes. Transfer bok choy to a serving platter; reserve liquid in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook liquid over medium-high heat until reduced by half, 1 to 2 minutes; pour over bok choy to serve.",
