  "ingredients": [
    "1.5 cups whole wheat flour",
    "1 scoop whey protein powder",
    "1.5 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground ginger",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups grated carrot",
    "0.5 cup raisins",
    "0.5 cup maple syrup",
    "0.33333334326744 cup olive oil",
    "1 cup plain Greek yogurt",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "3 tablespoons pumpkin seeds",
    "2 tablespoons raw sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line two 4-cup jumbo muffin tins with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, protein powder, baking powder, cinnamon, ginger, nutmeg, baking soda, and salt together in a large bowl; gently stir in carrots and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk maple syrup and olive oil together in a medium bowl; beat in yogurt, eggs, and vanilla extract. Stir maple syrup mixture into flour mixture until just combined; batter will be a bit lumpy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter among the prepared muffin cups; sprinkle tops with pumpkin seeds and raw sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and a toothpick inserted into center of largest muffin comes out clean, about 15 minutes. Cool on a wire rack before serving, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
