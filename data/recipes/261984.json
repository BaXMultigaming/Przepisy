  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "2 cups shredded Cheddar cheese",
    "10 jalapeno peppers, halved and seeded",
    "1 (12 ounce) package turkey bacon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cream cheese and Cheddar cheese in a large bowl until well combined. Spread cream cheese mixture into the center of each jalapeño half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut bacon slices in half crosswise. Wrap 1 bacon strip around the center of each jalapeño half. Place wrapped jalapeños on a nonstick baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bacon is cooked and jalapeños are slightly tender, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
