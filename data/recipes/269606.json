  "ingredients": [
    "0.75 stick unsalted butter",
    "1 large yellow onion, chopped",
    "0.5 cup chopped fresh ginger",
    "5 cloves garlic, minced",
    "7 cups low-sodium chicken broth",
    "1.5 pounds carrots, peeled and cut into 1/2-inch pieces",
    "1 cup dry white wine",
    "2 tablespoons fresh lemon juice",
    "1 teaspoon salt",
    "1 teaspoon freshly ground black pepper, or more to taste",
    "0.125 teaspoon curry powder",
    "1 tablespoon snipped fresh chives, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XYWIctlVoxHYbfH06_kQAFIx7qg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-269606-carrot-ginger-soup-VAT-step-01-e9cf11eb871a4597858d9907a5e403f9.jpg"
      ],
      "image": "assets/images/269606/step_01.webp"
    },
    {
      "text": "Melt butter in a large pot over medium heat. Add onion, ginger, and garlic; sauté until softened, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BIpezQBmsJIGBrA8bCR4Ki0JETg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-269606-carrot-ginger-soup-VAT-step-02-4e60f168d3254e21b2b6beb7044f2810.jpg"
      ],
      "image": "assets/images/269606/step_02.webp"
    },
    {
      "text": "Add broth, carrots, and wine; bring to a boil. Reduce heat to medium and simmer, uncovered, until carrots are tender, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bzbFtVIjSOYEdTKMLh-GxdLMe10=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-269606-carrot-ginger-soup-VAT-step-03-30ded0b1177e4ed9864e319fcf13bb38.jpg"
      ],
      "image": "assets/images/269606/step_03.webp"
    },
    {
      "text": "Puree with an immersion blender until carrots are no longer chunky and soup has a thick consistency. Add lemon juice, salt, pepper, and curry powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eSo-xWnIKn31dZ9Ui7-XFbq85Gc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-269606-carrot-ginger-soup-VAT-step-04-1blending-0a9203e1a00f426d8f6afaacf69e65d5.jpg"
      ],
      "image": "assets/images/269606/step_04.webp"
    },
    {
      "text": "Serve in large mugs with chives and fresh black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oqFyWrjU79uoQKPYoim5cy9LYJE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-269606-carrot-ginger-soup-VAT-step-05-128640b7bd9446dbbf09f86b45ef1173.jpg"
