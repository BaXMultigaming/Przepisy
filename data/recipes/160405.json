  "ingredients": [
    "3 tablespoons honey",
    "3 tablespoons balsamic vinegar",
    "3 tablespoons olive oil",
    "1 tablespoon fresh lemon juice",
    "1 teaspoon Worcestershire sauce",
    "0.5 teaspoon dried tarragon",
    "0.5 teaspoon dried rosemary, crushed",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon white pepper",
    "1 pinch salt",
    "1.5 pounds flat iron steak"
  ],
  "steps": [
    {
      "text": "Whisk together honey, vinegar, olive oil, lemon juice, Worcestershire sauce, tarragon, rosemary, garlic powder, white pepper, and salt in a large bowl until well combined; pour into a resealable plastic bag. Add flat iron steak; coat with marinade, squeeze out excess air, and seal the bag. Place in the refrigerator to marinate for at least 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steak from marinade; shake off excess and discard marinade. Cook steak on the preheated grill to desired degree of doneness, about 4 minutes per side for medium-rare. An instant-read thermometer inserted into the center of steak should read 140 degrees F (60 degrees C) for medium-rare doneness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
