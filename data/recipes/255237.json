  "ingredients": [
    "1 cup butter",
    "1 cup white sugar",
    "0.5 cup brown sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2.5 cups all-purpose flour",
    "2 teaspoons salt",
    "1 teaspoon baking powder",
    "2 cups milk chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, brown sugar, eggs, and vanilla extract in a bowl with an electric mixer until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, salt, and baking powder together in a bowl. Stir the flour mixture slowly into the butter mixture until well combined; fold in chocolate chips. Place spoonfuls of dough onto a nonstick baking sheet about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
