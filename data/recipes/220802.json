  "ingredients": [
    "1 cup mashed banana",
    "1 teaspoon lemon juice",
    "0.25 teaspoon salt",
    "0.5 cup unsalted butter, softened",
    "7 cups powdered sugar"
  ],
  "steps": [
    {
      "text": "Beat mashed banana, lemon juice, and salt together in a large bowl with an electric mixer on medium speed for 30 seconds. Beat in softened butter until creamy, about 1 minute. Slowly beat in confectioners’ sugar, 1 cup at a time, until smooth.",
