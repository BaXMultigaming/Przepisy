  "ingredients": [
    "5 tablespoons white sugar",
    "2 teaspoons ground cinnamon",
    "5 medium apples - peeled, cored, and thinly sliced",
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "4 large eggs",
    "0.5 cup orange juice",
    "3 teaspoons baking powder",
    "1 teaspoon salt",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 5 tablespoons sugar and cinnamon in a large bowl. Add apple slices; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat flour, 2 cups sugar, oil, eggs, orange juice, baking powder, salt, and vanilla extract in a separate bowl until smooth and thoroughly blended. Batter will be thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer ½ batter to the prepared pan; top with ½ apple slices. Add remaining ½ batter; neatly arrange remaining ½ apple slices on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 ¼ hours. Cool in the pan for 1 hour. Run a table knife around the edges to loosen. Invert carefully onto a cooling rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
