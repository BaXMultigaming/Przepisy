  "ingredients": [
    "1 (18.25 ounce) package lemon cake mix",
    "0.33333334326744 cup white sugar",
    "0.5 cup vegetable oil",
    "1 cup apricot nectar",
    "4 eggs",
    "1 cup confectioners' sugar",
    "2 tablespoons lemon juice"
  ],
  "steps": [
    {
      "text": "Grease and flour a 10 inch tube pan. Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix with sugar, cooking oil, and apricot nectar. Beat for two minutes with mixer. Add eggs one at a time, beating for 30 seconds after each addition. Pour batter into pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 50 to 60 minutes. Cool for 10 minutes in the pan before turning out onto a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix lemon juice with confectioners' sugar until you reach desired consistency. Drizzle glaze over sides of warm cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
