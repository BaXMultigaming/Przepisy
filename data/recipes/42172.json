  "ingredients": [
    "7 pounds boneless chuck roast",
    "1 cup water",
    "3 tablespoons white vinegar",
    "4 tablespoons brown sugar",
    "2 teaspoons dry mustard",
    "4 tablespoons Worcestershire sauce",
    "3 cups ketchup",
    "2 teaspoons salt",
    "0.75 teaspoon ground black pepper",
    "0.25 teaspoon cayenne pepper",
    "6 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Place the roast into a slow cooker along with the water. Cover, and cook on LOW for 2 to 4 hours, or until beef can be easily shredded with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred the beef, removing fat as you go. Remove 1/2 cup of the broth from the slow cooker, and reserve for later. Add the vinegar, brown sugar, dry mustard, Worcestershire sauce and ketchup. Mix in the salt, pepper, cayenne, and garlic. Stir so that the meat is well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and continue to cook beef on LOW for an additional 4 to 6 hours. Add the reserved broth only if necessary to maintain moisture. Serve on toasted buns. The meat can be frozen for future use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
