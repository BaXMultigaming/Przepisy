  "ingredients": [
    "5 tablespoons butter",
    "3 medium ripe bananas, pureed",
    "0.5 cup brown sugar",
    "2 tablespoons lemon juice",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon lemon zest",
    "0.125 teaspoon salt",
    "2 eggs",
    "1 egg yolk"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium-low heat. Add banana puree, brown sugar, lemon juice, vanilla extract, cinnamon, lemon zest, and salt. Cook, stirring constantly, until slightly thickened, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and egg yolk in a bowl until foamy. Add 2 to 3 tablespoons hot banana mixture to temper the eggs. Slowly add egg-banana mixture to saucepan and cook, stirring constantly, until the back of a spoon is coated with the curd, 4 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
