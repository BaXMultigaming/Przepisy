  "ingredients": [
    "1 pound ground turkey sausage",
    "2 cups shredded sharp Cheddar cheese",
    "1 tablespoon Montreal steak seasoning",
    "1 teaspoon fennel seeds, crushed",
    "2 cups baking mix (such as Bisquick®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sausage, Cheddar, steak seasoning, and fennel seeds together by hand in a large bowl. Mix in 1/2 of the baking mix until thoroughly incorporated; repeat with remaining baking mix. Roll 1-tablespoon portions of mixture into balls. Place onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, 20 to 25 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
