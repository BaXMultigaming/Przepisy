  "title": "Concord Grape Jelly",
  "description": "This homemade grape jelly recipe has been passed down the generations. It makes a gift-worthy sweet treat for all the grape jelly lovers in your life!",
  "authors": [
    "SWIZZLESTICKS"
  ],
  "date_published": "2020-06-18T23:07:31-04:00",
  "date_modified": "2025-12-19T09:35:42-05:00",
  "prep_time": "PT30M",
