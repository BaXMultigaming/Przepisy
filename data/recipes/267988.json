  "ingredients": [
    "2.3333332538605 cups all-purpose flour",
    "0.75 cup butter",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "2 eggs",
    "0.25 cup peanut butter",
    "1 cup quick-cooking oats",
    "0.75 cup semisweet chocolate chips",
    "0.75 cup miniature marshmallows",
    "0.5 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets or line with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, butter, baking soda, and baking powder in a large bowl and mix until well blended. Beat in white sugar, brown sugar, eggs, and peanut butter. Add oats, chocolate chips, and marshmallows; mix dough with a spoon or by hand.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place coconut flakes in a plate or shallow dish. Shape dough into 1-inch balls. Flatten slightly and press one side of each cookie into the coconut flakes. Place cookies 2 inches apart on the cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden brown, about 10 minutes. Transfer to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
