  "ingredients": [
    "1 (10 ounce) package frozen chopped spinach, thawed",
    "1 bunch green onions, finely chopped (white parts only)",
    "4 eggs, beaten",
    "1 (16 ounce) package cottage cheese",
    "2 cups shredded Cheddar cheese",
    "0.25 cup crushed croutons"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Lightly grease a 9 inch pie or quiche pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place spinach in a small saucepan. Cook over medium heat, stirring occasionally until soft. Drain off any remaining liquid. Stir in green onions, eggs, cottage cheese and Cheddar cheese. Pour mixture into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered in preheated oven for 45 minutes. Remove from oven and sprinkle with crushed croutons. Return to oven and bake for an additional 15 minutes, until eggs are set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
