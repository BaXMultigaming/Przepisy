  "ingredients": [
    "1 cup sweetened flaked coconut",
    "3 cups half-and-half",
    "0.75 cup white sugar",
    "0.5 cup all-purpose flour",
    "2 large eggs, beaten",
    "0.25 teaspoon salt",
    "1 teaspoon vanilla extract",
    "1 (9 inch) pie shell, baked",
    "1 cup frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iClVTgbO59L65bcnAuCsakIQ-TI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-12481-old-fashioned-coconut-cream-pie-ddmfs-ingredients-3x4-2763-c32dd8690b75487c9fa3013245fe8aba.jpg"
      ],
      "image": "assets/images/12481/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spread coconut on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake coconut in the preheated oven, stirring occasionally, until golden brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/evfWjF_LyfMCLNbNi3l2jfpqjaI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-12481-old-fashioned-coconut-cream-pie-ddmfs-step2-3x4-2774-72583d1c053f48ecae6bf6a642e13503.jpg"
      ],
      "image": "assets/images/12481/step_03.webp"
    },
    {
      "text": "Combine half-and-half, sugar, flour, eggs, and salt in a medium pot. Bring to a boil over low heat, stirring constantly, until mixture thickens and coats the back of a wooden spoon, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4YKqjUdVz4F_Dn4oLYsgjnr6eEY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-12481-old-fashioned-coconut-cream-pie-ddmfs-step3-3x4-2773-cf6d5ce1f9ee4c91b20229f2466a2dca.jpg"
      ],
      "image": "assets/images/12481/step_04.webp"
    },
    {
      "text": "Remove the pan from heat and stir in 3/4 cup toasted coconut and vanilla; reserve remaining toasted coconut for garnishing the pie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7kcEIQSSybcFuyKKSy4gnCmocUc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-12481-old-fashioned-coconut-cream-pie-ddmfs-step4-3x4-2777-95d20e324149482d8a1e66eb0c0b5cb8.jpg"
      ],
      "image": "assets/images/12481/step_05.webp"
    },
    {
      "text": "Pour custard into pie shell and chill until firm, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tZuDxuK_CRMaFLpXtetWCc0fNs4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-12481-old-fashioned-coconut-cream-pie-ddmfs-step5-3x4-2912-6e75d71fc14147c9925c16db8123c6ff.jpg"
      ],
      "image": "assets/images/12481/step_06.webp"
    },
    {
      "text": "Top with whipped topping and reserved toasted coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yegvnlpN5ENha2Z87WadACwUadw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-12481-old-fashioned-coconut-cream-pie-ddmfs-step6-3x4-2915-056a84eb6ad947149d3ea872fae997f2.jpg"
