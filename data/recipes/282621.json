  "title": "BBQ Pulled Chicken Sandwiches",
  "description": "Use a slow cooker to prepare these savory, crowd-pleasing, BBQ pulled chicken sandwiches for your next party.",
  "authors": [
    "Tara McDonald"
  ],
  "date_published": "2010-03-11T17:44:45-05:00",
