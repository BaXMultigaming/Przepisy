  "ingredients": [
    "1 egg",
    "0.5 teaspoon minced garlic",
    "1 tablespoon lemon juice",
    "1 teaspoon prepared yellow mustard",
    "0.75 cup vegetable or olive oil",
    "salt and pepper to taste"
