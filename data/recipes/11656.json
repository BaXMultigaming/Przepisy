  "ingredients": [
    "1 cup white sugar",
    "0.5 cup all-purpose flour",
    "6 tablespoons unsweetened cocoa powder",
    "0.125 teaspoon salt",
    "1 (4 ounce) jar pureed prunes baby food",
    "2 large eggs",
    "2 tablespoons vegetable oil",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together sugar, flour, cocoa, and salt in a mixing bowl. Add baby food, eggs, oil, and vanilla; mix until well blended. Spread batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is shiny and a toothpick inserted into the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cool completely before cutting into 16 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
