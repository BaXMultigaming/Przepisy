  "ingredients": [
    "1 (16 ounce) package square wonton wrappers",
    "1 pound sage-flavored bulk sausage",
    "2 cups shredded Colby cheese",
    "1 bunch green onions, chopped fine",
    "0.5 red bell pepper, chopped fine",
    "0.5 green bell pepper, chopped fine",
    "0.5 cup ranch salad dressing"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line each cup in a mini-muffin pan with a wonton wrapper, carefully pressing each into a star-shaped cup. Take care to not tear the wrapper as they will tear easily.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 8 to 10 minutes; transfer to a baking sheet. Repeat until remaining wonton wrappers are all baked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned completely, 5 to 7 minutes; drain and discard grease. Set sausage aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cooled sausage, Colby cheese, green onions, red bell pepper, green bell pepper, and ranch salad dressing together in a bowl; spoon into the wonton cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese has melted and is beginning to bubble, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
