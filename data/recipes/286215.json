  "ingredients": [
    "4 cups all-purpose flour",
    "0.25 cup white sugar",
    "2 tablespoons baking powder",
    "2 teaspoons salt",
    "0.5 teaspoon baking soda",
    "2 cups shredded Cheddar cheese",
    "1 (8 ounce) container sour cream",
    "0.5 cup canola oil",
    "0.33333334326744 cup milk",
    "2 large eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking powder, salt, and baking soda together in a bowl. Fold in Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sour cream, oil, milk, and eggs together in a small bowl. Add wet ingredients to the dry ingredients; stir just until moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead dough on a lightly floured surface 10 to 12 times. Pat out to a thickness of 3/4 inch. Cut into 3-inch squares or cut circles with a 3-inch cutter. Transfer to the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
