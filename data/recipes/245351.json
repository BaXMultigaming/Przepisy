  "ingredients": [
    "cooking spray",
    "1 pound ground beef",
    "1 onion, chopped",
    "2.5 cups all-purpose flour",
    "2 tablespoons white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "0.75 cup milk",
    "0.75 cup ketchup",
    "0.5 cup butter, melted",
    "2 eggs, lightly beaten",
    "1 tablespoon yellow mustard",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Spray 24 mini-muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium-high heat. Cook and stir beef and onions in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain excess fat and set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, white sugar, baking powder, and salt in a large bowl. Whisk milk, ketchup, melted butter, eggs, and mustard together in a separate bowl; stir into flour mixture until just moistened. Fold ground beef mixture and Cheddar cheese into batter; spoon into each muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake muffins in preheated oven until a toothpick inserted into the center comes out clean, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
