  "ingredients": [
    "2 cups packed brown sugar",
    "2 cups white sugar",
    "1 cup milk",
    "4 tablespoons butter",
    "1.5 cups peanut butter",
    "2 teaspoons vanilla extract",
    "2 cups miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Butter a 9-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 3-quart saucepan, combine brown sugar, white sugar, milk, and butter. Cook to soft ball stage, 234 degrees F (112 degrees C). Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in peanut butter, vanilla, and marshmallows; continue stirring until marshmallows are melted. Pour into the prepared pan and cool completely before cutting into 16 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
