  "ingredients": [
    "1 cup ghee (clarified butter)",
    "2 cups grated carrots",
    "1.5 cups milk",
    "1.5 cups water",
    "1.5 cups white sugar",
    "0.5 cup raisins",
    "1 tablespoon ground cardamom"
  ],
  "steps": [
    {
      "text": "Melt ghee in a saucepan over medium heat. Add carrots; cook and stir until soft, about 5 minutes. Add milk and bring to a boil. Cook and stir until thickened, about 10 minutes. Reduce heat to medium.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water and sugar in a bowl; stir to dissolve. Add to the saucepan with the carrots. Stir in raisins and cardamom. Cook and stir until raisins are plumped and mixture is thickened, about 10 minutes. Remove from heat.",
      "section": null,
