  "ingredients": [
    "0.5 pound butter, softened",
    "4.5 cups white sugar",
    "4 eggs, beaten",
    "1 cup evaporated milk",
    "2 teaspoons almond extract",
    "9 cups all-purpose flour",
    "9 tablespoons baking powder",
    "1 teaspoon ground cinnamon",
    "6 cups shredded coconut",
    "1 cup chopped dried mixed fruit",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease two 5x9 inch loaf pans and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend together the butter, sugar, eggs, evaporated milk and almond extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour, baking powder and cinnamon. Add to wet ingredients and stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add coconut, coarsely mixed dry chopped fruit and raisins. Mix well and pour into prepared loaf tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 35 minutes or until a toothpick inserted in the center comes out clean. Remove from pans and cool on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
