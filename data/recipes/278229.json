  "ingredients": [
    "cooking spray",
    "2 tablespoons packed light brown sugar",
    "2 tablespoons prepared horseradish",
    "1 teaspoon grated shallot",
    "0.5 teaspoon ground black pepper",
    "4 (4 ounce) filet mignon steaks"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 3 inches from the heat source and preheat the oven's broiler. Lightly spray a broiler pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, horseradish, shallot, and pepper in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place steaks on the prepared broiler pan and spread 1/2 of the brown sugar mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven for 5 minutes. Turn steaks, spread remaining brown sugar mixture over top, and broil to desired degree of doneness, 5 to 9 minutes longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
