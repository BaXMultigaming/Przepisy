  "ingredients": [
    "2.5 teaspoons onion powder",
    "2 teaspoons sea salt",
    "2 teaspoons garlic powder",
    "1.25 teaspoons dried oregano",
    "1.25 teaspoons dried thyme",
    "1 teaspoon ground black pepper",
    "1 teaspoon paprika",
    "1 teaspoon cayenne pepper",
    "1 teaspoon red pepper flakes",
    "1 cup olive oil mayonnaise",
    "0.33333334326744 cup sweet pickle relish",
    "1 medium lemon, juiced"
  ],
  "steps": [
    {
      "text": "Make the seasoning: Mix onion powder, salt, garlic powder, oregano, thyme, black pepper, paprika, cayenne pepper, and red pepper flakes together in a small bowl until well combined. Reserve 2 tablespoons seasoning for tartar sauce; save remaining seasoning in an airtight container for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the tartar sauce: Mix mayonnaise, relish, lemon juice, and 2 tablespoons seasoning in a bowl until well combined. Taste and adjust seasoning. Cover and chill tartar for at least 20 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
