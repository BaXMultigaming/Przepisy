  "ingredients": [
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.33300000429153 cup unsweetened cocoa powder",
    "0.5 cup butter, softened",
    "1 (3 ounce) package cream cheese, softened",
    "1 cup white sugar",
    "1 cup brown sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 tablespoon applesauce",
    "2 cups peanut butter chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Stir together the flour, baking soda, salt and cocoa; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter, cream cheese, white sugar and brown sugar until smooth. Beat in the eggs one at a time, then stir in the vanilla and applesauce. Blend in the dry ingredients to form a dough. Fold in the peanut butter chips by hand. Drop the dough by teaspoons two inches apart on a ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven. Allow cookies to cool on baking sheet for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
