  "ingredients": [
    "1 onion, minced",
    "0.66666668653488 cup white sugar",
    "1 tablespoon dry mustard",
    "1 teaspoon celery seed",
    "1 teaspoon black pepper",
    "0.5 cup distilled white vinegar",
    "0.5 cup olive oil",
    "1 head romaine lettuce, chopped",
    "1 (10 ounce) can mandarin oranges, drained",
    "5 ounces fresh mushrooms, sliced",
    "3 tablespoons slivered almonds",
    "3 tablespoons crumbled cooked bacon"
  ],
  "steps": [
    {
      "text": "Place the onion, sugar, mustard, celery seed, and black pepper into a small bowl. Pour in the vinegar, and stir until the sugar has dissolved. Whisk in the olive oil until the dressing is thick. Cover, and refrigerate at least 3 hours.",
      "section": null,
      "name": null,
      "url": null,
