  "ingredients": [
    "1 cup white sugar",
    "0.25 cup butter, softened",
    "2 eggs",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "25 plums, pitted and halved",
    "2 cups brown sugar",
    "2 cups all-purpose flour",
    "0.5 cup cold butter, cut into cubes"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, softened butter, and eggs together in a bowl until creamy. Whisk 2 cups flour and baking powder together in another bowl. And flour mixture to butter mixture and stir until just combined. Press mixture into the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange plums on top of butter mixture in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar, 2 cups flour, and 1/2 cup cold butter together in a bowl until mixture resembles coarse crumbs. Spread crumble mixture over plums in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake is set and plums are soft, about 1 hour 30 minutes. Cool for 1 hour before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
