  "ingredients": [
    "4 pounds corned beef brisket",
    "1 cup brown sugar",
    "1 (12 fluid ounce) can or bottle Irish stout beer (e.g. Guinness(r))"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E1HTnWnsyhjQtRZwLTtSOufL6g4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-46530-guinness-corned-beef-VAT-step-01-4201d29d8ef64060afc9b2cbed616702.jpg"
      ],
      "image": "assets/images/46530/step_01.webp"
    },
    {
      "text": "Rinse brisket thoroughly, then pat dry with paper towels and place on a rack in a roasting pan or Dutch oven. Rub brown sugar all over brisket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PcqFYqpSiXTcaXMEIGI9V93lpbs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-46530-guinness-corned-beef-VAT-step-02-a7831f27124f47ee96a2c527d14e8903.jpg"
      ],
      "image": "assets/images/46530/step_02.webp"
    },
    {
      "text": "Pour beer around and gently over brisket to wet sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rxxUd5OlkLGcwsWZTEBla02wZnE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-46530-guinness-corned-beef-VAT-step-03-3f84b18fde8e48eba21fd752ec2cf05a.jpg"
      ],
      "image": "assets/images/46530/step_03.webp"
    },
    {
      "text": "Bake, covered, in the preheated oven until tender, about 2 ½ hours. An instant-read thermometer inserted into the center of brisket should read at least 190 degrees F (88 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3IelMbq3XOT1Rp9GctV1DvDYgYE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-46530-guinness-corned-beef-VAT-step-04-4edc40e858ba46d19555688612203564.jpg"
      ],
      "image": "assets/images/46530/step_04.webp"
    },
    {
      "text": "Allow to rest for 5 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E5bsfcgzQ8XjxNxof255ygvCaag=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-46530-guinness-corned-beef-VAT-step-05-4f759ed61fd949a7ade6bff84440fa1e.jpg"
