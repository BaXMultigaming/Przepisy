  "ingredients": [
    "2 pounds chicken thighs",
    "1 lemon, juiced",
    "2 tablespoons ketchup",
    "2 teaspoons garlic powder",
    "2 teaspoons onion powder",
    "2 teaspoons ground coriander",
    "2 teaspoons ground cumin",
    "2 teaspoons garam masala",
    "2 teaspoons brown sugar",
    "2 teaspoons chile powder",
    "1 teaspoon paprika",
    "1 teaspoon dried sage",
    "1 teaspoon dried mint",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Place chicken thighs in a bowl. Season with lemon juice, ketchup, garlic powder, onion powder, coriander, cumin, garam masala, brown sugar, chile powder, paprika, sage, and mint. Mix well. Use clean hands to rub the seasoning on top of and underneath the skin of the chicken thighs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl with aluminum foil and let marinate in the refrigerator, 4 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a baking dish with cooking spray. Spread chicken over the bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tender and juicy, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
