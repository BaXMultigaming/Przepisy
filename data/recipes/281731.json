  "ingredients": [
    "1 head cauliflower, broken into florets",
    "1 medium red bell pepper, chopped",
    "1 medium carrot, sliced",
    "0.5 medium red onion, chopped",
    "1 stalk celery, sliced",
    "0.33333334326744 cup pimento-stuffed green olives, cut in half",
    "1 teaspoon minced fresh parsley",
    "salt and ground black pepper to taste",
    "0.33333334326744 cup white vinegar",
    "2 tablespoons olive oil",
    "1 clove garlic, minced",
    "0.5 teaspoon freeze-dried dill",
    "0.5 teaspoon crushed red pepper flakes"
  ],
  "steps": [
    {
      "text": "Combine cauliflower, bell pepper, carrot, onion, celery, olives, parsley, salt, and pepper in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk vinegar, olive oil, garlic, dill, and crushed pepper flakes together in a small bowl until smooth. Pour dressing over the cauliflower mixture. Stir until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate for at least 1 hour before serving.",
