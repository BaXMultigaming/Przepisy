  "title": "Double Chocolate-Cherry Cookies",
  "description": "Dried cherries, white chocolate chips, and a rich chocolate dough create the perfect balance of sweet, tart, moist, and chewy in these decadent double chocolate cookies.",
  "authors": [
    "Ayren Irvine"
  ],
  "date_published": "2022-02-28T10:40:22-05:00",
