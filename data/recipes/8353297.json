  "ingredients": [
    "2 cups all-purpose flour",
    "0.75 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.25 cups white sugar",
    "0.75 cup unsalted butter, softened",
    "2 large eggs",
    "2 tablespoons milk",
    "2 teaspoons vanilla extract",
    "1 cup white chocolate chips",
    "0.5 cup dried sour cherries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cocoa, baking soda, and salt together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter in a large bowl until smooth and creamy. Add eggs, one at a time, beating well after each addition and scraping the sides of the bowl as needed. Beat in milk and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually add flour mixture and stir until dough is just combined. Fold in white chocolate chips and cherries. Scoop about 1/4 cup dough per cookie 3 inches apart onto cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges of cookies are set and the tops lose their sheen, 13 to 15 minutes. Cool on the cookie sheets briefly before removing to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
