  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 cup honey",
    "2 large eggs, slightly beaten",
    "2 cups rice flour",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon ground cardamom",
    "2 teaspoons hemp seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and honey in a large bowl with an electric mixer until smooth and creamy; add eggs a little at a time, mixing well after each addition. Add rice flour, baking powder, and cardamom to butter mixture; mix until just combined. Roll dough into small balls, about 1 heaping teaspoon each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour hemp seeds into a small bowl. Press the top half of each dough ball into seeds. Transfer dough balls, seed-side up, to the baking sheet and gently press to 1/4-inch thickness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
