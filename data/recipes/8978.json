  "ingredients": [
    "1 skinless, boneless chicken breast half - pounded thin",
    "1 tablespoon vegetable oil",
    "0.25 cup all-purpose flour",
    "ground black pepper to taste",
    "0.5 tablespoon chopped garlic",
    "4 mushrooms, chopped",
    "0.5 lemon",
    "1.5 cups Chablis or other dry white wine",
    "2 tablespoons butter, room temperature",
    "2 ounces cooked angel hair pasta"
  ],
  "steps": [
    {
      "text": "In a medium skillet, heat oil for frying. Dredge chicken breast in flour and place it in the hot skillet. Add pepper to taste. Cook until golden brown on one side, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn chicken over (presentation side up) and add the garlic, mushrooms, juice from 1/2 lemon and wine. Stir all together. Turn heat up as high as possible and let liquids reduce until about 1/4 cup liquid remains in skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from skillet and add the room temperature butter. Swirl it around in the skillet sauce until it is incorporated and the sauce is slightly thickened. Pour sauce over chicken and serve with pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
