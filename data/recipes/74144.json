  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "1 (14 ounce) bag frozen broccoli florets",
    "1 (10.75 ounce) can condensed golden mushroom soup",
    "0.33333334326744 cup sour cream",
    "1 tablespoon prepared horseradish"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13 inch baking dish with cooking spray.",
