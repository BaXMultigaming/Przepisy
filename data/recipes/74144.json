      ],
      "image": "assets/images/74144/step_01.webp"
    },
    {
      "text": "Spread the broccoli evenly in the bottom of the baking dish. Place chicken breasts over the broccoli.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
