  "ingredients": [
    "2 tablespoons olive oil, divided",
    "0.25 cup rice flour",
    "2 tablespoons cornmeal",
    "0.5 teaspoon salt",
    "2 large onions, halved and cut into short strips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Oil a baking sheet with 1 tablespoon olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, cornmeal, and salt together in a bowl. Toss onion in flour mixture until coated and spread onto the prepared baking sheet. Drizzle remaining olive oil over onion mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, tossing onions occasionally, until crisped and golden, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
