  "ingredients": [
    "5 dried chipotle chile peppers",
    "0.5 medium yellow onion, roughly chopped",
    "0.25 cup freshly squeezed lime juice",
    "0.25 cup tomato paste",
    "1.5 tablespoons apple cider vinegar",
    "6 cloves garlic",
    "2 teaspoons ground cumin",
    "2 teaspoons salt",
    "1 teaspoon dried oregano",
    "1 (3 pound) beef shoulder roast, trimmed",
    "0.75 cup beef broth",
    "3 bay leaves",
    "1 teaspoon whole cloves"
  ],
  "steps": [
    {
      "text": "Slice open chile peppers and remove most of the seeds. Discard seeds and stems. Roughly chop and transfer to the bowl of a food processor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion, lime juice, tomato paste, vinegar, garlic, cumin, salt, and oregano to the peppers; pulse until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beef roast into a slow cooker and spread pureed mixture over top. Add broth, bay leaves, and cloves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until beef is tender and can be easily pulled apart with a fork, about 7 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove beef from the slow cooker and shred meat. Return meat to the slow cooker, cover, and cook for 1 more hour. Remove bay leaves before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
