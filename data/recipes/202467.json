  "title": "Grilled Bacon-Wrapped Corn on the Cob",
  "description": "Ears of corn are sprinkled with seasonings, wrapped in bacon, and grilled for a savory treat to serve at your next summer barbecue.",
  "authors": [
    "terryjcoe"
  ],
  "date_published": "2019-05-07T21:05:30-04:00",
