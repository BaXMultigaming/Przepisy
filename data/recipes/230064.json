  "ingredients": [
    "2 turnips, peeled and diced",
    "1 cup applesauce",
    "6 tablespoons butter, softened",
    "4 teaspoons brown sugar",
    "2 eggs, beaten",
    "1 tablespoon salt",
    "0.25 teaspoon ground black pepper",
    "1.75 cups soft bread crumbs, divided",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil; add turnips. Reduce heat to low; simmer until tender, about 15 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer turnips to a large bowl; mash with applesauce, 6 tablespoons butter, sugar, eggs, salt, pepper, and half of the bread crumbs. Spoon turnip mixture into the prepared casserole dish; sprinkle with remaining bread crumbs. Drizzle with 2 tablespoons melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
