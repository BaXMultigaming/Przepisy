  "ingredients": [
    "4 cups chopped cooked chicken breast",
    "1 (26 ounce) can condensed cream of chicken soup",
    "1 (15 ounce) can green enchilada sauce",
    "15 ounces milk",
    "1 (7 ounce) can diced green chiles",
