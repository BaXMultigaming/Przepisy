  "ingredients": [
    "3 tablespoons paprika",
    "1 tablespoon garlic powder",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "6.5 pounds pork ribs",
    "2 tablespoons vegetable oil",
    "3 cups water",
    "0.75 cup ketchup",
    "0.25 cup brown sugar",
    "0.25 cup Chinese vinegar",
    "1 teaspoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Mix paprika, garlic powder, black pepper, and salt in a resealable plastic bag. Place ribs in bag, seal the bag, and shake thoroughly until ribs are completely coated. Remove ribs from bag and discard dry rub.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a wok over medium-high heat. Cook ribs in hot oil until browned all over, 3 to 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water, ketchup, brown sugar, vinegar, and Worcestershire sauce together in a pressure cooker. Add browned ribs to pressure cooker. Lock the lid onto the pressure cooker, bring the cooker up to pressure, and reduce heat to medium.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook ribs over medium heat for 15 minutes. Remove from heat and release pressure according to manufacturer's directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
