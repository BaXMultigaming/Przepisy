  "ingredients": [
    "1 (16 ounce) package rotelle pasta",
    "1 cup broccoli florets",
    "1 cup chopped carrots",
    "1 cup chopped tomatoes",
    "1 (6 ounce) can black olives, drained",
    "1 (6 ounce) package pepperoni",
    "0.75 cup grated Parmesan cheese",
    "1 cup Italian-style salad dressing (such as Olive Garden®), divided"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil; cook rotelle at a boil until tender yet firm to the bite, about 12 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine rotelle, broccoli, carrots, tomatoes, olives, pepperoni, and Parmesan cheese in a large bowl; pour ½ dressing over salad and toss to coat. Cover the bowl with plastic wrap; refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour remaining ½ dressing over salad when ready to serve; stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
