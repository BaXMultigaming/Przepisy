  "ingredients": [
    "3 eggs",
    "1.75 cups pumpkin puree",
    "0.75 cup white sugar",
    "0.5 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground nutmeg",
    "1.5 pints vanilla ice cream, softened",
    "2 (9 inch) unbaked pie shells"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs together in a large bowl. Stir in pumpkin purée, sugar, salt, cinnamon, ginger, and nutmeg. Add ice cream, stirring until smooth. Divide filling between pie shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C); continue baking until filling sets, 30 to 40 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
