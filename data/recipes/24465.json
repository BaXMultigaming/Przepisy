  "ingredients": [
    "1 egg white",
    "1 cup white sugar",
    "1 cup toasted sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large glass or metal mixing bowl, beat the egg white until foamy. Gradually add sugar, continuing to beat until whites form stiff peaks. Fold in the toasted almonds. Drop by teaspoonfuls onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 20 minutes in the preheated oven, until golden and firm. When cookies are completely cool, they can be placed into plastic bags and frozen.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
