  "ingredients": [
    "0.25 cup unsalted butter, cut into pieces",
    "4 (1 ounce) squares unsweetened chocolate",
    "2 cups white sugar",
    "4 large eggs",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.33333298563957 cup confectioners' sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Melt butter and chocolate in a saucepan over low heat. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and eggs in a medium bowl with an electric mixer until smooth. Stir in melted chocolate mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and salt together into a bowl. Gradually stir dry ingredients into wet ingredients with a spoon until well blended. Cover and refrigerate for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to bake, preheat the oven to 300 degrees (150 degrees C). Grease 2 cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape teaspoonfuls of dough into balls, roll in confectioners' sugar, and place 2 inches apart on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are firm to the touch, 12 to 15 minutes, switching racks halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool on the baking sheets briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
