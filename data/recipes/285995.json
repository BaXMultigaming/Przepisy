  "ingredients": [
    "1 (16 ounce) package frozen broccoli",
    "2 (10 ounce) cans white meat chicken, drained and flaked",
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "1 (8 ounce) container cottage cheese",
    "1 (8 ounce) package shredded Cheddar cheese",
    "0.25 cup creamy salad dressing (such as Miracle Whip®)",
    "1 tablespoon lemon juice",
    "1 sleeve butter-flavored crackers, crushed",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine broccoli and 1/2 cup water in a saucepan over medium heat. Cover and cook until tender, about 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer broccoli to a 9x13-inch casserole dish. Add chicken, condensed soup, cottage cheese, Cheddar cheese, salad dressing, and lemon juice and mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix crushed crackers and melted butter together; sprinkle over the casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
