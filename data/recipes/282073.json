  "ingredients": [
    "1 cup milk",
    "1.5 teaspoons vinegar",
    "2.5 cups all-purpose flour, divided",
    "0.5 cup sourdough starter",
    "1 tablespoon white sugar",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "0.25 cup salted butter, melted"
  ],
  "steps": [
    {
      "text": "Make buttermilk by combining milk and vinegar in a small bowl. Stir and let sit until slightly thickened and curdled, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1 cup flour, sourdough starter, and buttermilk together in a large, non-reactive bowl. Cover and let dough sit in a warm place, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 1 cup flour, sugar, baking powder, salt, and baking soda to the dough; knead lightly until well mixed. Turn dough out onto a work surface that has been sprinkled with remaining 1/2 cup flour. Roll or pat dough out to a thickness of about 1/2 inch. Dip a biscuit cutter into melted butter and cut out biscuits. Reserve any remaining butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place biscuits close together in a greased 9x13-inch pan. Cover and let rest for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt any remaining butter and brush over biscuits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 30 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
