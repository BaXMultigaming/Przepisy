  "ingredients": [
    "0.5 cup unsalted butter, softened",
    "0.5 cup vegetable shortening",
    "1 teaspoon vanilla extract",
    "3 cups confectioners' sugar, sifted",
    "2 tablespoons milk, or as needed",
    "1 (7 ounce) package sweetened flaked coconut, divided",
    "0.25 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Beat butter and shortening with an electric mixer in a large bowl until smooth; beat in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually beat confectioners' sugar into butter mixture until well blended. The mixture will appear dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir enough milk into butter mixture to achieve desired consistency for icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold half the coconut into the icing; spread icing over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle remaining coconut and pecans over icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
