  "ingredients": [
    "1 (16 ounce) can garbanzo beans, drained and rinsed",
    "1 tablespoon olive oil",
    "1 medium red bell pepper, cut into 1/2 inch pieces",
    "1 tablespoon tahini",
    "1 fresh lime, juiced",
    "1.5 tablespoons water",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "In a food processor or blender, mix the garbanzo beans, olive oil, red bell pepper, tahini, lime juice, water, salt, black pepper, and garlic powder. Blend until smooth.",
