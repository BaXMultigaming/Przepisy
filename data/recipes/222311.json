  "title": "Fennel-Smoked Salmon",
  "description": "Smoke your salmon atop a bed of fennel, then serve with a cherry tomato-fennel frond salad.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2020-06-23T02:37:09-04:00",
