  "ingredients": [
    "2.5 cups all-purpose flour",
    "0.25 cup finely ground almonds",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cardamom",
    "1 teaspoon ground ginger",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon salt",
    "1 cup shortening",
    "1 cup white sugar",
    "1 egg",
    "0.5 cup corn syrup"
  ],
  "steps": [
    {
      "text": "Combine the flour, almonds, baking soda, spices and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream the shortening and sugar. Beat in the egg, beat in the corn syrup. Gradually blend in the dry ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and chill for 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a floured surface, roll out the dough to a thickness of 1/4 inch. Using cookie cutters, cut into shapes and place 1 inch apart on ungreased baking sheets. Bake for 8-10 minutes until lightly colored. Transfer to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
