  "ingredients": [
    "1 tablespoon butter, at room temperature",
    "2 cups self-rising flour",
    "0.5 cup white sugar",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 cup cooked and mashed pumpkin",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub butter into flour in a bowl using your fingers until evenly combined. Add sugar, baking powder, and salt to flour mixture; make a well in the center. Mix pumpkin and egg together in a separate bowl; pour into the well and mix until dough is well combined. Turn dough onto a floured work surface and cut into squares using a knife with flour on it. Arrange squares on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
