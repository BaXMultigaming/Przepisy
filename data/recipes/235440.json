  "ingredients": [
    "3 cups mashed cooked yams",
    "2 eggs",
    "0.5 cup butter, softened",
    "0.5 cup white sugar",
    "0.5 cup flaked coconut",
    "0.25 cup milk",
    "1 teaspoon vanilla extract",
    "1 cup chopped pecans",
    "1 cup brown sugar",
    "0.5 cup butter, softened",
    "0.5 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk yams, eggs, 1/2 cup butter, white sugar, coconut, milk, and vanilla together in a bowl until smooth; pour into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pecans, brown sugar, butter, and flour together in a separate bowl until crumbly; sprinkle over the yam mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the topping is slightly browned, about 30 minutes.",
