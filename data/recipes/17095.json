  "ingredients": [
    "0.5 cup rolled oats",
    "0.5 cup butter",
    "1 cup boiling water",
    "1.5 cups packed brown sugar",
    "2 eggs, beaten",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "4 tablespoons cocoa"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 8x8 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the rolled oats and butter. Mix in boiling water. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together the brown sugar, eggs and vanilla; add to cooled oat mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour, baking soda, baking powder, salt and cocoa. Add to wet ingredients and mix well. Spread into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 40 minutes. Remove from oven, allow to cool, and remove pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
