  "ingredients": [
    "1 tablespoon lemon juice",
    "1 cup milk",
    "1.5 cups white sugar",
    "0.5 cup butter, at room temperature",
    "4 large eggs",
    "2 teaspoons lemon extract",
    "0.5 teaspoon lemon zest",
    "1.5 cups chopped fresh strawberries",
    "3 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup miniature semisweet chocolate chips",
    "12 slices fresh strawberry",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Mix lemon juice with as much milk as needed to measure 1 cup; let soured milk stand for 5 minutes before using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 24 muffin tins with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together 1 1/2 cups sugar and butter in a large bowl until light and fluffy. Beat in eggs one at a time, mixing well after each addition. Mix in lemon extract. Gradually stir in soured milk and lemon zest, then gently fold in strawberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, baking powder, baking soda, and salt in a medium bowl until combined. Stir into butter mixture until batter is just combined. Fold in chocolate chips until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, about 2/3 full. Place a strawberry slice atop each muffin and sprinkle the tops with 1 tablespoon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 25 to 30 minutes. Cool in the pans for 5 minutes before serving warm.",
      "section": null,
      "name": null,
      "url": null,
