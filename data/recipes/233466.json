  "ingredients": [
    "3 cubes ice",
    "4 thick slices fresh cucumber",
    "1 dash lime juice",
    "1 dash simple syrup",
    "0.75 cup ice",
    "2 fluid ounces gin (such as Hendrick's)",
    "1 fluid ounce elderflower liqueur (such as St. Germain®)",
    "1 slice cucumber for garnish",
    "1 splash club soda"
  ],
  "steps": [
    {
      "text": "Place 3 ice cubes into a pint glass. Place 4 thick cucumber slices into glass, top with lime juice and simple syrup, and muddle thoroughly until cucumber pieces are juicy and broken up, about 10 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill pint glass about 3/4 full of ice; pour gin and elderflower liqueur over ice. Shake gently and strain into a cocktail glass. Add 1 or 2 small pieces of muddled cucumber. Garnish with 1 slice of cucumber and add splash of club soda. Serve with straw.",
