  "title": "Trio of Mushroom Soup (Cream of Mushroom Soup)",
  "description": "This soup made with herbs and a trio of portobello, baby bella, and oyster mushrooms get its creaminess from potato and just a little cream.",
  "authors": [
    "Dregun"
  ],
  "date_published": "2020-02-01T02:51:41-05:00",
