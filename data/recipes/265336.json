  "ingredients": [
    "0.5 cup dark Mexican beer",
    "0.25 cup avocado oil",
    "0.5 white onion, cut into large wedges",
    "1 cup fresh cilantro leaves",
    "salt and pepper to taste",
    "2 pounds beef skirt steak"
  ],
  "steps": [
    {
      "text": "Combine beer, oil, onion, cilantro, onion, cilantro, salt, and pepper in a blender; blend until cilantro marinade is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place steak in a large resealable plastic bag and pour cilantro marinade on top. Seal bag and shake to fully cover meat with the marinade. Refrigerate at least 8 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate with avocado oil. Grill the meat, turning over once, about 3 minutes per side for medium rare.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
