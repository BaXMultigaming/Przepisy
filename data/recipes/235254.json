  "ingredients": [
    "2 tablespoons butter, melted",
    "2 cups persimmon pulp",
    "2 cups white sugar",
    "3 eggs, lightly beaten",
    "1.25 cups buttermilk",
    "1 teaspoon baking soda",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Spread melted butter evenly over the bottom of a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat persimmon pulp and sugar together in a bowl; beat in eggs. Beat in buttermilk and baking soda.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, cinnamon, and salt together in a bowl. Gradually add flour mixture to persimmon mixture, stirring until well incorporated; stir in vanilla extract. Pour persimmon batter into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden and cooked through, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
