  "ingredients": [
    "2 tablespoons white sugar",
    "2.25 cups all-purpose flour",
    "2 teaspoons ground ginger",
    "1 teaspoon baking soda",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon salt",
    "0.75 cup margarine, softened",
    "1 cup white sugar",
    "1 large egg",
    "0.25 cup molasses",
    "1 tablespoon water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Put 2 tablespoons sugar in a small bowl; set aside.",
