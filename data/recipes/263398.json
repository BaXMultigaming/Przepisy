  "ingredients": [
    "1 pound cooked tiger shrimp, thawed and tails removed",
    "3 tablespoons soy sauce",
    "1 tablespoon vegetable oil, or to taste",
    "1 medium onion, diced",
    "2 jalapeno peppers, diced",
    "3 cloves garlic, diced",
    "1 (1/2 inch) piece ginger, grated",
    "1 lime, halved",
    "0.5 cup all-purpose flour",
    "1 teaspoon baking powder",
    "salt to taste",
    "0.33333334326744 cup milk, or as needed",
    "0.5 cup vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Toss shrimp and soy sauce together in a bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 tablespoon oil in a large skillet over medium heat. Saute onion until soft and translucent, about 5 minutes. Add jalapeno peppers, garlic, and ginger. Squeeze in 1/2 of the lime and mix until combined, about 2 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, and salt together in a bowl. Add milk slowly until batter is thin and runny.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1/2 cup oil in a frying pan. Dip shrimp in batter to lightly coat; fry in batches until golden, about 1 minute per side. Toss fried shrimp with jalapeno mixture. Squeeze remaining lime juice on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
