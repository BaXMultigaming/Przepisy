  "ingredients": [
    "1 cup water",
    "1 cup sugar",
    "3 tablespoons butter",
    "2 cups all-purpose flour",
    "3 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.5 cup butter",
    "0.75 cup milk",
    "3 cups finely chopped rhubarb",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water to a boil in a small saucepan. Dissolve 1 cup sugar in boiling water, then add 3 tablespoons butter. Remove from heat; set syrup aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a large bowl. Cut in 1/2 cup butter. Stir in milk; mix lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out dough on a floured surface into a rectangle shape about 12 inches long.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine rhubarb, cinnamon, and remaining 1 cup sugar in another bowl; spread evenly over dough, leaving a 1/2-inch border. Roll dough tightly lengthwise; seal the seam. Cut into twelve 1-inch pieces. Arrange rolls in the prepared baking dish. Pour syrup over rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
