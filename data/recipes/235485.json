  "ingredients": [
    "6 sweet potatoes, peeled and quartered",
    "5 tablespoons butter, melted",
    "3 tablespoons brown sugar, or more to taste",
    "1 tablespoon onion powder",
    "1 tablespoon garlic powder",
    "1 tablespoon chipotle chile powder, or more to taste",
    "1.5 teaspoons salt",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss sweet potatoes and butter together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk brown sugar, onion powder, garlic powder, chipotle chile powder, salt, and black pepper together in a small bowl; sprinkle over sweet potatoes and toss to coat. Pour potatoes in a single layer onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until potatoes are tender, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
