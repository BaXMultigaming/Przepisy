  "ingredients": [
    "3 large large eggs, room temperature",
    "0.66666668653488 cup milk, room temperature",
    "0.5 cup packed all-purpose flour",
    "0.25 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "3 tablespoons clarified butter",
    "1 tablespoon butter",
    "0.5 Meyer lemon, juiced",
    "1 tablespoon confectioners' sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend eggs, milk, flour, vanilla, and salt together in a blender until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt clarified butter in a 10-inch cast iron skillet over high heat until bubbling; pour batter into the center of the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden, 20 to 25 minutes. Brush with 1 tablespoon butter, drizzle lemon juice over the top, and dust with confectioners' sugar.",
