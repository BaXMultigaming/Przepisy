  "ingredients": [
    "2 (15 ounce) cans yams, drained and cut into chunks",
    "2 cups fresh cranberries",
    "0.5 cup all-purpose flour",
    "0.5 cup brown sugar",
    "0.5 cup oatmeal",
    "0.33333334326744 cup margarine, softened",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss yams and cranberries together in a bowl. Mix flour, brown sugar, oatmeal, margarine, and cinnamon together in a separate bowl. Add about half the oat mixture to the yam mixture; toss to combine and spread into a 1 1/2-quart casserole dish. Sprinkle remaining oat mixture over the casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until lightly browned, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
