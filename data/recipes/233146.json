  "ingredients": [
    "3 cups all-purpose flour",
    "1 cup white sugar",
    "0.5 cup brown sugar",
    "2 teaspoons ground cinnamon",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon ground nutmeg",
    "1 teaspoon salt",
    "2 cups mashed ripe bananas",
    "1 cup canola oil",
    "1 cup coconut milk"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease 12 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9eWwLzyRebOn3-3MO6EqNVphxac=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233146-vegan-banana-muffins-ddmfs-1929-4x3-step-01-4a65238cb93346808b5fe3a836c85e1f.jpg"
      ],
      "image": "assets/images/233146/step_01.webp"
    },
    {
      "text": "Mix flour, white sugar, brown sugar, cinnamon, baking powder, baking soda, nutmeg, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mcbbBscscgmUjDLDpoL9SHADriE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233146-vegan-banana-muffins-ddmfs-1931-4x3-step-02-5ff9fd947cd142dc8e13222784cdb4b6.jpg"
      ],
      "image": "assets/images/233146/step_02.webp"
    },
    {
      "text": "Stir bananas, canola oil, and coconut milk together in a separate bowl; stir banana mixture into flour mixture until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ShRR2CgwgKNuh-LBu6c6qWXqlC8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233146-vegan-banana-muffins-ddmfs-1932-4x3-step-03-9fb9fd878612465b82501a9cffd597b4.jpg"
      ],
      "image": "assets/images/233146/step_03.webp"
    },
    {
      "text": "Divide batter among the muffin cups, filling each about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1Zb6b9bwX2hX5xfmAEcmQjFLhrs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233146-vegan-banana-muffins-ddmfs-1935-4x3-step-04-7090010d678d4216a2f127361be63f0a.jpg"
      ],
      "image": "assets/images/233146/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hN6OJWoO0_wMd1nF31BaWytjPBc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233146-vegan-banana-muffins-ddmfs-1934-4x3-step-05-932401d222494fba933f1ab107a00880.jpg"
      ],
