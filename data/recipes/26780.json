  "ingredients": [
    "1 onion, grated",
    "1 cup butter, softened",
    "3 tablespoons poppy seeds",
    "2 tablespoons prepared Dijon-style mustard",
    "1 tablespoon Worcestershire sauce",
    "2 (12 ounce) packages white party rolls",
    "0.5 pound chopped cooked ham",
    "5 ounces shredded Swiss cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together onion, butter, poppy seeds, mustard, and Worcestershire sauce in a medium bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice rolls in half horizontally and set aside tops. Spread butter mixture onto bottoms, then top with ham and Swiss cheese. Cover with tops and arrange sandwiches in a single layer in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until rolls are lightly browned and cheese is melted, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
