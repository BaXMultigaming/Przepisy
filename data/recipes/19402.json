  "ingredients": [
    "0.5 cup butter",
    "1 (8 ounce) package cream cheese",
    "2 teaspoons garlic powder",
    "2 cups milk",
    "6 ounces grated Parmesan cheese",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Melt butter in a medium, nonstick saucepan over medium heat. Add cream cheese and garlic powder, stirring with a wire whisk until smooth. Add milk, a little at a time, whisking to smooth out lumps. Stir in Parmesan cheese and pepper.",
      "section": null,
      "name": null,
      "url": null,
