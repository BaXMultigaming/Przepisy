  "ingredients": [
    "2 tablespoons olive oil",
    "0.25 cup minced onion",
    "1 teaspoon ground cumin",
    "1 teaspoon ground ginger",
    "0.25 teaspoon ground cinnamon",
    "1 (10.75 ounce) can condensed tomato soup",
