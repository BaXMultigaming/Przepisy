  "title": "Pan-Fried Whole Trout",
  "description": "This fried trout recipe is a simple way to cook whole fish on the stove by coating it in equal parts flour and cornmeal, then frying it in olive oil.",
  "authors": [
    "Lorna"
  ],
  "date_published": "1999-07-23T14:36:45-04:00",
