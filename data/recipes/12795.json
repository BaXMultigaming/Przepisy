  "ingredients": [
    "4 whole (12 ounce) trout, cleaned with tails and heads on",
    "3 tablespoons olive oil",
    "0.5 cup all-purpose flour",
    "0.5 cup cornmeal",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.125 teaspoon cayenne pepper",
    "2 lemons - cut into wedges, for garnish"
  ],
  "steps": [
    {
      "text": "Remove gills from trout and discard. Rinse under cold water and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cornmeal, salt, black pepper, and cayenne pepper in a shallow dish. Increase heat to high. Dredge trout in flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry coated trout in hot oil until fish flakes easily with a fork, 4 to 6 minutes per side. Serve garnished with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
