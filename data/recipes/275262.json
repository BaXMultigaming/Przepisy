  "ingredients": [
    "8 ounces dried cranberry beans",
    "3 cups water",
    "0.25 cup extra virgin olive oil",
    "0.25 cup red wine vinegar",
    "1 tablespoon chopped fresh parsley",
    "1 teaspoon dried dill weed",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 small cucumber, seeded and chopped",
    "0.25 cup chopped red onion",
    "12 grape tomatoes, halved",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Sort and rinse cranberry beans. Place in a pot with water over medium-high heat; cover and bring to a boil. Reduce heat to medium-low and simmer until beans are tender, about 1 hour. Make sure beans are covered with water during the entire cooking process. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together olive oil, vinegar, parsley, dill, salt, and pepper in a bowl. Add cucumber, red onion, and tomatoes; stir to combine. Gently fold in cooked cranberry beans. Cover and refrigerate for at least 30 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
