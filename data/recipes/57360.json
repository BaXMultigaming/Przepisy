  "ingredients": [
    "5 large sweet onions, cut into 1/4 inch slices and separated into rings",
    "0.25 cup margarine",
    "0.25 cup sour cream",
    "0.75 cup grated Parmesan cheese",
    "10 buttery crackers"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the margarine in a large skillet over medium heat. Add onions; cook and stir until tender. Turn off the heat, and stir in the sour cream and Parmesan cheese. Transfer to the prepared baking dish, and crumble the crackers over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered for 30 minutes in the preheated oven, until the top is browned and the sauce is bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
