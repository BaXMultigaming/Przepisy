  "ingredients": [
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 cup shortening",
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "9 (1 ounce) squares unsweetened chocolate",
    "0.5 cup chopped almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Grease a 9 inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make crust: In a large bowl, cream shortening, white sugar and brown sugar. Separate egg and beat in yolk and vanilla, stirring until well blended. Slowly add in the flour and blend well. Mixture will be stiff.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press dough evenly into baking pan. Bake for 18 to 20 minutes, or until top is golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the chocolate in a double boiler over low heat. Spread the melted chocolate over warm crust. Sprinkle top with almonds. Let cool on wire rack before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
