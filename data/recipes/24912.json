  "ingredients": [
    "1 pound thinly sliced cooked ham",
    "3 (8 ounce) packages cream cheese, softened",
    "2 (8 ounce) packages shredded Cheddar cheese",
    "1 bunch green onions"
  ],
  "steps": [
    {
      "text": "Mix cream cheese and Cheddar cheese in a microwave-safe bowl. Microwave on high heat, stirring frequently, until melted and smooth, about 45 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay ham slices flat; spread cheese mixture on top. Place one green onion parallel to one edge of each ham slice. Tightly roll ham slices into thin logs around green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice the logs into 1/4- to 1/3-inch wide rings. Arrange roll ups flat on a large serving platter. Cover and chill until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
