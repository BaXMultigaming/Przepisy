  "ingredients": [
    "3 egg yolks",
    "0.5 cup brown sugar",
    "1 cup heavy cream",
    "1 cup pumpkin puree",
    "0.5 teaspoon ground allspice",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 pinch salt",
    "0.5 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg yolks and brown sugar together in a large bowl. Stir in heavy cream, pumpkin puree, allspice, cinnamon, nutmeg, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide pumpkin mixture between seven (5-inch) ramekins about 1/2 inch from the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the ramekins in a baking dish and fill with the baking dish hot water to reach halfway up the sides of the ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until just set, 30 to 35 minutes. Remove ramekins and refrigerate until completely cool, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle about 1 tablespoon of sugar onto each creme brulee. Melt the sugar with a chef’s torch until crisp and dark brown, 1 to 2 minutes. Allow to cool before serving.",
      "section": null,
      "name": null,
      "url": null,
