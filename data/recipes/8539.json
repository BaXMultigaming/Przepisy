  "ingredients": [
    "4 skinless, boneless chicken breasts",
    "1 tablespoon vegetable oil",
    "2.5 cups orange juice",
    "3 tablespoons cornstarch",
    "0.5 cup hot water",
    "3 tablespoons honey",
    "0.25 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "In a skillet, brown chicken breasts in 1 tablespoon oil over medium heat. Cook till juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add orange juice to the pan. When juice just begins to bubble around the edges of the pan, add corn starch dissolved in hot water. Mix ginger and honey together in a cup, and add to orange juice. Cook until sauce is thick and slightly browned. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
