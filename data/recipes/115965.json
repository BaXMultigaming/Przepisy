  "ingredients": [
    "1 cup chicken broth",
    "0.25 teaspoon soy sauce",
    "0.25 teaspoon sesame oil",
    "2 teaspoons water",
    "1 teaspoon cornstarch",
    "1 egg, beaten",
    "1 drop yellow food coloring",
    "0.5 teaspoon ground white pepper",
    "0.125 teaspoon salt",
    "1 teaspoon chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IWSTKy71YWTpQcLkxk4MSToIVO0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-115965-egg-drop-soup-better-than-restaurant-quality-ddmfs-step1-3x4-2859-811942b594be49c4b903db574e71b7e6.jpg"
      ],
      "image": "assets/images/115965/step_01.webp"
    },
    {
      "text": "Combine chicken broth, soy sauce, and sesame oil in a small saucepan over medium heat; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OmtPLmXyUjwDIEc_dN-jLWkvJUE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-115965-egg-drop-soup-better-than-restaurant-quality-ddmfs-step1-3x4-2862-e2e7c5c682d24ea18a0fb151488567bf.jpg"
      ],
      "image": "assets/images/115965/step_02.webp"
    },
    {
      "text": "Combine water and cornstarch in a small bowl until cornstarch is dissolved; stir into boiling broth. Stir in food coloring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XKRvgGcz68z3vZzxJo_ut9dKY9w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-115965-egg-drop-soup-better-than-restaurant-quality-ddmfs-step2-3x4-2869-127a7a0adb154dde99394dbf8d48dbc3.jpg"
      ],
      "image": "assets/images/115965/step_03.webp"
    },
    {
      "text": "Slowly pour in beaten egg, stirring constantly in one direction to form thin egg ribbons. Season soup with white pepper and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YGNwFSSsgeSbbdukcROIyAvDkQE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-115965-egg-drop-soup-better-than-restaurant-quality-ddmfs-step3-3x4-2872-914e81659a7749599ef8f6cb5f1c5fb2.jpg"
      ],
      "image": "assets/images/115965/step_04.webp"
    },
    {
      "text": "Serve hot, garnished with fresh chives. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
