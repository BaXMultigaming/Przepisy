  "title": "Savory Puff Pastry Christmas Tree",
  "description": "This fun and easy savory puff pastry Christmas tree is filled with goat cheese and sun-dried tomato pesto, a perfect Christmas appetizer.",
  "authors": [
    "Diana Moutsopoulos"
  ],
  "date_published": "2018-07-17T09:03:16-04:00",
