  "ingredients": [
    "1 pound shrimp, peeled and deveined",
    "3 tablespoons olive oil",
    "3 tablespoons chopped fresh cilantro",
    "2 tablespoons fresh lime juice",
    "2 cloves garlic, minced",
    "2 teaspoons tequila",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon salt",
    "4 bamboo skewers, soaked in water for 20 minutes"
  ],
  "steps": [
    {
      "text": "Combine shrimp, oil, cilantro, lime juice, garlic, tequila, cayenne pepper, and salt in a large bowl. Cover the bowl with plastic wrap; refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove shrimp from marinade and shake off excess; discard remaining marinade. Thread shrimp onto the prepared skewers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until shrimp turn pink, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
