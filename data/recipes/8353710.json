  "ingredients": [
    "cooking spray",
    "2.25 cups all-purpose flour",
    "0.75 cup white sugar, or more to taste",
    "0.25 cup brown sugar",
    "1.5 teaspoons baking powder",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "1 pinch sea salt",
    "0.75 cup low-fat plain yogurt",
    "6 tablespoons milk",
    "1 large egg",
    "3 tablespoons applesauce",
    "0.75 teaspoon vanilla extract",
    "1 cup fresh mulberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a 12-cup muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, white sugar, brown sugar, baking powder, baking soda, cinnamon, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir yogurt, milk, applesauce, egg, and vanilla extract together in another bowl. Gradually add flour mixture and stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chop mulberries (if large) and add to batter; stir gently until incorporated. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the centers comes out clean, 20 to 25 minutes. Cool in the tin for a few minutes, then transfer to a wire rack to cool completely, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
