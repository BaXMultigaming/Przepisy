  "title": "Easy Mulberry Muffins",
  "description": "Fresh mulberries add tart, fruity notes to these simple muffins that are made with yogurt and applesauce instead of butter and eggs.",
  "authors": [
    "Beth"
  ],
  "date_published": "2022-03-17T10:18:14-04:00",
