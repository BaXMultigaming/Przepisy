  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "4 eggs",
    "0.25 cup vegetable oil",
    "2 tablespoons water",
    "1 (3 ounce) package instant pistachio pudding mix",
    "1 cup sour cream",
    "0.5 cup maraschino cherries",
    "0.5 teaspoon green food coloring",
    "0.5 teaspoon ground cinnamon",
    "2 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour two 9 x 5 inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cake mix, eggs, oil, water, pudding mix, sour cream, cherries, and food coloring. Pour into prepared pans. In a small bowl, stir together cinnamon and sugar. Sprinkle tops of loaves with mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 45 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
