  "ingredients": [
    "cooking spray",
    "0.75 cup all-purpose flour",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "20 chicken wings",
    "0.5 cup melted butter",
    "0.5 cup hot pepper sauce (such as Frank's RedHot®)"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with aluminum foil, and lightly grease with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour, cayenne pepper, garlic powder, and salt into a resealable plastic bag, and shake to mix. Add chicken wings, seal the bag, and toss until well coated with the flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mhCPFcrSaIspYjjyKFT13qjH_PQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/166638-baked-buffalo-wings-ddmfs-step-1-7250e97c9ee94c62ae85a4fe95bec458.jpg"
      ],
      "image": "assets/images/166638/step_02.webp"
    },
    {
      "text": "Transfer wings to the prepared baking sheet and refrigerate for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rVQ7RCze1aNHjDH3TLIRvwi7mv4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/166638-baked-buffalo-wings-ddmfs-step-2-77fd2ec2181043809fc714125825e12f.jpg"
      ],
      "image": "assets/images/166638/step_03.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the oven is preheating, whisk together melted butter and hot sauce in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/37qXMqmWPTS4PKMJfUO5lE2WEZY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/166638-baked-buffalo-wings-ddmfs-step-3-0aaebdbb2f3548569d579213527a9c39.jpg"
      ],
      "image": "assets/images/166638/step_05.webp"
    },
    {
      "text": "Dip wings into butter mixture, and place back on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SbCdnbDRu3GwGJGES0MBh-Vah-E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/166638-baked-buffalo-wings-ddmfs-step-4-e61ede685ce749d68f9c9e838c4d368d.jpg"
      ],
      "image": "assets/images/166638/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Flip wings and continue to cook until crispy on the outside and no longer pink in the center, about 25 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bNPBvI8-jvK1lfSUuVxfNxhnjwk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/166638-baked-buffalo-wings-ddmfs-beauty-3x4-90787930d20b402e9dde79c22fced332-e993a17bca3940da80872714ef7f963d.jpg"
      ],
      "image": "assets/images/166638/step_07.webp"
    }
