  "title": "Baked Buffalo Wings",
  "description": "These spicy baked Buffalo wings are crispy without being fried, super easy to prep, and perfect for feeding a crowd! Great for parties or game watching!",
  "authors": [
    "Leesah"
  ],
  "date_published": "2008-05-06T17:09:22-04:00",
