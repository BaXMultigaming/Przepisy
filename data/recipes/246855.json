  "ingredients": [
    "1 (12 ounce) box jumbo pasta shells",
    "2 pounds ground turkey",
    "1 (7 ounce) can chopped green chiles",
    "0.75 cup water",
    "1 (1.25 ounce) package taco seasoning",
    "1 cup salsa",
    "1.5 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook pasta shells in the boiling water, stirring occasionally until tender yet firm to the bite, about 12 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine turkey, chopped green chiles, water, and taco seasoning in a large saucepan; cook and stir until turkey is cooked through and moisture is absorbed, 8 to 10 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread salsa in the bottom of a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stuff each pasta shell with some of the turkey mixture and arrange on top of the salsa in the baking dish. Sprinkle Cheddar cheese on top. Cover pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and bubbly, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
