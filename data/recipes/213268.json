  "ingredients": [
    "1 tablespoon olive oil",
    "1 large yellow onion, chopped",
    "green pepper",
    "2 pounds lean ground beef",
    "3 cloves garlic, chopped",
    "3 cups water",
    "2 (15 ounce) cans tomato sauce",
    "2 (14.5 ounce) cans diced tomatoes",
    "3 tablespoons soy sauce",
    "2 tablespoons dried Italian herb seasoning",
    "1 tablespoon seasoned salt, or to taste",
    "3 bay leaves",
    "2 cups uncooked elbow macaroni"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vPueKueno2d25vQIqLnLztw9EcY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-213268-Classic-Goulash-DDMFS-Step-01a-d773d33af31b43fa874c29bffc8cf094.jpg"
      ],
      "image": "assets/images/213268/step_01.webp"
    },
    {
      "text": "Heat olive oil in a large Dutch oven over medium-high heat. Add onion and cook 3 minutes, stirring often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yOdSSh0tcATV6FWAFbC-AtjDjgQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-213268-Classic-Goulash-DDMFS-Step-01b-d95f29bb970c4d7e90c7f5b33fc67f1f.jpg"
      ],
      "image": "assets/images/213268/step_02.webp"
    },
    {
      "text": "Add ground beef and cook, breaking up the meat until it is evenly browned, about 5 minutes. Add garlic and cook 3 minutes, stirring often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/644N69u2luJGIwS5JyTm2hOpYtw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-213268-Classic-Goulash-DDMFS-Step-02-656c74fd5dcf4482bad07fe166e7cb83.jpg"
      ],
      "image": "assets/images/213268/step_03.webp"
    },
    {
      "text": "Stir in water, tomato sauce, diced tomatoes, soy sauce, Italian seasoning, seasoned salt, and bay leaves. Bring to a simmer, cover and cook 5 minutes, stirring halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I-a_jWPoG-RB-pUyvje9CeDUB4c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-213268-Classic-Goulash-DDMFS-Step-03-f1e9a2bd34514cbda43cc579e6ad477f.jpg"
      ],
      "image": "assets/images/213268/step_04.webp"
    },
    {
      "text": "Stir in uncooked macaroni, cover, and simmer over medium heat until pasta is tender, 11 to 13 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YMWTyxOb4pOnHTWAq87heUohJo0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-213268-Classic-Goulash-DDMFS-Step-04-6dd90eb32890440c917d377f10db1eab.jpg"
      ],
      "image": "assets/images/213268/step_05.webp"
    },
    {
      "text": "Remove from heat, discard bay leaves, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m7VwkYlyUNgn_XtzC0J8dLT28bM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-213268-Classic-Goulash-DDMFS-4x3-d59a130059954fda99cdb3639f19a3a7.jpg"
      ],
      "image": "assets/images/213268/step_06.webp"
    }
