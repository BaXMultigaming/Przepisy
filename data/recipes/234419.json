  "ingredients": [
    "6 cups chicken broth",
    "1 cup water",
    "1.25 pounds chicken tenders",
    "3 extra large chicken bouillon cubes (such as Knorr®)",
    "1 tablespoon olive oil",
    "2 teaspoons granulated garlic",
    "2 teaspoons ground cumin",
    "salt and ground black pepper to taste",
    "0.5 large white onion, chopped, or to taste",
    "2 cups chicken broth",
    "1 cup white rice",
    "1 teaspoon chili powder",
    "1 avocado - peeled, pitted, and thinly sliced",
    "1 bunch fresh cilantro, chopped"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r8RowSKJqy5cM3xA1ms3xqjJhS0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234419-caldo-de-pollo-mexican-chicken-soup-DDMFS_4x3_Step_01-7cbe61bddc8d425389be43dafae9ca57.jpg"
      ],
      "image": "assets/images/234419/step_01.webp"
    },
    {
      "text": "Combine 6 cups chicken broth, water, chicken tenders, chicken bouillon cubes, olive oil, granulated garlic, cumin, salt, and pepper in a large pot; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lXSxqS3p1qgEW1XCGB7BGBO6X-A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234419-caldo-de-pollo-mexican-chicken-soup-DDMFS_4x3_Step_02-6421527f6903440287275604f4bddee8.jpg"
      ],
      "image": "assets/images/234419/step_02.webp"
    },
    {
      "text": "Reduce heat, cover pot, and simmer until chicken is cooked through, about 25 minutes. Gently shred chicken using two forks. Add onion to broth and simmer for about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lUrBAYSRlAplcUVqw8_Bflx3Dbc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234419-caldo-de-pollo-mexican-chicken-soup-DDMFS_4x3_Step_03-2a968fc673144ddbbd5408a7b8e7b853.jpg"
      ],
      "image": "assets/images/234419/step_03.webp"
    },
    {
      "text": "Bring 2 cups chicken broth, rice, and chili powder to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until the rice is tender and liquid has been absorbed, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xy0qjQsNX22BypUjywNFPJcHxpg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234419-caldo-de-pollo-mexican-chicken-soup-DDMFS_4x3_Step_04-a4edb1b99d894ebd922bf2f4ff67b500.jpg"
      ],
      "image": "assets/images/234419/step_04.webp"
    },
    {
      "text": "Spoon rice into each serving bowl and pour soup over rice. Garnish with avocado slices and cilantro.",
      "section": null,
      "name": null,
