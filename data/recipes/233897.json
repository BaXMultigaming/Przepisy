  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "2.5 teaspoons baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1 cup rolled oats",
    "0.5 cup chia seeds",
    "1 cup orange juice",
    "0.5 cup applesauce",
    "0.5 cup cooking oil",
    "2 eggs, beaten",
    "2 cups blueberries",
    "2 tablespoons brown sugar",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 24 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, white sugar, baking powder, salt, and baking soda together in a large bowl; add oats and chia seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix orange juice, applesauce, oil, and eggs together in a bowl; stir into flour mixture until batter is just combined. Fold blueberries into batter. Spoon batter into prepared muffin cups, filling 3/4-full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar and cinnamon together in a bowl; sprinkle over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
