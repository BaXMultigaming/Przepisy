  "ingredients": [
    "2 cups all-purpose flour",
    "1.5 cups white sugar",
    "1.3333333730698 cups oats",
    "0.66666668653488 cup unsweetened cocoa powder",
    "2 tablespoons baking powder",
    "2 cups milk",
    "1 cup peanut butter",
    "0.5 cup chocolate chips, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, oats, cocoa powder, and baking powder together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk and peanut butter in a saucepan; cook and stir over medium-low heat until mixture is smooth, about 5 minutes. Remove saucepan from heat and slightly cool peanut butter mixture, about 5 minutes. Stir peanut butter mixture into flour mixture until batter is just combined; fold in chocolate chips. Spoon batter into prepared muffin cups, about 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, about 13 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
