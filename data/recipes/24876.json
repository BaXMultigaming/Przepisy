  "ingredients": [
    "2 Cornish game hens",
    "0.5 cup melted butter",
    "0.5 onion, chopped",
    "0.5 stalk celery, chopped",
    "0.25 green bell pepper, chopped",
    "1 (4.5 ounce) can mushrooms, drained and chopped",
