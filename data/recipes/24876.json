      "image_sources": [
        "https://www.allrecipes.com/thmb/bRz311IgbiNot_gsNG-XsnXq1jA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-24876-baked-cornish-game-hens-VAT-step-04-fe4df43d36604f408c49d60b3ef98a93.jpg"
