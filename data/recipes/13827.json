      ],
      "image": "assets/images/13827/step_01.webp"
    },
    {
      "text": "Mix hot water, sugar, and shortening in a large bowl. Let cool until lukewarm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
