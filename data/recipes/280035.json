  "ingredients": [
    "3 pounds red potatoes, cubed",
    "6 hard-boiled eggs, coarsely chopped",
    "1 sweet onion, diced",
    "2 stalks celery, chopped",
    "6 green onions, chopped",
    "2 cups light mayonnaise",
    "0.5 cup pickled jalapeno peppers, chopped",
    "2.5 tablespoons pickled jalapeno pepper juice",
    "2 teaspoons ground cumin",
    "2 teaspoons ground black pepper",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 10 minutes. Drain and let cool, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooled potatoes, eggs, onion, celery, and green onions in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mayonnaise, jalapenos, jalapeno juice, cumin, pepper, and salt together in another bowl and add to the potatoes. Mix well and chill, 3 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
