  "ingredients": [
    "1.5 pounds thickly sliced bacon, diced",
    "6 pounds boneless lamb shoulder, cut into 2 inch pieces",
    "0.5 cup all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 large onion, chopped",
    "3 cloves garlic, minced",
    "0.5 cup water",
    "4 cups beef stock",
    "2 teaspoons white sugar",
    "4 cups diced carrots",
    "3 potatoes, peeled and cubed",
    "2 large onions, cut into bite-size pieces",
    "1 cup white wine",
    "1 teaspoon dried thyme",
    "2 bay leaves"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KTNcM_zv1zHJdOqr5izNqv6niD4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16035_IrishLambStew_step1_ddmfs_4x3_1434-4a122a64976e41b59e3fa9dec89d06df.jpg"
      ],
      "image": "assets/images/16035/step_01.webp"
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, stirring occasionally, until evenly browned, about 10 minutes. Use a slotted spoon to transfer bacon to a paper towel-lined plate to drain. Reserve bacon fat in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NTbOfVQEyU-evPW0z8X_v_gbguE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16035_IrishLambStew_step2_ddmfs_4x3_1449-16be11b2c9554961b7e3dc639a1224b3.jpg"
      ],
      "image": "assets/images/16035/step_02.webp"
    },
    {
      "text": "Place lamb, flour, salt, and pepper in a large mixing bowl; toss to coat evenly. Brown lamb in bacon fat in the skillet over medium-high heat. Transfer browned meat into a stockpot, leaving 1/4 cup of fat in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MIBbsbVgm3p86Tzoo9OVVEQhsfI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16035_IrishLambStew_step3_ddmfs_4x3_1456-1dcd54878ed8449eb9f59fb2e9436c9d.jpg"
      ],
      "image": "assets/images/16035/step_03.webp"
    },
    {
      "text": "Cook onion and garlic in reserved fat in the skillet over medium heat until onion is golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Nlw-phn_3D1pg6N8S3EOIOmtaMg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16035-Irish-Lamb-Stew-PICS-step-04-94115ccbcc7a47828e7cf9f97e8f8078.jpg"
      ],
      "image": "assets/images/16035/step_04.webp"
    },
    {
      "text": "Deglaze the skillet with water, then pour onion mixture into a Dutch oven or stockpot. Add bacon, beef stock, and sugar to the pot. Cover and simmer for 1 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Btz3HXlfY2ZZ0NPhenAh7UKHCbs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16035_IrishLambStew_step6_ddmfs_4x3_1477-2b1a1e6e8d404d5faee32d5e4a960ba6.jpg"
      ],
      "image": "assets/images/16035/step_05.webp"
    },
    {
      "text": "Add carrots, potatoes, onions, wine, thyme, and bay leaves to the pot. Reduce heat and simmer, covered, until vegetables are tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zghs37C4wp0HvCk6hkEQB4lpyUU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16035-Irish-Lamb-Stew-PICS-step-06-c3008915950d4dcd85d0497b84cf8c05.jpg"
      ],
      "image": "assets/images/16035/step_06.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wA9R3_aYae3cnaH6FVe9moOB5NM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16035-Irish-Lamb-Stew-PICS-Beauty-4x3-07bbf70d34de4e8eae625768b7fdf1f2.jpg"
      ],
      "image": "assets/images/16035/step_07.webp"
    }
