  "title": "Irish Lamb Stew",
  "description": "This hearty lamb stew braises cubes of browned lamb with veggies in a rich broth until fall apart tender and delicious for a comforting Irish meal.",
  "authors": [
    "Danny O'Flaugherty"
  ],
  "date_published": "2000-02-10T17:20:54-05:00",
