  "ingredients": [
    "4 pounds yellow squash, chopped",
    "0.25 pound butter, softened",
    "1 cup mayonnaise",
    "2 eggs, beaten",
    "1 tablespoon white sugar",
    "3 cups shredded Cheddar cheese",
    "1 cup bread crumbs",
    "1 (6 ounce) can French fried onions"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a pot of salted water to a boil. Add squash; cook until tender but still firm, about 10 to 15 minutes. Drain and transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add butter, mayonnaise, eggs and sugar to squash; mix together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle 1/2 of the bread crumbs on bottom of six-quart casserole dish. Pour squash mixture on top and sprinkle with remaining bread crumbs and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes; top with onion rings and bake for an additional 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
