  "ingredients": [
    "2 (15 ounce) cans black beans, drained and rinsed",
    "1.5 cups vegetable broth",
    "1 cup chunky salsa",
    "1 teaspoon ground cumin",
    "4 tablespoons sour cream",
    "2 tablespoons thinly sliced green onion"
  ],
  "steps": [
    {
      "text": "In an electric food processor or blender, combine beans, broth, salsa, and cumin. Blend until fairly smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the bean mixture in a saucepan over medium heat until thoroughly heated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle soup into 4 individual bowls, and top each bowl with 1 tablespoon of the sour cream and 1/2 tablespoon green onion.",
