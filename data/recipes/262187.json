  "ingredients": [
    "2 tablespoons toasted sesame seeds, divided",
    "2 tablespoons water",
    "1.5 tablespoons soy sauce",
    "0.5 teaspoon white sugar",
    "0.5 (8 ounce) package fresh spinach",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Place 1 1/2 tablespoons sesame seeds on a plate; use the bottom of a pot or heavy measuring cup to crush the seeds. Transfer to a bowl. Add water, soy sauce, and sugar; stir dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a small pot of water to a boil; add salt. Add spinach and cook until wilted, no more than 1 minute. Drain spinach into a colander and rinse with cool water to stop the cooking process. Squeeze spinach with hands to remove moisture. Cut into strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cooked spinach in serving bowls. Drizzle dressing on top and add remaining sesame seeds as garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
