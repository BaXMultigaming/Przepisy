  "ingredients": [
    "2.5 pounds lean ground beef",
    "1 (15 ounce) can tomato sauce",
    "1.3333300352097 (6 ounce) cans tomato paste",
    "5 tablespoons chili powder",
    "2 teaspoons ground cinnamon",
    "1 teaspoon ground allspice",
    "1.25 teaspoons salt",
    "1 tablespoon distilled white vinegar",
    "1 teaspoon ground black pepper",
    "0.25 teaspoon garlic powder",
    "1 teaspoon onion salt",
    "2 teaspoons steak sauce",
    "1 quart water"
  ],
  "steps": [
    {
      "text": "Cook ground beef in a large skillet over medium-high heat until lightly browned, 5 to 6 minutes. Transfer to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomato sauce, tomato paste, chili powder, cinnamon, allspice, salt, vinegar, pepper, garlic powder, onion salt, steak sauce, and water to the slow cooker; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 12 hours.",
      "section": null,
