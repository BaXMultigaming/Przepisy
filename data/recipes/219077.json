  "ingredients": [
    "3 large russet potatoes, peeled and cut in half lengthwise",
    "0.5 cup whole milk",
    "0.25 cup butter",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot and cover with cold salted water by about 1 inch. Bring to a boil. Reduce heat to medium-low, cover and simmer until tender and easily pierced with a fork, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ImaoFswllZ-GHVPa9SzS22nL_Lc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219077-chef-johns-perfect-mashed-potatoes-DDMFS-step-02-8e81ccbf97f54cea936dc40946db83b5.jpg"
      ],
      "image": "assets/images/219077/step_01.webp"
    },
    {
      "text": "Drain potatoes and return to the pot. Set the pot over high heat; let potatoes cook until excess moisture evaporates, about 30 seconds. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ri0ZeZ6nUvd9Mc07phr9A2CqrqI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219077-chef-johns-perfect-mashed-potatoes-DDMFS-step-03-df7c95dd4d124656baea40ed72b77121.jpg"
      ],
      "image": "assets/images/219077/step_02.webp"
    },
    {
      "text": "Mash potatoes with a potato masher until mostly smooth; mash in milk and butter until smooth and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yG3dsj_STvzrpqd4ltPPj6y9rMo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219077-chef-johns-perfect-mashed-potatoes-DDMFS-step-04-63a3c5eacfe04eeca0552384ec1976af.jpg"
      ],
      "image": "assets/images/219077/step_03.webp"
    },
    {
      "text": "Season with salt and pepper; whisk until evenly distributed, about 15 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CUiS70VZhyMRqEo1U7tPAc4vm-Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219077-chef-johns-perfect-mashed-potatoes-DDMFS-step-05-98191b0582bb4a428d47bf49ec4bdb20.jpg"
