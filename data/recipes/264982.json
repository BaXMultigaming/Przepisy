  "ingredients": [
    "1 (14 ounce) can beef broth",
    "3.5 pounds beef chuck roast, cut into 3 or 4 chunks",
    "1 stick butter",
    "0.5 (16 ounce) jar pepperoncini peppers and juice",
    "1 (1 ounce) package ranch dressing mix",
    "1 (1 ounce) package dry onion soup mix"
  ],
  "steps": [
    {
      "text": "Pour broth into a multi-functional pressure cooker (such as Instant Pot®). Place beef in the pot and sprinkle with ranch dressing mix and onion soup mix. Place butter on top. Add pepperoncinis and juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Close and lock the pressure cooker lid. Select high pressure according to manufacturer's instructions; set timer for 110 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
