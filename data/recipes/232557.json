  "ingredients": [
    "2 tablespoons white sugar",
    "1 tablespoon cocoa powder",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon ground allspice",
    "6 (8 inch) flour tortillas",
    "0.5 cup butter, melted",
    "0.5 cup peanut butter, melted",
    "0.5 cup caramel dip",
    "0.5 cup chocolate syrup",
    "0.5 cup whipped topping (such as Cool Whip®), or more as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, cocoa powder, cinnamon, and allspice together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat both sides of flour tortillas with melted butter; cut tortillas into quarters. Coat 1 side of tortillas with sugar mixture. Arrange tortilla pieces in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and crispy, 12 to 16 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange baked tortilla pieces on a serving platter; drizzle with peanut butter, caramel dip, and chocolate syrup. Top with whipped topping.",
