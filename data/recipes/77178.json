  "ingredients": [
    "20 cups popped popcorn",
    "8 cups broken salted pretzels",
    "4 cups dry roasted peanuts",
    "3 cups brown sugar",
    "1.5 cups butter",
    "0.75 cup light corn syrup",
    "2 teaspoons vanilla extract",
    "1 teaspoon salt",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Place popcorn, pretzels, and peanuts in a large paper bag or very large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, butter, and corn syrup in a saucepan over medium heat; cook and stir until butter melted, brown sugar dissolved, and mixture comes to a full boil. Boil for 5 minutes, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, stir vanilla, salt, and baking soda into brown sugar mixture using a long spoon; the mixture will foam up when you add the soda. Immediately pour brown sugar mixture over popcorn mixture; shake until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
