  "ingredients": [
    "1 (18.25 ounce) package spice cake mix",
    "1 cup dried apples",
    "1 cup chopped pecans",
    "0.5 cup shredded or flaked coconut",
    "0.33000001311302 cup currants",
    "3 eggs",
    "0.25 cup brown sugar",
    "1 teaspoon vanilla extract",
    "0.5 cup butter",
    "2 cups apple butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease bottoms of two 9 inch round layer cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix the spice cake mix, dried apples, pecans, coconut, currants, eggs, brown sugar, vanilla extract and butter. Pour the mixture into the cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 25 to 30 minutes, or until a toothpick inserted in the center comes out clean. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Split each cake layer into four sections. Spread apple butter between the sections and reassemble layers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
