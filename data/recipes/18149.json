  "title": "Shrimp and Asparagus",
  "description": "Mushrooms, shrimp, and asparagus cooked in a lemony garlic butter are tossed with egg noodles and Parmesan cheese.",
  "authors": [
    "Cathy Christensen"
  ],
  "date_published": "1999-09-30T15:33:45-04:00",
