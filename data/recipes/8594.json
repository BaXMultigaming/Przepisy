  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "1 cup sour cream",
    "0.25 cup chopped onion",
    "0.25 cup chopped mushrooms",
    "32 buttery round crackers, crumbled"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large pot with water; bring to a boil. Cook chicken in boiling water until no longer pink inside, 20 to 30 minutes. Chop chicken into bite-sized pieces and place in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine condensed soup, sour cream, onion, and mushrooms in a bowl. Pour mixture over chicken and top with crumbled crackers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake in the preheated oven until top is lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
