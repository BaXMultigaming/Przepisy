  "ingredients": [
    "2 tablespoons butter",
    "0.5 cup carrot, finely chopped",
    "0.5 cup onion, finely chopped",
    "0.5 cup celery, finely chopped",
    "0.5 cup button mushrooms, chopped",
    "1/2 cup butter",
    "0.25 cup all-purpose flour",
    "1 quart chicken broth",
    "1 (14 ounce) can artichoke hearts, drained",
    "1 bay leaf",
    "0.75 teaspoon salt",
    "0.5 teaspoon cayenne pepper",
    "0.25 teaspoon dried thyme",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon dried sage",
    "1 cup heavy cream",
    "12 shucked oysters and juice"
  ],
  "steps": [
    {
      "text": "Melt 2 tablespoons butter in a large pot. Add carrot, onion, celery, and mushrooms; cook until vegetables soften, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1/2 cup butter in a separate large pot; stir in flour and cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk chicken broth into flour mixture. Add carrot mixture, artichokes hearts, bay leaf, salt, cayenne pepper, thyme, oregano, and sage; simmer over medium heat for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk in cream; add oysters. Bring to a simmer, but do not boil; cook until oysters are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
