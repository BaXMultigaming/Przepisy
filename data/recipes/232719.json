    "publisher-tested"
  ],
  "ingredients": [
    "1 (.25 ounce) package active dry yeast",
    "1 cup warm water (90 to 100 degrees F/32 to 38 degrees C)",
    "1 cup all-purpose flour",
    "1.5 tablespoons olive oil",
    "1.75 teaspoons salt",
    "1.75 cups all-purpose flour, or more as needed",
    "1 teaspoon olive oil, divided"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KTDsbsESTSPa4U5zRWDzm4sgfEI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232719-homemade-pita-bread-DDMFS-4x3-step-01-1938bc57178440d7bb4088ff508d489f.jpg"
      ],
      "image": "assets/images/232719/step_01.webp"
    },
    {
      "text": "Place yeast in the bowl of a stand mixer and add 1 cup warm water and 1 cup flour. Whisk together, then let sit until mixture bubbles and foams, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wxrVIOk7__AmK72B9tEwoDVMGpQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232719-homemade-pita-bread-DDMFS-4x3-step-02-6ada9296273f428d8a1295e6981c27ed.jpg"
      ],
      "image": "assets/images/232719/step_02.webp"
    },
    {
      "text": "Add 1 1/2 tablespoons olive oil and salt into the yeast mixture, followed by 1 1/2 cups flour. Mix at low speed, using a dough hook attachment, until dough is soft, supple, and slightly sticky. Knead dough with machine on low speed until slightly springy and still soft, 5 to 6 minutes. If dough sticks to the sides of the bowl, add up to 1/4 cup more flour, a little at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MDIF6tVk2N68nW_WUBnFjL1kvz0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232719-homemade-pita-bread-DDMFS-4x3-step-03-68f703715597494eafe9d611b7f79c22.jpg"
      ],
      "image": "assets/images/232719/step_03.webp"
    },
    {
      "text": "Turn dough out onto a floured work surface and form into a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Db4H-64sxHv1S0IYXAUpqASpHhQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232719-homemade-pita-bread-DDMFS-4x3-step-04-23d84525ece7415fba82332baead6070.jpg"
      ],
      "image": "assets/images/232719/step_04.webp"
    },
    {
      "text": "Wipe inside of bowl with 1/4 teaspoon olive oil. Turn dough around in bowl to lightly cover with oil; cover bowl with foil and let rise until dough has doubled in size, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oa1pLBS9cVt5OxWxT0XYu2IbSfs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232719-homemade-pita-bread-DDMFS-4x3-step-05-83c0c65860ec42f2a7d52ce5a6657bcf.jpg"
      ],
      "image": "assets/images/232719/step_05.webp"
    },
    {
      "text": "Once dough has doubled, remove from bowl and place onto a lightly floured work surface. Lightly pat into a flat shape about 1-inch thick. Use a knife to cut dough into 8 equal pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uAVunEL6WEU86uiiAZBijFyLAmw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232719-homemade-pita-bread-DDMFS-4x3-step-06-10e1f9ec64db4a4b902837af569a9310.jpg"
      ],
      "image": "assets/images/232719/step_06.webp"
    },
    {
      "text": "Form each piece into a small round ball with a smooth top, pulling dough from the sides and tucking the ends underneath the bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EaX-bHpxHayD4uQKd6MT60txelk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232719-homemade-pita-bread-DDMFS-4x3-step-07-07c8251bced544558c3c3192b0a188e0.jpg"
      ],
      "image": "assets/images/232719/step_07.webp"
    },
    {
      "text": "Cover dough balls with lightly oiled plastic wrap and let rest for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mLZGwtgVghkPZDXLnhOSSvRGQms=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232719-homemade-pita-bread-DDMFS-4x3-step-08-d729ec16967847faa4129c39a8fd4e81.jpg"
      ],
      "image": "assets/images/232719/step_08.webp"
    },
    {
      "text": "Transfer the dough balls to a lightly floured work surface and sprinkle the tops with flour. One at a time, gently pat the dough with your fingers, forming a flat, round disc about 1/4-inch thick. Let the shaped dough rest for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6fKHfhqy980QXc9Hev5ePHmUUzE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232719-homemade-pita-bread-DDMFS-4x3-step-09-362e47b38c3841e7a7800dfcbba09459.jpg"
      ],
      "image": "assets/images/232719/step_09.webp"
    },
    {
      "text": "Brush a cast iron skillet with remaining 3/4 teaspoon olive oil and place over medium-high heat. Lay one round of dough into the hot skillet; cook for 30 seconds, then flip and cook for 1 to 2 minutes. Flip again and cook the first side for 1 to 2 minutes more, until both sides are golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IKR1boAGzNaQHizVI2qGhTaa7BM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232719-homemade-pita-bread-DDMFS-4x3-step-10-440d90a4101f4ad6b20813812d6f5b73.jpg"
      ],
      "image": "assets/images/232719/step_10.webp"
    },
    {
      "text": "Stack cooked breads on a plate; when cool enough to handle, slice breads in half and open the pocket inside for stuffing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w1pxq8Rh6RVBrG3nGCxL4PMbZN4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-232719-homemade-pita-bread-DDMFS-4x3-beauty-4f82a2ae98444cf58969214e3d8f66f0.jpg"
      ],
      "image": "assets/images/232719/step_11.webp"
    }
  ],
