  "ingredients": [
    "1 pound lean ground beef",
    "0.5 cup shredded carrots",
    "0.5 cup chopped celery",
    "0.5 cup chopped onion",
    "3 cups chicken broth",
    "2 cups cooked white rice",
    "1 (15 ounce) can mixed vegetables, drained",
    "1 pound processed cheese food (eg. Velveeta), cubed",
    "1 (11 ounce) can condensed cream of Cheddar cheese soup",
    "2.5 cups milk",
    "8 ounces sour cream"
  ],
  "steps": [
    {
      "text": "Place ground beef in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Simmer carrots, celery, onion, and broth for about 10 minutes or until soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add rice, mixed vegetables, beef, Velveeta, cheese soup, and milk, and cook until cheese is melted. Do not boil. Add sour cream and chives just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
