  "ingredients": [
    "0.5 teaspoon butter, or as needed",
    "2 cups all-purpose flour",
    "0.75 cup brown sugar",
    "0.5 cup vegetable oil",
    "0.5 cup white sugar",
    "4 teaspoons ground cinnamon",
    "0.5 teaspoon fine salt",
    "0.5 teaspoon ground ginger",
    "0.75 teaspoon baking powder",
    "0.75 teaspoon baking soda",
    "0.75 cup buttermilk",
    "1 egg",
    "2 apples - peeled, cored, and cut into 1/2-inch chunks"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Butter an 8-inch glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, oil, white sugar, 2 teaspoons cinnamon, salt, and ginger in a bowl. Transfer ½ cup flour mixture to a separate bowl; stir in remaining 2 teaspoons cinnamon. Set topping aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk baking powder and baking soda into remaining flour mixture. Beat buttermilk and egg together in a measuring cup until well combined; pour into flour mixture. Add apples; stir until just blended and no pockets of flour remain. Pour batter into the prepared pan; sprinkle with topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apples are tender and a toothpick inserted into center comes out clean, 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
