  "ingredients": [
    "0.5 pound ground beef",
    "0.5 pound bulk pork sausage",
    "1 (6 ounce) can tomato paste",
    "0.75 cup chopped onion",
    "1 tablespoon dried parsley",
    "0.5 clove garlic, minced",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "1 dash ground black pepper",
    "1 cup creamed cottage cheese",
    "0.25 cup grated Parmesan cheese",
    "1 large egg",
    "2 (8 ounce) packages refrigerated crescent rolls",
    "2 slices mozzarella cheese",
    "1 tablespoon milk",
    "1 tablespoon sesame seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Add ground beef and sausage; cook and stir until browned and crumbly, 5 to 7 minutes. Drain and discard grease. Add tomato paste, onion, parsley, garlic, basil, oregano, salt, and black pepper; simmer, uncovered, for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cottage cheese, Parmesan cheese, and egg in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll 1 can crescent rolls on an ungreased 15x13-inch cookie sheet; press edges together to seal. Spread ½ meat mixture on top to within 1 inch of dough edge. Top with cottage cheese mixture. Carefully spoon remaining ½ meat mixture on top. Place mozzarella cheese slices on top of meat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll remaining 1 can crescent roll; place dough on top, overlapping the edges by about ¼ inch. Pinch edges to seal to prevent leaking. Brush dough with milk; sprinkle on sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
