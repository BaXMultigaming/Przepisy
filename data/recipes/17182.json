  "title": "Mexican Cornbread Salad",
  "description": "This cold layered salad is made with Jiffy cornbread, pinto beans, bell peppers, canned corn, bacon bits, tomatoes, and cheese. Perfect for picnics or barbecues.",
  "authors": [
    "Jackie"
  ],
  "date_published": "2000-03-11T11:47:45-05:00",
