  "ingredients": [
    "2 pounds medium shrimp - peeled and deveined",
    "salt and pepper to taste",
    "cayenne pepper to taste",
    "0.5 cup olive oil",
    "2 pounds chopped okra",
    "1 tablespoon tomato paste",
    "1 tomato, chopped",
    "1 cup chopped onion",
    "4 cloves garlic, minced",
    "0.5 cup chopped celery",
    "0.5 cup chopped green bell pepper",
    "12 cups water",
    "0.5 cup chopped green onions"
  ],
  "steps": [
    {
      "text": "Season the shrimp with salt, pepper and cayenne to taste and set aside. Heat the oil in a large pot over medium heat. Add the okra and saute for 30 minutes, stirring occasionally. Add the tomato paste, tomato, onion, garlic, celery and green bell pepper and saute for 15 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the water and season to taste. Bring to a boil, reduce heat to low and simmer for 45 minutes. Add the shrimp and simmer for 20 more minutes. Finally, add the green onion to the soup and stir thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
