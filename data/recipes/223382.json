  "title": "Chicken Stir Fry",
  "description": "This chicken stir fry recipe is quick and easy to make with sliced chicken, veggies, and a sweet and savory garlic, ginger, and chili sauce for a kick of heat.",
  "authors": [
    "Katie Sechrist"
  ],
  "date_published": "2020-03-05T00:09:10-05:00",
