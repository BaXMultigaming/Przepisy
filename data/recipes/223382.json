  "ingredients": [
    "4 cups water",
    "2 cups white rice",
    "0.66666668653488 cup soy sauce",
    "0.25 cup brown sugar",
    "1 tablespoon cornstarch",
    "1 tablespoon minced fresh ginger",
    "1 tablespoon minced garlic",
    "0.25 teaspoon red pepper flakes",
    "3 skinless, boneless chicken breast halves, thinly sliced",
    "2 tablespoons sesame oil, divided",
    "1 head broccoli, broken into florets",
    "1 onion, cut into large chunks",
    "1 cup sliced carrots",
    "1 (8 ounce) can sliced water chestnuts, drained",
    "1 green bell pepper, cut into matchsticks"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GJIp4RMDy2z64YvC1k04PzP6lvc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223382-Chicken-Stir-Fry-DDMFS-Step-01a-e36fcb078ae54a0298086e4b7a3f4f57.jpg"
      ],
      "image": "assets/images/223382/step_01.webp"
    },
    {
      "text": "Bring water and rice to a boil in a saucepan over high heat. Reduce heat to medium-low, cover, and simmer until rice is tender, and liquid has been absorbed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kLqD5zd5ObNozoPg5h_eVosHJ_A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223382-Chicken-Stir-Fry-DDMFS-Step-01-14f5262f2e174581ac3d7e9d618bb9cd.jpg"
      ],
      "image": "assets/images/223382/step_02.webp"
    },
    {
      "text": "Meanwhile, combine soy sauce, brown sugar, and cornstarch in a medium glass or ceramic bowl; stir until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P-t6rkirUuSSZGMjseIAhIe69Mo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223382-Chicken-Stir-Fry-DDMFS-Step-02-5fe23122807748f988e19e739b0971a8.jpg"
      ],
      "image": "assets/images/223382/step_03.webp"
    },
    {
      "text": "Stir in ginger, garlic, and red pepper flakes; add chicken and stir to coat. Cover and marinate in the refrigerator for at least 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WK5-Ja6B3-wWIiixfIA21vjC_ZM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223382-Chicken-Stir-Fry-DDMFS-Step-03-7094d72f766c48119d8e146e48304e36.jpg"
      ],
      "image": "assets/images/223382/step_04.webp"
    },
    {
      "text": "Heat 1 tablespoon sesame oil in a wok or large skillet over medium-high heat. Add broccoli, onion, carrots, water chestnuts, and bell pepper; cook and stir until just tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/teMU9aWY1GTg-gB5TO1g9Ej_FvY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223382-Chicken-Stir-Fry-DDMFS-Step-04-9687abb9db6b406cb39b36ab272cb7c3.jpg"
      ],
      "image": "assets/images/223382/step_05.webp"
    },
    {
      "text": "Transfer vegetables into a dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5Qdy13iOHblnAU-2ckYfOmo0vyY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223382-Chicken-Stir-Fry-DDMFS-Step-05-fbeea0cab74949d791e86be4c374863c.jpg"
      ],
      "image": "assets/images/223382/step_06.webp"
    },
    {
      "text": "Heat remaining 1 tablespoon sesame oil in the same wok or skillet over medium-high heat. Add chicken, reserving marinade, and cook until just browned, about 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BvHV7vZ79NsoM7o9lhMCAhrjUQ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223382-Chicken-Stir-Fry-DDMFS-Step-06-d206379ff4e14b0c890f7f0ac8b8e0e3.jpg"
      ],
      "image": "assets/images/223382/step_07.webp"
    },
    {
      "text": "Stir in vegetables and reserved marinade. Bring to a boil; cook and stir until chicken is no longer pink in the center and vegetables are tender, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n7O-uvGPXJ0hYU7gjEnp1bmiFp8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-223382-Chicken-Stir-Fry-DDMFS-Step-07-612b15a4f5be4bd999fcfee7fda2c156.jpg"
      ],
      "image": "assets/images/223382/step_08.webp"
    },
    {
      "text": "Serve over rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xvlRRhK5ldXuGcXad8XDM5tTAfE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223382_chicken-stir-fry_Rita-1x1-1-b6b835ccfc714bb6a8391a7c47a06a84.jpg"
      ],
      "image": "assets/images/223382/step_09.webp"
    }
