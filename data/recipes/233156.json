  "ingredients": [
    "1 (16 ounce) container low-fat plain yogurt",
    "1 cucumber - peeled, seeded, and grated",
    "1 tablespoon chopped fresh dill",
    "1 tablespoon fresh lemon juice",
    "2 cloves garlic, minced",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Line a colander with two layers of cheesecloth; place over a bowl. Place yogurt in cheesecloth-lined colander; cover with plastic wrap. Drain yogurt 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place grated cucumber in a fine-mesh strainer; drain 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine yogurt, cucumber, dill, lemon juice, garlic, salt, and black pepper in a bowl; refrigerate for flavors to meld, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
