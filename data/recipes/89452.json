  "ingredients": [
    "cooking spray",
    "2 large egg whites",
    "0.5 cup seasoned dry bread crumbs",
    "2 tablespoons grated Parmesan cheese",
    "0.125 teaspoon ground black pepper",
    "2 medium zucchini, cut into 1/4-inch slices"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 475 degrees F (245 degrees C). Grease a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg whites in a small bowl. Mix together bread crumbs, Parmesan cheese, and pepper in a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip zucchini slices into egg whites, then press into bread crumb mixture to coat. Place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 minutes. Turn zucchini over and continue baking until browned and crispy, 5 to 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
