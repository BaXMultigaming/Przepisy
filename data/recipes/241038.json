    "0.25 cup white sugar",
    "2 tablespoons unsweetened cocoa powder",
    "0.125 teaspoon baking soda",
    "0.125 teaspoon salt",
    "3 tablespoons milk",
    "2 tablespoons canola oil",
    "1 tablespoon water",
    "0.25 teaspoon vanilla extract"
