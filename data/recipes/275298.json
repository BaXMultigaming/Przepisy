  "ingredients": [
    "2.5 cups all-purpose flour",
    "1 tablespoon baking powder",
    "2 bag Earl Grey tea, ground to a powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.75 cup butter, softened",
    "0.5 cup powdered sugar",
    "0.66666668653488 cup strong brewed Earl Grey tea"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, powdered tea, salt, and nutmeg together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter and powdered sugar together in a small bowl until smooth. Cut butter-sugar mixture into the flour mixture until it resembles coarse crumbs. Stir in brewed tea until a soft dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead dough briefly on a floured surface. Roll out into a circle about 1/2 inch thick. Cut out biscuits using a round cutter and transfer to the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
