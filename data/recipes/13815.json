  "title": "Knödel",
  "description": "Knödel is an Austrian dumpling casserole that bears a resemblance to a savory bread pudding or stuffing. Seasoned bread is baked with egg and more.",
  "authors": [
    "Margaret"
  ],
  "date_published": "1999-10-14T18:03:25-04:00",
