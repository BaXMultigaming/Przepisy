  "ingredients": [
    "1 (29 ounce) can solid pack pumpkin",
    "2.5 cups white sugar",
    "1.5 cups vegetable oil",
    "5 eggs",
    "3 cups all-purpose flour",
    "1 tablespoon baking powder",
    "2 teaspoons ground cinnamon",
    "2 teaspoons pumpkin pie spice",
    "1.5 teaspoons baking soda",
    "1.5 teaspoons salt",
    "2 (8 ounce) packages cream cheese, softened",
    "0.5 cup butter, softened",
    "2 teaspoons vanilla extract",
    "2 cups sifted confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a jelly roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat pumpkin, white sugar, vegetable oil, and eggs together in a large mixing bowl. Combine flour, baking powder, cinnamon, pumpkin pie spice, baking soda, and salt in a sifter; sift into the pumpkin mixture and mix well; pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until center springs back when lightly touched, 35 to 40 minutes. Cool completely before frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and butter together in a bowl until smooth; add vanilla extract and beat. Gradually beat confectioners' sugar into the frosting, adding in small amounts and assuring each batch is incorporated before introducing the next. Spread over the pumpkin bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
