  "ingredients": [
    "5 pounds Yukon Gold potatoes, cubed",
    "8 ounces sour cream",
    "2 (3 ounce) packages cream cheese",
    "0.5 cup milk",
    "2 teaspoons onion salt",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5GB8YBl6XLzCvJTdnb9ZTlw9FZs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13608-make-ahead-mashed-potatoes-Step-01-a7fcf36896aa4dd4b108374b93b35b54.jpg"
      ],
      "image": "assets/images/13608/step_01.webp"
    },
    {
      "text": "Place potatoes in a large pot of lightly salted water. Bring to a boil and cook until tender, about 15 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/03yP-rQxTM3uAG6Ocu_EkY9qv9A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13608-make-ahead-mashed-potatoes-Step-02-aa3303fd227542dfad323ac58d7c9841.jpg"
      ],
      "image": "assets/images/13608/step_02.webp"
    },
    {
      "text": "Transfer potatoes into a large bowl and mash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CfARmRsigH6KqHEwbiVtI1lF6nQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13608-make-ahead-mashed-potatoes-Step-03-c687c6f1945f4c188ba6ecfb61c5a1ab.jpg"
      ],
      "image": "assets/images/13608/step_03.webp"
    },
    {
      "text": "Stir in sour cream, cream cheese, milk, onion salt, and pepper until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9LukrtHGBJHeidyQIXz1WZWmyHc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13608-make-ahead-mashed-potatoes-Step-04-5e1c111a030246f69848c95bb767437b.jpg"
      ],
      "image": "assets/images/13608/step_04.webp"
    },
    {
      "text": "Transfer into a large casserole dish. Let potatoes cool completely, 15 to 20 minutes. Cover with aluminum foil and refrigerate for up to 2 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hkMTZSkM4C4UxEhBFkHNVCEyt2U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13608-make-ahead-mashed-potatoes-Step-05-c6c15cda050f453180ead44ec33bd77e.jpg"
      ],
      "image": "assets/images/13608/step_05.webp"
    },
    {
      "text": "When ready to bake, remove casserole from the refrigerator and let sit for 30 minutes on the counter. Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aOcQtbHbsjq3URChF0Ad9X34VJU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13608-make-ahead-mashed-potatoes-Step-06-ef26aacd81e24b069dfa43ca9af6ef11.jpg"
      ],
      "image": "assets/images/13608/step_06.webp"
    },
    {
      "text": "Bake, covered, in the preheated oven for 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s4DKgNp18SPOFyOW5Tw5wsfOK4o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13608-make-ahead-mashed-potatoes-Beauties-4x3-a1c6cde3226044b68cf4e859d2db17f6.jpg"
      ],
      "image": "assets/images/13608/step_07.webp"
    }
  ],
