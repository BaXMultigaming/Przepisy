  "ingredients": [
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "1.25 cups vegetable oil",
    "3 eggs",
    "1 (8 ounce) can crushed pineapple with juice",
    "2 cups diced bananas",
    "1 cup chopped pecans",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 12-cup Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Measure flour, sugar, soda, salt, cinnamon, oil, eggs, vanilla into mixing bowl. Beat until smooth. Stir in pineapple with juice, bananas, and pecans. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in oven for about 70 minutes. Turn cake out onto rack or plate after cooling for 20 minutes. Cool, and ice with cream cheese icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
