  "ingredients": [
    "1.5 tablespoons chili powder",
    "2 teaspoons ground cumin",
    "1 teaspoon ground paprika",
    "1 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon dried oregano",
    "0.25 teaspoon cayenne pepper",
    "12 ounces ground turkey",
    "0.5 cup water",
    "1 tablespoon cider vinegar",
    "1.5 teaspoons brown sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aKQN2BePthX822nFUkzMPua5ync=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-255545-Ground-Turkey-Taco-Meat-ddmfs-step-0-70551d72c56e4e0fa2163d230dd4da15.jpg"
      ],
      "image": "assets/images/255545/step_01.webp"
    },
    {
      "text": "Combine chili powder, cumin, paprika, salt, garlic powder, onion powder, oregano, and cayenne in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EgRr1RTrNXFbbtLl_9WQDGa_is4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-255545-Ground-Turkey-Taco-Meat-ddmfs-step-1-895c4dbaa11145de8832bbc6e1cebf08.jpg"
      ],
      "image": "assets/images/255545/step_02.webp"
    },
    {
      "text": "Heat a large nonstick skillet over medium heat. Add ground turkey and cook, stirring to break up clumps, until no longer pink, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9nUs4S-wZJGZaYOUxW7nGJ80F5Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-255545-Ground-Turkey-Taco-Meat-ddmfs-step-2-313e5166e57b4a4196fdcfd7d10b6a3b.jpg"
      ],
      "image": "assets/images/255545/step_03.webp"
    },
    {
      "text": "Stir in spice mixture and water. Reduce heat and simmer, stirring occasionally, until most of the liquid is absorbed, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3Qh7O-aYhEme-KxgVWI8T9Jd_2c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-255545-Ground-Turkey-Taco-Meat-ddmfs-step-3-e3a928fce23042d2985e1719b7f34e37.jpg"
      ],
      "image": "assets/images/255545/step_04.webp"
    },
    {
      "text": "Stir in cider vinegar and brown sugar; simmer until flavors combine, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KXPbA_VNsqVTQJRWu2qDj-f9LWU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-255545-Ground-Turkey-Taco-Meat-ddmfs-step-4-aafc9ee3be0448dbb841fd98ef66e6e5.jpg"
      ],
      "image": "assets/images/255545/step_05.webp"
    },
    {
      "text": "Transfer to a serving bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I8-iI1qSQ4viPaKSwCrsKKwwiGw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-255545-Ground-Turkey-Taco-Meat-ddmfs-step-5-da15ea2e155942aeb8d64e20b5f9e7c3.jpg"
