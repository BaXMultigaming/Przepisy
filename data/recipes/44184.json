  "ingredients": [
    "2 pounds ground veal",
    "1 cup Italian seasoned bread crumbs",
    "1 egg, beaten",
    "0.33333334326744 cup shredded baby carrots",
    "1 cup ketchup",
    "1 tablespoon chopped garlic",
    "0.5 cup chopped onion",
    "1 teaspoon salt",
    "1 teaspoon dried parsley",
    "0.5 teaspoon chili powder",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix the veal, bread crumbs, egg, baby carrots, 1/2 cup ketchup, garlic, and onion. Season with salt, parsley, chili powder, and pepper. Transfer to an 8x8 inch pan, and form into a loaf shape. Top with remaining ketchup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and bake 45 minutes in the preheated oven. Remove cover, and continue baking 15 minutes, or to an internal temperature of 160 degrees F (70 degrees C). Let sit 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
