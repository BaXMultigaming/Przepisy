  "ingredients": [
    "3 potatoes, peeled",
    "6 ounces bacon, chopped",
    "0.5 cup chopped onion",
    "0.5 cup chopped green bell pepper",
    "1 teaspoon chopped garlic",
    "1 cup chopped fresh tomatoes",
    "salt and pepper to taste",
    "6 ounces Cheddar cheese, shredded",
    "8 eggs"
  ],
  "steps": [
    {
      "text": "Bring a pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes. Drain, cool and chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Add the onions, peppers, garlic, tomatoes, and potatoes. Season with salt and pepper and cook until vegetables are soft, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle vegetable mixture with cheese. Crack eggs into the pan a couple of inches apart. Cover pan and allow eggs to cook to desired firmness. Remove pan from heat and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
