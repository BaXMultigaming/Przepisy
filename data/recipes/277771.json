  "ingredients": [
    "2 cups all-purpose flour",
    "0.33333334326744 cup unsweetened cocoa powder",
    "1 cup butter, softened",
    "1 cup white sugar",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and cocoa powder together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter in a large mixing bowl with an electric mixer until creamy. Add sugar and vanilla extract; mix well. Mix in flour mixture gradually, 1/2 cup at a time, until incorporated; dough will resemble damp sand.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press dough firmly into a 9x13-inch baking pan. Cut into 1x2-inch rectangles. Prick each rectangle a few times lightly with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top looks dry and edges start to pull away from the sides of the pan, 20 to 25 minutes. Let cool before lifting out of the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
