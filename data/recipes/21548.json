  "ingredients": [
    "0.75 cup orange juice",
    "1 egg, beaten",
    "0.25 cup vegetable oil",
    "2 teaspoons grated orange zest",
    "2 cups all-purpose flour",
    "0.75 cup white sugar",
    "1.5 teaspoons baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1.25 cups finely chopped rhubarb"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together orange juice, beaten egg, oil, and orange zest in a large bowl until well combined. Combine flour, white sugar, baking powder, salt, and baking soda in a medium bowl until well mixed; stir into egg mixture until just combined. Fold in rhubarb until incorporated. Divide batter evenly into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
