  "ingredients": [
    "0.25 cup oil",
    "1 red onion, minced",
    "1 red bell pepper, minced",
    "1 clove garlic, thinly sliced",
    "1 teaspoon minced fresh ginger, or to taste",
    "2 pounds watermelon, coarsely chopped",
    "1 pound tomatoes, coarsely chopped",
    "1 tablespoon lime juice, or to taste",
    "1 tablespoon curry powder",
    "1 pinch salt, or to taste",
    "1 pinch white sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a stockpot over medium heat. Add onion, bell pepper, garlic, and ginger; cook and stir until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir watermelon, tomatoes, lime juice, curry powder, salt, and sugar into onion mixture; bring to a boil. Reduce heat to medium-low; simmer, uncovered, until watermelon and tomatoes begin to break down, about 10 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill sterilized jars with chutney and seal. Flip jars upside down to mix for 5 minutes; flip right-side up and refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
