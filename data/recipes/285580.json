  "ingredients": [
    "3 cups cubed bread",
    "2 cups white sugar",
    "2 cups half-and-half",
    "5 large eggs, beaten",
    "2 teaspoons pure vanilla extract",
    "0.5 cup raisins",
    "1 cup packed light brown sugar",
    "0.5 stick unsalted butter, softened",
    "1 cup white sugar",
    "1 stick unsalted butter, melted",
    "1 large egg, beaten",
    "2 teaspoons pure vanilla extract",
    "0.25 cup rum"
  ],
  "steps": [
    {
      "text": "Scatter bread on a rimmed baking sheet in a single layer. Place inside a cold oven with the light on for 8 hours to overnight. Remove from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, half-and-half, and eggs together in a large bowl. Mix in vanilla. Add bread cubes and let sit until liquid is absorbed, 2 to 3 minutes. Stir in raisins. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar and butter for topping together in a small bowl until crumbly. Sprinkle over the bread mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the bread pudding is baking, prepare rum sauce: stir sugar, melted butter, egg, and vanilla together in a saucepan over medium heat. Stir until sugar melts. Add rum and stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove bread pudding from the oven. Drizzle rum sauce over top and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
