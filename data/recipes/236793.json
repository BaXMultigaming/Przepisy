  "ingredients": [
    "2.5 cups cooked lentils",
    "1 small onion, diced",
    "1 egg, beaten",
    "0.25 cup diced bell pepper",
    "0.125 cup Italian-seasoned bread crumbs",
    "0.33333334326744 cup shredded mozzarella cheese",
    "1 teaspoon olive oil-packed minced garlic",
    "1 pinch salt",
    "1 pinch ground black pepper",
    "0.25 cup cornmeal, or as needed",
    "1 tablespoon olive oil"
  ],
  "steps": [
    {
      "text": "Pulse lentils in a food processor until coarsely ground; transfer to a large mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix onion, egg, bell pepper, and bread crumbs with the lentils; add mozzarella cheese, garlic, salt, and pepper to the lentils and mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide the mixture into four equally sized portions, roll into balls, and flatten into patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cornmeal into a wide, shallow bowl. Dredge patties in cornmeal to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a wide skillet over medium-high heat. Cook patties in skillet until browned, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
