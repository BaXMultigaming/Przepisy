  "ingredients": [
    "1 teaspoon vegetable oil",
    "0.5 cup chopped onion",
    "2 (3 ounce) packages cream cheese, softened",
    "0.25 cup butter, softened",
    "1 (15.25 ounce) can whole kernel corn, drained",
    "1 (15.25 ounce) can creamed corn",
    "1 (4 ounce) can chopped green chile peppers",
    "1 (2.8 ounce) package French-fried onions, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a small skillet over medium heat. Sauté onion in hot oil until translucent. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese and butter in a large bowl. Stir in whole kernel corn, creamed corn, and chile peppers until well combined. Pour into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Remove from the oven and stir in 1/2 of the French-fried onions; sprinkle remaining French-fried onions on top. Bake for 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
