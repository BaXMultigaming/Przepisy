  "ingredients": [
    "3 cups all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "1 tablespoon ground cinnamon",
    "3 large eggs",
    "1 cup vegetable oil",
    "2.25 cups white sugar",
    "3 teaspoons vanilla extract",
    "2 cups grated zucchini",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 8x4-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xHChD2CRAX-LHXPtr15tSS-vuFY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6698-moms-zucchini-bread-DDMFS-4x3-step-01-c31e5613cc014affb16bb9b3d9be4640.jpg"
      ],
      "image": "assets/images/6698/step_01.webp"
    },
    {
      "text": "Sift flour, salt, baking powder, baking soda, and cinnamon together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HvLMYqXuyoauiMrpcbfbyo8_gkE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6698-moms-zucchini-bread-DDMFS-4x3-step-02-3fdbc8efc0fc4db6a77a98fbee877247.jpg"
      ],
      "image": "assets/images/6698/step_02.webp"
    },
    {
      "text": "Beat eggs, oil, sugar, and vanilla together in a separate large bowl with an electric mixer until combined; add flour mixture and beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qQYJOaRvyPivGWmgwxSroHZ1GDY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6698-moms-zucchini-bread-DDMFS-4x3-step-04-589880050fce46d584d6a372df1dd9bd.jpg"
      ],
      "image": "assets/images/6698/step_03.webp"
    },
    {
      "text": "Stir in shredded zucchini and chopped walnuts until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EJXuSdpGQL1Fs9qO10DJAmw3cmc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6698-moms-zucchini-bread-DDMFS-4x3-step-05-0a339c39e2ec4a549c237618ff3a2e4c.jpg"
      ],
      "image": "assets/images/6698/step_04.webp"
    },
    {
      "text": "Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WOqrMdT8Bergx8IbKaaH8H6OmR8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6698-moms-zucchini-bread-DDMFS-4x3-step-06-4cc2f07c467d451c9b69a4bc18226553.jpg"
      ],
      "image": "assets/images/6698/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 40 to 60 minutes. Cool in the pans on a wire rack for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/56JCXB7WmmXbV2-T7v2QIqWLcQ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6698-moms-zucchini-bread-DDMFS-4x3-step-07-5912e5f104f246be9481224a3ad0af3b.jpg"
      ],
      "image": "assets/images/6698/step_06.webp"
    },
    {
      "text": "Run a table knife around the edges to loosen. Invert carefully onto a wire rack and let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SuFyebthQYoEoz1-rSYGvVagnuk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-6698-moms-zucchini-bread-DDMFS-4x3-72c63ca7ff82453d8c353aa73715374f.jpg"
      ],
      "image": "assets/images/6698/step_07.webp"
    }
