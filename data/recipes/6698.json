  "title": "Mom's Zucchini Bread",
  "description": "This zucchini bread flavored with cinnamon and vanilla has crunchy walnuts in every bite. It is easy to bake, super moist, and delicious.",
  "authors": [
    "Vicki Monte"
  ],
  "date_published": "1998-05-16T15:29:57-04:00",
