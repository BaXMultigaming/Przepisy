  "ingredients": [
    "1 head cauliflower, cut into florets",
    "1 large red bell pepper, cut into 1-1/2 inch pieces",
    "1 red onion, sliced",
    "0.5 cup chopped fresh dill",
    "3 tablespoons balsamic vinegar",
    "2 tablespoons white wine vinegar",
    "2 teaspoons olive oil",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine the cauliflower, bell pepper, onion, dill, balsamic vinegar, white wine vinegar, and olive oil in a large resalable bag; shake bag to evenly coat. Allow to marinate in refrigerator 1 to 2 hours, turning bag occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Open the bag and season with salt and pepper; reseal the bag and shake again to coat. Pour into a 9x13 glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tender, about 30 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
