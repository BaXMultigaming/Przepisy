  "title": "Spicy Easy Baked Chicken Drumsticks",
  "description": "Marinated in mustard, beer, red pepper flakes, garlic, salt, and pepper, these baked chicken drumsticks make a simple, tasty dinner.",
  "authors": [
    "Chef Mo"
  ],
  "date_published": "2021-04-22T17:12:49-04:00",
