  "ingredients": [
    "10 slices LAND O LAKES® Deli American, cut into 1/4-inch pieces",
    "1 (8 ounce) package cream cheese, softened",
    "2 tablespoons jarred jalapeno pepper, chopped",
    "2 cups frozen cranberries",
    "2 tablespoons sugar",
    "1 thin slice Baguette slices, toasted"
  ],
  "steps": [
    {
      "text": "Heat oven to 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cheeses and jalapenos in bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cranberries and sugar in another bowl; toss to coat. Gently stir cranberries into cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread mixture into 1-quart casserole dish. Bake 30-35 minutes or until bubbly around edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with baguette slices, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
