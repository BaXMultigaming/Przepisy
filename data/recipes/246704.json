  "ingredients": [
    "2 teaspoons vegetable shortening",
    "2 cups sliced apples",
    "0.5 cup white sugar",
    "1 teaspoon ground cinnamon",
    "0.75 cup brown sugar",
    "0.75 cup self-rising flour",
    "0.75 cup quick-cooking oats",
    "0.5 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking dish with shortening.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix apples, white sugar, and cinnamon together in a bowl. Spread in the bottom of the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, self-rising flour, oats, and vegetable oil in a large bowl. Crumble over apples in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is crisp and golden, 30 to 45 minutes.",
