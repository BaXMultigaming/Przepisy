  "ingredients": [
    "0.25 cup vegetable oil",
    "3 tablespoons cider vinegar",
    "1.5 teaspoons white sugar",
    "1 teaspoon dried parsley",
    "1 teaspoon dried basil",
    "1 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "4 cups halved cherry tomatoes"
  ],
  "steps": [
    {
      "text": "Whisk oil, vinegar, sugar, parsley, basil, oregano, and salt together in a small bowl or measuring cup until vinaigrette is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cherry tomatoes in a serving dish; pour vinaigrette over tomatoes and gently stir to coat. Chill in the refrigerator for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently stir salad from the bottom to the top, coating all tomatoes, before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
