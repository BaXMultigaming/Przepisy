  "ingredients": [
    "1 cup milk",
    "3 tablespoons butter",
    "1 tablespoon brown sugar",
    "1 egg",
    "1 teaspoon salt",
    "1 tablespoon ground cinnamon",
    "1.5 teaspoons bread machine yeast",
    "3 cups bread flour",
    "0.5 cup raisins",
    "0.5 cup dried cherries"
