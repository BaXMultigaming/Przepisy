  "ingredients": [
    "5 slices bacon",
    "1 (5 1/2 pound) bone-in turkey breast, skin removed",
    "0.5 teaspoon garlic pepper",
    "1 (10.5 ounce) can turkey gravy",
    "2 tablespoons all-purpose flour",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon dried sage"
  ],
