    "publisher-tested"
  ],
  "ingredients": [
    "0.5 (17.5 ounce) package frozen puff pastry",
    "2 teaspoons olive oil (preferably drained from a tin of anchovies)",
    "1 pinch cayenne pepper, or to taste",
    "1 pinch salt and freshly ground black pepper to taste",
    "0.25 cup shredded sharp white Cheddar cheese",
    "5 tablespoons freshly shredded Parmigiano-Reggiano cheese, divided"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper or a silicone baking mat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DvyKRbwvLtwx9j5ALto5oq0rjmY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234683-how-to-make-cheese-sticks-DDMFS-Step-01-4d04e94942af49468cd0b77110375137.jpg"
      ],
      "image": "assets/images/234683/step_01.webp"
    },
    {
      "text": "Unfold puff pastry into a flat sheet and brush olive oil over top. Season with salt, pepper, and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9-ff-rElf7HgCll_PFCLQDdu8LM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234683-how-to-make-cheese-sticks-DDMFS-Step-02-ec7879d5634249f786f0d2ea5b8042d3.jpg"
      ],
      "image": "assets/images/234683/step_02.webp"
    },
    {
      "text": "Sprinkle Cheddar and 1/4 cup Parmigiano-Reggiano all over dough to cover. Cover with a piece of plastic wrap. Press on the plastic wrap with your fingers to push cheese and seasonings firmly into the dough, or place a sheet pan over top and press down. Remove and discard plastic wrap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xQJQa6fcKnwMyxFvQB7kTIp-q2E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234683-how-to-make-cheese-sticks-DDMFS-Step-03-fb18d45380454445b8560812d781f2b2.jpg"
      ],
      "image": "assets/images/234683/step_03.webp"
    },
    {
      "text": "Cut dough along the seams into thirds with a pizza cutter or sharp knife, then cut each third lengthwise into thirds again for a total of nine strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3y-70aHWPgSvI9ZzjblDjSgFAc8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234683-how-to-make-cheese-sticks-DDMFS-Step-04-c0cee7eded7a4a6a9b1e55e61866f14d.jpg"
      ],
      "image": "assets/images/234683/step_04.webp"
    },
    {
      "text": "Pick up one strip and place it seasoned-side down onto the work surface. Twist it from both ends eight to nine times to make a rolled tube of dough with the seasoning facing out. Place onto the prepared baking sheet and repeat with remaining strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZiApiPSxgA_-yVYSxRzYlPHshfM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234683-how-to-make-cheese-sticks-DDMFS-Step-05-a82cf09948eb444c8106725a77f4dec9.jpg"
      ],
      "image": "assets/images/234683/step_05.webp"
    },
    {
      "text": "Sprinkle remaining 1 tablespoon Parmigiano-Reggiano cheese over cheese sticks. Roll sticks lightly to even up their shapes; pick up and press any dropped cheese onto the surfaces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Lc51F4EBEZkbUzAQoJ82CvM02p4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234683-how-to-make-cheese-sticks-DDMFS-Step-06-55b0534cb7f64751851f7bcea6b6825d.jpg"
      ],
      "image": "assets/images/234683/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven for about 10 minutes, then flip and bake until sticks are browned and crisp and hold their shape without drooping when lifted, 10 to 20 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fnKphknXKmh-gaLfD8Tr-mGc9Ac=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234683-how-to-make-cheese-sticks-DDMFS-Step-08-032bcfcff1014b18a5f6c92ea072f55f.jpg"
      ],
      "image": "assets/images/234683/step_07.webp"
    },
    {
      "text": "Cool on a wire rack before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7XaHUJ-wRbkYyBLbtFhyEaSa7N0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234683-how-to-make-cheese-sticks-DDMFS-Step-07-6fb9acd3534d4a6b86f1c890e7112474.jpg"
      ],
      "image": "assets/images/234683/step_08.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vznLul2fzMjmEnxYqJIritgX_1A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234683-how-to-make-cheese-sticks-DDMFS-Beauty-4x3-6fb6179620c6456b82b3e13f753ac62c.jpg"
      ],
      "image": "assets/images/234683/step_09.webp"
    }
  ],
