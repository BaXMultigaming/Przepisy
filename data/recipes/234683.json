  "title": "How to Make Cheese Sticks",
  "description": "These fancy twist cheese sticks are rich, buttery, and satisfyingly crunchy. They&#39;re easy to make with Cheddar, Parmesan, and frozen puff pastry dough.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2013-09-23T17:30:29-04:00",
  "date_modified": "2025-12-31T06:41:00-05:00",
  "prep_time": "PT25M",
  "cook_time": "PT20M",
  "total_time": "PT60M",
  "yield": [
    "9",
    "9 sticks"
  ],
  "categories": [
    "Appetizer",
    "Snack"
  ],
  "cuisines": [
    "Italian Inspired",
    "American"
  ],
  "regions": [
    "Italian Inspired",
