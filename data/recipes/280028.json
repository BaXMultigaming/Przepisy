  "ingredients": [
    "1 large head cauliflower, cut into bite-sized pieces",
    "6 slices bacon",
    "2 hard-boiled eggs, diced",
    "0.5 cup shredded Cheddar cheese",
    "0.33333334326744 cup mayonnaise",
    "0.25 cup chopped red onion",
    "1 tablespoon chopped fresh dill",
    "1 tablespoon prepared yellow mustard",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add cauliflower, cover, and steam until tender-crisp, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cauliflower into a large mixing bowl and place in the refrigerator to chill for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels and crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add bacon, eggs, Cheddar cheese, mayonnaise, onion, dill, mustard, salt, and pepper to the bowl of cauliflower and stir well to combine. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
