  "ingredients": [
    "2 cups vegetable broth",
    "1 cup quinoa",
    "1 cucumber, chopped",
    "2 tomatoes, chopped",
    "0.5 cup fresh parsley, chopped",
    "2 green onions, chopped",
    "2 tablespoons chopped fresh mint",
    "2 cloves garlic, minced",
    "0.25 cup olive oil",
    "0.25 cup lemon juice",
    "0.5 teaspoon salt, or to taste"
