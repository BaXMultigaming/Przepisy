  "ingredients": [
    "4 slices bread",
    "2 tablespoons salted butter, softened",
    "1 teaspoon finely chopped scallion",
    "1 teaspoon finely chopped fresh parsley",
    "0.5 teaspoon bottled minced garlic",
    "8 slices smoked salmon",
    "0.5 cucumber, thinly sliced",
    "0.5 lemon"
  ],
  "steps": [
    {
      "text": "Toast bread slices in a toaster until golden and crispy, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, scallion, parsley, and garlic in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread each piece of bread with 1/2 tablespoon of herbed butter mixture. Layer with 2 slices of smoked salmon, followed by cucumber. Top with a squeeze of lemon juice. Cut on an angle and serve immediately.",
