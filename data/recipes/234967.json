  "ingredients": [
    "3 orange pekoe tea bags",
    "3 cups water",
    "0.25 cup white sugar",
    "10 cardamom seeds, or to taste",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground ginger",
    "1 (12 fluid ounce) can evaporated milk"
  ],
  "steps": [
    {
      "text": "Cut tea bags open and empty into a small bowl; discard tea bags.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water to a boil in a saucepan; add loose tea. Boil tea until water becomes dark red, 3 to 5 minutes. Stir sugar into tea.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grind cardamom seeds in an electric grinder or using a mortar and pestle. Stir ground cardamom, cinnamon, nutmeg, and ginger into tea; boil until flavors are infused, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk into tea and bring back to a boil for about 2 minutes. Pour tea through a sieve to separate out solids. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
