  "ingredients": [
    "0.75 cup butter, softened",
    "0.75 cup packed brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.75 cup whole wheat flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon ground cloves",
    "2 cups rolled oats",
    "1 cup shredded carrots",
    "0.5 cup raisins",
    "0.25 cup chopped walnuts",
    "1 tablespoon coarse sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and brown sugar together in a bowl using an electric mixer until smooth and creamy; add egg and vanilla extract and beat until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk all-purpose flour, whole wheat flour, baking powder, cinnamon, baking soda, and cloves together in a bowl; stir into butter mixture until just incorporated. Fold oats, carrots, raisins, and walnuts into dough. Drop large mounds of dough onto the prepared baking sheet and sprinkle each with coarse sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
