  "ingredients": [
    "4 tablespoons butter, divided",
    "0.5 sleeve buttery round crackers (such as Ritz®), crushed",
    "1 pound thick-cut cod loin",
    "0.5 medium lemon, juiced",
    "0.25 cup dry white wine",
    "1 tablespoon chopped fresh parsley",
    "1 tablespoon chopped green onion",
    "1 medium lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/chknVdifsSKRP85vWC7-nVqCJGQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228319-perfect-ten-baked-cod-mfs-step1-099-aeb48cf6dbf349ea980beee3dfb14def.jpg"
      ],
      "image": "assets/images/228319/step_01.webp"
    },
    {
      "text": "Place 2 tablespoons butter in a microwave-safe bowl. Melt in the microwave on high, about 30 seconds. Stir buttery round crackers into melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uqFbl-3sIBKIW2_0vTNPKJL0hV0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228319-perfect-ten-baked-cod-mfs-step2-100-66a345e5d37746bfa823a2a101916ddd.jpg"
      ],
      "image": "assets/images/228319/step_02.webp"
    },
    {
      "text": "Place remaining 2 tablespoons butter in a 7x11-inch baking dish. Melt in the preheated oven, 1 to 3 minutes. Remove dish from oven. Coat both sides of cod in melted butter in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mB0Qm3HQqwCD3We4Lg1eMJs9tsE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228319-perfect-ten-baked-cod-mfs-step3-101-2f3813b88b6645c8a7a4947ca9da5660.jpg"
      ],
      "image": "assets/images/228319/step_03.webp"
    },
    {
      "text": "Bake cod in the preheated oven for 10 minutes. Remove from oven; top with lemon juice, wine, and cracker mixture. Return to the oven and bake until fish is opaque and flakes easily with a fork, about 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RwuiJfixz6C3CFFLNjr9JMieZDk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228319-perfect-ten-baked-cod-mfs-step4-102-48c3cedd31dc4e468f60de6f75720430.jpg"
      ],
      "image": "assets/images/228319/step_04.webp"
    },
    {
      "text": "Garnish with parsley and green onion and serve with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EotP0OBdF5B40nO7NGfGZJIL78E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228319-perfect-ten-baked-cod-DDMFS-4x3-ef94101d44ee49659ba002a7b1b9cc8d.jpg"
      ],
      "image": "assets/images/228319/step_05.webp"
    }
  ],
