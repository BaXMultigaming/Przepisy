  "ingredients": [
    "0.66666668653488 cup vegetable oil",
    "1 cup white sugar",
    "1 egg",
    "0.25 cup molasses",
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground ginger",
    "0.5 teaspoon ground cloves",
    "0.33333334326744 cup white sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JQ2NO8J5eicKfYnIjEBDJDUtjPc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-10074-crackle-top-molasses-cookies-VAT-step-01-b73d6a1fdd2641d298650f43fca7feea.jpg"
      ],
      "image": "assets/images/10074/step_01.webp"
    },
    {
      "text": "Mix oil and 1 cup sugar in a large bowl. Add egg; beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3VCbemYMIVle9GwmhLQELOx5O90=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-10074-crackle-top-molasses-cookies-VAT-step-02-1whiskinframe-96c03e4b877a4d25af8e577a62b71fdf.jpg"
      ],
      "image": "assets/images/10074/step_02.webp"
    },
    {
      "text": "Stir in molasses, 2 cups flour, baking soda, cinnamon, ginger, and cloves. Add more flour to make a firm dough if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gWNNGatkSntSq2vnoKacaetLUHQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-10074-crackle-top-molasses-cookies-VAT-step-03-2spatulainframe-5b743dbacfd342fc8d58a7dee81854a0.jpg"
      ],
      "image": "assets/images/10074/step_03.webp"
    },
    {
      "text": "Shape dough into 1 1/4-inch balls. Roll in 1/3 cup sugar. Place 3 inches apart on an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sInQJxc39Q_DQRuPLV4B9TuJLVg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-10074-crackle-top-molasses-cookies-VAT-step-04-725c0c3bb77a487893c09bbfbf0071c4.jpg"
      ],
      "image": "assets/images/10074/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until tops crack, 12 to 14 minutes. Remove cookies from the baking sheet and cool on a rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/byeko2j3uic6zrGelAKOP-MwrGM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-10074-crackle-top-molasses-cookies-VAT-step-05-2ontray-6229814f9abd417b8f64c258437ff5f8.jpg"
      ],
