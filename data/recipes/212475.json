  "ingredients": [
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "0.5 cup orange juice",
    "0.5 cup water",
    "0.25 teaspoon ground cinnamon",
    "1 (12 ounce) package fresh or frozen cranberries"
  ],
  "steps": [
    {
      "text": "Place the sugars, orange juice, water, and cinnamon in a heavy saucepan, and stir to dissolve the sugar. Add the cranberries and bring the mixture to a boil. Cook over medium heat until the berries pop, about 10 minutes. Mash the mixture with a spoon to pop any unpopped berries and help thicken the sauce, if desired, and reduce heat to low and simmer until the sauce is the desired thickness, up to 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat, pour the sauce into a bowl, and chill until serving time. Sauce will thicken as it cools.",
