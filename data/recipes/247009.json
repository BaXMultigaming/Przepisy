  "ingredients": [
    "0.5 cup cooked RiceSelect® Texmati® Brown Rice",
    "0.66666668653488 cup skim milk",
    "2 tablespoons unsweetened applesauce",
    "1 egg, slightly beaten",
    "0.5 tablespoon coconut oil, melted",
    "1 teaspoon vanilla",
    "0.5 cup rice flour",
    "2 tablespoons coconut flour",
    "1 tablespoon stevia powder or sweetener of choice",
    "2 tablespoons powdered milk",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1 teaspoon cinnamon",
    "0.5 cup butter, softened",
    "0.25 cup dark brown sugar",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Combine cooked rice, milk, applesauce, egg, coconut oil, and vanilla in a medium-sized bowl. Whisk until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining pancake ingredients and stir into the brown rice mixture until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large nonstick skillet (sprayed with vegetable spray) over medium heat. Pour batter into skillet, about 1/4 cup per pancake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flip after 2-3 minutes or when edges start to turn golden and bubbles begin to appear on surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook another 1-2 minutes on second side until golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top pancakes with butter mixture and cooked apples, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
