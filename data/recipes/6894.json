  "ingredients": [
    "2 eggs",
    "1 cup white sugar",
    "0.5 cup butter, melted",
    "1 cup mashed bananas",
    "0.5 teaspoon almond extract",
    "1.5 cups all-purpose flour",
    "0.5 cup flaked coconut",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup chopped walnuts",
    "0.5 cup maraschino cherries, chopped"
  ],
  "steps": [
    {
      "text": "Mix together flour, coconut, baking powder, baking soda, salt, chopped walnuts, and cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break eggs in a mixing bowl, and beat until light and frothy. Add sugar and melted butter or margarine. Beat well. Stir in mashed banana and flavoring. Add flour mixture, and stir just to combine. Spoon into greased 9x5x3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour, or until a toothpick inserted in center comes out clean. Let stand for 10 minutes, and remove from pan. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
