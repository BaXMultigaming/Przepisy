  "ingredients": [
    "2 (8 ounce) packages Neufchatel cheese, softened",
    "0.5 cup white sugar",
    "1.5 tablespoons all-purpose flour",
    "2 large eggs",
    "0.5 cup plain Greek yogurt",
    "1.5 large lemons, juiced",
    "1 large lime, juiced",
    "1 (9 inch) prepared graham cracker crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat Neufchatel cheese and sugar in a large bowl with an electric mixer until smooth. Beat in flour. Mix on medium speed until combined. Add eggs and mix well. Add Greek yogurt and beat on medium speed; add lemon and lime juices and mix well until combined. Pour into the graham cracker crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is set, 50 to 60 minutes. Allow to cool completely, about 30 minutes. Refrigerate before serving, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
