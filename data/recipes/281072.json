  "title": "Lemon-Lime Cheesecake with Neufchatel Cheese",
  "description": "Full of sweet and sour citrus flavor, this lemon-lime cheesecake is made with Neufchatel cheese and baked in a graham cracker crust.",
  "authors": [
    "Karla"
  ],
