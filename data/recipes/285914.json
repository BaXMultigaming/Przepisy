  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 teaspoon cumin seeds",
    "2 teaspoons hot chili powder, or to taste",
    "0.5 teaspoon ground turmeric",
    "1 teaspoon garam masala",
    "1.5 cups shredded cabbage",
    "1 medium potato, peeled and sliced",
    "salt to taste",
    "1 teaspoon minced fresh cilantro, or more to taste"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a skillet over medium heat. Add cumin seeds, chili, turmeric, and garam masala and toast until fragrant, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cabbage and potato and cook, stirring frequently, until cabbage starts to wilt, about 5 minutes. Season with salt and continue cooking until potato is soft, 5 to 10 more minutes. Serve hot garnished with cilantro.",
      "section": null,
      "name": null,
      "url": null,
