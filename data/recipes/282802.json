  "ingredients": [
    "1 tablespoon capers",
    "0.5 cup mayonnaise",
    "1 tablespoon chopped fresh dill",
    "1 tablespoon chopped dill pickle",
    "1 tablespoon lemon juice",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Rinse capers in a strainer, pressing them lightly to squeeze out the brine. Mince capers and place into a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add mayonnaise, dill, dill pickle, lemon juice, salt, and pepper to capers in the bowl; mix until well combined. Let sit for 30 minutes to allow flavors to meld before serving.",
      "section": null,
