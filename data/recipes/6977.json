  "ingredients": [
    "0.5 pound finely chopped pork",
    "1 teaspoon salt",
    "1 small onion, chopped",
    "1.5 cups cornmeal",
    "0.5 cup all-purpose flour",
    "3 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "2 eggs, beaten",
    "2 tablespoons honey",
    "0.5 cup buttermilk",
    "1 cup orange juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degree C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 10 inch oven-proof skillet, fry the pork till crisp. Add onion, and cook till just tender. Drain off liquid fat, and reserve 2 tablespoons.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, combine corn meal, flour, baking powder, soda, and salt. Combine eggs, honey, buttermilk, and juice: mix into cornmeal mixture. Stir in pork and onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return reserved fat to skillet, and heat till very hot. Pour batter into skillet. Transfer to oven, and bake for 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
