  "title": "Applesauce Raisin Muffins",
  "description": "Coconut butter adds vegan goodness to these quick and easy applesauce muffins packed with raisins and walnuts.",
  "authors": [
    "Lina"
  ],
  "date_published": "2020-06-19T00:36:34-04:00",
