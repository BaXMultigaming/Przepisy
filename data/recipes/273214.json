  "ingredients": [
    "2 cups all-purpose flour",
    "0.75 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "0.5 cup coconut butter",
    "1 extra large egg",
    "1.5 cups unsweetened applesauce",
    "1 teaspoon vanilla extract",
    "1 cup raisins",
    "0.5 cup crushed walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, baking powder, cinnamon, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt coconut butter in a small bowl. Beat egg into the butter and pour into the flour mixture. Mix in applesauce and vanilla extract. Fold in raisins and walnuts and mix into a doughy batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop batter into the muffin liners using an ice cream scoop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 18 to 20 minutes. Let muffins cool for about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
