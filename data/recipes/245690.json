  "ingredients": [
    "0.75 cup white sugar",
    "0.5 cup butter",
    "0.25 cup unsweetened cocoa powder",
    "0.25 cup corn syrup",
    "1 teaspoon vanilla extract",
    "8 cups popped popcorn"
  ],
  "steps": [
    {
      "text": "Preheat oven to 250 degrees F (120 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring sugar, butter, cocoa powder, and corn syrup to a gentle boil in a saucepan; cook until thickened, 1 to 2 minutes. Stir in vanilla extract. Pour popcorn into a large bowl, add cocoa mixture and stir until popcorn is well coated. Spread evenly in prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring occasionally, until mixture is set, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven and cool to room temperature; break into clumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
