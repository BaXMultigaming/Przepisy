  "title": "Pignoli (Pine Nut) Cookies",
  "description": "Also called pine nut cookies. I make them and my family eats them so quickly I have to hide a few so I get some.",
  "authors": [
    "Maryellen"
  ],
  "date_published": "1997-12-30T13:54:40-05:00",
