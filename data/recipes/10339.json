  "ingredients": [
    "0.5 pound almond paste",
    "1 cup white sugar",
    "2 egg whites",
    "0.25 cup pine nuts"
  ],
  "steps": [
    {
      "text": "Use a pastry chopper (or food processor) to break up the almond paste into a granulated form. Put in mixing bowl and gradually add the sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another small bowl, beat the egg whites until stiff. Fold the egg whites into the sugar/almond paste mixture gently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a greased and floured cookie sheet, drop a spoonful of the mixture. Press pine nuts into the top of the cookie (you want to cover the top with nuts).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (170 degrees C) for 10-12 minutes. Cool on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
