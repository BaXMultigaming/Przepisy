  "ingredients": [
    "1 (16 ounce) package bulk hot pork sausage (such as Jimmy Dean®)",
    "1 (8 ounce) package cream cheese, softened",
    "1 (10 ounce) can diced tomatoes with green chile peppers (such as RO*TEL®)",
    "1 cup chopped fresh chives",
    "0.25 cup chopped onion"
  ],
  "steps": [
    {
      "text": "Stir sausage and onions together in a large skillet over medium-high heat until browned and crumbly, about 8 minutes. Drain the grease off the sausage in a mesh strainer, then return to the skillet.",
      "section": null,
      "name": null,
      "url": null,
