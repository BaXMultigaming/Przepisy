  "ingredients": [
    "1 cup soy sauce",
    "1 cup brown sugar",
    "1 cup water",
    "1 onion, chopped",
    "4 cloves garlic, minced",
    "1 tablespoon grated fresh ginger root",
    "1 tablespoon ground black pepper",
    "1 tablespoon dried oregano",
    "1 teaspoon crushed red pepper flakes",
    "1 teaspoon ground cayenne pepper",
    "1 teaspoon ground paprika",
    "5 pounds skinless chicken thighs"
  ],
  "steps": [
    {
      "text": "Whisk soy sauce, brown sugar, water, onion, garlic, ginger, black pepper, oregano, red pepper flakes, cayenne pepper, and paprika together in a large glass or ceramic bowl. Add chicken thighs and toss to coat evenly. Cover the bowl with plastic wrap; marinate chicken in the refrigerator for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill to medium heat. Lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken thighs from marinade; discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill chicken thighs on the preheated grill until no longer pink in the center and the juices run clear, about 15 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
