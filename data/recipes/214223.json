  "ingredients": [
    "1.75 cups brown sugar",
    "0.66666668653488 cup butter",
    "0.25 cup molasses",
    "2 teaspoons ground ginger",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "1 cup all-purpose flour",
    "1 cup whole wheat flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash the brown sugar, butter, and molasses together in a bowl with a spoon until the mixture is creamy and thoroughly combined. Mix in the ginger, eggs, and vanilla extract. In a separate bowl, combine the all-purpose flour, whole wheat flour, baking powder, baking soda, and salt. Stir 1/4 of flour mixture into the butter mixture at a time, incorporating each addition before adding the next. Pour the batter into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes. Let cool before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
