  "title": "Chocolate Chip Pumpkin Spice Cookies",
  "description": "Pumpkin puree, spice cake mix, chocolate chips, and a few additional spices turn into a quick and easy egg-free treat.",
  "authors": [
    "Lynne Vangheluwe Frantz"
  ],
  "date_published": "2020-06-18T23:55:19-04:00",
