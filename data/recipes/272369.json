  "ingredients": [
    "10 skinless chicken thighs",
    "0.5 cup liquid honey",
    "0.25 cup prepared mustard",
    "1 teaspoon curry powder",
    "0.25 teaspoon salt",
    "0.5 teaspoon dried tarragon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flatten chicken thighs and squeeze tightly into a square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine honey, mustard, curry powder, and salt in a bowl. Spoon over chicken. Sprinkle tarragon on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, uncovered, basting occasionally with the honey-mustard sauce, until chicken is no longer pink in the center and juices run clear, about 50 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
