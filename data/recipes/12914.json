  "title": "Provincial Beef Stew",
  "description": "A hearty stew with plenty of vegetables and a subtle orange twist. Great on a cold winter day.",
  "authors": [
    "Thalie Klein"
  ],
  "date_published": "1999-01-21T13:28:04-05:00",
