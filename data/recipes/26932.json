  "ingredients": [
    "6 costeno amarillo chile peppers",
    "0.5 pound tomatillos, husked",
    "1 clove garlic",
    "0.5 cup chopped onion",
    "0.33333334326744 cup chopped fresh cilantro",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "In a medium iron skillet over medium high heat, cook the costeno amarillo chile peppers, stirring constantly, until dark brown. Do not allow peppers to burn. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tomatillos in a medium saucepan with enough water to cover. Bring to a boil. Cook 5 minutes, remove from heat and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chile peppers, tomatillos and garlic in a blender or food processor. Blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chile pepper mixture to a medium bowl. Mix in onion, cilantro and salt. Chill in the refrigerator until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
