  "ingredients": [
    "0.33333334326744 cup vegetable oil for frying",
    "1.5 cups cornmeal",
    "0.5 cup all-purpose flour",
    "1 tablespoon seasoned salt",
    "1 tablespoon kosher salt",
    "0.5 tablespoon lemon pepper",
    "0.5 teaspoon ground white pepper",
    "3 large eggs",
    "6 salmon fillets"
  ],
  "steps": [
    {
      "text": "Heat oil in a cast iron skillet to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together cornmeal, flour, seasoned salt, kosher salt, lemon pepper, and white pepper in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a separate bowl for 10 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working one at a time, dip salmon into beaten eggs to coat completely. Dredge salmon in cornmeal mixture to cover completely. Shake off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, fry salmon in hot oil, flipping halfway, until a golden brown crust forms, 8 to 10 minutes. Transfer to a paper towel-lined plate to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
