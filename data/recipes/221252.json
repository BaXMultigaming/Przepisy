  "ingredients": [
    "0.5 large eggplant, sliced into rounds",
    "0.125 teaspoon salt",
    "4 skinless, boneless chicken breast halves , cut into cubes",
    "2 cloves garlic, minced",
    "2 tablespoons soy sauce",
    "1 tablespoon canola oil",
    "2 cups mushrooms, sliced",
    "0.125 teaspoon ground black pepper",
    "4 cups spinach"
  ],
  "steps": [
    {
      "text": "Sprinkle salt evenly over both sides of eggplant slices; set aside for 5 minutes. Cut eggplant into cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir chicken, garlic, and soy sauce together in a large skillet over medium heat until the chicken is nearly cooked through, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mushrooms and black pepper into the chicken mixture; continue cooking until the mushrooms brown, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat canola oil in a separate skillet over medium heat. Cook eggplant in hot canola oil until lightly browned; add to skillet with the chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir spinach through the chicken and eggplant mixture; cook and stir until the spinach wilts, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
