  "ingredients": [
    "2 tablespoons all-purpose flour, or more as needed",
    "6 pork chops",
    "salt and pepper to taste",
    "2 tablespoons olive oil",
    "1 cup uncooked long grain white rice",
    "1 cup beef consomme",
    "0.5 cup water",
    "1 medium onion, thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour into a shallow dish. Season pork chops on both sides with salt and pepper, then press into flour to lightly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Add pork chops and brown, about 3 minutes per side. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix rice, consommé, and water together in a large baking dish. Arrange onion slices over rice and place pork chops over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until rice is tender and pork is slightly pink in the center, about 1 1/2 hours. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
