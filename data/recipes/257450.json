  "ingredients": [
    "4 cups vegetable oil for frying",
    "2 cups buttermilk",
    "2 cups all-purpose flour",
    "0.5 tablespoon salt",
    "0.5 tablespoon ground black pepper",
    "12 large fresh scallops"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer or large saucepan to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour buttermilk into a bowl. Combine flour, salt, and pepper in a second bowl. Dip 4 or 5 scallops in buttermilk, then roll in flour mixture until thickly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook coated scallops in hot oil until golden and crispy, 3 to 4 minutes. Drain on a paper towel-lined plate. Repeat coating and frying remaining scallops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
