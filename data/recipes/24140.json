  "ingredients": [
    "1.5 cups chopped cooked ham",
    "1 (10 ounce) package frozen cut asparagus, thawed",
    "0.5 cup chopped onion",
    "0.25 cup chopped red bell peppers",
    "8 eggs",
    "2 cups milk",
    "1 cup all-purpose flour",
    "0.25 cup grated Parmesan cheese",
    "0.75 teaspoon dried tarragon",
    "0.75 teaspoon salt",
    "0.5 teaspoon black pepper",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ham, asparagus, onion, and bell pepper in the prepared baking dish. Beat eggs, milk, flour, Parmesan, tarragon, salt, and pepper together in a large bowl; pour over ham mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 20 minutes. Sprinkle top with Cheddar cheese; continue baking until cheese melted, 3 to 5 minutes. Let stand 5 to 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
