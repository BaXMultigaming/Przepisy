  "ingredients": [
    "cooking spray",
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "1 large egg",
    "1 teaspoon baking soda",
    "1 teaspoon vanilla extract",
    "1 (16 ounce) can fruit cocktail, undrained",
    "0.5 cup packed brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9-inch square baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, white sugar, egg, baking soda, and vanilla together in a bowl. Stir in undrained fruit cocktail and mix until well blended. Pour into the prepared pan and sprinkle brown sugar over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean and the top is golden brown, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
