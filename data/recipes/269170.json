  "ingredients": [
    "2 cups water",
    "0.75 cup agave nectar",
    "0.25 cup white sugar",
    "1 cup fresh orange juice",
    "2 ripe quinces",
    "0.5 cinnamon stick",
    "2 cups fresh cranberries",
    "1 tablespoon grated orange zest"
  ],
  "steps": [
    {
      "text": "Combine water, agave nectar, white sugar, and orange juice in a saucepan over medium-high heat and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, wash and peel the quince fruits and cut out any dark spots. Add whole quinces to the boiling liquid and reduce heat. Simmer for 10 minutes. Turn quince over 180 degrees and simmer an additional 10 minutes. Add cranberries and simmer until quince are tender to a knife, 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve quince cored or whole with the cranberries and syrup ladled over them. Top with orange zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
