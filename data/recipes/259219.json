  "ingredients": [
    "2 eggs, or as needed",
    "1.5 tablespoons milk",
    "salt and ground pepper to taste",
    "cooking spray",
    "0.25 cup cooked sausage, crumbled",
    "3 slices cooked bacon, cut into pieces",
    "0.5 cup diced tomatoes, or to taste",
    "0.5 cup diced mushrooms, or to taste",
    "1 prepared flatbread",
    "0.25 cup shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and milk together in a bowl; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a large skillet with cooking spray; heat over medium-high heat. Pour egg mixture into the skillet; cook and stir until eggs are set, about 5 minutes. Add sausage, bacon, tomatoes, and mushrooms, and cook until vegetables are soft, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread scrambled mixture over flatbread; top with shredded Monterey Jack cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake flatbread pizza in the preheated oven until the cheese is bubbly and underside of the crust is golden brown, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
