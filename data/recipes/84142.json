  "ingredients": [
    "1 tablespoon salt",
    "2 cups cold water",
    "1 pound shrimp, peeled and deveined",
    "0.33333331346512 cup chicken broth",
    "2 teaspoons rice wine",
    "1.5 teaspoons soy sauce",
    "1.5 teaspoons cornstarch",
    "0.75 teaspoon sugar",
    "0.125 teaspoon ground white pepper",
    "1 tablespoon vegetable oil",
    "2 tablespoons minced garlic",
    "1 teaspoon minced fresh ginger root",
    "2 teaspoons vegetable oil",
    "6 ounces snow peas, strings removed",
    "2 tablespoons chopped fresh chives",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "In a large bowl, stir salt into water until dissolved. Add shrimp, and set aside 5 minutes. Rinse shrimps, and dry on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix together broth, rice wine, soy sauce, cornstarch, sugar, and pepper. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 tablespoon oil in a large skillet or wok over high heat. Cook shrimp, turning constantly, until pink on all sides, about 1 minute. Stir in garlic, ginger, and 2 teaspoons oil. Stir in snow peas, chives, and 1/4 teaspoon salt; stir-fry 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir broth mixture into skillet, and continue cooking until sauce thickens. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
