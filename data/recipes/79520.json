  "ingredients": [
    "2 (14.5 ounce) cans Italian-style diced tomatoes, undrained",
    "1 (26 ounce) can tomato soup",
    "1 cup milk",
    "0.5 cup water",
    "4 ounces crumbled Gorgonzola cheese",
    "2 tablespoons minced garlic",
    "1 tablespoon dried basil",
    "1 teaspoon onion powder"
  ],
  "steps": [
    {
      "text": "Combine diced tomatoes, tomato soup, milk, and water in a large saucepan over medium heat; stir in Gorgonzola cheese, garlic, basil, and onion powder. Reduce heat to low; simmer 15 to 20 minutes, stirring often.",
