  "ingredients": [
    "1 cube chicken bouillon",
    "0.5 cup hot water",
    "0.5 (16 ounce) package farfalle (bow tie) pasta",
    "3 tablespoons olive oil",
    "2 cloves garlic, minced",
    "1 (8 ounce) package sliced baby bella mushrooms",
    "0.25 teaspoon kosher salt",
    "0.25 cup white wine",
    "0.125 teaspoon ground white pepper",
    "1 pinch crushed red pepper",
    "0.25 cup grated Asiago cheese"
  ],
  "steps": [
    {
      "text": "Dissolve bouillon cube in hot water. Set chicken broth aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook bow tie pasta at a boil, stirring occasionally, until tender yet firm to the bite. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, add olive oil to a medium skillet over medium heat. Add garlic; cook until fragrant, about 1 minute. Add mushrooms and salt; cook until mushrooms begin to release liquid, about 3 minutes. Add wine, increase heat to medium-high, and cook until slightly reduced, 1 to 2 minutes. Add reserved chicken broth, white pepper, and pepper flakes; cook until liquid is reduced by about half, 8 to 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss mushroom mixture with cooked pasta. Top servings with Asiago cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
