  "ingredients": [
    "2 cups water",
    "1 cup dry lentils, rinsed",
    "1 tablespoon ground cumin",
    "1 tablespoon garlic powder",
    "1 teaspoon salt",
    "0.75 cup white rice, rinsed",
    "2 tablespoons olive oil",
    "0.25 cup vegetable oil",
    "3 white onions, sliced into 1/4-inch rings"
  ],
  "steps": [
    {
      "text": "Combine 2 cups water, lentils, cumin, garlic powder, and 1 teaspoon salt in a pot over medium heat; bring to a simmer. Reduce heat to low; cook until lentils begin to soften, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rice, remaining 3/4 cup water, remaining 1 teaspoon salt, and olive oil into lentils. Cover pot; continue cooking until lentils and rice tender, about 40 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a skillet over medium heat. Add onions; cook and stir until browned, 7 to 10 minutes. Top rice and lentil mixture with onions; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
