  "ingredients": [
    "1 (16 ounce) package elbow macaroni",
    "2 ripe avocados, peeled and pitted",
    "1 cup shredded smoked Cheddar cheese",
    "1 teaspoon cracked black pepper",
    "0.5 cup crumbled cooked bacon",
    "0.5 cup crumbled bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil; add macaroni and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain and transfer to an 8x15-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix avocados, Cheddar cheese, and black pepper together in a bowl until smooth; stir into pasta. Top pasta with bacon and bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until sauce is bubbling, 20 to 25 minutes.",
      "section": null,
      "name": null,
