  "ingredients": [
    "cooking spray",
    "2 large eggs",
    "2 tablespoons milk",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "3 slices whole wheat bread",
    "0.5 cup mixed frozen berries",
    "0.25 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a small baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, milk, vanilla, and cinnamon together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut bread slices into squares and place in the prepared baking dish. Pour egg mixture over top, making sure all bread is soaked. Sprinkle berries and coconut on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until egg mixture is set, 15 to 30 minutes; check often to make sure coconut doesn't burn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
