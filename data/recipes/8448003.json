  "ingredients": [
    "1.5 pounds small red potatoes, quartered",
    "1 pound Brussels sprouts, trimmed and halved lengthwise",
    "2 teaspoons lemon-pepper seasoning",
    "1 teaspoon seasoned salt",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a large baking sheet with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine potatoes and Brussels sprouts in a large bowl. Sprinkle lemon pepper and seasoned salt over the top and toss to coat. Drizzle olive oil over the top and toss until evenly combined. Spread out onto the prepared baking sheet in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven for 15 minutes. Using a spatula, flip vegetables over and continue cooking until desired browning is achieved, about 15 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
