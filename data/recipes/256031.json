  "ingredients": [
    "0.5 cup butter",
    "2 cups fresh blackberries, or more to taste",
    "2 cups white sugar, divided",
    "0.75 cup milk",
    "0.75 cup all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Place butter in a (9x13-inch) baking dish; put dish in the preheating oven until butter is melted, 2 to 5 minutes. Remove dish from the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir blackberries and 1 cup sugar together in a bowl; set aside until mixture becomes juicy, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1 cup sugar, milk, flour, baking powder, and salt in a large bowl until batter is smooth; pour over melted butter. Do not stir. Spoon blackberry mixture over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling and cooked through, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
