  "ingredients": [
    "2 pounds ground turkey",
    "1 (28 ounce) can crushed tomatoes",
    "1 (15 ounce) can tomato sauce",
    "1 (15.5 ounce) can kidney beans, rinsed and drained",
    "1 (15.5 ounce) can pinto beans, rinsed and drained",
    "1 (15.5 ounce) can black beans, rinsed and drained",
    "0.5 cup chopped onion",
    "1 clove garlic, minced",
    "0.25 cup red wine",
    "2 tablespoons chili powder",
    "2 bay leaves",
    "1 teaspoon ground cumin",
    "1 teaspoon dried parsley",
    "1 teaspoon dried oregano",
    "0.5 teaspoon black pepper",
    "0.25 teaspoon crushed red pepper flakes"
  ],
  "steps": [
    {
      "text": "Add ground turkey to a large pot over medium heat; cook and stir until crumbly and no longer pink, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in crushed tomatoes, tomato sauce, kidney beans, pinto beans, black beans, onion, garlic, and red wine; season with chili powder, bay leaves, cumin, parsley, oregano, black pepper, and red pepper flakes. Increase heat to medium-high; bring to a simmer, then reduce heat to medium-low, cover, and simmer 2 hours, stirring occasionally. Discard bay leaves before serving.",
