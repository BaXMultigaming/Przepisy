  "ingredients": [
    "2.5 cups sifted cake flour",
    "2.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 cup butter",
    "1 tablespoon lemon zest",
    "1.75 cups white sugar",
    "6 egg yolks",
    "1.125 cups milk"
  ],
  "steps": [
    {
      "text": "Line two 9 inch round pans with parchment paper. Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Measure sifted flour, baking powder, and salt; sift together three times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter or margarine and lemon rind together. Gradually add sugar, creaming until light and fluffy. Add egg yolks one at a time, beating thoroughly after each addition. Add sifted ingredients alternately with milk to the creamed mixture, a small amount at a time; beat after each addition until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 to 30 minutes. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
