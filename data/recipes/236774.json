  "ingredients": [
    "0.75 cup all-purpose flour",
    "2 teaspoons salt",
    "2 teaspoons dry mustard",
    "1 teaspoon black pepper",
    "2 pounds cube steak",
    "0.25 cup vegetable oil",
    "1 onion, sliced thin",
    "2 cloves garlic, minced",
    "3 cups beef broth",
    "2 tablespoons tomato paste",
    "2 (14.5 ounce) cans diced tomatoes",
    "2 tablespoons Worcestershire sauce",
    "2 teaspoons ground paprika",
    "2 teaspoons ground thyme",
    "2 teaspoons dried oregano"
  ],
  "steps": [
    {
      "text": "Mix together flour, salt, mustard, and pepper in a wide, shallow bowl. Add cube steaks to flour mixture; toss to coat completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rf-JH4lGbT6UU1ECgo9xyzw1oEA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236774_SlowCookerSwissSteakandOnion_ddmfs_Shot2_3x4_4236-2bac4cbac90b483f974cebe2944a77c6.jpg"
      ],
      "image": "assets/images/236774/step_01.webp"
    },
    {
      "text": "Heat oil in a skillet over medium-high heat. Fry steaks in hot oil until golden brown, 2 to 3 minutes per side; transfer to a slow cooker, reserving drippings in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zXxXu-cK-NPO81-2qf6N-vRQLfw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236774_SlowCookerSwissSteakandOnion_ddmfs_Shot3_3x4_4240-ecf5150bb74d4b66b252a7d60905de58.jpg"
      ],
      "image": "assets/images/236774/step_02.webp"
    },
    {
      "text": "Sauté onion and garlic in drippings in the skillet over medium heat until softened, 2 to 3 minutes; add to the slow cooker. Discard oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bYhqbeQot0KdQmcfrzmszqSjOZs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236774_SlowCookerSwissSteakandOnion_ddmfs_Shot4_3x4_4243-2e515a25f7574863b1c8cc136066ee98.jpg"
      ],
      "image": "assets/images/236774/step_03.webp"
    },
    {
      "text": "Stir together broth and tomato paste in a large bowl until paste is dissolved; add tomatoes, Worcestershire sauce, paprika, thyme, and oregano. Pour broth mixture over steaks in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lpnSDiP5OIgDCEFECHJKdAPddQo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236774_SlowCookerSwissSteakandOnion_ddmfs_Shot6_3x4_4281-f70bdc8c71f24165a72dd6ffddc462d3.jpg"
      ],
      "image": "assets/images/236774/step_04.webp"
    },
    {
      "text": "Cook on Low until meat is tender and falling apart, 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eQTWCWRTK34eNrJnXJIM8lkVB8I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236774_SlowCookerSwissSteakandOnion_ddmfs_3x4_4272-5997a3d7f549483d9eb373d847827311.jpg"
