  "ingredients": [
    "3 tablespoons butter",
    "0.25 cup chopped onion",
    "0.25 cup chopped green onion",
    "6 cups chicken broth",
    "1.5 pounds zucchini, cut into 1-inch pieces",
    "1.5 tablespoons red wine vinegar",
    "1 teaspoon dried dill weed",
    "0.25 cup dry farina cereal (such as Cream of Wheat®)",
    "salt and ground black pepper to taste",
    "1 (4 ounce) package cream cheese, softened"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium heat. Cook and stir onion and green onion in hot butter until softened, about 5 minutes. Add chicken broth, zucchini, vinegar, and dill to the saucepan; bring to a boil. Gradually pour farina into the broth mixture while stirring. Reduce heat to low, loosely cover saucepan, and cook broth mixture at a simmer until the zucchini is tender, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend soup with an immersion blender until smooth. Add cream cheese and blend again until the cheese is fully incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
