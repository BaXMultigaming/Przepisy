  "title": "Gourmet Patty Melts",
  "description": "Lean ground sirloin burgers, sauteed onions, and Cheddar cheese come together for a heavenly patty melt experience.",
  "authors": [
    "Suzanne"
  ],
  "date_published": "2020-05-08T04:46:26-04:00",
  "date_modified": "2025-02-28T19:52:12-05:00",
