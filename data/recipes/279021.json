  "keywords": [],
  "ingredients": [
    "1 pound ground sirloin",
    "1 tablespoon Worcestershire sauce",
    "2 cloves garlic, minced, or more to taste",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "3 tablespoons unsalted butter",
    "3 tablespoons olive oil",
    "2 medium onions, sliced",
    "cooking spray",
    "4 slices Cheddar cheese",
    "4 teaspoons Dijon mustard",
    "8 slices rye bread, lightly toasted"
  ],
  "steps": [
    {
      "text": "Mix sirloin, Worcestershire sauce, garlic, salt, and pepper together by hand in a medium bowl. Form into 4 hamburger patties and wrap in plastic wrap. Place in the refrigerator until flavors have melded, 4 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter and olive oil in a large skillet over medium heat until melted. Add onions and saute until they begin to caramelize, about 15 minutes, reducing heat to medium-low if they seem to be sizzling too much.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a large skillet with cooking spray and heat over medium heat. Place hamburger patties in the skillet and cook for 3 minutes per side, topping each patty with a slice of Cheddar cheese after flipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place patties on toasted rye bread. Top with warm onions, Dijon mustard, and remaining bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
