  "ingredients": [
    "2 tablespoons butter",
    "2 tablespoons olive oil",
    "1 large onion, chopped",
    "1 red bell pepper, seeded and chopped",
    "1 yellow bell pepper, seeded and chopped",
    "1 green bell pepper, seeded and chopped",
    "2 cups cubed cooked chicken breast meat",
    "3 cloves garlic, minced",
    "1 teaspoon sugar",
    "0.25 cup pure maple syrup",
    "1 cup heavy cream",
    "2.5 tablespoons hot curry paste"
  ],
  "steps": [
    {
      "text": "Heat butter and oil in a large skillet over medium heat. Add onion and bell peppers; cook until onion is soft and translucent. Mix in cooked chicken and garlic, then sprinkle with sugar. Cook and stir for about 3 minutes, then stir in maple syrup and cook until caramelized, about 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in heavy cream and curry paste; reduce heat to low and simmer uncovered until sauce reaches desired thickness, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
