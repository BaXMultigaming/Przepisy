  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup cornmeal",
    "0.25 cup white sugar",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 egg, lightly beaten",
    "1 cup sour cream",
    "0.33333334326744 cup milk",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Lightly grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cornmeal, sugar, baking powder, baking soda, and salt in a large bowl. Mix egg, sour cream, milk, and butter in a small bowl. Fold egg mixture into flour mixture until just moistened; pour into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted near the center comes out clean, 20 to 25 minutes. Serve warm.",
      "section": null,
      "name": null,
