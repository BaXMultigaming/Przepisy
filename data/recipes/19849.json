  "title": "Baked Fruit Dumplings",
  "description": "Whole apples are stuffed with blueberries and drizzled with maple syrup before being wrapped in dough and baked in a sauce infused with orange.",
  "authors": [
    "Samantha Tessler"
  ],
  "date_published": "2000-07-15T22:53:54-04:00",
  "date_modified": "2022-07-14T17:32:20-04:00",
