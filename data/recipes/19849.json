  "keywords": [],
  "ingredients": [
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "2 tablespoons brown sugar",
    "0.5 cup butter, chilled and diced",
    "0.75 cup milk",
    "6 apples, peeled and cored",
    "1 cup blueberries",
    "0.25 cup maple syrup",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 teaspoon dried orange peel"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a 7x11 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix flour, baking powder, salt and brown sugar. Cut in butter. Pour in milk and stir to form a dough. Turn out onto a well-floured surface and roll out. Cut into 6 - 6 inch squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a whole apple in the center of each square. Fill the core with blueberries. Drizzle with maple syrup. Pull up corners of dough and pinch edges together to seal. Place dumplings in prepared pan and sprinkle with cinnamon and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining maple syrup with enough water to pour over dumplings to a 1 inch depth in dish. Submerge remaining blueberries and apple peelings with dried orange peel in liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 45 minutes, basting as necessary, until crisp and browned. Serve warm with sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
