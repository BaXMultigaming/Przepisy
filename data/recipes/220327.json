  "ingredients": [
    "1 tablespoon whipped butter",
    "1 tablespoon all-purpose flour",
    "1 pinch garlic salt",
    "1 pinch kosher salt",
    "0.25 cup low-fat milk",
    "1 (10 ounce) package frozen chopped spinach, thawed and squeezed dry"
  ],
  "steps": [
    {
      "text": "Melt whipped butter in a small saucepan over medium heat; stir flour, garlic salt, and kosher salt into melted butter until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk in low-fat milk, bring to a simmer, and reduce heat to low. Simmer sauce until thickened, whisking constantly, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir spinach into sauce and heat until warmed through, 1 to 2 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
