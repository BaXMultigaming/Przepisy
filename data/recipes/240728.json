  "ingredients": [
    "5 cups milk, divided",
    "0.5 cup white sugar",
    "1 (3.4 ounce) package instant vanilla pudding mix",
    "1.5 teaspoons rum-flavored extract",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Blend 2 cups milk, sugar, pudding mix, rum-flavored extract, nutmeg, allspice, and ginger in a blender on medium-high speed until smooth; pour into a pitcher. Stir remaining 3 cups milk into mixture. Refrigerate eggnog until thickened, at least 1 hour. Stir well before serving.",
