  "ingredients": [
    "2 Italian sausages, removed from casings and crumbled",
    "1 tablespoon olive oil",
    "1 medium onion, chopped",
    "4 cloves garlic, minced",
    "3 tomatoes, diced",
    "1 cup chopped fresh spinach",
    "2 cremini mushrooms, chopped",
    "1.5 teaspoons dried basil",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.75 cup heavy cream",
    "0.75 cup milk",
    "0.5 cup finely shredded Italian cheese blend",
    "2 tablespoons all-purpose flour",
    "2 (9 ounce) packages tri-colored cheese-filled tortellini"
  ],
  "steps": [
    {
      "text": "Heat a nonstick skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large pot over medium-high heat. Add onion and garlic; saute until the onion is translucent, about 5 minutes. Reduce heat; add tomatoes, spinach, mushrooms, basil, salt, and pepper. Bring to a simmer, stirring as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream, milk, cheese, and flour in a bowl. Add to the tomato mixture and return to a simmer. Stir occasionally until reduced, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the sauce is reducing, bring a large pot of water to a boil. Add tortellini and boil gently until tender, about 6 minutes. Drain the tortellini. Mix with the tomato sauce and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
