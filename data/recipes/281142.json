  "ingredients": [
    "2 (6 ounce) chicken breasts",
    "2 teaspoons olive oil",
    "2 teaspoons Italian seasoning",
    "1 teaspoon garlic salt",
    "2 ounces fresh mozzarella cheese",
    "0.25 cup sliced pepperoni",
    "2 tablespoons minced onion",
    "2 tablespoons pizza sauce"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 380 degrees F (190 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay a chicken breast flat onto your work surface; cut in half, lengthwise, leaving the breast attached on one side so it opens like a book. Repeat with remaining chicken breast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub outsides of chicken breasts with oil; sprinkle with Italian seasoning and garlic salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Open each breast like a book; divide and stuff with mozzarella cheese, pepperoni, onion, and pizza sauce. Close each breast to enclose filling. Carefully transfer to the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry until chicken is no longer pink in the center and the juices run clear according to manufacturer's directions, about 18 minutes. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
