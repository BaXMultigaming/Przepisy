  "ingredients": [
    "0.25 cup grated Romano cheese",
    "1 tablespoon sesame seed",
    "1 teaspoon paprika",
    "1 teaspoon poppy seed",
    "1 teaspoon celery seed",
    "1.5 teaspoons salt",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon ground black pepper",
    "1 dash cayenne pepper"
  ],
  "steps": [
    {
      "text": "Stir Romano cheese, sesame seed, paprika, poppy seed, celery seed, salt, garlic powder, black pepper, and cayenne pepper together in a small bowl until evenly mixed. Store refrigerated in an airtight container.",
