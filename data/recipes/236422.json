  "ingredients": [
    "2 cups chopped celery",
    "1 cup BBQ sauce",
    "1 cup ketchup",
    "1 medium onion, chopped",
    "0.5 cup water",
    "1 teaspoon garlic powder",
    "1 teaspoon chili powder",
    "salt and ground black pepper to taste",
    "1 (4 pound) pork shoulder roast"
  ],
  "steps": [
    {
      "text": "Stir celery, BBQ sauce, ketchup, onion, water, garlic powder, chili powder, salt, and pepper together in a slow cooker. Place roast into the mixture. Cover and cook on Low for 7 hours or High for 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer roast to a cutting board; shred meat with two forks. Return meat to the slow cooker, stir to combine with liquid, and cook for 1 more hour.",
      "section": null,
      "name": null,
      "url": null,
