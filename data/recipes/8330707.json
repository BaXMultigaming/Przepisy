  "ingredients": [
    "nonstick cooking spray",
    "2 tablespoons butter, softened, or more to taste",
    "1.5 tablespoons molasses",
    "1 (2.5 pound) salmon fillet",
    "1 tablespoon Greek seasoning (such as Cavender's®)",
    "1 medium lemon, juiced, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a rimmed baking sheet with foil and spray with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter and molasses together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay salmon, skin-side down, on the prepared baking sheet. Spread butter mixture evenly over the salmon. Sprinkle with Greek seasoning and drizzle with ½ of the lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until salmon flakes easily with a fork, 17 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with remaining lemon juice and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
