  "ingredients": [
    "1 pound lean pork sausage",
    "2 potatoes, peeled and diced",
    "1.5 cups chopped celery",
    "0.75 cup diced sweet onion",
    "0.75 cup butter",
    "9 cups soft bread cubes",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon ground sage",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sausage, potatoes, celery, onion and butter in a large, deep skillet. Saute over medium high heat until sausage is crumbled and evenly cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the bread cubes, thyme, sage, salt and pepper. Toss together with the sausage and potato mixture. Add chicken or vegetable broth if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake stuffing in a covered casserole dish for 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
