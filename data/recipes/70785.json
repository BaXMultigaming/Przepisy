  "ingredients": [
    "2.5 pounds red potatoes, cubed",
    "1 cup sour cream",
    "1 cup shredded Cheddar cheese",
    "0.5 bunch green onions, chopped",
    "0.5 cup mayonnaise",
    "0.25 cup white sugar",
    "1 tablespoon real bacon bits"
