  "ingredients": [
    "6 plantains, peeled and broken into chunks",
    "1 (16 ounce) can refried black beans",
    "1 tablespoon white sugar",
    "1 teaspoon salt",
    "1 quart oil for frying"
  ],
  "steps": [
    {
      "text": "Place plantains in a large pot; cover with water. Bring to a boil, then reduce heat and simmer until tender, about 15 minutes. Drain and mash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat refried beans in a small saucepan over low heat. Stir in sugar and salt. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form a palm-sized amount of mashed plantains into a ball; flatten and place about a teaspoon of bean mixture in the middle; then mold the sides of plantain around beans, making an egg-shaped ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep fryer or large skillet to 375 degrees F (190 degrees C), or until a small amount of batter sizzles and browns in oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry rellenitos in hot oil until browned. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
