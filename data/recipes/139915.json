  "ingredients": [
    "4 cups all-purpose flour",
    "2 tablespoons lemon pepper",
    "1.5 tablespoons salt",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon cayenne pepper",
    "1 teaspoon onion powder",
    "0.25 cup grated lemon zest, divided",
    "4 (6 ounce) fillets rainbow trout",
    "1 lemon",
    "0.5 cup lemon juice",
    "0.5 cup extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "In a large bowl, stir together the flour, lemon pepper, salt, thyme, cayenne and half of the lemon zest. Combine the lemon juice and remaining lemon zest in a shallow dish and soak fish fillets for about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Dip the trout fillets in the flour mixture so that both sides are coated. Shake off the excess and place fillets in the hot oil. Cook for 3 to 4 minutes on each side, until golden brown and fish can be flaked with a fork. Discard the leftover lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the skillet and drain on paper towels briefly before serving. Garnish each serving with a wedge of lemon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
