  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "0.5 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.75 cup unsalted butter",
    "0.5 cup peanut butter",
    "1 cup white sugar",
    "2 eggs",
    "1 cup semisweet chocolate chips",
    "1 cup peanut butter chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl whisk together flour, cocoa powder, baking soda, and baking powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl with an electric mixer cream butter, peanut butter, and sugar until light and fluffy. Beat in eggs, 1 at a time, beating well after each addition. Beat in flour mixture and stir in chocolate chips and peanut butter chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by level tablespoonfuls 2 inches apart onto buttered baking sheets and bake cookies in batches in the middle of oven 20 minutes. Cool cookies on racks. Cookies keep in airtight containers for about 5 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
