  "ingredients": [
    "6 medium ripe pears",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup sour cream",
    "0.5 cup powdered sugar, or to taste",
    "3 tablespoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Slice pears in half and remove seeds with a melon baller. Cut into 1/8-inch slices (if pears are firm) or 1/4-inch slices (if pears are softer).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, sour cream, powdered sugar, and cinnamon in a stand mixer; beat until smooth and creamy. Serve alongside pear slices.",
