  "ingredients": [
    "cooking spray",
    "1 teaspoon minced garlic",
    "3 cups water",
    "1 (1 ounce) package dry onion soup mix",
    "1 teaspoon beef base (such as Better Than Bouillon®)",
    "0.25 cup milk",
    "3 tablespoons all-purpose flour",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Spray a saucepan with cooking spray. Add garlic and cook over medium heat just until fragrant, about 1 minute. Add water, onion soup mix, and beef base; bring to a boil. Cover the pan and simmer until onions are tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk and flour in a jar with a lid; shake until combined and whisk into the saucepan. Bring gravy back to a boil and cook until thickened, about 10 minutes. Season with black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
