  "title": "Sandy's Frito Pie",
  "description": "A thick layer of beef, beans, salsa, and cheese are piled over crushed corn chips in this savory, family-pleasing casserole.",
  "authors": [
    "SBrazingto"
  ],
  "date_published": "2020-02-26T00:51:26-05:00",
