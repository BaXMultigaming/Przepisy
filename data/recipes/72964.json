  "ingredients": [
    "0.375 cup milk",
    "2 tablespoons white vinegar",
    "0.5 cup white sugar",
    "2 tablespoons shortening",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "2 cups sifted all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 quart oil for deep frying",
    "0.5 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/75FYAD4ew_FT3q1bwD8dQ-xha1U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72964-Easy-Homemade-Doughnuts-DDMFS-4x3-step-01-1ad2290e8feb49bdbc4c3ebd25ff5751.jpg"
      ],
      "image": "assets/images/72964/step_01.webp"
    },
    {
      "text": "Stir together milk and vinegar; let stand for a few minutes until thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/603-EyjUnidQGVuFYS-aXXVzdio=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72964-Easy-Homemade-Doughnuts-DDMFS-4x3-step-02-04df7c5c504d4400a4fded3ae810599c.jpg"
      ],
      "image": "assets/images/72964/step_02.webp"
    },
    {
      "text": "Cream together sugar and shortening in a mixing bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O7K-omzMijev94Le_WwCh_fXl-A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72964-Easy-Homemade-Doughnuts-DDMFS-4x3-step-03-1365a6682010418bbcc3fe407f571162.jpg"
      ],
      "image": "assets/images/72964/step_03.webp"
    },
    {
      "text": "Beat in egg and vanilla until well-blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QUVeZ6kHAIkl7kc58WxGWuRS-k0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72964-Easy-Homemade-Doughnuts-DDMFS-4x3-step-04-4a73147977164fc08c3ecd6e88f0d3fe.jpg"
      ],
      "image": "assets/images/72964/step_04.webp"
    },
    {
      "text": "Sift together flour, baking soda, and salt in a separate bowl; stir into sugar mixture alternating with milk mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/98Xw-ypYIvmYvBEmM1lGvE7lD1E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72964-Easy-Homemade-Doughnuts-DDMFS-4x3-step-05-94dc10c7e1bc4ec781178e5e1fe2d7ee.jpg"
      ],
      "image": "assets/images/72964/step_05.webp"
    },
    {
      "text": "Roll dough out on a floured surface to 1/3-inch thickness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3QOOO8zTOS2iPyw3KilArPMQqcQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72964-Easy-Homemade-Doughnuts-DDMFS-4x3-step-06-b039957672214669b1291fe4e85674e2.jpg"
      ],
      "image": "assets/images/72964/step_06.webp"
    },
    {
      "text": "Cut into donuts using a donut cutter. Let stand for about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GyiiViZn5nB2m7Jc3X-gNjFEgKo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72964-Easy-Homemade-Doughnuts-DDMFS-4x3-step-07-bab88207c3134e9b8b62c1371b0e5318.jpg"
      ],
      "image": "assets/images/72964/step_07.webp"
    },
    {
      "text": "Heat oil in a large, deep skillet to 375 degrees F (190 degrees C). Fry donuts in hot oil in batches until golden, turning over once, about 1 to 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TWEDEVJtQTC78fAc4YXuI4BE3VM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72964-Easy-Homemade-Doughnuts-DDMFS-4x3-step-08-26441d693863444787c6f6103b0755a6.jpg"
      ],
      "image": "assets/images/72964/step_08.webp"
    },
    {
      "text": "Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Lpdzo0PZjeJhhudhGiir-Gmj2nI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-72964-Easy-Homemade-Doughnuts-DDMFS-4x3-step-09-b0ca09a9e79d409eb048d6a656cb3c61.jpg"
      ],
      "image": "assets/images/72964/step_09.webp"
    },
    {
      "text": "Dust with confectioners' sugar while they are still warm and serve.",
