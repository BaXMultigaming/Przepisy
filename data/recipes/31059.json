  "steps": [
    {
      "text": "Heat oil in a large skillet or wok over medium-high heat. Fry ginger in hot oil until fragrant, then add pork, soy sauce, dark soy sauce, salt, and sugar. Cook, stirring occasionally, for 10 minutes.",
      "section": null,
      "name": null,
