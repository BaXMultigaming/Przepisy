      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9aZnb0m-8N37BQuJ8L1vzuRAECc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-50896-Creamy-Crab-and-Pasta-Salad-gw-ddmfs-4x3-step-05-862450fbee834df4b4c191c9156f3e01.jpg"
      ],
      "image": "assets/images/50896/step_04.webp"
    },
    {
      "text": "Toss until well combined, then cover and chill for 1 to 2 hours before serving.",
