  "ingredients": [
    "0.75 cup milk",
    "0.75 cup water",
    "1 tablespoon grated fresh ginger",
    "1 teaspoon honey, or more to taste",
    "1 teaspoon ghee (clarified butter)",
    "0.5 teaspoon ground turmeric",
    "0.5 teaspoon ground cinnamon",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
