  "ingredients": [
    "0.75 cup panko bread crumbs",
    "0.25 cup chopped fresh parsley",
    "0.75 tablespoon salt",
    "1 large egg, lightly beaten",
    "1 tablespoon milk",
    "4 (4 ounce) tilapia fillets, halved",
    "2 tablespoons canola oil"
  ],
  "steps": [
    {
      "text": "Combine panko, parsley, and salt on a dinner plate. Mix egg and milk together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip fillets into the milk mixture and shake off excess. Lightly dredge in panko mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large, nonstick skillet over medium heat. Add fillets and cook until golden brown on 1 side, about 4 minutes. Turn and cook until fillets are no longer translucent in the center and they easily flake with a fork, about 5 minutes more. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
