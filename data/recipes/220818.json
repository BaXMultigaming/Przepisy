  "ingredients": [
    "1 refrigerated crust for a 9-inch pie",
    "0.5 (8 ounce) package cream cheese",
    "2.5 cups fresh blueberries",
    "1 cup cold water",
    "3 tablespoons cornstarch",
    "1 cup white sugar",
    "1 pinch lemon zest"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press pie crust dough into a 9-inch pie plate; poke small holes into dough with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light brown, about 15 minutes. Cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cream cheese in a small microwave-safe bowl. Microwave on high to soften, about 20 seconds. Spread cream cheese into bottom of crust; layer 2 ½ cups blueberries on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk water and cornstarch in a small bowl until cornstarch is dissolved; stir into remaining 2 ½ cups blueberries, sugar, and lemon zest in a medium saucepan. Cook over medium heat until thick, 5 to 10 minutes. Spread blueberry mixture into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool pie in the refrigerator until set, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
