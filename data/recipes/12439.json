  "ingredients": [
    "1.5 cups graham cracker crumbs",
    "0.25 cup white sugar",
    "0.33333298563957 cup butter, melted",
    "1 (8 ounce) package cream cheese",
    "0.33333298563957 cup peanut butter",
    "2 (8 ounce) containers frozen whipped topping, thawed",
    "1 cup confectioners' sugar",
    "1 (3.4 ounce) package instant vanilla pudding mix",
    "1 (3.9 ounce) package instant chocolate pudding mix",
    "3 cups milk",
    "0.25 cup chopped peanuts",
    "0.125 cup grated semisweet chocolate"
  ],
  "steps": [
    {
      "text": "Combine graham cracker crumbs, sugar, and melted butter or margarine. Press firmly into the bottom of a 13x9-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese and peanut butter together until smooth. Stir in 2 cups of whipped topping and confectioners' sugar. Pour mixture over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pudding mixes and milk together and pour over peanut butter layer. Spread remaining whipped topping on top. Sprinkle with chopped peanuts and shaved chocolate. Chill for at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
