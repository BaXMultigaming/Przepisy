  "ingredients": [
    "cooking spray",
    "5 eggs",
    "1 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 cup self-rising flour",
    "1 (14 ounce) can sweetened condensed milk",
    "1 (12 fluid ounce) can evaporated milk",
    "1 cup milk",
    "1 tablespoon vanilla extract",
    "3 egg whites"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour an 8x12-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate 5 eggs. Beat egg whites in a large bowl. Add 1 cup sugar slowly to egg whites, beating constantly. Add yolks one at a time, beating well after each addition. Stir in 1 teaspoon vanilla. Sift flour over egg mixture and stir until well combined. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutess. Allow to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend together sweetened condensed milk, evaporated milk, milk, and 1 tablespoon vanilla. Pour over cooled cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 3 egg whites in a clean mixing bowl to soft peaks. Gradually add remaining 1 cup sugar and continue beating until stiff meringue forms. Stir in remaining 1 teaspoon vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread meringue frosting over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
