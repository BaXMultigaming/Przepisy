  "title": "Tres Leches Cake (Three Milks Cake)",
  "description": "This tres leches cake recipe is made with 3 types of milk and frosted with a fluffy vanilla meringue for a moist and delicious dessert served chilled.",
  "authors": [
    "Blanca"
  ],
  "date_published": "1998-04-13T17:00:32-04:00",
