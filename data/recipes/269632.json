  "ingredients": [
    "1 tablespoon olive oil",
    "1 pound cubed lamb stew meat",
    "1 large onion, sliced into petals",
    "1 pound red potatoes, cut into large cubes",
    "2 large carrots, sliced",
    "2 stalks celery, sliced",
    "4 fresh button mushrooms, sliced",
    "2 cups beef broth",
    "1 (6 ounce) can tomato paste",
    "0.5 cup beer",
    "3 tablespoons Worcestershire sauce",
    "1 large sprig fresh rosemary",
    "salt and pepper to taste",
    "1.5 cups frozen peas"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add lamb and onions; cook and stir until lamb is browned and onions are starting to soften, about 5 minutes. Transfer lamb mixture to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add potatoes, carrots, celery, and mushrooms. Stir in beef broth, tomato paste, beer, Worcestershire sauce, rosemary, salt, and pepper; cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 7 hours. Add peas and cook for an additional 15 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
