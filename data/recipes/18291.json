  "ingredients": [
    "2 pounds fresh green beans, washed and trimmed",
    "2 onions, chopped",
    "1 (14.5 ounce) can diced tomatoes with juice",
    "2 hot yellow banana peppers, diced",
    "1 green bell pepper, chopped",
    "0.5 cup water",
    "6 slices bacon"
  ],
  "steps": [
    {
      "text": "Place green beans, onions, tomatoes, banana peppers, bell pepper, and water in a large pot. Bring to a boil over high heat, then reduce heat to low. Cover pot and simmer approximately 10 minutes, until green beans are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While green beans are steaming, arrange bacon slices in a medium skillet. Fry over medium heat until crispy, approximately 10 minutes. Drain on paper towels. Crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon green bean mixture and juice into a serving dish. Sprinkle crumbled bacon over top and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
