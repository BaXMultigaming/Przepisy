  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup quick cooking oats",
    "0.25 cup brown sugar",
    "2 teaspoons baking powder",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.5 teaspoon salt",
    "1 cup milk",
    "1 egg, beaten",
    "0.75 cup canned pumpkin",
    "2 tablespoons vegetable oil",
    "0.75 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Stir together flour, oats, brown sugar, baking powder, cinnamon, cloves, and salt in a large bowl. In a separate large bowl, lightly beat together the milk, egg, pumpkin, and oil. Stir flour mixture into the pumpkin mixture, blending just until moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly greased griddle over medium high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter, 1/3 cup at a time, onto the prepared griddle. Make a jack-o-lantern face in each pancake with the chocolate chips. Cook until bubbles appear on the surface, then flip and cook until golden brown on the other side, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
