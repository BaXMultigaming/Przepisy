  "ingredients": [
    "2 racks baby back ribs, trimmed",
    "1 tablespoon fennel seeds",
    "1 tablespoon ground black pepper",
    "1 tablespoon white sugar",
    "1 tablespoon garlic salt",
    "1 tablespoon kosher salt",
    "½ teaspoon cayenne pepper",
    "⅓ cup brown sugar",
    "⅓ cup orange juice",
    "⅓ cup rice wine vinegar",
    "1 tablespoon orange zest",
    "2 teaspoons hot chile paste, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine fennel seeds, black pepper, sugar, garlic salt, kosher salt, and cayenne pepper in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place rib racks on the prepared baking sheet; cut several shallow slits in membranes along backs of ribs with a sharp paring knife. Rub spice rub on both sides of rib racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 1/2 hours. Flip and bake until a fork easily inserts between bones, 1 to 1 1/2 hours more. Cool completely, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring brown sugar, orange juice, vinegar, orange zest, and hot chili paste to a boil in a saucepan over medium heat. Reduce heat; simmer until reduced by half, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut rib racks into individual ribs; toss with glaze in a large bowl until evenly coated. Place ribs on the prepared baking sheet. Reserve any additional glaze in the bowl for basting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 minutes. Flip, brush with remaining glaze, and bake until browned, 5 to 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
