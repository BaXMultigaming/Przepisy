  "ingredients": [
    "0.75 pound sliced bacon",
    "1 (9 inch) single refrigerated pie crust",
    "6 large eggs, beaten",
    "1.5 cups heavy cream",
    "5 dashes hot pepper sauce, or to taste",
    "2 dashes Worcestershire sauce",
    "salt and ground black pepper to taste",
    "1 (10 ounce) package frozen chopped spinach - thawed, drained and squeezed dry",
    "1.5 cups shredded Cheddar cheese",
    "0.5 cup chopped green onion",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet, and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on a paper towel-lined plate. Chop when cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_rmMKICwcH_KFvKZzk6Zan-0Zg0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216724-spinach-and-bacon-quiche-PICS-step-02-10850580d1484e81b517c0c6eaf06a34.jpg"
      ],
      "image": "assets/images/216724/step_02.webp"
    },
    {
      "text": "Fit pie crust into a 9-inch pie dish and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kDI9VNaDyGR6SynIIdg_3eQFbDo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216724-spinach-and-bacon-quiche-PICS-step-03-6d2ce2cdb81644f8a5d0c73c13c8f338.jpg"
      ],
      "image": "assets/images/216724/step_03.webp"
    },
    {
      "text": "Whisk eggs, cream, hot pepper sauce, Worcestershire sauce, salt, and pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Sa_MbuzntvuAEdTofbKZldCpkOI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216724-spinach-and-bacon-quiche-PICS-step-04-17fd09c42bca432f841ae2d143b45274.jpg"
      ],
      "image": "assets/images/216724/step_04.webp"
    },
    {
      "text": "Spread spinach over the bottom of pie crust. Top with bacon, Cheddar cheese, and green onion; pour in egg mixture and sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1JVccnYgztPYlDXBZM8hUvcVt8U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216724-spinach-and-bacon-quiche-PICS-step-05-0f6430136f0b43158f7601be237547d7.jpg"
      ],
      "image": "assets/images/216724/step_05.webp"
    },
    {
      "text": "Bake quiche in the preheated oven until the top is lightly puffed and browned, and a knife inserted into the center of the quiche comes out clean, 35 to 45 minutes.",
      "section": null,
      "name": null,
