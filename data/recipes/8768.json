  "ingredients": [
    "6 pounds chicken wings, separated at joints, tips discarded",
    "1.5 cups Louisiana-style hot sauce",
    "1 cup honey",
    "0.75 cup butter",
    "1 teaspoon cayenne pepper, or to taste",
    "1 pinch garlic salt",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat. Lightly oil the grill grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AyGfkh7YldhRBLRLctfUYZsZDgM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8768-ddmfs-sweet-spicy-wings-step1-0025-dd9d4cd8f76a443b8cf6f26491708f70.jpg"
      ],
      "image": "assets/images/8768/step_01.webp"
    },
    {
      "text": "Grill chicken on the preheated grill until the juices run clear, 8 to 12 minutes per side. Remove chicken to a large roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uyQr3A5-MfDbwwsLs-ptD9E6yXo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8768-ddmfs-sweet-spicy-wings-step2-0059-0d2537e329e84856a3663879bc482a97.jpg"
      ],
      "image": "assets/images/8768/step_02.webp"
    },
    {
      "text": "Mix together hot sauce, honey, butter, cayenne pepper, garlic salt, and black pepper in a saucepan over medium heat. Simmer until blended and heated through, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z07ECv9MD7xuaKquhCi6g5PUtH8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8768-ddmfs-sweet-spicy-wings-step2-0062-0982047561e2427c8545d80dcbf74a7f.jpg"
      ],
      "image": "assets/images/8768/step_03.webp"
    },
    {
      "text": "Pour hot sauce over chicken and stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/L7CHj-1TbNqunD99GbpVCpWH8cw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8768-ddmfs-sweet-spicy-wings-step2-0064-431def37afa1402ca3bfc58431497b8c.jpg"
