  "ingredients": [
    "6 cups all-purpose flour",
    "2 teaspoons baking soda",
    "2 teaspoons salt",
    "15 ounces vegan margarine (such as Earth Balance®)",
    "2 cups white sugar",
    "2 cups brown sugar",
    "2 medium ripe bananas, mashed",
    "3 teaspoons vanilla extract",
    "3 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat vegan margarine, white sugar, and brown sugar together in a separate bowl. Mix in mashed bananas and vanilla. Add flour mixture and chocolate chips slowly while mixing together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 20 minutes.",
      "section": null,
