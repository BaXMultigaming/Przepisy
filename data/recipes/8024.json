  "ingredients": [
    "1 cup all-purpose flour",
    "0.33333334326744 cup white sugar",
    "1 teaspoon baking powder",
    "0.5 cup raisins",
    "0.5 cup milk",
    "1 cup packed brown sugar",
    "2 cups boiling water",
    "1 tablespoon butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, white sugar, and baking powder together in a large bowl. Add raisins and stir in milk. Spoon batter into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, boiling water, butter, and vanilla. Gently pour over batter. Do not stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
