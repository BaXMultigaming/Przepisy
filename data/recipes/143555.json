  "ingredients": [
    "0.33333334326744 cup rice vinegar",
    "0.25 cup orange juice",
    "0.25 cup vegetable oil",
    "1 (1 ounce) package dry onion soup mix",
    "2 teaspoons white sugar",
    "1 teaspoon toasted sesame oil",
    "1 teaspoon finely chopped, peeled fresh ginger",
    "1 clove garlic, pressed",
    "1 (8 ounce) package bow tie (farfalle) pasta",
    "2 cups diced cooked chicken",
    "1 (11 ounce) can mandarin orange segments, drained",
    "2 diced Roma tomatoes",
    "1 (6 ounce) bag fresh spinach",
    "1 carrot, shredded",
    "0.5 cucumber - scored, halved lengthwise, seeded, and sliced",
    "0.5 cup diced red bell pepper",
    "0.5 cup coarsely chopped red onion",
    "0.5 cup sliced almonds, toasted"
  ],
  "steps": [
    {
      "text": "Whisk vinegar, orange juice, vegetable oil, soup mix, sugar, sesame oil, ginger, and garlic together in a bowl until well blended; cover vinaigrette and refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook bow tie pasta at a boil, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes. Drain and rinse under cold water. Transfer to large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss chicken, mandarin oranges, tomatoes, spinach, carrot, cucumber, bell pepper, onion, and almonds with pasta. Add vinaigrette: toss to coat.",
      "section": null,
      "name": null,
