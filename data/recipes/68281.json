  "ingredients": [
    "1 (12 ounce) jar roasted red bell peppers",
    "1 (13.75 ounce) can low-sodium chicken broth",
    "1 teaspoon minced garlic",
    "0.75 teaspoon dried oregano",
    "0.125 teaspoon dried basil",
    "1 cup heavy cream",
    "0.5 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "In a food processor or blender, process undrained peppers with chicken broth, garlic, oregano, and basil until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer liquid to a saucepan, and heat over medium-low heat. Simmer for 5 minutes. Slowly whisk in cream, and heat through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve in soup bowls over crumbled feta cheese. Sprinkle additional feta cheese and oregano on top for garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
