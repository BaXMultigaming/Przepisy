  "ingredients": [
    "0.75 cup butter",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 teaspoon peppermint extract",
    "1.5 cups all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together butter, white sugar, and brown sugar until light and fluffy. Beat in egg, then stir in vanilla and peppermint extracts. Combine flour, cocoa powder, baking soda, and salt; gradually stir into the creamed mixture. Mix in the chocolate chips. Drop by rounded spoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in the preheated oven. Allow cookies to cool on cookie sheets for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
