  "ingredients": [
    "1 (14.5 ounce) can sauerkraut, liquid drained and reserved",
    "2 tablespoons brown mustard",
    "1 tablespoon brown sugar",
    "0.125 teaspoon ground celery seed",
    "0.125 teaspoon ground black pepper",
    "12 ounces fully-cooked cheddar bratwurst sausages, cut into 1/4-inch slices",
    "0.5 (16 ounce) package frozen shoestring french fries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread sauerkraut into bottom of a 9-inch square glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir reserved liquid from sauerkraut, brown mustard, brown sugar, celery seed, and black pepper together in a bowl; drizzle over sauerkraut. Arrange sausage slices in a layer over the sauerkraut and sauce. Loosely pile frozen french fries atop the sausage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the french fries are lightly browned, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
