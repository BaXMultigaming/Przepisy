  "title": "Strawberry Nut Bread",
  "description": "Fresh strawberries and nuts are doused with loads of cinnamon in this fruity quick bread.",
  "authors": [
    "JJOHN32"
  ],
  "date_published": "1998-08-10T13:52:53-04:00",
