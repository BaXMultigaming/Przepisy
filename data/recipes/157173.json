    {
      "text": "Prepare your child's lunch box by packing hot dog bun, ketchup, mustard, and Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dBph-BHIC5JuYPO4W0tXBDN54Jw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/157173-lunch-box-hot-hot-dogs-VAT-006-step-03-3aaa9f0c480e4a81920d4af4069c47b1.jpg"
