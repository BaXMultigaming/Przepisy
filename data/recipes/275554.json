  "ingredients": [
    "1 teaspoon bacon drippings",
    "2 corn tortillas",
    "2 slices Manchego cheese",
    "6 zucchini blossoms"
  ],
  "steps": [
    {
      "text": "Melt bacon grease in a cast-iron or regular skillet over medium heat. Place tortillas side-by-side in the skillet; top each with 1 slice cheese and 3 zucchini blossoms. Fold tortillas in half.",
      "section": null,
      "name": null,
      "url": null,
