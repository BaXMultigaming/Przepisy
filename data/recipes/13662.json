  "title": "The Greatest Grilled Turkey",
  "description": "This grilled turkey is tender and juicy with crispy skin. Learn how to grill a turkey with this easy recipe, and free up oven space at the same time.",
  "authors": [
    "Bob Cody"
  ],
  "date_published": "1998-11-17T22:22:12-05:00",
