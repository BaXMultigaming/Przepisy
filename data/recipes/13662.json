  "ingredients": [
    "1 (12 pound) whole turkey",
    "1 tablespoon vegetable oil",
    "1 teaspoon Italian seasoning, or more to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Prepare an outdoor grill for indirect medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T2lFeDYzIeBwiHnlrrDTwxYjSFA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13662-the-greatest-grilled-turkey-VAT-step-01-0f09d3a5541f484791037302bd03ec26.jpg"
      ],
      "image": "assets/images/13662/step_01.webp"
    },
    {
      "text": "Remove and discard giblets. Rinse turkey and pat dry. Turn wings back to hold neck skin in place. Return legs to a tucked position.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wNXreD_mY48MQudA9lurWdT-2nM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13662-the-greatest-grilled-turkey-VAT-step-02-5919a9abfb1844caa08824c0463a2410.jpg"
      ],
      "image": "assets/images/13662/step_02.webp"
    },
    {
      "text": "Brush turkey with oil. Season inside and out with Italian seasoning, salt, and pepper. Place turkey, breast-side up, on a metal grate inside a large roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MeuhFRsnOq9f-5fu9EMpHxrJzEY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13662-the-greatest-grilled-turkey-VAT-step-03-00e091797878491b83b155aac671eb65.jpg"
      ],
      "image": "assets/images/13662/step_03.webp"
    },
    {
      "text": "Place the roasting pan over indirect heat on the preheated grill. Grill until the internal thigh temperature is 180 degrees F (85 degrees C), 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S7Hp_e1kUu0SNz_rcv-cbQcG-Mo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13662-the-greatest-grilled-turkey-VAT-step-04-ff2fbcc1f0074eb09551cf970c76f891.jpg"
      ],
      "image": "assets/images/13662/step_04.webp"
    },
    {
      "text": "Remove from the grill and let turkey stand 15 minutes before carving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wq-gr9Oywa461iuy8Owy0tVou2Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13662-the-greatest-grilled-turkey-VAT-step-05-752f7e9b9c9a4ea0aac6d2448c0783fe.jpg"
      ],
      "image": "assets/images/13662/step_05.webp"
    }
  ],
