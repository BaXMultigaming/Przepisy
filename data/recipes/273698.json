  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "1.5 cups all-purpose flour",
    "1.75 teaspoons baking powder",
    "0.75 cup milk",
    "1 tablespoon lemon zest",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R3u34apOfD5uOPE9AJjh9G2E844=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273698-simple-lemon-cake-DDMFS-step-01-f1d91acb4170482bb9a63062847fbd70.jpg"
      ],
      "image": "assets/images/273698/step_01.webp"
    },
    {
      "text": "Beat sugar and butter together in a mixing bowl using an electric mixer until light and fluffy. Beat in eggs and vanilla extract until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/L4Q-1lJ3YROYfrXzJNLXjVRT97s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273698-simple-lemon-cake-DDMFS-step-02-e269dbb7dc774e25b621ab06716b5bb8.jpg"
      ],
      "image": "assets/images/273698/step_02.webp"
    },
    {
      "text": "Sift flour and baking powder together in a separate bowl; add to creamed mixture until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8nfKHIuovxP_2MjiPgwR4N5fvxg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273698-simple-lemon-cake-DDMFS-step-03-38aee52f6bdd4ee8a2282705b6ba8cc3.jpg"
      ],
      "image": "assets/images/273698/step_03.webp"
    },
    {
      "text": "Pour in milk, lemon zest, and lemon juice; mix until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BEFj2Zd58UB2cMCakftWrToIKNs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273698-simple-lemon-cake-DDMFS-step-04-40d37957b3624a5db80238a2f7464d47.jpg"
      ],
      "image": "assets/images/273698/step_04.webp"
    },
    {
      "text": "Spoon batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ii56t5UIFmXvnJU-fDnaDfJ7Rgg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273698-simple-lemon-cake-DDMFS-step-05-5e170b62055b4a37b7c4a4e48cdaa8f3.jpg"
      ],
      "image": "assets/images/273698/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QxhilKI3e71BYbqFt_dlj91BIzs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273698-simple-lemon-cake-DDMFS-step-06-15c3668e4d3f44009da07b24963aac4b.jpg"
      ],
      "image": "assets/images/273698/step_06.webp"
    },
    {
      "text": "Let cake cool before cutting into squares. Enjoy!",
      "section": null,
