  "ingredients": [
    "1 pound dry fettuccine pasta",
    "0.75 cup frozen green peas",
    "1 (14.5 ounce) can diced tomatoes",
    "1 cup low-fat sour cream",
    "0.75 cup grated Parmesan cheese",
    "salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes, adding peas just before pasta is done. Drain.",
      "section": null,
      "name": null,
      "url": null,
