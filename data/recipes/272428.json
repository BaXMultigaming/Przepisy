  "ingredients": [
    "1 tablespoon dark brown sugar",
    "1 tablespoon sweet paprika",
    "0.5 tablespoon kosher salt",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon poultry seasoning",
    "0.5 teaspoon mustard powder",
    "0.5 teaspoon freshly ground black pepper",
    "8 chicken wings, or more as needed"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk brown sugar, paprika, salt, garlic powder, onion powder, poultry seasoning, mustard powder, and pepper together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IHf3pkx_8ehdK6i4KHymM-SRHeg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272428-dry-rub-air-fried-chicken-wings-ddmfs-step1-127-4x3-46451386e0e24c7d9267f1ee89c292d8.jpg"
      ],
      "image": "assets/images/272428/step_02.webp"
    },
    {
      "text": "Toss in chicken wings and rub seasonings into chicken with your hands until fully coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D8knM6nQMMXxP5x0qiX3mL0FHoQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272428-dry-rub-air-fried-chicken-wings-ddmfs-step2-128-4x3-dc13a0ac0a9c4172b8cac671a6fd21a1.jpg"
      ],
      "image": "assets/images/272428/step_03.webp"
    },
    {
      "text": "Arrange wings in the air fryer basket, standing them up on their ends and leaning against each other and the wall of the basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Te6_4I7QLH2ypoyfYBmSpQ1GTwE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272428-dry-rub-air-fried-chicken-wings-ddmfs-step3-129-4x3-d25e7064c2cb4181825eaf579a41dbf1.jpg"
      ],
      "image": "assets/images/272428/step_04.webp"
    },
    {
      "text": "Cook in the preheated air fryer until wings are cooked through, tender inside and golden brown and crisp on the outside, about 30 to 35 minutes. Transfer wings to a plate and serve hot.",
      "section": null,
      "name": null,
      "url": null,
