  "ingredients": [
    "6 cups sliced pears",
    "0.5 cup butter, melted",
    "2 tablespoons maple syrup",
    "2 cups all-purpose flour, or more as needed",
    "1 cup brown sugar",
    "0.5 cup white sugar",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon vanilla extract",
    "0.5 cup butter, softened"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9bkSg2pnTe9gaE1CP17X93_r0UI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-234401-renees-pear-crisp-VAT-step-01-2d86422a731f4bbcabdae6ec9ae35339.jpg"
      ],
      "image": "assets/images/234401/step_01.webp"
    },
    {
      "text": "Spread pears to cover bottom of the baking dish; drizzle with melted butter and maple syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/orerHFYT8Y0m4QelE5pU3a-uGek=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-234401-renees-pear-crisp-VAT-step-02-6c7d2753ddb148e7a1003d5917849f0c.jpg"
      ],
      "image": "assets/images/234401/step_02.webp"
    },
    {
      "text": "Stir flour, brown sugar, white sugar, cinnamon, nutmeg, and vanilla extract together in a bowl. Cut softened butter into flour mixture until mixture resembles coarse crumbs, adding more flour if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qvFi5FwrP_RRg2uMb7XNXWRsdG0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-234401-renees-pear-crisp-VAT-step-03-7bee4b3484cc4ec18eb54b75ea403496.jpg"
      ],
      "image": "assets/images/234401/step_03.webp"
    },
    {
      "text": "Sprinkle topping over pears.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/knYfyaJdSuvSfqVtNo4oC9r5Y78=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-234401-renees-pear-crisp-VAT-step-04-d92a75c1d2f6492ab84cebde2419266c.jpg"
      ],
      "image": "assets/images/234401/step_04.webp"
    },
    {
      "text": "Bake in preheated oven until pears are bubbling and topping is crisp, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
