  "ingredients": [
    "cooking spray",
    "2 cups panko bread crumbs",
    "1 teaspoon garlic powder",
    "0.25 teaspoon chili powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 large egg",
    "2 skinless, boneless chicken breasts, cut into 1-inch strips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix panko, garlic powder, chili powder, salt, and pepper together well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a shallow bowl. Dip chicken tenders into the egg mixture, then dredge in the panko mixture. Arrange on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crispy on the outside and lightly browned, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
