  "ingredients": [
    "1 pint heavy whipping cream",
    "2 cups white sugar",
    "1 cup packed brown sugar",
    "1 cup butter",
    "1 cup corn syrup",
    "1 cup evaporated milk",
    "1.25 teaspoons vanilla extract"
  ],
  "steps": [
    {
