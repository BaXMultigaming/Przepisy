        "https://www.allrecipes.com/thmb/_l0moIh8YxPMieDJsj9iBGtPfsg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-17572-easy-chocolate-chip-pound-cake-ddmfs-step6-3x4-8b9f1b0c5ffe455bb72588459b39ff63.jpg"
