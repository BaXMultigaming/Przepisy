  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "0.5 cup white sugar",
    "1 (3.9 ounce) package instant chocolate pudding mix",
    "4 large eggs, beaten",
    "1 cup sour cream",
    "0.75 cup water",
    "0.75 cup vegetable oil",
    "0.5 cup milk chocolate chips",
    "0.125 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 10-inch Bundt pan.",
