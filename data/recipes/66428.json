  "ingredients": [
    "1 pound ground beef",
    "1 cup cornmeal",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 (14.5 ounce) can cream-style corn",
    "1 cup milk",
    "1 cup shredded Cheddar cheese",
    "1 onion, chopped",
    "2 jalapeno peppers, chopped",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9X12-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat. Add ground beef; cook and stir until no longer pink. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cornmeal, salt, and baking soda together in a large bowl. Stir in corn, milk, Cheddar cheese, onion, jalapeños, and egg. Stir in browned beef; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
