  "ingredients": [
    "6 skinless, boneless chicken breasts",
    "1.5 cups milk",
    "2 cups dried bread crumbs, seasoned",
    "6 slices Muenster cheese",
    "1 cup fresh sliced mushrooms",
    "0.5 cup chicken broth"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken in milk, then in breadcrumbs. Lightly brown coated chicken in a large skillet, then arrange chicken in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top each chicken with a slice of cheese. Top with mushrooms, then pour broth over and around chicken. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes; remove cover, baste with any remaining broth, and bake for another 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
