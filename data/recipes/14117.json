  "ingredients": [
    "5 large potatoes",
    "1 cup sour cream",
    "2 (8 ounce) packages cream cheese",
    "1 pinch garlic salt",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a large pot of salted boiling water, bring water back to a boil. Cook until potatoes are tender, approximately 15 to 20 minutes. Drain well. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When potatoes are cooled, cut them into small chunks. Using an electric blender, whip potatoes with sour cream, cream cheese and garlic salt. Place mixture in a 9x13 inch casserole dish. Sprinkle with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
