  "ingredients": [
    "2 pounds ground beef",
    "0.5 teaspoon coarsely ground black pepper",
    "0.5 teaspoon minced garlic",
    "0.5 teaspoon ground mustard seed",
    "2 tablespoons sugar-based curing mixture (such as Morton® Tender Quick®)"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix together the ground beef, black pepper, garlic, mustard seed and curing salt until well blended. Divide into 2 or 4 rolls, wrap in aluminum foil, and refrigerate for 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to a boil. Place the wrapped rolls in the water, and simmer for 1 hour over medium to low heat. Remove carefully, and poke holes in the foil to drain. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove foil, and rewrap with new aluminum foil. Refrigerate until fully chilled, about 3 hours. Slice, and use for sandwiches, crackers, salads or just snacking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
