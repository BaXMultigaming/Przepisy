  "ingredients": [
    "5 cups yams, peeled and cut into 1/2-inch pieces",
    "1.25 cups water",
    "1 cup brown sugar",
    "0.75 cup pineapple juice",
    "0.25 cup salted butter, cubed",
    "2 tablespoons vanilla extract",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "2 tablespoons cornstarch",
    "2 tablespoons water"
  ],
  "steps": [
    {
      "text": "Line a slow cooker with a slow cooker liner or grease with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place yams in the bottom of the slow cooker. Top with water, brown sugar, pineapple juice, butter, vanilla, cinnamon, and nutmeg. Stir to evenly distribute sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 2 hours. Stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cornstarch and water together in a small bowl to make a slurry. Add to slow cooker and stir to incorporate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until yams are fork-tender and sauce has thickened, about 1 hour more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
