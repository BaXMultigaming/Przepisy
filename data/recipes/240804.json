  "ingredients": [
    "3 tablespoons butter, divided",
    "1 small white onion, diced",
    "1 dill pickle, diced",
    "2 cups water",
    "0.5 cup dill pickle juice",
    "1 sprig fresh dill, roughly chopped",
    "0.75 cup half-and-half",
    "0.125 teaspoon celery salt",
    "1 tablespoon all-purpose flour"
  ],
  "steps": [
    {
      "text": "Heat 2 tablespoons butter in a pot over medium heat; cook and stir onion and dill pickle until onion is translucent and soft, 5 to 10 minutes. Add water and bring to a boil for about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pickle mixture to a blender; add dill pickle juice and dill. Blend mixture until smooth; add half-and-half and blend until smooth. Pour soup back into the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir celery salt into soup and bring to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 tablespoon butter and flour together in a skillet over medium heat; cook and stir until roux is smooth and lightly browned, about 5 minutes. Stir roux into soup until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
