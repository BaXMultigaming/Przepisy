  "ingredients": [
    "1 egg",
    "1 cup white sugar",
    "1 cup sour milk",
    "0.33329999446869 cup lard",
    "0.5 teaspoon baking soda",
    "1.5 cups all-purpose flour",
    "2 tablespoons unsweetened cocoa powder",
    "1 pinch salt",
    "0.5 teaspoon baking powder",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9 inch square cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg until light. Gradually add sugar, lard, milk and baking soda.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, cocoa, salt and baking powder. Add to batter and mix in. Add vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 30 minutes or until a toothpick inserted into cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
