  "ingredients": [
    "16 large shrimp, peeled and deveined",
    "1 tablespoon butter",
    "2 tablespoons minced garlic",
    "1 tablespoon minced shallot",
    "1 teaspoon olive oil",
    "0.25 cup chicken stock",
    "2 tablespoons freshly squeezed lemon juice",
    "0.25 teaspoon red pepper flakes",
    "0.125 teaspoon ground paprika",
    "salt and ground black pepper to taste",
    "0.25 cup crushed garlic croutons",
    "3 cups frozen riced cauliflower (such as Green Giant®)",
    "3 tablespoons chopped fresh parsley",
    "4 lemon wedges"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place shrimp in a shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small saucepan over medium heat. Add garlic, shallot, and olive oil and cook until fragrant, about 1 minute. Stir in chicken stock, lemon juice, red pepper flakes, paprika, salt, and pepper. Pour this mixture over shrimp and sprinkle with crushed croutons.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until shrimp are bright pink on the outside and the meat is opaque, 9 to 11 minutes; do not overcook.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While shrimp is cooking, place riced cauliflower in a large nonstick skillet. Cook over medium heat, stirring occasionally, until hot, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve shrimp over riced cauliflower. Garnish with chopped parsley and lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
