  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour, sifted",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "5 very ripe bananas, mashed",
    "0.75 cup brown sugar",
    "0.5 cup butter, softened",
    "2 eggs",
    "3 drops almond extract",
    "3 drops amaretto (almond-flavored liqueur)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, salt, and baking soda together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bananas, brown sugar, butter, eggs, almond extract, and amaretto in a separate bowl; stir in flour mixture just until incorporated, about 1 minute. Transfer to the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool before serving, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
