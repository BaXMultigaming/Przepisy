  "ingredients": [
    "3 cups fresh blueberries",
    "1 (9 inch) prepared graham cracker crust",
    "1 cup all-purpose flour, divided",
    "0.5 cup white sugar",
    "0.125 teaspoon salt",
    "0.66666668653488 cup sour cream",
    "2 eggs",
    "0.5 cup brown sugar",
    "0.5 cup cold butter, cut into cubes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread blueberries over bottom of crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ½ cup flour, white sugar, and salt in a bowl. Whisk sour cream and eggs together in a separate bowl; fold in flour mixture. Pour batter over blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining ½ cup flour and brown sugar in a bowl; cut in butter using a pastry cutter or 2 knives until mixture forms coarse crumbs. Scatter crumb topping over pie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until custard and topping are golden brown, 50 to 55 minutes. Transfer to a wire rack. Cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
