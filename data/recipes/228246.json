  "ingredients": [
    "2 (16 ounce) packages fudge stripe cookies",
    "0.25 cup honey, or as needed",
    "1 (9 ounce) bag milk chocolate candy kisses, unwrapped",
    "1 (4.5 ounce) tube decorating gel"
  ],
  "steps": [
    {
      "text": "Place a fudge stripe cookie with bottom side up onto a work surface. Smear a small dab (about 1/8 teaspoon) of honey onto the bottom of a chocolate kiss, and secure the candy piece to the center of the cookie, covering the hole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use decorating gel to pipe a small bow onto the cookie at the base of the candy piece. Repeat with remaining ingredients.",
