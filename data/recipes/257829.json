  "ingredients": [
    "0.25 cup milk, or more as needed",
    "1 egg",
    "2 tablespoons gluten-free all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "1 cup grapeseed oil",
    "12 white Cheddar cheese curds"
  ],
  "steps": [
    {
      "text": "Whisk milk, egg, flour, baking powder, basil, salt, and garlic powder together in a bowl until batter is the consistency of eggnog.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat grapeseed oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat cheese curds with batter; fry curds, 4 to 5 at a time, in hot oil until golden brown, about 1 minute. Drain on a plate lined with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
