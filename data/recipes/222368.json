  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup milk",
    "2 eggs",
    "3 tablespoons butter, melted",
    "1 tablespoon white sugar",
    "1 dash vanilla extract",
    "1 cup milk",
    "cooking spray (such as Pam®)"
  ],
  "steps": [
    {
      "text": "Mix flour, 1 cup milk, and eggs together in a large bowl. Stir butter, sugar, and vanilla extract into flour mixture until smooth. Add remaining 1 cup milk; mix until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a cast iron crepe pan over medium heat; spray surface with cooking spray. Pour a thin and even layer of batter onto the heated pan; fry for 30 to 60 seconds on each side. Repeat with remaining batter, spraying the pan between each batch.",
