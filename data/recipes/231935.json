  "ingredients": [
    "3 cups milk",
    "1.5 cups heavy whipping cream",
    "0.75 cup white sugar",
    "5 eggs",
    "1.5 teaspoons lemon zest",
    "1.5 teaspoons kosher salt",
    "0.25 teaspoon ground cinnamon",
    "0.75 vanilla bean, split and seeds scraped away",
    "1.5 French baguettes, cut into 2-inch slices",
    "0.5 cup golden raisins",
    "1 cup cranberries",
    "2 teaspoons butter"
  ],
  "steps": [
    {
      "text": "Whisk milk, cream, sugar, eggs, lemon zest, salt, cinnamon, and vanilla bean together in a bowl; fold in baguette slices, raisins, and cranberries. Set aside to soak for 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 12-inch deep-dish pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer bread mixture to prepared pie dish; remove and discard vanilla bean. Cover dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Remove foil and bake until pudding is set and lightly browned, about 15 more minutes.",
      "section": null,
      "name": null,
      "url": null,
