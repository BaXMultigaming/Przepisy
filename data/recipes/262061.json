  "ingredients": [
    "1 pound ground beef",
    "1.5 tablespoons cornstarch",
    "1.5 teaspoons salt",
    "1.5 teaspoons dried parsley",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1.75 cups milk",
    "1.25 cups beef stock",
    "1 (8 ounce) package egg noodles",
    "0.5 cup sour cream",
    "0.25 cup freshly grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornstarch, salt, parsley, garlic powder, and onion powder in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cornstarch mixture, milk, beef stock, and egg noodles into the skillet; bring to a boil. Cover, reduce heat, and simmer, stirring occasionally, until noodles are tender, about 5 minutes. Stir in sour cream and Parmesan cheese until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
