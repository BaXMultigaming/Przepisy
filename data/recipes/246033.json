  "ingredients": [
    "2 (15 ounce) cans tomato sauce",
    "2 tablespoons extra-virgin olive oil",
    "1 tablespoon white sugar",
    "1 tablespoon dried thyme",
    "2 teaspoons dried basil",
    "2 teaspoons dried oregano",
    "2 teaspoons dried minced shallots",
    "1 teaspoon garlic powder",
    "0.75 teaspoon salt",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Blend tomato sauce, olive oil, sugar, thyme, basil, oregano, shallots, garlic powder, salt, and baking soda together in a blender on high until sauce is smooth and well-mixed, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide sauce among twelve 1/2-cup freezer-safe containers; store in freezer until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove individual containers from freezer to thaw before using, about 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
