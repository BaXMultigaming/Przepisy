  "ingredients": [
    "2 (14.4 ounce) cans diced tomatoes",
    "1 jalapeno chile, seeds and ribs removed",
    "0.5 yellow onion, quartered",
    "0.5 bunch cilantro leaves",
    "1 tablespoon fresh lemon juice, or to taste",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Pour 1 can of tomatoes into a blender; add jalapeño pepper, onion, cilantro leaves, lemon juice, and salt. Blend until fairly smooth. Pour in second can of tomatoes and blend briefly. Adjust seasonings to taste by adding more lemon juice and salt. Let salsa rest for 1/2 hour before serving to allow flavors to blend.",
