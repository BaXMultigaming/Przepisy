  "ingredients": [
    "cooking spray",
    "8 canned whole green chiles, or more to taste",
    "7 eggs",
    "0.5 cup chopped onions",
    "3 tablespoons heavy cream",
    "0.75 teaspoon garlic salt",
    "0.5 teaspoon ground cumin",
    "0.25 teaspoon ground black pepper",
    "0.25 pound sharp Cheddar cheese, cubed",
    "2 tomatoes, sliced, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Spray a pie plate with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut chiles lengthwise into strips. Line strips over the bottom of pie plate to form a crust, placing pointed ends toward the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a bowl and mix in onions, cream, garlic salt, cumin, and pepper. Fold in Cheddar cheese. Layer tomatoes over the chile 'crust,' and pour egg mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until quiche is set, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
