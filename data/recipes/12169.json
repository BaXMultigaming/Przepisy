  "title": "English Walnut Pie",
  "description": "This walnut pie was a favorite at grandma's Woman's Club bake sales. It's a rich, sweet treat made with walnuts, sugar, corn syrup, butter, and eggs.",
  "authors": [
    "Vivian"
  ],
  "date_published": "1998-05-10T01:28:36-04:00",
