  "ingredients": [
    "3 large eggs",
    "0.75 cup white sugar",
    "0.75 cup light corn syrup",
    "2 teaspoons vanilla extract",
    "0.25 teaspoon salt",
    "0.25 cup unsalted butter, melted and cooled",
    "1 cup chopped walnuts",
    "1 (9 inch) deep-dish pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a large bowl. Mix in sugar, corn syrup, vanilla, and salt. Whisk in melted butter, then stir in walnuts. Pour filling into deep-dish pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Reduce the heat to 300 degrees F (150 degrees C) and continue baking until set in the center, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool completely on a wire rack before slicing; the pie will firm up as it cools.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
