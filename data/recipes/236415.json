  "ingredients": [
    "1 teaspoon butter, or as needed",
    "1 small sweet onion, diced",
    "3 stalks celery, diced",
    "0.5 large green bell pepper, diced",
    "0.5 large red bell pepper, diced",
    "0.25 cup butter",
    "0.25 cup all-purpose flour",
    "2 cups 2% milk",
    "2 pounds cooked and coarsely chopped lobster meat",
    "0.25 teaspoon salt, or to taste",
    "0.25 teaspoon ground black pepper, or to taste",
    "0.25 cup bread crumbs",
    "2 teaspoons sweet paprika",
    "1 tablespoon butter, cut into small pieces, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1 teaspoon butter in a large frying pan over medium heat. Add onion, celery, green pepper, and red pepper; cook and stir until onion has softened and turned translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1/4 cup butter in a large pot over medium-low heat; whisk in flour and cook for 1 minute. Add milk; cook until sauce is thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir vegetables and lobster into sauce; season with salt and pepper. Turn mixture into an 8x8-inch baking dish; sprinkle with bread crumbs, dot with butter pieces, and sprinkle with paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
