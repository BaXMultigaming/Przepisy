  "ingredients": [
    "1 cup corn syrup",
    "1 cup white sugar",
    "1 cup creamy peanut butter",
    "4.5 cups cornflakes cereal",
    "1 cup semi-sweet chocolate chips",
    "1 cup butterscotch chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
