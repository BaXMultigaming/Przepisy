  "ingredients": [
    "2 pounds uncooked medium shrimp, peeled and deveined",
    "1 pinch garlic salt, or to taste",
    "ground black pepper to taste",
    "0.25 teaspoon cayenne pepper, or to taste",
    "1 cup mayonnaise",
    "1 lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Preheat outdoor grill for medium heat, and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread shrimp onto skewers. Season both sides of shrimp with garlic salt and black pepper; if using cayenne, see Cook’s Note.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Generously coat both sides of shrimp with mayonnaise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook shrimp on heated grill until shrimp are bright pink on the outside and opaque on the inside, and the mayonnaise turns golden brown, 5 to 10 minutes on each side. Serve with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
