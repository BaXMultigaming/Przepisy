  "ingredients": [
    "1.5 pounds lean ground beef",
    "2 onions, chopped",
    "salt and pepper to taste",
    "5 tablespoons all-purpose flour",
    "2 (8 ounce) cans peeled and diced tomatoes with juice",
    "1 (5.5 ounce) can tomato juice",
    "2 cups hot water",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon granulated sugar"
  ],
  "steps": [
    {
      "text": "In a large skillet over medium heat, cook the ground beef and onions until beef is evenly browned; do not drain. Season with salt and pepper to taste. Stir in flour 1 tablespoon at a time, until beef juices have been absorbed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomatoes, tomato juice, and water. Simmer on low heat to thicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in nutmeg and sugar; simmer until flavors are blended well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
