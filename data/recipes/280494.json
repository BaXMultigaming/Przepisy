  "ingredients": [
    "2.25 cups fresh strawberries, cut into 1/4-inch pieces",
    "1 tablespoon white sugar",
    "2 teaspoons lemon juice",
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "6 tablespoons unsalted butter",
    "0.5 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine strawberries, 1 tablespoon sugar, and lemon juice in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, 1/2 cup sugar, baking powder, and salt together in a large bowl. Cut in butter with two knives or pastry blender until mixture resembles coarse crumbs. Stir in cream until dough starts to come together, then stir in strawberry mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoonfuls of dough 2 inches apart onto nonstick baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 23 to 25 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
