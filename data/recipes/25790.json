    "0.5 cup white sugar",
    "1 cup margarine, melted",
    "4 cups rolled oats",
    "2 cups semisweet chocolate chips",
    "0.75 cup peanut butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the brown sugar, white sugar, melted margarine and oats until well blended. Mix in the chocolate chips. Press the mixture into a 9x9 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in the preheated oven. Spread peanut butter over the top of the bars and let cool until set. Cut into squares and serve.",
