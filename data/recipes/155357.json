  "ingredients": [
    "0.25 cup coconut oil",
    "1 cup chopped onions",
    "1 clove garlic, minced",
    "3 cups vegetable broth",
    "1 teaspoon curry powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground coriander",
    "0.25 teaspoon crushed red pepper flakes",
    "1 (15 ounce) can 100% pure pumpkin",
    "1 cup light coconut milk"
  ],
  "steps": [
    {
      "text": "Melt coconut oil in a deep pot over medium-high heat. Add onions and garlic; cook and stir until onions are translucent, about 5 minutes. Stir in vegetable broth, curry powder, salt, coriander, and pepper flakes; cook and stir until mixture comes to a gentle boil, about 10 minutes. Cover the pot; boil for 15 to 20 minutes, stirring occasionally. Whisk in pumpkin and coconut milk until incorporated; cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill blender halfway with soup. Cover and hold lid down with a potholder; pulse a few times before leaving on to blend. Pour into a pot. Repeat with remaining soup. Reheat briefly over medium heat before serving.",
      "section": null,
      "name": null,
      "url": null,
