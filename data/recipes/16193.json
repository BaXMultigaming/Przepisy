  "ingredients": [
    "12 slices bacon",
    "2 heads fresh broccoli, florets only",
    "1 cup chopped celery",
    "0.5 cup chopped green onions",
    "1 cup seedless green grapes",
    "1 cup seedless red grapes",
    "0.5 cup raisins",
    "0.5 cup blanched slivered almonds",
    "1 cup mayonnaise",
    "1 tablespoon white wine vinegar",
    "0.25 cup white sugar"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large salad bowl, toss together the bacon, broccoli, celery, green onions, green grapes, red grapes, raisins and almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together the mayonnaise, vinegar and sugar. Pour dressing over salad and toss to coat. Refrigerate until ready to serve.",
