  "ingredients": [
    "1 pound king salmon fillets",
    "1 pinch ground black pepper",
    "0.5 cup dark brown sugar",
    "0.25 cup miso paste",
    "2 tablespoons minced ginger",
    "0.25 cup gluten-free soy sauce (tamari), or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a pie pan with aluminum foil. Place salmon in the prepared pie pan; season with pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, miso, and ginger together in a bowl. Slowly pour in enough soy sauce to reach the consistency of a glaze. Cover salmon with a thick layer of the glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the center of the preheated oven for 10 minutes. Remove salmon and set the oven rack about 6 inches from the heat source. Preheat the broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil salmon, checking regularly, until fish flakes easily with a fork and glaze is bubbly and golden, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
