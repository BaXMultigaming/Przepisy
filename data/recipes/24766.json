  "ingredients": [
    "1 (29 ounce) can yams, drained and mashed",
    "0.25 cup melted butter",
    "0.5 cup white sugar",
    "0.5 cup evaporated milk",
    "2 eggs, beaten",
    "0.5 teaspoon nutmeg",
    "0.5 teaspoon ground cinnamon",
    "1 teaspoon vanilla extract",
    "0.25 cup butter, softened",
    "0.5 cup brown sugar",
    "0.5 cup chopped walnuts",
    "1 cup sugar frosted corn flake cereal"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine yams, melted butter, white sugar, evaporated milk, eggs, nutmeg, cinnamon and vanilla extract. Mix well and transfer to a 9x9 inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl cream butter with brown sugar. Stir in walnuts and frosted cereal. Spread on top of yam mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
