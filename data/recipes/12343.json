  "title": "Tourtière (French Canadian Meat Pie)",
  "description": "A tourtière is a French Canadian meat pie made with deliciously seasoned ground pork, mashed potatoes, and onion in a double crust pie pastry.",
  "authors": [
    "Maggie Rogers"
  ],
  "date_published": "1998-08-08T11:46:18-04:00",
