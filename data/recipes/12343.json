  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 large baking potato",
    "1.5 pounds ground pork",
    "1 large onion, minced",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "1 pinch ground allspice",
    "0.5 cup water",
    "1 (14.1 ounce) package double-crust pie pastry, thawed",
    "1 large egg, beaten",
    "0.25 teaspoon paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0A1L4GHL3BO9BlFHqkZDF4C31aY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12343-Meat-Pie-Tourtiere-ddmds-4x3-step-01-e5e574918f7242a2815d688174150bd2.jpg"
      ],
      "image": "assets/images/12343/step_01.webp"
    },
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prick potato several times with a fork and place onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pKn-yGE3EQ79-xK_IMrXH0J8S9I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12343-Meat-Pie-Tourtiere-ddmds-4x3-step-02-c6f9e03286254a269d05c5090a1404a1.jpg"
      ],
      "image": "assets/images/12343/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until easily pierced with a fork, 50 minutes to 1 hour. Let cool for 10 minutes, then discard skin and mash flesh. Turn the oven off.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oJV1W3eLc2_x3uBAAGybf92MR0k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12343-Meat-Pie-Tourtiere-ddmds-4x3-step-03-8b290edc48d84455a1ae5ece5ecadc42.jpg"
      ],
      "image": "assets/images/12343/step_04.webp"
    },
    {
      "text": "Place mashed potato into a large skillet with ground pork, onion, water, pepper, cinnamon, cloves, and allpsice. Bring to a boil, then reduce the heat and simmer until very thick, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZpUSvZd853Poyxsicxy89KpjHPo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12343-Meat-Pie-Tourtiere-ddmds-4x3-step-04-2-997c7e9ac5cc4ed090a660ec9d04d7dc.jpg"
      ],
      "image": "assets/images/12343/step_05.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a deep-dish pie plate with one pastry. Spoon in pork and potato filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Br9xWslMdCH5vMHX-v3Rsd_aOh8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12343-Meat-Pie-Tourtiere-ddmds-4x3-step-06-abb2fe747768493e84913bbc1fc11760.jpg"
      ],
      "image": "assets/images/12343/step_07.webp"
    },
    {
      "text": "Cover with remaining pastry. Brush with beaten egg and sprinkle with paprika. Cut a steam vent in pastry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qnZ3yU6jc8kTdoyleiGZZsZOXlY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12343-Meat-Pie-Tourtiere-ddmds-4x3-step-08-d8b4464afe384045b490067fcc8edb71.jpg"
      ],
      "image": "assets/images/12343/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven for 50 minutes. If the edges brown too fast, cover them with a strip of foil. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k6B3bP6XJVn3KJmCLoohC8GcES4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12343-Meat-Pie-Tourtiere-ddmds-4x3-step-09-b1bd0ced0b2b490c8fd9a7d103f050f7.jpg"
      ],
      "image": "assets/images/12343/step_09.webp"
    }
  ],
