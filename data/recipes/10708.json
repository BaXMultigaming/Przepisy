  "ingredients": [
    "0.66666698455811 cup ground pecans",
    "0.33333298563957 cup white sugar",
    "0.5 cup butter",
    "1 tablespoon all-purpose flour",
    "2 tablespoons milk",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine all ingredients in a skillet, stirring over medium heat until blended. Keep mixture warm. (Mixture will be thin).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoonfuls about 3 inches apart on a well-greased cookie sheet. (No more than four or six cookies per sheet). Bake for five minutes then cool on the cookie sheet for one minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Quickly remove each cookie with spatula and curl around handle of wooden spoon. If cookies get too brittle to curl, return to oven for a minute to soften. To keep crisp, store airtight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
