  "ingredients": [
    "0.25 cup butter, softened",
    "0.25 cup shortening",
    "1.5 cups white sugar",
    "0.5 teaspoon vanilla extract",
    "3 eggs",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "1.5 teaspoons ground nutmeg",
    "0.25 teaspoon salt",
    "1 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter, shortening, and sugar until light and fluffy. Beat in the eggs one at a time, mixing well after each one. Combine the flour, baking powder, baking soda, nutmeg, and salt; stir into the creamed mixture alternately with the buttermilk until just blended. Pour the batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 40 minutes in the preheated oven, until the cake springs back when pressed lightly in the center. Cool completely before frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
