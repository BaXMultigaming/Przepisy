  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "0.33333334326744 cup vegetable oil",
    "4 eggs",
    "1 cup plain yogurt",
    "1 tablespoon unsweetened cocoa powder",
    "0.5 cup chopped walnuts",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Beat yellow cake mix, instant vanilla pudding mix, oil, eggs and yogurt together until no lumps remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl mix cocoa, chopped nuts, and cinnamon together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a large bundt pan with cooking spray and put 1/2 of batter in pan. Sprinkle streusel mix over batter and top streusel with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 50 minutes. Cool for 15 minutes and take out of pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
