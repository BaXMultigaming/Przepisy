  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove some of the bread from the middle of bread halves to accommodate more toppings. Spread about 1 teaspoon butter on each half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 2 to 3 tablespoons warmed refried beans on bread. Sprinkle about 1/4 cup Borden® Cheddar and Monterey Jack shredded cheese on the beans. Place bread halves on prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the cheese is melted and bubbly and the bread is crispy, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top molletes with Mexican salsa or pico de gallo.",
      "section": null,
      "name": null,
