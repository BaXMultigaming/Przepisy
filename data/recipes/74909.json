  "ingredients": [
    "1 medium zucchini, quartered and cut into 1/2-inch slices",
    "2 tablespoons olive oil",
    "0.25 teaspoon sesame oil",
    "2 teaspoons sesame seeds",
    "2 tablespoons Parmesan cheese",
    "0.25 teaspoon cayenne pepper",
    "0.5 teaspoon garlic salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, toss the zucchini with the olive oil, sesame oil, sesame seeds, Parmesan cheese, cayenne pepper, and garlic salt. Spread in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 minutes in the preheated oven, until lightly browned.",
