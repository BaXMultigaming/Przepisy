  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "1 cup cold butter",
    "0.5 cup confectioners' sugar",
    "2 cups white sugar",
    "4 eggs",
    "0.25 cup all-purpose flour",
    "0.25 cup lemon juice, or more to taste",
    "1 teaspoon baking powder",
    "1 teaspoon lemon zest, or to taste",
    "confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 cups flour, butter, and 1/2 cup confectioners’ sugar in the bowl of a food processor; pulse until mixture resembles coarse crumbs. Press into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust edges are golden brown, 18 to 22 minutes. Cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, eggs, 1/4 cup flour, lemon juice, baking powder, and lemon zest together in a bowl using an electric mixer until light and fluffy; pour onto the cooled crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven until custard is set, 25 to 28 minutes. Completely cool lemon squares; dust top with confectioners’ sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
