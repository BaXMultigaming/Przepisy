  "ingredients": [
    "2 (14 ounce) cans sweetened condensed milk",
    "4 jumbo egg yolks",
    "0.5 cup Key lime juice",
    "1 (8 inch) graham cracker crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk condensed milk and egg yolks together in a large mixing bowl. Mix in Key lime juice; mixture will be thin at first but will thicken as it is whisked. Whisk until smooth and thick. Pour into the graham cracker crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is firm to the touch and only slightly jiggly in the center, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool to room temperature, then refrigerate before serving, 5 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
