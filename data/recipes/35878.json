  "ingredients": [
    "1.5 teaspoons paprika",
    "1 teaspoon brown sugar",
    "0.25 teaspoon black pepper",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon dried thyme",
    "0.25 teaspoon dried rosemary",
    "0.25 teaspoon garlic powder",
    "0.125 teaspoon cayenne pepper",
    "2 large sweet potatoes",
    "1.5 teaspoons olive oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, stir together paprika, brown sugar, black pepper, onion powder, thyme, rosemary, garlic powder, and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice the sweet potatoes in half lengthwise. Brush each half with olive oil. Rub the seasoning mix over the cut surface of each half. Place sweet potatoes on a baking sheet, or in a shallow pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until tender, or about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
