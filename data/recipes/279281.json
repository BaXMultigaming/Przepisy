  "ingredients": [
    "1 pound beef sirloin steak, cut into thin strips",
    "0.25 cup reduced-sodium soy sauce",
    "1 tablespoon steak seasoning",
    "1.5 teaspoons brown sugar",
    "1 teaspoon Worcestershire sauce",
    "0.5 teaspoon liquid smoke flavoring",
    "skewers"
  ],
  "steps": [
    {
      "text": "Combine steak strips, soy sauce, steak seasoning, brown sugar, Worcestershire sauce, and liquid smoke in a resealable plastic bag. Marinate for at least 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Measure skewers to fit across the air fryer basket, slightly overlapping the edge. Trim off excess length.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the air fryer to 200 degrees F (95 degrees C) for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread beef strips onto skewers, leaving room in between each strip, while the air fryer is preheating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry for 2 hours. Adjust cooking time as most air fryers have a maximum setting of 30 minutes. Rearrange the skewers during the reset time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce temperature to 180 degrees F (80 degrees C). Air fry for an additional 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove strips to a paper towel-lined storage container. Seal. Allow to rest overnight before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
