  "ingredients": [
    "1 cup all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 pinch salt",
    "0.5 cup brown sugar",
    "0.25 cup chunky peanut butter",
    "3 tablespoons unsalted butter, softened",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "0.5 cup milk",
    "0.5 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, peanut butter, and butter in another bowl; beat together with an electric mixer until creamy. Beat in egg and vanilla extract. Mix in flour mixture and milk; beat until smooth. Fold chocolate chips into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes. Transfer to a wire rack to cool, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
