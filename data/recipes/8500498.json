  "ingredients": [
    "2 large ripe peaches - peeled, pitted, and chopped",
    "0.5 cup ketchup",
    "0.33 cup bourbon whiskey",
    "0.25 cup apple cider vinegar",
    "0.25 cup hot honey (such as Mike's Hot Honey®)",
    "0.25 cup dark brown sugar",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon liquid smoke",
    "2 teaspoons Dijon mustard",
    "1 teaspoon smoked paprika",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon salt",
    "0.25 teaspoon freshly ground black pepper",
    "0.13 teaspoon allspice"
  ],
  "steps": [
    {
      "text": "Combine peaches, ketchup, bourbon, apple cider vinegar, hot honey, brown sugar, Worcestershire sauce, liquid smoke, Dijon mustard, smoked paprika, garlic powder, onion powder, salt, pepper, and allspice in a high-powered blender. Blend until mixture is smooth, 15 to 20 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into a medium saucepan. Bring to a light boil over medium heat, whisking constantly. Reduce heat to medium-low and simmer until thickened, 15 to 20 minutes. Sauce will thicken further upon cooling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
