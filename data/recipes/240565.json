  "ingredients": [
    "1 (15.25 ounce) package red velvet cake mix",
    "2 large eggs",
    "0.5 cup vegetable oil",
    "0.5 (11 ounce) package chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cake mix, eggs, and oil together in a bowl until well mixed; fold in chocolate chips. Roll dough into 24 balls and arrange on an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned around the edges, 7 to 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool on the baking sheet 2 to 3 minutes before transferring to a wire rack to cool completely, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
