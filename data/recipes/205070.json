  "ingredients": [
    "1 egg white",
    "0.5 teaspoon salt",
    "1 teaspoon white sugar",
    "0.25 teaspoon mustard powder",
    "2 teaspoons lemon juice",
    "1 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Blend the egg white, salt, sugar, mustard powder, and lemon juice in a blender until combined; slowly stream the vegetable oil into the mixture while blending, about 1/4 cup at a time, until thick. Refrigerate in an air-tight container until using.",
