  "ingredients": [
    "3 cups biscuit baking mix",
    "1 cup white sugar",
    "2.5 teaspoons baking powder",
    "0.5 cup yellow cornmeal",
    "3 eggs",
    "1.25 cups milk",
    "1 cup butter, melted",
    "2 cups frozen corn kernels, thawed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, combine baking mix, sugar, baking powder and cornmeal. In a separate bowl, whisk together the eggs, milk and melted butter until creamy. Stir in flour mixture until blended. Fold in frozen corn if using. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes, or until a toothpick inserted into the center of the bread comes out clean. Serve warm.",
