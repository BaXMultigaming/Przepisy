  "title": "Zucchini Stuffed Chicken",
  "description": "Chicken breasts are stuffed with a savory zucchini and Swiss cheese stuffing and baked until golden brown in this family-friendly recipe.",
  "authors": [
    "REDTEETOP"
  ],
  "date_published": "2009-08-13T13:48:41-04:00",
