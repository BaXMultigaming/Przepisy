  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "2 eggs, beaten",
    "1 cup packed brown sugar",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground nutmeg",
    "2 teaspoons ground cinnamon",
    "1 (12 fluid ounce) can evaporated milk",
    "1 (18.25 ounce) package yellow cake mix",
    "0.33333298563957 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, combine the pumpkin, eggs, brown sugar, salt, ginger, nutmeg, cinnamon and evaporated milk. Mix until smooth and pour into 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top the pumpkin mixture with yellow cake mix (dry), melt 1/3 cup margarine and drizzle over cake mix until covered. Bake for 30 to 35 minutes or until crust is golden brown. Allow to cool uncovered and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
