  "ingredients": [
    "1 pound ground beef",
    "0.5 teaspoon crushed dried rosemary",
    "1 pinch salt",
    "1 pinch pepper",
    "0.25 teaspoon garlic powder",
    "4 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat a grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the ground beef, rosemary, salt, pepper and garlic powder. Divide the mixture into four parts and form into balls. Make an indention in the center of each one, and place a tablespoon of butter in the hole. Mold the meat around the butter, and flatten into a patty.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil the grilling surface, and place burgers on the preheated grill. Cook for 5 to 10 minutes on each side, until well done.",
