  "ingredients": [
    "1 cup vegetable oil",
    "3 eggs",
    "2 (4 ounce) jars plum baby food",
    "2 cups white sugar",
    "1 teaspoon red food coloring",
    "2 cups all-purpose flour",
    "1 teaspoon ground cloves",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1 cup chopped nuts",
    "1 cup confectioners' sugar",
    "2.5 tablespoons lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a bundt pan or loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together vegetable oil, white sugar, eggs, plum baby food, and food coloring. In a separate bowl, mix together flour, cloves, cinnamon, nutmeg, salt, baking soda, and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix wet and dry ingredients together. Transfer batter to prepared pan(s).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 50-60 minutes or until a tester comes out clean. (Smaller loaf pans will take less time.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven to cool 10 minutes in pan. Remove and place on cooling rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the cake is cooling, combine confectioners' sugar and lemon juice. Brush over top while cake is still hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
