  "ingredients": [
    "8 cups bread flour",
    "2 cups sourdough starter",
    "2 cups water",
    "0.25 cup vegetable oil",
    "0.25 cup white sugar",
    "0.25 cup dry milk powder",
    "4 teaspoons active dry yeast",
    "2 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Combine flour, sourdough starter, water, oil, sugar, milk powder, yeast, and salt in a large bowl. Mix by hand until flour is incorporated. Transfer to the bowl of a stand mixer fitted with a dough hook. Knead dough for 6 minutes; allow to rest for 6 minutes. Repeat 3 times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dough to an oiled pan; cover with plastic wrap and let rise until doubled, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate dough into 6 equal rounds; let rest 10 minutes. Roll out each portion to desired crust size.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 to 6 minutes. Cool on a rack; freeze in resealable plastic bags separated by parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
