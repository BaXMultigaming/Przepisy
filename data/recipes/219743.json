  "ingredients": [
    "4 slices bacon, or more to taste",
    "1 (16 ounce) bag fresh spinach, stems removed",
    "2 hard-cooked eggs, chopped",
    "1 small red onion, finely chopped",
    "0.5 cup white sugar",
    "0.33333334326744 cup ketchup",
    "0.25 cup vegetable oil",
    "0.25 cup vinegar",
    "2 teaspoons Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Place the bacon into a skillet over medium heat, and cook until browned and crisp, turning often, about 10 minutes. Transfer the bacon to paper towels to absorb excess grease. Crumble the bacon when cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the spinach into a large salad bowl, and sprinkle with the bacon, hard-cooked eggs, and onion. Gently toss the salad.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, whisk together the sugar, ketchup, vegetable oil, vinegar, and Worcestershire sauce until the sugar has dissolved. Pour the dressing over the salad, and toss thoroughly to combine all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
