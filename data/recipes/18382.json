  "ingredients": [
    "2 eggs",
    "1.25 cups white sugar",
    "1 cup coarsely chopped walnuts",
    "1 cup chopped dates",
    "1 teaspoon vanilla extract",
    "1 cup flaked coconut",
    "0.25 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, beat eggs with an electric mixer. Add 1 cup sugar and beat well. Blend in nuts, dates, vanilla, coconut and almond extract. Transfer mixture to an ungreased 2 quart casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 350 degrees F (175 degrees C) oven for 30 minutes. Remove the mixture from the oven while still hot and beat well with a wooden spoon. Cool until the mixture can be handled then form into small balls and roll in the 1/4 cup remaining sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
