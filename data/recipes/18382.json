  "title": "Christmas Casserole Cookies I",
  "description": "This is a good way to use up leftover ingredients from Christmas baking. The amounts of dates, nuts and coconut can be varied - just use a total of 3 cups.",
  "authors": [
    "Peggy McCormack"
  ],
  "date_published": "2000-05-30T01:45:23-04:00",
