  "ingredients": [
    "1 recipe pastry for a 9 inch double crust pie",
    "2 tablespoons all-purpose flour",
    "0.25 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "9 apples - peeled, cored and sliced",
    "1 tablespoon lemon juice",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl mix together flour, salt, and cinnamon. Add apples and lemon juice. Toss until apples are thoroughly coated. Allow to sit for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour apples into pastry-lined pie plate. Dot with butter or margarine. Cover with top pastry. Seal edges and cut steam vents in top pastry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 35 to 45 minutes, until crust is golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
