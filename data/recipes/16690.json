  "ingredients": [
    "1 pound Italian sausage",
    "0.75 cup chopped onion",
    "1 slice pancetta bacon, diced",
    "1.25 teaspoons garlic, minced",
    "1 cube chicken bouillon",
    "4 cups water",
    "2 potatoes, cubed",
    "2 cups kale, rinsed and julienned",
    "0.33333334326744 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sausage links on a sheet pan and bake until cooked through, 15 to 20 minutes. Cut each link in half lengthwise, then into 1/2-inch slices. Set aside for later.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sauté onions and pancetta in a 4-quart saucepan over medium heat until onions are translucent, about 10 minutes. Add garlic and sauté for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add bouillon, water, and potatoes; bring to a simmer for 15 minutes. Add kale, cream, and reserved sausage; simmer for 5 more minutes and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
