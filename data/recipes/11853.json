  "ingredients": [
    "2 tablespoons butter",
    "1 cup uncooked orzo pasta",
    "1 (14.5 ounce) can chicken broth",
    "0.5 cup grated Parmesan cheese",
    "0.25 cup chopped fresh basil",
    "salt and pepper to taste",
    "2 tablespoons chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Melt butter in a heavy skillet over medium-high heat. Stir in orzo and sauté until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chicken broth and bring to boil. Cover, reduce heat, and simmer until orzo is tender and liquid is absorbed, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in Parmesan cheese and 1/4 cup chopped basil. Season with salt and pepper. Transfer to a shallow bowl and garnish with remaining basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
