  "ingredients": [
    "8 slices bacon",
    "2 heads butterhead lettuce",
    "4 ears sweet corn, cut off the cob",
    "1 bunch green onions, chopped",
    "1 red bell pepper, chopped",
    "2 avocados - peeled, seeded and cubed",
