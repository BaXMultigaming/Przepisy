  "ingredients": [
    "0.5 cup heavy cream",
    "1.25 cups poppy seeds",
    "1.5 cups whole wheat flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.75 cup butter, softened",
    "0.5 lemon, juiced",
    "0.66666668653488 cup maple flavored syrup"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a baking sheet or line it with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream and poppy seeds in a small saucepan. Heat mixture over medium heat until mixture is hot; do not boil. Remove from heat and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine flour, baking soda and cinnamon. Stir in butter, lemon juice and syrup. Mix well and add cooled poppy seed mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by small spoonfuls onto prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden brown, about 20 minutes. Allow cookies to cool on baking sheet for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
