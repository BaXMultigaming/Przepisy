  "ingredients": [
    "0.25 cup vegetable oil",
    "2 tablespoons raspberry balsamic vinegar",
    "1 tablespoon balsamic vinegar",
    "1 tablespoon brown sugar",
    "1 clove garlic, minced",
    "0.5 teaspoon honey Dijon mustard"
  ],
  "steps": [
    {
      "text": "Combine oil, raspberry balsamic vinegar, balsamic vinegar, brown sugar, garlic, and mustard in a sealable jar. Seal the jar and shake vigorously until dressing is well-combined. Refrigerate until flavors combine, at least 1 hour.",
