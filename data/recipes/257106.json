  "ingredients": [
    "8 skinless, boneless chicken thighs",
    "2 large onions, thinly sliced",
    "4 large carrots, thinly sliced",
    "0.5 cup raisins",
    "0.5 cup dried apricots, chopped",
    "2 cups chicken broth",
    "2 tablespoons tomato paste",
    "2 tablespoons lemon juice",
    "2 tablespoons all-purpose flour",
    "2 teaspoons garlic salt",
    "2 teaspoons ground cumin",
    "1.5 teaspoons ground ginger",
    "1 teaspoon ground cinnamon",
    "1 teaspoon Hungarian paprika",
    "1 teaspoon ground black pepper",
    "3 cups water",
    "2 cups couscous",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Layer chicken thighs, onions, carrots, raisins, and apricots in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk chicken broth, tomato paste, lemon juice, flour, garlic salt, cumin, ginger, cinnamon, paprika, and black pepper together in a bowl; pour over chicken and vegetables. Cover slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High 4 1/2 hours or on Low for 7 1/2 hours. Slightly shred chicken using 2 forks. Cook 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring 3 cups water to a boil in a saucepan; remove from heat and stir in couscous and butter. Cover saucepan; let stand until water is completely absorbed, 5 to 10 minutes. Fluff couscous with a fork. Serve chicken tagine over couscous.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
