  "title": "Banana Cake with Cream Cheese Frosting",
  "description": "My family loves this banana cake recipe frosted with a cream cheese frosting with one ripe banana added and confectioners' sugar sprinkled over the top.",
  "authors": [
    "Carol Farrington"
  ],
  "date_published": "1998-04-09T11:06:52-04:00",
