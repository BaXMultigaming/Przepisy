  "ingredients": [
    "1 tablespoon coconut oil",
    "1 roma (plum) tomato, diced",
    "0.25 cup sliced white onion",
    "1 small garlic clove, minced",
    "0.125 teaspoon minced scotch bonnet chile pepper",
