  "ingredients": [
    "4 medium green bell peppers, tops and seeds removed",
    "1 (28 ounce) can tomato sauce",
    "0.25 cup white vinegar",
    "1.5 pounds lean ground beef",
    "1 cup leftover cooked white rice",
    "0.5 cup Italian-style bread crumbs",
    "6 tablespoons grated Parmesan cheese",
    "0.25 cup finely chopped onion",
    "1 large egg, lightly beaten",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "0.25 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Bring a large pot of water to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xYDnOnERtw5i1Y_JsO3bHFZYjgw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220003-Homestyle-Stuffed-Peppers-ddmfs-step-1-ab8f4d03a05d43ec94162db7e1e790fe.jpg"
      ],
      "image": "assets/images/220003/step_01.webp"
    },
    {
      "text": "Add peppers and boil until softened, 4 to 5 minutes. Transfer peppers to a colander and run under cold water to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mKzV3GmgabnVzgvdR0XoW6FA-bo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220003-Homestyle-Stuffed-Peppers-ddmfs-step-2-afbe06e71e254148905d480051b1ab9e.jpg"
      ],
      "image": "assets/images/220003/step_02.webp"
    },
    {
      "text": "Mix ground beef, cooked rice, bread crumbs, 4 tablespoons Parmesan, onion, egg, garlic powder, salt, and pepper together in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kuxRk51cimHyX2OOIgB4xyHBF2I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220003-Homestyle-Stuffed-Peppers-ddmfs-step-3-59b65d8a1e2448b488542fdefcaad423.jpg"
      ],
      "image": "assets/images/220003/step_03.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spoon beef mixture into peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A46bh14goO1LGTeLD3yaLtb8SGE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220003-Homestyle-Stuffed-Peppers-ddmfs-step-5-8d705f6848f343ae9b9e36efc5e51a6b.jpg"
      ],
      "image": "assets/images/220003/step_04.webp"
    },
    {
      "text": "Place peppers into a baking dish with the stuffing facing up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kFLONVDA1KDv-XoW-PFFbHTDCzc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220003-Homestyle-Stuffed-Peppers-ddmfs-step-6-2f1561054e954dd4baacea1a05952781.jpg"
      ],
      "image": "assets/images/220003/step_05.webp"
    },
    {
      "text": "Stir tomato sauce and vinegar together in a bowl. Pour tomato sauce mixture over peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eBWbRi4bkXRyygKQ0XKA2h0IqiM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220003-Homestyle-Stuffed-Peppers-ddmfs-step-7-9a5f4b3014444ad78b0fd89f3a039ba9.jpg"
      ],
      "image": "assets/images/220003/step_06.webp"
    },
    {
      "text": "Sprinkle remaining 2 tablespoons Parmesan over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nWDa7_mAYBj7qK5-_f_Do_geeWw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220003-Homestyle-Stuffed-Peppers-ddmfs-step-8-8455927e599949bab09bed7b59a3e2a5.jpg"
      ],
      "image": "assets/images/220003/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven, basting peppers with sauce several times, until beef filling is no longer pink in the center, about 1 hour 20 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PoQ_Spxa42sFOvGcMArSrOdevPg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-220003-Homestyle-Stuffed-Peppers-ddmfs-step-9-d7a48cb812f84db89ca6d5e92d165b98.jpg"
      ],
      "image": "assets/images/220003/step_08.webp"
    }
