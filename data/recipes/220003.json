  "title": "Homestyle Stuffed Peppers",
  "description": "Old-fashioned stuffed peppers just like mom used to make! Green bell peppers stuffed with beef and rice are smothered in a tangy tomato sauce.",
  "authors": [
    "Jillian"
  ],
  "date_published": "2019-06-06T19:48:02-04:00",
