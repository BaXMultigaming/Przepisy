  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "1 cup peanut butter",
    "0.5 cup white sugar",
    "1 (6 ounce) package white chocolate chips (such as Nestle®)"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese, peanut butter, and sugar together in a bowl; form into 1-inch balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt white chocolate chips in a microwave-safe glass or ceramic bowl in 30-second intervals, stirring after each melting, 1 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each ball into the melted white chocolate, using spoons to roll ball around until evenly coated. Arrange coated balls on the prepared baking sheet; refrigerate until set, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
