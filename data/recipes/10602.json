  "ingredients": [
    "1 cup butter",
    "0.5 cup packed brown sugar",
    "1 teaspoon vanilla extract",
    "3 cups quick cooking oats",
    "1 cup semisweet chocolate chips",
    "0.5 cup peanut butter"
  ],
  "steps": [
    {
      "text": "Grease a 9-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Stir in brown sugar and vanilla; mix in oats. Cook over low heat until ingredients are well blended, about 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZzdDsfyGYE2rnGDpbRSMVJPBn-Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10602-no-bake-chocolate-oat-bars-ddmfs-step1-0867-e4c63438ca2344a48901d3fe89c375e8.jpg"
      ],
      "image": "assets/images/10602/step_02.webp"
    },
    {
      "text": "Press 1/2 of the mixture into the bottom of the prepared pan. Reserve remaining oat mixture for topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OOTCMv-ZuuWrN_vz8s4Qui5k1Tw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10602-no-bake-chocolate-oat-bars-ddmfs-step2-0871-cae5ec585ab445c38fe32b0392050820.jpg"
      ],
      "image": "assets/images/10602/step_03.webp"
    },
    {
      "text": "Meanwhile, melt chocolate chips and peanut butter in a small heavy saucepan over low heat, stirring frequently until smooth. Pour chocolate mixture over crust in the pan and spread evenly with a knife or the back of a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/neFQ-zpDATKtN4AxKzxU-OWmuJ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10602-no-bake-chocolate-oat-bars-ddmfs-step4-0873-8ba550f9cb20424faaec8c19ed90cc18.jpg"
      ],
      "image": "assets/images/10602/step_04.webp"
    },
    {
      "text": "Crumble remaining oat mixture over chocolate layer, pressing down gently. Cover and refrigerate for 2 to 3 hours or overnight. Bring to room temperature before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nEEtHwYMJXlVE_G7YoWbMzKdMEk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10602-no-bake-chocolate-oat-bars-ddmfs-2X3-0879-af3f2963b94c400bbbe0328cce9d3b8c.jpg"
      ],
      "image": "assets/images/10602/step_05.webp"
    }
  ],
