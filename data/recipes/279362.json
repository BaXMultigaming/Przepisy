  "ingredients": [
    "0.75 cup white sugar",
    "0.5 cup unsalted butter, softened",
    "2 eggs",
    "1 tablespoon cocoa powder",
    "1 teaspoon ground cinnamon",
    "1 pinch ground cloves",
    "1.6666667461395 cups all-purpose flour",
    "1 cup soured milk",
    "0.5 cup raisins",
    "1 teaspoon baking soda",
    "1 tablespoon boiling water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and butter together in a large bowl. Beat in eggs, cocoa powder, cinnamon, and cloves. Add flour alternately with soured milk, stirring batter until smooth. Fold in raisins. Dissolve baking soda in boiling water and add to the batter. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a skewer inserted into the center comes out clean, 30 to 35 minutes. Cool before slicing.",
      "section": null,
      "name": null,
      "url": null,
