  "ingredients": [
    "0.5 cup unsalted butter",
    "2 tablespoons olive oil",
    "4 cups sliced onions",
    "5 cups beef broth",
    "2 tablespoons dry sherry",
    "1 teaspoon dried thyme",
    "1 pinch salt and pepper to taste",
    "4 slices French bread",
    "4 slices provolone cheese",
    "2 slices Swiss cheese, diced",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/spUF2qY71sv22fxvQyEEyD_eqAs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13309-Rich-and-Simple-French-Onion-Soup-DDMFS-Step1-10695ec69bcc41ecb05e1fc67a589b8e.jpg"
      ],
      "image": "assets/images/13309/step_01.webp"
    },
    {
      "text": "Melt butter with olive oil in an 8-quart stock pot over medium heat. Add onions to butter and continually stir until tender and translucent. Do not brown the onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FrpANN5bqMHziieQCR9tKn1CnZg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13309-rich-and-simple-french-onion-soup-mfs-039-f75e52af25bf4df3b6c176d0c36b2771.jpg"
      ],
      "image": "assets/images/13309/step_02.webp"
    },
    {
      "text": "Add beef broth, sherry, and thyme. Season with salt and pepper. Let simmer for 30 minutes. Meanwhile, preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Efk3X8Z3P9SR3Jl1WnB9TLU0eZw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13309-rich-and-simple-french-onion-soup-mfs-040-4a11923931404de5a3d5f8273a58f1f3.jpg"
      ],
      "image": "assets/images/13309/step_03.webp"
    },
    {
      "text": "Ladle soup into oven-safe serving bowls and place one slice of bread on top of each (bread may be broken into pieces if you prefer). Layer each slice of bread with a slice of provolone, 1/2 slice diced Swiss and 1 tablespoon Parmesan cheese. Place bowls on a rimmed sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oN17YJ-G3eva1greh8AK6dkd4tU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13309-rich-and-simple-french-onion-soup-mfs-045-cfccd06932134ef6b6be03a032e0b4e2.jpg"
      ],
      "image": "assets/images/13309/step_04.webp"
    },
    {
      "text": "Broil in the preheated oven until cheese bubbles and browns slightly, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RpmUZM7xWs5zSGRi9OgilEb7tMc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13309-rich-and-simple-french-onion-soup-mfs-046-0e5b8cc38e7649cfa1cf29d26565abb6.jpg"
      ],
      "image": "assets/images/13309/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wWn2fBl9C-OjhcyZj9Av-i8Alfc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13309-rich-and-simple-french-onion-soup-DDMFS-4x3-31ad7eaa56234d20ae35c3940fd03f36.jpg"
      ],
      "image": "assets/images/13309/step_06.webp"
    }
