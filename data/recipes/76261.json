  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 cup butter, softened",
    "1 cup SPLENDA® Sugar Blend",
    "2 large eggs",
    "1 tablespoon molasses",
    "1.5 teaspoons vanilla extract",
    "3 cups old-fashioned oatmeal, uncooked",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, soda, and cinnamon. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and Splenda at medium speed with an electric mixer until fluffy. Add eggs, molasses, and vanilla, beating until blended. Gradually add flour mixture, beating at low speed until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in oats and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded tablespoons onto lightly greased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 10 to 12 minutes or until lightly browned. Cool slightly on baking sheets. Remove to wire racks; cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
