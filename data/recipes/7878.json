      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FaZF3E-2mdhj67E1tcOJHkz-A1k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7878-blueberry-coffee-cake-DDMFS-step-08-3-2900-76d3d7cd743640ef99e6a44b7fae967d.jpg"
