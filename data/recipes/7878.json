    "0.66666668653488 cup all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.5 cup unsalted butter, softened",
    "cooking spray",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 cup unsalted butter, softened",
    "1 cup white sugar",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "0.5 cup milk",
