  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the streusel: Mix brown sugar, flour, and cinnamon together in a medium bowl. Cut in butter until mixture is crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
