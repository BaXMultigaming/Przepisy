  "ingredients": [
    "1 (16 ounce) package Brussels sprouts, trimmed and halved",
    "2 tablespoons olive oil",
    "1 teaspoon garlic powder",
    "1 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "1 tablespoon balsamic vinegar",
    "0.25 cup grated Parmesan cheese",
    "1 pinch red pepper flakes, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3_QRjuXyodOUXVk11RJlsdNQIQc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276723-roasted-brussels-sprouts-with-parmesan-ddmfs-Step1-5a949d234754417391cb8d8a299b8087.jpg"
      ],
      "image": "assets/images/276723/step_01.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss Brussels sprouts with olive oil, garlic powder, black pepper, and salt in a large bowl. Spread evenly in a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ovAgVNaV0hjr9kXoHSfstiB82H0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276723-roasted-brussels-sprouts-with-parmesan-ddmfs-Step5-43b2a96e8f684771b64385722ff244a6.jpg"
      ],
      "image": "assets/images/276723/step_03.webp"
    },
    {
      "text": "Roast in the preheated oven, shaking every 5 minutes, until crispy and fork-tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5BGVpkgiWXoa3tD0AeKb4oubQPc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276723-roasted-brussels-sprouts-with-parmesan-ddmfs-Step7-0ecfa9d9331f44e09a9bfdaf7e9803f3.jpg"
      ],
      "image": "assets/images/276723/step_04.webp"
    },
    {
      "text": "Stir balsamic vinegar into sprouts, then sprinkle with Parmesan. Continue roasting until cheese is melted, about 1 minute. Sprinkle with red pepper flakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mn9frDIOXTra2caleHVk-ICSv0c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276723-roasted-brussels-sprouts-with-parmesan-ddmfs-Step11-490fc20c52cd444794ab7b2196c8fcb8.jpg"
