  "ingredients": [
    "0.66666668653488 cup oil",
    "3 tablespoons milk",
    "2 cups all-purpose flour",
    "2 teaspoons white sugar",
    "1.25 teaspoons salt",
    "2 cups frozen cranberries, sorted and rinsed",
    "2 cups chopped apples",
    "0.66666668653488 cup white sugar",
    "3.5 teaspoons all-purpose flour",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil and milk in a liquid measuring cup; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, and salt in a medium bowl; mix together with a fork. Add oil mixture and mix until well combined. Press a little more than 1/2 of the crust mixture into the bottom and sides of a pie plate, using a spatula if necessary, as mixture will crumble easily.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cranberries and apples in a large mixing bowl. Add sugar, flour, and lemon juice; mix until fruit is evenly coated. Pour filling into the pie plate and crumble remaining crust mixture over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is bubbly and crumb topping is golden brown, 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
