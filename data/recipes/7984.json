  "ingredients": [
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "5 tablespoons unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "2 cups cold water",
    "0.66666668653488 cup vegetable oil",
    "2 tablespoons distilled white vinegar",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl combine the flour, sugar, cocoa, soda, and salt--stir to mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine water, oil, vinegar, and vanilla. Dump the dry ingredients into the water mixture and stir with a fork until smooth. DO NOT BEAT. Pour batter into an UNGREASED 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
