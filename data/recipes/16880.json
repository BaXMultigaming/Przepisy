  "ingredients": [
    "1.5 cups uncooked long-grain white rice",
    "3 cups water",
    "1 cup chopped red onion",
    "1 cup chopped celery",
    "1 cup chopped cucumber",
    "4 ounces feta cheese",
    "1 tablespoon olive oil",
    "2 tablespoons red wine vinegar"
  ],
  "steps": [
    {
      "text": "Place rice and water in a medium-size pot. Bring water to a boil, when boiled reduce heat to a simmer, cover pot and let rice cook until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, combine red onion, celery, and cucumber. Crumble the feta into the bowl. Cover the vegetable mixture with cooked rice, cover and let sit for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss vegetable and feta with oil and vinegar, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
