  "ingredients": [
    "1 pinch kosher salt for rimming glasses",
    "ice cubes",
    "0.5 cup silver tequila",
    "0.25 cup sweetened lime juice (such as Rose's®)",
    "0.25 cup triple sec",
    "0.25 cup lemon-lime soda, or to taste"
  ],
  "steps": [
    {
      "text": "Rim 2 margarita glasses with salt, if desired, and fill with ice. Pour tequila, sweetened lime juice, triple sec, and lemon-lime soda into a shaker filled with ice, hold your hand firmly over the top of the shaker so it doesn't pop off from the carbonated soda. Shake vigorously. Pour into prepared margarita glasses, and serve.",
