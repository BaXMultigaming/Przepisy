  "ingredients": [
    "1 (20 ounce) can pineapple chunks with juice",
    "0.75 cup water, or as needed",
    "0.75 cup uncooked long-grain rice",
    "0.5 teaspoon freshly grated ginger",
    "0.5 teaspoon salt",
    "3 medium green onions, white and green parts, finely chopped"
  ],
  "steps": [
    {
      "text": "Pour pineapple juice into a 2-cup liquid measure; add water to reach 1 3/4 cups liquid. Pour into a saucepan. Reserve pineapple chunks.",
