  "ingredients": [
    "5 sun-dried tomatoes packed in oil, drained and chopped",
    "0.5 (6 ounce) container feta cheese",
    "0.66666668653488 cup toasted walnuts",
    "2 tablespoons olive oil",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon red pepper flakes",
    "salt and freshly ground black pepper to taste",
    "6 tablespoons milk, or as needed"
  ],
  "steps": [
    {
      "text": "Combine sun-dried tomatoes, feta cheese, walnuts, olive oil, oregano, red pepper flakes, salt, and pepper in the bowl of a food processor; pulse until blended. Pour in milk with the processor running, 1 tablespoon at a time, until a spreadable consistency is reached. Serve immediately or chill until needed.",
