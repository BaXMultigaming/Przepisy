    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "6 cups grated carrots",
    "1 cup brown sugar",
    "1 cup raisins",
    "4 eggs",
    "1.5 cups white sugar",
    "1 cup vegetable oil",
    "2 teaspoons vanilla extract",
    "1 cup crushed pineapple, drained",
    "3 cups all-purpose flour",
    "4 teaspoons ground cinnamon",
    "1.5 teaspoons baking soda",
    "1 teaspoon salt",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EpbvR6TIDqbEurlMDTWK_-PGgNM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-17393-Best-Carrot-Cake-Ever-ddmfs-step-0-d179654a8a014d4ca2b098b99c47470e.jpg"
      ],
      "image": "assets/images/17393/step_01.webp"
    },
    {
      "text": "Combine grated carrots and brown sugar in a medium bowl. Let sit for 1 hour, then stir in raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z8xkNYrMhMV07NlJ8GHnRZC-_dc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-17393-Best-Carrot-Cake-Ever-ddmfs-step-1-ace0d67d3eb745bc967f8633c00df4f6.jpg"
      ],
      "image": "assets/images/17393/step_02.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 10-inch round cake pans. Beat eggs in a large bowl until lighter in color.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Sq3jDL13KvrzQt38ol3W3BQLGu8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-17393-Best-Carrot-Cake-Ever-ddmfs-step-2-e6b969d4ddbe47b38f0f9d3ad58f8646.jpg"
      ],
      "image": "assets/images/17393/step_03.webp"
    },
    {
      "text": "Gradually beat in white sugar, oil, and vanilla. Stir in pineapple.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8qgQY5ioGu5E4L9OxPFOowDMl6c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-17393-Best-Carrot-Cake-Ever-ddmfs-step-3-a5eb48767d054e74b012c3c08c08a034.jpg"
      ],
      "image": "assets/images/17393/step_04.webp"
    },
    {
      "text": "Combine flour, cinnamon, baking soda, and salt in a separate bowl, then stir into egg mixture until absorbed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SIopJfbDilbdgA-hdEYWh1hVhH8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-17393-Best-Carrot-Cake-Ever-ddmfs-step-4-ec08a8db546e40c29c4be01b36120924.jpg"
      ],
      "image": "assets/images/17393/step_05.webp"
    },
    {
      "text": "Stir in carrot mixture and walnuts. Pour evenly into the prepared cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2Nv8WQd6CpYVNIiv8PwRAWSBRWk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-17393-Best-Carrot-Cake-Ever-ddmfs-step-5-A-7b6c2d1535784507a08f3adfb844a035.jpg"
      ],
      "image": "assets/images/17393/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MH4BGb2uS9ZrLwW51wPnqtFCBKU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-17393-Best-Carrot-Cake-Ever-ddmfs-step-6-4171dbca8e4c489e8adee3843e4d16d3.jpg"
      ],
      "image": "assets/images/17393/step_07.webp"
    },
    {
      "text": "Cool for 10 minutes before removing cake from the pans; let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FdnjmAgpd-a2Df99LIY6wRsRrFQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-17393-Best-Carrot-Cake-Ever-ddmfs-4x3-724b5c5584b04426852addcf85ac72af.jpg"
      ],
      "image": "assets/images/17393/step_08.webp"
    }
  ],
