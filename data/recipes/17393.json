  "title": "Best Carrot Cake Ever",
  "description": "The best carrot cake recipe uses grated carrots, crushed pineapple, and juicy raisins to create the most deliciously moist and tender cake ever!",
  "authors": [
    "Nan"
  ],
  "date_published": "2000-01-24T22:20:17-05:00",
