  "ingredients": [
    "1 pound spaghetti, broken into pieces",
    "1 (16 ounce) bottle Italian-style salad dressing",
    "1 tablespoon grated Parmesan cheese",
    "1 tablespoon sesame seeds",
    "1 tablespoon poppy seeds",
    "2 teaspoons seasoning salt",
    "1 teaspoon paprika",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon cayenne pepper",
    "1 cucumber, chopped",
    "1 red onion, diced",
    "2 tomatoes, chopped"
  ],
  "steps": [
    {
      "text": "Cook spaghetti according to package directions. Drain, rinse with cold water and drain well. Transfer to large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk salad dressing, cheese, seeds, salt, paprika, garlic powder, and peppers together until well blended. Stir in cucumber and onion. Pour mixture over spaghetti and toss lightly to coat evenly. Cover and refrigerate for at least 2 hours or up to 24 hours. Top with tomatoes to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
