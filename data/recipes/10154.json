  "ingredients": [
    "0.5 cup butter, softened",
    "0.66666698455811 cup white sugar",
    "2 tablespoons milk",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.33333298563957 cup unsweetened cocoa powder",
    "0.25 teaspoon salt",
    "1 cup finely chopped walnuts",
    "0.5 cup confectioners' sugar",
    "1 tablespoon butter, softened",
    "2 teaspoons milk",
    "0.25 teaspoon vanilla extract",
    "26 milk chocolate candy kisses, unwrapped"
  ],
  "steps": [
    {
      "text": "Beat 1/2 cup butter or margarine, white sugar, egg yolk, 2 tablespoons milk and 1 teaspoon vanilla until light and fluffy. Combine flour, cocoa and salt; gradually add to butter mixture. Cover and chill 1 hour or until firm enough to roll into balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in a small bowl, lightly beat egg white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 1 inch balls; dip in egg white, then roll in nuts. Place on greased baking sheets. Make an indentation with thumb in center of each cookie. Bake for 10-12 minutes or until center is set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make the Filling: In a small bowl, combine 1/2 cup confectioner's sugar, 1 tablespoon of butter or margarine, 2 teaspoons of milk and 1/4 teaspoon of vanilla extract. Mix until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon 1/4 teaspoon of the filling into each warm cookie; gently press a chocolate kiss (unwrapped) in the center. Carefully remove from baking sheet to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
