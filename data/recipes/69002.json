  "ingredients": [
    "1 pound ground turkey",
    "1 (4 ounce) jar mushrooms, drained and diced",
    "1 (1.5 ounce) package dry beef stew seasoning mix",
    "2 eggs, beaten",
    "0.25 cup extra virgin olive oil"
  ],
  "steps": [
    {
