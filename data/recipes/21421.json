  "ingredients": [
    "2 (29 ounce) cans sweet potatoes",
    "2 tablespoons butter",
    "1 tablespoon lemon juice",
    "0.5 (16 ounce) package gingersnap cookies",
    "1 (16 ounce) package miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Combine sweet potatoes, butter, and lemon juice in a large saucepan over medium heat. Break gingersnap cookies into sweet potatoes mixture; cook, stirring occasionally, until thick, about 15 minutes.",
