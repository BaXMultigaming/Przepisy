  "title": "Baked Teriyaki Chicken",
  "description": "This teriyaki chicken recipe uses a homemade teriyaki sauce to glaze chicken thighs that are baked in the oven for the most delicious sticky chicken.",
  "authors": [
    "Allrecipes Member"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
