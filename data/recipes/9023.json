  "ingredients": [
    "0.5 cup white sugar",
    "0.5 cup soy sauce",
    "0.25 cup cider vinegar",
    "1 tablespoon cornstarch",
    "1 tablespoon cold water",
    "1 clove garlic, minced",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon ground black pepper",
    "12 boneless, skinless chicken thighs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, soy sauce, vinegar, cornstarch, cold water, garlic, ginger, and black pepper in a small saucepan over low heat; simmer, stirring frequently, until teriyaki sauce thickens and bubbles, 3 to 5 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1nY5Z5Q0jmma-VcrKQXTScihAAo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9023-baked-teriyaki-chicken-step-2-209copy-d8c82756f50d41058a61e8577b621097.jpg"
      ],
      "image": "assets/images/9023/step_02.webp"
    },
    {
      "text": "Place chicken thighs in the prepared baking dish; brush both sides of each thigh with teriyaki sauce. Reserve any extra sauce for basting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tPcYZj9mC0ijkzElQ6fo1fiK_2c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9023-baked-teriyaki-chicken-step-3-211-b9e6a52997e74045ac85dcfb7351ee22.jpg"
      ],
      "image": "assets/images/9023/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flip chicken; brush with sauce. Continue baking, basting with remaining sauce every 10 minutes, until no longer pink and juices run clear, 20 to 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LLnvqnBTEErWK95wDd2amICoVHY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9023-baked-teriyaki-chicken-DDMFS-4x3-8fc9cd3743714eedad57edb8bda8e59b.jpg"
      ],
      "image": "assets/images/9023/step_06.webp"
    }
