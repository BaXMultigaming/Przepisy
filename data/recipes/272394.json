  "ingredients": [
    "1.25 cups warm water",
    "1 egg",
    "1.5 tablespoons olive oil",
    "3 tablespoons honey",
    "1 tablespoon molasses",
    "2 tablespoons chia seeds",
    "3.75 cups whole wheat flour",
    "1.5 teaspoons salt",
    "3 teaspoons active dry yeast",
    "cooking spray",
    "1 tablespoon butter, melted, or more as needed"
  ],
  "steps": [
    {
      "text": "Place warm water, egg, olive oil, honey, molasses, chia seeds, whole wheat flour, salt, and yeast into a bread machine in the order listed by the manufacturer. Run Dough cycle. Remove dough from the machine after the cycle is done, about 1 hour 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a baking sheet with nonstick cooking spray. Form dough into 12 buns and arrange on the baking sheet. Let rise until doubled in size, about 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until buns are golden brown, about 14 minutes. Let cool for 10 minutes before transferring to a wire rack. Brush with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
