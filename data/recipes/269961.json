  "ingredients": [
    "cooking spray",
    "1.5 pounds fresh pizza dough",
    "1 ounce sliced turkey pepperoni",
    "dried oregano to taste",
    "ground red pepper to taste",
    "garlic salt to taste",
    "1 teaspoon melted butter",
    "1 teaspoon grated Parmesan cheese",
    "0.5 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Shape a large sheet of aluminum foil into a pan with 2-inch-high sides to fit the bottom of your air fryer. Spray with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat air fryer to 390 degrees F (200 degrees C) for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll pizza dough into 1-inch balls, and place in a single layer in the aluminum foil pan. Sprinkle with pepperoni, oregano, red pepper, and garlic salt. Brush with melted butter and sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pan in the bottom of the air fryer and cook for 15 minutes. Sprinkle bread with mozzarella cheese and cook until cheese is melted and bubbling, about 2 more minutes. Remove from air fryer using tongs to pull the sides of the pan up and out of the machine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
