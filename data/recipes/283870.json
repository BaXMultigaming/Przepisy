  "ingredients": [
    "6 ears corn",
    "5 medium plum tomatoes, seeded and chopped",
    "0.5 medium red onion, chopped",
    "0.5 medium red bell pepper, chopped",
    "2 medium green onions, sliced",
    "2 tablespoons chopped fresh cilantro",
    "3 tablespoons olive oil",
    "2 tablespoons lemon juice",
    "1 tablespoon white sugar",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook corn, covered, on the preheated grill until golden brown in spots, flipping occasionally, 10 to 12 minutes. Cool until easily handled; cut kernels from cobs. Place in a large bowl; add tomatoes, red onion, bell pepper, green onions, and cilantro and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, lemon juice, sugar, cayenne pepper, salt, and black pepper in a small bowl; stir into corn salad until well mixed. Chill until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
