  "ingredients": [
    "1 cup shortening",
    "0.5 cup white sugar",
    "1 cup packed dark brown sugar",
    "2 teaspoons vanilla extract",
    "2 eggs",
    "2 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1.5 cups beer nut mix"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream the shortening and the sugar until light. Add the eggs (room temperature) and the vanilla and mix well. Combine the flour, salt, and baking soda. Add this to the creamed mixture. Stir in the nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop about 2 teaspoons per each cookies onto greased cookie sheets. Bake for about 11 minutes, or until firm. Cool for about 3 minutes on the sheet and then remove to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
