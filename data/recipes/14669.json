  "ingredients": [
    "1 (17.5 ounce) package frozen puff pastry, thawed",
    "4 tablespoons olive oil",
    "1 cup chopped onion",
    "1 teaspoon minced garlic",
    "1 cup raw porcini mushrooms",
    "1 cup chopped carrots",
    "0.5 cup chopped celery",
    "1 potato, diced",
    "1 pound beef tenderloin, cubed",
    "1 bay leaf",
    "1 teaspoon dried oregano",
    "1 cup dry Marsala wine",
    "2 tablespoons chopped fresh parsley",
    "1 egg white"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, cook bay leaf, oregano, onions and mushrooms in olive oil until soft. Stir in garlic, carrots, celery, potatoes, and meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir for 10 minutes, or until meat starts to brown. Pour in wine. Bring to a boil, and reduce heat to simmer. Simmer for 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in pie dish, sprinkle with parsley, and cover with pastry. Brush with egg whites.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 45 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
