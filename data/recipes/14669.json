  "title": "Beef Pot Pie I",
  "description": "This version of a traditional family favorite calls for beef tenderloin, and includes porcini mushrooms, carrots, celery, and potatoes. Packaged puff pastry makes the topping.",
  "authors": [
    "Maryellen"
  ],
  "date_published": "1999-10-14T21:10:32-04:00",
  "date_modified": "2022-07-14T18:04:44-04:00",
