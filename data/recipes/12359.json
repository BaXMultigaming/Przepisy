  "ingredients": [
    "6 apples - peeled, cored and sliced",
    "0.75 cup white sugar",
    "1 tablespoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.75 cup packed brown sugar",
    "0.5 cup all-purpose flour",
    "3 teaspoons ground cinnamon",
    "0.25 cup butter",
    "1 recipe pastry for a 9 inch single crust pie"
  ],
  "steps": [
    {
      "text": "Mix the white sugar 1 tablespoon of the cinnamon and the nutmeg together in a small bowl. Layer apples then sugar mixture. Then repeat the layering until out of apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the flour and brown sugar and cinnamon and butter. Use a fork until it becomes crumbly. Sprinkle mixture on top of apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 425 degree F (220 degree C) oven for 40-50 minutes. Cover the top for the remaining 15 minutes to avoid over browning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
