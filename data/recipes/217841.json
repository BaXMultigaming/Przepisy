  "steps": [
    {
      "text": "Stir yellow and white corn, Mexican-style corn, sour cream, mayonnaise, green onion, green chiles, adobo seasoning, seasoned salt, chili powder, and minced garlic together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
