  "ingredients": [
    "2 cups tri-color rotini pasta",
    "2 Granny Smith apples - peeled, cored, and diced",
    "2 fresh figs, chopped",
    "0.5 cup diced red onion",
    "0.25 cup chopped fresh basil",
    "3 tablespoons sliced black olives",
    "3 tablespoons chopped fresh mint",
    "1 clove garlic, minced",
    "0.5 cup mayonnaise",
    "0.25 cup grated Pecorino Romano cheese",
    "2 tablespoons sour cream",
    "1 tablespoon white sugar",
    "1 tablespoon apple cider vinegar",
    "1 lime, zested and juiced",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil; cook rotini at a boil until tender yet firm to the bite, about 8 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix apples, figs, onion, basil, black olives, mint, and garlic together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, Pecorino Romano cheese, sour cream, sugar, vinegar, lime zest and juice, salt, and pepper together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked rotini to apple mixture, stir, and pour dressing on top. Mix well and refrigerate, covered, for at least 30 minutes. Serve chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
