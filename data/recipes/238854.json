  "ingredients": [
    "1 pound peeled and deveined shrimp",
    "0.25 cup Sriracha chile sauce",
    "1 teaspoon smoked paprika",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon chili powder",
    "0.5 teaspoon ground cumin"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put shrimp in a large bowl; add chile sauce, paprika, garlic powder, onion powder, chili powder, and cumin and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place shrimp onto the preheated grill using large tongs and cook until they are bright pink on the outside and the meat is no longer transparent in the center, 3 to 4 minutes.",
