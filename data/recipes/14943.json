  "ingredients": [
    "1 pound ground beef",
    "1 pound sausage",
    "2 pounds processed cheese, shredded",
    "1 (16 ounce) jar salsa",
    "1 bunch green onions, chopped"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef and sausage in the hot skillet until browned and crumbly, 7 to 10 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the meat is cooking, combine processed cheese, salsa, and green onions in another large skillet over low heat. Stir constantly until cheese melts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir meat into the melted cheese mixture until incorporated. Simmer, uncovered, for a few more minutes or until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
