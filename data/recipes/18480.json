  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 cup butter, softened",
    "0.5 cup white sugar",
    "2 large eggs, separated",
    "1.5 teaspoons grated lemon zest",
    "0.5 cup white sugar",
    "2 teaspoons cornstarch",
    "2.25 cups red currants"
  ],
  "steps": [
    {
      "text": "Make the dough: Sift flour and baking powder into a medium bowl. Mix in butter, sugar, egg yolks, and lemon zest until a dough forms. Cover and let rest in a cool place for 30 minutes. Set egg whites aside for the filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease the bottom and sides of a 10-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into a 10-inch circle; place into the prepared springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make the filling: Beat reserved egg whites in a glass, metal, or ceramic bowl until stiff. Gradually mix in sugar and cornstarch, then beat for 5 minutes. Fold in currants, then pour over crust in the springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake until top is lightly browned, about 10 minutes. Cool to room temperature before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
