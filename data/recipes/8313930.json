  "title": "Italian Fig Cookies (Cuccidati)",
  "description": "Cuccidati are rich fig-stuffed Italian cookies dipped in frosting and decorated with sprinkles for a delicious Christmas treat. Perfect for gifting!",
  "authors": [
    "Nicole McLaughlin"
  ],
  "date_published": "2021-12-06T11:56:42-05:00",
  "date_modified": "2026-06-10T05:43:24-04:00",
