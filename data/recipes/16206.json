  "ingredients": [
    "3 cups matzo farfel",
    "2 onions, chopped",
    "1 pound mushrooms, chopped",
    "2 tablespoons vegetable oil",
    "1 teaspoon dried dill weed",
    "1 pinch garlic powder",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x12-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a colander in the sink. Add farfel to colander; pour boiling water over it.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sauté onions and mushrooms in oil in a large skillet; stir in dill, garlic powder, salt, and pepper. Remove from heat; stir in farfel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
