  "ingredients": [
    "1.5 pounds unpeeled potatoes, cut into 1-inch chunks",
    "2 tablespoons olive oil",
    "1 teaspoon kosher salt",
    "0.25 teaspoon black pepper",
    "0.5 cup grated Parmesan cheese",
    "0.25 teaspoon dried thyme leaves"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes into a mixing bowl and drizzle with olive oil. Sprinkle with kosher salt, black pepper, Parmesan cheese, and thyme leaves. Toss to evenly coat, and transfer to a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are golden brown on the edges and tender when pierced with a fork, about 1 hour. Serve hot or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
