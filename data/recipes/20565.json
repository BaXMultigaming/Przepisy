  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "0.5 cup white sugar",
    "2 eggs",
    "0.5 teaspoon vanilla extract",
    "1 cup raspberry jam",
    "2 cups frozen whipped topping, thawed",
    "1 (9 inch) graham cracker crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine cream cheese, sugar, eggs, and vanilla. Beat until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into graham cracker pie crust. Bake in the preheated oven for 25 minutes. Allow to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the topping: In a medium bowl, fold the raspberry jam into the whipped topping. Spread over top of cooled cheesecake and refrigerate for approximately 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
