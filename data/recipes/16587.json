  "ingredients": [
    "1 (6 ounce) can crab meat, drained",
    "5 ounces sharp processed cheese spread",
    "0.25 cup butter, softened",
    "2 tablespoons mayonnaise",
    "2 tablespoons chopped fresh parsley",
    "1 pinch garlic salt",
    "6 English muffins, split in half"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix crabmeat, cheese spread, butter, mayonnaise, parsley, and garlic salt together in a mixing bowl until well combined. Spread mixture evenly over English muffin halves. Cut each muffin half into quarters and transfer to the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Turn on the broiler and broil until muffins are toasted, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
