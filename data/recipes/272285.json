  "ingredients": [
    "3 tablespoons soy sauce",
    "4 teaspoons all-purpose flour",
    "14 ounces chicken breasts, cut into bite-sized pieces",
    "0.33333334326744 cup water",
    "2 tablespoons fish sauce",
    "2 tablespoons brown sugar",
    "2 teaspoons tamarind paste",
    "2 tablespoons olive oil",
    "3 cloves garlic, minced",
    "1 fresh green chile pepper, or more to taste",
    "0.5 teaspoon grated ginger"
  ],
  "steps": [
    {
      "text": "Mix soy sauce and flour together in a large bowl until blended. Add chicken and mix until coated.",
      "section": null,
      "name": null,
      "url": null,
