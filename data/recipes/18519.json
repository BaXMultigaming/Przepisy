  "ingredients": [
    "3 medium russet potatoes",
    "0.25 cup olive oil",
    "salt to taste",
    "0.5 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave the potatoes on high power for 5 minutes. Cool slightly and cut potatoes in half lengthwise, then cut each half into 4 wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle potatoes with oil; sprinkle with paprika and salt. Arrange in a single layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 40 to 45 minutes, until crispy and browned.",
      "section": null,
