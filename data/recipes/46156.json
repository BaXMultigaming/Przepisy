  "ingredients": [
    "0.5 cup minced shallots",
    "2 tablespoons minced garlic",
    "1.5 cups dry white wine",
    "1 cup heavy cream",
    "1 teaspoon curry powder",
    "32 mussels - cleaned and debearded",
    "0.25 cup butter",
    "0.25 cup minced parsley",
    "0.25 cup chopped green onions"
  ],
  "steps": [
    {
      "text": "In a large saucepan, cook shallots and garlic in simmering wine until translucent.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in cream and curry powder. When sauce is heated through, add mussels. Cover, and steam mussels for a few minutes, until their shells open wide. With a slotted spoon, transfer steamed mussels to a bowl, leaving the sauce in the pan. Discard any unopened mussels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk butter into the cream sauce. Turn heat off, and stir in parsley and green onions. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
