  "ingredients": [
    "1.5 cups boiling water",
    "0.5 cup white sugar",
    "0.25 lemon",
    "8 whole cloves",
    "1 (3 inch) cinnamon stick",
    "1 (750 milliliter) bottle claret wine",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
