  "title": "Easy Chocolate Zucchini Bread",
  "description": "This chocolate zucchini bread recipe uses shredded zucchini, cocoa, and chocolate chips to make an extra chocolaty moist and fudgy quick bread.",
  "authors": [
    "Shanna"
  ],
  "date_published": "2000-07-27T23:20:05-04:00",
