  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "3 cups all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "1 tablespoon ground cinnamon",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "1 teaspoon salt",
    "2 cups white sugar",
    "3 eggs",
    "1 cup vegetable oil",
    "2 teaspoons vanilla extract",
    "2 cups shredded zucchini",
    "1 cup chopped walnuts",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qIIFKDLMo7q61_42pOS4gcwIdNU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23443-chocolate-zucchini-bread-ii-DDMFS-Step-01-d3f82f5832e44aa1b9c8662378428b94.jpg"
      ],
      "image": "assets/images/23443/step_01.webp"
    },
    {
      "text": "Combine flour, cocoa, cinnamon, baking soda, baking powder, and salt in large bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DjkIACBR39xaqHAqZxxLCKdcAgA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23443-chocolate-zucchini-bread-ii-DDMFS-Step-02-43e9061a5f3648409908ed3bcc84695a.jpg"
      ],
      "image": "assets/images/23443/step_02.webp"
    },
    {
      "text": "Combine sugar and eggs in a separate bowl; beat until well blended. Add oil and vanilla; beat until combined. Stir in zucchini.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oy9eOTgYxpvlINF2uGkvFCbLV7c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23443-chocolate-zucchini-bread-ii-DDMFS-Step-03-5705912b5e6f42a291ceb0f03fbb90a8.jpg"
      ],
      "image": "assets/images/23443/step_03.webp"
    },
    {
      "text": "Add flour mixture; stir just until moistened. Stir in nuts and chocolate chips. Spoon evenly into prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3W3r42-OrQDW1uOCEPh34sVo-Es=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23443-chocolate-zucchini-bread-ii-DDMFS-Step-04-918b42095a97446cacce961a6a002313.jpg"
      ],
      "image": "assets/images/23443/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 55 to 60 minutes. Cool bread in the pans for 10 minutes, then transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HmSUxeuzOWg_rfFC9L3IPNbKo7g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23443-chocolate-zucchini-bread-ii-DDMFS-Step-05-78e5364d60b54f62a0be3849012589e6.jpg"
      ],
      "image": "assets/images/23443/step_05.webp"
    }
  ],
