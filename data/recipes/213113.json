  "ingredients": [
    "1 pinch saffron",
    "2 tablespoons warm milk",
    "1.5 quarts vanilla ice cream, softened",
    "1.5 tablespoons rose syrup",
    "0.5 teaspoon ground cardamom",
    "0.25 cup chopped pistachio nuts"
  ],
  "steps": [
    {
      "text": "Add the saffron to the warm milk and set aside for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the softened ice cream, saffron with milk, rose syrup, cardamom, and pistachios in a large bowl. Stir until the ice cream is smooth and pink in color. Scoop the ice cream back into the container and freeze 2 hours, or until ready to eat.",
