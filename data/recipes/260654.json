  "ingredients": [
    "1 egg",
    "1 cup persimmon pulp",
    "0.5 cup canola oil",
    "0.33333334326744 cup milk",
    "2 cups all-purpose flour",
    "0.5 cup walnuts",
    "0.33333334326744 cup white sugar",
    "1 teaspoon salt",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a bowl. Stir in persimmon pulp, oil, and milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, walnuts, sugar, salt, baking powder, and cinnamon in a separate bowl. Stir flour mixture into persimmon mixture; mix until just moistened. Fill muffin cups 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and tops spring back when lightly touched, 19 to 20 minutes.",
      "section": null,
