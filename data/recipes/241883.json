  "ingredients": [
    "2 cups plain croutons",
    "2 cups shredded Cheddar cheese",
    "4 slices cooked bacon, crumbled",
    "3 eggs, beaten",
    "0.5 teaspoon prepared yellow mustard",
    "0.125 teaspoon onion powder",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Mix croutons, Cheddar cheese, and bacon together in a bowl; transfer to an 11x7-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, mustard, onion powder, and black pepper together in a bowl; pour over croutons mixture. Cover dish with plastic wrap and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Remove plastic wrap from dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted near the center comes out clean, about 45 minutes. Let casserole stand for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
