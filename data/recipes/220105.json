  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.33333334326744 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "1 (16 ounce) container frozen whipped topping, thawed",
    "1 (9 inch) prepared graham cracker crust",
    "0.5 cup strawberry preserves"
  ],
  "steps": [
    {
      "text": "Beat together the cream cheese, sugar, and vanilla extract in a large bowl with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat in the whipped topping until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread about half of the cream cheese mixture into the graham cracker crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the strawberry preserves in an even layer over the cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top the preserves with the remaining half of the cream cheese filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover with plastic wrap and refrigerate until set, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
