  "ingredients": [
    "1 pound spaghetti",
    "1 pound lean ground beef",
    "1 (15 ounce) can sloppy joe sauce",
    "0.5 green bell pepper, diced",
    "0.5 onion, chopped",
    "0.5 cup Italian-style dried bread crumbs",
    "0.25 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Stir in sauce, bell pepper, and onion; cook and stir until onion and bell pepper are tender, about 5 minutes. Remove from the heat; mix in bread crumbs and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sauce to pasta; toss to coat and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
