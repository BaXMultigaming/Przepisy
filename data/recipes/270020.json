  "ingredients": [
    "5 cups water",
    "3 tablespoons chicken soup base",
    "1 pound egg noodles",
    "1.5 pounds boneless chicken breast cut into 1-inch cubes",
    "1.5 cups frozen peas",
    "1 cup chopped carrot",
    "1 tablespoon ginger",
    "1 teaspoon ground mustard",
    "1 teaspoon garlic salt"
  ],
  "steps": [
    {
      "text": "Combine water and soup base in a 2-quart pan and bring to a boil, about 5 minutes. Add noodles. Add chicken, peas, and carrots. Add ginger, mustard, and salt. Boil soup until noodles are tender, about 10 minutes more.",
