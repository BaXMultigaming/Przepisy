  "ingredients": [
    "2 cups apple cider",
    "0.33333334326744 cup brown sugar",
    "2 tablespoons ground cinnamon",
    "1 tablespoon lemon juice",
    "1 teaspoon ground nutmeg",
    "6 skinless, boneless chicken breast halves"
