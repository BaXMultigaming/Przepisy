    },
    {
      "text": "Whisk apple cider, brown sugar, cinnamon, lemon juice, and nutmeg together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken breasts in a single layer in the bottom of a large casserole dish. Pour apple juice mixture over chicken breasts. Cover casserole dish with aluminum foil.",
