  "ingredients": [
    "8 ears corn, shucked",
    "2 medium green onions, chopped",
    "1 medium jalapeno pepper, diced",
    "1 clove garlic, minced",
    "0.25 cup mayonnaise",
    "0.25 cup sour cream",
    "2 tablespoons lime juice",
    "1 tablespoon Mexican-style hot sauce (such as Valentina®)",
    "3 tablespoons chopped cilantro",
    "1.5 teaspoons ground ancho chile powder",
    "0.33333334326744 cup crumbled cotija cheese"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook corn on the preheated grill for 10 minutes, turning every 2 minutes; transfer to a cutting board and cool for 5 minutes. Cut kernels from cobs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Add onions and jalapeño; cook about 4 minutes. Add garlic; cook for 1 minute. Reduce heat to low; stir in mayonnaise, sour cream, lime juice, and hot sauce and cook for 2 minutes. Stir in corn; cook until heated through, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, stir in cilantro. Transfer dip to a serving dish. Sprinkle chile powder over top; garnish with cotija cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
