  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Spray a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk honey, brown sugar, Dijon mustard, balsamic vinegar, water, olive oil, and garlic together in a large bowl. Add chicken legs and toss to coat. Place chicken legs on the prepared baking sheet; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until juices run clear, 30 to 35 minutes. Turn over and cook longer if needed.",
      "section": null,
