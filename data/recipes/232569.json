  "ingredients": [
    "0.5 cup softened butter",
    "0.33333334326744 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour, or as needed",
    "1 (8 ounce) package cream cheese, softened",
    "1 egg",
    "0.25 cup white sugar",
    "1 tablespoon vanilla extract",
    "4 cups peeled and sliced apples",
    "0.33333334326744 cup white sugar",
    "2 tablespoons ground cinnamon",
    "0.25 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter, 1/3 cup sugar, and 1 teaspoon vanilla extract in a bowl. Stir flour into mixture to make a workable dough. You might not need all the flour. Press the crust into a 9-inch pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese with egg, 1/4 cup sugar, and 1 tablespoon vanilla extract in a bowl. Pour cream cheese mixture into pie crust. Toss sliced apples with 1/3 cup sugar and cinnamon; top the cream cheese filling with the apple mixture. Sprinkle with sliced almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pie in the preheated oven for 10 minutes. Reduce oven temperature to 350 degrees F (175 degrees C) and continue baking until the filling is set, 20 to 25 more minutes. Cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
