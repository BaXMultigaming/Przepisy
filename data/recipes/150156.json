  "ingredients": [
    "1 (16 ounce) package egg noodles",
    "3.5 slices smoked bacon",
    "2 cups sour cream",
    "1 (12 ounce) container cottage cheese",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook egg noodles in boiling water until al dente, 8 to 10 minutes. Drain well and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels. Crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place drained noodles in a large baking dish. Stir in sour cream until well combined. Spoon cottage cheese evenly over the top of noodle mixture. Sprinkle with crumbled bacon; season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cottage cheese softens, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
