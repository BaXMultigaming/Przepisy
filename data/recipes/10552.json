  "ingredients": [
    "1 cup butter, softened",
    "0.75 cup white sugar",
    "0.75 cup packed brown sugar",
    "1 teaspoon vanilla extract",
    "2 large eggs",
    "2.25 cups all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "2 cups semisweet chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fp9cV0rVdIQNGrIpLo0g_KkxEyE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-10552-GiantChocolateChipCookie-ddmfs-Step1-3x4-6483-2-64d58419553245eba5f91825dbdf54fd.jpg"
      ],
      "image": "assets/images/10552/step_01.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 14-inch round pizza pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, brown sugar, and vanilla in a large bowl with an electric mixer on medium speed until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0XXJa0PWaCvJbCL7NNRJBUzvuHA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-10552-GiantChocolateChipCookie-ddmfs-Step2-3x4-6486-2-5db320e597914d8bb545a4244a82bb6a.jpg"
      ],
      "image": "assets/images/10552/step_03.webp"
    },
    {
      "text": "Beat in eggs, one at a time, mixing well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yPZE_ih9Yo3FAOMvkAUwrAElVBM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-10552-GiantChocolateChipCookie-ddmfs-Step3-3x4-6489-2-000d77a9a7144aa79d1db9f66b0fd158.jpg"
      ],
      "image": "assets/images/10552/step_04.webp"
    },
    {
      "text": "Gradually add flour, salt, and baking soda, beating until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SncyaxFwm31hqXeOz6BOAXwbDDk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-10552-GiantChocolateChipCookie-ddmfs-Step4-3x4-6490-2-f7d0b0c34c744d7f83b5adb08b7f9787.jpg"
      ],
      "image": "assets/images/10552/step_05.webp"
    },
    {
      "text": "Stir in chocolate chips and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B2K9h1sclJ-uGjj_8U1SnyKUhLg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-10552-GiantChocolateChipCookie-ddmfs-Step5-3x4-6494-2-0edeafaf612940cc9987aeef1a24f286.jpg"
      ],
      "image": "assets/images/10552/step_06.webp"
    },
    {
      "text": "Spread dough evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SG2iD5K9fIAkNGA_xLuj6HmwI4o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-10552-GiantChocolateChipCookie-ddmfs-Step6-3x4-6496-2-698241acb795489dafa27f33e5ce2ade.jpg"
      ],
      "image": "assets/images/10552/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes. Cool cookie in the pan on a cooling rack. Decorate as desired.",
      "section": null,
      "name": null,
      "url": null,
