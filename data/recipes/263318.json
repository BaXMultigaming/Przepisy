  "ingredients": [
    "0.5 medium head red cabbage, shredded",
    "1 teaspoon salt",
    "2 red apples, thinly sliced",
    "2 tablespoons white balsamic vinegar",
    "2 tablespoons liquid honey",
    "2 tablespoons rapeseed oil"
  ],
  "steps": [
    {
      "text": "Combine red cabbage and salt in a bowl and knead with your hands for a few minutes until cabbage is soft. Mix in apples.",
