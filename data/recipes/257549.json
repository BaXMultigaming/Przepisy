  "ingredients": [
    "3.5 cups milk",
    "2 cups old-fashioned oats",
    "1 cup sweetened coconut",
    "0.5 cup packed brown sugar",
    "2 eggs, beaten",
    "0.5 cup golden raisins",
    "0.33333334326744 cup semisweet chocolate chips",
    "2 teaspoons vanilla extract",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine milk, oats, coconut, brown sugar, beaten eggs, golden raisins, chocolate chips, vanilla extract, and salt in a large bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into a 1.8-quart baking dish. Cover and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are firm and center is still slightly soft, about 45 minutes. Stir before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
