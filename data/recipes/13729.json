  "ingredients": [
    "2 (15 ounce) cans sweet potatoes",
    "0.25 cup orange juice",
    "0.75 cup all-purpose flour",
    "0.5 cup white sugar",
    "1 teaspoon ground cinnamon",
    "1 pinch salt",
    "0.5 cup margarine",
    "1.5 cups miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sweet potatoes in a 6x10-inch shallow baking dish. Drizzle with orange juice and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O3UvAMXtO0UQjj6NUwZ407MGNFA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13729-thanksgiving-sweet-potatoes-DDMFS-step-01-4a164ecf7ea943a2a573b28734c4e983.jpg"
      ],
      "image": "assets/images/13729/step_02.webp"
    },
    {
      "text": "Mix together flour, sugar, cinnamon, and salt in a medium bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A5b5OsPRXy8luWsybNzK8SvPFVw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13729-thanksgiving-sweet-potatoes-DDMFS-step-02-65a65b300a104c0dacf80e13e2a0ff6f.jpg"
      ],
      "image": "assets/images/13729/step_03.webp"
    },
    {
      "text": "Cut in margarine with 2 knives or a pastry blender until mixture resembles coarse crumbs; sprinkle evenly over sweet potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TqEH_eCqxFQZXRgdP7G9KX8tC-o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13729-thanksgiving-sweet-potatoes-DDMFS-step-03-d9643c5bb3fa45b096909cb6c49f6850.jpg"
      ],
      "image": "assets/images/13729/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V96mXdD-DMyy9S507wBoEAICj4U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13729-thanksgiving-sweet-potatoes-DDMFS-step-04-6c9bd377ecb94c118581141f3ec2408d.jpg"
      ],
      "image": "assets/images/13729/step_05.webp"
    },
    {
      "text": "Remove casserole from the oven and turn on the broiler. Sprinkle marshmallows evenly over the top of casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gTW1PV3TUF18eVukBL4-gRJYKvE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13729-thanksgiving-sweet-potatoes-DDMFS-step-05-fba54b9d70524a219f247c462ef7fb98.jpg"
      ],
      "image": "assets/images/13729/step_06.webp"
    },
    {
      "text": "Cook under the broiler until marshmallows are puffed and golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tor4Os0O8xvoGNf21X2thXq3DPE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13729-thanksgiving-sweet-potatoes-DDMFS-step-06-2b2628d6a2fa45bda1ab8015da1ff271.jpg"
