  "ingredients": [
    "1 tablespoon olive oil",
    "1 onion, chopped",
    "1 large green bell pepper, chopped",
    "1 bunch green onions, chopped",
    "1 jalapeno pepper, chopped",
    "4 large cloves garlic, minced",
    "2.5 pounds boneless country-style pork ribs, cut into 3/4-inch pieces",
    "1.5 cups fresh sweet cherries, pitted and cut into quarters",
    "1 lime, juiced",
    "2 tablespoons chopped fresh cilantro",
    "1 teaspoon chili powder",
    "0.5 teaspoon cumin",
    "0.25 teaspoon onion powder",
    "3 tablespoons honey",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat. Stir in onion, bell pepper, green onions, jalapeño, and garlic; cook until soft, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in pork, cherries, lime juice, cilantro, chili powder, cumin, and onion powder; mix well. Bring to a boil, cover, and reduce heat to a simmer; cook until vegetables and cherries release their juices, and pork is cooked through and no longer pink, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in honey; season with salt and black pepper. Simmer, uncovered, until sauce reduces and pork is tender, about 30 minutes more (sauce won't be extremely thick).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
