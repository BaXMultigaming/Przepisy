  "ingredients": [
    "0.5 cup chopped walnuts",
    "1 cup dates, pitted and chopped",
    "1 cup chopped dried figs",
    "0.25 cup unsalted butter, softened",
    "1.5 teaspoons baking soda",
    "1 cup boiling water",
    "0.5 cup white sugar",
    "2 large eggs, room temperature",
    "0.75 cup all-purpose flour",
    "0.75 cup whole wheat flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x4-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread walnuts onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until toasted and fragrant, 5 to 10 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix dates, figs, butter, and baking soda together in a bowl. Pour boiling water over the date mixture. Let sit for figs to slightly rehydrate, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, walnuts, and eggs into date mixture. Whisk all-purpose flour, whole wheat flour, salt, and baking soda together in a separate bowl. Stir flour mixture into date mixture until batter is just combined. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 55 to 65 minutes. Cool in the pan for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
