  "ingredients": [
    "0.5 cup milk",
    "0.5 cup white sugar",
    "1 egg, beaten",
    "2 tablespoons vegetable oil",
    "1 cup all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "2 cups mulberries",
    "0.75 cup all-purpose flour",
    "0.5 cup brown sugar",
    "0.25 cup white sugar",
    "3 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 8x8-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk, 1/2 cup white sugar, egg, and oil in a bowl. Add 1 cup flour, baking powder, and salt; mix until smooth. Pour into baking pan; sprinkle with mulberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 3/4 cup flour, brown sugar, and 1/4 cup white sugar in a bowl; cut in butter and stir until mixture resembles crumbs, about 2 minutes. Sprinkle over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
