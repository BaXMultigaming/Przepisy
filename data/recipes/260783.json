  "ingredients": [
    "0.5 cup unsweetened cocoa powder",
    "0.5 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.0625 teaspoon cayenne pepper",
    "2 cups confectioners' sugar",
    "3 egg whites",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon salt",
    "1 cup miniature marshmallows (such as Kraft® Jet-Puffed)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper. Grease parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cocoa powder, white sugar, cinnamon, and cayenne pepper in a bowl. Mix in confectioners' sugar, egg whites, vanilla extract, and salt until the dough is smooth. Fold in marshmallows.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded tablespoons onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, rotating halfway through baking, until edges are set, 10 to 12 minutes. Cool on baking sheets. Remove carefully, as centers are soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
