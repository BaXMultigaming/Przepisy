  "ingredients": [
    "1 cup butter, softened",
    "0.75 cup tightly packed dark brown sugar",
    "0.5 cup white sugar",
    "2 eggs",
    "1 tablespoon molasses",
    "1.5 teaspoons vanilla extract",
    "1.5 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.5 cups rolled oats",
    "1 cup cinnamon chips (such as Hershey's®)",
    "2 cups confectioners' sugar",
    "0.5 cup butter, softened",
    "1 tablespoon heavy whipping cream, or more as needed",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 cup butter, brown sugar, white sugar, eggs, molasses, and 1 ½ teaspoons vanilla extract in a large bowl with an electric mixer until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cinnamon, baking soda, and salt in a separate bowl; stir into butter mixture. Fold in oats and cinnamon chips until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoonfuls of dough onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges start to brown, 10 to 12 minutes. Transfer to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat confectioners' sugar, ½ cup butter, heavy cream, and 1 teaspoon vanilla extract in the bowl of a stand mixer fitted with the paddle attachment on high speed until light and fluffy, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1 teaspoon cream filling over half cookies; top with remaining cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
