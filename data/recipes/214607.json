  "ingredients": [
    "2 pounds kielbasa sausage, cut into 1/4-inch slices",
    "1 (12 ounce) bottle tomato-based chili sauce (such as Heinz®)",
    "1 (12 ounce) jar red currant jelly",
    "0.5 cup water",
    "1 tablespoon crushed red pepper flakes"
  ],
  "steps": [
    {
      "text": "Stir sausage, chili sauce, red currant jelly, water, and pepper flakes together in a slow cooker. Cover slow cooker. Cook on Low, at least 4 hours, stirring once every hour.",
