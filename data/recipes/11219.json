  "ingredients": [
    "1 cup packed brown sugar",
    "0.5 cup white sugar",
    "0.5 cup butter, softened",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "0.75 cup all-purpose flour",
    "5 cups cornflakes cereal",
    "1.5 cups flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream the butter with the brown sugar and white sugars. Add the eggs and the vanilla and beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in the flour until well combined. Stir in the corn flakes and the coconut. Drop by teaspoonfuls onto a parchment lined baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
