  "ingredients": [
    "4 cups fresh blackberries",
    "1 cup white sugar",
    "1 cup water",
    "0.25 cup cornstarch",
    "1 teaspoon lemon juice",
    "1.5 cups all-purpose flour",
    "0.75 cup light brown sugar",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground cinnamon",
    "0.75 cup unsalted butter, cut into pieces",
    "1 prepared pastry for a single-crust pie"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Smash blackberries in a bowl until they are mostly liquid, with only a few chunks remaining.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring sugar, water, cornstarch, and lemon juice to a boil in a saucepan over high heat: stir and cook for 3 minutes. Off heat, mix in blackberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, salt, and cinnamon in a bowl. Add butter: mix until crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press pie pastry into a pie pan. Add blackberry filling; top with crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the bottom of the crust is cooked and golden, 40 to 50 minutes. Cool, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
