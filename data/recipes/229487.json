  "ingredients": [
    "2 pounds ground beef",
    "0.5 cup chopped onion",
    "0.25 cup chopped celery",
    "7 ounces ketchup",
    "1 tablespoon brown sugar",
    "1.5 teaspoons Worcestershire sauce",
    "1 teaspoon vinegar",
    "0.25 teaspoon dry mustard powder",
