  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "1 cup sour cream",
    "4 eggs",
    "0.66666668653488 cup vegetable oil",
    "1 cup brown sugar",
    "3.5 teaspoons ground cinnamon",
    "3 cups confectioners' sugar",
    "0.75 cup milk",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ok93AHwK7V5qpkx4re6CVM4KWfc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-257023-grandmas-honey-bun-cake-VAT-step-01-2e53f9d324764fe8b920c94e50b538e7.jpg"
      ],
      "image": "assets/images/257023/step_01.webp"
    },
    {
      "text": "Beat cake mix, sour cream, eggs, and oil together in a bowl with an electric mixer for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mdB6iUJJtc8HybyBR86W9Z333ng=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-257023-grandmas-honey-bun-cake-VAT-step-02-de6625e4d0ce40379b1b594ef610ac70.jpg"
      ],
      "image": "assets/images/257023/step_02.webp"
    },
    {
      "text": "Pour 1/2 batter into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q0r86SbNzioZf8WJu-h-gpezF5Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-257023-grandmas-honey-bun-cake-VAT-step-03-f9335b73e2934a5e8f55a780e2041b82.jpg"
      ],
      "image": "assets/images/257023/step_03.webp"
    },
    {
      "text": "Combine brown sugar and cinnamon in a small bowl; sprinkle over batter in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KObxszyayXqchtsdpne52yOWhyc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-257023-grandmas-honey-bun-cake-VAT-step-04-ca9d2ce6b6c44df28a2f86370b3083eb.jpg"
      ],
      "image": "assets/images/257023/step_04.webp"
    },
    {
      "text": "Carefully pour remaining 1/2 batter over brown sugar-cinnamon layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LqGDMigb4bZg1KG-qtjWda5SDKE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-257023-grandmas-honey-bun-cake-VAT-step-05-3e839c07afd44cdab7364297c89d3ee3.jpg"
      ],
      "image": "assets/images/257023/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ay8W2qXvusDENEr0N28a07wGPl8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-257023-grandmas-honey-bun-cake-VAT-step-06-9eb8171ae31742d9be6c1d74ded6a143.jpg"
      ],
      "image": "assets/images/257023/step_06.webp"
    },
    {
      "text": "Combine confectioners' sugar, milk, and vanilla in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t4hqIXEa0lBQyxaEgeq-uDS0PQ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-257023-grandmas-honey-bun-cake-VAT-step-07-dff253af291349a296578bddad26b505.jpg"
      ],
      "image": "assets/images/257023/step_07.webp"
    },
    {
      "text": "Poke holes in hot cake with a fork; pour confectioners' sugar mixture over top of cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oWVuimG7n_i5pRPFtPEMZZ7SpVg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-257023-grandmas-honey-bun-cake-VAT-step-08-1e9d9a30c93f4c27a4162f1ff57cdbb1.jpg"
      ],
      "image": "assets/images/257023/step_08.webp"
    },
    {
      "text": "Cool cake completely before serving, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JvfNUhKZyXftR0OPF98P8-aV6zM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-257023-grandmas-honey-bun-cake-VAT-step-09-f1a4c424da8548bbada0b8c06130b4cd.jpg"
      ],
