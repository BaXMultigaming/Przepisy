  "ingredients": [
    "1 cup unsweetened applesauce",
    "0.75 cup white sugar",
    "3 cups oats",
    "1 cup plain soy milk",
    "1 tablespoon baking powder",
    "0.25 teaspoon baking powder",
    "1 teaspoon vegetable oil",
    "0.5 teaspoon sea salt",
    "0.5 cup raisins",
    "1 tablespoon brown sugar, or more to taste",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Lightly grease a pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat applesauce and white sugar together in a bowl. Add oats, soy milk, 1 tablespoon plus 1/4 teaspoon baking powder, vegetable oil, and sea salt; mix well. Fold raisins into oat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour oat mixture into the prepared pie pan; top with brown sugar and cinnamon. Refrigerate for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until oatmeal is firm, 35 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
