  "title": "Chef John's Coq au Vin",
  "description": "Coq au vin is a classic French stew made with hearty bone-in chicken thighs braised slowly in a rich red wine broth with bacon, mushrooms, and thyme.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2014-09-03T18:14:22-04:00",
  "date_modified": "2026-03-11T14:51:24-04:00",
  "prep_time": "PT15M",
  "cook_time": "PT90M",
  "total_time": "PT105M",
  "yield": [
    "6"
  ],
  "categories": [
