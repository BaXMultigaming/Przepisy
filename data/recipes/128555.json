  "ingredients": [
    "1 (16 ounce) package egg noodles",
    "2 cups sour cream",
    "2 cups creamy whipped cottage cheese",
    "1 cup raisins",
    "1 cup white sugar, divided",
    "2 eggs, beaten",
    "0.5 cup butter",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 10 to 12 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss cooked noodles with sour cream, cottage cheese, raisins, 1/2 cup sugar, and eggs until well blended; pour into the prepared baking dish. Dot top with butter pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1/2 cup sugar and cinnamon; sprinkle over noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is lightly brown, about 45 minutes. Remove from oven; cool to set pudding before serving, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
