  "ingredients": [
    "1.5 tablespoons hoisin sauce",
    "1 tablespoon soy sauce",
    "2 teaspoons sesame oil",
    "1 clove garlic, minced",
    "1 (8 ounce) package fresh green beans, trimmed"
  ],
  "steps": [
    {
      "text": "Whisk hoisin sauce, soy sauce, sesame oil, and garlic together in a bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring about 4 cups water to a boil in a large deep skillet. Add green beans and boil for 3 minutes. Drain green beans and run under cold water for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring hoisin mixture to a simmer in the same skillet over medium-high heat. Add green beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Saute until desired doneness, about 5 minutes.",
      "section": null,
