  "title": "Spicy Lentil Nachos",
  "description": "Layers of spicy lentils, black beans and corn, salsa, and cheese on tortilla chips make budget-friendly, meatless snack for game time or anytime.",
  "authors": [
    "thomlynn61601"
  ],
