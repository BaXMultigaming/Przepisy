  "ingredients": [
    "1.5 cups milk",
    "1 (5 ounce) package instant vanilla pudding mix",
    "1.5 cups flaked coconut",
    "1 (8 ounce) container frozen whipped topping, thawed",
    "1 (9 inch) pie shell, baked"
  ],
  "steps": [
    {
      "text": "Whisk together milk and pudding mix in a large bowl until mixture starts to thicken, about 2 minutes. Fold in 1 cup coconut and 1/2 of the whipped topping until well combined. Pour filling into baked pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread remaining whipped topping over filling. Sprinkle with remaining 1/2 cup coconut. Refrigerate pie and serve chilled.",
      "section": null,
