  "ingredients": [
    "2 tablespoons all-purpose flour",
    "1 teaspoon salt",
    "0.5 teaspoon celery salt",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon garlic salt",
    "0.25 teaspoon black pepper",
    "3 pounds chuck roast, cut into 2-inch pieces",
    "2 tablespoons bacon drippings",
    "3 medium onions, chopped",
    "1 (14.5 ounce) can diced tomatoes",
    "0.5 cup molasses",
    "0.5 cup water",
    "0.33333334326744 cup red wine vinegar",
    "6 carrots, chopped",
    "0.5 cup raisins",
    "4 cups cooked rice"
  ],
  "steps": [
    {
      "text": "Combine flour, salt, celery salt, ginger, garlic salt, and pepper in a small bowl. Sprinkle mixture evenly over beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat bacon drippings in a large, heavy-bottomed pot over medium-high heat. Add seasoned beef and brown, stirring as necessary. Drain excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onions, diced tomatoes, molasses, water, and vinegar. Bring to a boil, then cover and simmer for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add carrots and raisins; simmer until carrots are tender, about 30 minutes. Serve with steamed rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
