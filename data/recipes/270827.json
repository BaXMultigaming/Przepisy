  "ingredients": [
    "1 cup low-fat (1%) cottage cheese",
    "1 tablespoon maple syrup, or to taste",
    "2 tablespoons pineapple juice",
    "0.25 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon",
    "1 pinch ground nutmeg",
    "1 pinch ground allspice",
    "2 ounces pineapple chunks, drained",
    "1 banana, sliced",
    "3 tablespoons toasted pecans, chopped",
    "0.25 cup unsweetened coconut, toasted"
  ],
  "steps": [
    {
      "text": "Stir cottage cheese, maple syrup, pineapple juice, vanilla extract, cinnamon, nutmeg, and allspice together in a bowl until thoroughly combined. Divide between 2 bowls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top each bowl with pineapple chunks, banana slices, pecans, and coconut. Serve immediately.",
