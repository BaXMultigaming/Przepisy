  "ingredients": [
    "1 eggplant, cubed",
    "olive oil, divided",
    "salt to taste",
    "1 pint grape tomatoes, halved",
    "0.5 red onion, thinly sliced",
    "1 teaspoon lemon juice, or to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss eggplant with 1 tablespoon olive oil and sprinkle with salt. Place onto a baking sheet and arrange in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil eggplant in the preheated oven, until browned on all sides, 5 to 7 minutes, turning occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cooked eggplant to a large bowl. Add tomatoes and onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1 tablespoon olive oil, lemon juice, salt, and pepper in a bowl. Pour dressing over salad.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
