  "ingredients": [
    "4 cups blanched green peas",
    "0.5 cup mayonnaise",
    "0.5 cup sour cream",
    "2 tablespoons prepared horseradish",
    "1 tablespoon Dijon-style prepared mustard",
    "0.25 cup chopped fresh dill weed",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gently pat peas with a paper towel to absorb any excess moisture. Place peas in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In small bowl combine the mayonnaise, sour cream, horseradish, mustard and 3 tablespoons dill weed. Add to peas and toss to coat. Sprinkle remaining dill over top. Cover and chill for at least 2 hours before serving.",
      "section": null,
