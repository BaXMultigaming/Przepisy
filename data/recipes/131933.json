  "ingredients": [
    "2 cups fresh orange juice",
    "2 cups unsweetened pineapple juice",
    "1 cup simple syrup",
    "1 cup coconut-flavored rum",
    "1 cup 151 proof rum",
    "0.5 cup grenadine syrup",
    "0.5 cup fruit-flavored rum liqueur",
    "8 cups shaved ice",
    "8 maraschino cherries for garnish",
    "8 orange slices for garnish"
  ],
  "steps": [
    {
      "text": "Stir orange juice, pineapple juice, simple syrup, coconut-flavored rum, 151-proof rum, grenadine syrup, and fruit-flavored liqueur together in a 2-quart or larger pitcher. Refrigerate for at least 2 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 cup of crushed ice in each of eight 12-ounce glasses. Pour about 1 cup of rum mixture into each glass. Garnish each glass with a maraschino cherry and an orange slice.",
