  "ingredients": [
    "1.5 cups packed brown sugar",
    "1 cup shortening",
    "1 egg",
    "2 cups prepared mincemeat pie filling",
    "3.25 cups all-purpose flour",
    "0.25 teaspoon salt",
    "1.5 teaspoons baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter together in a large mixing bowl with an electric mixer until light and fluffy; add egg and mix well. Stir in mincemeat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, salt, and baking soda together; stir into mincemeat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoonfuls, about 2 inches apart, on prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden brown, about 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
