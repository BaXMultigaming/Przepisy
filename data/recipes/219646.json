  "title": "Authentic Mexican Chile Rellenos",
  "description": "Chile relleno recipe that's authentic and delicious; Anaheim chiles are stuffed with Mexican cheese, dipped in flour and egg, then fried until golden.",
  "authors": [
    "Kentucky Guera"
  ],
  "date_published": "2019-04-02T02:55:55-04:00",
