  "ingredients": [
    "2 cups water",
    "1 cup uncooked long-grain white rice",
    "1 (16 ounce) can refried beans",
    "salt to taste",
    "garlic powder to taste",
    "1 tablespoon olive oil",
    "2 small onions, chopped",
    "4 beef steaks",
    "2 avocados - peeled, pitted and sliced"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat, and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan, bring water to a boil. Stir in rice, reduce heat, cover, and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place refried beans in a medium saucepan over medium heat, and season with salt and garlic powder. Cook, stirring occasionally, until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a medium skillet over medium heat. Saute onions until browned and tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On the prepared grill, cook steaks 7 to 10 minutes, to an internal temperature of 145 degrees F (65 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread steaks with refried beans, and top with onions and avocado slices. Serve over rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
