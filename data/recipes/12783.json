  "ingredients": [
    "6 cups water, or more as needed",
    "1 cup white sugar",
    "2 tablespoons salt",
    "6 (6 ounce) fillets cod",
    "1.5 cups butter, melted",
    "1 dash paprika"
  ],
  "steps": [
    {
      "text": "Preheat the broiler. Lightly grease a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together water, sugar, and salt in a large saucepan. Add fillets to water mixture; add more water to fully submerge fillets if needed. Bring water to a boil over medium-high heat. Boil for 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove fillets from water and blot dry on paper towels. Brush with 6 tablespoons melted butter; sprinkle with paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated broiler until fillets are golden brown, 8 to 10 minutes per inch of thickness. Serve with remaining melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
