  "ingredients": [
    "2 cups granulated sugar",
    "1 pound walnut halves",
    "0.25 cup brandy",
    "1 teaspoon vanilla extract",
    "2 teaspoons ground cinnamon",
    "3 fluid ounces orange juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, toss 1 cup of sugar with remaining ingredients and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture on to a cookie sheet, spread evenly, and bake for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven and sprinkle remaining 1 cup of sugar over the top and mix. Allow walnuts to cool before serving.",
