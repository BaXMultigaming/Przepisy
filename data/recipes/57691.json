  "ingredients": [
    "3 cups sliced peaches",
    "2 cups huckleberries",
    "0.66666668653488 cup white sugar",
    "0.25 cup cornstarch",
    "2 tablespoons butter",
    "1 cup all-purpose flour",
    "1/4 cup white sugar",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.25 cup rolled oats",
    "1 teaspoon grated lemon zest",
    "0.25 teaspoon ground cinnamon",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine peaches and huckleberries in an ungreased 2-quart casserole dish; stir in ⅔ cup sugar and cornstarch to coat. Dot fruit with 2 tablespoons butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, ¼ cup sugar, baking powder, and salt together in a bowl; stir in oats, lemon zest, and cinnamon. Cut in remaining 4 tablespoons butter with 2 knives or a pastry blender until mixture resembles coarse crumbs; stir in milk until a stiff batter forms. Spoon batter over fruit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fruit is bubbling and topping is golden brown, about 30 minutes. Cool about 15 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
