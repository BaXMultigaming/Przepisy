  "ingredients": [
    "nonstick cooking spray",
    "2 medium ripe avocados, peeled and pitted",
    "1 (15 ounce) can pumpkin puree",
    "0.75 cup white sugar",
    "1 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "1 tablespoon pumpkin pie spice",
    "1.5 teaspoons baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 12-cup muffin tin with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree avocado flesh in a food processor or blender. Transfer to a large bowl and mix in pumpkin puree, sugar, and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift in flour, pumpkin pie spice, baking powder, and salt; beat until well combined. Spoon batter into the prepared muffin cups, filling each 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 25 minutes. Cool in the tin for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
