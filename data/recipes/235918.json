  "ingredients": [
    "cooking spray",
    "1 (16 ounce) package bulk pork sausage",
    "2 cups half-and-half",
    "1 cup baking mix (such as Bisquick®)",
    "6 eggs",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray 12 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir sausage in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and transfer sausage to prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix half-and-half, baking mix, eggs, salt, and black pepper together in a bowl; pour over sausage. Top each muffin with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through and cheese is melted, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
