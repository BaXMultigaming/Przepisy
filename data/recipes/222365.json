  "ingredients": [
    "1.5 cups fresh pumpkin seeds",
    "0.5 cup whiskey (such as Jack Daniel's®)",
    "2 tablespoons bacon drippings",
    "1 tablespoon dark brown sugar",
    "2 teaspoons salt, plus more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin seeds, whiskey, bacon drippings, brown sugar, and 2 teaspoons salt together in a saucepan over medium-low heat; bring to a simmer and cook until seeds begin to turn gray in the middle, 15 to 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pumpkin seeds on a baking sheet in a single layer; season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until crisp and golden brown, 1 to 1 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
