  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 green bell pepper, seeded and cubed",
    "1 red bell pepper, seeded and cubed",
    "0.25 cup sliced sweet onions",
    "0.75 pound skinless, boneless chicken breast, cut into strips",
    "2.5 teaspoons Caribbean jerk seasoning",
    "0.5 cup plum sauce",
    "1 tablespoon soy sauce",
    "0.25 cup chopped roasted peanuts"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook and stir bell pepper and onion in hot oil until slightly tender, 5 to 7 minutes; transfer onto a plate and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken to the same skillet and season with jerk seasoning; cook and stir until chicken is cooked through and no longer pink inside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return bell peppers and onions to the skillet and pour in plum sauce; toss to combine. Cook until peppers and onions are heated through, 3 to 5 minutes. Sprinkle with soy sauce and chopped peanuts to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
