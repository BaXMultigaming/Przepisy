  "ingredients": [
    "4 cups chicken broth",
    "0.5 cup mushrooms, diced",
    "0.25 cup shredded cooked chicken",
    "3 tablespoons soy sauce",
    "1 tablespoon chile-garlic paste (sambal oelek)",
    "2 cloves garlic, minced",
    "3 ounces firm tofu, drained, cut into 1/4-inch cubes",
    "0.33333334326744 cup canned bamboo shoots, cut into matchsticks",
    "0.25 cup white vinegar",
    "0.25 teaspoon ground white pepper, or to taste",
    "2 tablespoons cold water",
    "2 tablespoons cornstarch",
    "1 egg",
    "2 green onions, diced",
    "1 teaspoon toasted sesame oil"
  ],
  "steps": [
    {
      "text": "Bring chicken broth to a simmer in a 2-quart saucepan. Add mushrooms, chicken, soy sauce, chile paste, and garlic. Simmer for 5 minutes. Add tofu, bamboo shoots, vinegar, and white pepper. Simmer for 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cold water and cornstarch in a cup; stir until smooth. Pour into soup and stir well. Let simmer until soup thickens, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a cup and slowly pour, in a fine stream, into soup. Stir well and heat through for 30 seconds. Mix in green onions and sesame oil. Remove from heat; serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
