  "ingredients": [
    "0.25 cup butter",
    "garlic powder, or to taste",
    "2 hoagie rolls",
    "8 thin slices mozzarella cheese",
    "2 cups cold cooked spaghetti",
    "1 cup spaghetti sauce"
  ],
  "steps": [
    {
      "text": "Melt butter with garlic powder in a large skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut a slice of the crust off the top and bottom of each hoagie roll. Brush the cut sides with some of the garlic-flavored butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Split the rolls and line the insides with mozzarella cheese slices. Mix spaghetti and spaghetti sauce together in a bowl; divide between the hoagie rolls and sandwich the rolls around the cheese and pasta mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill the sandwiches in the skillet until the cheese melts completely, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
