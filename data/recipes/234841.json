  "ingredients": [
    "1 apple - peeled, cored, and sliced",
    "1 cup strawberries",
    "1 cup blackberries",
    "1 cup fresh raspberries",
    "0.5 cup sliced rhubarb",
    "2 tablespoons lemon juice",
    "2 tablespoons white sugar, or more to taste",
    "1 (15 ounce) package pastry for a 9-inch double crust pie"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir apple, strawberries, blackberries, raspberries, and rhubarb together in a bowl. Pour lemon juice and sprinkle sugar over fruit mixture and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a 9-inch pie pan with prepared pie pastry. Turn apple mixture into pie pan. Cover with remaining pie pastry and pinch and crimp edges to seal the crusts. Cut several air holes into the top of the pastry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden and fruit is tender and bubbling, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
