  "ingredients": [
    "0.66666668653488 cup uncooked white rice",
    "1.3333330154419 cups water",
    "0.75 cup black beans, drained and rinsed",
    "1 large tomato, seeded and diced",
    "0.75 cup shredded Cheddar cheese",
    "0.33333334326744 cup sliced green onions",
    "0.33333334326744 cup vegetable oil",
    "0.25 cup vinegar",
    "1 tablespoon diced jalapeno peppers",
    "0.5 teaspoon white sugar",
    "salt to taste",
    "1 avocado - peeled, pitted and diced"
