  "ingredients": [
    "0.5 cup all-purpose flour",
    "0.25 cup white sugar",
    "1 tablespoon cornstarch",
    "0.25 teaspoon baking powder",
    "1 pinch salt, or more to taste",
    "1.5 teaspoons coconut oil",
    "3 tablespoons milk",
    "1 tablespoon sour cream",
    "0.5 teaspoon vanilla extract",
    "0.25 cup crushed pistachios",
    "0.25 cup shredded unsweetened coconut",
    "1 teaspoon white sugar",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, 1/4 cup sugar, cornstarch, baking powder, and salt together in a bowl. Rub coconut oil into flour mixture using your hands until mixture is crumbly. Add milk, sour cream, and vanilla extract and mix just until dough is combined; fold in pistachios and coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop dough, about 1 teaspoon per cookie, and form into balls; arrange on the prepared baking sheet about 1-inch apart. Mix 1 teaspoon sugar and cinnamon together in a bowl; sprinkle over dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges turn light brown, 10 to 12 minutes. Cool cookies on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
