  "title": "Concord Grape Crumble Pie",
  "description": "This flavorful Concord grape pie is topped with a homemade buttery, crisp oat topping that lets the juicy filling shine through.",
  "authors": [
    "Terri"
  ],
  "date_published": "1999-09-25T23:37:04-04:00",
