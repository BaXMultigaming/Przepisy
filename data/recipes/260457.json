  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8-inch square casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine baked beans, ketchup, cooked bacon, brown sugar, and mustard powder in a bowl. Pour mixture into the prepared dish. Arrange bacon strips on top. Cover with aluminum foil.",
