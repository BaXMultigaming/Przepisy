  "ingredients": [
    "0.5 cup butter",
    "1.25 cups white sugar",
    "2 eggs",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.25 cup milk",
    "2.5 cups fresh blueberries",
    "0.25 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease and flour muffin pans or use paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream butter and 1 1/4 cup sugar until light and fluffy. Add eggs one at a time and mix in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder and salt. Add flour mixture, alternating with milk. Mash 1/2 cup berries and stir into batter. Fold in remaining berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill muffin cups and sprinkle with the remaining 1/4 cup of sugar. Bake at 375 degrees F (190 degrees C) for 30 minutes. Remove from oven and wait 20 minutes to remove from pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
