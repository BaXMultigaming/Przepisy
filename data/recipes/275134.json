  "ingredients": [
    "1 medium head cabbage",
    "2 pounds ground pork",
    "1 large yellow onion, diced",
    "8 ounces mushrooms, sliced",
    "1 tablespoon minced garlic",
    "1 tablespoon finely grated fresh ginger",
    "0.25 cup soy sauce",
    "1 tablespoon apple cider vinegar",
    "1 tablespoon sesame oil",
    "2 medium green onions, chopped"
  ],
  "steps": [
    {
      "text": "Remove any damaged cabbage leaves from head. Set aside 6 larger leaves to use for serving. Dice remaining cabbage head and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brown ground pork in a large skillet over medium-high heat, about 5 minutes. Add diced cabbage, onion, mushrooms, garlic, and ginger to the skillet and reduce heat to medium. Continue to cook and stir until onion has softened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with soy sauce, vinegar, and sesame oil. Stir to combine and allow flavors to meld, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set out cabbage leaves and fill with pork mixture. Garnish with green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
