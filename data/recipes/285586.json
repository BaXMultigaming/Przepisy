  "ingredients": [
    "1 (16 ounce) package ziti",
    "1 tablespoon olive oil",
    "2 cups cubed butternut squash",
    "1 tablespoon minced fresh garlic",
    "2 teaspoons rubbed dried sage",
    "1 teaspoon dried thyme",
    "1.5 cups heavy cream",
    "1 cup fresh spinach leaves",
    "0.25 cup grated Parmesan cheese, or more to taste",
    "salt and ground black pepper to taste",
    "3 tablespoons chopped walnuts"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook, stirring occasionally, until tender yet firm to the bite, 10 to 11 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NBb0NtF4wkuyvtRB_NRssmBhTPo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/285586-creamy-butternut-squash-pasta-VAT-step-01-5a10dadf9b14437cad02e1defd04cbe1.jpg"
      ],
      "image": "assets/images/285586/step_01.webp"
    },
    {
      "text": "Meanwhile, heat olive oil in a large skillet over medium heat. Add squash and sauté until fork-tender, 10 to 15 minutes. Add garlic, sage, and thyme; cook until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HnIdgGsdTW0gbSphaaIvamzfNFo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/285586-creamy-butternut-squash-pasta-VAT-step-02-72db1ed7100342718d240f59371422a3.jpg"
      ],
      "image": "assets/images/285586/step_02.webp"
    },
    {
      "text": "Fold in cream and spinach; bring to a simmer. Add 1/4 cup Parmesan cheese and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GGn5yTfPqttedy9Bm5RKrZUhB8Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/285586-creamy-butternut-squash-pasta-VAT-step-03-aca6efac150147918a8190e049f9e341.jpg"
      ],
      "image": "assets/images/285586/step_03.webp"
    },
    {
      "text": "Add ziti and toss until evenly coated. Cook until sauce has thickened, 1 to 3 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dVx1IkvvUrmfwNCfUUOv3i4VO-U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/285586-creamy-butternut-squash-pasta-VAT-step-04-0bfbc5b936584b268dcb9f3ea85d2ee1.jpg"
      ],
      "image": "assets/images/285586/step_04.webp"
    },
    {
      "text": "Divide between 8 bowls. Top with walnuts and more Parmesan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_0ZYbx4FjyiMTHXIYl72PH9_AJ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/285586-creamy-butternut-squash-pasta-VAT-step-05-83a221507d374a21bbb4a45eee9a9ec3.jpg"
