  "ingredients": [
    "cooking spray",
    "5 small zucchini, quartered lengthwise and cut crosswise into 1/2-inch slices",
    "2 cups cooked basmati rice",
    "0.75 cup shredded Havarti cheese",
    "0.25 cup shredded Parmesan cheese",
    "1 cup milk",
    "4 large eggs, separated, divided",
    "2 teaspoons Sriracha sauce",
    "1 teaspoon salt",
    "0.5 teaspoon black pepper",
    "0.25 cup panko bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly spray a shallow 2-quart baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine zucchini, cooked rice, Havarti, and Parmesan in a large bowl. Blend milk, egg yolks, Sriracha, salt, and pepper in a smaller bowl, then pour over the rice mixture and mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until stiff but not dry. Fold into the egg yolk-rice mixture. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes. Sprinkle panko across the top and continue to bake until browned and set, about 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
