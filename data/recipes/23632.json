  "ingredients": [
    "2 cups uncooked white rice",
    "1 tablespoon butter",
    "2 skinless, boneless chicken breast halves - cubed",
    "salt to taste",
    "2 eggs, beaten",
    "0.75 cup sliced mushrooms",
    "2 green onions, chopped",
    "1 tablespoon soy sauce, or to taste"
  ],
  "steps": [
    {
      "text": "In a saucepan bring 4 cups water to a boil. Add rice and stir. Reduce heat, cover and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a large skillet over medium-high heat. Brown chicken in butter and season with salt to taste. Set chicken aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cooked rice to the skillet in which the chicken was cooked, stirring to brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate skillet, scramble eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To the rice add chicken, mushrooms, green onions, eggs and soy sauce to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
