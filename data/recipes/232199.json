  "ingredients": [
    "2 (8 ounce) cans pineapple tidbits, drained",
    "1 large mango, diced",
    "2 green onions, chopped",
    "0.5 medium red bell pepper, diced",
    "2 tablespoons chopped cilantro",
    "1 tablespoon red wine vinegar",
    "0.25 teaspoon salt",
    "Reynolds Wrap® Non-Stick Foil",
    "0.25 cup butter, melted",
    "0.5 teaspoon salt",
    "0.25 teaspoon cayenne pepper, or to taste",
    "4 (5 ounce) fish fillets, fresh or thawed",
    "0.5 cup finely chopped pecans",
    "0.5 cup shredded coconut",
    "2 tablespoons plain dry bread crumbs"
  ],
  "steps": [
    {
      "text": "Combine pineapple, mango, green onions, bell pepper, cilantro, red wine vinegar, and ¼ teaspoon salt in a bowl; chill until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Line a 15 ½x10 ½x1-inch baking sheet with nonstick foil (with the dull, nonstick, side that will touch food up); set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, ½ teaspoon salt, and cayenne pepper in a large bowl. Add fish; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pecans, coconut, and bread crumbs in a bowl; spread onto a sheet of wax paper. Press fish into pecan mixture, turning to evenly coat; press in additional pecan mixture as necessary. Place fish in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven just until fish is opaque throughout, 15 to 20 minutes. Serve with salsa.",
      "section": null,
      "name": null,
      "url": null,
