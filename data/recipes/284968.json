  "title": "Vegan Energy Balls",
  "description": "Who needs chocolate? These vegan energy balls with protein powder, nuts, and seeds are sweetened with agave and dried apple slices and rolled in a tasty cinnamon-almond coating.",
  "authors": [
    "Kameron"
  ],
  "date_published": "2010-03-10T00:35:44-05:00",
