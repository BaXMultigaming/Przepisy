  "ingredients": [
    "2 tablespoons ground almonds",
    "2 teaspoons ground cinnamon",
    "0.75 cup almond butter",
    "0.25 cup agave syrup",
    "2 tablespoons hemp protein powder",
    "2 tablespoons shredded coconut",
    "1 tablespoon raw coconut sap",
    "0.25 teaspoon ground nutmeg",
    "2 tablespoons pumpkin seeds",
    "2 tablespoons flax seeds",
    "2 tablespoons sesame seeds",
    "2 tablespoons sunflower seeds",
    "10 dried apple slices, chopped",
    "0.25 cup finely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Combine ground almonds and cinnamon in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix almond butter, agave syrup, and protein powder together in a bowl. Add shredded coconut, coconut sap, and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin, flax, and sesame seeds in the bowl of a food processor; pulse until blended. Add to almond butter mixture along with sunflower seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mince dried apple in the food processor. Add to almond butter mixture along with walnuts. Form into 1-inch balls and roll in the almond-cinnamon mixture to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in the freezer to firm up and store.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
