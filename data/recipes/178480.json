  "ingredients": [
    "0.5 cup apple cider vinegar",
    "0.33333334326744 cup packed dark brown sugar",
    "1 teaspoon dry mustard",
    "2 teaspoons celery seed",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon dried dill weed",
    "1 cup sour cream",
    "0.5 cup mayonnaise",
    "1 teaspoon prepared horseradish",
    "salt to taste",
    "1 small head red cabbage, shredded",
    "2 yellow bell pepper, cut into 1/4 inch strips",
    "2 green zucchini, cut into 1/4 inch strips"
  ],
  "steps": [
    {
      "text": "Whisk together cider vinegar, dark brown sugar, dry mustard, celery seed, cayenne pepper, dill, sour cream, mayonnaise, horseradish and salt. Cover and refrigerate for 2 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to serve, place the cabbage, bell pepper, and zucchini in a large bowl. Pour the dressing over the vegetables and toss to coat (see notes).",
