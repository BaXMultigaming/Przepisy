  "ingredients": [
    "1 tablespoon butter",
    "24 marshmallows",
    "0.5 cup milk",
    "0.5 cup canned pumpkin",
    "1 teaspoon vanilla extract",
    "1 teaspoon pumpkin pie spice",
    "0.33333334326744 cup confectioners' sugar",
    "1 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet; stir in marshmallows, milk, and pumpkin. Stir frequently until melted and smooth. Remove from heat; stir in vanilla and pumpkin pie spice. Cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/3 cup confectioners' sugar and 1 cup heavy cream in a large bowl. Use an electric mixer to beat until stiff peaks form. Fold whipped cream into cooled pumpkin mixture. Pour mousse into ramekins or chocolate shells. Cover and refrigerate until firm, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
