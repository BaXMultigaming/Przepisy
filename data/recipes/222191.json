  "title": "Lamb Braised in Pomegranate",
  "description": "Chef John braises lamb chops in pomegranate juice in this beautiful dish. Serve on polenta, potatoes, or rice.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-05-03T15:51:08-04:00",
