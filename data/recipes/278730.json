  "title": "Gluten-Free Scalloped Potatoes",
  "description": "These gluten-free scalloped potatoes with a tasty cheese sauce start out in the microwave and then finish baking in the oven.",
  "authors": [
    "Marcia"
  ],
  "date_published": "2020-02-24T18:37:57-05:00",
