  "ingredients": [
    "1 tablespoon tahini",
    "1.5 cups boiling water",
    "2 teaspoons whole anise seeds",
    "1.5 cups white sugar",
    "3 cups all-purpose flour",
    "2 teaspoons ground turmeric",
    "1.5 teaspoons baking powder",
    "1.25 teaspoons anise seed powder",
    "0.5 cup vegetable oil",
    "0.5 cup unsalted butter, melted",
    "2 tablespoons pine nuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x13-inch baking pan with tahini.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine boiling water and anise seeds in a glass measuring cup; steep, about 5 minutes. Strain into a bowl; discard anise seeds. Stir sugar into anise-flavored water until dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, turmeric, baking powder, and anise seed powder together in a bowl; make a well in the center. Add oil and butter to the well; stir in sweetened anise-flavored water until batter is the consistency of thick yogurt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared baking pan; score top into diamond shapes using the tip of a knife. Place 1 pine nut in center of each diamond.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
