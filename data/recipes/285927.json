  "ingredients": [
    "1 cup crushed shortbread cookies",
    "3 tablespoons unsalted butter, melted",
    "1 tablespoon white sugar",
    "1 (8 ounce) package reduced-fat cream cheese",
    "0.5 cup low-fat plain Greek yogurt",
    "0.5 cup sweetened condensed milk",
    "2 tablespoons fresh lemon juice",
    "1 teaspoon almond extract",
    "1 pinch salt",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Combine shortbread cookie crumbs, butter, and sugar in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, yogurt, condensed milk, lemon juice, almond extract, and a pinch of salt in a bowl. Using an electric mixer, beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add about 1 tablespoon of cookie mixture to the bottom of four 8-ounce canning jars or small dessert dishes. Spoon or pipe in a layer of the cream cheese mixture, followed by a layer of cherry pie filling. Repeat this layering once more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Move desserts to the refrigerator to chill for at least 30 minutes or longer before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
