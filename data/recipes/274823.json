  "ingredients": [
    "1 (14.75 ounce) can salmon, drained and bones removed",
    "1 small onion, minced",
    "2 cloves garlic, minced",
    "2 sprigs fresh dill, finely chopped",
    "1 sprig fresh parsley, finely chopped",
    "1 teaspoon chopped fresh chives",
    "2 eggs",
    "6 tablespoons Japanese-style panko bread crumbs",
    "0.25 teaspoon lemon-pepper seasoning (such as Goya®)",
    "0.25 teaspoon ground black pepper",
    "0.25 cup cooking oil"
  ],
  "steps": [
    {
      "text": "Break up salmon into fine pieces and place in a medium bowl. Add onion, garlic, dill, parsley, and chives. Crack both eggs into the bowl. Mix in bread crumbs, lemon-pepper seasoning, and pepper until thoroughly combined. Form salmon patties with a 1/4-cup scoop; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a frying pan over medium heat. Place patties in pan and fry until golden brown on both sides, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
