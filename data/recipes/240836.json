  "ingredients": [
    "1 tablespoon bacon drippings",
    "1 cup minced onion",
    "1 large red apple, diced",
    "1 teaspoon caraway seeds",
    "2 pounds sauerkraut, drained and rinsed",
    "0.5 cup dry white wine",
    "0.5 cup chicken stock",
    "2 tablespoons brown sugar",
    "2 pounds boneless pork loin roast",
    "1 pound kielbasa sausage, cut into 3-inch pieces"
  ],
  "steps": [
    {
      "text": "Heat bacon drippings in a Dutch oven over medium heat. Cook and stir onion in hot drippings until soft and translucent, about 5 minutes. Stir in apple and caraway seeds and cook until apple is just tender, about 3 minutes more. Stir in sauerkraut until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together white wine, chicken stock, and brown sugar in a medium bowl; pour over sauerkraut mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork roast into a slow cooker. Pour sauerkraut mixture over the top of pork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until pork easily falls apart when pulled with a fork, 6 to 8 hours. Add sausage and continue to cook until sausage is heated through, 15 to 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
