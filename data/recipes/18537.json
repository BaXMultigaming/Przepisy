        "https://www.allrecipes.com/thmb/-Pm6bKlxCVLEEW_NnXWm5xcvYzI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/yummy-yam-casserole-photo-by-den-4014662-1f6f10f90bc148d893b13eeb6bc5067e.jpg"
      ],
