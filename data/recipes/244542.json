  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix, divided",
    "0.25 cup butter, softened",
    "1 egg, lightly beaten",
    "0.75 cup packed brown sugar",
    "0.75 cup dark corn syrup",
    "3 eggs",
    "1 teaspoon vanilla extract",
    "1.25 cups coarsely chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set aside 1 cup cake mix to be used for filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix remaining cake mix, butter, and 1 lightly beaten egg together in a bowl until crumbly; press into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly browned, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, corn syrup, 3 eggs, and vanilla extract together in a bowl; add the reserved 1 cup cake mix and stir until well blended. Spread mixture evenly over crust and top with pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling appears to be set when gently shaken, 25 to 30 minutes. Cool completely before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
