  "title": "Easy Pecan Bars",
  "description": "Easy pecan bars, that taste just like pecan pie, are quick to prepare thanks to yellow cake mix used for the crust and in the filling.",
  "authors": [
    "JonG"
  ],
  "date_published": "2020-03-05T00:13:26-05:00",
