  "ingredients": [
    "1 Reynolds® Slow Cooker Liner",
    "1 pound beef stew meat, cut into 1-inch pieces",
    "2 tablespoons all-purpose flour",
    "1 tablespoon canola oil",
    "1 (15 ounce) can black beans, rinsed and drained",
    "2 medium carrots, peeled and chopped",
    "1 medium onion, chopped",
    "2 cloves garlic, minced",
    "1 (14.5 ounce) can diced tomatoes, undrained",
    "1 (14.5 ounce) can reduced-sodium beef broth",
    "1.5 teaspoons chili powder",
    "1 teaspoon ground cumin",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 cup frozen whole kernel corn",
    "0.25 cup Chopped avocado, cilantro, and/or crushed red pepper"
  ],
  "steps": [
    {
      "text": "Line a 5- to 6-quart slow cooker with a Reynolds slow cooker liner. Coat beef with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add beef; cook and stir until browned, about 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beans, carrots, onion, and garlic into the prepared slow cooker liner. Top with browned beef. Add tomatoes, broth, chili powder, cumin, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on low for 7 hours or until the beef is fork-tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in corn gently with a rubber spatula. Cover and cook 10 minutes more or until heated through. If desired, serve with avocado, cilantro, and/or crushed red pepper.",
      "section": null,
      "name": null,
      "url": null,
