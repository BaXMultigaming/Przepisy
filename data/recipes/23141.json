  "ingredients": [
    "1.5 cups pumpkin puree",
    "1 (12 fluid ounce) can evaporated milk",
    "2 eggs",
    "0.75 cup white sugar",
    "1 tablespoon all-purpose flour",
    "0.5 teaspoon salt",
    "1.25 teaspoons vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine pumpkin, evaporated milk, eggs, sugar, flour, salt vanilla, and cinnamon. Pour filling into pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 minutes in the oven then turn the oven temperature down to 350 degrees F (175 degrees C). Continue baking 40 more minutes or until a knife inserted in center comes out clean. Cool completely on a wire rack before serving.",
      "section": null,
      "name": null,
      "url": null,
