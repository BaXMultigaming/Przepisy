  "ingredients": [
    "4 cups all-purpose flour",
    "2 cups very soft butter",
    "3.5 cups chopped pecans",
    "0.25 cup confectioners' sugar",
    "1 cup confectioners' sugar for rolling"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash together the flour, butter, pecans, and 1/4 cup of confectioners' sugar in a bowl until the mixture is thoroughly combined and forms a soft dough. Pinch off about 2 teaspoons of dough per cookie, and roll into 3/4-inch balls. Place the balls on ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the bottoms of the cookies are lightly golden brown but the tops are still pale, 8 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let the cookies cool completely, then roll in remaining confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
