  "ingredients": [
    "1.5 cups white sugar, divided",
    "0.75 cup margarine, melted",
    "1 egg",
    "0.25 cup molasses",
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground ginger"
  ],
