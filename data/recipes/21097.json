  "ingredients": [
    "0.5 cup butter, softened",
    "0.33333334326744 cup masa harina",
    "0.25 cup water",
    "1.5 cups frozen corn kernels, thawed",
    "0.25 cup cornmeal",
    "0.33333334326744 cup white sugar",
    "2 tablespoons heavy cream",
    "0.25 teaspoon salt",
    "0.5 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat butter with an electric mixer until creamy. Beat in the masa harina and water until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put the corn in a blender or food processor and coarsely chop on low speed. Stir the corn and the cornmeal into the butter mixture. In another bowl, mix together the sugar, cream, salt and baking powder. Combine the two mixtures until well blended. Pour the batter into an ungreased 8x8 pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the pan with foil and place into a 9x13 inch pan filled 3/4 inch high with hot water. Bake in preheated oven for 50 to 60 minutes, until a toothpick inserted into center of the cake comes out clean. Remove small pan from water and let sit for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
