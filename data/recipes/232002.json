  "ingredients": [
    "1 cup butter",
    "1 cup brown sugar",
    "0.25 cup white sugar",
    "2 eggs",
    "1 (3.5 ounce) package vanilla pudding mix",
    "2 teaspoons vanilla extract",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2.75 cups quick oats",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar in a bowl until creamy; beat in eggs until smooth. Stir pudding mix into creamed mixture, followed by vanilla extract. Whisk flour, baking soda, and salt together in a separate bowl and stir flour mixture into moist ingredients. Mix oats and chocolate chips into dough. Press dough into prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 25 minutes. Let cool before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
