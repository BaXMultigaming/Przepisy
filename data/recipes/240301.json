  "ingredients": [
    "0.75 cup shortening",
    "0.75 cup butter, softened",
    "0.75 cup white sugar, or to taste",
    "2 eggs",
    "4 teaspoons vanilla extract",
    "4 cups all-purpose flour",
    "1 teaspoon salt",
    "0.5 cup chopped pecans",
    "2 tablespoons confectioners' sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s7i1ta49PoEjJaUeQfMgX6qLS_k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240301-grandma-mineccis-snowball-cookies-DDMFS-step-01-9b145f312fd04960bf3700363c3e0273.jpg"
      ],
      "image": "assets/images/240301/step_01.webp"
    },
    {
      "text": "Beat together shortening, butter, and white sugar in a large bowl using an electric mixer until smooth and creamy; add eggs and vanilla and beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XIp2e1tv4OpavcNqlKTK4F1eiRM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240301-grandma-mineccis-snowball-cookies-DDMFS-step-02-ceb0993ac1a241d49e486192a47fc06e.jpg"
      ],
      "image": "assets/images/240301/step_02.webp"
    },
    {
      "text": "Sift flour and salt into creamed butter mixture and stir just until dough is combined; fold in pecans. Shape dough into 1-inch balls and arrange on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4yOMLqmbR6YnyvvICgShLYbzrTE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240301-grandma-mineccis-snowball-cookies-DDMFS-step-03-e55bcb3b1b4148d5ad5ea5e1addfef7d.jpg"
      ],
      "image": "assets/images/240301/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 20 minutes. Cool cookies slightly, then roll in confectioners' sugar. Cool cookies completely and roll again in confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ptcvKDkSX_JleXm9Jaz-p4bVfP0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240301-grandma-mineccis-snowball-cookies-DDMFS-step-04-efbda779c6b74b0c951272db7216d5c5.jpg"
      ],
      "image": "assets/images/240301/step_04.webp"
    }
  ],
