  "ingredients": [
    "1 cup orange juice",
    "1 tablespoon soy sauce",
    "1 (1 ounce) envelope dry onion soup mix",
    "0.5 teaspoon garlic powder, or to taste",
    "8 chicken thighs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, stir together the orange juice, soy sauce, onion soup mix and garlic powder; set aside. Rinse chicken, and pat dry. Place chicken thighs into a 9x13 inch glass baking dish. Pour the orange juice mixture over.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, for 1 hour and 30 minutes in the preheated oven, basting every half hour. If using boneless chicken, reduce cooking time to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
