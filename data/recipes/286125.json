  "ingredients": [
    "1 tablespoon olive oil",
    "2 teaspoons grated orange zest",
    "1 teaspoon ground paprika",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground cumin",
    "0.25 teaspoon ground black pepper",
    "1 (2 1/2 pound) boneless pork sirloin roast"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil, orange zest, paprika, cinnamon, cumin, and pepper in a small bowl; mix to form a paste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Apply paste to the top and sides of the roast. Feel free to apply all around the roast if desired. Place pork in a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until an instant-read thermometer inserted into the thickest part of the roast reads 145 degrees F (63 degrees C), 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and tent with foil. Allow to rest at least 10 minutes before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
