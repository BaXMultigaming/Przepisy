  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups semisweet chocolate chips",
    "1 cup sweetened flaked coconut",
    "1 cup chopped pecans",
    "0.5 cup whole wheat flour",
    "0.5 cup oats",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 sticks unsalted butter, melted",
    "0.75 cup brown sugar",
    "0.75 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all-purpose flour, chocolate chips, pecans, coconut, whole wheat flour, oats, baking soda, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter, brown sugar, and white sugar until combined in a separate bowl; add eggs and vanilla. Add flour mixture and stir until combined. Press dough into an ungreased 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 13 minutes. Be careful not to overbake. Cool for 10 minutes before cutting into 1x2-inch bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
