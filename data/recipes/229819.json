  "ingredients": [
    "0.5 cup margarine",
    "1 cup firmly packed light brown sugar",
    "1 pinch salt",
    "0.5 cup light corn syrup",
    "0.66666668653488 cup sweetened condensed milk",
    "1.5 cups chopped pecans",
    "0.5 teaspoon vanilla extract",
    "1 (6 ounce) package semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt margarine in a saucepan over medium heat; stir brown sugar and salt into the melted margarine. Mix in corn syrup and sweetened condensed milk; cook, stirring occasionally, until mixture reaches 250 degrees F (120 degrees C), 15 to 20 minutes. Remove from heat; fold in pecans. Stir vanilla extract into the caramel mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of caramel onto the prepared baking sheet. Allow caramels to cool until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir chocolate chips in a saucepan over medium-low heat until melted and smooth, about 5 minutes. Remove from heat. Dip cooled caramels in the melted chocolate; return to greased baking sheet. Cool until chocolate is set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
