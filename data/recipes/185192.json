  "ingredients": [
    "2 sweet potatoes, peeled and chopped",
    "0.5 head cabbage, coarsely chopped",
    "1 cup chopped carrots",
    "1 pound turkey bratwurst, sliced",
    "0.5 teaspoon salt",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon dried rosemary",
    "0.5 teaspoon ground white pepper",
    "0.5 cup dry white wine",
    "3 cups chicken broth"
  ],
  "steps": [
    {
      "text": "Place the sweet potatoes, cabbage, and carrots into a slow cooker, then place the bratwurst slices on top of the vegetables. Sprinkle with the salt, thyme, rosemary, and pepper. Pour the wine and chicken broth over the vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until the sweet potatoes are easily pierced with a fork, 5 to 6 hours.",
