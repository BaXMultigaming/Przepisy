  "ingredients": [
    "3 cups chopped rhubarb",
    "0.25 cup water",
    "5 tablespoons maple syrup",
    "2 tablespoons chia seeds",
    "0.75 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine rhubarb, water, and maple syrup in a pot. Bring to a simmer over medium-low heat, stirring occasionally, until rhubarb is soft and water is absorbed, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and stir in chia seeds and vanilla extract. Let cool and pour into 2 small jars or a plastic container. Store in the fridge for up to 2 weeks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
