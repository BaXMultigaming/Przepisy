  "ingredients": [
    "5 (15 ounce) cans green beans, drained",
    "7 slices bacon",
    "0.66666668653488 cup brown sugar",
    "0.25 cup butter, melted",
    "7 teaspoons soy sauce",
    "1.5 teaspoons garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place drained green beans in a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bacon in a single layer on a microwave-safe plate. Cook in the microwave until slightly cooked, about 2 minutes. Lay bacon over green beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together brown sugar, melted butter, soy sauce, and garlic powder in a small bowl. Pour over green beans and bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven for 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
