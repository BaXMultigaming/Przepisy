  "ingredients": [
    "1 tablespoon butter",
    "3 slices bacon, chopped",
    "2 pounds beef short ribs, cut into 2 inch pieces",
    "1.5 teaspoons salt",
    "0.125 teaspoon ground black pepper",
    "1 cup beef broth",
    "2 tablespoons fresh lemon juice",
    "0.25 cup red wine",
    "0.125 teaspoon dried oregano, crushed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large heavy saucepan over medium heat, melt the butter and brown the bacon and beef short ribs, stirring constantly for about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer ribs and bacon to a 2 quart baking dish. Season with salt and pepper. Pour in the beef broth, lemon juice and red wine. Sprinkle in oregano. Mix well and cover the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 1 1/2 to 2 hours, until the meat may be easily separated from the bone. Spoon off excess fat before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
