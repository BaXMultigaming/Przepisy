  "ingredients": [
    "1 cup graham cracker crumbs",
    "0.5 teaspoon baking soda",
    "1 pinch salt",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1 cup chocolate-hazelnut spread (such as Nutella®)"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the graham cracker crumbs, baking soda, and salt in a large bowl; add the egg, vanilla, and chocolate-hazelnut spread and mix by hand until well blended. Form the mixture into 1 1/2-inch balls and place on a baking sheet 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crispy on the outside, 8 to 10 minutes. Allow to rest on cookie sheet a few minutes before moving to a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
