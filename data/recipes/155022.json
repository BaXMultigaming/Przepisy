  "ingredients": [
    "1 (.25 ounce) envelope unflavored gelatin",
    "2 tablespoons cold water",
    "0.75 cup white sugar",
    "0.66666668653488 cup apple cider vinegar",
    "0.33333334326744 cup water",
    "0.25 cup mustard powder",
    "0.5 teaspoon salt",
    "4 eggs",
    "1 cup whipping cream"
  ],
  "steps": [
    {
      "text": "Dissolve gelatin in 2 tablespoons cold water in a small bowl; transfer to a blender. Add sugar, vinegar, ⅓ cup water, mustard powder, and salt to blender; blend until smooth. Add eggs; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a mixing bowl over a pot of boiling water; pour mustard mixture into bowl. Cook and stir until thick like a custard. Remove from heat; cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat heavy cream in a separate bowl with an electric mixer until soft peaks form. Fold whipped cream into mustard mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly grease a 1-quart ring mold; pour in mustard-cream mixture. Chill in refrigerator 8 hours to overnight. Serve with ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
