  "ingredients": [
    "1 cup barbecue sauce",
    "1 tablespoon Southwest seasoning",
    "0.5 teaspoon hot sauce",
    "2 teaspoons olive oil",
    "3 cups shredded rotisserie chicken",
    "8 (6 inch) flour or corn tortillas",
    "0.5 cup chopped tomatoes",
    "0.5 cup Borden® Finely Shredded Four Cheese Mexican Shreds",
    "0.5 cup coarsely chopped fresh cilantro",
    "Lime wedges, for serving"
  ],
  "steps": [
    {
      "text": "Combine barbecue sauce, Southwest seasoning, and hot sauce in a small bowl; set aside for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat until hot. Add chicken; cook and stir until warmed through, 3 to 5 minutes. Stir in barbecue sauce mixture; cook until chicken is coated and sauce thickens slightly, 3 to 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tortillas according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide chicken mixture among tortillas; top each with tomatoes, cheese, and cilantro. Serve with lime wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
