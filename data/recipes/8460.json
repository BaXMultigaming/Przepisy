  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.75 teaspoon ground ginger",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup shortening",
    "0.25 cup packed brown sugar",
    "1 egg",
    "0.5 cup light molasses",
    "0.5 cup boiling water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9 inch round pan. Sift together flour, ginger, cinnamon, baking powder, baking soda and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream shortening and brown sugar until light and fluffy. Beat in the egg and molasses. Add flour mixture and water. Beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into pan. Bake at 350 degrees F (175 degrees C) for 30 to 35 minutes, or until a toothpick inserted into cake comes out clean. Cool in pan on a wire rack for 10 minutes. Remove from pan and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
