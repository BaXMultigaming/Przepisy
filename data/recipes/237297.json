  "ingredients": [
    "1.5 teaspoons salt",
    "1 teaspoon paprika",
    "1 teaspoon ground cardamom",
    "1 teaspoon ground coriander",
    "0.5 teaspoon ground black pepper",
    "0.25 cup grapeseed oil",
    "2 tablespoons maple syrup",
    "1 (2 pound) salmon fillet, cut into 3-inch pieces"
  ],
  "steps": [
    {
      "text": "Stir salt, paprika, cardamom, coriander, and black pepper together in a bowl. Add oil and maple syrup; stir until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a nonstick frying pan over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge salmon pieces through maple syrup mixture until evenly coated on all sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook salmon in the preheated pan until fish flakes easily with a fork, 5 to 7 minutes per side.",
