  "title": "Easy Gluten-Free Bagels",
  "description": "Made with almond flour and mozzarella cheese, these gluten-free bagels are easy, chewy, and delicious!",
  "authors": [
    "Gray Luring Recipes"
  ],
  "date_published": "2018-08-23T20:15:27-04:00",
