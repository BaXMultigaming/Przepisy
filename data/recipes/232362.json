  "ingredients": [
    "3 cups all-purpose flour",
    "1.5 teaspoons salt",
    "1.5 teaspoons baking powder",
    "2.25 cups white sugar",
    "1.125 cups vegetable oil",
    "3 eggs",
    "1.5 cups milk",
    "1.5 tablespoons poppy seeds",
    "1.5 teaspoons vanilla extract",
    "1.5 teaspoons almond extract",
    "1.5 teaspoons butter-flavored extract",
    "0.75 cup white sugar",
    "0.25 cup orange juice",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "0.5 teaspoon butter-flavored extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a large loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, salt, and baking powder in a bowl. Beat 2 1/4 cups sugar, vegetable oil, and eggs in another bowl until smooth. Stir milk, poppy seeds, 1 1/2 teaspoon vanilla extract, 1 1/2 teaspoon almond extract, and 1 1/2 teaspoon butter extract into egg mixture. Add flour mixture; mix until batter is just moistened. Pour batter into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 3/4 cup sugar, orange juice, 1/2 teaspoon vanilla extract, 1/2 teaspoon almond extract, and 1/2 teaspoon butter extract in a bowl until smooth. Pour orange juice glaze over hot poppy seed loaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
