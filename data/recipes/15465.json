  "ingredients": [
    "6 tablespoons margarine",
    "1 cup packed brown sugar",
    "0.5 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.75 cup all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "3.5 cups rolled oats",
    "1 (8 ounce) can crushed pineapple, drained",
    "1 cup raisins",
    "0.75 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream the margarine with the brown sugar and white sugar. Stir in the egg and vanilla. Sift together the flour, baking soda and cinnamon; add to the creamed mixture and stir until just combined. Finally, mix in the oats, raisins, pineapple and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by heaping teaspoonfuls onto the prepared cookie sheet. Cookies should be about 2 inches apart. Bake for 10 to 12 minutes in the preheated oven. Cool for a few minutes on the cookie sheet before removing to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
