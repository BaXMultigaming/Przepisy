  "ingredients": [
    "0.33333334326744 cup red wine",
    "0.33333334326744 cup soy sauce",
    "2 tablespoons light brown sugar",
    "2 pounds pork tenderloin",
    "0.33333334326744 cup mayonnaise",
    "0.33333334326744 cup sour cream",
    "1.5 tablespoons mustard powder",
    "1 tablespoon minced fresh chives"
