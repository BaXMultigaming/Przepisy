  "ingredients": [
    "cooking spray",
    "1 cup mayonnaise",
    "1 teaspoon paprika",
    "0.75 cup panko bread crumbs, or as needed",
    "1 teaspoon garlic powder",
    "4 bone-in chicken thighs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking dish with aluminum foil; grease with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise and paprika in a bowl; mix well. Stir together panko and garlic powder in a second bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread mayonnaise mixture over each chicken thigh; press into panko mixture to coat. Place in the prepared baking dish; spritz thighs with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink at the bone and the juices run clear, about 1 hour. An instant-read thermometer inserted near the bone should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
