  "ingredients": [
    "1 tablespoon butter",
    "1 tablespoon minced onion",
    "0.33333334326744 cup fine dry bread crumbs",
    "0.5 cup water",
    "0.5 cup half-and-half",
    "0.75 pound ground beef",
    "0.25 pound ground pork",
    "2 teaspoons salt",
    "0.25 teaspoon ground white pepper",
    "0.33333334326744 teaspoon white sugar",
    "3 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Melt 1 tablespoon butter in a frying pan over low heat; cook and stir onion in melted butter until lightly browned, 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs, water, and half-and-half in a large bowl; let stand for about 2 minutes. Stir cooked onion, ground beef, ground pork, salt, white pepper, and sugar into bread crumb mixture until thoroughly mixed. Shape mixture into about 48 very small meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 3 tablespoons butter in a skillet; add meatballs. Brown slowly, allowing about 25 minutes, until meatballs are fully cooked in the middle and no longer pink. Shake pan occasionally to cook evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
