  "ingredients": [
    "1 cup white sugar",
    "1 cup butter, softened",
    "4 large eggs",
    "1 cup all-purpose flour",
    "0.5 teaspoon salt",
    "1 (16 ounce) can chocolate syrup",
    "1 tablespoon vanilla extract",
    "2 cups confectioners' sugar",
    "0.5 cup butter, softened",
    "0.25 cup creme de menthe liqueur",
    "1 cup semisweet chocolate chips",
    "6 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the brownies: Beat sugar and butter until light and fluffy. Beat in eggs. Stir in flour, salt, chocolate syrup, and vanilla; mix until combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Let cool, 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the brownies are cooling, make the frosting: Mix together confectioners’ sugar, butter, and crème de menthe until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the topping: Melt chocolate chips and butter over low heat. Stir until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread frosting over cooled brownies, and place in the refrigerator to set, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread chocolate topping over frosting. Let sit until set, about 15 minutes. Cut into 24 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
