  "ingredients": [
    "6 frozen bean and cheese burritos",
    "1 (10.5 ounce) can condensed cream of chicken or cream of mushroom soup",
    "0.5 cup sour cream",
    "1 (4 ounce) can diced green chile peppers, drained",
    "1 cup shredded Cheddar cheese",
    "1 medium tomato, chopped",
    "1 avocados - peeled, pitted and sliced",
    "1 (2.25 ounce) can sliced black olives, drained",
    "0.5 cup salsa"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place burritos in a row across the bottom of a 9x13-inch baking dish. In a medium bowl, stir together condensed soup, sour cream, and chile peppers. Spread evenly over the top of the burritos. Sprinkle with shredded cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 to 30 minutes in the preheated oven, until cheese is slightly browned and burritos are heated through. Serve with tomato, avocado, olives, and salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
