  "ingredients": [
    "2 cups queijo coalho cheese curds",
    "0.5 pound pineapple",
    "0.5 cup brown sugar",
    "2 sprigs fresh mint"
  ],
  "steps": [
    {
      "text": "Preheat grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook queijo coalho cheese and pineapple on the preheated grill until browned, 5 to 10 minutes. Transfer to a plate; cool until easily handled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut grilled queijo coalho cheese and pineapple into cubes with a sharp knife; transfer to a bowl. Add brown sugar and toss until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stick 1 cube of queijo coalho cheese, 1 mint leaf, and 1 cube of pineapple onto a toothpick; repeat until all ingredients are skewered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
