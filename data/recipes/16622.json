  "title": "Hot German Potato Salad I",
  "description": "My Grandparents used to make this for us when we were children. The addition of escarole adds a great flavor to the bacon, potatoes and eggs.",
  "authors": [
    "Karen"
  ],
  "date_published": "2000-03-14T18:28:14-05:00",
