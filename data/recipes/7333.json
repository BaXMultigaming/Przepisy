  "ingredients": [
    "1 (18.25 ounce) package white cake mix",
    "1 (3 ounce) package strawberry flavored Jell-O®",
    "0.66666668653488 cup vegetable oil",
    "4 eggs",
    "3 tablespoons all-purpose flour",
    "4 ounces frozen strawberries",
    "0.5 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Thaw and drain the frozen strawberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease on 9x13 inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the white cake mix, strawberry gelatin, oil, eggs, flour, thawed strawberries, and buttermilk and mix until just combined. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for about 25 to 35 minutes or until a toothpick inserted in the center comes out clean.",
      "section": null,
