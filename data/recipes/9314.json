  "ingredients": [
    "1 cup shortening",
    "2 cups packed brown sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "0.25 cup sour milk",
    "3.5 cups all-purpose flour",
    "2 teaspoons cream of tartar",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the shortening and the sugar. Add the eggs and beat for 2 minutes. Beat in the vanilla, salt, sour milk, flour, cream of tartar, baking soda and cinnamon. Stir in the chopped walnuts. Drop cookies 3 inches apart on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 12 minutes. Chopped dates can be added for extra flavor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
