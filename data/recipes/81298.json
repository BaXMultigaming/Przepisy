  "ingredients": [
    "2 cups rolled oats",
    "1 cup all-purpose flour",
    "0.75 cup packed brown sugar",
    "0.75 cup raisins",
    "0.5 cup wheat germ",
    "0.75 teaspoon ground cinnamon",
    "0.75 teaspoon salt",
    "0.5 cup honey",
    "0.5 cup vegetable oil",
    "1 egg, beaten",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Generously grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, flour, brown sugar, raisins, wheat germ, cinnamon, and salt in a large bowl. Make a well in the center; pour in honey, oil, egg, and vanilla; mix well using your hands. Pat evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bars begin to turn golden at the edges, 30 to 35 minutes. Cool for 5 minutes, then cut into bars while still warm. Do not allow bars to cool completely before cutting or they will be too hard to cut.",
      "section": null,
      "name": null,
      "url": null,
