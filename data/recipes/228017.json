  "ingredients": [
    "1.5 cups rolled oats",
    "0.5 cup whole wheat flour",
    "0.5 cup all-purpose flour",
    "0.5 cup light brown sugar",
    "1.5 teaspoons wheat germ",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 ripe banana, mashed",
    "0.25 cup unsweetened applesauce",
    "2 egg whites",
    "1 teaspoon vanilla extract",
    "0.5 cup chocolate chips",
    "0.5 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper or a silicone mat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, whole wheat flour, all-purpose flour, brown sugar, wheat germ, baking powder, baking soda, and salt in a large bowl. Add banana, applesauce, egg whites, and vanilla extract; mix well. Gently fold chocolate chips and cranberries into the batter. Drop batter, about 1 tablespoon at a time, onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 12 minutes.",
      "section": null,
      "name": null,
