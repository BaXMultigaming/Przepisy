  "ingredients": [
    "4 cups milk",
    "2 eggs",
    "1.5 cups white sugar",
    "0.5 cup all-purpose flour",
    "1 (12 ounce) package miniature vanilla wafers",
    "3 barely ripe bananas, sliced 1/4-inch thick, or more to taste"
  ],
  "steps": [
    {
      "text": "Whisk milk and eggs together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and flour in a saucepan. Stir in milk mixture gradually. Place saucepan over medium heat; cook and stir mixture is the consistency of pudding, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange an even layer of wafers in the bottom of a large bowl. Top with a layer of banana slices. Cover with a layer of pudding. Repeat layers with remaining wafers, banana slices, and pudding, ending with wafers.",
      "section": null,
