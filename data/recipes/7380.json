  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter",
    "1 cup chilled applesauce",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.5 cup chopped walnuts",
    "0.5 cup raisins"
  ],
  "steps": [
    {
