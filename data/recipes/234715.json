  "yield": [
    "12",
    "1 dozen cupcakes"
  ],
  "categories": [
    "Dessert"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 teaspoon shortening, or as needed",
    "1 teaspoon all-purpose flour, or as needed",
    "1.5 cups all-purpose flour, sifted",
    "1 cup white sugar",
    "3 tablespoons cocoa powder",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup cold water",
    "0.33333334326744 cup olive oil",
    "2 tablespoons orange juice",
    "0.5 teaspoon vanilla extract",
    "1 tablespoon grated orange zest",
    "0.5 cup unsalted butter",
    "0.66666668653488 cup confectioners' sugar, sifted",
    "2 tablespoons instant pistachio pudding mix",
    "2 tablespoons cold water",
    "1 ounce dark chocolate, grated"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C). Grease 12 muffin cups with shortening using a paper towel and dust with about 1 teaspoon flour or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iebJLkWA6BVwtArSLyv0mR3BRHg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234715-chocolate-orange-cupcakes-with-pistachio-buttercream-VAT-005-step-01-dfdcff5cb7a14c268ee2c8ccac59a906.jpg"
      ],
      "image": "assets/images/234715/step_01.webp"
    },
    {
      "text": "Combine 1 1/2 cups flour, white sugar, cocoa powder, baking soda, and salt in the bowl of a stand mixer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9sN2jWVkWuLP3QhYzQtAMgl4rXo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234715-chocolate-orange-cupcakes-with-pistachio-buttercream-VAT-006-step-02-ce6c14ed40f84816b4e1293f4a25d949.jpg"
      ],
      "image": "assets/images/234715/step_02.webp"
    },
    {
      "text": "Beat 1 cup cold water, olive oil, orange juice, and vanilla extract into flour mixture on medium-low speed until batter is just combined, about 2 minutes. Fold orange zest into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B_qAHguuq09Y7FdKaPAdjqwtT9A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234715-chocolate-orange-cupcakes-with-pistachio-buttercream-VAT-007-03-c99df76187fe4eed8eed16cc8e5b8408.jpg"
      ],
      "image": "assets/images/234715/step_03.webp"
    },
    {
      "text": "Pour batter into prepared muffin cups, 2/3-full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/epYQMYtxyyae3KGjI8vRh0jCjl8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234715-chocolate-orange-cupcakes-with-pistachio-buttercream-VAT-008-step-04-33fb290c292b44c78cb8b4c5ef2c0134.jpg"
      ],
      "image": "assets/images/234715/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into a cupcake comes out clean, about 20 minutes. Transfer cupcakes to a wire rack to cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f6QRKIu3fKZ4S3zDlwWJ5lWxcsE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234715-chocolate-orange-cupcakes-with-pistachio-buttercream-VAT-009-step-05-300106111a334009ac8769b333f48b07.jpg"
      ],
      "image": "assets/images/234715/step_05.webp"
    },
    {
      "text": "Beat butter in a bowl using an electric mixer in medium speed until fluffy, about 1 minute. Slowly pour confectioners' sugar into creamed butter and beat until incorporated, about 2 minutes. Beat pudding mix into butter mixture until just combined. Add water, 1 tablespoon at a time, until desired consistency of icing is reached.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aI5VBOiQK2YDaPf5yneSOhcwHok=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234715-chocolate-orange-cupcakes-with-pistachio-buttercream-VAT-010-step-06-228acfb937424701b0ffd7772dc25c7e.jpg"
      ],
      "image": "assets/images/234715/step_06.webp"
    },
    {
      "text": "Ice the cooled cupcakes; garnish with grated chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LCb9jJ24x0QRWcuon95H6ojvafM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234715-chocolate-orange-cupcakes-with-pistachio-buttercream-VAT-011-step-07-c8beb5a36b0348b581d369382f79637b.jpg"
      ],
      "image": "assets/images/234715/step_07.webp"
    }
  ],
