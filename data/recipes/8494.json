  "title": "Jamaican Jerked Chicken",
  "description": "An easy homemade Jerk sauce of soy, lime, orange juice and lots of sweet-hot spices makes a mouthwatering pre-barbecue marinade for chicken.",
  "authors": [
    "Cathy Anderson"
  ],
  "date_published": "1999-04-19T13:09:03-04:00",
