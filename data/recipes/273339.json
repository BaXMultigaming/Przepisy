  "ingredients": [
    "0.25 cup almonds",
    "0.25 cup dried cranberries",
    "0.25 cup shelled roasted peanuts",
    "0.25 cup candy-coated milk chocolate pieces (such as M&M's®)",
    "1 cup rolled oats",
    "0.75 cup all-purpose flour",
    "0.5 cup brown sugar",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup butter, softened",
    "0.25 cup honey",
    "1 egg",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 2 cookie sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix almonds, cranberries, peanuts, and candy pieces together to make trail mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, flour, brown sugar, baking soda, and salt together in a large bowl. Beat in butter, honey, egg, and vanilla extract using an electric mixer or wooden spoon until dough is thoroughly combined. Fold in trail mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoonfuls of cookie dough onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set and bottoms of cookies are golden brown, about 8 minutes. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
