  "ingredients": [
    "10 ounces ground sirloin",
    "3 tablespoons tomato sauce, divided",
    "2 tablespoons finely chopped onion",
    "2 tablespoons quick-cooking oats",
    "1 teaspoon Italian seasoning",
    "1 teaspoon dried parsley",
    "0.25 teaspoon salt, or to taste",
    "0.25 teaspoon freshly ground black pepper, or to taste",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 355 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sirloin, 2 tablespoons tomato sauce, onion, oats, Italian seasoning, parsley, salt, and pepper in a bowl and mix until just incorporated. Form into 2 small loaves that are approximately 4 1/2 inches long and 2 inches wide.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly spray the inner basket of the air fryer with cooking spray. Add the 2 loaves, without touching one another, and lightly brush the tops with the remaining 1 tablespoon tomato sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry meatloaves until an instant-read thermometer inserted into the center reads 165 degrees F (73 degrees C), 17 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
