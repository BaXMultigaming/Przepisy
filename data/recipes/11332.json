  "ingredients": [
    "2 cups packed brown sugar",
    "0.75 cup unsalted butter, softened",
    "2 large eggs",
    "2.5 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "3 tablespoons boiling water",
    "2 cups quick cooking oats",
    "2 cups confectioners' sugar",
    "1 large egg white, beaten",
    "2 tablespoons milk",
    "1 teaspoon vanilla extract",
    "0.75 cup shortening"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the cookies: Beat brown sugar and butter in a large bowl with an electric mixer until light and fluffy. Add eggs and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, cinnamon, baking powder, baking soda, and salt in a separate bowl. Add flour mixture to wet ingredients in 2 batches, alternating with boiling water, mixing batter after each addition until well combined. Stir in oats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 to 12 minutes, switching racks halfway through. Remove from the oven and transfer to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the cookies are cooling, make the filling: Beat 1 cup confectioners’ sugar, egg white, milk, and vanilla until combined. Beat in shortening and remaining 1 cup confectioners’ sugar until light and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread filling onto 1/2 of the cooled cookies, then sandwich with remaining cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
