  "ingredients": [
    "1 cup chicken broth",
    "0.75 cup packed brown sugar",
    "0.125 cup white vinegar",
    "2 tablespoons soy sauce",
    "2 tablespoons sesame oil",
    "1 teaspoon chile paste",
    "1 clove garlic, minced",
    "0.25 cup cornstarch",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Mix together chicken broth, brown sugar, vinegar, soy sauce, sesame oil, chile paste, and garlic in a small pot until well combined. Bring to a boil, then reduce heat to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve cornstarch in water in a small bowl; add to simmering mixture in the pot. Cook until sauce thickens, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
