  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease an 8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix apples, pears, cranberries, honey, lemon juice, and 1 tablespoon flour together in the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1/2 cup flour, brown sugar, oats, and walnuts together in a medium bowl. Cut in butter until mixture resembles coarse crumbs. Sprinkle over fruit mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and crisp on top, about 45 minutes.",
