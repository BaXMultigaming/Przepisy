  "ingredients": [
    "6 cups milk",
    "1 (14 ounce) can sweetened condensed milk",
    "1.5 cups heavy whipping cream",
    "1.5 cups bittersweet chocolate chips",
    "1 teaspoon vanilla extract",
    "0.125 teaspoon salt"
