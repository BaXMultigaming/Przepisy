  "ingredients": [
    "1 loaf 100% whole wheat bread",
    "1 cup grated Pecorino Romano cheese",
    "1 tablespoon dried parsley",
    "1 tablespoon dried oregano",
    "1 tablespoon dried basil",
    "1.5 teaspoons garlic powder",
    "1.5 teaspoons onion powder",
    "0.75 teaspoon dried thyme",
    "0.75 teaspoon kosher salt",
    "0.75 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer bread slices in a single layer on ungreased baking sheets. Allow a bit of room between slices for warm air to circulate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast bread in the preheated oven, flipping until evenly dry, 30 to 45 minutes. Remove from the oven and cool completely, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Process bread in a food processor until fine. Add Pecorino Romano cheese, parsley, oregano, basil, garlic powder, onion powder, thyme, salt, and sugar and pulse until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
