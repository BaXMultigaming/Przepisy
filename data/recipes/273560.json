  "ingredients": [
    "1 (1 pound) flank steak",
    "0.5 cup olive oil",
    "0.25 cup lemon juice",
    "1 tablespoon dried minced onion",
    "2 cloves garlic, minced",
    "1.5 teaspoons flavor enhancer (such as Accent®)",
    "1.5 teaspoons salt",
    "1 teaspoon black pepper",
    "1 teaspoon white sugar",
    "0.5 teaspoon dry mustard",
    "0.5 teaspoon dried rosemary",
    "0.25 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Whisk oil, lemon juice, minced onion, garlic, flavor enhancer, salt, black pepper, sugar, dry mustard, rosemary, and ginger together in a glass jar; transfer to a resealable plastic bag. Add steak, toss to coat, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove flank steak from marinade; shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, flipping once, until firm and slightly pink in center, 5 to 8 minutes per side. Slice on a diagonal against the grain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
