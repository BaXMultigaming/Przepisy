  "ingredients": [
    "1 cup whole wheat flour",
    "0.75 cup ground flax seed",
    "0.5 cup wheat germ",
    "1 teaspoon baking soda",
    "1.5 teaspoons baking powder",
    "0.5 cup cocoa powder",
    "1 tablespoon ground cinnamon",
    "0.5 cup miniature semisweet chocolate chips",
    "1 cup low-fat buttermilk",
    "0.75 cup pumpkin puree",
    "1 cup brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 400 degrees F (200 degrees C). Grease 12 muffin cups, or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, flax seed, wheat germ, baking soda, baking powder, cocoa powder, cinnamon, and chocolate chips in a large bowl. In another bowl, beat the buttermilk, pumpkin puree, brown sugar, egg, and vanilla until smooth. Gently stir the wet ingredients into the dry, mixing just until combined. Spoon equal amounts of batter into muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until a toothpick inserted in the center of a muffin comes out clean, about 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
