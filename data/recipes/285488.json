  "ingredients": [
    "1 (2 pound) pork tenderloin",
    "2 sprigs fresh rosemary, leaves stripped",
    "1 tablespoon fresh thyme",
    "0.5 teaspoon salt",
    "0.5 teaspoon freshly ground black pepper",
    "6 slices thick-cut bacon",
    "1 tablespoon garlic powder",
    "0.5 cup packed brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season tenderloin with rosemary leaves, thyme, salt, and pepper. Wrap bacon around tenderloin and secure with toothpicks. Sprinkle garlic powder over bacon, then pack brown sugar around tenderloin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven until an instant-read thermometer inserted into the center reads at least 145 degrees F (63 degrees C), 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
