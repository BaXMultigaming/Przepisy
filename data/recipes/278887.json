  "ingredients": [
    "1.25 pounds fresh okra",
    "2 teaspoons olive oil",
    "1 teaspoon chili-lime seasoning (such as Tajin®)",
    "0.5 teaspoon smoked salt"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put the whole okra in a resealable plastic bag. Add oil, chili-lime seasoning, and salt. Seal and shake bag until okra is completely covered with oil and spices. Allow to rest for a few minutes, until the air fryer has reached its temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour contents of the bag into the air fryer basket. Cook for 6 minutes. Toss the basket and cook until okra is crispy on the outside, about 6 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
