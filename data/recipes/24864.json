  "ingredients": [
    "0.25 pound bacon",
    "2 eggs",
    "0.5 head lettuce",
    "1 carrot, shredded",
    "1 tomato, sliced",
    "1 tablespoon corn oil",
    "1 tablespoon red wine vinegar",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggs in a saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove from hot water, cool, peel and chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place lettuce in a salad bowl along with the carrot and tomato. Sprinkle with bacon and eggs and toss.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle oil over salad. Add vinegar and salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
