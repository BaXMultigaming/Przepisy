  "ingredients": [
    "1 cup butter",
    "1 cup vegetable oil",
    "1 cup packed brown sugar",
    "1 cup white sugar",
    "1 egg",
    "3 teaspoons vanilla extract",
    "1 teaspoon cream of tartar",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "3.5 cups all-purpose flour",
    "2 cups crisp rice cereal",
    "1 cup quick cooking oats",
    "1 cup flaked coconut",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dIyecsBnqQm0rhI0Q3lJxfOh9To=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10577-million-dollar-cookies-ddmfs-step-1-016-19ac4206a8354b8bb298018fdb8cda8b.jpg"
      ],
      "image": "assets/images/10577/step_01.webp"
    },
    {
      "text": "Mix butter, oil, brown sugar, white sugar, egg, vanilla, cream of tartar, baking soda, and salt together in a large bowl until smooth; stir in flour, crisp cereal, oats, coconut, and chocolate chips to form a dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wblXJNyIpD_Amc3HcAKaZaiw7sQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10577-million-dollar-cookies-ddmfs-step-2-017-c4cb6391c3a64d61a2aaeb857d990467.jpg"
      ],
      "image": "assets/images/10577/step_02.webp"
    },
    {
      "text": "Roll dough into walnut-size balls and place 2 inches apart on baking sheets. Press cookies down with a glass which has been buttered and dipped in sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xL87TzDdsCzhU28fC1DSHa8INro=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10577-million-dollar-cookies-ddmfs-step-3-020-0152e85c86f14f1888c3f92b80d75c44.jpg"
      ],
      "image": "assets/images/10577/step_03.webp"
    },
    {
      "text": "Bake cookies in the preheated oven until edges are golden, about 12 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MW_MsGGu82hyBM6W3JPkVX2SenQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10577-million-dollar-cookies-ddmfs-step-4-027-5a709c9ea7ba48bcb3f7ad49ccea1597.jpg"
      ],
      "image": "assets/images/10577/step_04.webp"
    }
  ],
