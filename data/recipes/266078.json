  "ingredients": [
    "1.25 cups uncooked orzo pasta",
    "3 cups chopped grilled chicken breasts",
    "1 cup cherry tomatoes, halved",
    "0.25 cup chopped red onion",
    "2 tablespoons chopped fresh basil",
    "1 teaspoon chopped fresh oregano",
    "0.25 cup red wine vinegar, or more to taste",
    "2 tablespoons extra-virgin olive oil, or more to taste",
    "0.125 teaspoon kosher salt",
    "0.125 teaspoon cracked black pepper",
    "1 (2 ounce) can sliced black olives, or to taste",
    "2 ounces crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil. Cook orzo in the boiling water, stirring occasionally until tender yet firm to the bite, about 11 minutes. Drain and rinse with cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine orzo, chicken, tomatoes, red onion, basil, and oregano in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk vinegar, oil, salt, and pepper in a separate bowl. Drizzle over the pasta mixture. Toss to coat. Sprinkle with olives and feta cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
