  "ingredients": [
    "1 pomelo",
    "1 mango",
    "2 oranges",
    "2 cups club soda"
  ],
  "steps": [
    {
      "text": "Peel pomelo and separate the fruit from the pith. Place fruit segments into a high performance blender (such as a Vitamix®). Blend on variable 1, quickly switching to variable 10. Blend for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel mango, remove pit, and cut into slices. Add to the blender and blend for another minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut oranges in half and squeeze juice into a small container. Strain to remove pulp, if desired, and pour juice into the blender. Add club soda and blend on high speed for 1 minute. Serve chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
