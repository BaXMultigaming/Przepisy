  "ingredients": [
    "nonstick cooking spray",
    "4 large eggs",
    "3 tablespoons heavy whipping cream",
    "0.5 cup coarsely chopped spinach leaves",
    "0.5 cup feta cheese",
    "0.5 cup cherry tomatoes, halved",
    "0.5 cup diced red onion",
    "1 teaspoon dried oregano",
    "salt and freshly ground black pepper, to taste"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C). Spray a 6-inch cake pan with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and cream together in a bowl. Stir in spinach, feta cheese, cherry tomatoes, onion, oregano, salt, and pepper until well combined. Pour into the prepared cake pan and cover tightly with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry for 12 minutes. Remove foil and air-fry until top starts to brown and a toothpick inserted in the center comes out clean, 4 to 8 minutes longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
