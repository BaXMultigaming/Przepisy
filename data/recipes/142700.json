  "ingredients": [
    "3 medium sweet potatoes",
    "1 teaspoon olive oil",
    "2 shallots, finely chopped",
    "0.5 cup fat-free ricotta cheese",
    "1 tablespoon brown sugar",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon ground ginger",
    "0.25 cup grated Parmesan cheese",
    "2.5 tablespoons chopped fresh sage"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Pierce potatoes with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake potatoes in the preheated oven until soft, about 1 hour. Remove from the oven and cool until potatoes can be handled, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the potatoes are cooling, reduce the oven temperature to 350 degrees F (175 degrees C). Grease a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a small skillet over medium heat. Add shallots; cook and stir until softened and beginning to brown, about 10 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop sweet potato flesh out of each half, leaving a thin amount of flesh with the skins; set skins aside. Place flesh into a blender or food processor and blend until smooth. Add ricotta, brown sugar, salt, pepper, and ginger; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer potato mixture to a bowl; stir in cooked shallots, Parmesan, and sage. Spoon into potato skins, and place onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until heated through, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
