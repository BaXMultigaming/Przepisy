  "ingredients": [
    "6 medium potatoes, peeled and cubed",
    "6 stalks celery, chopped, leaves reserved",
    "1 medium onion, chopped",
    "2 cubes chicken bouillon",
    "2 (15.25 ounce) cans whole kernel corn, drained",
    "0.25 cup chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Place potatoes, celery and leaves, and onion in a large pot. Pour in enough water to cover. Bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove celery leaves, then stir in bouillon cubes until dissolved. Mix in corn. Reduce heat to medium-low; cook until potatoes are tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chives into soup; continue cooking 5 minutes more. Serve warm.",
