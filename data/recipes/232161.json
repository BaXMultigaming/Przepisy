  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.125 teaspoon salt",
    "0.25 cup butter, softened",
    "6 tablespoons turbinado sugar",
    "1.25 cups mashed overripe bananas",
    "1 large egg, beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease and flour a fluted tube pan (such as Bundt).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, baking powder, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and sugar in a blender; process until sugar is almost completely dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour butter mixture into a bowl. Stir in bananas and egg until well blended. Add to flour mixture and stir until just combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and cool in the pan for 10 minutes before inverting the cake onto a plate to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
