  "ingredients": [
    "2 cups water",
    "2 tablespoons sea salt",
    "2 cups unsalted raw sunflower seeds"
  ],
  "steps": [
    {
      "text": "Bring water and salt to a boil in a large saucepan over high heat. Turn off heat; stir in sunflower seeds and let sit for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the smoker to 275 degrees F (135 degrees C). Add wood chips according to manufacturer's directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain water from sunflower seeds; do not rinse. Place seeds inside a disposable foil pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Smoke in the preheated smoker for 3 hours, shaking the pan every hour. Set seeds aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
