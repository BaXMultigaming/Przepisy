  "ingredients": [
    "1 (12 ounce) package rotini pasta",
    "1 pound bulk Italian sausage",
    "1 small onion, chopped",
    "2 cloves garlic, minced",
    "1 red bell peppers, chopped",
    "1 small zucchini, chopped",
    "1 small yellow squash, chopped",
    "1 cup mushrooms, sliced",
    "salt and pepper to taste",
    "1 (14.4 ounce) can diced tomatoes",
    "1 cup tomato sauce",
    "0.25 teaspoon dried thyme",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon dried oregano",
    "1 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until al dente, 8 to 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brown sausage, stirring to crumble, in a skillet over medium heat. Remove sausage using a slotted spoon, leaving drippings in the pan. Cook and stir onion and garlic in sausage drippings until onions are softened. Return sausage to the pan. Stir in red bell pepper, zucchini, yellow squash, and mushrooms. Season with salt and pepper. Cook another 5 minutes. Add tomatoes, tomato sauce, thyme, basil, and oregano; cook until heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine drained pasta with sausage mixture in a large bowl. Top with Parmesan cheese to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
