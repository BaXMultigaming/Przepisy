  "ingredients": [
    "3.25 pounds pig's feet, rinsed and patted dry",
    "1.5 cups vinegar",
    "1.5 cups water",
    "0.33333334326744 cup soy sauce",
    "1 onion, diced",
    "2 cloves garlic, crushed",
    "1 tablespoon whole black peppercorns, crushed",
    "1 tablespoon white sugar",
    "3 bay leaves",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Combine pig's feet, vinegar, water, soy sauce, onion, garlic, peppercorns, sugar, bay leaves, and salt in a stockpot. Bring to a boil. Allow to boil, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce the heat to medium-low. Simmer, stirring occasionally, until meat is tender, pulls away easily from bones, and liquid thickens, about 1 hour. Serve hot over rice, if desired.",
      "section": null,
      "name": null,
      "url": null,
