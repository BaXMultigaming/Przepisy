  "ingredients": [
    "1 pound ground beef",
    "0.5 cup dry bread crumbs",
    "0.25 cup milk",
    "0.125 teaspoon ground black pepper",
    "1 tablespoon snipped fresh parsley",
    "0.33333334326744 cup minced onion",
    "1 teaspoon salt",
    "1 egg",
    "0.5 teaspoon Worcestershire sauce",
    "0.25 cup shortening",
    "1 (12 ounce) bottle chile sauce",
    "1.25 cups grape jelly"
  ],
  "steps": [
    {
      "text": "In a large bowl, combine the ground beef, dry bread crumbs and milk. Blend in ground pepper, parsley, onion, salt, egg and Worcestershire sauce. Mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape the beef mixture into 1 inch meatballs. In a large skillet, melt the shortening over medium heat and brown the meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in a medium saucepan, mix the chile sauce and grape jelly over medium heat, stirring occasionally, until jelly is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the sauce over the browning meatballs and simmer for 30 minutes, or until meatballs are thoroughly cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
