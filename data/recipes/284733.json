  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x13-inch baking pan with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread apple pie filling in the prepared pan; top with cranberry sauce. Sprinkle cake mix over top, then cover as much as possible with butter slices; sprinkle with walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 55 minutes. Cool for a least 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
