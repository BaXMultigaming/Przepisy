  "ingredients": [
    "2 (5 ounce) cans tuna, drained",
    "3 tablespoons mayonnaise",
    "1.5 tablespoons pickle relish",
    "1 tablespoon chopped onion",
    "1 tablespoon chopped celery",
    "1 teaspoon lemon juice, or to taste",
    "1 pinch garlic salt, or to taste",
    "4 leaves lettuce",
    "4 (8 inch) flour tortillas, warmed"
  ],
  "steps": [
    {
      "text": "Mix tuna, mayonnaise, pickle relish, onion, celery, lemon juice, and garlic salt together in a bowl. Lay 1 lettuce leaf on each tortilla. Spoon tuna mixture in a line across the middle of each tortilla. Fold opposing edges of the tortilla to overlap the filling. Roll 1 of the opposing edges around the filling in a burrito-style.",
