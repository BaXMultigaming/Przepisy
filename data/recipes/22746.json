  "ingredients": [
    "16 vanilla wafer cookies",
    "2 (8 ounce) packages cream cheese, softened",
    "0.75 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line muffin pans with cupcake papers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place one wafer cookie in the bottom of each cupcake paper. In a medium bowl, cream together cream cheese and sugar. Beat in eggs and vanilla until smooth. Pour over wafers in cupcake papers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 15 minutes, until golden and set.",
      "section": null,
