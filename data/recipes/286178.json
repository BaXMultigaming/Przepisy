  "ingredients": [
    "2 cups unsweetened oat milk, or more to taste",
    "2 medium frozen bananas, chopped",
    "4 small dried figs, chopped",
    "2 tablespoons chia seeds",
    "2 tablespoons almond butter",
    "0.5 teaspoon ground cinnamon",
    "2 teaspoons honey, or to taste"
  ],
  "steps": [
    {
      "text": "Combine 2 cups oat milk, bananas, figs, chia seeds, almond butter, and cinnamon in a blender; blend until smooth and creamy, 1 to 2 minutes.",
