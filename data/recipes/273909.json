  "ingredients": [
    "1.5 cups white sugar",
    "1 cup sour cream",
    "0.5 cup butter, softened",
    "2 eggs",
    "1.75 cups mashed ripe bananas",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.75 teaspoon salt",
    "0.5 cup chopped walnuts",
    "1.5 cups chocolate-hazelnut spread (such as Nutella®), or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, sour cream, softened butter, and eggs together in a bowl until creamy. Add mashed bananas and vanilla extract and blend again. Add flour, baking soda, and salt and blend again until smooth and creamy. Fold in walnuts. Spread batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove brownies from the oven, leaving oven on. Add chocolate-hazelnut spread to the top without spreading.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return pan to the hot oven until chocolate-hazelnut spread is softened, 2 to 3 minutes. Remove from oven and spread chocolate-hazelnut spread over brownies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut cooled brownies into 20 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
