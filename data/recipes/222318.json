  "ingredients": [
    "2 cups heavy whipping cream",
    "1.5 cups whole milk",
    "0.75 cup white sugar",
    "0.5 cup brewed espresso, chilled",
    "0.25 cup chocolate syrup",
    "0.75 cup cocoa roast almonds, chopped",
    "4 ounces dark chocolate, chopped"
  ],
  "steps": [
    {
      "text": "Mix heavy cream, whole milk, sugar, espresso, and chocolate syrup in a bowl until sugar is dissolved. Refrigerate until chilled, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chilled mixture into an ice cream maker and freeze according to the manufacturer's directions until it reaches \"soft-serve\" consistency, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in almonds and dark chocolate. Serve soft ice cream immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
