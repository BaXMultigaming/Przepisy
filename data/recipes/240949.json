  "ingredients": [
    "2 cups crushed pretzels",
    "0.5 cup butter, melted",
    "3 tablespoons white sugar",
    "1 (8 ounce) package cream cheese, softened",
    "1 cup confectioners' sugar",
    "1 (12 ounce) container frozen whipped topping (such as Cool Whip®), thawed",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together pretzels, melted butter, and sugar in a medium bowl; press into the bottom of a 13x9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake crust in the preheated oven until lightly browned, about 10 minutes. Remove to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together cream cheese and confectioners' sugar in a large bowl. Fold in whipped topping until smooth. Spread over cooled crust. Cover evenly with cherry pie filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
