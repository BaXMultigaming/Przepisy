  "ingredients": [
    "4.5 pounds apples - peeled, cored, and sliced",
    "1 lemon, juiced",
    "1.125 cups unsalted butter",
    "1.25 cups white sugar",
    "1 tablespoon vanilla sugar",
    "5 eggs",
    "2.75 cups all-purpose flour",
    "1 tablespoon baking powder",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease a deep baking pan with butter or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss apple slices with lemon juice in a bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, sugar, and vanilla sugar in a large bowl and beat using an electric blender until pale and fluffy. Add eggs, one at a time, and mix well after each addition. Combine flour, baking powder, and salt together in a separate bowl and mix on low speed. Fold apple slices into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter into the prepared baking pan and smooth the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
