  "ingredients": [
    "1 recipe pastry for a 9 inch single crust pie",
    "1 cup white sugar",
    "0.5 cup all-purpose flour",
    "2 eggs",
    "0.5 cup butter, melted and cooled",
    "1 cup pecans, coarsely chopped",
    "1 cup semisweet chocolate chips",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
