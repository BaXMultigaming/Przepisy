  "ingredients": [
    "nonstick cooking spray",
    "8 cups chopped red cabbage",
    "0.5 (8 ounce) package sliced cremini mushrooms",
    "salt and ground black pepper to taste",
    "8 cups fresh baby spinach",
    "4 leaves fresh sage, minced",
    "0.25 cup chopped green onion"
  ],
  "steps": [
    {
      "text": "Lightly coat a saute pan with nonstick spray and place over medium-high heat. Add red cabbage and saute, stirring frequently, until it begins to wilt, about 10 minutes. Add mushrooms, salt, and pepper. Continue to cook until mushrooms begin to caramelize, stirring occasionally, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add spinach and sage; cook until leaves are vibrant green and wilted, about 2 minutes. Stir in green onions and serve.",
      "section": null,
