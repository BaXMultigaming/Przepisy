  "ingredients": [
    "1 (15.25 ounce) package dark chocolate fudge cake mix",
    "0.5 cup vegetable oil",
    "2 large eggs",
    "0.5 (10 ounce) package creme de menthe baking chips (such as Andes®)",
    "0.5 (10 ounce) bag white chocolate chips"
  ],
  "steps": [
    {
      "text": "Combine cake mix, oil, and eggs in a mixing bowl or the bowl of an electric stand mixer and mix well. Stir in creme de menthe baking chips and white chocolate chips. Dough might be a bit oily, but that's fine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill dough for 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into 1- to 2-inch balls and place 2 inches apart on prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are set around the edges, 8 to 9 minutes. Cool on the baking sheets briefly before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
