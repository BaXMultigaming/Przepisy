  "ingredients": [
    "2 bananas",
    "0.25 cup semisweet chocolate chips",
    "0.25 cup miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Build a campfire and allow the fire to burn until it has accumulated a bed of coals. Rake the coals into a flat bed on one side of the fire.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slit each banana lengthwise through the peel, making sure not to cut all the way through to the other side. Stuff bananas with marshmallows and chocolate chips. Wrap each stuffed banana in aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bananas over the fire until chocolate is melted, about 5 minutes. Carefully unwrap the foil and eat with a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
