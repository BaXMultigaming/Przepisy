  "ingredients": [
    "1 (18.25 ounce) package brownie mix (such as Pillsbury®)",
    "0.66666668653488 cup vegetable oil",
    "0.25 cup water",
    "2 eggs",
    "2 cups confectioners' sugar",
    "1 cup creamy peanut butter",
    "0.5 cup butter, softened",
    "1 (6 ounce) package chocolate chips",
    "6 tablespoons butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brownie mix, oil, water, and eggs together in a bowl until smooth; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges have started to pull away from the sides of pan, 28 to 31 minutes. Let brownies cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat confectioners' sugar, peanut butter, and 1/2 cup butter together in a bowl until smooth and creamy; spread over cooled brownies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat chocolate chips and 6 tablespoons butter together in a saucepan over low heat, stirring occasionally, until melted, about 5 minutes; spread over peanut butter layer. Cool and cut into squares.",
      "section": null,
      "name": null,
      "url": null,
