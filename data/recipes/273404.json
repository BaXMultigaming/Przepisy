  "ingredients": [
    "2 tablespoons olive oil",
    "2 tablespoons lemon juice",
    "0.25 teaspoon salt",
    "0.25 teaspoon pepper",
    "2 pounds red potatoes, cut into 2-inch cubes",
    "6 large cloves garlic, peeled and smashed",
    "3 tablespoons butter, melted",
    "3 tablespoons dukkah (such as Manitou Trading Company®)",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, lemon juice, 1/4 teaspoon salt, and black pepper together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes and garlic cloves in an 11x13-inch baking dish; drizzle with olive oil mixture and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 minutes, stirring every 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and dukkah in a small bowl; brush on potatoes. Continue baking until potatoes are soft and golden, 10 to 15 minutes more. Season with salt; garnish with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
