  "ingredients": [
    "2 (3.9 ounce) packages instant chocolate pudding mix",
    "3.5 cups milk",
    "1 (9 inch) prepared graham cracker crust",
    "1 (10 ounce) package miniature marshmallows",
    "1 (8 ounce) container whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Whisk 1 box pudding mix with 1/2 of the milk in a bowl until smooth, about 2 minutes. Repeat with second box of pudding mix and remaining milk in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1 bowl pudding into graham cracker crust. Put 1/2 of the marshmallows on the pudding. Top with remaining pudding, then layer with marshmallows. Put whipped topping over the marshmallows and level it out with a spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill in the refrigerator before serving, 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
