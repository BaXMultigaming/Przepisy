  "ingredients": [
    "2 ounces freeze-dried strawberries",
    "2.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.5 teaspoon baking powder",
    "1 cup unsalted butter, softened",
    "1 cup brown sugar",
    "0.5 cup white sugar",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "0.75 teaspoon strawberry extract",
    "2 cups white chocolate chips"
  ],
  "steps": [
    {
      "text": "Place a rack in the center of the oven and preheat to 350 degrees F (175 degrees C). Line two baking sheets with parchment paper. Crush freeze-dried strawberries to a fine consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, salt, and baking powder together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together in a larger mixing bowl until fluffy. Add eggs, crushed strawberries, vanilla extract, and strawberry extract. Mix in dry ingredients in three additions, adding white chocolate chips with the last addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop cookies with a 1 1/2 tablespoon-sized scoop and place onto the prepared baking sheets, 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden, about 14 minutes. Remove from the oven and let cool on the cookie sheets for 3 to 5 minutes before removing to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
