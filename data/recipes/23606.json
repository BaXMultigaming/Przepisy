  "ingredients": [
    "1 (8 ounce) package egg noodles",
    "1 pound lean ground beef",
    "1 onion, chopped",
    "2 (7 ounce) cans tomato sauce with mushrooms",
    "1 teaspoon salt",
    "0.25 teaspoon black pepper",
    "0.25 teaspoon ground cinnamon",
    "1 cup cottage cheese",
    "0.5 cup chopped green onions",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a skillet over medium heat, brown the ground beef with the onion until no pink shows; drain. Mix in 1 of the cans of tomato sauce, salt, pepper and cinnamon. Pour into shallow 3 quart casserole baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in noodles in an even layer. Top with cottage cheese; sprinkle with onions and Cheddar cheese. Pour on remaining can of tomato sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated over for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
