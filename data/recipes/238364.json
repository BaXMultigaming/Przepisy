  "ingredients": [
    "3 small avocados, flesh removed",
    "0.5 white onion, cut into large chunks",
    "0.5 bunch cilantro",
    "0.5 bunch parsley",
    "1 jalapeno pepper, seeded",
    "1 lime, juiced",
    "3 tablespoons white balsamic vinegar",
    "3 cloves garlic, minced",
    "salt and ground black pepper to taste",
    "0.25 cup extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "Blend avocado, white onion, cilantro, parsley, jalapeno pepper, lime juice, white balsamic vinegar, garlic, salt, and pepper in a blender until everything is thoroughly chopped. Stream olive oil into the avocado mixture while blending until the mixture is smooth and creamy.",
