  "ingredients": [
    "6 pounds fresh tomatillos, husks removed",
    "6 small serrano peppers, stems removed",
    "1.5 large onions, roughly chopped",
    "6 cloves garlic, peeled",
    "4 cups chicken broth",
    "0.5 cup packed brown sugar",
    "0.5 bunch fresh cilantro, chopped, or to taste",
    "1 tablespoon salt",
    "1 teaspoon ground cumin"
  ],
  "steps": [
    {
      "text": "Put tomatillos and serrano peppers in a large stockpot, cover with water, and bring to a boil. Boil until tomatillos are an army green color, 15 to 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomatillo-pepper mixture, onions, and garlic in a blender, working in batches if necessary. Puree until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer puree to a large pot. Add chicken broth, brown sugar, cilantro, salt, and cumin; bring to a boil. Cook until reduced and thickened, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
