  "ingredients": [
    "1 cup butter, softened",
    "2 cups white sugar",
    "5 large eggs",
    "2 cups all-purpose flour",
    "0.25 cup fresh lemon juice",
    "1 large lemon, zested"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a fluted tube pan (such as a Bundt).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t6QSaO9SoyDiwY0LxpXswCBWvBU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23136-fresh-lemon-bundt-cake-DDMFS-Step-01-384-5731f39cca7646028589ac4e5a1a0cc3.jpg"
      ],
      "image": "assets/images/231361/step_01.webp"
    },
    {
      "text": "Beat butter and sugar with an electric mixer in a large bowl until light and fluffy. The mixture should be noticeably lighter in color. Add eggs one at a time, alternating with flour, allowing each egg and portion of flour to blend into the butter mixture before adding the next.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PlNVk3soZarldjUxGMW25P7NJSQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23136-fresh-lemon-bundt-cake-DDMFS-Step-02-388-45b303a5de4344cc9c847d45f64e2bdc.jpg"
      ],
      "image": "assets/images/231361/step_02.webp"
    },
    {
      "text": "Stir lemon juice and zest into flour mixture until batter is just combined; pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lvAMcsta4glsJdqF-RYbrKH5gbE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23136-fresh-lemon-bundt-cake-DDMFS-Step-03-389-0f03b8561c4a4b2182acabf279530ec1.jpg"
      ],
      "image": "assets/images/231361/step_03.webp"
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into the center of the cake comes out clean, 45 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NzCWFmRCk7TwqRsBwbtEG4X0orM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23136-fresh-lemon-bundt-cake-DDMFS-Step-04-405-4566215027af49129b4556acaec4297d.jpg"
      ],
      "image": "assets/images/231361/step_04.webp"
    }
  ],
