  "ingredients": [
    "1 cup rolled oats",
    "1 cup buttermilk",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1 teaspoon salt",
    "1 egg",
    "0.25 cup vegetable oil",
    "0.75 cup brown sugar",
    "1 teaspoon vanilla",
    "1 cup chopped fresh strawberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease and flour a muffin pan or line with paper liners. Combine oats and buttermilk in a small bowl; let stand for 5 minutes. Whisk flour, baking powder, baking soda, and salt together in a medium bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg, oil, brown sugar, and vanilla together in a large bowl. Stir in the oat mixture. Add the flour mixture and stir just until moistened. Fold in strawberries. Fill muffin cups 2/3 to 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 to 20 minutes, or until a toothpick inserted into the center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
