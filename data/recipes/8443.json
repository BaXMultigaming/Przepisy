  "ingredients": [
    "0.5 cup butter",
    "2 cups all-purpose flour",
    "1.25 cups white sugar",
    "2 eggs",
    "0.5 cup milk",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1.5 cups fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour muffin pan or use paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and salt together and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar until light and fluffy. Add eggs and beat well. Add milk and flour mixture. Beat until combined. Stir in blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill muffin cups 2/3 full. Bake in the preheated oven for 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
