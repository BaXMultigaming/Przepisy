  "ingredients": [
    "1 pound dry fettuccini noodles",
    "8 slices bacon",
    "4 eggs",
    "0.5 cup grated Parmesan cheese",
    "1.25 cups heavy cream",
    "1 pinch ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add fettuccini and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry bacon in skillet over medium heat until crispy, remove and drain on paper towel. Chop with knife into bits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the eggs, cheese and cream in a bowl, then add the bacon. Pour over the pasta in the pan and toss gently using tongs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return the pan to a very low heat and cook for 1 to 2 minutes, or until slightly thickened. Don't overheat or the eggs will scramble. Season well with black pepper and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
