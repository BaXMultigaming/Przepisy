  "ingredients": [
    "6 large russet potatoes",
    "1 tablespoon olive oil",
    "salt and ground black pepper to taste",
    "1 cup chopped cooked bacon",
    "1 cup shredded provolone cheese",
    "0.25 cup chopped green onion"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 450 degrees F (230 degrees C). Prick potatoes several times with a fork and place onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are easily pierced with a fork, 50 minutes to 1 hour. Remove from the oven and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and generously oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When potatoes are cool enough to handle, cut them lengthwise and scoop out flesh to within 1/4 inch of skin. Reserve flesh for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle skins with oil and season with salt and pepper. Sprinkle with bacon, provolone cheese, and green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill with the lid closed until skins are crispy and cheese is melted, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
