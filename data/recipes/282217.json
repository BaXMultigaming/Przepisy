  "title": "Crispy Potato Skins",
  "description": "Scrumptious and easy to make at home, these delicious potato skins are finished up on the grill where they get extra crispy.",
  "authors": [
    "Cara"
  ],
  "date_published": "2007-03-11T01:49:13-05:00",
