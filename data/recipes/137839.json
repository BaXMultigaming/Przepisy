  "ingredients": [
    "1 (8 ounce) package cream cheese, at room temperature",
    "0.5 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "1 (10 ounce) package frozen puff pastry shells, thawed",
    "0.25 cup milk",
    "0.25 cup turbinado sugar",
    "1.5 cups fresh or frozen blackberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, sugar, and cinnamon in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place puff pastry shells on the prepared cookie sheet. Brush shells with milk; sprinkle with turbinado sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until shells puff, turn golden brown, and are thoroughly baked, 10 to 15 minutes. Remove caps from shells using a fork; set caps aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon 2 tablespoons cream cheese mixture into each shell; top with 6 to 8 blackberries, then pastry cap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake filled pastry shells in the preheated oven until filling is warm, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
