  "ingredients": [
    "0.25 cup honey",
    "3 tablespoons mayonnaise",
    "2 tablespoons olive oil",
    "2 tablespoons whole-grain Dijon mustard",
    "1 tablespoon lemon juice",
    "4 (4 ounce) fillets swai fish"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix honey, mayonnaise, olive oil, mustard, and lemon juice together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place each fish fillet on separate pieces of aluminum foil. Drizzle honey sauce over each fish fillet. Gently wrap the aluminum foil around each coated fish fillet, crimping the foil together over the top to seal into a packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake fillets in the preheated oven until fish flakes easily with a fork, about 13 minutes. Place one fish fillet on each serving plate and top with leftover sauce from foil packet.",
      "section": null,
      "name": null,
      "url": null,
