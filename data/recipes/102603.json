  "ingredients": [
    "1 (5 pound) bone-in ham",
    "0.33333334326744 cup prepared yellow mustard",
    "0.33333334326744 cup maple syrup",
    "2 tablespoons brown sugar",
    "2 teaspoons onion powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uB6rh3TbB773I-njVxpvM2IgLH0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/102603-roasted-easter-ham-DDMFS_Step1-16bd3b6086844e7584a46a88298db789.jpg"
      ],
      "image": "assets/images/102603/step_01.webp"
    },
    {
      "text": "Place ham in a shallow roasting pan. Mix mustard, maple syrup, brown sugar, and onion powder together in a small bowl. Coat ham entirely with the glaze using a spoon or brush.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bueyGYKScv9ltbgrzaSlcTBcVmk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/102603-roasted-easter-ham-DDMFS_step2-9175e14b563541dcabc20d936054bd99.jpg"
      ],
      "image": "assets/images/102603/step_02.webp"
    },
    {
      "text": "Roast ham in the preheated oven, uncovered, until heated through, about 2 hours. Let ham rest for about 15 minutes before carving to keep it from drying out.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
