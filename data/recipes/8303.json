  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix",
    "1 cup mashed bananas",
    "0.66666668653488 cup dark rum",
    "0.66666668653488 cup water",
    "0.33333334326744 cup chopped pecans",
    "2 large eggs",
    "0.25 teaspoon baking soda",
    "0.33333334326744 cup unsalted butter, softened",
    "3 cups confectioners' sugar",
    "2 tablespoons dark rum",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9-inch round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the cake: Stir cake mix, bananas, rum, water, pecans, eggs, and baking soda in a large bowl until combined, then beat with an electric mixer on medium speed for 2 to 4 minutes. Pour into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes. Cool pans on a wire rack for 5 minutes. Run a table knife around the edges to loosen cakes; invert carefully onto a cooling rack and let cool completely, about 25 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make the frosting: Beat butter in a mixing bowl with an electric mixer until creamy. Gradually mix in confectioners sugar; blend thoroughly. Mix in rum and vanilla until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread frosting on cooled cake tops, then stack layers and frost sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
