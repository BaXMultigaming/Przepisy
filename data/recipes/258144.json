  "ingredients": [
    "6 ears corn, husked",
    "0.5 cup butter, melted",
    "1 pinch salt",
    "0.5 cup firmly packed brown sugar",
    "1 (12 ounce) package smoked bacon"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium, indirect heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place each ear on a sheet of aluminum foil large enough to wrap it completely. Brush corn with butter; season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread brown sugar evenly on a large plate; roll corn in sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap 2 bacon strips around each ear to cover; wrap foil around ears to completely enclose.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill over indirect heat, flipping occasionally, until corn is tender and bacon is crisp, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
