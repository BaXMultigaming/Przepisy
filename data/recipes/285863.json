  "ingredients": [
    "1 pound frozen pitted dark sweet cherries, thawed",
    "0.5 cup white sugar",
    "1 large blood orange, juiced",
    "1 teaspoon grated orange zest",
    "1 pinch salt",
    "1 cup gluten-free flour",
    "1 cup white sugar",
    "0.75 cup almond milk",
    "0.25 cup vegan butter, melted",
    "1 tablespoon baking powder",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cherries, sugar, orange juice, orange zest, and salt for base in a stockpot over low heat; cook and stir for 10 minutes. Transfer to a 10-inch cast iron skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, sugar, almond milk, melted butter, baking powder, and salt for topping in a bowl until well mixed. Scoop over the cherries in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is slightly browned, 35 to 45 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
