  "ingredients": [
    "1 (32 ounce) package frozen French fries",
    "cooking spray",
    "1.5 cups pizza sauce, or to taste",
    "1 teaspoon oregano",
    "1 (12 ounce) package shredded mozzarella cheese",
    "1 (8 ounce) package sliced pepperoni",
    "1 teaspoon dried parsley flakes"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread fries onto a baking sheet and coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crispy, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pizza sauce and oregano together in a bowl; pour over fries. Sprinkle mozzarella cheese over sauce mixture and top with pepperoni slices. Sprinkle parsley over sauce and pepperoni.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the oven to broil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil fries until cheese is browned and bubbling, 2 to 4 minutes.",
