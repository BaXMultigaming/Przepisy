  "ingredients": [
    "1 (15 ounce) can black-eyed peas, rinsed and drained",
    "4 green onions, chopped",
    "2 tablespoons white sugar",
    "0.25 cup olive oil",
    "2 cloves garlic, minced",
    "2 roma (plum) tomatoes, chopped",
    "0.5 bunch fresh cilantro, chopped",
    "3 tablespoons balsamic vinegar",
    "0.25 teaspoon salt",
    "1 minced jalapeno pepper to taste"
  ],
  "steps": [
    {
      "text": "Stir the black-eyed peas, green onions, sugar, olive oil, garlic, tomatoes, cilantro, balsamic vinegar, and salt together in a mixing bowl. Mix in jalapeno peppers, if desired. Cover, and refrigerate at least six hours before serving.",
