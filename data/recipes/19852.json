  "ingredients": [
    "1 (14 ounce) package individually wrapped caramels, unwrapped",
    "0.33333331346512 cup evaporated milk",
    "1 (18.25 ounce) package chocolate cake mix",
    "0.75 cup butter, melted",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine caramels and 1/3 cup evaporated milk in a heavy saucepan, Cook over low heat, stirring constantly until smooth; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together cake mix, melted butter, and remaining 1/3 cup evaporated milk in a large bowl by hand until dough comes together. Press 1/2 of the dough into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Sprinkle chocolate chips over crust and pour caramel mixture evenly over chips. Crumble remaining dough over caramel layer and return to the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue baking for 15 to 18 minutes more. Cool in the refrigerator to set caramel before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
