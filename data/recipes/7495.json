  "ingredients": [
    "0.5 cup creamy peanut butter",
    "0.5 cup butter, softened",
    "4 large eggs",
    "1 (15.25 ounce) package butter cake mix",
    "0.66666698455811 cup water",
    "1 cup peanut butter",
    "0.5 cup butter, softened",
    "4 cups confectioners' sugar",
    "0.33333298563957 cup heavy cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two (9-inch) round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make cake: Beat peanut butter and butter in a mixing bowl until light and fluffy. Add eggs, one at time, mixing well after each addition. Add cake mix alternately with water, stirring until just combined. Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the centers comes out clean, about 25 minutes. Allow cakes to cool in the pans for 10 minutes, then turn out onto a wire rack to cool completely before frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make frosting: Beat peanut butter and butter in a mixing bowl until light and fluffy. Add confectioner's sugar; mix until combined. Beat in enough cream until frosting reaches spreading consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill and frost cooled cake layers with frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
