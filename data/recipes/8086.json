  "ingredients": [
    "1 (14 ounce) can fat free sweetened condensed milk",
    "0.75 cup oil substitute",
    "0.66666668653488 cup packed brown sugar",
    "2 eggs",
    "1 egg white",
    "1.75 cups all-purpose flour",
    "0.75 cup unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 cup boiling water",
    "1 cup semisweet chocolate chips",
    "1 (21 ounce) can cherry pie filling"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Coat one 12-cup, fluted tube pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cocoa, soda, baking powder, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine condensed milk, oil substitute, brown sugar, eggs, and egg white; mix well. Stir flour mixture into milk mixture just until moistened. Gradually add water. Stir in chips. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 to 40 minutes, or until inserted toothpick comes out clean. Cool cake in pan for 10 minutes. Remove from pan, and top with cherry filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
