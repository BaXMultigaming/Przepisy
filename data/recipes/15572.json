  "ingredients": [
    "1 (9 inch) pie shell",
    "4 eggs",
    "0.75 cup white sugar",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "1 teaspoon vanilla extract",
    "2.5 cups milk",
    "1 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl beat eggs then stir in sugar, salt, nutmeg or cinnamon, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat milk in a small saucepan then pour milk slowly into egg mixture, whisking constantly. Stir in coconut, then pour mixture into pastry shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes, or until knife inserted in center comes out clean. Serve slightly warm or chilled. Store in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
