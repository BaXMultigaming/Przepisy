  "ingredients": [
    "0.75 cup vegetable oil",
    "2 cups white sugar",
    "0.67 cup cocoa powder",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "4 eggs",
    "2 teaspoons vanilla extract",
    "0.5 cup chopped walnuts",
    "0.25 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "In a small mixing bowl combine flour and baking powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat oil, sugar, and cocoa together in a large mixing bowl. Add eggs to oil and cocoa mixture one egg at a time, beating well after each addition. Stir in vanilla. Mix in flour mixture. Fold in nuts if desired. Chill the dough overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into walnut-size balls and roll each ball in confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies for 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
