  "ingredients": [
    "1 (12 count) package Hawaiian bread rolls (such as King's®)",
    "0.5 cup marinara sauce",
    "8 ounces grated mozzarella cheese",
    "3 Roma tomatoes, sliced",
    "0.25 cup chopped fresh basil",
    "0.25 cup butter, melted",
    "2 tablespoons grated Parmesan cheese",
    "2 cloves roasted garlic, finely minced",
    "2 teaspoons Italian seasoning"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut the rolls in half. Set the bottom halves into the bottom of the prepared pan and spread with marinara sauce. Place a layer of mozzarella cheese over the marinara and add a layer of tomatoes over the cheese. Spread basil over the tomatoes and add the top halves of the rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine melted butter, Parmesan cheese, garlic, and Italian seasoning in a bowl; stir to combine. Brush over the tops of the sliders.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the insides are gooey and the tops are golden brown, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
