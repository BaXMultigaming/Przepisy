  "ingredients": [
    "4 skinless, boneless chicken breasts",
    "2 cups Italian-style salad dressing",
    "1 cup Italian-style dried bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken breasts in a 9x13 inch baking dish. Pour salad dressing over chicken. Cover dish and refrigerate for 30 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll each chicken piece in stuffing crumbs. Return to baking dish. Cover with aluminum foil and bake in the preheated oven for about 45 minutes or until chicken is cooked through and juices run clear.",
