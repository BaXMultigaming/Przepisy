  "ingredients": [
    "1 (15 ounce) can black-eyed peas, drained",
    "1 (10 ounce) package frozen corn kernels, thawed",
    "0.5 cup chopped celery",
    "2 tablespoons chopped pimento peppers",
    "2 tablespoons minced onion",
    "0.25 cup apple cider vinegar",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon white sugar",
    "0.5 teaspoon garlic salt",
    "0.5 teaspoon pepper",
    "0.25 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Combine black-eyed peas, corn, celery, pimentos, and onion in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk vinegar, Worcestershire sauce, sugar, garlic salt, and black pepper together in a small bowl until well combined; slowly whisk in oil until emulsified.",
