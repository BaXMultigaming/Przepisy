  "title": "Jack-o'-Lantern Tea Cakes",
  "description": "Adorable cut-out jack-o'-lantern tea cake cookies decorated with frosting and candy for a kid-friendly Halloween treat.",
  "authors": [
    "Pi3"
  ],
