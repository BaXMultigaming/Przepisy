  "ingredients": [
    "4 sticks salted butter, softened, divided",
    "1 large shallot, minced",
    "1 tablespoon minced garlic",
    "0.75 cup bourbon",
    "3 tablespoons chopped fresh parsley",
    "1.5 teaspoons lemon zest",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Melt 3 tablespoons butter in a small saucepan over medium heat; simmer, stirring frequently, until butter is browned, fragrant, and foamy, with brown bits in it, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add shallot and garlic and saute until soft, about 5 minutes. Whisk in bourbon until combined, then cook until reduced, 2 to 3 minutes. Remove from the stove and cool to room temperature, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 3 sticks plus 5 tablespoons butter, parsley, and lemon zest in a mixing bowl. Add cooled bourbon-butter mixture and beat with an electric mixer until smooth. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer butter to a sheet of waxed paper and roll into a log. Refrigerate until fully chilled, 2 to 3 hours. Use as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
