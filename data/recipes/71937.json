  "ingredients": [
    "1 tablespoon butter",
    "1 small onion, diced",
    "3 pounds chicken drumsticks",
    "2 (28 ounce) cans whole peeled tomatoes",
    "2 (28 ounce) cans tomato sauce",
    "1 (20 ounce) package frozen cauliflower and broccoli",
    "1 (10 ounce) package frozen corn",
    "0.25 cup uncooked barley",
    "0.25 cup uncooked elbow macaroni"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium heat. Add onion; cook until brown. Add chicken, cover with water, and bring to a boil. Cook until chicken is fork-tender, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken to a cutting board using tongs; cool slightly. Remove meat from chicken; transfer to a plate and discard bones. Skim cooking liquid; return chicken to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomatoes, tomato sauce, cauliflower and broccoli, corn, barley, and macaroni to the pot; cook, stirring occasionally, until barley and macaroni are tender, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
