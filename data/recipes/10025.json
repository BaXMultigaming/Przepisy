  "ingredients": [
    "1 cup butter, softened",
    "0.75 cup packed light brown sugar",
    "0.5 cup white sugar",
    "2 eggs",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup coarsely chopped macadamia nuts",
    "1 cup coarsely chopped white chocolate"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4wcxulXjRrlmss34qZx4LMIpl2Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10025-White-Chocolate-Macadamia-Nut-Cookies-iii-DDMFS-Step-01-2609f3da0b9b407bb0fd57bfcbead9c8.jpg"
      ],
      "image": "assets/images/10025/step_01.webp"
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together in a large bowl with an electric mixer until light and fluffy. Beat in eggs one at a time, then stir in vanilla and almond extracts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_IIpcXp8g4QWLbg3XwfhZmLy-K8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10025-White-Chocolate-Macadamia-Nut-Cookies-iii-DDMFS-Step-02-756b277f3bac4e6197438f247f1ca89d.jpg"
      ],
      "image": "assets/images/10025/step_02.webp"
    },
    {
      "text": "Combine flour, baking soda, and salt in another bowl. Gradually stir flour mixture into butter mixture until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h2PmZ2tgHOg7fuBkOlg4E11Zyow=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10025-White-Chocolate-Macadamia-Nut-Cookies-iii-DDMFS-Step-03-96d3324433e44254a6e4dcfa38fbd213.jpg"
      ],
      "image": "assets/images/10025/step_03.webp"
    },
    {
      "text": "Fold macadamia nuts and white chocolate into dough until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rk_xdWIfq7xdQ1Ea5h9EC3Yb1nA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10025-White-Chocolate-Macadamia-Nut-Cookies-iii-DDMFS-Step-04-6be0b5b6ffbc478d925ddb6c335b05be.jpg"
      ],
      "image": "assets/images/10025/step_04.webp"
    },
    {
      "text": "Drop rounded spoonfuls of dough 2 inches apart onto ungreased cookie sheets. Gently press each dough ball down slightly to help cookies spread evenly during baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bMARLsEf0aU9zoiNwE3mwrWIJLQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10025-White-Chocolate-Macadamia-Nut-Cookies-iii-DDMFS-Step-05-d924673a29144062bde1f5dc5ba805ca.jpg"
      ],
      "image": "assets/images/10025/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 10 minutes. Cool cookies slightly on the baking sheets, then transfer to wire racks to cool completely. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zQo-Ez7K1HgB5HMXg8kSSSCMI68=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10025-white-chocolate-macadamia-nut-cookies-iii-DDMFS-4x3-d3d55d474ecc42bf93c8c378fa0a4374.jpg"
      ],
      "image": "assets/images/10025/step_06.webp"
    }
