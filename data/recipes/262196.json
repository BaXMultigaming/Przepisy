  "steps": [
    {
      "text": "Combine carob powder and cacao powder in a small bowl. Add coconut milk little by little, mixing well until no lumps remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix applesauce and maca powder together in a bowl. Add raisins and 1 teaspoon maple syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix shredded coconut and 2 teaspoons maple syrup together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon layers of 1 tablespoon each carob mixture, maple coconut flakes, maca applesauce, and coconut yogurt, in that order, into 4 digestif glasses or small wine glasses. Cover the parfaits and refrigerate until very cold, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Decorate parfaits with figs, strawberries, and shaved chocolate.",
