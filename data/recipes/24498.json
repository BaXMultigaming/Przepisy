  "ingredients": [
    "2 tablespoons canola oil",
    "3 tablespoons all-purpose flour",
    "4 tablespoons New Mexico red chile powder",
    "2.5 cups warm water",
    "3 cloves garlic, peeled and minced",
    "1.5 teaspoons dried oregano",
    "0.33300000429153 teaspoon ground cumin",
    "1 tablespoon salt",
    "3 pounds cubed pork stew meat"
  ],
  "steps": [
    {
      "text": "In a skillet or frying pan, heat oil over medium heat. Stir in flour and brown until light golden brown. Blend in chile powder. Slowly add water, stirring until lumps are removed. Add garlic, oregano, cumin and salt. Simmer on medium heat for 15 minutes. Remove from heat and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork in a large baking pan or casserole pan. When chile mixture has cooled, add it to pork and mix until pork is covered with chile. Marinate pork for at least 12 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pork in preheated oven for at least 4 1/2 hours, or until meat is well cooked, tender and falls apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
