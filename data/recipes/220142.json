  "ingredients": [
    "4 eggs",
    "1 cup milk",
    "0.5 cup warm water",
    "3 tablespoons white sugar",
    "1 cup all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 cup butter, melted",
    "1 tablespoon butter, melted, or as needed"
  ],
  "steps": [
    {
      "text": "Blend eggs, milk, warm water, white sugar, flour, and salt together in a large mixing bowl with an electric mixer until well combined into a smooth batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stream the melted butter into the batter while continuing to beat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet or crepe pan over medium heat. Coat the cooking surface with a thin layer of butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour a thin layer of batter onto the prepared cooking surface; swirl the pan to assure even coverage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the crepe until browned on the bottom, 1 to 2 minutes; flip the crepe and continue cooking until the other side is browned. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
