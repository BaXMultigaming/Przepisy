  "ingredients": [
    "2 tablespoons vegetable oil",
    "2 tablespoons ketchup",
    "2 tablespoons brown sugar",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon soy sauce",
    "1 teaspoon lemon juice",
    "6 pork chops, trimmed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thoroughly blend oil, ketchup, brown sugar, Worcestershire sauce, soy sauce, and lemon juice in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork chops in a medium baking dish. Pour 1/2 of the sauce over chops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pork chops in the preheated oven for 30 minutes. Flip chop and cover with remaining sauce. Continue baking until the internal temperature of the chops reaches 145 degrees F (63 degrees C), about 30 minutes longer.",
      "section": null,
      "name": null,
