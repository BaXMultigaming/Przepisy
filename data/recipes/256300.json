  "ingredients": [
    "2.5 pounds pork tenderloin",
    "2 (14.5 ounce) cans Hunt's® Diced Tomatoes, undrained",
    "1 onion, chopped",
    "3 cloves garlic, minced",
    "0.25 cup water",
    "1 tablespoon dried oregano",
    "1 tablespoon brown sugar",
    "2 teaspoons ground ancho chile powder"
  ],
  "steps": [
    {
      "text": "Place pork tenderloin into a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomatoes, onion, garlic, water, oregano, brown sugar, and ancho chile powder together in a bowl. Pour mixture over pork tenderloin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low for 6 hours.",
      "section": null,
      "name": null,
      "url": null,
