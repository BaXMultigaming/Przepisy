  "ingredients": [
    "2.75 cups cake flour",
    "2.5 teaspoons baking powder",
    "2 cups white sugar",
    "1 cup butter, softened",
    "1 (3 ounce) package strawberry flavored Jell-O®",
    "4 eggs",
    "1 cup milk",
    "1 teaspoon vanilla extract",
    "0.5 cup strawberries, pureed",
    "4 ounces cream cheese",
    "4 ounces white chocolate baking squares",
    "3 tablespoons heavy whipping cream",
    "4 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease two 9-inch round cake pans and line with waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and baking powder in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, butter, and gelatin together in a separate bowl until fluffy; add eggs, one at a time, beating well with each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir alternately flour mixture then milk, into sugar mixture to form a smooth batter. Stir vanilla extract and strawberries into batter until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter between prepared cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of both cakes comes out clean, 25 to 30 minutes; cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream cheese, white chocolate, and heavy whipping cream in a saucepan over medium heat until combined and white chocolate is melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir confectioners' sugar into cream cheese mixture until a smooth frosting forms. Allow to cool and set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread a layer of frosting over the top of one cake. Place the second cake on top of frosting layer. Frost the top of second cake and sides of both cakes with remaining frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
