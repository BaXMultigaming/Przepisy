  "title": "White Chocolate Strawberry Cake",
  "description": "The moist, flavorful strawberry cake and rich white chocolate frosting combine to create a decadent dessert.",
  "authors": [
    "Damen"
  ],
  "date_published": "2020-06-18T23:48:21-04:00",
