  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 pound skinless, boneless chicken meat, cut into bite-size pieces",
    "2 (14.5 ounce) cans diced tomatoes",
    "2 (15 ounce) cans light red kidney beans, drained, liquid reserved",
    "2 onions, chopped",
    "3 potatoes, peeled and chopped",
    "3 tablespoons chili powder",
    "salt to taste",
    "1 tablespoon ground black pepper",
    "0.75 cup fresh corn kernels"
  ],
  "steps": [
    {
      "text": "Heat the oil in a skillet over medium heat, and cook the chicken 10 minutes, or until juices run clear.",
      "section": null,
