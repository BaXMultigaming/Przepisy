  "ingredients": [
    "2.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "salt to taste",
    "0.75 cup white sugar",
    "0.5 cup butter, softened",
    "1 large egg",
    "1 tablespoon caraway seeds",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F ( 175 degrees C). Grease and flour the bottom and sides of an 8-inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking powder, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter with an electric mixer in a large bowl until creamy. Mix in egg and caraway seeds. Add flour mixture in two batches, alternating with milk, beating well after each addition. Pour batter into the prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 45 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
