  "ingredients": [
    "1 medium navel orange, zested",
    "2 tablespoons dried cranberries, or more to taste",
    "0.5 cup white sugar",
    "2 tablespoons water"
  ],
  "steps": [
    {
      "text": "Cut off both ends of the zested orange, and cut orange in half. Peel halves and remove the white core.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place orange sections and cranberries in a food processor. Pulse until orange is mostly pulp, using roughly 5 three-second pulses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the orange-cranberry mixture, zest, sugar, and water in a medium saucepan. Bring to a gentle boil and simmer, stirring frequently, for 15 minutes. Let marmalade cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour marmalade into a glass jar with a tight-fitting lid. Chill completely in refrigerator before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
