  "ingredients": [
    "5 cups cubed cinnamon raisin bread",
    "1.5 cups milk",
    "4 eggs",
    "0.25 cup white sugar",
    "1 teaspoon vanilla extract",
    "3 tablespoons softened butter, cut into chunks",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly butter an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour bread cubes into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk, eggs, sugar, and vanilla together in a large bowl until evenly mixed; pour mixture over bread cubes. Arrange butter chunks atop bread mixture. Set aside for bread to absorb liquid, about 10 minutes. Sprinkle the top with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
