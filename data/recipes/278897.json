  "ingredients": [
    "1 serving cooking spray",
    "4 eggs",
    "3 tablespoons heavy cream",
    "2 slices bacon, cooked and crumbled",
    "0.5 cup shredded Jack cheese",
    "0.25 cup chopped green chiles (such as Ortega®)",
    "3 tablespoons diced tomatoes",
    "2 tablespoons finely chopped onion",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C). Spray a 6-inch cake pan with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and cream together in a bowl. Add bacon, Jack cheese, chiles, tomatoes, onion, salt, and pepper. Stir until well combined. Pour into the cake pan and place inside the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry for 10 minutes. Cover the pan with foil if the top is browning too fast; continue cooking until a toothpick inserted in the center comes out clean, 6 to 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
