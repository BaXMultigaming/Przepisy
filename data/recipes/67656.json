  "ingredients": [
    "cooking spray",
    "1 (15.25 ounce) package chocolate cake mix",
    "1 cup water",
    "3 large eggs",
    "0.33 cup vegetable oil",
    "1 (16 ounce) container prepared chocolate frosting",
    "1 (3 ounce) bar chocolate flavored confectioners coating"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish with cooking spray. Line a baking tray with waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend cake mix, water, eggs, and oil in a large bowl with an electric mixer at low speed until moistened, about 30 seconds. Beat at medium speed for 2 minutes. Pour batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of cake comes out clean, 26 to 31 minutes. Let cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble warm cake into a large bowl; stir in frosting until well blended. Use a melon baller or small scoop to form chocolate cake mixture into balls and place them on the prepared baking tray. Place in the freezer until cake balls are chilled, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate coating in a glass bowl in the microwave or a metal bowl over a pan of simmering water, stirring occasionally until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip cake balls in melted chocolate using a toothpick or fork to hold them. Return to the tray to set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nx_dAwKWLDUYYRZeMm9k7aOnUtg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/67656-cake-balls-VAT-Beauty-4x3-12773143c5f141608b34d545d84ebc40.jpg"
      ],
