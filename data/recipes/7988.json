  "ingredients": [
    "2 cups white sugar",
    "1 cup butter, softened",
    "3 large eggs",
    "0.5 cup water",
    "1 tablespoon vanilla extract",
    "2.5 cups all-purpose flour",
    "2 tablespoons unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "2 cups apples - peeled, cored and finely diced",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 9- or 10-inch tube pan (such as Bundt).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a bowl with an electric mixer until light and fluffy; beat in eggs, then beat in water and vanilla extract. Whisk flour, cocoa powder, baking soda, cinnamon, and nutmeg together in a separate bowl until well mixed; beat into sugar mixture just to combine. Stir in apples and chocolate chips until evenly distributed. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted near center comes out clean, about 1 hour and 15 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
