  "title": "Caramel for Apples",
  "description": "This homemade caramel is perfect for coating apples--let it cool slightly before dipping. It&#39;s great over ice cream, too.",
  "authors": [
    "SPLACE"
  ],
  "date_published": "2020-06-18T23:09:29-04:00",
