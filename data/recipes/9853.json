  "ingredients": [
    "0.25 cup butter",
    "4 (1 ounce) squares unsweetened chocolate",
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "0.5 cup chopped walnuts",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "3 eggs",
    "0.33333298563957 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Melt butter and chocolate either in a microwave or over low heat on the stove. Allow to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in remaining ingredients, except powdered sugar. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover dough and chill for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 1 inch balls. Roll in powdered sugar to coat heavily. Place 2 inches apart on an ungreased cookie sheet. Bake for 15 to 18 minutes or until edges are set. Remove from cookie sheet and cool on rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
