  "ingredients": [
    "1 cup water",
    "0.5 cup salted butter",
    "1 cup all-purpose flour",
    "4 large eggs, beaten",
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup sour cream",
    "0.25 cup finely chopped celery",
    "2 tablespoons minced onion",
    "0.25 teaspoon garlic powder",
    "1 dash soy sauce",
    "1 (12 ounce) package imitation crabmeat"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and butter to a boil in a saucepan; reduce heat to low. Stir in flour until forms a ball. Off heat, add eggs all at once; stir until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by teaspoonfuls onto a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffs are golden brown and hollow sounding, 20 to 25 minutes. Cool, then split.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine cream cheese, sour cream, celery, onion, garlic powder, and soy sauce until smooth; fold in crabmeat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill cooled puff pastries with crab mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
