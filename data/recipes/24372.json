  "ingredients": [
    "1 (.25 ounce) package active dry yeast",
    "1 cup warm water",
    "2 cups whole wheat flour",
    "0.25 cup wheat germ",
    "1 teaspoon salt",
    "1 tablespoon honey"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Flour a 12-inch pizza pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, dissolve yeast in warm water. Let stand until creamy, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine flour, wheat germ, and salt. Make a well in the center and pour in honey and yeast mixture. Stir well to combine. Cover and set in a warm place to rise for a few minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dough to the prepared pizza pan and roll to fit. Poke a few holes in dough with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 to 10 minutes, or until desired crispiness is achieved.",
      "section": null,
      "name": null,
      "url": null,
