  "ingredients": [
    "1 bagel",
    "2 large eggs",
    "1 tablespoon milk",
    "0.125 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "2 tablespoons crumbled cooked bacon",
    "2 tablespoons shredded Cheddar cheese",
    "2 teaspoons chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Preheat a toaster oven to the bagel setting or an oven to 350 degrees F (175 degrees C). Line a small pan with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Split bagel and scoop out the soft interior of each half with a spoon. (Discard excess or reserve for another use.) Whisk together eggs, milk, salt, and pepper in a small bowl. Stir in bacon. Add cheese, followed by half the egg mixture, to each hollowed-out bagel half. Transfer to the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast bagel until eggs are set, about 10 minutes. Sprinkle with chives and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
