  "keywords": [],
  "ingredients": [
    "3 cups uncooked brown rice",
    "6 cups water",
    "1 cup toasted cashews",
    "1 pound toasted unsalted sunflower seeds",
    "1 sweet onion, chopped",
    "6 carrots, chopped",
    "1 tablespoon extra virgin olive oil",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "In a large pot, bring the rice and water to a boil. Reduce heat to low, cover, and simmer 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a food processor, grind the toasted cashews and sunflower seeds to a fine meal. Transfer to a large bowl. Pulse the onion and carrots in the food processor until finely shredded, and mix with the ground nuts. Place the cooked rice and olive oil in the food processor, and pulse until smooth. Mix into the bowl. Season with salt. Form the mixture into patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Oil the grill grate. Grill the patties 6 to 8 minutes on each side, until nicely browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
