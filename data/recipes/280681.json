  "ingredients": [
    "4 ears sweet corn",
    "2 tablespoons olive oil",
    "6 large tomatoes, chopped",
    "2 (15 ounce) cans black beans, rinsed and drained",
    "1 large onion, diced",
    "2 jalapeno peppers, finely chopped",
    "0.33333334326744 cup chopped fresh cilantro",
    "4 tablespoons lime juice",
    "3 cloves garlic, finely diced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice corn off of cobs and toss with olive oil. Spread across a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven, checking frequently, for 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine tomatoes, black beans, onion, jalapeno peppers, cilantro, lime juice, and garlic in a large bowl. Stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove corn from the oven and stir into salsa. Cover and refrigerate for at least 2 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
