  "ingredients": [
    "1 cup butter, softened",
    "0.5 cup confectioners' sugar",
    "1.5 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "1 pinch salt",
    "1.5 teaspoons baking powder",
    "0.75 cup chopped walnuts",
    "0.33333334326744 cup confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Beat together the butter and confectioners' sugar till creamy. Add vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the dry ingredients, stir into creamy mixture. Blend well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the nuts, mix well, roll the dough out into two balls. Wrap in plastic wrap and chill for at least 1 hour in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flatten dough out and cut into 15 or 20 equal size pieces, shape into balls. Place on ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 10 to 12 minutes till firm but not brown. While still warm roll into confectioners' sugar, let cool and roll again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
