  "title": "Old Charleston-Style Shrimp and Grits",
  "description": "This shrimp and grits recipe featuring creamy, cheesy grits topped with a savory shrimp sauce is a classic Southern seafood dish bursting with flavor.",
  "authors": [
    "berskine"
  ],
  "date_published": "2011-12-17T10:15:17-05:00",
