        "https://www.allrecipes.com/thmb/lOS4k2Vm8Zw_Z-fKvyMJoVd_dgE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274777-soft-boiled-eggs-in-the-microwave-DDMFS-292-4x3-step-06-360584579ec448e381f6a37c89f4a138.jpg"
