      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fMwYVtTdfzmNA4WLo2jO8spL8g4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274777-soft-boiled-eggs-in-the-microwave-DDMFS-286-4x3-step-04-bf2904cbbd3c41f9b42123659c3331e9.jpg"
      ],
      "image": "assets/images/274777/step_02.webp"
    },
    {
      "text": "Remove eggs from warm water and place into boiling water; cover the bowl with plastic wrap. Microwave at 60% power for 1 ½ minutes.",
