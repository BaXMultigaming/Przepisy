  "title": "Southern Fried Chicken Gizzards",
  "description": "A chicken gizzard is transformed into a thing of beauty when simmered until tender, marinated in spicy seasonings, coated in flour, and deep-fried.",
  "authors": [
    "pnutmommy"
  ],
  "date_published": "2011-12-15T15:48:04-05:00",
