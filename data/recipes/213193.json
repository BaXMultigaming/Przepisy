    "publisher-tested"
  ],
  "ingredients": [
    "1 pound chicken gizzards, rinsed",
    "2 stalks celery, cut into chunks",
    "1 onion, cut into chunks",
    "2 bay leaves",
    "1.5 teaspoons celery salt, divided",
    "1 teaspoon seasoned salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon dried Italian herb seasoning",
    "1 teaspoon garlic powder",
    "0.25 teaspoon ground cumin",
    "0.5 teaspoon Louisiana-style hot sauce",
    "3 cups oil for deep frying",
    "1 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WB4Ovq5oEm9ODbh7n_ohBuKdMww=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213193-southern-fried-chicken-gizzards-ddmfs-Step-1-0196-f704ddf0c60d4588a8cc02a42518078a.jpg"
      ],
      "image": "assets/images/213193/step_01.webp"
    },
    {
      "text": "Place chicken gizzards, celery, onion, bay leaves, and 1 teaspoon celery salt into a saucepan, and pour in enough water to cover the gizzards by 1 inch. Bring gizzards to a boil, reduce heat to low, cover, and simmer until tender, about 2 1/2 hours. Pour in more water during simmering, if needed, to keep gizzards covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G7uNSY-NJJZAdKwyqCKwirZwdF8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213193-southern-fried-chicken-gizzards-ddmfs-Step-2-0198-cd94e43eb6524722a06e21e406b3fecb.jpg"
      ],
      "image": "assets/images/213193/step_02.webp"
    },
    {
      "text": "Once cooked, remove gizzards to a bowl, discard celery and onion, and reserve the broth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season gizzards with 1/2 teaspoon celery salt, seasoned salt, pepper, Italian seasoning, garlic powder, cumin, and hot sauce, stirring to combine well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-OizBxyzylAuVPWTNi024tk4pHs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213193-southern-fried-chicken-gizzards-ddmfs-Step-3-0200-37737fe6d32f4c1aa6e4d25a12bd6e16.jpg"
      ],
      "image": "assets/images/213193/step_04.webp"
    },
    {
      "text": "Pour 1/3 cup of the reserved broth over the seasoned gizzards, and refrigerate for 30 minutes or more, stirring often. (Save or freeze the remaining broth for another use, if desired.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Coz3X4frHUiV9OWWCHIKwQOytqs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213193-southern-fried-chicken-gizzards-ddmfs-Step-4-0201-0b608df34be54864a70f599ee42f11c9.jpg"
      ],
      "image": "assets/images/213193/step_05.webp"
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour in a plastic bag, and transfer the gizzards with their seasoning into the bag as well. Shake the bag to thoroughly coat the gizzards with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3OCcIBZwvPjc9-HlPAsP0EL_xeE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213193-southern-fried-chicken-gizzards-ddmfs-Step-5-0206-a6faf183c25c43479ff487af8bdb321a.jpg"
      ],
      "image": "assets/images/213193/step_07.webp"
    },
    {
      "text": "Gently lower the gizzards into the hot oil in batches, and fry until golden brown, about 5 minutes per batch. Drain the gizzards on paper towels, and serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BOGH_wzNzi4Tg4Xq-fAItwpSfTc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/213193-southern-fried-chicken-gizzards-ddmfs-Step-7-0222-652d7d2bcbb44d48a38fcb4891b7b8d2.jpg"
      ],
      "image": "assets/images/213193/step_08.webp"
    }
  ],
