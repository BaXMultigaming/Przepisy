  "title": "Waterzooi (Vaterzoy)",
  "description": "A whole fryer chicken is cut up and slowly simmered with leeks, onions, celery, nutmeg, lemon juice and egg yolks.",
  "authors": [
    "Rayna Jordan"
  ],
  "date_published": "2000-10-15T21:08:30-04:00",
