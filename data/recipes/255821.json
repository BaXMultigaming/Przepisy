  "ingredients": [
    "3.5 cups rolled oats",
    "0.5 cup brown sugar",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 cup cooked and mashed sweet potato",
    "1 cup milk",
    "2 eggs, lightly beaten",
    "0.25 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8x8-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, brown sugar, baking powder, salt, cinnamon, and nutmeg together in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix potatoes, milk, eggs, and oil together in a separate bowl until well combined. Add sweet potatoes to oats and mix until well combined. Spread evenly in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until oatmeal sets, and top is golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
