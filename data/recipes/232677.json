  "ingredients": [
    "0.5 pound bacon",
    "2 (14.5 ounce) cans Great Northern beans, rinsed and drained",
    "2 small onions, chopped",
    "1 cup water",
    "0.75 cup packed brown sugar",
    "3 tablespoons ketchup",
    "3 tablespoons molasses",
    "1 tablespoon vinegar",
    "1 tablespoon mustard",
    "1 teaspoon salt",
    "1 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2 1/2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat until crisp, about 10 minutes; drain and cool on paper towels. Crumble bacon once cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bacon, beans, onions, water, brown sugar, ketchup, molasses, vinegar, mustard, salt, and garlic powder together in the prepared baking dish. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until bubbling, 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
