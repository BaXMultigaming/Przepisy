  "ingredients": [
    "3 tablespoons olive oil",
    "2 pounds skinless, boneless chicken breast halves",
    "seasoned salt to taste",
    "6 cups chicken broth",
    "1 head green cabbage, shredded",
    "1 large onion, chopped",
    "1 cup chopped carrots",
    "1 green bell pepper, chopped",
    "2 stalks celery, chopped",
    "1 (6.5 ounce) can tomato sauce",
    "0.5 cup chopped cilantro",
    "2 limes, juiced",
    "4 cloves garlic, minced",
    "1 dash hot sauce (such as Marie Sharp's Belizean Habanero Sauce), or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large Dutch oven over medium heat. Season chicken with seasoned salt. Cook chicken in hot oil until browned, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chicken broth, cabbage, onion, carrots, green bell pepper, celery, tomato sauce, cilantro, lime juice, garlic, hot sauce, salt, and black pepper into chicken in the Dutch oven. Simmer, adding water if needed, until stew is thickened, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle stew into bowls and top each with a piece of chicken.",
      "section": null,
