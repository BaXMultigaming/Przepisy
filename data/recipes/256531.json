  "ingredients": [
    "cooking spray with flour",
    "1 (16.5 ounce) package devil's food cake mix",
    "1 (8 ounce) container sour cream",
    "4 large eggs",
    "0.5 cup coffee-flavored liqueur (such as Kahlua®)",
    "0.5 cup vegetable oil",
    "1 (3.9 ounce) package instant chocolate pudding mix",
    "2 tablespoons grated orange zest",
    "1 teaspoon ground cinnamon",
    "1 (12 ounce) package mini chocolate chips",
    "1 tablespoon confectioners' sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a fluted tube pan (such as Bundt) with floured cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, sour cream, eggs, coffee-flavored liqueur, oil, pudding mix, orange zest, and cinnamon in a large bowl; beat with an electric mixer on medium speed until very smooth, about 4 minutes. Fold in chocolate chips. Pour batter into the prepared Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and cool in the pan for 10 minutes. Invert cake onto a plate and remove from pan; let cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dust with confectioners' sugar to serve.",
      "section": null,
      "name": null,
      "url": null,
