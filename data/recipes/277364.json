  "ingredients": [
    "0.75 cup fat free half-and-half",
    "0.25 cup whipping cream",
    "0.25 cup fine-quality bittersweet chocolate (preferably 70% cacao), finely chopped",
    "2 tablespoons white sugar",
    "0.5 teaspoon vanilla extract",
    "1 pinch ground cinnamon",
    "0.25 cup red wine"
  ],
  "steps": [
    {
      "text": "Combine 1/2 of the half-and-half and 1/2 of the cream into a saucepan over low heat. Add chopped chocolate to the warmed cream mixture, whisking constantly (to prevent scalding) until chocolate is melted, 2 to 3 minutes. Pour in remaining half-and-half, remaining cream, sugar, vanilla extract, and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add red wine and allow to bubble for about 3 minutes. Remove from the heat and pour into a coffee mug to serve.",
