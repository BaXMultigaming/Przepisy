  "ingredients": [
    "1 pint cherry tomatoes, halved",
    "2 cups cubed seeded watermelon",
    "6 large basil leaves, thinly sliced",
    "0.5 cup crumbled feta cheese",
    "1 teaspoon lemon zest",
    "2 tablespoons extra-virgin olive oil",
    "1.5 tablespoons white balsamic vinegar",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Place the tomatoes and watermelon into a mixing bowl. Sprinkle with the basil, feta cheese, and lemon zest. Drizzle with the olive oil and balsamic vinegar. Toss gently. Season to taste with salt and pepper before serving.",
