  "ingredients": [
    "1 cup butter",
    "0.25 cup soy sauce",
    "2 tablespoons Dijon mustard",
    "3 cloves garlic, minced",
    "2 teaspoons ketchup",
    "1 teaspoon Worcestershire sauce"
  ],
  "steps": [
