  "ingredients": [
    "2 cups light brown sugar",
    "2 cups white sugar",
    "2 teaspoons vanilla extract",
    "2 cups vegetable oil",
    "4 large eggs",
    "4 cups all-purpose flour",
    "1.5 cups quick cooking oats",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "4 cups cornflakes cereal",
    "1 cup chopped pecans",
    "1 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream brown sugar, white sugar, oil, eggs, and vanilla together in a large bowl. Add flour, oats, baking soda, and salt. Mix well. Stir in cornflakes, pecans, and coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by rounded tablespoonfuls onto an ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
