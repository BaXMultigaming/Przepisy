  "ingredients": [
    "2 cups Almond Breeze Vanilla almondmilk",
    "0.25 cup sugar",
    "2 tablespoons cornstarch + 2 teaspoons cornstarch",
    "2 teaspoons cornstarch",
    "1 teaspoon vanilla extract",
    "2 tablespoons coconut oil",
    "0.75 cup fresh raspberries"
  ],
  "steps": [
    {
      "text": "Whisk almond milk, sugar, cornstarch, and vanilla extract together in a small saucepan until well combined; bring to a simmer, whisking frequently. Add coconut oil; cook over low heat until mixture thickened, stirring frequently, about 5 minutes. Cool, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in berries, then spoon mixture into ice cream pop molds. Insert a handle or popsicle stick into each. Place in the freezer until solid, 8 hours to overnight.",
