  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "0.5 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "5 tablespoons vegetable oil",
    "1 teaspoon vinegar",
    "1 teaspoon vanilla extract",
    "1 cup water",
    "2 (1 ounce) squares unsweetened chocolate, chopped",
    "0.25 cup margarine",
    "0.25 cup water",
    "1 teaspoon vanilla extract",
    "2 cups confectioners' sugar",
    "1 cup miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Sift together the flour, sugar, cocoa, baking soda and salt. Sift once more, then sift again into a 9 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a well in the center, and measure in the oil, vinegar and vanilla. Pour water over all and mix with a fork until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 35 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the frosting: In a saucepan, combine chocolate, margarine and water. Cook over low heat until melted and smooth. Remove from heat and stir in vanilla and confectioners' sugar. Fold in miniature marshmallows. Spread over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
