  "ingredients": [
    "3 cloves garlic",
    "1 tablespoon mild curry paste",
    "1 onion, diced",
    "1 green bell pepper, chopped",
    "1 pound ground chicken",
    "4 stalks celery, chopped",
    "4 carrots, chopped",
    "2 zucchini, diced",
    "2 roma tomatoes, diced",
    "1 cup chicken broth",
    "1 tablespoon soy sauce",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Mash garlic in the bottom of a saucepan. Stir curry paste into garlic; add onion and bell pepper. Cook and stir over medium-low heat until onion is golden, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble ground chicken into the saucepan; add celery, carrots, zucchini, and tomatoes. Increase heat to medium, cover the saucepan with a lid, and cook until carrots have softened, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chicken broth and soy sauce over mixture; season with salt. Reduce heat to medium-low, cover with a lid, and simmer for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
