  "ingredients": [
    "4 cups vegetable broth",
    "2 pounds russet potatoes, peeled and cubed",
    "4 cloves garlic",
    "3 teaspoons salt, divided",
    "0.25 cup butter",
    "0.25 cup milk",
    "0.25 cup finely grated Parmesan cheese",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Combine vegetable broth, potatoes, garlic, and 2 teaspoons salt in a multi-functional pressure cooker (such as Instant Pot). Close and lock the lid. Select Steam function according to manufacturer's instructions; set timer for 15 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain potatoes and place back in the pot; mash until creamy. Mix in butter, milk, and Parmesan cheese. Season with remaining salt and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
