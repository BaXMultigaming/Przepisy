  "ingredients": [
    "4 potatoes, peeled and sliced",
    "1 pound ground beef",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 onion, thinly sliced",
    "1 (15 ounce) can kidney beans, drained",
    "1 (10.75 ounce) can condensed tomato soup"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Xd6CK82eYQHd2czglaB9TNNXnVY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-14593-grandma-flos-shipwreck-VAT-step-01-7692ac4aac9e43d7aba7314a7f3904cc.jpg"
      ],
      "image": "assets/images/14593/step_01.webp"
    },
    {
      "text": "Arrange potatoes at the bottom of the casserole dish. Crumble ground beef over potatoes, and sprinkle with 1/2 teaspoon salt and ground black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n6_VfQdml6X-fMhCNKqLIrDm85Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-14593-grandma-flos-shipwreck-VAT-step-02-A-6a03a10b32904c65979c0b836852328f.jpg"
      ],
      "image": "assets/images/14593/step_02.webp"
    },
    {
      "text": "Spread onions over meat and then beans. Pour undiluted soup over everything. Sprinkle with remaining 1/2 teaspoon salt. Cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4KzYuqWbNinCeHkVQorXxjcDrps=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-14593-grandma-flos-shipwreck-VAT-step-03-b44e4d0e735c4e4cb83f65be72d707a1.jpg"
      ],
      "image": "assets/images/14593/step_03.webp"
    },
    {
      "text": "Bake for 30 minutes. Remove cover, and continue baking for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
