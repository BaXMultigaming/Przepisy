  "ingredients": [
    "12 ounces dry ziti pasta",
    "3 tablespoons olive oil",
    "1 onion, chopped",
    "1 red bell pepper, chopped",
    "2 cloves garlic, minced",
    "1 pound kielbasa sausage, sliced into 1/2 inch pieces",
    "12 ounces sauerkraut, drained and rinsed",
    "2 tablespoons prepared Dijon-style mustard",
    "1 pinch cayenne pepper",
    "0.25 cup white wine",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until al dente, 8 to 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat olive oil in a large skillet over medium heat. Cook onion and bell pepper in oil, stirring frequently, until onion is tender. Stir in garlic and kielbasa and cook until kielbasa begins to brown, about 8 minutes. Stir in sauerkraut, mustard, and cayenne; cook about 4 minutes more. Stir in wine and parsley and heat through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss ziti with kielbasa and sauerkraut mixture and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
