  "ingredients": [
    "2 cups ice cubes",
    "1.5 cups milk",
    "3 tablespoons white sugar",
    "2 tablespoons chocolate-hazelnut spread (such as Nutella®)",
    "4 teaspoons instant coffee granules",
    "1 tablespoon vanilla extract"
  ],
