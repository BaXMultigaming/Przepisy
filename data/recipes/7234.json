  "ingredients": [
    "1 cup hot, brewed coffee",
    "0.5 cup raisins",
    "0.5 cup shortening",
    "1 cup white sugar",
    "2 eggs",
    "2 tablespoons molasses",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground ginger",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Soak raisins in coffee until plump. Do not drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the shortening, sugar and eggs. Blend in molasses and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl mix together the cinnamon, nutmeg, cloves, ginger, flour, baking soda, and salt. Make a well in the center of the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the liquid ingredients to the well in the dry ingredients. Stir in coffee with raisins and nuts. Pour batter into a greased 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 350 degree F(175 degrees C) oven for one hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
