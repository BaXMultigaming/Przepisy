  "ingredients": [
    "3.5 cups plain or vanilla soy milk",
    "0.25 teaspoon salt",
    "2 cups rolled oats",
    "0.25 cup pure maple syrup",
    "0.33333334326744 cup raisins",
    "0.33333331346512 cup dried cranberries",
    "0.33333334326744 cup sweetened flaked coconut",
    "0.33333334326744 cup chopped walnuts",
    "1 (8 ounce) container plain yogurt",
    "3 tablespoons honey"
  ],
  "steps": [
    {
      "text": "Pour the milk and salt into a saucepan, and bring to a boil. Stir in the oats, maple syrup, raisins, and cranberries. Return to a boil, then reduce heat to medium. Cook for 5 minutes. Stir in walnuts and coconut, and let stand until it reaches your desired thickness. Spoon into serving bowls, and top with yogurt and honey, if desired.",
