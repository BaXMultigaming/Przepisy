  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sweet potato fries in a single layer on the crisping tray of the air fryer basket. You may need to cook the fries in batches. Air fry for 15 minutes, vigorously shaking at the 8-minute point. Pour fries into a serving bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fish fillets in a single layer across the crisping basket. If they do not all fit without overlapping, cook in batches. Air fry for 15 minutes, flipping fish fillets over at the 8-minute point.",
