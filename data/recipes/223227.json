  "ingredients": [
    "4 walleye fillets",
    "0.5 cup all-purpose flour",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon ground black pepper",
    "1 pinch salt",
    "2 eggs, beaten",
    "2 cups crushed saltine crackers",
    "vegetable oil for frying",
    "1 lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Check walleye fillets to ensure all bones and skin have been removed. Cut fillets into manageable pieces, if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, garlic powder, pepper, and salt in a shallow bowl. Place beaten eggs in a separate shallow bowl. Place cracker crumbs onto a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep fryer or large cast iron skillet to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip fillets into flour mixture, then dip in beaten egg, and then coat evenly with cracker crumbs; set fillets aside on a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully lower 2 fillets into hot oil using tongs; cook until golden brown, about 3 minutes per side. Transfer to a paper towel-lined plate; repeat with remaining fillets. Serve with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
