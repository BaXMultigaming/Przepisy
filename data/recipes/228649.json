  "ingredients": [
    "1 pound ground beef",
    "0.25 white onion, chopped",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon dried oregano",
    "1 (26 ounce) jar chunky tomato sauce (such as Ragu®)",
    "3 tablespoons white sugar",
    "18 lasagna noodles",
    "cooking spray",
    "1 (15 ounce) container ricotta cheese",
    "1 large egg, beaten",
    "2 tablespoons chopped fresh parsley",
    "1 cup grated Parmesan cheese, divided",
    "1 (12 ounce) package shredded mozzarella cheese, or as needed"
  ],
  "steps": [
    {
      "text": "Cook and stir ground beef, onion, garlic powder, and oregano in a large skillet over medium heat until onion is tender and beef is browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lU-vyy_h7BYsI7AWD_C2Qjg2ULk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228649-LasagnaRollUpsii-ddmfs-Step1-0473-4x3-f0ac8e8aa060461db7de85cd05f9ab7d.jpg"
      ],
      "image": "assets/images/228649/step_01.webp"
    },
    {
      "text": "Add tomato sauce and sugar; simmer until sauce is heated through, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zkw8DUJD9JVUcOZjYKO6yIf2WT4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228649-LasagnaRollUpsii-ddmfs-Step2-0474-4x3-1bc9c60a6829404cad960967aa937378.jpg"
      ],
      "image": "assets/images/228649/step_02.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook lasagna in the boiling water, stirring occasionally until cooked through but firm to the bite, 8 to 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/L-ixZAu2aeYOxBG4v8o3e-O15xA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228649-LasagnaRollUpsii-ddmfs-Step3-0475-4x3-cebf5fe0a0b5438bb3865cb2be5c4ce3.jpg"
      ],
      "image": "assets/images/228649/step_03.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ricotta cheese, egg, parsley, and 3/4 cup Parmesan cheese together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v0RgvlNRF7iLqLQ89fOQEinxqU8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228649-LasagnaRollUpsii-ddmfs-Step4-0477-4x3-fe4b56b4fcf141fba9dadfe03b03f759.jpg"
      ],
      "image": "assets/images/228649/step_05.webp"
    },
    {
      "text": "Place a lasagna noodle on a work surface. Spoon one layer ricotta cheese mixture, one layer meat sauce, and one layer mozzarella cheese atop lasagna noodle; top with another lasagna noodle. Roll up the stuffed lasagna noodles in the jelly-roll style; place in the prepared casserole dish. Repeat with remaining lasagna noodles, ricotta cheese mixture, meat sauce, and mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5Ra5UejLDheQWOafyUEVK-0DLnw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228649-LasagnaRollUpsii-ddmfs-Step5-0484-4x3-01138f1a4cc54f6f81c2b25b45daa199.jpg"
      ],
      "image": "assets/images/228649/step_06.webp"
    },
    {
      "text": "Spread a spoonful of meat sauce atop each lasagna roll; top with remaining mozzarella cheese and 1/4 cup Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yQXW--sBNLwzPEw_ekR6QYu8GaQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228649-LasagnaRollUpsii-ddmfs-Step6-0490-4x3-0442e101f5fa4af09b14bbd31b95dfcb.jpg"
      ],
      "image": "assets/images/228649/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and bubbling, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c8fUPSIU57TMu3JIWu73xmEOG0U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228649-LasagnaRollUpsii-ddmfs-Step6-10493-4x3-fe346372f68e4f988b504d2f086bd215.jpg"
      ],
      "image": "assets/images/228649/step_08.webp"
    }
