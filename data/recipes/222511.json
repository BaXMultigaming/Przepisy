  "ingredients": [
    "2.5 cups ice, divided",
    "2 fluid ounces gin",
    "0.75 fluid ounce lemon juice",
    "0.5 fluid ounce simple syrup",
    "2 fluid ounces club soda",
    "1 lemon wedge"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
