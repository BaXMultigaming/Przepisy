  "ingredients": [
    "1 pound cubed beef stew meat",
    "3 cups cold water",
    "0.75 cup vinegar",
    "9 tablespoons soy sauce",
    "9 tablespoons brown sugar",
    "5 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Heat a deep skillet over medium heat. Cook and stir beef in hot skillet until completely browned, 7 to 10 minutes. Transfer beef to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk water, vinegar, soy sauce, brown sugar, and cornstarch together until smooth; pour over the beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until the beef is tender and the sauce is thick, 6 to 8 hours.",
