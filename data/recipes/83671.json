  "ingredients": [
    "0.25 cup margarine",
    "1 onion, chopped",
    "1 red bell pepper, chopped",
    "1 clove garlic, chopped",
    "1 teaspoon ground paprika",
    "1 teaspoon caraway seed",
    "1 teaspoon dried marjoram",
    "0.5 pound pork tenderloin, cut into thin strips",
    "1 cup water",
    "1 (6 ounce) can tomato paste",
    "0.5 cube beef bouillon, crumbled",
    "1 (16 ounce) jar sauerkraut"
  ],
  "steps": [
    {
      "text": "Heat the margarine in a skillet over medium heat, and saute the onion, red bell pepper, and garlic until tender. Season with paprika, caraway seed, and marjoram. Place pork strips into the skillet, and cook 5 minutes, until lightly browned. Stir in water and tomato paste, and sprinkle in the bouillon. Continue cooking 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sauerkraut into the skillet, and continue cooking 10 minutes, until pork is done and sauerkraut is heated through.",
