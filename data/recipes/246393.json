  "ingredients": [
    "cooking spray",
    "0.5 cup brown sugar",
    "3 tablespoons all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "6 apples - peeled, cored, and chopped, or more to taste",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts",
    "0.25 cup butter, cut into small cubes",
    "0.5 cup whole milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, flour, cinnamon, nutmeg, and cloves together in a large bowl; add apples and toss to coat. Stir raisins, walnuts, and butter into apple mixture. Spread apple mixture evenly in prepared baking dish. Combine milk and vanilla extract together in a bowl; pour evenly over apple mixture. Cover baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apples are easily pierced with a fork, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove foil and stir apples. Bake until apples are very soft and mixture is bubbly, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
