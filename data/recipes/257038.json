  "ingredients": [
    "2.5 cups Quaker® Oats (Quick or Old Fashioned, uncooked)",
    "2 tablespoons honey",
    "0.25 cup creamy or chunky peanut butter",
    "1 cup ripe mashed banana",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Place oats and cinnamon in a large bowl; stir to blend well. Add mashed banana, peanut butter, and honey. Stir until ingredients are well blended.",
      "section": null,
