  "ingredients": [
    "3.5 cups water",
    "1 dash salt",
    "1 cup steel-cut oats",
    "0.5 cup milk",
    "0.5 cup cashews",
    "0.25 cup sweetened dried cranberries (such as Ocean Spray® Craisins®)",
    "2 tablespoons flaked coconut",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "1 pinch white sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Bring water and salt to a boil in a saucepan. Stir oats into boiling water; cook oats until thick and soft, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk, cashews, cranberries, coconut, vanilla extract, and cinnamon into cooked oats; continue cooking, stirring frequently, for 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle sugar over oats to serve.",
      "section": null,
