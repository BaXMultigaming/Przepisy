  "ingredients": [
    "2 cups white sugar",
    "1.25 cups butter, softened",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "0.75 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together sugar and butter in a large bowl until light and fluffy. Beat in eggs one at a time, then stir in vanilla. Sift together flour, cocoa, baking soda, and salt; stir into creamed mixture. Mix in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 8 to 9 minutes. Cookies will be soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool slightly on cookie sheet; remove from sheet onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
