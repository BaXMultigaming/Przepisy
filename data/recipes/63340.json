  "ingredients": [
    "4 cups Brussels sprouts, trimmed and halved",
    "5 tablespoons butter",
    "0.5 pound whole mushrooms",
    "0.5 cup chopped fresh parsley",
    "fresh lemon juice",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Cook Brussels sprouts in a pot of lightly salted boiling water for 15 minutes, or until fork-tender; strain through a colander, removing as much water as possible. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium-high heat. Cook and stir mushrooms until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss Brussels sprouts with mushrooms and sprinkle with parsley, lemon juice, salt, and pepper. Serve immediately.",
      "section": null,
