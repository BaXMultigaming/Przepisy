  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1 pinch ground nutmeg",
    "3 bananas (ripe or very ripe work best)",
    "0.5 cup white sugar",
    "0.33333334326744 cup butter, melted",
    "0.25 cup lightly packed brown sugar",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "0.25 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, baking soda, cinnamon, salt, and nutmeg together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash bananas in a large bowl. Mix in white sugar, melted butter, brown sugar, egg, and vanilla extract. Fold in flour mixture until just combined. Fold walnuts into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter evenly among the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
