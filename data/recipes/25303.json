  "title": "Creamy Chicken Fettuccine Alfredo",
  "description": "Al dente fettuccine pasta is topped with tender chunks of chicken and a creamy Alfredo sauce made with mushrooms, tomatoes, and lots of cheese.",
  "authors": [
    "Emily"
  ],
  "date_published": "2019-04-02T02:43:06-04:00",
