  "ingredients": [
    "4 cups all-purpose flour",
    "1.5 cups white sugar",
    "1 cup honey",
    "3 large eggs",
    "0.5 cup vegetable oil",
    "0.5 cup brewed coffee",
    "1 tablespoon jam (any flavor)",
    "1 tablespoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon baking soda",
    "0.5 cup white sugar",
    "0.25 cup unsweetened cocoa powder",
    "3.5 tablespoons water",
    "1 teaspoon all-purpose flour",
    "0.5 cup margarine",
    "1 tablespoon brandy"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Lightly grease two 8x3-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 4 cups flour, 1 1/2 cups sugar, honey, eggs, oil, coffee, jam, baking powder, cinnamon, cloves, and baking soda together in a bowl until smooth; spread evenly into the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, about 1 hour. Remove cake from pans and cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1/2 cup sugar, cocoa powder, water, and 1 teaspoon flour together, stirring constantly, in a saucepan over low heat until mixture is smooth and thick, about 8 minutes. Remove saucepan from heat and add margarine and brandy; whisk until glaze is thickened. Refrigerate glaze until cooled, at least 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread glaze over cooled cakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
