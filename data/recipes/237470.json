  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon salt",
    "0.5 cup butter, softened",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "2.3333332538605 cups mashed overripe bananas",
    "2 eggs, beaten",
    "1 tablespoon lemon juice",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, cinnamon, nutmeg, ginger, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and brown sugar together in a bowl using an electric mixer until smooth and creamy. Stir in bananas, eggs, lemon juice, and vanilla extract until well blended; stir into flour mixture until batter just combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, 60 to 65 minutes. Cool bread in the pan for 10 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
