  "ingredients": [
    "2 tablespoons butter",
    "2 teaspoons olive oil, or more to taste",
    "4 cloves garlic, minced",
    "1 tablespoon chopped onion",
    "1 teaspoon Cajun seasoning",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon parsley flakes",
    "1 pinch lemon-pepper seasoning, or to taste",
    "1 pound tilapia fillets"
  ],
  "steps": [
    {
      "text": "Heat butter and olive oil in a large skillet over medium heat. Add garlic, onion, Cajun seasoning, basil, parsley, and lemon-pepper seasoning; stir until fragrant, about 30 seconds. Add tilapia fillets; increase heat to medium-high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook tilapia until opaque and fillets easily flake with a fork, 3 to 4 minutes per side. Adjust temperature if browning too quickly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
