  "ingredients": [
    "1 (15.25 ounce) can whole kernel corn, drained",
    "1 (15 ounce) can cream-style corn",
    "1 cup sugar",
    "1 large egg",
    "0.25 cup butter, melted and divided",
    "2 sleeves buttery round crackers (such as Ritz®), crushed and divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir whole kernel corn, cream-style corn, sugar, egg, and about 3/4 of the melted butter together in a casserole dish. Fold about 1/2 of the crushed crackers into the corn mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle remaining crushed crackers over the top of the mixture and drizzle with remaining butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until beginning to brown, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
