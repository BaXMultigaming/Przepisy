  "title": "Soft Oatmeal Cookies",
  "description": "Oatmeal cookies are a family-favorite and this classic recipe is a winner, producing soft, chewy oatmeal cookies with just a hint of cinnamon flavor.",
  "authors": [
    "BITTERSWEET1"
  ],
  "date_published": "2000-05-15T17:36:26-04:00",
