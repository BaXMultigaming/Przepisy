      ],
      "image": "assets/images/12580/step_01.webp"
    },
    {
      "text": "Beat together sugar, butter, and eggs in a large bowl with an electric mixer on low speed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qyJniGyJybAsZSLr4iwaaXhJdBE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-12580-coconut-custard-pie-i-VAT-step-02-aa837b38e9a041f7941d839338bb2e3d.jpg"
