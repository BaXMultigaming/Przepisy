  "ingredients": [
    "1 (8 ounce) package pitted dates, chopped",
    "1 cup white sugar",
    "0.5 cup butter or margarine",
    "3 cups crispy rice cereal",
    "1 cup chopped pecans",
    "1 teaspoon vanilla extract",
    "0.5 cup confectioners' sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Place dates, sugar, and margarine in a large saucepan over low heat; cook and stir until sugar dissolves. Remove from heat and fold in crispy rice cereal, pecans, and vanilla extract until evenly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll date mixture into 1-inch balls using lightly greased hands; allow balls to cool.",
