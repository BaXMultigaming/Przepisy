  "ingredients": [
    "3 tablespoons butter",
    "1 onion, diced",
    "2 large carrots, diced",
    "3 stalks celery, diced",
    "1 (28 ounce) can whole peeled tomatoes, chopped, juice reserved",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 teaspoon dried parsley",
    "3 tablespoons soy sauce",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon paprika",
    "2 quarts beef broth"
  ],
  "steps": [
    {
      "text": "In a large pot over medium heat, melt butter. Cook onion, carrots and celery until onion is translucent. Stir in tomatoes with their juice, salt, pepper, parsley, soy sauce, Worcestershire and paprika. Pour in beef broth. Bring to a boil, then reduce heat and simmer 30 minutes, until vegetables are tender and flavors are well blended.",
