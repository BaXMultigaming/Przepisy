  "ingredients": [
    "3 lemongrass stalks, bottom two-thirds of tender inner bulbs only, thinly sliced",
    "4 cloves garlic, chopped",
    "1 (4 inch) piece fresh ginger root, chopped",
    "4 cups chicken broth",
    "1 tablespoon vegetable oil",
    "2.5 pounds skinless, boneless chicken thighs, cut into chunks",
    "12 ounces fresh white mushrooms, quartered",
    "3 tablespoons fish sauce",
    "2 teaspoons red curry paste",
    "1 lime, juiced",
    "2 (14 ounce) cans coconut milk",
    "1 red onion, sliced",
    "0.5 bunch cilantro, roughly chopped",
    "1 lime, cut into wedges, for serving",
    "1 fresh jalapeno pepper, sliced into rings"
  ],
  "steps": [
    {
      "text": "Stir together lemongrass, garlic, and ginger in a large stockpot over medium-high heat until fragrant. Pour in chicken broth and bring to a boil. Reduce heat to low and simmer for 30 minutes. Strain broth and set aside. Discard lemongrass, garlic, and ginger.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E2r2geHgcJhTmc28lfB0b51ZJX8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219936-spicy-chicken-thai-soup-PICS-step-01-19d63ad5781640d38800990f2473b632.jpg"
      ],
      "image": "assets/images/219936/step_01.webp"
    },
    {
      "text": "Heat oil in a large soup pot over medium heat. Cook and stir chicken in hot oil for 5 minutes. Add mushrooms and cook for 5 more minutes. Stir in fish sauce, red curry paste, and lime juice until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OlVmYTgNkLI7wyD9x_Gl2NJ2WOM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219936-spicy-chicken-thai-soup-PICS-step-02-a01e1e1e63b94db580b740037e7602c7.jpg"
      ],
      "image": "assets/images/219936/step_02.webp"
    },
    {
      "text": "Pour in broth and coconut milk; return to a simmer and cook on low heat for 15 to 20 minutes. Skim off any excess oil and fat that rises to the top and discard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d0chaO8Ji1frJO15aN-GtLw0wdA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219936-spicy-chicken-thai-soup-PICS-step-03-d8ff4c314efc447883875f7923d21ef3.jpg"
      ],
      "image": "assets/images/219936/step_03.webp"
    },
    {
      "text": "Add red onion; cook until onion softens, about 5 minutes. Remove from heat and stir in about 1/2 of the cilantro. Portion soup into bowls and serve with plates of lime wedges, jalapeño rings, and remaining cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rNx0HHAVdGZSzVrFRWJFN96qEXI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219936-spicy-chicken-thai-soup-PICS-step-04-ca1a123ffb784aefb9008be3492f029b.jpg"
      ],
      "image": "assets/images/219936/step_04.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
