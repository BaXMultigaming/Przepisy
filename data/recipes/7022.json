  "ingredients": [
    "1 cup buttermilk",
    "6 tablespoons light corn syrup",
    "0.25 cup white sugar",
    "0.5 teaspoon baking soda",
    "0.125 teaspoon ground cardamom",
    "3.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix by hand sour milk or buttermilk, corn syrup, sugar, soda, cardamom, and flour until mixture becomes a soft pliable dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide the dough into 12 or so pieces. Roll out each piece until about 1/8 inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake on a lightly floured griddle over very low heat for 12 to 15 minutes per side. Serve warm with your favorite cheese or jam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
