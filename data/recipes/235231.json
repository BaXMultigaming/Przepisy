  "ingredients": [
    "2 pounds lean ground beef",
    "2 cups chopped onions",
    "1 cup chopped red bell pepper",
    "1 (14.5 ounce) can beef broth",
    "4 potatoes, peeled and quartered",
    "1 cup sliced carrots",
    "0.33333334326744 cup ketchup",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon crushed garlic",
    "1.5 teaspoons paprika",
    "1 dash hot sauce (such as Tabasco), or to taste",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium heat. Cook and stir beef, onions, and bell pepper in the hot skillet until beef is browned and crumbly, 7 to 10 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer beef mixture to a slow cooker. Add broth, potatoes, carrots, ketchup, Worcestershire sauce, garlic, paprika, hot sauce, and salt. Stir the mixture, making sure potatoes remain submerged in liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low for 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
