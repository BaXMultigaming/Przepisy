  "ingredients": [
    "1 (9 inch) unbaked pie crust",
    "1 cup white sugar",
    "0.5 cup butter",
    "2 large eggs",
    "0.25 cup all-purpose flour",
    "3 tablespoons unsweetened cocoa powder",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line pie crust with parchment paper or aluminum foil. Fill with pie weights or dried beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake crust in the preheated oven until the edges start to brown and appear set, about 15 minutes. Remove from the oven and carefully lift the parchment paper (with the weights) out of crust. Prick holes all over bottom crust with a fork. Continue baking until the bottom of crust is golden brown, 14 to 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce oven temperature to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together sugar, butter, eggs, flour, cocoa powder, and vanilla in a medium bowl until well combined. Pour into baked crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is set, 25 to 30 minutes. Allow to cool to room temperature before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
