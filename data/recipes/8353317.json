  "ingredients": [
    "0.5 cup smoked almonds",
    "2 tablespoons roughly chopped fresh parsley",
    "2 tablespoons roughly chopped fresh chives",
    "0.25 cup dried cherries",
    "1 (8 ounce) log plain goat cheese"
  ],
  "steps": [
    {
      "text": "Pulse almonds in the bowl of a food processor until chopped. Add parsley and chives; continue to pulse until incorporated. Add cherries and process until everything is finely chopped and you have a nice mixture of red and green.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour nut mixture onto a flat work surface and spread into a thin layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll goat cheese log in the nut mixture until fully covered. Carefully pick it up and tap the ends of the log into the nut mixture to cover. Place on a serving dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
