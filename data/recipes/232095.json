  "ingredients": [
    "1.5 pounds zucchini, sliced",
    "1 tablespoon butter",
    "1 large onion, finely chopped",
    "1 (1 inch) piece fresh ginger, grated",
    "1 teaspoon ground cumin",
    "1 teaspoon ground coriander",
    "1 teaspoon mustard seeds",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground turmeric",
    "0.25 teaspoon ground cardamom",
    "0.25 teaspoon cayenne pepper",
    "sea salt to taste",
    "freshly ground black pepper to taste",
    "1 cup vegetable stock",
    "0.25 cup chopped fresh cilantro",
    "4 cinnamon sticks"
  ],
  "steps": [
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add zucchini, cover, and steam until slightly tender, 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a saucepan over medium heat; cook and stir onion in the melted butter until tender and translucent, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix grated ginger, cumin, coriander, mustard seeds, ground cinnamon, turmeric, cardamom, cayenne pepper, sea salt, and black pepper in a small bowl. Mix spice mixture into onions until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix zucchini into onion mixture; cook and stir until heated through, 2 to 3 minutes. Pour vegetable stock over zucchini mixture; stir well. Simmer until vegetables are tender, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour zucchini mixture into a blender no more than half full. Cover and hold lid down; pulse a few times before leaving on to blend. Puree in batches until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour soup into 4 serving bowls; garnish each bowl with 1 tablespoon cilantro and 1 cinnamon stick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
