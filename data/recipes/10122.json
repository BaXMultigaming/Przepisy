  "ingredients": [
    "0.75 cup white sugar",
    "0.33333334326744 cup butter, softened",
    "2 teaspoons almond extract",
    "6 ounces cream cheese",
    "2 cups Make Ahead Cookie Mix",
    "1 egg, separated",
    "0.25 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar and almond flavoring and set aside. In a separate bowl mix butter, cheese and egg yolk. Stir in Make Ahead Cookie Mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll onto flat surface. Cut in half. Place 1 half on greased cookie sheet. Spoon on almond and sugar mix. Place 2nd half on top. Brush with slightly beaten egg white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 22 - 30 minutes. Let cool at least 30 minutes. Cut into 1/2 inch strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
