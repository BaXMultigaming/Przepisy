  "ingredients": [
    "1.5 tablespoons olive oil",
    "1 sweet onion, chopped",
    "1.33 cups Greek yogurt",
    "0.5 cup Japanese mayonnaise (such as Kewpie®)",
    "0.67 cup finely chopped cornichons",
    "1 tablespoon minced fresh dill",
    "1 clove garlic, minced",
    "ridge-cut potato chips for serving (optional)"
  ],
  "steps": [
    {
      "text": "Heat the oil in a large skillet over medium-low heat until warm. Add onions and sauté until reduced and caramelized, 15 to 18 minutes. Remove from heat and set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together Greek yogurt, kewpie mayo, cornichon pickles, dill, garlic, salt, and pepper in a bowl until well combined. Once cooled, stir in caramelized onions. Serve immediately with potato chips.",
      "section": null,
      "name": null,
