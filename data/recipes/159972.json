  "title": "Tender Pan-Fried Chicken Breasts",
  "description": "This pan-fried chicken is coated in spices, pan-seared until golden brown, then baked until moist and tender for a delicious family weeknight dinner.",
  "authors": [
    "Alesia"
  ],
  "date_published": "2019-04-02T02:50:01-04:00",
