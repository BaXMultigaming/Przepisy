  "ingredients": [
    "1 (1.5 ounce) bar milk chocolate candy bar (such as Hershey's®)",
    "6 sugar cones",
    "0.75 cup mini marshmallows",
    "6 sheets aluminum foil"
  ],
  "steps": [
    {
      "text": "Build a campfire and allow the fire to burn until it has accumulated a bed of coals. Rake the coals into a flat bed on one side of the fire.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide chocolate bar into 12 pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each cone with 2 tablespoons marshmallows and 2 chocolate pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap each filled cone in foil and place on the campfire, indirectly over the heat and cook until gooey and melted, about 5 minutes, rotating halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
