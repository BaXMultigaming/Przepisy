  "ingredients": [
    "1 (12.4 ounce) can refrigerated cinnamon rolls with icing (such as Pillsbury® Refrigerated Cinnamon Rolls with Icing)",
    "1 tablespoon unsalted butter, melted",
    "3 large eggs",
    "0.25 cup milk",
    "1 teaspoon vanilla extract",
    "1 teaspoon maple extract",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a 9x13-inch baking pan with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each cinnamon roll into 8 pieces and put into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix eggs, milk, vanilla extract, maple extract, and cinnamon together in a bowl and pour over the rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and set, 23 to 30 minutes. Cover with packaged icing and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
