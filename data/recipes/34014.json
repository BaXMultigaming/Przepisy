  "ingredients": [
    "1.5 cups white sugar",
    "6 eggs, lightly beaten",
    "4 cups milk",
    "1 cup heavy cream",
    "1 tablespoon vanilla extract",
    "0.5 tablespoon ground cinnamon",
    "1 (1 pound) loaf bread, cut into 1 inch cubes",
    "0.5 cup golden raisins",
    "0.75 cup butter",
    "0.75 cup corn syrup",
    "0.5 cup whiskey"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1 ½ cups sugar and eggs together in a medium bowl. Whisk in milk, heavy cream, vanilla extract, and cinnamon until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bread cubes in a medium baking dish; top with golden raisins. Pour milk mixture over bread cubes; set aside until bread becomes saturated with mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat remaining 1 ½ cups sugar, butter, and corn syrup in a medium saucepan over low heat until thoroughly combined. Off heat, whisk in whiskey. Serve warm over bread pudding.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
