  "ingredients": [
    "1 (20 ounce) package refrigerated prepared diced potatoes (such as Simply Potatoes® Steakhouse Seasoned Diced Potatoes)",
    "2 tablespoons butter, melted",
    "1 (8 ounce) package cream cheese, cubed",
    "1 cup milk",
    "9 eggs, beaten",
    "0.75 cup chopped tomato",
    "0.5 cup chopped red onion",
    "1 bunch cilantro, chopped",
    "0.5 tablespoon garlic salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon dried marjoram",
    "2 cups shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss potatoes with melted butter in a microwave-safe bowl. Microwave on high power for 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cream cheese into the bottom of a large bowl. Pour hot buttered potatoes on top and mix gently until only a few lumps are left.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat milk in a microwave-safe container in the microwave until warm, 30 to 45 seconds. Stir gently into potato mixture until well combined. Add beaten eggs and stir well. Stir in tomato, onion, cilantro, garlic salt, pepper, and marjoram. Fold in Cheddar cheese gently. Pour into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and golden, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
