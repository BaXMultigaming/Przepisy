  "ingredients": [
    "nonstick cooking spray",
    "1 tablespoon unsalted butter",
    "1 cup roughly chopped carrots",
    "0.5 cup chopped celery",
    "1 small onion, diced",
    "2 cups cubed cooked turkey",
    "2.5 cups prepared stuffing, or more to taste",
    "0.5 cup turkey broth",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon granulated garlic",
    "1 pinch dried thyme",
    "2 tablespoons unsalted butter, divided",
    "1 tablespoon all-purpose flour",
    "1 cup turkey broth",
    "0.5 teaspoon salt",
    "0.25 teaspoon dried thyme",
    "0.25 teaspoon granulated onion",
    "0.25 teaspoon granulated garlic",
    "0.25 teaspoon ground black pepper",
    "1 pinch poultry seasoning",
    "0.5 cup fresh bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 8x8-inch casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium-high heat. Add carrots, celery, and onion and saute until softened, about 5 minutes. Add cubed turkey, stuffing, turkey broth, salt, pepper, garlic, and thyme. Stir to combine and transfer into the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1 tablespoon butter in a saucepan over medium-high heat for the sauce. Stir in flour and mix until a paste forms. Pour in 1 cup turkey broth and season with salt, thyme, onion, garlic, pepper, and poultry seasoning. Stir to combine and pour over the turkey mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, uncovered, for 30 minutes. Remove and top with fresh bread crumbs. Melt remaining butter and drizzle over the bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil casserole until bread crumbs are golden and toasted, about 2 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
