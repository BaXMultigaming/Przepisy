  "ingredients": [
    "3 tablespoons butter",
    "0.75 cup white sugar",
    "3 large Granny Smith apples - peeled, cored, and quartered",
    "1 tablespoon all-purpose flour",
    "1 9-inch unbaked pie crust (see footnote for recipe link)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat a heavy-bottomed 10-inch oven-proof skillet with butter. Sprinkle sugar evenly over the top of the butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1xs2K-sf4h5JfCn0MB8NQxMl7Iw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230610-apple-tarte-tatin-VAT-step-02-2e0473e1e59649c58541a2131a837d9b.jpg"
      ],
      "image": "assets/images/230610/step_02.webp"
    },
    {
      "text": "Place apple quarters, rounded sides down, on top of the butter and sugar in a circular pattern.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_W-FZyyXW3BkdwViRfeipEmGsC0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230610-apple-tarte-tatin-VAT-step-03-bddf4b5481d74f4e8515de0e46736f2b.jpg"
      ],
      "image": "assets/images/230610/step_03.webp"
    },
    {
      "text": "Place skillet over medium-high heat and cook until butter melts and sugar dissolves and begins to caramelize. Continue to cook until apples soften and caramel begins to brown, 10 to 12 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XpoEuwL-6pRW9_87fPuUMlMyV3E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230610-apple-tarte-tatin-VAT-step-04-9719d1cde3914e3780d82b19ec057042.jpg"
      ],
      "image": "assets/images/230610/step_04.webp"
    },
    {
      "text": "Sprinkle work surface with flour and roll pie dough into an 11-inch circle. Pinch edge to create a ruffle around crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iZGsUYw1-7SrdKsfBDiDM4zmTlQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230610-apple-tarte-tatin-VAT-step-05-a79776f35fb844eaa5698797613ffa17.jpg"
      ],
      "image": "assets/images/230610/step_05.webp"
    },
    {
      "text": "Place crust on top of apples and tuck in edges around apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fuKAtTFeoIryZhGxXqIG2m-Cr3U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230610-apple-tarte-tatin-VAT-step-06-dc2fc2e363e54ee7a08f329c088eb8c6.jpg"
      ],
      "image": "assets/images/230610/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until crust is golden brown, about 20 minutes. Allow to cool for 5 minutes. Place a plate over the top of the pan and carefully invert to release tarte from the pan. Scrape any remaining apples stuck to the pan back on top of crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pLrloZjuD-CE7jbGejWG_XiYkjk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230610-apple-tarte-tatin-VAT-Beauty-4x3-362b14da899544fb81552dd38b62061f.jpg"
      ],
      "image": "assets/images/230610/step_07.webp"
    }
