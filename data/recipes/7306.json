  "ingredients": [
    "1 cup white sugar",
    "0.5 cup unsalted butter",
    "4 ripe bananas, mashed",
    "2 cups all-purpose flour",
    "0.5 cup chopped walnuts",
    "2 large eggs",
    "1 teaspoon baking soda",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
