  "ingredients": [
    "6 ounces oyster mushrooms",
    "1.5 tablespoons extra-virgin olive oil",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Remove and discard tough ends mushroom stems. Place mushrooms in a large bowl; add oil, salt, and black pepper. Toss to combine. Marinate mushrooms at room temperature while the oven heats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread mushrooms in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 12 minutes. Flip mushrooms using tongs; continue roasting until reaches desired doneness, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
