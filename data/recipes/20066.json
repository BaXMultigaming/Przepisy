  "title": "Traditional White Bread",
  "description": "A delicious white bread recipe with a very light center with crunchy crust. You may substitute butter or vegetable oil for the lard if you wish.",
  "authors": [
    "Danialle"
  ],
  "date_published": "2000-07-29T16:18:58-04:00",
