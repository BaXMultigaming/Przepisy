  "ingredients": [
    "2 cups white sugar",
    "1 cup peanut butter",
    "1 cup butter or margarine",
    "0.5 cup water",
    "2 tablespoons vanilla extract",
    "2 eggs",
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.5 cups rolled oats",
    "1.5 cups raisins",
    "6 cups toasted oat cereal rings (such as Cheerios®)"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yx3hBjDx6PmElx5gYV_Tu_1dV_w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/144059-Jumbo-Breakfast-Cookies-step-1-022-23e84a5ffdfb488094e4d000da9eb114.jpg"
      ],
      "image": "assets/images/144059/step_01.webp"
    },
    {
      "text": "Mix sugar, peanut butter, butter, water, vanilla, and eggs together in a very large bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aFzAxxqZbb3777JyC9kV2iopioc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/144059-Jumbo-Breakfast-Cookies-step-2-027-444399ebaca54ee99d9219e6361855ad.jpg"
      ],
      "image": "assets/images/144059/step_02.webp"
    },
    {
      "text": "Combine flour, baking soda, and salt; stir into cookie batter. Mix in oats and raisins, then carefully stir in cereal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fDvzikZKJw5lX4PG_UFWGFZAN14=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/144059-Jumbo-Breakfast-Cookies-step-3-028-bec8114fd3544052b4a3811620ffe278.jpg"
      ],
      "image": "assets/images/144059/step_03.webp"
    },
    {
      "text": "Drop 1/2 cupfuls of dough onto ungreased cookie sheets, spacing cookies about 4 inches apart. Flatten cookies to 1 inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ExI0B3fIHhZJ9TJjmVxI9fq1CZA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/144059-Jumbo-Breakfast-Cookies-step-4-029-1ca877989e1d448bb52d3646d58f7806.jpg"
      ],
      "image": "assets/images/144059/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until cookies are lightly browned at the edges, about 10 to 12 minutes. Let stand on the cookie sheets for 5 minutes before removing to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DRpOxiocLm8sQSQMxAq5-ejtlH4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/144059-Jumbo-Breakfast-Cookies-step-5-040-2cf4c5e671874789b6d528017518e4f2.jpg"
      ],
      "image": "assets/images/144059/step_05.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Es0RNrW9JsJWtpep6SnItPOK4yk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/144059-Jumbo-Breakfast-Cookies-3x4-095-edf2895b944a4676aa412bcccf965cf2.jpg"
      ],
      "image": "assets/images/144059/step_06.webp"
    }
