  "ingredients": [
    "4 cups cooked white rice",
    "0.25 cup butter",
    "0.25 cup all-purpose flour",
    "2 cups milk",
    "2 teaspoons chicken bouillon powder",
    "1 teaspoon seasoned salt",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon ground black pepper",
    "5 cups cooked, shredded chicken breast meat",
    "12 ounces processed cheese food (eg. Velveeta), cubed",
    "2 cups sour cream",
    "0.5 cup butter",
    "2 cups crushed buttery round crackers"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread rice in the bottom of a 9x13 inch baking dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan melt butter or margarine and stir in flour until smooth. Gradually add milk, bouillon granules, seasoned salt, garlic powder and pepper. Stir all together and bring to a boil. Let simmer and stir for 2 minutes or until thickened and bubbly. Reduce heat; add chicken, cheese and sour cream. Stir until cheese is melted. Mix all together and pour mixture over rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1/2 cup butter or margarine in saucepan and toss with crushed cracker crumbs. Sprinkle crumb mixture over casserole. Bake in the preheated oven for 10 to 15 minutes or unti heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
