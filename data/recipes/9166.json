      ],
      "image": "assets/images/9166/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x11-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
