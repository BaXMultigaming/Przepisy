  "ingredients": [
    "3 (15 ounce) cans cream-style corn",
    "1 cup crushed saltine crackers, divided",
    "0.5 cup butter, melted, divided",
    "2 large eggs",
    "0.5 teaspoon paprika",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
