  "ingredients": [
    "2 pounds celeriac (celery root), peeled and cut into 1/2-inch cubes",
    "0.25 cup sour cream, or more to taste",
    "0.5 teaspoon dried dill weed, or more to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place celeriac into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain and transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash together celeriac, sour cream, and dill in a large bowl with a potato masher until smooth. Season with salt and pepper.",
