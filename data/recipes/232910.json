  "ingredients": [
    "2 eggs",
    "0.25 cup milk",
    "1 tablespoon white sugar",
    "1.5 teaspoons vanilla extract",
    "1 teaspoon ground cinnamon",
    "2 cups corn flakes cereal, crushed",
    "4 slices bread, toasted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
