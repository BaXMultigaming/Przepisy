  "ingredients": [
    "4 medium baking potatoes, sliced 1/8-inch thick",
    "0.125 teaspoon garlic powder",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon celery seed",
    "0.125 teaspoon paprika",
    "1 pinch cayenne pepper",
    "1 dash salt",
    "4 tablespoons olive oil, or more as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yEcOc9tqogaS6OIgdB4lUyRzECk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273572-oven-baked-potato-slices-DDMFS-step-01-da5a6430b271483bbabc58f4f9c7961f.jpg"
      ],
      "image": "assets/images/273572/step_01.webp"
    },
    {
      "text": "Place potatoes, garlic powder, black pepper, celery seed, paprika, cayenne pepper, and salt into a zip-top bag. Shake to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DeHs4JYJeH46DDaUvCmRvmX3gws=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273572-oven-baked-potato-slices-DDMFS-step-02-c43f454378b64e56b9994eaa2323307e.jpg"
      ],
      "image": "assets/images/273572/step_02.webp"
    },
    {
      "text": "Pour the entire contents of the bag onto a large baking sheet and spread evenly. Drizzle with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kRNJgevy9vP2wuqUuBtXS5xwghs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273572-oven-baked-potato-slices-DDMFS-step-03-744d3cea71394a8fbcd3e15719ccb743.jpg"
      ],
      "image": "assets/images/273572/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until potatoes reach desired crispness, turning frequently to brown evenly, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fsNaHTiiQT_F5iW2SncWyifDPcE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273572-oven-baked-potato-slices-DDMFS-step-04-b85981dfb5314f6b95ab9e12b11c6721.jpg"
      ],
      "image": "assets/images/273572/step_04.webp"
    },
    {
      "text": "Remove from the oven. Let cool slightly and transfer into a serving dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WVU_I5SFicIZ5y0QwG5kBEfw2gY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273572-oven-baked-potato-slices-DDMFS-4x3-55e701c918fd4e0887d3a12745196a9e.jpg"
