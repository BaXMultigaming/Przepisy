  "ingredients": [
    "7 raw green mangoes, peeled and sliced 1-inch thick",
    "0.25 cup salt, divided",
    "3 cups water",
    "3 tablespoons water",
    "1.25 cups white sugar",
    "1 tablespoon vinegar"
  ],
  "steps": [
    {
      "text": "Combine mango slices and 3 tablespoons salt in a large bowl. Let sit, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1 tablespoon salt, 3 cups plus 3 tablespoons water, and sugar in a large pot; bring to a boil. Stir until sugar dissolved. Off heat, pour in vinegar. Let brine cool about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain mango slices; place in large jars. Add cooled brine to cover. Seal jars; refrigerate until mango turns yellow, about 2 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
