    "publisher-tested"
  ],
  "ingredients": [
    "5 pounds beef soup bones",
    "1 tablespoon salt, divided",
    "2 gallons water",
    "2 medium onions, quartered",
    "1 (4 inch) piece fresh ginger root",
    "2 pounds beef oxtail",
    "1 white (daikon) radish, sliced",
    "2 ounces whole star anise pods",
    "0.5 (3 inch) cinnamon stick",
    "1 teaspoon black peppercorns",
    "2 whole cloves",
    "1 tablespoon white sugar",
    "1 tablespoon fish sauce",
    "salt to taste",
    "1.5 pounds dried flat rice noodles",
    "0.5 pound frozen beef sirloin"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-iqymoBUbQy1lCrL0_OPwP6W-lE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/57354-BeefPho-DDMFS-Step-1-0488-c6c7ed3ce11c43a8b4b1a4bf06ecff84.jpg"
      ],
      "image": "assets/images/57354/step_01.webp"
    },
    {
      "text": "Make broth: Place beef bones in a 9-quart (or larger) pot; season with 1 teaspoon salt. Pour water into the pot and bring to a boil. Reduce heat and simmer broth for about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a 10x15-inch roasting pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place onions and unpeeled ginger onto the prepared roasting pan and cook under the preheated broiler, stirring occasionally, until vegetables are charred, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZtnkbwlxOR0eEvqfHvsuHTTBkpc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/57354-Beef-Pho-DDMFS-Step-3-0500-7d0307c880f24aed8340ab207761fc35.jpg"
      ],
      "image": "assets/images/57354/step_04.webp"
    },
    {
      "text": "Cool slightly. Chop onions, then peel and slice ginger; set aside separately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rPlOii5RFj3pL4h4epa4_DzH_ss=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/57354-Beef-Pho-DDMFS-Step-4-0501-6aa2823839974e7a81b5563d6fe5c275.jpg"
      ],
      "image": "assets/images/57354/step_05.webp"
    },
    {
      "text": "Skim fat from surface of simmering broth. Add oxtail, radish, and charred onions to broth. Tie charred ginger, anise, cinnamon stick, peppercorns, and cloves in cheesecloth to make a bouquet garni; add to broth. Stir in sugar, fish sauce, and remaining 2 teaspoons salt. Simmer over medium-low heat for at least 4 hours (the longer, the better). Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7_1JJOC4BYFWHud5j5BihiV36g4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/57354-Beef-Pho-DDMFS-Step-7-0514-44a9688819554d46bf8cbdd52510311c.jpg"
      ],
      "image": "assets/images/57354/step_06.webp"
    },
    {
      "text": "Strain broth. Discard bones and bouquet garni. Reserve meat from bones for another use. Chill broth in the refrigerator, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vr_H1LcvBeRaNs3h3e0jjf0Y25E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/57354-Beef-Pho-DDMFS-Step-8-0526-ec79f7122ddc49a894b4dd1c3bfb9df4.jpg"
      ],
      "image": "assets/images/57354/step_07.webp"
    },
    {
      "text": "Skim and discard fat from the top of chilled broth. Pour broth into a pot; bring to a boil. Reduce heat and keep hot until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jRMSUMQREj-UK_HvaFyqilZ4Jhs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/57354-Beef-Pho-DDMFS-Step-9-0567-8fb14a5307fd4b03bc07c1ed5e1c887b.jpg"
      ],
      "image": "assets/images/57354/step_08.webp"
    },
    {
      "text": "Bring a pot of water to a boil. Turn off heat. Stir in rice noodles and let sit until noodles are tender yet chewy, 6 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c40LI2nOY4vae73X-K3BX7uxvdg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/57354-Beef-Pho-DDMFS-Step-12-0592-6cf2805cf13145759c29b03cb0fa9c01.jpg"
      ],
      "image": "assets/images/57354/step_09.webp"
    },
    {
      "text": "Meanwhile, cut frozen sirloin into paper-thin slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iI9KF5MSA8bEMo-W6L0RMkB0pKY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/57354-Beef-Pho-DDMFS-Step-11-0588-6a762a19316b455d8241406d5e301ef1.jpg"
      ],
      "image": "assets/images/57354/step_10.webp"
    },
    {
      "text": "Drain and divide noodles among bowls, about 1 1/2 cups per serving. Top each with a few sirloin slices. Ladle hot broth over sirloin and noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PHmC9EkZ1Y4bSmKxdlv9h7wMuzw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/57354-Beef-Pho-DDMFS-Step-12-0601-000f4227174147a5b634712505cf683e.jpg"
      ],
      "image": "assets/images/57354/step_11.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/48QQ_ki8BzxgkBBERjVUJj95p3w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/57354-beef-pho-PICS-5932-beauty-4x3-d88e8af66ba04c3ca2c6e049defa5a5f.jpg"
      ],
      "image": "assets/images/57354/step_12.webp"
    }
  ],
