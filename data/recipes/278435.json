  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 sweet onion, grated",
    "1 pound ground sirloin",
    "0.5 pound ground pork",
    "0.75 cup seasoned panko bread crumbs",
    "1 egg",
    "1 tablespoon milk",
    "1 teaspoon garlic powder",
    "1 teaspoon salt",
    "0.5 teaspoon freshly ground black pepper",
    "4 dashes Worcestershire sauce, divided",
    "4.5 cups reduced-sodium beef broth, divided",
    "1 tablespoon reduced-sodium soy sauce",
    "1 tablespoon finely chopped fresh rosemary",
    "0.25 cup cornstarch",
    "0.33333334326744 cup Greek yogurt",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a pan over medium-high heat. Add onion; sauté until transparent, 5 to 7 minutes. Remove from heat; let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground sirloin, ground pork, bread crumbs, onion, egg, milk, garlic powder, salt, pepper, and 2 dashes Worcestershire sauce in a bowl. Form into 1-inch meatballs. Place onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the centers, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 4 cups broth, soy sauce, rosemary, and remaining 2 dashes Worcestershire sauce in a large skillet. Bring to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour remaining 1/2 cup broth into a measuring cup; whisk in cornstarch. Stir cornstarch mixture into sauce until thickened. Add meatballs; stir in Greek yogurt. Top with parsley and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
