  "ingredients": [
    "1 tablespoon soy sauce",
    "1 (1 inch) piece fresh ginger root, peeled and thinly sliced",
    "1 pound round steak, thinly sliced",
    "1 teaspoon butter",
    "12 mushrooms, sliced",
    "1 onion, chopped",
    "1 red bell pepper, chopped",
    "0.25 cup sweet and sour sauce",
    "4 cups cooked rice"
  ],
  "steps": [
    {
      "text": "Whisk soy sauce and ginger together in a large glass or ceramic bowl. Add steak and toss to evenly coat. Cover the bowl with plastic wrap and marinate in the refrigerator for at least 30 minutes or up to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a wok over high heat. Add steak mixture; cover wok and cook until steak browned, about 5 minutes. Transfer steak to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in wok over high heat; stir in mushrooms, onion, bell pepper, and sweet and sour sauce. Cover and cook until vegetables begin to soften, about 3 minutes. Stir in cooked steak; cook until heated through, about 2 minutes. Serve over cooked rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
