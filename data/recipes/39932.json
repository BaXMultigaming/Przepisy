  "ingredients": [
    "0.5 cup reduced-calorie margarine, melted",
    "1.5 cups all-purpose flour",
    "1.5 cups white sugar",
    "2 teaspoons baking powder",
    "0.5 cup skim milk",
    "4 (15 ounce) cans sliced peaches packed in juice, drained and juice reserved"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour melted margarine into the bottom of a 9x13-inch baking dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, and baking powder in a large bowl; stir in 1 cup reserved peach liquid and milk until smooth. Pour batter into the prepared baking dish; do not stir. Spoon peaches over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden, 35 to 40 minutes.",
