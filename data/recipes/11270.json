  "ingredients": [
    "1 cup semisweet chocolate chips",
    "0.5 cup rum",
    "0.25 cup light corn syrup",
    "3 cups vanilla wafer crumbs",
    "1.5 cups chopped pecans",
    "1 cup confectioners' sugar",
    "24 red candied cherries, halved"
  ],
  "steps": [
    {
      "text": "Melt the chocolate chips and stir in the rum and corn syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together the vanilla wafer crumbs, pecans and 1/2 cup of the confectioners' sugar. Drizzle the chocolate mixture over the crumb mixture and stir until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape mixture into 1 inch balls. Roll balls in the remaining confectioners' sugar. Place cherry half in center of each cookie, pressing down lightly. Store in an airtight container for several days to develop flavor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
