  "ingredients": [
    "0.75 cup unsalted butter, softened",
    "1.3333333730698 cups white sugar",
    "1 teaspoon vanilla extract",
    "1 egg",
    "4.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "0.5 cup milk",
    "1 (12.5 ounce) can cherry pie filling",
    "1 egg white (for egg wash)"
  ],
  "steps": [
    {
      "text": "Sift together flour, baking powder, and salt. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter in a separate bowl, then add sugar a little at a time. Add vanilla and beat mixture until it is nice and fluffy. Beat in egg. Stir in flour mixture alternately with milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill dough in the refrigerator for at least 2 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make turnovers: Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough out to 1/4 inch thickness on a lightly floured surface. Cut into 3-inch squares. Spoon about 2 teaspoons of pie filling into the center of each square and fold over to form a triangle. Pinch seams to seal or press with the tines of a fork. Place at least 2 inches apart on a greased baking sheet. Brush with egg white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in the preheated oven, or until golden brown on the top and bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
