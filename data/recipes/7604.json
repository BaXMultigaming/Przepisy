  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In an ungreased 8 inch square baking pan combine the biscuit mix, white sugar, 2 tablespoons cocoa, nuts, milk, and vanilla blend well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and 1/4 cup cocoa. Spoon evenly over top of cake mix. Do no stir. Pour the boiling water carefully over everything. Do not stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 35 to 40 minutes. Allow cake to cool in pan for 20 minutes before serving. Serve with whipped cream or vanilla ice cream.",
      "section": null,
      "name": null,
