  "ingredients": [
    "nonstick cooking spray",
    "4 ounces pecan halves",
    "24 individually wrapped caramels, unwrapped",
    "1 cup semisweet chocolate chips",
    "1 teaspoon shortening"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat the oven to 300 degrees F (150 degrees C). Line a cookie sheet with aluminum foil and spray with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rBTHGL4EZb4ql318MMT5r_KRjL4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-14996-christmas-turtles-candies-VAT-step-01-1-e5985fe4a6b64aa7a0c255da7d0d2b7d.jpg"
      ],
      "image": "assets/images/14996/step_01.webp"
    },
    {
      "text": "Arrange 3 pecan halves in a \"Y\" shape on the prepared cookie sheet. Place 1 caramel candy in the center of the \"Y\". Repeat with remaining pecans and caramels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0p0STJaYYxP276EIpjfTbvmCpes=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-14996-christmas-turtles-candies-VAT-step-02-1a86b034870943c7aa1af7bbd7a36bed.jpg"
      ],
      "image": "assets/images/14996/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven just until caramel is melted, about 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZWAz7dcqAN4IUfXZDyORgsHvuCc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-14996-christmas-turtles-candies-VAT-step-03-354639babc014dd8a5b54e8bcc9481db.jpg"
      ],
      "image": "assets/images/14996/step_03.webp"
    },
    {
      "text": "Meanwhile, heat chocolate chips and shortening in a saucepan over low heat until chocolate is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HCWGP9Ixy69qJfJyD3OJawn9ltY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-14996-christmas-turtles-candies-VAT-step-04-ae0237afde1e4652b01c8b7213be1eb4.jpg"
      ],
      "image": "assets/images/14996/step_04.webp"
    },
    {
      "text": "Spoon chocolate over candies and refrigerate until set, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x85a-hDKFqEhwKtPsU8pM7xULGI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-14996-christmas-turtles-candies-VAT-step-05-86753d8d7823493a99004031ada94d9a.jpg"
      ],
      "image": "assets/images/14996/step_05.webp"
    }
  ],
