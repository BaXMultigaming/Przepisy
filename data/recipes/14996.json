  "title": "Christmas Turtles Candies",
  "description": "This turtle candy recipe is easy to make with pecans, caramels, and chocolate. Package into small cellophane bags to make delicious Christmas gifts.",
  "authors": [
    "MARBALET"
  ],
  "date_published": "1999-12-31T16:39:31-05:00",
