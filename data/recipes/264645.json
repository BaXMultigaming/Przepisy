  "ingredients": [
    "1 cup soy sauce",
    "1 cup butter, melted",
    "1 cup brown sugar",
    "1 teaspoon salt",
    "1 teaspoon garlic powder",
    "1 teaspoon ground black pepper",
    "1 (16 ounce) package maple bacon",
    "1 pound fresh green beans, or to taste",
    "toothpicks"
  ],
  "steps": [
    {
      "text": "Mix soy sauce, butter, brown sugar, salt, garlic powder, and black pepper together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap 1 piece of bacon around 3 or 4 green beans. Use a toothpick to secure in place, if necessary, and place in a baking dish. Continue with remaining bacon and green beans. Pour brown sugar sauce on top, cover the baking dish with aluminum foil, and refrigerate 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Uncover baking dish; turn and dip the wrapped green beans so they are covered in the sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bacon is fully cooked, 45 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
