  "title": "Mojo French Fries",
  "description": "Oven-baked potato wedges coated in flour with spicy seasonings are a nice alternative to French fries.",
  "authors": [
    "Brooke'smom"
  ],
  "date_published": "2018-06-08T10:02:57-04:00",
