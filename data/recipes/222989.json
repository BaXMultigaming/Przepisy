  "ingredients": [
    "1.5 cups all-purpose flour",
    "1.5 teaspoons paprika",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon chili powder",
    "0.25 teaspoon cayenne pepper",
    "1 egg",
    "0.33333334326744 cup milk",
    "6 potatoes, cut into wedges",
    "0.25 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, paprika, salt, black pepper, chili powder, and cayenne pepper in a bowl. Whisk egg with milk together in a separate bowl. Dip potato wedges in the egg mixture, then dredge in the seasoned flour. Arrange coated potato wedges on prepared baking sheet. Drizzle wedges with vegetable oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the coating is browned and the potatoes are tender, 20 to 25 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
