  "ingredients": [
    "13 ounces bread, crust removed",
    "cold water to cover",
    "0.5 cup olive oil",
    "1 small onion, roughly chopped",
    "1 large lemon, juiced",
    "1 cup tarama (cured carp, cod, or mullet roe)"
  ],
  "steps": [
    {
      "text": "Place bread in a bowl, cover with water and let sit until the bread is well soaked, 5 to 10 minutes. Drain water from the bowl and squeeze all of the excess water from the bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread, olive oil, onion, and lemon juice in a food processor; process until smooth. Add tarama and process until well combined.",
