  "ingredients": [
    "cooking spray",
    "0.5 cup peanut butter",
    "1 very ripe banana",
    "3 tablespoons honey",
    "1 egg white",
    "1 tablespoon almond extract",
    "0.25 teaspoon baking soda",
    "1 pinch sea salt",
    "0.5 cup mini chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray a muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine peanut butter, banana, honey, egg white, almond extract, baking soda, and sea salt in a blender; blend until smooth. Stir chocolate chips into the batter with a wooden spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared muffin tin, filling each cup 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 9 minutes. Cool in the tin for 5 minutes; transfer to a baking rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
