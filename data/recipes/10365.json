  "ingredients": [
    "0.33333334326744 cup cinnamon sugar",
    "2 cups sifted all-purpose flour",
    "1 tablespoon ground ginger",
    "2 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.75 cup shortening",
    "1 cup white sugar",
    "1 large egg",
    "0.25 cup dark molasses"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place cinnamon sugar in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VY40Mu5U0fP8y_S8fqn1LUqjbYg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10365-grandmas-gingersnap-cookies-ddmfs-Step1-9adf9bf5577b4785bf78df7341ce0b8a.jpg"
      ],
      "image": "assets/images/10365/step_01.webp"
    },
    {
      "text": "Sift flour, ginger, baking soda, cinnamon, and salt into a large bowl; stir until well combined. Sift a second time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MBlrXUSW9SvMQV6oSi5lrGsDNlM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10365-grandmas-gingersnap-cookies-ddmfs-Step5-976923c61e5040609c3c73c140e63aea.jpg"
      ],
      "image": "assets/images/10365/step_02.webp"
    },
    {
      "text": "Beat butter in a large bowl with an electric mixer until creamy. Gradually beat in sugar. Add egg and molasses; beat until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xuGUGL1vLFphXi22VD8qBPSaBJY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10365-grandmas-gingersnap-cookies-ddmfs-Step11-ba8ca304f500472d949de181b64fbc8b.jpg"
      ],
      "image": "assets/images/10365/step_03.webp"
    },
    {
      "text": "Sift 1/3 of the flour mixture into butter mixture; stir until well combined. Sift in remaining flour mixture. Stir until a soft dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DOurXaI2vXLn5rosX9AEUhPL44w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10365-grandmas-gingersnap-cookies-ddmfs-Step13-3523a78492de4d0c8dca6866d84044ce.jpg"
      ],
      "image": "assets/images/10365/step_04.webp"
    },
    {
      "text": "Pinch off small pieces of dough; roll into 1-inch balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I_QesUMS92dPymC1e89AvPmS6Us=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10365-grandmas-gingersnap-cookies-ddmfs-Step15-6a7b5ea7b37a47c0b29d23a5daae7da7.jpg"
      ],
      "image": "assets/images/10365/step_05.webp"
    },
    {
      "text": "Roll balls in cinnamon sugar to coat; place 2-inches apart on ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/93-bOXF9IvSAWmbWup1RCBM_JSE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10365-grandmas-gingersnap-cookies-ddmfs-Step17-5bf364424bea4fa9bf6e1f4fba0fe378.jpg"
      ],
      "image": "assets/images/10365/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until tops are rounded and slightly cracked, about 10 minutes, switching racks halfway through. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Bt5jGNAb4nLhlkogl1vONvBAcEE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10365-grandmas-gingersnap-cookies-ddmfs-Step18-f36bdb41eaf74070bd4c349633dbcf82.jpg"
      ],
      "image": "assets/images/10365/step_07.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TNyOUYJ06Sh2J6zrzhYrvD5lIug=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10365-grandmas-gingersnap-cookies-mfs385-5a04e3b792e34619acec4b977c4679c0.jpg"
      ],
      "image": "assets/images/10365/step_08.webp"
    }
  ],
