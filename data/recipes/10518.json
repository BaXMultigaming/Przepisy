  "ingredients": [
    "0.5 cup butter",
    "0.25 cup white sugar",
    "1 egg yolk, beaten",
    "2 teaspoons lemon juice",
    "1 cup all-purpose flour",
    "1 egg white",
    "1 cup finely chopped walnuts",
    "1 cup raspberry jam, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar; add yolk and lemon juice and beat well. Stir in flour until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form into 1-inch balls, dip into beaten egg white then into chopped nuts. Place on a greased cookie sheet, make a deep indentation in the center of each cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 5 minutes, then quickly indent centers again, continue baking for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill center of each hot cookie with raspberry jam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
