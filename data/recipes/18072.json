  "ingredients": [
    "1 (15 ounce) can beets",
    "1 onion, thinly sliced",
    "12 hard cooked eggs, shelled and left whole",
    "0.25 cup white sugar",
    "0.5 cup vinegar"
  ],
  "steps": [
    {
      "text": "Drain liquid from the beets into saucepan. Place beets, onions, and eggs into a large bowl or pitcher.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sugar and vinegar into the saucepan with beet liquid; bring mixture to a boil. Reduce the heat to low, and let mixture simmer for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour beet juice mixture over beets, eggs, and onions. Seal the bowl or pitcher and refrigerate for at least 1 to 3 days; the longer they are allowed to rest the better they will taste.",
      "section": null,
      "name": null,
      "url": null,
