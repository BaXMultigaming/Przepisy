  "ingredients": [
    "1 (12 ounce) bag round tortilla chips",
    "1.3333333730698 tablespoons vegetable oil",
    "0.33333334326744 cup chopped green bell pepper",
    "0.33333334326744 cup chopped red bell pepper",
    "0.33333334326744 cup chopped green onions",
    "1 cup chopped tomato",
    "0.5 cup frozen corn",
    "1 pinch chili powder",
    "1 pinch onion powder",
    "1 pinch garlic salt",
    "8 ounces nacho cheese, or to taste",
    "2 jalapeno peppers, chopped"
  ],
  "steps": [
    {
      "text": "Place tortilla chips on a large serving plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat. Add bell peppers and cook 1 minute. Add onions and cook 2 minutes more. Add tomato and corn, cook 2 minutes while seasoning with chili powder, onion powder, and garlic salt. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place nacho cheese in a microwave-safe bowl and heat in the microwave for 2 minutes. Pour cheese carefully over tortilla chips. Pour vegetables over cheese. Top with jalapenos.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
