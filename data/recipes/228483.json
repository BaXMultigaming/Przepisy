  "ingredients": [
    "cooking spray",
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.75 cup white sugar",
    "0.33333334326744 cup applesauce",
    "0.33333334326744 cup skim milk",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2 cups fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray 16 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and cinnamon together in a bowl. Mix sugar, applesauce, milk, egg, and vanilla extract together in a separate bowl. Stir flour mixture into wet ingredients until just combined. Fold in blueberries. Fill muffin cups 2/3 full with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, 20 minutes.",
      "section": null,
