  "ingredients": [
    "1 cup butter",
    "0.75 cup white sugar",
    "1 teaspoon baking powder",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon ground cardamom",
    "2 cups all-purpose flour",
    "50 blanched whole almonds, toasted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a large heavy skillet and cook over medium-low heat without stirring for about 15 minutes, or until butter is a light tan color. Pour into mixing bowl. Place over a bowl of cold water and chill until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sugar, baking powder, vanilla and cardamom; beat until combined. Stir in flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 1-inch balls. Place 1 inch apart on an ungreased cookie sheet. Top each with an almond; press almond slightly into dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until golden brown, 12 to 15 minutes. Remove to wire rack and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
