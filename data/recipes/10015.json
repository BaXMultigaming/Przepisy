  "title": "Drommar",
  "description": "These Swedish &#39;dreams&#39; are browned-butter cardamom cookies, each topped with a blanched almond.",
  "authors": [
    "Gail Devens"
  ],
  "date_published": "1997-09-24T17:45:16-04:00",
