  "ingredients": [
    "2 tablespoons grated Parmesan cheese",
    "0.5 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon ground black pepper",
    "4 teaspoons butter, softened",
    "1 head cabbage, cored and quartered",
    "4 slices bacon",
    "4 sheets heavy-duty aluminum foil"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Parmesan cheese, salt, garlic powder, and pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread butter over the cut sides of each cabbage wedge, then sprinkle with Parmesan mixture and wrap with a bacon slice. Wrap each wedge in foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook cabbage on the preheated grill until tender in the middle and bacon is crisp, about 40 minutes, turning halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
