  "ingredients": [
    "1 tablespoon whole cloves",
    "6 cinnamon sticks",
    "3 tablespoons chopped crystallized ginger",
    "3.75 cups white sugar",
    "2 quarts water",
    "2 quarts orange juice",
    "2 cups lemon juice",
    "1 gallon apple cider"
  ],
  "steps": [
    {
      "text": "Wrap the cloves, cinnamon stick, and ginger in cheese cloth, and tie with string.",
