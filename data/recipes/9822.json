  "ingredients": [
    "4 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1 teaspoon ground white pepper",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground cardamom",
    "0.5 teaspoon ground ginger",
    "0.75 teaspoon salt",
    "0.75 cup butter, softened",
    "1.25 cups packed brown sugar",
    "2 eggs",
    "0.75 cup finely chopped almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine dry ingredients and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, beat butter and sugar together until light. Add eggs one at a time, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in dry ingredients 1/2 cup at a time. Add almonds, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll into one inch balls and arrange 1 inch apart on ungreased baking sheet. Bake 11 to 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool and store in airtight containers for 3 days to mellow flavors.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
