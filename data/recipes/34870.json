  "title": "Chicken Murphy",
  "description": "Chicken Murphy is a deliciously comforting one-pot dish with Italian sausage, chicken thighs, sweet and spicy peppers, potatoes, and mushrooms in a wine sauce.",
  "authors": [
    "Juliana Hale"
  ],
  "date_published": "2019-04-03T23:29:20-04:00",
