  "ingredients": [
    "1 pound lean ground beef",
    "1 pound lean ground turkey",
    "0.5 onion, chopped",
    "1.5 cups water",
    "2 (28 ounce) cans diced tomatoes",
    "1.5 teaspoons garlic powder (such as Lawry's®)",
    "1.5 teaspoons sea salt, or to taste",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon finely ground black pepper, or to taste",
    "3.5 teaspoons beef base (such as Better Than Bouillon®)",
    "2 (12 ounce) packages frozen mixed vegetables"
  ],
  "steps": [
    {
      "text": "Heat a large pot over medium heat. Cook and stir ground beef and ground turkey in the pot until completely browned, 7 to 10 minutes. Stir onion into the meat mixture; continue to cook and stir until the onion is translucent, about 5 minutes. Drain fat from the pot and return to medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour water and tomatoes into the pot. Season soup with garlic powder, sea salt, basil, and black pepper. Stir beef base through the soup. Add frozen mixed vegetables to the pot; stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring the soup to a boil, reduce heat to low, and cook, stirring occasionally, until the vegetables are cooked through, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
