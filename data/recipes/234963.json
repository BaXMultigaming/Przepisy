  "ingredients": [
    "4 cups mashed, cooked butternut squash",
    "0.25 cup butter, softened",
    "1 tablespoon brown sugar",
    "0.25 teaspoon salt",
    "1 pinch ground black pepper",
    "1.5 tablespoons butter",
    "6 cups peeled and sliced Red Delicious apples",
    "0.25 cup white sugar",
    "0.33333334326744 cup all-purpose flour",
    "0.33333334326744 cup rolled oats",
    "0.33333334326744 cup firmly packed brown sugar",
    "0.25 teaspoon ground cinnamon",
    "0.25 cup butter",
    "0.25 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter or coat a 3-quart casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butternut squash, ¼ cup softened butter, 1 tablespoon brown sugar, salt, and black pepper in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1 ½ tablespoons butter in a large skillet over medium heat; stir in apples and white sugar. Cover skillet; reduce heat to low. Simmer until apples are barely tender, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, oats, ⅓ cup brown sugar, and cinnamon together in a bowl. Cut in ¼ cup butter with a pastry blender or 2 knives until mixture resembles coarse crumbs; stir in pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread apple mixture into the prepared casserole dish; spoon butternut squash mixture over top. Sprinkle with oat-pecan topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling and lightly browned, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
