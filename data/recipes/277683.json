  "ingredients": [
    "12 ounces smoked sausage, chopped",
    "1 large onion, chopped",
    "2 ribs celery, sliced",
    "1 tablespoon minced garlic",
    "3 sprigs fresh thyme, leaves only",
    "0.5 teaspoon ground black pepper",
    "2 (14.5 ounce) cans sauerkraut, drained",
    "1 pound red potatoes, cubed",
    "5 cups chicken broth",
    "6 fluid ounces hard apple cider"
  ],
  "steps": [
    {
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saute function. Add sausage and cook until caramelized and fat is rendered, about 4 minutes. Add onion, celery, garlic, thyme leaves, and pepper. Cook for 3 more minutes. Cancel Saute mode.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sauerkraut, potatoes, chicken broth, and hard cider to the pot. Close and lock the lid. Select High pressure according to manufacturer's instructions; set timer for 8 minutes. Allow 10 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
