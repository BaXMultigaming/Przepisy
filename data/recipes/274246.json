  "ingredients": [
    "2 pounds potatoes, cut into 1-inch pieces",
    "0.5 pound fresh green beans, trimmed",
    "1 yellow onion, thickly sliced",
    "0.25 cup maple syrup",
    "3 tablespoons soy sauce",
    "3 tablespoons Dijon mustard",
    "2 tablespoons olive oil",
    "2 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes, beans, and onion into a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir maple syrup, soy sauce, mustard, olive oil, and garlic together in a bowl. Pour over veggies and mix until evenly coated. Cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove veggies from the oven and remove foil. Stir, ensuring sauce is distributed evenly. Reduce oven temperature to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return veggies to the oven and bake, uncovered, for an additional 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven; toss again. Return to the oven and bake until tender, about 25 minutes more. Serve piping hot or lukewarm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
