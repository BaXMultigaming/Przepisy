  "ingredients": [
    "0.75 cup chopped banana",
    "0.25 cup pineapple juice",
    "2 cups unbleached all-purpose flour",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.375 cup turbinado sugar",
    "0.25 cup butter",
    "0.25 cup coconut oil",
    "2 ounces Greek yogurt"
  ],
  "steps": [
    {
      "text": "Place chopped banana into a small bowl, cover with pineapple juice, and let sit for 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper or a silicone liner.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, baking powder, and salt together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, and coconut oil together in a large bowl with an electric mixer until smooth; stir in yogurt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain banana chunks and save juice for another use. Fold bananas into the yogurt mixture. Fold in the dry ingredients carefully until just mixed. Dump onto the prepared baking sheet and pat into a 9- to 10-inch circle. Cut the circle into 8 wedges using a dough scraper or large knife, but don't separate them.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and cooked through, about 15 minutes. Let cool for 5 to 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
