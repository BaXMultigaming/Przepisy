  "ingredients": [
    "1 pound Brussels sprouts, trimmed and halved lengthwise",
    "0.5 pound cipollini onions, stem and root ends trimmed",
    "2 tablespoons butter",
    "salt and ground black pepper to taste",
    "1 lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large pot with water and bring to a rolling boil. Cook Brussels sprouts in boiling water for 2 minutes. Use a slotted spoon to remove sprouts to a bowl of ice water to cool. Drain, pat dry, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place onions in boiling water; cook until nearly tender, about 10 minutes. Drain, then rinse with cold water. Pat dry and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in an oven-proof skillet over medium heat. Stir in Brussels sprouts and onions; toss with butter to coat. Stir in salt and black pepper; cook for 2 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the skillet to the preheated oven and roast until vegetables are golden and tender, 15 to 20 minutes. Garnish with lemon wedges to serve.",
      "section": null,
      "name": null,
      "url": null,
