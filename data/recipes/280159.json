  "ingredients": [
    "1 pound bread, cut into 1/2-inch cubes",
    "1 tablespoon unsalted butter, softened",
    "2 cups sliced fresh strawberries",
    "1 (8 ounce) package cream cheese, softened",
    "2 cups half-and-half",
    "6 large eggs",
    "1 cup heavy cream",
    "1 tablespoon white sugar",
    "0.5 teaspoon ground ginger",
    "0.66666668653488 cup white sugar",
    "0.5 cup all-purpose flour",
    "4 tablespoons unsalted butter, softened",
    "1 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Place bread cubes on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast in the preheated oven until dry and golden brown, about 20 minutes. Cool slightly, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a 9x13-inch casserole dish with 1 tablespoon softened butter. Add bread cubes and strawberries; randomly dollop with cream cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk half-and-half, eggs, cream, 1 tablespoon sugar, and ½ teaspoon ginger together in a separate bowl; pour over bread mixture. Cover the dish with plastic wrap; refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set casserole aside at room temperature 1 hour before baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ⅔ cup sugar, flour, ¼ cup butter, and 1 teaspoon ginger with a fork until moist crumbs form; set streusel topping aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, about 30 minutes. Sprinkle streusel on top. Continue baking until top is golden, about 30 minutes more. Rest before serving for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
