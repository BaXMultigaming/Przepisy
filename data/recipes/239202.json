  "ingredients": [
    "1.5 cups brown sugar",
    "1 cup butter, softened",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "2.3333332538605 cups quick-cooking oats",
    "1.5 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "1 (11 ounce) package semisweet chocolate chips",
    "1 cup white chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter together in a bowl using an electric mixer until smooth and creamy; beat in eggs and vanilla extract until smooth. Mix oats, flour, baking soda, and salt into creamed butter mixture until dough is well-mixed; fold in semisweet chocolate chips and white chocolate chips. Scoop 1/4 cup batter per cookie and place on a baking sheet 3 inches apart, partially flattening dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are golden brown, 15 to 20 minutes. Cool cookies on baking sheet for 5 minutes before transferring to a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
