  "ingredients": [
    "2.5 pounds Yukon Gold potatoes, peeled and cut into 1-inch cubes",
    "2 cups Swanson® Chicken Broth",
    "0.5 cup half and half",
    "2 tablespoons butter",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes and Swanson® Chicken Broth in a 3-quart saucepan. Heat over high heat to a boil, then cover and cook (still on high) for 10 minutes or until the potatoes are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain the potatoes, reserving the broth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash the potatoes with the cream, butter and about 1/2 cup reserved broth (the consistency will vary depending on the type of potatoes used, so you may want to add more of the reserved broth- see ingredient note). Season with salt and freshly ground black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
