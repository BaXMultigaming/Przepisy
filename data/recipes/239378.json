  "ingredients": [
    "1 cup oatmeal",
    "0.5 teaspoon baking powder",
    "1 pinch white sugar",
    "2 cups milk",
    "1 egg, or more to taste",
    "0.25 cup dried cranberries",
    "0.25 cup flaked coconut",
    "0.25 cup chopped nuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oatmeal, baking powder, and sugar together in a large bowl. Beat milk and egg together in a separate bowl; add to oatmeal mixture and stir to incorporate. Stir cranberries, coconut, and nuts into the oatmeal mixture; spread into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until beginning to brown along the edges, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
