  "ingredients": [
    "4 eggs",
    "0.75 cup 1% milk",
    "salt and ground black pepper to taste",
    "1 cup all-purpose flour",
    "2 tablespoons all-purpose flour",
    "2 tablespoons lard"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a muffin tin in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, milk, salt, and pepper together in a bowl. Gradually whisk 1 cup plus 2 tablespoons flour, a small amount at a time, into egg mixture until batter is smooth. Let rest 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully remove muffin tin from oven and add lard to 6 muffin cups, about 1 teaspoon per muffin cup. Return to the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk batter again until small bubbles form on the surface. Carefully remove muffin tin from oven and ladle batter into greased muffin cups, filling almost to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puddings are risen and golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
