  "ingredients": [
    "4 (4 ounce) fillets orange roughy",
    "0.5 lemon",
    "0.5 cup grated Parmesan cheese",
    "0.25 cup butter, softened",
    "0.25 cup prepared Dijon mustard mayonnaise blend",
    "1 large clove garlic, pressed",
    "0.25 teaspoon salt",
    "0.5 teaspoon paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven's broiler and set the oven rack about 6 inches from the heat source.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fillets on the broiler pan and squeeze lemon over fillets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven for 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Parmesan, butter, Dijionnaise, garlic, and salt in a small bowl. Spread Parmesan mixture on top of fillets. Sprinkle with paprika.",
