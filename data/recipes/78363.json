  "ingredients": [
    "4 cloves garlic, peeled",
    "1.5 teaspoons salt",
    "1 bunch broccoli, cut into florets",
    "0.33333334326744 cup olive oil",
    "0.25 cup red wine vinegar",
    "1 tablespoon Dijon mustard",
    "0.5 cup grated Parmesan cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Place garlic in a mortar dish or on a cutting board, and sprinkle with salt. Mash with a pestle, or use the flat side of a knife to mash garlic and salt into a paste. Transfer to a medium bowl, and stir in olive oil, vinegar, and mustard. Add the broccoli, and stir to coat. Chill for 3 hours to marinate, stirring occasionally. Sprinkle with Parmesan cheese before serving.",
