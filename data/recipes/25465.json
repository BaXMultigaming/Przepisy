  "ingredients": [
    "1 large sweet onion",
    "1.5 tablespoons butter",
    "garlic salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel onion; slice into 6 to 8 wedges, leaving onion's base intact. Slightly pull apart wedges; place butter, garlic salt, and black pepper inside onion. Wrap onion tightly in aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until onion is translucent and lightly browned, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
