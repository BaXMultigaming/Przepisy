  "ingredients": [
    "1 (18.25 ounce) package white cake mix",
    "3 eggs",
    "1 cup vegetable oil",
    "1 cup lemon-lime flavored carbonated beverage",
    "2 (3 ounce) packages instant pistachio pudding mix",
    "1 cup frozen whipped topping, thawed",
    "1 cup cold milk"
  ],
  "steps": [
    {
      "text": "Combine cake mix, eggs, oil, soda drink and 1 box pistachio pudding. Pour batter into a greased and floured 13 x 9 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 30 to 40 minutes, or until a toothpick inserted into cake comes out clean. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While cake is baking, mix 1 box pistachio pudding, whipped topping, and milk. Chill. Ice cooled cake with chilled frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
