  "ingredients": [
    "2 cups whole milk",
    "0.33333334326744 cup coarsely ground coffee beans",
    "0.75 cup brown sugar, divided",
    "1 bunch fresh mint leaves, crushed",
    "6 large egg yolks",
    "1 cup heavy whipping cream",
    "0.33333334326744 cup white rum",
    "0.33333334326744 cup chopped chocolate"
  ],
  "steps": [
    {
      "text": "Heat milk, ground coffee, 1/4 cup brown sugar, and mint in a saucepan over low heat until warmed through, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg yolks and remaining 1/2 cup brown sugar in a bowl; slowly whisk in about 1 cup hot milk mixture. Pour egg yolk mixture into saucepan and continue to heat until custard is thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a sieve with cheesecloth and strain custard into a large bowl; discard solids. Whisk heavy cream into custard. Cover and refrigerate until chilled, 4 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rum and chocolate into chilled custard and pour into an ice cream maker. Freeze according to manufacturer's directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
