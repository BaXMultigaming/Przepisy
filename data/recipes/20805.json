  "ingredients": [
    "1 (16 ounce) package bacon",
    "2 (8 ounce) cans water chestnuts, drained",
    "1 cup ketchup",
    "1 cup brown sugar",
    "1 teaspoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut bacon slices into thirds. Cut large water chestnuts in half. Wrap each water chestnut with bacon; secure with a toothpick. Place on a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ketchup, brown sugar, and Worcestershire sauce together in a saucepan over medium heat until almost boiling; pour over bacon-wrapped water chestnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bacon is cooked and crisp, about 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
