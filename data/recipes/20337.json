  "ingredients": [
    "1 (9 inch) sponge cake",
    "0.375 cup strong brewed coffee, room temperature",
    "0.375 cup brandy",
    "1.5 pounds mascarpone cheese, room temperature",
    "1.5 cups confectioners' sugar",
    "3 tablespoons unsweetened cocoa powder, for dusting"
  ],
  "steps": [
    {
      "text": "Cut the cake in half lengthwise to make two layers. Combine the coffee and brandy. Sprinkle enough of the coffee mixture over the bottom cake layer to moisten it well, but not soak it.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together the mascarpone and the confectioners' sugar until fluffy. Spread half the cheese mixture over the bottom cake layer. Top with remaining cake layer and spread remaining cheese on top. Dust liberally with sifted cocoa. Refrigerate 2 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
