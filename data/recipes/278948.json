  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, 1/2 cup flour, and cinnamon in a bowl. Cut in 6 tablespoons cold butter. Stir in apple and walnuts. Set streusel topping aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 cups flour, baking powder, and salt in a bowl. Beat white sugar and 1/3 cup softened butter together in a large bowl with an electric mixer until creamy. Add baking powder mixture; stir in milk, egg, and vanilla extract. Transfer batter to the prepared pan; sprinkle streusel topping over top. Swirl a knife through both mixtures.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
