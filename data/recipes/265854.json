  "ingredients": [
    "1 large ripe papaya",
    "2 cups heavy whipping cream",
    "1 cup packed dark brown sugar",
    "5 teaspoons chili-lime seasoning (such as Tajin®)",
    "2 cups chopped strawberries"
  ],
  "steps": [
    {
      "text": "Cut the papaya in half lengthwise. Scoop out the seeds and pulp. Spoon out the flesh and place in a blender or food processor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add heavy whipping cream, brown sugar, and chili-lime seasoning to the blender or food processor; blend until smooth, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the mixture into an airtight bowl and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer's instructions, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chopped strawberries in the last 5 minutes of churning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
