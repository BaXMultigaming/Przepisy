  "title": "Oyster Sauce Chicken",
  "description": "Oyster chicken is made with chicken thighs baked in a sweet oyster and garlic sauce. Serve this deliciously sticky chicken over rice for rave reviews.",
  "authors": [
    "TAGOILELAGI"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
