  "ingredients": [
    "8 chicken thighs",
    "salt and pepper to taste",
    "1 (10 fluid ounce) bottle oyster sauce",
    "0.75 cup white sugar, or more to taste",
    "0.25 cup water",
    "2 teaspoons minced garlic"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken thighs all over with salt and pepper; place into the prepared baking dish with the skin facing up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix oyster sauce, sugar, water, and garlic together in a bowl. Taste and add more sugar if not sweet enough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sauce over chicken and continue to bake until no longer pink at the bone and the juices run clear, about 20 more minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
