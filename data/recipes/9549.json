  "ingredients": [
    "0.5 cup mayonnaise",
    "0.5 cup shredded Cheddar cheese",
    "0.5 cup shredded Monterey Jack cheese",
    "0.125 teaspoon onion salt",
    "1 teaspoon dried dill weed",
    "0.125 teaspoon lemon pepper",
    "0.5 (14 ounce) can artichoke hearts, drained"
