  "ingredients": [
    "3 tablespoons olive oil, divided",
    "2 tablespoons white balsamic vinegar",
    "0.5 teaspoon Dijon mustard",
    "salt and pepper to taste",
    "1 head radicchio",
    "2 tablespoons coarsely chopped pistachio nuts",
    "2 tablespoons crumbled blue cheese"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together 2 tablespoons olive oil, balsamic vinegar, Dijon mustard, salt, and pepper in a small bowl. Set dressing aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut radicchio head into 4 wedges. Brush wedges with remaining 1 tablespoon olive oil and lightly sprinkle with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place wedges on the preheated grill; grill until lightly charred, 3 to 4 minutes on each side. Transfer to a plate and top with pistachios and blue cheese; drizzle with dressing. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
