  "ingredients": [
    "1.5 pounds ground beef",
    "0.66666668653488 cup plain breadcrumbs",
    "0.33333334326744 cup minced onion",
    "0.25 cup milk",
    "1 egg",
    "1.5 teaspoons salt",
    "0.5 cup brown sugar",
    "2 tablespoons cornstarch",
    "1 (15 ounce) can pineapple chunks, juice reserved",
    "0.33333334326744 cup vinegar",
    "0.33333334326744 cup chopped green bell pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together ground beef, bread crumbs, onion, milk, egg, and salt in a large bowl until well combined. Roll mixture into balls and arrange onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until meatballs are browned on the bottom, about 25 minutes. Transfer to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together brown sugar and cornstarch in a medium saucepan and place over low heat. Add reserved pineapple juice and vinegar; stir until smooth. Bring to a boil for 1 full minute before removing from heat; pour over meatballs in the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pineapple chunks and green bell pepper to the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until flavors are thoroughly combined, 3 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
