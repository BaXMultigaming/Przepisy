  "ingredients": [
    "0.5 sweet onion, roughly chopped",
    "0.5 cup red wine",
    "3 tablespoons honey",
    "2 tablespoons Dijon mustard",
    "2 tablespoons lemon juice",
    "4 garlic cloves, minced",
    "1 tablespoon ground thyme",
    "1 tablespoon dried rosemary",
    "2 teaspoons ground basil",
    "1 teaspoon salt",
    "1 teaspoon coarse ground black pepper",
    "0.25 cup tapioca starch",
    "1.5 pounds sirloin lamb chops, room temperature"
  ],
  "steps": [
    {
      "text": "Combine onion and red wine in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk honey, mustard, lemon juice, garlic, thyme, rosemary, basil, salt, and pepper together in a small bowl until well blended. Add tapioca starch and whisk until well combined. Let sit until mixture is thickened, at least 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip lamb chops in the honey-mustard mixture and massage until fully coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chops in a single layer over the red wine and onion mixture in the slow cooker. Pour remaining honey-mustard mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker and cook on Low for 4 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
