  "ingredients": [
    "0.25 lemon",
    "1 pint heavy cream",
    "0.5 cup confectioners' sugar",
    "1 cup milk",
    "3.5 teaspoons unflavored gelatin",
    "0.75 teaspoon vanilla extract",
    "1.5 cups sliced fresh strawberries",
    "1.5 cups fresh raspberries"
  ],
  "steps": [
    {
      "text": "Cut the rind from 1/4 lemon into long strips. Place strips in a saucepan with cream and confectioners' sugar. Bring to a simmer over medium heat. Set aside to steep for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine milk and gelatin in a small bowl. Let sit for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reheat the cream mixture until hot. Remove from heat. Stir in gelatin mixture and vanilla extract. Remove lemon rind. Pour into 8 ramekins and refrigerate until set, about 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To serve, arrange strawberry slices and raspberries on top of each custard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
