  "ingredients": [
    "8 links pork sausage",
    "1 onion, chopped",
    "3 tablespoons all-purpose flour",
    "2.5 cups water",
    "2 cubes beef bouillon",
    "1 tablespoon Worcestershire sauce",
    "2 tablespoons tomato sauce",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Boil sausages in large pan of water for 5 minutes; drain and peel off skin. Chop up sausages.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large fry pan and fry onion until soft and golden. Remove pan from heat and add flour. Stir slowly adding water until well combined. Return to heat and bring to boil, stirring. Add beef cubes, Worcestershire sauce, tomato sauce, salt and pepper; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat and add cooked sausages. Cover and simmer for 20 minutes.",
      "section": null,
