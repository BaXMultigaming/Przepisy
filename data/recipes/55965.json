  "ingredients": [
    "0.25 cup salt",
    "8 cups water",
    "12 duck breast halves",
    "12 slices bacon",
    "1 (16 ounce) bottle Italian-style salad dressing",
    "toothpicks"
  ],
  "steps": [
    {
      "text": "Mix together salt and water. Set aside 2/3 of the mixture, and pour the rest into a glass baking dish. Soak the duck in the salt water overnight to remove the gamey. Change the salt water twice, or until mostly clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "The next morning, discard the salt water, and pour salad dressing over the duck breasts, and marinate for at least 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Wrap each breast half in one strip of bacon, and secure with a toothpick. Place the breasts in a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for about 1 hour, or until bacon is crisp, and duck is cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
