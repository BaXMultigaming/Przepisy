  "ingredients": [
    "1.5 cups sugar, plus more for sprinkling",
    "2 sticks butter, softened",
    "0.75 cup Grandma's® Original Molasses",
    "1 egg",
    "1 teaspoon Spice Islands® Pure Vanilla Extract",
    "3 cups flour, plus more for dusting",
    "1 teaspoon Clabber Girl® Baking Soda",
    "1 teaspoon Clabber Girl® Baking Powder",
    "1 teaspoon Spice Islands® Ground Nutmeg",
    "1 teaspoon Spice Islands® Ground Cloves",
    "1 tablespoon Spice Islands® Ground Ginger",
    "1 tablespoon Spice Islands ® Ground Saigon Cinnamon"
  ],
  "steps": [
    {
      "text": "In a large bowl, whip together sugar, butter, molasses, egg, and vanilla. Mix in flour, baking soda, baking powder, nutmeg, cloves, ginger, and cinnamon until dough comes together. Wrap well and refrigerate 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll cookie dough into 1-inch balls and roll in sugar to coat. Arrange on rimmed baking sheets. Bake in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
