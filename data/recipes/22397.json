  "ingredients": [
    "1 small head red cabbage, shredded",
    "1 apple, cored and diced",
    "3 teaspoons salt, divided",
    "1 tablespoon lemon juice",
    "0.5 cup water",
    "1 tablespoon butter",
    "1 small onion, chopped",
    "0.125 teaspoon ground black pepper",
    "1 tablespoon wine vinegar",
    "1 pound kielbasa sausage, cut into 1 inch pieces"
  ],
  "steps": [
    {
      "text": "Place cabbage in a large kettle; add diced apple, 2 teaspoons salt, lemon juice, and water. Bring to a boil. Reduce heat, cover, and simmer, stirring occasionally, for about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm butter in a skillet over medium-high heat. Sauté onion until golden. Add onion to cabbage mixture along with 1 teaspoon salt, pepper, vinegar, and sausage. Cook, covered, until sausage is heated through, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon cabbage onto a heated platter and top with sausage to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
