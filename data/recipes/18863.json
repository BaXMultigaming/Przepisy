  "title": "Sarma (Stuffed Cabbage)",
  "description": "Sarma is a Turkish food featuring tender cabbage leaves stuffed with seasoned rice and three types of meat, steamed over a bed of sauerkraut.",
  "authors": [
    "Bea Gassman"
  ],
  "date_published": "2000-04-13T21:22:32-04:00",
