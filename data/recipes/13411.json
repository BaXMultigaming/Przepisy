  "title": "Creamy Tomato And Cream Cheese Soup",
  "description": "A seasoned and pureed brick of cream cheese adds creaminess to this soup of baked tomatoes in beef broth. Garnish before serving with chopped parsley.",
  "authors": [
    "MARBALET"
  ],
  "date_published": "1999-09-23T11:45:28-04:00",
