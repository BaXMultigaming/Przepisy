  "ingredients": [
    "1 (20 ounce) can pineapple chunks in juice, drained",
    "0.5 pound sliced bacon, cut into thirds",
    "0.5 cup packed brown sugar",
    "0.5 cup mayonnaise",
    "0.25 cup chili sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap each pineapple chunk with 1 piece bacon; secure with toothpicks. Place in a shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, mayonnaise, and chili sauce in a small bowl; pour over bacon-wrapped pineapple.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, uncovered, until bacon is crispy on the edges and sauce is bubbly, 25 minutes; serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
