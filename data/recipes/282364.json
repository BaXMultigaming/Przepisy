  "ingredients": [
    "2.5 pounds russet potatoes, scrubbed",
    "0.25 cup margarine (such as Country Crock®)",
    "1 cup canned pumpkin",
    "1 teaspoon salt",
    "0.5 teaspoon pumpkin pie spice",
    "0.5 teaspoon dried basil"
  ],
  "steps": [
    {
      "text": "Cut potatoes into big chunks, leaving skins on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine potatoes and 1 1/2 cups water in a stovetop pressure cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Close cooker securely and place pressure regulator over vent according to manufacturer's instructions. Heat until steam escapes in a steady flow and makes a whistling sound, about 10 minutes. Adjust temperature until regulator is gently rocking. Cook for 10 minutes. Let pressure release naturally according to manufacturer's instructions, 5 to 10 minutes. Unlock lid and remove.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain water and mash potatoes. Stir in margarine. Stir in pumpkin, salt, pumpkin pie spice, and basil until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
