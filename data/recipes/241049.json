  "ingredients": [
    "3 medium sweet potatoes, sliced into 1/4-inch wedges",
    "2 tablespoons vegetable oil",
    "1 teaspoon kosher salt",
    "0.5 teaspoon cracked black pepper",
    "0.75 cup Mott's Natural Applesauce",
    "2 tablespoons unsalted butter",
    "3 tablespoons light brown sugar",
    "2 medium yellow onions, thinly sliced",
    "8 ounces regular or reduced-fat sour cream",
    "0.25 cup Mott's Natural Applesauce",
    "0.33333334326744 cup ketchup",
    "2 tablespoons mayonnaise",
    "0.125 teaspoon chipotle chile powder",
    "0.25 teaspoon garlic powder",
    "0.25 cup Mott's Natural Applesauce",
    "2 tablespoons coarse ground mustard",
    "0.25 cup maple syrup",
    "1 teaspoon molasses"
  ],
  "steps": [
    {
      "text": "For fries, preheat oven to 400 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil rimmed baking sheet, wiping up any excess oil with paper towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place prepared baking sheet in rack in third part of the oven. Toss sweet potatoes with vegetable oil and salt in medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sweet potato wedges, in a single layer, on heating baking sheet. Bake 15 minutes or until develops a nice golden brown crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn potatoes over using a spatula and bake an additional 10-15 minutes until potatoes are crisp and have browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Caramelized Onion Dip: For dip, while potatoes bake, in saute pan over medium heat, melt butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add brown sugar and onions. Cook until onions have caramelized. Puree caramelized onions, applesauce and sour cream in blender or food processor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Can be served warm or cold with fries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chipotle Ketchup Dip: Whisk together applesauce, ketchup, mayonnaise, and spices. Serve cold or warm as dip for sweet potato fries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mustard Dipping Sauce: Whisk together applesauce, mustard, syrup, and molasses. Serve cold or warm as dip for sweet potato fries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
