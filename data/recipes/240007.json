    "Dessert"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "0.5 cup shortening",
    "0.5 cup peanut butter",
    "0.5 cup packed brown sugar",
    "0.5 cup white sugar",
    "1 egg, beaten",
    "2 tablespoons milk",
    "1 teaspoon vanilla extract",
    "1.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 cup white sugar for rolling",
    "24 chocolate candy spheres with smooth chocolate filling (such as Lindt Lindor Truffles), refrigerated until cold",
    "48 decorative candy eyeballs",
    "0.5 cup prepared chocolate frosting"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3a0Z1TIYqyPa7zuTHsXRAYwdv7U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240007-peanut-butter-spider-cookies-VAT-step-01-9b12195175b040c69c84b48f1a68c817.jpg"
      ],
      "image": "assets/images/240007/step_01.webp"
    },
    {
      "text": "Beat shortening, peanut butter, brown sugar, and ½ cup white sugar in a large bowl with an electric mixer until smooth. Beat egg into the creamy mixture until fully incorporated. Stir milk and vanilla extract into the mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Oov1bi9DM6q13FEdJcqwRfms3No=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240007-peanut-butter-spider-cookies-VAT-step-02-546dd74f5ac241f2acbce292aa5edad0.jpg"
      ],
      "image": "assets/images/240007/step_02.webp"
    },
    {
      "text": "Mix flour, baking soda, and salt together in a small bowl; add to peanut butter mixture in the large bowl and stir until completely incorporated into a dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xHDKPDSLO_2fNx5mhAE11Xj1Gy0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240007-peanut-butter-spider-cookies-VAT-step-03-ec24b7f51ff64f06a41010f483abd0ea.jpg"
      ],
      "image": "assets/images/240007/step_03.webp"
    },
    {
      "text": "Divide and shape dough into 48 balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/71n9FSLLNyJxwnnzNeDxeI2CcAQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240007-peanut-butter-spider-cookies-VAT-step-04-82c59e48ac064375b0b535d6819f1244.jpg"
      ],
      "image": "assets/images/240007/step_04.webp"
    },
    {
      "text": "Spread 1/4 cup white sugar into a wide, shallow bowl. Roll dough balls in sugar to coat and arrange about 2 inches apart onto prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nFzvBJIfpVBEa07dLB9_JV2jO0s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240007-peanut-butter-spider-cookies-VAT-step-05-e494ecdb0ab84f5db1a4c7e16e1e2cf7.jpg"
      ],
      "image": "assets/images/240007/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 10 to 12 minutes. Remove cookies from oven and quickly press a dimple into the center of each cookie using the blunt end of a wooden spoon. Cool cookies on sheets for 10 minutes before transferring to a wire cooling rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LaN0IeehyGePoCCYqsqFGksce0c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240007-peanut-butter-spider-cookies-VAT-step-06-48a4a3cd4ea54a03a2cd57ca5b9ff18b.jpg"
      ],
      "image": "assets/images/240007/step_06.webp"
    },
    {
      "text": "Cut each chocolate truffle in half. Put one piece atop each cookie with the rounded side facing upwards.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LgRSdJqakF7Mx4_FZvkQ_bJrC0w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240007-peanut-butter-spider-cookies-VAT-step-07-df25694c2d1f4c948725c2232891a38d.jpg"
      ],
      "image": "assets/images/240007/step_07.webp"
    },
    {
      "text": "Spoon frosting into a piping bag fitted with a small round tip, or use a resealable plastic bag with a corner snipped off. Dab a small amount of frosting onto the back of each candy eyeball and stick two onto each chocolate candy to resemble eyes. Then pipe frosting in four thin lines, starting at the base of the candy, on each side atop the cookie to resemble spider legs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UyrD0lf1Dq6hv-qx45CCiMpicv0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240007-peanut-butter-spider-cookies-VAT-step-08-f4d1a17db89342cb9e71c4924723a4f6.jpg"
      ],
      "image": "assets/images/240007/step_08.webp"
    },
    {
      "text": "Let frosting harden at room temperature, about 30 minutes. Store cookies in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yhuy63LPw1Gw1nbKN6Uzg3AT2Is=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240007-peanut-butter-spider-cookies-VAT-Beauty-4x3-90b951448458467b8fc0f59eadc20b4e.jpg"
      ],
      "image": "assets/images/240007/step_09.webp"
    }
  ],
