  "title": "Peanut Butter Spider Cookies",
  "description": "These cute spider cookies are a fun Halloween treat made with peanut butter cookie dough, chocolate candies, and frosting to decorate them as spiders.",
  "authors": [
    "What's for dinner, mom?"
  ],
  "date_published": "2020-06-19T00:01:21-04:00",
  "date_modified": "2026-01-05T05:38:34-05:00",
  "prep_time": "PT45M",
