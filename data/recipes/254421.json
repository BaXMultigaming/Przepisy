  "ingredients": [
    "1 watermelon rind, peeled",
    "4 cups water",
    "4 cups white sugar",
    "0.5 cup spearmint leaves, coarsely chopped",
    "1 tablespoon dried sweet basil"
  ],
  "steps": [
    {
      "text": "Cut watermelon rind into 2-inch long, 1-inch wide, and 1/2-inch thick pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, sugar, spearmint, and basil in a large pot. Bring to a rolling boil. Strain out spearmint and basil. Add watermelon rind, making sure pieces are completely immersed. Cook until rind is soft, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain watermelon pieces and arrange in a single layer on dehydrator trays. Dry according to the manufacturer's instructions until pieces are candied, 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
