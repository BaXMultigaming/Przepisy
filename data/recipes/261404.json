  "ingredients": [
    "1.5 tablespoons canola oil",
    "2 teaspoons minced garlic",
    "1 pound baby bok choy",
    "1 tablespoon light soy sauce",
    "0.5 teaspoon white sugar",
    "salt to taste",
    "0.25 cup water",
    "0.5 teaspoon sesame oil",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat a wok over medium heat. Add oil and heat until shimmering. Add garlic and stir-fry until fragrant, about 30 seconds. Add bok choy and cook for 30 seconds. Add soy sauce and sugar, then season with salt; cook for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour water into the wok, cover, and simmer until bok choy leaves are dark green and stems are tender but still firm, 2 to 3 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle sesame oil over bok choy and season with pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
