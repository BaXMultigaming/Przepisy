  "keywords": [],
  "ingredients": [
    "2 pounds chicken tenderloins, tendons removed",
    "0.5 cup tapioca starch",
    "1.5 teaspoons jerk seasoning",
    "0.5 teaspoon granulated garlic",
    "1 egg",
    "1 teaspoon hot sauce",
    "1 cup cornflakes, finely crushed",
    "0.25 cup unsweetened coconut flakes"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C) for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine tapioca starch, jerk seasoning, and garlic in a shallow bowl for the dry mix. Beat together egg and hot sauce in a separate shallow bowl for the egg wash. Combine corn flakes and coconut flakes in a third shallow bowl for the crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each chicken tender into the dry mix, shaking off excess spice. Dip into egg wash, draining excess, and dredge through the crust mixture. Repeat steps for each tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place crusted chicken tenders into the air fryer basket and cook on high for 6 minutes. Turn tenders and cook for another 6 minutes until chicken is cooked through and coating is crisp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
