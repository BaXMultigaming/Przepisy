  "ingredients": [
    "2 tablespoons vegetable oil",
    "1 cup coarsely broken tortilla chips",
    "0.5 medium onion, chopped",
    "0.5 medium green bell pepper, chopped",
    "0.75 cup chopped chorizo sausage",
    "1 medium tomato, diced",
    "5 large eggs, beaten",
    "salt and ground black pepper to taste",
    "6 (6 inch) warm corn tortillas",
    "1 cup shredded Cheddar cheese",
    "0.25 cup salsa"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium-high heat. Add broken tortilla chips; cook and stir for 2 to 3 minutes. Add onion; cook and stir for 3 minutes. Add bell pepper and cook until tender, 3 to 5 minutes. Stir in sausage and let cook until heated through, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomato and mix until well combined. Pour beaten eggs into the skillet and season with salt and pepper. Cook, stirring regularly, until eggs are set and thoroughly cooked, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve skillet mixture with tortillas, Cheddar cheese, and salsa for guests to assemble themselves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
