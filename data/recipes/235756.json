  "ingredients": [
    "3 cups masa harina",
    "1 tablespoon salt",
    "2 cups warm water, or as needed",
    "1 quart oil for frying"
  ],
  "steps": [
    {
      "text": "Whisk masa harina and salt together in a bowl. Stir in enough water until dough is smooth and holds together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N2yBwQ1REXqSPDavHiw2ZeOw5sQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235756-easy-mexican-sopes-step1-671copy-45c7b26fa8ce404cbf325d948cde6bf7.jpg"
      ],
      "image": "assets/images/235756/step_01.webp"
    },
    {
      "text": "Form dough into twelve 2-inch balls. Place balls onto parchment paper and flatten to 1/2-inch thick circles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8VPCNrW5J38uKFV70T0loX1-Rg8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235756-easy-mexican-sopes-step2-676copy-df181994236142408efc134a4d08c822.jpg"
      ],
      "image": "assets/images/235756/step_02.webp"
    },
    {
      "text": "Heat oil in a deep fryer or large saucepan to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, fry a few sopes at a time until lightly browned, about 30 seconds per side. Transfer with tongs to a paper towel-lined plate and let cool just until they can be handled, 2 to 3 minutes. Pinch the edges of each sope together to form a little boat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return sopes to the hot oil and fry until golden and cooked through, 1 to 2 more minutes. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c9Owg1gi4DKWwLDHLNGCM4S9r5c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235756-easy-mexican-sopes-step3-678copy-9d3ef7742ca94fa38256a004dc02ab92.jpg"
      ],
      "image": "assets/images/235756/step_05.webp"
    }
