    "French"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "4 medium russet potatoes, thinly sliced",
    "1 medium onion, sliced into rings",
    "salt and ground black pepper to taste",
    "3 tablespoons butter",
    "3 tablespoons all-purpose flour",
    "0.5 teaspoon salt",
    "2 cups milk",
    "1.5 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Grease a 2-quart casserole dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QqpyBtBhWj-5mqwgGw0V8XQ-QIg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15925-creamy-au-gratin-potatoes-ddmfs-step-1-51a1bb33317440fc9e169121c9d9049e.jpg"
      ],
      "image": "assets/images/15925/step_01.webp"
    },
    {
      "text": "Layer 1/2 of the potatoes in the bottom of the prepared casserole dish; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lwKwIOwjbTGp-MD0tTOWD0Sk15s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15925-creamy-au-gratin-potatoes-ddmfs-step-2-14b100c716af4eb0b690cc7adcdaa847.jpg"
      ],
      "image": "assets/images/15925/step_02.webp"
    },
    {
      "text": "Layer onion slices over top, then top with with remaining potatoes. Season again with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Earf0Oygyw29AqEUdhqF-YqEJD4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15925-creamy-au-gratin-potatoes-ddmfs-step-4-32ea149eb83f440ab31c08309061aa01.jpg"
      ],
      "image": "assets/images/15925/step_03.webp"
    },
    {
      "text": "Melt butter in a medium saucepan over medium heat. Whisk in flour and salt; cook, whisking constantly, until raw flour flavor has cooked off, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gF0p3Pvw292Lza6W9Fwpx393blM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15925-creamy-au-gratin-potatoes-ddmfs-step-6-5b24431d058d463abc69ca6fa1974d54.jpg"
      ],
      "image": "assets/images/15925/step_04.webp"
    },
    {
      "text": "Gradually add milk, about 1/4 cup at a time, whisking well after each addition to incorporate; the gradual addition and whisking of milk will help avoid lumps in your sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3mw9Jk_ps5R2oqd-WN2PasSxJvA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15925-creamy-au-gratin-potatoes-ddmfs-step-7-9221f76f0b6b4935a04c364e9a40ba06.jpg"
      ],
      "image": "assets/images/15925/step_05.webp"
    },
    {
      "text": "Cook, whisking constantly, until the mixture has thickened, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rdSJm0r9e3X6g5EvOi2qtKEOlLs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15925-creamy-au-gratin-potatoes-ddmfs-step-8-cc43303a95e14e72b80ed10490291851.jpg"
      ],
      "image": "assets/images/15925/step_06.webp"
    },
    {
      "text": "Stir in cheese all at once; cook, stirring constantly, until melted, 30 to 60 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Iu-6SxiX7jkfoNGTJdDVBjKCkC8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15925-creamy-au-gratin-potatoes-ddmfs-step-9-82cce42757f1470b9e3b660f599380c6.jpg"
      ],
      "image": "assets/images/15925/step_07.webp"
    },
    {
      "text": "Pour cheese sauce over the potatoes, and cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NSdlcQGLz1wjKbbHdKyIZthfVDM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15925-creamy-au-gratin-potatoes-ddmfs-step-10-ccfd259b6ea546eda7f476520840accd.jpg"
      ],
      "image": "assets/images/15925/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven until potatoes are tender and sauce is bubbly, about 1 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m4Ab_qaYCt9cFG2blJ5suJUkV0g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15925-creamy-au-gratin-potatoes-mfs_120-c597ec9a74464fd6b72efed5779e1290.jpg"
      ],
      "image": "assets/images/15925/step_09.webp"
    }
  ],
