  "title": "Creamy au Gratin Potatoes",
  "description": "Au gratin potatoes made with thinly sliced potatoes and onions baked in a decadently rich and creamy cheese sauce until tender and bubbling.",
  "authors": [
    "Cathy Martin"
  ],
  "date_published": "2000-02-06T14:23:07-05:00",
  "date_modified": "2026-01-20T14:51:26-05:00",
