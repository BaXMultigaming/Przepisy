  "ingredients": [
    "1 large egg, beaten",
    "2 tablespoons milk",
    "0.5 teaspoon salt",
    "1 cup sifted all-purpose flour, or more as needed"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine egg, milk, and salt in a bowl. Add sifted flour and stir until a dough forms, adding more flour as needed, a little at a time, for the dough to come together. Separate into two balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle a work surface with flour and roll out each piece of dough as thin as you like. Let rolled dough rest for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut into strips and spread to dry, dusting with a bit of flour so the noodles don't stick together. Let dry for approximately 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook noodles in boiling salted water, or hot soup, until tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
