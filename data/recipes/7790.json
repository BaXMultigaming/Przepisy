  "title": "Gone with the Wind Cake",
  "description": "This is a lovely sponge cake that is reminiscent of the Deep South. May be cut into layers and filled and iced with lemon filling, or with whipped cream.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-06-20T13:45:41-04:00",
