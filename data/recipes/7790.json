  "ingredients": [
    "0.75 cup cold water",
    "3 egg yolks",
    "3 egg whites",
    "1.5 cups white sugar",
    "1 teaspoon vanilla extract",
    "1.75 cups sifted cake flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cold water and egg yolks together until mixture makes 1 quart--at least 10 minutes. Slowly add sugar and vanilla to egg yolk mixture, beating for at least 7 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift the cake flour, baking powder, and salt together. Fold into the egg yolk mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites until medium-stiff peaks form. Fold one third of the egg white mixture into the batter to lighten; fold in remaining egg whites. Pour batter into an ungreased tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until cake springs back when lightly touched with a fingertip, about 50 minutes. Turn upside down to cool in pan for 1 hour. Loosen sides and coax from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
