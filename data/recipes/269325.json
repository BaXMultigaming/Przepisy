  "ingredients": [
    "3 cups fresh basil leaves",
    "6 tablespoons pine nuts",
    "0.25 cup nutritional yeast",
    "4 cloves garlic",
    "3 slices sun-dried tomatoes",
    "0.75 teaspoon coarse sea salt",
    "0.5 teaspoon ground black pepper",
    "2 pinches paprika, or to taste",
    "6 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Combine basil, pine nuts, nutritional yeast, garlic, sun-dried tomatoes, salt, pepper, and paprika in a food processor. Blend, gradually pouring in olive oil, until liquefied.",
