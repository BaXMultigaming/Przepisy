  "ingredients": [
    "1 (2 pound) venison roast",
    "1 cup packed brown sugar",
    "0.33333334326744 cup unsweetened apple juice",
    "0.33333334326744 cup soy sauce",
    "0.5 teaspoon salt",
    "3 tablespoons cold water",
    "2 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Cut venison roast in half; rub with brown sugar. Place roast into a slow cooker; add apple juice, soy sauce, and salt. Cover the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low setting until roast is tender, about 6 hours. Transfer roast to a platter, cover, let stand for 15 minutes, then slice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, pour cooking liquid through a strainer into a medium-sized bowl; discard solids. Return cooking liquid to the slow cooker. Whisk water and cornstarch together until smooth; stir into cooking liquid until combined. Cover the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High until thickened, about 15 minutes. Serve sliced roast with gravy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
