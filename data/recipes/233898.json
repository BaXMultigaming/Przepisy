  "ingredients": [
    "2 cups oil for frying",
    "0.66666668653488 cup all-purpose flour",
    "0.33333334326744 cup finely crushed cornflakes cereal",
    "1.5 teaspoons baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon white sugar",
    "0.75 cup milk",
    "16 slices 1/8-inch thick green tomato slices"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer to 360 degrees F (182 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cornflakes, baking powder, salt, black pepper, and sugar together in a shallow dish until well combined. Pour milk into a separate shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently press 1 tomato slice into flour mixture to coat on both sides; shake off excess. Dip into milk; press into flour mixture again. Place in a single layer on a plate; do not stack. Repeat with remaining tomato slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lower tomato slices carefully into the hot oil in batches until golden brown, about 3 minutes per side. Transfer to a paper towel-lined plate to drain. Repeat with remaining tomato slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
