  "ingredients": [
    "8 ounces penne pasta",
    "3 tablespoons Country Crock® Spread, divided",
    "2 medium shallots, sliced",
    "2 cloves garlic, chopped",
    "1 cup cherry tomatoes, halved",
    "1 cup zucchini, sliced",
    "1 cup yellow squash, sliced",
    "1 cup frozen peas",
    "0.5 cup chicken or vegetable broth",
    "1 tablespoon chopped fresh mint or basil",
    "0.5 teaspoon lemon zest",
    "Grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Cook pasta according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt 2 tablespoons Country Crock® Spread in large nonstick skillet over medium heat. Add shallots and cook 3 minutes or until tender. Add garlic and cook 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add vegetables and cook 3 minutes, stirring occasionally. Stir in broth and simmer 5 minutes or until vegetables are tender. Add remaining tablespoon Country Crock® Spread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss vegetable mixture with cooked pasta, mint or basil, and lemon zest. Sprinkle with Parmesan cheese, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
