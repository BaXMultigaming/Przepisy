  "ingredients": [
    "0.75 cup Gevalia® Cold Brew Concentrate - House Blend, chilled",
    "0.25 cup cream of coconut",
    "0.25 teaspoon almond extract",
    "4 large scoops vanilla ice cream",
    "1 tablespoon whipped cream, or to taste",
    "1 tablespoon sweetened coconut flakes",
    "1 tablespoon slivered almonds",
    "1 maraschino cherry"
  ],
  "steps": [
    {
      "text": "Place chilled cold brew concentrate, cream of coconut, almond extract, and ice cream in a blender. Blend all ingredients just enough to mix well, 10 to 15 seconds. Pour into a large glass.",
