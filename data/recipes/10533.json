  "ingredients": [
    "1.3333333730698 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "4 eggs",
    "1 cup honey",
    "2 teaspoons almond extract",
    "1 cup dates, pitted and chopped",
    "1 cup chopped almonds",
    "0.33333334326744 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Combine flour, baking powder and salt and set aside. Beat eggs in a large bowl until thick and lemon colored. Beat in honey and almond extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually add in dry ingredients blending well. Stir in dates and almonds. Spread evenly in a 13 x 9 inch greased pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) 12-15 minutes until lightly brown on top. Cool 2 minutes in pan. Cut into bars. When cool, sprinkle with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
