  "ingredients": [
    "2 eggs",
    "1.75 cups milk",
    "0.25 cup vegetable oil",
    "1 cup all-purpose flour",
    "1 cup cornmeal",
    "2.5 teaspoons baking powder",
    "1 tablespoon sugar",
    "0.5 teaspoon salt",
    "0.5 pound thinly sliced bacon",
    "1 (1 pound) loaf processed cheese, cubed",
    "0.25 cup milk, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat your waffle iron.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix together the eggs, milk and oil. In a larger bowl, stir together the flour, cornmeal, baking powder, sugar and salt. Make a well in the center, and pour in the milk mixture. Stir until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/4 cup batter onto the heated waffle iron. Amount may be different for different irons. Place a strip of raw bacon over the batter across each section of the waffle iron. Close the lid, and cook until steam is no longer coming out, and the waffle is golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For the cheese sauce, melt processed cheese in a bowl in the microwave. Gradually stir in milk until you reach your desired thickness. Drizzle cheese sauce over waffles before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
