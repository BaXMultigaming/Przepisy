  "ingredients": [
    "6 fresh peaches - pitted, skinned, and sliced",
    "1.5 cups white sugar",
    "2 tablespoons all-purpose flour",
    "1 egg",
    "0.5 cup butter, melted",
    "5 slices white bread"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut crust from bread slices, and cut each into 4 or 5 strips. Spread fruit into prepared pan, and cover with a layer of bread strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together butter, sugar, and flour; mix in egg. Pour mixture over the fruit and bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 35 to 45 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
