  "ingredients": [
    "1 large red onion, thinly sliced",
    "1 (2 pound) rabbit, rinsed and patted dry",
    "3 tablespoons lemon juice",
    "2 tablespoons olive oil",
    "2 tablespoons minced rosemary",
    "1 teaspoon chopped parsley",
    "0.5 teaspoon ground cumin",
    "0.5 cup slivered almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spread the thinly sliced onion onto the bottom of a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub the rabbit with lemon juice and olive oil. Sprinkle inside and out with a mixture of rosemary, parsley, and cumin. Place rabbit into the roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes, then sprinkle almonds over the onions. Continue baking until the meat has turned opaque, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
