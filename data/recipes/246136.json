  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup butter, at room temperature",
    "0.5 cup white sugar",
    "3 large eggs",
    "1.5 cups light brown sugar",
    "0.25 cup all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup chopped walnuts",
    "0.5 cup maraschino cherries, drained and chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a 10x15-inch jelly roll pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 2 cups flour, butter, and white sugar together into a smooth dough in a large bowl. Press evenly into prepared pan to make crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly golden, about 12 minutes. Remove from oven and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a large bowl until fluffy, 2 to 3 minutes. Add brown sugar, 1/4 cup flour, baking powder, and salt; mix well until smooth. Fold in walnuts and maraschino cherries. Spread filling over baked crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is set and golden brown, 20 to 25 minutes. Remove oven and allow to cool completely, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
