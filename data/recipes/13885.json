  "ingredients": [
    "1.125 cups green lentils",
    "2.25 cups water",
    "6 slices white bread, torn into small pieces",
    "2 eggs",
    "1 cup vegetable broth",
    "2 tablespoons tomato paste",
    "0.5 teaspoon dried basil",
    "0.25 teaspoon garlic powder",
    "0.5 teaspoon ground black pepper",
    "1 teaspoon dried parsley",
    "1 tablespoon olive oil",
    "0.5 packet dry vegetable soup mix",
    "0.33333334326744 cup dried bread crumbs"
  ],
  "steps": [
    {
      "text": "Combine lentils and water in a small saucepan. Bring to a boil. Reduce heat, and simmer until tender, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (205 degrees C). Grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together 2 cups cooked lentils, bread, eggs, broth, tomato paste, basil, garlic powder, black pepper, parsley, olive oil, and dry soup mix. Spread into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 40 minutes. Sprinkle top with dry bread crumbs, and continue baking another 10 minutes. Let sit for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
