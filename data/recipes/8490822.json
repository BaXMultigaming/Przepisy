  "ingredients": [
    "1 tablespoon unsalted butter",
    "2.5 cups leeks, white and light green parts only, thinly sliced",
    "0.25 teaspoon salt",
    "0.25 teaspoon freshly ground black pepper",
    "3.5 cups sliced celery",
    "0.5 teaspoon lemon zest",
    "1 clove garlic, minced",
    "chopped celery leaves for garnish (optional)"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium-high heat. Add leeks. Sprinkle with salt and pepper; cook, stirring occasionally, until just tender, about 3 minutes. Add celery to skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook, covered and stirring occasionally, until celery is tender, about 5 minutes. Add lemon zest and garlic; cook, stirring, 1 minute more. Garnish with celery leaves, if desired.",
