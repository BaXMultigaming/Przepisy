  "ingredients": [
    "1.5 cups all-purpose flour",
    "2 teaspoons poppy seeds",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.66666668653488 cup sugar",
    "0.33333334326744 cup butter, melted",
    "1 egg, lightly beaten",
    "1 egg yolk, beaten",
    "0.66666668653488 cup sour cream",
    "0.75 teaspoon vanilla extract",
    "0.5 teaspoon lemon peel",
    "0.25 teaspoon lemon extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 12 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, poppy seeds, baking powder, and baking soda in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together sugar and melted butter in a large bowl with an electric mixer until well mixed. Add lightly beaten egg, then beaten egg yolk, allowing each to blend into butter mixture before adding the next.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sour cream, vanilla, lemon peel, and lemon extract into egg mixture until well combined. Add flour mixture and stir until just moistened. Spoon batter into the prepared muffin cups, filling each cup about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and the tops spring back when lightly pressed, about 15 minutes. Cool for 5 minutes before removing to wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
