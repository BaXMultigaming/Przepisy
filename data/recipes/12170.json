  "ingredients": [
    "3 eggs",
    "1 cup white sugar",
    "1 cup corn syrup",
    "2 tablespoons butter, melted",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "1.5 cups pecan halves",
    "1 recipe pastry for a 9 inch single crust pie"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
