  "ingredients": [
    "2 (16 ounce) packages baby carrots",
    "1 cup orange juice",
    "0.25 cup honey",
    "0.5 cup apricot preserves",
    "3 tablespoons Dijon mustard",
    "2 tablespoons butter",
    "2 tablespoons brown sugar",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground white pepper"
  ],
  "steps": [
    {
      "text": "Mix carrots and orange juice in a large saucepan; bring to a boil, place a cover on the pan, reduce heat to low, and cook at a simmer until carrots are tender-crisp, 8 to 10 minutes. Drain carrots, reserving 1/4 cup of the orange juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return carrots and reserved juice to the pan and place over medium heat. Stir honey, apricot preserves, Dijon mustard, butter, brown sugar, salt, and black pepper with the carrots and juice; cook and stir until sugar dissolves completely and the carrots are glazed and tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
