  "ingredients": [
    "2 cups white sugar",
    "1.75 cups all-purpose flour",
    "0.75 cup unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "1 cup strong brewed coffee",
    "1 cup buttermilk",
    "0.5 cup vegetable oil",
    "2 large eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease and flour two 9-inch round cake pans or one 9x13-inch dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ajlWVdOPFLXC2q9v_hF85smTA-4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372-Black-Magic-Cake-ddmfs-Step-1-1080-feff626fbde34c738358e7c76790d608.jpg"
      ],
      "image": "assets/images/8372/step_02.webp"
    },
    {
      "text": "Combine sugar, flour, cocoa, baking soda, baking powder, and salt in a large bowl. Make a well in the center. Pour coffee, buttermilk, oil, eggs, and vanilla into the well. Beat for 2 minutes on medium speed. Batter will be thin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1Z5sDad3R-YK6ebt_lpHtzfC-qw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372-Black-Magic-Cake-ddmfs-Step-4-1087-94873269aa8c4dafb0ac14749fc3175e.jpg"
      ],
      "image": "assets/images/8372/step_03.webp"
    },
    {
      "text": "Pour into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BCLtOP8TpVrKrEcyJSqZjyL5g3Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372-Black-Magic-Cake-ddmfs-Step-5-1088-e46e695d270a4291bb50b23bf0dd865f.jpg"
      ],
      "image": "assets/images/8372/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5am_wQL1fpMzg3Lu7f2b6f4h6Mc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372-Black-Magic-Cake-ddmfs-step-6-1178-4e73af809c9043fa91dd778bf5a16d7b.jpg"
      ],
      "image": "assets/images/8372/step_05.webp"
    },
    {
      "text": "Cool for 10 minutes, then remove from the pans and finish cooling on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/t__5NaFd2V0q4Zu0yWMHuj-Dx3I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372-Black-Magic-Cake-ddmfs-step-7-1180-833678de94ec4823991ae0772a0d2333.jpg"
      ],
      "image": "assets/images/8372/step_06.webp"
    },
    {
      "text": "Fill and frost as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z2HFHhhqK5pJAaPvMFEk3fDXh6U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8372-black-magic-cake-DDMFS-4x3-9c505ceb4a2d43a79b5d2a31ca782932.jpg"
      ],
