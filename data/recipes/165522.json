  "ingredients": [
    "0.75 cup butter",
    "2 cloves garlic, minced",
    "1 cup dry bread crumbs",
    "0.33333334326744 cup grated Parmesan cheese",
    "2 tablespoons chopped fresh thyme",
    "2 tablespoons chopped fresh basil",
    "2 tablespoons chopped fresh oregano",
    "0.25 teaspoon pepper",
    "0.5 teaspoon salt",
    "6 (4 ounce) skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2DCwPdmJ2pMgknPfLt9QWOoJic0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-165522-baked-parmesan-crusted-chicken-VAT-step-01-ff34d2277bf14452988461d917f4af88.jpg"
      ],
      "image": "assets/images/165522/step_01.webp"
    },
    {
      "text": "Heat butter and garlic in a saucepan over medium heat until butter starts to bubble; remove from the heat and allow to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v_lR7AAshRAFfTcPwuPm8poR_zc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-165522-baked-parmesan-crusted-chicken-VAT-step-02-f44cd8fd6ca7494880e93e1f561aabf6.jpg"
      ],
      "image": "assets/images/165522/step_02.webp"
    },
    {
      "text": "Mix bread crumbs, Parmesan cheese, thyme, basil, oregano, pepper, and salt together in a bowl. Dip chicken breasts into melted butter mixture, then press into seasoned bread crumbs. Arrange breaded chicken breasts in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zKRUMrQl0uw9mBqj-xv33VhqlFg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-165522-baked-parmesan-crusted-chicken-VAT-step-03-1-943117cfe4c5485aab70de6c3a552fc2.jpg"
      ],
      "image": "assets/images/165522/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown on top and chicken is no longer pink in the center, about 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xIZXCHjtYkkL4iTRvGfha7liLNk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-165522-baked-parmesan-crusted-chicken-VAT-step-04-9fbf5d11fa624ba1822701556e7ed60e.jpg"
      ],
      "image": "assets/images/165522/step_04.webp"
    },
    {
      "text": "Serve and enjoy!",
