  "ingredients": [
    "6 tablespoons whipped cream cheese",
    "1 tablespoon lemon juice, or to taste",
    "0.25 cup low-fat milk",
    "0.5 teaspoon chopped fresh dill",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat cream cheese and lemon juice in a saucepan over medium heat and whisk until smooth. Slowly whisk in milk until incorporated and continue to heat until warmed through. Season with dill, salt, and pepper.",
