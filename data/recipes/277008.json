  "ingredients": [
    "2 (21 ounce) cans cherry pie filling",
    "1 (15.25 ounce) package white cake mix",
    "0.25 cup butter, melted",
    "0.5 cup coarsely chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cherry pie filling over the bottom of a 9x13-inch baking pan. Stir cake mix and butter together into a gooey, clumpy mixture. Break into pieces between your fingers and crumble evenly on top of the cherry filling. Sprinkle chopped pecans evenly on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fruit is bubbling and dump cake is golden brown on top, 35 to 40 minutes.",
