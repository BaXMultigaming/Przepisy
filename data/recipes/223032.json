  "title": "Grandpa&#39;s Garden Chicken Soup",
  "description": "This recipe for chicken soup with beans, potatoes, and lots of other vegetables is pretty flexible — just throw in your favorites and cook it low and slow.",
  "authors": [
    "SRF0079"
  ],
  "date_published": "2019-04-03T23:52:50-04:00",
