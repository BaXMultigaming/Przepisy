  "ingredients": [
    "1 tablespoon light olive oil",
    "2 cloves garlic, minced",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (12 ounce) package vegetarian ground beef crumbles (such as MorningStar Farms® Griller's Recipe Crumbles®)",
    "1 (1 ounce) package taco seasoning",
    "6 cups shredded lettuce",
    "2 cups non-fat cottage cheese",
    "1 cup shredded non-fat cheddar cheese",
    "2 tablespoons taco sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a skillet over medium-high heat. Add garlic; cook until fragrant and slightly softened, about 2 minutes. Add tomatoes, vegetarian crumbles, and taco seasoning; cook and stir until tomatoes are soft, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide lettuce between two bowls; divide tomato mixture between bowls on top lettuce. Surround tomato mixture with cottage cheese; sprinkle Cheddar cheese over top. Season with taco sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
