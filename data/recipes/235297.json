  "ingredients": [
    "1 (750 milliliter) bottle red wine (such as Cabernet Sauvignon, Beaujolais, or Burgundy)",
    "2 cups apple juice",
    "3 tablespoons honey",
    "3 cinnamon sticks",
    "10 pods cardamom pods",
    "8 whole cloves",
    "0.5 teaspoon anise seed"
  ],
  "steps": [
    {
      "text": "Stir red wine, apple juice, honey, cinnamon sticks, cardamom pods, cloves, and anise together in a saucepan over medium-low heat.",
