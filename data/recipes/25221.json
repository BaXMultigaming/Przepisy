  "ingredients": [
    "0.5 cup pecan halves",
    "18 frozen dinner rolls",
    "1 (3.5 ounce) package cook and serve butterscotch pudding mix",
    "0.5 cup butter",
    "0.5 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Generously butter a 9x13 inch baking pan. Sprinkle pecans in bottom of pan. Place frozen dinner rolls in a single layer on top of pecans. Sprinkle dry pudding mix over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter and brown sugar in a small saucepan. Heat until boiling then pour over rolls. Cover with plastic wrap or wax paper and allow to stand overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the morning, preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 to 30 minutes, until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
