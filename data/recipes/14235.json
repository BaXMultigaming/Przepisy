  "ingredients": [
    "1 head romaine lettuce",
    "0.75 cup extra virgin olive oil",
    "3 tablespoons red wine vinegar",
    "1 teaspoon Worcestershire sauce",
    "0.5 teaspoon salt",
    "0.25 tablespoon ground mustard",
    "1 clove crushed garlic",
    "1 egg",
    "1 lemon, juiced",
    "freshly ground black pepper",
    "0.25 cup grated Parmesan cheese",
    "1.5 cups garlic croutons",
    "1 (2 ounce) can anchovy filets"
  ],
  "steps": [
    {
      "text": "Clean lettuce thoroughly and wrap in paper towels to absorb moisture. Refrigerate until crisp, at least 1 hour or more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl or jar combine oil, vinegar, Worcestershire sauce, salt, mustard, garlic and lemon juice. Whisk until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coddle egg by heating 3 cups of water to boiling. Drop in egg (still in shell) and let stand for 1 minute. Remove egg from water and let cool. Once cooled crack open and whisk egg into dressing. Whisk until thoroughly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash desired amount of anchovies and whisk them into the dressing. If desired set aside a few for garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To assemble, place torn lettuce leaves in a large bowl. Pour dressing over the top and toss lightly. Add the grated cheese, garlic croutons and freshly ground pepper, toss. Serve immediately!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
