  "ingredients": [
    "2 tablespoons olive oil",
    "0.5 cup diced sweet onion",
    "0.5 cup grated carrot",
    "1 teaspoon minced garlic",
    "0.5 pound ground chicken",
    "0.5 cup bulk pork sausage",
    "4.5 cups sliced cabbage",
    "0.5 cup water",
    "2 tablespoons tamari",
    "1 tablespoon honey",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon freshly ground black pepper",
    "0.25 teaspoon salt",
    "1 teaspoon sesame oil"
  ],
  "steps": [
    {
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot) and select Saute function. Add olive oil, followed by onion, carrot, and garlic; cook until onion is translucent, 5 to 7 minutes. Add ground chicken and ground sausage and cook until browned, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in cabbage, water, tamari, honey, ginger, pepper, and salt. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 10 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 15 minutes. Stir and add sesame oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
