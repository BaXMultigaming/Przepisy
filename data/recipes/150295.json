  "ingredients": [
    "2 tablespoons olive oil",
    "3 cloves roasted garlic, mashed into a paste",
    "0.125 teaspoon cumin",
    "1 dash cayenne pepper",
    "1 (15 ounce) can garbanzo beans, drained",
    "0.5 cup crumbled feta cheese",
    "0.5 teaspoon dried thyme"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour olive oil into an ovenproof pan. Stir in mashed garlic, cumin, and cayenne pepper until well combined. Add garbanzo beans and toss until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until garbanzo beans turn golden, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and sprinkle with feta cheese and thyme. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
