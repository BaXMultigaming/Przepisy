  "ingredients": [
    "2 tablespoons vegetable oil",
    "4 green onions, chopped",
    "1 cup cubed ham",
    "1 cup frozen mixed peas and carrots",
    "4 eggs, beaten",
    "4 cups cold cooked rice",
    "1 cup bean sprouts",
    "3 tablespoons soy sauce",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook and stir green onions in hot oil for 1 minute. Add ham, peas and carrots, and beaten eggs. Cook and stir until egg is completely cooked. Add cold rice and bean sprouts; cook and stir until rice is heated through. Remove from heat; season with soy sauce, salt, and pepper.",
