  "ingredients": [
    "1 cup butter flavored shortening",
    "1 egg",
    "1 cup confectioners' sugar",
    "1 teaspoon vanilla extract",
    "1 teaspoon cream of tartar",
    "0.5 teaspoon salt",
    "1 teaspoon baking soda",
    "2 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Mix together the shortening, egg, and confectioners' sugar. Stir in vanilla, cream of tartar, salt, baking soda and flour. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1 inch in diameter balls. Place on cookie sheet. Press down with a glass bottom dipped in sugar. ( I have also used cookie stamps dipped into sugar.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for about 10 minutes or just until edges are turning golden. Let cool slightly before removing from the cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
