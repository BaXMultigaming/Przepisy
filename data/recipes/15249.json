  "ingredients": [
    "2 cups packed brown sugar",
    "1 tablespoon butter",
    "0.5 cup milk",
    "1 teaspoon cornstarch",
    "1 tablespoon water",
    "1 teaspoon vanilla extract",
    "1 cup creamy peanut butter"
  ],
  "steps": [
    {
      "text": "Grease an 8x8 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan over medium heat, combine the brown sugar , butter and milk. cook until the mixture reaches the soft ball stage (234-240 degrees F, 112-115 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the cornstarch and water, add to the saucepan and mix well. Remove from heat and beat for 2 minutes. Stir in the vanilla and peanut butter until thoroughly blended. Spread batter evenly into the prepared pan. let cool, then cut into squares and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
