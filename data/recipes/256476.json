  "ingredients": [
    "1 baguette",
    "3 eggs",
    "2 tablespoons whole milk",
    "1.25 cups shredded fontina cheese",
    "0.33333334326744 cup chopped spinach",
    "2 strips cooked bacon, crumbled",
    "2 tablespoons diced sun-dried tomatoes",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a rimmed baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a V-shaped cut in the baguette, leaving ends intact. Lift out V-shaped wedge. Hollow out baguette gently to make a long, skinny bread bowl, being careful not to cut through the bottom or sides. Place baguette on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a bowl. Add milk; whisk until well blended. Stir in fontina cheese, spinach, bacon, sun-dried tomatoes, black pepper, and red pepper flakes. Pour mixture slowly into the prepared baguette, spreading evenly with a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until egg mixture is completely set and cheese is lightly browned, about 30 minutes. Cool for 5 minutes; cut into 1 1/2-inch slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
