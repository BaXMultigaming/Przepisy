  "ingredients": [
    "4 large sweet potatoes, peeled and cut into 1-inch cubes",
    "4 ounces Neufchatel cheese (such as Organic Valley®), softened",
    "0.5 teaspoon sea salt, or to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with cold water; bring to a boil. Reduce heat to medium-low and simmer potatoes until tender, about 20 minutes; drain and transfer potatoes to a large bowl.",
