  "ingredients": [
    "0.5 cup butter, softened",
    "0.75 cup mayonnaise",
    "1 bunch green onions, chopped",
    "3 cloves garlic, minced",
    "1.25 cups Parmesan cheese",
    "1.5 cups shredded Monterey Jack cheese",
    "1 (1 pound) loaf French bread, halved lengthwise"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together butter, mayonnaise, green onions, garlic, Parmesan cheese, and Monterey Jack cheese in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each French bread half into 4 pieces. Spread cheese mixture evenly over each bread piece.",
