  "ingredients": [
    "1 tablespoon butter",
    "1.5 cups raw cashews",
    "0.75 cup white sugar",
    "1 tablespoon crushed dried mint",
    "1 teaspoon cayenne pepper",
    "1 teaspoon ground cumin",
    "1 teaspoon ground coriander",
    "7 lemons, juiced",
    "0.5 cup white sugar, or more to taste",
    "0.5 (15 ounce) can unsweetened coconut milk",
    "1 (1 inch) piece fresh ginger, finely chopped, or more to taste",
    "6 cups watermelon, cut into bite-sized chunks",
    "3 cups cantaloupe, cut into bite-size pieces",
    "4 kiwi fruits, sliced",
    "1 apple, diced",
    "0.5 cup raisins",
    "0.5 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Cover a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir butter, cashews, 3/4 cup sugar, dried mint, cayenne pepper, cumin, and coriander in a skillet over medium-low heat until sugar has dissolved and cashews are browned, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cashews over the prepared baking sheet to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place lemon juice and 1/2 cup sugar in a blender. Blend until sugar is dissolved. Add coconut milk and ginger; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine watermelon, cantaloupe, kiwi, apple, raisins, and shredded coconut in a large bowl",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour coconut mixture over fruit and gently toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle cooled cashews over fruit salad.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
