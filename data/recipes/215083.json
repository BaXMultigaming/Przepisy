  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup sour cream",
    "1 teaspoon dried minced onion",
    "0.5 teaspoon onion salt",
    "0.5 teaspoon Worcestershire sauce",
    "0.25 teaspoon cayenne pepper",
    "2 (10 ounce) cans chunk white chicken, drained"
  ],
  "steps": [
    {
      "text": "Mix cream cheese, sour cream, minced onion, onion salt, Worcestershire sauce, and cayenne pepper in a bowl until well blended. Stir in chicken, breaking up any large pieces. Cover and refrigerate for at least 1 hour before serving.",
