  "ingredients": [
    "2.25 cups cake flour",
    "1.5 cups white sugar",
    "4.5 tablespoons unsweetened cocoa powder",
    "1.5 teaspoons baking soda",
    "0.75 teaspoon salt",
    "0.5 cup vegetable oil",
    "1.5 teaspoons distilled white vinegar",
    "1.5 teaspoons vanilla extract",
    "1.5 cups water",
    "0.25 cup butter",
    "0.33333298563957 cup unsweetened cocoa powder",
    "4 cups confectioners' sugar",
    "4 tablespoons milk",
    "1 teaspoon vanilla extract",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees (175 degrees C). Grease a 13x9-inch cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, white sugar, 4 ½ tablespoons cocoa, baking soda, and salt together in a bowl. Pour dry ingredients into the prepared pan. Scoop out 3 holes in the dry mixture with a spoon: add vegetable oil, vinegar, and 1 ½ teaspoons vanilla individually in each hole. Stir in cold water over top until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the frosting: Melt butter in a saucepan over medium heat: add cocoa. Off heat, stir in salt, milk, and 1 teaspoon vanilla. Mix in confectioners' sugar until your desired consistency. Spread over hot cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
