  "ingredients": [
    "0.25 cup all-purpose flour",
    "1 cup milk",
    "0.5 cup shortening",
    "0.75 cup white sugar",
    "0.5 cup butter, softened",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "In a small saucepan mix the flour and the milk and cook over low heat until it forms a smooth paste with no lumps. Place in refrigerator and let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With an electric mixer beat the shortening, butter or margarine and the sugar until light and fluffy. Beat in the cooled flour paste and mix until smooth. Stir in the vanilla. Use to frost any cooled cake. Makes enough to frost one 9x13 inch sheet cake or two 8 or 9 inch layer cakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
