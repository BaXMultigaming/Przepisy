  "ingredients": [
    "1 cup all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1 cup white sugar",
    "1 egg",
    "0.25 cup vegetable oil",
    "2 cups peeled and chopped apple",
    "0.5 cup chopped walnuts",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a small fluted tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FpI7qt_QIqYzXCqsCJa2lu6PfhE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18049-grandmas-fresh-apple-cake-VAT-step-01-a2c567f11a2c4bcc8b778df95f758fb7.jpg"
      ],
      "image": "assets/images/18049/step_01.webp"
    },
    {
      "text": "Sift flour, baking soda, cinnamon, and salt together in a bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-AcEwHg02BRg_B8BeZCC1dSUjFA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18049-grandmas-fresh-apple-cake-VAT-step-02-fa2e36ec31454a009974a80901953ee5.jpg"
      ],
      "image": "assets/images/18049/step_02.webp"
    },
    {
      "text": "Mix sugar, egg, and oil together in another bowl. Stir in the flour mixture just until combined; fold in apple, walnuts, and raisins. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rKmi6z-M3Oh7hksNJWv_jn3Jev8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18049-grandmas-fresh-apple-cake-VAT-step-03-f496d16940ad4d80a14dd6997f3858d9.jpg"
      ],
      "image": "assets/images/18049/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the cake comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kmAy9qCa3ar5jr2DA5AQoY6gA9o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18049-grandmas-fresh-apple-cake-VAT-step-04-5c238757b48344df9058066bbc8da115.jpg"
      ],
      "image": "assets/images/18049/step_04.webp"
    }
  ],
