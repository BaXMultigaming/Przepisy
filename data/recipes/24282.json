  "ingredients": [
    "0.5 cup butter, room temperature",
    "1 cup white sugar",
    "6 eggs, room temperature",
    "0.5 cup chopped candied citron",
    "1.5 cups pitted prunes, chopped",
    "0.5 cup raisins",
    "1 cup coarsely chopped pecans",
    "0.5 cup all-purpose flour",
    "1.5 cups fine dry bread crumbs",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon ground allspice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 2 quart souffle or casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter and sugar until light and fluffy. Beat in the eggs one at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl combine the citron, prunes, raisins and pecans. Stir in the flour and toss so that everything is coated with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To the butter mixture add the fruit and nut mixture along with the bread crumbs, cinnamon, nutmeg and allspice. Mix well and transfer to prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 50 to 55 minutes, or until well browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
