  "ingredients": [
    "1 (14.1 ounce) package pastry",
    "4 cups fresh blackberries",
    "1.5 cups white sugar",
    "0.5 cup all-purpose flour",
    "0.25 teaspoon salt",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line one pie crust in a 9-inch deep dish pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place blackberries in a large bowl. Stir sugar, flour, and salt together; sprinkle over berries, and toss to coat. Pour into the pie crust; dot with butter. Place other pie crust over the top, and secure to the bottom crust by pressing with a fork, or fluting with your fingers. Cut a design in the top crust with a sharp knife to vent steam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top crust is browned, 1 hour. Let cool to almost room temperature before serving for filling to set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
