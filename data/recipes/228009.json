  "ingredients": [
    "2 cups boiling water",
    "6 cranberry herb tea bags",
    "0.25 cup lemon juice",
    "9 packets Sweet'N Low granulated sugar substitute",
    "2.5 cups cold water",
    "1.5 cups orange juice"
  ],
  "steps": [
    {
      "text": "In a large pitcher, pour the boiling water over the tea bags. Steep 5 minutes; remove the tea bags and discard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the lemon juice and Sweet'N Low until the Sweet'N Low dissolves. Mix in the cold water and orange juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate until well chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour over ice in tall glasses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
