  "ingredients": [
    "cooking spray",
    "1 pound fresh strawberries, diced",
    "2 teaspoons sugar",
    "1 (8 ounce) package cream cheese, softened",
    "1 (15.25 ounce) package white cake mix",
    "1 cup butter, melted",
    "1 (21 ounce) can strawberry pie filling"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch dish with nonstick cooking spray. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle strawberries with sugar; set aside until strawberries release their juices, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, in a large bowl, whip cream cheese until light and fluffy. Add strawberries to whipped cream cheese and mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix and melted butter in a separate bowl and mix until mixture comes together as a crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour pie filling into the greased baking dish. Pour strawberry-cream cheese mixture on top. Evenly distribute crumble over pie filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Remove from oven and cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
