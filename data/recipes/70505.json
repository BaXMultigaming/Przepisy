  "ingredients": [
    "12 eggs",
    "1 medium onion, thinly sliced",
    "1.25 cups white vinegar",
    "1 cup white sugar",
    "0.75 cup water",
    "2 teaspoons salt",
    "1 teaspoon dried dill weed",
    "0.5 teaspoon mustard seed",
    "0.25 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Place eggs in a large pot and fill with enough water to cover. Bring to a boil, then cover and remove from heat. Let stand for 10 minutes. Cool under running water and remove shells. Place hard-cooked eggs in a large jar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onion, vinegar, sugar, and water in a medium saucepan. Stir in salt, dill, mustard seed, and garlic powder. Bring to a boil, then reduce heat to low and simmer for 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour vinegar mixture over eggs in the jar. Cover and refrigerate for at least 4 days. The eggs will be yellow!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
