  "ingredients": [
    "1 pound ground beef",
    "1 (10.75 ounce) can condensed tomato soup",
    "0.25 cup brown sugar",
    "0.125 teaspoon black pepper",
    "0.25 teaspoon salt",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "1 (12 ounce) package wide egg noodles",
    "10 slices American cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add egg noodles and cook until tender, about 7 minutes. Drain and return to the pan. Mix in the cream of chicken soup until noodles are coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble the ground beef into a large skillet over medium-high heat. Drain the grease, and stir in the tomato soup, brown sugar, pepper and salt. Spread half of the beef in the bottom of a greased 2 1/2 quart casserole dish. Arrange 5 slices of cheese over the beef. Top with half of the noodles, then repeat layers ending with cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 minutes in the preheated oven, until cheese is browned and sauce is bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
