  "ingredients": [
    "0.5 cup honey",
    "2 tablespoons butter",
    "0.5 teaspoon ground cinnamon",
    "4 cups cashews",
    "2.5 tablespoons white sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine honey, butter, and 1/2 teaspoon cinnamon in a small saucepan; bring to boil. Cook and stir until butter is melted, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cashews in a large bowl; pour honey mixture over cashews. Stir to thoroughly coat. Spread coated cashews on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cashews are glazed and very lightly browned, 10 to 15 minutes. Cool cashews for about 20 minutes; transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar and 1/2 teaspoon cinnamon in a bowl; sprinkle over cashews. Stir to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
