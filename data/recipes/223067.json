  "ingredients": [
    "2 cups all-purpose flour",
    "1.25 cups white sugar",
    "1 tablespoon light brown sugar",
    "0.75 teaspoon baking soda",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1.3333333730698 cups mashed bananas",
    "0.66666668653488 cup canola oil",
    "0.66666668653488 cup crushed pineapple, drained",
    "0.66666668653488 cup flaked coconut",
    "0.25 cup chopped walnuts",
    "0.25 cup chopped macadamia nuts",
    "2 eggs, well beaten",
    "4 teaspoons applesauce",
    "1.5 teaspoons vanilla extract",
    "1 teaspoon lemon extract",
    "0.5 teaspoon coconut extract",
    "2 tablespoons butter, at room temperature",
    "0.25 cup white sugar",
    "0.25 cup chopped walnuts",
    "0.25 cup chopped macadamia nuts",
    "1 teaspoon milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, 1 1/4 cup white sugar, brown sugar, baking soda, cinnamon, baking powder, and salt in a large bowl. Stir mashed banana, canola oil, pineapple, flaked coconut, 1/4 cup walnuts, 1/4 cup macadamia nuts, eggs, applesauce, vanilla extract, lemon extract, and coconut extract into flour mixture until blended. Pour batter into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the loaf comes out clean, 70 to 80 minutes. Cool bread in the pan for 10 minutes; remove and transfer to a wire rack to cool, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter, 1/4 cup white sugar, 1/4 cup walnuts, 1/4 cup macadamia nuts, and milk together in a bowl. Spread on top of bread once it has been transferred to the wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
