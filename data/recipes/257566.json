  "ingredients": [
    "0.5 cup all-purpose flour",
    "0.25 cup white sugar",
    "2 tablespoons white sugar",
    "3 eggs",
    "3 tablespoons butter, melted",
    "0.25 cup milk",
    "2 tablespoons milk",
    "1 squeeze lemon juice",
    "2 cups fresh raspberries",
    "2 tablespoons confectioners' sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour and ¼ cup plus 2 tablespoons sugar together in a bowl; whisk in eggs and butter. Whisk in ¼ cup plus 2 tablespoons milk and lemon juice until batter is smooth, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into a 9-inch oval or round baking dish; scatter raspberries on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffy and golden, about 30 minutes. Cool, about 15 minutes. Dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
