  "ingredients": [
    "1 (9 inch) unbaked pastry shell",
    "2 cups fat-free half-and-half",
    "4 large eggs",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 cup shredded Monterey Jack cheese",
    "0.5 cup frozen corn, thawed",
    "4 slices cooked bacon, crumbled",
    "1 (4 ounce) can diced green chile peppers, drained",
    "1 tablespoon chopped fresh parsley, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pastry shell in a 9-inch pie pan or quiche pan. Prick the bottom and sides with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 8 minutes. Remove and set aside. Leave the oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk half-and-half, eggs, salt, and pepper together in a medium bowl until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle cheese, corn, chile peppers, and crumbled bacon into the pie shell. Carefully pour egg mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven until filling is just about set but a little wiggly in the center, about 30 minutes. Remove from the oven and cool for 10 minutes. Garnish with parsley and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
