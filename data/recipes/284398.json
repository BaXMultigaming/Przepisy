  "ingredients": [
    "1 tablespoon sake",
    "1 tablespoon mirin (Japanese sweet wine)",
    "1 teaspoon grated ginger",
    "1 teaspoon grated garlic",
    "1 teaspoon soy sauce",
    "ground black pepper to taste",
    "1.5 pounds boneless, skinless chicken thighs",
    "0.5 cup mayonnaise",
    "0.25 cup white miso paste",
    "0.125 cup grated ginger",
    "0.125 cup grated garlic",
    "0.125 cup soy sauce",
    "1 teaspoon honey",
    "1 cup shredded cabbage",
    "0.75 cup shredded carrots",
    "0.5 cup chopped fresh cilantro",
    "0.5 cup cider vinegar",
    "0.25 cup finely chopped green onions",
    "2 tablespoons toasted sesame oil",
    "2 tablespoons sesame seeds",
    "salt and ground black pepper to taste",
    "1 cup peanut oil for frying, or as needed",
    "0.5 cup cornstarch",
    "4 potato buns, split and toasted",
    "0.5 teaspoon shichimi togarashi (Japanese seven spice), or to taste"
  ],
  "steps": [
    {
      "text": "Combine sake, mirin, ginger, garlic, soy sauce, and pepper for marinade in a glass or ceramic bowl and mix well. Add chicken and marinate in the refrigerator for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While chicken marinates, combine mayonnaise, miso, ginger, garlic, soy sauce, and honey for the miso mayonnaise in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cabbage, carrots, cilantro, vinegar, green onions, sesame oil, sesame seeds, salt, and pepper for the slaw in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C). Remove chicken from marinade and dredge in cornstarch, knocking off any excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry chicken in the hot oil until no longer pink in the centers and golden brown on the outsides, 4 to 5 minutes on each side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat toasted buns with miso mayonnaise. Add fried chicken, top with slaw, and sprinkle each with togarashi. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
