  "title": "Easy Pecan Zucchini Bread",
  "description": "This nutty zucchini bread loaf is flavored with lemon and cinnamon, and has plenty of tasty pecans for added crunch.",
  "authors": [
    "Phyllis Province"
  ],
  "date_published": "2000-04-14T11:46:57-04:00",
