  "ingredients": [
    "2 cups all-purpose flour",
    "0.75 teaspoon baking soda",
    "0.75 teaspoon baking powder",
    "0.75 teaspoon salt",
    "0.75 teaspoon ground cinnamon",
    "1 cup white sugar",
    "3 eggs",
    "0.66666698455811 cup vegetable oil",
    "1.3333300352097 cups grated zucchini",
    "0.66666698455811 cup chopped pecans",
    "0.75 teaspoon lemon extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, baking powder, salt, and cinnamon together in a medium bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and eggs together in a large bowl until light and fluffy, about 10 minutes. Gradually add oil; beat 2 minutes more. Mix in zucchini, pecans, and lemon extract. Fold in flour mixture until just combined; do not overmix. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
