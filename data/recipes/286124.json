  "ingredients": [
    "1 small head savoy cabbage",
    "3 small carrots, peeled and grated",
    "1 small red onion, finely chopped",
    "0.33333334326744 cup mayonnaise",
    "2 tablespoons mango-flavored balsamic vinegar",
    "2 teaspoons white sugar",
    "0.5 teaspoon salt",
    "freshly ground white pepper to taste"
  ],
  "steps": [
    {
      "text": "Quarter and core cabbage, reserving outer leaves for presentation. Roughly chop cabbage and rinse in a salad spinner.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cabbage to a large bowl. Add carrots and red onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together mayonnaise, balsamic vinegar, sugar, salt, and white pepper. Pour over the slaw mixture and mix until well combined. Cover and refrigerate until chilled, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange reserved cabbage leaves on a platter with chilled slaw on top.",
