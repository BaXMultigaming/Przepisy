  "ingredients": [
    "0.66666668653488 cup olive oil",
    "0.5 cup chopped fresh cilantro",
    "0.25 cup chopped fresh parsley",
    "2 limes, juiced",
    "1 teaspoon garlic salt",
    "0.5 teaspoon Cajun seasoning (such as Slap Ya Mama®)",
    "2 large skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Combine olive oil, cilantro, parsley, lime juice, garlic salt, and Cajun seasoning in a large bowl. Add chicken breasts and toss to coat. Marinate in the refrigerate for at least 2 hours, preferably overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill chicken on the preheated grill until no longer pink in the center and the juices run clear, 10 to 15 minutes. Baste chicken with marinade as it cooks. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
