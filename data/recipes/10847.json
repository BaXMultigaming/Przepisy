  "ingredients": [
    "0.75 cup butter, softened",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "1 cup graham cracker crumbs",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups semisweet chocolate chips",
    "0.75 cup candy-coated milk chocolate pieces (such as M&M's®), or as desired",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together butter and sugars in a large bowl with an electric mixer until light and fluffy. Blend in egg and vanilla. Combine flour, graham cracker crumbs, baking soda, and salt in a separate bowl; add to egg mixture and mix well. Stir in chocolate chips, candy-coated chocolate pieces, and nuts until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by heaping tablespoonfuls 3 inches apart onto the prepared cookie sheets. Press 2 to 3 candy-coated chocolate pieces on top of each cookie if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 8 to 10 minutes. Allow to cool on cookie sheets for about 3 minutes before removing to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
