  "title": "Southern Potato Salad",
  "description": "This Southern potato salad with warm potatoes, hard boiled eggs, crunchy celery, mayo, sweet pickle, and mustard is creamy, tangy, and delicious.",
  "authors": [
    "S0NGLADY"
  ],
  "date_published": "2000-02-25T05:30:26-05:00",
