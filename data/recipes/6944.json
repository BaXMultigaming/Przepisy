  "ingredients": [
    "4 ounces cream cheese, softened",
    "0.25 cup margarine",
    "1.25 cups white sugar",
    "2 eggs",
    "1 cup canned pumpkin",
    "1.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 9x5x3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put softened cheese, butter, and sugar in mixing bowl. Cream together well. Beat in eggs one at a time until blended. Mix in pumpkin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl combine flour, soda, baking powder, salt, cinnamon, cloves, and walnuts. Stir until thoroughly mixed. Pour all at once over batter. Stir just enough to moisten. Turn into greased 9x5x3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 60-70 minutes until inserted toothpick comes out clean. Cool 10 minutes in pan. Remove to rack to finish cooling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
