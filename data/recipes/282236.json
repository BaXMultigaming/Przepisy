  "ingredients": [
    "1 (12 ounce) package Impossible Burger",
    "1 (16 ounce) can vegetarian refried beans",
    "1 cup shredded Mexican cheese blend",
    "0.5 cup salsa",
    "1 teaspoon chili powder",
    "1 teaspoon ground cumin",
    "0.5 teaspoon dried oregano",
    "8 (10 inch) flour tortillas",
    "2 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir Impossible Burger in a large nonstick skillet over medium-high heat until browned and crumbly, 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix crumbles, refried beans, cheese, salsa, chili powder, cumin, and oregano together until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay tortillas on a flat work surface and place about 1/3 cup of filling in the center of each tortilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold tortilla sides up over filling and roll up like burritos.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chimichangas on a foil-lined baking sheet and brush with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until golden and crisp, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
