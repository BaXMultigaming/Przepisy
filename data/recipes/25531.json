  "ingredients": [
    "1 pound ground beef",
    "1 pound ground pork sausage",
    "1 pound processed cheese food",
    "1 teaspoon Worcestershire sauce",
    "1 tablespoon ketchup",
    "1 (1 pound) loaf cocktail rye bread, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C). Line a rimmed baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jLXHAjhFfcRyyc5sTbfypavlkSw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RyeBreadPartyPizzas_25531_ingredients_0283-1e84f1838b304bf3b14f23c404681efa.jpg"
      ],
      "image": "assets/images/25531/step_01.webp"
    },
    {
      "text": "Cook beef and sausage in a large, deep skillet over medium-high heat until browned and crumbly, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8BYm4I_Ch5FRbZKeFtc0Dxb1Owk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RyeBreadPartyPizzas_25531_step2_0294-6a66539ede95408bbea48286afbf8bd6.jpg"
      ],
      "image": "assets/images/25531/step_02.webp"
    },
    {
      "text": "Meanwhile, microwave processed cheese food in a large microwave-safe bowl on high until melted, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1fI9wxlwVkmciJe4c6JX-jB68Sw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RyeBreadPartyPizzas_25531_step3_0297-587d0e0413544ccd8a65082b802d16fa.jpg"
      ],
      "image": "assets/images/25531/step_03.webp"
    },
    {
      "text": "Stir Worcestershire sauce and ketchup into melted cheese, then stir in cooked meat until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q-c9DDHhtP6B0jvCJa7kVdVYMFI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RyeBreadPartyPizzas_25531_step4_0300-c350bf4cbd914b52a4e716ea10fa2c76.jpg"
      ],
      "image": "assets/images/25531/step_04.webp"
    },
    {
      "text": "Spoon about 2 tablespoons meat and cheese mixture onto each bread slice. Arrange bread in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rZBIjcJP2I23yJgL0pteNsyWfZU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RyeBreadPartyPizzas_25531_step5_0301-a30e22b677144333bce08f1bb1b11ef5.jpg"
      ],
      "image": "assets/images/25531/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven, in batches if necessary, until lightly browned and crisp, 10 to 15 minutes. Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lTTbMKBezOrNfTztsECg92BQ32k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RyeBreadPartyPizzas_25531_step6_0302-0069b282435a4106acb3321928861b97.jpg"
      ],
      "image": "assets/images/25531/step_06.webp"
    }
