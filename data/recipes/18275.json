  "ingredients": [
    "1 pound red potatoes",
    "1 pound Yukon Gold (yellow) potatoes",
    "12 ounces baby carrots",
    "4 cloves garlic",
    "1 fresh jalapeno pepper, sliced",
    "1 (10 ounce) package frozen white corn, thawed",
    "0.25 cup butter",
    "0.5 cup shredded Cheddar cheese",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes, carrots, garlic, and jalapeño in a large pot and cover with water; bring to a boil over high heat. Cook until potatoes are tender, 15 to 20 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add corn and butter; mash until butter melts and potatoes reach desired texture. Stir in cheese, salt, and black pepper. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
