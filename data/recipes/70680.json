  "ingredients": [
    "1 pound spicy pork sausage",
    "1 (16 ounce) jar Alfredo sauce",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "0.25 teaspoon ground black pepper",
    "2 cups shredded Cheddar cheese",
    "1 (15 ounce) container ricotta cheese",
    "0.5 cup grated Parmesan cheese",
    "1 egg, lightly beaten",
    "0.75 (16 ounce) package no-boil lasagna noodles",
    "1 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sausage in a skillet over medium heat until evenly browned; drain grease. Add Alfredo sauce and spinach; season with black pepper. Cook until sauce and spinach are heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Cheddar cheese, ricotta cheese, Parmesan cheese, and egg in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer ⅓ sausage mixture, ⅓ noodles, and ⅓ Cheddar cheese mixture in a 9x13-inch baking dish; repeat layers twice. Top with mozzarella cheese. Cover dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes . Let stand before serving for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
