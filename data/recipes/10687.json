  "ingredients": [
    "1.5 cups white sugar",
    "0.5 cup butter, softened",
    "0.5 cup shortening",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "2.75 cups all-purpose flour",
    "2 teaspoons cream of tartar",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "2 tablespoons white sugar",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vOqWvdhB2aBzAXd6UJa8vkcq8V8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10687-Mrs-Siggs-Snickerdoodles-DDMFS-Step-01-1086-bee5d6bdad3746a3bb49d3007f0f894c.jpg"
      ],
      "image": "assets/images/10687/step_01.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make cookies: Beat sugar, butter, shortening, eggs, and vanilla in a large bowl until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IfOjT1yYCq1Gf_BogELtnDa4CuA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10687-Mrs-Siggs-Snickerdoodles-DDMFS-Step-01b-1090-c406e3da38ab46a1b9ee9592a1b7ec5d.jpg"
      ],
      "image": "assets/images/10687/step_03.webp"
    },
    {
      "text": "Whisk flour, cream of tartar, baking soda, and salt together in a separate bowl. Gradually mix dry ingredients mixture into the wet ingredients just until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lBmShQp-LF6-IK6KNS9BQvyhJaE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10687-Mrs-Siggs-Snickerdoodles-DDMFS-Step-03-1094-b8e6f1df8dcd4918bf5f263965688f10.jpg"
      ],
      "image": "assets/images/10687/step_04.webp"
    },
    {
      "text": "Shape dough into walnut-sized balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lfJJb6-Jo_yGtUbiTxLf7jiX3kc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10687-Mrs-Siggs-Snickerdoodles-DDMFS-Step-03b-1096-1c92a65abf904e738452a43bca04b9e3.jpg"
      ],
      "image": "assets/images/10687/step_05.webp"
    },
    {
      "text": "Make cinnamon-sugar: Combine sugar and cinnamon in a small bowl or zip-top plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7zoqRKFvH0O6HjJdu1Ky3ZA6FX8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10687-Mrs-Siggs-Snickerdoodles-DDMFS-Step-04-1097-f958ef52fcf84a20a58f7d41ac35e84e.jpg"
      ],
      "image": "assets/images/10687/step_06.webp"
    },
    {
      "text": "Place dough balls in cinnamon-sugar and roll or shake until coated. Place 2 inches apart on ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8QlqNrT49uPiJGW5QRSM79Cu3R8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10687-Mrs-Siggs-Snickerdoodles-DDMFS-Step-05-1099-42f9fdd31adb4f5ba5d7c8a953db45ec.jpg"
      ],
      "image": "assets/images/10687/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven until set but not too hard, 8 to 10 minutes, switching racks halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UXViudVcFBNbdeVGGx3ehNMNWk8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10687-Mrs-Siggs-Snickerdoodles-DDMFS-Step-06-1130-88ec267dc63245bb81f3180236273476.jpg"
      ],
      "image": "assets/images/10687/step_08.webp"
    },
    {
      "text": "Remove from the oven and immediately transfer to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qPFm7dTXn6SU0tyyR4HS7K2UkjY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10687-Mrs-Siggs-Snickerdoodles-DDMFS-Step-07-1131-3bd0fc5890834fd18a9e1283a1d7e138.jpg"
      ],
      "image": "assets/images/10687/step_09.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BeI0xeb5qBxRZ4MHHlVxbmRCXYw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10687-Mrs-Siggs-Snickerdoodles-DDMFS-4x3-1145-27f69abf2dc64d27a402175e6baa2f2f.jpg"
      ],
      "image": "assets/images/10687/step_10.webp"
    }
