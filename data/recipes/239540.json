  "ingredients": [
    "1 teaspoon dried tarragon",
    "2 tablespoons white wine vinegar",
    "1 cup mayonnaise",
    "0.25 cup diced dill pickles",
    "0.25 cup diced bread-and-butter pickles",
    "1 tablespoon chopped capers",
    "1 tablespoon minced green onions",
    "1 tablespoon chopped fresh parsley",
    "2 teaspoons anchovy paste",
    "1 teaspoon Dijon mustard",
    "1 teaspoon paprika",
    "0.25 teaspoon freshly ground black pepper",
    "1 pinch cayenne pepper, or more to taste",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Crumble tarragon into a saucepan over medium heat; add vinegar, bring to a simmer, and cook until vinegar is almost completely evaporated, 1 to 2 minutes. Transfer to a bowl to cool, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, dill pickles, bread-and-butter pickles, capers, green onions, parsley, anchovy paste, Dijon mustard, paprika, black pepper, cayenne pepper, and salt into tarragon mixture. Cover with plastic wrap and refrigerate until flavors blend, 8 hours to overnight.",
