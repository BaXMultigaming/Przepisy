  "ingredients": [
    "3 slices bacon",
    "1 stick unsalted butter, softened",
    "1 tablespoon dry onion soup mix"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned and crisp, 6 to 8 minutes. Drain bacon slices on paper towels. Allow to cool, then crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place softened butter in a small bowl and mash with a fork. Stir in the bacon and dry onion soup mix until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Store in an airtight container or transfer to a large piece of plastic wrap, form into a log, and wrap tightly, twisting the edges to seal. Keep refrigerated until serving.",
      "section": null,
