  "title": "Chef John&#39;s Quick Cassoulet",
  "description": "This meaty cassoulet recipe makes a quick and tasty version of the French classic with chicken thighs, smoked sausage, canned white beans, and crispy bacon.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-02-21T18:44:04-05:00",
  "date_modified": "2026-06-03T10:35:17-04:00",
  "prep_time": "PT20M",
