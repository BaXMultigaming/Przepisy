  ],
  "cuisines": [
    "French Inspired",
    "French"
  ],
  "regions": [
    "French Inspired",
    "French"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "4 ounces bacon, cut into 1 inch pieces",
    "8 ounces smoked sausage, sliced",
    "12 ounces boneless, skinless chicken thighs, cubed",
    "1 onion, diced",
    "salt and pepper to taste",
    "2 cups chicken broth, plus more if needed",
    "2 (15 ounce) cans cannellini beans, drained and rinsed",
    "1.5 teaspoons minced fresh rosemary",
    "1.5 teaspoons minced fresh thyme",
    "cayenne pepper to taste",
    "0.25 cup melted butter",
    "1 cup bread crumbs",
    "0.5 cup finely grated Parmigiano-Reggiano"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a3iRTgT80mq8PYqru9SRtxFJU2Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220322-chef-johns-quick-cassoulet-DDMFS-step-01-dea01c25558548bfa827720b7af175b6.jpg"
      ],
      "image": "assets/images/220322/step_01.webp"
    },
    {
      "text": "Add bacon to a large, cold oven-ready skillet. Place over medium heat and cook for 10 to 12 minutes, until almost crisp. Transfer to a bowl, reserving the grease in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hco0RwaMXhTiPqcB9LNrC2cfqa4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220322-chef-johns-quick-cassoulet-DDMFS-step-02-96461b796db14b98aa1ab327bca16d1f.jpg"
      ],
      "image": "assets/images/220322/step_02.webp"
    },
    {
      "text": "Stir in sausage slices; cook 3-4 minutes. Add chicken thigh pieces; cook and stir for 5 minutes, until browned. Remove meat to the plate with bacon. Discard all the oil, but don't wipe out the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/psYYJtZjjFRSTOIHQPPPs7p5YFY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220322-chef-johns-quick-cassoulet-DDMFS-step-03-1764271630934ebd92edc8318a4364f7.jpg"
      ],
      "image": "assets/images/220322/step_03.webp"
    },
    {
      "text": "Add chopped onion and turn the heat to medium-low; cook and stir for 5 minutes, until the onions are translucent. Add 1 cup of chicken stock.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e10Ytbv-O6S5HhnhFYvUjOyPVlo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220322-chef-johns-quick-cassoulet-DDMFS-step-04-65a95317670d4bab87000bcf0d6e2525.jpg"
      ],
      "image": "assets/images/220322/step_04.webp"
    },
    {
      "text": "Mash about 1/4 of the beans in a small bowl, stir all the beans into the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kYIBdnR1dRoflJXTrJ_xVATW5uM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220322-chef-johns-quick-cassoulet-DDMFS-step-05-7dadd854771c4c37a51ecdc5bfe716f3.jpg"
      ],
      "image": "assets/images/220322/step_05.webp"
    },
    {
      "text": "Stir in cayenne, rosemary and thyme. Add reserved meat back to the pan. Stir in remaining cup of stock or more if needed to cover. Return to simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/K9HntGjnxZ34OplJG24DeWwDWHE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220322-chef-johns-quick-cassoulet-DDMFS-step-06-faf11cba963b45f0883b7d8862efce60.jpg"
      ],
      "image": "assets/images/220322/step_06.webp"
    },
    {
      "text": "Mix bread crumbs, Parmigiano-Reggiano, and melted butter together in a small bowl. Preheat the oven's broiler and set the oven rack about 7 inches from the heat source.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VpKV8NL8YXwbZV3nuHCUaT9x85A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220322-chef-johns-quick-cassoulet-DDMFS-step-07-420df8422ea449a2bb61507f28e16c96.jpg"
      ],
      "image": "assets/images/220322/step_07.webp"
    },
    {
      "text": "Sprinkle the cassoulet with half the bread crumb mixture. Place under the broiler and cook about 5 minutes, until browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YneLE-KneHNnUxlCwJt2qI-uggw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220322-chef-johns-quick-cassoulet-DDMFS-step-08-4dc88b3c1204432788dc5961e8c2407c.jpg"
      ],
      "image": "assets/images/220322/step_08.webp"
    },
    {
      "text": "Remove the pan and push bread crumbs down into the cassoulet. Top with remaining bread crumb mixture. Return to oven and continue broiling 5 more minutes, until browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/izkpvgPcf6VqSyoGGNwpHKEY5Fo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220322-chef-johns-quick-cassoulet-DDMFS-step-09-44d2c4f135e047c1b3874ee1d31daa72.jpg"
      ],
      "image": "assets/images/220322/step_09.webp"
    },
    {
      "text": "Turn off the broiler and leave in the oven for 15 minutes. Remove and let sit for 5 minutes. Enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QN00XSX132ldVxs7CNvF8C1zxXk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/220322-chef-johns-quick-cassoulet-DDMFS-Beauty-4x3-a7e3424f3549452ea36bd3f1fdc314cd.jpg"
      ],
      "image": "assets/images/220322/step_10.webp"
    }
  ],
