  "ingredients": [
    "1 (15.25 ounce) package yellow cake mix, divided",
    "0.5 cup unsalted butter, melted",
    "1 large egg, beaten",
    "1 (15 ounce) can pumpkin puree",
    "0.5 cup white sugar",
    "3 large eggs, beaten",
    "0.25 cup packed brown sugar",
    "1.5 teaspoons ground cinnamon",
    "0.5 cup white sugar",
    "3 tablespoons unsalted butter, softened",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reserve 1 cup of the cake mix in a medium bowl. Combine remaining cake mix, butter, and egg in a large bowl until well combined; press into the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pumpkin, white sugar, eggs, brown sugar, and cinnamon together in the large bowl until well combined. Pour over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar and butter into reserved cake mix until crumbly; sprinkle over pumpkin layer. Scatter walnuts over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 40 to 45 minutes. Cool completely in the pan on a wire rack before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
