  "ingredients": [
    "2 cups peanut oil, or as needed",
    "0.75 cup flour",
    "0.66666668653488 cup cold flat beer",
    "0.5 cup cornstarch",
    "2 egg whites",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground white pepper",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon celery salt",
    "0.25 teaspoon black pepper",
    "3 pounds asparagus, ends trimmed",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Heat peanut oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, beer, cornstarch, egg whites, baking powder, white pepper, baking soda, celery salt, and black pepper together in a bowl with a wire whisk to form the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip asparagus spears individually in the batter and place carefully in the hot oil. Fry until golden brown, about 2 minutes. Dust fried asparagus with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
