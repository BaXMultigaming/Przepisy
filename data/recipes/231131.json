  "ingredients": [
    "1 cup soy sauce",
    "0.75 cup dark brown sugar",
    "2 tablespoons minced garlic",
    "1 tablespoon rice wine vinegar",
    "1 tablespoon chile-garlic sauce (such as Sriracha®)",
    "1.5 teaspoons ground black pepper",
    "1 teaspoon grated fresh ginger",
    "1 teaspoon Asian (toasted) sesame oil",
    "1 tablespoon cornstarch",
    "1 tablespoon water"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AMntPbIiR21Rh6ayW9Y9YLqHWXM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231131-korean-bbq-sauce-DDMFS-4x3-step-01-2b7de99189664ec1971b1d333b187a37.jpg"
      ],
      "image": "assets/images/231131/step_01.webp"
    },
    {
      "text": "Stir soy sauce, brown sugar, garlic, rice wine vinegar, gochujang paste, black pepper or gochugara chili powder, ginger, and sesame oil together in a saucepan; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5hKyi5H279D6BgCGZwBfTcs-oGo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231131-korean-bbq-sauce-DDMFS-4x3-step-02-ed13de8662cb4b56b6649215b271a41d.jpg"
      ],
      "image": "assets/images/231131/step_02.webp"
    },
    {
      "text": "Whisk cornstarch and water together in a small bowl until cornstarch dissolves. Whisk cornstarch mixture into the boiling soy sauce mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ohCWlVw_H2XDVMcYTqcHP_0PmyM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-231131-korean-bbq-sauce-DDMFS-4x3-step-03-9ccbda64c98d4393b38fc56e405edfb5.jpg"
      ],
      "image": "assets/images/231131/step_03.webp"
    },
    {
      "text": "Reduce heat to medium-low and cook, stirring constantly, until sauce is thickened, about 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
