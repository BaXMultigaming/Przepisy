  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "1 teaspoon baking soda",
    "2 eggs, beaten",
    "1 (15 ounce) can crushed pineapple, with juice",
    "1 teaspoon vanilla extract",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, sugar, and baking soda. Stir in eggs, pineapple, and vanilla, mixing until blended. Fold in pecans. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 35 minutes. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
