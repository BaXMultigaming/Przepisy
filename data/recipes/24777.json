  "ingredients": [
    "0.5 teaspoon olive oil",
    "1 cup all-purpose flour",
    "salt and pepper to taste",
    "1 pound chicken giblets (hearts and gizzards)",
    "1 medium onion, chopped",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Rub oil on the inside of a pressure cooker and turn it on to heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix flour, salt, and pepper together in a bowl. Dredge giblets in flour mixture to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place giblets and onion into the hot pressure cooker. With the lid open, cook until lightly sautéed, shaking and stirring often, about 5 minutes. Add water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and lock the pressure cooker. Bring to 15 pounds of pressure and cook until giblets are no longer pink inside, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
