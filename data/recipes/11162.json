  "ingredients": [
    "0.5 cup butter, melted",
    "1 pound confectioners' sugar",
    "1.5 cups peanut butter",
    "1 teaspoon vanilla extract",
    "2 cups semisweet chocolate chips",
    "1 tablespoon shortening"
  ],
  "steps": [
    {
      "text": "Combine the melted butter or margarine, confectioners' sugar, peanut butter and the vanilla together and mix well. Refrigerate for 1 hour or until firm. Roll into 1 inch balls and place on waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the top half of a double boiler melt the chocolate chips and shortening, stirring constantly. Use a toothpick to dip balls into the melted chocolate, leaving a small uncovered area so balls resemble buckeyes. Place balls on waxed paper. Use fingers to blend in toothpick holes. Refrigerate until chocolate is firm. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
