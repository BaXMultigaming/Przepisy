  "ingredients": [
    "4 (12 ounce) cans beer",
    "1 large onion, thinly sliced",
    "10 bratwurst",
    "2 teaspoons red pepper flakes",
    "1 teaspoon garlic powder",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E0xb0aF4ENZADu1dTGMq5uz-El8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/149975_BeerBrats_mfs_step1_00188-f66b54ce014f4d49b6edf14db494ab7e.jpg"
      ],
      "image": "assets/images/149975/step_01.webp"
    },
    {
      "text": "Combine beer and onion slices in a large pot; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Fi5XSDU5CrCyG5X56vNJ9jSxoms=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/149975_BeerBrats_mfs_step2_00191-792ee9a2ac63417eb3d594e47d5f1fe8.jpg"
      ],
      "image": "assets/images/149975/step_02.webp"
    },
    {
      "text": "Add bratwurst, pepper flakes, garlic powder, salt, and pepper to beer and onion mixture. Reduce heat to medium and cook for 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hzx9iUjDI4QTBnKiQl5ToaKSnR8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/149975_BeerBrats_mfs_step3_00192-0f10f5ac5efb4385b96ca0eb9dfbeb9f.jpg"
      ],
      "image": "assets/images/149975/step_03.webp"
    },
    {
      "text": "Meanwhile, preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer bratwurst to a plate. Reduce heat to low and let onions simmer until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bratwurst on the preheated grill, turning occasionally to get char marks, until no longer pink in the middle, 5 to 10 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve bratwurst with onions.",
      "section": null,
      "name": null,
      "url": null,
