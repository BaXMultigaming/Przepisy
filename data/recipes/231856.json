  "ingredients": [
    "4 slices bacon",
    "cooking spray",
    "4.5 cups whole kernel corn",
    "0.5 red bell pepper, chopped",
    "0.5 cup half-and-half",
    "0.25 cup unsalted butter, melted",
    "1 teaspoon white sugar",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 (8 ounce) container chive and onion cream cheese"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain the bacon slices on paper towels; crumble when cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat the inside of a 4-quart slow cooker with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine corn, red bell pepper, half-and-half, butter, sugar, salt, black pepper, and half the crumbled bacon in the slow cooker; stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 2 to 2 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream cheese into corn mixture; cook until cheese melts, about 10 more minutes. Stir well and top with remaining bacon before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
