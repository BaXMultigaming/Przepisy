  "ingredients": [
    "3 tablespoons blanched almonds",
    "0.33333334326744 pound dried spaghetti",
    "2 tablespoons extra-virgin olive oil",
    "2 zucchini, grated",
    "1 clove garlic, crushed",
    "salt and ground black pepper to taste",
    "2 teaspoons butter",
    "2 tablespoons chopped fresh parsley",
    "1 lemon, zested",
    "1 squeeze lemon juice"
  ],
  "steps": [
    {
      "text": "Heat a small pan over medium heat. Add almonds and toast, about 2 minutes. Let cool slightly and roughly chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While pasta cooks, add olive oil to a saucepan over medium heat. Add zucchini, garlic, salt, and pepper and fry until tender, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reserve 1/4 cup of the pasta cooking water and drain. Add cooked spaghetti to the saucepan with the zucchini. Add butter, parsley, lemon zest, lemon juice, and toasted almonds and stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
