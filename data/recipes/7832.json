  "ingredients": [
    "1 (9 inch) prepared graham cracker crust",
    "16 ounces cream cheese",
    "2 eggs",
    "0.75 cup white sugar",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon grated lemon zest"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
