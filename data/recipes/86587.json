  "ingredients": [
    "2 large eggs",
    "1 teaspoon mayonnaise or salad dressing",
    "1 teaspoon water",
    "1 teaspoon margarine or butter",
    "1 pinch salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Whisk together eggs, mayonnaise, and water in a cup or small bowl using a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt margarine in a skillet over low heat. Pour in eggs and constantly stir as they cook. Remove eggs to a plate when they are set but still moist. Do not overcook. Season with salt and pepper to taste once eggs are on the plate.",
