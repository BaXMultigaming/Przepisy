  "ingredients": [
    "0.75 cup shortening",
    "1 cup white sugar",
    "2 eggs",
    "2 tablespoons milk",
    "1 teaspoon vanilla extract",
    "2.25 cups sifted all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup chopped pecans",
    "1 cup dates, pitted and chopped",
    "0.33333298563957 cup maraschino cherries, chopped",
    "2.5 cups crushed cornflakes cereal",
    "10 maraschino cherries, quartered"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat oven to 375 degrees F (190 degrees C). Lightly grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Wn0Txy-GqvBKdvS8rQC2OrjoUlg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11223-cherry-winks-VAT-step-01-710b535c6e74423ea555792cb138d4be.jpg"
      ],
      "image": "assets/images/11223/step_01.webp"
    },
    {
      "text": "Cream the shortening with the sugar. Blend in the eggs, milk and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s9bwdE4nWwm2mryF1907t5bzPgs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11223-cherry-winks-VAT-step-02-daed27f534364abdb2736bcc773b8453.jpg"
      ],
      "image": "assets/images/11223/step_02.webp"
    },
    {
      "text": "Sift together the flour, baking powder, baking soda and salt. Add the flour mixture to the creamed mixture and mix well. Stir in the chopped pecans, chopped dates and 1/3 cup maraschino cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TCBNfu0rXc61ytTMa7EMCZjMXvA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11223-cherry-winks-VAT-step-03-7fffd07bb04a44ee8a3eb916209f2572.jpg"
      ],
      "image": "assets/images/11223/step_03.webp"
    },
    {
      "text": "Shape teaspoonful sized chunks of dough into balls. Roll each ball in the crushed corn flakes. Place balls on the prepared baking sheets and top each cookie with 1/4 maraschino cherry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WTOLJGj48uoNprzDVkd1tEfhaIM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11223-cherry-winks-VAT-step-04-fb6e709526e848418194624f140a0f6a.jpg"
      ],
      "image": "assets/images/11223/step_04.webp"
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 10 to 12 minutes. Let cool completely before storing in airtight containers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PKfsliM5L0khFeaqX77bbqx7ZG8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11223-cherry-winks-VAT-step-05-5fca3d0cc86b4537a46fd988e67e3152.jpg"
      ],
      "image": "assets/images/11223/step_05.webp"
    }
  ],
