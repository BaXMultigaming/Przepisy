  "ingredients": [
    "1 pound butter",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon garlic salt",
    "1 teaspoon celery salt",
    "4 cups crispy rice cereal squares (such as Rice Chex™)",
    "4 cups crispy wheat cereal squares (such as Wheat Chex™)",
    "4 cups crispy corn cereal squares (such as Corn Chex™)",
    "4 cups toasted oat cereal (such as Cheerios™)",
    "1 pound mixed nuts",
    "1 (12 ounce) package thin pretzel sticks"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OVeuex3V4vKdxCkILNSoH2plytk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274486-homemade-chex-party-mix-DDMFS_4x3_Step_01-907b415ad73a47d1913549517da9102a.jpg"
      ],
      "image": "assets/images/274486/step_01.webp"
    },
    {
      "text": "Heat butter, Worcestershire sauce, garlic salt, and celery salt over low heat in a medium saucepan until butter has melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CdaXqb0Jw0qm04HvoQeHhuTLeF0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274486-homemade-chex-party-mix-DDMFS_4x3_Step_02-1ae8c15c57cb4ae6ae48a017c26105a2.jpg"
      ],
      "image": "assets/images/274486/step_02.webp"
    },
    {
      "text": "Combine cereals, nuts, and pretzel sticks in a large mixing bowl. Evenly pour butter mixture over top. Gently stir until evenly coated; transfer to a large roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kD4sPQCMa4YxX5hl4sbDfgypYsQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274486-homemade-chex-party-mix-DDMFS_4x3_Step_03-78b6b270319d4119b0ec42605dc8b1b6.jpg"
      ],
      "image": "assets/images/274486/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until golden and fragrant, about 2 hours, stirring gently every 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2aGGK_5-cvxsvVw1IYi2kDxzU_Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274486-homemade-chex-party-mix-DDMFS_4x3_Step_04-fcfb8239604d48a09c10f2614febfc12.jpg"
      ],
      "image": "assets/images/274486/step_04.webp"
    },
    {
      "text": "Let mix cool completely at room temperature, about 1 hour. Store in airtight containers or large resealable bags.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/87jqMTmF_BfE16aHJ1anwfb2d-A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/274486-homemade-chex-party-mix-DDMFS_4x3_Step_05-1aa33e420d3d44c0aa1a4989a3345f87.jpg"
      ],
      "image": "assets/images/274486/step_05.webp"
    }
