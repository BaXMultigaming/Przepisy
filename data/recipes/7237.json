  "ingredients": [
    "2 cups all-purpose flour",
    "3 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 cup white sugar",
    "1 egg, beaten",
    "0.75 cup milk",
    "0.25 cup vegetable oil",
    "1 cup any flavor fruit jam"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the flour, baking powder, salt and sugar. Make a well in the center. In a small bowl beat egg, milk and oil together. Pour all at once into the well in the flour mixture. Mix quickly and lightly until moistened, do not beat. The batter will be lumpy. Gently stir in jam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the batter into the prepared pan and bake at 400 degrees F (205 degrees C) for 25 minutes or until golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
