  "ingredients": [
    "2 cups rhubarb, cut into 1-inch pieces",
    "0.5 cup white sugar",
    "0.125 teaspoon baking soda",
    "0.25 cup hot water"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil; place a metal or glass bowl on top, with bottom of bowl just above boiling water. Add rhubarb to the bowl; cook undisturbed for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, dissolve sugar and baking soda in hot water in a small bowl, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sugar mixture over steamed rhubarb in the metal or glass bowl; continue cooking over boiling water, 2 to 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour rhubarb mixture through a fine-mesh sieve into a clean jar; press with a wooden spoon to extract more syrup. Discard solids. Store syrup in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
