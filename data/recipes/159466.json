  "ingredients": [
    "0.5 cup raisins",
    "1 egg",
    "0.75 cup milk",
    "1.5 cups bran cereal (such as Kellogg's All-Bran® Original Cereal)",
    "1 cup whole wheat flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "2 tablespoons melted butter",
    "1 apple, cored and shredded",
    "1 ripe banana, mashed",
    "0.5 cup honey"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 400 degrees F (200 degrees C). Grease 12 muffin cups or line with paper cupcake liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover raisins with water in a microwave-safe bowl; microwave on High for 1 minute to plump. Drain raisins and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg with milk in a bowl; mix in bran cereal. Let mixture stand until cereal absorbs liquid, about 5 minutes. Gently mix in plumped raisins, flour, baking soda, cinnamon, melted butter, shredded apple, mashed banana, and honey; stir a few times to mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into prepared muffin cups. Bake in the preheated oven for about 20 minutes, or until a toothpick inserted into the center of a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
