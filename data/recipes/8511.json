  "ingredients": [
    "1 (3 pound) whole chicken, skin removed and cut into pieces",
    "0.33333334326744 cup all-purpose flour",
    "1 tablespoon vegetable oil",
    "0.5 pound smoked sausage",
    "2 cloves garlic, minced",
    "1 onion, chopped",
    "2 red bell peppers, chopped",
    "3 roma (plum) tomatoes, chopped",
    "1 teaspoon brown sugar",
    "0.75 teaspoon dried thyme",
    "0.75 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground allspice",
    "1.5 cups long-grain white rice",
    "2.25 cups chicken stock",
    "1 tablespoon chopped fresh parsley, for garnish",
    "1 lemon - sliced, for garnish"
  ],
  "steps": [
    {
      "text": "Dredge chicken in flour, turning to coat all over.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large saucepan or Dutch oven, heat oil over medium heat. Brown chicken pieces about 8 minutes per side. Transfer to plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sausage, garlic, onion, peppers, tomatoes, sugar, thyme, oregano, salt, and allspice in the pan. Cook over medium heat, stirring occasionally, for 10 minutes or until peppers are softened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in rice, and add stock. Nestle chicken into rice. Bring to a boil. Reduce heat, and cover. Cook for 20 to 25 minutes, or until liquid is absorbed and juices run clear when chicken is pierced. Serve sprinkled with parsley. Garnish with lemon slices if you like.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
