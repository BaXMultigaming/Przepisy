  "title": "Jazzy New Orleans Chicken",
  "description": "Browned chicken pieces simmer with smoked sausage, rice, and bell peppers in this easy one-pot meal.",
  "authors": [
    "Charlene"
  ],
  "date_published": "1999-04-23T08:50:20-04:00",
