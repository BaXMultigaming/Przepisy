  "title": "Potato Logs",
  "description": "Deep fried seasoned mashed potatoes make tasty little appetizers. Dip them in butter or gravy for a real flavor sensation!",
  "authors": [
    "Mary"
  ],
  "date_published": "2018-03-21T12:18:19-04:00",
