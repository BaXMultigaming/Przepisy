  "ingredients": [
    "3 tablespoons butter, divided",
    "2 cloves garlic, chopped",
    "2 cups broccoli florets",
    "8 Brussels sprouts, trimmed and halved",
    "1 small tomato, seeded and diced",
    "0.25 teaspoon salt",
    "0.125 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Melt 1 tablespoon butter in a large skillet over medium heat; cook and stir garlic in hot butter until fragrant, 1 to 2 minutes. Stir broccoli and Brussels sprouts into garlic; add tomato and remaining 2 tablespoons butter. Season with salt and red pepper flakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Brussels sprouts mixture until well combined, then cover the skillet and cook until browned on one side, about 5 minutes. Flip sprouts and broccoli, cover the skillet again, and cook until browned on the other side, about 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
