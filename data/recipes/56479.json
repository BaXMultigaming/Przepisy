  "ingredients": [
    "4 slices bacon, chopped",
    "0.25 cup chopped onion",
    "1 (15 ounce) can stewed tomatoes",
    "4 (15 ounce) cans green beans"
  ],
  "steps": [
    {
      "text": "Fry the bacon in a large skillet over medium heat until browned and crisp. Drain off all but a thin coating of the grease. Add onions to the skillet; cook and stir until browned, about 5 minutes. Mix in tomatoes, stirring to remove any stuck on bits of bacon from the bottom of the skillet. Drain two cans of the beans, leave the liquid in the other two; pour into the skillet. Cook and stir until heated through.",
