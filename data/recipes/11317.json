  "title": "Easter Story Cookies",
  "description": "These cookies are great to do with the kids. They are to be prepared the night before Easter. The spiritual preparation goes along with the physical preparation of the cookies.",
  "authors": [
    "Sonia"
  ],
  "date_published": "1999-03-21T00:51:28-05:00",
