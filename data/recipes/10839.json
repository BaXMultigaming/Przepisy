  "ingredients": [
    "0.5 cup unsalted butter",
    "1 cup packed brown sugar",
    "2 tablespoons light corn syrup",
    "1 teaspoon vanilla extract",
    "2 cups chocolate flavored crispy rice cereal",
    "1 cup milk chocolate chips",
    "0.75 cup almonds"
  ],
  "steps": [
    {
      "text": "Heat oven to 350 degrees F. Line an 8 inch, square baking pan with heavy-duty foil, folding the foil over the edges of the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put butter in pan and melt in oven. Add brown sugar, corn syrup and vanilla; stir to mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cereal and stir with a spoon, then mix with fingers until thoroughly coated. Place waxed paper on top and press down gently but firmly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 minutes until entire surface is bubbly. Sprinkle with chocolate chips and let stand for chips to soften.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread chips, then sprinkle with almonds, pressing gently into chocolate. Let cool until just warm, then refrigerate at least 1 hour or overnight before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using foil as a lifter, remove from pan and, without inverting (almond would peel off), peel off foil. Cut into bars. Store in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
