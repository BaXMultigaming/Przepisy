  "ingredients": [
    "3 cups frozen bite-sized potato nuggets (such as Tater Tots®)",
    "3 tablespoons butter, melted",
    "0.5 teaspoon salt",
    "1 cup shredded Cheddar cheese",
    "0.75 cup diced ham",
    "0.5 cup grated Parmesan cheese",
    "3 tablespoons all-purpose flour",
    "4 eggs",
    "1.25 cups milk",
    "0.33333334326744 cup diced onion",
    "0.33333334326744 cup diced green bell pepper",
    "1 teaspoon salt",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the crust: Place potato nuggets in a large microwave-safe bowl. Heat in the microwave until thawed, 1 to 2 minutes. Add butter and salt; mash together until potato nuggets are crumbled. Press evenly into a glass pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove crust from the oven. Reduce the oven temperature to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the filling: Combine Cheddar cheese, ham, Parmesan cheese, and flour in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a separate bowl until smooth. Stir in milk, onion, bell pepper, salt, onion powder, and garlic powder. Pour into Cheddar mixture and stir filling until well combined. Pour filling over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is set and golden, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool for 10 to 15 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
