  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup whole wheat flour",
    "0.5 cup white sugar",
    "3 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.75 cup milk",
    "0.33333334326744 cup vegetable oil",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease the bottoms only of 12 muffin cups or line them with baking cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine all-purpose flour, whole wheat flour, sugar, baking powder, and salt; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine milk, oil, and egg; blend well. Add dry ingredients all at once; stir just until dry ingredients are moistened (batter will be lumpy.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill muffin cups 2/3 full. Bake for 20 to 25 minutes or until toothpick inserted in center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool muffins 1 minute before removing from pan. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
