  "title": "Green Beans in Cider",
  "description": "Green beans are simmered in apple cider and topped with bacon bits and onions for a lighter green bean side dish for Thanksgiving dinner.",
  "authors": [
    "Carol Shorter Hicks"
  ],
  "date_published": "2018-06-08T10:05:55-04:00",
