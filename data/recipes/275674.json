  "ingredients": [
    "10 cups popped popcorn",
    "0.5 cup packed brown sugar",
    "0.25 cup butter",
    "1 (16 ounce) package marshmallows",
    "5 drops green food coloring",
    "1/2 cup candy eyeballs"
  ],
  "steps": [
    {
      "text": "Pour popcorn into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt brown sugar and butter together in a saucepan over medium heat, stirring often. Stir in marshmallows until completely melted and mixture is smooth. Stir in green food coloring until color is evenly distributed. Pour mixture over popcorn and stir until evenly coated. Sprinkle with candy eyeballs while mixture is still sticky.",
