  "title": "Roasted Cherry Tomato Pasta",
  "description": "This easy pasta dish boasts a flavorful sauce made with roasted cherry tomatoes, shallots, and garlic. Perfect for an easy vegetarian weeknight dinner.",
  "authors": [
    "Kim"
  ],
  "date_published": "2010-06-09T17:36:14-04:00",
