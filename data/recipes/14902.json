  "ingredients": [
    "2 avocados, halved with pits removed",
    "1 lemon, juiced",
    "2 cups cottage cheese",
    "2 tomatoes, diced",
    "0.5 cup diced sweet onion",
    "1 jalapeno pepper, seeded and minced",
    "0.5 teaspoon garlic powder",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Scoop avocado flesh out of the skins and place into a medium mixing bowl; discard skins. Add lemon juice to the bowl and mash well. Add cottage cheese, tomatoes, onion, jalapeño, garlic powder, salt, and pepper; stir until combined. Chill for at least 1 hour before serving.",
