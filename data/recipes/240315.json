  "ingredients": [
    "1.5 cups pecan halves",
    "1 cup white sugar",
    "3 eggs, beaten",
    "0.5 cup light corn syrup",
    "0.5 cup dark corn syrup",
    "2 tablespoons butter, melted",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "18 (3 inch) ready-to-bake pie shells"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pecans on a food processor and pulse until coarsely chopped.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5brje8TR2QrU1ArbQiOL4xKgxOg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240315-mini-southern-pecan-pies-DDMFS-step-01-573a0203c3c340e8956597c86443f5f7.jpg"
      ],
      "image": "assets/images/240315/step_02.webp"
    },
    {
      "text": "Mix sugar, eggs, light corn syrup, dark corn syrup, butter, vanilla extract, and salt together in a bowl; fold in pecans. Spoon 1/4 cup pecan mixture into each mini pie shell. Transfer pies onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F5k6cElh9rqQkj6hgwR_F1mE_Ig=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240315-mini-southern-pecan-pies-DDMFS-step-02-606e7e4d488942918db7b633ac6c7911.jpg"
      ],
      "image": "assets/images/240315/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until mini pies are slightly browned, 25 to 30 minutes. Serve warm or cool and place in airtight containers for up to one week.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fwzyKdygZsYUvemIPdAIb0GeKqU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240315-mini-southern-pecan-pies-DDMFS-step-03-27585e08370a4d68b79b3c644d7be384.jpg"
