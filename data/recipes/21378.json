  "ingredients": [
    "4 potatoes, peeled and cubed",
    "2 tablespoons butter",
    "1 head broccoli, cut into florets",
    "1 onion, chopped",
    "1.5 cups cooked ham, cubed",
    "8 eggs, beaten",
    "0.75 cup shredded Cheddar cheese",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled skillet over medium high heat. Add the potatoes and cook for 10 minutes, until lightly brown. Layer in bottom of prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add butter to skillet and saute broccoli and onions until soft; spoon over potatoes. Spread ham on top of broccoli and onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat together eggs and cheese. Season with salt and pepper and pour over vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until eggs are set and lightly brown on top, about 20 to 30 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
