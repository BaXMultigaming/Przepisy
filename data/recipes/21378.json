  "title": "Mouth Watering Medley",
  "description": "A hearty vegetable and ham breakfast casserole made with broccoli, ham, Cheddar cheese and eggs.",
  "authors": [
    "Ann"
  ],
  "date_published": "2000-07-17T21:54:43-04:00",
