  "ingredients": [
    "0.66666698455811 cup raisins",
    "0.75 cup all-purpose flour",
    "0.75 cup whole wheat flour",
    "0.33333298563957 cup unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "0.25 teaspoon salt",
    "1 tablespoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.75 cup butter, softened",
    "1.5 cups white sugar",
    "3 eggs",
    "2 cups applesauce",
    "0.5 cup coarsely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Place raisins in a small saucepan, and cover with boiling water. Soak for 5 minutes, then drain. Grease and flour a 9 inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the all-purpose flour, whole wheat flour, cocoa, baking soda, salt, cinnamon, and nutmeg. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream butter and sugar until light and fluffy. Blend in the eggs, then the applesauce. Beat in the flour mixture. Stir in raisins and walnuts. Spread batter evenly into prepared tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 80 minutes, or until a toothpick inserted in the center of cake comes out clean. Let cool in pan for 10 minutes, then turn out onto a wire rack and cool completely; chill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
