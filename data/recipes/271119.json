  "ingredients": [
    "1 (16 ounce) package elbow macaroni",
    "1 quart chicken stock",
    "0.5 teaspoon salt",
    "0.5 teaspoon dry mustard",
    "0.5 teaspoon liquid smoke flavoring",
    "0.5 teaspoon paprika",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon garlic powder",
    "2 tablespoons butter",
    "1 cup milk",
    "8 ounces shredded Cheddar cheese",
    "1 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Combine macaroni, chicken stock, salt, dry mustard, liquid smoke, paprika, pepper, and garlic powder in a multi-functional pressure cooker (such as Instant Pot). Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 4 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in butter, then milk. Add in Cheddar and Parmesan cheese until melted. Mixture will be soupy at first.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Select the \"Keep Warm\" setting on the Instant Pot and allow macaroni to sit, uncovered and stirring occasionally, until all liquid has been absorbed and consistency is smooth and creamy, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
