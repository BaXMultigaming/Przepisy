  "ingredients": [
    "4 cups all-purpose flour",
    "1 pound butter",
    "1 pint sour cream",
    "1.5 cups white sugar",
    "1.5 cups chopped walnuts",
    "2 teaspoons ground cinnamon",
    "1 tablespoon confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Pour flour into a bowl and cut in butter until the mixture resembles coarse crumbs. Stir in sour cream, cover, and chill dough in the refrigerator overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, chopped nuts, and cinnamon in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide chilled dough into quarters. On a lightly floured surface roll out dough into circles 1/8 to 1/4 inch thick. Cut into wedges and sprinkle with the nut mixture. Roll up into crescent shapes, starting with the wide end first.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies on a parchment lined baking sheet at 350 degrees F (175 degrees C) for 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle cooled cookies with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
