  "ingredients": [
    "1 tablespoon butter, or as needed",
    "1 cup elbow macaroni",
    "1 (6 ounce) can salmon, drained",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "0.66666668653488 cup milk, or to taste",
    "0.5 cup grated Parmesan cheese",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.25 cup French-fried onions"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 9-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine macaroni, salmon, cream of mushroom soup, 1/2 can of milk, Parmesan cheese, salt, and pepper in a casserole dish. Mix until well blended. Sprinkle French-fried onions on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the middle rack of the preheated oven until lightly browned on top, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
