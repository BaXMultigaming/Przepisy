  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "0.75 cup unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1.5 cups vegetable oil",
    "4 eggs",
    "3 cups grated zucchini",
    "0.75 cup chopped walnuts"
  ],
