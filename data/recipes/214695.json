  "ingredients": [
    "0.33333334326744 cup peanut butter",
    "0.33333334326744 cup brown sugar",
    "2.5 tablespoons butter",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1 ripe banana, mashed",
    "0.66666668653488 cup rolled oats",
    "0.33333334326744 cup all-purpose flour",
    "2 tablespoons wheat germ",
    "0.25 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together peanut butter, brown sugar, and butter in a large bowl with an electric mixer until smooth and fluffy. Beat in egg and vanilla until incorporated. Mix in mashed banana. Stir in oats, flour, wheat germ, and baking soda until batter is well combined. Spread batter in the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and lightly browned, 20 to 25 minutes. Remove from the oven and cool completely in the pan on a wire rack before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
