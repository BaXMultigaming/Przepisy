  "ingredients": [
    "1 (16 ounce) package medium seashell pasta",
    "1.5 pounds ground beef",
    "1 small onion, chopped",
    "2 cloves garlic, minced",
    "3 (14.5 ounce) cans Italian stewed tomatoes",
    "3 beef bouillon cubes",
    "1.5 tablespoons white sugar",
    "1 teaspoon garlic salt",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Place pasta in the pot, cook for 8 to 10 minutes, until al dente, and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet over medium heat, mix the beef, onion, and, garlic, and cook until beef is evenly brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a blender or food processor, liquefy the tomatoes. Pour into the skillet with the beef. Mix in beef bouillon, sugar, garlic salt, and pepper. Cover, and simmer 10 minutes, stirring occasionally, until bouillon has dissolved. Stir in the pasta until evenly coated with the sauce to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
