  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup whole wheat flour",
    "0.25 cup brown sugar",
    "0.5 cup flaked coconut",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "2 eggs",
    "0.25 cup applesauce",
    "1 (6 ounce) container plain coconut milk yogurt",
    "2 tablespoons skim milk",
    "1 tablespoon vegetable oil",
    "1 tablespoon honey, or more to taste",
    "0.5 cup chopped dried mango",
    "8 (1 inch) pieces crystallized ginger, finely chopped",
    "2 tablespoons flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all-purpose flour, whole wheat flour, brown sugar, 1/2 cup flaked coconut, baking powder, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the eggs in another large bowl until creamy. Add applesauce, coconut milk yogurt, skim milk, vegetable oil, and honey to eggs. Blend well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour mixture, dried mango, candied ginger, and honey into egg mixture just until blended. Spoon batter into muffin cups, filling about 3/4 of each cup. Sprinkle 2 tablespoons flaked coconut on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the middle of a muffin comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
