  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup mini chocolate chips",
    "0.25 cup white sugar",
    "0.25 cup cocoa powder",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 cup milk",
    "1 large egg, beaten",
    "3 tablespoons butter, melted",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Mix flour, chocolate chips, sugar, cocoa powder, baking powder, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, egg, butter, and vanilla in a small bowl. Pour over flour mixture; stir only enough to blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle over medium-high heat. Drop batter by large spoonfuls onto the griddle and cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
