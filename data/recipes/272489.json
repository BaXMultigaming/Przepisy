  "ingredients": [
    "0.5 cup Cabernet Sauvignon",
    "1 cup granulated sugar",
    "0.5 cup goat cheese",
    "0.5 cup crumbled Gorgonzola cheese",
    "1 tablespoon milk, or more as needed",
    "4 nectarines",
    "1 tablespoon olive oil"
  ],
  "steps": [
    {
      "text": "Combine Cabernet and sugar in a saucepan. Boil until reduced to 1/2 cup. Let syrup cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place goat cheese and Gorgonzola in a blender with milk. Blend until smooth. Add additional milk, 1 tablespoon at a time, if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut the nectarines in half lengthwise and remove the pits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly brush nectarines with olive oil and place on the grill for 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Once nectarines are cooled, place a spoonful of the goat cheese mousse in the center of each nectarine. Drizzle with Cabernet syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
