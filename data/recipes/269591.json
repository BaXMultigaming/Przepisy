  "ingredients": [
    "1.75 sticks unsalted butter",
    "7 ounces dark chocolate, chopped",
    "0.66666668653488 cup brown sugar",
    "5 large cold eggs",
    "3 tablespoons all-purpose flour",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Generously butter a 9x2 inch round cake pan and dust with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter and chocolate together in a heavy saucepan over very low heat. Remove from heat and whisk in sugar and eggs 1 at a time. Stir vigorously 2 or 3 times, then gently whisk in flour and salt. Pour batter into the prepared pan. Rap pan once against the counter to settle batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center of the cake comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Run a knife around the edge of the pan and cool for 10 minutes. Unmold cake and cool right-side up on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
