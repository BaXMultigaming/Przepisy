  "steps": [
    {
      "text": "Combine 1 1/2 cups sugar, 6 tablespoons margarine, and 1/3 cup evaporated milk in a heavy 1 1/2-quart saucepan; bring to full rolling boil, stirring constantly. Continue boiling over medium heat for 4 minutes, stirring constantly to prevent scorching.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat; stir in chocolate pieces until melted. Add 1/2 of the marshmallow creme and 1/2 teaspoon vanilla; beat until well blended. Pour into a greased 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Repeat steps 1 and 2 with remaining ingredients, substituting peanut butter for chocolate pieces. Spread evenly over chocolate layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let fudge cool at room temperature until set; cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
