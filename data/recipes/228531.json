  "ingredients": [
    "1 gallon vegetable broth",
    "1 cup kosher salt",
    "0.5 cup light brown sugar",
    "1 tablespoon black peppercorns",
    "1.5 teaspoons whole allspice berries",
    "1.5 teaspoons chopped candied ginger",
    "1 gallon water with ice chunks",
    "1 medium red apple, cored and sliced",
    "0.5 medium onion, sliced",
    "1 (3 inch) cinnamon stick",
    "4 sprigs fresh rosemary",
    "6 leaves fresh sage",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine vegetable broth, kosher salt, brown sugar, peppercorns, allspice berries, and candied ginger in a large stockpot over medium-high heat. Stir to dissolve sugar and salt; bring mixture to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uum_N_Szn1hZ6Woba8gYWXbcGqk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228531-matts-fried-turkey-brine-DDMFS-step-01-4bbde4fa11de49dfbd82c921647799e8.jpg"
      ],
      "image": "assets/images/228531/step_02.webp"
    },
    {
      "text": "Remove from the heat and cool to room temperature. Cover and refrigerator until well chilled, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zYaj9OD4rf62eo7G3TT0g32hsSc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228531-matts-fried-turkey-brine-DDMFS-step-02-19e76e1e6cf849efaa576aec14fa035e.jpg"
      ],
      "image": "assets/images/228531/step_03.webp"
    },
    {
      "text": "Remove from the refrigerator and add water with ice chunks, apple and onion slices, cinnamon stick, rosemary sprigs, and sage leaves. Stir in remaining 1 cup water and brine is ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JDlt6XOmHHgmgkNhVAoXOyMtyCk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228531-matts-fried-turkey-brine-DDMFS-step-03-39c6d7e7b5814ca0a2b1bcc7fc3eaef9.jpg"
      ],
      "image": "assets/images/228531/step_04.webp"
    }
