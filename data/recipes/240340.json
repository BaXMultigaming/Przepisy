  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "1 cup honey",
    "0.75 cup shortening",
    "0.25 cup water",
    "1 egg",
    "1 teaspoon vanilla extract",
    "3 cups oats",
    "1.5 cups all-purpose flour",
    "0.25 cup brown sugar",
    "2 teaspoons ground cinnamon",
    "1.5 teaspoons ground ginger",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground nutmeg",
    "0.125 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat pumpkin, honey, shortening, water, egg, and vanilla extract together in a large bowl until creamy. Whisk oats, flour, brown sugar, cinnamon, ginger, baking soda, baking powder, salt, nutmeg, and cloves together in another bowl. Add oat mixture to pumpkin mixture; stir until dough is well-blended. Drop dough by rounded teaspoonfuls onto prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and set, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
