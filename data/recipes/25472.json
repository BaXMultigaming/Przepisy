  "ingredients": [
    "3 pounds rib roast",
    "0.5 cup vegetable oil",
    "0.5 cup soy sauce",
    "0.25 cup packed brown sugar",
    "4 cloves garlic, peeled and crushed",
    "2 tablespoons curry powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Trim excess fat from rib roast, place on a medium baking sheet and cover with foil. Bake approximately 30 minutes in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, whisk together vegetable oil, soy sauce, brown sugar, garlic and curry powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain juices from ribs and cut into 4 separate pieces. Place on the prepared grill. Basting frequently with the vegetable oil mixture and turning often, cook ribs 15 to 20 minutes, or until richly glazed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
