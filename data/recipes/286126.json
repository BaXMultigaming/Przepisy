  "ingredients": [
    "1 (2 1/2 pound) boneless pork sirloin roast",
    "3 tablespoons olive oil",
    "2 teaspoons minced garlic",
    "2 teaspoons chopped fresh thyme",
    "2 teaspoons chopped fresh sage",
    "2 teaspoons finely grated lemon zest",
    "1.5 teaspoons chopped fresh rosemary",
    "1 teaspoon sea salt",
    "1 teaspoon coarsely ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring roast to room temperature by removing from the refrigerator 30 minutes before cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil, garlic, thyme, sage, lemon zest, rosemary, salt, and pepper in a small bowl. Spread rub over roast until completely coated. Place on a rack in a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until slightly pink in the center, 45 to 60 minutes. An instant-read thermometer inserted into the center should read at least 150 degrees F (66 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and tent loosely with foil. Allow to rest for 10 to 15 minutes before carving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
