  "ingredients": [
    "2 cups frozen green peas, thawed",
    "0.66666698455811 cup water",
    "0.125 teaspoon salt",
    "3 tablespoons butter",
    "0.33333298563957 cup heavy cream",
    "2 tablespoons all-purpose flour",
    "1 tablespoon white sugar"
  ],
  "steps": [
