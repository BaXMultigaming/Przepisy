  "ingredients": [
    "0.5 cup salted butter, at room temperature",
    "0.33333334326744 cup confectioners' sugar, plus extra for dusting",
    "1 teaspoon vanilla extract",
    "1 teaspoon almond extract",
    "0.125 teaspoon salt",
    "0.75 cup all-purpose flour, sifted",
    "2 tablespoons all-purpose flour, sifted",
    "0.5 cup almonds, finely chopped"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kZSZKwhSSZxlRAeHSyABGFJskeo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-245336-almond-crescent-cookies-VAT-step-01-5268ea3cbb804c76b7a437189f05b873.jpg"
      ],
      "image": "assets/images/245336/step_01.webp"
    },
    {
      "text": "Beat butter and confectioners' sugar in a bowl using an electric mixer until smooth and creamy. Add vanilla extract, almond extract, and salt; mix briefly to incorporate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6GhpRff9sGlkM9nTfrQxZFSoD9I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-245336-almond-crescent-cookies-VAT-step-02-44b901ee039c481d92811fb132f441a0.jpg"
      ],
      "image": "assets/images/245336/step_02.webp"
    },
    {
      "text": "Gradually stir 3/4 cup plus 2 tablespoons flour into the creamed butter, add almonds, and mix until dough is just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zUj0DlWNvM3kMB-cyrEv16jOink=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-245336-almond-crescent-cookies-VAT-step-03-6594a55464304fc8b20f8bc0d4b4b31f.jpg"
      ],
      "image": "assets/images/245336/step_03.webp"
    },
    {
      "text": "Shape dough into tiny crescents; place on an ungreased baking sheet about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pVwYsDpS18W5TFom57SWdmB-eJs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-245336-almond-crescent-cookies-VAT-step-04-5baf5deeaef74307985a42af2c5c5b70.jpg"
      ],
      "image": "assets/images/245336/step_04.webp"
    },
    {
      "text": "Bake cookies in preheated oven until edges are lightly golden, about 15 minutes. Cool on the baking sheet for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MHgjxCoM-VcqdTAI2H8YqsZoTF4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-245336-almond-crescent-cookies-VAT-step-05-9c23f30cf7a34c758d895d924d37b874.jpg"
      ],
      "image": "assets/images/245336/step_05.webp"
    },
    {
      "text": "Roll cookies in sifted confectioners' sugar when cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A3hsrJNzQAyLsJJfGCkjfIcVXDI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-245336-almond-crescent-cookies-VAT-step-06-7beb709dd3224b54816b1a544c130aba.jpg"
