  "ingredients": [
    "1.5 cups unsalted butter",
    "3 cups white sugar",
    "2 teaspoons vanilla extract",
    "7 eggs, beaten",
    "1.25 cups all-purpose flour",
    "1.25 cups unsweetened cocoa powder",
    "1 teaspoon salt",
    "1 pound chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line one 9x9-inch baking pan with foil and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan over medium-heat, melt butter. Stir in sugar until dissolved. Remove mixture from heat. Gradually pour melted butter into beaten eggs, whisking constantly, until mixture is fully incorporated. Stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cocoa, and salt together. Add flour mixture to butter mixture, mixing until combined. Stir in walnuts. Spread batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until brownies are set (a toothpick inserted in the center should have small crumbs clinging to it, rather than wet batter), 45 to 50 minutes. Do not overbake!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
