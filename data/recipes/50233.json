  "ingredients": [
    "2 tablespoons vegetable oil",
    "4 cloves garlic, chopped",
    "0.5 pound ground beef",
    "0.5 small head cabbage, shredded",
    "1 red bell pepper, cut into strips",
    "2 tablespoons soy sauce",
    "1 teaspoon cornstarch",
    "0.5 cup cold water",
    "1 teaspoon ground black pepper, or to taste",
    "1 pinch salt, to taste"
  ],
  "steps": [
    {
      "text": "Gather ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oEZDlHNxv5WZ-T1xS9RbeYB6iBI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/50233-BlackPepperBeefandCabbageStirFry-ddmps-step-1-103983-9988dbd29c924ebe8a946db0ddf3d0f7.jpg"
      ],
      "image": "assets/images/50233/step_01.webp"
    },
    {
      "text": "Heat a wok or large skillet over medium-high heat, and add oil. Saute garlic for about 5 seconds, then add ground beef. Stir-fry until beef is evenly brown, 5 to 7 minutes; drain excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gBgaQ1c9GBY36L2JHd4q0SW53LM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/50233-BlackPepperBeefandCabbageStirFry-ddmps-step-2-103991-08e3c8745ee74b01a14af8a222c5b140.jpg"
      ],
      "image": "assets/images/50233/step_02.webp"
    },
    {
      "text": "Stir in cabbage and pepper, and cook until vegetables are tender and beef is fully cooked. Stir in soy sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sChMcdNnDt0TqQbC6jpdiHtjo_s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/50233-BlackPepperBeefandCabbageStirFry-ddmps-step-3-103994-5580ab039efa47d58b59434dad235a1e.jpg"
      ],
      "image": "assets/images/50233/step_03.webp"
    },
    {
      "text": "Mix together cornstarch and water, and stir in. Season with pepper; add salt to taste. Cook, stirring, until sauce has thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j50QI_b6TXXHvdO3zkL7Gv8Cs_4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/50233-BlackPepperBeefandCabbageStirFry-ddmps-step-4-104001-819dfa5f950b4a7ab3b88b85a0c8dcb0.jpg"
      ],
      "image": "assets/images/50233/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
