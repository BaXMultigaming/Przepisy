  "ingredients": [
    "0.66666668653488 cup prepared dashi stock",
    "2 teaspoons white sugar",
    "2 teaspoons mirin (Japanese sweet wine)",
    "2 teaspoons soy sauce",
    "0.5 teaspoon salt",
    "1 tablespoon vegetable oil",
    "1 small onion, chopped",
    "2 (3 ounce) fried breaded pork chops, sliced into long strips",
    "2 eggs, beaten",
    "1.5 cups cooked short-grain rice"
  ],
  "steps": [
    {
      "text": "Mix dashi, sugar, mirin, soy sauce, and salt together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a small skillet over medium heat. Add onion; cook and stir until translucent, about 5 minutes. Stir in dashi mixture. Lay pork slices carefully on top of the onions. Drizzle eggs around the slices. Cover skillet and cook until eggs are set, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide rice between 2 bowls. Top each with half the onions, eggs, and pork slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
