  "ingredients": [
    "5 fresh jalapeno peppers, seeded and chopped",
    "1 cup shredded Monterey Jack cheese",
    "0.33333334326744 cup JIF® Creamy Peanut Butter",
    "2 tablespoons Crosse & Blackwell® Major Grey's Chutney",
    "0.5 teaspoon Cajun seasoning",
    "2 eggs, beaten",
    "0.5 cup Pillsbury BEST® All Purpose Flour",
    "1 cup plain panko bread crumbs",
    "Crisco® Pure Peanut Oil",
    "Salt to taste",
    "1 cup sour cream",
    "3 tablespoons minced fresh chives"
  ],
  "steps": [
    {
      "text": "Stir jalapenos, cheese, peanut butter, chutney and Cajun seasoning in medium bowl until blended. Shape into 1/2-inch round balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place egg, flour and breadcrumbs into three separate small bowls. Coat each ball in flour, then egg and breadcrumbs. Chill on baking sheet 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 2 inches oil to 350 degrees F in a 6-quart saucepan. Fry poppers 1 1/2-2 minutes each or until golden brown. Drain on paper towel. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sour cream and chives. Serve with poppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
