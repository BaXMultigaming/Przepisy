  "ingredients": [
    "4 tablespoons olive oil",
    "2 cloves garlic, peeled and crushed",
    "1.5 teaspoons dried oregano",
    "1 teaspoon smoked paprika",
    "1 teaspoon hot sauce, or to taste",
    "4 large potatoes, cut into wedges"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place a baking pan in the oven to heat up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix olive oil, garlic, oregano, smoked paprika, and hot sauce in a large bowl. Toss potato wedges in the oil until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour wedges into the hot baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crisp and golden, about 40 minutes.",
