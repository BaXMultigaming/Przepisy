  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup Becel® Original margarine",
    "1 cup firmly packed light brown sugar",
    "0.25 cup granulated sugar",
    "2 large eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Combine flour, baking soda and salt in medium bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat Becel® Original margarine with sugars in large bowl. Beat in eggs and vanilla until blended. Gradually add in flour mixture; beat just until blended. Add your choice of mix in's (i.e. chocolate chip, dried fruit, seeds, toffee bits, etc.). Drop by tablespoonfuls on ungreased baking sheets, 2-inches (5 cm) apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 7 minutes or until edges are golden. Cool 2 minutes on wire rack; remove cookies from sheets and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
