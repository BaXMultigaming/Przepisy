  "ingredients": [
    "1 pound ground pork",
    "1 cup diced celery",
    "1 cup shredded carrot",
    "1 cup diced onion",
    "3 cloves garlic, minced",
    "1 teaspoon salt",
    "1 tablespoon ground black pepper",
    "0.25 cup soy sauce",
    "1 (14 ounce) package wonton wrappers",
    "2 eggs, beaten",
    "1 quart canola oil for frying"
  ],
  "steps": [
    {
      "text": "Mix together ground pork, celery, carrot, onion, and garlic in a bowl. Season with salt, pepper, and soy sauce; mix with your hands until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate the wonton wrappers and lay them out on a clean surface. Spoon 1 teaspoon pork mixture into the center of each wrapper. Moisten the edges of the wonton wrappers with beaten egg, fold over the filling to form a triangle, and press together to seal. Place the finished wontons on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat canola oil in a deep fryer or large saucepan to 365 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry wontons, about 6 at a time, in hot oil until golden brown and they float to the top, 3 to 4 minutes. Remove and drain on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
