  "ingredients": [
    "1 pound refrigerated pizza dough",
    "0.25 cup pizza sauce",
    "0.5 cup shredded mozzarella cheese",
    "0.5 cup sliced pepperoni"
  ],
  "steps": [
    {
      "text": "Place a pizza stone on an outdoor grill directly over a wood fire. You may first need to spread out the wood if the flames are too high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out pizza dough on a flat surface to desired thickness. Place on the pizza stone; cook until golden on one side, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dough to a flat work surface; spread pizza sauce in an even layer onto cooked side of dough, leaving ½-inch edge bare. Sprinkle mozzarella cheese on top sauce; top with pepperoni.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pizza on the pizza stone; tent with aluminum foil and cook until cheese has melted, about 10 minutes. Transfer pizza to a cutting board. Cool slightly before cutting and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
