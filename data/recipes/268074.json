  "ingredients": [
    "3.5 cups water",
    "1 cup black rice",
    "0.75 teaspoon salt",
    "1 cup unsweetened coconut milk",
    "0.5 cup white sugar"
  ],
  "steps": [
    {
      "text": "Combine water, black rice, and salt in a saucepan; bring to a boil. Reduce heat; cover and simmer for 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in coconut milk and sugar; bring to a boil. Reduce heat; simmer, uncovered, until rice reaches a sticky consistency, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool. Stir and serve.",
