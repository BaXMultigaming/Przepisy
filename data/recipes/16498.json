  "ingredients": [
    "2 cups quick cooking oats",
    "1 cup all-purpose flour",
    "0.75 cup packed brown sugar",
    "0.75 cup raisins",
    "0.5 cup wheat germ",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup chopped English walnuts",
    "0.5 cup vegetable oil",
    "0.5 cup honey",
    "1 egg",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13 inch baking pan with aluminum foil or parchment paper, and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oats, flour, brown sugar, raisins, wheat germ, salt, cinnamon, and walnuts together in a large bowl. Whisk oil, honey, egg, and vanilla together in a medium bowl. Add to flour mixture, and mix with a wooden spoon until well combined. Press evenly into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges are golden, 25 to 30 minutes. Cool completely in the pan before turning out on a cutting board and cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
