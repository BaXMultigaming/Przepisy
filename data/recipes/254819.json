  "ingredients": [
    "cooking spray (such as Pam®)",
    "1.5 pounds ground beef",
    "1 cup chopped onion",
    "0.5 cup water",
    "1 (1 ounce) package taco seasoning mix",
    "1 (10 ounce) can refried beans",
    "1 (6 ounce) can sliced black olives",
    "1 (4 ounce) can diced green chiles",
    "0.5 cup salsa",
    "15 taco shells, broken up, or more to taste",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook ground beef and onions in a skillet over medium heat until beef is browned, 7 to 10 minutes; drain grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rLc5OIMvQ2TCs8c70hZ-nkBo_AU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/254819-taco-bake-casserole-ddmfs-step1-142-3x4-0e4e2342e5a145b28a787057bb611dcb.jpg"
      ],
      "image": "assets/images/254819/step_02.webp"
    },
    {
      "text": "Stir in water and taco seasoning; cook, stirring often, until thickened, about 2 minutes. Reduce heat to low. Add refried beans, olives, green chiles, and salsa; cook and stir until warmed through, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NGl9x38oq0nLqnax71ZtT5CQek8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/254819-taco-bake-casserole-ddmfs-step2-147-3x4-b7d322fa6e82444d8309e3d58a260bab.jpg"
      ],
      "image": "assets/images/254819/step_03.webp"
    },
    {
      "text": "Arrange ½ broken taco shells into the prepared baking dish; layer ½ ground beef mixture over broken taco shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IXk8j8cXFqD61gUXIA4azYNO6dA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/254819-taco-bake-casserole-ddmfs-step3-156-3x4-f12428a18f8c4cc094575300a908a361.jpg"
      ],
      "image": "assets/images/254819/step_04.webp"
    },
    {
      "text": "Sprinkle ½ Cheddar cheese over top. Repeat layers once more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lWy-mcnE63_25OhXBwrzoRDjFw0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/254819-taco-bake-casserole-ddmfs-step4-162-3x4-30acb71c8b6649f3b3761b23aa443193.jpg"
      ],
      "image": "assets/images/254819/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and bubbly, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KFzubvztb4gxSyiAnCiuI_jdO8o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/254819-taco-bake-casserole-ddmfs-step5-180-3x4-23cabb4bfbff46f1b10b29ad12b44646.jpg"
      ],
      "image": "assets/images/254819/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eJc9F5iq0Q0V9zJFfYmuxQFdW0Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/254819-taco-bake-casserole-DDMFS-4x3-e8939e901b794c3f9e0799d7462d56a7.jpg"
      ],
      "image": "assets/images/254819/step_07.webp"
    }
