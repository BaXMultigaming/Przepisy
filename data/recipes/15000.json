  "title": "Stuffed Cabbage",
  "description": "Cabbage leaves are wrapped around a beef and rice mixture, then baked in a sauce made from tomato soup in this old-time favorite.",
  "authors": [
    "Barb"
  ],
  "date_published": "1999-04-04T22:01:16-04:00",
