  "title": "Banana Coffee Cake",
  "description": "A cross between chocolate chip banana bread and coffee cake, this moist banana cake is layered with chocolate chips and a brown sugar-cinnamon topping.",
  "authors": [
    "danaca"
  ],
  "date_published": "2020-06-19T00:44:45-04:00",
