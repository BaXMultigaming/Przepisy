  "ingredients": [
    "3 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons baking soda",
    "0.5 cup brown sugar",
    "1 teaspoon ground cinnamon",
    "2 cups white sugar",
    "1 cup unsalted butter, at room temperature",
    "2.5 cups mashed banana",
    "1 teaspoon vanilla extract",
    "2 large eggs, beaten",
    "1 cup sour cream",
    "1.5 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and baking soda together in a large bowl. Mix brown sugar and cinnamon together in a small bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and butter in a large mixing bowl; beat with an electric mixer until creamy. Add banana and vanilla extract; mix until smooth. Mix in beaten eggs. Add flour mixture alternately with sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/2 of the batter into the prepared baking pan, sprinkle with 1/2 of the brown sugar mixture, and 1/2 of the chocolate chips; repeat layers once more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
