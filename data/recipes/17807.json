  "ingredients": [
    "1 (10 ounce) package frozen chopped spinach, thawed",
    "0.5 yellow onion, chopped",
    "1 cup cottage cheese",
    "4 skinless, boneless chicken breast halves",
    "2 tablespoons Cajun-style seasoning",
    "2 tablespoons melted butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Squeeze excess water out of thawed spinach; in a large bowl, mix spinach with onion and cottage cheese and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken breasts with Cajun-style seasoning, then place 1/4 of cheese/spinach mixture in the center of each breast and fold in half. Secure with toothpicks and place in a lightly greased 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle with melted butter and bake at 350 degrees F (175 degrees C) for about 25 minutes, or until chicken is cooked through and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
