  "title": "Cottage Cheese Spinach Chicken",
  "description": "Cajun-seasoned chicken breast stuffed with a cottage cheese and spinach mixture, then baked in butter. Serve with tossed salad, if desired.",
  "authors": [
    "Loretta"
  ],
  "date_published": "2000-04-27T00:37:16-04:00",
