  "ingredients": [
    "0.5 pound fettuccine",
    "0.25 cup butter",
    "2 cloves garlic, minced",
    "0.25 cup sliced smoked sausage",
    "2 roma tomatoes, diced",
    "1 cup broccoli florets",
    "0.5 green bell pepper, chopped",
    "4 mushrooms, sliced",
    "3 green onions, chopped",
    "1 cup cubed cooked chicken breast",
    "0.5 pound medium shrimp, peeled and deveined",
    "0.25 cup white wine",
    "2 teaspoons Cajun seasoning",
    "0.75 cup milk",
    "0.25 cup grated Parmesan cheese",
    "fresh ground black pepper to taste",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a rolling boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Boil fettuccine until cooked through yet firm to the bite, about 8 minutes; drain and transfer pasta to a large serving bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter and garlic in a large skillet over medium-high heat; stir in sausage, tomatoes, broccoli, bell pepper, mushrooms, and green onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir until sausage is browned and vegetables are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chicken, shrimp, white wine, cajun seasoning, milk, and 1/4 cup Parmesan cheese. Cook and stir shrimp until they are bright pink on the outside and meat is no longer transparent in the center, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve over pasta and sprinkle with pepper and 2 tablespoons Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
