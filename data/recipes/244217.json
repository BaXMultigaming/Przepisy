  "ingredients": [
    "1.5 pounds plum tomatoes, seeded and cut into small dice",
    "6 tablespoons extra-virgin olive oil, divided",
    "0.25 cup chopped fresh basil",
    "2 tablespoons finely chopped red onion",
    "2 large cloves garlic, minced",
    "2 teaspoons red wine vinegar",
    "freshly ground black pepper to taste",
    "1 French baguette, cut into 1/2-inch thick slices",
    "1 tablespoon high-quality balsamic vinegar, or to taste"
  ],
  "steps": [
    {
      "text": "Combine tomatoes, 3 tablespoons olive oil, basil, red onion, garlic, red wine vinegar, and pepper in a bowl; let stand at room temperature for 15 minutes, then marinate in the refrigerator for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush one side of Baguette slices with remaining 3 tablespoons olive oil; place, oiled-sides-up, onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil until golden brown, about 2 minutes",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon tomato mixture onto toasted Baguette slices; drizzle with balsamic vinegar. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
