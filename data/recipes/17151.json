  "title": "Old Italian Meat Sauce",
  "description": "This Italian meat sauce made with beef, pork, tomato, and mushroom, flavored with dried herbs and red wine, is a must at your next spaghetti dinner.",
  "authors": [
    "Debbie"
  ],
  "date_published": "2000-03-10T11:49:23-05:00",
