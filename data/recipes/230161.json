  "ingredients": [
    "Cooking spray",
    "2 tablespoons mayonnaise",
    "1 tablespoon lemon juice",
    "1 tablespoon barbeque sauce",
    "2 (7 ounce) red snapper fillets",
    "salt to taste",
    "cayenne pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil and lightly coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise, lemon juice, and barbeque sauce in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place red snapper fillets on the prepared baking sheet and season with salt. Spread the mayonnaise mixture over the top of each fillet and sprinkle with cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook under the preheated broil until top is browned and bubbling and fish flakes easily with a fork, rotating the baking sheet if necessary, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
