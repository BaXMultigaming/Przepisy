  "ingredients": [
    "12 fresh blueberries",
    "3 small fresh strawberries, chopped",
    "1 flat-bottom ice cream cone",
    "2 tablespoons whipped topping, or to taste",
    "1 teaspoon sprinkles, or to taste"
