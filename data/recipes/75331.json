  "ingredients": [
    "2.75 cups all-purpose flour",
    "0.25 cup soy flour",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "0.5 cup silken tofu",
    "1 cup brown sugar",
    "3 eggs",
    "0.5 cup honey",
    "0.5 cup walnut oil",
    "1 teaspoon almond extract",
    "2.5 cups grated zucchini",
    "0.5 cup crushed pineapple, drained",
    "0.5 cup chopped walnuts",
    "0.5 cup ground flax seed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk all-purpose flour, soy flour, cinnamon, salt, baking soda, and baking powder together in a bowl until blended; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tofu in a blender; blend until smooth. Transfer to a bowl; beat in brown sugar, eggs, honey, walnut oil, and almond extract until smooth. Stir in flour mixture until just moistened; stir in zucchini, pineapple, walnuts, and flax seeds until combined. Divide batter between two 8x4-inch ungreased loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Cool in the pans on a wire rack before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
