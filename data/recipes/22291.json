  "ingredients": [
    "4 cups cooked, chopped turkey meat",
    "1 (6 ounce) package dry bread stuffing mix",
    "12 potatoes, peeled and chopped",
    "2 cups turkey gravy"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes. Drain and mash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare stuffing as directed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the stuffing in a 2 quart baking dish. Layer with turkey and cover with 1 cup gravy. Top with mashed potatoes and the remaining gravy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake covered in the preheated oven 45 minutes, or until bubbly and lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
