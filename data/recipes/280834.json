  "ingredients": [
    "cooking spray",
    "0.75 pound ground turkey",
    "0.75 pound lean ground beef",
    "1 small onion, chopped",
    "1 cup milk",
    "1 cup seasoned bread crumbs",
    "1 large egg",
    "1 teaspoon dried rosemary",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.33333334326744 cup ketchup",
    "2 tablespoons brown sugar",
    "2 tablespoons prepared yellow mustard"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 9x13-inch loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground turkey, ground beef, onion, milk, bread crumbs, egg, rosemary, salt, and pepper in a mixing bowl. Press into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk ketchup, brown sugar, and mustard together in a separate bowl; pour over meatloaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into the center reads at least 165 degrees F (74 degrees C), about 1 hour. It's best to let rest for at least 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
