  "ingredients": [
    "0.5 cup unsalted butter, softened",
    "0.5 cup brown sugar",
    "5 tablespoons white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.75 cup old-fashioned rolled oats",
    "0.5 cup dried blueberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together with an electric mixer in a bowl until creamy and smooth, about 2 minutes. Add egg and vanilla extract; mix until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cinnamon, baking soda, baking powder, and salt in a separate bowl; mix into butter mixture until just combined. Fold in oats and blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon dough, about 1 tablespoon per cookie, onto the prepared baking sheets about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 1 sheet at a time in the preheated oven until cookies are golden brown, about 12 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
