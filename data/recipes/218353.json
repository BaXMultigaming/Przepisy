  "title": "LaVohn's Beef Stew",
  "description": "Red wine adds depth of flavor to this comforting beef stew that's simmered for hours.",
  "authors": [
    "LaVohn Crabtree"
  ],
  "date_published": "2020-03-09T22:51:38-04:00",
