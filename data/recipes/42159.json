  "ingredients": [
    "6 tablespoons butter",
    "1.5 cups brown sugar",
    "4.5 tablespoons lemon juice",
    "2.25 teaspoons dried dill weed",
    "0.75 teaspoon ground cayenne pepper",
    "1 pound salmon fillets, with skin",
    "lemon pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butter in a saucepan over medium heat, and mix in the brown sugar, lemon juice, dill, and cayenne pepper. Cook and stir until the brown sugar is dissolved. Reduce heat and simmer until ready to brush onto the salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season salmon with lemon pepper, and place directly on the grill grate, skin side down. Brushing frequently with the butter and brown sugar glaze, cook the salmon 20 minutes, or until easily flaked with a fork. Reserve some of the glaze for serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
