  "ingredients": [
    "4 cups trimmed heirloom green beans (such as Kentucky Wonder Beans)",
    "1 slice bacon",
    "1 teaspoon olive oil, or as needed",
    "1 clove garlic, minced",
    "0.5 teaspoon sea salt",
    "1 pinch coarsely ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Pour about 1 inch water into a large saucepan. Add green beans, bacon, olive oil, garlic, sea salt, and black pepper; bring to a boil. Reduce heat to medium, cover, and cook until beans are tender, 7 to 10 minutes.",
