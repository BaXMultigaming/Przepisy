  "title": "Brownie-Blasted Cookies",
  "description": "This recipe mixes a chocolate chip cookie dough with brownie batter for a combination of two classic treats in one delicious cookie.",
  "authors": [
    "mamaiscookin"
  ],
  "date_published": "2020-06-19T00:02:38-04:00",
