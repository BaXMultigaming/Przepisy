  "ingredients": [
    "1.5 cups white sugar",
    "0.5 cup butter",
    "0.5 cup shortening",
    "0.5 cup water",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.5 cup flaxseed meal",
    "0.33333334326744 cup unsweetened cocoa powder",
    "0.25 cup brewers' yeast",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking soda",
    "3 cups quick-cooking oats",
    "1 cup chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, and shortening together in a bowl using an electric mixer until creamy. Add water, egg, and vanilla extract and mix well. Add flour, flaxseed meal, cocoa powder, yeast, salt, and baking soda. Mix well. Fold oats, chocolate chips, and walnuts into the dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded teaspoonfuls about 2 inches apart on ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 12 minutes. Let cool for 5 minutes; transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
