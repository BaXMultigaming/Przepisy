  "ingredients": [
    "1 medium head cabbage, cored and shredded",
    "1 medium onion, finely chopped",
    "1 cup white sugar",
    "1 cup vinegar",
    "0.75 cup vegetable oil",
    "1 teaspoon celery seed",
    "1 teaspoon salt",
    "1 teaspoon prepared mustard",
    "1/4 teaspoon black pepper"
  ],
