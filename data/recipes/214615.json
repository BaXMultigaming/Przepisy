  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon salt",
    "1 cup white sugar",
    "0.5 cup butter",
    "1 egg",
    "1 cup chopped rhubarb",
    "0.5 cup raisins",
    "0.5 cup chopped nuts",
    "3 tablespoons flax seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, baking powder, cinnamon, cloves, and salt in a medium bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together sugar and butter with an electric mixer in a large bowl until smooth. Beat in egg until completely blended, then stir in rhubarb. Mix in flour mixture until just incorporated. Fold in raisins, nuts, and flax seeds, mixing just enough to evenly combine. Drop spoonfuls of dough 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 12 to 15 minutes. Cool on the baking sheets for 10 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
