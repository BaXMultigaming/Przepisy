  "steps": [
    {
      "text": "Place mushrooms, tomatoes, zucchini, bell peppers, squash, and red onion into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together olive oil, soy sauce, lemon juice, and garlic in a small bowl. Pour over vegetables; toss to coat. Cover the bowl and marinate in the refrigerator for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
