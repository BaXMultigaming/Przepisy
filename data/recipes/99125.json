  "ingredients": [
    "2 tablespoons olive oil",
    "2 tablespoons sesame oil",
    "1 teaspoon minced fresh ginger root",
    "1 bunch asparagus stalks, ends cut",
    "0.5 cup chopped cashews",
    "1 tablespoon soy sauce"
  ],
  "steps": [
    {
      "text": "Heat olive oil and sesame oil in a wok over low to medium heat. Add ginger and stir-fry until slightly brown. Add asparagus and stir-fry for 2 to 3 minutes. Add cashews and soy sauce. Cook, stirring frequently, until asparagus is tender but still crisp and bright green.",
