  "title": "Bangin&#39; Banana Bread",
  "description": "This is a loaf with the pure taste of bananas and the toasty crunch of macadamia nuts.",
  "authors": [
    "dad_can_cook"
  ],
  "date_published": "2020-06-18T23:40:47-04:00",
