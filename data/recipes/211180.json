  "ingredients": [
    "0.5 cup butter, at room temperature",
    "0.5 cup white sugar",
    "2 eggs, at room temperature",
    "2.5 cups pureed ripe bananas",
    "1.25 teaspoons baking soda",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon kosher salt",
    "0.5 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "0.5 cup coarsely chopped macadamia nuts"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, beat the butter and sugar together with an electric mixer until thoroughly blended. Beat in the eggs, one at a time, and add the bananas, baking soda, baking powder, salt, and vanilla extract. Stir in the flour by hand until barely combined, and gently fold the macadamia nuts into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the batter into the prepared pan, and bake on the oven's middle shelf until a toothpick or cake tester inserted in the middle of the loaf comes out clean, 60 to 65 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven, and let the loaf rest for 10 minutes before turning out from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
