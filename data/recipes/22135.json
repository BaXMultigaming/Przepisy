  "ingredients": [
    "3 eggs",
    "1 cup applesauce",
    "0.5 cup vanilla fat-free yogurt",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "0.5 cup rolled oats",
    "1 teaspoon ground cinnamon",
    "3 cups bread cubes",
    "2 apples - peeled, cored and chopped",
    "0.25 cup brown sugar",
    "0.25 cup all-purpose flour",
    "2 tablespoons butter",
    "1 (9 inch) unbaked 9 inch pie crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium mixing bowl stir together eggs, applesauce, yogurt, white sugar, 1/2 cup brown sugar, oats, and cinnamon. Stir in bread and apples. Pour into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl stir 1/4 cup brown sugar and flour. Cut in butter until mixture resembles coarse crumbs. Sprinkle on top of pie filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 1 hour or until top is golden and fruit is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
