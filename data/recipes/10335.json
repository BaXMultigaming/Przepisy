  "ingredients": [
    "2 cups peanut butter",
    "2 cups white sugar",
    "4 eggs",
    "2 cups semisweet chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine peanut butter, sugar and eggs. Mix well with wooden spoon till smooth and well-blended. Stir in chocolate chips and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by rounded tablespoonfuls on ungreased cookie sheets two inches apart. Bake 10 to 12 minutes or till lightly browned. Cool on cookie sheets for a few minutes than transfer to wire rack. Cool completely. Store in airtight containers up to a week",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
