  "ingredients": [
    "0.75 cup red wine",
    "0.25 cup water",
    "10 cloves garlic, chopped",
    "1 tablespoon chile paste",
    "0.5 teaspoon white pepper",
    "0.5 teaspoon salt",
    "6 (4 ounce) beef tenderloin steaks",
    "0.33333334326744 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "In a medium bowl, combine red wine, water, garlic, chile paste, white pepper and salt. Add beef, and turn to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large heavy skillet over medium heat, fry 3 steaks for 2 minutes on each side; Set steaks aside, and drain liquids into the red wine mixture. Repeat with remaining beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour oil into skillet, and reduce heat to medium-low. Fry steaks for a second time, 2 minutes on each side. Drain oil, and return all steaks and marinade to the pan. Allow to boil for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
