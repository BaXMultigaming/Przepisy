  "title": "Sesame Anise Melts",
  "description": "This is an Italian cookie. Shaped in balls and rolled in sesame seeds. Flavored with anise.",
  "authors": [
    "Candy"
  ],
  "date_published": "2000-01-24T12:01:33-05:00",
