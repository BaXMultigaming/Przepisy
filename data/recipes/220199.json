  "ingredients": [
    "1 pound fresh asparagus, trimmed",
    "1 tablespoon olive oil, or more if needed",
    "1 tablespoon lemon juice, or more if needed",
    "salt and ground black pepper to taste",
    "0.25 cup grated Parmesan cheese, plus extra for topping"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place asparagus in a large, shallow bowl. Drizzle with olive oil and lemon juice, going from bottom to top of stalks. Season with salt and pepper. Sprinkle Parmesan cheese over asparagus; lightly toss to coat each spear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use tongs to transfer coated asparagus to the preheated grill. Grill to desired tenderness, 3 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove asparagus from the grill and place onto a serving plate. Sprinkle with additional Parmesan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
