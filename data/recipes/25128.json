  "ingredients": [
    "2 cups white sugar",
    "1 cup unsalted butter, softened",
    "2 large eggs",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "0.75 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.6660000085831 cups white chocolate chips"
  ],
  "steps": [
    {
