  "ingredients": [
    "2 slices bacon",
    "0.5 large onion, minced",
    "1 clove garlic, minced",
    "1 cup ketchup",
    "0.25 cup molasses",
    "2 tablespoons packed brown sugar",
    "2 tablespoons cider vinegar",
    "2 tablespoons Worcestershire sauce",
    "2 tablespoons Dijon mustard",
    "2 teaspoons liquid smoke",
    "1 teaspoon chili powder",
    "1 teaspoon hot sauce (such as Cholula®)",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tsh_ptx5GPiuXHjcqMtFnI9_kYU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Bacon-and-Onion-BBQ-Sauce-DDMFS-Step-01-15999-d0d6f596cd7a44e2b379f6e3dcd94de4.jpg"
      ],
      "image": "assets/images/279305/step_01.webp"
    },
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Add onion; reduce heat to medium-low. Cook until very soft and almost mushy, 7 to 10 minutes. Add garlic; cook until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tYUX28CVJv2F3M4BXum0hjdj4eg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Bacon-and-Onion-BBQ-Sauce-DDMFS-Step-02-16000-af45b1f172d24b60bede6dc56dcb3f97.jpg"
      ],
      "image": "assets/images/279305/step_02.webp"
    },
    {
      "text": "Stir in ketchup, molasses, brown sugar, cider vinegar, Worcestershire sauce, Dijon mustard, liquid smoke, hot sauce, and black pepper; bring to a simmer, cover, and cook for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
