  "ingredients": [
    "1 tablespoon vegetable oil",
    "0.5 cup finely chopped onion",
    "0.5 cup finely chopped celery",
    "0.25 cup finely chopped green pepper",
    "1 cup Heinz Tomato Ketchup",
    "1.5 pounds lean ground beef",
    "1 cup soft, fresh breadcrumbs",
    "1 large egg, slightly beaten",
    "0.5 teaspoon salt",
    "0.25 teaspoon pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Lightly grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook and stir onion, celery, and green pepper in hot oil until softened, about 5 minutes. Stir in ketchup to make a sauce. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 of the sauce with ground beef, bread crumbs, beaten egg, salt, and pepper in a large bowl; mix gently. Pat mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an instant-read thermometer reads 160 degrees F (70 degrees C), about 1 hour. Remove from the oven and let rest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, reheat remaining sauce over medium heat. Slice meatloaf and serve with warm sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
