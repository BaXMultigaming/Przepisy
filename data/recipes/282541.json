  "ingredients": [
    "4 cups shredded cooked chicken",
    "4 stalks celery, minced",
    "2 large carrots, peeled and minced",
    "1 cup mayonnaise",
    "0.25 cup sweet relish",
    "1 tablespoon spicy brown mustard",
    "0.5 medium lemon, juiced",
    "0.75 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Combine chicken, celery, carrots, mayonnaise, relish, mustard, lemon juice, salt, and black pepper in a bowl. Chill in the refrigerator before serving, at least 1 hour.",
