  "ingredients": [
    "0.5 gallon milk",
    "1 cup white sugar",
    "1 cup uncooked long-grain white rice",
    "3 eggs, lightly beaten",
    "0.25 cup milk",
    "2 teaspoons vanilla extract",
    "0.25 teaspoon salt",
    "ground cinnamon to taste"
  ],
  "steps": [
    {
      "text": "Combine 1/2 gallon milk, sugar, and rice in a large saucepan over medium-low heat. Simmer, covered, for 1 hour, stirring frequently. Remove the pan from heat and let sit for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UkS2f7k_TccFbzUwntJx3K9Dbrk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/27131-creamiest-rice-pudding-step-1-01-1-f764491e34034007bfbd4d57a3230796.jpg"
      ],
      "image": "assets/images/27131/step_01.webp"
    },
    {
      "text": "Whisk together eggs, 1/4 cup milk, vanilla, and salt in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dVRi3JCq1WJVAFyVomhxIa8XYGo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/27131-creamiest-rice-pudding-step-2-71-1-d8ae08875ec34e658b02a8dc98b45a80.jpg"
      ],
      "image": "assets/images/27131/step_02.webp"
    },
    {
      "text": "Stir into rice mixture and return the pan to low heat, stirring constantly, for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fujukUjUnjCZMn4w831DUn93MZg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/27131-creamiest-rice-pudding-step-3-72120-1-3da887c478b1413abec3929afccef39c.jpg"
      ],
      "image": "assets/images/27131/step_03.webp"
    },
    {
      "text": "Pour pudding into a 9x13-inch dish and cover with plastic wrap, folding back the corners to allow steam to escape. Allow pudding to cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6WUZcprYlfISkCv2mg82OYz7edg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/27131-creamiest-rice-pudding-step-4-72123-1-287d34eb2cda44868976c71d92b1653d.jpg"
      ],
      "image": "assets/images/27131/step_04.webp"
    },
    {
      "text": "Remove plastic wrap and sprinkle the surface of pudding with cinnamon. Cover tightly with fresh plastic wrap and refrigerate for 8 hours to overnight before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
