  "ingredients": [
    "1 cup all-purpose flour",
    "0.75 teaspoon salt",
    "0.5 teaspoon baking powder",
    "0.75 cup milk",
    "2 tablespoons milk",
    "1 large egg",
    "1 tablespoon melted unsalted butter",
    "1 tablespoon unsalted butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r3sBowXmWi_NXwVD8rFvKzZGBYM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260537-easy-blini-russian-pancake-DDMFS-4x3-step-01-5ca6e54744a64065b3168ce0d846618f.jpg"
      ],
      "image": "assets/images/260537/step_01.webp"
    },
    {
      "text": "Combine flour, salt, and baking powder in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8_PVxd7jCxpIERIbYElY-unWhbs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260537-easy-blini-russian-pancake-DDMFS-4x3-step-02-1804d4456b084613af08ca817dbb18ff.jpg"
      ],
      "image": "assets/images/260537/step_02.webp"
    },
    {
      "text": "Whisk 3/4 cup plus 2 tablespoons milk, egg, and 1 tablespoon melted butter together in a separate bowl. Mix into the flour mixture until the batter is fully combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Sxxr85e-59K7w7JgP-uGvS4AfLU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260537-easy-blini-russian-pancake-DDMFS-4x3-step-03-ee8994cf56314c5494d340d2b94b9b62.jpg"
      ],
      "image": "assets/images/260537/step_03.webp"
    },
    {
      "text": "Heat 1 tablespoon butter in a large skillet over medium-low heat. Cooking several blini at a time, drop batter, one tablespoon at a time, onto the heated skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wuT8xgDzGi2JZKXutnTfZ0uZdTc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260537-easy-blini-russian-pancake-DDMFS-4x3-step-04-9a3090a10d4944198d8a4207eb83afcd.jpg"
      ],
      "image": "assets/images/260537/step_04.webp"
    },
    {
      "text": "Cook until bubbles form, 1 1/2 to 2 minutes. Flip and continue cooking until brown, about 1 minute more. Move to a paper towel-lined plate to help soak up excess butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ipAqFONagUEjCxpT9k9PG8PJZZ0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-260537-easy-blini-russian-pancake-DDMFS-4x3-step-05-90371c2ed7f64e6fa0a65796e7866638.jpg"
      ],
      "image": "assets/images/260537/step_05.webp"
    },
    {
      "text": "Repeat with the remaining batter.",
      "section": null,
      "name": null,
      "url": null,
