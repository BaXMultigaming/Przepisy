  "ingredients": [
    "3 cups cake flour",
    "1.5 teaspoons baking powder",
    "0.75 teaspoon salt",
    "1.5 cups white sugar",
    "0.5 cup unsalted butter, softened",
    "2 large eggs, at room temperature",
    "1.25 cups sour cream, at room temperature",
    "1 tablespoon vanilla extract",
    "0.5 teaspoon almond extract",
    "1 cup sweetened shredded coconut",
    "1 cup finely chopped white chocolate",
    "1 (8 ounce) package cream cheese, at room temperature",
    "0.25 cup unsalted butter, softened",
    "1 teaspoon vanilla extract",
    "1/2 teaspoon coconut extract",
    "1 pinch salt",
    "2 tablespoons heavy cream",
    "2.5 cups powdered sugar",
    "2 cups sweetened shredded coconut"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yuUD8VDLBEBNga4iZN7KWktRUwE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8535279-tom-cruise-cake-mfs-step1-3x4-1869-1378b991e89a442a8495d2c2fd401654.jpg"
      ],
      "image": "assets/images/8535279/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/te7EabVYONoWy7qELxh8MZ2TgsE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8535279-tom-cruise-cake-mfs-step1-3x4-1871-bcf2bccb847c4a95812d667ab8fedf31.jpg"
      ],
      "image": "assets/images/8535279/step_02.webp"
    },
    {
      "text": "Combine flour, baking powder, and ¾ teaspoon salt in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nuSXp1Dm1QvvS1lF6sN3iuB0fSo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8535279-tom-cruise-cake-mfs-step2-3x4-1873-a169f766951a4d22a90b803b3031c5f5.jpg"
      ],
      "image": "assets/images/8535279/step_03.webp"
    },
    {
      "text": "Beat white sugar and 1 cup butter together in a large bowl with an electric mixer on medium until light and fluffy, about 5 minutes; beat in eggs, one at a time, beating well after each addition. Beat in sour cream, 1 ½ teaspoons vanilla extract, and 1 teaspoon coconut extract until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zngJbHHpxUm19t_i2XvQawSCXE0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8535279-tom-cruise-cake-mfs-step5-3x4-1895-18a7b3b795b04d988f0a732ebed96795.jpg"
      ],
      "image": "assets/images/8535279/step_04.webp"
    },
    {
      "text": "Mix in flour mixture until just combined; fold in 1 ¼ cups flaked coconut and white chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FL5C7PBSfcgn2hkBGYgChv_KCmE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8535279-tom-cruise-cake-mfs-step7-3x4-1902-d1203630261143f19e1bde665a4bd3f8.jpg"
      ],
      "image": "assets/images/8535279/step_05.webp"
    },
    {
      "text": "Transfer cake batter to the prepared pan; spread batter evenly using the back of a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GYEW6vJdRMV59TJmdwuag6jvWVY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8535279-tom-cruise-cake-mfs-step8-3x4-1906-a3026e51bbf8466e9d26bc64b77bef78.jpg"
      ],
      "image": "assets/images/8535279/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour 25 minutes. Cool cake in the pan for 20 minutes before inverting onto a wire rack to cool completely, about 2 hours more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wj3rVLTPVEcHAuG2V-xjtudh8FA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8535279-tom-cruise-cake-mfs-step10-3x4-1910-825afa5f00054a07979dc908b5f7e518.jpg"
      ],
      "image": "assets/images/8535279/step_07.webp"
    },
    {
      "text": "Beat cream cheese, ¼ cup butter, 1 teaspoon vanilla extract, ½ teaspoon coconut extract, and ⅛ teaspoon salt in a medium bowl with an electric mixer until smooth; gradually beat in confectioners' sugar until incorporated. Beat in cream until frosting is light and fluffy, about 1 or 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v_ORnPe40eMVeVx6rgo-7e1y7lI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8535279-tom-cruise-cake-mfs-step14-3x4-1918-dcd99d15a2a14d63b0cf03f566befdd0.jpg"
      ],
      "image": "assets/images/8535279/step_08.webp"
    },
    {
      "text": "Frost top and sides of cake; lightly press 1 ½ cups flaked coconut evenly around frosted cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lJswJRh6ORGTFQaKdQLv0sWFy8c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8535279-tom-cruise-cake-mfs-step15-3x4-1926-5db5b15051c14fea8b9da6e56f1db3f7.jpg"
      ],
      "image": "assets/images/8535279/step_09.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6oD7mtUTQbY9cklKkjcbcb2zn5Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8535279-tom-cruise-cake-mfs-3x4-2060-c737031fe5a34ff2b9277d25065c4a8d.jpg"
      ],
      "image": "assets/images/8535279/step_10.webp"
    }
