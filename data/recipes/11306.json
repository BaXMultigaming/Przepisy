  "ingredients": [
    "2 cups white sugar",
    "1 cup unsweetened cocoa powder",
    "1 cup all-purpose flour",
    "0.5 cup melted butter",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "0.25 teaspoon salt",
    "0.33333334326744 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Line a 9x13-inch pan with greased parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sugar, cocoa, flour, melted butter, eggs, vanilla, and salt in a large bowl. Mix until well combined; it will be thick and sticky. Spread brownie batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Cool completely; cut into squares and dust with confectioners’ sugar.",
      "section": null,
