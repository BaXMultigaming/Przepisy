  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "1 tablespoon baking powder",
    "1 teaspoon nutmeg",
    "0.5 teaspoon salt",
    "0.5 cup walnuts, chopped",
    "1 cup eggnog",
    "0.33333334326744 cup butter, melted",
    "0.25 cup rum",
    "1 egg, beaten",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line 12 muffin cups with paper liners or grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, nutmeg, and salt in a large bowl; mix in walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggnog, melted butter, rum, egg, and vanilla extract in a separate bowl; stir into flour mixture until just moistened, forming a lumpy batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into prepared muffin cups and bake in preheated oven until a toothpick inserted into the center comes out clean, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
