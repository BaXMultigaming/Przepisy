  "ingredients": [
    "1 cup warm water",
    "1 tablespoon warm water",
    "2 tablespoons margarine",
    "3 cups bread flour",
    "2 tablespoons dry milk powder",
    "2 tablespoons white sugar",
    "1.5 teaspoons salt",
    "2 teaspoons active dry yeast",
    "1 cup shredded sharp Cheddar cheese",
    "3 tablespoons dried minced onion, divided",
    "2 teaspoons garlic powder"
  ],
  "steps": [
    {
      "text": "Place 1 cup plus 1 tablespoon warm water, margarine, bread flour, milk powder, sugar, salt, and yeast into a bread machine in the order listed. Run White cycle. When the machine beeps indicating it’s time to add remaining ingredients, add Cheddar cheese, 2 tablespoons dried onion, and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When the final knead cycle is complete, sprinkle remaining 1 tablespoon dried onion over loaf and close the lid. Remove loaf from the machine after the full cycle is done; total time should be about 2 hours 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
