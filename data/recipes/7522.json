  "ingredients": [
    "1 cup butter",
    "2 cups white sugar",
    "4 eggs",
    "1 cup buttermilk",
    "1 teaspoon vanilla extract",
    "3 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1 pinch salt",
    "1 teaspoon rum flavored extract",
    "1 cup butter",
    "1 cup white sugar",
    "0.5 cup rum"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour one 9 or 10 inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream 1 cup of the butter and 2 cups of the white sugar together. Add eggs one at a time mixing well after each one.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift the flour, baking powder, baking soda, and salt together and add alternately with the buttermilk to the egg mixture. Stir in the vanilla and rum extracts. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour. Remove cake from oven and pour all of the Rum Butter glaze over cake while still warm. Leave cake in pan for 2 hours before removing to serving dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Butter Rum Glaze: Melt the remaining 1 cup of the butter and 1 cup of white sugar over low heat. Remove from heat and stir in rum. Use immediately to glaze cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
