  "title": "Rum Cake II",
  "description": "This makes a tube pan cake that is moist and delicious. It's the rum glaze that soaks in after baking that makes it fabulous!",
  "authors": [
    "Brenda Benzar Butler"
  ],
  "date_published": "1998-05-13T00:01:25-04:00",
