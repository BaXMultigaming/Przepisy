  "ingredients": [
    "0.25 cup extra-virgin olive oil",
    "1 tablespoon lime juice",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon ground cumin",
    "1.5 cups water",
    "1 cup dry quinoa (such as Quinta®)",
    "0.5 teaspoon kosher salt",
    "1 (15 ounce) can black beans, drained and rinsed",
    "1 (15 ounce) can yellow corn kernels, drained and rinsed",
    "0.5 cup finely chopped red bell pepper",
    "0.5 cup finely chopped red onion",
    "0.5 cup finely chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Make dressing: Whisk together olive oil, lime juice, salt, pepper, and cumin in a large serving bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make salad: Bring water, quinoa, and salt to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cooked quinoa into the serving bowl with dressing. Add beans, corn, bell pepper, onion, and cilantro. Mix with a large spoon or wide spatula until combined.",
      "section": null,
      "name": null,
      "url": null,
