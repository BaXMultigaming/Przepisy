  "ingredients": [
    "2 tablespoons olive oil",
    "3 eggs",
    "2 egg whites",
    "0.5 cup milk",
    "1 cup all-purpose flour",
    "2 tablespoons cold water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Drop 1 teaspoon olive oil each into 6 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, egg whites, and milk together in a glass bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat egg mixture in microwave oven until warmed, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour into the egg mixture until completely incorporated into a batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat muffin cups in preheated oven until the oil is smoking, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cold water into batter. Pour 1/4 cup batter into each muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until risen and cooked in their centers, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
