  "ingredients": [
    "1 cup milk",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "2 cups frozen whipped topping, thawed",
    "0.25 teaspoon coconut extract",
    "2 pounds whole strawberries, stems removed"
  ],
  "steps": [
    {
      "text": "Whisk milk and pudding mix together in a bowl until smooth and thickened, 2 minutes. Fold in whipped topping and coconut extract. Chill in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a straw to poke a hole in each strawberry, from top to bottom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pudding mixture to a piping bag fitted with a star tip. Cover the bottom hole of a strawberry with one fingertip, then fill the strawberry with pudding mixture. Refrigerate before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
