  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 cup butter, softened",
    "0.5 cup white sugar",
    "1 cup packed brown sugar",
    "2 eggs",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon vanilla extract",
    "5 ounces maraschino cherries",
    "0.5 cup chopped walnuts",
    "1.5 cups powdered sugar",
    "1.5 tablespoons butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch pan with heavy aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, 1 cup butter, and white sugar together until mixture is crumbly. Press into the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend brown sugar, eggs, salt, baking powder, and vanilla extract together in a bowl. Drain and chop cherries, reserving the liquid. Stir cherries and walnuts into the egg mixture. Place mixture on top of the baked crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake until set, about 25 minutes. Remove from the oven and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine powdered sugar and 1 1/2 tablespoons butter with enough cherry liquid to spread easily. Frost cooled bars. Cut into squares after icing has set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
