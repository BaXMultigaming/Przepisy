  "ingredients": [
    "1 (8 pound) pork shoulder roast",
    "1 quart apple cider, or as needed",
    "5 tablespoons white sugar",
    "5 tablespoons light brown sugar",
    "2 tablespoons kosher salt",
    "2 tablespoons paprika",
    "1 tablespoon onion powder",
    "1 tablespoon freshly ground black pepper",
    "1 tablespoon garlic powder",
    "3 cups hickory chips, or more as needed, soaked in water",
    "1 onion, chopped"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uxjROopKQ-czfLQPmNmbtkM3xvI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236104-bobs-pulled-pork-on-a-smoker-01-86c5751c08bf430e85eebd622cf082a6.jpg"
      ],
      "image": "assets/images/236104/step_01.webp"
    },
    {
      "text": "Place pork shoulder in a large pot and add enough apple cider to cover. Combine white sugar, brown sugar, salt, paprika, onion powder, black pepper, and garlic powder in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uqXb1OAsh3C4LFII_QzsTfTI-bE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236104-bobs-pulled-pork-on-a-smoker-02-4bb76eb192304efba33a5466a5c75383.jpg"
      ],
      "image": "assets/images/236104/step_02.webp"
    },
    {
      "text": "Mix 1/4 cup of sugar rub into cider; reserve remaining rub. Cover the pot and refrigerate for 12 hours. Preheat the smoker to 210 degrees F (99 degrees C). Add enough wood chips to the smoker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yBcb88AphoTihG8-QSZ7pobH_Eg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236104-bobs-pulled-pork-on-a-smoker-03-e80758ee03324ac2acf9002d42429918.jpg"
      ],
      "image": "assets/images/236104/step_03.webp"
    },
    {
      "text": "Pour cider brine into the water pan of the smoker; add onion and 1/4 cup more sugar rub.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uYy88YCPYOgQYQumyenLWTmGw1s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236104-bobs-pulled-pork-on-a-smoker-04-0eecf64f09c543159aad9272a8c04e64.jpg"
      ],
      "image": "assets/images/236104/step_04.webp"
    },
    {
      "text": "Spread remaining sugar rub over pork shoulder. Transfer pork to the center of the smoker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tcjF4YAuouwdy2q-rdExiRlYpEs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236104-bobs-pulled-pork-on-a-smoker-05-65557061cc14431fb3c1f447e1f10940.jpg"
      ],
      "image": "assets/images/236104/step_05.webp"
    },
    {
      "text": "Smoke pork until very tender or until it reaches an internal temperature of 200 degrees F (95 degrees C), about 8 hours. Monitor hickory chips and liquid, adding more as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iTgx6_KGbmyc_k1r9tnfnhBBqwg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236104-bobs-pulled-pork-on-a-smoker-06-257130bbd67b4977aeb77449780c50bf.jpg"
      ],
      "image": "assets/images/236104/step_06.webp"
    },
    {
      "text": "Transfer pork to a large platter and let it rest for 30 minutes before shredding with forks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qQYTt681QNaOmizsM9ykYDv--6g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236104-bobs-pulled-pork-on-a-smoker-hero-4x3-bd2d585e1bed4f5ea64028528dab8004.jpg"
      ],
      "image": "assets/images/236104/step_07.webp"
    }
