  "ingredients": [
    "0.75 cup panko bread crumbs",
    "0.75 cup freshly grated Parmesan cheese",
    "0.25 cup prepared fresh basil pesto",
    "1 large egg",
    "2 tablespoons milk",
    "2 tablespoons ricotta cheese",
    "0.5 teaspoon Italian seasoning",
    "0.5 teaspoon salt",
    "0.25 teaspoon pepper",
    "0.25 teaspoon granulated garlic",
    "1 pound ground turkey"
  ],
  "steps": [
    {
      "text": "Combine panko, Parmesan cheese, pesto, egg, milk, ricotta cheese, Italian seasoning, salt, pepper, and garlic in a large bowl; mix together. Add ground turkey and lightly fold into the mixture--the more you mix the tougher it will be.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the air fryer to 375 degrees F (190 degrees C) for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape ground turkey mixture into 1-1/2 inch meatballs and place into the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook meatballs in the air fryer until cooked through, 8 to 10 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
