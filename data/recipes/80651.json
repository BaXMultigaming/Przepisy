  "ingredients": [
    "1 tablespoon olive oil",
    "2 pounds bone-in chicken pieces",
    "1 large onion, finely chopped",
    "1 small carrot, finely chopped",
    "2 cloves garlic, finely chopped",
    "1 (14 ounce) can chicken broth",
    "0.75 cup dried lentils",
    "0.5 teaspoon salt",
    "1 (10 ounce) can tomato sauce",
    "0.5 teaspoon dried rosemary",
    "0.5 teaspoon dried basil",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Add chicken; cook until juices run clear, 5 minutes on each side. Transfer chicken to a plate; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion to the skillet; cook until tender, 5 minutes. Stir in carrot and garlic, then stir in broth and lentils; season with salt. Bring to a boil, cover, reduce heat to low, and simmer 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return chicken to skillet. Cover, and continue cooking 20 minutes more. If mixture becomes too dry, add a little water just to moisten.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomato sauce; season with rosemary and basil. Continue cooking until lentils tender, 10 minutes more. Stir in lemon juice. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
