  "ingredients": [
    "10 large hard-boiled eggs, peeled and halved lengthwise",
    "0.5 (8 ounce) package cream cheese, softened",
    "2 tablespoons mayonnaise",
    "0.5 teaspoon garlic powder",
    "4 slices cooked bacon, crumbled, divided",
    "1 small jalapeno pepper, seeded and diced",
    "1 pinch salt and ground black pepper to taste",
    "1 pinch paprika"
  ],
  "steps": [
    {
      "text": "Spoon egg yolks into a bowl. Add cream cheese, mayonnaise, and garlic powder; mix well. Fold 3 crumbled slices of bacon and jalapeno pepper into egg yolk mixture; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each egg white half with egg yolk filling. Sprinkle remaining crumbled bacon over filling and top with paprika. Chill in refrigerator for about 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
