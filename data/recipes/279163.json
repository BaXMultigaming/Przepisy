  "ingredients": [
    "1 pound veal, scallopini cut",
    "2 tablespoons lemon juice",
    "salt and ground black pepper to taste",
    "0.25 cup all-purpose flour",
    "1 egg",
    "1 tablespoon chopped fresh parsley",
    "1 cup panko bread crumbs",
    "nonstick cooking spray",
    "1 lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place veal on a clean work surface and sprinkle with lemon juice, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour in a flat dish. Beat egg and parsley together in a second dish. Place bread crumbs in a third dish. Dredge each veal cutlet first in flour, then in egg-parsley mixture, followed by bread crumbs, pressing down so that bread crumbs adhere.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray the basket of the air fryer with nonstick cooking spray. Place breaded veal cutlets into the basket, making sure not to overcrowd. Spray the tops with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook for 5 minutes. Flip, spray any chalky spots with nonstick cooking spray, and cook for 5 minutes longer. Repeat with remaining veal. Serve with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
