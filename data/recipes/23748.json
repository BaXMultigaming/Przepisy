  "ingredients": [
    "0.75 cup butter, softened",
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "1 cup pecan halves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x8 inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the butter, brown sugar, and white sugar. Beat in the eggs and vanilla. Stir in the flour and pecans until just blended. Spread the mixture evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 to 40 minutes in the preheated oven, or until edges begin to pull away from the sides of the pan. Allow bars to cool in the pan before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
