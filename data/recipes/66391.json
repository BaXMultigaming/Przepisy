  ],
  "steps": [
    {
      "text": "Cook bacon in a large skillet over medium-high heat until just beginning to brown but still soft. Set aside until cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season halibut with pepper. Wrap 1 bacon piece around each halibut cube and secure with a toothpick. Place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook under the preheated broiler until fish is cooked through and bacon is crisp, about 5 minutes, turning halfway. Transfer to a platter and serve warm.",
