  "ingredients": [
    "cooking spray (such as Pam®)",
    "1 apple, cored and chopped",
    "salt to taste",
    "1 tablespoon lemon juice",
    "1 tablespoon raisins",
    "0.5 teaspoon ground cinnamon",
    "0.5 (1 gram) packet granular sucrolose sweetener (such as Splenda®), or more to taste",
    "0.25 cup water, or as needed"
  ],
  "steps": [
    {
      "text": "Heat a small skillet over low heat; spray with cooking spray. Add apple, season with salt, and cook until warmed through, 1 to 2 minutes. Sprinkle lemon juice over apples and toss to coat. Stir in raisins, cinnamon, and sweetener. Cook until apples are easily pierced with a fork, adding water if mixture is too dry, 5 to 7 minutes.",
