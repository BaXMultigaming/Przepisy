  "ingredients": [
    "1.5 pounds ground beef",
    "1.5 cups Italian seasoned bread crumbs",
    "1 cup chopped fresh spinach",
    "0.5 cup grated Parmesan cheese",
    "0.5 cup sour cream",
    "0.5 cup Italian salad dressing",
    "2 large eggs",
    "2 tablespoons Worcestershire sauce",
    "1 (1 ounce) package dry onion soup mix"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, bread crumbs, spinach, Parmesan cheese, sour cream, salad dressing, eggs, Worcestershire sauce, and soup mix together in a large bowl until well combined. Press mixture into a 9x5-inch loaf pan and cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Remove foil and continue to bake until no longer pink in the center, about 15 more minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let stand 5 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
