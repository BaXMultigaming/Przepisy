  "ingredients": [
    "2 large tomatoes, cut into 3/4-inch slices",
    "1 tablespoon olive oil",
    "0.5 teaspoon dried basil leaves",
    "0.5 teaspoon dried oregano",
    "1 clove garlic, minced",
    "salt and ground black pepper to taste",
    "0.33 cup soft bread crumbs",
    "0.33 cup shredded mozzarella cheese",
    "2 tablespoons grated Parmesan cheese",
    "1 dash balsamic vinegar"
  ],
  "steps": [
    {
      "text": "Place an oven rack 6 inches from the top of the oven, preheat the broiler, and and arrange tomato slices on a foil-lined baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil, basil, oregano, garlic, salt, and pepper in a bowl and brush onto the tops of the tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs, mozzarella cheese, and Parmesan cheese in a small bowl and sprinkle the mixture over the tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place under the broiler until topping starts to brown, 3 to 4 minutes, checking frequently to avoid burning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer tomatoes to a plate, drizzle with balsamic vinegar, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
