  "ingredients": [
    "1 pound lean ground beef",
    "1 (1.25 ounce) package McCormick® Chili Seasoning",
    "1 teaspoon McCormick® Ground Cinnamon",
    "1 (15 ounce) can tomato sauce",
    "0.5 cup shredded Cheddar cheese",
    "0.25 cup chopped onion"
  ],
  "steps": [
    {
      "text": "Brown ground beef in large skillet on medium-high heat until beef is no longer pink, about 5 minutes. Drain fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomato sauce, chili seasoning, and cinnamon into the skillet. Bring to boil. Reduce heat to low; simmer 10 minutes. Sprinkle with Cheddar cheese and onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
