  "ingredients": [
    "1 (3 pound) beef brisket",
    "2 (12 ounce) bottles chili sauce",
    "1 (1 ounce) envelope dry onion soup mix",
    "2 teaspoons garlic powder"
  ],
  "steps": [
    {
      "text": "Place beef brisket in a slow cooker. Whisk chili sauce, onion soup mix, and garlic powder together in a medium bowl; pour over brisket. Cover slow cooker.",
