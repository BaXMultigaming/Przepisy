  "ingredients": [
    "1 tablespoon olive oil",
    "6 (3.5 ounce) links Italian sausage, or to taste",
    "2 cloves garlic, chopped",
    "0.5 cup red wine",
    "1 (28 ounce) can diced tomatoes with spices",
    "1.5 cups chicken stock",
    "0.5 teaspoon cayenne powder",
    "2 cups bow-tie pasta (farfalle)",
    "0.5 cup chopped mushrooms",
    "0.25 cup chopped fresh parsley",
    "0.25 cup chopped fresh basil",
    "0.25 cup grated Romano cheese"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large skillet over medium-high heat. Add sausages and brown on all sides, 3 to 5 minutes. Add garlic; saute for a few seconds, until fragrant, but not burned. Add wine and cook, covered, until wine has reduced, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add diced tomatoes, chicken stock, and cayenne powder. Stir well, cover, and simmer for 5 minutes. Stir in uncooked pasta until well combined, cover, and cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add mushrooms, parsley, and basil. Cook, covered, until pasta is tender yet firm to the bite, 5 to 7 minutes. Remove from heat, transfer to a serving dish, and toss with Romano cheese. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
