  "ingredients": [
    "0.5 cup gluten-free oats",
    "1 scoop protein powder",
    "2 tablespoons brown sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking powder",
    "1 banana",
    "0.5 cup cottage cheese",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "water as needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat a griddle or large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wog5hh5HTehqgIjQ8VawhYjG6j8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239402-banana-oat-cottage-cheese-pancakes-VAT-005-step-01-893315439b134dfd9ced1a55e137381f.jpg"
      ],
      "image": "assets/images/239402/step_01.webp"
    },
    {
      "text": "Combine oats, protein powder, brown sugar, cinnamon, and baking powder in a blender; blend until fine then transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1_9borZcHuqStEFnTRJbwDy0otg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239402-banana-oat-cottage-cheese-pancakes-VAT-006-step-02-e8d62f734c444814b7c61c4722eda8a5.jpg"
      ],
      "image": "assets/images/239402/step_02.webp"
    },
    {
      "text": "Combine banana, cottage cheese, eggs, and vanilla extract in a blender; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z_duyTzn1i_MPXqpniAWOSnenZo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239402-banana-oat-cottage-cheese-pancakes-VAT-007-step-03-611df3221e404f1698821f64c7b9e269.jpg"
      ],
      "image": "assets/images/239402/step_03.webp"
    },
    {
      "text": "Add banana mixture to oat mixture; stir into a thick batter. Stir water into batter to thin as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CjYXGSfXno0uUhYChbeIZxK-u_g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239402-banana-oat-cottage-cheese-pancakes-VAT-008-step-04-04ee4e88bf6c42339735ef3ce946c40c.jpg"
      ],
      "image": "assets/images/239402/step_04.webp"
    },
    {
      "text": "Ladle ¼ to ½ cup batter per pancake onto the preheated griddle or skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zuPXFw_7vwytroEkuwGl8k843EY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239402-banana-oat-cottage-cheese-pancakes-VAT-008-step-05-207ea1a6abc84dadb7c8670bd2a133ea.jpg"
      ],
      "image": "assets/images/239402/step_05.webp"
    },
    {
      "text": "Cook until browned on bottoms, 3 to 5 minutes; flip and cook until browned on other sides and centers are set, 3 to 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
