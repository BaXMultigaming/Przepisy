  "ingredients": [
    "0.5 head cauliflower, grated",
    "0.5 cup shredded extra-sharp Cheddar cheese",
    "1 large egg, beaten",
    "0.25 cup panko bread crumbs",
    "0.125 cup chopped green onion",
    "0.75 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon smoked paprika",
    "1 tablespoon extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "Place grated cauliflower, Cheddar cheese, egg, panko, green onion, salt, pepper, and paprika in a large bowl. Mix until combined; mixture will be very crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a large skillet over medium-high heat until hot. Scoop up some cauliflower mixture using an ice cream scoop; pat into a flat patty. Gently place patty in hot oil; reduce heat to medium. Repeat with remaining mixture. Cook until a golden brown crust forms, about 5 minutes per side. Remove to a platter and serve immediately.",
      "section": null,
