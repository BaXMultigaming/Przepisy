  "ingredients": [
    "6 ounces egg noodles",
    "1 pound ground beef",
    "2 (10.75 ounce) cans condensed tomato soup",
    "2 tablespoons Worcestershire sauce",
    "2 cloves garlic, minced",
    "0.5 pound shredded Cheddar cheese",
    "0.25 cup dry sherry",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook the noodles according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brown the ground beef in a large skillet over medium high heat. Stir in the tomato soup, Worcestershire sauce and garlic, bring to a boil, reduce heat to low and let simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When noodles are done, stir them and the cheese into the simmering sauce until cheese is melted. Stir the sherry into the sauce and stir for 1 minute, then place in a 2 quart casserole dish and sprinkle with the Parmesan cheese to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
