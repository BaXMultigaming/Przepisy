  "title": "Beef and Noodle Casserole",
  "description": "Condensed tomato soup makes the sauce for this easy to prepare baked casserole. Cheddar cheese, Worcestershire sauce, and garlic provide additional flavor.",
  "authors": [
    "Candace Cook"
  ],
  "date_published": "2000-03-03T21:46:07-05:00",
