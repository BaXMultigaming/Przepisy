  "title": "Chicken Jubilee",
  "description": "Chicken breasts lightly broiled, then baked with a cherry juice/brown sugar sauce, brandy and cherries.",
  "authors": [
    "gmistarzbellsouthnet"
  ],
  "date_published": "2000-07-04T11:48:28-04:00",
