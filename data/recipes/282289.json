  "ingredients": [
    "2 cups all-purpose flour",
    "2.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "0.5 cup Country Crock® Spread",
    "0.75 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, salt, and baking soda in a large bowl. Cut in Country Crock® Spread with pastry blender or two knives, until mixture is the size of coarse crumbs. Gradually drizzle in buttermilk, then stir until just moistened. Gently press into an 8-inch round on lightly floured board.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut out 6 biscuits using a 3-inch biscuit cutter. Arrange biscuits on ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 10 minutes or until lightly golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
