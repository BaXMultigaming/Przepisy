  "ingredients": [
    "1 tablespoon butter",
    "1 tablespoon brown sugar",
    "0.25 cup orange juice",
    "1 large banana, cut into 1/4-inch-thick slices",
    "1 tablespoon rum",
    "1 cup vanilla ice cream"
  ],
  "steps": [
    {
      "text": "Melt butter and brown sugar together in a skillet over medium heat until caramelized, 3 to 5 minutes. Pour in orange juice; mix well for 2 minutes. Stir in banana slices until evenly coated with orange juice mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour rum into the skillet. Light rum carefully using a long match. Shake skillet back and forth until flames die down, about 30 seconds. Cook for 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide vanilla ice cream between 2 bowls. Spoon banana mixture over ice cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
