  "title": "Flambe for Two",
  "description": "Caramelized banana slices in orange juice are flambeed with rum and served over vanilla ice cream in this rich and creamy dessert for two.",
  "authors": [
    "Kristen Egert"
  ],
  "date_published": "2020-03-05T00:16:25-05:00",
