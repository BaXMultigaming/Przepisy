  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 medium white onion, chopped",
    "4 cloves garlic, smashed",
    "2 (32 fluid ounce) containers chicken stock",
    "3 cups water",
    "2 smoked ham hocks",
    "3 tablespoons apple cider vinegar",
    "2 tablespoons whole black peppercorns",
    "2 bunches collard greens - rinsed, trimmed, and chopped",
    "6 slices chopped cooked bacon"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large stockpot over medium heat. Add onion and saute until fragrant, 3 to 4 minutes. Add garlic and cook for 30 seconds more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken stock, water, ham hocks, vinegar, and peppercorns to the pot. Increase heat to high and bring to a boil. Reduce heat and simmer for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain solids out of the pot and increase heat to high. Add collards and return to a boil. Add bacon and reduce heat to a simmer. Continue to simmer until greens are tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle collards into bowls with a little stock and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
