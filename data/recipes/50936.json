  "ingredients": [
    "6 eggs",
    "1.5 cups milk",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "3 tablespoons sugar",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground cinnamon",
    "2 tablespoons butter",
    "2 apples - peeled, cored and sliced",
    "3 tablespoons brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend eggs, milk, and vanilla with an electric mixer in a large bowl. Add flour, sugar, salt, and cinnamon; mix just until blended. Set batter aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a 9x9-inch square pan. Arrange apple slices in the bottom of the pan; pour batter over them. Sprinkle brown sugar on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and lightly browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
