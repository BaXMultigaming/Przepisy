  "ingredients": [
    "4 eggs",
    "1 head lettuce, torn into small pieces",
    "1 onion, chopped",
    "1 (8 ounce) can water chestnuts",
    "1 (16 ounce) package frozen green peas",
    "2 cups mayonnaise",
    "2 teaspoons white sugar",
    "1 teaspoon seasoning salt",
    "0.25 teaspoon garlic powder",
    "0.5 pound bacon - cooked and crumbled",
    "1 large tomato, chopped"
  ],
  "steps": [
    {
      "text": "Place eggs in a large saucepan and completely cover with water. Bring to a boil. Cover and remove from heat. Let stand for 12 minutes. Remove eggs and chill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 9x13 inch dish, layer the lettuce, onion, water chestnuts and peas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl combine the mayonnaise, sugar, seasoned salt and garlic powder. Mix until smooth. Spread over the top evenly over the top of the peas. Cover and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel and chop hard-cooked eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove salad from refrigerator and top with the bacon, eggs and tomato. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
