  "ingredients": [
    "0.5 cup white sugar",
    "4 tablespoons all-purpose flour",
    "0.125 teaspoon salt",
    "1 egg",
    "1 cup diced fresh pineapple",
    "0.75 cup pineapple juice",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Combine sugar, flour, and salt in the top of a double boiler over simmering water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in egg, pineapple, and pineapple juice. Cook, stirring frequently, until mixture has thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in butter until melted. Remove from heat and allow to cool.",
      "section": null,
