        "https://www.allrecipes.com/thmb/KuhGhdEqnPjjWbgjosjjiERHBxE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/60598-vegetarian-korma-ddmfs-step1-0496-93b57a7d358d42cd9bbb6303873a71ca.jpg"
