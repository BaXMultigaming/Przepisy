  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 cup chopped onion",
    "2 cloves garlic, minced",
    "0.5 cup chopped carrot",
    "0.25 cup chopped celery",
    "2 (28 ounce) cans crushed tomatoes",
    "3.5 cups vegetable broth",
    "1 tablespoon vegetarian Worcestershire sauce",
    "1 teaspoon salt",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon ground black pepper",
    "4 drops hot pepper sauce"
  ],
  "steps": [
    {
      "text": "Heat oil in a large Dutch oven over medium-high heat. Add onion and garlic; sauté until onion is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add carrot and celery; cook until tender, 7 to 9 minutes, stirring frequently. Stir in tomatoes, vegetable broth, Worcestershire sauce, salt, thyme, black pepper, and hot sauce; reduce heat to low. Cover Dutch oven; simmer 20 minutes, stirring frequently.",
      "section": null,
