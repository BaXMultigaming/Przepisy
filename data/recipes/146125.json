  "ingredients": [
    "0.5 cup butter, melted",
    "0.5 cup all-purpose flour",
    "1 pound skinless, boneless chicken breasts, cut into strips",
    "2 tablespoons fresh lemon juice",
    "salt and pepper to taste",
    "1 cup heavy cream",
    "0.5 cup grated Parmesan cheese",
    "1 dash paprika, for garnish"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter and flour in separate shallow dishes. Dredge chicken strips first in flour, coating evenly, and then in butter. Place chicken in the prepared baking dish. Sprinkle with lemon juice. Add salt and pepper to taste. Pour heavy cream over the chicken. Sprinkle evenly with Parmesan cheese and paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese melts and cream bubbles, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
