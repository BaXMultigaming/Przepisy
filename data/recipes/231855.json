      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zMQA7DBOh4Vu2-_auGaV6piHbSI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231855_Mini_Chocolate_Chip_Pancakes_DDMFS_Step_1_02_5891-c9deec390e5b4165b23b2c4e96474421.jpg"
      ],
      "image": "assets/images/231855/step_02.webp"
    },
    {
      "text": "Whisk milk and egg together in a bowl until thoroughly combined.",
