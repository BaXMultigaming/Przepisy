  "ingredients": [
    "1 cup milk",
    "1 large egg",
    "1 cup all-purpose flour",
    "2 tablespoons white sugar",
    "1 tablespoon baking powder",
    "0.25 teaspoon salt",
    "2 tablespoons butter, melted and cooled",
    "0.5 cup miniature chocolate chips"
  ],
  "steps": [
