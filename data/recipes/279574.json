  "keywords": [],
  "ingredients": [
    "1 (20 ounce) can crushed pineapple",
    "12 cinnamon graham crackers",
    "0.33333334326744 cup unsalted butter, melted",
    "2 (8 ounce) packages cream cheese, softened",
    "0.66666668653488 cup white sugar",
    "2 large eggs, beaten",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon vanilla extract",
    "1 cup sour cream",
    "0.25 cup brown sugar",
    "0.5 tablespoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Allow pineapple to drain in a colander.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crush graham crackers and mix with melted butter. Press into the bottom of a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and white sugar together with an electric mixer on medium speed. Beat in eggs, flour, salt, and vanilla extract until all is mixed well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the drained pineapple on the prepared crust and pour the cream cheese filling on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, about 30 minutes. Remove from the oven and allow to cool another 30 minutes. Leave the oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While cake cools, mix sour cream, brown sugar, and cinnamon together for topping in a bowl. Spread on top of the partially cooled cheesecake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven to set the topping, about 10 minutes. Chill cheesecake completely before serving, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
