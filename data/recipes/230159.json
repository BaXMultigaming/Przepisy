  "ingredients": [
    "cooking spray",
    "1 cup untoasted walnut halves",
    "1 cup untoasted pecan halves",
    "1 cup unsalted, dry roasted almonds",
    "1 cup unsalted, dry roasted cashews",
    "1 teaspoon salt",
    "0.5 teaspoon freshly ground black pepper",
    "0.25 teaspoon ground cumin",
    "0.25 teaspoon cayenne pepper",
    "0.5 cup white sugar",
    "0.25 cup water",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil and lightly coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ovZh6g3aL_mbWxh4aB9FU9d8568=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-230159-sweet-salty-spicy-party-nuts-DDMFS-4x3-step-01-264354d0202e415ab82c19bf882dcbd7.jpg"
      ],
      "image": "assets/images/230159/step_01.webp"
    },
    {
      "text": "Combine walnuts, pecans, almonds, and cashews in a large bowl. Add salt, black pepper, cumin, and cayenne; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c7W7OqYNF76q2c_9tRERCpQciuA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-230159-sweet-salty-spicy-party-nuts-DDMFS-4x3-step-02-3d34fb12656c4a8d87a7b411bd1ca171.jpg"
      ],
      "image": "assets/images/230159/step_02.webp"
    },
    {
      "text": "Heat sugar, water, and butter in a small saucepan over medium heat. Cook until butter is melted and sugar is dissolved, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VveL9N8rd3sKe2AVPWBb5iMv2zY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-230159-sweet-salty-spicy-party-nuts-DDMFS-4x3-step-03-7514fe856e6f4ccd91726c2c144a6ea2.jpg"
      ],
      "image": "assets/images/230159/step_03.webp"
    },
    {
      "text": "Slowly pour butter mixture over nuts and stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UCuTKJ1V2HYC2i-u2xYXlWYNUZo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-230159-sweet-salty-spicy-party-nuts-DDMFS-4x3-step-04-a3bbfbc44b1345eb8f53fbcb7b6d0196.jpg"
      ],
      "image": "assets/images/230159/step_04.webp"
    },
    {
      "text": "Transfer nuts to the prepared baking sheet and spread into a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WWMCT4FcbCLRMu4s_ZR3fDSQdCE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-230159-sweet-salty-spicy-party-nuts-DDMFS-4x3-step-05-c9f02179f9f04e4a85c936db623329b1.jpg"
      ],
      "image": "assets/images/230159/step_05.webp"
    },
    {
      "text": "Bake nuts in the preheated oven for 10 minutes. Stir nuts to coat with warm syrup; spread out in a single layer. Return to the oven and bake until nuts are sticky and roasted, about 6 more minutes. Allow to cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N5ncTEyiKOS_-yNFbU6r32vs3Jw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-230159-sweet-salty-spicy-party-nuts-DDMFS-4x3-step-07-7029fb31bc634eb28b453f6e40477d93.jpg"
      ],
      "image": "assets/images/230159/step_06.webp"
    },
    {
      "text": "Allow to cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aDKzNF1ePFSTBvR47DwvohGzde8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-230159-sweet-salty-spicy-party-nuts-DDMFS-4x3-beauty-f9f5a9b5da754f4da878dd9916b6be36.jpg"
      ],
