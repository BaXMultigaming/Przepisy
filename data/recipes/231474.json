  "ingredients": [
    "0.66666668653488 cup white sugar",
    "0.5 cup vegetable oil",
    "2 eggs",
    "2 lemons, zested",
    "1.3333333730698 cups all-purpose flour",
    "2 tablespoons poppy seeds",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup buttermilk",
    "2 tablespoons fresh lemon juice",
    "1 teaspoon vanilla extract",
    "0.66666668653488 cup confectioners' sugar",
    "2 tablespoons fresh lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 10 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and oil together in a bowl with an electric mixer. Add eggs and lemon zest; beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, poppy seeds, baking powder, and salt together in bowl; gradually beat into the sugar mixture alternately with buttermilk and 2 tablespoons lemon juice until you achieve a smooth batter. Stir vanilla extract into the batter; pour into prepared muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and the tops spring back when lightly pressed, 25 to 35 minutes. Cool muffins in pans for a few minutes before moving to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir confectioners' sugar and 2 tablespoons lemon juice together in a bowl; drizzle over tops of cooled muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
