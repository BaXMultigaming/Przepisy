  "ingredients": [
    "0.75 cup brown sugar",
    "0.33333334326744 cup cornstarch",
    "0.25 teaspoon salt",
    "3 cups evaporated coconut milk",
    "2 tablespoons vegan butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Stir brown sugar, cornstarch, and salt together in a medium saucepan. Add 1/2 cup evaporated coconut milk; stir to combine. Add remaining evaporated coconut milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat over medium-low heat, stirring constantly, until mixture thickens to an almost pudding-like consistency, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and stir in vegan butter and vanilla. Pour into one serving dish (or 4 smaller dishes) and cover with plastic wrap, so the wrap is touching the surface of the pudding.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for at least 4 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
