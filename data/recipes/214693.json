  "ingredients": [
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.5 cups white sugar",
    "1 cup butter, softened",
    "2 eggs",
    "1 lemon, zested",
    "0.25 cup lemon juice",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, and salt together in a bowl until thoroughly combined. Beat sugar and butter together in a separate large bowl with an electric mixer until creamy, about 5 minutes. Add eggs, one at a time, beating well after each addition. Beat in lemon zest, lemon juice, and vanilla extract. Gently mix in flour mixture until just incorporated. Chill dough about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into balls, about 1 ½ teaspoonfuls per cookie; place about 2 inches apart onto baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and just beginning to brown at edges, about 8 minutes; cool on baking sheets for 1 minute before transferring to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
