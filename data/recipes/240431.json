  "ingredients": [
    "cooking spray",
    "3 tablespoons unsalted butter",
    "1 ½ cups chopped yellow onion",
    "1 clove garlic, minced",
    "2 teaspoons dried Italian seasoning",
    "¼ teaspoon crushed red pepper",
    "1 ¾ teaspoons kosher salt, divided",
    "3 tablespoons all-purpose flour",
    "2 1/2 cups whole milk",
    "4 ounces chive and onion cream cheese",
    "4 cups shredded rotisserie chicken",
    "3 cups cooked long-grain white rice",
    "2 (10-ounce) packages frozen chopped spinach, thawed and squeezed dry",
    "2 tablespoons fresh lemon juice",
    "1 teaspoon grated lemon zest",
    "8 ounces part-skim mozzarella cheese, shredded",
    "1/4 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/61-9lPZlSQr6dzc-CfiRLqYjzDo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240431-chicken-spinach-casserole-ddmfs-ingredients-17e04c7660cf434197e6f870aec6e0f3.jpg"
      ],
      "image": "assets/images/240431/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C) and arrange rack in the upper third position. Coat a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large nonstick skillet over medium heat. Add onion, garlic, Italian seasoning, crushed red pepper, and ¾ teaspoon of salt; cook, stirring often, until onions are softened and translucent, about 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RGueblk--tLisI23DdHdfFJmZV8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240431-chicken-spinach-casserole-ddmfs-step1-1428820b45de47cbb1d7d88fef424984.jpg"
      ],
      "image": "assets/images/240431/step_03.webp"
    },
    {
      "text": "Stir in flour and cook, stirring constantly, for 1 minute. Gradually add milk, and cook, stirring constantly, until slightly thickened, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BfM-tk0Ya4yp9z7vrz1hHdJr8eM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240431-chicken-spinach-casserole-ddmfs-step2-85050e351f1d4f898481949e0784e848.jpg"
      ],
      "image": "assets/images/240431/step_04.webp"
    },
    {
      "text": "Add cream cheese, and remaining 1 teaspoon salt; cook, stirring constantly, until fully combined. Remove from heat and stir in shredded chicken, cooked rice, spinach, lemon juice, and lemon zest until fully combined. Transfer mixture to prepared baking dish and spread in an even layer. Sprinkle evenly with mozzarella and Parmesan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G5g8uzbiEViR5enU4FgSiLS54js=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240431-chicken-spinach-casserole-ddmfs-step3-502aa53114784a32b80e1d5a1e9cebc3.jpg"
      ],
      "image": "assets/images/240431/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, about 15 minutes. Turn on the broiler and broil until cheese is browned, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yW-yKigCsWMB0Ze2HTzcDrAz77k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240431-chicken-spinach-casserole-ddmfs-step4-9f7c079163834990af35812890021b8d.jpg"
      ],
      "image": "assets/images/240431/step_06.webp"
    }
  ],
