  "ingredients": [
    "2.5 cups all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup butter, room temperature",
    "0.75 cup brown sugar",
    "0.75 cup white sugar",
    "2 large eggs",
    "2 tablespoons vanilla extract",
    "0.5 cup chocolate-hazelnut spread, such as Nutella®",
    "0.5 cup chopped toasted hazelnuts",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cocoa powder, baking soda, and salt in a bowl. Mix with a whisk to break up any lumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar with an electric mixer in a large bowl until smooth. Beat in eggs one at a time until completely incorporated. Mix in vanilla and chocolate-hazelnut spread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly add in flour mixture and stir just until combined. Fold in chopped hazelnuts and chocolate chips. Drop the dough onto prepared baking sheet by tablespoons or with a cookie scoop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until edges look dry and cookies are fragrant, about 10 to 12 minutes. Allow to cool briefly on baking sheet before transferring to a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
