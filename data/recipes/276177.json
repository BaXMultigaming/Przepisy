  "ingredients": [
    "2 cups light molasses",
    "2 cups brewed coffee",
    "2 eggs, lightly beaten",
    "5.5 cups all-purpose flour",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "2 teaspoons ground ginger",
    "2 teaspoons ground allspice",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "1 cup shortening",
    "1 cup white sugar",
    "2 teaspoons vanilla extract",
    "1 cup semisweet chocolate chips",
    "1 cup miniature marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour 36 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend molasses, coffee, and eggs together in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, cinnamon, ginger, allspice, nutmeg, and salt in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat shortening and sugar in a bowl with an electric mixer until creamy. Add coffee mixture alternately with flour mixture, mixing between each addition, until batter is combined. Stir in vanilla extract. Fold in chocolate chips and marshmallows.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill prepared muffin cups about 3/4 full of batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes. Cool for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
