  "ingredients": [
    "6 tablespoons light olive oil",
    "2 cloves garlic, minced",
    "1 tablespoon lemon juice",
    "1 tablespoon fresh parsley, chopped",
    "1 teaspoon dried basil",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "2 (6 ounce) fillets salmon"
  ],
  "steps": [
    {
      "text": "Whisk olive oil, garlic, lemon juice, parsley, basil, salt, and pepper together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GkQVilpr7SDks8luCKDHCCXJ-Dk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/34746-BakedSalmonII-ddmfs-step10048-1-056334c524ae40ea9520488aaddbca55.jpg"
      ],
      "image": "assets/images/34746/step_01.webp"
    },
    {
      "text": "Arrange salmon fillets in a small glass or ceramic baking dish; pour marinade over salmon. Cover and marinate in the refrigerator for about 1 hour, turning occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2KVm9jtFhjS3WCUO6j8B7UPsiXg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/34746-BakedSalmonII-ddmfs-step2-0050-1-eb99dcaa5f9649198523d2394584d6e6.jpg"
      ],
      "image": "assets/images/34746/step_02.webp"
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer salmon fillets onto a large piece of aluminum foil. Spoon marinade on top and fold up the foil to seal. Place sealed foil packs on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/laTnovSw6HdpuWseFy1EENudPLg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/34746-BakedSalmonII-ddmfs-step6-0009-1-584868d6d0104f56ae47c9d309ba115e.jpg"
      ],
      "image": "assets/images/34746/step_04.webp"
    },
    {
      "text": "Bake in preheated oven until fish flakes easily with a fork, about 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b-QA1TsAATjHz4gaciBQ-WIga5o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/34746-BakedSalmonII-ddmfs-step7-0011-1-d3c0e86d3e784f38ad10824f22272fde.jpg"
      ],
      "image": "assets/images/34746/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
