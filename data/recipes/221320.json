  "ingredients": [
    "1 sugar cube",
    "1 teaspoon water",
    "1 dash bitters",
    "2 fluid ounces whiskey (rye or bourbon)",
    "1 lemon twist",
    "0.5 cup ice cubes, or as needed",
    "1 orange slice, for garnish",
    "1 maraschino cherry, for garnish"
  ],
