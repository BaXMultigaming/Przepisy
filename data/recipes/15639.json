  "ingredients": [
    "3 cups baby carrots",
    "1 tablespoon walnut oil",
    "0.25 cup brandy",
    "2 teaspoons honey",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Tear a large sheet of aluminum foil. Place carrots on foil and sprinkle with walnut oil, cognac, honey, and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap up tightly and roast for 25 to 35 minutes until carrots are tender, yet crisp.",
