  "ingredients": [
    "cooking spray",
    "4 medium sweet potatoes, peeled and sliced 1/2 inch thick",
    "0.25 cup butter, melted",
    "2 tablespoons sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange sweet potato slices on the baking sheet. Brush with 1/2 of the butter. Mix sugar and cinnamon in a small bowl and sprinkle 1/2 over the potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Turn, brush with remaining butter, and sprinkle with remaining cinnamon and sugar. Continue baking until tender, about 15 minutes.",
