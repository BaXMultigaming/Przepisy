  "ingredients": [
    "2 cups uncooked long-grain rice",
    "2 cups coconut water (such as Goya®)",
    "1 cup water",
    "1 tablespoon olive oil",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine rice, coconut water, water, olive oil, and salt in a saucepan. Bring to a boil; reduce heat and simmer, covered, until liquid is absorbed, about 15 minutes. Do not lift the lid while rice is cooking. Fluff with a fork.",
