  "ingredients": [
    "0.25 cup butter, melted",
    "0.75 cup white sugar",
    "2 eggs, beaten",
    "2.25 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 cup eggnog",
    "0.5 cup chopped pecans",
    "0.5 cup raisins",
    "0.5 cup chopped red and green candied cherries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease an 8x4 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the butter, sugar, and eggs together in a mixing bowl. Stir in the flour, baking powder, and sat, alternating with the eggnog, just until the dry ingredients are moistened. Fold in the pecans, raisins, and cherries until evenly blended. Spoon the batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until top is golden and springs back when lightly touched, about 70 minutes. Cool in pan 10 minutes, then turn out onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
