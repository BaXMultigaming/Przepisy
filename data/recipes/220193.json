  "ingredients": [
    "0.25 cup frozen strawberries, thawed",
    "1.25 fluid ounces amaretto liqueur",
    "2 (1/2 cup) scoops vanilla ice cream",
    "1 dash vanilla extract",
    "0.5 cup crushed ice",
    "0.25 fluid ounce vanilla-flavored vodka",
    "1 tablespoon whipped cream",
    "1 fresh strawberry"
  ],
  "steps": [
