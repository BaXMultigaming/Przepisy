  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 egg",
    "0.25 cup vegetable oil",
    "1 tablespoon orange zest",
    "2 tablespoons orange juice",
    "2 cups prepared mincemeat pie filling"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9 x 5 x 3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the egg, oil, orange peel, juice, and mincemeat, blending well. Combine flour, sugar, baking powder, baking soda, and salt; add gradually to the egg mixture. Mix just until moist. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour. Remove the loaf from the oven, and cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
