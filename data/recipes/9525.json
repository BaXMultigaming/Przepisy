  "ingredients": [
    "1.5 pounds blanched whole almonds",
    "1 pound Brazil nuts",
    "0.5 pound walnut halves",
    "0.5 pound pecan halves",
    "1.5 pounds pitted dates",
    "0.33333298563957 pound red candied cherries",
    "0.33333298563957 pound green candied cherries",
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "1 teaspoon baking powder",
    "0.75 teaspoon salt",
    "4 eggs",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Line two 5x9-inch loaf pans with greased parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almonds, Brazil nuts, walnuts, pecans, dates, red and green cherries; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, sugar, baking powder, and salt. Combine with nut mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and vanilla, add to nut and flour mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press into 2 lined loaf pans and bake for 1 1/2 to 2 hours. Set aside for 5 minutes and remove from pans. Completely cool on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
