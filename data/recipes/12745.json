  "ingredients": [
    "1.5 pounds cod",
    "1 cup salsa",
    "1 cup shredded sharp Cheddar cheese",
    "0.5 cup coarsely crushed corn chips",
    "1 avocado - peeled, pitted and sliced",
    "0.25 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease an 8x12-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse cod fillets under cold water and pat dry with paper towels. Lay fillets side by side in the prepared baking dish. Pour salsa over the top and sprinkle evenly with cheese. Top with crushed corn chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until fish is opaque and flakes easily with a fork, about 15 minutes. Serve topped with sliced avocado and sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
