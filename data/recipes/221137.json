  "ingredients": [
    "0.5 small head green cabbage, cored and thinly sliced",
    "0.5 jicama, sliced into matchsticks",
    "1 large sweet apple (such as Fuji), sliced into matchsticks",
    "0.5 cup mayonnaise",
    "0.25 cup pineapple juice",
    "1 teaspoon white sugar",
    "0.5 teaspoon hot sauce, or to taste",
    "salt and freshly ground black pepper to taste",
    "0.25 bunch chopped fresh cilantro",
    "0.33333334326744 ounce toasted corn bits (such as CornNuts ®), crushed"
  ],
  "steps": [
    {
      "text": "Combine cabbage, jicama, and apple in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together mayonnaise, pineapple juice, sugar, hot sauce, salt, and pepper in a medium bowl until smooth and fluffy, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mayonnaise mixture over cabbage mixture; toss to combine. Let sit for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in cilantro and toss again. Garnish with corn bits to serve.",
