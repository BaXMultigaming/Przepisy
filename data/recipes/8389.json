  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "4 tablespoons unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "6 tablespoons vegetable oil",
    "1 tablespoon cider vinegar",
    "1 teaspoon vanilla extract",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, cocoa powder, baking soda, and salt together in an 8x8-inch ungreased cake pan. Make 3 depressions in flour mixture; pour oil into one well, vinegar into second, and vanilla into third well. Pour water over all, then stir with a fork until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
