  "ingredients": [
    "1.5 teaspoons superfine sugar",
    "1 fluid ounce 151-proof rum",
    "0.75 fluid ounce triple sec (such as Bols®)",
    "2.5 fluid ounces coffee-flavored liqueur (such as Kahlua®)",
    "0.5 cup freshly brewed coffee"
  ],
  "steps": [
    {
      "text": "Pour sugar into a shallow dish. Wet the rim of a wine glass or Irish coffee mug and dip in sugar to coat. Add rum and triple sec. Use a long match or lighter to carefully ignite the mixture. Turn glass slowly until sugar begins to caramelize. Pour in coffee liqueur to put out the flame. Top with hot coffee.",
