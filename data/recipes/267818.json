  "ingredients": [
    "1 loaf day-old French baguette",
    "5 eggs",
    "3.5 cups whole milk",
    "1 cup sugar",
    "1 tablespoon vanilla extract",
    "0.5 cup butter",
    "1.5 cups brown sugar",
    "1.5 cups shelled pecan halves"
  ],
  "steps": [
    {
      "text": "Cut bread into cubes; arrange on a baking sheet. Dry out at room temperature for about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs together in a medium bowl. Stir in milk, white sugar, and vanilla until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread cubes in a baking pan; pour milk mixture over bread cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a microwave-safe bowl; microwave until melted. Stir in brown sugar until dissolved, then stir in pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour pecan mixture over bread cubes; gently fold. Don't mix it in thoroughly, just fold it so pecan mixture forms clumps throughout bread pudding.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is slightly brown, 45 to 55 minutes. The center will still be a little jiggly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool before serving, at least 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
