  "title": "Vegan Breakfast Sausage",
  "description": "TVP is the MVP in this easy, vegan take on breakfast sausage, loaded with flavor and pan-fried on the stovetop.",
  "authors": [
    "Breanna Ford"
  ],
  "date_published": "2020-03-09T22:54:14-04:00",
