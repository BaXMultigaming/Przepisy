  "title": "Zucchini Coconut Cake",
  "description": "This zucchini coconut cake recipe uses grated zucchini, which keeps the cake exceptionally moist, and black walnuts and raisins, which add texture.",
  "authors": [
    "Kendra"
  ],
  "date_published": "2020-06-18T23:48:19-04:00",
