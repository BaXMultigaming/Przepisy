  "ingredients": [
    "cooking spray",
    "1 cup all-purpose flour",
    "0.33333334326744 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1.5 cups bran flakes, crushed",
    "1 cup skim milk",
    "1.5 teaspoons ground cinnamon",
    "1.5 teaspoons ground nutmeg",
    "1.5 teaspoons vanilla extract",
    "1 egg",
    "0.25 cup olive oil",
    "0.5 cup diced apple",
    "0.5 cup diced banana",
    "0.33333334326744 cup raisins"
  ],
  "steps": [
    {
      "text": "Spray rice cooker bowl with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, baking powder, baking soda, and salt together in a bowl. Combine bran flakes, milk, cinnamon, nutmeg, and vanilla extract together in a separate large bowl; allow bran flakes to slightly absorb the milk, about 5 minutes. Add egg and oil to bran mixture; stir to combine. Stir flour into bran mixture until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently fold apple, banana, and raisins into batter. Pour into sprayed rice cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the rice cooker for 3 cycles or until a toothpick inserted in the center of the cake comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
