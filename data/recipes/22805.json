  "title": "Seafood Lasagna",
  "description": "This seafood lasagna with crab and shrimp in a creamy sauce is layered with noodles, topped with cheese, then baked for a decadent twist on a classic.",
  "authors": [
    "Rayna Jordan"
  ],
  "date_published": "2000-10-15T20:00:02-04:00",
