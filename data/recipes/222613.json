  "ingredients": [
    "2 cups spiral pasta",
    "1 pound ground beef",
    "1 (1.25 ounce) package taco seasoning",
    "3 cups shredded lettuce",
    "2 cups halved cherry tomatoes",
    "1 cup shredded Cheddar cheese",
    "1 (7 ounce) bag corn chips",
    "0.5 cup chopped onion",
    "0.5 cup French salad dressing",
    "2 tablespoons sour cream"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Stir in spiral pasta and return to a boil. Cook pasta uncovered, stirring occasionally, until tender yet firm to the bite, about 12 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat a large skillet over medium-high heat; add ground beef. Cook and stir until beef is crumbly, evenly browned, and no longer pink, about 10 minutes. Drain and discard any excess grease. Stir taco seasoning into beef; cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir beef mixture into pasta. Add lettuce, tomatoes, Cheddar cheese, corn chips, onion, and French dressing; toss to combine and coat. Top with sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
