  "ingredients": [
    "1 quart boiling water",
    "1 cup white sugar",
    "0.5 cup instant iced tea powder",
    "3 tablespoons crushed fresh mint leaves",
    "2 quarts cold water",
    "1 (6 ounce) can frozen lemonade concentrate, thawed"
  ],
  "steps": [
    {
      "text": "Combine 1 quart boiling water, sugar, instant tea powder, and mint leaves in a 1-gallon pitcher; stir until sugar dissolves. Set aside for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in 2 quarts cold water and lemonade concentrate. Serve in ice-filled tall glasses. Strain out mint leaves, if desired.",
