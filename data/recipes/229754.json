  "ingredients": [
    "1 cup butter",
    "2 cups chopped celery",
    "1 cup chopped onion",
    "2 teaspoons McCormick® Thyme Leaves",
    "1.5 teaspoons McCormick® Poultry Seasoning",
    "1 teaspoon seasoned salt",
    "0.5 teaspoon McCormick® Black Pepper, Ground",
    "12 cups dry unseasoned bread cubes",
    "4 cups chicken broth"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F. Melt butter in large skillet on medium heat. Add celery and onion; cook and stir 5 minutes. Stir in thyme, poultry seasoning, seasoned salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread cubes in large bowl. Add celery mixture and broth; toss gently until well mixed. Spoon into lightly greased 13x9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 35 minutes or until heated through and lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
