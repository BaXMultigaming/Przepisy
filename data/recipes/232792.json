  "title": "Chef John's Monte Cristo Benedict",
  "description": "Chef John's Monte Cristo Benedict recipe tops French toast with ham, two kinds of cheese, and perfectly poached eggs for a change on the brunch sandwich.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2013-05-15T14:39:43-04:00",
