  "ingredients": [
    "0.25 cup butter",
    "0.25 cup butter flavored shortening",
    "0.25 cup brown sugar, firmly packed",
    "0.5 cup white sugar",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "1.125 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup butterscotch chips",
    "1 cup flaked coconut, firmly packed"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the butter, shortening, brown sugar, and white sugar in a large bowl until light and fluffy. Beat in the egg, vanilla extract, and almond extract. In a separate bowl, whisk together the flour, baking soda, and salt. Stir the dry ingredients into the wet ingredients. Gently stir in the butterscotch chips and coconut. Drop dough by rounded tablespoons onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until set and lightly browned, about 10 to 12 minutes. Allow cookies to cool on baking sheets for 5 minutes. Transfer cookies wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
