  "ingredients": [
    "2 pounds ground pork",
    "0.25 cup white sugar",
    "2 tablespoons fish sauce",
    "6 cloves garlic, minced",
    "1 teaspoon sea salt",
    "1 teaspoon ground black pepper",
    "1.5 teaspoons baking powder",
    "1 tablespoon water",
    "wooden skewers, soaked in water"
  ],
  "steps": [
    {
      "text": "Combine pork, sugar, fish sauce, garlic, salt, and pepper in a bowl. Mix together thoroughly. Dissolve baking powder in 1 tablespoon water and blend completely into pork mixture. Cover bowl with plastic wrap and chill in the refrigerator for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread a handful of pork mixture through a skewer using lightly oiled hands. Shape meat into a 1-inch-thick sausage around th skewer. Repeat with remaining pork and skewers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill skewers, turning as needed, until browned on all sides and no longer pink in the center, about 15 minutes. Cut each sausage into bite-sized pieces before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
