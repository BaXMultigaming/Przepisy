  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "4 eggs",
    "1 (5.1 ounce) package instant vanilla pudding mix",
    "2 tablespoons amaretto liqueur",
    "0.5 cup water",
    "0.5 cup vegetable oil",
    "0.25 teaspoon almond extract",
    "0.5 cup amaretto liqueur",
    "1 cup sifted confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, eggs, instant vanilla pudding, water, oil, almond extract, and 2 tablespoons amaretto in a large bowl; mix well. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make the amaretto glaze: sift confectioners’ sugar into a bowl, add the remaining 1/2 cup amaretto, and mix until smooth. Add more amaretto as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the cake from the oven; while still warm, poke holes over the surface. Drizzle with the amaretto glaze, ensuring some fills the holes. Let cool for at least 2 hours before removing from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
