  "ingredients": [
    "1 cup chopped pitted dates",
    "1 teaspoon baking soda",
    "1 cup strong brewed coffee",
    "2 tablespoons butter, softened",
    "1 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1 teaspoon salt",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8x4-inch loaf pan and line the bottom with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place dates into a small bowl and sprinkle baking soda over top. Heat coffee to boiling; pour it over dates. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together butter, sugar, and egg until well blended. Stir in vanilla. Blend in flour and salt, then fold in pecans and date mixture. Transfer batter to the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour in the preheated oven, or until the top of the loaf springs back when lightly touched. Let stand for 5 minutes before removing from the pan. Peel off parchment paper and finish cooling on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
