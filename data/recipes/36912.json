  "ingredients": [
    "nonstick cooking spray",
    "4 boneless, skinless chicken breast halves",
    "1 (14.5 ounce) can stewed tomatoes",
    "1 yellow squash, thinly sliced",
    "1 medium zucchini, thinly sliced",
    "1.5 cups shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly coat a medium baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange chicken in the prepared baking dish; top with stewed tomatoes. Arrange squash and zucchini slices around chicken; sprinkle with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink and juices run clear, about 45 minutes. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
