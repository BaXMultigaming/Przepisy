  "ingredients": [
    "0.75 pound mostaccioli pasta",
    "1 (15.5 ounce) jar spaghetti sauce, or more to taste",
    "12 frozen cooked meatballs, thawed",
    "1 (8 ounce) package shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pasta to a large glass baking dish. The pasta should reach about halfway to the rim of the dish. Cover with as much spaghetti sauce as you like, but at least enough to almost cover pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place meatballs in a microwave-safe dish and heat in the microwave for about 3 minutes. Spread out over pasta. Cover entirely with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through and cheese is completely melted, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
