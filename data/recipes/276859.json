  "ingredients": [
    "2 tablespoons butter",
    "1 cup sliced fresh mushrooms",
    "0.33333334326744 cup chopped onion",
    "1 pound lean ground beef",
    "2 tablespoons all-purpose flour",
    "1 teaspoon garlic powder",
    "1 teaspoon seasoning salt",
    "0.5 teaspoon ground paprika",
    "0.25 teaspoon ground black pepper",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "0.75 cup sour cream, or more to taste",
    "1 tablespoon liquid smoke, or to taste",
    "1 tablespoon Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium-high heat. Add mushrooms and onions and saute until onions have turned translucent, about 5 minutes. Add ground beef and cook and stir until browned and crumbly, 5 to 7 minutes. Sprinkle with flour, garlic powder, seasoning salt, paprika, and pepper; stir until mixed in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add condensed soup, sour cream, liquid smoke, and Worcestershire sauce. Reduce heat to medium, and cook and stir until sauce has thickened, 5 to 7 minutes.",
