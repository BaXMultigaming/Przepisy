  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "1.5 teaspoons baking soda",
    "0.5 teaspoon salt",
    "1 cup mayonnaise",
    "1 cup white sugar",
    "0.75 cup water",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two (8- or 9-inch) round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, cocoa, baking soda, and salt in a medium bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend together mayonnaise, sugar, water, and vanilla in a large bowl with an electric mixer until well combined. Add flour mixture slowly, beating for 2 minutes. Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of each cake comes out clean, 20 to 25 minutes. Allow to cool, then frost with your favorite frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
