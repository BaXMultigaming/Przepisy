  "ingredients": [
    "1 (8 ounce) package reduced-fat cream cheese, softened",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon almond extract",
    "2 cups heavy cream"
  ],
