  "ingredients": [
    "2 gallons water",
    "1.5 cups canning salt",
    "0.33333334326744 cup brown sugar",
    "0.25 cup Worcestershire sauce",
    "3 tablespoons minced garlic",
    "1 tablespoon ground black pepper"
  ],
  "steps": [
