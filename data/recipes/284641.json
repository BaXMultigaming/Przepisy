  "ingredients": [
    "6 tablespoons unsalted butter",
    "1.5 cups self-rising flour",
    "1.5 cups white sugar",
    "0.66666668653488 cup milk, or more as needed",
    "1 teaspoon pure vanilla extract",
    "1.5 cups packed light brown sugar",
    "1 tablespoon ground cinnamon",
    "1 cup pecan halves",
    "1.5 cups hot water"
  ],
  "steps": [
    {
      "text": "Add butter to a 9x13-inch cake pan or casserole dish; place in the oven. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine flour, sugar, milk, and vanilla in a bowl; stir to blend but don't overmix, batter should be a pouring consistency. If too thick, add more milk. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and cinnamon in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove melted butter from the oven; sprinkle pecans over top. Pour batter over pecans, without mixing or stirring; sprinkle with brown sugar mixture, then carefully pour hot water over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
