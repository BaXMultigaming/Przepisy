  "ingredients": [
    "1 (3 ounce) package lime flavored Jell-O® mix",
    "0.5 cup boiling water",
    "1 (12 fluid ounce) can evaporated milk, chilled",
    "0.25 cup fresh lemon juice",
    "1 cup white sugar",
    "2 (9 inch) prepared graham cracker crusts"
  ],
  "steps": [
    {
      "text": "Pour the boiling water into a small bowl, and stir in the gelatin until dissolved. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the evaporated milk in a mixer bowl until stiff. Add the lemon juice and sugar; continue beating. Stir in the gelatin mixture and blend thoroughly. Chill for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour filling into the crusts. Chill until firm, about 1 hour, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
