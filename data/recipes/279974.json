  "ingredients": [
    "2 pounds lean ground turkey",
    "1 pound lean ground beef",
    "1 onion, minced",
    "1 carrot, shredded",
    "2 cups chopped fresh spinach",
    "1 large egg, beaten",
    "3 tablespoons taco seasoning mix",
    "3 cloves garlic, minced",
    "2 teaspoons ground black pepper",
    "3 drops ketchup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place turkey and beef in a large bowl. Add onion, carrot, spinach, egg, taco seasoning, garlic, pepper, and ketchup. Mix with your hands until blended. Shape into 3 equal-sized loaves and place into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, about 1 1/2 hours. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
