    "publisher-tested"
  ],
  "ingredients": [
    "6 thick cut pork chops",
    "1 teaspoon garlic powder",
    "1 teaspoon seasoning salt",
    "2 egg, beaten",
    "0.25 cup all-purpose flour",
    "2 cups Italian-style seasoned bread crumbs",
    "4 tablespoons olive oil",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "0.5 cup milk",
    "0.33333334326744 cup white wine"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Mj7BgA1Q37CTuXqQChU8dvIxlrM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16348-baked-pork-chops-PICS-step-01-ca458db5e2024a2a8fe6c6d1e7e227f1.jpg"
      ],
      "image": "assets/images/16348/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season pork chops with garlic powder and seasoning salt. Place beaten eggs in a small bowl. Dredge pork chops lightly in flour; dip into beaten egg, then press into bread crumbs to coat both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kuiFilcirRPevn_JUbs9kHCaRaw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16348-baked-pork-chops-PICS-step-03-d4909af7bde24ac18a1ecd9206dc7805.jpg"
      ],
      "image": "assets/images/16348/step_03.webp"
    },
    {
      "text": "Heat oil in a medium skillet over medium-high heat. Add breaded pork chops and cook until golden brown, about 5 minutes per side; transfer to a 9x13-inch baking dish and cover tightly with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fdvKRGH5SuEyeEhk9xAohKZcCD8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16348-baked-pork-chops-PICS-step-04-f4dac500a4b948d39fb46de93735b5cc.jpg"
      ],
      "image": "assets/images/16348/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/erGUHrogTmnzwYZdtn-al0KuxUU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16348-baked-pork-chops-PICS-step-05-8f246c82265943a59cb81c9854f0ffa4.jpg"
      ],
      "image": "assets/images/16348/step_05.webp"
    },
    {
      "text": "Meanwhile, mix condensed soup, milk, and white wine in a medium bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vRbzHhZx-eOlXCtPNMcXWDE24T4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16348-baked-pork-chops-PICS-step-06-f223e190bd454b85bbddd1781fce3d85.jpg"
      ],
      "image": "assets/images/16348/step_06.webp"
    },
    {
      "text": "Pour soup mixture over pork chops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xUPiVgjhjXeog6-M6CKN1zVZ3SI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16348-baked-pork-chops-PICS-step-07-406dd75a20454e84b26fc7f4b0b2ef05.jpg"
      ],
      "image": "assets/images/16348/step_07.webp"
    },
    {
      "text": "Replace the foil, and continue to bake for another 10 to 15 minutes, or until pork chops are tender and an instant-read thermometer inserted near the bone reads at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6shLxmBs2STz5FHH-90riWnCl9A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16348-baked-pork-chops-PICS-step-08-450be24844df4d77ac64e6db22f59aa5.jpg"
      ],
      "image": "assets/images/16348/step_08.webp"
    },
    {
      "text": "Let rest briefly. Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yh9j6IyWa6w706Zmt-TMCe7zBBY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/16348-baked-pork-chops-fabeveryday-Beauty-4x3-68a7fc4567654fb58853e12ec42ace6a.jpg"
      ],
      "image": "assets/images/16348/step_09.webp"
    }
  ],
