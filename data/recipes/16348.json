  "title": "Easy Baked Pork Chops",
  "description": "These easy baked pork chops turn out juicy and tender — plus they are quick to prep with simple ingredients for a family-friendly weeknight dinner.",
  "authors": [
    "bdld"
  ],
  "date_published": "1999-12-28T00:56:57-05:00",
