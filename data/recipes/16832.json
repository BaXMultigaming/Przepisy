  "ingredients": [
    "0.5 pound chopped dates",
    "1 cup golden raisins",
    "0.5 cup red wine",
    "0.5 cup coarsely chopped walnuts",
    "1 teaspoon ground cinnamon",
    "0.5 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Place dates and raisins in a small saucepan; add wine. Cook over low heat, stirring occasionally, until fruit breaks down and thickens into a soft paste. Cool.",
