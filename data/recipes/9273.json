  "ingredients": [
    "3 cups all-purpose flour",
    "1 tablespoon baking soda",
    "2 tablespoons ground cinnamon",
    "2 tablespoons ground nutmeg",
    "2 tablespoons ground allspice",
    "2 tablespoons ground cloves",
    "2 cups packed brown sugar",
    "1.5 cups butter, melted",
    "0.5 cup brandy",
    "4 eggs",
    "2 tablespoons lemon zest",
    "2 tablespoons vanilla extract",
    "1.5 cups dried mixed fruit",
    "1.5 cups raisins",
    "1.5 cups chopped nuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Grease and flour a 9-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wi7CV0tifuF0rZ27jpgN8LnqxKU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9273-fruitcake-VAT-step-01-3e29f1c4b83b4c3783cc139b8e93aa81.jpg"
      ],
      "image": "assets/images/9273/step_01.webp"
    },
    {
      "text": "Whisk flour, baking soda, cinnamon, nutmeg, allspice, and cloves together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zju8t9dVSCGRSUWWJEPDo1AWgGk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9273-fruitcake-VAT-step-02-409440ad49a44480b5263d689346649e.jpg"
      ],
      "image": "assets/images/9273/step_02.webp"
    },
    {
      "text": "Beat sugar, eggs, lemon zest, vanilla, brandy, and melted butter together in a separate bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g-AjDvJshVPPkz02ZY4MvwWGh4o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9273-fruitcake-VAT-step-03-db316361ae6e400b9c2bb0a4dc7e707c.jpg"
      ],
      "image": "assets/images/9273/step_03.webp"
    },
    {
      "text": "Stir butter mixture into flour mixture until combined, then fold in dried fruit, raisins, and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vPt8SJIWbDDuoFSECPT6edWKiSM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9273-fruitcake-VAT-step-04-5b9eccadffbe47569f4b98a0172d7539.jpg"
      ],
      "image": "assets/images/9273/step_04.webp"
    },
    {
      "text": "Transfer cake batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QhiBH7hSTQVBS_YAfXW7DKCKHOc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9273-fruitcake-VAT-step-05-96b832ee457e4f78bbd11fe85080f2c7.jpg"
      ],
      "image": "assets/images/9273/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour 45 minutes to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y5_-OIQMHljLoe0O-MsXGfek8KM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9273-fruitcake-VAT-step-06-ce66064771544a2e9395ce827a42b2a7.jpg"
      ],
      "image": "assets/images/9273/step_06.webp"
    },
    {
      "text": "Cool in the pan for 15 minutes, then transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2WV2patPnyNdPUEiGdhVrWB1VSc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9273-fruitcake-VAT-step-07-ec68c0b53b6a4629840e907c9158a69c.jpg"
      ],
