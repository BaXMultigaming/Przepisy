  "ingredients": [
    "1 turkey carcass",
    "3 onions, coarsely chopped",
    "1 pound carrots, coarsely chopped",
    "1 bunch celery, coarsely chopped",
    "1 green bell pepper, coarsely chopped",
    "3 cloves garlic",
    "4 cubes chicken bouillon",
    "1 tablespoon whole black peppercorns, or to taste",
    "3 bay leaves",
    "water to cover"
  ],
  "steps": [
    {
      "text": "Combine turkey carcass, onions, carrots, celery, green bell pepper, garlic, chicken bouillon cubes, peppercorns, and bay leaves in a stockpot. Pour in enough water to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_51NV0-WXOlaUKlCzUXAV2AX_eI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235243-turkey-stock-VAT-step-01-46c66a55164b472faa7d0023cc0b3410.jpg"
      ],
      "image": "assets/images/235243/step_01.webp"
    },
    {
      "text": "Bring mixture to a boil, reduce heat, and simmer until flavors blend, about 1 hour. Remove stockpot from heat and let sit for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_x8IralJ-rVfRPXBXF3cHKxeBa8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235243-turkey-stock-VAT-step-02-88661206cc074aa08ffcb3eac72e8931.jpg"
      ],
      "image": "assets/images/235243/step_02.webp"
    },
    {
      "text": "Strain the stock through a fine-mesh sieve lined with cheesecloth into a large bowl; discard solids.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6h5LrCh64-hzQKNhOIZWY_H1hK8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235243-turkey-stock-VAT-step-03-91bf0429bc33420f9f400b7b421c30e2.jpg"
