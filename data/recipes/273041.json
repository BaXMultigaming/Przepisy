  "ingredients": [
    "1 unbaked 10-inch pie shell",
    "3 cups diced rhubarb",
    "1.5 cups white sugar",
    "0.5 cup milk",
    "2 slightly beaten eggs",
    "1 teaspoon cornstarch",
    "0.25 teaspoon nutmeg",
    "0.125 teaspoon salt",
    "1 cup all-purpose flour",
    "0.5 cup firmly packed brown sugar",
    "0.5 cup margarine"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pie crust in a 10-inch pie plate. Combine rhubarb, white sugar, milk, eggs, cornstarch, nutmeg, and salt in a large bowl until well mixed; pour into crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat flour, brown sugar, and margarine together in a medium bowl using an electric mixer until well combined; sprinkle over top of pie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Remove from oven; reduce oven temperature to 350 degrees F (175 degrees C). Continue baking until pie is set and golden brown, about 40 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
