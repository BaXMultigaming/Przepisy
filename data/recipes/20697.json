  "ingredients": [
    "1 pound ground breakfast sausage",
    "1 (8 ounce) package refrigerated crescent rolls",
    "1 cup frozen hash brown potatoes, thawed",
    "1 cup shredded Cheddar cheese",
    "5 eggs",
    "0.25 cup milk",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook sausage in a large, deep skillet over medium-high heat until evenly browned. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate crescent roll dough into 8 triangles. Place on an ungreased 12-inch pizza pan with points toward the center; press dough together to form a crust. Bottom crust should be sealed and outside edge should be slightly raised.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon sausage over crust; sprinkle with hash browns and top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, milk, salt, and black pepper together in a bowl; pour over crust. Sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until eggs are set, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
