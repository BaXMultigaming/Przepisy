  "title": "Best Breakfast Pizza",
  "description": "This breakfast pizza recipe uses refrigerated crescent roll dough, sausage, hash browns, and cheese to make a different kind of breakfast. It is the best.",
  "authors": [
    "Tammy Christie"
  ],
  "date_published": "2000-07-17T22:51:08-04:00",
