  "ingredients": [
    "2 cups rolled oats",
    "1 cup unsweetened flaked coconut",
    "0.25 cup light brown sugar",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "2 cups skim milk",
    "3 tablespoons coconut oil, softened",
    "1 large egg, beaten",
    "1 teaspoon vanilla extract",
    "1.5 cups blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, coconut flakes, brown sugar, baking powder, cinnamon, and salt in a bowl. Whisk milk, coconut oil, egg, and vanilla extract together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange ⅔ blueberries in the prepared baking dish. Spread oat mixture over blueberries. Pour milk mixture over oats, then sprinkle on remaining ⅓ blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden on top and oatmeal is set, about 40 minutes. Cool before serving, 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
