  "ingredients": [
    "1 pound sage pork sausage",
    "1 small onion, chopped",
    "1 jalapeno pepper, chopped",
    "0.5 cup shredded Swiss cheese",
    "0.25 cup grated Parmesan cheese",
    "1 egg, beaten",
    "0.25 teaspoon hot pepper sauce",
    "0.33333334326744 cup milk",
    "2 cups buttermilk baking mix",
    "0.25 cup melted margarine",
    "1 teaspoon salt",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 400 degrees F (200 degrees C). Grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet over medium heat, cook and stir the sausage, onion, and jalapeno until the sausage is well browned, about 10 minutes. Drain; set aside to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together the Swiss cheese, Parmesan cheese, egg, hot sauce, and milk in a large bowl. Stir in the biscuit mix, margarine, salt, and parsley. Add the sausage mixture; stir until well combined. Pour the mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 minutes. Serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
