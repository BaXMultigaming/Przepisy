  "ingredients": [
    "1.25 cups all-purpose flour",
    "1.25 cups light brown sugar",
    "0.25 cup rolled oats",
    "1 tablespoon ground chia seeds",
    "1 tablespoon flaxseed meal",
    "3 eggs",
    "2 oranges, juiced and zested",
    "5 ounces unsalted butter, melted",
    "2 tablespoons milk, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a loaf pan and line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, oats, ground chia seeds, and flaxseed meal in a large bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs lightly in a separate bowl. Mix in orange juice and orange zest. Beat in butter and milk. Add egg mixture gradually to the flour mixture and whisk until well incorporated. Pour batter in the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 40 to 50 minutes. Cool on a wire rack for 5 minutes. Run a table knife around the edges to loosen. Invert carefully onto a serving plate or cooling rack. Let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
