  "ingredients": [
    "2.75 cups apple cider",
    "0.25 cup pure maple syrup",
    "3 bags cinnamon-flavored black tea",
    "1 (1 inch) piece fresh ginger, sliced",
    "3 cardamom pods, split",
    "6 ounces bourbon",
    "0.25 cup lemon juice"
  ],
  "steps": [
    {
      "text": "Bring cider and maple syrup just to a boil in a saucepan. Remove from heat. Add tea bags, ginger, and cardamom. Let stand, covered, for 5 minutes. Remove and discard tea bags and spices. Stir in bourbon and lemon juice.",
