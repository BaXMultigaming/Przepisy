  "ingredients": [
    "0.75 cup creamy or chunky peanut butter",
    "2 pounds chocolate almond bark, broken into pieces",
    "80 buttery round crackers (such as Ritz®)",
    "2.25 ounces colored candy sprinkles"
  ],
  "steps": [
    {
      "text": "Spread approximately 1 teaspoon peanut butter onto each cracker half. Press peanut butter sides together to form 40 peanut butter-filled sandwich cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt almond bark in the top of a double boiler over hot, but not boiling, water. Reduce heat and keep melted chocolate in top of double boiler over simmering water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each sandwich cookie into the melted chocolate, allowing excess to drain back into pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place coated cookies onto waxed paper and immediately sprinkle with candy sprinkles so they adhere to the melted chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cookies in the refrigerator until chocolate has set, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
