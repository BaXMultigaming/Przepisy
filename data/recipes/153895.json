  "ingredients": [
    "3 cups milk",
    "1.25 cups yellow cornmeal",
    "3 eggs, beaten",
    "1 teaspoon salt",
    "1.75 teaspoons baking powder",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Measure milk into a saucepan and bring to a boil. Add cornmeal; cook and stir for several minutes, until cornmeal has absorbed all of milk. Remove from the heat and allow to cool for about 1 hour. Mixture will be very stiff.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 1 1/2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cornmeal mixture into a large bowl. Stir in eggs, salt, baking powder, and butter. Pour into the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 minutes in the preheated oven, or until edges become lightly toasted. Serve hot directly from the dish with a spoonful.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
