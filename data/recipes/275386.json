  "ingredients": [
    "4 ounces lean ground beef",
    "0.5 cup tomato sauce",
    "1 tablespoon taco seasoning",
    "1 frozen margherita pizza on cauliflower crust",
    "0.75 cup canned refried beans",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir ground beef in a skillet until browned and crumbly, 4 to 5 minutes. Drain grease from skillet, stir in tomato sauce and taco seasoning, and cook for about 2 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place frozen pizza on a pizza or round baking pan. Spread refried beans evenly over the crust, followed by a layer of the ground beef mixture. Sprinkle the pizza with shredded Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is crispy, edges are golden brown, and cheese is melted, 15 to 17 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
