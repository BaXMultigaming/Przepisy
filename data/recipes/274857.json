  "ingredients": [
    "1.5 pounds boneless, skinless chicken breasts, cut into 1-inch pieces",
    "2 cups fresh green beans, trimmed",
    "1 sweet potato, cut into 1-inch cubes",
    "1 red bell pepper, cut into 1-inch cubes",
    "0.5 medium onion, cut into 1-inch cubes",
    "3 cloves garlic, minced",
    "1 tablespoon minced fresh ginger",
    "0.75 cup chicken broth",
    "2 tablespoons curry powder",
    "2 teaspoons kosher salt",
    "1 teaspoon cumin",
    "1 teaspoon ground turmeric",
    "0.5 teaspoon cayenne pepper",
    "1 (15 ounce) can full-fat coconut milk",
    "0.25 cup cashew butter",
    "0.5 cup chopped raw cashews",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Combine chicken, green beans, sweet potato, bell pepper, onion, garlic, and ginger in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together chicken broth, curry powder, kosher salt, cumin, turmeric, and cayenne pepper in a small bowl. Pour into slow cooker and stir into chicken and vegetables. Cover slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until chicken is cooked through and vegetables are fork tender, about 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together coconut milk and cashew butter in a bowl until all the lumps are gone. Add to slow cooker and continue cooking for 1 more hour. Garnish with chopped cashews and cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
