  "ingredients": [
    "1.6666667461395 cups all-purpose flour",
    "1 cup white sugar",
    "1 tablespoon ground cinnamon",
    "1 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 pinch ground nutmeg",
    "1 cup pumpkin puree",
    "0.5 cup butter, melted",
    "2 eggs",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, sugar, cinnamon, baking soda, baking powder, salt, and nutmeg together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk pumpkin, butter, and eggs together in a separate bowl. Stir in chocolate chips. Fold pumpkin mixture into flour mixture. Pour pumpkin batter into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the loaf comes out clean, 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
