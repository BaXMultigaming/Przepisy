  "ingredients": [
    "1.75 cups white sugar",
    "1 cup butter, softened",
    "2 eggs",
    "2 tablespoons chai concentrate",
    "2.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "3 tablespoons white sugar",
    "4 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 ¾ cups sugar, butter, eggs, and chai concentrate together in a bowl until light and fluffy. Whisk flour, baking soda, and salt together in another bowl; stir into butter mixture until dough is combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 3 tablespoons sugar and cinnamon together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into 1-inch balls; roll each ball in cinnamon sugar to coat and place 2 inches apart on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 10 minutes. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
