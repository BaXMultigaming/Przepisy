  "ingredients": [
    "1 pound beef frankfurters, sliced",
    "1 (15 ounce) can pork and beans",
    "1 (15 ounce) can butter beans",
    "1 (16 ounce) can chili beans, drained",
    "1 small onion, chopped",
    "0.5 cup brown sugar",
    "0.25 teaspoon dried oregano",
    "2 tablespoons distilled white vinegar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine the frankfurters, pork and beans, butter beans, chili beans, onion, sugar, oregano and vinegar. Mix all together and pour mixture into a lightly greased 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake uncovered at 350 degrees F (175 degrees C) for 1 hour, or until cooked through and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
