  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 tablespoons peanut oil",
    "1 tablespoon margarine",
    "1 large onion, chopped",
    "2 tablespoons minced garlic",
    "1 tablespoon minced fresh ginger root",
    "2 tablespoons ground coriander",
    "2 tablespoons ground cumin",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground black pepper",
    "1 teaspoon cayenne pepper",
    "0.25 teaspoon ground turmeric",
    "2 tomatoes",
    "2 serrano chile peppers, seeded",
    "0.5 cup fresh cilantro",
    "0.5 cup yogurt, whisked until smooth",
    "3 cups water"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4CYB56cuZYqxURVTIjfrNz8ijwc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25881-basic-curry-sauce-DDMFS-4x3-step-01-c3ee2ce9ecab4611bdfbe711cd839b45.jpg"
      ],
      "image": "assets/images/25881/step_01.webp"
    },
    {
      "text": "Heat oil and margarine in a small skillet or wok over medium-high heat. Add onion and sauté until very brown, 10 to 15 minutes; do not undercook or sauce will taste funny.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sFbmi-VT2UDiNPahEHvlSSw9KYc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25881-basic-curry-sauce-DDMFS-4x3-step-02-cf8cbf5959f146e2882f4a95f703d056.jpg"
      ],
      "image": "assets/images/25881/step_02.webp"
    },
    {
      "text": "Add garlic and ginger to onions; sauté for an additional 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WKXwk1ZyJQF_9D0Qk0fr37kUm0o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25881-basic-curry-sauce-DDMFS-4x3-step-03-65f1c8a9afb04449ae531e0ac5f61a5b.jpg"
      ],
      "image": "assets/images/25881/step_03.webp"
    },
    {
      "text": "Transfer mixture to a food processor and blend until smooth. Do not rinse the food processor. Place blended onion mixture in a large saucepan. Stir in coriander, cumin, cinnamon, black pepper, cayenne pepper, and turmeric; cook over low heat until mixture is thick and has a paste-like consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LarLVQNxT5c8j8PJL9xP8NN6ciQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25881-basic-curry-sauce-DDMFS-4x3-step-04-b406a588366241d3be92ac0fe94a6487.jpg"
      ],
      "image": "assets/images/25881/step_04.webp"
    },
    {
      "text": "Purée tomatoes, chile peppers, and cilantro in the food processor until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KdG9gfGtsr8ly7HObxhj5FSk3xg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25881-basic-curry-sauce-DDMFS-4x3-step-06-a45e368368a4490e96be93ba472370cb.jpg"
      ],
      "image": "assets/images/25881/step_05.webp"
    },
    {
      "text": "Add to onion mixture and stir over low heat, cooking off moisture from tomatoes and peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8gIYaTsx0ES5X4Hj05OMTvPk8HQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25881-basic-curry-sauce-DDMFS-4x3-step-07-f8a5f2a11f5f445bbe0937a166c8689b.jpg"
      ],
      "image": "assets/images/25881/step_06.webp"
    },
    {
      "text": "Add yogurt a little bit at a time, stirring constantly to avoid curdling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sx8Cz7lGdZqC9E4-5WbuNcUvap0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25881-basic-curry-sauce-DDMFS-4x3-step-08-e7913d781a4644fcb470d8a5a121fcb0.jpg"
      ],
      "image": "assets/images/25881/step_07.webp"
    },
    {
      "text": "Blend mixture in the food processor until smooth",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xDnHn9Et54Rf_DEsnwvosqQN-8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25881-basic-curry-sauce-DDMFS-4x3-step-09-02be39061ae84fbe9d93c35499088369.jpg"
      ],
      "image": "assets/images/25881/step_08.webp"
    },
    {
      "text": "Return to saucepan, add water, and increase heat to high; bring sauce to a rolling boil. Cover saucepan and boil for 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Kw8ou6zuHHB1KOaGeLAg5cN5fnk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25881-basic-curry-sauce-DDMFS-4x3-step-10-b08125c462764dff99f5a3a9c4a5e623.jpg"
      ],
      "image": "assets/images/25881/step_09.webp"
    },
    {
      "text": "Reduce heat and simmer until desired consistency is reached.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Bk7d39a8bFAE5FZI9rI-pqkNaZw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-25881-basic-curry-sauce-DDMFS-4x3-cb46f4a05f67478598c9437fe313d9e8.jpg"
      ],
      "image": "assets/images/25881/step_10.webp"
    }
  ],
