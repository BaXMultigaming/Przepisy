  "ingredients": [
    "0.75 cup heavy whipping cream",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Pour cream into a microwave-safe bowl; heat in microwave on high until very hot, 1 to 2 minutes. Add chocolate chips to heated cream; whisk until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate-cream mixture in the freezer until ganache is cold and starting to thicken, stirring every 5 minutes, about 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon ganache into a resealable plastic bag and refrigerate until completely cooled, 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut a corner from the plastic bag and pipe ganache.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
