        "https://www.allrecipes.com/thmb/2Z9kr1XPLf3AlH8Eef9rnubeezE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-gw-7177-Bread-Pudding-II-ddmfs-4x3-step-03-d17eb6dac8244a38bb45ddab415c7f7d.jpg"
