  "ingredients": [
    "1 tablespoon dark soy sauce",
    "1 tablespoon all-purpose flour",
    "1 pound skinless, boneless chicken breast halves - cut into 1 inch cubes",
    "2 tablespoons cooking oil",
    "2 tablespoons green curry paste",
    "2 green onions with tops, chopped",
    "3 cloves garlic, peeled and chopped",
    "1 teaspoon fresh ginger, peeled and finely chopped",
    "2 cups coconut milk",
    "2 tablespoons white sugar",
    "1 tablespoon fish sauce",
    "1 tablespoon dark soy sauce",
    "0.5 cup cilantro leaves, for garnish"
  ],
  "steps": [
    {
      "text": "Pour 1 tablespoon soy sauce into a shallow dish. Place 1 tablespoon flour into a separate shallow dish. Toss chicken pieces in soy sauce, then in flour, coating pieces evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e0W9Ou5ola_ZgNrStb_6vSVyYbg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/141833-thai-green-curry-chicken-ddmfs-Step-02-551d3373e91e4d47882eb7d7792fa56d.jpg"
      ],
      "image": "assets/images/141833/step_01.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add chicken; cook and stir until browned, about 5 minutes. Transfer chicken to a plate; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KpPi9JVNE8WyHmIHQFQ0CEaKKjI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/141833-thai-green-curry-chicken-ddmfs-Step-04-bb0300b98cbb4a5fa44e13dcae64e490.jpg"
      ],
      "image": "assets/images/141833/step_02.webp"
    },
    {
      "text": "Reduce heat to medium and stir in curry paste. Cook for 1 minute until fragrant. Add green onions, garlic, and ginger; cook an additional 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lOF-y0TIU_LMWRSUNk3MEzpIxsQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/141833-thai-green-curry-chicken-ddmfs-Step-05-2230b378a0a9498eb07883dd3aa9ebce.jpg"
      ],
      "image": "assets/images/141833/step_03.webp"
    },
    {
      "text": "Return chicken to the skillet, stirring to coat with curry paste. Stir in coconut milk, sugar, fish sauce, and remaining 1 tablespoon soy sauce; simmer over medium heat until chicken is tender and cooked through, about 20 minutes. Serve curry with cilantro leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o4kkcxmM9lOf-jsgiU2aKkSm-vI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/141833-thai-green-curry-chicken-ddmfs-Step-06-b5c9d2837ade45c197c626c4c9eeab2a.jpg"
      ],
      "image": "assets/images/141833/step_04.webp"
    }
