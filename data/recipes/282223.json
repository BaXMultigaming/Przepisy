  "ingredients": [
    "1 pound ground beef",
    "1 medium green bell pepper, chopped",
    "0.5 large onion, chopped",
    "2 cloves garlic, minced",
    "1 (10.75 ounce) can condensed tomato soup",
    "1 (14.5 ounce) can diced tomatoes",
    "1.5 cups frozen mixed vegetables",
    "1 cup shredded sharp Cheddar cheese",
    "0.5 cup water",
    "2 tablespoons Worcestershire sauce",
    "1 tablespoon soy sauce",
    "1 teaspoon garlic salt",
    "0.5 teaspoon chili powder",
    "salt and ground black pepper to taste",
    "2 cups cooked brown rice, warmed"
  ],
  "steps": [
    {
      "text": "Heat a large nonstick skillet over medium-high heat. Cook and stir hamburger, bell pepper, and onion in the hot skillet until meat is browned and vegetables are soft, 5 to 7 minutes. Add garlic; cook until fragrant, about 30 seconds. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add condensed soup, vegetables, Cheddar cheese, water, Worcestershire sauce, soy sauce, garlic salt, chili powder, salt, and pepper. Cook, stirring occasionally, until vegetables are hot and cheese is melted, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve stew over warm brown rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
