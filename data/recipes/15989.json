  "ingredients": [
    "0.5 cup melted butter",
    "0.33333298563957 cup white sugar",
    "1.5 cups crushed vanilla wafers",
    "1 cup chopped pecans",
    "1 cup butter, softened",
    "2 cups white sugar",
    "4 eggs",
    "1 cup milk",
    "2 teaspoons vanilla extract",
    "2.6666700839996 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease two 8x4 inch bread pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare the topping by combining the 1/2 cup butter, 1/3 cup sugar, vanilla wafers and pecans. Mix together well and press into the bottom of prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar together. Add eggs one at a time and beat well. Combine milk and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and salt. Add to batter, alternating with milk; beat well. Pour into prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven at 350 degrees F (175 degrees C) for 1 hour, or until a toothpick inserted into the cake comes out clean. Remove from oven and cool on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
