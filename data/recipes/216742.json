  "title": "Dutch Oven Mountain Man Breakfast",
  "description": "Serve this mountain man breakfast the next time you go camping! Sausage, eggs, and hash brown potatoes are cooked over a hot campfire in a Dutch oven.",
  "authors": [
    "Mrs Mik"
  ],
  "date_published": "2020-05-27T00:58:30-04:00",
