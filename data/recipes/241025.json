  "ingredients": [
    "2 cups lightly packed brown sugar",
    "1 cup butter-flavored shortening, melted",
    "0.5 cup unsalted butter, melted",
    "0.5 cup molasses",
    "2 eggs",
    "1 tablespoon baking soda",
    "1 tablespoon ground cinnamon",
    "1 tablespoon ground ginger",
    "1 teaspoon salt",
    "1 teaspoon ground cloves",
    "0.5 teaspoon cayenne pepper",
    "4 cups all-purpose flour",
    "0.5 cup coarse sugar crystals, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk brown sugar, shortening, butter, molasses, eggs, baking soda, cinnamon, ginger, salt, cloves, and cayenne pepper together in a large bowl until glossy; fold in flour until dough is just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour coarse sugar into a shallow bowl. Roll dough into 48 balls; roll balls in coarse sugar and place 2 inches apart on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookie tops crack, about 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
