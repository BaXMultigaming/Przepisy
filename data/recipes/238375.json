  "ingredients": [
    "0.25 cup extra-virgin olive oil",
    "0.25 cup pure maple syrup",
    "0.25 cup apple cider vinegar",
    "2 teaspoons white sugar",
    "0.5 teaspoon salt",
    "0.25 cup chopped walnuts",
    "2.5 cups chicken broth or vegetable broth",
    "1 cup farro",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried basil",
    "1 cup chopped tart green apple",
    "0.75 cup dried cherries",
    "2 tablespoons chopped flat-leaf parsley"
  ],
  "steps": [
    {
      "text": "Whisk oil, maple syrup, vinegar, sugar, and salt together in a bowl until vinaigrette is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir walnuts in a small skillet over low heat until toasted and fragrant, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring chicken broth, farro, oregano, and basil to a boil in a saucepan. Reduce heat to medium-low; simmer for 10 minutes. Remove saucepan from heat, cover, and let sit until all liquid has been absorbed, about 30 minutes. Transfer farro to a glass bowl; cool to room temperature, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir walnuts, green apples, dried cherries, and parsley into farro; drizzle in vinaigrette and toss to coat. Refrigerate until chilled, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
