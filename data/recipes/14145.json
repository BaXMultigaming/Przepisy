  "ingredients": [
    "1 head fresh broccoli, cut into florets",
    "1 head cauliflower, broken into small florets",
    "4 ounces fresh mushrooms, sliced",
    "1 green bell pepper, chopped",
    "3 stalks celery, diced",
    "1 onion, finely diced",
    "0.5 cup distilled white vinegar",
    "2 tablespoons poppy seeds",
    "1 cup white sugar",
    "2 teaspoons mustard powder",
    "1 teaspoon salt",
    "1.5 cups vegetable oil"
  ],
  "steps": [
    {
      "text": "Blanch broccoli and cauliflower in a large pot of boiling water until just barely tender. Drain and rise with cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine broccoli, cauliflower, mushrooms, pepper, celery and onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine the vinegar, poppy seeds, sugar, mustard, salt and vegetable oil. Mix until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the marinade over the vegetables and mix well. Chill overnight before serving. Keep any extras refrigerated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
