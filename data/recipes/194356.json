  "ingredients": [
    "2 (3.4 ounce) packages JELL-O Lemon Flavor Instant Pudding",
    "2 cups cold milk",
    "1 tablespoon lemon juice",
    "1 (6 ounce) HONEY MAID Graham Pie Crust",
