  "ingredients": [
    "5 cups chicken stock",
    "1 pound Yukon Gold potatoes",
    "1 clove garlic, minced",
    "1 teaspoon saffron threads, crushed",
    "0.5 cup milk",
    "2 tablespoons olive oil",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring chicken stock, potatoes, garlic, and saffron to a boil in a large pot; cover and simmer until potatoes are tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain potatoes and return to the pot; reserve cooking stock for another use. Add milk, olive oil, salt, and black pepper; mash potatoes with a potato masher until smooth.",
      "section": null,
      "name": null,
      "url": null,
