  "ingredients": [
    "2 cups cider vinegar",
    "1 cup vegetable oil",
    "1 egg, lightly beaten",
    "3 teaspoons salt",
    "1 teaspoon poultry seasoning",
    "8 boneless chicken thighs, with skin"
  ],
  "steps": [
    {
      "text": "Mix cider vinegar, vegetable oil, egg, salt, and poultry seasoning in a large bowl. Place chicken thighs in the bowl; cover and marinate in the refrigerator for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange chicken thighs in a baking dish. Cover with about 1/4 of the marinade mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake chicken in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain off marinade so that chicken skin will become crisp (a baster works well for extracting marinade). Continue baking until chicken is no longer pink and juices run clear, about 15 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
