    },
    {
      "text": "Place broccoli florets in a large bowl; drizzle with olive oil and toss to coat. Season with salt, black pepper, and pepper flakes; toss to coat. Place broccoli in a grill basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
