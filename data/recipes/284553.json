  "ingredients": [
    "4 cups chopped rhubarb, or more to taste",
    "1 cup white sugar",
    "2 tablespoons all-purpose flour",
    "2 large eggs",
    "0.5 cup all-purpose flour",
    "0.5 cup brown sugar",
    "0.25 cup rolled oats",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "6 tablespoons unsalted butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Put rhubarb in an 8- or 9-inch round glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, flour, and eggs together in a medium mixing bowl; pour over rhubarb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare crumble in the same bowl: Mix flour, brown sugar, oats, baking powder, and salt until combined; mix in softened butter until well combined. Sprinkle crumble mixture over rhubarb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until rhubarb is soft and top is browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
