  "ingredients": [
    "2 (12 ounce) packages frozen mixed berries",
    "2.25 cups warm water, divided",
    "0.5 cup white sugar",
    "2 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Pour frozen berries and 2 cups water into a medium saucepan and cook over medium heat, stirring occasionally, until they have thawed but are not hot. Add sugar and bring to a simmer; cook for about 5 minutes, stirring frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix remaining 1/4 cup water and cornstarch together in a bowl. Add to the berry mixture and cook over medium-low heat to thicken slightly, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
