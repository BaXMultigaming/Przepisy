  "ingredients": [
    "0.75 pound boneless, skinless chicken meat",
    "3 tablespoons vegetable oil",
    "2 (14 ounce) cans coconut milk",
    "2 cups water",
    "2 tablespoons minced fresh ginger root",
    "4 tablespoons fish sauce",
    "0.25 cup fresh lime juice",
    "0.25 teaspoon cayenne pepper",
    "0.5 teaspoon ground turmeric",
    "2 tablespoons thinly sliced green onion",
    "1 tablespoon chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Cut chicken into thin strips and saute in oil for to 2 to 3 minutes until the chicken turns white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a pot, bring coconut milk and water to a boil. Reduce heat. Add ginger, fish sauce, lime juice, cayenne powder and turmeric. Simmer until the chicken is done, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with scallions and fresh cilantro and serve steaming hot.",
      "section": null,
      "name": null,
      "url": null,
