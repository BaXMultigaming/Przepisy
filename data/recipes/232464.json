  "ingredients": [
    "2 tablespoons olive oil",
    "0.5 cup chopped onion",
    "2 tablespoons chile-garlic sauce (such as Sriracha®)",
    "2 teaspoons red pepper flakes",
    "1.5 teaspoons minced garlic",
    "0.5 cup water",
    "0.25 cup creamy peanut butter",
    "3 tablespoons ketchup",
    "2 teaspoons Asian (toasted) sesame oil",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a saucepan over medium heat. Cook and stir onion, chile-garlic sauce, red pepper flakes, and garlic until the onion is tender, about 5 minutes. Add water, peanut butter, ketchup, sesame oil, and sugar to the onion mixture; cook and stir until smooth. Reduce heat to low and simmer until thickened, about 15 minutes.",
