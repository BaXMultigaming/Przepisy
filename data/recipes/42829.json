  "ingredients": [
    "1.5 tablespoons dry sherry",
    "3 tablespoons oyster sauce",
    "0.5 teaspoon white sugar",
    "2 teaspoons cornstarch",
    "2 tablespoons peanut oil",
    "1 pound flank steak, thinly sliced",
    "6 green onions, cut into 1/2-inch pieces"
  ],
