  "ingredients": [
    "4 (8 ounce) halibut steaks",
    "salt and pepper to taste",
    "0.5 cup all-purpose flour for dusting",
    "0.25 cup melted butter",
    "0.25 cup dry white wine",
    "1 lemon, juiced",
    "0.5 cup heavy cream",
    "2 tablespoons finely chopped fresh parsley",
    "4 tablespoons finely chopped fresh basil",
    "2 tablespoons drained capers"
  ],
  "steps": [
    {
      "text": "Rinse halibut steaks and pat dry. Season with salt and pepper, then dust with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium-high heat. Fry halibut steaks in melted butter for 4 to 5 minutes, or until nicely browned and flaky. Remove from the skillet and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce the heat to medium and stir wine into the skillet, scraping up any browned bits stuck to the bottom. Mix in lemon juice, then stir in cream. Simmer for 2 to 3 minutes or until it starts to thicken. Season with parsley, basil, and capers; cook and stir for 1 more minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve halibut with sauce spooned over top. Garnish with additional parsley if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
