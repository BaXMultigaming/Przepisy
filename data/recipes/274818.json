  "title": "Berry Oatmeal Scones",
  "description": "These tasty, reliable oatmeal scones with frozen mixed berries are so easy to make, even kids can help.",
  "authors": [
    "Murton8r"
  ],
  "date_published": "2020-06-19T00:39:33-04:00",
