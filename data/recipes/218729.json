      ],
      "image": "assets/images/218729/step_02.webp"
    },
    {
      "text": "When the machine signals that the dough is finished, transfer dough to a well-floured work surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OhE43qcPGu1caxvX5vVQ6HOda-4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218729_BreadMachineThinCrustPizzaDough_ddmfs_Shot3_3x4_4324-a0455d44007b468a8e1bc469c77352fb.jpg"
