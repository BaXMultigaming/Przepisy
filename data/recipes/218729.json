  "ingredients": [
    "0.75 cup warm water - 100 to 110 degrees F (40 to 45 degrees C)",
    "2 cups all-purpose flour",
    "1 teaspoon active dry yeast",
    "0.5 teaspoon salt",
    "0.25 teaspoon white sugar",
    "2 teaspoons olive oil"
  ],
