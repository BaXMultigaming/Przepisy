  "ingredients": [
    "1 quart oil for frying, or as needed",
    "4 large potatoes, cubed",
    "1 teaspoon vegetable oil",
    "2 cups chopped fresh cilantro",
    "4 cloves garlic, minced",
    "1 tablespoon fresh lemon juice",
    "0.5 teaspoon cumin",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Heat 1 quart oil in a deep fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry potatoes in hot oil until golden brown, about 8 minutes. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat 1 teaspoon oil in a large skillet over medium heat. Add cilantro and garlic; cook and stir for about 5 minutes. Add drained potatoes, lemon juice, cumin, and salt; stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
