  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 pound cubed beef stew meat",
    "1 large onion, chopped",
    "1 (1 ounce) package dry mushroom gravy mix",
    "1 cup water",
    "1 teaspoon Worcestershire sauce",
    "1 pinch salt and pepper to taste",
    "1 sheet frozen puff pastry, thawed",
    "1 egg",
    "1 tablespoon water"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Vfd4HvEM664Bh9auW1jLL_8YPjk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78567-steak-pie-VAT-step-01-104dc1eb06084ed6ac4948a38cbb9a2b.jpg"
      ],
      "image": "assets/images/78567/step_01.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add beef stew meat, and cook until browned. Add onion; cook and stir until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NlcVLve4CUzLet3DHCRzTxvDsKw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78567-steak-pie-VAT-step-02-f0dfdf1b68ca4a6a87e509f01858f42d.jpg"
      ],
      "image": "assets/images/78567/step_02.webp"
    },
    {
      "text": "Stir in mushroom gravy mix and 1 cup of water. Season with Worcestershire sauce, salt, and pepper. Turn heat to low, and simmer until beef is tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o-Azbho8ycKjQTqdPv2QSxr0Dhk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78567-steak-pie-VAT-step-03-e7d2366ed64a456ca2768458e2696d96.jpg"
      ],
      "image": "assets/images/78567/step_03.webp"
    },
    {
      "text": "Transfer beef mixture to a casserole dish. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/edvIVJFHlqVCsM2X9GnB1GDtxxo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78567-steak-pie-VAT-step-04-b056b3d6b0ac44f3b4725d45ddb52ae8.jpg"
      ],
      "image": "assets/images/78567/step_04.webp"
    },
    {
      "text": "Roll out puff pastry to cover the top of the casserole dish. Press edges onto the rim of the dish to seal. Whisk egg and 1 tablespoon of water together in a small cup using a fork. Brush over the top of pastry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Kp9tGVKOnpnizLH1UzauQM0qkNw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78567-steak-pie-VAT-step-05-c53ca50bf3c2451fbd8e5234e30599f8.jpg"
      ],
      "image": "assets/images/78567/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven, until pastry is puffed and golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i4mkFxlbE-1W2xu30RBV-91MSPg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78567-steak-pie-VAT-step-06-12a30b8cae1342328e2ef873ecff1ba8.jpg"
      ],
      "image": "assets/images/78567/step_06.webp"
    }
