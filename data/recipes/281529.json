  "title": "Sesame Chicken Wraps",
  "description": "Sesame chicken wraps filled with broccoli, rice, and a homemade peanut sauce are a perfect choice for a satisfying lunch or dinner.",
  "authors": [
    "Lilsargitty"
  ],
  "date_published": "2007-04-10T20:02:36-04:00",
