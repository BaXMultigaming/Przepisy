  "ingredients": [
    "1 knockwurst",
    "2 teaspoons salted butter, or to taste",
    "0.25 pound deli sliced corned beef",
    "2 slices rye bread",
    "2 slices Swiss cheese",
    "1 tablespoon spicy brown mustard"
  ],
  "steps": [
    {
      "text": "Slice knockwurst into long slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter on a large griddle over medium heat. Throw corned beef onto the griddle and get it sizzling. Add knockwurst slices; cook 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add bread, making sure it gets a good coat of butter and grease from the griddle. Cook for 1 minute, then flip. Place Swiss cheese on bread slices. Cover with a lid or pot to steam until cheese melts, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove everything from the griddle and assemble sandwich. Place one slice of bread on a plate with the melted cheese facing up. Pile on corned beef, knockwurst slices, and mustard. Top with second slice of bread, cheese facing down. Eat hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
