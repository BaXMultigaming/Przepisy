  "ingredients": [
    "1 cup water",
    "0.25 cup Truvia® natural sweetener spoonable**",
    "6 whole cloves",
    "6 whole black peppercorns, crushed",
    "3 whole allspice berries, crushed",
    "1 (750 milliliter) bottle red wine",
    "3/4 cup spiced simple syrup (recipe above)",
    "3 cups sparkling water",
    "0.25 cup fresh orange juice",
    "1 orange, thinly sliced",
    "1 lemon, thinly sliced",
    "1 lime, thinly sliced",
    "2 cups ice cubes"
  ],
  "steps": [
    {
      "text": "Spiced Simple Syrup: Place all of the ingredients in a medium saucepot, stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place on high heat, bring to a boil. Reduce heat, and simmer 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat, allow to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour syrup through a strainer to remove spices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour syrup into a jar with lid and store refrigerated. Shake before using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sangria: Combine wine, 3/4 cup spiced simple syrup, sparkling water, orange juice, and fruit slices. Stir briskly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve over ice in large red wine glasses.",
      "section": null,
