  "ingredients": [
    "3 cups all-purpose flour",
    "3 cups cornmeal",
    "1 cup white sugar",
    "3 tablespoons baking powder",
    "1 teaspoon salt",
    "3 cups whole milk",
    "1 cup vegetable oil",
    "3 eggs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease a 15x10x2-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cornmeal, sugar, baking powder, and salt together in a bowl; stir in milk, vegetable oil, and eggs until batter is evenly combined. Pour batter into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the loaf comes out clean, about 33 minutes.",
      "section": null,
