  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup unsalted butter, at room temperature",
    "1 cup sugar",
    "3 large eggs, at room temperature",
    "1.5 teaspoons vanilla extract",
    "0.5 cup buttermilk, at room temperature",
    "1 (16 ounce) package strawberries, diced",
    "2 tablespoons sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat oven to 350 degrees F (175 degrees C). Grease a 10-inch cast-iron skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BHR42KZyWZhGYxZoErWMm8scsBk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8377298-strawberry-buttermilk-cake-VAT-step-01-4dc5e0c9aa1b461494911a205b3786dc.jpg"
      ],
      "image": "assets/images/8377298/step_01.webp"
    },
    {
      "text": "Combine flour, baking powder, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wzgP0w8RlxFsZFEkpwMhfhnO420=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8377298-strawberry-buttermilk-cake-VAT-step-02-d4cb1aaf6e924c4798219bf61acc92cd.jpg"
      ],
      "image": "assets/images/8377298/step_02.webp"
    },
    {
      "text": "Beat butter and 1 cup sugar together in a large bowl with an electric mixer until light and fluffy. Add eggs, one at a time, beating well after each addition. Beat in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JkHIo83nmXire2Rbq6W6HSlnhlA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8377298-strawberry-buttermilk-cake-VAT-step-03-8a8b23f522b840f086a5b4e3bb8f8bde.jpg"
      ],
      "image": "assets/images/8377298/step_03.webp"
    },
    {
      "text": "Add flour mixture in batches, alternating with buttermilk, beating batter briefly after each addition: fold in strawberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/InoQNOrvadCCEO32yxD48yc2Wbo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8377298-strawberry-buttermilk-cake-VAT-step-04-1foldingaction-91456b3b7dc345fea06c4f2dc3b3e337.jpg"
      ],
      "image": "assets/images/8377298/step_04.webp"
    },
    {
      "text": "Transfer batter into the prepared skillet. Sprinkle 2 tablespoons sugar over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6wc11bKULBEcHEfU-OLS0XRR5Tw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8377298-strawberry-buttermilk-cake-VAT-step-05-82576c4d57da42b08cef8b63b3d6156b.jpg"
      ],
      "image": "assets/images/8377298/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted in center comes out clean, 60 to 75 minutes.",
      "section": null,
      "name": null,
      "url": null,
