  "ingredients": [
    "4 cups chopped rhubarb",
    "0.75 cup white sugar",
    "2 tablespoons quick-cooking tapioca",
    "0.5 teaspoon salt",
    "0.5 (10 ounce) package frozen sliced strawberries",
    "1 cup rolled oats",
    "0.33333334326744 cup brown sugar",
    "0.25 cup sifted all-purpose flour",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix rhubarb, white sugar, tapioca, and salt in a large bowl and toss to coat; let rest, stirring occasionally, for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir strawberries into rhubarb mixture; spread into a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oats, brown sugar, flour, and melted butter together in a separate bowl until crumbly; sprinkle over fruit mixture in the casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
