  "ingredients": [
    "1 cup white sugar, divided",
    "2 cups fresh strawberries, sliced",
    "3 cups water",
    "2 cups almond milk",
    "2.5 cups old-fashioned oats",
    "1.5 cups bananas, mashed",
    "1 teaspoon cinnamon",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground nutmeg",
    "0.5 cup pecans, chopped"
  ],
  "steps": [
    {
      "text": "Sprinkle 1/2 cup sugar over sliced strawberries in a bowl. Let rest until juices have been released, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Boil water and almond milk together in a large pot. Add oats and cook over medium-low heat for 5 minutes, stirring frequently. Stir in strawberries, remaining 1/2 cup sugar, bananas, cinnamon, vanilla extract, salt, and nutmeg and remove from heat. Stir in pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease 18 muffin cups and fill each to the top with oat mixture, mounding a bit. Freeze 8 hours to overnight. Remove oatmeal from muffin cups and place in freezer bags or a freezer-safe container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare 1 frozen oatmeal cup by placing in a microwave-safe bowl and heating in a microwave oven for 1 1/2 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
