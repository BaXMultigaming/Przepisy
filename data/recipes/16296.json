  "ingredients": [
    "2 pounds ground beef",
    "1 cup bread crumbs",
    "0.33333298563957 cup ketchup",
    "2 eggs, beaten",
    "2 tablespoons soy sauce",
    "0.25 teaspoon ground black pepper",
    "0.5 teaspoon garlic powder",
    "1 (16 ounce) can jellied cranberry sauce",
    "1 (18 ounce) bottle barbecue sauce",
    "2 tablespoons brown sugar",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground beef, bread crumbs, ketchup, eggs, soy sauce, black pepper, and garlic powder in a large bowl until well combined. Shape into small meatballs and arrange on a nonstick baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, about 30 minutes, turning once.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine cranberry sauce, BBQ sauce, brown sugar, and lemon juice in a large saucepan; heat and stir over low heat until smooth. Add meatballs and simmer for I hour. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
