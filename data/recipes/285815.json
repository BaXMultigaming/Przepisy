  "ingredients": [
    "2 bunches broccoli, cut into bite-sized florets",
    "1 pound cooked and crumbled bacon",
    "1 (8 ounce) package sharp Cheddar cheese, shredded",
    "1 medium onion, diced",
    "1 cup mayonnaise (such as Hellmann's®)",
    "0.5 cup white sugar",
    "0.25 cup cider vinegar"
  ],
  "steps": [
    {
      "text": "Toss broccoli, cooked bacon, Cheddar cheese, and onion together in a resealable container. Mix mayonnaise, sugar, and cider vinegar together in a separate container until well blended. Refrigerate both until chilled, 30 minutes or up to 1 week.",
