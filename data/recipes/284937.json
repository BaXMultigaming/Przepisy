  "ingredients": [
    "3 fresh peaches, pitted and chopped",
    "1 medium fresh mango, peeled and chopped",
    "1 cup chopped fresh pineapple",
    "0.25 cup triple sec",
    "2 tablespoons spicy mustard",
    "2 tablespoons Worcestershire sauce",
    "1 medium lime, juiced",
    "0.5 cup brown sugar",
    "1 medium fresh jalapeno pepper, seeded and chopped",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon cayenne pepper",
    "0.125 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Heat peaches, mango, pineapple, triple sec, mustard, Worcestershire sauce, and lime juice in a medium saucepan over medium-high heat until just boiling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium-low. Add brown sugar, jalapeno, cinnamon, allspice, cayenne pepper, and cloves. Simmer, uncovered, until thickened and somewhat chunky, about 45 minutes; stir occasionally to prevent burning.",
      "section": null,
