  "ingredients": [
    "1 (4 ounce) packet saltine crackers",
    "1.5 cups mayonnaise",
    "3 green onions, finely chopped",
    "1 large tomato, chopped",
    "1 hard-cooked egg, chopped",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Coarsely crumble saltines into a medium bowl. Stir in mayonnaise, green onions, and tomato, then stir in hard-cooked egg; season with salt and pepper.",
