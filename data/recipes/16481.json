  "ingredients": [
    "0.75 cup butter, softened",
    "1 cup white sugar",
    "1 cup brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1.25 cups quick cooking oats",
    "0.5 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup chopped pecans",
    "0.75 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together the butter, white sugar and brown sugar. Beat in the egg and vanilla. Combine the flour, oats, baking soda, baking powder and salt; stir into the wet mixture until just blended. Finally, fold in the pecans and coconut. Dough may be a little dry. Shape dough into walnut sized mounds and place 1 1/2 inches apart on the prepared cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 14 minutes in the preheated oven, or until golden. Cool on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
