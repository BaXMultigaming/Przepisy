  "ingredients": [
    "4 cups mulberries",
    "3 cups chopped rhubarb",
    "1 cup white sugar",
    "2 tablespoons cornstarch",
    "1 teaspoon ground cinnamon",
    "1 teaspoon salt",
    "1.3333333730698 cups brown sugar",
    "1 cup all-purpose flour",
    "1 cup rolled oats",
    "1 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mulberries, rhubarb, sugar, cornstarch, cinnamon, and salt in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, flour, and oats in a large bowl; cut in butter using a pastry blender or 2 knives. Sprinkle over rhubarb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden and fruit is bubbly, about 40 minutes.",
      "section": null,
