  "ingredients": [
    "2 tablespoons butter",
    "1 cup blueberries",
    "3 tablespoons dark brown sugar",
    "1 tablespoon fresh squeezed lemon juice",
    "0.25 teaspoon ground cinnamon",
    "0.5 cup milk",
    "2 large eggs",
    "6 tablespoons all-purpose flour",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Divide butter between 2 shallow 1-cup oven-proof dishes and heat in the oven until butter melts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir blueberries, brown sugar, lemon juice, and cinnamon together in a bowl and toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, eggs, flour, and salt in a bowl. Mix well. Divide batter evenly between the prepared dishes. Add blueberry mixture and sprinkle blueberries evenly on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden, 17 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
