  "ingredients": [
    "0.5 cup whole wheat flour",
    "0.5 cup sourdough starter discard",
    "0.5 cup plain yogurt",
    "0.5 cup 2% milk",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 cup canola oil",
    "0.5 cup white sugar",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon lemon zest",
    "1.5 cups fresh blueberries"
  ],
  "steps": [
    {
      "text": "Mix flour, discard, yogurt, milk, baking powder, and baking soda for starter sponge together in a large bowl until thoroughly combined. Let sit at room temperature, 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 2 jumbo 6-cup muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, cinnamon, and salt together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, sugar, eggs, vanilla extract, and lemon zest into the starter sponge. Slowly add dry ingredients into the wet ingredients; mix until incorporated but be careful to not overmix. Carefully fold in blueberries. Scoop batter into the prepared muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 25 to 30 minutes. Transfer to a wire rack and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
