  "ingredients": [
    "1 pound scallops, rinsed and drained",
    "2 tablespoons butter",
    "1 bunch green onion, minced",
    "4 ounces fresh mushrooms, sliced",
    "2 tablespoons all-purpose flour",
    "1 cup milk",
    "0.5 cup dry white wine",
    "1 teaspoon salt",
    "1 pinch ground white pepper",
    "0.5 cup shredded Swiss cheese",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Wash and drain scallops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small stock pot over medium-low heat. Sauté onions and mushrooms until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour. Pour in milk and stir over medium heat until thickened and bubbly. Add wine, scallops, salt, and pepper. Cook over medium heat until thickened. Serve topped with Swiss cheese and parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
