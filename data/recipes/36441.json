  "ingredients": [
    "1 cup slivered almonds",
    "3 eggs",
    "1 cup milk",
    "3 tablespoons all-purpose flour",
    "0.25 teaspoon salt",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon almond extract",
    "1 teaspoon vanilla extract",
    "12 thick slices French bread",
    "3 tablespoons canola oil",
    "3 tablespoons butter",
    "confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Toast almonds in a small saucepan over low heat, tossing frequently, until lightly browned, 5 to 10 minutes. Remove from the heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk together eggs, milk, flour, salt, baking powder, almond extract, and vanilla extract. Soak bread slices in the mixture until saturated, then transfer to a shallow pan. Cover and refrigerate for approximately 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat canola oil and butter in a large skillet over medium heat. Press one side of each soaked bread slice into toasted almonds to coat. Fry bread slices on both sides until golden brown. Dust with confectioner's sugar before serving,",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
