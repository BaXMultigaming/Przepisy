  "ingredients": [
    "0.75 cup buttermilk",
    "0.5 cup all-purpose flour",
    "0.5 cup quick cooking oats",
    "1 large egg",
    "2 tablespoons vegetable oil",
    "1 tablespoon white sugar",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt"
  ],
