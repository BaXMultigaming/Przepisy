  "ingredients": [
    "1 (15.25 ounce) package white cake mix",
    "2 large eggs",
    "6 tablespoons unsalted butter, melted",
    "0.5 cup powdered sugar"
  ],
  "steps": [
    {
      "text": "Position a rack in the center of the oven and preheat to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cake mix, eggs, and butter together in a large bowl to form a soft cookie dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 1-inch balls; roll in powdered sugar to coat. Set balls about 2 inches apart on ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, one pan at a time, just until edges are firm and cracks appear slightly moist, 9 to 11 minutes. Cool on pans for 3 minutes; transfer to a wire rack to cool completely.",
      "section": null,
