  "ingredients": [
    "1 (15 ounce) can ranch-style beans, drained",
    "1 (14 ounce) can refried beans",
    "0.5 (1 ounce) package taco seasoning mix",
    "1 (8 ounce) container sour cream",
    "1 (1 ounce) package dry onion soup mix",
    "1 (8 ounce) jar salsa",
    "0.25 head iceberg lettuce, torn into bite-sized pieces",
    "0.5 cup crushed tortilla chips",
    "0.25 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Mix ranch-style beans and refried beans together in the bottom of a shallow casserole dish; season with taco seasoning mix and stir. Spread the bean mixture into an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sour cream and onion soup mix together in a small bowl; spread over the bean mixture. Top the sour cream layer with salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate dish until the bean layer firms, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer lettuce atop the salsa. Sprinkle tortilla chips in a layer over the lettuce. Finish with a layer of Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
