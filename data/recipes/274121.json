  "ingredients": [
    "3 cups grated carrots",
    "2 cups all-purpose flour",
    "1.75 cups white sugar",
    "1.5 cups chopped walnuts",
    "1.25 cups oil",
    "4 eggs",
    "2 teaspoons baking soda",
    "2 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 6-cavity mini loaf tray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix carrots, flour, sugar, walnuts, oil, eggs, baking soda, baking powder, cinnamon, and salt in a large bowl until combined. Pour batter into the prepared tray, filling each loaf cavity 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes. Cool in the pan for 5 to 10 minutes, then transfer loaves to a wire rack to finish cooling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
