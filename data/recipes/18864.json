  "title": "Turkey and Stuffing Casserole",
  "description": "This turkey and stuffing casserole combines two holiday favorites in one creamy, comforting dish—perfect for using up leftover turkey.",
  "authors": [
    "Kristi Evans"
  ],
  "date_published": "2000-06-08T17:39:54-04:00",
