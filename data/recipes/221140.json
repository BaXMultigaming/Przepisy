  "ingredients": [
    "1 tablespoon olive oil",
    "8 ounces uncooked spaghetti, broken into 1 inch pieces",
    "2 cloves garlic, minced",
    "1.5 cups chicken broth, divided",
    "0.5 teaspoon red pepper flakes, or to taste",
    "salt to taste",
    "2 tablespoons freshly grated Parmigiano-Reggiano cheese, or to taste",
    "1 tablespoon chopped fresh flat-leaf parsley"
  ],
  "steps": [
    {
      "text": "Heat oil in a saucepan over medium heat; add spaghetti and toast, stirring constantly, until golden brown, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir garlic into spaghetti pieces and cook for 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in 1/2 cup broth and increase heat to medium-high. Stir spaghetti and broth until all the liquid is absorbed, 2 to 3 minutes. Repeat this process until all of the stock is absorbed and noodles are desired tenderness, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low. Season spaghetti with red pepper flakes and salt to taste. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Parmigiano-Reggiano cheese and parsley into spaghetti and serve.",
      "section": null,
      "name": null,
