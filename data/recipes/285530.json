  "ingredients": [
    "cooking spray",
    "0.75 cup minced onion",
    "0.5 cup finely chopped bell pepper",
    "0.5 cup milk",
    "2 large eggs",
    "2 cloves garlic, minced",
    "0.75 cup ketchup, divided",
    "2 tablespoons chopped fresh parsley",
    "4 teaspoons Worcestershire sauce, divided",
    "2 teaspoons minced fresh thyme",
    "2 teaspoons Dijon mustard",
    "0.75 cup seasoned bread crumbs",
    "2 pounds ground sirloin",
    "1.5 teaspoons kosher salt",
    "0.75 teaspoon ground black pepper",
    "2 teaspoons balsamic vinegar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly coat a 9x5-inch loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onion, bell pepper, milk, eggs, garlic, 2 tablespoons ketchup, parsley, 3 teaspoons Worcestershire sauce, thyme, and Dijon in a large bowl and mix well. Stir in bread crumbs. Add ground sirloin, salt, and pepper; mix until just combined. Form mixture into a loaf shape and fit into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining ketchup with balsamic vinegar and remaining 1 teaspoon Worcestershire in a small bowl. Mix until well combined and spread over the top of the meatloaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an instant read thermometer inserted in the center reads 160 degrees F (71 degrees C), about 1 hour. Let stand for 10 minutes before slicing and serving. The longer it sits, the easier it will be to slice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
