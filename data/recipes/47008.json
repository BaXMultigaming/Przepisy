  "ingredients": [
    "cooking spray",
    "1 cup chicken broth",
    "2 tablespoons honey",
    "2 limes, juiced",
    "0.5 jalapeno pepper, minced",
    "2 teaspoons ground cinnamon",
    "2 teaspoons chili powder",
    "2 teaspoons salt",
    "1 teaspoon ground cumin",
    "1 teaspoon black pepper",
    "1 whole chicken, cut into pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Lightly grease a medium baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken broth, honey, lime juice, and jalapeño to a medium saucepan over medium-high heat. Cook and stir until slightly thickened and syrupy; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cinnamon, chili powder, salt, cumin, and pepper in a large bowl. Add chicken pieces to the bowl; rub well with spice mixture, then arrange on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for about 15 minutes. Baste chicken with broth mixture. Continue baking, basting occasionally, until chicken is no longer pink and the juices run clear, about 30 minutes. An instant-read thermometer inserted into the center of meat should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
