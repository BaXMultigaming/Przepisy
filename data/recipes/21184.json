  "ingredients": [
    "1 clove garlic",
    "3 teaspoons dried oregano",
    "0.5 cup distilled white vinegar",
    "0.5 cup crushed red pepper flakes",
    "0.5 cup water",
    "2.5 pounds ground pork"
  ],
  "steps": [
    {
      "text": "In a blender, combine garlic, oregano, vinegar, red pepper flakes, and water; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ground pork into a bowl and pour blended mixture over top. Mix to combine, then cover and refrigerate for at least 8 hours or all day. Pour off any water that accumulates. Refrigerate or freeze for future use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
