  "ingredients": [
    "1 pound extra large shrimp (16-20 per lb.), shell on, deveined",
    "0.25 cup vodka",
    "0.25 cup orange juice",
    "2 cloves garlic, minced",
    "1 teaspoon ground cumin",
    "0.5 teaspoon ground coriander",
    "0.5 teaspoon smoked paprika",
    "0.5 teaspoon paprika",
    "0.25 teaspoon cayenne pepper",
    "1 (5 ounce) package finely chopped lettuce",
    "6 (6 inch) tortillas, warmed",
    "0.25 cup fresh chopped cilantro",
    "1 red bell pepper, seeded and chopped",
    "1 bunch chopped green onions, white parts only",
    "3 tablespoons crema con sal (salted Mexican-style sour cream)",
    "0.25 cup shredded Mexican cheese blend, or to taste"
  ],
  "steps": [
    {
      "text": "Combine vodka, orange juice, garlic, cumin, coriander, smoked paprika, paprika, and cayenne in a resealable plastic bag. Add shrimp and marinate for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain off marinade and air-fry shrimp for 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide chopped salad amongst tortillas. Add cilantro, bell pepper, and the white parts of the green onion. Roughly chop shrimp (optional) and add to the tacos. Top with crema con sal and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
