  "ingredients": [
    "0.5 pound butter",
    "3 cups white sugar",
    "0.5 cup shortening",
    "5 eggs",
    "3 cups cake flour",
    "0.5 teaspoon baking powder",
    "0.25 cup milk",
    "1 cup sour cream",
    "1 teaspoon vanilla extract",
    "1 teaspoon lemon extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease and flour a tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, sugar, and shortening together with an electric mixer until creamy and fluffy. Add eggs, one at a time, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour and baking powder together in another bowl. Add to creamed mixture, alternating with milk and sour cream. Mix in vanilla extract and lemon extract. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 1 hour and 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
