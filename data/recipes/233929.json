  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 cup white sugar",
    "0.25 cup brown sugar",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 cup olive oil",
    "0.25 cup milk",
    "1 egg",
    "1.5 teaspoons vanilla extract",
    "1 cup shredded zucchini",
    "0.5 cup fresh blueberries",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease 12 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e4vS6BU_aICed3DQVLUxrOsYyLU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233929-blueberry-zucchini-muffins-DDMFS-28495-step-01-09d09cfe258d4ac1bdd87f67eec24f7c.jpg"
      ],
      "image": "assets/images/233929/step_01.webp"
    },
    {
      "text": "Combine flour, white sugar, brown sugar, baking soda, cinnamon, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xPlY_mZuna_C1Ne6FqT_Vta02b8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233929-blueberry-zucchini-muffins-DDMFS-28495-step-02-4f4215932c8643148363c7c4ba5714db.jpg"
      ],
      "image": "assets/images/233929/step_02.webp"
    },
    {
      "text": "Whisk olive oil, milk, egg, and vanilla together in a separate bowl until smooth; stir into flour mixture until batter is just moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LZfz55MskCSMXROuhuollDWwh_s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233929-blueberry-zucchini-muffins-DDMFS-28495-step-03-82b6a228753f4baa93ffe0e3e2c75a87.jpg"
      ],
      "image": "assets/images/233929/step_03.webp"
    },
    {
      "text": "Fold in zucchini, blueberries, and pecans until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_HJJaQo4-eOQsTnaleZVGpR9hi8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233929-blueberry-zucchini-muffins-DDMFS-28495-step-04-d2c1e99e24aa49a6b5c8e9aaa8c35076.jpg"
      ],
      "image": "assets/images/233929/step_04.webp"
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VrSh9lKxKDoGs3Rd7ieFEIvEVWg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233929-blueberry-zucchini-muffins-DDMFS-28495-step-05-54d614fc7233425b85234ae888b296ab.jpg"
      ],
      "image": "assets/images/233929/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 20 to 25 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_HJJaQo4-eOQsTnaleZVGpR9hi8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233929-blueberry-zucchini-muffins-DDMFS-28495-step-04-d2c1e99e24aa49a6b5c8e9aaa8c35076.jpg"
