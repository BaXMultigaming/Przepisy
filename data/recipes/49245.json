  "ingredients": [
    "1 (12 ounce) package farfalle (bow tie) pasta",
    "1 cup butter",
    "1 medium head cabbage, chopped",
    "1 medium onion, chopped",
    "3 cloves garlic, minced",
    "0.5 teaspoon salt",
    "0.25 teaspoon pepper"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add farfalle pasta, and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butter in a skillet over medium heat. Stir in the cabbage, onion, and garlic, and season with salt and pepper. Cook 15 minutes, or until the cabbage and onion are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, toss together the cooked farfalle and the cabbage mixture. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
