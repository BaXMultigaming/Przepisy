  "ingredients": [
    "1.5 cups toasted pecans",
    "1.5 cups white sugar",
    "0.75 cup brown sugar",
    "0.5 cup milk",
    "0.375 cup butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ooEGSgo2_hzOOIE708BoBhT7m5c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21038-Pralines-ddms-4x3-step1-6010661076874a239c76604d0d8a7020.jpg"
      ],
      "image": "assets/images/21038/step_01.webp"
    },
    {
      "text": "Combine pecans, white sugar, brown sugar, milk, butter, and vanilla in a large saucepan over medium heat; bring to a boil. Do not stir once mixture begins to boil. Heat to 240 degrees F (115 degrees C) or until a small amount of syrup dropped into cold water forms a soft ball that flattens when removed from water and placed on a flat surface.",
      "section": null,
      "name": null,
