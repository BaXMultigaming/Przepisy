  "ingredients": [
    "1 bunch beets, trimmed and thinly sliced",
    "1 tablespoon olive oil, or as needed",
    "1 pinch sea salt to taste",
    "2 ounces crumbled feta cheese",
    "2 teaspoons chopped fresh chives, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread beets on a sheet of aluminum foil; drizzle with olive oil and season with salt. Fold foil over beets, sealing the edges together to create a packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, flipping once, until beets are tender, about 30 minutes. Carefully open packet; top beets with feta cheese and chives. Reseal packet; grill until cheese melts, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
