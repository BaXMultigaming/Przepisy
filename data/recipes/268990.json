  "ingredients": [
    "1 teaspoon green tea powder (matcha)",
    "1 cup boiling water",
    "0.5 cup milk",
    "2 tablespoons melted butter",
    "1 teaspoon vanilla extract",
    "1 egg",
    "1 cup all-purpose flour",
    "2 tablespoons white sugar",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "1 teaspoon butter, or as needed"
  ],
  "steps": [
    {
      "text": "Place matcha powder in a bowl and slowly add boiling water while whisking continuously until tea is frothy and matcha is fully incorporated. Refrigerate or set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix milk, melted butter, and vanilla extract together in a large mixing bowl. Beat egg into the wet ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, salt, and baking soda together in a bowl. Sift into another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cooled tea mixture into the milk mixture. Add sifted flour mixture to the milk mixture and mix batter thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly buttered frying pan or griddle over medium heat, but do not let it smoke. Pour 1/4 cup batter into the pan and cook until small bubbles are visible near the center of the pancake, 1 to 3 minutes. Flip and cook on the second side 1 to 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
