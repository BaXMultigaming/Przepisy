  "ingredients": [
    "0.25 cup butter",
    "1 pound ground venison",
    "1 pound cubed beef stew meat",
    "1 pound cubed pork stew meat",
    "1 large onion, chopped",
    "1 fresh jalapeno pepper, seeded and minced",
    "3 tablespoons chili powder",
    "1.5 teaspoons ground cumin",
    "0.5 teaspoon cayenne pepper",
    "2 (14 ounce) cans stewed tomatoes, with juice",
    "1 (15 ounce) can tomato sauce",
    "6 cloves garlic, minced",
    "4 cubes beef bouillon, crumbled",
    "2 (12 fluid ounce) cans pilsner-style beer",
    "2 cups water",
    "0.25 cup Kentucky bourbon"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium heat. Add venison, beef, and pork; cook until browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion and jalapeño; cook until tender. Stir in chili powder, cumin, and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the stewed tomatoes, tomato sauce, garlic, and beef bouillon. Add beer, water, and bourbon; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover pot and reduce heat to medium-low; simmer, stirring frequently, until meat is tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
