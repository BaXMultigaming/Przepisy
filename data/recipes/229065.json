  "ingredients": [
    "2.5 cups shredded red cabbage",
    "1 (10 ounce) can mandarin oranges, drained",
    "1 green onion, chopped",
    "0.25 cup sweetened dried cranberries",
    "0.25 cup pine nuts",
    "0.33333334326744 cup canola oil",
    "0.25 cup vinegar",
    "1 tablespoon white sugar",
    "2 pinches salt"
  ],
  "steps": [
    {
      "text": "Lightly toss red cabbage, mandarin orange segments, green onion, and cranberries together in a salad bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast pine nuts in a small skillet over medium heat, stirring constantly, until fragrant and lightly browned, about 2 minutes. Remove immediately to a bowl and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk canola oil, vinegar, sugar, and salt in a bowl until sugar and salt have dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir toasted pine nuts into salad and pour dressing over the top. Toss again to coat salad with dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
