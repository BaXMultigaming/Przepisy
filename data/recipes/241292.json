  "ingredients": [
    "6 skinless, boneless chicken breast halves",
    "salt and ground black pepper to taste",
    "2 tablespoons olive oil",
    "1 (15 ounce) jar mild picante salsa",
    "1 (14 ounce) can chicken broth"
  ],
  "steps": [
    {
      "text": "Season chicken breasts all over with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook chicken breasts in hot oil until browned, 4 to 6 minutes per side. Pour salsa and chicken broth over chicken. Bring mixture to a boil, reduce heat to medium-low and simmer 3 to 5 minutes. Turn chicken over, stir salsa mixture, and continue to simmer until chicken is tender and sauce is slightly thickened, 3 to 5 minutes more. An instant-read thermometer inserted into center of chicken should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
