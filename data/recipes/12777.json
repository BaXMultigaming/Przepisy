  "ingredients": [
    "3 eggs",
    "0.75 cup beer",
    "1.5 cups milk",
    "4 cups pastry flour",
    "1 tablespoon baking powder",
    "0.5 teaspoon baking soda",
    "2 tablespoons cornstarch",
    "salt to taste",
    "ground black pepper to taste",
    "0.0625 teaspoon garlic powder",
    "1.5 pounds cod fillets",
    "2 quarts vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "In a medium bowl, stir together flour, baking powder, baking soda, and cornstarch.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat together eggs and milk. Mix in beer. Stir in flour mixture. Season with salt, black pepper, and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In an electric deep fryer or a heavy saucepan, heat oil to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat fish in batter, and submerge in hot oil. Fry until golden brown, about 4 to 5 minutes. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
