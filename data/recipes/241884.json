  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "0.75 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup fat-free Greek yogurt (such as Fage®)",
    "0.75 cup fat-free buttermilk",
    "0.25 cup butter, melted",
    "1 large egg, lightly beaten",
    "1 tablespoon poppy seeds",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Spray 15 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly spoon 2 cups flour into a dry measuring cup; level with a knife. Combine flour, sugar, baking powder, baking soda, and salt in a bowl using a whisk; make a well in the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir yogurt, buttermilk, butter, eggs, poppy seeds, and vanilla extract together in a separate bowl; add to flour mixture, stirring just until batter is moist. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are golden brown, about 18 minutes. Remove muffins from cups immediately and place on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
