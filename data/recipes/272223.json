  "ingredients": [
    "1 head cauliflower, broken into florets",
    "2 tablespoons water, or as needed",
    "2 eggs, lightly beaten",
    "0.5 cup shredded mozzarella cheese",
    "0.25 cup grated Parmesan cheese",
    "1.5 teaspoons paprika",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "Place cauliflower florets into a food processor and blend into rice-like bits. Transfer to a saucepan and add water. Cook over medium-low heat for 10 to 15 minutes. Transfer cauliflower rice to a bowl and refrigerate until completely cooled, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cooled cauliflower rice onto a clean kitchen towel. Wrap it up tightly and squeeze out all the water. Transfer to a large bowl and add eggs, mozzarella cheese, Parmesan cheese, paprika, oregano, and salt. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cauliflower mixture to the baking sheet and spread and shape it into a pizza crust shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Allow to cool completely before carefully flipping crust over and adding toppings, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
