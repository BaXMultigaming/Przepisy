  "ingredients": [
    "2 tablespoons olive oil",
    "2 tablespoons balsamic vinegar",
    "1 tablespoon Dijon mustard",
    "2 cloves garlic, minced",
    "0.5 teaspoon Worcestershire sauce",
    "1 pinch salt and ground black pepper",
    "4 large portobello mushrooms, stems removed",
    "4 kaiser rolls, split"
  ],
  "steps": [
    {
      "text": "Preheat the grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, balsamic vinegar, Dijon mustard, garlic, Worcestershire sauce, salt, and pepper in a bowl. Brush mixture over tops and bottoms of mushrooms; let stand for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill mushrooms on the preheated grill with the cover closed until mushrooms are browned and tender, about 10 minutes, turning once. Serve on kaiser rolls.",
      "section": null,
