  "ingredients": [
    "3 cups white sugar",
    "1.5 cups butter, softened",
    "6 eggs at room temperature",
    "1 (8 ounce) package cream cheese, softened",
    "1 teaspoon vanilla extract",
    "3 cups all-purpose flour, sifted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease and flour a 10-inch fluted tube pan (such as a Bundt).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until light and fluffy. Add eggs, one at a time, beating well after each addition. Beat in cream cheese and vanilla. Mix in flour, about 1/2 cup at a time, until batter is smooth and velvety. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
