  "ingredients": [
    "1 egg white",
    "0.25 cup confectioners' sugar",
    "1 cup heavy cream",
    "1 teaspoon sherry wine or Marsala",
    "1 teaspoon almond extract",
    "1 cup almond macaroon crumbs",
    "0.5 cup ground almonds",
    "6 red maraschino cherries, chopped",
    "6 green maraschino cherries, chopped",
    "0.25 cup slivered almonds",
    "4 maraschino cherries, halved for garnish"
  ],
  "steps": [
    {
      "text": "In a small bowl, beat egg white until foamy. Gradually beat in sugar, and continue beating until thick and glossy; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip cream in a large bowl. Carefully fold in sherry, almond extract, macaroon crumbs, ground almonds, and chopped red and green cherries. Gently fold egg white into cream mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon into 8 paper baking cups placed in medium size muffin tray. Sprinkle with slivered almonds. Cover muffin tray with clear plastic wrap, then wrap with aluminum foil. Freeze overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To serve: Let sit for 5 minutes at room temperature, then garnish with maraschino cherry halves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
