  "title": "My Meatloaf",
  "description": "Italian-style seasonings and dry onion soup mix are used in this meatloaf rendition. The loaf is basted with ketchup before baking.",
  "authors": [
    "Marian Turgeon"
  ],
  "date_published": "1999-11-29T15:59:03-05:00",
