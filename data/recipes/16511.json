  "ingredients": [
    "1 pound ground beef",
    "0.25 cup ketchup",
    "0.5 packet dry onion soup mix",
    "3 slices leftover bread (heels are great), torn into bite-size pieces",
    "1 teaspoon Italian-style seasoning",
    "1 tablespoon water",
    "water as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the beef, ketchup, soup mix, bread, Italian-style seasoning and water. Mix well. Shape into a loaf and place into a 9 inch pie pan OR a 9x13 inch baking dish. Baste the top of the meatloaf with ketchup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 425 degrees F (220 degrees C) for one hour, or until the edges are just crispy and the top has a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool for 15 to 20 minutes before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
