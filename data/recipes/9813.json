  "ingredients": [
    "1 cup butter",
    "0.5 cup white sugar",
    "1 egg yolk",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.66666668653488 cup crushed potato chips",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream together butter and sugar until smooth. Stir in egg yolk and vanilla. Gradually stir in the flour until just blended, then mix in crushed potato chips and pecans. Drop by rounded spoonfuls onto ungreased cookie sheets. Criss-cross the top using a fork dipped in water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 12 to 14 minutes in preheated oven, or until edges are lightly browned. Cool on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
