  "ingredients": [
    "0.66666668653488 cup white sugar",
    "0.66666668653488 cup packed brown sugar",
    "2 large eggs",
    "0.5 cup butter, softened",
    "0.5 cup shortening",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon ground nutmeg",
    "3.5 cups old-fashioned rolled oats",
    "2 cups thinly sliced apples",
    "1 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, brown sugar, eggs, butter, shortening, baking soda, cinnamon, vanilla extract, salt, baking powder, and nutmeg together in a bowl with an electric mixer on medium speed until smooth; stir in oats, apples, and flour until dough is evenly combined. Drop dough by rounded tablespoons, about 2 inches apart, onto baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are lightly browned, 9 to 11 minutes. Transfer cookies to a wire rack to cool, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
