  "ingredients": [
    "2.5 quarts water",
    "4 cups peeled and diced potatoes",
    "2.5 cups diced turkey ham",
    "1 large onion, diced",
    "1 (10 ounce) can butter beans, rinsed and drained",
    "3 carrots, chopped",
    "2 stalks celery, chopped",
    "1 cup frozen corn kernels",
    "1 (8 ounce) can cream-style corn",
    "1 teaspoon dill",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 (12 fluid ounce) can evaporated milk"
  ],
  "steps": [
    {
      "text": "Heat water in a 6-quart pot over high heat; add potatoes, turkey ham, onion, beans, carrots, celery, frozen corn, cream-style corn, dill, salt, and black pepper. Bring water to a boil, lower heat to medium-low, and simmer, stirring occasionally, until potatoes are tender and soup is reduced, 1 to 1 1/2 hours.",
