  "ingredients": [
    "1 cup sugar",
    "1 cup water",
    "zest of 2 lemons (optional)",
    "6 cups water, divided",
    "2 cups freshly squeezed lemon juice",
    "1 dragon fruit, peeled and cubed",
    "ice as needed"
  ],
  "steps": [
    {
      "text": "Combine sugar, water, and lemon zest in a small saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil over medum-high heat and stir until the sugar is completely dissolved, 3 to 5 minutes. Let cool, then strain simple syrup to remove zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine simple syrup, 4 cups of water, and lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cubed dragon fruit and remaining 2 cups of water in a blender; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add dragon fruit mixture to the lemonade, stir to combine. Serve over ice.",
