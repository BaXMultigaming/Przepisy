  "ingredients": [
    "0.5 cup warm water",
    "6 tablespoons flax seed meal",
    "1 cup turbinado sugar",
    "0.75 cup unsweetened applesauce",
    "0.25 cup safflower oil",
    "1 teaspoon vanilla extract",
    "2.5 cups zucchini, grated",
    "2 cups oat flour",
    "1 cup all-purpose flour",
    "1 tablespoon baking powder",
    "1 tablespoon ground cinnamon",
    "2 teaspoons ground nutmeg",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 2 muffin pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk warm water and flaxseed together in a large bowl. Mix in sugar, applesauce, oil, and vanilla extract. Stir in zucchini until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift oat flour, all-purpose flour, baking powder, cinnamon, nutmeg, salt, and baking soda into a bowl. Stir in raisins and combine with the zucchini mixture until batter is just mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer batter into muffin cups using 1/4 cup measure.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into a muffin comes out clean, 50 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
