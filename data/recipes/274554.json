  "ingredients": [
    "cooking spray",
    "8 fresh tomatillos, husks removed",
    "1 serrano pepper",
    "1 jalapeno pepper",
    "0.5 medium yellow onion, quartered",
    "3 cloves garlic, unpeeled",
    "0.5 cup cilantro leaves",
    "1 lime, juiced",
    "1 tablespoon kosher salt",
    "0.5 tablespoon freshly ground black pepper",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler to high. Spray a baking sheet with fat-free cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut tomatillos in half and place cut-side-down on the prepared baking sheet with serrano pepper, jalapeno pepper, onion, and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until charred, about 20 minutes, turning peppers halfway through cooking time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove vegetables from the oven and let cool completely, about 15 minutes. Remove stems from peppers and peel garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomatillos, serrano pepper, jalapeno pepper, onion, garlic, cilantro, lime juice, and salt in a food processor and pulse to desired consistency. Store in an airtight container in the refrigerator for at least 30 minutes to meld flavors.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
