  "ingredients": [
    "1 large egg, beaten",
    "0.5 cup milk",
    "salt to taste",
    "1 pinch white sugar, or to taste",
    "0.5 cup semolina flour",
    "3 teaspoons olive oil, divided",
    "1 pinch red pepper flakes, or to taste"
  ],
  "steps": [
    {
      "text": "Whisk egg, milk, salt, and sugar together in a bowl. Add semolina flour and whisk until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 teaspoon oil in a griddle or pan over medium heat. Drop ladlefuls of batter in batches into the hot pan and fry until set and golden, 2 to 4 minutes, flipping halfway. Remove from the pan and let cool enough to handle, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll up pancakes and thinly slice into \"noodles.\"",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining 2 teaspoons olive oil in the same pan over medium heat. Add pepper flakes and \"noodles.\" Pan-fry until almost crisp, 2 to 4 minutes.",
      "section": null,
