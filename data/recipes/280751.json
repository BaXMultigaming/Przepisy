  "steps": [
    {
      "text": "Heat olive oil in a 4-quart pot over medium-low heat. Add yellow and red onions, garlic, salt, oregano, bay leaf, and black pepper; cook and stir until onions are translucent, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chicken broth, pork, split peas, and carrots; bring to a boil. Reduce heat to low; simmer until split peas are soft, about 1 1/2 hours.",
      "section": null,
      "name": null,
