  "ingredients": [
    "1 pound Persian cucumbers, thinly sliced",
    "1 teaspoon salt",
    "0.66666668653488 cup rice vinegar",
    "0.25 cup white sugar",
    "1 teaspoon soy sauce",
    "1 teaspoon sesame oil",
    "2 tablespoons sesame seeds"
  ],
  "steps": [
    {
      "text": "Place Persian cucumbers in a bowl; add salt and mix well. Let sit until cucumbers release their juices, about 10 minutes. Squeeze excess juice from cucumbers and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together rice vinegar, white sugar, soy sauce, and sesame oil in a bowl until sugar is dissolved; pour over cucumbers. Marinate for 30 minutes. Garnish with sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
