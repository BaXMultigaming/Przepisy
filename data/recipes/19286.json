  "ingredients": [
    "2 cups quick cooking oats",
    "1.75 cups all-purpose flour",
    "1 cup white sugar",
    "0.5 cup sliced almonds",
    "1 cup melted butter",
    "2 tablespoons golden syrup",
    "2 tablespoons boiling water",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, flour, sugar, and almonds in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small saucepan over medium heat. Off heat, stir in golden syrup, water, and baking soda. Stir butter mixture into flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into walnut-size balls; place 2 inches apart on the prepared cookie sheets. Slightly flatten dough balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 15 to 18 minutes. Transfer cookies to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
