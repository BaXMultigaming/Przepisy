  "ingredients": [
    "2 sticks butter",
    "3 pounds boneless beef roast",
    "4.5 cups water, divided",
    "1 onion, thinly sliced",
    "2 teaspoons salt",
    "0.5 teaspoon ground black pepper",
    "4 potatoes, cubed",
    "4 carrots, chopped",
    "2 stalks celery, chopped",
    "2 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium-high heat. Cook beef in hot butter until browned on all sides. Pour in 4 cups water and bring to a boil. Add onion, salt, and pepper. Reduce heat to low and simmer for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add potatoes, carrots, and celery; simmer for 1 1/2 more hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together remaining 1/2 cup water and flour in a small bowl to form a thin paste; stir into soup and simmer until thickened, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
