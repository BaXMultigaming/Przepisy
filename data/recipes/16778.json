  "ingredients": [
    "1 (1 pound) loaf day-old French bread, cut into 1/2 inch cubes",
    "0.5 cup vegetable oil",
    "2 tablespoons garlic powder",
    "2 tablespoons dried basil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper or a silicone liner.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread into a bowl; drizzle with oil and sprinkle with garlic powder and basil. Mix with your hands until bread is well coated and seasonings are evenly distributed. Pour onto the prepared baking sheet and spread into a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring occasionally, until lightly browned and toasted, 6 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
