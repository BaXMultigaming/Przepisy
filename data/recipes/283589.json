  "ingredients": [
    "16 rice paper sheets",
    "0.5 (16 ounce) package rice noodles",
    "16 leaves lettuce",
    "1 cup shredded red cabbage",
    "1 cup shredded green cabbage",
    "1 cup bean sprouts",
    "1 cup pea sprouts",
    "0.66666668653488 cup chopped fresh cilantro",
    "1 medium carrot, shredded",
    "0.5 medium avocado, sliced",
    "0.5 medium red bell pepper, sliced",
    "0.5 medium green bell pepper, sliced",
    "0.5 medium yellow bell pepper, sliced"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil. Remove from the heat and add rice noodles. Let soak for 8 to 10 minutes, until noodles are soft but firm, stirring occasionally. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a bowl with hot water (not boiling). Submerge 1 sheet of rice paper into the water until soft, about 15 seconds. Place rice paper on a work surface and lay 1 piece of lettuce in the middle, starting at the bottom. Add some rice noodles, cabbage, sprouts, cilantro, carrot, avocado, and bell peppers. Pull up the bottom of the rice paper and roll up and over the vegetables. Fold in the sides of the sheet to seal. Repeat to make remaining rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
