  "ingredients": [
    "0.5 cup cornmeal",
    "0.5 cup whole-wheat pastry flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup applesauce",
    "0.5 cup soy milk",
    "0.25 cup agave nectar",
    "2 tablespoons canola oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a 6-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornmeal, flour, baking soda, and salt in a large bowl; stir in applesauce, soy milk, and agave nectar. Slowly stir in oil while continually stirring. Pour into the prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick or small knife inserted in the crown of a muffin comes out clean, 15 to 20 minutes.",
      "section": null,
      "name": null,
