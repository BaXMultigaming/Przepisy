  "ingredients": [
    "1.25 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon pumpkin pie spice",
    "0.5 teaspoon salt",
    "1 cup soy milk",
    "1 tablespoon brown sugar",
    "3 tablespoons pumpkin puree",
    "1 teaspoon vanilla extract",
    "1.5 teaspoons vegetable oil",
    "0.33333334326744 cup water"
  ],
  "steps": [
    {
      "text": "Combine flour, baking powder, pumpkin pie spice, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk, brown sugar, pumpkin puree, vanilla extract, oil, and water together in a second bowl; mix thoroughly. Make a well in the flour mixture, add milk mixture, and mix until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a nonstick skillet over medium-high heat. Drop 1/4 cup pancake batter onto the hot skillet and cook until bubbles form and edges are dry, 3 to 5 minutes. Flip and cook until browned on the other side, 3 to 5 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
