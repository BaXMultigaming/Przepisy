  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a layer of tomato slices in an 8-inch square baking pan. Spread with a thin layer of mayonnaise and sprinkle with about 1/4 of the Cheddar cheese. Season with salt and pepper. Repeat layers, ending with the remaining Cheddar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tomatoes are softened and cheese is melted and bubbly, 20 to 25 minutes.",
