  "ingredients": [
    "1 cup unsalted butter",
    "0.75 cup honey",
    "1 teaspoon lemon juice",
    "2 cups whole wheat flour",
    "1 cup quick-cooking oats",
    "0.5 cup wheat germ",
    "2 eggs",
    "0.25 cup honey",
    "1 cup chopped almonds",
    "1 cup jumbo semisweet chocolate chips",
    "0.5 cup chopped dates",
    "0.5 cup chopped dried apricots",
    "0.5 cup unsweetened flaked coconut",
    "2 tablespoons sesame seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the butter, 3/4 cup honey, and lemon juice until well blended. Combine the flour, oats, and wheat germ; mix into the honey mixture. Spread evenly into the bottom of an ungreased 9x13 inch baking pan. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, beat eggs while gradually pouring in 1/4 cup honey. Stir in almonds, chocolate chips, dates, apricots, coconut, and sesame seeds until they are evenly distributed and well coated. Spread over the crust in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 35 minutes in the preheated oven, or until center is set, and the top is lightly browned. Cool completely before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
