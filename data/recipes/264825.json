  "ingredients": [
    "1 medium sweet potato, peeled",
    "1 tablespoon canola oil",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon pepper",
    "0.125 teaspoon garlic powder",
    "0.125 teaspoon ground sweet paprika"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut sweet potato into 1/2-inch wide fries. Place in a bowl with canola oil; toss to coat. Season with salt, pepper, garlic powder, and paprika; mix until all fries are evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9UvR2KB1JLaIgaHbXFhBu8jVkEE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/264825-AirFriedSweetPotatoFries-mfs-Step2-0392-af8dab4740cf46f3bffdd3c7c0369c02.jpg"
      ],
      "image": "assets/images/264825/step_02.webp"
    },
    {
      "text": "Working in batches if necessary, place an even layer of fries in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/--wFpKXmnqsp2NsjMk8hAp9aDX0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/264825-AirFriedSweetPotatoFries-mfs-Step3-0395-c97a945fe56c4a3990094264aa46099a.jpg"
      ],
      "image": "assets/images/264825/step_03.webp"
    },
    {
      "text": "Cook in the preheated air fryer until golden, about 10 minutes. Repeat to cook remaining fries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WNKDm2WgydnRCnSayPD_hl8v7dU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/264825-AirFriedSweetPotatoFries-mfs-Step4-0408-4d054b8379f040fb996e167e49af0e36.jpg"
      ],
      "image": "assets/images/264825/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
