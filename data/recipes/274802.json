  "ingredients": [
    "0.75 cup white whole wheat flour",
    "1 tablespoon unsweetened cocoa powder",
    "0.25 teaspoon salt",
    "0.5 cup butter",
    "1 tablespoon instant espresso powder",
    "5 ounces semisweet chocolate chips",
    "0.5 cup white sugar",
    "0.25 cup packed brown sugar",
    "3 large eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cocoa, and salt together in a bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small saucepan over low heat. Stir in espresso powder. Stir in chocolate chips until melted. Remove from heat; mix in white sugar and brown sugar until fully blended. Add eggs and vanilla extract and mix well. Stir in the flour mixture until just combined. Pour batter into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is dry and edges have started to pull away from the sides of the pan, 25 to 30 minutes. Do not overbake. Let cool completely before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
