  "ingredients": [
    "2 beef soup bones",
    "2 tablespoons kosher salt",
    "5 stalks celery",
    "1 onion, quartered",
    "0.5 teaspoon ground black pepper",
    "2 'bouqet garni' spice balls",
    "0.5 pound baby carrots",
    "0.25 cup fresh parsley",
    "11 cloves garlic, peeled",
    "1 cup barley"
  ],
  "steps": [
    {
      "text": "Place beef bones in a large size slow cooker. Add salt, celery stalks, onion, bouquets garni sachets, pepper, carrots, parsley and garlic. Fill slow cooker within 2 inches of the top with hot water and cook for 6 hours, covered on high heat, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add barley and cook for 2 more hours stirring occasionally or until meat can easily be removed from bones.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and discard onion, bouquets garni sachets, celery, and parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer bones to a dish and remove meat from bones, being careful not to take off cartilage or gristle. Place meat back into soup, stir, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
