  "ingredients": [
    "2 tablespoons extra-virgin olive oil",
    "1 pound fresh broccoli, cut into spears",
    "3 cloves garlic, minced",
    "1 pinch red pepper flakes",
    "3 tablespoons water",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a nonstick skillet. Add garlic and pepper flakes and cook for 2 to 3 minutes. Add broccoli, stirring until coated in oil. Add water and cover the skillet. Steam until crisp-tender, about 5 minutes. Add salt and pepper to taste.",
