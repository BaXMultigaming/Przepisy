  "ingredients": [
    "0.25 cup mayonnaise",
    "1.5 teaspoons Cajun seasoning",
    "6 hard-boiled eggs",
    "1.5 ounces grated sharp Cheddar cheese",
    "3 bacon strips, cooked and crumbled"
  ],
  "steps": [
    {
      "text": "Combine mayonnaise and Cajun seasoning in a medium bowl; go easy on the spice if you don't like a lot of heat. Add eggs and mash with a fork. Add Cheddar cheese and crumbled cooked bacon. Mix until thoroughly combined. Refrigerate until ready to serve.",
