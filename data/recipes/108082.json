  "ingredients": [
    "1.5 cups quinoa",
    "0.25 teaspoon salt",
    "3.5 cups water",
    "1 bunch green onions, chopped",
    "0.75 cup chopped celery",
    "0.5 cup raisins",
    "1 pinch cayenne pepper",
    "1 tablespoon vegetable oil",
    "1 tablespoon distilled white vinegar",
    "2 tablespoons lemon juice",
    "2 tablespoons sesame oil",
    "0.33333334326744 cup chopped fresh cilantro",
    "0.75 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Bring the quinoa, salt, and water to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until the quinoa is tender, 20 to 25 minutes. Once done, scrape into a large bowl, and allow to cool for 20 minutes. Stir in the green onions, celery, raisins, cayenne pepper, vegetable oil, vinegar, lemon juice, and sesame oil. Allow to stand at room temperature for 1 hour to allow the flavors to blend. Stir in the cilantro and pecans before serving.",
