  "ingredients": [
    "6 slices Smithfield® Hometown Original Bacon, cooked",
    "6 medium sweet potatoes",
    "1 tablespoon butter",
    "0.5 cup heavy cream",
    "3 tablespoons brown sugar, divided",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "0.25 teaspoon black pepper",
    "6 tablespoons marshmallow creme"
  ],
  "steps": [
    {
      "text": "Bake sweet potatoes for 40-50 minutes at 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut off top 1/3 of potato and scoop out flesh, leaving 1/4 inch in shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix potato with butter, cream, 2 tbsp brown sugar, nutmeg, salt and pepper and spoon back into reserved potato shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top each with 1 strip bacon cut into pieces, 1 tablespoon marshmallow creme, and then sprinkle all with remaining brown sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil for 3-5 minutes or until marshmallow creme is toasty brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve hot!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
