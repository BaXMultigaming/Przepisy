  "title": "Ramen Eggs (Ajitsuke Tamago)",
  "description": "These soft-boiled, jammy eggs are marinated in a mixture of soy, mirin, and sake. Cut them in half and add them to your ramen soup for extra flavor.",
  "authors": [
    "Lazarus"
  ],
  "date_published": "2022-03-10T09:11:24-05:00",
  "date_modified": "2022-03-29T11:01:25-04:00",
  "prep_time": "PT10M",
  "cook_time": "PT10M",
  "total_time": "PT155M",
  "yield": [
    "4",
    "4 eggs"
  ],
  "categories": [
    "Side Dish"
  ],
  "cuisines": [
    "Asian Inspired"
  ],
  "regions": [
    "Asian Inspired"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "4 large eggs",
    "3 tablespoons soy sauce",
    "2 tablespoons mirin (Japanese rice wine)",
    "1 tablespoon cooking sake",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring eggs to room temperature by soaking them in warm water for about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of water to a low boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully pierce the bottom of each egg with thumb tack. Gently lower eggs into the boiling water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently lower eggs into water and boil for 6 minutes 20 seconds. Remove eggs and place in a bowl of ice water until completely cool, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the eggs are cooling, stir together soy sauce, mirin, sake, and pepper for marinade in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully peel cooled eggs; try to start from the middle of the shell and work you way up and down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place whole peeled eggs in marinade. Refrigerate for at least 2 to 4 hours, or up to 2 days for stronger flavor, turning eggs every 30 minutes or as often as you prefer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice eggs in half when ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
