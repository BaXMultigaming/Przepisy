  "ingredients": [
    "1.5 pounds elk roast",
    "1.5 tablespoons steak seasoning",
    "1 teaspoon rubbed sage",
    "1 (10.5 ounce) can condensed cream of onion soup",
    "1 cup water",
    "1 small onion, chopped",
    "4 cloves garlic, chopped",
    "1 cup sour cream"
  ],
  "steps": [
    {
      "text": "Season elk roast with steak seasoning and sage; place into a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir condensed soup, water, onion, and garlic together in a bowl; pour over roast. Cover and cook on Low until meat is easily shredded with a fork, 5 to 7 hours. Stir in sour cream and cook for 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove meat and shred with a fork. Return shredded meat to the slow cooker and mix with sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
