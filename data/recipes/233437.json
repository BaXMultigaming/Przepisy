  "title": "Grilled Vegetable Salad",
  "description": "A delicious grilled vegetable salad with zucchini, squash, bell peppers, asparagus, and corn tossed with a tangy vinaigrette full of fresh herbs.",
  "authors": [
    "Celeste"
  ],
  "date_published": "2019-07-10T03:04:41-04:00",
