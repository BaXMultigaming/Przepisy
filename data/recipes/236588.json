  "ingredients": [
    "1 cup white sugar",
    "0.5 cup margarine",
    "2 eggs, beaten",
    "1 cup mashed bananas",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 (10 ounce) can mandarin oranges, drained and chopped",
    "0.5 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour 12 muffins cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and margarine together in a bowl using an electric mixer until smooth and creamy; stir in eggs. Stir bananas into margarine mixture; stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a bowl; stir into margarine mixture until just combined. Fold oranges and coconut into batter. Spoon batter into muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
