  "ingredients": [
    "5 red potatoes, peeled and cubed",
    "salt and pepper to taste",
    "0.75 cup all-purpose flour for coating",
    "0.5 small onion, diced",
    "2 tablespoons vegetable oil",
    "3 tablespoons water"
  ],
  "steps": [
    {
      "text": "Season potatoes with salt and pepper to taste. Place flour in a shallow dish or bowl; coat potatoes with flour. Add onion to potato/flour mixture and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a medium skillet over medium-high heat. When oil is hot add potato/onion mixture and cook until golden brown, stirring occasionally to prevent burning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When mixture has browned, reduce heat to low, add water and cover skillet. Simmer for 20 minutes, or until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
