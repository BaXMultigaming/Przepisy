  "ingredients": [
    "1 pound lean pork shoulder, cut into 1/4-inch cubes",
    "2 tablespoons all-purpose flour",
    "2 tablespoons shortening",
    "0.5 cup chopped onion",
    "1 clove garlic, minced",
    "2 cups water",
    "1 (16 ounce) can whole peeled tomatoes, chopped",
    "2 (7 ounce) cans chopped green chiles (such as Ortega®)",
    "1 teaspoon salt, or to taste",
    "0.25 teaspoon oregano"
  ],
  "steps": [
    {
      "text": "Dredge pork in flour until evenly coated, shaking off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt shortening in a large, deep skillet over medium-high heat. Add pork; cook until thoroughly browned on all sides, 5 to 6 minutes. Add onion and garlic; cook until onion is soft, about 5 minutes. Add water, tomatoes, green chiles, salt, and oregano.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover; simmer, stirring occasionally, until pork is tender, 1 to 2 hours. Uncover; simmer until sauce reaches desired consistency, 5 to 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
