  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "1 cup quick-cooking oats",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1.25 cups Greek yogurt",
    "2 eggs",
    "0.5 cup unsweetened applesauce",
    "0.33333334326744 cup brown sugar",
    "2 tablespoons water",
    "1.5 tablespoons vanilla extract",
    "1.25 cups fresh blueberries",
    "1 teaspoon all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a muffin tin with cooking spray or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 2 cups flour, oats, baking soda, baking powder, and salt together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk Greek yogurt, eggs, applesauce, brown sugar, water, and vanilla extract together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss blueberries with 1 teaspoon flour to prevent them from sinking to the bottom of the muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold flour mixture into the Greek yogurt mixture. Fold in blueberries. Spoon batter into the prepared muffin tin, filling each cup 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
