  "title": "Classic Vichyssoise",
  "description": "This vichyssoise recipe is a thick soup made with boiled leeks, onions, potatoes, and herbs blended until smooth and mixed with cream before serving.",
  "authors": [
    "2doulas"
  ],
  "date_published": "1999-08-17T22:44:09-04:00",
