  "ingredients": [
    "10 ripe tomatoes",
    "2 tablespoons butter",
    "2 tablespoons olive oil",
    "2 carrots, chopped",
    "1 onion, chopped",
    "1 green bell pepper, chopped",
    "4 cloves garlic, minced",
    "0.25 cup Burgundy wine",
    "0.25 cup chopped fresh basil",
    "0.25 teaspoon Italian seasoning",
    "2 stalks celery",
    "1 bay leaf",
    "2 tablespoons tomato paste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3r6f3TyUJXvJktMcE_xDOfyZ4ME=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21126-homemade-tomato-sauce-i-VAT-4x3-step-01-83a0392056eb498da891e16ba4ada6ca.jpg"
      ],
      "image": "assets/images/21126/step_01.webp"
    },
    {
      "text": "Bring a large pot of water to a boil. Prepare a large bowl of ice water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4goHfd0DPXjYIn2oUCdXcbZowr0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21126-homemade-tomato-sauce-i-VAT-4x3-step-02-21a98a9ba64840cdb0c9b1f53bf3cf01.jpg"
      ],
      "image": "assets/images/21126/step_02.webp"
    },
    {
      "text": "Plunge whole tomatoes in boiling water until skin starts to peel, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6GeNN8TmTsJWGhFoPJMQrnbamKA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21126-homemade-tomato-sauce-i-VAT-4x3-step-03-590118c471d547ca821440d8793b8d4a.jpg"
      ],
      "image": "assets/images/21126/step_03.webp"
    },
    {
      "text": "Remove with a slotted spoon and place in ice bath. Let rest until cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0zZ8Q_NzgDDeF-O9D5YL--iuAKU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21126-homemade-tomato-sauce-i-VAT-4x3-step-04-4d2e5772dbc348f6ac7f40b6584358b4.jpg"
      ],
      "image": "assets/images/21126/step_04.webp"
    },
    {
      "text": "Remove peels, squeeze out seeds and chop 8 tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Uk5fyae51I_cNWLr5-809ZcjQxM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21126-homemade-tomato-sauce-i-VAT-4x3-step-05-2c64d1c393104c5e8120ecc0af09dd7f.jpg"
      ],
      "image": "assets/images/21126/step_05.webp"
    },
    {
      "text": "Puree tomatoes in a blender or food processor until smooth. Chop remaining 2 tomatoes and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tNKDs8PQpdRv2pNCWWmG_eNHjd4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21126-homemade-tomato-sauce-i-VAT-4x3-step-06-c92cd2ecc9c641e288423e832807314b.jpg"
      ],
      "image": "assets/images/21126/step_06.webp"
    },
    {
      "text": "Heat butter and oil in a large pot or Dutch oven over medium heat. Add carrots, onion, bell pepper, and garlic; cook and stir until onion softens, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ImGJmlNcr0wcboItSWLQIb4hTEk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21126-homemade-tomato-sauce-i-VAT-4x3-step-07-cd2d01fe04484f63a83a9e4a8e05c64a.jpg"
      ],
      "image": "assets/images/21126/step_07.webp"
    },
    {
      "text": "Pour in pureed tomatoes, then stir in chopped tomatoes, wine, basil, and Italian seasoning. Place celery stalks and bay leaf in the pot and bring to a boil. Reduce heat to low, cover, and simmer for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Qt9BfV_3F7IAxwpU7iI9_l86qzA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21126-homemade-tomato-sauce-i-VAT-4x3-step-08-adf13fe0cdec4e59857ffcaa1a84789c.jpg"
      ],
      "image": "assets/images/21126/step_08.webp"
    },
    {
      "text": "Stir in tomato paste; simmer for an additional 2 hours. Discard celery and bay leaf and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nOoqs4qG7wC_C8ndHNNkZHgXeDA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21126-homemade-tomato-sauce-i-VAT-hero-4x3-72fecafc90c14b50a021baeee29ce303.jpg"
      ],
      "image": "assets/images/21126/step_09.webp"
    }
  ],
