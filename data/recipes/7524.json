  "ingredients": [
    "1.5 cups butter",
    "3 cups white sugar",
    "5 eggs",
    "3 cups all-purpose flour",
    "2 teaspoons lemon extract",
    "0.75 cup lemon-lime flavored carbonated beverage"
  ],
  "steps": [
    {
      "text": "Cream together the butter and sugar for 20 minutes. Add eggs, one at a time. Add flour, lemon extract and fold in the 7UP soft drink.",
