  "ingredients": [
    "0.5 cup butter",
    "1.5 cups confectioners' sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "2 bananas",
    "1 tablespoon lemon juice",
    "1 (1 ounce) square unsweetened chocolate, grated",
    "1 (9 inch) pie crust, baked"
  ],
  "steps": [
    {
      "text": "Cream together butter or margarine and confectioner's sugar. Beat in eggs one at a time; beat for 3 minutes after each addition. Stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice 2 bananas, and sprinkle with lemon juice. Fold grated chocolate and bananas into sugar mixture. Turn filling into cooled pie shell. Garnish with walnuts, banana slices, and whipped cream.",
      "section": null,
      "name": null,
      "url": null,
