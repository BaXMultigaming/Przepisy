  "ingredients": [
    "0.5 cup unsalted butter, softened",
    "0.5 cup white sugar",
    "1 large egg",
    "1 cup molasses (not blackstrap)",
    "2.5 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground ginger",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon salt",
    "1 cup hot water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and line a 9-inch square baking pan with parchment.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter in a large bowl with an electric mixer until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p0aO7YUSXigCsn-QqvXSHZr9H4c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7322-Favorite-Old-Fashioned-Gingerbread-ddmfs-step-1-103885-4x3-dfe339f89fc34e388f039883b87bf675.jpg"
      ],
      "image": "assets/images/7322/step_02.webp"
    },
    {
      "text": "Add sugar and beat until light and fluffy, about 3 minutes. Beat in egg and molasses until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0-3TI-DA9Km4q1NrLS-ySGDWaS8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7322-Favorite-Old-Fashioned-Gingerbread-ddmfs-step-2-103889-4x3-999f2940a97b4e9c9d3c80249143658d.jpg"
      ],
      "image": "assets/images/7322/step_03.webp"
    },
    {
      "text": "Sift flour, baking soda, cinnamon, ginger, cloves, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J3OvKSl0IiPlaYDHlsXftWMqrSQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7322-Favorite-Old-Fashioned-Gingerbread-ddmfs-step-3-103894-315ddaf73cab4a65ba5c633ab93bb4cb.jpg"
      ],
      "image": "assets/images/7322/step_04.webp"
    },
    {
      "text": "Gradually add flour-spice mixture to molasses mixture, beating well after each addition until well combined. Mix in water until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H4Z6vCSNSmvkizspsZ1lH-Cktiw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7322-Favorite-Old-Fashioned-Gingerbread-ddmfs-step-4-103897-ae4d5a9dfa944dee9d626685d5e755d4.jpg"
      ],
      "image": "assets/images/7322/step_05.webp"
    },
    {
      "text": "Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tcpCFsDbtfpfxQT9JE4RRtDbxbE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7322-Favorite-Old-Fashioned-Gingerbread-ddmfs-step-5-103906-e94324bc1ba3486b96fdb937b2964918.jpg"
      ],
      "image": "assets/images/7322/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. A toothpick inserted in the center should come out clean. If not, continue baking, checking often for doneness, 15 to 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wG5hMh_KmITD0Xr1LAITqPYBPPU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7322-Favorite-Old-Fashioned-Gingerbread-ddmfs-step-6-103910-0802e48b5c5a4b8b92d97b372ccbfb75.jpg"
      ],
      "image": "assets/images/7322/step_07.webp"
    },
    {
      "text": "Let cool in the pan before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zy_j5bHmB7mbDHQ26CHdLTvRgPo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7322-favorite-old-fashioned-gingerbread-DDMFS-4x3-a15c0a20c8824c4cb4300989527f0d2f.jpg"
      ],
      "image": "assets/images/7322/step_08.webp"
