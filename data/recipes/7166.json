  "ingredients": [
    "1 banana, peeled and mashed",
    "0.5 cup egg substitute",
    "0.75 cup vanilla soy milk",
    "2 tablespoons vegetable oil",
    "0.5 cup applesauce",
    "2 cups white rice flour",
    "1 tablespoon sucanat",
    "0.75 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup dried cherries",
    "0.5 cup vanilla baking chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (205 degrees C). Lightly grease or line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl blend the banana, egg substitute, soy milk, oil and applesauce together. Stir in the rice flour, sucanat, baking powder and salt. Mix until just moistened then stir in the dried cherries and vanilla chips. Pour batter into the prepared muffin tin, filling each cup 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 400 degrees F (205 degrees C) for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
