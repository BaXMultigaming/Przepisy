  "ingredients": [
    "3 cups vegetable broth",
    "3 potatoes, cubed",
    "0.5 cup chopped onion",
    "0.5 cup chopped carrots",
    "0.25 cup chopped celery",
    "5 slices fat-free American cheese",
    "0.5 cup skim milk",
    "1 tablespoon hot pepper sauce",
    "salt and pepper to taste",
    "3 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "In a medium saucepan over high heat, combine the broth, potatoes, onions, carrots and celery. Bring to a boil and reduce heat to low. Cover and simmer about 15 minutes, or until potatoes are tender. Mash lightly with a potato masher.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add American cheese, milk and hot sauce and continue cooking over low heat until cheese melts, stirring occasionally. Add salt and pepper to taste. Garnish with fresh parsley and hot pepper sauce, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
