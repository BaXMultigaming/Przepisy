  "ingredients": [
    "4 ounces herb-seasoned dry bread stuffing mix",
    "0.33300000429153 cup melted butter",
    "4 cups cubed zucchini",
    "2 medium carrots, grated",
    "1 small onion, chopped",
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "0.5 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine stuffing mix and butter in a small bowl. Combine zucchini, carrots, and onion in a separate bowl; add condensed soup and sour cream; stir in ½ stuffing mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer zucchini mixture to a 9x13-inch casserole dish; sprinkle remaining ½ stuffing mixture over top. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour.",
      "section": null,
