  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 cup salted butter, softened",
    "0.5 cup white sugar",
    "0.25 cup dark brown sugar",
    "0.25 cup sugar and sucralose blend for baking (such as Natur® Bakers Blend)",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "0.5 cup white chocolate chips",
    "0.25 cup candy-coated milk chocolate pieces",
    "0.25 cup candy corn",
    "3 tablespoons sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly butter an 8-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour and baking powder in a small bowl to remove any lumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter with white sugar, brown sugar, and sugar blend in a large bowl until well combined. Stir in egg and vanilla extract, beating until smooth. Add flour mixture and blend until just combined, taking care not to overbeat the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently fold white chocolate chips, milk chocolate pieces, candy corn, and almonds into the batter. Spread batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 30 to 35 minutes. Let cool for at least 30 minutes before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
