  "title": "Halloween Candy Blondies",
  "description": "Transform your leftover Halloween candy into these gooey blondie bars that pair perfectly with ice cream or a hot or cold beverage of your choice.",
  "authors": [
    "Sandra Garth"
  ],
  "date_published": "2020-06-19T00:32:06-04:00",
