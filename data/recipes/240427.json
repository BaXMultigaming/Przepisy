  "ingredients": [
    "1 cup quick-cooking steel-cut oats",
    "3 cups water",
    "2 cups hot water, or more to taste",
    "1 (15 ounce) can pumpkin puree",
    "1 teaspoon white sugar",
    "0.5 teaspoon herbes de Provence",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 pinch garlic powder",
    "1 tablespoon virgin olive oil"
  ],
  "steps": [
    {
      "text": "Stir oats into 3 cups water in a saucepan; bring to a boil, reduce heat to medium-low, and cook at a simmer until the oats are tender and the water is absorbed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir 2 cups hot water into the cooked oats. Strain water to use as 'oat broth' into a large sauce pan. Save cooked oats for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir pumpkin puree, sugar, herbes de Provence, salt, black pepper, and garlic powder into the oat broth with a whisk until smooth; add olive oil and stir to combine. Thin the gravy with more hot water, if desired. Place the saucepan over medium heat, bring the gravy to a simmer, and cook until hot, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
