  "ingredients": [
    "3 eggs",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "2 cups grated zucchini",
    "2 teaspoons vanilla extract",
    "3 cups all-purpose flour",
    "0.5 cup chopped walnuts",
    "3 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "0.25 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 8x4-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9b8HxpWxnTpFCinQP_tnC6uqi8A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6915-zucchini-bread-iv-DDMFS-step-01-da48a504270f4bed9800df2e86180859.jpg"
      ],
      "image": "assets/images/6915/step_01.webp"
    },
    {
      "text": "Beat eggs in a large bowl until light and frothy. Add sugar and oil; mix until well combined. Stir in zucchini and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XPwxic4xenxwrhFPE2QL4adsZOY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6915-zucchini-bread-iv-DDMFS-step-02-585e6365e19845f397da3005a0c898bf.jpg"
      ],
      "image": "assets/images/6915/step_02.webp"
    },
    {
      "text": "Combine flour, nuts, cinnamon, salt, baking soda, and baking powder; stir into egg mixture until incorporated. Divide batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5_ChNVJNFWht6i9Vj3fFuwiKbLI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6915-zucchini-bread-iv-DDMFS-step-03-45ea30a5b7ae4f76b154876192bd1e01.jpg"
      ],
      "image": "assets/images/6915/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of each loaf comes out clean, 60 to 70 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GuJ4ayMRg1PxEt6JOAwa1zA_VOw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6915-zucchini-bread-iv-DDMFS-step-04-6c4e339115634dab8b5e65543680fe82.jpg"
      ],
      "image": "assets/images/6915/step_04.webp"
    },
    {
      "text": "Slice and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rnH04On9fy4qN-rLOy1MS7amuxQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6915-zucchini-bread-iv-DDMFS-beauty-4x3-8f9e4582996b4eeb87d44a1ee873ed34.jpg"
      ],
