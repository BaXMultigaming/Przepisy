  "ingredients": [
    "2 cups uncooked long-grain rice",
    "0.75 teaspoon crushed saffron threads",
    "boiling water",
    "4 tablespoons butter",
    "3 cinnamon sticks",
    "6 whole cardamom seeds",
    "4 whole cloves",
    "1 onion, chopped",
    "3 cups boiling vegetable broth",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Cover rice with cold water and set aside to soak for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, soak saffron threads in 2 tablespoons hot water in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium heat; add cinnamon sticks, cardamom, and cloves. Fry in hot butter for 2 minutes, stirring occasionally. Add onion and sauté, stirring occasionally, until golden brown. Drain rice and add to onion mixture. Reduce heat to low and cook for 5 minutes, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in boiling broth; stir in salt and saffron mixture. Cover and cook until rice is tender and liquid is absorbed, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
