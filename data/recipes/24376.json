  "title": "Stovetop Saffron Rice",
  "description": "This gorgeous yellow saffron rice is made by cooking long-grain rice in butter and broth flavored with saffron threads, cardamom, and cinnamon.",
  "authors": [
    "Kimber"
  ],
  "date_published": "2020-03-09T22:50:28-04:00",
