  "ingredients": [
    "2 large eggs",
    "2 cups all-purpose flour",
    "1.75 cups milk",
    "0.5 cup vegetable oil",
    "1 tablespoon white sugar",
    "4 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.5 teaspoon vanilla extract",
    "nonstick cooking spray"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GI09Uu2kEVl0GtsFDfVUYvW1CkQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22180-waffles-i-VAT-016-step-01-6bb9e591ac75437586f2c84540688cff.jpg"
      ],
      "image": "assets/images/22180/step_01.webp"
    },
    {
      "text": "Whisk eggs in a large bowl until light and fluffy. Add flour, milk, and vegetable oil and mix to combine. Whisk in sugar, then mix in baking powder, salt, and vanilla just until smooth, being careful not to overmix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c0A7eN7thKB912q4U4xKnEgJY-0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22180-waffles-i-VAT-017-step-02-eac2a00384af4e16a92b3c47f77080bb.jpg"
      ],
      "image": "assets/images/22180/step_02.webp"
    },
    {
      "text": "Spray the preheated waffle iron with nonstick spray. Pour batter onto the hot waffle iron and cook until golden brown and the iron stops steaming, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hXjrvcbaZ-4_Au5brYuFH_RN9Pg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22180-waffles-i-VAT-018-step-03-a95688b095904956a8ab7daa42232f34.jpg"
      ],
      "image": "assets/images/22180/step_03.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
