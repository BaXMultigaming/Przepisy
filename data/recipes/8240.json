  "ingredients": [
    "1.3332999944687 cups water",
    "1.3332999944687 cups white sugar",
    "1 cup raisins",
    "2 large carrots, grated",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "1 teaspoon ground nutmeg",
    "2 teaspoons butter",
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1 cup chopped walnuts",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 9x5 inch loaf pan, and line with wax paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, sugar, raisins, grated carrots, cinnamon, cloves, nutmeg, and butter in a medium saucepan. Cook over low heat for 5 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together flour, baking soda, nuts, and salt. Stir in carrot mixture. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 1/4 hours, or until a tester inserted in the center comes out clean. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
