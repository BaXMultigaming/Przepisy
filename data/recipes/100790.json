  "ingredients": [
    "4 cups heavy cream",
    "1 cup confectioners' sugar, divided",
    "0.125 teaspoon almond extract",
    "0.5 cup sour cream, at room temperature",
    "2 pints fresh blackberries",
    "8 strips of lemon zest, for garnish",
    "8 sprigs fresh mint"
  ],
  "steps": [
    {
      "text": "Beat heavy cream, ½ cup confectioners' sugar, and almond extract together in a large bowl until stiff; fold in sour cream until combined. Refrigerate until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss blackberries with remaining ½ cup confectioners' sugar in a separate large bowl until evenly coated. Let stand at room temperature for about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer whipped cream and blackberries into 8 parfait glasses, beginning and ending with whipped cream. Garnish each parfait with 1 strip lemon zest, a few blackberries, and 1 sprig mint.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
