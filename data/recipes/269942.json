  "ingredients": [
    "8 ounces uncooked rigatoni pasta",
    "4 cups chopped butternut squash",
    "8 ounces Hillshire Farm® Rope Smoked Sausage, cut into bias-cut pieces",
    "1 tablespoon olive oil",
    "6 tablespoons unsalted butter, divided",
    "0.25 cup fresh sage leaves, chopped",
    "3 tablespoons fresh lemon juice",
    "1 cup grated Parmesan cheese",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook rigatoni in the boiling water, stirring occasionally until tender yet firm to the bite, about 12 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an oven to 450 degrees F (230 degrees C). Place butternut squash and sausage on a large baking pan. Drizzle with oil; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in preheated oven for 12 minutes. Toss with 3 tablespoons cubed butter and sage; return to oven. Cook until squash is caramelized and tender, 12 to 14 minutes,",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt remaining butter in a large skillet over medium heat. Toss in pasta, sausage-squash mixture, lemon juice, ¾ cup Parmesan cheese, salt, and pepper. Top with remaining ¼ cup Parmesan cheese to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
