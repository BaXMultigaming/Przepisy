    "4 skinless, boneless chicken breasts",
    "5 cups dry sweetened cereal, crushed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place crushed cereal crumbs in a large resealable plastic bag. Add chicken breasts to bag, one at a time. Seal bag and shake to coat. Place coated chicken in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour, or until chicken is cooked through and juices run clear.",
      "section": null,
