  "ingredients": [
    "1 (12 ounce) bag fresh cranberries",
    "0.75 cup white sugar",
    "1 bunch cilantro, chopped",
    "1 bunch green onions, cut into 3 inch lengths",
    "1 medium jalapeno pepper, seeded and minced",
    "2 medium limes, juiced",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Combine cranberries, sugar, cilantro, green onions, jalapeño, lime juice, and salt in the bowl of a food processor; process to a medium consistency. Adjust flavors to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate to let flavors meld, or serve immediately at room temperature.",
