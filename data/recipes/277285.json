  "ingredients": [
    "4 cups water",
    "1 teaspoon salt",
    "1 cup uncooked quick-cooking grits",
    "1 cup shredded Cheddar cheese",
    "0.5 cup shredded Parmesan cheese",
    "2 tablespoons butter",
    "ground black pepper to taste"
  ],
