  "ingredients": [
    "2 (10 ounce) packages frozen riced cauliflower",
    "0.25 cup chopped cilantro",
    "2 tablespoons lime juice",
    "salt and ground black pepper to taste",
    "1 pound cooked pork roast, shredded",
    "0.5 (15.25 ounce) can whole kernel corn, drained",
    "0.5 (15 ounce) can black beans, rinsed and drained",
    "0.25 cup shredded Cheddar cheese",
    "1/4 cup Mexican crema con sal",
    "0.25 cup salsa",
    "0.25 cup cilantro ranch dressing",
    "1 avocado, sliced, or to taste",
    "1 medium lime, cut into wedges"
  ],
  "steps": [
    {
      "text": "Steam cauliflower rice according to package directions, about 6 minutes. Once cauliflower is cooked, empty contents into a large bowl; add in cilantro, lime juice, salt, and pepper. Cover and set mixture aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat cooked shredded pork in a pan on the stovetop until warmed through, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix corn and beans together in a medium microwave-safe bowl. Microwave to heat through, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Assemble bowls by adding 5 ounces cilantro-lime cauliflower rice, top with 4 ounces pork, black beans, and corn. Add 1 tablespoon each: salsa, Cheddar cheese, crema con sal, and cilantro ranch dressing to each bowl. Garnish with sliced avocado and lime wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
