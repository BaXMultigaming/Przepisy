  "ingredients": [
    "1 pound boneless, skinless chicken breast halves, sliced into thin strips",
    "0.5 cup Greek yogurt",
    "1 tablespoon fresh or jarred minced garlic",
    "1 tablespoon lemon juice",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Combine chicken, Greek yogurt, garlic, lemon juice, cinnamon, oregano, salt, nutmeg, and cloves in a resealable plastic container or bag. Shake until ingredients are evenly combined and chicken is well coated. Refrigerate at least 4 hours, up to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Discard excess marinade and cook the chicken as desired when ready to make sandwiches or wraps.",
