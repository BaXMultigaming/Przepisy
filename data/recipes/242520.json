  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "0.25 cup unsweetened cocoa powder",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 cup water",
    "0.33333334326744 cup vegetable oil",
    "1 tablespoon distilled white vinegar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, cocoa powder, salt, and baking soda together into a bowl; beat in water, oil, vinegar, and vanilla until smooth, about 1 minute. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 30 minutes. Cool on a wire rack before removing from cake pan, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
