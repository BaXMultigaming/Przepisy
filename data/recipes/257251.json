  "ingredients": [
    "0.5 cup heavy whipping cream",
    "1 (4 ounce) package cream cheese, softened",
    "0.25 cup butter, softened",
    "0.25 cup strawberry puree",
    "0.5 teaspoon vanilla extract",
    "1.25 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Chill a large glass or metal bowl and the beaters from an electric mixer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat heavy cream in the chilled bowl with the electric mixer until stiff peaks form, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese in a separate bowl until creamy, 1 to 2 minutes. Add butter; mix until well-blended, 1 or 2 minutes. Stir in strawberry puree and vanilla extract. Add confectioners' sugar and mix until well-blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently fold whipped cream into cream cheese mixture until evenly incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
