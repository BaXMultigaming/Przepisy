  "ingredients": [
    "4 pounds boneless chuck roast",
    "2 tablespoons butter",
    "1 onion, chopped",
    "12 ounces chile sauce",
    "3 tablespoons distilled white vinegar",
    "3 cloves garlic, minced",
    "2 tablespoons brown sugar",
    "2 tablespoons Worcestershire sauce",
    "1 teaspoon mustard powder",
    "1 teaspoon salt",
    "0.5 teaspoon freshly ground black pepper",
    "0.125 teaspoon ground cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place roast in a roasting pan; cover pan. Cook in the preheated oven until beef falls apart and shreds easily, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a large skillet over medium heat. Add onion; cook until translucent.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chili sauce and vinegar into onion. Fill empty chili sauce bottle with water, shake, and pour liquid into skillet. Stir in garlic, brown sugar, Worcestershire sauce, mustard powder, black pepper, salt, and cayenne pepper; cook over low heat, stirring often, until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shred beef using 2 forks; stir into sauce and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
