  "title": "Lamb (Gosht) Biryani",
  "description": "This flavorful Indian lamb biryani has tender chunks of aromatic spiced lamb with perfectly cooked golden saffron rice for a delicious celebratory meal.",
  "authors": [
    "SUSMITA"
  ],
  "date_published": "2019-07-10T03:01:59-04:00",
