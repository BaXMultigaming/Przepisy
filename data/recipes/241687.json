  "ingredients": [
    "0.75 cup butter",
    "0.5 cup white sugar",
    "1 egg, separated",
    "1.75 cups all-purpose flour",
    "0.5 teaspoon ground allspice",
    "0.125 teaspoon ground turmeric"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter in a large bowl with an electric mixer until creamy; beat in sugar until light and fluffy. Beat in egg yolk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, allspice, and turmeric together in a bowl until well combined; sift into butter mixture and stir until dough is combined. Press dough into a 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white in a small bowl; brush over dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake feels firm when lightly pressed in center, 30 to 45 minutes. Cut into squares while cake is still hot; cool in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
