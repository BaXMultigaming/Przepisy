  "ingredients": [
    "1 red bell pepper, julienned",
    "0.75 pound large cooked shrimp, peeled and deveined",
    "0.5 cup chopped fresh mint leaves",
    "0.25 cup fresh lemon juice",
    "2 teaspoons grated lemon zest",
    "3 tablespoons olive oil",
    "0.75 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 pound dry fettuccini pasta"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Meanwhile prepare the remaining ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, combine the red pepper, shrimp, mint, lemon juice, lemon zest, olive oil, salt and pepper. Mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pasta to the boiling water and cook for 8 to 10 minutes or until al dente; drain. Add the pasta to the shrimp mixture and toss to coat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
