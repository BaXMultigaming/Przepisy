  "ingredients": [
    "0.75 cup cider vinegar",
    "0.25 cup chili sauce",
    "0.25 cup Worcestershire sauce",
    "1 (6 ounce) can tomato paste",
    "0.5 cup diced onion",
    "2 tablespoons brown sugar",
    "0.5 teaspoon cayenne pepper",
    "2 tablespoons vegetable oil",
    "8 chicken thighs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan over medium heat, blend cider vinegar, chili sauce, Worcestershire sauce, and tomato paste. Mix in the onion, brown sugar, and cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a medium skillet over medium heat, and saute the chicken thighs until browned. Remove from heat, drain, and arrange in a medium baking dish. Cover with the cider vinegar sauce mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake covered 45 minutes in the preheated oven, or until chicken is no longer pink and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
