  "ingredients": [
    "1 cup all-purpose flour",
    "0.33333334326744 cup white sugar",
    "0.25 cup coconut flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "1 egg",
    "0.75 cup applesauce",
    "0.5 cup coconut milk",
