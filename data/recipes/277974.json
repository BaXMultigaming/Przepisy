  "ingredients": [
    "4 eggs, separated",
    "0.5 cup white sugar",
    "2 tablespoons maple syrup",
    "2.25 cups mascarpone cheese"
  ],
  "steps": [
    {
      "text": "Whisk egg whites in the bowl of a stand mixer fitted with the whisk attachment until soft peaks form; transfer to another bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg yolks and sugar together in the bowl of the stand mixer fitted with the paddle attachment until smooth and pale. Add maple syrup; beat until fully combined. Slowly beat in mascarpone cheese; fold in egg whites.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Store in the refrigerator for up to 48 hours, loosely covered with plastic wrap. Cream may begin to separate after 24 hours. Gently stir before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
