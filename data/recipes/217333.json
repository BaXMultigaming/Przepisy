  "ingredients": [
    "1 teaspoon ground turmeric",
    "0.5 teaspoon ground cardamom",
    "0.5 tablespoon ground cinnamon",
    "0.5 teaspoon ground coriander",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon paprika",
    "0.25 teaspoon cayenne pepper, or to taste",
    "2 cups chopped onion",
    "1 tablespoon olive oil",
    "3 cloves garlic, minced",
    "1 tablespoon grated fresh ginger root",
    "1 tablespoon tomato paste",
    "1 pound skinless, boneless chicken thighs, cut into 1 1/2-inch pieces",
    "2 large potatoes, cut into 1/2-inch cubes",
    "2 (14.5 ounce) cans diced tomatoes, drained",
    "1.5 cups chicken broth",
    "2 tablespoons wine vinegar",
    "1 bay leaf",
    "salt and black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BfrJfQa6_IzxYHUxyMyslhlm4Ks=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-217333-Chicken-Vindaloo-gw-ddmfs-4x3-step-01-f7d6cfea0d884e08a2abe7ed39f3a726.jpg"
      ],
      "image": "assets/images/217333/step_01.webp"
    },
    {
      "text": "Toast turmeric, cardamom, cinnamon, coriander, cloves, cumin, paprika, and cayenne pepper in a Dutch oven or large pot over medium-low heat until fragrant, about 2 minutes. Stir spices constantly as they toast to ensure they do not burn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1-_KL7wEgS3L5bcwD4nhC4-6YJk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-217333-Chicken-Vindaloo-gw-ddmfs-4x3-step-02-9ad8c3fb08a9436dbb9de0f2cbd066e3.jpg"
      ],
      "image": "assets/images/217333/step_02.webp"
    },
    {
      "text": "Stir in onion, olive oil, garlic, and ginger. Increase heat to medium; cook and stir until onion is softened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VNOM4OTZUo3UQLxIVGC35V7tXs8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-217333-Chicken-Vindaloo-gw-ddmfs-4x3-step-03-8061370f08114548bd35e2d3c7ee1724.jpg"
      ],
      "image": "assets/images/217333/step_03.webp"
    },
    {
      "text": "Stir in tomato paste until no lumps of paste remain. Add chicken, potatoes, tomatoes, broth, wine vinegar, and bay leaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lpjQe4lOom5wgXw4oxQm-Kw1P04=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-217333-Chicken-Vindaloo-gw-ddmfs-4x3-step-05-01f273b49e084b8380f3a91d0c7e7e65.jpg"
      ],
      "image": "assets/images/217333/step_04.webp"
    },
    {
      "text": "Bring to a boil, then reduce heat to medium-low. Cover and simmer until potatoes are tender and chicken is no longer pink in the center, about 15 minutes. Uncover and continue cooking until sauce thickens slightly, about 5 minutes more. Season with salt, black pepper, and additional cayenne pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G9H7zGAUgTdgxLcGhqbVZXaa__4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-217333-Chicken-Vindaloo-gw-ddmfs-4x3-step-06-bead452214b2492b8649ca1861b99aa5.jpg"
      ],
      "image": "assets/images/217333/step_05.webp"
    }
