  "ingredients": [
    "2 tablespoons butter",
    "3 tablespoons cider vinegar",
    "0.25 cup brown sugar",
    "0.5 teaspoon salt, or to taste",
    "0.25 cup onion, minced",
    "0.5 cup grated peeled apple",
    "2 pounds red cabbage, thinly sliced",
    "0.125 teaspoon ground cloves",
    "0.125 teaspoon ground allspice"
  ],
  "steps": [
    {
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot®) and select Saute function. Melt butter. Add apple cider vinegar, brown sugar, and salt. Stir to combine. Mix in onion, grated apple, and red cabbage until well combined. Close and lock the lid. Select Steam function. Set timer for 3 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Mix in ground cloves and allspice.",
