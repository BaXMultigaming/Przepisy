  "ingredients": [
    "8 ounces dried pinto beans",
    "2 tablespoons olive oil",
    "1.5 teaspoons salt",
    "16 slices white whole wheat bread",
    "1 cup shredded queso blanco",
    "0.33333334326744 cup chile-garlic sauce (such as Sriracha®)"
  ],
  "steps": [
    {
      "text": "Place beans in a saucepan and add enough water to cover them by 1 inch. Bring to a boil and remove from heat. Let stand for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain and rinse beans. Add enough fresh water to cover by 1 inch. Bring to a boil, reduce heat, and simmer for 2 hours. Drain, reserving 1/2 cup of the cooking water, and rinse.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium-high heat. Add beans and salt. Fry until beans are very soft, stirring and mashing frequently, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler on low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread an equal amount of beans on each slice of bread and sprinkle queso on top. Place bread slices on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil until beans are warmed and cheese is melted, about 3 minutes. Remove from oven and top with chile-garlic sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
