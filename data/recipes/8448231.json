  "title": "Chicken Alfredo Stuffed Shells",
  "description": "These chicken Alfredo stuffed shells provide creamy, cheesy, comforting flavor your entire family will enjoy any night of the week.",
  "authors": [
    "Britney Alston"
  ],
  "date_published": "2022-09-15T13:24:15-04:00",
