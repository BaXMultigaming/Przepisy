    "publisher-tested"
  ],
  "ingredients": [
    "30 jumbo pasta shells",
    "1 pound skinless, boneless chicken breast halves",
    "1.5 teaspoons kosher salt, divided",
    "1.25 teaspoons ground black pepper, divided",
    "1 tablespoon olive oil",
    "0.75 cup ricotta cheese",
    "2 cups shredded Italian cheese blend, divided",
    "2 tablespoons chopped fresh flat-leaf parsley, plus more for garnish",
    "2 tablespoons heavy whipping cream",
    "2 cups heavy whipping cream",
    "0.5 cup unsalted butter",
    "2 cloves garlic, finely chopped",
    "1 teaspoon Italian seasoning",
    "2.5 cups freshly grated Parmesan cheese, divided"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil over medium-high heat; cook the pasta shells according to package directions for al dente, 9 to 11 minutes. Drain and run under cold water until cool enough to touch. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken breasts on both sides with 1/2 teaspoon salt and 1/2 teaspoon pepper. Heat oil in a large skillet over medium heat. Add chicken; cook until browned and a thermometer inserted into the thickest portion of the chicken breast registers 165 degrees F (74 degrees C), about 18 minutes, turning halfway through. Remove from heat and transfer chicken from skillet to a cutting board.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mCy8IGz738sx4GtCXK6uKF5PFJs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/chicken-alfredo-stuffed-shells-ddmfs-step-1-653-3x4-278654338c8f46e89ea554958d98ca44.jpg"
      ],
      "image": "assets/images/8448231/step_03.webp"
    },
    {
      "text": "Shred chicken using 2 forks and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jUE36v5LwtCAjy-cwXca1U_3WIg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/chicken-alfredo-stuffed-shells-ddmfs-step-2-656-3x4-ca4dec59b7c340d3840f55b1b4842efa.jpg"
      ],
      "image": "assets/images/8448231/step_04.webp"
    },
    {
      "text": "Stir together ricotta, 1 1/2 cup Italian blend cheese, parsley, 1/2 teaspoon salt, 1/4 teaspoon pepper, chicken, and 2 tablespoons cream in a medium bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XgFyIaqlySnpv5X_0IPebtWOiTA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/chicken-alfredo-stuffed-shells-ddmfs-step-3-659-3x4-2353e4e5921a482d9b21237205406c75.jpg"
      ],
      "image": "assets/images/8448231/step_05.webp"
    },
    {
      "text": "Combine 2 cups cream and butter in a deep, large skillet. Bring to a simmer over medium heat and cook for 2 minutes, stirring occasionally. Whisk in garlic, Italian seasoning, and remaining 1/2 teaspoon salt and 1/2 teaspoon pepper and cook for 1 more minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lOuPvBzisODomaA3GUo-X0S7q_Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/chicken-alfredo-stuffed-shells-ddmfs-step-4-671-3x4-71952b9b88b248e49656ccd90dbf8967.jpg"
      ],
      "image": "assets/images/8448231/step_06.webp"
    },
    {
      "text": "Add 2 cups Parmesan cheese and whisk until melted. Set sauce aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NElUuiXb5KwxM4VDGrVHBqQmn6c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/chicken-alfredo-stuffed-shells-ddmfs-step-5-680-3x4-d7697aec52434cb688937dd009e80d47.jpg"
      ],
      "image": "assets/images/8448231/step_07.webp"
    },
    {
      "text": "Add 1 cup sauce to the bottom of a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c8e6_RpHikJpQJ_dVlUMMx04j1s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/chicken-alfredo-stuffed-shells-ddmfs-step-6-683-3x4-69150492f06043e893164eac985fc77e.jpg"
      ],
      "image": "assets/images/8448231/step_08.webp"
    },
    {
      "text": "Using a spoon, fill each of the jumbo shells generously with the chicken-ricotta mixture. Lay them seam side up in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/USSAaNqBRkZNXldM2bXLOUUvy-o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/chicken-alfredo-stuffed-shells-ddmfs-step-7-688-3x4-eef44ed9fab44b9697dc7ca6a55fe547.jpg"
      ],
      "image": "assets/images/8448231/step_09.webp"
    },
    {
      "text": "Pour the remaining sauce all over the top of the jumbo shells. Sprinkle with remaining 1/2 cup Italian blend cheese and 1/2 cup Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vpkPsYVTakK5BAidI2RYAPB85RQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/chicken-alfredo-stuffed-shells-ddmfs-step-8-690-3x4-93880a6daa3e4c6395c5c14df3a0b6dd.jpg"
      ],
      "image": "assets/images/8448231/step_10.webp"
    },
    {
      "text": "Bake in the preheated oven until bubbly and golden, 20 to 25 minutes. Garnish with more parsley if desired and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zHEZgfRDw_Ukni4oDRILmgUYuNA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/chicken-alfredo-stuffed-shells-ddmfs-step-9-699-3x4-69eda44596b647048a32e8510ac861d0.jpg"
      ],
      "image": "assets/images/8448231/step_11.webp"
    }
  ],
