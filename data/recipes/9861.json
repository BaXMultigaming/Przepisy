  "ingredients": [
    "2 cups white sugar",
    "1 cup unsweetened cocoa powder",
    "0.5 cup vegetable oil",
    "4 large eggs",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Mix sugar, cocoa, and oil together in a medium bowl. Beat in eggs, one at a time, until combined. Stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Te00IwMSccJJGIlNXfvGiwCcjYU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23028-chocolate-crinkle-cookies-DDMFS-Step02-11834-5122e7c2713440499d9af269191aef6c.jpg"
      ],
      "image": "assets/images/9861/step_01.webp"
    },
    {
      "text": "Whisk together flour, baking powder, and salt in another medium bowl; gradually stir into cocoa mixture until just combined; dough will be sticky. Cover and refrigerate until firm, 4 hours to overnight. This helps to deepen the chocolate flavor and create more defined crinkles when baked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sRGV1RiqfIfAoxX0YvRwHWJnSX8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9861-Chocolate-Crinkle-Cookies-mfs-Steps-002-d8866ed4da564956a51bf9cd1090c8dc.jpg"
      ],
      "image": "assets/images/9861/step_02.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two cookie sheets with parchment paper. Roll or scoop dough into 1-inch balls. Roll each ball in confectioners' sugar; place 1 inch apart on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/83u_ax7ykROnJqY3qtB4iOKUKZ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9861-Chocolate-Crinkle-Cookies-mfs-Steps-003-c4b89f62941a486d8c9d700ad198e3a5.jpg"
      ],
      "image": "assets/images/9861/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until edges set and tops crackle, 10 to 12 minutes. Let cool on the cookie sheet for a few minutes to firm up; transfer to wire racks to cool completely. Repeat with remaining dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lYp_ezwCHJmcV8H5nBQNsVCE5hw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9861-Chocolate-Crinkle-Cookies-mfs-Steps-004-0ee07e2f5b4744c883c42ca36a90a3c5.jpg"
      ],
      "image": "assets/images/9861/step_04.webp"
    }
  ],
