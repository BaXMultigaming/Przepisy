  "ingredients": [
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup white sugar",
    "1 cup brown sugar",
    "0.5 cup coconut oil",
    "0.5 cup butter",
    "1 cup persimmon puree",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2 cups unsweetened date pieces",
    "1.75 cups rolled oats"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, brown sugar, coconut oil, and butter in a separate bowl; mix until creamy. Beat in persimmon pulp. Add eggs and vanilla extract; beat until well combined, scraping sides of the bowl occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour mixture into persimmon mixture by hand until thoroughly combined. Add dates and oats; mix dough well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by rounded teaspoonfuls onto an ungreased baking sheet, about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 10 to 12 minutes. Cool briefly; transfer to a wire rack to cool completely, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
