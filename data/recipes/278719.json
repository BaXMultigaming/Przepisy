  "ingredients": [
    "3 pounds skinless, boneless chicken breast halves",
    "3 tablespoons salt",
    "1.5 tablespoons ground cumin",
    "1.5 tablespoons paprika",
    "1.5 tablespoons chili powder",
    "1.5 tablespoons cayenne pepper",
    "2 (14 ounce) cans diced tomatoes",
    "2 white onions, diced",
    "2 jalapeno peppers, diced",
    "2 habanero peppers, diced",
    "6 cloves garlic, pressed",
    "1 lime, halved",
    "18 corn tortillas"
  ],
  "steps": [
    {
      "text": "Season chicken with salt, cumin, paprika, chili powder, and cayenne pepper. Place into the bottom of a slow cooker. Pour diced tomatoes into the cooker, followed by onions, jalapenos, habanero peppers, and garlic. Squeeze the juice of lime into the pot and stir the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on High until chicken breasts are no longer pink in the centers, 4 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken, shred meat with 2 forks, and return to the pot. Mix to combine and serve with tortillas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
