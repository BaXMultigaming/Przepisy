  "ingredients": [
    "1 (750 milliliter) bottle mango flavored rum",
    "1 (10 ounce) can frozen pina colada mix",
    "1 cup crushed pineapple in juice, undrained",
    "1 cup vanilla ice cream",
    "8 cubes ice",
    "0.25 cup whipping cream",
    "4 cherries with stems"
  ],
  "steps": [
    {
      "text": "Combine rum, piña colada mix, crushed pineapple with juice, vanilla ice cream, and ice in a blender; blend until slushy.",
