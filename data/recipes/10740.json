  "ingredients": [
    "1 cup canned pumpkin",
    "1 cup white sugar",
    "0.5 cup vegetable oil",
    "1 large egg",
    "1 teaspoon baking soda",
    "1 teaspoon milk",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon salt",
    "2 cups semisweet chocolate chips",
    "0.5 cup chopped walnuts",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a baking sheet; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s7E7aoFjxm7vnn9ueEiXIqK1-OQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10740-pumpkin-chocolate-chip-cookies-iii.ddmfs-step01_7635-083d3183aa1f406e80aa513f9f9a2a9f.jpg"
      ],
      "image": "assets/images/10740/step_01.webp"
    },
    {
      "text": "Mix pumpkin, sugar, oil, and egg together in a large bowl. Stir baking soda and milk together in a small bowl until baking soda dissolves. Stir into pumpkin mixture until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hm2sER1Odyh6KimkNnPmihlw_8U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10740-pumpkin-chocolate-chip-cookies-iii.ddmfs-step02_7637-b93a714c97c54a5eb2fae5364ce0a558.jpg"
      ],
      "image": "assets/images/10740/step_02.webp"
    },
    {
      "text": "Stir flour, baking powder, cinnamon, and salt together in a medium bowl. Add flour mixture to pumpkin mixture until well combined. Fold in chocolate chips, walnuts, and vanilla extract until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YOzHWcSxZaWoDbHsDlrhtnFa3bw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10740-pumpkin-chocolate-chip-cookies-iii.ddmfs-step03_7639-ae637da15d6744128d379f8f337d817d.jpg"
      ],
      "image": "assets/images/10740/step_03.webp"
    },
    {
      "text": "Drop by spoonful on the prepared baking sheet; bake in the preheated oven until golden and firm, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qJ8DdAvlrhcaP7UScr8cXPbG1Yw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10740-pumpkin-chocolate-chip-cookies-iii.ddmfs-step04_7640-9003a13f257e4ba5aa763b6fbd32e699.jpg"
      ],
      "image": "assets/images/10740/step_04.webp"
    },
    {
      "text": "Let cool on the baking sheet for 2 minutes; transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ucjXqjyeXt5E9ra3fXwskbnaCu4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-10740-pumpkin-chocolate-chip-cookies-iii.ddmfs-hero_7687-c5380eea8eb84de8950c03157598d91d-d2c0e577472d44ef9b04c8b3255fc41e.jpg"
      ],
      "image": "assets/images/10740/step_05.webp"
    }
  ],
