  "ingredients": [
    "1 cup cake flour",
    "1 cup whole wheat flour",
    "1 cup packed brown sugar",
    "1.5 teaspoons ground cinnamon",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.66666698455811 cup buttermilk",
    "0.33333298563957 cup vegetable oil",
    "3 eggs",
    "0.5 cup white sugar",
    "1.5 cups grated carrots"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease and flour a 9x13-inch baking pan or two 9-inch round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flours, brown sugar, cinnamon, baking powder, and baking soda in a large bowl. Add buttermilk and oil and mix until well combined. Mix in egg yolks until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a separate bowl until frothy. Gradually beat in white sugar, then continue to beat until stiff.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold egg whites into batter, then fold in carrots. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 35 minutes. Let cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
