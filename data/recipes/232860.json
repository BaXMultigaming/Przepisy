  "ingredients": [
    "2 slices ham steak",
    "1 cup brown sugar",
    "1 cup maple syrup",
    "2 tablespoons Dijon mustard",
    "1.5 teaspoons distilled white vinegar",
    "15 whole cloves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Arrange ham steaks in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk brown sugar, maple syrup, Dijon mustard, and vinegar in a bowl; pour over ham steaks. Sprinkle cloves over ham steaks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned on both sides, about 45 minutes, turning every 15 minutes. Discard cloves before serving.",
