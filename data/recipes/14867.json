  "ingredients": [
    "1 (8 ounce) package cream cheese with chives",
    "0.5 cup creamy salad dressing, e.g. Miracle Whip ™",
    "1 pinch garlic powder",
    "1 teaspoon lemon juice concentrate",
    "1 (16 ounce) package thinly sliced smoked beef"
  ],
  "steps": [
    {
      "text": "In a medium-size mixing bowl, combine cream cheese, salad dressing, garlic powder, lemon juice and smoked beef. Mix well. Cover and refrigerate for at least one hour to let all of the flavors mix.",
