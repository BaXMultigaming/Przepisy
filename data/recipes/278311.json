  "title": "Instant Pot Celery Soup",
  "description": "Flavorful vegetables combine in an Instant Pot to create this wholesome vegan celery soup that's great served hot or cold.",
  "authors": [
    "sashman"
  ],
  "date_published": "2020-03-09T22:54:14-04:00",
