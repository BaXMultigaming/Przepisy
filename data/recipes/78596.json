  "ingredients": [
    "2 (8 ounce) packages frozen artichoke hearts",
    "1.5 cups fat-free cottage cheese",
    "4 ounces herbed goat cheese (chevre)",
    "4 teaspoons Dijon mustard",
    "3 tablespoons fresh lemon juice",
    "2 garlic cloves, crushed",
    "1 tablespoon Worcestershire sauce",
    "0.33333334326744 cup light mayonnaise",
    "0.33333334326744 cup fat-free half-and-half",
    "1 cup chopped chives",
    "Salt and pepper, to taste",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook artichokes according to package directions; chop roughly. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a food processor, mix all ingredients except artichokes and Parmesan cheese until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in artichokes. Pour mixture into a 9-inch baking dish. Sprinkle with Parmesan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes. If top hasn't browned, put under broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let sit for 15 minutes before serving (it may be watery when first removed from the oven). Serve with toasted whole-wheat pita chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
