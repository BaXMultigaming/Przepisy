  "ingredients": [
    "2 (8 ounce) packages cream cheese",
    "3 tablespoons pesto",
    "2 tablespoons chopped fresh chives",
    "3 tablespoons chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Place cream cheese and pesto in a food processor or blender. Blend until smooth. Mix in the chives and cilantro. Continue blending until smooth. Transfer to a mold lined with plastic wrap. Cover and chill in the refrigerator 1 hour, or until firm.",
