  "title": "Delmonico Potatoes",
  "description": "These Delmonico potatoes are boiled, shredded, and layered with a savory cheese sauce for an easy, tasty, and comforting baked potato casserole.",
  "authors": [
    "MARBALET"
  ],
  "date_published": "1999-12-30T15:35:16-05:00",
