    "1.5 fluid ounces tequila",
    "1 fluid ounce lime juice",
    "0.5 fluid ounce triple sec",
    "1 teaspoon white sugar, or to taste",
    "1 cup ice cubes",
    "1 wedge lime",
    "1 teaspoon white sugar"
