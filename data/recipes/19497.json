  "ingredients": [
    "1 (14.75 ounce) can salmon, undrained and flaked",
    "1 small onion, grated",
    "1 slice bread, shredded",
    "1 large egg",
    "1 tablespoon all-purpose flour",
    "salt and pepper to taste",
    "1 cup vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Mix together salmon, onion, bread, egg, flour, salt, and pepper in a large bowl until well combined. Shape into 4 equal patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook patties in hot oil until browned on both sides, about 8 minutes. Drain briefly on a paper towel-lined plate before serving.",
