  "ingredients": [
    "1 large onion, chopped",
    "0.25 cup butter, cut in small pieces",
    "salt and pepper to taste",
    "bread crumbs, or as needed",
    "4 skinless, boneless chicken breast halves",
    "1 cup red wine",
    "0.75 (12 ounce) bottle ketchup-style chili sauce",
    "0.5 (10 ounce) jar red currant jelly"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scatter chopped onion and butter pieces into the bottom of a 9x13-inch baking dish. Place bread crumbs into a shallow bowl; season chicken with salt and pepper, and press chicken breast halves into crumbs to coat. Place coated chicken breasts atop onion and butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crumbs are browned and chicken juices run clear, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix red wine, chili sauce, and currant jelly in a bowl; pour sauce over chicken. Bake until sauce thickens and glazes onto chicken breasts, about 30 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
