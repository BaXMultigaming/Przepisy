  "ingredients": [
    "3 cups Greek yogurt",
    "0.66666668653488 cup white sugar",
    "0.5 cup sifted cocoa powder",
    "0.25 cup half-and-half",
    "1 tablespoon ground cinnamon",
    "0.5 teaspoon cayenne pepper",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Combine yogurt, sugar, cocoa powder, half-and-half, cinnamon, cayenne pepper, and salt together in a bowl until smooth. Refrigerate yogurt mixture until completely chilled, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer yogurt mixture to your ice cream maker and process for 1/2 the amount of time recommended in manufacturers' instructions for ice cream until firm and creamy, 1 to 2 hours.",
