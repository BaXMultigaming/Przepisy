  "ingredients": [
    "4 slices bacon",
    "0.75 pound fresh spinach",
    "2 hard-cooked eggs, sliced",
    "2 tablespoons sweet onion, chopped",
    "2 tablespoons chopped raw almonds",
    "1 tablespoon raw sunflower seeds",
    "0.5 cup vegetable oil",
    "0.5 cup ketchup",
    "0.25 cup cider vinegar",
    "2 tablespoons brown sugar",
    "1 tablespoon Worcestershire sauce",
    "1 clove garlic, minced",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels, then crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer spinach, bacon, eggs, and onion in a large bowl; sprinkle with almonds and sunflower seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, ketchup, vinegar, brown sugar, Worcestershire sauce, garlic, salt, and black pepper together in a bowl. Pour over spinach mixture; toss. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
