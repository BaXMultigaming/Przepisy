  "ingredients": [
    "2 heads cauliflower",
    "1.5 cups sour cream",
    "1.5 cups shredded Cheddar cheese",
    "1 tablespoon butter",
    "1 cup bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease one 9x13 inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break cauliflower into florets, place in large covered saucepan and steam until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cauliflower in casserole dish; gently stir in sour cream and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saute pan over medium heat, melt butter; add bread crumbs and evenly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle bread crumbs over cauliflower mixture and bake for 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
