    "Inspired",
    "Irish"
  ],
  "regions": [
    "Inspired",
    "Irish"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "3.25 cups all-purpose flour",
    "0.5 cup whole wheat flour",
    "0.25 cup rolled oats",
    "1.5 teaspoons salt",
    "1.25 teaspoons baking soda",
    "1 teaspoon baking powder",
    "0.25 cup cold unsalted butter, cut into small cubes",
    "1.75 cups buttermilk",
    "1 large egg",
    "2 tablespoons honey, or more to taste",
    "2 teaspoons grated orange zest",
    "1 cup dried currants",
    "0.33333334326744 cup golden raisins"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper or a silicone baking mat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7zHVHop6trA343K7xQiKslETi30=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-241738-chef-johns-irish-soda-bread-VAT-step-01-e1a8bd9fdf144ed4ac5a2defcddb9e1f.jpg"
      ],
      "image": "assets/images/241738/step_01.webp"
    },
    {
      "text": "Whisk all-purpose flour, whole wheat flour, oats, salt, baking soda, and baking powder together in a large bowl. Cut butter into flour mixture using a pastry blender until mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/81KVl6wFLspNSAhPXRVoKnKy5OQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-241738-chef-johns-irish-soda-bread-VAT-step-02-e4d99b76a6564a46a06426e834936f73.jpg"
      ],
      "image": "assets/images/241738/step_02.webp"
    },
    {
      "text": "Beat buttermilk, egg, honey, and orange zest together in a medium bowl. Pour buttermilk mixture, currants, and raisins into flour-butter mixture; stir with a wooden spoon until a wet, sticky dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nJbxOUZAYlJ9iJ5VkpXcPSoh5So=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-241738-chef-johns-irish-soda-bread-VAT-step-03-ca26b2c4b94344ab93390a4f630f90d2.jpg"
      ],
      "image": "assets/images/241738/step_03.webp"
    },
    {
      "text": "Turn dough out onto a well-floured work surface; press dough together into a ball and cut into 2 equal pieces. Form each into a smooth, round loaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ME3wXJwm0JCk52cFuPJPzALiZu4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-241738-chef-johns-irish-soda-bread-VAT-step-04-23b546a4626e4fafa40178f1673a3ba2.jpg"
      ],
      "image": "assets/images/241738/step_04.webp"
    },
    {
      "text": "Transfer to the prepared baking sheet and let rest for 15 minutes. Cut a 1/2-inch-deep “X” into the top of each loaf using a serrated knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1pVaODKKjKbGEHLi2Dcush2JBpA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-241738-chef-johns-irish-soda-bread-VAT-step-05-403e3e5639e94a8e93f327e451ac3835.jpg"
      ],
      "image": "assets/images/241738/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown and fragrant, about 45 minutes. Transfer loaves to a wire rack to cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KLG6UBU59AzliOGji46zV5nPPIU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-241738-chef-johns-irish-soda-bread-VAT-step-06-87f2e0992751455da8a2bb29f026ffbb.jpg"
      ],
      "image": "assets/images/241738/step_06.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1hp6gOkXjo_ebHp7bSbchHW62ro=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-241738-chef-johns-irish-soda-bread-VAT-4X3-0aabf7583ef1428fbe2b73240376472d.jpg"
      ],
      "image": "assets/images/241738/step_07.webp"
    }
  ],
