  "title": "Chef John’s Irish Soda Bread",
  "description": "This moist soda bread recipe is flavored with buttermilk, honey, and orange zest and is perfect for St. Patrick’s Day — or any time of year.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2015-03-16T15:29:13-04:00",
  "date_modified": "2026-08-18T15:12:56-04:00",
  "prep_time": "PT30M",
