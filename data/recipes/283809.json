  "ingredients": [
    "1 (15 ounce) can chickpeas, drained",
    "0.5 cup peanut butter",
    "0.5 cup pure maple syrup, or to taste",
    "3 tablespoons all-purpose flour",
    "0.5 teaspoon vanilla extract",
    "0.125 teaspoon salt",
    "0.5 cup vegan chocolate chips",
    "2 tablespoons peanuts"
  ],
  "steps": [
