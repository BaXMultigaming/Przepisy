  "ingredients": [
    "2 tablespoons butter",
    "1 small red onion, chopped",
    "0.5 apple - peeled, cored, and cubed",
    "0.5 cup red wine",
    "0.33333334326744 cup apple cider vinegar",
    "0.125 cup red wine vinegar",
    "2 tablespoons brown sugar",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 head red cabbage, shredded",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium heat. Add onion and apple; cook and stir until onion is translucent and apple is soft, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir wine, apple cider vinegar, red wine vinegar, brown sugar, cinnamon, and nutmeg into onion mixture; bring to a boil. Stir in cabbage to coat; season with salt and black pepper. Reduce heat; simmer until cabbage softened, about 30 minutes.",
      "section": null,
