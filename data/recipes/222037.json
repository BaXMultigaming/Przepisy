  "ingredients": [
    "1 pound ground beef",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "salt and ground black pepper to taste",
    "1 (16 ounce) package frozen tater tots",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rx4dYomHnUjbHWNWo0CoqxwWT-4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222037-tater-tot-casserole-VAT-01-c608047998644cd98e28949b5b92d22d.jpg"
      ],
      "image": "assets/images/222037/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until completely browned and crumbly, 7 to 10 minutes. Stir in condensed soup; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N-q9Wuimx5lQHgz-3ymgNhMfKY0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222037-tater-tot-casserole-VAT-02-7ac2169d429a4aaeaf687745ff4760fd.jpg"
      ],
      "image": "assets/images/222037/step_02.webp"
    },
    {
      "text": "Transfer beef mixture to a 9x13-inch baking dish; layer tater tots evenly on top and sprinkle with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9HTXX8Zd8wzqQqlvWS8B5wL72BA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222037-tater-tot-casserole-VAT-03-0f3e318a53094ad7a986943c77650275.jpg"
      ],
      "image": "assets/images/222037/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until tater tots are golden brown and hot, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V-Y5lYuVy7ghQOdUYvISpCvxwbw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222037-tater-tot-casserole-VAT-04-ea44d584f25f499ba8bec15e4a1ba624.jpg"
      ],
      "image": "assets/images/222037/step_04.webp"
    },
    {
      "text": "Serve and enjoy!",
