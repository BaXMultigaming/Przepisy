  "ingredients": [
    "5 cups water",
    "1 cup uncooked white long-grain rice",
    "0.66666668653488 cup white sugar",
    "0.5 cup milk",
    "0.5 tablespoon vanilla extract",
    "0.5 tablespoon ground cinnamon"
  ],
  "steps": [
    {
