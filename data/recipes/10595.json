  "ingredients": [
    "0.33333334326744 cup butter, softened",
    "0.66666668653488 cup white sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1.75 cups all-purpose flour",
    "0.33333334326744 cup unsweetened cocoa powder",
    "2 teaspoons baking powder",
    "0.5 cup miniature semisweet chocolate chips",
    "0.25 cup chopped walnuts",
    "1 egg yolk, beaten",
    "1 tablespoon water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease baking sheets, or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter and sugar until smooth. Beat in the eggs one at a time, then stir in the vanilla. Combine the flour, cocoa and baking powder; stir into the creamed mixture until well blended. Dough will be stiff, so mix in the last bit by hand. Mix in the chocolate chips and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into two equal parts. Shape into 9x2x1 inch loaves. Place onto baking sheet 4 inches apart. Brush with mixture of water and yolk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 to 25 minutes in the preheated oven, or until firm. Cool on baking sheet for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a serrated knife, slice the loaves diagonally into 1 inch slices. Return the slices to the baking sheet, placing them on their sides. Bake for 10 to 15 minutes on each side, or until dry. Cool completely and store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
