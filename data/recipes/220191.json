  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup brown sugar",
    "0.25 cup white sugar",
    "4 teaspoons baking powder",
    "2.5 teaspoons ground cinnamon",
    "0.25 teaspoon salt",
    "1.75 cups milk",
    "0.5 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "2 egg whites",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Whisk flour, brown sugar, white sugar, baking powder, cinnamon, and salt together in a bowl until no lumps remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk, vegetable oil, and vanilla extract into flour mixture until batter just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a large glass or metal mixing bowl until soft peaks form. Lift your beater or whisk straight up: the egg whites will form soft mounds rather than a sharp peak. Fold into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions. Coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook, in batches, in the preheated waffle iron until crisp and golden brown, about 2 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
