  "ingredients": [
    "0.25 cup butter",
    "1 onion, chopped",
    "0.25 cup all-purpose flour",
    "1 (10.5 ounce) can chicken broth",
    "2 cups milk",
    "1.5 cups grated Gouda cheese",
    "2 cups chopped broccoli",
    "1 pinch ground nutmeg",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium-high heat. Cook and stir onion in the melted butter until tender, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle flour over the onion; continue cooking 2 to 3 minutes, stirring often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour chicken broth and milk into the pot; reduce heat to medium, and bring the mixture to a simmer. Stir shredded Gouda cheese into the liquid; cook and stir until the cheese melts completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place broccoli into a microwave-safe dish; cook in the microwave until softened, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir broccoli into the soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season the soup with nutmeg, salt, and black pepper to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
