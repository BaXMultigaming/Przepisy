  "ingredients": [
    "6 red potatoes, scrubbed and cut into wedges",
    "3 tablespoons butter, melted",
    "3 tablespoons vegetable oil",
    "1 tablespoon chopped fresh rosemary",
    "0.125 teaspoon salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Mix together melted butter and oil, then pour into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes into the prepared dish; stir until coated. Sprinkle with rosemary, salt, and pepper. Cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are tender, about 30 minutes. Stir potatoes occasionally to ensure even cooking.",
      "section": null,
      "name": null,
