  "ingredients": [
    "1.75 cups boiling water",
    "1 cup rolled oats",
    "1 cup packed brown sugar",
    "1 cup white sugar",
    "0.5 cup butter",
    "2 eggs",
    "1.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 tablespoon unsweetened cocoa powder",
    "0.5 teaspoon salt",
    "1 cup semisweet chocolate chips",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Mix water and oatmeal in mixing bowl, and let sit 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sugars, butter or margarine, and eggs. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour, baking soda, cocoa, and salt. Blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into greased and floured 10 x 15 x 1 inch jelly roll pan. Top with chocolate chips and chopped nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 350 degrees F (175 degrees C) oven for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
