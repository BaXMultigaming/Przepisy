  "ingredients": [
    "1 cup white whole wheat flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon sea salt",
    "0.33333334326744 cup cold salted butter, cut into small pieces",
    "1 cup sourdough starter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, baking soda, and salt together into a large bowl. Cut in butter until pea-sized. Add sourdough starter and stir just until dough holds together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a floured board and knead 5 to 10 times. Pat to a 3/4-inch thickness and cut into 10 biscuits. Place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until golden brown, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
