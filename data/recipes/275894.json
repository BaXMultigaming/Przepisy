  "ingredients": [
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "3 large eggs",
    "0.5 cup fresh orange juice",
    "2.5 tablespoons fresh orange juice",
    "0.5 cup ricotta cheese",
    "2 tablespoons ricotta cheese",
    "0.5 cup vegetable oil",
    "0.5 cup milk",
    "0.5 cup white sugar",
    "3 tablespoons finely grated orange zest",
    "2.5 tablespoons sour cream",
    "2 teaspoons apple cider vinegar",
    "1 cup mini chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 18 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, 1/2 cup plus 2 1/2 tablespoons orange juice, 1/2 cup plus 2 tablespoons ricotta, vegetable oil, milk, sugar, orange zest, sour cream, and vinegar in a medium bowl. Make a well in the center of the flour mixture; pour in egg mixture and chocolate chips. Stir until flour is just moistened. Be sure not to overmix to avoid overly tough muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon about 1/4 cup batter into each muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 18 to 20 minutes. Transfer to a wire rack to cool for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
