  "ingredients": [
    "1.5 cups rolled oats",
    "0.5 cup whole wheat flour",
    "0.5 cup all-purpose flour",
    "0.33333334326744 cup white sugar",
    "0.75 teaspoon baking soda",
    "0.75 teaspoon baking powder",
    "6 tablespoons butter, cubed",
    "0.75 cup milk",
    "1 cup fresh blueberries or frozen blueberries, thawed",
    "0.5 cup pecans",
    "2 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the oatmeal, flours, sugar, baking soda, and baking powder together in a mixing bowl. Use a pastry cutter or two forks and cut in the butter with the flour mixture until crumbly and well blended. Stir the milk into the flour mixture until just combined. Lightly stir in the pecans and blueberries. Collect the dough into a ball and pat into a large circle about 1 inch high. Cut into 8 wedges, and place on prepared baking sheet. Brush tops with 2 tablespoons milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until lightly browned, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
