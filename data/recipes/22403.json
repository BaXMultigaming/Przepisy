  "ingredients": [
    "5 tablespoons vegetable oil",
    "2 large onions, chopped",
    "1 chile pepper, chopped",
    "5 cloves garlic, chopped",
    "2 pounds lean ground beef",
    "3 (14.5 ounce) cans whole peeled tomatoes with liquid, chopped",
    "1.5 teaspoons salt",
    "1 teaspoon freshly ground black pepper",
    "1.5 tablespoons ground cumin",
    "0.5 tablespoon chili powder",
    "2 tablespoons paprika",
    "2 tablespoons dried oregano",
    "2 cinnamon sticks",
    "6 whole cloves",
    "2 (15.25 ounce) cans red kidney beans, rinsed and drained"
  ],
  "steps": [
    {
      "text": "Heat oil in a medium stockpot over medium heat. Cook and stir onion, chile pepper, and garlic until softened, about 5 minutes. Add ground beef; cook and stir until browned and crumbly, 5 to 7 minutes. Drain excess grease if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in tomatoes with liquid, salt, pepper, cumin, chili powder, paprika, oregano, cinnamon sticks, and cloves. Cover and simmer for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in kidney beans, and cook another 15 minutes. Remove cinnamon sticks before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
