  "ingredients": [
    "4 cloves garlic, crushed",
    "2 teaspoons brown sugar",
    "1 teaspoon ground thyme",
    "1 teaspoon crushed dried rosemary",
    "0.5 teaspoon ground Jamaican allspice",
    "salt and freshly ground black pepper to taste",
    "4 bone-in, skin-on chicken thighs",
    "2 tablespoons olive oil",
    "1 cup chicken stock",
    "2 lemons"
  ],
  "steps": [
    {
      "text": "Mix garlic, brown sugar, thyme, rosemary, allspice, salt, and pepper together in a bowl. Pat chicken dry and rub with the spice mixture. Refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium-high heat. Add chicken thighs, skin-side down, and cook until crisp, about 4 minutes. Flip. Pour chicken stock around the thighs. Squeeze juice of 1 lemon into the skillet. Slice the second lemon and arrange over the thighs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and simmer until chicken is no longer pink at the bone and the juices run clear, about 30 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C). Discard lemon slices and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
