  "ingredients": [
    "1 pound tri-color pasta",
    "1 pound cooked and peeled medium shrimp",
    "1 pint cherry tomatoes, halved",
    "3 green onions, sliced",
    "0.5 cup sliced pitted green olives",
    "1 cup lemon juice",
    "0.5 cup extra-virgin olive oil",
    "1 clove garlic, minced",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil; cook rotini at a boil until tender yet firm to the bite, about 8 minutes. Drain and rinse.",
