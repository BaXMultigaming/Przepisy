    },
    {
      "text": "Combine rotini, shrimp, tomatoes, green onions, and olives in a large serving bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk lemon juice, olive oil, garlic, salt, and black pepper together in a bowl until well combined; pour over salad and toss. Cover the bowl with plastic wrap; refrigerate at least 4 hours.",
