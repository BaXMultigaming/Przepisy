  "ingredients": [
    "cooking spray",
    "1 (18.25 ounce) package yellow cake mix",
    "0.5 cup margarine, softened",
    "3 eggs",
    "4 teaspoons vanilla extract",
    "1 (8 ounce) package cream cheese",
    "4 cups confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch pan with floured cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix cake mix, margarine, 1 egg, and 2 teaspoons vanilla together. Press into the prepared pan as a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the same bowl, beat cream cheese, 2 eggs, and 2 teaspoons vanilla until combined. Gradually mix in confectioners' sugar until smooth. Pour over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake rises up around the sides of the pan and looks sunken in the middle, 35 to 40 minutes. Allow to cool before cutting into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
