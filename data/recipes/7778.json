  "ingredients": [
    "2 eggs",
    "1.25 cups white sugar",
    "0.33329999446869 cup butter",
    "1 cup + 1 tablespoon + 1 teaspoon all-purpose flour",
    "0.5 cup dry bread crumbs",
    "0.5 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease a 9 inch springform pan, and sprinkle with dry breadcrumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together the egg and sugar. Melt butter or margarine, and stir into mix. Add flour; mix until smooth, but not fluffy. Spread the batter into the prepared pan. Sprinkle flaked almonds on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 minutes. Allow cake to cool slightly before removing from the pan. Cool completely on a wire rack. This cake keeps very well for up to a week in an airtight container or plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
