  "ingredients": [
    "2 eggs",
    "2 (5 ounce) cans tuna, drained",
    "1 (6 ounce) can crabmeat, shredded",
    "0.5 cup mayonnaise",
    "1 teaspoon sour cream",
    "1 teaspoon yellow mustard",
    "0.5 teaspoon dried dill weed",
    "0.125 teaspoon lemon pepper",
    "2 tablespoons dill pickle relish",
    "2 tablespoons sweet pickle relish",
    "0.75 cup finely chopped onion"
  ],
  "steps": [
    {
      "text": "Place eggs in a saucepan and cover with cold water. Bring water to a boil and immediately remove from heat. Cover and let eggs stand in hot water for 10 to 12 minutes. Remove from hot water, cool, peel, and chop finely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, combine tuna, crabmeat, mayonnaise, sour cream, and mustard. Stir in chopped egg, dill weed, lemon pepper, dill, sweet relish, and chopped onion. Mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
