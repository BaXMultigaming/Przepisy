        "https://www.allrecipes.com/thmb/vNzCWvA1nUBHdiLHMPW9B_5qwW8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-218304-red-velvet-pancakes-with-cream-cheese-glaze-VAT-step-07-e4ed050156c64cb2bef4c4efe233aa5f.jpg"
      ],
