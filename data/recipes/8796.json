  "title": "Mom&#39;s Chicken Cacciatore",
  "description": "Chicken cacciatore is an Italian rustic stew made with chicken pieces, mushrooms, and bell peppers simmered in a tomato and herb sauce until tender.",
  "authors": [
    "Jana"
  ],
  "date_published": "1999-07-06T18:28:32-04:00",
