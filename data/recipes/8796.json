  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 cups all-purpose flour for coating",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 (4 pound) chicken, cut into pieces",
    "2 tablespoons vegetable oil",
    "1 onion, chopped",
    "1 green bell pepper, chopped",
    "2 cloves garlic, minced",
    "1 (14.5 ounce) can diced tomatoes",
    "0.5 cup white wine",
    "0.5 teaspoon dried oregano",
    "2 cups fresh mushrooms, quartered",
    "salt and pepper to taste",
    "fresh basil leaves for garnish"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bYg2bH_dLZ2PJnoQy_XoXEs9U04=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8796-moms-chicken-cacciatore-VAT-005-step-01-01withonesetofsaltandpepper-976e43676bb343fc8484846e99546a32.jpg"
      ],
      "image": "assets/images/8796/step_01.webp"
    },
    {
      "text": "Combine flour, salt, and pepper in a plastic bag; add chicken pieces and shake until coated in flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/37u60m0CX74zYSaaIkdlZLX4lOI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8796-moms-chicken-cacciatore-VAT-006-step-02-01combined-3057f63b83dd412a970cd8829d27e107.jpg"
      ],
      "image": "assets/images/8796/step_02.webp"
    },
    {
      "text": "Heat oil in a large skillet (that has a lid) over medium-low heat. Add floured chicken pieces and cook in hot oil until browned on both sides, about 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oPt6fXwyAIElG921PkkitKlJUOQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8796-moms-chicken-cacciatore-VAT-007-step-03-aa5bb0a534094ce4b35a9c76e9194ce0.jpg"
      ],
      "image": "assets/images/8796/step_03.webp"
    },
    {
      "text": "Transfer chicken pieces onto a plate; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x1f4D9dF22su5rkCEazuk1KyAPs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8796-moms-chicken-cacciatore-VAT-008-step-04-a82ef68a3e144adcb028b506307cf572.jpg"
      ],
      "image": "assets/images/8796/step_04.webp"
    },
    {
      "text": "Add onion, bell pepper, and garlic to the same skillet; cook and stir over medium-low heat until onion is softened and slightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cMnnChxhtPYcSxNHBxqyW2fiioM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8796-moms-chicken-cacciatore-VAT-009-step-05-01stirringaction-1-c2d69b5cbff64de4bc4116259bbe3da5.jpg"
      ],
      "image": "assets/images/8796/step_05.webp"
    },
    {
      "text": "Return chicken pieces to the skillet; add tomatoes, wine, and oregano. Cover and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sArBMNO9bZHjZ-6J5B3a3kiucC4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8796-moms-chicken-cacciatore-VAT-010-step-06-02cookednolidinframe-ac9df7522ba34c97b5d5707a9bfd8635.jpg"
      ],
      "image": "assets/images/8796/step_06.webp"
    },
    {
      "text": "Add mushrooms and salt and pepper to taste. Simmer until chicken is cooked through and tender, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Lp-9uaim1JARS_0R17NpHWOJB4k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8796-moms-chicken-cacciatore-VAT-011-step-07-9780451022bf4171ba92b1f808389e38.jpg"
      ],
      "image": "assets/images/8796/step_07.webp"
    },
    {
      "text": "Serve hot, garnished with fresh basil leaves. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J8vth2BqR58oLHmNeq95Kp-nvkk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8796-moms-chicken-cacciatore-VAT-003-4x3-02lowerangle-5414a0efe59e4fc5ad3b96e627ba113f.jpg"
      ],
      "image": "assets/images/8796/step_08.webp"
    }
  ],
