  "ingredients": [
    "2 pounds ground turkey",
    "1 (28 ounce) can stewed tomatoes",
    "3 stalks celery, chopped",
    "1 (15 ounce) can kidney beans, undrained",
    "1 (15 ounce) can pinto beans, undrained",
    "1.5 white onion, chopped",
    "1 green bell pepper, chopped",
    "1 red bell pepper, chopped",
    "1 cup water, or as needed",
    "1 (6 ounce) can tomato paste",
    "1 jalapeno pepper, seeded and minced",
    "1 tablespoon white sugar",
    "1 teaspoon crushed garlic",
    "1 tablespoon chili powder",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground turkey in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground turkey, stewed tomatoes, celery, kidney beans, pinto beans, white onion, green bell pepper, red bell pepper, water, tomato paste, jalapeno pepper, sugar, and garlic in a slow cooker; season with chili powder, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 2 to 2 1/2 hours.",
