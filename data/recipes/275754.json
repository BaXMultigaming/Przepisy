  "ingredients": [
    "1 (10.5 ounce) can condensed beef broth",
    "1 cup ketchup",
    "0.5 cup packed brown sugar",
    "0.5 cup lemon juice",
    "3 tablespoons steak sauce",
    "2 cloves garlic, minced",
    "1 tablespoon ground black pepper",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon salt",
    "1 (3.5 pound) beef eye of round roast, cut in half",
    "16 sandwich buns, split"
  ],
  "steps": [
    {
      "text": "Whisk beef broth, ketchup, brown sugar, lemon juice, steak sauce, garlic, pepper, and Worcestershire sauce together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/2 of the mixture into a 5-quart slow cooker. Sprinkle salt over beef. Add beef to the slow cooker and cover with the remaining broth mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until tender, 10 to 12 hours. Shred beef on a cutting board using 2 forks; return to the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a slotted spoon to place about 1/2 cup of the beef mixture on each sandwich bun.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
