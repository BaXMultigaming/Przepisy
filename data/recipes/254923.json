  "ingredients": [
    "2 cups all-purpose flour",
    "0.66666668653488 cup white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 cup sour cream",
    "0.5 cup butter, melted",
    "2 large eggs",
    "1 teaspoon milk",
    "1 teaspoon vanilla extract",
    "11 ounces fresh blackberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, baking powder, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sour cream, butter, eggs, milk, and vanilla extract together in a separate bowl; stir into flour mixture until blended. Fold blackberries into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 18 to 20 minutes. Cool in the tin for a few minutes, then transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
