  "ingredients": [
    "1.5 cups butter",
    "1 (8 ounce) package cream cheese",
    "3 cups white sugar",
    "1 tablespoon vanilla extract",
    "1 teaspoon almond extract",
    "6 eggs",
    "3 cups cake flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease one 10 inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the butter, cream cheese, and sugar until light. Stir in the vanilla and the almond extracts. Add the flour and the eggs alternately, beginning and ending with the flour. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C) for 1 hour and 15 minutes or until a toothpick inserted in the center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
