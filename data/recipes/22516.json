  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon salt",
    "1.5 cups white sugar",
    "0.5 cup butter, softened",
    "0.5 cup vegetable oil",
    "3 eggs",
    "1 teaspoon vanilla extract",
    "3 cups peeled, seeded and chopped mango",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts",
    "0.5 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, cinnamon, and salt together in a medium bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, and oil together in a large bowl until light and fluffy. Add eggs, one at a time, beating well after each addition; stir in vanilla. Add flour mixture; mix just until combined. Fold in mango, raisins, walnuts, and coconut, mixing just enough to evenly combine. Divide batter between the prepared pans; let stand for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
