  "title": "Magic Mango Bread",
  "description": "This magic mango bread recipe bakes fresh mango, shredded coconut, chopped walnuts, and raisins into an irresistible, tropical paradise quick bread.",
  "authors": [
    "SACKPAC"
  ],
  "date_published": "2000-09-15T21:53:28-04:00",
