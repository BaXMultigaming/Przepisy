  "ingredients": [
    "5 tablespoons soy sauce",
    "0.25 cup brown sugar",
    "2 tablespoons dry sherry",
    "1 teaspoon prepared yellow mustard",
    "0.5 teaspoon garlic powder",
    "24 chicken wings"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
