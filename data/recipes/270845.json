  "ingredients": [
    "1 pound asparagus spears",
    "1 tablespoon unsalted butter",
    "0.5 cup beef broth",
    "0.5 teaspoon garlic powder",
    "1 cup sliced fresh mushrooms",
    "0.25 cup whipped cream cheese",
    "2 tablespoons Greek yogurt",
    "0.75 teaspoon ground nutmeg",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Cut asparagus into 1-inch pieces. Melt butter in a large skillet over medium-high heat. Add asparagus, broth, and garlic powder; cover and cook, stirring occasionally, until asparagus is crisp-tender, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add mushrooms; cook until tender, 3 to 5 minutes. Reduce heat to low; add cream cheese, yogurt, nutmeg, and black pepper. Cook, stirring occasionally, until cream cheese melts, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
