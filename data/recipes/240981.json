  "ingredients": [
    "1 Reynolds® Slow Cooker Liner",
    "1 (12 fluid ounce) bottle dark German beer",
    "1 cup thinly sliced onions",
    "1 tablespoon maple syrup",
    "1 tablespoon white vinegar",
    "0.5 teaspoon caraway seeds",
    "0.5 teaspoon dried thyme, crushed",
    "0.5 teaspoon Worcestershire sauce",
    "6 uncooked bratwurst links",
    "6 hoagie buns, split and toasted",
    "1.5 cups shredded Cheddar cheese",
    "1.5 cups shredded lettuce"
  ],
  "steps": [
    {
      "text": "Line a 5- to 6-quart slow cooker with a Reynolds® Slow Cooker Liner.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add beer, onions, maple syrup, vinegar, caraway seeds, thyme, and Worcestershire sauce to the prepared slow cooker. Stir gently with a rubber spatula to combine. Place bratwurst on top of the mixture in cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook for 4 hours on high or for 8 hours on low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve bratwursts and onions in toasted buns topped with cheese and lettuce, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
