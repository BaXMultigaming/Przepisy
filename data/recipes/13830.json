  "title": "Dinner in a Pumpkin II",
  "description": "Ground beef, rice and vegetables in a creamy sauce are baked in a whole pumpkin in this dinner for six.",
  "authors": [
    "Joan"
  ],
  "date_published": "1999-10-31T23:04:57-05:00",
