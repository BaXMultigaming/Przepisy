  "ingredients": [
    "3 tablespoons bacon drippings",
    "0.25 cup all-purpose flour",
    "1.6666667461395 cups buttermilk, or more as needed",
    "0.5 teaspoon chicken bouillon granules",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat bacon drippings in a skillet over medium heat. Add flour and whisk until well combined and bubbly, about 1 minute. Pour in buttermilk gradually and bring to a boil, about 3 minutes. Reduce heat and simmer, whisking constantly, until thickened and smooth, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chicken bouillon, salt, and pepper. If gravy is too thick, whisk in more buttermilk until you reach your desired consistency. Serve immediately.",
