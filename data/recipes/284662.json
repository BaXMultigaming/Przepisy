  "ingredients": [
    "2.5 cups diced fresh strawberries",
    "3 tablespoons white sugar",
    "1.5 tablespoons cornstarch",
    "0.5 teaspoon vanilla extract",
    "0.125 teaspoon salt",
    "0.25 cup quick-cooking oats",
    "0.25 cup all-purpose flour",
    "0.25 cup white sugar",
    "0.25 cup salted butter, cubed",
    "0.125 teaspoon salt",
    "nonstick cooking spray"
  ],
  "steps": [
    {
      "text": "Place strawberries in a bowl and toss with 3 tablespoons sugar. Let sit until the juices release, 10 to 15 minutes. Stir in cornstarch, vanilla, and salt until combined; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, flour, sugar, butter, and salt for streusel in a bowl. Mix with your hands until crumbly and butter is in tiny bits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C). Spray 4 individual-sized ramekins with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide strawberry mixture evenly among all 4 ramekins. Top with streusel, dividing evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry in the preheated air fryer until streusel is golden brown, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
