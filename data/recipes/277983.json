  "ingredients": [
    "3 (6 ounce) containers plain yogurt",
    "2 tablespoons active dry yeast",
    "0.5 cup warm water",
    "4 cups all-purpose flour, or as needed, divided",
    "2 tablespoons white sugar",
    "2 tablespoons olive oil",
    "2 teaspoons salt",
    "cold water as needed"
  ],
  "steps": [
    {
      "text": "Place yogurt in a microwave-safe bowl. Microwave (or heat on the stovetop) until lukewarm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve yeast in ½ cup warm water. Stir in yogurt, 2 cups flour, sugar, oil, and salt; beat until smooth. Stir in enough remaining 2 cups flour to make dough easy to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a lightly floured surface; knead until smooth. Place in a greased bowl; let rise until doubled in volume, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 8 loaves; lightly brush each loaf with cold water. Cut 3 diagonal slashes across loaf tops with a sharp knife. Let rise until doubled in volume, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Brush loaves with cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until loaves sound hollow when tapped, 30 to 35 minutes, brushing with water twice during baking time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
