  "ingredients": [
    "8 large Idaho® Gold Potatoes",
    "0.5 cup soft butter",
    "0.5 cup shredded Parmesan cheese",
    "1.5 cups buttermilk",
    "1 cup heavy cream, or more to taste",
    "1 bunch flat leaf parsley, roughly chopped",
    "1 teaspoon kosher salt"
  ],
  "steps": [
    {
      "text": "Slice all potatoes in half, place in a large pan, and cover with cool water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil for 25 to 35 minutes or until potatoes are tender enough to mash.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain water and add remaining ingredients. The parsley cooks slightly with the heat of the potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash by hand or with a hand mixer; season to taste with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
