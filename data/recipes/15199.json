  "ingredients": [
    "6 skinless, boneless chicken breasts",
    "1 (1 ounce) package cheese and garlic dry salad dressing mix",
    "2 tablespoons all-purpose flour",
    "0.25 teaspoon salt",
    "0.25 cup butter",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in a lightly greased 9x13 inch baking dish. In a small bowl, combine the dry salad dressing mix, flour, salt, butter or margarine and lemon juice. Mix together, then brush mixture evenly over the top of the chicken breasts. Bake in the preheated oven for 60 minutes or until tender.",
