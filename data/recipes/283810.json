  "ingredients": [
    "3 cups hot water",
    "0.66666668653488 cup blanched almonds",
    "0.33333334326744 cup long grain rice",
    "1 (2 inch) stick cinnamon",
    "2 cups strawberries, sliced",
    "0.5 cup water",
    "0.25 cup stevia powder, or to taste",
    "4 cups ice, or as needed"
  ],
  "steps": [
    {
      "text": "Combine 3 cups hot water, almonds, and rice in a powerful blender, such as a Vitamix®; blend until smooth. Pour into a container, add cinnamon stick, and cover; let sit at room temperature for 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cinnamon stick from mixture break up into small pieces. Pour mixture and cinnamon pieces into the Vitamix® and blend until cinnamon pieces are pulverized and blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain mixture over a sieve. Pour back into Vitamix® and add strawberries, 1/2 cup water, and stevia. Blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour over ice and serve, or chill until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
