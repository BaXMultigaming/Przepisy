  "ingredients": [
    "1 cup whole wheat flour",
    "0.66666668653488 cup all-purpose flour",
    "0.33333334326744 cup wheat germ",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "2 tablespoons brown sugar",
    "1 teaspoon salt",
    "5.3333334922791 tablespoons unsalted butter",
    "2.5 cups buttermilk",
    "2 eggs, beaten",
    "3 tablespoons unsalted butter"
  ],
  "steps": [
    {
      "text": "In a food processor or in a large bowl, combine the whole wheat flour, white flour, wheat germ or oats, baking powder, baking soda, brown sugar, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut the butter into small pieces with a knife, and add the butter to the flour-mixture. Mix until the mixture has a sand-like consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a well in the center of the flour-butter mixture, and add the buttermilk and eggs. Stir until the liquids are fully incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a frying pan over medium heat and grease the surface with 1 tablespoon of butter or oil. Ladle the batter onto the surface to form 4 inch pancakes. Once bubbles form on the top of the pancakes, flip them over, and cook them on the other side for about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
