  "ingredients": [
    "1 (16 ounce) package bulk breakfast sausage",
    "1 green onion, chopped",
    "1 (16 ounce) package hash brown potatoes",
    "2 cups shredded Cheddar cheese",
    "6 large eggs, lightly beaten",
    "1 cup milk",
    "1 (2.64 ounce) package country gravy mix",
    "1 pinch ground paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease an 8x11-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir breakfast sausage in a skillet over medium heat until browned and crumbly, about 10 minutes; drain excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pO9Vw-Bzvb3SzixZiss-1TgW3Lg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230966-CoutrySundayBreakfastCasserole-Step1-0053-050d7ac2903740a88757509efb6e7328.jpg"
      ],
      "image": "assets/images/230966/step_02.webp"
    },
    {
      "text": "Stir green onion into sausage; transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cz8tujIvVw9j96Hk7SbnvKuEQAk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230966-CoutrySundayBreakfastCasserole-Step2-0056-3729e37449bc4bc797c0004d1011298c.jpg"
      ],
      "image": "assets/images/230966/step_03.webp"
    },
    {
      "text": "Layer hash brown potatoes over sausage mixture; sprinkle with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pedeaV6eMNo09obhxecRIUzzSLU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230966-CoutrySundayBreakfastCasserole-Step-4-0058-1bd1d2965faf470e8b820d84a8f8d80e.jpg"
      ],
      "image": "assets/images/230966/step_04.webp"
    },
    {
      "text": "Whisk eggs, milk, and gravy mix together in a bowl until smooth; pour over casserole. Sprinkle with paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TuMRvoGd3dyJg98CiplBfmbU1wE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230966-CoutrySundayBreakfastCasserole-Step-6-0061-464fe3d60b33463fa9953a3fe2b61460.jpg"
      ],
      "image": "assets/images/230966/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into center comes out clean, about 1 hour. Let stand 10 minutes to firm up before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SNtSTGd4qcqqvgcSwf2f7DPCmsM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230966-country-sunday-breakfast-casserole-DDMFS-4x3-5c2f16d8f61d455b9130caf9809f1ea7.jpg"
