  "ingredients": [
    "cooking spray",
    "8 potatoes, peeled and thinly sliced",
    "0.5 cup butter",
    "1 onion, finely chopped",
    "0.5 cup all-purpose flour",
    "2 teaspoons Dijon mustard",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "3 cups milk",
    "2 cups shredded Cheddar cheese",
    "3 cups diced ham"
  ],
  "steps": [
    {
      "text": "Gather all the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/04QrzB8_F_ABYGJbXv5GhQ21t40=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/256267-ham-and-scalloped-potatoes-DDMFS_4x3_Step_01-baf0a65d1050474eb297cc529f8b59f4.jpg"
      ],
      "image": "assets/images/256267/step_01.webp"
    },
    {
      "text": "Bring a large pot of water to a boil. Add potatoes and cook until almost tender, 5 to 10 minutes. Transfer to a colander and rinse with cold water until cool enough to handle. Drain well and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5FhPUkyg2NZaS5gYDzpxW1CgGMY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/256267-ham-and-scalloped-potatoes-DDMFS_4x3_Step_02-03c3565d95f94e8088d939c2daec41df.jpg"
      ],
      "image": "assets/images/256267/step_02.webp"
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add onion; cook and stir until tender, about 5 minutes. Stir in flour, Dijon mustard, salt, and pepper; cook for 1 minute. Gradually pour in milk, stirring constantly until sauce is thickened, about 5 minutes. Stir in Cheddar cheese until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iqnyerMq61RjS0F9yvVIHe62Tus=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/256267-ham-and-scalloped-potatoes-DDMFS_4x3_Step_03-7f2e3b3f19964420aee5e73776bd860a.jpg"
      ],
      "image": "assets/images/256267/step_03.webp"
    },
    {
      "text": "Layer ½ of the potatoes in the bottom of the prepared baking dish. Top with 1 ½ cups diced ham and ½ of the Cheddar cheese sauce. Repeat another layer with remaining potatoes, ham, and sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PD9zdtANuJe5tAOJeYjfB5RwEWw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/256267-ham-and-scalloped-potatoes-DDMFS_4x3_Step_04-d8ca27bd51784d329b2bd8c8e35a48b6.jpg"
      ],
      "image": "assets/images/256267/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until the sauce is bubbling and the top of the casserole is golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hWRGbCg_VDfIZ84bT47ISTvihR4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/256267-ham-and-scalloped-potatoes-DDMFS_4x3_Step_05-309073b1a9e64568ac074c8880963c26.jpg"
      ],
      "image": "assets/images/256267/step_05.webp"
    }
