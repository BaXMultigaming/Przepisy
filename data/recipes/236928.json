  "ingredients": [
    "1 (20 ounce) package 15-bean soup mix (seasoning packet not used)",
    "2 tablespoons olive oil, or more as needed",
    "1 large onion, diced",
    "12 carrots, peeled and chopped, or more to taste",
    "15 crimini mushrooms, sliced, or more to taste",
    "7 stalks celery, chopped, or more to taste",
    "6 leaves dinosaur kale, chopped",
    "4 leaves red Swiss chard, chopped",
    "3 large cloves garlic, minced",
    "12 cups vegetable broth",
    "2 bay leaves",
    "1 teaspoon dried rosemary",
    "1 teaspoon dried basil",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place bean soup mix (without seasoning packet) into a large container; cover with several inches of cool water. Let stand 8 hours to overnight. Strain and rinse.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5MEJX_TEBluJLXj1U41pRUPiXbo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236928-vegetarian-15-bean-soup-VAT-step-01-cf62e3afec1942eea942e7a4430b86d4.jpg"
      ],
      "image": "assets/images/236928/step_01.webp"
    },
    {
      "text": "Heat olive oil in a stockpot over medium heat. Add onion; cook until golden brown, 15 to 20 minutes. Add carrots, mushrooms, celery, kale, chard, and garlic; cook and stir until carrots and mushrooms are slightly tender, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/17TRJtK28BpzYPuK7WGEDmy2MmU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236928-vegetarian-15-bean-soup-VAT-step-02-e103b5d19fb748c68a4ef26a8ae9c9e3.jpg"
      ],
      "image": "assets/images/236928/step_02.webp"
    },
    {
      "text": "Pour broth over vegetable mixture; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mzqf7QeKD5nPeZyg8xGvDcXmBx4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236928-vegetarian-15-bean-soup-VAT-step-03-afd02a0708a14b36a3e419affdbff260.jpg"
      ],
      "image": "assets/images/236928/step_03.webp"
    },
    {
      "text": "Reduce the heat; add bay leaves, rosemary, basil, salt, and black pepper. Add strained beans; simmer until softened, 1 ½ to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WSg060kUqqRIPYl5De2XngzCpfM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236928-vegetarian-15-bean-soup-VAT-step-04-7e3e8e5f7b024a07a49a22ce3607e7af.jpg"
      ],
