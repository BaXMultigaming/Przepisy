  "ingredients": [
    "1 (14.5 ounce) can stewed tomatoes, chopped",
    "1 onion, chopped",
    "2 stalks celery, chopped",
    "1 carrot, sliced",
    "1 (6 ounce) can tomato paste",
    "0.33333334326744 cup bottled steak sauce",
    "0.25 cup chopped green bell pepper",
    "0.25 cup chopped red bell pepper",
    "0.25 cup white wine",
    "1 pinch crushed red pepper flakes",
    "5 slices bacon",
    "1.5 pounds ground beef",
    "1 (1.25 ounce) package chili seasoning mix",
    "1 teaspoon ground cumin",
    "1 (15 ounce) can kidney beans, drained",
    "1 tablespoon chopped fresh cilantro",
    "1 tablespoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZGCHBhyUIdAcLG4veQ1RVuEhon8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AwardWinningChili-26357-ddmfs-Ingredients-step1-1827-ee3087752d854382be7243bf95764cf6.jpg"
      ],
      "image": "assets/images/26357/step_01.webp"
    },
    {
      "text": "Combine tomatoes, onion, celery, carrot, tomato paste, steak sauce, bell peppers, wine, and red pepper flakes in a large pot. Bring to a simmer over medium-low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bOa84jACJGXRcaXFh_GPmr_bwHw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AwardWinningChili-26357-ddmfs-Step2-1831-9f62a5a7a5034ac2ba3784c65611fad0.jpg"
      ],
      "image": "assets/images/26357/step_02.webp"
    },
    {
      "text": "While tomato mixture simmers, cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N4QPdeiKxPsZsTnNcMo1JyC2chY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AwardWinningChili-26357-ddmfs-Step3-1834-2a66ea4a3f0b44c28e9763057390de55.jpg"
      ],
      "image": "assets/images/26357/step_03.webp"
    },
    {
      "text": "Cook and stir beef in bacon drippings over medium-high heat until brown and crumbly; drain. Stir in chili seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dUEiI21Mz3sfJyMfMG5wGJg1Kq0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AwardWinningChili-26357-ddmfs-Step4-1836-9f328f8ef0674bdf884a094528209c7c.jpg"
      ],
      "image": "assets/images/26357/step_04.webp"
    },
    {
      "text": "Stir seasoned beef, bacon, and cumin into tomato mixture. Continue to simmer until vegetables are tender and flavors are well blended. Stir in beans, cilantro, and parsley. Continue cooking until beans are heated through. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mYr8yoNmNbchpc7obUEIqBDTZMk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AwardWinningChili-26357-ddmfs-Step6-1847-1623b3ded584470d86a0216be85f23d9.jpg"
      ],
      "image": "assets/images/26357/step_05.webp"
    }
