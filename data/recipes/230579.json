  "ingredients": [
    "2 cups white sugar",
    "1.5 cups applesauce",
    "2 cups pumpkin puree",
    "4 eggs, beaten",
    "2 teaspoons baking powder",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon ground mace",
    "0.5 cup chopped walnuts",
    "0.5 cup semisweet chocolate chips",
    "3 cups all-purpose flour",
    "0.25 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar and applesauce in a bowl; stir in pumpkin purée and eggs until smooth. Stir in baking powder, baking soda, cinnamon, salt, ginger, cloves, and mace until incorporated. Fold in walnuts and chocolate chips. Stir in flour until fully blended. Divide batter between the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Cool in the pans for 10 minutes before removing from the pans; transfer to a wire rack to cool completely, about 50 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle loaves with confectioners' sugar before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
