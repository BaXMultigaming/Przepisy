  "ingredients": [
    "1 (12 ounce) package frozen pound cake, thawed and cut into cubes",
    "2 (21 ounce) cans cherry pie filling",
    "1 (12 ounce) jar hot fudge ice cream topping, warmed",
    "4 cups frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Arrange half of the pound cake cubes into the bottom of a glass trifle bowl; top with 1 can cherry pie filling, half of the hot fudge, and 2 cups whipped topping. Repeat layers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle remaining hot fudge over the top. Spoon a few dollops of cherry pie filling decoratively over whipped topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover trifle and refrigerate until chilled before serving, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
