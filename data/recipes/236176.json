    "1 pound Italian turkey sausage, casings removed",
    "2 carrots, thinly sliced",
    "1 large onion, chopped",
    "1 cup thinly sliced mushrooms",
    "0.33333334326744 cup chopped fresh parsley, divided",
    "1 clove garlic, minced",
