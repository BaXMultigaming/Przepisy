  "ingredients": [
    "1.5 teaspoons coconut oil",
    "10 jalapeno peppers, sliced",
    "10 habanero peppers, sliced",
    "0.5 cup minced onion",
    "3 cloves garlic, minced",
    "0.5 lime, juiced",
    "1 teaspoon salt",
    "1.5 cups watermelon juice",
    "0.5 cup diced mango",
    "1 cup white vinegar"
  ],
  "steps": [
    {
      "text": "Heat coconut oil in a medium glass- or enamel-lined saucepan over high heat. Add jalapenos, habanero peppers, onion, garlic, lime juice, and salt. Saute mixture for 5 minutes; reduce heat to a simmer. Stir in watermelon juice and mango and cook, stirring often, for 20 minutes. Remove from heat and let mixture cool to room temperature, 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer mixture to a food processor and puree until smooth. With processor running, slowly add vinegar until combined. Pour sauce into a clean jar with a tight lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
