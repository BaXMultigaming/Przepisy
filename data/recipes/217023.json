  "ingredients": [
    "4 onions, sliced",
    "1 pound small new potatoes",
    "1 (16 ounce) package baby carrots",
    "7 pounds beef brisket",
    "1 cup beef broth",
    "1 packet dry onion soup mix",
    "1 cup ketchup",
    "10 fluid ounces ginger ale"
  ],
  "steps": [
    {
      "text": "Layer the onions, potatoes, and carrots into the bottom of a large Dutch oven. Place the brisket on top of the vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the beef broth, onion soup mix, ketchup, and ginger ale in a bowl, and pour it over the brisket and vegetables. Bring to a boil over high heat, cover, and reduce heat to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Simmer the brisket until tender, about 2 1/2 hours.",
