  "ingredients": [
    "1 (11 ounce) can whole kernel corn, drained",
    "1 (4 ounce) can sliced black olives, drained",
    "1.5 cups diced roma tomatoes",
    "0.75 cup diced red onion",
    "1 red bell pepper, seeded and diced",
    "1.5 teaspoons minced jalapeno pepper",
    "1 avocados - peeled, pitted and diced",
    "2 tablespoons olive oil",
    "2 tablespoons fresh lime juice",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Mix together corn, olives, tomatoes, onion, red pepper, and jalapeño pepper in a large bowl until well combined. Gently fold in avocados, olive oil, lime juice, and salt.",
