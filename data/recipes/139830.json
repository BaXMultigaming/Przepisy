  "ingredients": [
    "2 tomatoes, diced",
    "1 mango - peeled, seeded and diced",
    "1 ripe avocado - peeled, pitted, and diced",
    "0.5 cup chopped fresh cilantro",
    "0.25 cup chopped red onion",
    "2 tablespoons lime juice",
    "3 cloves garlic, minced",
    "0.5 teaspoon salt",
    "0.25 cup honey butter",
    "1 pound salad shrimp",
    "4 (10 inch) flour tortillas, warmed"
  ],
  "steps": [
    {
      "text": "Toss tomatoes, mango, avocado, cilantro, onion, lime juice, garlic, and salt together in a bowl. Cover and refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt honey butter in a skillet over medium-high heat. Add shrimp; cook and stir until pink and opaque, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a few shrimp on a warm tortilla, top with mango salsa, and fold up. Repeat with remaining ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
