  "ingredients": [
    "1 cup sunflower seed oil",
    "1 tablespoon sunflower oil",
    "1.25 cups white sugar",
    "5 large eggs, at room temperature",
    "1 cup advocaat egg liqueur",
    "1 tablespoon advocaat egg liqueur",
    "2 cups all-purpose flour",
    "3 teaspoons baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a Bundt cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together sunflower seed oil, white sugar, and eggs with an electric mixer until well combined. Slowly add advocaat egg liqueur while stirring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and baking powder in a bowl and fold flour mixture into the batter with a spatula until well combined. Pour batter into the prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven on the lowest rack of your oven until a tester comes out clean, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
