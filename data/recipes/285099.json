  "ingredients": [
    "1 head cauliflower, cut into florets",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "1 (8 ounce) package processed cheese (such as Velveeta®), cubed",
    "1 cup shredded Cheddar cheese",
    "2 teaspoons curry powder, or to taste"
  ],
  "steps": [
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add cauliflower, cover, and steam until tender, 2 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine soup, processed cheese, and Cheddar cheese in a small saucepan over medium-low heat. Cook and stir until melted and creamy, 3 to 5 minutes. Add curry powder and cook for 3 to 4 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix steamed cauliflower into the cheese sauce and toss until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
