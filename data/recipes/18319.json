  "ingredients": [
    "8 potatoes, peeled and diced",
    "0.25 cup butter",
    "1 onion, chopped",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "0.25 cup sour cream",
    "0.75 cup shredded Cheddar cheese",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes into a large pot and cover with salted water; bring to a boil. Reduce the heat to medium-low and simmer until tender, about 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While potatoes are cooking, melt butter in a small skillet over medium heat. Add onion and sauté until golden brown. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash potatoes with condensed soup and sour cream until smooth and creamy. Mix in onions, 3/4 cup Cheddar cheese, salt, and pepper. Spoon into a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Sprinkle remaining 1/4 cup Cheddar over top and bake for 10 more minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
