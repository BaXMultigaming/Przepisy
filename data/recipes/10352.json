  "ingredients": [
    "1 cup white sugar",
    "1 cup shortening",
    "1 cup honey",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking soda",
    "1 teaspoon ground ginger",
    "4 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gi8puBidF1WREpiaFLi2jB43uo8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10352-old-german-honey-cookies-DDMFS-step-01-83966533b6d74da39ebce73f4d271de7.jpg"
      ],
      "image": "assets/images/10352/step_01.webp"
    },
    {
      "text": "Heat sugar, butter, and honey in a saucepan over low heat, stirring until melted and combined. Remove from heat and let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UWwWW2c3n4QJAsite3bj6Gxw9Ok=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10352-old-german-honey-cookies-DDMFS-step-02-627b4683f32447b59cc5e559d292dfca.jpg"
      ],
      "image": "assets/images/10352/step_02.webp"
    },
    {
      "text": "Whisk eggs, vanilla, baking soda, and ginger together in a large bowl. Gradually stir into the cooled honey mixture until well blended. Add flour, 1 cup at a time, mixing after each addition until a soft dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v1j8alVe-BBV6B2UUSrtjYDRgJI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10352-old-german-honey-cookies-DDMFS-step-03-21285f2c33ed4875ba13498ec826cdc4.jpg"
      ],
      "image": "assets/images/10352/step_03.webp"
    },
    {
      "text": "Drop dough by teaspoonfuls onto prepared baking sheets, spacing about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P-1if8FIPQMF2UoptIxFMqptt00=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10352-old-german-honey-cookies-DDMFS-step-04-ec3ee46f2936424597f6cc89690a3bb3.jpg"
      ],
      "image": "assets/images/10352/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are golden brown, 12 to 15 minutes. Cool on baking sheets for 5 minutes before transferring to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1x4fwXL_DCeYFNnoYFisUYgkYw4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10352-old-german-honey-cookies-DDMFS-step-05-21dec7d625804981964aa8ec8c183c13.jpg"
      ],
      "image": "assets/images/10352/step_05.webp"
    }
  ],
