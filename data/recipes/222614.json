  "ingredients": [
    "2 baking potatoes",
    "2 tablespoons butter, softened",
    "1 tablespoon milk",
    "0.25 teaspoon salt",
    "1 (3 ounce) package cream cheese, cubed",
    "2 tablespoons sour cream",
    "1 pinch paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Scrub and dry potatoes, then prick several times with a fork and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are easily pierced with a fork, 50 minutes to 1 hour. Remove from oven and cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut a thin slice off the top of each potato; scoop out pulp and place in a small bowl. Beat potato flesh, butter, milk, and salt with an electric mixer in a large bowl until smooth and fluffy. Fold cream cheese and sour cream into potatoes; spoon mixture into potato shells. Sprinkle with paprika and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through and tops are golden brown, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
