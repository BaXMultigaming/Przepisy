  "ingredients": [
    "0.25 cup olive oil",
    "1 onion, chopped",
    "1 small garlic clove, crushed",
    "6 (6 ounce) lobster tails, thawed",
    "1 tablespoon chopped fresh parsley",
    "1 (28 ounce) can crushed tomatoes",
    "1 (8 ounce) can tomato sauce",
    "3 tablespoons chopped fresh basil",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large saucepan over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion and garlic; cook and stir until lightly browned, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add lobster tails and parsley; cook until shells turn bright red, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in crushed tomatoes, tomato sauce, basil, salt, and black pepper; simmer over low heat for 1 hour, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove lobster tails from sauce; shake off excess sauce from shells. Remove lobster meat from shells; stir into sauce or serve lobster tails separately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
