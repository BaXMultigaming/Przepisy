  "ingredients": [
    "0.25 cup brown sugar",
    "0.25 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup butter, softened",
    "0.25 cup white sugar",
    "0.5 cup sour cream",
    "1 teaspoon vanilla extract",
    "1 egg",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "1 pinch salt",
    "0.33300000429153 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour 8 inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In small bowl, combine brown sugar, 1/4 cup white sugar, cinnamon; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In medium bowl, cream butter and 1/4 cup sugar until light and fluffy; beat in sour cream, vanilla and egg. In a separate bowl, mix flour, baking soda and salt; add to creamed mixture. Blend well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread half of the batter in prepared pan; add raisins. Sprinkle half of the topping mixture over the raisins. Spread remaining batter over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 25 to 30 minutes, or until toothpick inserted into center of cake comes out clean. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
