  "ingredients": [
    "2 egg whites",
    "1 cup white sugar",
    "1 pinch salt",
    "0.5 teaspoon vanilla extract",
    "1 pound pecan halves",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites until soft peaks begin to form. Add sugar, salt, and vanilla; beat until stiff peaks form and turn glossy. Fold in nuts and coat well with the egg white mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a 9x13 inch baking pan by placing pan in the oven. Evenly spread coated nuts over melted butter in pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes, stirring and turning nuts about every 8 minutes, or until butter no longer remains in pan. Place hot nuts on foil and allow to cool. May be stored in an airtight container for several weeks!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
