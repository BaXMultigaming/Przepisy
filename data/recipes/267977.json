  "ingredients": [
    "1.5 cups white sugar",
    "1 cup butter",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "0.75 teaspoon baking soda",
    "0.75 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 cup chopped pecans",
    "0.5 cup butterscotch chips",
    "0.5 cup semisweet chocolate chips",
    "0.5 cup sweetened dried cranberries (such as Ocean Spray® Craisins®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, eggs, and vanilla extract together in a bowl until fluffy. Combine flour, cocoa powder, baking soda, baking powder, and salt in a separate bowl. Stir flour mixture into butter mixture. Stir in pecans, butterscotch chips, chocolate chips, and cranberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop cookie dough by rounded teaspoons onto an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden brown and set, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
