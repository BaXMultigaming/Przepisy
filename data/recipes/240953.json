  "ingredients": [
    "0.5 cup mayonnaise",
    "2 tablespoons apple cider vinegar",
    "1 tablespoon white sugar",
    "0.5 teaspoon lemon juice",
    "0.5 teaspoon prepared horseradish",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.125 teaspoon cayenne pepper",
    "2 tablespoons water, or more to taste"
  ],
  "steps": [
    {
      "text": "Stir mayonnaise, vinegar, sugar, lemon juice, horseradish, salt, black pepper, and cayenne pepper together in a bowl until smooth. Slowly stream water into the sauce, increasing the amount until you reach your desired consistency.",
