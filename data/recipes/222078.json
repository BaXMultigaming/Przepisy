  "title": "Healthier Mom's Zucchini Bread",
  "description": "This moist and flavorful zucchini bread is made a lot healthier by using whole wheat flour, low-fat milk, less oil and sugar, and more zucchini.",
  "authors": [
    "MakeItHealthy"
  ],
  "date_published": "2020-06-18T23:48:55-04:00",
