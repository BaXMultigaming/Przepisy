  "ingredients": [
    "1.5 cups all-purpose flour",
    "1.5 cups white whole wheat flour",
    "3 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1.5 cups white sugar",
    "3 eggs",
    "0.5 cup low-fat milk",
    "0.5 cup vegetable oil",
    "3 teaspoons vanilla extract",
    "3 cups grated zucchini",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 8x4-inch pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together all-purpose flour, whole-wheat flour, cinnamon, salt, baking soda, and baking powder into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together sugar, eggs, milk, oil, and vanilla in a second large bowl until well combined. Add sifted flour mixture and beat well. Stir in zucchini and walnuts until evenly distributed in batter. Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of loaves comes out clean, 40 to 60 minutes. Cool in the pans on a wire rack for 20 minutes. Remove loaves from the pans and place directly on the wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
