  "ingredients": [
    "1.5 cups white sugar",
    "3 large eggs",
    "1 stick butter, melted and cooled",
    "0.25 cup brewed coffee",
    "2 tablespoons brown sugar",
    "1 tablespoon sour cream",
    "2 teaspoons vanilla extract",
    "1.5 cups sifted all-purpose flour",
    "0.25 cup unsweetened cocoa powder (such as Hershey's®)",
    "1 tablespoon ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, eggs, butter, coffee, brown sugar, sour cream, and vanilla extract together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cocoa powder, cinnamon, salt, and baking powder in a separate bowl. Add to the butter mixture and mix until smooth. Pour batter into the prepared pan. Smooth out evenly and trim excess parchment paper from the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place baking pan on a flat surface. Carefully lift out brownies using the parchment paper edges; place on a cutting board. Let cool before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
