  "ingredients": [
    "1 package Duncan Hines® Moist Deluxe® French Vanilla Cake Mix",
    "2 large eggs",
    "1 cup butter or margarine, melted",
    "0.75 cup firmly packed light brown sugar",
    "1 teaspoon vanilla extract",
    "1 (12 ounce) package butterscotch chips",
    "1.5 cups chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F. Grease 15 1/2 x 10 1/2 x 1-inch jelly-roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, eggs, melted butter, brown sugar and vanilla extract in large bowl. Beat at low speed with electric mixer until smooth and creamy. Stir in butterscotch chips and pecans. Spread in pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F for 20 to 25 minutes or until golden brown. Cool completely. Cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
