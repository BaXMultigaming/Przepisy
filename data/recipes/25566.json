  "ingredients": [
    "3 (1 ounce) squares unsweetened chocolate, chopped",
    "1 cup mayonnaise",
    "2 tablespoons vinegar",
    "2 tablespoons vanilla extract",
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "2 cups warm water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan. Melt the chocolate in a double boiler or in the microwave.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the melted chocolate into a large mixing bowl. Blend in the mayonnaise, vinegar and vanilla. Combine the flour, sugar, baking soda, and salt and gradually stir into the chocolate mixture. Slowly stir in the warm water. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 35 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
