  "ingredients": [
    "5 cups diced red potatoes",
    "7 cups water",
    "4 teaspoons salt",
    "1.25 cups green onions, chopped",
    "0.33333334326744 cup chopped fresh dill",
    "2 cups buttermilk",
    "1 cup half-and-half"
  ],
  "steps": [
    {
      "text": "Place diced potatoes into a large saucepan, and cover with water. Bring to a boil over high heat, then reduce heat, and simmer until potatoes are tender, about 25 minutes. Stir in the green onions, dill, and buttermilk; bring back to a simmer. Stir in the half-and-half before serving.",
