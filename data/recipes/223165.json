  "ingredients": [
    "cooking spray",
    "1.5 cups quick-cooking oats",
    "1 cup almond flour",
    "0.75 cup chopped dried mixed fruit",
    "0.5 cup crispy rice cereal",
    "0.5 cup brown sugar",
    "0.5 cup chopped pecans",
    "0.5 cup chocolate chips",
    "0.25 cup flax seeds",
    "1 tablespoon instant coffee granules, or more to taste",
    "1 teaspoon ground cinnamon",
    "0.75 cup applesauce",
    "0.5 cup honey",
    "1 egg",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, almond flour, dried fruit, rice cereal, brown sugar, pecans, chocolate chips, flax seeds, instant coffee granules, and cinnamon in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk applesauce, honey, egg, and vanilla extract in a small bowl; pour into oat mixture. Stir until evenly incorporated. Press batter into prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden brown, 25 to 30 minutes. Cool completely before cutting into granola bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
