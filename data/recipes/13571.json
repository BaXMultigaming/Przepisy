  "ingredients": [
    "1 cup butter",
    "2 cups chopped onion",
    "2 cups chopped celery",
    "12 ounces sliced mushrooms",
    "0.25 cup chopped fresh parsley",
    "12 cups dry bread cubes",
    "1.5 teaspoons salt",
    "1.5 teaspoons dried sage",
    "1 teaspoon poultry seasoning",
    "1 teaspoon dried thyme",
    "0.5 teaspoon dried marjoram",
    "0.5 teaspoon ground black pepper",
    "4.5 cups chicken broth, or as needed",
    "2 large eggs, beaten"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Add onion, celery, mushrooms, and parsley; cook until slightly softened, 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tEVWbA9e_0t4O7Zaq2w8M0fbuiw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13571-Slow-Cooker-Stuffing-DDMFS-4x3-step-02-ccb9b3c7c275464089cc36abae3386ed.jpg"
      ],
      "image": "assets/images/13571/step_01.webp"
    },
    {
      "text": "Place bread cubes in a large bowl; fold in vegetable mixture, salt, sage, poultry seasoning, thyme, marjoram, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UUecygm7P2FcbdCbiymX7e5KK0w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13571-Slow-Cooker-Stuffing-DDMFS-4x3-step-03-bf0c7b5a81f8466ca531cfc6e08bff4d.jpg"
      ],
      "image": "assets/images/13571/step_02.webp"
    },
    {
      "text": "Add enough broth to moisten mixture — it should be evenly damp, but not soggy. Fold in eggs until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kueo-A74MlvbW1Wcg87Zt6xkbys=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13571-Slow-Cooker-Stuffing-DDMFS-4x3-step-04-45ce99abf8404ccf9ede8c650323ea7a.jpg"
      ],
      "image": "assets/images/13571/step_03.webp"
    },
    {
      "text": "Transfer mixture to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p_8ZQIHFMf0s7kUJu4_hrnne7Mc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13571-Slow-Cooker-Stuffing-DDMFS-4x3-step-05-ccd1278931a743abac306f5d283ba2f4.jpg"
      ],
      "image": "assets/images/13571/step_04.webp"
    },
    {
      "text": "Cover and cook on High for 45 minutes. Reduce heat to Low and cook until flavors blend, about 4 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FSvPT39unq4TIWmmxey0wkX-wUY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13571-Slow-Cooker-Stuffing-DDMFS-4x3-8a1cc222f2a44faba6e920635d1bd2a5.jpg"
      ],
      "image": "assets/images/13571/step_05.webp"
    }
