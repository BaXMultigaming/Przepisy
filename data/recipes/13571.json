  "title": "Slow Cooker Stuffing",
  "description": "This slow cooker stuffing recipe is made with celery, onions, and butter tossed with bread cubes, broth, and herbs, then slow-cooked until golden.",
  "authors": [
    "Gayle Wagner"
  ],
  "date_published": "1998-11-01T14:42:16-05:00",
