  "ingredients": [
    "1.25 cups reduced fat margarine",
    "0.5 cup white sugar",
    "0.75 cup packed brown sugar",
    "2 egg whites",
    "1 teaspoon vanilla extract",
    "0.5 cup all-purpose flour",
    "1 teaspoon baking soda",
    "3 cups rolled oats"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the margarine, white sugar and brown sugar until smooth. Beat in the egg whites one at a time, then stir in the vanilla. Combine the flour and baking soda; stir into the sugar mixture. Mix in the rolled oats. Drop dough by teaspoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven. Allow cookies to cool on baking sheet for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
