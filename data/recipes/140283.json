  "ingredients": [
    "1 cup low-fat sour cream",
    "0.5 cup buttermilk",
    "0.5 teaspoon dried parsley",
    "0.5 teaspoon dried chives",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon dried dill weed",
    "0.25 teaspoon onion powder",
