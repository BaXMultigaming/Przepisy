  "ingredients": [
    "cooking spray",
    "1.5 cups all-purpose flour",
    "2 tablespoons confectioners' sugar",
    "0.5 cup butter, softened",
    "1.5 cups brown sugar",
    "2 eggs, well beaten",
    "0.25 cup melted butter",
    "1 tablespoon white vinegar",
    "1 teaspoon vanilla extract",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Spray a 9x9-inch pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour and confectioner's sugar together in a bowl; stir in 1/2 cup butter until crumbly. Press flour mixture evenly into the bottom of prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 5 minutes. Remove pan from the oven, leaving oven at 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, eggs, 1/4 cup melted butter, vinegar, and vanilla extract together in a bowl until smooth; stir in raisins. Pour sugar mixture over baked crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven until bubbly and golden, about 35 minutes; cool before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
