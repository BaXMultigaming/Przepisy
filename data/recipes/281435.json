  "ingredients": [
    "1 (16 ounce) package littleneck clams",
    "0.75 cup unsalted butter",
    "2 heads garlic, chopped",
    "1 tablespoon Cajun seasoning",
    "1 tablespoon lemon and herb seafood seasoning",
    "0.5 tablespoon cayenne pepper",
    "1 pound uncooked medium shrimp, peeled and deveined",
    "1 pound Snow Crab legs",
    "2 lobster tails, split in half lengthwise",
    "4 andouille sausage links, cut into quarters",
    "3 ears corn, cut into chunks"
  ],
  "steps": [
    {
      "text": "Remove grit from clams by soaking in salt water for 20 minutes. Repeat this step twice. Scrub shells clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a medium saucepan over low heat with garlic, Cajun seasoning, seafood seasoning, and cayenne until garlic is fragrant, 1 to 2 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place clams, shrimp, crab, and lobster on a sheet pan. Add sausage and corn. Pour seasoned butter over and mix to ensure all is covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until shrimp just turns opaque, clams open, and sausage is browned, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
