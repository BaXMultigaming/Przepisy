  "ingredients": [
    "1 (15.25 ounce) package lemon cake mix",
    "0.5 (8 ounce) package cream cheese, softened",
    "1 (3 ounce) package lime-flavored gelatin mix",
    "0.75 cup limeade",
    "0.333 cup vegetable oil",
    "4 large eggs",
    "0.5 medium lime, zested and juiced",
    "0.5 cup unsalted butter, softened",
    "1 (8 ounce) package cream cheese, softened",
    "4.5 cups powdered sugar",
    "4.5 tablespoons Key lime juice",
    "3 tablespoons graham cracker crumbs, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 10-inch Bundt® pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix, cream cheese, gelatin mix, limeade, vegetable oil, eggs, lime zest, and lime juice for cake in a mixing bowl; mix until smooth and well combined. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 45 minutes. Remove from the oven and let cool to room temperature, 30 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and cream cheese for glaze in a bowl with an electric mixer until light and fluffy. Add powdered sugar and Key lime juice and mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the pan over and remove the cooled cake onto a serving plate. Pour glaze over the cake and garnish with crushed graham crackers and more lime zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
