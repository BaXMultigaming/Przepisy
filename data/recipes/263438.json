  "ingredients": [
    "3 tablespoons butter",
    "1 (16 ounce) package frozen shrimp, deveined and tails removed, thawed",
    "0.25 cup honey",
    "0.125 cup balsamic vinegar",
    "1 teaspoon ground mustard",
    "1 teaspoon dried dill",
    "1 teaspoon dried basil",
    "1 pinch cayenne pepper",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a frying pan over high heat. Add shrimp, honey, balsamic vinegar, mustard, dill, basil, and cayenne. Stir and season with salt and pepper. Cook until honey and balsamic vinegar start to bubble, about 5 minutes. Cover with a lid; cook, stirring occasionally, until liquid is completely reduced and shrimp are blackened in spots, about 10 minutes.",
