  "title": "Breakfast Casserole",
  "description": "This overnight breakfast casserole with cream of mushroom soup, breakfast sausage, eggs, and Cheddar cheese is a hearty way to start your day.",
  "authors": [
    "Heather Franks"
  ],
  "date_published": "2019-04-02T02:50:55-04:00",
