  "ingredients": [
    "3 tablespoons olive oil",
    "2 pounds sea scallops",
    "2 pounds large shrimp, peeled and deveined",
    "1 pound calamari rings",
    "24 mussels, cleaned and debearded",
    "24 littleneck clams, scrubbed and rinsed",
    "3 (14.5 ounce) cans crushed tomatoes",
    "1 cup water",
    "2 (6.5 ounce) cans chopped clams",
    "0.25 cup olive oil",
    "1 small yellow onion, chopped",
    "2 tablespoons red pepper flakes",
    "1 tablespoon chopped garlic",
    "1 teaspoon dried oregano",
    "1 teaspoon dried parsley",
    "1 teaspoon salt",
    "2 (16 ounce) packages linguine pasta"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DNhpkdd_f5gtQgYY7tU2ZLpWZEo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230551-zuppa-di-pesce-fra-di-avolo-VAT-step-01-31da44f1e49b41e0911093efbac41130.jpg"
      ],
      "image": "assets/images/230551/step_01.webp"
    },
    {
      "text": "Heat 3 tablespoons olive oil in a large skillet over medium heat; cook and stir sea scallops, shrimp, and calamari rings in the hot oil until scallops and calamari are opaque and shrimp are pink, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xp8ZnE-Ns6McnwwhC89bVomVvSU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230551-zuppa-di-pesce-fra-di-avolo-VAT-step-02-043ea8e3d8734457944d0aa152c98de8.jpg"
      ],
      "image": "assets/images/230551/step_02.webp"
    },
    {
      "text": "Bring a separate pot of water to a boil and add mussels and littleneck clams to the boiling water; cook until shells have opened, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FalxjczFWwt3xomeSl5l02cpy0w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230551-zuppa-di-pesce-fra-di-avolo-VAT-step-03-ae3133a078b64fee93e468668259b440.jpg"
      ],
      "image": "assets/images/230551/step_03.webp"
    },
    {
      "text": "Remove shellfish and rinse with hot water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HJaTbepYVIcVaKdzlkfHtNhgn2c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230551-zuppa-di-pesce-fra-di-avolo-VAT-step-04-322d212f87514a16bff9c34d7f460b27.jpg"
      ],
      "image": "assets/images/230551/step_04.webp"
    },
    {
      "text": "Pour crushed tomatoes, water, 2 cans chopped clams, 1/4 cup olive oil, onion, red pepper flakes, garlic, oregano, parsley, and salt into a large pot and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZlHKWhjME5upX4s-Yks95JyFVUI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230551-zuppa-di-pesce-fra-di-avolo-VAT-step-05-0e90b1ffedd646da8c78e27119696c1b.jpg"
      ],
      "image": "assets/images/230551/step_05.webp"
    },
    {
      "text": "Stir cooked scallops, shrimp, calamari, mussels in shells, and littleneck clams in shells into tomato mixture. Reduce heat to low and simmer for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AUKJ-QvE34wAXOlWAR8zlmsOJZM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230551-zuppa-di-pesce-fra-di-avolo-VAT-step-06-b7ccbe931d164cf88256f09a495022d4.jpg"
      ],
      "image": "assets/images/230551/step_06.webp"
    },
    {
      "text": "About 10 minutes before serving, bring a large pot of lightly salted water to a boil; cook the linguine at a boil until tender yet firm to the bite, about 10 minutes; drain and rinse pasta in hot water to prevent sticking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/in0zDassMAmEb5RkyPnkER-JBTY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230551-zuppa-di-pesce-fra-di-avolo-VAT-step-07-0e11251e329b4e6c939bc4f716e2482f.jpg"
      ],
      "image": "assets/images/230551/step_07.webp"
    },
    {
      "text": "Serve seafood and sauce over pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MuygT9QXL8B8ntwuJZS6WFy_OVA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-230551-zuppa-di-pesce-fra-di-avolo-VAT-step-08-bfa20803d3394f59af9ccade3d87b3f0.jpg"
      ],
      "image": "assets/images/230551/step_08.webp"
    }
