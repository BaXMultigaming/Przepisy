  "title": "Red Snapper Livornese",
  "description": "This delicious Italian-inspired livornese recipe features red snapper fillets baked with a zesty tomato, onion, caper, and black olive sauce.",
  "authors": [
    "Ro"
  ],
  "date_published": "2000-04-06T01:32:08-04:00",
