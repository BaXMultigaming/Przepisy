  "ingredients": [
    "1.5 tablespoons fresh lime juice",
    "2 fluid ounces rum",
    "1 tablespoon brown sugar",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon ground clove",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "1 teaspoon black pepper",
    "0.5 teaspoon salt",
    "0.5 teaspoon dried thyme leaves",
    "1 (3 pound) whole chicken",
    "1 tablespoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine the lime juice, rum, and brown sugar; set sauce aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the cayenne pepper, clove, cinnamon, ginger, pepper, salt, and thyme leaves. Brush the chicken with oil, then coat with the spice mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place in a roasting pan, and bake about 90 minutes, until the juices run clear or until a meat thermometer inserted in thickest part of the thigh reaches 180 degrees F. Baste the chicken with the reserved sauce every 20 minutes while it's cooking. Allow chicken to rest for 10 minutes before carving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
