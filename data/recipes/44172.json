  "ingredients": [
    "1.5 pounds ground beef",
    "1 tablespoon Worcestershire sauce",
    "1 (4 ounce) can tomato sauce",
    "0.33333334326744 cup crushed fried pork skins",
    "2 eggs",
    "2.5 tablespoons chili powder",
    "1 tablespoon garlic salt",
    "1 tablespoon garlic pepper seasoning"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together ground beef, Worcestershire sauce, tomato sauce, crushed pork skins, and eggs. Season with chili powder, garlic salt, and garlic pepper. Mix until well blended. Form into a loaf, and place into a greased loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered for 35 to 40 minutes in the preheated oven. Let stand for at least 5 minutes before slicing and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
