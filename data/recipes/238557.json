  "ingredients": [
    "3 hard-boiled eggs, grated",
    "1 ripe avocado, peeled and pitted",
    "0.33333334326744 cup olive oil",
    "2 tablespoons mashed garlic",
    "0.5 teaspoon lemon-pepper seasoning",
    "1 (8 ounce) package shredded cabbage",
    "0.33333334326744 cup Greek yogurt",
    "1 onion, finely chopped",
    "1 cup sunflower seeds, or more to taste",
    "0.75 cup finely chopped broccoli florets",
    "1 tablespoon fresh lemon juice, or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Mash eggs, avocado, olive oil, garlic, and lemon-pepper seasoning together in a bowl until sauce is smooth. Add cabbage and Greek yogurt to sauce and toss until evenly coated. Mix onion, sunflower seeds, and broccoli into cabbage mixture until evenly coated. Mix lemon juice, salt, and pepper into slaw. Cover bowl with plastic wrap and refrigerate until chilled, at least 30 minutes.",
