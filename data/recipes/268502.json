  "ingredients": [
    "10 large jalapeno peppers",
    "1 (8 ounce) package cream cheese, softened",
    "2 tablespoons prepared horseradish",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon paprika",
    "5 slices prosciutto, cut in half lengthwise",
    "0.33333334326744 cup apricot preserves",
    "2 teaspoons water",
    "0.125 teaspoon garlic powder",
    "0.125 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each jalapeno lengthwise. Use a spoon to scrape the seeds and membranes out of the halves. Place jalapeno halves on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, horseradish, garlic powder, and paprika in a small bowl. Stuff jalapeno halves with the mixture. Wrap each jalapeno with a strip of prosciutto.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until peppers are slightly softened and cheese is lightly browned, 15 to 17 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile whisk apricot preserves, water, garlic powder, and red pepper flakes together in a small saucepan over medium heat until thickened. Remove from heat and keep sauce warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place jalapenos on a serving platter and drizzle apricot sauce on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
