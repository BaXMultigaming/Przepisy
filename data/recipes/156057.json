  "ingredients": [
    "2 cups milk",
    "3 large eggs",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "0.125 teaspoon salt",
    "0.75 cup wheat and barley nugget cereal (e.g. Grape-Nuts™)",
    "2 tablespoons butter or margarine, cut into small pieces",
    "0.5 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together milk, eggs, sugar, vanilla, and salt in a large bowl until well combined; pour into a baking dish. Sprinkle with cereal; dot with butter. Gently set the baking dish into a larger baking dish. Pour enough hot water into the larger dish to reach at least 1 inch up the sides of the inner dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Sprinkle with nutmeg to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
