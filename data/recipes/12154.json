  "ingredients": [
    "0.75 cup white sugar, divided",
    "0.33333334326744 cup all-purpose flour",
    "2 cups milk",
    "2 (1 ounce) squares unsweetened chocolate",
    "3 egg yolks, lightly beaten",
    "2 tablespoons butter",
    "1 teaspoon vanilla extract",
    "1 (9 inch) pie shell, baked"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b3rgxWT5OORACUCoJdvBA6fCE-Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12154-chocolate-cream-pie-i-DDMFS-01-14797-c67b34f6053748f7b007ff37ec8d3965.jpg"
      ],
      "image": "assets/images/12154/step_01.webp"
    },
    {
      "text": "Combine 1/2 cup sugar, flour, milk, and chopped chocolate in a 2-quart saucepan. Cook over medium-high heat, stirring constantly, until mixture begins to bubble. Reduce heat; simmer and continue stirring for 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hHl9Ptao08Q7xKd_iBAzZdv5zrs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12154-chocolate-cream-pie-i-DDMFS-02-14800-773bc8d4215e492191784f48ea01be54.jpg"
      ],
      "image": "assets/images/12154/step_02.webp"
    },
    {
      "text": "Remove pan from heat. Whisk remaining 1/4 cup sugar into egg yolks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pbfIJ0H2IMRzMbgzMXUYtKjUijU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12154-chocolate-cream-pie-i-DDMFS-03-14803-4d0b444c4d5b422e9587a8784c7bb3d0.jpg"
      ],
      "image": "assets/images/12154/step_03.webp"
    },
    {
      "text": "Pour the hot milk mixture into the egg yolks in a slow stream, whisking constantly. Return filling mixture to the saucepan and cook over medium heat for an additional 90 seconds, stirring constantly. Remove from heat, and stir in butter and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1EWC9DtMIkkFFgOBPEbygMWZ_60=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12154-chocolate-cream-pie-i-DDMFS-04-14811-48c00819681b432fb6c1053dd120cce0.jpg"
      ],
      "image": "assets/images/12154/step_04.webp"
    },
    {
      "text": "Pour filling into pie shell, and chill until set, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jQzl78xNLWAxFh5AYNhdsPs-kxw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12154-chocolate-cream-pie-i-DDMFS-05-14813-267dd75e18204ba9bd7c2c04275b534e.jpg"
      ],
      "image": "assets/images/12154/step_05.webp"
    },
    {
      "text": "Top with whipped cream and a little grated chocolate before serving. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EdaTcz7uyjboXPGnn-vK1Ru7bbg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12154-chocolate-cream-pie-i-DDMFS-4x3-14890-498a3bb4688e4ea69d6cf668b4101402.jpg"
