  "ingredients": [
    "1 (15 ounce) can sliced beets, drained with liquid reserved",
    "0.5 cup apple cider vinegar",
    "0.5 cup white sugar",
    "6 whole cloves",
    "1 pinch ground cinnamon",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Combine beet liquid, vinegar, sugar, cloves, cinnamon, and salt in a medium saucepan; stir to dissolve sugar, then bring to a boil over medium-high heat. Reduce heat to medium; simmer for 5 minutes. Add beets; simmer 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer beets to a clean jar using tongs; pour cooking liquid over beets to cover. Seal the jar; cool to room temperature. Refrigerate until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
