  "ingredients": [
    "1 tablespoon avocado oil",
    "2 pounds beef sirloin tip roast",
    "1 (28 ounce) can fire-roasted diced tomatoes, drained",
    "1 cup beef broth",
    "3 bell peppers, seeded and sliced into strips",
    "2 onions, sliced",
    "1 (6 ounce) can tomato paste",
    "2 tablespoons minced garlic",
    "1 tablespoon olive oil",
    "1 tablespoon red wine vinegar",
    "1 teaspoon ground cumin",
    "1 teaspoon salt",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Heat avocado oil in a large skillet over medium-high heat. Add roast; sear until brown, about 4 minutes per side. Transfer roast to a slow cooker. Pour tomatoes and beef broth over roast; add bell peppers and onions to slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomato paste, garlic, olive oil, vinegar, cumin, and salt in a bowl; pour over bell peppers and onions. Cover the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 1 hour. Decrease heat to Low; cook until beef is tender enough to shred, about 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer beef to a work surface; shred using 2 forks. Return shredded beef to slow cooker; stir in cilantro. Cover the slow cooker. Cook on Low 1 hour more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
