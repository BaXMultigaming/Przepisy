  "ingredients": [
    "0.5 cup unsalted butter",
    "1 cup crunchy peanut butter",
    "0.25 cup applesauce",
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "4 egg whites",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1.5 teaspoons baking soda"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, peanut butter, applesauce, white sugar, and brown sugar with an electric mixer in a large bowl until smooth. Add eggs and beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking powder, and baking soda in a separate bowl; stir into peanut butter batter. Put batter in refrigerator for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into walnut-sized balls and place 2 inches apart onto ungreased baking sheets. Flatten each ball with a fork, making a crisscross pattern.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until cookies begin to brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
