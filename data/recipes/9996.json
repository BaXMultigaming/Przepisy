  "ingredients": [
    "1 cup packed brown sugar",
    "0.5 cup white sugar",
    "0.5 cup butter, softened",
    "0.5 cup peanut butter",
    "2 eggs",
    "2 tablespoons light corn syrup",
    "2 tablespoons water",
    "2 teaspoons vanilla extract",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups chopped semisweet chocolate"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GXDlh2r2nRG_BGsrnsclSU-1i14=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9996-chewy-peanut-butter-chocolate-chip-cookies-ddmfs-4x3-step-Ingredients-47fe1d79cc734f9cac6592fccf880d84.jpg"
      ],
      "image": "assets/images/9996/step_01.webp"
    },
    {
      "text": "Cream sugars, butter, and peanut butter in a large bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tWG1jovcTnhZEW8fhye7XaArM0Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9996-chewy-peanut-butter-chocolate-chip-cookies-ddmfs-4x3-step-02-0eff991ce967477aba0278a503cb4784.jpg"
      ],
      "image": "assets/images/9996/step_02.webp"
    },
    {
      "text": "Beat in eggs one at a time, then stir in corn syrup, water, and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a14QM7sxyAnxhqs_45NwlVfFc5Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9996-chewy-peanut-butter-chocolate-chip-cookies-ddmfs-4x3-step-03-90c0ffc0c137407d88f4a71308b33e35.jpg"
      ],
      "image": "assets/images/9996/step_03.webp"
    },
    {
      "text": "Combine flour, baking soda, and salt in a separate bowl; stir into peanut butter mixture. Fold in chocolate chunks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g1nDuedxkbBdpkfBrrIQO9oIbGk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9996-chewy-peanut-butter-chocolate-chip-cookies-ddmfs-4x3-step-04-08a1beabd2f441aab983dba18b5b4db8.jpg"
      ],
      "image": "assets/images/9996/step_04.webp"
    },
    {
      "text": "Scoop 1/4-cup portions of dough 3-inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uLjg15K4eqe1tqJyQ485CFrSLvI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9996-chewy-peanut-butter-chocolate-chip-cookies-ddmfs-4x3-step-05-b01fdf7cf1a845f59120bcbb577077e0.jpg"
      ],
      "image": "assets/images/9996/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 12 to 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hPSM8iip9dqfeXs3oRsMky6LpCc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9996-chewy-peanut-butter-chocolate-chip-cookies-ddmfs-4x3-step-06-62be9392b36840fdbb5c3c90edb20ef1.jpg"
      ],
      "image": "assets/images/9996/step_06.webp"
    },
    {
      "text": "Allow cookies to cool for 1 minute before transferring to wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dNzzgeEyacuH-RIfMI4PjWFODBM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9996-chewy-peanut-butter-chocolate-chip-cookies-ddmfs-4x3-614164ea044a4845b3cca7e725ecf7bd.jpg"
