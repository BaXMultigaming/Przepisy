    "0.33333334326744 cup white wine",
    "0.75 cup vegetable stock",
    "1 teaspoon chopped fresh ginger",
    "1 clove garlic, minced",
    "1 small carrot, chopped",
    "0.5 leek, chopped",
    "10 sea scallops, halved",
