  "ingredients": [
    "4 pounds eggplants, peeled and cut into 1/2-inch-thick slices",
    "0.5 teaspoon salt, or to taste",
    "3 medium tomatoes, cubed",
    "0.5 cup chopped fresh parsley",
    "2 tablespoons diced white onion",
    "ground black pepper to taste",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange eggplant slices on a plate and sprinkle both sides with salt. Let sit until juicy, 15 to 20 minutes. Rinse in cold water and pat dry with a paper towel. Place slices on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tender, 20 to 25 minutes, flipping halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove eggplant from the oven and let cool down. Cut into 1/4-inch squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggplant, tomatoes, parsley, and onion in a bowl. Season with salt and pepper and gently mix to combine. Add olive oil and mix again before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
