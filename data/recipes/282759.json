  "title": "Eggplant and Tomato Salad",
  "description": "Tender baked eggplant is mixed with tomatoes, onion, and parsley in this easy and fresh tasting vegetable salad that goes with any main dish.",
  "authors": [
    "aborodenko"
  ],
  "date_published": "2012-02-05T18:37:19-05:00",
