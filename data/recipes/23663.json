  "title": "Western Pound Cake",
  "description": "A pound cake enriched with the addition of grated sweet chocolate and walnuts. Frost with your favorite icing.",
  "authors": [
    "Sheri Ketarkus"
  ],
  "date_published": "2020-06-18T23:05:02-04:00",
