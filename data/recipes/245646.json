  "ingredients": [
    "0.5 cup unsalted butter",
    "0.5 cup brown sugar",
    "0.25 cup heavy whipping cream",
    "1 teaspoon salt",
    "0.75 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Stir butter and brown sugar together in a saucepan over medium heat until melted. Stir in heavy whipping cream and salt; bring to a boil. Reduce heat to medium and simmer until thickened, about 5 minutes. Remove from heat to cool slightly, 3 to 5 minutes. Stir in chopped pecans.",
