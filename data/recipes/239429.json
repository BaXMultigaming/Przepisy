  "ingredients": [
    "1 box brownie mix (for 13” x 9” pan), 18 to 22 ounces",
    "0.25 cup all-purpose flour",
    "1 teaspoon Spice Islands® Pure Vanilla Extract",
    "0.5 teaspoon Spice Islands® Pure Almond Extract",
    "2 eggs",
    "0.25 cup Mazola® Corn Oil",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Combine brownie mix and flour in a mixing bowl. Stir in extracts, eggs and oil; blend thoroughly. Dough will be stiff. Add chocolate chips. Drop by rounded tablespoons onto greased baking sheets. Bake for 10 to 12 minutes; cool on rack.",
