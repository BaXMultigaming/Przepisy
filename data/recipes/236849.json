  "ingredients": [
    "6 tablespoons butter",
    "1 cup firmly packed golden brown sugar",
    "0.33333334326744 cup heavy whipping cream",
    "2 tablespoons light corn syrup",
    "0.5 teaspoon rum-flavored extract"
  ],
  "steps": [
    {
      "text": "Melt butter in a heavy saucepan over medium heat; add brown sugar, cream, and corn syrup. Bring to a boil; cook and stir until sugar dissolves, about 1 minute. Remove saucepan from heat and stir in rum extract. Cool slightly before serving.",
