  "ingredients": [
    "0.25 cup nutritional yeast",
    "0.25 cup all-purpose flour",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion powder",
    "0.125 teaspoon ground yellow mustard",
    "salt to taste",
    "1 cup soy milk",
    "1.5 tablespoons vegan margarine (such as Earth Balance®)"
  ],
  "steps": [
    {
      "text": "Mix nutritional yeast, flour, garlic powder, onion powder, ground mustard, and salt together in a bowl. Pour in soy milk; whisk until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt margarine in a saucepan over medium heat. Pour in soy milk mixture; cook, whisking constantly, until thickened into a sauce, about 5 minutes. Simmer until flavors combine, 1 to 2 minutes more.",
      "section": null,
