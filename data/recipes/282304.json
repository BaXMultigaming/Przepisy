  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "1 (8 ounce) package shredded Swiss cheese",
    "0.5 cup mayonnaise",
    "3 tablespoons yellow mustard",
    "1 (8 ounce) package ham, diced",
    "6 ounces pork, diced",
    "0.33333334326744 cup diced salami",
    "0.25 cup diced dill pickles",
    "3 tablespoons shredded Swiss cheese",
    "2 (8 ounce) loaves Cuban bread"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together cream cheese and 8 ounces Swiss cheese in a large bowl with an electric mixer until well combined. Add mayonnaise and mustard and mix until smooth. Stir in ham, pork, salami, and dill pickles until incorporated. Spoon mixture into an oven-safe dish. Sprinkle 3 tablespoons Swiss cheese over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven's broiler. Broil dip until the top is nicely browned and bubbly, 1 to 2 minutes. Watch closely, so it doesn't burn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice bread into 1/2-inch-thick slices to use as dippers. Serve with hot dip.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
