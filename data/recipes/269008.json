  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place artichokes on a baking sheet. Drizzle with 1 teaspoon olive oil and sprinkle with sea salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven on the top rack until golden, about 25 minutes. Remove from the oven and let cool at least 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While artichokes cool, whisk 3 tablespoons olive oil, lemon juice, oregano, and sea salt to taste together in a large bowl for dressing. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place romaine lettuce in a serving bowl. Add artichokes and feta cheese. Drizzle with dressing and toss to combine.",
