  "ingredients": [
    "1 apple, cored and chopped",
    "0.5 cup crispy rice cereal squares (such as Rice Chex®), crushed",
    "2 teaspoons ground cinnamon",
    "2 teaspoons coconut oil",
    "0.5 cup sliced fresh strawberries",
    "0.25 cup chopped walnuts"
  ],
  "steps": [
    {
