  "ingredients": [
    "1 cup butter",
    "0.75 cup white sugar",
    "3 egg yolks",
    "1 teaspoon almond extract",
    "3 cups cake flour",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the butter and the sugar. Add the 3 beaten egg yolks and one teaspoon of almond extract. Mix until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, mix together the flour, baking powder and salt. Gradually sift into the butter mixture and stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill until firm (2 - 3 hours).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a cookie press, press out cookies onto a cookie sheet. Bake for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
