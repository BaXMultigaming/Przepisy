  "ingredients": [
    "18 ounces ground beef",
    "1 large egg",
    "5 tablespoons oats",
    "0.25 cup diced onion",
    "0.25 cup grated apple",
    "2 tablespoons heavy cream",
    "1 tablespoon pure maple syrup",
    "1 teaspoon minced fresh thyme",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon granulated garlic",
    "4 tablespoons maple syrup",
    "1 tablespoon German stone ground mustard"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, oats, egg, onion, apple, cream, maple syrup, thyme, salt, pepper, and garlic in a bowl; mix until well combined. Roll beef mixture into 1-inch meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together 4 tablespoons maple syrup and mustard in a small bowl and brush meatballs with the glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Turn meatballs over and baste with glaze. Bake until cooked through, about 10 minutes more. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
