  "ingredients": [
    "5 tablespoons butter",
    "0.5 cup minced yellow onion",
    "2.5 teaspoons curry powder",
    "0.5 cup all-purpose flour",
    "1.5 teaspoons white sugar",
    "1.25 teaspoons salt",
    "0.25 teaspoon ground ginger",
    "2 cups milk",
    "1 cup chicken broth",
    "1.5 pounds cooked medium shrimp, shelled and deveined",
    "1 teaspoon lemon juice",
    "4 cups cooked rice"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium heat. Add onion and curry powder; cook and stir until onion is tender, about 5 minutes. Stir in flour, sugar, salt, and ginger until completely incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually stir milk and chicken broth into curry mixture, stirring constantly; cook and stir until hot and thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in shrimp; cook until heated through, 3 to 5 minutes. Stir in lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve shrimp curry over rice; add condiments as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
