  "ingredients": [
    "1.5 pounds Brussels sprouts, ends trimmed and yellow leaves removed",
    "3 tablespoons olive oil",
    "1 teaspoon kosher salt",
    "0.5 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Position a rack in the center of the oven. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bIJu2zKEoPzACJjrWVIG9J8Rx40=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/67952-roasted-brussels-sprouts-DDMFS-Step01-cfe1af4e39ae476e86beba017f4dbf84.jpg"
      ],
      "image": "assets/images/67952/step_01.webp"
    },
    {
      "text": "Place Brussels sprouts, oil, salt, and pepper in a large resealable plastic bag. Seal tightly; shake to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ce3KfgaQT9kuOSK8BvkU--oFD1U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/67952-roasted-brussels-sprouts-DDMFS-Step02-8fbcdd43441e4437af50d704ea847900.jpg"
      ],
      "image": "assets/images/67952/step_02.webp"
    },
    {
      "text": "Arrange on a baking sheet in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j4EoeM0CfCaiKmst1w1lcJtx1_U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/67952-roasted-brussels-sprouts-DDMFS-Step03-bcf6bf39fb8f4da99dd73f51a71555b8.jpg"
      ],
      "image": "assets/images/67952/step_03.webp"
    },
    {
      "text": "Roast in the preheated oven, 30 to 45 minutes, shaking the pan every 5 to 7 minutes for even browning. Reduce the heat as needed to prevent burning. Brussels sprouts should be dark brown and crispy outside. Season with more salt, if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oVnS6--eB0PZC7cxccmFV6xEKQY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/67952-roasted-brussels-sprouts-DDMFS-Step04-db9af81449d2457eb569bdf33a7e42ca.jpg"
