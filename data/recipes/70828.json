  "title": "Blueberry Sour Cream Coffee Cake",
  "description": "This blueberry coffee cake with sour cream, juicy blueberries, cinnamon, and pecans is tender, moist, and buttery—perfect for brunch or holidays.",
  "authors": [
    "d newman"
  ],
  "date_published": "2004-03-20T15:33:46-05:00",
