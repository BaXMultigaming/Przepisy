  "ingredients": [
    "10 radishes, thinly sliced",
    "0.66666668653488 cup white wine vinegar",
    "0.33333334326744 cup water",
    "1 tablespoon white sugar",
    "1 teaspoon salt",
    "1 star anise pod",
    "0.5 teaspoon cumin seed",
    "0.5 teaspoon black peppercorns"
  ],
  "steps": [
    {
      "text": "Place radish slices into a pint-sized jar with a lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vinegar and water in a small non-reactive saucepan over medium heat; whisk in sugar and salt until just dissolved. Remove from heat and add star anise pod, cumin seed, and black peppercorns. Let cool slightly for 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour liquid over radishes. Cover and let cool to room temperature, then refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
