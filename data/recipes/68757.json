  "ingredients": [
    "1 medium onion, chopped",
    "1 pound lean ground lamb",
    "2 tablespoons olive oil",
    "0.5 teaspoon red pepper flakes",
    "0.5 tablespoon dried basil",
    "1 teaspoon cumin",
    "0.125 teaspoon cinnamon",
    "2 large cloves garlic, minced",
    "3.5 tablespoons chili powder",
    "0.5 teaspoon dried oregano",
    "1 teaspoon unsweetened cocoa powder",
    "1 teaspoon white sugar",
    "1 bay leaf",
    "salt and pepper to taste",
    "1 (14.5 ounce) can diced tomatoes with juice",
    "4 cups red beans, with liquid"
  ],
  "steps": [
    {
      "text": "In a large pot, cook onions and ground lamb in olive oil over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When onions are soft and meat browned, season with red pepper flakes, basil, cumin, cinnamon, garlic, chili powder, dried oregano, cocoa powder, sugar, and bay leaf, and salt and pepper to taste. Cook for 1 or 2 minutes. Stir in tomatoes and beans. Increase heat to bring soup to a boil. Reduce heat, and simmer for 15 minutes.",
