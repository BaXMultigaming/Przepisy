  "ingredients": [
    "1 cup butter",
    "1.75 cups sugar",
    "5 egg yolks",
    "3.5 cups all-purpose flour",
    "1 cup milk",
    "2 teaspoons baking powder",
    "5 egg whites",
    "2 tablespoons sweet cocoa"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour one 10 inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream the butter with the sugar. Beat in egg yolks. Continue beating for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually stir in flour, alternating with splashes of milk, until all of the flour and milk are mixed in. Stir in baking powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, beat egg whites. Fold egg whites into batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reserve 1/4 of the batter, and pour the rest into a greased, floured tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cocoa into the remaining 1/4 of the batter. Then turn into tube pan, and fold under with a fork to produce a marbled appearance.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 60 to 70 minutes, or until a toothpick inserted into the center of the cake comes out clean. Let cool in pan for 10 minutes, then turn out onto a wire rack and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
