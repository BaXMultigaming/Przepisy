  "ingredients": [
    "1 cup shredded purple cabbage",
    "0.5 cup shredded carrots",
    "2 squares Land O'Lakes® Teriyaki Saute Express®",
    "1 pound boneless, skinless chicken breasts, cut into strips",
    "0.5 cup cashews",
    "3 green onions, diagonally cut into 1-inch pieces",
    "4 (8 inch) flour tortillas, warmed"
  ],
  "steps": [
    {
      "text": "Combine cabbage and carrots in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt teriyaki squares in a 12-inch nonstick skillet over medium-low heat just until bubbles begin to form. Add chicken; cook, stirring occasionally, until chicken is no longer pink in center, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cashews and green onions; cook and stir until heated through, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1/4 of the chicken mixture onto each tortilla; top with cabbage mixture. Fold 2 opposite sides of tortilla over filling. Starting at an open end, roll up tightly to enclose filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
