  "ingredients": [
    "1 egg",
    "1 tablespoon milk",
    "1 pinch salt and pepper to taste",
    "2 slices white bread",
    "1 slice American cheese"
  ],
  "steps": [
    {
      "text": "Crack egg into a microwave-safe bowl; whisk in milk. Season with salt and black pepper. Microwave at 100% power until cooked through, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, toast bread. Place cooked egg on 1 piece toast; top with cheese slice and remaining piece toast. Microwave until cheese is melted, about 15 seconds.",
