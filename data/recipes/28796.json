  "ingredients": [
    "2 cups rolled oats",
    "0.75 cup white sugar",
    "3 tablespoons unsweetened cocoa powder",
    "1 tablespoon water",
    "0.5 teaspoon vanilla",
    "0.66666698455811 cup butter, softened",
    "1 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "In a large bowl, combine oats, sugar, and cocoa. With clean hands, mix in water, vanilla, and butter to form a dough. Wash hands, then roll dough into balls 1 to 2 inches in diameter. Roll balls in confectioners' sugar until thickly coated (or they will become crusty). Chill 20 minutes before serving.",
