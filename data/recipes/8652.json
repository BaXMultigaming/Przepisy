  "ingredients": [
    "0.25 cup olive oil",
    "2 cloves garlic, crushed",
    "0.25 cup Italian-seasoned bread crumbs",
    "0.25 cup grated Parmesan cheese",
    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil and garlic in a small saucepan over low heat until warmed, 1 to 2 minutes. Pour into a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs and Parmesan cheese in a separate shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use tongs to dip chicken breasts in olive oil-garlic mixture, then coat evenly in bread crumb mixture. Transfer coated chicken to a shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink and juices run clear, 30 to 35 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
