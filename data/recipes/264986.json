  "ingredients": [
    "3 tablespoons butter",
    "3 large eggs",
    "0.75 cup milk, room temperature",
    "0.75 cup flour",
    "1 tablespoon sugar",
    "2 teaspoons vanilla extract",
    "1 pinch salt",
    "2 tablespoons confectioners' sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Place butter in an oven-proof pan or cast iron skillet and place in the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine eggs and milk in a bowl. Add flour, sugar, vanilla, and salt and whisk for 1 minute to remove lumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove hot pan from the oven and swirl melted butter to coat. Pour batter into the hot pan and return it to the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the pancake is puffed in the center and golden brown on the edges, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dust with confectioners' sugar and slice into 8 wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
