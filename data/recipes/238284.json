  "ingredients": [
    "6 cups cold water",
    "2.25 cups dried pinto beans",
    "2 tablespoons butter",
    "0.5 pound bulk pork sausage",
    "2 cups peeled tart apple slices",
    "1.5 cups tomato juice",
    "1 cup chopped onion",
    "0.25 cup brown sugar",
    "2 cloves garlic, mashed",
    "2 teaspoons salt",
    "1 teaspoon chili powder",
    "1 teaspoon dry mustard",
    "0.25 teaspoon coarse black pepper",
    "0.25 cup Jamaican rum",
    "0.25 cup sour cream, for topping"
  ],
  "steps": [
    {
      "text": "Combine cold water and beans in a pot; let stand 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter into the pot with the beans and water; bring to a boil, reduce heat to low, cover the pot, and simmer until beans are tender, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir pork sausage in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and reserve 2 tablespoons sausage drippings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sausage and reserved drippings, apple slices, tomato juice, onion, brown sugar, garlic, salt, chili powder, mustard, and black pepper into beans. Bring bean mixture to a boil, reduce heat to low, cover the pot, and simmer until flavors blend, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rum into beans, ladle beans into bowls, and top with sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
