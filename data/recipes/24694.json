  "ingredients": [
    "3 pounds carrots, chopped",
    "4 eggs",
    "1.5 cups white sugar",
    "1 teaspoon vanilla extract",
    "1.5 teaspoons baking powder",
    "0.33333334326744 cup all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Steam or boil carrots until tender; mash. In an electric mixer with whisk attachment or by hand, beat eggs into carrots, one at a time. Beat in sugar, vanilla and baking powder. Fold in flour. Pour into a 2 quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 30 minutes, until puffed and set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
