  "steps": [
    {
      "text": "Heat picante tomato sauce, water, taco seasoning, Worcestershire sauce, vinegar, sugar, lime juice, onion powder, and garlic powder in a small saucepan over low heat; simmer until fragrant, about 10 minutes.",
