  "ingredients": [
    "1 pound ground beef",
    "1 (1.25 ounce) package taco seasoning",
    "Mazola Pure® Cooking Spray",
    "0.75 cup all-purpose flour",
    "0.5 cup masa corn flour OR corn meal",
    "2 envelopes Fleischmann's® RapidRise Yeast",
    "1 tablespoon sugar",
    "0.5 teaspoon salt",
    "0.75 cup very warm milk (120 degrees F to 130 degrees F)",
    "3 tablespoons Mazola® Corn Oil",
    "1 egg",
    "1 cup chunky salsa",
    "1 cup shredded Mexican-style cheese",
    "1 cup corn chips, partially crushed"
  ],
  "steps": [
    {
      "text": "Brown ground beef and drain. Add taco seasoning and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix batter ingredients together in a pre-sprayed 9-1/2-inch deep dish pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top batter with taco meat filling. Pour salsa evenly over meat; sprinkle with shredded cheese and corn chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake by placing in a COLD oven; set temperature to 350 degrees F. Bake for 30 minutes or until done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
