  "ingredients": [
    "2 pounds skinless, boneless chicken breast halves - cut into bite-size pieces",
    "0.25 cup cornstarch",
    "2 large eggs",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "6 tablespoons all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 cup vegetable oil",
    "0.5 cup chopped green onion",
    "2 tablespoons grated fresh ginger root",
    "4 teaspoons sesame oil",
    "0.5 cup water",
    "0.5 cup white sugar",
    "0.25 cup distilled white vinegar",
    "2 tablespoons cornstarch",
    "2 tablespoons soy sauce",
    "0.25 cup oyster sauce",
    "0.25 cup ketchup"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Bs9gZt-NrJNmsDHmdnALqdT-qso=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/146579-general-tao-chicken-ddmfs-3265-4x3-step-01-2202a7ced13c4cde9aa284ca628a002b.jpg"
      ],
      "image": "assets/images/146579/step_01.webp"
    },
    {
      "text": "Coat chicken pieces with cornstarch in a bowl; set aside. Beat eggs, salt, and pepper in a mixing bowl until combined. Stir in flour and baking powder until no large lumps remain. Mix in chicken pieces until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PIeG9GOrFXFJ-cjE_qVFFlD-Zys=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/146579-general-tao-chicken-ddmfs-3267-4x3-step-02-1f7caade6fe34dd19922a9553124f055.jpg"
      ],
      "image": "assets/images/146579/step_02.webp"
    },
    {
      "text": "Heat vegetable oil in a large skillet or wok over high heat. Cook chicken in hot oil until golden brown and no longer pink on the inside, about 12 minutes. Set chicken aside; keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lFpYWsr47uGwfLk5Loc2EsL8eYw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/146579-general-tao-chicken-ddmfs-3274-4x3-step-02-e5b9af6d99544ec3b9cac8541b6d5bcd.jpg"
      ],
      "image": "assets/images/146579/step_03.webp"
    },
    {
      "text": "Make sauce: Reduce heat to medium-high; add green onion, ginger, and sesame oil to the skillet. Cook and stir until onion is limp and ginger begins to brown, about 1 minute. Pour in water, sugar, and vinegar; bring to a boil",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U-s4JKi7MlRTc4ngLOUrLocznYg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/146579-general-tao-chicken-ddmfs-3270-4x3-step-04-e38a7174e69840f0aa130ad805691322.jpg"
      ],
      "image": "assets/images/146579/step_04.webp"
    },
    {
      "text": "Dissolve cornstarch in soy sauce in a small bowl and stir into vinegar mixture along with oyster sauce and ketchup. Cook until sauce has thickened and is no longer cloudy. Stir in chicken; simmer until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VTM4Yw77blsuT2Zp4ZNr7ehOnI0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/146579-general-tao-chicken-ddmfs-3280-4x3-step-05-16faa73dee8a4a45ae54e68f70c3f174.jpg"
      ],
      "image": "assets/images/146579/step_05.webp"
    }
