  "ingredients": [
    "0.25 cup extra-virgin olive oil",
    "3 tablespoons Meyer lemon juice",
    "1 tablespoon white balsamic vinegar",
    "1 tablespoon freshly grated Parmesan cheese",
    "1 small garlic clove",
    "0.5 teaspoon Meyer lemon zest",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Combine olive oil, Meyer lemon juice, balsamic vinegar, Parmesan cheese, garlic, zest, salt, and pepper in a small blender cup. Blend until dressing is smooth, 30 to 45 seconds.",
