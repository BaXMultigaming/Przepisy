  "ingredients": [
    "0.25 cup mayonnaise",
    "0.25 cup sour cream",
    "0.25 cup crumbled blue cheese",
    "1.5 teaspoons milk",
    "0.5 teaspoon honey mustard",
    "0.5 teaspoon white vinegar",
    "0.5 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon cayenne pepper",
    "2.5 cups penne pasta",
    "2 tablespoons olive oil",
    "1 clove garlic, minced",
    "0.75 teaspoon minced fresh basil",
    "2.5 cups cauliflower florets",
    "2 cups halved cherry tomatoes",
    "0.5 cup chopped red bell pepper",
    "4 ounces mozzarella cheese, cut into 1-inch strips",
    "3 green onions, chopped",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Whisk mayonnaise, sour cream, blue cheese, milk, honey mustard, vinegar, salt, garlic powder, black pepper, and cayenne pepper together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, uncovered, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain; transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a small skillet over medium heat. Add garlic and basil; cook and stir until fragrant, 3 to 4 minutes. Pour garlic mixture over penne.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cauliflower, tomatoes, bell pepper, mozzarella cheese, green onion, and Parmesan cheese to penne mixture. Drizzle salad with dressing; toss to combine and coat. Cover the bowl; refrigerate to blend flavors, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
