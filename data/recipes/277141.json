  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup whole wheat flour",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 cup milk",
    "0.33333334326744 cup vegetable oil",
    "1 egg",
    "0.75 cup semisweet chocolate chips",
    "1 tablespoon all-purpose flour",
    "4 ounces chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup all-purpose flour, whole wheat flour, white sugar, brown sugar, pudding mix, baking powder, and salt in a large bowl. Beat milk, oil, and egg together in a separate bowl. Stir into flour mixture until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat chocolate chips with 1 tablespoon flour and fold into the batter. Fold in pecans. Fill muffin cups 3/4 full of batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into a muffin comes out clean, 18 to 20 minutes. Cool in the tin briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
