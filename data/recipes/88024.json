  "ingredients": [
    "3 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons baking soda",
    "0.25 teaspoon salt",
    "2 cups white sugar",
    "0.25 cup shortening",
    "2 eggs",
    "0.5 teaspoon vanilla extract",
    "0.5 cup chopped walnuts",
    "1.5 cups chopped pitted dates",
    "1.75 cups hot brewed coffee (secret ingredient)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 8x4 inch loaf pans, or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift the flour, baking powder, baking soda and salt into a bowl, and set aside. In a large bowl, mix together the sugar and shortening. Beat in the eggs and vanilla. Toss the walnuts and dates with the dry ingredients, and stir into the sugar mixture alternately with the hot coffee. Divide the batter evenly between the two loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour in the preheated oven, or until a knife inserted in the center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
