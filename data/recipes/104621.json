  "ingredients": [
    "2 pounds steelhead trout fillets",
    "0.25 cup butter, melted",
    "2 tablespoons lemon juice",
    "0.25 teaspoon paprika",
    "0.125 teaspoon cayenne pepper",
    "0.25 cup barbeque sauce"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange trout fillets on a large piece of aluminum foil. Whisk butter, lemon juice, paprika, and cayenne pepper together in a bowl; brush onto fillets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until trout flakes easily with a fork, about 10 minutes; brush fillets with barbecue sauce; cook 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
