  "ingredients": [
    "4 cups water",
    "2 cups brown rice",
    "1 lime, juiced",
    "1 teaspoon minced garlic",
    "1 teaspoon extra-virgin olive oil",
    "1 teaspoon sea salt",
    "0.5 cup chopped fresh cilantro"
