  "ingredients": [
    "1 (12 ounce) bottle horseradish mustard, divided",
    "0.66666668653488 cup bourbon",
    "0.66666668653488 cup dark brown sugar",
    "0.25 cup honey",
    "1 tablespoon liquid hickory smoke flavoring",
    "1 (6 pound) smoked ham, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ⅔ cup horseradish mustard, bourbon, brown sugar, honey, and liquid smoke in a small saucepan; bring to a boil. Reduce heat to medium-low; simmer glaze, stirring frequently, until thickened, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Liberally coat ham with remaining horseradish mustard; place in a roasting pan. Spoon glaze over ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, basting occasionally, until an instant-read thermometer inserted into center of ham reads 160 degrees F (72 degrees C), about 2 hours. (Generally bake 22 minutes per pound.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
