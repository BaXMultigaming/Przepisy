  "ingredients": [
    "1 (15 ounce) can canned pumpkin puree",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "1 teaspoon ground nutmeg",
    "1 (15.25 ounce) package yellow cake mix with pudding",
    "2 large eggs",
    "0.25 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "4 (3 ounce) packages cream cheese, softened",
    "0.5 cup butter, softened",
    "2 cups confectioners' sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk pumpkin, 1 teaspoon cinnamon, cloves, and nutmeg together in a bowl until combined. Combine cake mix, eggs, and oil in a separate bowl until smooth; fold in pumpkin mixture and 1 teaspoon vanilla extract until combined. Transfer batter to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 40 minutes. Transfer to a wire rack; cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat cream cheese and butter together in a bowl with an electric mixer until light and fluffy; beat in confectioners' sugar until smooth. Stir in 1 teaspoon cinnamon and 1 teaspoon vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread frosting over cooled cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
