  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "3 teaspoons ground cinnamon",
    "1 cup milk",
    "1.75 cups packed brown sugar",
    "1.5 cups water",
    "2 tablespoons butter",
    "0.5 cup chopped walnuts",
    "0.75 cup apple - peeled, cored, and chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease the bottom of a 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together flour, sugar, baking powder, salt, and cinnamon. Make a well in the center and pour in milk. Mix well and pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan, combine brown sugar, water, and butter. Bring to a boil and pour over batter in the pan. Sprinkle top with nuts and chopped apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 35 to 40 minutes, or until a toothpick inserted into the center of cake comes out clean. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
