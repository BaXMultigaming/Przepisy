  "ingredients": [
    "1 tablespoon olive oil",
    "1 medium onion, 1/2-inch dice",
    "1 clove garlic, minced",
    "1 (14 ounce) package Hillshire Farm® Smoked Sausage, cut into 1/4-inch slices",
    "1 tablespoon tomato paste",
    "4 cups chicken broth",
    "1 (28 ounce) can diced tomatoes",
    "1 (9 ounce) package fresh cheese tortellini",
    "1 teaspoon salt",
    "0.25 teaspoon pepper",
    "2 cups baby spinach",
    "1 tablespoon Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat. Add onion and garlic; cook until soft, about 5 minutes. Stir in sausage and tomato paste; cook 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add broth, diced tomatoes, tortellini, salt, and black pepper; bring to a boil. Reduce heat; simmer for 5 minutes. Stir in spinach; cook 3 to 4 minutes. Top servings with Parmesan cheese.",
