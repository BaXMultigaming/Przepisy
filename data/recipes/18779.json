  "ingredients": [
    "8 hot dog buns",
    "8 hot dogs",
    "1 (15 ounce) can chili",
    "0.25 cup chopped onion",
    "1 tablespoon prepared mustard",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly grease a 9x13-inch baking dish. Tear up the hot dog buns and arrange the pieces in the bottom of the dish evenly. Slice the hot dogs into bite size pieces and layer the pieces over the buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the chili over the hot dogs, sprinkle with the chopped onion, then spread some mustard over the chili and the onion. Top off with the cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
