  "ingredients": [
    "2 cups flour",
    "3 tablespoons white sugar",
    "4 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon cream of tartar",
    "0.5 cup butter or margarine",
    "0.75 cup milk",
    "0.5 cup shredded Cheddar cheese",
    "1 tablespoon chopped fresh thyme"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking powder, salt, and cream of tartar together in a medium bowl. Cut in butter using a pastry cutter or a fork until pea-sized. Make a well in center of the mixture; add milk, Cheddar cheese, and thyme to the well. Gently stir until a soft dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll or pat dough out on a floured surface to ¾-inch thick; cut into circles and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until biscuit bottoms are golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
