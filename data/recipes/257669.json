  "ingredients": [
    "6 tablespoons water",
    "2 teaspoons powdered unflavored gelatin",
    "1.5 cups milk",
    "3 tablespoons white sugar",
    "2 tablespoons black sesame paste"
  ],
  "steps": [
    {
      "text": "Stir water and gelatin together in a bowl until gelatin dissolves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, sugar, and black sesame paste in a saucepan over medium heat; cook and stir until sugar melts, 2 to 4 minutes. Stir gelatin mixture into milk mixture; cook and stir pudding for 1 to 2 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill pudding in the saucepan at room temperature for 5 minutes. Pour pudding into small bowls and refrigerate until chilled and set, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
