  "ingredients": [
    "1.5 pounds ground beef",
    "1 cup fresh bread crumbs",
    "2 eggs",
    "4 ounces crumbled blue cheese",
    "0.5 cup diced onion",
    "0.25 teaspoon ground black pepper",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a jelly roll pan with aluminum foil.",
