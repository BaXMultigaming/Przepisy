  "ingredients": [
    "1 (12 ounce) package yolk-free egg noodles",
    "0.5 cup sweet butter, cut into pieces",
    "1 (16 ounce) container creamed cottage cheese",
    "1 pint sour cream",
    "0.5 cup white sugar",
    "0.5 cup raisins",
    "2 large eggs, slightly beaten",
    "2 tablespoons vanilla extract",
    "0.25 cup brown sugar",
    "0.25 cup crushed cornflakes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 10 to 12 minutes. Drain and return to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter with hot noodles. Stir in cottage cheese, sour cream, sugar, raisins, eggs, and vanilla. Transfer mixture to the prepared baking dish. Mix brown sugar and crushed cornflakes together and sprinkle over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
