  "ingredients": [
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "2 cups dry bread stuffing mix",
    "3 eggs, beaten",
    "0.25 cup grated Parmesan cheese",
    "0.5 onion, chopped",
    "2 tablespoons melted butter",
    "0.25 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix together chopped spinach, dry bread stuffing mix, eggs, Parmesan cheese, onion, butter and Cheddar cheese. Cover and chill in the refrigerator approximately 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop the mixture by rounded spoonfuls onto a lightly greased large baking sheet. Place baking sheet in the freezer approximately 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to bake, allow the balls to partially thaw, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake the balls in the preheated oven 20 to 25 minutes, or until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
