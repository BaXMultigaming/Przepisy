  "ingredients": [
    "0.75 cup mashed ripe bananas",
    "0.5 cup sugar",
    "0.25 cup Almond Breeze Vanilla almondmilk",
    "3 tablespoons vegetable oil",
    "1 teaspoon almond extract",
    "1 egg",
    "0.75 cup all-purpose flour",
    "0.5 cup lightly packed fine almond flour",
    "0.75 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.25 cup Blue Diamond Honey Roasted Almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F and coat 2 mini loaf pans with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together bananas, sugar, Almond Breeze, oil, extract, and egg in a large bowl. Stir together dry ingredients and add to banana mixture, stirring just until dry ingredients are incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon equal amounts into prepared pans and bake for 40 minutes or until a toothpick inserted into the center comes out clean. Let cool before removing from pans. Makes 8 servings.",
