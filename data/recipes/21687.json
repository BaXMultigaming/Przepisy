  "ingredients": [
    "1.75 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground nutmeg",
    "0.33300000429153 cup vegetable oil",
    "0.75 cup white sugar",
    "1 egg",
    "0.75 cup milk",
    "0.75 cup white sugar",
    "1 teaspoon ground cinnamon",
    "0.5 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine flour, baking powder, salt and nutmeg. In a separate bowl, beat together oil, 3/4 cup sugar, egg and milk. Stir egg mixture into flour mixture, just until moistened. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 to 25 minutes, until a toothpick inserted into a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While muffins are baking, mix together 3/4 cup white sugar and 1 teaspoon cinnamon. While muffins are still hot, dip tops in melted butter and then in cinnamon sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
