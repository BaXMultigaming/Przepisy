  "ingredients": [
    "8 ears fresh corn",
    "1 stick butter, softened",
    "1 fluid ounce bourbon whiskey",
    "0.125 teaspoon ground cinnamon",
    "wood chips, soaked",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Pull corn husks back to remove and discard the silk. Pull husks back over the corn. Soak corn in a pot of water for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a small dish. Add bourbon and cinnamon and carefully mix with a fork until well incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the smoker to 225 degrees F (110 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place corn, unstacked, onto wire racks. Place the racks into the smoker. Add wood chips according to manufacturer's directions. Smoke until corn is tender, turning halfway through, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pull husks off corn and spread the bourbon butter over corn. Sprinkle with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
