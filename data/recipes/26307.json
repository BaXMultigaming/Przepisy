  "ingredients": [
    "0.75 pound ground beef",
    "2 packets dry spaghetti sauce mix",
    "1 (1 ounce) package dry mushroom gravy mix",
    "2 (6 ounce) cans tomato paste",
    "4 cups water",
    "2 tablespoons vegetable oil",
    "1 (16 ounce) package lasagna noodles",
    "1 (16 ounce) package mozzarella cheese, shredded"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ground beef in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan over medium-high heat, combine spaghetti sauce mix, mushroom gravy mix, tomato paste, water and oil. Bring to a boil and stir in ground beef. Reduce heat and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 9x13 inch baking dish layer the noodles, sauce and cheese; repeat layers, ending with cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
