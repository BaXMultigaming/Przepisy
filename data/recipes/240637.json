  "ingredients": [
    "1.25 cups all-purpose flour",
    "0.25 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon ground nutmeg",
    "0.5 cup very thick eggnog",
    "0.5 cup milk",
    "1 egg, beaten",
    "1 tablespoon oil"
  ],
  "steps": [
    {
      "text": "Sift and stir flour, sugar, baking powder, and nutmeg together in a bowl. Whisk eggnog, milk, egg, and oil together in a separate bowl. Pour eggnog mixture into flour mixture and stir until batter is moistened and slightly lumpy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle over medium-high heat, about 350 degrees F (175 degrees C). Drop batter by large spoonfuls onto the griddle and cook until bubbles form and the edges are dry, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
