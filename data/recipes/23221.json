  "ingredients": [
    "10 country style pork ribs",
    "2 teaspoons minced garlic",
    "1 medium lemon, thinly sliced",
    "1 (18 ounce) bottle barbeque sauce"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kuzJ4x8OCt2jkNIQBd9RWIsKUD0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23221-BBQ-Country-Style-Ribs-ddmfs-Step-1-d61c90f39ade48b0acdf3ee924ad281b.jpg"
      ],
      "image": "assets/images/23221/step_01.webp"
    },
    {
      "text": "Place ribs in a single layer in a shallow baking pan or roaster; salt if desired. Spread garlic on ribs, then arrange lemon slices on top. Bake in the preheated oven until tender, about 2 hours, covering the pan with foil after 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tKtbIiIYTyacGe7R_6k1lOnY9CI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23221-BBQ-country-Style-ribs-ddmfs-step-3-8da77b96047f41b78e4961796a7085b7.jpg"
      ],
      "image": "assets/images/23221/step_02.webp"
    },
    {
      "text": "Drain any grease and liquid; pour barbecue sauce over ribs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NhbK5-VnoKzfpx66CrvxA9wjuW4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23221-BBQ-country-Style-ribs-ddmfs-step-4-1-6311caa4775946de8be1be42891112ef.jpg"
      ],
      "image": "assets/images/23221/step_03.webp"
    },
    {
      "text": "Reduce oven temperature to 225 degrees F (110 degrees C) and cook ribs, uncovered, until sauce bakes into meat, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5UX0JA8I_T2edM8RvznqHSi39Eo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-23221-BBQ-Country-Style-Ribs-ddmfs-4x3-0b3710467d384cd184c7559d413ca9e4.jpg"
      ],
      "image": "assets/images/23221/step_04.webp"
    }
