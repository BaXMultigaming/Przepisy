  "ingredients": [
    "2 (10 ounce) chicken breast, bone-in, with skin, raw",
    "1 (15 ounce) can whole kernel corn, drained",
    "1 (15 ounce) can black beans, rinsed and drained",
    "2 cups salsa",
    "2 cups brown rice",
    "1 (8 ounce) package cream cheese, softened"
  ],
  "steps": [
