  "ingredients": [
    "0.33333334326744 cup coconut oil",
    "0.25 cup brown sugar",
    "0.25 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup milk chocolate chips",
    "0.25 cup old-fashioned oats"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine coconut oil, brown sugar, and white sugar in a large bowl; beat with an electric mixer until creamy. Beat in egg and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, and salt together in a bowl. Gradually beat into the coconut oil mixture until just blended. Fold chocolate chips and oats into the dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll 2 tablespoons of dough into a ball. Place on the prepared baking sheet. Repeat with remaining dough, spacing balls about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are golden on the bottom, 12 to 14 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
