  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves",
    "1 (20 ounce) can apple pie filling",
    "2 eggs",
    "0.5 cup vegetable oil",
    "1.5 teaspoons vanilla extract",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 10-inch fluted tube pan (such as a Bundt®).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking soda, cinnamon, salt, nutmeg, and cloves in a bowl until thoroughly combined. Mix apple pie filling, eggs, vegetable oil, and vanilla extract into dry ingredients to make a batter; stir in walnuts. Pour batter into prepared tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cake is lightly browned and a toothpick inserted into the middle comes out clean or with moist crumbs, about 1 hour. Cool cake thoroughly in pan, at least 1 hour, before removing pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
