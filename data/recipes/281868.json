  "ingredients": [
    "1 (2 1/2 pound) boneless beef chuck roast",
    "1 pinch garlic salt, or to taste",
    "ground black pepper to taste",
    "3 tablespoons Worcestershire sauce",
    "3 tablespoons soy sauce",
    "1 tablespoon red wine vinegar",
    "0.5 (1 ounce) package dry onion soup mix",
    "1.5 cups water",
    "1 tablespoon cornstarch, or as needed"
  ],
  "steps": [
    {
      "text": "Rub beef roast with garlic salt and black pepper. Place roast in the bottom of a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together Worcestershire, soy sauce, and red wine vinegar in a small bowl; pour over roast. Sprinkle onion soup mix over roast. Pour water into the slow cooker around roast, not over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until no longer pink in the center and meat is fork tender, 4 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer sauce from the slow cooker into a saucepan. Warm over medium heat until bubbling, then mix in cornstarch to thicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
