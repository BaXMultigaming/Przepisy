  "ingredients": [
    "2 tablespoons olive oil",
    "1 small onion, finely diced",
    "2 cloves garlic, minced",
    "1 small red bell pepper, diced",
    "1 small tomato, diced",
    "3 cups riced cauliflower",
    "0.5 cup vegetable broth",
    "1 tablespoon tomato paste",
    "1 teaspoon cumin",
    "1 teaspoon paprika",
    "0.5 teaspoon dried oregano",
    "0.25 teaspoon ancho chile powder",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Add onion and cook until translucent, about 3 minutes. Add garlic and cook 2 minutes more. Add red belle pepper and tomato. Cook another 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cauliflower rice, broth, tomato paste, cumin, paprika, oregano, and ancho chile powder to the skillet. Stir to combine and cook about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Taste and adjust seasoning if desired. Cook until cauliflower still has a bite and is not mushy, 3 to 5 minutes more. Season with salt and pepper before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
