  "ingredients": [
    "0.25 cup vegetable oil",
    "0.25 cup New Mexico or California chili powder",
    "2 tablespoons self-rising flour",
    "1.5 cups water",
    "1 (8 ounce) can tomato sauce",
    "0.25 teaspoon ground cumin",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion salt",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium-high heat. Stir in chili powder and flour, reduce heat to medium, and cook until fragrant and deepened in color, stirring constantly to prevent the flour from burning, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wRw7EGVa4JibeqWYhGFnO__rWXU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/61727-TenMinuteEnchiladaSauce-Step1--0632-47b555967192424a841af47e958849e6.jpg"
      ],
      "image": "assets/images/61727/step_01.webp"
    },
    {
      "text": "Gradually stir in water, tomato sauce, cumin, garlic powder, and onion salt until smooth. Continue cooking over medium heat until thickened slightly, about 10 minutes. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
