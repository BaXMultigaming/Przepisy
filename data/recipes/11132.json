  "ingredients": [
    "2 cups melted butter",
    "6 cups graham cracker crumbs",
    "3 (14 ounce) cans sweetened condensed milk",
    "3 cups semisweet chocolate chips",
    "3.6666700839996 cups flaked coconut",
    "2.5 cups chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the graham cracker crumbs and melted butter, mix well an press mixture into the bottom of one 18x26 inch pan. Pour the sweetened condensed milk over the crust. Layer the chocolate chips, coconut and nuts on top. Press down gently into the \"goo\".",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 25 to 30 minutes or until lightly brown. Let cookies cool completely before cutting into 2x2 inch squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
