  "ingredients": [
    "0.5 cup unsalted butter, softened",
    "2 teaspoons truffle oil",
    "0.125 truffle, thinly shaved",
    "sea salt to taste",
    "4 (6 ounce) New York strip steaks",
    "sea salt and ground black pepper to taste",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Make the truffle butter: Mix butter, truffle oil, shaved truffle, and sea salt together in a bowl. Cover and refrigerate for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When ready to cook the steaks, place a baking pan in the oven and preheat to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season steaks with sea salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a heavy skillet over medium-high heat until shimmering. Add steaks, working in batches if necessary, and sear until browned, about 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the hot baking pan from the oven; place seared steaks into the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until steaks are firm and reddish-pink and juicy in the center, 8 to 10 minutes. An instant-read thermometer inserted into the center should read 130 degrees F (54 degrees C) for medium-rare.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let steaks rest for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To serve, dab 1 tablespoon truffle butter on top of each steak.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
