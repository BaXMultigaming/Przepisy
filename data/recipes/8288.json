  "title": "Chocolate Chip Coffee Cake",
  "description": "Made extra moist with sour cream, this cinnamon-spiced chocolate chip coffee cake is lovely for a weekend brunch or afternoon snack.",
  "authors": [
    "Kerrilyn Blood"
  ],
  "date_published": "1999-07-06T15:16:59-04:00",
