  "ingredients": [
    "2.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 cup semisweet chocolate chips",
    "1.5 cups white sugar, divided",
    "1 teaspoon ground cinnamon",
    "0.5 cup butter, softened",
    "2 large eggs",
    "1 cup sour cream",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, baking powder, and baking soda together in a medium bowl. Combine chocolate chips, 1/2 cup sugar, and cinnamon in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream remaining 1 cup sugar and butter in a large bowl with an electric mixer. Mix in eggs, sour cream, and vanilla until well combined. Mix in flour mixture until incorporated; batter will be thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1/2 of the batter into the prepared pan. Sprinkle 1/2 of the chocolate chip mixture over top. Repeat layers once more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted near the center comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and place onto a wire rack to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
