  "ingredients": [
    "4 potatoes, peeled and cut into 1 inch cubes",
    "1 onion, chopped",
    "2 green bell peppers, cut into 1 inch pieces",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon black pepper",
    "0.25 cup vegetable oil",
    "1 (16 ounce) package kielbasa sausage, cut into 1 inch pieces"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook onions and potatoes for 15 minutes, stirring occasionally. Reduce flame to med and stir in bell pepper, onion powder, garlic powder, salt and pepper. Cover, and cook 5 minutes. Stir in kielbasa, cover, and cook for 15 minutes, or until onions are caramelized.",
