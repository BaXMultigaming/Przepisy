  "ingredients": [
    "0.5 cup rolled oats",
    "0.75 cup all-purpose flour",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.25 cup butter",
    "2 teaspoons honey",
    "0.25 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grind oats until fine using a blender or food processor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the blended oats, flour, baking soda and salt. Cut in the butter using a pastry blender or your fingers until the butter lumps are smaller than peas. Stir in the buttermilk and honey to form a stiff dough. On a lightly floured surface, roll the dough out to 1/8 inch in thickness. Cut into desired shapes with cookie cutters. Place cookies 1 inch apart onto cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 5 to 7 minutes in the preheated oven, until edges are lightly browned. Remove from cookie sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
