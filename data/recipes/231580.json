  "ingredients": [
    "2 (21 ounce) cans apple pie filling, coarsely chopped",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 (8 ounce) package reduced-fat cream cheese",
    "0.5 cup confectioners' sugar",
    "10 small flour tortillas",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "0.33333334326744 cup water",
    "0.33333334326744 cup butter",
    "1 tablespoon cornstarch",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C) with rack in top position.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apple pie filling, 1 teaspoon cinnamon, and nutmeg in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, confectioners' sugar, and ¼ teaspoon cinnamon in a separate bowl until whipped and smooth; stir in apple pie mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide filling among tortillas; roll tortillas around filling. Arrange rolled tortillas, seam-sides down, in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, brown sugar, water, butter, cornstarch, and vanilla extract in a saucepan; bring to a boil. Reduce heat and simmer, stirring constantly, until sugar is dissolved, about 3 minutes. Spread sauce over rolled tortillas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until enchiladas are bubbling, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
