  "ingredients": [
    "5 pounds new red potatoes",
    "3 pounds kielbasa sausage, cut into 1 inch pieces",
    "1 (8 fluid ounce) bottle liquid shrimp and crab boil seasoning",
    "salt to taste",
    "12 ears fresh corn",
    "4 lemons, halved",
    "1 tablespoon diced green chile pepper, or to taste",
    "10 pounds medium shrimp - peeled and deveined",
    "12 blue crabs, cleaned"
  ],
  "steps": [
    {
      "text": "Fill a large, 40-quart pot half full with water; bring water to a full boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add potatoes, sausage, shellfish boil seasoning, and salt. Cook until potatoes are halfway cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MfuGpg8H16NrtFADtaBg5VM7apI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17153-seafood-boil-ddmfs-step-3-27-8b9fa00c175c463183c139de05b15279.jpg"
      ],
      "image": "assets/images/17153/step_02.webp"
    },
    {
      "text": "Stir in corn, lemons, and chile pepper; continue boiling until vegetables are tender. Turn off heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6cHIQ4yMb5i3vMhOAdQgA5HSVTE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17153-seafood-boil-ddmfs-step-4-28-e1acc20f776044ca9491b9e8fbcde080.jpg"
      ],
      "image": "assets/images/17153/step_03.webp"
    },
    {
      "text": "Mix in shrimp and crab. Cover the pot and let sit until shrimp are pink and crabmeat is opaque and flaky, 10 to 15 minutes. Remove vegetables and shellfish from the pot; drain well. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
