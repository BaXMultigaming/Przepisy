  "ingredients": [
    "3 large ripe tomatoes, quartered",
    "3 tablespoons olive oil",
    "salt and freshly ground black pepper to taste",
    "6 eggs, beaten"
  ],
  "steps": [
    {
      "text": "Place tomatoes into a food processor; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium-high heat. Stir in tomatoes, salt, and pepper; cook and stir until all liquid has evaporated from the tomatoes, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium. Add eggs; cook, stirring constantly, until mixture is evenly dry and no large chunks remain, 7 to 10 minutes.",
