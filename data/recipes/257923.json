  "ingredients": [
    "1 cup milk",
    "1.75 ounces fresh yeast",
    "1 egg",
    "3.3333332538605 tablespoons olive oil",
    "1.5 tablespoons white sugar",
    "1 teaspoon salt",
    "4.3333334922791 cups all-purpose flour, or as needed",
    "2 small carrots, grated",
    "5.5 tablespoons sunflower seeds",
    "1 tablespoon milk, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm 1 cup milk in a large saucepan over low heat until it reaches room temperature, 3 to 5 minutes. Remove from heat and mix in yeast until dissolved. Mix in egg, olive oil, sugar, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir half of the flour into the saucepan. Add carrots and sunflower seeds. Stir in remaining flour until dough is sticky. Cover and let rise in a warm place for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into 12 pieces; roll into small buns. Arrange buns on the prepared baking sheet. Cover and let rise until puffy, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush tops of buns with 1 tablespoon milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 15 to 17 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
