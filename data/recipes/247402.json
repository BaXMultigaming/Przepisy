  "ingredients": [
    "1 teaspoon Dijon mustard",
    "2 teaspoons lime juice",
    "1 teaspoon lime zest",
    "0.5 teaspoon sugar",
    "2 tablespoons olive oil",
    "Salt and ground black pepper",
    "1 (5 ounce) can solid white albacore tuna in water, drained and chunked",
    "2 tablespoons chopped Roma tomatoes",
    "1.5 tablespoons chopped red onion",
    "1 tablespoon peeled, seeded, and chopped cucumber",
    "1 tablespoon chopped fresh parsley",
    "1 teaspoon capers, drained",
    "8 Original Snack Factory® Pretzel Crisps®",
    "8 slices pitted kalamata olives",
    "Crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Stir Dijon mustard, lime juice, lime zest, and sugar together in a bowl. Gradually whisk in olive oil; whisk until dressing thickens slightly. Stir in the salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the tuna in a bowl. Lightly fold in tomatoes, red onion, cucumber, parsley, and capers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle dressing over the tuna mixture. Stir gently, trying not to break the tuna into small pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a spoonful of tuna onto a pretzel crisp, top with 2 olive slices, and sprinkle with some crumbled feta cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
