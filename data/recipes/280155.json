  "ingredients": [
    "1 cooking spray",
    "8 slices cinnamon bread",
    "2 Golden Delicious apples - peeled, cored, and chopped",
    "4 large eggs, lightly whisked",
    "1 cup half-and-half",
    "0.5 cup milk",
    "1 tablespoon white sugar",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.5 cup unsalted butter, at room temperature",
    "0.5 cup packed light brown sugar",
    "0.5 cup chopped pecans",
    "2 tablespoons maple syrup",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Spray an 8x8-inch baking dish with cooking spray to coat. Layer 4 slices bread on the bottom of the baking dish; sprinkle with 1/2 of the apples. Repeat layers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, half-and-half, milk, sugar, vanilla extract, cinnamon, and nutmeg in a bowl. Mix well. Pour over the bread. Cover with foil and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pull out of the refrigerator 1 hour before baking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Mix butter, brown sugar, pecans, maple syrup, cinnamon, and nutmeg together in a bowl. Spread over the top layer of apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
