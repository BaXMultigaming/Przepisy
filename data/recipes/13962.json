  "ingredients": [
    "1 head fresh broccoli, cut into florets",
    "1 head cauliflower, broken into small florets",
    "1 pound carrots, coarsely chopped",
    "0.5 pound fresh lima beans, cut into bite-sized pieces",
    "0.75 pound yellow wax beans, cut into bite-sized pieces",
    "1 zucchini, chopped",
    "5 onions, chopped",
    "6 cloves garlic, minced",
    "2 tablespoons butter",
    "6 ounces shredded Cheddar cheese",
    "1.5 cups chopped walnuts"
  ],
  "steps": [
    {
      "text": "In a medium saute pan, melt butter or margarine over medium heat. Add onions and garlic; cook and stir until translucent.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread broccoli, cauliflower, carrots, lima beans, yellow wax beans, and zucchini in a large baking dish. Sprinkle with walnuts and shredded cheese. Arrange sauteed onions over cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) until vegetables are tender and cheese melts, approximately 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
