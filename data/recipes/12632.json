  "ingredients": [
    "4 eggs, beaten",
    "0.25 cup butter",
    "0.5 cup self-rising flour",
    "1 teaspoon vanilla extract",
    "1.75 cups white sugar",
    "2 cups milk",
    "7 ounces flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine eggs, butter or margarine, flour, vanilla, sugar, milk and coconut. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into 10 inch deep dish pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C) for 30 to 40 minutes. Crust will form on the bottom.",
      "section": null,
