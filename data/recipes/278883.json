  "ingredients": [
    "1 cup unsalted butter",
    "1.5 cups white sugar",
    "1 egg",
    "2 cups all-purpose flour",
    "1 cup cocoa powder (such as Hershey's®)",
    "1 teaspoon baking soda",
    "1 pinch salt",
    "0.75 cup water",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, sugar, and egg in a bowl. Beat with an electric mixer until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, cocoa powder, baking soda, and salt together. Add to the butter mixture, 1 cup at a time, until evenly incorporated. Gradually beat in water, then vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of the cookie dough onto the prepared baking sheets. Press gently to flatten the mounds of dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm, about 20 minutes. Cool for 3 minutes before removing from the baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
