  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "2 cups chicken stock",
    "2 cloves garlic, crushed",
    "0.5 small onion, finely chopped",
    "1 cup white wine",
    "1 (8 ounce) package sliced fresh mushrooms",
    "1 (10 ounce) can artichoke hearts, drained",
    "1 cup heavy cream",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in a 9x13 inch baking dish. Bake for 25 to 30 minutes, or until chicken is no longer pink and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the chicken is baking, place the chicken stock, garlic, and onion in a medium saucepan. Bring to a boil, and cook until liquid is reduced by half. Stir in wine, and continue to cook until reduced and slightly thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the mushrooms and artichokes to the chicken stock mixture. Reduce heat, and simmer until mushrooms are tender. Stir in the heavy cream, and cook, stirring occasionally, until thickened. Season with salt and pepper, and serve over the baked chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
