  "ingredients": [
    "2 flour tortilla (6 inch)",
    "1 tablespoon extra-virgin olive oil",
    "2 tablespoons pizza sauce, divided",
    "0.5 cup shredded mozzarella cheese, divided",
    "0.25 cup sliced pepperoni",
    "0.125 teaspoon dried oregano"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 400°F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush one side of each tortilla lightly with olive oil. Be sure to get all the way to the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1 tablespoon sauce over the middle of one tortilla, then top with ¼ cup cheese. Cover with second tortilla and repeat with the remaining sauce and cheese. Top with pepperoni and oregano.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly brush the air fryer basket with any remaining olive oil and transfer the pizza to the air fryer basket. Cook 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully remove the pizza with a spatula and let cool slightly before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
