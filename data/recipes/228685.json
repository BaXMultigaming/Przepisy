  "ingredients": [
    "4 sweet potatoes, cut into chunks",
    "1.3333333730698 cups white sugar",
    "0.75 cup milk",
    "3 eggs, beaten",
    "0.75 teaspoon salt",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "1.5 cups brown sugar",
    "1.5 cups chopped pecans",
    "0.75 cup all-purpose flour",
    "0.5 cup margarine, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350°F (175°C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover sweet potatoes with water in a large pot; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain and transfer potatoes to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash potatoes with white sugar, milk, eggs, salt, vanilla extract, and cinnamon. Spread mixture in prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, pecans, and flour in another bowl. Pour margarine over pecan mixture; toss until mixture resembles coarse crumbs. Sprinkle over potato mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven until pecan topping is hard, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
