  "ingredients": [
    "3 eggs",
    "1 egg yolk",
    "1 cup sugar",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "0.5 teaspoon nutmeg",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground cloves",
    "2 cups Original or Vanilla Unsweetened Almond Breeze Almondmilk",
    "2 cups pumpkin puree",
    "1 (9 inch) unbaked pie shell"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine eggs, egg yolk, sugar, cinnamon, salt, nutmeg, ginger and ground cloves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually stir in Original or Vanilla Almond Breeze, then stir in pumpkin puree.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour filling into premade pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 50 to 55 minutes or until filling is set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
