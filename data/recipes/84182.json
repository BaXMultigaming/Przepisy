  "ingredients": [
    "2 cloves garlic, minced",
    "2 serrano peppers, finely chopped",
    "2 tablespoons minced fresh ginger root",
    "0.5 cup chopped fresh cilantro",
    "2 teaspoons grated lime zest",
    "2 tablespoons soy sauce",
    "1 tablespoon white sugar",
    "0.75 cup unsweetened coconut milk",
    "4 boneless, skinless chicken thighs"
  ],
  "steps": [
    {
      "text": "In a blender or large food processor, combine the garlic, serrano peppers, ginger, cilantro, lime zest, soy sauce, sugar and coconut milk. Process until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the chicken into a large resealable bag, and pour the liquid from the blender in with it. Seal, and refrigerate for about 1 hour, turning once after 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven's broiler. Place the chicken onto a broiling pan, and pour the marinade into a saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil the chicken for about 10 minutes on each side, until browned and the juices run clear. While the chicken is cooking, bring the marinade to a boil. Simmer over medium heat for about 5 minutes, then remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken onto a serving plate, and pour the sauce over it to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
