  "ingredients": [
    "0.33333334326744 cup flaxseed meal",
    "0.33333334326744 cup water",
    "1 cup butter",
    "1 cup white sugar",
    "1 cup brown sugar",
    "1 tablespoon coconut oil",
    "2 eggs",
    "1.5 tablespoons vanilla extract",
    "0.33333334326744 cup brewers' yeast",
    "1 tablespoon Himalayan pink salt",
    "1 teaspoon baking soda",
    "2.5 cups all-purpose flour",
    "3 cups steel-cut oats",
    "1.5 cups miniature semisweet chocolate chips",
    "1 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flaxseed meal and water together in a bowl; let sit for 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, brown sugar, and coconut oil into the flaxseed mixture using an electric mixer until a dough forms. Add eggs and mix well. Pour in vanilla extract and mix to combine. Beat in brewer's yeast, pink salt, and baking soda. Add in flour a little at a time on low speed. Stir in oats, chocolate chips, and cranberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop cookies onto a baking sheet, flattening a little so they are not balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set and golden, about 12 minutes. Remove from the oven and let cool 10 minutes before transferring to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
