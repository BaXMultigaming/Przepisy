  "ingredients": [
    "1 (8 ounce) bone-in fully cooked ham steak",
    "5 tablespoons butter, cubed",
    "5 tablespoons brown sugar"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sm9b0u5fLbr6cc2MMEH3PgbnGSM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-236432-brown-sugar-ham-steak-ddmfs-4x3-ingredients-b2a10e9255d44aa6b17c52f24ad3becc.jpg"
      ],
      "image": "assets/images/236432/step_01.webp"
    },
    {
      "text": "Cook ham steak in a large skillet over medium heat until browned, 3 to 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EkI5ntFdVT6CWEA8AfQbqz3KlJg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-236432-brown-sugar-ham-steak-ddmfs-4x3-step-01-300ea5b654164422b2d3ac65b1813711.jpg"
      ],
      "image": "assets/images/236432/step_02.webp"
    },
    {
      "text": "Remove ham from skillet; drain off any fat. Melt butter in the same skillet over medium-low heat. Stir in brown sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5I9gY0ki7hoWCg_wOvMF8c1qHxw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-236432-brown-sugar-ham-steak-ddmfs-4x3-step-02-2365d09fcf0b4d21b43c047cf418fcfe.jpg"
      ],
      "image": "assets/images/236432/step_03.webp"
    },
    {
      "text": "Return ham to skillet. Cook, turning ham often, until heated through and brown sugar has dissolved, about 10 minutes. Reduce heat if brown sugar/butter mixture starts to pop or splatter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6mONGgU2Uy-2DyQCNG1H25-lrUo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-236432-brown-sugar-ham-steak-ddmfs-4x3-step-03-63768a94998f4c869849c0d25513e780.jpg"
      ],
      "image": "assets/images/236432/step_04.webp"
    },
    {
      "text": "Serve and enjoy!",
