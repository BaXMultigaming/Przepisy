  "ingredients": [
    "0.33333334326744 cup butter, softened",
    "0.33333334326744 cup packed brown sugar",
    "1 cup sifted all-purpose flour",
    "0.33333331346512 cup chopped walnuts",
    "8 ounces cream cheese",
    "0.25 cup white sugar",
    "1 egg",
    "2 tablespoons milk",
    "1 tablespoon lemon juice",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the crust: Beat butter and brown sugar together in a large bowl with an electric mixer until light and fluffy. Add flour and chopped nuts; stir until mixture becomes crumbly. Set aside 1/4 cup to use as a topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press mixture into an 8-inch square pan. Bake in the preheated oven for 12 to 15 minutes. Let cool on a rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the filling: Beat cream cheese and white sugar together in a large bowl with an electric mixer until smooth. Stir in egg, milk, lemon juice, and vanilla until well combined. Spread filling mixture over baked crust. Sprinkle reserved mixture on as a topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges are puffed and the surface is firm, about 25 to 30 minutes. Let cool on a wire rack before refrigerating until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
