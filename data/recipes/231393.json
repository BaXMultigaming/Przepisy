  "ingredients": [
    "3 large eggs",
    "1 cup sifted all-purpose flour",
    "0.5 cup milk",
    "3 tablespoons baking powder",
    "2 tablespoons vegetable oil",
    "2 large ripe bananas, mashed",
    "1 ripe banana, sliced",
    "0.75 cup maple syrup, warmed - or to taste"
  ],
  "steps": [
    {
      "text": "Preheat a griddle to medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a mixing bowl until frothy, about 2 minutes. Add flour, milk, baking powder, and vegetable oil to the eggs and mix to make a batter. Stir mashed bananas into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle batter in 1/4 cup portions onto the hot griddle. Cook until tiny air bubbles form on top, 2 to 5 minutes; turn and continue cooking until the bottoms are browned, 2 to 3 minutes. Repeat with remaining batter. Keep finished pancakes warm. Top pancakes with banana slices and maple syrup to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
