  "ingredients": [
    "0.5 cup unsalted butter, softened",
    "0.5 (8 ounce) package cream cheese, softened",
    "2 cups white sugar",
    "4 large eggs",
    "1 teaspoon vanilla extract",
    "3 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1 (8 ounce) carton sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and cream cheese together until creamy; add sugar and beat until fluffy. Add eggs one at a time, beating until each one is blended. Stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, and baking soda in a separate bowl. Gradually add to the butter mixture, alternating with sour cream, beating until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 24 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
