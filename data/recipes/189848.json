  "ingredients": [
    "1 large sweet potato, cut into chunks",
    "1 cup brown sugar",
    "1 cup butter",
    "0.33333334326744 cup sweetened condensed milk",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "1 pinch salt",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a casserole dish with butter or oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sweet potato chunks into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low, cover, and simmer until tender, about 20 minutes. Drain and transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash sweet potatoes with a potato masher. Add brown sugar, butter, sweetened condensed milk, vanilla extract, cinnamon, and salt; beat with a whisk until fluffy. Add eggs; continue whisking until mixture is light in color. Transfer to the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 1 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
