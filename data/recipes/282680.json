  "ingredients": [
    "1 cup white sugar",
    "11 tablespoons unsalted butter, softened",
    "3.5 ounces marzipan",
    "1 teaspoon vanilla extract",
    "4 large eggs",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "2 medium bananas, cut into small chunks",
    "3.5 ounces high-quality dark chocolate (at least 75%), chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, butter, marzipan, and vanilla extract in a large bowl; mix with an electric mixer until smooth. Add eggs one at a time, and mix until well combined. Mix in flour and baking powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in bananas and chocolate, folding them into batter. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
