  "ingredients": [
    "2 pounds ground beef",
    "1 medium onion, diced",
    "1 (29 ounce) can tomato sauce",
    "1 (29 ounce) can kidney beans, undrained",
    "1 (29 ounce) can pinto beans, undrained",
    "2 cups beer",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (4.5 ounce) can chopped green chiles",
    "2 tablespoons chili powder",
    "1 tablespoon ground cumin",
    "2 teaspoons salt",
    "2 teaspoons ground black pepper"
  ],
  "steps": [
    {
      "text": "Cook ground beef and onion in a large skillet over medium-high heat until beef is brown and crumbly and onion is translucent, 7 to 10 minutes. Drain and discard excess grease. Transfer beef mixture to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomato sauce, kidney beans, pinto beans, beer, diced tomatoes, green chiles, chili powder, cumin, salt, and black pepper into beef mixture to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the slow cooker. Cook on Low for 8 to 10 hours or on High for 4 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
