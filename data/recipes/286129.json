  "ingredients": [
    "1 cup unsalted butter, softened",
    "0.75 cup brown sugar",
    "0.25 cup white sugar",
    "0.5 (5.1 ounce) package instant vanilla pudding mix",
    "1 teaspoon vanilla extract, or more to taste",
    "2 tablespoons milk",
    "1.5 tablespoons vinegar",
    "1.5 teaspoons baking powder",
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 pinch salt",
    "1.5 cups semi-sweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 2 cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, both sugars, pudding mix, and vanilla in a large bowl; beat with an electric mixer until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, vinegar, and baking powder together in a small bowl until frothy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add milk-vinegar mixture to the butter mixture and mix to combine. Mix in flour, baking soda, and salt until a dough forms. Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a cookie scoop to make perfect balls of dough. Drop balls onto the prepared cookie sheets and press them down a bit if your prefer a flatter cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light brown, 8 to 10 minutes. Cool on the cookie sheets briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
