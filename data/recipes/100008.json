  "ingredients": [
    "8 ounces fresh young ginger root, peeled",
    "1.5 teaspoons sea salt",
    "1 cup rice vinegar",
    "0.33333334326744 cup white sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O1Q4rNfSjErfC8P53CDUcshvMhs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-100008-homemade-pickled-ginger-gari-DDMFS-step-1-235e3dcf340e4cb497cdcfd9fe5941df.jpg"
      ],
      "image": "assets/images/100008/step_01.webp"
    },
    {
      "text": "Cut ginger into chunks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XHCeYzqqHQGkJJi6XXKqTEEeQ5c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-100008-homemade-pickled-ginger-gari-DDMFS-step-2-a387277e6fda469884230ad195d29633.jpg"
      ],
      "image": "assets/images/100008/step_02.webp"
    },
    {
      "text": "Place in a bowl, sprinkle with sea salt, and stir to coat. Let stand for about 30 minutes, then transfer to a clean lidded jar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4bKxQ_Ej3d7G2zQCtnL-_hz2AEY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-100008-homemade-pickled-ginger-gari-DDMFS-step-3-df96e84a19c849c69f73d00bdb650e5a.jpg"
      ],
      "image": "assets/images/100008/step_03.webp"
    },
    {
      "text": "Stir together rice vinegar and sugar in a saucepan until sugar has dissolved.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sbUqxsiAl39UwDPbv_8vPhZ3O7E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-100008-homemade-pickled-ginger-gari-DDMFS-step-4-34dad313b0954ae4b68cef4406365ad1.jpg"
      ],
      "image": "assets/images/100008/step_04.webp"
    },
    {
      "text": "Bring to a boil, then pour the boiling liquid over ginger root pieces in the jar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rU-UMKJiyslNloJjVyty1xj3tGA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-100008-homemade-pickled-ginger-gari-DDMFS-step-5-2ebf6ed25d344175a7e21c82ba71c04f.jpg"
      ],
      "image": "assets/images/100008/step_05.webp"
    },
    {
      "text": "Allow the mixture to cool, then seal the jar. After a few minutes, the liquid may change to a slightly pinkish color; don't be alarmed. Store in the refrigerator for at least 1 week.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/94UYyGsaxTdQZeu_u6jD8dHGG8A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-100008-homemade-pickled-ginger-gari-DDMFS-step-6-6f1c601bcedb426ba93e03a21d045507.jpg"
      ],
      "image": "assets/images/100008/step_06.webp"
    },
