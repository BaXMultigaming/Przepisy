  "ingredients": [
    "1 (8 ounce) package cream cheese, at room temperature",
    "1 pound lean ground beef",
    "1 cup water",
    "1 (1 ounce) package taco seasoning mix",
    "1.5 cups salsa",
    "1.5 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cream cheese in an even layer in an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir ground beef in a large skillet over medium-high heat until crumbly, browned, and cooked through, 5 to 10 minutes. Stir in water and taco seasoning mix; simmer until most liquid evaporates, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread beef mixture over cream cheese; top with salsa, then sprinkle with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling and cheese is melted, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
