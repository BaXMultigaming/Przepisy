  "ingredients": [
    "1 pound ground beef",
    "1.5 teaspoons chili powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon garlic powder",
    "0.125 teaspoon cayenne pepper",
    "0.25 cup water",
    "8 medium taco shells, warmed",
    "2 cups shredded Cheddar cheese",
    "2 cups shredded lettuce",
    "0.25 cup finely chopped onion",
    "1 medium tomato, chopped",
    "taco sauce"
  ],
  "steps": [
    {
      "text": "Crumble the ground beef into a 1 1/2 quart casserole dish. Cover with glass lid. Cook in the microwave for 5 minutes on High. Drain, and stir in chili powder, salt, garlic powder, cayenne pepper and water. Cover and return to the microwave. Cook for another 3 to 4 minutes on High.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill each taco shell with about 2 tablespoons of the ground beef, then top with desired amounts of cheese, lettuce, onion, tomato and taco sauce.",
