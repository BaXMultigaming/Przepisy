  "ingredients": [
    "4 tablespoons olive oil",
    "1 yellow onion, chopped",
    "1 red bell pepper, chopped",
    "1 Anaheim chile pepper, chopped",
    "2 red jalapeno pepper, chopped",
    "4 garlic cloves, minced",
    "2.5 pounds lean ground beef",
    "0.25 cup Worcestershire sauce",
    "1 pinch garlic powder, or to taste",
    "2 beef bouillon cubes",
    "1 (12 fluid ounce) can or bottle light beer (such as Coors®)",
    "1 (28 ounce) can crushed San Marzano tomatoes",
    "1 (14.5 ounce) can fire-roasted diced tomatoes",
    "1 (12 ounce) can tomato paste",
    "0.5 cup white wine",
    "2 tablespoons chili powder",
    "2 tablespoons ground cumin",
    "1 tablespoon brown sugar",
    "1 tablespoon chipotle pepper sauce",
    "2.5 teaspoons dried basil",
    "1.5 teaspoons smoked paprika",
    "1 teaspoon salt",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon ground black pepper",
    "2 (16 ounce) cans dark red kidney beans (such as Bush's®)",
    "1 cup sour cream",
    "3 tablespoons chopped fresh cilantro",
    "0.5 teaspoon ground cumin"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s7rw8IFXtkDmMt_3wZF2_hQsmSE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233613-Best-Damn-Chili-mfs-STEPS-001-0a5af42a27a1436c90360c06b83468f0.jpg"
      ],
      "image": "assets/images/233613/step_01.webp"
    },
    {
      "text": "Heat oil in a large pot over medium heat. Add onion, bell pepper, Anaheim pepper, jalapeños, and garlic; cook and stir until softened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xevIReGDRL78HD7eqxyqsujARX0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233613-Best-Damn-Chili-mfs-STEPS-006-d961566058ef41daa754aa9230e33686.jpg"
      ],
      "image": "assets/images/233613/step_02.webp"
    },
    {
      "text": "Meanwhile, heat a large skillet over medium-high heat. Add beef; cook and stir until browned and crumbly, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EIqaAkKXwp56ekIfYCBF7U99HCI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233613-Best-Damn-Chili-mfs-STEPS-009-bbed75fb127b41a39ddc370d4b314ec7.jpg"
      ],
      "image": "assets/images/233613/step_03.webp"
    },
    {
      "text": "Add Worcestershire sauce and garlic powder; crumble bouillon cubes over beef. Add beer; continue to cook , scraping any browned bits from the bottom of the skillet, until liquid is hot, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FymI1o7G202t_Cy1ERo55z8avKo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233613-Best-Damn-Chili-mfs-STEPS-012-b0c19568b4e3441eafe24200895a1196.jpg"
      ],
      "image": "assets/images/233613/step_04.webp"
    },
    {
      "text": "Stir beef mixture into pepper mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EBcQQblqW-29ec43C9JFhqa4klM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233613-Best-Damn-Chili-mfs-STEPS-018-d970ccdc694f435e91015071cd84008f.jpg"
      ],
      "image": "assets/images/233613/step_05.webp"
    },
    {
      "text": "Stir crushed tomatoes, diced tomatoes, tomato paste, and wine into beef mixture; season with chili powder, 2 tablespoons cumin, brown sugar, pepper sauce, basil, paprika, salt, oregano, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KQa3B0drLgIogaeGJUehJ3PAgik=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233613-Best-Damn-Chili-mfs-STEPS-026-56eb834251be4b1793d3e297cf3223b9.jpg"
      ],
      "image": "assets/images/233613/step_06.webp"
    },
    {
      "text": "Bring chili to a boil; reduce heat to medium-low. Cover the pot; simmer until meat and vegetables are very tender and flavors have developed, about 90 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mMrBmp4XdRVr5ZlcGouC6bXFxVU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233613-Best-Damn-Chili-mfs-STEPS-029-4301f61155004747becc3f2d9a604a4c.jpg"
      ],
      "image": "assets/images/233613/step_07.webp"
    },
    {
      "text": "Stir kidney beans into chili; simmer until beans are hot, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E-ESLyDfO5VEHVY0CNqjyBMU-Rs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233613-Best-Damn-Chili-mfs-STEPS-032-ee72a54b6f13430da88535b8ece850fe.jpg"
      ],
      "image": "assets/images/233613/step_08.webp"
    },
    {
      "text": "Blend sour cream, cilantro, and remaining ½ teaspoon cumin in a food processor until smooth; serve with chili.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2EpyKEdrKKaPU0yAI2Ccc7LFJBo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233613-Best-Damn-Chili-mfs-STEPS-037-a3f8e55600a143dea9b1cd81c8e82aae.jpg"
      ],
      "image": "assets/images/233613/step_09.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hjpXTv1l525EU4JTqsemISrTkeg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233613-best-damn-chili-DDMFS-4x3-e493a5d6071c47cc836c95bb6ced7883.jpg"
      ],
      "image": "assets/images/233613/step_10.webp"
    }
