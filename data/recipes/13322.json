  "ingredients": [
    "1 pound beef oxtail",
    "1 pound cubed beef stew meat",
    "6 potatoes, chopped",
    "2 onions, chopped",
    "2 Roma (plum) tomatoes, quartered",
    "6 stalks celery, chopped",
