  "ingredients": [
    "4 tablespoons vegetable oil",
    "5 cloves garlic, finely chopped",
    "2 green chilies, diced",
    "2 cups cubed skinless, boneless chicken breast meat",
    "2 cups cooked jasmine rice, chilled",
    "1 tablespoon white sugar",
    "1 tablespoon fish sauce",
    "1 tablespoon soy sauce",
    "2 teaspoons chopped green onion",
    "2 tablespoons chopped fresh basil leaves",
    "5 tablespoons chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Heat oil in a wok or large skillet, over medium-high heat. Fry garlic until golden then add chile pepper and chicken meat, and stir-fry until cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When chicken is cooked, add rice, sugar, fish sauce, and soy sauce. Cook over medium heat, stirring gently. When mixture is well blended, stir in green onions, basil, and cilantro. Cook for 1 more minute, then serve hot.",
