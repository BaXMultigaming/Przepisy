  "ingredients": [
    "1.5 pounds boneless, skinless chicken thighs, trimmed of fat",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 teaspoon olive oil",
    "1 onion, thinly sliced",
    "1 garlic clove, chopped",
    "1 large potato, peeled and cubed",
    "3 plum tomatoes, chopped",
    "0.75 cup chicken broth",
    "0.5 cup chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Season chicken thighs with salt and pepper on both sides. Heat olive oil in a large nonstick skillet over medium-high heat. Cook chicken until browned, about 5 minutes per side. Add onion and garlic; cook until onion is just tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir potato, tomatoes, and chicken broth into the skillet. Cover, reduce heat, and simmer until chicken is no longer pink in the center and potato is tender, about 20 minutes. Remove from heat and stir in basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
