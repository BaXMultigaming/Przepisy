  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "2 medium ripe bananas, mashed",
    "0.75 cup diced strawberries",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "0.5 cup vegetable oil",
    "0.5 cup semisweet chocolate chips",
    "2 large eggs, lightly beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, cinnamon, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bananas, strawberries, both sugars, oil, chocolate chips, and eggs together in a medium bowl. Add to flour mixture and mix until well combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
