  "title": "Old-Fashioned Carrot Pudding",
  "description": "This Christmas carrot pudding recipe is made with grated carrots, raisins, walnuts, and spices steamed in a mold for a traditional dessert.",
  "authors": [
    "Carol Shorter Hicks"
  ],
  "date_published": "2020-06-18T23:11:42-04:00",
