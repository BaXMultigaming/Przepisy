  "ingredients": [
    "2 (5 ounce) cans tuna, drained",
    "0.25 cup mayonnaise",
    "0.25 cup finely chopped celery",
    "1.5 tablespoons finely chopped onion",
    "1 tablespoon chopped parsley",
    "0.75 teaspoon red wine vinegar",
    "1 pinch salt",
    "1 pinch freshly ground black pepper",
    "4 slices seedless rye bread",
    "8 slices Swiss cheese",
    "8 slices ripe tomato",
    "paprika, for garnish"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tuna, mayonnaise, celery, onion, parsley, and vinegar in a bowl; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread on a baking sheet; broil in the preheated oven until lightly toasted, 1 minute. Remove from oven; keep broiler on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide tuna salad among bread slices; place 1 cheese slice on top of each. Layer each with 2 tomato slices; top each with 1 cheese slice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until cheese is melted, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
