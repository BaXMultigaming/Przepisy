  "ingredients": [
    "2 cups milk",
    "3 tablespoons all-purpose flour",
    "1 tablespoon Worcestershire sauce",
    "2 teaspoons ground dry mustard",
    "1 clove garlic, peeled and crushed",
    "6 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Mix together milk, flour, Worcestershire sauce, mustard, and garlic in a medium saucepan over low heat. Heat until almost boiling.",
      "section": null,
