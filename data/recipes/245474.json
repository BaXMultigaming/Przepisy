  "ingredients": [
    "2.5 pounds oxtail",
    "1 tablespoon soy sauce",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon salt",
    "1 tablespoon white sugar",
    "1 tablespoon garlic and herb seasoning (such as Spike®)",
    "1 teaspoon browning sauce (such as Grace®)",
    "0.25 teaspoon ground paprika",
    "0.25 teaspoon ground cayenne pepper",
    "0.25 teaspoon ground black pepper",
    "2 tablespoons vegetable oil",
    "2 carrots, thinly sliced",
    "2 stalks celery, thinly sliced",
    "1 onion, chopped",
    "4 garlic cloves, minced",
    "3 cups low-sodium beef broth",
    "1 bunch fresh thyme",
    "1 sprig fresh rosemary",
    "1 bay leaf",
    "2 tablespoons unsalted butter"
  ],
  "steps": [
    {
      "text": "Place oxtail in a shallow dish. Combine soy sauce, Worcestershire sauce, salt, sugar, garlic and herb seasoning, browning sauce, paprika, cayenne pepper, and black pepper together in a small bowl. Rub both sides of oxtail with soy sauce mixture; discard any excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bHTQr2ZV5lN5nCnxEdSftKOMYGI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245474-Jamaincan-Oxtail-ddmfs-112-step1-a675fc9ab1d946bfaaed4112be9bb60d.jpg"
      ],
      "image": "assets/images/245474/step_01.webp"
    },
    {
      "text": "Heat vegetable oil in a large, deep skillet over medium-high heat. Sear oxtail in hot oil until golden brown, about 3 minutes per side; transfer to a plate and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d30RYd4nJTAj23SXKjQwAjhg-YY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245474-Jamaincan-Oxtail-ddmfs-113-step2-80bcbd29c4d44fc09b979ea12ac235b2.jpg"
      ],
      "image": "assets/images/245474/step_02.webp"
    },
    {
      "text": "Sauté carrots, celery, onion, and garlic in the same skillet until softened, about 5 minutes. Add beef broth, thyme, rosemary, and bay leaf; bring to a boil. Add oxtail, with its juices, and butter. Reduce heat to low, cover, and simmer until oxtail is fork tender, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n9FWcos97YsvamnAwfSujOaVgWE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/245474-Jamaincan-Oxtail-ddmfs-112-step3-83f36cc11e6a403fab0d438bf24a8fca.jpg"
      ],
      "image": "assets/images/245474/step_03.webp"
    },
    {
      "text": "Uncover skillet and increase heat to high. Cook, stirring occasionally, until sauce reduces and thickens, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
