  "ingredients": [
    "1 egg",
    "0.5 cup white sugar",
    "0.25 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "1 cup buttermilk",
    "2 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup chopped walnuts",
    "0.5 cup candied cherries",
    "0.5 cup currants",
    "0.5 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour one 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in mixing bowl until frothy. Add sugar, oil, and vanilla. Beat to blend. Mix in buttermilk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl measure the flour, soda, and salt. Stir to mix well. Add walnuts, cherries, raisins, and chips. Mix together. Add all at once to liquid batter. Stir only until just combined. Pour the batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour or until bread tests done. Let bread stand for 10 minutes then remove from pan and let cool on a rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
