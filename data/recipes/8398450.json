  "ingredients": [
    "0.5 cup Greek yogurt",
    "0.75 cup self-rising flour, plus more for kneading",
    "1 small egg",
    "1 teaspoon water",
    "24 cocktail wieners",
    "2 tablespoons everything bagel seasoning"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a large baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place Greek yogurt in a large bowl. Add flour and stir until crumbly. Dust a cutting board with flour. Add dough mixture to the cutting board and knead until smooth, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg and water together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into a 12x6-inch rectangle. Cut dough in half lengthwise. Cut crosswise into 1-inch strips to form 24 strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap 1 dough strip around a cocktail wiener and place seam side down onto the prepared baking sheet. Repeat with remaining cocktail wieners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush egg wash evenly over dough. Sprinkle each pig in the blanket with everything bagel seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
