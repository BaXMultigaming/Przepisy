  "ingredients": [
    "1 teaspoon butter",
    "1 egg",
    "2 tablespoons milk",
    "1 slice Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Melt butter in a small skillet over medium heat. In a small bowl, whisk together egg and milk; pour into skillet. Cook until bubbles appear, then flip over. Cover with cheese. Cook 10 seconds, or until cheese is melted.",
