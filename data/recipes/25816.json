  "ingredients": [
    "1 (3 ounce) package cream cheese",
    "0.5 cup butter",
    "1 cup all-purpose flour",
    "1 egg",
    "1 tablespoon butter",
    "1 teaspoon vanilla extract",
    "1 cup brown sugar",
    "0.75 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line mini muffin pans with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together cream cheese, 1/2 cup butter, and flour until a dough forms. Roll into 1-inch balls and press into the bottom and up the sides of the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, blend together egg, butter, vanilla, and brown sugar until smooth. Stir in walnuts. Spoon mixture into the muffin cups, filling each 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 to 20 minutes, until crusts are golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
