  "ingredients": [
    "1.5 cups chopped fresh basil",
    "0.5 cup chopped fresh oregano",
    "0.5 cup olive oil",
    "1 (4 ounce) package grated Parmesan cheese",
    "1 (4 ounce) can minced black olives",
    "0.33333334326744 cup red wine vinegar",
    "0.25 cup chopped fresh cilantro",
    "1.5 tablespoons white sugar",
    "2 teaspoons hot pepper sauce (e.g. Tabasco™)",
    "2 cloves garlic, chopped",
    "1.5 teaspoons ground black pepper",
    "1.5 teaspoons Dijon mustard",
    "1 teaspoon salt, or to taste",
    "1 teaspoon lemon juice",
    "1 teaspoon onion powder",
    "4 roma (plum) tomatoes, chopped",
    "6 green onions, chopped",
    "1 (16 ounce) package farfalle (bow tie) pasta",
    "1 cup shredded mozzarella cheese",
    "0.5 cup pine nuts"
  ],
  "steps": [
    {
      "text": "Whisk basil, oregano, oil, Parmesan cheese, olives, vinegar, cilantro, sugar, hot sauce, garlic, black pepper, Dijon mustard, salt, lemon, and onion powder together in a large bowl; stir in tomatoes and green onions to coat. Refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook farfalle at a boil, stirring occasionally, until tender yet firm to the bite, about 7 minutes. Drain, rinse with cold water, drain. Add pasta to the bowl; mix well. Top with mozzarella cheese and pine nuts. Refrigerate before serving, at least 1 hour.",
