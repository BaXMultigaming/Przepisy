  "ingredients": [
    "3 (16 ounce) cans seasoned green beans, drained",
    "1.5 cups frozen corn",
    "2 cups sour cream",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "4 ounces buttery round crackers",
    "0.5 cup butter, melted",
    "1.5 cups shredded Colby-Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the green beans and corn into a 2 quart casserole dish, and spread evenly. In a medium bowl, stir together the sour cream and cream of mushroom soup. Spread on top of the corn and beans. Sprinkle shredded cheese over the soup. Stir together the melted butter and cracker crumbs; sprinkle over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 20 minutes in the preheated oven, until the cheese is melted and everything is heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
