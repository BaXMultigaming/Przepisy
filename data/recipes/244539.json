  "ingredients": [
    "1 (8 ounce) package reduced-fat cream cheese, softened",
    "0.5 cup granular sucrolose sweetener (such as Splenda®), or more to taste",
    "1 (8 ounce) container frozen whipped topping, thawed",
    "1 teaspoon vanilla extract"
  ],
