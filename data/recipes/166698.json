  "ingredients": [
    "1 chicken carcass",
    "0.75 cup thinly sliced galangal",
    "2 stalks lemon grass, crushed",
    "2 makrut lime leaves",
    "1 shallot, sliced",
    "2 cloves peeled garlic",
    "2 chopped Thai chiles, or to taste",
    "10 cups water"
  ],
  "steps": [
    {
      "text": "Place chicken carcass into a large pot and cover with water. Bring to a boil over high heat, then reduce heat to medium-low and simmer for 5 minutes. Drain, rinse carcass under running water, and return to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add galangal, lemongrass, lime leaves, shallot, garlic, and chiles. Pour in 10 cups water. Bring to a boil over high heat, then reduce heat to medium-low and simmer uncovered for 1 1/2 hours, skimming the foam and fat often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain stock through cheesecloth before using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
