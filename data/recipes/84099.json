  "title": "Awesome Egg Rolls",
  "description": "Tasty shrimp egg roll recipe featuring egg roll wrappers filled with shrimp, cabbage, carrots, and bean sprouts that are fried to a golden-brown finish.",
  "authors": [
    "ROUVER"
  ],
  "date_published": "2018-03-21T12:43:40-04:00",
