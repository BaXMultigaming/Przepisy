  ],
  "ingredients": [
    "4 cups warm water (110 degrees F/45 degrees C)",
    "1 cup honey",
    "0.5 cup olive oil",
    "2 (.25 ounce) packages active dry yeast",
    "2.5 cups wheat berries",
    "1.5 cups spelt flour",
    "0.5 cup barley",
    "0.5 cup millet",
    "0.25 cup dry green lentils",
    "2 tablespoons dry great Northern beans",
    "2 tablespoons dry kidney beans",
    "2 tablespoons dried pinto beans",
    "2 tablespoons salt, or to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SEZmDna9KuYZzZuGdpnQTWH_v-M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/EzekielBread_7047_DDMFS_Ingredients_Step1_2258-a74d18e4c8d3493796ee5a82f4afef59.jpg"
      ],
      "image": "assets/images/7047/step_01.webp"
    },
    {
      "text": "Mix water, honey, olive oil, and yeast in a large bowl. Let sit for 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vVAyD9QOFkne1LmkGQEjtGmFNps=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/EzekielBread_7047_DDMFS_Step2_2265-1a60e9a633304457bd45ba7803832636.jpg"
      ],
      "image": "assets/images/7047/step_02.webp"
    },
    {
      "text": "Meanwhile, stir together wheat berries, spelt flour, barley, millet, lentils, great northern beans, kidney beans, and pinto beans together until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7LFsLg4iX2vfnzdHRhdf4Sc8U2o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/EzekielBread_7047_DDMFS_Step3_2268-6ac45a8efdf34e5fb24c94775076ee5f.jpg"
      ],
      "image": "assets/images/7047/step_03.webp"
    },
    {
      "text": "Grind in a flour mill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1G1IG9SSO5ioPTey6Ws8LGFE4_w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/EzekielBread_7047_DDMFS_STep5_2294-0b68aa6cc9bf4577bd3d7eb2a8165c0c.jpg"
      ],
      "image": "assets/images/7047/step_04.webp"
    },
    {
      "text": "Add fresh milled flour mixture and salt to yeast mixture; stir until well mixed, about 10 minutes. The dough will be loose.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5cQFCflOCjhc9etecu9o58zmALg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/EzekielBread_7047_DDMFS_Step6_2296-13e50dd0b98c4dc1b8d8d549433cff7b.jpg"
      ],
      "image": "assets/images/7047/step_05.webp"
    },
    {
      "text": "Pour dough into two greased 9x5-inch loaf pans. Let rise in a warm place until dough has reached the top of the pan, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cg_bP6DP3InbDvWOFNFM9TySTEY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/EzekielBread_7047_DDMFS_STep7_2331-5f8a2066a60249efb506d231a3ca5581.jpg"
      ],
      "image": "assets/images/7047/step_06.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until loaves are golden brown, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oxHN8ipXxePqL3EpkUb8qEhiF2k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/EzekielBread_7047_DDMFS_Step8_2461-c28824ba729a43eebe316b8bb63be950.jpg"
      ],
      "image": "assets/images/7047/step_08.webp"
    }
