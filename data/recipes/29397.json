  "ingredients": [
    "1 (9 inch) unbaked pie shell",
    "0.33333334326744 cup white sugar",
    "1 tablespoon all-purpose flour",
    "2 cups chopped fresh rhubarb",
    "1 (8 ounce) package cream cheese, softened",
    "2 eggs",
    "1 cup sour cream",
    "2 tablespoons white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place pie crust in a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ⅓ cup sugar and flour together in a large bowl until well combined; add rhubarb and toss to coat. Pour into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat cream cheese, eggs, and ⅓ cup sugar together in a medium bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pie from the oven; reduce the oven temperature to 350 degrees F (175 degrees C). Pour cream cheese mixture over rhubarb; continue baking 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir sour cream, 2 tablespoons sugar, and vanilla extract together in a medium bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pie from the oven; immediately spread sour cream mixture over pie. Cool, then cut into wedges and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
