  "ingredients": [
    "1 pound cooked and drained spaghetti",
    "5 chicken breasts, cooked and cubed",
    "2 (10.75 ounce) cans condensed cream of chicken soup",
    "2.25 cups water",
    "0.25 cup butter",
    "2 cubes chicken bouillon",
    "0.25 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put cooked spaghetti noodles into 9x13-inch baking dish. Place chicken on top of spaghetti.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring condensed soup, water, butter, and bouillon to a boil in a medium saucepan. Pour soup mixture over pasta and chicken. Sprinkle Cheddar on top and press down a bit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes.",
