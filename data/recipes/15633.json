  "title": "Gourmet Sweet Potato Classic",
  "description": "This unique sweet potato casserole features an irresistible brown sugar and pecan topping instead of typical marshmallows for a family-friendly side.",
  "authors": [
    "Heather"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
