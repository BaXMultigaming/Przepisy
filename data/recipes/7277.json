  "ingredients": [
    "0.5 cup heavy whipping cream",
    "4 tablespoons all-purpose flour",
    "1 cup unsalted butter",
    "0.5 cup shortening",
    "2 cups confectioners' sugar",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon butter flavored extract"
  ],
  "steps": [
    {
      "text": "Mix heavy cream and flour in a small bowl. Heat mixture in the microwave for 45 seconds on high. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, combine butter, shortening, confectioners' sugar, vanilla extract, and butter extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using an electric mixer, beat on low until combined. Then beat on medium speed for 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add heavy cream mixture, and beat on medium speed for another 10 minutes. (Mixture will appear soupy at first, but will become fluffy.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
