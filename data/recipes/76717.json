  "ingredients": [
    "2 tablespoons vegetable oil",
    "3 pounds pork spareribs",
    "1 (12 fluid ounce) can cola-flavored carbonated beverage",
    "1 cup ketchup",
    "0.5 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Quickly brown spareribs on both sides; transfer to a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cola, ketchup, and ginger in a bowl; pour over ribs. Cover the pan with a lid or cover tightly with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 2 hours; uncover during the last 30 minutes.",
      "section": null,
