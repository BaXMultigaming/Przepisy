  "ingredients": [
    "5 cups sliced peeled tart apples",
    "1.6666667461395 cups white sugar, divided",
    "1.5 teaspoons ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon freshly ground nutmeg",
    "1.25 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 egg, beaten",
    "0.5 cup table cream (18%)",
    "0.33333334326744 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir apples, 2/3 cup sugar, cinnamon, cloves, and nutmeg together; distribute apple mixture into a 9x9-inch baking dish that is at least 2 inches deep.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, remaining 1 cup sugar, baking powder, and salt together in a bowl. Stir egg, cream and melted butter together in a cup; pour egg mixture into flour mixture and stir until all ingredients are moistened. Using the back of a spoon, spread batter over apple mixture to seal apples in completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown on top, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
