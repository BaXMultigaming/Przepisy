  "ingredients": [
    "9 cups Rice Chex® cereal",
    "1.25 cups white vanilla baking chips",
    "0.25 cup butter or margarine",
    "4 teaspoons grated lemon peel",
    "2 tablespoons fresh lemon juice",
    "2 cups powdered sugar"
  ],
  "steps": [
    {
      "text": "Place cereal into a large bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a 1-quart, microwave-safe bowl, combine chips, butter, lemon peel, and juice. Microwave, uncovered, on high for 1 minute; stir. Microwave about 30 seconds longer or until mixture can be stirred smooth. Pour mixture over cereal, stirring until evenly coated. Pour into a 2-gallon resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add powdered sugar. Seal bag and gently shake until well coated. Spread on waxed paper or foil to cool. Store in airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
