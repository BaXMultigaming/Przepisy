  "title": "Absolutely Ultimate Potato Soup",
  "description": "This rich and satisfying potato soup is made by cooking potatoes and onion in bacon grease before blending with cream and herbs for a cozy winter meal.",
  "authors": [
    "Karena"
  ],
  "date_published": "1999-02-27T23:42:31-05:00",
  "date_modified": "2026-03-24T12:52:16-04:00",
  "prep_time": "PT15M",
  "cook_time": "PT30M",
  "total_time": "PT45M",
  "yield": [
    "8"
  ],
