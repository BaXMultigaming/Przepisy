  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "1 pound bacon, chopped",
    "2 stalks celery, diced",
    "1 onion, chopped",
    "3 cloves garlic, minced",
    "8 potatoes, peeled and cubed",
    "4 cups chicken stock, or enough to cover potatoes",
    "3 tablespoons butter",
    "0.25 cup all-purpose flour",
    "1 cup heavy cream",
    "1 teaspoon dried tarragon",
    "3 teaspoons chopped fresh cilantro",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Za_Xwxb8WHR7sGzY7y4k2v-yWhs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13218-Absolutely-Ultimate-Potato-Soup-Recipe-mfs-Steps-001-5accb3a0b4c74270988722c80d243b76.jpg"
      ],
      "image": "assets/images/13218/step_01.webp"
    },
    {
      "text": "Place bacon in a Dutch oven and cook over medium-high heat, turning occasionally, until evenly browned, 5 to 10 minutes. Drain bacon pieces on paper towels. Drain off all but 1/4 cup of the bacon grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/O8M0zGPYViRojrsk2JSgF9ytF54=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13218-Absolutely-Ultimate-Potato-Soup-Recipe-mfs-Steps-006-61b9172e59cd4a30a0c9c2367d86498e.jpg"
      ],
      "image": "assets/images/13218/step_02.webp"
    },
    {
      "text": "Cook celery and onion in the reserved bacon drippings until onion is soft and translucent, about 5 minutes. Stir in garlic, and continue cooking for 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OqXn3jMs_wBD_xLkha-EsWg9MdA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13218-Absolutely-Ultimate-Potato-Soup-Recipe-mfs-Steps-013-9f83b8572b50490ebf45a13b2b3e7a8b.jpg"
      ],
      "image": "assets/images/13218/step_03.webp"
    },
    {
      "text": "Add cubed potatoes, and toss to coat. Sauté for 3 to 4 minutes. Return bacon to the pan, and add enough chicken stock to just cover the potatoes. Cover, and simmer until potatoes are tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/54VJGYGm8cTKCxxVn340nJAGA3w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13218-Absolutely-Ultimate-Potato-Soup-Recipe-mfs-Steps-014-452e75c7ba304734bcac1b88fc47dff0.jpg"
      ],
      "image": "assets/images/13218/step_04.webp"
    },
    {
      "text": "Meanwhile, melt butter in a separate skillet over medium heat. Whisk in flour. Cook, stirring constantly, 1 to 2 minutes. Whisk in heavy cream, tarragon, and cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OxAZyQBTHysx4lLAmUmk91iHih8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13218-Absolutely-Ultimate-Potato-Soup-Recipe-mfs-Steps-025-e45be650c5874995824d27b245eac446.jpg"
      ],
      "image": "assets/images/13218/step_05.webp"
    },
    {
      "text": "Bring cream mixture to a boil, and cook, stirring constantly, until thickened, about 5 minutes. Add cream mixture to the potato mixture; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LXPjv8owxKdHcc8z_U9z9DhPruY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13218-Absolutely-Ultimate-Potato-Soup-Recipe-mfs-Steps-028-7f91849bbdb940a9864d9bea68abd9be.jpg"
      ],
      "image": "assets/images/13218/step_06.webp"
    },
    {
      "text": "Transfer about 1/2 of the soup to a blender and purée. Return to the Dutch oven. Adjust seasonings to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bjtJOxqOJngJnvRdFp657dPUfp4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13218-Absolutely-Ultimate-Potato-Soup-Recipe-mfs-Steps-038-f2a38ceaf5a6448b9865b0163e63e00b.jpg"
      ],
      "image": "assets/images/13218/step_07.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ldIm8bOEocOlc3wsF9TiiWyiWwI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13218-absolutely-ultimate-potato-soup-DDMFS-4x3-9c551183c89c4fdb804d25147f75fbcd.jpg"
      ],
      "image": "assets/images/13218/step_08.webp"
    }
  ],
