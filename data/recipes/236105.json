  "title": "Baked Blazing Hot Wings",
  "description": "Cooking frozen chicken wings is easy! Just bake the wings until juicy and crisp, toss in hot sauce, and serve for a crowd-pleasing treat on game day.",
  "authors": [
    "Jim M"
  ],
  "date_published": "2018-06-27T09:02:49-04:00",
