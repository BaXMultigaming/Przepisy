  "ingredients": [
    "5 very cold egg whites",
    "2.5 cups white sugar",
    "5 teaspoons almond extract",
    "4.5 cups almond meal",
    "0.25 cup confectioners' sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Beat egg whites with an electric mixer fitted with the whisk attachment until foamy. Gradually add sugar and almond extract, continuing to beat until very stiff peaks form. Switch to the paddle attachment and mix in almond meal until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover cookie dough with plastic wrap and refrigerate, 3 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour confectioners' sugar into a shallow bowl. Roll cookie dough into small balls and coat with confectioners' sugar. Arrange on the baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies in the preheated oven until lightly browned and firm, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
