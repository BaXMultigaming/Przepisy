  "ingredients": [
    "0.25 cup pineapple juice",
    "0.25 cup coconut oil",
    "1.5 teaspoons vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon sea salt",
    "3 cups rolled oats",
    "0.25 cup sunflower seeds",
    "0.5 cup pitted dates",
    "0.25 cup roasted almonds",
    "1.25 cups quick-cooking oats",
    "0.5 cup raisins",
    "0.5 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 200 degrees F (95 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together pineapple juice and coconut oil in a microwave-safe bowl or jar and cook in the microwave until melted, about 1 minute. Add vanilla, cinnamon, and sea salt; stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour rolled oats and sunflower seeds into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place dates and almonds into an electric blender with pineapple juice mixture; pulse until combined, about 15 seconds. Pour into oat mixture and stir using a large spoon. Stir in quick-cooking oats. Pour evenly onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 2 hours 30 minutes. Remove from the oven and mix in raisins and cranberries. Continue baking until golden, about 30 minutes more. Let cool for 30 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
