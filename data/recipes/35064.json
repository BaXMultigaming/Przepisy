  "ingredients": [
    "2.25 cups all-purpose flour",
    "1 cup white sugar",
    "2.5 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup shortening",
    "1.5 cups shredded zucchini",
    "2 eggs, lightly beaten",
    "0.25 cup sour milk",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped walnuts",
    "0.25 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 12-cup muffin tin or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and sugar in a large bowl; stir in baking powder, cinnamon, nutmeg, baking soda, and salt. Cut in shortening until mixture resembles coarse crumbs; make a well in the center. Stir zucchini, eggs, sour milk, and vanilla extract into well to combine; fold in walnuts. Spoon batter into the prepared muffin cups, filling each ⅔ to ¾ full; sprinkle tops with brown sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 15 to 20 minutes. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
