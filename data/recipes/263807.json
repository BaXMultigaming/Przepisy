  "ingredients": [
    "4 (4 ounce) cod fillets",
    "1 pinch salt and freshly ground black pepper to taste",
    "0.5 cup warm water",
    "0.5 fish bouillon cube",
    "0.75 cup dry bread crumbs",
    "0.25 cup butter, cut into small chunks",
    "1 bunch fresh parsley, chopped",
    "1 tablespoon chopped fresh dill",
    "2 teaspoons dried tarragon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lay cod fillets in a baking dish and season lightly with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water and fish bouillon cube in a bowl. Stir to combine and pour over cod.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs, butter, parsley, dill, tarragon, salt, and pepper in a bowl with a fork until crumbly. Sprinkle evenly over cod.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork and the crust is golden and crunchy, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
