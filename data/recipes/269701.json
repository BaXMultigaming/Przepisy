  "ingredients": [
    "4 ripe bananas",
    "0.33333334326744 cup applesauce",
    "1 large egg",
    "0.25 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 cup einkorn flour",
    "1 cup rolled oats",
    "0.5 cup dried blueberries",
    "0.5 cup shredded coconut",
    "2 teaspoons ground cinnamon",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash bananas in a bowl. Mix in applesauce, egg, sugar, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix einkorn flour, oats, blueberries, coconut, cinnamon, baking powder, salt, and baking soda together in another bowl. Add to banana mixture and stir until just combined. Spoon batter into the muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
