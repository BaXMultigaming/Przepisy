  "ingredients": [
    "1 (10 ounce) can refrigerated buttermilk biscuit dough (such as Pillsbury®)",
    "1 cup blueberries",
    "0.5 cup powdered sugar",
    "1 tablespoon lemon juice",
    "0.5 teaspoon lemon zest"
  ],
  "steps": [
