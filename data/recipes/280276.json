    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a cookie sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove biscuits from the can; split in half crosswise, for a total of 10 biscuits. Place 5 biscuits on the prepared cookie sheet; divide and place blueberries on 5 biscuits.",
