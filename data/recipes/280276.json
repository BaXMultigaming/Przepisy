      ],
      "image": "assets/images/280276/step_03.webp"
    },
    {
      "text": "Cover blueberries with remaining 5 biscuits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5SAHMpVOYdFrnEQNaCQu8Anwr9s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/280276-blueberry-lemon-breakfast-biscuits-step-04-9a608f7e3186422288df34eccae4dbc1.jpg"
      ],
      "image": "assets/images/280276/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 18 to 22 minutes. Let cool for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wZKxO5PLgUcwbd4_6yDJnI0x2TQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/280276-blueberry-lemon-breakfast-biscuits-step-05-41e82530435f404cb2d6c4ebcea509c3.jpg"
      ],
      "image": "assets/images/280276/step_05.webp"
    },
    {
      "text": "Combine confectioners' sugar, lemon juice, and zest in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A_G9rq-gVZyX82NNxSLoFPa7UuE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/280276-blueberry-lemon-breakfast-biscuits-step-06-2ddb8d30fd8940aa8268499c257c5b19.jpg"
      ],
      "image": "assets/images/280276/step_06.webp"
