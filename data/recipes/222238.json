  "ingredients": [
    "1 teaspoon salt, or to taste",
    "12 ounces egg noodles",
    "3 tablespoons butter",
    "3 tablespoons flour",
    "3.5 cups cold milk",
    "1 (10 ounce) can condensed cream of mushroom soup",
    "0.5 cup diced red bell pepper",
    "0.5 cup diced green bell pepper",
    "0.25 cup chopped green onions",
    "1 teaspoon garam masala",
    "1 teaspoon dried tarragon",
    "1 cup shredded pepperjack cheese",
    "3 cups cubed skinless cooked turkey",
    "5 ounces crushed potato chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/avktQBnvXVp-OUfLLya14n_wvoY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222238-chef-johns-turkey-noodle-casserole-VAT-step-01-463dba349e3244e29ddfc28df80e02e8.jpg"
      ],
      "image": "assets/images/222238/step_01.webp"
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until almost cooked through yet still firm to the bite, about 4 minutes, stirring occasionally. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dCSgbbgOnFxhaLmwcOI37yXyzlA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222238-chef-johns-turkey-noodle-casserole-VAT-step-02-448b0e6b8a724fd88e56b4dca1fa53a2.jpg"
      ],
      "image": "assets/images/222238/step_02.webp"
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Whisk in flour; cook and stir until light golden, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9UutXcpTDyr2zGmmhmJxDjV2hI4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222238-chef-johns-turkey-noodle-casserole-VAT-step-03-36627da8d3a94781a5a7448fe5e4514f.jpg"
      ],
      "image": "assets/images/222238/step_03.webp"
    },
    {
      "text": "Pour in milk, whisking constantly. Stir in soup, bell peppers, green onions, garam masala, and tarragon; bring to a simmer and cook for 2 minutes. Off heat, stir in pepper Jack cheese until melted and incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d4CbDu1KVtfz0CQwg-LgR_lVstI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222238-chef-johns-turkey-noodle-casserole-VAT-step-04-903f22295b964e3fa6734a0ab13d5175.jpg"
      ],
      "image": "assets/images/222238/step_04.webp"
    },
    {
      "text": "Combine cheese mixture, turkey, and noodles in a large bowl until evenly incorporated; pour into a large casserole dish. Sprinkle chips on top, slightly pressing down with the tines of a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YGkXQEZqfWzA5vC1S5XsCww3nWw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222238-chef-johns-turkey-noodle-casserole-VAT-step-05-5ccbdf0143fc4bbe86efaa58ac3c24f4.jpg"
      ],
      "image": "assets/images/222238/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until top is golden brown and sauce is bubbling, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eZXBzYcjhiDrU_8L-J-RjqB_OwY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222238-chef-johns-turkey-noodle-casserole-VAT-Beauty-4x3-2598f8c3b9414122ba4b3e33bc8ef2bb.jpg"
      ],
      "image": "assets/images/222238/step_06.webp"
    }
  ],
