  "ingredients": [
    "1 large onion, thinly sliced",
    "0.66666668653488 cup gochujang (Korean hot pepper paste)",
    "0.5 cup apple cider vinegar",
    "0.5 cup chicken stock",
    "0.25 cup honey",
    "0.25 cup brown sugar",
    "2 tablespoons fresh ginger",
    "1 tablespoon soy sauce",
    "1 tablespoon yellow mustard",
    "1 tablespoon ground cinnamon",
    "3 cloves garlic, minced",
    "1 teaspoon salt",
    "5 sprigs thyme, stemmed",
    "0.5 teaspoon ground black pepper",
    "1 (4 pound) boneless pork shoulder roast, trimmed",
    "0.25 cup butter, divided",
    "1 tablespoon all-purpose flour",
    "8 hamburger buns, split",
    "3 green onions, thinly sliced"
  ],
  "steps": [
    {
      "text": "Combine onion, gochujang, vinegar, chicken stock, honey, brown sugar, ginger, soy sauce, mustard, cinnamon, garlic, salt, thyme, and black pepper in a large bowl and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dredge pork in gochujang sauce on all sides. Pour sauce into a slow cooker and add pork. Spoon some of the sauce on top of pork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until pork roast shreds easily with a fork, about 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork roast in a large bowl and shred meat with 2 forks. Pour sauce from the slow cooker into a medium pot over medium-high heat. Cover and bring to a boil. Uncover; reduce heat to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together 1 tablespoon butter and flour in a small bowl until well combined; add to sauce in the pot and mix well. Cook until heated through and slightly thickened, about 5 minutes. Remove from heat and stir again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread remaining 3 tablespoons butter over insides of buns. Place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast in the preheated oven until golden brown, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sauce into the bowl with shredded pork and mix. Top pork with green onions. Spoon pork over toasted buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
