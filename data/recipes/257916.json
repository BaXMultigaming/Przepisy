  "ingredients": [
    "1.3333333730698 cups warm water (90 degrees F (32 degrees C))",
    "1 cup poi (taro root powder)",
    "0.5 cup butter, softened",
    "1 egg",
    "2.5 teaspoons active dry yeast",
    "1 teaspoon purple food coloring",
    "1 cup white sugar",
    "0.25 teaspoon salt",
    "4 cups all-purpose flour, or as needed"
  ],
  "steps": [
    {
      "text": "Combine water, poi, butter, egg, yeast, and purple food coloring in the bowl of a stand mixer fitted with the dough hook. Let stand until yeast softens and forms a creamy foam, about 5 minutes. Add sugar and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix on low speed, adding flour gradually, until dough comes together and texture is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a floured work surface. Divide into 18 pieces; shape into rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place rolls on the prepared baking sheet. Cover and let rise until doubled, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bottoms start to brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
