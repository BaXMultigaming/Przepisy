  "ingredients": [
    "1 cup cornmeal",
    "1 cup all-purpose flour",
    "1 teaspoon salt",
    "4 teaspoons baking powder",
    "1.5 teaspoons white sugar",
    "3 eggs",
    "1 (10 ounce) package frozen chopped broccoli",
    "12 ounces cottage cheese",
    "5 tablespoons margarine, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease the bottom and sides of a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl mix together the cornmeal, flour, salt, baking powder, and sugar. Make a well in the center of the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, combine the eggs, thawed broccoli, cottage cheese, and melted butter or margarine. Pour into well of flour mixture. Stir until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into a greased 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 350 degree F (175 degrees C) oven for 30 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
