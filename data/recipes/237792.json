  "ingredients": [
    "1 cup frozen unsweetened raspberries",
    "0.75 cup gold tequila",
    "0.75 cup fresh orange juice",
    "0.5 cup fresh lemon juice",
    "0.25 cup brandy-based orange liqueur (such as Grand Marnier®)",
    "2 tablespoons superfine sugar",
    "4 mint leaves",
    "4 ice cubes"
