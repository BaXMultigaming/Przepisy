  "ingredients": [
    "5 quarts popped popcorn",
    "1 cup butter",
    "2 cups brown sugar",
    "0.5 cup corn syrup",
    "1 teaspoon salt",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 250 degrees F (120 degrees C). Place popcorn in a very large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qxhWtXGBA5zrwq7oEbJCooCcYEo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24952-Caramel-Popcorn-ddmfs-step-1-095-d57276089f6c4bd19eba35c84e783d6f.jpg"
      ],
      "image": "assets/images/24952/step_01.webp"
    },
    {
      "text": "Melt butter in a medium saucepan over medium heat. Stir in brown sugar, corn syrup, and salt. Bring to a boil, stirring constantly. Boil without stirring 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LK09FKo_0D71wQGLN-g0ELO84MI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24952-Caramel-Popcorn-ddmfs-step-3-101-a2f3176cd0c746aba66a3804db3d2e13.jpg"
      ],
      "image": "assets/images/24952/step_02.webp"
    },
    {
      "text": "Remove pan from heat and stir in vanilla and baking soda. Pour caramel in a thin stream over popcorn while stirring. Stir until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Gvhz3KDt1VnZh7uOSABSZqcqN4M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24952-Caramel-Popcorn-ddmfs-step-4-B-108-f9a70809676042afbb4f2de83beff6d0.jpg"
      ],
      "image": "assets/images/24952/step_03.webp"
    },
    {
      "text": "Divide popcorn between two large shallow baking dishes. Bake in the preheated oven, stirring every 15 minutes, for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2eBXsCoMX1HOJfkt_kMcRVPikp8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24952-Caramel-Popcorn-ddmfs-step-5-5113-af26545e2a144da48f0002f49289d99c.jpg"
      ],
      "image": "assets/images/24952/step_04.webp"
    },
    {
      "text": "Remove from oven and let cool completely before breaking into pieces. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XtVqOU66_KvIYyy3TAAOpeXsZEc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24952-Caramel-Popcorn-ddmfs-4x3-156-25ce4108d73341a6a810b28e85384bad.jpg"
      ],
      "image": "assets/images/24952/step_05.webp"
    }
