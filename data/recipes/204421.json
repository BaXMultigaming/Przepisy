  "ingredients": [
    "1 cup butter",
    "0.5 cup maple syrup",
    "2 cups flour",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and maple syrup together with an electric mixer in a large bowl until smooth. Stir flour and salt together in a separate bowl; gradually mix flour mixture into butter mixture until dough is just incorporated. Form dough into walnut-sized balls; flatten gently and arrange onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 10 to 12 minutes.",
      "section": null,
