  "ingredients": [
    "0.75 cup butter, softened",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.75 cup raspberry jam",
