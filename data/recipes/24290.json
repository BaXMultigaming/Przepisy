    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl combine butter, white sugar, brown sugar, flour, baking powder and salt; mix well. Spread 2/3 of mixture into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread jam over mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
