  "ingredients": [
    "1 cup milk",
    "1 teaspoon lemon juice",
    "1.5 cups bran cereal (such as Kellogg's® All-Bran®)",
    "1 cup all-purpose flour",
    "2 teaspoons cocoa powder",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground cinnamon",
    "0.125 teaspoon ground cloves",
    "0.66666668653488 cup dark brown sugar",
    "0.33333334326744 cup vegetable oil",
    "1 egg, beaten",
    "0.5 teaspoon vanilla extract",
    "0.75 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease 12 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir milk and lemon juice together in a bowl; let sit until milk curdles slightly, about 5 minutes. Pour bran cereal into milk mixture and let cereal soften, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cocoa powder, baking soda, baking powder, salt, cinnamon, and cloves together in a bowl. Beat brown sugar, vegetable oil, egg, and vanilla extract together in another bowl. Stir egg mixture into flour mixture until batter is just-combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir bran cereal mixture into batter; fold in raisins. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and set, 16 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
