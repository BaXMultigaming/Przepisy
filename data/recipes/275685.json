  "ingredients": [
    "2 cups white sugar",
    "1.75 cups all-purpose flour",
    "0.33333334326744 cup cocoa powder",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons baking soda",
    "1 teaspoon salt",
    "2 eggs",
    "1 cup pumpkin puree",
    "1 cup milk",
    "0.5 cup canola oil",
    "2 teaspoons vanilla extract",
    "0.33333334326744 cup boiling water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two 12-cup muffin tins with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, flour, cocoa powder, baking powder, baking soda, and salt in the bowl of an electric mixer. Mix briefly until combined. Add pumpkin, milk, canola oil, and vanilla extract; mix on medium speed for 2 minutes. Add water and mix until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each almost all the way to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a cupcake comes out clean, about 20 minutes. Let cool in trays for about 10 minutes before transferring to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
