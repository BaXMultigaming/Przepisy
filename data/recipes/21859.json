  "ingredients": [
    "2 cups whole kernel corn",
    "1.5 cups dry bread crumbs",
    "1 large egg, beaten",
    "2 tablespoons butter, softened",
    "4 thick cut pork chops",
    "1 (10.5 ounce) can condensed cream of mushroom soup"
  ],
