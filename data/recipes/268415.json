  "ingredients": [
    "0.25 cup white sugar",
    "2 tablespoons all-purpose flour",
    "0.25 teaspoon salt",
    "6 tablespoons butter, melted",
    "1 teaspoon coconut extract",
    "3 eggs",
    "8 ounces sweetened cream of coconut (such as Coco Lopez®)",
    "0.5 cup milk",
    "1.5 cups shredded sweetened coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, flour, and salt in a bowl. Add butter and coconut extract. Add eggs 1 at a time, mixing well after each addition. Add cream of coconut and milk. Add shredded coconut. Pour mixture into the prepared pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill completely before serving, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
