  "ingredients": [
    "1 tablespoon kosher salt",
    "1.5 fluid ounces tequila",
    "1 fluid ounce orange flavored liqueur (such as Cointreau®)",
    "0.5 fluid ounce lime juice",
    "1 cup ice",
    "1 lime wheel"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-YWJMA0t3vA3CTHi3PDfCy3riik=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222416-maragrita-cocktail-ddmfs-Step1-0299-9fc08780654a4ec9a308464aaa40e8b2.jpg"
