  "ingredients": [
    "1 (18.25 ounce) package chocolate chip cake mix with pudding",
    "2 eggs",
    "0.5 cup vegetable oil",
    "0.5 cup raisins",
    "0.5 cup rolled oats",
    "1 cup mini semi-sweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the cake mix, eggs, oil, raisins, oatmeal and chocolate chips. Stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoonful onto a greased cookie sheet (Baking stones yield best results). Bake for about 8-10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from oven and let cool for 1 minute before removing from cookie sheet. NOTE: For even more chocolate, put a large chocolate kiss in the center of each cookie 1 minute before removing from oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
