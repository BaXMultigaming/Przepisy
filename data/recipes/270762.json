  "ingredients": [
    "2 whole boneless chicken breasts, quartered lengthwise",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "4 tablespoons all-purpose flour",
    "1 cup water",
    "0.5 cup white sugar",
    "2 lemons, zested and juiced",
    "1 cup sweet rice flour (mochiko)",
    "3 tablespoons cold water, or as needed",
    "2 cups oil for deep frying",
    "3 tablespoons cornstarch",
    "6 tablespoons water",
    "1 egg yolk, beaten",
    "2 lemons, sliced"
  ],
  "steps": [
    {
      "text": "Season chicken with salt and pepper. Roll in flour to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1 cup water, sugar, lemon zest, and juice in a saucepan. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sweet rice flour with enough cold water to make a runny, pancake-like batter. Add a pinch of salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a wok to 400 degrees F (200 degrees C). Dip chicken into the batter. Deep-fry, a few pieces at a time, until light golden brown, 4 to 5 minutes per side. Drain oil and keep chicken warm on a serving platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place lemon mixture over medium-low heat. Dissolve cornstarch in 6 tablespoons water and pour into the saucepan. Stir until mixture reaches a syrupy thickness. Add egg yolk; stir quickly until completely combined. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut chicken into bite-sized pieces and serve with the lemon sauce. Garnish with lemon slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
