  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 medium onion, chopped",
    "0.5 cup chopped dried apricots",
    "0.5 cup finely chopped rhubarb",
    "1 cup couscous",
    "1.25 cups chicken stock",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cumin",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground cardamom",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon ground cayenne pepper",
    "1 pinch ground cloves"
  ],
  "steps": [
    {
      "text": "Heat oil in a saucepan over medium heat. Add onion and cook until soft and translucent, about 5 minutes. Stir in apricots and rhubarb. Cook for 2 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in couscous, chicken stock, salt, cumin, ginger, cardamom, allspice, cinnamon, cayenne, and cloves - mixture will be thick. Stir and bring to a boil. Cover and remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let sit for 10 minutes until all the liquid is absorbed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
