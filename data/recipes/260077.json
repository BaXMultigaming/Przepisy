  "ingredients": [
    "cooking spray",
    "1 pound lean ground turkey",
    "1.5 cups panko bread crumbs, divided",
    "0.5 cup thinly sliced green onions",
    "1 egg, slightly beaten",
    "3 tablespoons soy sauce",
    "1 tablespoon brown sugar",
    "2.5 teaspoons minced fresh ginger root",
    "1.5 teaspoons minced garlic",
    "0.25 cup mayonnaise",
    "1 teaspoon teriyaki sauce",
    "0.25 teaspoon white sugar",
    "4 (4 roll) packages Hawaiian bread rolls (such as King's®)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Cover a baking sheet with aluminum foil and grease with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine turkey, 3/4 cup bread crumbs, green onions, egg, soy sauce, brown sugar, ginger, and garlic in a bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour remaining bread crumbs into a shallow bowl. Roll turkey mixture into sixteen 1 1/2-inch balls with wet hands and coat in bread crumbs. Flatten gently between your palms to create a patty and place on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through and no longer pink in the center, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mayonnaise and teriyaki sauce together in a bowl. Season with sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve turkey sliders on Hawaiian dinner rolls with a small amount of mayo-teriyaki sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
