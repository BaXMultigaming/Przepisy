  "ingredients": [
    "2 cups all-purpose flour",
    "3 teaspoons baking powder",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "0.25 teaspoon salt",
    "2 cups white sugar",
    "1.25 cups vegetable oil",
    "2 cups canned pumpkin",
    "1 teaspoon vanilla extract",
    "4 eggs",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 12x18-inch sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, baking soda, cinnamon, and salt together in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sNWf94bxVpMigHgMKhh1-8EKDPk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19079_PumpkinCakeIII_ddmfs_Step1_3x4_3295-d42bc5a6f57448f8b6c74a44da1429aa.jpg"
      ],
      "image": "assets/images/19079/step_02.webp"
    },
    {
      "text": "Beat sugar and oil together in a large bowl with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P6-yrDTLq0pEW-LQzsyI4u6N9GU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19079_PumpkinCakeIII_ddmfs_Step2_3x4_3304-0715d8f63bd74dd3a9b209c3be316041.jpg"
      ],
      "image": "assets/images/19079/step_03.webp"
    },
    {
      "text": "Blend in pumpkin and vanilla, then beat in eggs one at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jnx_iY1jxboXJcLm1L4TKE9xGKE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19079_PumpkinCakeIII_ddmfs_Step3_3x4_3309-654b4870146a4933a9b338fa1aef405b.jpg"
      ],
      "image": "assets/images/19079/step_04.webp"
    },
    {
      "text": "Gradually beat in flour mixture until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-f3eLOzGEGlDTRjXRXIQPC3QerM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19079_PumpkinCakeIII_ddmfs_Step4_3x4_3310-496e6e52fa894f9dbe14434461d5e68d.jpg"
      ],
      "image": "assets/images/19079/step_05.webp"
    },
    {
      "text": "Stir in walnuts; spread batter into the prepared sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/psPlQBu3KEcYfhsaJKjmy92h3YQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19079_PumpkinCakeIII_ddmfs_Step6_3x4_3321-2861228dedbd4434ad748800711e477c.jpg"
