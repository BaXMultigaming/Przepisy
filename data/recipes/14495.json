  "ingredients": [
    "0.25 cup soy sauce",
    "0.25 cup packed brown sugar",
    "2 tablespoons sherry",
    "1.5 teaspoons dried minced onion",
    "1 teaspoon ground cinnamon",
    "2 tablespoons olive oil",
    "1 pinch garlic powder",
    "2 (3/4 pound) pork tenderloins"
  ],
  "steps": [
    {
      "text": "Place soy sauce, brown sugar, sherry, dried onion, cinnamon, olive oil, and a touch of garlic powder in a large resealable plastic bag. Seal, and shake to mix. Place pork in bag with marinade, seal, and refrigerate for 6 to 12 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil grate. Place tenderloins on grill, and discard marinade. Cook 20 minutes, or to desired doneness. Slice into medallions, and serve.",
      "section": null,
      "name": null,
      "url": null,
