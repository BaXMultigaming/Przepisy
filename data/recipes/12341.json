  "ingredients": [
    "2 cups pitted cherries",
    "2 cups blueberries, rinsed and drained",
    "1.25 cups white sugar",
    "0.25 cup all-purpose flour",
    "1 tablespoon ground cinnamon",
    "0.5 teaspoon lemon juice",
    "1 tablespoon butter",
    "1 recipe pastry for a 9 inch double crust pie"
  ],
  "steps": [
    {
      "text": "Mix sugar, flour, and cinnamon in large bowl. Add fruit. Add lemon juice, and stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into a 9 inch unbaked pie shell. Dot with the butter or margarine. Cover with top crust and flute edges. Cut small slits in the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 1 hour. I put a baking sheet under mine to catch any liquid that might bubble over.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
