  "ingredients": [
    "2 cups low-fat cottage cheese",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "0.5 cup grated Parmesan cheese",
    "2 large eggs, beaten",
    "1 pinch garlic powder, or to taste",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cottage cheese, spinach, Parmesan, and eggs together in a bowl until well combined. Pour mixture into an 8-inch square baking dish and smooth into an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is bubbling along the edges, 20 to 30 minutes. Season with garlic powder, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
