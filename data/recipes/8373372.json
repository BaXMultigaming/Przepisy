  "ingredients": [
    "1 pound large shrimp, peeled and deveined",
    "2 tablespoons olive oil",
    "2 cloves garlic, minced",
    "1 teaspoon Cajun seasoning blend (such as Tony Chachere's®)",
    "0.5 teaspoon freshly ground black pepper",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon cayenne pepper",
    "1 tablespoon chopped fresh parsley",
    "1 medium lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse shrimp under cold running water, dry with paper towels, and transfer to a large bowl. Add olive oil, garlic, Cajun seasoning, pepper, onion powder, and cayenne, and toss to completely coat. Place shrimp in a single layer in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the air fryer for 4 minutes. Flip the shrimp and cook until the shrimp are bright pink on the outside and the meat is opaque, about 2 more minutes. Depending on the size of your air fryer, you may have to cook the shrimp in 2 batches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove shrimp from the air fryer and serve immediately garnished with parsley and lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
