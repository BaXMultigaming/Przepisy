  "ingredients": [
    "0.25 cup white sugar",
    "3 tablespoons unsalted butter, softened",
    "0.5 cup almond meal",
    "1 large egg, lightly beaten",
    "1 tablespoon all-purpose flour",
    "0.5 teaspoon vanilla extract, or to taste",
    "0.125 teaspoon almond extract, or to taste"
  ],
  "steps": [
    {
