  "ingredients": [
    "1 pound ground pork sausage",
    "1 tablespoon butter",
    "6 stalks chopped celery",
    "2 onions, chopped",
    "2 (1 pound) loaves day-old white bread, torn into small pieces",
    "1.5 teaspoons sage seasoning mixture",
    "salt and pepper to taste",
    "2 eggs, lightly beaten",
    "1 cup chicken broth"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork sausage in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Place celery and onions in saucepan; slowly cook and stir until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together sausage, celery, onions, bread, sage, salt, and pepper in a large bowl; add eggs and enough chicken broth to make stuffing mixture moist but not mushy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press stuffing into the prepared baking dish. Bake in the preheated oven for 1 hour, or until top is brown and crisp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
