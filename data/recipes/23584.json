  "title": "Basic Yankee Bread Stuffing",
  "description": "This traditional bread stuffing made with white bread, ground pork sausage, celery, onions, and sage seasoning is moist and flavorsome.",
  "authors": [
    "KRKing911"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
