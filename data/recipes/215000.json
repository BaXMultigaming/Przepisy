  "ingredients": [
    "4 (15 ounce) cans black beans, rinsed and drained",
    "1 (16 ounce) package frozen corn, thawed",
    "1 yellow bell pepper, diced",
    "1 orange bell pepper, diced",
    "1 green bell pepper, diced",
    "0.66666668653488 cup olive oil",
    "0.25 red onion, finely chopped",
    "2 tablespoons red wine vinegar",
    "2 tablespoons balsamic vinegar",
    "2 tablespoons apple cider vinegar",
    "1 tablespoon minced garlic",
    "1 tablespoon chopped fresh cilantro",
    "1 teaspoon salt",
    "1 teaspoon ground cumin",
    "0.25 teaspoon hot sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Stir black beans, corn, yellow, orange, and green bell pepper, olive oil, red onion, red wine vinegar, balsamic vinegar, apple cider vinegar, garlic, cilantro, salt, cumin, and hot sauce together in a non-reactive container. Chill in the refrigerator overnight.",
