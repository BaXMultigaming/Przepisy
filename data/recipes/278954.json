  "ingredients": [
    "vegetable oil cooking spray",
    "0.33333334326744 cup milk",
    "2 teaspoons white vinegar",
    "2 ripe bananas",
    "0.75 cup all-purpose flour",
    "0.75 cup whole wheat flour",
    "0.75 cup rolled oats",
    "1 teaspoon baking powder",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup unsalted butter, at room temperature",
    "0.5 cup brown sugar",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "Topping:",
    "0.33333334326744 cup packed brown sugar",
    "3 tablespoons all-purpose flour",
    "2 tablespoons unsalted butter, softened",
    "0.25 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 10-inch square baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk and vinegar in a glass to make sour milk; stir gently. Mash bananas in a small bowl to make 1 cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine all-purpose flour, whole wheat flour, oats, baking powder, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and brown sugar in a large mixing bowl with an electric mixer until fluffy. Beat in eggs and vanilla extract. Mix in bananas. Add dry ingredients in 2 batches, alternating with sour milk; mix thoroughly. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, flour, and butter for topping together in a bowl. Sprinkle topping over batter, then sprinkle on pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes. Cool on a wire rack before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
