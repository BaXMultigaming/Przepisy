  "ingredients": [
    "1.25 cups confectioners' sugar, divided",
    "0.5 cup butter, softened",
    "1 cup all-purpose flour",
    "0.25 cup quick cooking oats",
    "0.25 cup finely chopped sweetened coconut",
    "0.25 cup finely chopped walnuts",
    "1 pinch salt",
    "15 maraschino cherries, finely chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1/4 cup confectioner's sugar and butter with an electric mixer until smooth. Add flour; beat for 5 seconds. Add oats; beat for 5 seconds. Add coconut; beat for 5 seconds. Add walnuts; beat for 5 seconds. Add salt; beat for 5 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cherries into the butter mixture, beating until dough comes together and turns light pink from cherries, about 25 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of the dough 2 inches apart onto prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until slightly golden, 18 minutes. Remove from oven. Pour remaining 1 cup confectioners' sugar into a shallow dish; roll warm cookies in sugar to coat. After rolling all of the cookies once, roll again in confectioners' sugar to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
