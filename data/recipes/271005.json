  "ingredients": [
    "0.75 cup butter-flavored shortening",
    "1 cup brown sugar",
    "0.5 cup white sugar",
    "1 egg",
    "2 tablespoons milk",
    "1 tablespoon vanilla extract",
    "1.75 cups all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 cup chopped Easter candy, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine shortening and sugars in a stand mixer fitted with the paddle attachment. Mix until creamy. Add egg, milk, and vanilla extract; beat until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, salt, and baking soda together in another bowl. Add to the sugar mixture; blend thoroughly. Add chopped candies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough onto cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are light golden brown, about 11 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
