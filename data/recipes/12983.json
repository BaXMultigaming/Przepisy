      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6eTiPnAo5uLGKPdqv7zNKhCW3gE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-12983-basic-chicken-stock-ddmfs-step2-3x4-e50d4b9844fe4647ae09df86b4ba048a.jpg"
      ],
      "image": "assets/images/12983/step_02.webp"
    },
    {
