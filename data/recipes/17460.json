  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "2 cups white sugar",
    "1.5 cups vegetable oil",
    "4 eggs",
    "3 (4 ounce) jars carrot baby food"
  ],
  "steps": [
