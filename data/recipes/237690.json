    "1 cup unsweetened almond milk",
    "0.5 cup canned pumpkin",
    "1 scoop vanilla protein powder",
    "2 dates, pitted",
    "0.5 teaspoon vanilla extract",
    "1 pinch ground nutmeg",
    "1 pinch ground cinnamon",
    "1 pinch ground cloves",
    "1 pinch ground ginger"
