  "ingredients": [
    "1.5 cups milk",
    "0.25 cup white vinegar",
    "2 cups all-purpose flour",
    "0.25 cup white sugar",
    "0.25 cup unsweetened cocoa powder",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 eggs",
    "0.25 cup butter, melted",
    "2 teaspoons vanilla extract",
    "1 cup mini marshmallows",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Combine milk and vinegar in a large bowl. Set aside for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine flour, sugar, cocoa powder, baking powder, baking soda, and salt in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, butter, and vanilla extract into the milk-vinegar mixture. Add flour mixture and whisk until no lumps remain. Gently fold in marshmallows and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle over medium-high heat. Drop 1/3 cup of batter onto the griddle for each pancake; cook until tops begin to bubble, 3 to 4 minutes. Flip and cook until browned on the other side, 2 to 3 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
