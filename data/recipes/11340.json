  "ingredients": [
    "1 cup semisweet chocolate chips",
    "1 cup packed brown sugar",
    "0.5 cup vegetable oil",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup chopped walnuts",
    "0.5 cup sifted confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Melt the chocolate chips and combine with the brown sugar and vegetable oil. Add the eggs one at a time and beat well. Stir in the vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the flour, baking powder and salt. Add flour mixture to the chocolate mixture. Stir in the chopped walnuts. Chill dough for a few hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop teaspoonfuls of dough in confectioners' sugar and roll to coat. Place cookies on the prepared baking sheets. Bake at 350 degrees F (175 degrees C) for 10 to 12 minutes. Let cookies cool on racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
