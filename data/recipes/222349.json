  "ingredients": [
    "18 jumbo pasta shells",
    "4 cups chopped romaine lettuce",
    "1 cup chopped roma tomatoes",
    "0.5 pound thinly sliced salami",
    "0.75 cup seeded and chopped cucumber",
    "0.75 cup chopped red onion",
    "0.5 cup balsamic vinaigrette salad dressing",
    "1 cup shredded Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add shells and cook, stirring occasionally, until tender but firm to the bite, about 8 minutes. Drain; rinse with cold water until cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine lettuce, tomatoes, salami, cucumber, and red onion in a large bowl. Add vinaigrette; toss salad to coat. Stuff shells with salad; sprinkle with Parmesan cheese.",
