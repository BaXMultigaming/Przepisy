  "ingredients": [
    "1 cup water",
    "1 cup white sugar",
    "1.5 cups fresh mint leaves, divided",
    "0.66666668653488 cup cream of coconut",
    "0.33333334326744 cup lime juice",
    "1 tablespoon grated lime zest",
    "1 cup sparkling water"
  ],
  "steps": [
    {
      "text": "Combine water and sugar in a saucepan; bring to a boil, stirring until sugar is completely dissolved and syrup forms, about 5 minutes. Remove from heat, stir 1 cup mint leaves into mixture, and let steep for 30 minutes. Strain and discard leaves. Transfer syrup to refrigerator to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend coconut, remaining mint leaves, lime juice, and lime zest together in a blender until mint is minced and mixture is well-combined, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir coconut mixture, cooled syrup, and sparkling water together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into an ice cream maker and freeze according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
