  "title": "Air-Fried Sweet and Sour Chicken Wings",
  "description": "Sweet, sour, crispy, and sticky chicken wings made in the air fryer to avoid the mess of deep-frying.",
  "authors": [
    "Soup Loving Nicole"
  ],
  "date_published": "2020-11-17T07:28:47-05:00",
