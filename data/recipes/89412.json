  "ingredients": [
    "2 cups mayonnaise",
    "1 cup buttermilk",
    "3 tablespoons white sugar",
    "1 teaspoon celery seed",
    "0.5 teaspoon ground black pepper",
    "2 (16 ounce) packages shredded coleslaw mix"
  ],
  "steps": [
    {
      "text": "Stir together mayonnaise, buttermilk, sugar, celery seed, and black pepper in a large bowl until well combined. Fold in coleslaw mix until evenly coated. Refrigerate before serving, at least 2 hours.",
