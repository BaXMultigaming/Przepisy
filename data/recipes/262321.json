  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 (7 ounce) package fideo noodles",
    "0.25 white onion, roughly chopped",
    "1 clove garlic, sliced",
    "1.25 cups tomato puree",
    "2 bay leaves",
    "0.75 cup water",
    "1 teaspoon chicken bouillon granules",
    "1 pinch salt to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add noodles; fry until golden brown, about 4 minutes. Transfer to a bowl and set aside. Add onion and garlic to the skillet. Cook and stir until translucent, about 5 minutes. Add tomato puree and bay leaves; cook until heated through, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour tomato mixture carefully into a blender; add water. Cover and hold lid down with a potholder; pulse a few times before leaving on to blend. Pour back into the skillet; add bouillon and salt. Bring to a boil. Reduce heat to low and add the fried noodles. Cook until the noodles are tender and have absorbed most of the tomato sauce, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
