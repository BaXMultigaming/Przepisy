  "ingredients": [
    "1.5 cups unsalted butter",
    "0.75 cup confectioners' sugar",
    "0.75 teaspoon salt",
    "1.5 cups finely ground almonds",
    "4.5 teaspoons vanilla extract",
    "3 cups sifted all-purpose flour",
    "0.33333334326744 cup confectioners' sugar for rolling"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vz2R56Fy_YZ1UQ8qOhEEgH1PY4M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10431-Italian-Wedding-Cookies-ddmfs-4x3-Ingredients-e4bfa3871f3b4fd7bb2bb1aa82993b0a.jpg"
      ],
      "image": "assets/images/10431/step_01.webp"
    },
    {
      "text": "Place butter, 3/4 cup confectioners' sugar, and salt in a large bowl; beat with an electric mixer until smooth and creamy, about 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l9_6RT1uiL14UwqdzJ3hpPuRCTs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10431-Italian-Wedding-Cookies-ddmfs-4x3-steps-02-2f9b375002a349ac99dbb25b9d9aef31.jpg"
      ],
      "image": "assets/images/10431/step_02.webp"
    },
    {
      "text": "Mix in ground almonds and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZVZ5I5CF5YFMuTC3v1XFIkqrtOI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10431-Italian-Wedding-Cookies-ddmfs-4x3-steps-03-697705db000b49c685a11f0f4d2c7593.jpg"
      ],
      "image": "assets/images/10431/step_03.webp"
    },
    {
      "text": "Blend in flour gradually until well-combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_dUX6NiUO5C7YINK6ksj8Tq5dwU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10431-Italian-Wedding-Cookies-ddmfs-4x3-steps-04a-f768334ef59e480e8237edef637e68cc.jpg"
      ],
      "image": "assets/images/10431/step_04.webp"
    },
    {
      "text": "Shape into balls (or crescents) using about 1 teaspoon for each cookie; place 1 inch apart on ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-WYBu6tHXKLB5cr4ZFXF1f9CLl4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10431-Italian-Wedding-Cookies-ddmfs-4x3-steps-05-386baba512554471b4943bb162af9cca.jpg"
      ],
      "image": "assets/images/10431/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until the edges of the cookies are just browned, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cG-2huWaTzWGLbefSmd2eHzSVP4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10431-Italian-Wedding-Cookies-ddmfs-4x3-steps-06-b0835f9098ab427187cbe7027dd7bc8f.jpg"
      ],
      "image": "assets/images/10431/step_06.webp"
    },
    {
      "text": "Let sit until slightly cooled, about 15 minutes. Roll cookies in remaining confectioners' sugar. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EXkRYZgDc0m23A6T-5Ma8ekBq4I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-10431-Italian-Wedding-Cookies-ddmfs-4x3-hero-c22c533ef2544898b509f327b9b2f55a.jpg"
