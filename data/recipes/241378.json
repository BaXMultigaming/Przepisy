  "ingredients": [
    "1 (4 pound) package pork spareribs",
    "1 pinch garlic salt, or to taste",
    "1 cup ketchup",
    "0.5 cup white vinegar",
    "0.25 cup white sugar",
    "4 teaspoons celery salt",
    "1.5 teaspoons chili powder",
    "1 teaspoon salt",
    "1 teaspoon dry mustard",
    "1 teaspoon paprika",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle ribs with garlic salt and place into a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ketchup, vinegar, sugar, celery salt, chili powder, salt, dry mustard, paprika, and black pepper together in a bowl; pour over the ribs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook, basting with the pan drippings every half-hour, until the meat pulls away easily from the bone, about 90 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
