  "title": "Sugarless Applesauce Cake",
  "description": "Applesauce and an artificial brown sugar replacement pair to make this raisin-studded cake.",
  "authors": [
    "Jenny"
  ],
  "date_published": "1999-09-16T03:16:09-04:00",
