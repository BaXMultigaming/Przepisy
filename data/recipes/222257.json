  "ingredients": [
    "cooking spray",
    "1 pound ground beef",
    "2 cups chopped onion",
    "2 (16 ounce) cans pork and beans",
    "1 (16 ounce) can kidney beans, drained",
    "1 cup ketchup",
    "0.75 cup brown sugar",
    "2 tablespoons mustard",
    "1 tablespoon white vinegar",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir ground beef and onion in a skillet over medium heat until beef is browned and onion is translucent, 10 to 15 minutes. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pork and beans, kidney beans, ketchup, brown sugar, mustard, vinegar, and salt in a large bowl; add ground beef mixture. Transfer to the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
