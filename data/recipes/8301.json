  "ingredients": [
    "3 very ripe bananas",
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "0.25 cup butter, softened",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash bananas in a large bowl. Add flour, sugar, butter, egg, vanilla, baking soda, and baking powder; mix until well combined. Pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of loaf comes out clean, 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
