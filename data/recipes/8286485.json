  "ingredients": [
    "cooking spray",
    "1 (15.5 ounce) can garbanzo beans, drained",
    "1 (15.5 ounce) can dark red kidney beans, drained",
    "1 (16 ounce) package firm tofu, drained",
    "1 (15 ounce) can tomato sauce",
    "1 cup rolled oats",
    "1 medium green bell pepper, diced",
    "1 tablespoon dry vegan egg replacer",
    "1 teaspoon onion powder",
    "1 teaspoon garlic powder",
    "1 pinch oregano, or to taste",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine garbanzo beans and kidney in a food processor; pulse until smooth. Crumble tofu into the food processor; pulse until well combined and mixture resembles ground meat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer mixture to a large bowl. Add tomato sauce, oats, bell pepper, onion, egg replacer, onion powder, garlic powder, oregano, and salt; mix by hand until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form mixture into a loaf shape and place in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through, about 1 hour 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
