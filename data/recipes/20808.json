  "ingredients": [
    "0.25 cup vegetable oil",
    "0.5 cup unpopped popcorn kernels",
    "0.25 cup white sugar"
  ],
  "steps": [
    {
      "text": "Gather this ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G5aRhxmopXxAzWp38hDy8hFeCn8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20808-kettle-corn-ddmfs-Step1-923fab13429a4b30a01093f49f8662f6.jpg"
      ],
      "image": "assets/images/20808/step_01.webp"
    },
    {
      "text": "Heat vegetable oil in a large pot over medium heat. Stir in popcorn kernels and sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Db34HYcy8-R1YLL7AeYJV9gbsNE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20808-kettle-corn-ddmfs-Step2-ceb80f284d9c40fa9cd650d940648182.jpg"
      ],
      "image": "assets/images/20808/step_02.webp"
    },
    {
      "text": "Cover and shake the pot constantly to prevent sugar from burning. When popping has slowed to once every 2 to 3 seconds, remove the pot from the heat and shake for a few minutes until popping stops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P_wezgqgj17gWgvKh1pp7Wxc-18=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20808-kettle-corn-ddmfs-Step3-f7626a6299e7499a8aa1086173f23a08.jpg"
      ],
      "image": "assets/images/20808/step_03.webp"
    },
    {
      "text": "Pour popcorn into a large bowl and allow to cool, stirring occasionally to break up large clumps.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ru5G_e99e2BXPXUXgJqjYUZepL8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20808-kettle-corn-ddmfs-Step5-6d23cbd9e1dd418e8f6be55edbf87a80.jpg"
      ],
      "image": "assets/images/20808/step_04.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
