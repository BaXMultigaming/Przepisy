  "ingredients": [
    "4 medium russet potatoes, scrubbed",
    "1 tablespoon olive oil, or as needed",
    "1.5 teaspoons salt",
    "1.5 teaspoons ground black pepper",
    "1 teaspoon onion powder"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place potatoes onto a plate and use your hands to lightly cover them all over with olive oil. Sprinkle with salt, pepper, and onion powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 30 minutes, flipping over with tongs halfway through cooking. Let cool for a few minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
