  "title": "Coconut Chickpea Curry",
  "description": "This is an easy and delicious vegetarian curry with coconut milk, chick peas, and spinach. Serve over rice.",
  "authors": [
    "Ita Mac Airt"
  ],
  "date_published": "2023-02-23T12:00:00-05:00",
