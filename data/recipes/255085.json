  "ingredients": [
    "1 (30 ounce) can mango slices with juice",
    "3 cups water, divided",
    "4 (.25 ounce) packages powdered gelatin",
    "1 cup white sugar",
    "2 cups heavy whipping cream",
    "2 tablespoons heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Drain mango slices, reserving 1/2 cup juice. Place mango slices and reserved juice in a bowl. Beat with an electric mixer until pureed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring 2 cups water to a boil in a large saucepan. Add gelatin; stir quickly until dissolved. Pour in sugar and stir until dissolved. Add remaining 1 cup water. Remove from heat and let cool, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pureed mango and 2 cups plus 2 tablespoons heavy cream into the water mixture; mix well. Pour into 8 dessert cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate until set, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
