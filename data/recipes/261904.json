  "ingredients": [
    "1 cup packed brown sugar",
    "0.66666668653488 cup melted butter",
    "0.25 cup light corn syrup",
    "0.25 cup peanut butter",
    "0.5 teaspoon vanilla extract",
    "4 cups quick-cooking oats",
    "1 cup semisweet chocolate chips",
    "0.5 cup butterscotch chips",
    "0.33333334326744 cup peanut butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Butter a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, butter, corn syrup, 1/4 cup peanut butter, and vanilla extract in a bowl. Add oats gradually. Press bar mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 12 to 14 minutes. Let cool for 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate chips, butterscotch chips, and 1/3 cup peanut butter in a microwave-safe bowl in 15-second intervals, stirring after each melting until blended, 1 to 3 minutes. Spread over warm bars. Let cool before cutting, 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
