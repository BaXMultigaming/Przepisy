    "2 tablespoons soy sauce",
    "2 tablespoons crunchy peanut butter",
    "1 tablespoon brown sugar",
    "1 teaspoon garlic powder",
    "0.125 teaspoon ground ginger",
    "0.125 teaspoon cayenne pepper"
