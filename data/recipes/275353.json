  "ingredients": [
    "1 (16 ounce) can blueberry pie filling",
    "8.25 ounces gluten-free yellow cake mix",
    "0.5 cup gluten-free oats (such as Bob's Red Mill®)",
    "0.5 cup sliced almonds",
    "0.25 cup melted butter",
    "1 tablespoon white sugar",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour blueberry filling in a 9x9-inch baking dish and smooth to even out in the dish. Sprinkle dry cake mix over the filling, smoothing evenly to cover the top. Sprinkle with oats and almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour melted butter over the top, covering evenly. Mix sugar and cinnamon in a small bowl; sprinkle evenly on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is bubbly and top is brown, 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cool for 30 minutes. Serve warm or cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
