  "ingredients": [
    "1.5 cups dried black beans, rinsed",
    "1.5 cups dried pinto beans, rinsed",
    "1.5 cups dried kidney beans, rinsed",
    "1 pound andouille sausage, chopped",
    "1 pound lean ground beef",
    "1 large onion, chopped",
    "1 bell pepper, chopped",
    "2 cloves cloves garlic, minced",
    "1 cup corn",
    "1 cup water",
    "0.75 cup salsa",
    "0.75 cup tomato-based chili sauce",
    "2 tablespoons white vinegar",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place black beans, pinto beans, and kidney beans in a large pot and cover with several inches of cool water; let stand for at least 12 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring beans and water to a boil in the large pot; cook until beans are tender and heated through, about 30 minutes. Drain beans and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir sausage, beef, onion, bell pepper, and garlic in a large skillet over medium-high heat until meat is browned and crumbly, 5 to 10 minutes. Drain and discard fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beans, sausage mixture, corn, water, salsa, chili sauce, and vinegar into a slow cooker; stir until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for at least 4 hours, stirring occasionally. Season with salt and ground black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
