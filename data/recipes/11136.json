  "ingredients": [
    "2 cups white sugar",
    "0.5 cup shortening",
    "0.5 cup butter",
    "3 eggs",
    "5 teaspoons baking powder",
    "0.5 cup milk",
    "4 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease two cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream the sugar with the shortening and the butter or the margarine. Add the baking powder, eggs, milk and flour. Mix until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a lightly floured surface roll out the dough to 1/4 inch thick and cut into desired shapes. Place cookies on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
