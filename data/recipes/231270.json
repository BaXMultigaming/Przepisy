  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1 cup flour and confectioners' sugar together in a bowl; cut in butter using a pastry blender or two forks until mixture is crumbly. Press crust mixture into an 8-inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk white sugar, ¼ cup flour, baking powder, and nutmeg together in a bowl; set aside. Beat eggs together in a bowl; stir in white sugar mixture until combined. Fold in rhubarb; pour filling into baked crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
