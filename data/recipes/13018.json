  "ingredients": [
    "2 tablespoons butter",
    "1 onion, thinly sliced",
    "1 small potatoes, thinly sliced",
    "2 cups fresh chopped broccoli",
    "1.5 cups chicken broth",
    "0.25 teaspoon salt",
    "ground black pepper to taste",
    "0.5 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan; do not brown. Add onion, potato, and broccoli; toss to coat with butter. Press parchment paper over the vegetables; this is called \"sweating\" and adds better flavor. Cover the pan and simmer very gently until vegetables have softened; do not brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and discard the parchment paper. Add chicken broth and bring to a boil. Reduce the heat and simmer until vegetables are soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée with an immersion blender until smooth. Add salt, pepper, and cream. Simmer gently until heated through; do not boil or cream will curdle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
