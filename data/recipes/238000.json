  "ingredients": [
    "0.5 cup quick-cooking oats",
    "1 tablespoon chopped walnuts",
    "2 teaspoons brown sugar",
    "1 teaspoon ground flax",
    "1 teaspoon chia seeds",
    "0.5 teaspoon sesame seeds",
    "0.25 teaspoon ground cinnamon",
    "1 pinch ground nutmeg",
    "1 pinch salt",
    "1 cup boiling water",
    "0.25 cup frozen blueberries, thawed"
  ],
  "steps": [
    {
      "text": "Mix oats, walnuts, brown sugar, flax, chia seeds, sesame seeds, cinnamon, nutmeg, and salt together in a bowl. Pour boiling water over the oats mixture and stir so ingredients are completely moistened; steep until the oats are softened, about 2 minutes. Stir blueberries through the oats mixture.",
