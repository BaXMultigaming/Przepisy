  "title": "Tiramisu",
  "description": "This tiramisu is made with layers of coffee and rum-soaked ladyfingers, homemade mascarpone custard, cream, and cocoa for a decadent Italian dessert.",
  "authors": [
    "Christine"
  ],
  "date_published": "2000-06-11T01:21:32-04:00",
