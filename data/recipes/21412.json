    "publisher-tested"
  ],
  "ingredients": [
    "6 large egg yolks",
    "0.75 cup white sugar",
    "0.66666668653488 cup milk",
    "1.25 cups heavy cream",
    "0.5 teaspoon vanilla extract",
    "1 pound mascarpone cheese, at room temperature",
    "0.25 cup strong brewed coffee, at room temperature",
    "2 tablespoons rum",
    "2 (3 ounce) packages ladyfinger cookies",
    "1 tablespoon unsweetened cocoa powder"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ItOMNlosB8P3YY302dJvI6lGBlE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21412-Teramisu-ii-DDMFS-Step1-11926-20f7fc6cc8904c80b00b84a4eebf8abc.jpg"
      ],
      "image": "assets/images/21412/step_01.webp"
    },
    {
      "text": "Whisk egg yolks and sugar together in a medium saucepan until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jelbq7zRwkvOeNq3wQXjmz8eVYA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21412-Teramisu-ii-DDMFS-Step2-11929-2d0b6841c32a437d9f20008d17306282.jpg"
      ],
      "image": "assets/images/21412/step_02.webp"
    },
    {
      "text": "Whisk in milk and cook over medium heat, stirring constantly, until mixture comes to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eNxE9qCNkxECvRQRWAHqH17aNak=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21412-Teramisu-ii-DDMFS-Step3-11930-6be215c729c742e0b25be8ff6fab0109.jpg"
      ],
      "image": "assets/images/21412/step_03.webp"
    },
    {
      "text": "Boil gently for 1 minute, then remove from the heat and allow to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AmtUUAqnPbcUcMSZO8kiP-O9uKw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21412-Teramisu-ii-DDMFS-Step4-11931-5da5a752d96342b683a7a7a090839f2e.jpg"
      ],
      "image": "assets/images/21412/step_04.webp"
    },
    {
      "text": "Cover tightly and chill in the refrigerator for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vCzLT6dEW4_GGdHBu1Kuc7q7Kjg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21412-Teramisu-ii-DDMFS-Step5-11932-a69ac4fe58ce4f998cc6c1f70a651a47.jpg"
      ],
      "image": "assets/images/21412/step_05.webp"
    },
    {
      "text": "Beat cream and vanilla in a medium bowl with an electric mixer until stiff peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KeNMeeGVEH301RQObTIJ6If4qKc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21412-Teramisu-ii-DDMFS-Step6-11934-c9175b0f8bf24967b968f1b6fa602ab4.jpg"
      ],
      "image": "assets/images/21412/step_06.webp"
    },
    {
      "text": "Remove egg yolk mixture from the refrigerator; add mascarpone cheese and whisk until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8j4-M784WM4uPDcwgThGPwyLyB4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21412-Teramisu-ii-DDMFS-Step7-11935-b7f5f78375654d03a5731c8e909742c5.jpg"
      ],
      "image": "assets/images/21412/step_07.webp"
    },
    {
      "text": "Combine coffee and rum in a small bowl. Split ladyfingers in half lengthwise and drizzle with the coffee mixture. Arrange 1/2 of the soaked ladyfingers in the bottom of a 7x11-inch dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F33nmK0G2Ojk_LtuUu-AkfZWo4c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21412-Teramisu-ii-DDMFS-Step8-11937-40630467a34249229c07fe385956ad8b.jpg"
      ],
      "image": "assets/images/21412/step_08.webp"
    },
    {
      "text": "Spread 1/2 of the mascarpone mixture over the ladyfingers, then spread 1/2 of the whipped cream over top. Repeat layers once more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HfTCemCcmOLIRVS3ZNXmFS8tf60=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21412-Teramisu-ii-DDMFS-Step9-11939-8cf8757840d94b3d965560acd0869089.jpg"
      ],
      "image": "assets/images/21412/step_09.webp"
    },
    {
      "text": "Sprinkle cocoa powder over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-b6u2Vd6dnEV6p94d8rT36yjtXA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21412-Teramisu-ii-DDMFS-Step10-11940-2f7d42f55e764506b2a0519902148f65.jpg"
      ],
      "image": "assets/images/21412/step_10.webp"
    },
    {
      "text": "Cover and refrigerate until set, 4 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D1IJge7TMhf8ufUR9EuAa5D1wEA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21412-Teramisu-ii-DDMFS-Step11-11941-cb7b8a5b083b453ead14040ce2c2ecac.jpg"
      ],
      "image": "assets/images/21412/step_11.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OJXZYI1d1bHEcobLAzzSzpGRGjs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21412-Teramisu-ii-DDMFS-3x4-12023-13745e4a6c974f7c83150b14f837b4c3.jpg"
      ],
      "image": "assets/images/21412/step_12.webp"
    }
