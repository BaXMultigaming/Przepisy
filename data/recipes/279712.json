  "ingredients": [
    "5 cups water",
    "5 cups cubed potatoes",
    "2 cups chopped onion",
    "0.5 cup chopped celery",
    "0.25 cup salted butter",
    "4 cubes chicken bouillon",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "1 pinch garlic powder",
    "1 cup cold water",
    "1.5 tablespoons cornstarch",
    "1 pint heavy whipping cream",
    "1 (12 ounce) can evaporated milk",
    "1 tablespoon chopped fresh chives, or to taste"
  ],
  "steps": [
    {
      "text": "Combine 5 cups water, potatoes, onion, celery, butter, bouillon cubes, salt, pepper, and garlic powder in a slow cooker. Cook until vegetables are tender, on Low for 8 to 9 hours or on High, about 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cold water and cornstarch together in a small bowl. Stir 1/2 of the cornstarch mixture, heavy cream, and evaporated milk into the soup and cook for 1 more hour until thickened, adding more of the cornstarch mixture if desired for consistency. Top with chives before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
