  "ingredients": [
    "0.25 pound bacon",
    "4 skinless, boneless chicken breast halves - cut into strips",
    "1 teaspoon Cajun seasoning",
    "1 tablespoon light olive oil",
    "1 head romaine lettuce- rinsed, dried and chopped",
    "0.5 cup Caesar salad dressing",
    "0.33333334326744 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown; crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a preheated skillet, add chicken, seasoning mix, and oil. Cook until chicken is golden brown and cooked through. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a salad bowl, combine Romaine, enough salad dressing to coat, Parmesan cheese, and crumbled bacon; toss and place on individual salad plates. Top with chicken and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
