  "ingredients": [
    "6 dried ancho chiles",
    "3 cups beef broth",
    "1 (6 ounce) can tomato paste",
    "0.25 cup corn oil",
    "2 cloves garlic, minced",
    "1.5 teaspoons salt",
    "1 teaspoon dried oregano",
    "0.25 teaspoon ground cumin"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange ancho chiles on a baking sheet. Bake in the preheated oven until toasted 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and discard stems and seeds from toasted peppers. Place peppers in a bowl; add enough hot water to bowl until peppers completely covered. Soak for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ancho chiles, about 1 cup broth, tomato paste, oil, garlic, salt, oregano, and cumin in a blender; blend until smooth. Combine ancho chile mixture and remaining 2 cups beef broth in a saucepan over medium heat; simmer until heated through, about 10 minutes.",
      "section": null,
