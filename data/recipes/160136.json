  "ingredients": [
    "1.5 pounds lean ground beef",
    "1 cup chopped onion",
    "2 cups frozen green beans, thawed",
    "1 cup frozen corn niblets, thawed",
    "1 (14.5 ounce) can diced tomatoes, drained",
    "1 (12 ounce) jar beef gravy",
    "1 teaspoon dried thyme leaves",
    "0.5 teaspoon salt",
    "1 (24 ounce) package Simply Potatoes® Mashed Potatoes"
  ],
  "steps": [
    {
      "text": "Heat oven to 375 degrees F. Spray 2-1/2 to 3 quart casserole baking dish with nonstick cooking spray.*",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In 12-inch skillet cook ground beef and onion until browned; drain grease. Add beans, corn, tomatoes, gravy, thyme and salt. Cook until heated through. Spoon beef mixture into casserole dish. Spread Simply Potatoes® evenly over beef mixture. Bake 30 to 35 minutes or until edges are bubbly. Remove from oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat broiler. Broil casserole 4 to 6 inches from heat, 3 to 5 minutes, until Simply Potatoes® are lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
