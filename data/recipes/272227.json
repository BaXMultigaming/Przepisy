  "ingredients": [
    "1.75 cups all-purpose flour",
    "0.5 cup whole wheat flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup buttermilk",
    "0.5 cup melted butter",
    "0.5 cup honey",
    "0.5 cup brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 cup diced apple",
    "1 cup shredded carrot",
    "2 tablespoons chia seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 16 muffin cups with liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine all-purpose flour, whole wheat flour, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat buttermilk, melted butter, honey, brown sugar, egg, and vanilla extract in another bowl. Stir in flour mixture. Fold in apple, carrot, and chia seeds. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool for 5 minutes before transferring to a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
