    },
    {
      "text": "Mix green beans, condensed cream of mushroom soup, milk, and half of the fried onions together in a 1.5-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XHvvpniGodYQRbXQeNk8QCSeExI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13660-green-bean-casserole-i-VAT-step-02-add27d8a20e64d8e8d392ffe24799583.jpg"
      ],
      "image": "assets/images/13660/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until bubbly, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JGe-cr1eXhUC_9oa_SFB394OplU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13660-green-bean-casserole-i-VAT-step-03-557765b4fd6e46c09a64daaa1b4d619d.jpg"
      ],
      "image": "assets/images/13660/step_03.webp"
