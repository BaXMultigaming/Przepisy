  "ingredients": [
    "cooking spray",
    "3 tablespoons butter",
    "0.5 cup diced celery",
    "0.25 cup minced onion",
    "0.5 teaspoon paprika",
    "0.25 teaspoon seafood seasoning (such as Old Bay®)",
    "0.25 teaspoon ground thyme",
    "0.25 teaspoon kosher salt, or to taste",
    "0.125 teaspoon ground white pepper",
    "0.25 cup rice flour",
    "1 cup seafood stock, or more as needed",
    "1 pint half-and-half",
    "1 pint heavy whipping cream",
    "0.5 cup milk",
    "2 cups cooked crabmeat"
  ],
  "steps": [
    {
      "text": "Spray a stockpot with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in the prepared stockpot over medium heat; cook and stir celery, onion, paprika, seafood seasoning, thyme, salt, and white pepper until onion is translucent, about 5 minutes. Whisk flour into vegetable mixture until smooth and dissolved. Pour seafood stock over vegetable mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix half-and-half, cream, and milk into broth mixture; decrease heat and simmer until bisque is thickened, about 15 minutes. Add crabmeat and simmer bisque until crabmeat is heated through, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
