  "ingredients": [
    "1.5 cups dark brown sugar",
    "1 cup unsalted butter",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1 cup solid pack pumpkin puree",
    "2.25 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon pumpkin pie spice",
    "10 ounces white chocolate, chopped",
    "0.5 cup pecan halves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C) Grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter together in a bowl with an electric mixer until smooth; beat in 1 egg. Beat in remaining 1 egg with vanilla extract: stir in pumpkin purée until well blended. Combine flour, baking soda, and pumpkin pie spice in a separate bowl; stir into pumpkin mixture. Fold in white chocolate and pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 20 to 22 minutes. Cool cookies on baking sheets for 5 minutes; transfer cookies to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
