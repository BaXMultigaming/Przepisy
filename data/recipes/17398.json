  "ingredients": [
    "1 cup butter",
    "2 cups white sugar",
    "4 eggs",
    "2.5 cups self-rising flour",
    "1 cup milk",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour three 8-inch pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar together in a medium bowl. Beat in eggs one at a time. Combine milk and vanilla; add to the creamed mixture alternately with flour, ending with flour. Mix just until combined. Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cake in the preheated oven until a skewer inserted into the center comes out clean, about 15 to 20 minutes. Let cool in the pans for a few minutes, then transfer to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
