  "title": "Grandma&#39;s Moist Cake",
  "description": "This very moist yellow cake recipe comes from my boyfriend&#39;s grandmother. We usually serve it with chocolate buttermilk icing.",
  "authors": [
    "Patricia"
  ],
  "date_published": "1999-03-30T16:57:52-05:00",
