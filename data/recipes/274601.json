  "ingredients": [
    "2 teaspoons ground cumin",
    "1.5 teaspoons sumac powder",
    "1 teaspoon toasted sesame seeds",
    "0.5 teaspoon salt",
    "0.5 teaspoon dried thyme",
    "0.25 teaspoon oregano",
    "0.25 teaspoon dried marjoram",
    "0.25 cup grapeseed oil",
    "2 tablespoons lemon juice",
    "1 pound boneless, skinless chicken breasts, butterflied",
    "nonstick cooking spray"
  ],
  "steps": [
    {
      "text": "Combine cumin, sumac powder, sesame seeds, salt, thyme, oregano, and marjoram in a 1-gallon resealable plastic bag. Add grapeseed oil and lemon juice; mix to combine. Add chicken breast, mix with seasoning, and marinate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray the grate of the grill with cooking spray, and preheat the grill to 500 degrees F (260 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill chicken breasts, flipping halfway, until no longer pink in the center and the juices run clear, 7 to 8 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
