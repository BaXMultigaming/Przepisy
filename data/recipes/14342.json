  "ingredients": [
    "1 cup vegetable oil",
    "0.75 cup white wine vinegar",
    "1 cup white sugar",
    "0.5 cup ketchup",
    "0.5 teaspoon salt",
    "2 teaspoons Worcestershire sauce",
