  "ingredients": [
    "1 pound ground turkey",
    "0.5 onion, finely chopped",
    "0.5 cup egg substitute",
    "2 tablespoons minced fresh basil",
    "1 clove garlic, minced",
    "1 teaspoon prepared horseradish",
    "1 teaspoon light soy sauce",
    "0.25 teaspoon ground black pepper",
    "4 whole wheat hamburger buns, split",
    "4 leaves lettuce leaves",
    "4 slices tomato"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground turkey, onion, egg substitute, basil, garlic, horseradish, soy sauce, and black pepper in a bowl; form into 4 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until no longer pink in centers and juices run clear, about 6 minutes per side. An instant-read thermometer inserted into centers should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve patties on buns with lettuce and tomato.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
