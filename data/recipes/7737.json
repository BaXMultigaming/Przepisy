  "ingredients": [
    "4 cups confectioners' sugar",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup unsweetened cocoa powder",
    "0.25 cup butter, softened",
    "4 tablespoons milk",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Beat confectioner’s sugar, cream cheese, cocoa powder, butter, 3 tablespoons milk, vanilla, and cinnamon together in a large bowl until it reaches a spreadable consistency. Beat in remaining 1 tablespoon milk if necessary. Pipe or spread frosting onto cooled cake or cupcakes.",
