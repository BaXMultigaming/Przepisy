  "ingredients": [
    "12 large chocolate chip cookies",
    "1 cup white sugar",
    "2 tablespoons flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup butter, softened",
    "3 eggs",
    "2 teaspoons vanilla extract",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease a 9x13-inch cake pan or baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Process chocolate chip cookies in a food processor until completely crumbled. Add sugar, flour, baking powder, and cinnamon to cookie crumbs; pulse to combine. Add butter, eggs, and vanilla to cookie mixture; process until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk into cookie mixture while food processor is running; blend until batter is evenly mixed. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 40 minutes. Cool in the pans for 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
