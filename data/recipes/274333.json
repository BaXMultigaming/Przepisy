  "ingredients": [
    "2 cups rhubarb, cut into 1/2 inch pieces",
    "2 cups strawberries, hulled and quartered",
    "0.25 cup water",
    "3 tablespoons fresh orange juice",
    "2 tablespoons honey, or more to taste",
    "1 star anise pod",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Combine rhubarb, strawberries, water, orange juice, honey, star anise pod, and salt in a small pot and bring to a slow boil over medium heat. Reduce heat, cover, and simmer for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the lid and simmer until fruit is soft, about 5 more minutes. Turn off heat and allow to cool completely. Remove star anise and place compote into jars. Use within a few days and keep refrigerated.",
      "section": null,
      "name": null,
      "url": null,
