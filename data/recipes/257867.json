  "ingredients": [
    "1 pound ground beef",
    "0.5 cup water",
    "3 tablespoons taco seasoning mix",
    "1 (8 ounce) package refrigerated crescent rolls",
    "4 slices pepper Jack cheese, halved on the diagonal",
    "1 Roma tomato, chopped",
    "1 tablespoon chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir beef in a large skillet until browned, 5 to 8 minutes. Drain excess grease. Stir in water and taco seasoning mix. Cover and keep at a simmer over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll crescent dough triangles onto the prepared baking sheet. Cut each triangle in half. Top dough triangles with pepper Jack cheese slices. Divide beef mixture evenly over cheese; top with tomato and cilantro. Fold up dough to enclose filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 13 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
