  "ingredients": [
    "3 eggs",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "0.33300000429153 cup unsweetened cocoa powder",
    "1.5 teaspoons vanilla extract",
    "2 cups grated zucchini",
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground cardamom"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 12-cup muffin tins or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3B81T89sySPOkRTWSNAY4Saf36E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7167-chocolate-zucchini-muffins-VAT-step-01-e349ea8e2c8845ac8550366b638114ac.jpg"
      ],
      "image": "assets/images/7167/step_01.webp"
    },
    {
      "text": "Whisk eggs in a large bowl until smooth. Add sugar, oil, cocoa, and vanilla; whisk until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1B-HPaGY_v5cxzJFqiqG1qpYvI4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7167-chocolate-zucchini-muffins-VAT-step-02-0a34887bcee94196ade53b52ef0d9f47.jpg"
      ],
      "image": "assets/images/7167/step_02.webp"
    },
    {
      "text": "Stir in grated zucchini. Add flour, baking soda, salt, baking powder, cinnamon, nutmeg, cloves, and cardamom; mix until just moist.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cJGKZm1pzOHOPV1sKBhi5d-nweQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7167-chocolate-zucchini-muffins-VAT-step-03-904f468df9bb433a93f69c948cdbbc66.jpg"
      ],
      "image": "assets/images/7167/step_03.webp"
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gbhOYfIRszG3PjPrlBiiDSeALrY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7167-chocolate-zucchini-muffins-VAT-step-04-a151b0fa5f3b40a6949ae2fe73109631.jpg"
      ],
      "image": "assets/images/7167/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 20 to 25 minutes. Transfer to a wire rack to cool completely; store loosely covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FS-NDr4hPuGG3nU01L82CNDZ_Eo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7167-chocolate-zucchini-muffins-VAT-step-05-ad4b9ea4a51549cd888294ad4a1fff08.jpg"
      ],
      "image": "assets/images/7167/step_05.webp"
    }
