  "ingredients": [
    "1 cup uncooked long grain rice",
    "0.5 cup pineapple juice",
    "1 cup water",
    "0.5 cup crushed pineapple",
    "2 teaspoons butter",
    "0.5 teaspoon grated lime zest",
    "0.25 teaspoon salt",
    "0.25 cup minced fresh cilantro",
    "0.25 cup chopped green onions",
    "2 tablespoons lime juice"
  ],
  "steps": [
    {
      "text": "Bring the rice, pineapple juice, water, pineapple, butter, lime zest, and salt to a boil in a saucepan over high heat. Reduce heat to medium-low, cover, and simmer until the rice is tender, and the liquid has been absorbed, 20 to 25 minutes. Stir in the cilantro, green onions, and lime juice to serve.",
