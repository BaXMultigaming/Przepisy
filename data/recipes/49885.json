  "ingredients": [
    "0.125 cup water",
    "1 bunch fresh spinach, rinsed and stemmed",
    "0.33333334326744 cup cream cheese, softened",
    "1 pinch salt",
    "4 teaspoons lemon juice"
  ],
  "steps": [
    {
      "text": "Bring the water to a boil in a skillet over medium heat. Add spinach all at once, and reduce heat slightly. Cover, and let cook for about 3 minutes, or until spinach is not quite tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the cream cheese and lemon juice, and season with salt. Cook, stirring, until the cream cheese is melted and well blended. Serve immediately.",
