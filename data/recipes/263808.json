  "ingredients": [
    "2 tomatoes, cubed",
    "1 red bell pepper, seeded and cubed",
    "1 onion, minced",
    "2 tablespoons olive oil",
    "2 tablespoons chopped fresh basil",
    "1 clove garlic, minced",
    "aluminum foil",
    "4 (5 ounce) cod fillets",
    "1 lemon, juiced",
    "salt and ground black pepper to taste"
  ],
  "steps": [
