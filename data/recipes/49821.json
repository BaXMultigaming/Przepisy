  "ingredients": [
    "2 cups butter, softened",
    "1.5 cups white sugar",
    "1 teaspoon almond extract",
    "4 cups all-purpose flour",
    "0.25 teaspoon salt",
    "1 cup whole almonds"
  ],
  "steps": [
    {
      "text": "In a large bowl, cream together the butter, sugar, and almond extract until smooth. Combine the flour and salt; stir into the butter mixture until well blended. Cover and refrigerate for 3 to 4 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Drop cookies by teaspoonfuls onto cookie sheets, and press down slightly with the bottom of a glass. Place a whole almond on top of each cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes in the preheated oven, or until firm. Remove cookies from cookie sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
