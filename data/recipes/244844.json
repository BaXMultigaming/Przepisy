  "ingredients": [
    "1 (9 inch) pie crust pastry",
    "1 (12 ounce) can evaporated milk",
    "1 cup cooked acorn squash",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "2 large eggs",
    "1 teaspoon ground cinnamon",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Press pie crust dough into a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat evaporated milk, squash, white sugar, brown sugar, eggs, cinnamon, vanilla extract, and salt together in a bowl using an electric mixer until smooth; pour into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C); continue baking until pie center is set, about 30 minutes more.",
