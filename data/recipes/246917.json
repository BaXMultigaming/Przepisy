  "ingredients": [
    "2 cups all-purpose flour",
    "1.5 cups water",
    "1 cup sourdough starter",
    "0.5 cup vegetable oil",
    "2 eggs",
    "2 tablespoons white sugar",
    "2 teaspoons salt",
    "1 tablespoon water",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Mix flour, 1 1/2 cups water, and sourdough starter together in a large bowl to make batter; cover loosely with plastic wrap and let sit in a warm place until filled with large holes and bubbles, 4 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oil, eggs, sugar, and salt into the batter; mix well to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1 tablespoon water and baking soda together in a small bowl until dissolved. Fold into the batter with a rubber spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a waffle iron according to the manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour about 1/3 cup batter onto preheated iron and bake until crisp and golden, according to manufacturer's instructions, about 3 minutes. Continue making waffles until all remaining batter is used.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
