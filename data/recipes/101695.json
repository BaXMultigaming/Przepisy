  "ingredients": [
    "3 tablespoons all-purpose flour",
    "3 tablespoons brown sugar",
    "0.25 teaspoon ground cinnamon",
    "2 tablespoons butter",
    "1.75 cups all-purpose flour",
    "0.33333334326744 cup white sugar",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "2 packets instant maple and brown sugar oatmeal",
    "1 egg, beaten",
    "1 cup milk",
    "0.25 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 3 tablespoons flour, brown sugar, and cinnamon in a small bowl. Use a pastry blender or two knives to cut in the butter until the mixture resembles coarse crumbs. Reserve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 3/4 cup flour, white sugar, baking powder, salt, and the instant oatmeal in a large bowl. Make a well in the center of the flour mixture; pour in the egg, milk, and oil. Stir just until moistened. Spoon batter into prepared muffin cups, filling each 2/3 full. Evenly sprinkle streusel topping over muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until toothpick inserted in center of muffin comes out clean, about 15 minutes. Cool on wire rack for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
