  "ingredients": [
    "olive oil cooking spray",
    "1 cup water",
    "0.75 cup gluten-free baking flour (such as Premium Gold® Flax and Ancient Grains All-Purpose Flour)",
    "0.5 teaspoon garlic powder, or to taste",
    "salt and ground black pepper to taste",
    "2 heads cauliflower, cut into bite-size pieces",
    "2 tablespoons butter",
    "0.5 cup hot pepper sauce (such as Frank's RedHot®)",
    "1 teaspoon honey"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Lightly grease a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together water, flour, garlic powder, salt, and pepper in a large bowl until batter is smooth and somewhat runny.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PmT5KBOGKcahrAv7rKkHWGVDXXM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239616-buffalo-cauliflower-step1-264copy-1638258fb9ef419491f3d4b8c3bcc0c1.jpg"
      ],
      "image": "assets/images/239616/step_02.webp"
    },
    {
      "text": "Add cauliflower pieces to batter and mix until evenly coated; spread onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5unuuKunamOmfGIP6MJL4vYss_s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239616-buffalo-cauliflower-step2-268copy-006789e3b07b4b0bb3db6b35db6c19e3.jpg"
      ],
      "image": "assets/images/239616/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 20 to 25 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uzl8VkYe2fHvi3xBkpgdnq7sybg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239616-buffalo-cauliflower-step3-343copy-f5fbd07b8c5b4c5aa23fa59bd1794e0c.jpg"
      ],
      "image": "assets/images/239616/step_04.webp"
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Remove from heat; stir in hot pepper sauce and honey until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T3NQUEi6n1QxEeo5nn7oSSKAzUc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239616-buffalo-cauliflower-step4-277copy-a26bb4ed45594dbf9967c3329aeb5e59.jpg"
      ],
      "image": "assets/images/239616/step_05.webp"
    },
    {
      "text": "Brush hot sauce mixture over each cauliflower piece, repeating until all is used.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/22yE0xWhNu2EOstwnZelOBw3taA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239616-buffalo-cauliflower-step5-344copy-5194086a41d44111931239c3955ef336.jpg"
      ],
      "image": "assets/images/239616/step_06.webp"
    },
    {
      "text": "Return to the oven and bake until cauliflower is browned, about 10 minutes. Let cool for 10 to 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Qshen23ONAK6kSfDldNd8PVTvqA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239616-buffalo-cauliflower-DDMFS-4x3-dbc3ece590024fa0bb3f45773f1d511a.jpg"
      ],
      "image": "assets/images/239616/step_07.webp"
    }
