  "ingredients": [
    "1 (10 ounce) container refrigerated pizza crust",
    "1 cup sour cream",
    "2 tablespoons ranch seasoning mix",
    "2 cups shredded mozzarella cheese",
    "1.5 cups cubed, cooked chicken",
    "1 medium tomato, diced",
    "6 slices cooked bacon, chopped",
    "3 thin slices red onion, separated into rings"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pizza crust onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges just start to brown, 7 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sour cream and ranch mix in a bowl; spread onto warm pizza crust. Sprinkle with ½ mozzarella cheese. Top with chicken, tomato, bacon, and red onion; sprinkle with remaining ½ mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is browned to your liking and cheese is melted, 6 to 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
