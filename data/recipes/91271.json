  "ingredients": [
    "8 slices cinnamon bread",
    "2 eggs",
    "1 egg white",
    "0.33333334326744 cup white sugar",
    "1.5 cups 2% low-fat milk",
    "0.5 cup maple syrup",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "6 tablespoons fat-free caramel sauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut bread into 3/4 inch cubes. Arrange cubes in a 9x13-inch baking dish. Whisk together the eggs, egg white and sugar in a bowl. Stir in the milk, syrup, cinnamon, nutmeg, and salt. Pour mixture over bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until lightly browned on top and middle is set, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm the caramel sauce; drizzle over the bread pudding before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
