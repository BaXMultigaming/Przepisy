  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup unsalted butter",
    "1.5 cups white sugar",
    "0.33300000429153 cup peanut butter",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2 cups semisweet chocolate chips",
    "4 chocolate covered peanut butter cups, chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour, baking soda and salt, set aside. In a medium bowl, cream together the sugar and butter. Stir in the peanut butter, egg and vanilla. Add the dry ingredients, mix well. Then fold in the chocolate chips and chopped peanut butter cups. Shape into 2 inch balls and place on unprepared cookie sheets 3 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in the preheated oven. Remove from baking sheets to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
