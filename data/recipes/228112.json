  "ingredients": [
    "1 (8 ounce) carton liquid egg substitute",
    "1 tablespoon shredded Cheddar cheese",
    "1 tablespoon shredded Parmesan cheese",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon garlic powder",
    "0.125 teaspoon red pepper flakes",
    "1 teaspoon olive oil",
    "0.5 cup chopped fresh mushrooms",
    "1 tablespoon chopped onion",
    "0.5 cup chopped fresh spinach, or more to taste"
  ],
  "steps": [
    {
      "text": "Whisk egg substitute, Cheddar cheese, Parmesan cheese, salt, black pepper, garlic powder, and pepper flakes together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a nonstick skillet over medium heat. Add mushrooms and onion; cook until tender, 4 to 5 minutes. Add spinach; cook until wilted, 3 to 4 minutes. Add egg mixture, swirling skillet to evenly distribute egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until egg mixture is set in the middle and no longer runny, 5 to 10 minutes. Cut into wedges to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
