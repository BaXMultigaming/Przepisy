  "ingredients": [
    "2 cups powdered non-dairy coffee creamer",
    "1.5 cups instant hot chocolate mix",
    "1.5 cups instant coffee granules",
    "1.5 cups white sugar",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "In a large bowl, stir together the coffee creamer, hot chocolate mix, instant coffee, sugar, nutmeg and cinnamon. Store in an airtight container at room temperature.",
