  "ingredients": [
    "1 (8 ounce) package bow-tie pasta",
    "6 slices bacon",
    "0.66666668653488 cup chopped basil",
    "3 tablespoons lemon juice",
    "2 tablespoons olive oil",
    "3 cloves garlic, minced",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon salt",
    "2 avocados, chopped",
    "0.5 cup grated Romano cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook bow tie pasta at a boil, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a large skillet over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain on paper towels. Crumble into small pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine basil, lemon juice, olive oil, garlic, pepper, and salt together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bacon and avocado in a large bowl; stir in basil mixture. Add pasta; toss to combine. Sprinkle Romano cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
