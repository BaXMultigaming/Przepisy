    "publisher-tested"
  ],
  "ingredients": [
    "1 pound sirloin steak, cubed",
    "salt and ground black pepper to taste",
    "1 (14 ounce) can beef broth",
    "3 large carrots, diced",
    "3 potatoes, cubed",
    "1 cup frozen green peas, thawed",
    "3 tablespoons cornstarch",
    "0.33333334326744 cup water",
    "2 (9 inch) refrigerator pie crusts"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G74K2P01eN-876iwTKF8bv2B01A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22851-beef-pot-pie-III-DDMFS-step-1-BG-4331-94127d4efabf4c8da0a37163a55e2bc5.jpg"
      ],
      "image": "assets/images/22851/step_01.webp"
    },
    {
      "text": "Brown pieces of meat on all sides in a saucepan over medium heat. Pour in some water to almost cover. Bring to a boil and reduce heat. Simmer until meat is tender and falls apart easily; 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/81rwcpVjSJQ0dMOp4hVLMX1GY4I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22851-beef-pot-pie-III-DDMFS-step-3-BG-4356-0ab125dd75e24b499a2510855413d5c3.jpg"
      ],
      "image": "assets/images/22851/step_02.webp"
    },
    {
      "text": "Transfer meat to a large mixing bowl. Shred the meat slightly and add salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/i0U1NVit9Vgh0UsMF8bq_1whHiE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22851-beef-pot-pie-III-DDMFS-step-4-BG-4517-eb28f0b686a04d68b374897d96f332ad.jpg"
      ],
      "image": "assets/images/22851/step_03.webp"
    },
    {
      "text": "Meanwhile, in another 2-quart saucepan over medium heat, pour in beef broth and add carrots and potatoes. Cook until almost tender; 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r_OEFL-4dYVX__0qemfDNTOWIdg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22851-beef-pot-pie-III-DDMFS-step-5-BG-4369-69cd0412699c489a9a2633b4086e75f6.jpg"
      ],
      "image": "assets/images/22851/step_04.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When carrots and potatoes are done, transfer to the large mixing bowl with the beef; leaving the liquid in the pan. Combine peas with carrots, potatoes, and beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_n1Q9YLAuzEhIeKcBxSYI6Jqtpk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22851-beef-pot-pie-III-DDMFS-step-6-BG-4519-18efab9c87724f5292f4be8a2834207a.jpg"
      ],
      "image": "assets/images/22851/step_06.webp"
    },
    {
      "text": "Dissolve cornstarch with 1/3 cup water. Pour into the saucepan with beef broth, stirring constantly. Bring to a simmer and reduce heat; cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aJeVN2aKA8Welic6uw6Hgp_t2FQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22851-beef-pot-pie-III-DDMFS-step-7-BG-4384-cde9210a1f7a432a9674af0c34e69b2b.jpg"
      ],
      "image": "assets/images/22851/step_07.webp"
    },
    {
      "text": "Line a 9-inch pie plate with one of the pie crusts following the package directions. Place the beef mixture into the pie crust. Pour the gravy over the top of the mixture, then cover with the other pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VdQ28_xLZFFieE76t8yihT0ze8Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22851-beef-pot-pie-III-DDMFS-step-9-BG-4533-35647c207b4649e2be0ee3de4117a22e.jpg"
      ],
      "image": "assets/images/22851/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven until the crust is golden brown; about 25 minutes. Let cool for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XNMXAC5nb5rX04yPlhpT8JrMyFI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/22851-beef-pot-pie-III-DDMFS-beauty-4x3-BG-4644-d4d01ddf022e480e9a69ac143e732e5e.jpg"
      ],
      "image": "assets/images/22851/step_09.webp"
    }
  ],
