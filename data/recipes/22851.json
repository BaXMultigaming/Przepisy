  "title": "Beef Pot Pie",
  "description": "This beef pot pie is delicious. Cubed beef, carrots, potatoes, and peas are combined with a homemade gravy and baked in between flaky pie crusts.",
  "authors": [
    "Stephanie"
  ],
  "date_published": "2000-10-16T23:17:20-04:00",
