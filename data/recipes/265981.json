  "ingredients": [
    "1 cup cottage cheese",
    "0.5 cup raisins",
    "2 eggs",
    "2 tablespoons white sugar",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "2 tablespoons canola oil",
    "1.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Mix together cottage cheese, raisins, eggs, sugar, vanilla extract, cinnamon, and salt in a large bowl until well combined. Add flour slowly, mixing until incorporated and batter is very thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Drop batter by tablespoonfuls onto the hot skillet and cook for 1 minute. Flip and flatten slightly with a spatula, cook until browned on the other side, about 2 minutes more. Flip back to the first side and cook until browned, about 1 more minute. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
