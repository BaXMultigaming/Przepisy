  "ingredients": [
    "1 (1.9 ounce) package mini phyllo tart shells (such as Athens®)",
    "0.25 cup apricot preserves",
    "2 tablespoons mini chocolate chips",
    "0.5 cup chopped pecans",
    "0.25 cup brown sugar",
    "2 tablespoons half-and-half",
    "1 tablespoon honey",
    "0.5 teaspoon rum extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper or foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the phyllo cups on the baking sheet. Add about 1/4 teaspoon apricot preserves to each cup, followed by 1/4 teaspoon mini chocolate chips; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pecans, brown sugar, half-and-half, honey, and rum extract in a small mixing bowl. Stir well. Distribute the pecan mixture equally among the phyllo cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges start to turn golden brown, about 10 minutes. Let cool for about 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
