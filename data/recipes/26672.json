  "ingredients": [
    "1 cup water",
    "1 cup uncooked instant rice",
    "1 pound lean ground beef",
    "2 onions, chopped",
    "1 large green bell pepper, chopped",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (8 ounce) can tomato sauce",
    "2 tablespoons chili powder",
    "1 (8.75 ounce) can whole kernel corn, drained",
    "salt and pepper to taste",
    "3 slices processed American cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 2 quart (8 inch round) casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan, bring 1 cup of water to a boil. Stir in instant rice, cover and remove from heat. Let sit for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium skillet over high heat, brown ground beef with onions and green pepper. Stir in diced tomatoes, tomato sauce and chili powder. Simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cooked rice into the beef mixture. Mix in the corn, salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the mixture into prepared casserole dish. Cut the American cheese slices in half and place over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 15 to 20 minutes or until cheese is melted and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
