  "ingredients": [
    "1 pound bulk pork sausage",
    "1.25 cups baking mix (such as Bisquick ®)",
    "1 (8 ounce) package cream cheese, softened",
    "1 (8 ounce) package shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sausage, baking mix, cream cheese, and Cheddar cheese in the bowl of a stand mixer fitted with the dough hook attachment; beat on low speed until well combined, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll mixture into 1-inch balls and place on a rimmed baking stone.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and no longer pink in centers, 22 to 25 minutes. An instant-read thermometer inserted into centers should read 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
