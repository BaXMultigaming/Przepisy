  "ingredients": [
    "2 large onions, diced",
    "3 carrots, sliced",
    "7 potatoes, cubed",
    "1 pound salmon, cut into chunks",
    "1 pound cod, cut into chunks",
    "1 pound scallops",
    "1 pound shrimp, peeled and deveined",
    "6 ounces cooked lobster meat, shredded",
    "1 (6 ounce) can crabmeat, drained and flaked",
    "2 (6.5 ounce) cans chopped clams, drained",
    "4.25 cups heavy whipping cream",
    "2 cups half-and-half",
    "1.5 cups butter, cut into chunks",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2EgVPOIuHnmr_TloEj-9j_rdquk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228991-moms-nova-scotia-seafood-chowder-VAT-005-step-01-02crabandclaminbowl-e118e9a31d0d4b07835c40978a7c2c26.jpg"
      ],
      "image": "assets/images/228991/step_01.webp"
    },
    {
      "text": "Fill a large pot halfway with lightly salted water; bring to a boil. Add onions and carrots; cook until slightly tender, 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Qrkp8hSnZjrQT88fKhGlVljQuFg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228991-moms-nova-scotia-seafood-chowder-VAT-006-step-02-c3f1cc59e9114a0099dab0b4cb912f55.jpg"
      ],
      "image": "assets/images/228991/step_02.webp"
    },
    {
      "text": "Add potatoes; cook until tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SZ2Vn6HJXpUNZgNfYhBfrEtmPvs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228991-moms-nova-scotia-seafood-chowder-VAT-007-step-03-01showingpotatocooked-21490836d88a4595a1bd8244531393f6.jpg"
      ],
      "image": "assets/images/228991/step_03.webp"
    },
    {
      "text": "Stir in salmon, cod, scallops, shrimp, lobster, and crab; cook over medium heat until salmon and cod are firm but chunks are still slightly translucent in the center, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3Bu3iP4T7gapXmvoEWprZaPsJiw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228991-moms-nova-scotia-seafood-chowder-VAT-008-step-04-01showingseafood-dfb7fd30b4d14e198899b47840601fc2.jpg"
      ],
      "image": "assets/images/228991/step_04.webp"
    },
    {
      "text": "Drain half the water from the pot and add clams, heavy cream, and half-and-half. Place butter chunks atop the soup; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1KyzzRs5WTSBAP4ligmQnpYQD70=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228991-moms-nova-scotia-seafood-chowder-VAT-009-step-05-53069fcb257a4f3f92be7d63220aee7a.jpg"
      ],
      "image": "assets/images/228991/step_05.webp"
    },
    {
      "text": "Cover and simmer, stirring occasionally, until salmon and cod are fully cooked and flake easily with a fork, about 30 minutes. Do not boil once cream is added.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hxDlRIl78UBqIeIAcBJQkJcrlms=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/228991-moms-nova-scotia-seafood-chowder-VAT-010-step-06-02stirring-ee114cbdc4574680976ca4ee783826c7.jpg"
      ],
      "image": "assets/images/228991/step_06.webp"
    }
