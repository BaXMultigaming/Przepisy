  "ingredients": [
    "4 (4 ounce) cube steaks",
    "2 eggs",
    "3 cups dry bread crumbs",
    "1 tablespoon dried oregano",
    "1 teaspoon ground cumin",
    "salt and pepper to taste",
    "1 lemon, sliced",
    "2 cups vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "In a shallow dish, combine the breadcrumbs with the oregano, cumin, and salt and pepper. Beat eggs in another shallow dish. Dip each steak in beaten eggs, and then in the breadcrumb mixture. Make sure to cover each steak well with the breadcrumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large, deep skillet, heat 1inch oil over medium high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the steaks in the oil when it's hot (so that the breading will not stick to the pan). Cook steaks, turning once, until brown for well done and golden brown for medium. Serve with lemon slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
