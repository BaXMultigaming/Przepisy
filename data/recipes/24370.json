  "ingredients": [
    "1 pound silken tofu",
    "0.5 cup unsweetened cocoa powder",
    "1 cup white sugar",
    "1 tablespoon vanilla extract",
    "0.5 teaspoon cider vinegar",
    "1 (9 inch) prepared graham cracker crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend tofu with an electric mixer or in a food processor until smooth. Blend in cocoa, sugar, vanilla and vinegar. Pour into prepared crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
