  "ingredients": [
    "1 (12 ounce) bag broccoli florets",
    "0.5 red onion, sliced",
    "8 fresh sage leaves, torn",
    "2 tablespoons extra-virgin olive oil",
    "0.5 teaspoon salt",
    "0.5 teaspoon garlic salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread broccoli in a single layer on the prepared baking sheet. Sprinkle onion and sage leaves over broccoli; drizzle with olive oil. Sprinkle salt, garlic salt, and black pepper over broccoli mixture; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until broccoli is browned and crisp, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
