  "ingredients": [
    "4 slices multigrain bread",
    "2 large avocados - peeled, pitted, and mashed",
    "2 tablespoons diced red onion",
    "2 tablespoons chopped fresh cilantro, or more to taste",
    "0.25 cup freshly grated Parmesan cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread slices on a baking sheet under the preheated broiler until toasted, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together mashed avocados, red onion, and cilantro in a bowl. Spread on toasted bread and sprinkle with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to broiler until cheese is melted, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
