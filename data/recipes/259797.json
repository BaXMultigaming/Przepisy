  "ingredients": [
    "3 pounds red potatoes, unpeeled, cut into 1/2-inch cubes",
    "2 (14.5 ounce) cans chicken broth",
    "1 white onion, finely chopped",
    "2 tablespoons butter",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 (8 ounce) package crisp cooked bacon, crumbled",
    "0.75 cup half-and-half",
    "0.75 cup shredded Cheddar cheese, plus more for garnish",
    "0.5 cup sour cream, plus more for garnish",
    "3 tablespoons minced fresh chives"
  ],
  "steps": [
    {
      "text": "Combine potatoes, chicken broth, onion, butter, salt, and black pepper in a slow cooker. Cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nKRCV89ZoM5YD7nmJMB8swodLOQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259797-Bretts-Slow-Cooker-Loaded-Baked-Potato-Soup-ddmfs-step-1-153-35a11533c1b448b9b12e68b184935888.jpg"
      ],
      "image": "assets/images/259797/step_01.webp"
    },
    {
      "text": "Cook on High until soup flavors have melded and potatoes are extremely soft, 4 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-K0GRVt0nOti_TWtY_bCMeEpoTA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259797-Bretts-Slow-Cooker-Loaded-Baked-Potato-Soup-ddmfs-step-2-165-2f20b376e964455db1deac36eab4d681.jpg"
      ],
      "image": "assets/images/259797/step_02.webp"
    },
    {
      "text": "Stir in bacon, half-and-half, Cheddar cheese, and sour cream. Cook on Low until thick and creamy, 15 to 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hcHUFf6E8Zg6V9omX7YVw4rUA6o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259797-Bretts-Slow-Cooker-Loaded-Baked-Potato-Soup-ddmfs-step-3-167-ba4310fc627a4cb8a1570608097bf4e1.jpg"
      ],
      "image": "assets/images/259797/step_03.webp"
    },
    {
      "text": "Mash soup with a potato masher to your desired consistency.",
