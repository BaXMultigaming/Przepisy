  "ingredients": [
    "2 tablespoons butter",
    "0.5 tablespoon olive oil",
    "0.5 tablespoon balsamic vinegar",
    "1 clove garlic, minced",
    "0.125 teaspoon dried oregano",
    "1 pound button mushrooms, sliced"
