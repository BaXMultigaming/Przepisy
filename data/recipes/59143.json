  "ingredients": [
    "1 (32 ounce) container plain yogurt",
    "3 Persian cucumbers - peeled, trimmed, and cut into 1/4-inch cubes",
    "1 clove garlic, minced",
    "1 shallot, finely chopped",
    "5 tablespoons dried dill weed",
    "1 teaspoon salt",
    "1 teaspoon pepper"
  ],
  "steps": [
    {
      "text": "Stir yogurt, cucumbers, garlic, and shallot together in a medium bowl; season with dill, salt, and pepper. Refrigerate for at least 1 hour to blend flavors.",
