  "ingredients": [
    "0.5 cup white sugar",
    "2 tablespoons water",
    "1 cup confectioners' sugar",
    "2 teaspoons low-fat milk",
    "0.25 teaspoon almond extract",
    "1 dash assorted natural food coloring"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wUkHifFah1XpC7i2Vm8-wRhMZvA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-222118-healthier-sugar-cookie-icing-step-01-33e7cd85eab34fcd9c40574af5984171.jpg"
      ],
      "image": "assets/images/222118/step_01.webp"
    },
    {
      "text": "Combine white sugar and water in a small saucepan over medium heat, simmering until dissolved and a sugar syrup is created, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KVrLnrO5ArNC9FL98EWbwwz6ToM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-222118-healthier-sugar-cookie-icing-step-02-d53e6d8978c74b89ac7257fcb24fcfe6.jpg"
      ],
      "image": "assets/images/222118/step_02.webp"
    },
    {
      "text": "Stir together confectioner's sugar and milk in a small bowl until smooth. Beat in almond extract and 2 teaspoons of sugar syrup until icing is smooth and glossy. If icing is too thick, add more sugar syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fc2lbqIVwo7qTbRBzsqND6CMP_4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-222118-healthier-sugar-cookie-icing-step-03-bf662d36ac1d4913bfa9c784237f059b.jpg"
      ],
      "image": "assets/images/222118/step_03.webp"
    },
    {
      "text": "Optional: Divide icing into separate bowls and add food colorings to each to desired intensity. Dip cookies or paint them with a brush.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4tEUCtlFQT7Z2PRAoKVIgKryrXk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-222118-healthier-sugar-cookie-icing-step-04-aa868f2e8f7f4f9f93e7e87d95b000b1.jpg"
