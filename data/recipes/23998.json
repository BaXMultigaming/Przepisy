  "ingredients": [
    "3 tablespoons butter",
    "4 skinless, boneless chicken breast halves",
    "2 teaspoons garlic powder",
    "1 teaspoon seasoning salt",
    "1 teaspoon onion powder"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HUuvi6ZzjGrHP79GNM18qO8wFmE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23998_AGoodandEasyGarlicChicken_ddmfs_Step1_3x4_3381-13bf0d1e424b4bf2bab3249bfbb09496.jpg"
      ],
      "image": "assets/images/23998/step_01.webp"
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add chicken and sprinkle with garlic powder, seasoning salt, and onion powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9efcHVLnwoCA9bQrf0fsQUJ5ELs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23998_AGoodandEasyGarlicChicken_ddmfs_Step2_3x4_3390-1f8d717efb93471c82ed6515759cd701.jpg"
      ],
      "image": "assets/images/23998/step_02.webp"
    },
    {
      "text": "Sauté until chicken is cooked through and juices run clear, about 7 to 10 minutes on each side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4Z0bAw9bFZ-PjlCdv48IP2ODNBQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23998_AGoodandEasyGarlicChicken_ddmfs_Step3_3x4_3392-106579d9524f4b9c946b29bcb8c5ef4d.jpg"
      ],
      "image": "assets/images/23998/step_03.webp"
    },
    {
      "text": "Serve hot and enjoy!",
