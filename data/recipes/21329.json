  "ingredients": [
    "2 large potatoes, peeled",
    "2 cups chopped fresh broccoli",
    "0.25 cup milk",
    "0.25 teaspoon salt",
    "1 tablespoon olive oil",
    "0.5 onion, chopped",
    "1 cup shredded Cheddar cheese",
    "3 eggs",
    "1 cup milk",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes; drain. Meanwhile, place broccoli in a steamer over 1 inch of boiling water, and cover. Cook until tender but still firm, about 2 to 6 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash the potatoes with milk and salt. Brush a deep 9 inch pie dish with olive oil and press the potatoes in. Brush with remaining olive oil. Bake in preheated oven for 30 minutes or until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange onions, broccoli and cheese in the potato crust. Whisk together the eggs, milk, salt, pepper and nutmeg. Pour over broccoli and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 to 40 minutes, until slightly puffed and cooked throughout. Allow to cool for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
