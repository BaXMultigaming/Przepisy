  "ingredients": [
    "2 cups white sugar",
    "0.75 cup butter, cut into pieces",
    "0.66666668653488 cup milk",
    "2.5 cups quick cooking oats",
    "1 cup crushed chocolate sandwich cookies (such as Oreo®)",
    "1 (4 ounce) package cookies and cream instant pudding mix (such as Jell-O® Oreo®)",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine sugar, butter, and milk in a large saucepan over medium heat; bring to a boil. Cook and stir until butter has melted and sugar has dissolved a bit, about 2 minutes. Turn off heat and stir in oats, crushed cookies, pudding mix, and vanilla extract. Let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of batter 2 inches apart onto waxed paper. Let cool until set, about 30 minutes.",
