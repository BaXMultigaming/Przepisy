  "ingredients": [
    "0.33333334326744 cup white wine",
    "0.25 cup lemon juice",
    "2 tablespoons soy sauce",
    "2 tablespoons olive oil",
    "4 cloves garlic",
    "1 tablespoon poultry seasoning",
    "0.25 teaspoon salt",
    "0.125 teaspoon pepper",
    "4 swordfish steaks",
    "1 tablespoon chopped fresh parsley",
    "4 slices lemon, for garnish"
  ],
  "steps": [
    {
      "text": "To make the marinade: Mix wine, lemon juice, soy sauce, olive oil, garlic, poultry seasoning, salt, and pepper in a glass baking dish until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay swordfish steaks in marinade; turn to coat. Refrigerate for 1 hour, turning frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook swordfish steaks on the preheated grill until cooked through and the fish flakes easily with a fork, 5 to 6 minutes per side; discard marinade. An instant-read thermometer inserted into the center of each steak should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish swordfish steaks with parsley and serve with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
