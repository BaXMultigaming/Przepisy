  "ingredients": [
    "0.75 cup all-purpose flour",
    "0.66666668653488 cup chopped pecans",
    "0.5 cup butter",
    "0.33333334326744 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "8 ounces cream cheese",
    "1/4 cup sugar",
    "1 large egg",
    "1/2 teaspoon vanilla extract",
    "1/4 teaspoon almond extract",
    "28 ounces peach slices, drained",
    "1/2 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease a 10-inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, pecans, butter, sugar, and vanilla extract together in a medium bowl for the crust. Press into the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden, about 5 minutes. Remove from the oven and let cool; Do not shut the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, sugar, egg, vanilla extract, and almond extract in a large bowl until smooth. Gently fold in peaches. Spread filling over crust; sprinkle with cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake for 10 minutes. Reduce the heat to 325 degrees F (165 degrees C); bake for 20 to 25 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
