  "ingredients": [
    "3 slices bacon",
    "8 ounces sliced fresh mushrooms",
    "0.5 medium onion, chopped",
    "1 clove garlic, minced",
    "2 tablespoons all-purpose flour",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 (8 ounce) package cream cheese, cut into cubes",
    "2 teaspoons Worcestershire sauce",
    "2 teaspoons soy sauce",
    "0.5 cup sour cream"
  ],
  "steps": [
    {
      "text": "Place bacon slices in a large skillet over medium-high heat. Fry until crisp. Remove bacon, crumble and set aside. Drain off all but 2 tablespoons of the bacon drippings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add mushrooms, onion and garlic to the bacon drippings, and cook over medium heat, stirring, until tender and most of the liquid has evaporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle the flour, salt, and pepper over the top, and stir to blend. Mix in cream cheese, Worcestershire sauce, and soy sauce. Reduce heat to low, and stir until cream cheese is melted. Remove from heat. Stir in the sour cream and bacon. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
