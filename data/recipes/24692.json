  "ingredients": [
    "0.5 cup all-purpose flour",
    "1 pinch salt",
    "2 tablespoons white sugar",
    "0.25 cup milk",
    "2 eggs, beaten",
    "1.5 teaspoons grated lemon zest",
    "2 large apples",
    "2 tablespoons vegetable oil",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix flour, salt and sugar. Pour in milk, a little at a time, stirring to make a smooth batter. Beat in eggs and lemon zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Core and peel apples, then cut in wedges. Cut each wedge crosswise into thin slices. Toss apples in batter to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet over medium heat, heat oil and butter. Drop fritter mixture by spoonfuls into pan and cook, turning once, until golden brown. Plate and sprinkle with sugar. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
