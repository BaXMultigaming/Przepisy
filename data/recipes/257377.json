  "ingredients": [
    "2 tablespoons olive oil",
    "1 large onion, thinly sliced",
    "2 green chile peppers, thinly sliced",
    "1 tablespoon mustard seeds",
    "1 tablespoon cumin seeds",
    "1 teaspoon white sugar",
    "1 clove garlic, minced",
    "salt and ground black pepper to taste",
    "8 potatoes, peeled and cubed",
    "2 tablespoons red pepper flakes"
  ],
  "steps": [
    {
      "text": "Pour olive oil into the bottom of a slow cooker. Layer onion slices over the oil. Add green chile peppers, mustard seeds, cumin seeds, sugar, garlic, salt, and pepper. Layer potatoes on top, seasoning each layer with a sprinkle of salt and red pepper flakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High until potatoes are tender, 3 1/2 to 4 hours. Stir gently before serving.",
