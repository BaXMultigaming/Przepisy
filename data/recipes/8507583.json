  "ingredients": [
    "1 tablespoon olive oil",
    "1 medium shallot, thinly sliced",
    "2 cloves garlic, minced",
    "0.5 teaspoon crushed red pepper flakes",
    "8 chopped fresh sage leaves",
    "1 (15 ounce) can pumpkin puree",
    "1 cup 2% milk",
    "0.5 cup half-and-half",
    "1 teaspoon salt, or to taste",
    "0.5 teaspoon freshly ground white pepper",
    "0.25 teaspoon chili powder",
    "8 ounces gemelli pasta, cooked and drained"
  ],
  "steps": [
    {
      "text": "Heat oil in a large sauté pan over medium heat. Add shallot, garlic, and pepper flakes; cook, stirring occasionally, until shallots are crispy, about 5 minutes. Add sage; cook for 30 seconds, being careful sage doesn't burn. Transfer shallot-sage mixture to a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pumpkin, milk, half-and-half, salt, white pepper, and chili powder to the same pan; cook and stir over medium heat until forms a smooth, creamy sauce, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide cooked pasta among four plates; top with pumpkin sauce. Sprinkle servings with reserved shallot-sage mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
