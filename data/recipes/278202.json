  "ingredients": [
    "0.75 (16 ounce) package penne rigate",
    "2 tablespoons olive oil",
    "1 pound cooked medium shrimp with tails intact",
    "1 cup chopped green bell pepper",
    "1 cup diced baby bella mushrooms",
    "1 (16 ounce) jar Alfredo sauce",
    "1 (15 ounce) can diced tomatoes",
    "2 cups shredded Italian cheese blend",
    "1.5 cups grated Parmesan cheese, divided",
    "2 (6 ounce) tubs sun-dried tomato pesto",
    "0.5 cup seasoned bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add penne and cook, stirring occasionally, until tender yet firm to the bite, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat olive oil in a pan over medium-low heat. Add shrimp, green pepper, and mushrooms; saute until vegetables soften, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain penne. Mix Alfredo sauce, tomatoes, Italian cheese blend, and 1 cup Parmesan cheese in a large bowl. Add shrimp mixture and mix thoroughly. Add pesto and mix again. Fold in penne.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer penne mixture to a casserole dish. Mix remaining Parmesan cheese with bread crumbs; sprinkle over the casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
