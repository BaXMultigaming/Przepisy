  "ingredients": [
    "1 cup white sugar",
    "1 cup packed light brown sugar",
    "1 cup butter",
    "1 cup vegetable oil",
    "1 large egg",
    "1 tablespoon milk",
    "1 teaspoon vanilla extract",
    "4 cups all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon cream of tartar",
    "1 teaspoon baking soda",
    "2 cups semisweet chocolate chips",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together white sugar, brown sugar, butter, oil, egg, milk, and vanilla until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add in flour, salt, cream of tartar, and baking soda. Mix in chocolate chips and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by teaspoons onto ungreased cookie sheets. Bake in the preheated oven for 8 to 12 minutes. Cookies are light in color when done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
