  "steps": [
    {
      "text": "Pour 1/4 to 1/2 inch of salt onto a small, shallow plate. Moisten the rim of a margarita glass with 1 lime wedge; dip the moistened rim into salt. Fill the glass with ice cubes.",
      "section": null,
      "name": null,
      "url": null,
