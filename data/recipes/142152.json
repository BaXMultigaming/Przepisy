  "ingredients": [
    "1 head cauliflower, trimmed and cut into bite-size florets",
    "0.75 cup mayonnaise",
    "1 tablespoon mustard",
    "1 teaspoon salt",
    "ground black pepper to taste",
    "3 hard boiled eggs, chopped",
    "1 onion, chopped",
    "0.75 cup frozen green peas, thawed",
    "0.25 cup dill pickles, chopped",
    "3 slices crisply cooked bacon, crumbled"
  ],
  "steps": [
    {
      "text": "Place cauliflower in a large saucepan and cover with water. Bring to a boil and cook until just fork tender, about 10 minutes. Drain and cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl whisk together the mayonnaise, mustard, salt, and pepper. Add the cauliflower, eggs, onion, peas, dill pickles, and bacon to the dressing and stir until well coated. Cover and refrigerate for 2 to 24 hours. The longer the cauliflower salad chills, the better the flavor.",
