  "ingredients": [
    "8 eggs",
    "2 cups milk",
    "2 teaspoons white sugar",
    "1.5 teaspoons salt",
    "2 cups all-purpose flour",
    "0.5 cup butter",
    "2 cups fresh or frozen mixed berries",
    "1 tablespoon fresh lemon juice",
    "confectioners' sugar for dusting",
    "whipped cream, for serving"
  ],
  "steps": [
    {
      "text": "Whisk together eggs, milk, sugar, and salt until smooth. Whisk in flour until incorporated, then set mixture aside and let stand for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 500 degrees F (260 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter into a 9x13 inch glass baking dish, and place into the preheated oven until it melts, then brush it all over the insides of the hot dish. Pour batter into hot baking dish and bake in preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle with lemon juice, top with berries, and dust with confectioner's sugar; serve immediately with whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
