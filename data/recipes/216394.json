  "ingredients": [
    "1 (9.6 ounce) package Jimmy Dean® Original Hearty Pork Sausage Crumbles",
    "2 cups cubed cooked red potatoes",
    "8 eggs",
    "0.25 cup grated Parmesan cheese",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup chopped seeded tomato",
    "2 green onions, thinly sliced"
  ],
  "steps": [
    {
      "text": "Cook sausage in a large nonstick skillet over medium heat until hot, 4 to 5 minutes. Stir in potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, cheese, salt, and black pepper together in a large bowl; pour over sausage mixture in the skillet. Cook over medium-high heat for 2 minutes, occasionally lifting the edge with a spatula and tilting the skillet to allow uncooked egg to flow underneath. Do not stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium-low; cover the skillet. Cook until eggs are set, 14 to 17 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top frittata with tomatoes and green onions. Cut into 8 wedges; serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
