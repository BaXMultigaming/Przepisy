  "ingredients": [
    "24 chicken wings",
    "2 tablespoons vegetable oil",
    "2 tablespoons soy sauce",
    "2 tablespoons minced green onion",
    "2 cloves garlic, minced",
    "1 teaspoon curry powder",
    "0.5 teaspoon ground turmeric",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Combine chicken wings, vegetable oil, soy sauce, green onion, garlic, curry powder, turmeric, and pepper in a resealable plastic bag. Squeeze out any excess air, seal the bag, and refrigerate for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread chicken wings into a large baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until wings are browned, about 25 minutes.",
