  "ingredients": [
    "nonstick cooking spray",
    "1.5 cups whole wheat flour",
    "1 cup all-purpose flour",
    "1 tablespoon ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon ground nutmeg",
    "1 teaspoon salt",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon baking powder",
    "6 egg whites",
    "1.5 cups brown sugar",
    "1 cup grated unpeeled zucchini",
    "1 cup grated carrot",
    "0.5 cup unsweetened applesauce",
    "2 teaspoons vanilla extract",
    "0.5 cup raisins",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat a 9x5-inch loaf pan with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift whole wheat flour, all-purpose flour, cinnamon, baking soda, nutmeg, salt, cloves, and baking powder together in a medium bowl until well blended. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a large bowl with an electric mixer until light and frothy; stir in brown sugar, zucchini, carrots, applesauce, and vanilla until well combined. Stir in raisins and pecans. Stir in flour mixture just until blended. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour 20 minutes. Cool in the pan for 10 minutes, then remove bread from the pan; cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
