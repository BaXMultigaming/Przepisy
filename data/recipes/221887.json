  "title": "Chef John&#39;s Chicken and Mushrooms",
  "description": "Succulent chicken breasts topped with perfectly sauteed mushrooms create a delicious, yet very simple, dish.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-04-20T17:17:25-04:00",
