  "ingredients": [
    "1 (8 ounce) round Brie cheese",
    "2 tablespoons pesto sauce",
    "0.25 cup toasted pine nuts",
    "2 teaspoons brown sugar",
    "1 (8 ounce) package refrigerated crescent rolls"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut Brie cheese horizontally in half, creating two equal rounds similar to a layered cake. Spread pesto sauce on the cut surface of 1 half; sprinkle pine nuts and brown sugar over pesto layer. Place the other Brie half on top of pesto mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate crescent rolls and cover entire Brie round with crescent roll dough, sealing all the gaps. Place covered Brie on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until Brie cheese is softened and crescent rolls are lightly browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
