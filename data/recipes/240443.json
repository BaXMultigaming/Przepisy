  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "0.25 cup stevia",
    "2.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup sour cream",
    "0.5 cup butter, melted",
    "2 eggs",
    "0.5 teaspoon almond extract",
    "1 cup flaked coconut",
    "0.5 cup semisweet chocolate chips",
    "0.5 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, stevia, baking powder, and salt together in a bowl. Whisk sour cream, butter, and eggs together in a separate bowl; stir into flour mixture just until batter is moistened. Fold coconut and chocolate chips into batter. Fill the prepared muffin cups 2/3-full with batter and top with sliced almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 18 to 20 minutes. Cool muffins for 5 minutes in the tin before transferring to a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
