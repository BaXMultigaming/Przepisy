  "ingredients": [
    "0.5 cup butter, softened",
    "1 (3 ounce) package cream cheese",
    "1 egg, separated",
    "1 teaspoon vanilla extract",
    "1 teaspoon lemon zest",
    "0.25 teaspoon salt",
    "1 cup sifted confectioners' sugar",
    "1 cup sifted all-purpose flour",
    "1 cup finely chopped walnuts",
    "0.25 cup apricot preserves"
  ],
  "steps": [
    {
      "text": "Cream butter, cream cheese, egg yolk, vanilla, lemon peel and salt until fluffy. Gradually mix in confectioners' sugar, then the flour to make stiff dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill dough for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 30 - one inch balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg white until foamy. Dip balls in egg white then roll in chopped nuts. Arrange 2 inches apart on ungreased cookie sheet and make a depression in each with your thumb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12-15 minutes, until cookies begin to brown on the bottoms. Carefully remove to wire rack and while hot fill each depression with 1/2 teaspoon of apricot preserves or your favorite jam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
