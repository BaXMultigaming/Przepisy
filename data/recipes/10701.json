  "title": "Walnut Cheesecake Cookies",
  "description": "This has been a favorite Christmas cookie for years -- a bit of trouble to make but well worth it. Melt in your mouth goodness.",
  "authors": [
    "Diane"
  ],
  "date_published": "1998-03-22T22:56:13-05:00",
