  "ingredients": [
    "1 head cauliflower, chopped",
    "1 cup almond flour",
    "3 eggs",
    "0.5 teaspoon oregano",
    "0.5 teaspoon thyme",
    "0.5 teaspoon rosemary",
    "1 dash salt",
    "1 teaspoon all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cauliflower in a food processor or blender; pulse until broken down into grains the size of rice. Spread on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until soft, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer softened cauliflower to a large bowl; add almond flour, eggs, oregano, thyme, and rosemary. Stir well until dough pulls into a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dust a pizza pan with flour; spread dough on the pan with a spatula to form the crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake crust in the preheated oven until golden brown and edges are crispy, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
