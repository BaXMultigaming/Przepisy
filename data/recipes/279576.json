  "title": "Pineapple-Nut Cake",
  "description": "Crushed canned pineapple and a cream cheese and pecan frosting make this cake an instant delicious hit.",
  "authors": [
    "Nancy Phillips Chalmers"
  ],
  "date_published": "2020-04-12T16:22:09-04:00",
