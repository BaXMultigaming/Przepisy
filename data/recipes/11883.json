  "ingredients": [
    "1 (16 ounce) package tri-color rotini pasta",
    "2 large tomatoes, diced",
    "2 stalks celery, chopped",
    "0.5 cup thinly sliced carrots",
    "0.5 cup chopped green bell pepper",
    "0.5 cup cucumber, peeled and thinly sliced",
    "0.25 cup chopped onion",
    "1.5 (16 ounce) bottles Italian-style salad dressing, or to taste",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil; cook pasta at a boil until tender yet firm to the bite, about 8 minutes. Rinse under cold water, and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix tomatoes, celery, carrots, bell pepper, cucumber, and onion together in a large bowl. Add cooled pasta, salad dressing, and Parmesan; mix until well combined. Cover and chill for 1 hour before serving.",
