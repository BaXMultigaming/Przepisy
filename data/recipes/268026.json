  "ingredients": [
    "2 cups water",
    "1 (12 fluid ounce) can or bottle beer",
    "4 cloves garlic, minced",
    "1 (3 pound) corned beef brisket with spice packet"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
