  "ingredients": [
    "2 tablespoons extra-virgin olive oil",
    "4 cloves garlic, minced",
    "1 bunch Swiss chard, stalks discarded, leaves cut into wide ribbons",
    "0.25 cup balsamic vinegar",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat the olive oil on a large skillet over medium heat. Stir in the garlic and cook until tender and aromatic, about 2 minutes. Add the Swiss chard and balsamic vinegar; cook and stir until the chard is wilted and tender, about 5 minutes. Season with salt and pepper and serve.",
