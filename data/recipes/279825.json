  "ingredients": [
    "4 cups milk",
    "1 cinnamon stick",
    "3.5 tablespoons white sugar",
    "1.5 tablespoons pure vanilla extract",
    "0.33333334326744 cup water",
    "4 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Combine milk and cinnamon stick in a saucepan over medium heat. Bring to a boil, stirring constantly to prevent milk from burning on the bottom. Add sugar and stir for 2 minutes. Add vanilla extract and stir for another 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix water and cornstarch in a small bowl until no lumps remain. Pour into the boiling milk and stir until thick, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
