  "ingredients": [
    "3 cups Ore-Ida® Shredded Hash Brown Potatoes",
    "5 eggs",
    "0.5 cup milk",
    "0.33333334326744 cup green onions, sliced",
    "0.5 teaspoon salt",
    "0.25 teaspoon hot sauce",
    "1.5 cups shredded sharp Cheddar cheese, divided",
    "4 slices bacon, cooked crisp and crumbled, divided"
  ],
  "steps": [
    {
      "text": "Heat oven to 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together eggs and milk in a medium bowl; stir in potatoes, green onions, salt and pepper sauce. Stir in 1 cup of the cheese and half of bacon. Pour into greased 9-inch pie plate or quiche dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25-30 minutes or until center is set. Sprinkle remaining bacon and 1/2 cup cheese over top of pie; continue baking 3 to 4 minutes or until cheese is melted.",
      "section": null,
