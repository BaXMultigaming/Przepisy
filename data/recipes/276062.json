  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "0.5 teaspoon salt",
    "0.75 cup white sugar",
    "1 teaspoon baking soda",
    "1 cup applesauce",
    "1 egg",
    "3 ripe bananas, diced",
    "1 cup mini chocolate chips",
    "1 cup dried cherries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking soda, and salt in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix applesauce and egg together in another bowl. Add applesauce mixture to the flour mixture. Stir in bananas, chocolate chips, and dried cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin tin, filling each cup almost to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake muffins in the preheated oven until lightly browned, about 20 minutes. Let cool for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
