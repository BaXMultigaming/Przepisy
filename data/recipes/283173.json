  "ingredients": [
    "1 cup buttermilk",
    "1 large egg",
    "2 tablespoons vegetable oil",
    "0.5 cup whole wheat flour",
    "0.5 cup whole wheat pastry flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
