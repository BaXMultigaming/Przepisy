  "ingredients": [
    "0.75 cup aquafaba",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat aquafaba in a large bowl with an electric mixer on high speed until stiff peaks form, 10 to 13 minutes. Whisk in sugar, 1 heaping tablespoon at a time, until well combined. Whisk in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pipe or drop tablespoonfuls of the mixture onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until firm to the touch, about 70 minutes. Let sit on the baking sheets for 2 minutes then transfer to wire racks to finish cooling, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
