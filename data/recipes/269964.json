  "ingredients": [
    "1 cup cold water",
    "0.25 cup masa harina",
    "1 cup milk",
    "0.25 teaspoon ground cinnamon",
    "0.5 cup evaporated milk",
    "1 (2 ounce) bar dark chocolate, chopped",
    "2 tablespoons brown sugar",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Whisk water and masa harina together in a saucepan over medium heat. Cook, stirring constantly, until mixture comes to a boil. Add milk and cinnamon. Continue stirring until thick and bubbly. Add evaporated milk, chocolate, brown sugar, and vanilla extract. Cook and stir until chocolate and sugar are just melted, about 2 minutes. Remove from heat and pour into mugs. Serve hot.",
