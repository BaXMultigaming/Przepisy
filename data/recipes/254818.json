  "ingredients": [
    "1 pound ground beef",
    "1 (1 ounce) package taco seasoning mix",
    "1 cup salsa",
    "0.5 (15 ounce) can black beans, rinsed and drained",
    "1 (8.5 ounce) package corn bread mix (such as Jiffy®)",
    "0.33333334326744 cup milk",
    "1 egg",
    "1 tablespoon honey",
    "1 tablespoon corn oil",
    "0.5 cup corn",
    "1 cup shredded Cheddar cheese",
    "1 cup corn chips, partially crushed"
  ],
  "steps": [
    {
      "text": "Cook and stir ground beef in a skillet over medium heat until brown and crumbled, 7 to 10 minutes; drain grease. Add taco seasoning; mix well. Stir in salsa and black beans; remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a 9-inch pie plate or casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornbread mix, milk, egg, honey, and corn oil in a bowl until batter is smooth; stir in corn. Pour batter into the prepared pie plate. Layer ground beef mixture over batter; sprinkle with Cheddar cheese. Top with corn chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place taco pie in a cold oven; heat the oven to 350 degrees F (175 degrees C). Bake until sides are golden brown, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
