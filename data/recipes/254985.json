  "ingredients": [
    "1 pound sirloin steak, cut into 1/8-inch strips",
    "1 pinch meat tenderizer",
    "1 splash olive oil",
    "1 onion, thinly sliced",
    "0.5 cup minced bell pepper",
    "1 teaspoon Italian seasoning, or to taste",
    "ground black pepper to taste",
    "2 cups canned sliced mushrooms",
    "1 (12 count) package Hawaiian-style dinner rolls, sliced in half",
    "8 slices provolone cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Set oven rack about 6 inches from the heat source and preheat the oven’s broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/krrynPaK5noWcPYMoImiZnbFFLQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-254985-philly-cheesesteak-sliders-step-01-77d6a13e23d7457e85c5b7d9a0ae22f4.jpg"
      ],
      "image": "assets/images/254985/step_01.webp"
    },
    {
      "text": "Mix steak and meat tenderizer together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jH39Oagq27lt-zlwjM463EDnzoE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-254985-philly-cheesesteak-sliders-step-02-bbfc7dab99f44f6cae71bec4887f4592.jpg"
      ],
      "image": "assets/images/254985/step_02.webp"
    },
    {
      "text": "Heat olive oil in a skillet over medium heat. Add onion and bell pepper; cook and stir until slightly softened, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kxheKiDjztcKNb7BCUifJNcUcMo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-254985-philly-cheesesteak-sliders-step-03-867f3399b8bd4b2792c2ea6617a0c01f.jpg"
      ],
      "image": "assets/images/254985/step_03.webp"
    },
    {
      "text": "Stir in steak mixture; cook and stir until flavors combine, about 3 minutes. Mix in Italian seasoning and pepper; add mushrooms. Cook and stir until steak is mostly browned, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k2rxvHv_b5g5xNQko39Tu6bBHI8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-254985-philly-cheesesteak-sliders-step-04-49ad2a35c7df4fc3bf8ad7ca6ebce332.jpg"
      ],
      "image": "assets/images/254985/step_04.webp"
    },
    {
      "text": "Spoon steak mixture onto lower half of dinner rolls until covered; top with provolone cheese. Place onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7mrNPJzjYlO2NLiJhjxMs-uivnE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-254985-philly-cheesesteak-sliders-step-05-3b4c284c08a74afcafbb2570329c5d76.jpg"
      ],
      "image": "assets/images/254985/step_05.webp"
    },
    {
      "text": "Broil in the preheated oven until cheese is melted, 1 to 3 minutes; remove from broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H-pX0CXDM0njHspK2HTLcGBI-k4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-254985-philly-cheesesteak-sliders-step-06-193e23500c9a4c17980620d5ebf53cfe.jpg"
      ],
      "image": "assets/images/254985/step_06.webp"
    },
    {
      "text": "Place dinner roll tops onto melted provolone cheese; broil until tops are toasted, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gMVMGy8kreInRqOv0Mu8mUAc-AY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-254985-philly-cheesesteak-sliders-step-07-e1ad4a07c3b54cc1858a9f66caa88465.jpg"
      ],
      "image": "assets/images/254985/step_07.webp"
    },
    {
      "text": "Enjoy!",
