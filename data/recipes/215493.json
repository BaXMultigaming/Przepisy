  "title": "Caley&#39;s Classic Zucchini Bread",
  "description": "This zucchini bread recipe makes two moist, flavorful loaves packed with freshly grated squash, warm cinnamon, crunchy walnuts, and sweet vanilla.",
  "authors": [
    "mouse1493"
  ],
  "date_published": "2020-06-18T23:43:09-04:00",
