  "ingredients": [
    "2 cups old-fashioned oats",
    "1 cup chopped walnuts",
    "0.75 cup brown sugar",
    "0.75 cup dried fruit",
    "0.5 cup all-purpose flour",
    "0.5 cup whole wheat flour",
    "0.5 cup toasted wheat germ",
    "0.75 teaspoon ground cinnamon",
    "0.75 teaspoon salt",
    "0.5 cup vegetable oil",
    "0.5 cup honey",
    "1 egg",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a 9x13-inch baking dish or jelly roll pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, walnuts, brown sugar, dried fruit, all-purpose flour, whole wheat flour, wheat germ, cinnamon, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, honey, egg, and vanilla extract together in a separate bowl; stir into oats mixture until batter is just mixed. Spread batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown around the edges, 20 to 25 minutes. Cool slightly on a wire rack; cut into 12 bars while still warm using a pizza cutter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
