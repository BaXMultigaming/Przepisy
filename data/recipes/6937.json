  "ingredients": [
    "2 eggs",
    "1 cup white sugar",
    "0.5 cup melted butter",
    "1 cup crushed pineapple with juice",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "0.5 cup chopped walnuts",
    "1 teaspoon baking powder",
    "0.75 teaspoon salt",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggs in a large bowl; beat with an electric mixer. Add sugar and melted butter; continue to beat until smooth. Stir in pineapple and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, walnuts, baking powder, salt, and baking soda together in a separate bowl; add to pineapple mixture and stir until just combined. Pour mixture into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool in the pan briefly, then invert onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
