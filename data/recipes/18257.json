  "ingredients": [
    "2 medium heads cabbage, quartered with hearts removed",
    "4 quarts boiling water",
    "0.5 cup margarine",
    "0.5 cup all-purpose flour",
    "2 cups milk",
    "12 slices American cheese",
    "1 cup bread crumbs",
    "1 pinch salt",
    "1 pinch ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cabbage in a large pot of boiling water. Cook until tender, drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan, then add flour stirring constantly. Gradually add 2 cups of milk. Stir on medium heat until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer cabbage in bottom of the prepared baking dish. Pour 1/3 of white sauce over cabbage. Arrange six slices of cheese on that. Repeat, ending with white sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in an oven at 375 degrees F (190 degrees C) oven for 45 minutes or until bubbly and browned. Let stand 5 minutes. Slice and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
