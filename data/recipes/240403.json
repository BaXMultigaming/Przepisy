  "ingredients": [
    "2 cups butter",
    "1.5 cups white sugar",
    "3 eggs",
    "1 teaspoon vanilla extract",
    "1 teaspoon almond extract",
    "3.5 cups all-purpose flour",
    "2 teaspoons cream of tartar",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Beat butter and sugar with an electric mixer in a large bowl until smooth. Add first egg while continuing to beat, incorporating the egg fully before adding the second and beating fully into the mixture. Beat vanilla extract and almond extract into the mixture with the third egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, cream of tartar, baking soda, and salt together in a separate bowl; add to the wet mixture and beat just until the wet and dry combine into a cookie dough. Shape dough into a ball, wrap in plastic wrap, and refrigerate until chilled, at least 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough out onto a flour-dusted surface and cut with cookie cutters. Arrange cut cookies onto baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies in preheated oven until beginning to brown around edges, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
