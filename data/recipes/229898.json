  "ingredients": [
    "1 (8 ounce) package light cream cheese, softened",
    "0.5 cup apple butter",
    "0.5 teaspoon vanilla extract",
    "1 pinch ground cinnamon"
  ],
  "steps": [
    {
      "text": "Combine cream cheese, apple butter, vanilla extract, and cinnamon in the container of a food processor fitted with a metal blade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Process until just smooth, about 20 seconds. Scrape down the sides of the container and process again until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrape spread into a small bowl; cover with plastic wrap and refrigerate until slightly firm, about 30 minutes.",
      "section": null,
