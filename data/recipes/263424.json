  "ingredients": [
    "1.25 pounds cooked pulled pork",
    "1 (10 ounce) can red enchilada sauce",
    "1 (4.5 ounce) can chopped green chile peppers",
    "0.5 cup black beans, rinsed and drained",
    "0.5 cup frozen corn",
    "0.5 medium onion, diced",
    "0.33333334326744 cup sliced black olives",
    "1 (15 ounce) package corn bread mix",
    "0.66666668653488 cup milk",
    "1 egg",
    "2 tablespoons butter, melted",
    "3 ounces shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pulled pork, enchilada sauce, green chile peppers, black beans, corn, onion, and olives in a large bowl. Spread mixture into a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine corn bread mix, milk, egg, and butter in a separate bowl. Pour over pork mixture. Spread Cheddar cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and casserole is hot, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
