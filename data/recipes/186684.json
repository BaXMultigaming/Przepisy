  "ingredients": [
    "1.75 cups white whole wheat flour",
    "0.25 cup wheat germ",
    "2 tablespoons baking powder",
    "1 teaspoon salt",
    "1.75 cups skim milk",
    "0.25 cup margarine, melted",
    "2 eggs, beaten",
    "3 tablespoons demerara sugar",
    "0.5 cup semisweet chocolate chips",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Combine flour, wheat germ, baking powder, and salt in a large bowl. Set bowl aside. In a separate bowl, whisk together the skim milk, melted margarine, eggs, and sugar. Make a well in the center of the dry ingredients; stir in the wet ingredients, being careful not to over mix the batter. Gently fold in the chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat, and coat with cooking spray. Pour 1/4 cupfuls of batter onto the skillet, and cook until bubbles appear on the surface. Flip with a spatula, and cook until golden brown on the other side.",
      "section": null,
