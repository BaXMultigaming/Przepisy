  "ingredients": [
    "1.5 cups water",
    "0.75 cup raisins",
    "0.33333334326744 cup packed brown sugar",
    "1 pinch salt",
    "1 teaspoon cornstarch"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
