  "ingredients": [
    "1 cup sour cream",
    "0.5 cup white sugar",
    "0.25 cup margarine",
    "1 large egg",
    "1 teaspoon rum flavored extract",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 (15 ounce) can crushed pineapple, drained",
    "0.5 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 12-cup muffin pan with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sour cream, sugar, margarine, egg, and rum extract in a large bowl with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, baking soda, and salt together in a medium bowl. Blend flour mixture into the wet ingredients. Stir in drained pineapple and coconut. Divide batter among the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the tops spring back when lightly tapped, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
