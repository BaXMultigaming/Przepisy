  "ingredients": [
    "5 green onions, chopped",
    "3 tablespoons chopped fresh chives",
    "2 teaspoons dried chives",
    "0.5 teaspoon onion powder",
    "1 (12 ounce) container whipped cream cheese",
    "0.75 cup Greek-style yogurt"
  ],
  "steps": [
    {
      "text": "In the container of a food processor, combine green onions, fresh chives, dried chives, onion powder, cream cheese, and yogurt. Pulse until blended, but onions and chives should be in chunks. Transfer to a container, and refrigerate for 8 hours to overnight before serving.",
