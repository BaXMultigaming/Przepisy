  "ingredients": [
    "1 pound firm tofu",
    "0.25 cup brown miso",
    "0.33333334326744 cup roasted tahini",
    "2 tablespoons minced onion",
    "3 tablespoons minced carrot",
    "3 tablespoons unsalted sunflower seeds"
  ],
  "steps": [
    {
      "text": "Press tofu to remove excess water: Place tofu on a flat surface. Cover with a cutting board, and place an iron skillet or a similarly heavy object on top. Allow it to sit for about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble tofu into a medium bowl. Mix in miso and tahini. If desired, stir in onion, carrot, and seeds. Refrigerate.",
