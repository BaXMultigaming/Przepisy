  "ingredients": [
    "3 tablespoons sugar",
    "2 tablespoons butter",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.75 cup maple syrup",
    "0.66666668653488 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease an 8x8 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, beat together sugar, butter, egg, and vanilla extract using an electric mixer until soft and creamy, at least 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the flour, baking powder, and salt; stir into the butter mixture a little at a time, alternating with the maple syrup and milk. Just mix enough to moisten. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated oven for 45 minutes. The maple syrup will sink to the bottom, and the top should be lightly browned. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
