  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "3 egg yolks",
    "1 large egg",
    "1 (14 ounce) can sweetened condensed milk",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon fine salt",
    "0.25 teaspoon freshly grated nutmeg",
    "0.125 teaspoon Chinese 5-spice powder",
    "1 9-inch unbaked pie crust (see footnote for recipe link)",
    "freshly whipped cream",
    "grated nutmeg"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QzKxFGmx-z8D90YGFgpph3xrExg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230132-chef-johns-pumpkin-pie-ddmfs-0660-4x3-step01-eff74370a6b44c53a436e717ae576c8e.jpg"
      ],
      "image": "assets/images/230132/step_01.webp"
    },
    {
      "text": "Whisk pumpkin, egg yolks, and egg together in a large bowl until smooth. Add sweetened condensed milk, cinnamon, ginger, salt, nutmeg, and Chinese 5-spice powder; whisk until thoroughly smooth and combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PTDO0JXScOOxJUnG7MweGeNZLAE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230132-chef-johns-pumpkin-pie-ddmfs-0662-4x3-step02-263ead1dde10435c9086de52c550cd37.jpg"
      ],
      "image": "assets/images/230132/step_02.webp"
    },
    {
      "text": "Line a 9-inch pie plate with pie crust; crimp edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qEXgE9RrsylMRw8L0BO7AqIcEZM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230132-chef-johns-pumpkin-pie-ddmfs-0661-4x3-step03-156414eaa48b4cd8bb8d88eba5d9237f.jpg"
      ],
      "image": "assets/images/230132/step_03.webp"
    },
    {
      "text": "Pour filling into crust; lightly tap on the counter to release air bubbles. Bake in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bEtis_91X2EdpsmIotD5rKIVOX0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230132-chef-johns-pumpkin-pie-ddmfs-0663-4x3-step04-318be0a1673c47c88749b604e8bb9962.jpg"
      ],
      "image": "assets/images/230132/step_04.webp"
    },
    {
      "text": "Reduce heat to 350 degrees F (175 degrees C) and bake until just set in the middle, 30 to 40 more minutes. A paring knife inserted into the filling, 1 inch from the edge, should come out clean. Allow to cool completely before slicing and serving; garnish with whipped cream and freshly grated nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qeeyAIe-RqE5ecVCFh4MbMpNguo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/7381818_Chef-Johns-Pumpkin-Pie-4x3-5bede34cbca249008b0e81ea46f978d6.jpg"
      ],
      "image": "assets/images/230132/step_05.webp"
    }
