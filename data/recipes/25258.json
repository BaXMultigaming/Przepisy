  "ingredients": [
    "1 medium head cabbage, cut into small wedges",
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon salt",
    "1 cup milk",
    "0.66666668653488 cup shredded American cheese",
    "0.5 cup crushed buttery round crackers"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil. Cook cabbage in boiling water until barely tender, about 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a small saucepan over low heat. Blend in flour, salt, and milk. Cook and stir until slightly thickened, then fold in cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cabbage to the prepared casserole dish; stir in cheese sauce. Sprinkle cracker crumbs on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is browned, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
