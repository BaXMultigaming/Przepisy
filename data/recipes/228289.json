  "ingredients": [
    "10 red potatoes, cut into bite-size pieces",
    "2 teaspoons olive oil, or as needed",
    "3 large hard-cooked eggs, chopped",
    "3 slices cooked bacon, chopped",
    "0.5 stalk celery, chopped",
    "0.25 cup chopped green onion",
    "1 cup mayonnaise",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread potatoes onto a baking sheet; drizzle with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until tender, about 45 minutes. Let cool at least 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
