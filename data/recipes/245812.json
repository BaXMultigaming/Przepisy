  "ingredients": [
    "3 tablespoons butter",
    "1.5 cups chopped dates",
    "1 cup white sugar",
    "2 eggs, lightly beaten",
    "2 cups crispy rice cereal (such as Rice Krispies®)",
    "0.5 cup chopped pecans",
    "1 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Add dates, sugar, and eggs; cook and stir until mixture thickens and leaves the sides of the skillet, 5 to 10 minutes. Remove from heat; add crispy rice cereal and pecans. Stir cookie dough until well-mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place coconut in a shallow bowl. Drop teaspoonfuls of cookie dough into coconut and roll to coat and form into balls. Let cookies cool, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
