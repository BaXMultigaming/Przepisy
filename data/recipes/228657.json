  "ingredients": [
    "0.66666668653488 cup water",
    "5 tablespoons unsweetened cocoa powder",
    "0.25 cup chocolate chips",
    "0.25 cup white sugar",
    "0.25 teaspoon salt",
    "3 large marshmallows",
    "4 cups 2% milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Mix water, cocoa powder, chocolate chips, sugar, and salt in a saucepan; cook over medium heat until chocolate chips have melted and sugar has dissolved, about 10 minutes. Stir in marshmallows and milk until evenly combined and marshmallows are melted, about 5 minutes. Remove from heat; stir in vanilla extract.",
