  "ingredients": [
    "1 cup white sugar",
    "0.5 pound butter",
    "0.25 cup water",
    "0.125 teaspoon salt",
    "1 teaspoon vanilla extract",
    "6 (1.45 ounce) bars dark chocolate candy"
  ],
  "steps": [
    {
      "text": "Grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, butter, water, and salt in a heavy saucepan. Cook, stirring continuously until the mixture reaches light crack stage (310 degrees F, 160 degrees C) on a candy thermometer). Remove the pan from heat and stir in vanilla. Pour mixture into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay chocolate bars on top of the hot mixture and spread the melting chocolate over the top of the mixture. Chill well. Crack into pieces to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
