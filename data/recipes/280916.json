  "ingredients": [
    "2 pounds large frozen peeled and deveined shrimp, thawed",
    "1.5 teaspoons chili powder",
    "1 teaspoon freshly minced garlic",
    "0.5 teaspoon paprika",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon ground coriander",
    "0.25 teaspoon grated Valencia orange zest",
    "2 tablespoons olive oil, or more as needed",
    "2 tablespoons sour cream",
    "1 lime, zested and juiced",
    "1 teaspoon chopped fresh cilantro",
    "0.25 teaspoon garlic powder",
    "1 pinch salt and ground black pepper",
    "20 (6 inch) corn tortillas",
    "2 avocados, thinly sliced, or to taste",
    "1 red onion, finely diced, or to taste",
    "0.5 bunch fresh cilantro, chopped, or to taste",
    "1 jalapeno pepper, diced, or to taste",
    "2 limes, cut into wedges, or as needed"
  ],
  "steps": [
    {
      "text": "Rinse defrosted shrimp under cold water, drain, and pat dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine shrimp, chili powder, garlic, paprika, cumin, onion powder, 1/2 teaspoon salt, 1/2 teaspoon black pepper, coriander, and orange zest in a bowl. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a4dzfurwPRZuRzWybQMvoX6lNSE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/280916-shrimp-tacos-with-cilantro-lime-crema-step-1-0363-1-8e7c3d29d66b4d08ba17c107b3114a03.jpg"
      ],
      "image": "assets/images/280916/step_02.webp"
    },
    {
      "text": "Heat olive oil in nonstick frying pan over medium-high heat. Add shrimp and cook until bright pink on the outside and the meat is opaque, 4 to 5 minutes on each side, depending on the size of the shrimp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uvlbD16EggL6pyMSGI_kyg87QfU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/280916-shrimp-tacos-with-cilantro-lime-crema-step-2-0365-1-1392ca06bbdd47b9b33c19d66eafed18.jpg"
      ],
      "image": "assets/images/280916/step_03.webp"
    },
    {
      "text": "While shrimp cooks, prepare crema by whisking together sour cream, zest and juice of 1 lime, 1 teaspoon cilantro, garlic powder, and 1 pinch each of salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tsPvHI4VlHKL5S8T8r5LRByN1_4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/280916-shrimp-tacos-with-cilantro-lime-crema-step-3-0364-1-68a0c5901ef942ceba1c75714e35c804.jpg"
      ],
      "image": "assets/images/280916/step_04.webp"
    },
    {
      "text": "Heat corn tortillas in either a pan or on a griddle over low heat, 1 to 2 minutes per side. Be careful not to let them burn. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Assemble tacos by spreading 1 teaspoon crema across each tortilla, adding 3 or 4 shrimp, 2 slices of avocado, a sprinkle of fresh red onion, cilantro, and jalapeño. Serve with sliced limes to squeeze on top and extra crema on the side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7bhEbQJD0nz8Fpf6F7x_1c2Ijgk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/280916-shrimp-tacos-with-cilantro-lime-crema-step-4-0368-1-11e56e4f6f2e4b93ac2b8e781fb741f1.jpg"
      ],
      "image": "assets/images/280916/step_06.webp"
    }
