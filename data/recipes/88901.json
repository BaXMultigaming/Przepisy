  "ingredients": [
    "0.5 cup olive oil",
    "1 small white onion, sliced into thin wedges",
    "1 (14.5 ounce) can diced tomatoes, undrained",
    "2 medium zucchini, sliced",
    "1 tablespoon salt",
    "1.5 teaspoons Italian seasoning",
    "1 teaspoon sugar"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a skillet over medium heat. Stir in onion and cook until tender, 5 to 7 minutes. Mix in tomatoes and zucchini; season with salt and Italian seasoning. Cook and stir until zucchini is tender, 7 to 10 minutes. Mix in sugar and adjust seasonings to taste.",
