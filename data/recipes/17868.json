  "ingredients": [
    "2 tablespoons olive oil, divided",
    "2 cups diced onion",
    "3 cups cooked, finely chopped chicken meat",
    "1.5 cups seasoned dry bread crumbs",
    "2 large eggs, lightly beaten",
    "1 large egg, lightly beaten",
    "1 tablespoon chopped fresh parsley",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nPtv2gVoBEWYMGb8nocYVGXt6r8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17868-Leftover-Chicken-Croquettes-DDMFS-4x3-step-1-46-dbbe0d7ae6d24b1d9042c8ab55a260aa.jpg"
      ],
      "image": "assets/images/17868/step_01.webp"
    },
    {
      "text": "Heat 1 tablespoon oil in a large skillet over medium heat. Add onion and sauté until translucent, about 5 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chicken, bread crumbs, and two eggs in a large bowl; stir in onion until well combined. If mixture is too dry to form patties, mix in remaining egg. Mix in parsley, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uhf7s5Rob_8G6baoI-fxMMcLRns=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17868-Leftover-Chicken-Croquettes-DDMFS-4x3-step-2-47-94140ff2048d426cb3c9fe8d60d51188.jpg"
      ],
      "image": "assets/images/17868/step_03.webp"
    },
    {
      "text": "Form into small patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hwnSj1q3W98gZffns79OrO9kyyI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17868-Leftover-Chicken-Croquettes-DDMFS-4x3-step-3-49-6060911595754d6b8a27835e4a231d33.jpg"
      ],
      "image": "assets/images/17868/step_04.webp"
    },
    {
      "text": "Wipe out the skillet; add remaining 1 tablespoon oil and heat over medium heat. Working in batches, fry patties until golden brown and crispy, 4 to 6 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
