  "ingredients": [
    "1.5 cups macaroni",
    "2 slices bacon, chopped",
    "1.5 cups pasta sauce",
    "0.5 teaspoon ground black pepper",
    "3 eggs, beaten",
    "0.5 cup heavy cream",
    "0.5 cup milk",
    "1 pinch ground nutmeg",
    "0.5 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet over medium heat, cook bacon until crisp. Stir in pasta sauce, black pepper and cooked pasta. Spread mixture in prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine eggs, cream, milk and nutmeg and stir until smooth. Pour gently over macaroni mixture. Sprinkle with mozzarella.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 30 minutes, until set and golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
