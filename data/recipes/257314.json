  "ingredients": [
    "cooking spray",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon seasoned salt",
    "0.5 teaspoon ground black pepper",
    "2 skin-on, bone-in chicken thighs",
    "0.25 cup pesto",
    "2 tablespoons shredded mozzarella cheese",
    "4 slices bacon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with aluminum foil; mist with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix onion powder, garlic powder, seasoned salt, and pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle onion powder mixture over both sides of the chicken thighs. Lift up the skin to create a pocket; stuff pocket with 2 tablespoons of pesto and 1 tablespoon of mozzarella cheese. Wrap chicken with 2 slices of bacon, using bacon to seal the pocket. Place chicken thighs seam-side down on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into the chicken, near the bone, reads at least 165 degrees F (74 degrees C), about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
