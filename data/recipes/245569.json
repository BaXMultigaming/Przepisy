  "ingredients": [
    "0.5 cup stone-ground cornmeal",
    "6 tablespoons brown rice flour",
    "2 tablespoons ground almonds",
    "2 tablespoons smoked paprika",
    "1 tablespoon garlic powder",
    "1 tablespoon white sugar, or more to taste",
    "1 teaspoon sea salt, or more to taste",
    "1 teaspoon ground black pepper, or more to taste",
    "1 teaspoon dried oregano",
    "0.5 teaspoon dried basil",
    "0.25 teaspoon dried thyme, or more to taste",
    "1 pinch dried rosemary",
    "1 pinch dried chile pepper"
  ],
  "steps": [
    {
      "text": "Combine cornmeal, brown rice flour, almonds, paprika, garlic powder, sugar, salt, pepper, oregano, basil, thyme, rosemary, and chile pepper together in a large resealable plastic bag.",
