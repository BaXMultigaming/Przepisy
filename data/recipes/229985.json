  "ingredients": [
    "1.5 pounds fresh cranberries",
    "2 pears - peeled, cored, and quartered",
    "2 Granny Smith apples - peeled, cored, and quartered",
    "2 oranges - zested, peeled, and segmented",
    "2 lemons - zested, peeled, and segmented",
    "0.75 cup white sugar",
    "0.25 cup brandy",
    "0.25 cup cranberry juice"
  ],
  "steps": [
    {
      "text": "Combine cranberries, pears, apples, oranges, and lemons in a food processor; grind to a fine consistency. Transfer to a large glass bowl. Stir sugar, orange zest, and lemon zest into the fruit mixture. Add brandy and cranberry juice; stir.",
