  "ingredients": [
    "2 cups water",
    "1.25 cups white sugar",
    "2 tablespoons vanilla extract",
    "2 tablespoons fresh ground coffee beans",
    "2.5 cups vodka"
  ],
  "steps": [
    {
      "text": "In a saucepan over medium heat, combine water, sugar, vanilla and ground coffee. Bring to a boil, reduce heat to low, and simmer for 10 minutes, stirring occasionally. Allow to cool, then remove grounds through a strainer.",
      "section": null,
      "name": null,
      "url": null,
