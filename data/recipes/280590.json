  "ingredients": [
    "1 tablespoon butter",
    "2 (5 ounce) tuna steaks",
    "1 pinch salt and ground black pepper to taste",
    "0.33333334326744 cup fat-free half-and-half",
    "0.25 cup garlic-and-herb spreadable cheese (such as Alouette®)",
    "1 teaspoon lemon juice",
    "2 cups fresh spinach"
  ],
  "steps": [
    {
      "text": "Heat a nonstick skillet over medium heat. Add butter; melt. Season tuna steaks with salt and pepper; place in the skillet and cook 3 to 4 minutes per side. Transfer to a serving plate; keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add half-and-half and cheese to the skillet; stir until incorporated. Stir in lemon juice. Reserve 2 tablespoons sauce; set aside. Add spinach to the skillet; cook and toss with sauce until wilted, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide spinach between two plates; top with tuna steaks. Serve reserved sauce over tuna steaks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
