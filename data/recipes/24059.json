  "ingredients": [
    "1.5 cups cold water",
    "0.75 cup uncooked white rice",
    "2 cups milk, divided",
    "0.33333334326744 cup white sugar",
    "0.25 teaspoon salt",
    "1 egg, beaten",
    "0.66666668653488 cup golden raisins",
    "1 tablespoon butter",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hbg3woXal3MNX2KHzWmbwJ8PoXg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-24059-creamy-rice-pudding-DDMFS-4x3-step-01-d666016f2d90496f9acc9a364dc9b915.jpg"
      ],
      "image": "assets/images/24059/step_01.webp"
    },
    {
      "text": "Bring water in a saucepan to a boil over medium heat; stir in rice. Reduce heat to low, cover, and simmer until rice is tender and liquid has been absorbed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qtsAlMJM7Dr7rUwKQzc5LPj2O5k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-24059-creamy-rice-pudding-DDMFS-4x3-step-04-a22e139bd5304fbda6d5516869b86e00.jpg"
      ],
      "image": "assets/images/24059/step_02.webp"
    },
    {
      "text": "Combine cooked rice, 1 ½ cups milk, sugar, and salt in a clean saucepan; cook over medium heat, stirring often, until thick and creamy, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HBkBThIZfh-4t0ZlfugU330mDhs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-24059-creamy-rice-pudding-DDMFS-4x3-step-06-8ddde4a793634b929a6fc5037329ec0f.jpg"
      ],
      "image": "assets/images/24059/step_03.webp"
    },
    {
      "text": "Stir in remaining ½ cup milk, egg, and raisins; cook 2 minutes, stirring constantly. Off heat, stir in butter and vanilla extract until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gcH12yTOJeQCtIYosmCdDHCyrCM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-24059-creamy-rice-pudding-DDMFS-4x3-step-09-79a0c66b1c6849f2a188621fdadce807.jpg"
      ],
      "image": "assets/images/24059/step_04.webp"
    },
    {
      "text": "Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DzRDzQ4wiiV9dWWdCsn5sdXekuw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-24059-creamy-rice-pudding-DDMFS-4x3-a47c1f5ad9d449c582d62e6e42da28ac.jpg"
