  "ingredients": [
    "1 pound okra, stems trimmed",
    "1 tablespoon extra-virgin olive oil, or more as needed",
    "1 pinch paprika, or to taste",
    "1 pinch garlic powder, or to taste",
    "salt and freshly ground black pepper to taste",
    "1 pinch cayenne pepper",
    "1 lemon, juiced",
    "0.25 teaspoon chopped fresh rosemary, or to taste",
    "0.25 teaspoon chopped fresh thyme, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss okra with olive oil, paprika, garlic powder, salt, pepper, and cayenne pepper in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill okra on the preheated grill until 1 side is bright green with visible grill marks, about 5 minutes. Turn okra, cover grill, and cook until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer okra to a serving bowl; sprinkle with lemon juice, rosemary, and thyme.",
