  "ingredients": [
    "2 cups egg whites",
    "0.25 teaspoon salt",
    "1.25 teaspoons cream of tartar",
    "1.25 cups white sugar",
    "1.25 cups confectioners' sugar",
    "1.25 cups cake flour",
    "0.25 cup unsweetened cocoa powder",
    "1.25 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix confectioners' sugar, cake flour, and cocoa. Sift together 2 times, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a clean large bowl, whip egg whites, salt, and cream of tartar with an electric mixer on high speed until very stiff. Fold in white sugar 2 tablespoons at a time while continuing to mix. Fold in flour mixture, a little at a time, until fully incorporated. Stir in vanilla. Pour into a 10 inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C) for approximately 1 hour, or until cake springs back when touched.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
