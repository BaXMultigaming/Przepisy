  "ingredients": [
    "1 teaspoon butter",
    "1 (15 ounce) can pumpkin puree",
    "2 eggs",
    "0.33333334326744 cup water",
    "1 tablespoon vanilla extract",
    "2 teaspoons pumpkin pie spice",
    "1 (18 ounce) package yellow cake mix",
    "1 teaspoon baking soda",
    "0.5 cup brown sugar",
    "0.5 cup all-purpose flour",
    "0.25 cup butter, melted",
    "0.5 cup brown sugar",
    "0.25 cup heavy whipping cream",
    "0.25 cup white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan with 1 teaspoon butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin puree, eggs, water, 1 tablespoon vanilla extract, and pumpkin pie spice in a large bowl. Stir in cake mix and baking soda until just combined. Pour batter into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup brown sugar, flour, and 1/4 cup melted butter in a small bowl until crumbly; sprinkle over batter with your fingers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup brown sugar, heavy cream, white sugar, and 1 teaspoon vanilla extract in a saucepan; bring to a simmer over medium heat. Remove from heat; stir until sugars are dissolved and glaze is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Poke holes all over top of cake with a toothpick. Pour glaze evenly over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
