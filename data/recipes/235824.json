  "ingredients": [
    "0.75 cup light molasses",
    "0.75 cup heavy whipping cream",
    "0.75 cup white sugar",
    "2 teaspoons unsweetened cocoa powder",
    "0.25 cup chopped almonds, or to taste",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Mix molasses, cream, sugar, and cocoa powder together in a pot; bring to a boil. Heat to 251 degrees F (122degrees C), or until a small amount of syrup dropped into cold water forms a firm but pliable ball, 30 to 40 minutes. The finished candy will be same firmness of the ball in water. Remove pot from heat and stir in almonds and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon candy into small paper candy cups. Cool to room temperature and store in an airtight container at room temperature.",
