  "ingredients": [
    "3 tablespoons butter",
    "3 leeks, chopped",
    "2 onions, chopped",
    "2 cloves garlic, minced",
    "2 pounds chopped mushrooms",
    "2 teaspoons dried savory",
    "0.25 teaspoon dried oregano",
    "0.33333334326744 cup sherry",
    "9 cups chicken stock",
    "2 tablespoons tomato paste",
    "1 bay leaf",
    "salt to taste",
    "ground black pepper to taste",
    "10 leaves fresh spinach"
  ],
  "steps": [
    {
      "text": "Saute butter, leeks, onion, and garlic until clear. Add mushrooms (except the 8 reserved chopped mushrooms), savory, oregano, sherry, stock, tomato paste and bay leaf. Simmer for 30 minutes or so.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain out the vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the reserved mushrooms and spinach leaves into the broth, and cook until spinach is wilted. Add salt and pepper to taste. Serve garnished with Parmesan cheese if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
