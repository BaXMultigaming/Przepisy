  "ingredients": [
    "1 cup panko bread crumbs",
    "2 ounces grated Parmesan cheese",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon ground paprika",
    "4 tablespoons Dijon mustard",
    "3 tablespoons honey",
    "1 tablespoon olive oil",
    "2 pounds skinless, boneless chicken breast halves",
    "4 cloves garlic, minced",
    "4 tablespoons Dijon mustard",
    "4 tablespoons honey",
    "3 tablespoons olive oil",
    "1 medium lemon, juiced",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Lightly coat a large baking dish with oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare chicken tenders: Mix panko, Parmesan cheese, salt, pepper, and paprika together in a medium bowl. Mix mustard, honey, and olive oil together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice chicken in half horizontally to form thin fillets. Cut each fillet into strips. Dip chicken strips in the mustard mixture, then coat in the panko, and place in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tenders are golden brown, 15 to 20 minutes, turning over halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare sauce: Mix garlic, mustard, honey, oil, lemon juice, salt, and pepper in a small bowl. Serve sauce with chicken tenders.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
