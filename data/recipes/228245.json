  "ingredients": [
    "3 long pickling cucumbers, thinly sliced",
    "1 red bell pepper, finely chopped",
    "1 sweet onion, finely chopped",
    "1 tablespoon salt",
    "2 teaspoons celery seed",
    "0.75 cup white sugar",
    "0.5 cup white wine vinegar",
    "5 half pint canning jars with lids and rings"
  ],
  "steps": [
    {
      "text": "Place cucumbers, bell pepper, onion, salt, and celery seeds in a large bowl; set aside at room temperature, stirring occasionally, for 1 hour. Mix sugar and vinegar together in a bowl, stirring until sugar dissolves; stir into pickle mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide pickle mixture among the jars; pour any excess liquid over top. Cover the jars with lids and rings. Refrigerate at least 24 hours; pickles will keep in the refrigerator for 3 weeks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
