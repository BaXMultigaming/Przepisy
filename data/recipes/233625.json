  "ingredients": [
    "cooking spray",
    "3 cups all-purpose flour",
    "1.5 cups brown sugar",
    "1.5 cups quick oats",
    "1 cup flaked coconut",
    "0.5 cup chopped walnuts",
    "1.25 cups butter, melted",
    "1 (18 ounce) jar raspberry preserves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Prepare a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, brown sugar, oats, coconut, and walnuts together in a bowl. Pour melted butter over the flour mixture and mix. The mixture should clump together easily when compressed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press about half the flour mixture into the bottom of the prepared baking dish; top with a layer of raspberry preserves. Finish by topping with the remaining flour mixture, patting lightly to complete the 'crust.'",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until browned, 20 to 25 minutes. Cool completely before cutting to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
