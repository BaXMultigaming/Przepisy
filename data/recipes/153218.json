  "ingredients": [
    "0.25 cup white sugar",
    "1.5 teaspoons ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 pastry for a 9-inch double crust pie",
    "5 apples, peeled, cored, and sliced",
    "2 tablespoons maple syrup",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Stir together the sugar, cinnamon, and nutmeg in a small bowl; set aside. Press one of the pastries into the bottom of a 9-inch pie pan; reserve the crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss the apples with maple syrup and vanilla extract. Spread 1/3 of the apples into the pie pan and sprinkle with the sugar mixture. Repeat the layers with the remaining apples and sugar. Cover the pie with the top crust and pinch the edges to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the crust is golden brown, 30 to 35 minutes. Allow to cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
