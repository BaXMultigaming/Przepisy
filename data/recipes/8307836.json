  "ingredients": [
    "1 (1 pound) loaf sourdough bread, cubed",
    "0.75 cup butter",
    "1.5 cups diced onion",
    "1.5 cups diced celery",
    "1.5 teaspoons kosher salt",
    "1.5 teaspoons poultry seasoning",
    "1 teaspoon ground black pepper",
    "2 cups chicken stock",
    "2 large eggs",
    "2.5 tablespoons finely chopped fresh parsley, divided",
    "2 teaspoons chopped fresh rosemary"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread cubes in a single layer on a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 to 12 minutes, stirring halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool. Increase oven temperature to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium-high heat. Add onion and celery and cook, stirring often, until onion is translucent and beginning to brown, about 7 minutes. Stir in salt, poultry seasoning, and pepper and remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together stock, eggs, parsley, and rosemary in a large bowl. Add cooled bread cubes and onion mixture; stir until very well combined. Pour mixture into the prepared baking dish and cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 45 minutes. Uncover and bake until golden brown and lightly toasted on top, 20 to 25 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with remaining parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
