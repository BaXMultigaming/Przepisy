  "ingredients": [
    "3 eggs",
    "0.75 cup white sugar",
    "0.75 cup melted butter",
    "1 teaspoon anise extract",
    "1 teaspoon vanilla extract",
    "0.75 cup all-purpose flour",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat pizzelle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and eggs together in a bowl using an electric mixer. Add butter, anise extract, and vanilla extract; beat until blended. Add flour and baking powder gradually; beat until smooth batter forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop a spoonful of batter onto the preheated iron. Bake until golden, about 45 seconds. Carefully remove pizzelle and cool on a cooling rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
