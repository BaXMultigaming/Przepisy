  "ingredients": [
    "2 cups white sugar",
    "1 cup shortening",
    "2 eggs",
    "1 (15 ounce) can pumpkin puree",
    "2 teaspoons vanilla extract",
    "4 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "1.5 teaspoons baking powder",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "1 pinch ground nutmeg",
    "1 cup semisweet chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar and shortening together in a bowl with an electric mixer until smooth; beat in eggs, one at a time, beating well after each addition. Stir in pumpkin purée and vanilla extract until well blended. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, baking powder, salt, cinnamon, and nutmeg together in a separate bowl; stir into pumpkin mixture until well mixed. Stir in chocolate chips and walnuts until evenly distributed. Drop dough by teaspoonfuls onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges begin to brown, 12 to 15 minutes. Cool for 3 to 5 minutes on the baking sheets before transferring cookies to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
