  "ingredients": [
    "1.5 cups mashed banana",
    "0.33333334326744 cup oil",
    "0.33333334326744 cup milk, or as needed",
    "1 medium egg, beaten",
    "1.5 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "2 teaspoons cocoa powder",
    "0.5 cup white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a muffin tin with 12 paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mashed banana, oil, milk, egg, and vanilla extract in a medium bowl. Sift flour and cocoa powder into a large bowl. Add sugar, baking powder, and salt into the flour mixture; mix to combine. Add wet ingredients to dry ingredients, mixing until just combined. Batter should be wet enough to scoop into muffin liners; add a little extra milk if your mixture is too dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chocolate chips into batter. Scoop batter into muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
