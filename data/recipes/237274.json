  "ingredients": [
    "7 slices white bread, cut into cubes",
    "0.5 cup butter, melted",
    "30 ounces crushed pineapple",
    "4 eggs",
    "0.5 cup white sugar"
  ],
  "steps": [
    {
      "text": "Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread bread cubes in the bottom of the prepared casserole dish. Pour butter over bread cubes and top with pineapple.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and sugar together in a bowl until foamy; pour over bread mixture. Cover dish with aluminum foil and refrigerate, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Remove aluminum foil and bake until browned, 5 to 20 minutes.",
      "section": null,
      "name": null,
