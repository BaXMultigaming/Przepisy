  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain; rinse in cold water until completely cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place macaroni in a large bowl; stir in tomatoes, bell pepper, cucumber, and green onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk sugar, oil, ketchup, vinegar, salt, paprika, and black pepper together in a bowl until sugar dissolves; pour over macaroni-vegetable mixture and toss to coat.",
      "section": null,
