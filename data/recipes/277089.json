  "ingredients": [
    "1.5 cups Italian bread crumbs",
    "2 eggs",
    "0.5 cup grated Romano cheese",
    "4 cloves garlic, minced",
    "1.5 tablespoons chopped Italian flat-leaf parsley",
    "1 teaspoon anchovy paste",
    "salt to taste",
    "1 pound ground beef",
    "1 pound bulk Italian sausage",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a sheet pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs, eggs, Romano cheese, garlic, parsley, anchovy paste, and salt in a large bowl. Mix until eggs are well beaten. Add ground beef and sausage; mix to combine. Add milk and stir until mixture comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop out and roll together 2 tablespoons of mixture per meatball. Place meatballs very close together on the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an instant-read thermometer inserted into a meatball reads 160 degrees F (71 degrees C), 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
