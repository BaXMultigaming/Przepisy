  "ingredients": [
    "1 (16 ounce) can crushed tomatoes",
    "0.5 small white onion, thinly sliced",
    "3 tablespoons balsamic vinegar",
    "0.5 teaspoon ground cumin",
    "4 skinless, boneless chicken breast halves",
    "0.5 tablespoon Italian seasoning",
    "0.5 tablespoon lemon pepper seasoning",
    "0.5 teaspoon garlic salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine crushed tomatoes, onion, vinegar, and cumin in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken breasts in a baking dish. Season with Italian seasoning, lemon pepper, and garlic salt. Pour the tomato mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until chicken is no longer pink in the center and the juices run clear, about 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
