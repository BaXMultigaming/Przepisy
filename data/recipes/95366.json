  "ingredients": [
    "1 cup butter, softened",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 egg, separated",
    "1 tablespoon vanilla extract",
    "2 cups all-purpose flour",
    "1 tablespoon cardamom",
    "0.75 teaspoon salt",
    "0.33333334326744 cup chopped pecans",
    "1.5 tablespoons Butter",
    "1 cup confectioners' sugar",
    "1 tablespoon milk, or as needed",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C). Grease a 10x15-inch jelly roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 1 cup butter, white sugar, and brown sugar together in a large bowl with an electric mixer until light and fluffy. Beat in egg yolk and 1 tablespoon vanilla extract. Combine flour, cardamom, and salt in a bowl; stir into butter mixture until it forms a soft dough. Spread dough evenly into the prepared pan. Brush with egg white; sprinkle pecans over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt 1 1/2 tablespoons butter in a saucepan over low heat until it starts to brown. Off heat, stir in confectioners' sugar until smooth. Stir in enough milk to achieve a drizzling consistency; stir in 1/2 teaspoon vanilla extract. Drizzle frosting onto warm bars; cool, then cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
