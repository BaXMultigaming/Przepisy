  "ingredients": [
    "1 turkey carcass",
    "4 quarts water",
    "1 (28 ounce) can whole peeled tomatoes, chopped",
    "6 small potatoes, diced",
    "4 large carrots, diced",
    "1 large onion, diced",
    "2 stalks celery, diced",
    "1.5 cups shredded cabbage",
    "0.5 cup uncooked barley",
    "1 tablespoon Worcestershire sauce",
    "1.5 teaspoons salt",
    "1 teaspoon dried parsley",
    "1 teaspoon dried basil",
    "1 large bay leaf",
    "0.25 teaspoon freshly cracked black pepper",
    "0.25 teaspoon ground paprika",
    "0.25 teaspoon poultry seasoning",
    "1 pinch dried thyme"
  ],
  "steps": [
    {
      "text": "Place turkey carcass in a large soup pot and cover with water; bring to a boil over medium heat. Reduce heat to a simmer, and cook until the remaining meat falls off the bones, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove turkey carcass from the pot; pick off and chop any remaining turkey meat, discarding bones.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BpwexsFRIHLob3POojETbA5vJw0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218804-TurkeyCarcassSoup-mfs-Step2-1687-ae8bd357e82848ef9fc7060b96ce50dc.jpg"
      ],
      "image": "assets/images/218804/step_02.webp"
    },
    {
      "text": "Strain broth through a fine mesh strainer into a clean soup pot. Add chopped turkey to the strained broth and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/15efQ_zdPWSnBwg_6dTN1RU9lxQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218804-TurkeyCarcassSoup-mfs-Step3-1690-d114217067194d1ea47fe8a1e1627a48.jpg"
      ],
      "image": "assets/images/218804/step_03.webp"
    },
    {
      "text": "Reduce heat and stir in tomatoes, potatoes, carrots, onion, celery, cabbage, barley, Worcestershire sauce, salt, parsley, basil, bay leaf, pepper, paprika, poultry seasoning, and thyme. Simmer until vegetables and barley are tender, about 1 more hour. Remove bay leaf before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F3sbw9VyxiEVJSMVGpenlidLgHo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218804-TurkeyCarcassSoup-mfs-Step4-1700-e45917346651498ebc6fd5260b988da2.jpg"
      ],
      "image": "assets/images/218804/step_04.webp"
    }
