  "steps": [
    {
      "text": "Cook pasta according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place peas, spinach, basil, Parmesan, olive oil, walnuts, garlic and salt and pepper in a blender or food processor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Two minutes before pasta is done, ladle out 1/2 cup hot pasta cooking water and add to blender. Pulse until smooth, scraping sides and adding additional pasta water by the tablespoon, if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When pasta is done, drain lightly and return to pot. Add sauce and toss to coat. Season to taste with salt and pepper. Serve immediately with additional Parmesan cheese and tomatoes, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
