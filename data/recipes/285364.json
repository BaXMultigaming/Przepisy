  "ingredients": [
    "0.75 cup water",
    "0.75 cup white vinegar",
    "2 tablespoons white sugar",
    "4 cloves garlic, minced",
    "1 teaspoon salt",
    "1.5 cups jalapeno peppers, sliced"
  ],
  "steps": [
    {
      "text": "Inspect a 12-ounce jar for cracks and ring for rust, discard if defective. Immerse in simmering water until pickled jalapeño is ready. Wash new, unused lid and ring in warm soapy water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water, vinegar, sugar, garlic, and salt to a boil in a small saucepan, stirring, until sugar dissolved. Cool, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pack jalapeños in the sterilized jar; pour cooled vinegar brine over top, filling to within ½ inch of top. Wipe rim with a moist paper towel to remove any residue. Top with lid and screw ring on tightly. Refrigerate before serving for 24 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
