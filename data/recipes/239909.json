  "ingredients": [
    "1 tablespoon olive oil",
    "1 large onion, chopped",
    "1.5 pounds ground beef",
    "1 teaspoon garlic powder",
    "0.5 teaspoon red pepper flakes",
    "0.5 teaspoon Italian seasoning",
    "salt and pepper to taste",
    "1 small head cabbage, chopped",
    "2 (14.5 ounce) cans diced tomatoes",
    "1 (14.5 ounce) can tomato sauce"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large heavy pot or a 6-quart Dutch oven over medium heat. Cook and stir onion in hot oil until translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Break ground beef into small chunks and add to the pot; cook and stir, continuing to break the beef into smaller pieces, until the beef is completely browned, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season beef mixture with garlic powder, red pepper flakes, Italian seasoning, and a dash of salt. Stir cabbage, diced tomatoes, and tomato sauce with the beef mixture; bring to a boil, reduce heat to low, and cook mixture at a simmer until cabbage is fork-tender, about 25 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
