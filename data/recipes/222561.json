  "ingredients": [
    "2 cups sliced radishes",
    "0.5 teaspoon salt",
    "1 cup sliced red onion",
    "1 cup seeded and sliced cucumber",
    "0.5 cup extra virgin olive oil",
    "2 tablespoons white wine vinegar",
    "1 teaspoon chopped fresh dill",
    "1 clove garlic, minced",
    "0.5 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Toss radishes with salt; let stand for about 10 minutes. Drain any liquid and transfer radishes to a large bowl; add red onion and cucumber slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, vinegar, dill, garlic, and sugar together in a small bowl until well mixed; pour over vegetables and toss to combine. Cover and refrigerate for at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
