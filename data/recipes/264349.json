  "ingredients": [
    "1.5 cups mangos - peeled, seeded, chopped, and chilled",
    "1.5 cups plain yogurt",
    "0.5 cup cold milk",
    "2 tablespoons heavy cream",
    "2 tablespoons confectioners' sugar",
    "0.5 teaspoon ground cardamom"
  ],
  "steps": [
    {
      "text": "Combine mangos, yogurt, milk, cream, confectioners' sugar, and cardamom in a blender; blend until smooth and frothy. Pour into glasses and serve immediately.",
