  "ingredients": [
    "20 pounds bone-in ham",
    "1 (20 ounce) can sliced pineapple",
    "2 (12 fluid ounce) cans beer"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease an 18 quart roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the ham, with the fattier side up, in the roaster. Use toothpicks to secure pineapple rings on the ham. Pour the beer over the ham. Place lid on roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 6 to 8 hours, or until cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the pineapple rings and let sit 15 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
