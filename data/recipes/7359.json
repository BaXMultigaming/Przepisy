  "ingredients": [
    "1.5 cups boiling water",
    "0.5 cup rolled oats",
    "0.5 cup whole bran cereal",
    "1 cup white sugar",
    "1 cup packed light brown sugar",
    "0.5 cup shortening",
    "2 eggs",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Pour boiling water over oats and bran cereal, and let stand 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the remaining ingredients, and add oat mixture to them. Pour into two 8 or 9 inch pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F ( 175 degrees C) for 30 to 40 minutes. To make muffins bake about 15 minutes, or until toothpick comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
