  "ingredients": [
    "3 tablespoons white sugar",
    "2 tablespoons cornstarch",
    "0.125 teaspoon salt",
    "0.125 teaspoon ground cinnamon",
    "2 cups whole milk"
  ],
  "steps": [
    {
      "text": "Whisk sugar, cornstarch, salt, and cinnamon together in a large saucepan; stir in milk until evenly blended. Heat over medium-high heat; cook and whisk until reaches a thick consistency, 25 to 30 minutes, making sure to continually whisk while custard cooks to avoid burning or clumping. The custard will thicken as it cools. Divide between bowls.",
