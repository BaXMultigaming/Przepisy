  "ingredients": [
    "2 teaspoons lime juice",
    "0.33333334326744 cup milk",
    "0.5 cup butter, softened",
    "0.75 cup white sugar",
    "1 egg",
    "2 teaspoons lime zest",
    "1.75 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "2 tablespoons lime juice",
    "0.25 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Combine the 2 teaspoons of lime juice with the milk, let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter and 3/4 cup sugar until light and fluffy. Beat in the egg, then stir in the lime zest and milk mixture. Combine the flour, baking powder and baking soda, blend into the creamed mixture. Drop by rounded spoonfuls onto the ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven, until the edges are light brown. Allow cookies to cool on baking sheets for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the glaze, stir together the remaining lime juice and sugar. Brush onto cooled cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
