  "ingredients": [
    "2 tablespoons olive oil",
    "2 teaspoons hot sauce",
    "0.5 teaspoon cumin",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon paprika",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon salt",
    "1 large sweet potato, cut into wedges"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil oil, hot sauce, cumin, thyme, paprika, garlic powder, and salt together in a large bowl. Add sweet potato wedges and stir until wedges are evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sweet potato wedges on the preheated grill and cook for 5 minutes. Flip wedges with tongs and cook 5 additional minutes.",
