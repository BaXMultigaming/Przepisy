  "ingredients": [
    "0.5 cup graham cracker crumbs",
    "3 (8 ounce) packages cream cheese",
    "0.875 cup white sugar",
    "0.5 cup heavy cream",
    "2 tablespoons sour cream",
    "0.25 cup half-and-half",
    "1.5 teaspoons vanilla extract",
    "4 eggs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Wrap the outside of an 8 inch springform pan with foil. Generously butter the inside of pan and sprinkle with graham cracker crumbs, then shake out excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, Beat cream cheese and sugar on low speed until smooth. Beat in heavy cream, sour cream and half-and-half. Add vanilla and beat in the eggs one at a time. Pour filling into prepared pan. Wrap bottom of the pan on aluminum foil to prevent water from seeping in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cheesecake in a water bath. Bake in the preheated oven for 75 minutes, or until filling is set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
