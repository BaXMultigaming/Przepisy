  "ingredients": [
    "1 cup unsalted butter",
    "1.5 tablespoons minced garlic",
    "1 tablespoon all-purpose flour",
    "4 cups heavy cream",
    "0.25 cup whole milk",
    "8 ounces freshly shredded Parmesan cheese",
    "2 ounces shredded fontina cheese",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium heat. Stir in garlic and flour; cook and stir until garlic is fragrant but not brown, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/incWz-JppcT2Jo0xPtLAJMXnlzc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/2547412-3a3530bd2a2e4dc2bf024b47f524c26b.jpg"
      ],
      "image": "assets/images/219767/step_01.webp"
    },
    {
      "text": "Whisk in heavy cream and milk until mixture is hot and slightly thickened, about 10 minutes. Gradually stir in Parmesan cheese and fontina cheese. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue to simmer until cheese melts and sauce thickens, stirring often, 20 to 30 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
