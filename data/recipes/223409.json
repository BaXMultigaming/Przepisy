  "ingredients": [
    "1 (16 ounce) bag coleslaw mix",
    "1 cup mayonnaise",
    "0.25 cup white sugar, or to taste",
    "2 tablespoons cider vinegar",
    "0.5 teaspoon onion powder",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place coleslaw mix in a large bowl. Combine mayonnaise, sugar, vinegar, onion powder, salt, and pepper in a small bowl. Pour mayonnaise mixture over coleslaw mix and toss to coat. Refrigerate for at least 30 minutes; serve with a slotted spoon.",
