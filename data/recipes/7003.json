  "ingredients": [
    "3 cups all-purpose flour",
    "3 eggs",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "2 cups applesauce",
    "1 cup raisins",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "0.5 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together eggs, sugar, and oil. Blend in applesauce, and then sour cream or buttermilk. Mix in flour, baking powder, soda, and cinnamon. Stir in raisins. Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour and 20 minutes. Cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
