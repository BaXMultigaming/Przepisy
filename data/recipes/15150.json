  "ingredients": [
    "6 green onions, chopped",
    "3 tablespoons minced shallots",
    "2 cloves garlic, minced",
    "1 teaspoon ground ginger",
    "1 tablespoon ground allspice",
    "1 teaspoon ground black pepper",
    "2 scotch bonnet chile peppers, chopped",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "1 teaspoon salt",
    "1 tablespoon brown sugar",
    "0.5 cup fresh orange juice",
    "0.5 cup cider vinegar",
    "0.25 cup red wine",
    "0.25 cup soy sauce",
    "0.25 cup vegetable oil",
    "1 tablespoon molasses"
  ],
  "steps": [
    {
      "text": "In a medium bowl, combine the green onions, shallots, garlic, ginger, allspice, ground black pepper, chile peppers, cinnamon, nutmeg, salt, brown sugar, orange juice, vinegar, wine, soy sauce, oil, and molasses. Mix well, cover, and allow to sit for one hour. Stir again before using with fish or meat. Discard any remaining sauce.",
