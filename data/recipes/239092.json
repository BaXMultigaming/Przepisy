  "ingredients": [
    "1 cup rice milk",
    "1 carrot, shredded",
    "0.25 cup ice cubes, or as desired",
    "1 tablespoon honey, or to taste",
    "1 pinch ground cinnamon",
    "1 pinch ground nutmeg"
