  "title": "PHILLY Caramel Cheesecake Bars",
  "description": "Take cheesecake bars over-the-top with a drizzle of caramel and a dusting of chopped pecans.",
  "authors": [
    "PHILADELPHIA Cream Cheese"
  ],
  "date_published": "2010-06-16T11:45:21-04:00",
