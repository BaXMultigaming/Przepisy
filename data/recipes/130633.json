  "ingredients": [
    "0.5 cup white sugar",
    "2.5 cups vanilla wafer crumbs",
    "0.5 cup confectioners' sugar",
    "1 cup chopped pecans",
    "2 cups semisweet chocolate chips",
    "3 tablespoons light corn syrup",
    "0.25 cup bourbon whiskey"
  ],
  "steps": [
    {
      "text": "Place the sugar in a shallow bowl, and set aside. Combine the vanilla wafer crumbs, confectioners' sugar, and pecans in a bowl, and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the chocolate chips in a microwave-safe bowl, and microwave on High for 1 to 2 minutes to melt the chips. Stir the melted chips until smooth, and beat in the corn syrup and whiskey. Scrape the chocolate mixture into the crumb mixture, and stir well to mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form the dough into 1-inch balls, and roll each ball in sugar. Place the finished bourbon balls on a cooling rack to finish setting up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
