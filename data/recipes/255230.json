  "ingredients": [
    "6 slices bacon",
    "4 eggs, divided",
    "2 cups baking mix (such as Bisquick®)",
    "1.3333333730698 cups milk",
    "2 tablespoons vegetable oil",
    "0.25 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels; crumble into small pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 3 eggs in a small bowl until smooth; pour into the hot skillet. Cook, stirring, over medium heat until scrambled and set, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a cake pop maker according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining egg, baking mix, milk, and vegetable oil in a large bowl to make pancake batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold crumbled bacon, scrambled eggs, and Cheddar cheese gently into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill wells of preheated cake pop machine with batter. Cook until golden brown, 4 to 6 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
