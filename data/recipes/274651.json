  "ingredients": [
    "2 tablespoons all-purpose flour",
    "2 tablespoons white sugar",
    "1 tablespoon dried thyme",
    "2 teaspoons ground black pepper",
    "1 teaspoon salt",
    "48 large chicken wings"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Lightly grease 1 to 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, thyme, pepper, and salt together in a large bowl. Add wings and toss until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread chicken wings out in a single layer on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast chicken wings until golden brown and no longer pink in the centers, 15 to 20 minutes, turning once after 10 minutes.",
