  "ingredients": [
    "6 cups mixed frozen berries",
    "4 tablespoons white sugar",
    "2 teaspoons cornstarch",
    "1.5 cups rolled oats",
    "1.5 cups packed brown sugar",
    "1 cup all-purpose flour",
    "0.75 cup chopped pecans",
    "1 teaspoon ground cinnamon",
    "1 cup unsalted butter, cut into small pieces"
  ],
  "steps": [
    {
      "text": "Defrost frozen berries for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease the bottom of a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss berries, white sugar, and cornstarch together in a large bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, brown sugar, flour, pecans, and cinnamon in a separate large bowl. Cut in butter with a pastry blender or 2 knives until crumbly. Press 1/2 of the mixture over the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 7 to 8 minutes. Cover with berry mixture. Sprinkle remaining crumble mixture over the berries. Continue to bake until fruit is bubbly and topping is golden brown, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
