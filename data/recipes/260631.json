  "ingredients": [
    "cooking spray",
    "7 tablespoons butter, at room temperature",
    "0.25 cup white sugar",
    "2 tablespoons white sugar",
    "1 egg",
    "1.6666667461395 cups all-purpose flour",
    "1 pinch salt, or to taste",
    "6 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 350 degrees F (180 degrees C). Spray a small fluted tube pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and 1/4 cup plus 2 tablespoons sugar together in a bowl using an electric mixer until light and creamy. Add egg and mix until smooth and fluffy. Stir in flour and salt. Add milk and mix batter thoroughly. Transfer batter to the prepared pan; use the back of a spoon to level the surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the pan in the air fryer basket. Set the timer for 15 minutes. Bake until a toothpick inserted into the cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn cake out of pan and allow to cool, about 5 minutes.",
      "section": null,
      "name": null,
