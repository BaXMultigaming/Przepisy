  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup rice flour",
    "0.25 cup stevia powder, or to taste",
    "1 tablespoon baking powder",
    "0.5 teaspoon baking soda",
    "1 pinch salt",
    "3 ripe bananas, mashed",
    "0.75 cup unsweetened almond milk",
    "0.25 cup vegetable oil",
    "1 egg",
    "0.75 cup pine nuts",
    "0.25 cup flax seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all-purpose flour, rice flour, stevia powder, baking powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bananas, almond milk, vegetable oil, and egg in another bowl; beat with an electric mixer until smooth. Stir banana mixture into flour mixture until incorporated, then fold in pine nuts and flax seeds. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center of loaf comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
