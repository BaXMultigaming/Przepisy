  "ingredients": [
    "2 tablespoons vegetable oil",
    "3 medium potatoes, peeled and cut into strips",
    "1 (16 ounce) jar sliced nopalitos, drained and rinsed",
    "1 medium onion, diced",
    "1 small tomato, diced",
    "1 medium jalapeño pepper, minced",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add potatoes, cover, and cook, stirring occasionally, until they begin to soften, about 10 minutes. Stir in the nopalitos, onion, tomato, jalapeño, and salt. Continue to cook, stirring occasionally, until onion is soft and translucent and potatoes are tender, about 10 minutes more.",
