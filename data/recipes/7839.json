  "ingredients": [
    "1 (18.25 ounce) package moist yellow cake mix",
    "0.5 cup white sugar",
    "1 cup vegetable oil",
    "4 eggs",
    "1 (4 ounce) jar apricot baby food",
    "1 (4 ounce) jar plum baby food",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (175 degrees C). Grease and flour one 9 or 10 inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the cake mix, sugar, vegetable oil, eggs, apricot baby food and plum baby food. Mix for 2 minutes. Stir in walnuts and pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 1 hour. Wonderful with a light dusting of confectioner's sugar or with an almond frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
