  "ingredients": [
    "1 pound lean ground beef",
    "4.5 cups water",
    "1 (28 ounce) can crushed tomatoes",
    "0.5 (32 fluid ounce) container beef broth",
    "1 (15.25 ounce) can whole kernel sweet corn (such as Green Giant® Niblets®), undrained",
    "2 stalks celery, thinly sliced",
    "1 medium onion, chopped",
    "1 cup frozen lima beans",
    "0.75 cup barley",
    "1 cube beef bouillon",
    "1 teaspoon ground paprika",
    "1 bay leaf",
    "0.5 teaspoon Italian seasoning",
    "2 cups elbow macaroni",
    "1 tablespoon chopped fresh parsley, or to taste"
  ],
  "steps": [
    {
      "text": "Cook and stir ground beef in a large skillet over medium-high heat until browned and crumbly, 5 to 7 minutes. Drain excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer beef to a slow cooker; add water, tomatoes, broth, undrained corn, celery, onion, lima beans, barley, bouillon, paprika, bay leaf, and Italian seasoning. Cover the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil when 15 minutes remain on the timer. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir macaroni into soup until combined and heated through. Garnish servings with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
