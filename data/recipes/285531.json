  "ingredients": [
    "1 cup white sugar",
    "1 cup water",
    "0.5 cup chopped fresh ginger",
    "0.25 cup freshly squeezed lime juice",
    "1.5 cups sparkling apple cider",
    "1 cup vodka (such as Tito's®)",
    "1 medium lime, cut into 4 wedges",
    "4 cups ice, or as needed"
  ],
  "steps": [
    {
      "text": "Combine sugar, water, and ginger in a small saucepan over medium-high heat. Bring to a simmer, and stir constantly until sugar is dissolved. Remove from heat and strain into a pitcher; discard solids. Let cool completely, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/4 cup cooled ginger syrup into a separate pitcher; reserve remaining ginger syrup for a later use. Stir in lime juice, sparkling cider, and vodka. Pour into 4 ice-filled glasses and garnish with lime wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
