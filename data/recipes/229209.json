  "ingredients": [
    "12 slices apple",
    "1 cup applesauce",
    "0.5 cup butter, melted",
    "2 eggs",
    "0.75 cup brown sugar",
    "1 cup bread crumbs, or as needed",
    "0.5 cup butter, cut into small chunks",
    "0.25 cup white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x8-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix apple slices and applesauce together in a bowl. Whisk 1/2 cup melted butter and eggs together in a separate bowl; pour into apple mixture. Stir in brown sugar until well incorporated. Pour apple mixture into prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs, 1/2 cup butter, white sugar, and vanilla extract together in a bowl; sprinkle over apple mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apples are tender and topping is lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
