  "ingredients": [
    "1 tablespoon olive oil",
    "2 pounds diced boneless chicken",
    "0.5 cup chopped onion",
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "1 (7 ounce) can chopped green chile peppers",
    "1 cup sour cream",
    "0.25 cup milk",
    "1 tablespoon ground cumin",
    "1 tablespoon chili powder",
    "0.5 teaspoon ground coriander",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon crushed red pepper flakes",
    "1 (14.5 ounce) package tortilla chips, or as needed",
    "3 cups shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat. Add chicken and saute for about 5 minutes. Add onion and saute until softened, another 5 minutes. Stir in condensed soup, chile peppers, sour cream, milk, cumin, chili powder, coriander, cayenne pepper, and pepper flakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer 1/2 of the chicken mixture into a 9x13-inch pan. Layer with 1/2 of the tortilla chips and 1/2 of the Monterey Jack cheese. Repeat layers once more and cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Remove foil and bake for 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
