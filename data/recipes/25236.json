  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 cup diced onion",
    "3 tablespoons chopped garlic",
    "1 teaspoon dried oregano",
    "1 teaspoon ground cumin",
    "0.25 teaspoon ground cinnamon",
    "3 tablespoons all-purpose flour",
    "5 tablespoons hot chili powder",
    "4.5 cups chicken broth",
    "0.5 (1 ounce) square semisweet chocolate"
  ],
  "steps": [
    {
      "text": "Heat oil in a large saucepan over medium-high high heat. Sauté onion until tender. Stir in garlic, oregano, cumin and cinnamon; sauté for a few minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour and chili powder until sauce thickens. Slowly whisk in chicken broth; reduce until sauce reaches desired consistency. Stir in chocolate until melted and well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
