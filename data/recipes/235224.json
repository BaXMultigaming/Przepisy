  "ingredients": [
    "1 cup white sugar",
    "0.5 cup brown sugar",
    "0.25 cup butter, softened",
    "0.25 cup applesauce",
    "1 egg",
    "2 egg whites",
    "1 cup mashed ripe bananas",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "2 cups self-rising flour",
    "0.5 cup buttermilk",
    "1 (8 ounce) can crushed pineapple, drained",
    "0.5 cup chopped maraschino cherries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease two 8x4-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar, brown sugar, butter, and applesauce together in a bowl using an electric mixer until light and fluffy. Beat egg and egg whites into sugar mixture; stir in bananas, vanilla extract, and cinnamon. Mix flour, alternating with buttermilk, into sugar mixture until batter is well mixed; fold in pineapple and cherries. Pour batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 45 to 55 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
