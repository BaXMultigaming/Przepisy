  "ingredients": [
    "2 quarts hot water",
    "2 cups brown sugar",
    "0.5 cup butter",
    "1 pinch salt",
    "6 whole cloves",
    "3 cinnamon sticks",
    "2 cups rum",
    "1 cup sweetened whipped cream",
    "ground nutmeg to taste"
  ],
  "steps": [
    {
      "text": "Combine hot water, brown sugar, butter, and salt in a 5-quart slow cooker; add cloves and cinnamon sticks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker. Cook on Low for 5 hours. Stir in rum.",
