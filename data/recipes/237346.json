  "ingredients": [
    "1 tablespoon butter",
    "1 small beet, peeled and thinly sliced",
    "3 ounces carrots, peeled and thinly sliced",
    "3.5 ounces daikon radishes, thinly sliced",
    "2 crimini mushrooms, thinly sliced",
    "3.5 ounces bok choy",
    "0.25 teaspoon ground cardamom"
