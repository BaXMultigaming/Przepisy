  "steps": [
    {
      "text": "Melt butter in a skillet over medium-high heat; saute beet, carrots, daikon radishes, and mushrooms until slightly tender, about 5 minutes. Cover skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut bottom half off bok choy and chop. Slice bok choy leaves into ribbons.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chopped bok choy into beet mixture; cook and stir until bok choy is tender, about 5 minutes. Add cardamom and bok choy leaves; cook and stir for 1 minute more.",
