  "ingredients": [
    "1 pound imitation crabmeat, coarsely chopped",
    "3 tablespoons butter",
    "2 teaspoons minced garlic",
    "1.5 teaspoons lemon pepper",
    "0.25 cup grated Romano cheese"
  ],
  "steps": [
    {
      "text": "In a medium sauce pan, heat butter until melted. Add the garlic and saute lightly. Add the imitation crabmeat and cook over medium heat, turning gently. Add the lemon pepper and continue to cook until hot. Add grated cheese and serve.",
