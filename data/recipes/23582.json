  "ingredients": [
    "1 pound cooked, chopped turkey meat",
    "3 cups water",
    "salt and pepper to taste",
    "3 tablespoons all-purpose flour",
    "1 (12 ounce) package refrigerated biscuit dough"
  ],
  "steps": [
    {
      "text": "Place turkey, water, salt, and pepper in a medium saucepan and bring to a boil. Reduce heat and simmer 30 to 40 minutes until a broth has formed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread flour on a medium cutting board or another flat surface. Roll out biscuit dough and cut it into 1x2-inch pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough pieces into broth and cook over low heat until cooked through, about 15 minutes.",
