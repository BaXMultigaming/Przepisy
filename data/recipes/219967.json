  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "3 ripe bananas, mashed",
    "2 large eggs",
    "1 tablespoon milk",
    "0.25 teaspoon vanilla extract",
    "1 cup chopped walnuts",
    "0.33333334326744 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat a 9x4-inch loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour, baking powder, baking soda, and salt in a medium bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together sugar and butter with an electric mixer in a large bowl until smooth. Add mashed bananas and mix until combined. Add eggs, one at a time, beating well after each addition. Stir in milk and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour mixture, walnuts, and chocolate chips until just incorporated. Pour batter into the prepared loaf pan. Tap pan on the counter to release any air pockets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour and 10 minutes. Let rest in the pan for 15 to 20 minutes. Remove bread from the pan, then slice and serve.",
      "section": null,
      "name": null,
      "url": null,
