  "title": "Vidalia Onion Tart",
  "description": "Sweet onions are whisked together with sour cream and eggs, flavored with leek soup mix and finished with shredded Monterey Jack cheese.",
  "authors": [
    "sweetpotato"
  ],
  "date_published": "2000-05-25T19:04:57-04:00",
