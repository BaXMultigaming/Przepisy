  "ingredients": [
    "1 cup chocolate graham crackers",
    "0.25 cup white sugar",
    "0.125 teaspoon ground cinnamon",
    "0.25 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crumble graham crackers in a food processor with sugar and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a microwave-safe bowl and melt in a microwave oven, about 1 minute. Add to the mixture in the food processor and blend until combined into the dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough out into a crust and place into a pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 7 minutes. Let cool completely before filling, about 30 minutes.",
