  "ingredients": [
    "1 (7 ounce) package elbow macaroni",
    "1 pound bacon, diced",
    "2 tablespoons lemon juice",
    "1 large avocado, diced",
    "0.5 cup mayonnaise",
    "0.5 cup creamy salad dressing (such as Miracle Whip®)",
    "0.33333334326744 cup tomato-based chile sauce",
    "0.25 cup lemon juice",
    "2 teaspoons chicken bouillon granules",
    "2 teaspoons white sugar",
    "1 large tomato - cored, seeded, and diced",
    "0.5 cup sliced green onion tops",
    "6 cups shredded lettuce"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and rinse with cold water. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a large skillet over medium heat until browned and crisp, about 7 minutes. Drain on paper towels. Refrigerate bacon when cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle 2 tablespoons lemon juice over avocado in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise, creamy dressing, chili sauce, ¼ cup lemon juice, bouillon granules, and sugar; fold in macaroni, avocado, tomato, and green onions until well combined. Cover the bowl tightly with plastic wrap; refrigerate until well chilled, at least 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in lettuce and bacon just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
