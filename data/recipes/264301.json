  "ingredients": [
    "2.5 cups old-fashioned rolled oats",
    "1.5 cups unsweetened almond milk",
    "2 large egg whites, lightly beaten",
    "0.25 cup agave nectar",
    "2 tablespoons melted coconut oil",
    "2 tablespoons dark brown sugar",
    "1 teaspoon vanilla bean paste",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking powder",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground cardamom",
    "0.75 cup blackberries",
    "0.75 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Combine oats and almond milk in a large bowl. Cover and let soak in the refrigerator until much of the liquid is absorbed, 8 to 12 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 12-cup nonstick muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir egg whites, agave syrup, coconut oil, brown sugar, vanilla paste, cinnamon, baking powder, nutmeg, salt, and cardamom into the oat-milk mixture. Fold in blackberries. Divide batter among the muffin cups, about 1/4 cup each. Top each muffin with 1 tablespoon blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake muffins in the preheated oven until tops spring black when touched, 30 to 35 minutes. Let cool in tin for 10 minutes. Serve warm or wrap airtight and refrigerate for up to 2 days. Can be frozen for up to 3 months.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
