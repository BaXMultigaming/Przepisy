  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix Brussels sprouts, apples, oil, bacon, maple syrup, pepper, salt, thyme, marjoram, rosemary, lavender, fennel, and oregano together in a large bowl. Spread in an even layer on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until Brussels sprouts are tender and bacon is crisp, 30 to 35 minutes.",
