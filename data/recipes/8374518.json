  "ingredients": [
    "1 (3 ounce) package chicken-flavored ramen noodles",
    "1 cup cubed, cooked chicken",
    "0.25 cup chopped baby spinach",
    "6 asparagus spears, trimmed",
    "2 baby carrots, diced into bite-sized pieces",
    "1 green onion, chopped",
    "1 teaspoon sesame oil",
    "1 dash Sriracha sauce",
    "2 cups water"
  ],
  "steps": [
    {
      "text": "Crumble ramen noodles into a microwavable to-go container with a lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle half of the season packet over the noodles and discard the rest of the packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken, spinach, asparagus, carrots, green onion, sesame oil and Sriracha sauce and put the lid on. Refrigerate until lunchtime.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the lid and pour water into the noodle bowl. Microwave on high for 5 minutes. Let stand 3 minutes before digging in.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
