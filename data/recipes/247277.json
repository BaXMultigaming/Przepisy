  "ingredients": [
    "1 (16 ounce) bottle zesty Italian dressing",
    "3 yellow squash, cut into 1/2-inch pieces",
    "3 zucchini, cut into 1/2-inch pieces",
    "2 cups cherry tomatoes",
    "1 bunch spring onions, minced",
    "wood chips, soaked"
  ],
  "steps": [
    {
      "text": "Mix Italian dressing, yellow squash, zucchini, cherry tomatoes, and spring onions together in a large bowl. Cover with plastic wrap; let marinate in the refrigerator for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a vegetable tray in a smoker and heat to 250 degrees F (121 degrees C) according to manufacturer's instructions. Add wood chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer marinated vegetables to the tray, reserving excess dressing in the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook vegetables, basting every 20 minutes with 1/3 of the reserved dressing, until tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
