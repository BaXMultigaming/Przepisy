  "ingredients": [
    "3 tablespoons white sugar",
    "1 tablespoon active dry yeast",
    "1.25 cups warm water",
    "1.3333333730698 cups rice flour",
    "0.66666668653488 cup sorghum flour",
    "0.5 cup potato starch",
    "0.5 cup cornstarch",
    "0.33333334326744 cup vegetable oil",
    "3 eggs",
    "1 tablespoon xanthan gum",
    "1.5 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve sugar and yeast in warm water in a bowl. Let stand until yeast softens and begins to form a creamy foam, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine yeast mixture, rice flour, sorghum flour, potato starch, cornstarch, vegetable oil, eggs, xanthan gum, and salt in the bowl of a stand mixer fitted with the paddle attachment; beat on medium speed until incorporated, about 2 minutes. Transfer dough to the prepared loaf pan; smooth top of dough with the back of a wet spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place dough in a warm place until it rises just over the top of the pan, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until medium golden brown, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
