  "ingredients": [
    "2 cups warm milk",
    "2 tablespoons vegetable oil",
    "4 tablespoons molasses",
    "3.25 cups bread flour",
    "1.3333300352097 cups rye flour",
    "0.5 cup cornmeal",
    "1.3333300352097 teaspoons salt",
    "2.6666700839996 teaspoons active dry yeast",
    "4 tablespoons unsweetened cocoa powder",
    "2.6666700839996 tablespoons brown sugar"
  ],
  "steps": [
    {
      "text": "Mix well bread flour, rye flour, cornmeal, salt, yeast, cocoa, and brown sugar. Add milk, oil, and molasses. Mix thoroughly. When mixed well enough that the dough holds together, knead by hand 15-20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, let rise in bowl 30 minutes. Punch down, form, and place into 9 1/2x5 inch pan. Cover with damp cloth and let rise about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated 375 degree F (190 degrees C) oven 25 to 30 minutes, covering top with aluminum foil last 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
