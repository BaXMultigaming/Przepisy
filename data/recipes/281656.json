  "ingredients": [
    "1 large head green cabbage",
    "0.25 cup olive oil",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "4 tablespoons ranch dressing",
    "4 slices cooked bacon, crumbled"
  ],
  "steps": [
    {
      "text": "Cut cabbage in half through the core. Discard any loose leaves. Cut two 3/4-inch steaks from each half of cabbage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, salt, and pepper together in a small bowl. Brush oil over one side of each steak and let sit for 5 minutes to absorb. Flip steaks over and brush with remaining oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place steaks directly on the grate and grill for 5 minutes. Using tongs, carefully flip the steaks over and grill for 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer steaks to serving plates. Drizzle 1 tablespoon ranch dressing over each and top with crumbled bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
