  "ingredients": [
    "6 cups thinly sliced apples",
    "1 tablespoon lemon juice",
    "0.75 cup white sugar",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "0.125 teaspoon ground nutmeg",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts",
    "1 (9 inch) pie shell",
    "0.5 cup all-purpose flour",
    "0.5 cup packed brown sugar",
    "3 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nvTRDtXkIuMuF7JFGrilrLgDaEQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15587-Apple-Crumble-Pie-ddmfs-step-1-3ef6aea714da462a8c6e7062fbd80b94.jpg"
      ],
      "image": "assets/images/15587/step_01.webp"
    },
    {
      "text": "Place sliced apples in a large bowl; sprinkle with lemon juice. Mix white sugar, 2 tablespoons flour, cinnamon, and nutmeg together in a small bowl; sprinkle mixture over apples and toss until evenly coated. Stir in raisins and walnuts; transfer mixture into pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b55TzCqm0GS4m2Yubv8mO6iZSnU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15587-Apple-Crumble-Pie-ddmfs-step-3-069def42e03547aa91a7a0d6db1d68be.jpg"
      ],
      "image": "assets/images/15587/step_02.webp"
    },
    {
      "text": "Mix 1/2 cup flour and brown sugar together in a small bowl. Blend in butter with a fork until mixture is crumbly; sprinkle over apple filling. Cover top of pie loosely with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LzWHOxMM-fFM8Nd40-fD7xndF5U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15587-Apple-Crumble-Pie-ddmfs-step-5-7dbc68c288084fbfac8116ed68156833.jpg"
      ],
      "image": "assets/images/15587/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 25 minutes. Remove foil and bake until top is golden brown and filling is bubbly, about 25 to 30 minutes more. Cool on a wire rack before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
