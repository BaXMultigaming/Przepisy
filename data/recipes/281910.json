  "ingredients": [
    "2.5 cups peeled, cored, and diced apples",
    "0.25 cup brown sugar",
    "1 tablespoon salted butter, melted",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "0.125 teaspoon ground nutmeg",
    "0.125 teaspoon salt",
    "cooking spray",
    "0.25 cup quick-cooking oats",
    "0.25 cup all-purpose flour",
    "0.25 cup brown sugar",
    "0.25 cup salted butter, cubed",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine apples, brown sugar, butter, vanilla, cinnamon, nutmeg, and salt in a bowl. Toss and stir until apples are coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray 4 individual-sized ramekins with nonstick cooking spray. Divide apple mixture evenly among all 4 ramekins. Cover with foil and air fry until apples are tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make streusel in the same bowl by combining oats, flour, brown sugar, butter, cinnamon, and salt. Use your hands to combine streusel. Place in the refrigerator until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove ramekins from the air fryer, divide streusel evenly on top of the apples, and air fry, uncovered, until streusel is a golden brown, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
