  "title": "Blackberry-Thyme Scones",
  "description": "Ready in under an hour, these mildly sweet blackberry-thyme scones are topped with fresh blackberries and thyme leaves.",
  "authors": [
    "Jacqualin"
  ],
  "date_published": "2020-06-19T00:03:22-04:00",
