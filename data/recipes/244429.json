  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup oats",
    "0.33333334326744 cup butter, cut in small pieces",
    "1 tablespoon sugar, or more to taste",
    "0.5 cup half-and-half",
    "2 eggs, beaten",
    "1 cup fresh blackberries",
    "1 teaspoon chopped fresh thyme"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Process flour, oats, butter, and sugar together in a food processor until mixture resembles a coarse meal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir half-and-half and eggs together in a bowl, reserving 1 tablespoon. Add egg mixture to flour mixture in food processor and pulse until it forms a soft dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn out dough onto lightly floured work surface. Press dough into a circle about 1-inch thick. Gently press blackberries into top of dough; brush with reserved 1 tablespoon egg mixture and sprinkle with thyme. Cut into six wedges and transfer to a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until scones turn golden brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
