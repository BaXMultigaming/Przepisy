  "title": "Stuffed Peppers My Way",
  "description": "This rice-stuffed pepper recipe is made with roasted green bell peppers filled with a mixture of Arborio risotto, tomatoes, herbs, and feta cheese.",
  "authors": [
    "Sandy"
  ],
  "date_published": "2000-08-25T21:54:50-04:00",
  "date_modified": "2026-04-29T09:34:23-04:00",
  "prep_time": "PT10M",
  "cook_time": "PT30M",
  "total_time": "PT40M",
  "yield": [
    "2",
    "4 stuffed peppers"
  ],
