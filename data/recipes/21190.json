    "publisher-tested"
  ],
  "ingredients": [
    "1 cup water",
    "0.5 cup uncooked Arborio rice",
    "2 green bell peppers, halved and seeded",
    "1 tablespoon olive oil",
    "2 green onions, thinly sliced",
    "1 teaspoon dried basil",
    "1 teaspoon Italian seasoning",
    "1 teaspoon salt",
    "1 pinch ground black pepper",
    "1 tomato, diced",
    "0.5 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water to a boil in a medium saucepan. Stir in rice. Reduce heat, cover, and simmer until liquid is absorbed, about 20 minutes. Remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UEc5N0af8tX8x5cT_etwxXdj9GM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21190-Stuffed-Peppers-My-Way-ddmfs-step-2-138-450e1ba05d4f4d158ae0b4527439ad59.jpg"
      ],
      "image": "assets/images/21190/step_02.webp"
    },
    {
      "text": "Meanwhile, place peppers cut-side down on the prepared baking sheet. Roast in the preheated oven until tender and skin begins to brown, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RHmgCYrSmeEge22OA2ltBgdjGoo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21190-Stuffed-Peppers-My-Way-ddmfs-step-3-143-b7d23635c5e44ba8a0645ae52f89c71d.jpg"
      ],
      "image": "assets/images/21190/step_03.webp"
    },
    {
      "text": "While peppers are roasting, heat oil in a medium skillet over medium-high heat. Cook and stir onions, basil, Italian seasoning, salt, and pepper in oil for 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N9v1IxPxoGIgdDY8iEd_uFLe7MA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21190-Stuffed-Peppers-My-Way-ddmfs-step-4-144-53146fae6e1548289ef0c72651679663.jpg"
      ],
      "image": "assets/images/21190/step_04.webp"
    },
    {
      "text": "Stir in tomato and cook for 5 minutes. Spoon in cooked rice and stir until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZfQlGhMCZSuxPeHhvGio4VTRzTg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21190-Stuffed-Peppers-My-Way-ddmfs-step-5-145-816035a061a54a65b0e153d56aa1c45a.jpg"
      ],
      "image": "assets/images/21190/step_05.webp"
    },
    {
      "text": "Remove from heat, mix in feta cheese, and spoon mixture into pepper halves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9I7YzVQRfZKvfTzs_sUCpZ83k3o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21190-Stuffed-Peppers-My-Way-ddmfs-step-6-149-5491416401df4070868bb3cbb93e6a08.jpg"
      ],
      "image": "assets/images/21190/step_06.webp"
    },
    {
      "text": "Return peppers to the oven until warmed through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XdF1767VRSlZRI7-lYmtk7wp1eE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21190-stuffed-peppers-my-way-TTV78-b2c0a2caaa9a4f68a0d1b43364364686.jpg"
      ],
      "image": "assets/images/21190/step_07.webp"
    }
  ],
