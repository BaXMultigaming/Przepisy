  "ingredients": [
    "1 cup confectioners' sugar",
    "5 teaspoons milk",
    "1 tablespoon unsalted butter, melted",
    "0.125 teaspoon vanilla extract",
    "0.75 cup white sugar",
    "0.5 cup unsalted butter, melted",
    "0.25 cup brown sugar",
    "1 large egg",
    "1 cup all-purpose flour",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon baking soda",
    "1 cup finely chopped apples",
    "0.75 cup brown sugar",
    "7 tablespoons all-purpose flour",
    "2 tablespoons unsalted butter, melted",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x5-inch loaf pan. Sprinkle with 1 tablespoon flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix confectioners' sugar, milk, 1 tablespoon butter, and vanilla extract together in a small bowl for glaze; refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir white sugar, 1/2 cup butter, 1/4 cup brown sugar, and egg together in a medium bowl for the bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift 1 cup flour, 2 teaspoons cinnamon, and baking soda together in a large bowl. Slowly add sugar-egg mixture to flour mixture. Fold in apples. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 3/4 cup brown sugar, 7 tablespoons flour, 2 tablespoons butter, and 2 teaspoons cinnamon together in a medium bowl with a fork until coarse crumbs form for the streusel; sprinkle evenly over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, about 40 minutes; cool on a rack, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer glaze to a zip-top bag. Cut a tiny hole in the tip of the bag; drizzle glaze over bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
