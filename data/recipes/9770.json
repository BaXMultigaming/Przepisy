  "ingredients": [
    "0.5 cup finely chopped walnuts",
    "2 cups rolled oats",
    "1.5 cups all-purpose flour",
    "1 cup unsalted butter",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 egg",
    "0.75 cup packed brown sugar",
    "0.5 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, cream together the butter and white and brown sugars. Add egg, almond and vanilla extracts and stir well. In a separate bowl, mix together the flour, salt and baking soda. Stir into butter mixture, and mix until well blended. Stir in chopped nuts and oats.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll about 1 tablespoon of dough into a ball. Flatten dough on cookie sheet with a fork and bake for 8 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
