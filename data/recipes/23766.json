        "https://www.allrecipes.com/thmb/GLhYJ9fgqWPoasXfGcfXxZTYxZk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23766-danish-pastry-apple-bars-VAT-step-05-6fe27ae185f54e2aa3a180697636e04a.jpg"
