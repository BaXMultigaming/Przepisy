  "ingredients": [
    "2.5 cups all-purpose flour",
    "1 teaspoon salt",
    "1 cup shortening",
    "1 egg yolk",
    "0.5 cup milk",
    "10 apples - peeled, cored and thinly sliced",
    "0.5 cup light brown sugar",
    "0.25 cup white sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
