      "image_sources": [
        "https://www.allrecipes.com/thmb/LtZyZ3B-j8aejYB9CCM90gIlyeM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23766-danish-pastry-apple-bars-VAT-step-03-0d47750ddee640c4a5f84bcdd1a0eb6d.jpg"
      ],
      "image": "assets/images/23766/step_03.webp"
    },
    {
      "text": "Divide dough in half. Roll one dough piece on a lightly floured surface; fit into a 9x13-inch pan.",
      "section": null,
