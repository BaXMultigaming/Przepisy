  "ingredients": [
    "5 tablespoons butter, divided",
    "1 medium onion, chopped",
    "2 (10 ounce) packages chopped frozen broccoli, thawed",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "1 cup shredded sharp Cheddar cheese",
    "1 cup mayonnaise",
    "2 large eggs, beaten",
    "1.5 teaspoons lemon juice",
    "0.5 teaspoon garlic salt",
    "0.5 teaspoon seasoned salt",
    "0.25 teaspoon ground black pepper",
    "12 buttery round crackers, crushed fine"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Cut 2 tablespoons butter into small pieces; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt remaining 3 tablespoons butter in a medium skillet over medium-high heat. Add onion and sauté until golden, 7 to 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer onion to a 2-quart casserole dish. Stir in broccoli, condensed soup, Cheddar, mayonnaise, eggs, lemon juice, garlic salt, seasoned salt, and pepper until well combined. Sprinkle crushed crackers over top and dot with reserved butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until heated through and browned on top, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
