  "ingredients": [
    "4 yellow squash, sliced",
    "0.5 cup creamy salad dressing (e.g. Miracle Whip)",
    "0.25 cup grated Parmesan cheese",
    "1 cup all-purpose flour",
    "0.5 cup vegetable oil",
    "1 large sweet onion, sliced"
  ],
  "steps": [
    {
      "text": "Place squash in a large bowl and pour in creamy salad dressing. Cover and refrigerate for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove squash from refrigerator and sprinkle in the parmesan cheese; mix to coat well. Stir in the flour, coating well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Carefully place squash in oil and fry until lightly browned. Turn once, and add onions. Fry until squash is browned on both sides. Using a slotted spoon, transfer squash and onions to paper towels to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
