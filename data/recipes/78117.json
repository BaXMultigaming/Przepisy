  "ingredients": [
    "1.5 pounds veal cutlets",
    "0.5 cup all-purpose flour",
    "2 large eggs",
    "3 tablespoons grated Parmesan cheese",
    "2 tablespoons milk",
    "1 teaspoon minced parsley",
    "0.5 teaspoon salt",
    "0.25 teaspoon pepper",
    "1 pinch ground nutmeg",
    "1 cup dry bread crumbs",
    "6 tablespoons butter",
    "4 slices lemon"
  ],
  "steps": [
    {
      "text": "Place veal cutlets between 2 sheets of heavy plastic on a solid, level surface. Firmly pound cutlets with the smooth side of a meat mallet to a 1/4-inch thickness. Dip cutlets in flour to coat; shake off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0NFxDp6OtqGoEaFmwrHHPdUkK6U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78117-wienerschnitzel-ddmfs-Step1-0177-288f95d6ce054ffa9c5d0861fd3b008a.jpg"
      ],
      "image": "assets/images/78117/step_01.webp"
    },
    {
      "text": "Beat eggs, Parmesan cheese, milk, parsley, salt, pepper, and nutmeg together in a shallow bowl until combined. Place bread crumbs on a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QFo7auG2VROd1NcvfeQFoxxifqI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78117-wienerschnitzel-ddmfs-Step3-0182-ce7015db58804099a195a4974c646cc1.jpg"
      ],
      "image": "assets/images/78117/step_02.webp"
    },
    {
      "text": "Dip each cutlet into the egg mixture, then press in bread crumbs to coat. Place coated cutlets on a plate and refrigerate for 1 hour to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yxwXTXdjDikdKGs9h64-Qj91xEM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78117-wienerschnitzel-ddmfs-Step4-0184-386c8f1722704a7ba02719172e2ec54e.jpg"
      ],
      "image": "assets/images/78117/step_03.webp"
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Cook breaded cutlets in butter until browned, about 3 minutes per side. Transfer cutlets to a serving platter and pour pan juices over them. Garnish with lemon slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dMw1Qc3CZa3byLDhWe4Vz2CJt4g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/78117-wienerschnitzel-ddmfs-Step5-0187-570a2669869f42049982cc5d12089f12.jpg"
      ],
      "image": "assets/images/78117/step_04.webp"
    }
  ],
