  "ingredients": [
    "3 pounds beef rump roast",
    "2 large onions, chopped",
    "1 cup red wine vinegar, or to taste",
    "1 cup water",
    "1 tablespoon salt",
    "1 tablespoon ground black pepper",
    "1 tablespoon white sugar",
    "10 whole cloves, or more to taste",
    "2 bay leaves, or more to taste",
    "2 tablespoons all-purpose flour",
    "salt and ground black pepper to taste",
    "2 tablespoons vegetable oil",
    "10 gingersnap cookies, crumbled"
  ],
  "steps": [
    {
      "text": "Place beef rump roast, onions, vinegar, water, 1 tablespoon salt, 1 tablespoon black pepper, sugar, cloves, and bay leaves in a large pot. Cover and refrigerate for 2 to 3 days, turning meat daily. Remove meat from marinade and pat dry with paper towels, reserving marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tRUK4Pwqax6YHl1WfJF-G9Ottag=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221361-traditional-sauerbraten-step-1-BP-2693-8990c49f1a8f4384aa5bfe06cb6f381d.jpg"
      ],
      "image": "assets/images/221361/step_01.webp"
    },
    {
      "text": "Season flour to taste with salt and black pepper in a large bowl. Sprinkle flour mixture over beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_Dj54Hr7iv7RJsrnvwYmuo0u2JM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221361-traditional-sauerbraten-step-3-BP-2700-c542e2d1d12a4171a6ccfab6f11a8393.jpg"
      ],
      "image": "assets/images/221361/step_02.webp"
    },
    {
      "text": "Heat vegetable oil in a large Dutch oven or pot over medium heat; cook beef until brown on all sides, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HD1Tqp1yjpld_Bn_40KPkIeNGLc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221361-traditional-sauerbraten-step-4-BP-2718-5bc2e7edd3bf4ea0b6870eca2c41c053.jpg"
      ],
      "image": "assets/images/221361/step_03.webp"
    },
    {
      "text": "Pour reserved marinade over beef, cover, and reduce heat to medium-low. Simmer until beef is tender, 3 1/2 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DtmXkcaibtRvauRaNJ5UhRJ4Rps=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221361-traditional-sauerbraten-step-5-BP-2734-64722f700abd43efa994bea893649771.jpg"
      ],
      "image": "assets/images/221361/step_04.webp"
    },
    {
      "text": "Remove beef to a platter and slice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a5PyWVTuN9OkoQ6m019sojvdksY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221361-traditional-sauerbraten-step-6-BP-2878-3f35b6de4cf34f5091fb69b15d9720ca.jpg"
      ],
      "image": "assets/images/221361/step_05.webp"
    },
    {
      "text": "Strain solids from remaining liquid and continue cooking over medium heat. Add gingersnap cookies and simmer until gravy is thickened, about 10 minutes. Serve gravy over sliced beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JEtXeOJfiYyFdtQbpZqFZDZ2PaQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/221361-traditional-sauerbraten-step-7-BP-2889-5149429869ac47708b8ea229e339ee7c.jpg"
      ],
