  "ingredients": [
    "1 (16 ounce) can pears in juice",
    "1 (15 ounce) can peaches in juice",
    "1 (15 ounce) can pitted cherries in water",
    "1 cup quick-cooking oats",
    "0.5 cup brown sugar, divided",
    "1 teaspoon ground cinnamon",
    "2 tablespoons butter, cut in small pieces"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour pears, peaches, and cherries with their liquids into the prepared baking dish; stir. Stir oats and 1/4 cup brown sugar together in a bowl; sprinkle over the fruit mixture. Sprinkle remaining 1/4 cup brown sugar over the oat layer. Sprinkle cinnamon over the brown sugar. Arrange butter pieces evenly over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until hot, bubbly, and slightly brown at edges, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
