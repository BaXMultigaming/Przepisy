  "ingredients": [
    "0.66666668653488 cup graham cracker crumbs",
    "3 tablespoons white sugar",
    "5 tablespoons butter",
    "2 (8 ounce) packages cream cheese",
    "0.5 cup white sugar",
    "0.5 teaspoon almond extract",
    "0.25 teaspoon salt",
    "2 eggs",
    "3 tablespoons amaretto liqueur",
    "1 (8 ounce) container sour cream",
    "1 tablespoon white sugar",
    "0.5 teaspoon almond extract",
    "1 tablespoon amaretto liqueur"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). In a medium bowl, combine graham cracker crumbs, butter and 3 tablespoons sugar. Mix well and press into the bottom of a 9 inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat cream cheese and 1/2 cup sugar until smooth. Beat in almond extract and salt. Blend in the eggs, one at a time, on low speed. Stir in 3 tablespoons amaretto liqueur. Pour batter into crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 40 to 45 minutes, or until golden brown and filling is set. Allow to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the topping: In a small bowl, combine sour cream, 1 tablespoon sugar, 1 teaspoon almond extract and 1 tablespoon amaretto liqueur. Mix well and spread over top of cooled cake. Refrigerate 4 to 6 hours before removing from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
