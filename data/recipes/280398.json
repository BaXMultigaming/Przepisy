  "ingredients": [
    "2 cups water",
    "1 cup white sugar",
    "1 bunch fresh rosemary, chopped",
    "ice cubes",
    "3 fluid ounces bourbon",
    "1.5 fluid ounces orange liqueur",
    "1.5 fluid ounces amaro liqueur (such as Fernet Branca®)",
    "0.5 lemon, juiced",
    "2 dashes aromatic bitters (such as Angostura®)",
    "2 sprigs fresh rosemary",
    "2 orange peel strips"
  ],
  "steps": [
    {
      "text": "Combine water, sugar, and rosemary in a microwave-safe glass jar. Microwave and bring to a boil, about 2 minutes, watching carefully to ensure it doesn't boil over.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Allow to sit for 10 minutes; bring to a boil again. Let syrup sit until cooled, 15 to 20 minutes. Strain out the spent rosemary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Measure 3 fluid ounces of rosemary simple syrup, ice, bourbon, orange liqueur, amaro liqueur, and lemon juice into a cocktail shaker and mix. Pour into glasses, add bitters to each, and top with a sprig of rosemary and an orange peel strip.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
