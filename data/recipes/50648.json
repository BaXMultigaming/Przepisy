  "ingredients": [
    "1 tablespoon butter",
    "0.25 cup chopped onion",
    "4 eggs, beaten",
    "0.25 cup chopped tomatoes",
    "2 tablespoons crumbled feta cheese",
    "salt and pepper to taste"
