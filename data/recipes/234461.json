  "ingredients": [
    "1 cup unsalted butter",
    "cooking spray",
    "1 cup dark brown sugar",
    "0.5 cup heavy whipping cream",
    "2 tablespoons light corn syrup",
    "2.5 teaspoons flaked sea salt",
    "1 (16 ounce) package miniature marshmallows",
    "12 ounces gluten-free crispy rice cereal (such as Kellogg's® Gluten Free Rice Krispies®)"
  ],
  "steps": [
    {
      "text": "Spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cereal in a large heatproof bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium-high heat. Stir brown sugar, cream, and corn syrup into butter; cook, stirring, until mixture becomes thick and syrupy, 7 minutes. Stir 2 teaspoons salt into butter mixture. Remove from heat and add marshmallows; stir until marshmallows are smooth and melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour marshmallow mixture over rice cereal and stir. Transfer cereal mixture to prepared baking dish and press down with greased parchment paper. Sprinkle with 1/2 teaspoon sea salt; cool and cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
