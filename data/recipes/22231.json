  "title": "Chocolate Mint Sugar Cookie Drops",
  "description": "These are just like regular chocolate chip cookies but they are made with mint flavored chocolate chips.",
  "authors": [
    "Clare"
  ],
  "date_published": "2000-10-04T18:01:40-04:00",
