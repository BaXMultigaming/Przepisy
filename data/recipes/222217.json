  "ingredients": [
    "0.5 cup canola oil",
    "6 tablespoons white sugar",
    "0.25 cup red wine vinegar",
    "1 tablespoon soy sauce",
    "1 (8 ounce) package shredded cabbage",
    "3 green onions, thinly sliced",
    "0.33333334326744 cup slivered almonds",
    "0.33333331346512 cup sunflower seed kernels"
  ],
  "steps": [
    {
      "text": "Whisk canola oil, sugar, red wine vinegar, and soy sauce together in a large bowl until sugar has dissolved. Toss in cabbage, green onions, almonds, and sunflower seeds. Cover bowl and refrigerate before serving, at least 1 hour; slaw tastes better when chilled overnight.",
