  "ingredients": [
    "1 tablespoon olive oil",
    "1.5 cups diced celery",
    "1.5 cups diced carrots",
    "1 cup diced onion",
    "1 tablespoon dried parsley",
    "1 bay leaf",
    "3 cups beef stock",
    "3 cups chicken stock",
    "2 cups roasted white turkey meat",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "0.75 cup rotini pasta"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat. Add celery, carrots, onion, parsley, and bay leaf; cook until vegetables are tender, about 10 minutes. Add beef stock, chicken stock, turkey, salt, and black pepper; bring to a boil. Reduce heat, cover pot, and simmer until soup is heated through, about 15 minutes.",
      "section": null,
