  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Spray a skillet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir beef sirloin in the prepared skillet over medium heat until browned on the outside and slightly pink in the middle, 3 to 4 minutes. Transfer sirloin to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray the skillet with butter-flavored cooking spray. Add mushrooms, onion, and green bell pepper; cook and stir until just turning tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll pizza dough onto a baking sheet and top with American cheese. Spoon mushroom mixture and sirloin over American cheese layer and top with Mexican cheese blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is golden brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
