  "ingredients": [
    "2 eggs",
    "1 cup white sugar",
    "1 cup all-purpose flour",
    "0.125 teaspoon ground nutmeg",
    "0.75 cup butter, melted and cooled",
    "0.5 teaspoon almond extract",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C). Spray madeleine molds with non-stick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a double boiler, heat eggs and sugar stirring constantly; whipping in as much air as possible. Remove from heat, let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour add remaining ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill madeleine molds with a generous amount of batter, but don't spread it out. Bake until lightly browned; approx. 15 minutes. Cool one minute, remove to racks to cool completely. *Extracts can be varied and spices changed to suit tastes. Sprinkle with powdered sugar or dip in chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
