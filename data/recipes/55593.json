  "ingredients": [
    "1 cup vegetable oil for frying",
    "0.5 cup all-purpose flour",
    "0.5 teaspoon seasoning salt, or to taste",
    "salt and pepper to taste",
    "4 (3/4 inch) thick pork chops"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, seasoning salt, salt, and pepper in a paper or plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uMrwltnU0YR67D97aD-UUsCPTSU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/55593-fried-pork-chop-ddmfs-step1-0092-0f03e4129410422ca7fbb0cb24d5f75e.jpg"
      ],
      "image": "assets/images/55593/step_02.webp"
    },
    {
      "text": "Place pork chops in the bag and shake to coat. Shake off any excess flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uveeTMo9hkcbGxCqc5FBJMGnu0s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/55593-fried-pork-chop-ddmfs-step2-0095-78a0b181348e4b88bcb72a942fdddc69.jpg"
      ],
      "image": "assets/images/55593/step_03.webp"
    },
    {
      "text": "Fry chops in hot oil until golden on the outside and juices run clear, 4 to 5 minutes per side. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C). Drain on a wire rack or paper towels before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6VgAHR-47jqPGI1mYN1yzekoNKo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/55593-fried-pork-chop-ddmfs-step4-0099-e3b93ec7ae804c01aaae0a9a9ae55271.jpg"
      ],
      "image": "assets/images/55593/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
