  "ingredients": [
    "2 cups sifted all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.66666698455811 cup shortening",
    "2.25 cups packed brown sugar",
    "3 eggs",
    "1 teaspoon vanilla extract",
    "2 cups semisweet chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 10x15-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt shortening in a saucepan over low heat or in the microwave. Stir in brown sugar until well combined; let cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs into the cooled brown sugar mixture until smooth. Stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the flour mixture and stir just until combined. Fold in chocolate chips and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until the top is golden brown and a toothpick inserted near the center comes out with a few moist crumbs, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cool completely in the pan before cutting into 35 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
