  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rice into beef; cook and stir until rice is lightly browned, about 5 minutes. Add water and seasoning packet from rice; cover skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring to a boil, reduce heat to low, and simmer until liquid is almost completely absorbed, about 30 minutes.",
