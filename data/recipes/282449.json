  "title": "Brooke's Layered Pumpkin-Pecan Cheesecake",
  "description": "Pumpkin pie, cheesecake, and pecan pie all rolled into one sweet dessert that's a perfect ending for any holiday meal.",
  "authors": [
    "Brooke Elizabeth"
  ],
