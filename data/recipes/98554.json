  "ingredients": [
    "0.5 cup olive oil or butter",
    "0.33333334326744 cup water",
    "0.33333334326744 cup milk or soy milk",
    "1 teaspoon salt",
    "2 cups tapioca flour",
    "2 teaspoons minced garlic",
    "0.66666668653488 cup freshly grated Parmesan cheese",
    "2 beaten eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Combine olive oil, water, milk, and salt in a large saucepan and place over high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QKNygD0zCMu37ByFyQN-byfOwKY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-98554-brazilian-cheese-bread-pao-de-queijo-Step-01-6c9d09e7a984446faf0655688fa40a37.jpg"
      ],
      "image": "assets/images/98554/step_01.webp"
    },
    {
      "text": "Bring to a boil and immediately remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UqlH2K5G2bSQknjZ9sKRth6tbnw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-98554-brazilian-cheese-bread-pao-de-queijo-Step-02-4060a0c9a3bf41f4be75b55583e09f20.jpg"
      ],
      "image": "assets/images/98554/step_02.webp"
    },
    {
      "text": "Stir in tapioca flour and garlic, stirring until smooth. Set aside to rest for 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uUeSReEnlhgdZWEydw2GZy0FXFI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-98554-brazilian-cheese-bread-pao-de-queijo-Step-04-0f5ce5bc8f8b4db3a85676021ad3dd11.jpg"
      ],
      "image": "assets/images/98554/step_03.webp"
    },
    {
      "text": "Stir cheese and eggs into tapioca mixture until combined; the dough will be chunky, like cottage cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HGPjaVMP173aRhLjxkjhtBtvuvw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-98554-brazilian-cheese-bread-pao-de-queijo-Step-06-0008944985b744798a027427cc79d4f7.jpg"
      ],
      "image": "assets/images/98554/step_04.webp"
    },
    {
      "text": "Drop dough by 1/4 cup-size balls onto an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V0d7Dm04V8tD5g2aPW9EnEj0YoI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-98554-brazilian-cheese-bread-pao-de-queijo-Step-07-f93fb210c984410db7154f397f4497fb.jpg"
      ],
      "image": "assets/images/98554/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until the tops are lightly browned, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/b3tSotoRQMqSVmYQK-RRwYM7U8g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-98554-brazilian-cheese-bread-pao-de-queijo-Step-08-bb9470a9164d488d94d679f05de5c392.jpg"
      ],
      "image": "assets/images/98554/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
