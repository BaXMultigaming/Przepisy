  "ingredients": [
    "0.33333334326744 cup butter, melted",
    "1 tablespoon chopped fresh thyme",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "3 pounds Yukon Gold potatoes, cut into 1-inch slices",
    "1.25 cups vegetable broth",
    "2 cloves garlic, minced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 500 degrees F (260 degrees C) and place oven rack in upper-middle position. Grease a high-rimmed metallic baking sheet with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine melted butter, thyme, salt, and pepper in a bowl. Add potatoes and toss until fully coated. Place potato slices in a single layer on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until slightly golden, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flip potatoes over and roast for another 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flip potatoes and add vegetable broth and garlic; roast until tender, about 15 minutes.",
      "section": null,
      "name": null,
