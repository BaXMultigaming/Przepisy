  "ingredients": [
    "2 cups all-purpose flour",
    "0.75 cup white sugar",
    "1 tablespoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "1 cup diced pears",
    "1 cup buttermilk",
    "2 eggs, separated, yolks lightly beaten",
    "0.25 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "2 tablespoons white sugar",
    "1 tablespoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, ¾ cup sugar, baking powder, 1 teaspoon cinnamon, baking soda, salt, and nutmeg together into a large bowl. Add pears; stir to evenly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine buttermilk, egg yolks, oil, and vanilla extract in a bowl; mix well. Stir into pear mixture until batter is just moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a separate bowl with an electric mixer until stiff but not dry; fold into batter until just barely incorporated. Spoon batter into muffin cups, filling each ⅔ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 tablespoons sugar and 1 tablespoon cinnamon together in a bowl; sprinkle over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden brown and tops spring back when lightly pressed, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
