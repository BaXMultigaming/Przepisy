  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, melted",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "2 eggs",
    "0.33329999446869 cup unsweetened cocoa powder",
    "1.5 cups all-purpose flour",
    "1 cup chopped walnuts",
    "0.25 cup hot fudge topping",
    "1 cup heavy whipping cream",
    "2 tablespoons confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease a pie plate well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and butter or margarine in a mixing bowl. Blend in vanilla, salt, and beaten eggs. Stir in flour and cocoa . Stir in nuts. Pour mixture into pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25 minutes, or until toothpick inserted halfway between center and edge comes out clean. Immediately prick holes in pie; spread fudge sauce over top. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cold whipping cream and confectioners' sugar in a chilled bowl until peaks form; spread over fudge sauce. Drizzle pie with additional fudge sauce. Refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
