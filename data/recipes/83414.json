  "ingredients": [
    "6 skinless, boneless chicken breast halves - pounded to 1/2 inch thickness",
    "6 string cheese sticks",
    "6 slices ham",
    "0.5 cup butter, melted",
    "1 cup seasoned dry bread crumbs",
    "toothpicks"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay out the pounded chicken breasts on a clean surface. Place a slice of ham on each piece, then one stick of cheese. Roll the chicken up around the cheese and ham, and secure with toothpicks. Dip each roll in melted butter, then roll in bread crumbs. Place in a shallow baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 40 minutes in the preheated oven, or until chicken is browned and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
