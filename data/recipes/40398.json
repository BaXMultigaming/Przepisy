  "ingredients": [
    "2 cups shredded zucchini",
    "2 eggs",
    "0.25 cup finely chopped onion",
    "1 clove garlic, minced",
    "1.5 cups buttermilk baking mix",
    "salt and ground black pepper to taste",
    "oil for frying"
  ],
  "steps": [
    {
      "text": "Combine zucchini, eggs, onion, and garlic in a large bowl; blend in baking mix, salt, and black pepper until incorporated.",
      "section": null,
