  "ingredients": [
    "3 cups oil for frying, or as needed",
    "1 head cauliflower, broken into florets",
    "0.25 teaspoon salt",
    "1 large egg, beaten",
    "1 tablespoon vegetable oil",
    "1 cup all-purpose flour",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss cauliflower florets with salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg and vegetable oil together in a separate bowl. Whisk in flour and milk until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, drop cauliflower florets into batter; stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, gently lower battered cauliflower into preheated oil; fry until florets rise to the top and float, 2 to 4 minutes. Carefully turn pieces over and continue frying until golden brown, about 2 minutes more. Use a slotted spoon to transfer fried cauliflower to a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
