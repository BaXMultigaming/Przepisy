  "ingredients": [
    "2 tablespoons butter",
    "1.5 teaspoons olive oil",
    "2 cloves garlic, pressed",
    "1 teaspoon dried sage",
    "1 teaspoon dried rosemary",
    "1 teaspoon dried thyme",
    "0.5 teaspoon cayenne pepper",
    "salt and ground black pepper to taste",
    "16 ounces frozen artichoke hearts (such as Trader Joe's®), thawed and drained"
  ],
  "steps": [
    {
      "text": "Heat butter and olive oil together in a skillet over medium heat; add garlic, sage, rosemary, thyme, cayenne pepper, salt, and pepper and stir. Mix artichoke hearts into seasoned butter mixture; cover skillet and cook until tender, about 5 minutes.",
