  "ingredients": [
    "2 pounds boneless pork chops, cubed",
    "oil for frying",
    "2 eggs, beaten",
    "plain bread crumbs",
    "3 (1 ounce) packages dry mushroom gravy mix",
    "1 pound fresh mushrooms, coarsely chopped",
    "1 (16 ounce) package dry egg noodles"
  ],
  "steps": [
    {
      "text": "Pound out cubed pork, and cut in half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet or Dutch oven over medium heat. Dip pork in egg, then bread crumbs, and place in hot oil. Cook, turning, until golden brown. Remove to a warm plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare gravy mix according to package directions. Stir in mushrooms, and cook with gravy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Add the egg noodles, and cook until al dente, about 8 to 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve pork over noodles and smother with gravy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
