  "ingredients": [
    "1 teaspoon oregano",
    "1 teaspoon dried basil",
    "4 boneless, skinless chicken breasts",
    "cooking spray",
    "1 clove garlic, chopped",
    "1 (14 ounce) jar spaghetti sauce",
    "1 (8 ounce) package shredded mozzarella cheese, or to taste",
    "24 slices turkey pepperoni"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub oregano and basil over chicken breasts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a large skillet with cooking spray and heat over medium-high heat. Add garlic; cook and stir until fragrant, 2 to 3 minutes. Add chicken; cook until browned and no longer pink in the center, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour half of the spaghetti sauce into a large baking dish. Lay chicken breasts on top. Coat chicken with remaining spaghetti sauce. Scatter mozzarella cheese over sauce. Arrange 6 pepperoni slices over each chicken breast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
