  "ingredients": [
    "3 (9 inch) unbaked pie crusts",
    "1 cup white sugar",
    "0.5 cup unsweetened cocoa powder",
    "0.75 cup water",
    "1 teaspoon vanilla extract",
    "1.5 cups white sugar",
    "0.5 cup butter",
    "2 eggs",
    "1 cup milk",
    "2 teaspoons baking powder",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Combine 1 cup sugar, cocoa, water, and 1 teaspoon vanilla in a saucepan. Heat over medium-low heat to the boiling point, but do not boil. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together 1 1/2 cup sugar and butter. Beat in eggs. Stir in milk and 1 teaspoon vanilla. Combine flour and baking powder; mix into the creamed mixture. Divide batter into the pastry shells. Pour 1/3 of the cocoa mixture on top of the cake batter in each pastry shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 25 to 35 minutes, or till cake is done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
