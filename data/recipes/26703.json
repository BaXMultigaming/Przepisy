  "ingredients": [
    "1 (1 pound) loaf white bread, crusts trimmed",
    "1 (8 ounce) package cream cheese, softened",
    "1 pound sliced bacon, cut in half"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each slice of white bread in half horizontally; spread with cream cheese. Tightly roll each piece of bread with 1/2 a piece of bacon and secure with toothpicks. The bacon should be on the outside of the bread. Arrange roll ups in a single layer in a baking dish or on a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bacon is no longer pink and bread is lightly browned, about 30 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
