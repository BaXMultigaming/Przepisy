  "ingredients": [
    "1 pound bulk pork sausage",
    "6 eggs",
    "2 cups milk",
    "1 teaspoon salt",
    "1 teaspoon ground mustard",
    "1 cup shredded Cheddar cheese",
    "2 (8 ounce) packages refrigerated crescent rolls"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat and stir in sausage. Cook and stir until sausage is crumbly, evenly browned, and no longer pink, 5 to 7 minutes. Drain and discard any excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, milk, salt and ground mustard in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Cheddar cheese and sausage into the egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out crescent roll dough and place one sheet on the bottom of a large baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour egg mixture into baking dish; place the second sheet of crescent roll dough on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover with plastic wrap and refrigerate for 8 hours or overnight. Allow casserole to come to room temperature for 30 minutes before baking; remove plastic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until egg is set and a knife inserted near the center comes out clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
