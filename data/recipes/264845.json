  "ingredients": [
    "2 cups seedless watermelon cubes",
    "1 lime wedge",
    "1 pinch kosher salt",
    "ice cubes",
    "1.5 fluid ounces silver tequila",
    "0.75 fluid ounce orange-flavored liqueur (such as Cointreau®)",
    "0.75 fluid ounce lime juice",
    "1 thin slice jalapeno slice, plus more for garnish",
    "1 watermelon wedge"
  ],
  "steps": [
    {
      "text": "Puree watermelon in a blender. Wipe the rim of a margarita glass with a lime wedge; dip rim in salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a cocktail shaker half-filled with ice, add tequila, orange liqueur, lime juice, jalapeño, and 2 ounces of the watermelon puree. Shake until very cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain into prepared glass. Garnish with watermelon wedge and jalapeño slice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
