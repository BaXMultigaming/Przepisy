  "ingredients": [
    "1 (15 ounce) package pretzels",
    "0.75 cup olive oil",
    "1 (1 ounce) package dry Ranch-style dressing mix",
    "3 tablespoons garlic powder",
    "3 tablespoons dried dill weed"
  ],
  "steps": [
    {
      "text": "Break the pretzels into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend olive oil, ranch-style dressing mix, garlic powder, and dill weed in a medium bowl; pour the mixture over pretzels. Let pretzels marinate for 1 hour, tossing approximately every 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread marinated pretzels on a large cookie sheet. Bake in the preheated oven for 8 to 10 minutes. Allow the pretzels to cool, then serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
