  "ingredients": [
    "cooking spray",
    "0.75 cup all-purpose flour",
    "2 tablespoons white sugar, divided",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon baking soda",
    "0.125 teaspoon salt",
    "5 tablespoons milk",
    "0.25 cup butter, melted, divided",
    "1 teaspoon apple cider vinegar",
    "3 tablespoons light brown sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Coat 4 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, 1 tablespoon white sugar, baking powder, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, 2 tablespoons butter, and apple cider vinegar together in a small bowl; stir into flour mixture until a soft dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a lightly floured surface; roll out into a 6x7-inch rectangle. Spread remaining 2 tablespoons butter on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1 tablespoon white sugar, brown sugar, and cinnamon in a small bowl; sprinkle evenly over buttered dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough lengthwise into a log. Cut into 4 even pieces using a sharp serrated knife. Place 1 piece in each prepared muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown on all sides, 13 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
