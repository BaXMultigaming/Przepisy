  "ingredients": [
    "16 cups fresh figs",
    "1 tablespoon baking soda",
    "12 cups boiling water",
    "8 cups white sugar",
    "4 cups water",
    "1 lemon, sliced"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3vbf3aJ4FKhv6ms5vfR9m3r77rk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20854-fig-preserves-VAT-step-01-c986c25cd76c46b6b07a8811723cf9d7.jpg"
      ],
      "image": "assets/images/20854/step_01.webp"
    },
    {
      "text": "Place figs in a large bowl; sprinkle baking soda over figs. Carefully cover figs with boiling water and soak for 1 hour. Drain figs and rinse thoroughly with cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/evaPlbB43daW0AA3SQHRwTHLs0Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20854-fig-preserves-VAT-step-02-e615e324def34f4aafb66fcde91dd5c2.jpg"
      ],
      "image": "assets/images/20854/step_02.webp"
    },
    {
      "text": "Combine sugar and 4 cups of water in a large Dutch oven; bring to a boil and simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V86hvGk4ESAgSt214Y5zGApd-Fg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20854-fig-preserves-VAT-step-03-2f739eeb95b84af6a9183453e7fb6b81.jpg"
      ],
      "image": "assets/images/20854/step_03.webp"
    },
    {
      "text": "Add figs and lemon slices to syrup and simmer for 1 hour, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hum6uSeFI3jD1bfnWZKr9ls-y7Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20854-fig-preserves-VAT-step-04-7e2212ab7df64b38bfd929f004151ca2.jpg"
      ],
      "image": "assets/images/20854/step_04.webp"
    },
    {
      "text": "Spoon figs into hot, sterilized jars and spoon syrup over figs, leaving ½ inch of head space. Run a clean knife or thin spatula around the insides of the jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BN4dGLnxGQAk8vpvBuS0AsUe_pI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20854-fig-preserves-VAT-step-05-57e231ceb7ff4bd5b31a61f822f95b1b.jpg"
      ],
      "image": "assets/images/20854/step_05.webp"
    },
    {
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JTlgIak3yc3RdxDTYBgZm9vbSuI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20854-fig-preserves-VAT-step-06-362147cf2d0f40bdbfd7a715d0237f42.jpg"
      ],
      "image": "assets/images/20854/step_06.webp"
    },
    {
      "text": "Remove the jars from the stockpot and let rest, several inches apart, for 12 to 24 hours. Press the center of each lid with a finger to ensure the lid does not move up or down. Remove the rings for storage and store in a cool, dark area for up to 1 year.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7KxumMHkh9fgPlJELShnytcqeWk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20854-fig-preserves-VAT-Beauty-4x3-2df143d94a6e4dda9eb1f39183d15342.jpg"
      ],
      "image": "assets/images/20854/step_07.webp"
    }
  ],
