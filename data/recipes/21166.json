  "ingredients": [
    "25 cucumbers, thinly sliced",
    "6 onions, thinly sliced",
    "2 green bell peppers, diced",
    "3 cloves garlic, chopped",
    "0.5 cup salt",
    "5 cups white sugar",
    "3 cups cider vinegar",
    "2 tablespoons mustard seed",
    "1 tablespoon ground turmeric",
    "1.5 teaspoons celery seed",
    "0.5 teaspoon whole cloves"
  ],
  "steps": [
    {
      "text": "Mix cucumbers, onions, green bell peppers, garlic, and salt together in a large bowl. Allow to stand approximately 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wYLrBeqjj4VpnNd16K91hBw6Lqg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21166-bread-and-butter-pickles-ii-ddmfs-step1-0710-2b1614000abc4834a7e5ece4df4fac98.jpg"
      ],
      "image": "assets/images/21166/step_01.webp"
    },
    {
      "text": "Mix sugar, cider vinegar, mustard seed, turmeric, celery seed, and whole cloves together in a large saucepan; bring to a boil over high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8SFkHDUd_eIwHelJVdSTbQj3MYo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21166-bread-and-butter-pickles-ii-ddmfs-step2-0711-0016c6846341405b9dc856dec33cec1a.jpg"
      ],
      "image": "assets/images/21166/step_02.webp"
    },
    {
      "text": "Drain any liquid from the cucumber mixture. Stir cucumbers into the boiling vinegar mixture. Remove from heat shortly before the combined mixture comes to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4jLxR5Em-4_yOBe8dKxjTw3FYVU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21166-bread-and-butter-pickles-ii-ddmfs-step3-0712-c992e0cf32f248dbbf3d500e553d435f.jpg"
      ],
      "image": "assets/images/21166/step_03.webp"
    },
    {
      "text": "Transfer into sterile screw-top jars; seal and chill in the refrigerator until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZCA6C8vGWd4H3NOKXqr5gYsZ2Cs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21166-bread-and-butter-pickles-ii-ddmfs-step4-0713-bd8d44f4dfc94cd69282cfad598b2935.jpg"
      ],
      "image": "assets/images/21166/step_04.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vKaTVyV1OVSeMYxd3ehqsn46eUU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21166-bread-and-butter-pickles-ii-DDMFS-4x3-fb1134c9c6014084a4cc21c6fd2b5875.jpg"
