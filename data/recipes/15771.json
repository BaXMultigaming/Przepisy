  "ingredients": [
    "4 cups low fat, low sodium chicken broth",
    "2 cloves garlic, minced",
    "0.5 cup red onion, minced",
    "0.5 cup diced carrots",
    "1 cup pearl barley",
    "0.5 cup diced zucchini",
    "2 tablespoons chopped fresh parsley",
    "1 teaspoon olive oil",
    "1 tablespoon lemon juice",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat 1/4 cup of the broth in a saucepan over medium high heat. Add the garlic and onion and saute for 5 minutes. Add the carrots and saute for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the remaining broth and bring to a boil. Add the barley, lower the heat, cover, and simmer until the liquid is almost absorbed, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the zucchini, parsley, oil, and lemon juice. Simmer for 5 more minutes; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
