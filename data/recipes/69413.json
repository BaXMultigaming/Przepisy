    "0.5 teaspoon salt",
    "1 tablespoon ground cumin",
    "1 tablespoon ground coriander",
    "3 cloves garlic, minced",
    "2 tablespoons olive oil, divided",
    "2 boneless pork loin chops",
    "ground black pepper to taste"
