  "ingredients": [
    "PAM® Original No-Stick Cooking Spray",
    "2 cups Reddi-wip® Original Dairy Whipped Topping",
    "0.25 cup Egg Beaters® Original",
    "0.5 cup dry red velvet cake mix",
    "3 tablespoons reduced-fat cream cheese spread",
    "4 tablespoons Reddi-wip® Original Dairy Whipped Topping",
    "1 tablespoon granulated sugar"
  ],
  "steps": [
    {
      "text": "For cakes, spray insides of 2 large microwave-safe mugs with cooking spray. Whisk together 2 cups Reddi-wip, Egg Beaters, and cake mix in medium bowl. Place half of batter in each mug. Microwave each mug individually on HIGH 1 minute to 1 minute 15 seconds or until set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For frosting, stir together cream cheese spread, 2 servings Reddi-wip and sugar in small bowl until blended. Invert each cake onto a plate; top each with half of the frosting.",
      "section": null,
      "name": null,
      "url": null,
