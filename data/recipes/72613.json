  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "0.5 cup spicy brown mustard",
    "0.5 cup Italian seasoned bread crumbs",
    "0.25 cup butter, melted",
    "2 tablespoons lemon juice",
    "2 tablespoons water",
    "paprika to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush the chicken breast halves on all sides with the mustard. Place the bread crumbs in a shallow dish. Press the chicken into the bread crumbs to evenly coat. Arrange the chicken breasts in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix the butter, lemon juice, and water. Drizzle about 1 tablespoon of the mixture over each chicken breast. Pour the remaining mixture around the breasts in the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and bake 45 minutes in the preheated oven. Uncover, season with paprika, and continue baking 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
