  "title": "Simple Gluten-Free Brownies",
  "description": "These quick and easy gluten-free brownies made with melted dark chocolate and ground almonds are a perfectly moist gluten-free dessert.",
  "authors": [
    "cisacke"
  ],
  "date_published": "2020-06-19T00:24:30-04:00",
