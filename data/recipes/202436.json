  "ingredients": [
    "2 (3 ounce) cans white tuna in water, drained",
    "2 (1 ounce) slices Swiss cheese, diced",
    "2 tablespoons mayonnaise",
    "1.5 teaspoons sweet pickle relish",
    "0.25 teaspoon dried minced onion",
    "0.25 teaspoon onion powder",
    "salt and ground black pepper to taste",
    "1 (8 ounce) package fresh white mushrooms, cleaned and stems removed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tuna, Swiss cheese, mayonnaise, sweet relish, dried onion, onion powder, salt, and black pepper in a large bowl. Fill mushroom caps with tuna mixture; place on a baking sheet, filled-side up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until mushrooms are soft and begin to give up their juices, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
