  "ingredients": [
    "6 large ripe bananas",
    "1 cup brown sugar",
    "0.75 cup salted butter, melted",
    "0.5 cup white sugar",
    "2 eggs",
    "1.5 cups all-purpose flour",
    "1.25 cups whole wheat flour",
    "0.5 cup ground flax seeds",
    "2 teaspoons baking soda",
    "2 teaspoons baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 muffin tins with 20 paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash bananas in a bowl. Stir in brown sugar, butter, white sugar, and eggs until well combined. Stir in all-purpose flour, whole wheat flour, flax seeds, baking soda, and baking powder. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
