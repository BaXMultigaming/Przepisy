  "ingredients": [
    "3 cups all-purpose flour",
    "2.5 cups white sugar",
    "2 cups grated yellow squash",
    "1 cup vegetable oil",
    "1 (8 ounce) can crushed pineapple, drained",
    "1 cup chopped nuts",
    "3 eggs, beaten",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.25 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, squash, oil, pineapple, nuts, eggs, vanilla, cinnamon, baking soda, salt, and baking powder in a large bowl. Divide batter into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, about 1 hour. Cool in the pans for 10 minutes, then transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
