  "ingredients": [
    "2 medium cucumbers, cubed",
    "2 avocados, cubed",
    "4 tablespoons chopped fresh cilantro",
    "1 clove garlic, minced",
    "2 tablespoons minced green onions",
    "0.25 teaspoon salt",
    "black pepper to taste",
    "1 lime",
    "0.25 large lemon"
  ],
  "steps": [
    {
      "text": "Combine cucumbers, avocados, and cilantro in a large bowl; stir in garlic, green onions, salt, and pepper. Pour lemon and lime juice over the top; toss well. For best flavor results, cover and refrigerate the salad until chilled before serving.",
