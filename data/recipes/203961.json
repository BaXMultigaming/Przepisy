  "ingredients": [
    "1 (16 ounce) package linguine pasta",
    "2 tablespoons olive oil, divided",
    "4 cloves garlic, minced",
    "1 small red onion, minced",
    "3 green onions, chopped",
    "2 tomatoes, seeded and diced",
    "1 (8 ounce) can crushed tomatoes",
    "1 tablespoon tomato paste",
    "1 teaspoon dried oregano",
    "1 teaspoon ground thyme",
    "2 pounds mussels, cleaned and debearded",
    "1 pound uncooked medium shrimp, peeled and deveined",
    "1 cup dry white wine",
    "2 teaspoons lemon juice",
    "1 lemon - cut into wedges, for garnish"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1GxaYPYLRJQVJnkZz7RFQOztsvo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/203961_SeafoodMarinaraPasta_ddmfs_step1_4x3_1367-70914e81232a40a1b2f515ee28e083ee.jpg"
      ],
      "image": "assets/images/203961/step_01.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, about 11 minutes. Drain well in a colander set in the sink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 tablespoon of olive oil in a skillet over medium heat. Stir in garlic and onion; cook and stir until onion has softened and turned translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Sp8AwcAI8EReu8CKMq6hDY0pRgo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/203961_SeafoodMarinaraPasta_ddmfs_step2_4x3_1371-0b0a163fa50d422b934285d0ed4f01bf.jpg"
      ],
      "image": "assets/images/203961/step_03.webp"
    },
    {
      "text": "Heat remaining 1 tablespoon of olive oil in a large skillet over medium-low heat. Stir in green onion and diced tomatoes; cook and stir until tomatoes have softened. Stir onion mixture into tomato mixture; add crushed tomatoes, tomato paste, oregano, and thyme. Simmer for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wsG_oXJ8jmfS5hANs6KR0Nhj2G4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/203961_SeafoodMarinaraPasta_ddmfs_step4_4x3_1380-e9afe38593284cdba2af787e42da203a.jpg"
      ],
      "image": "assets/images/203961/step_04.webp"
    },
    {
      "text": "Stir in mussels and shrimp, then pour in wine and lemon juice. Cover and increase heat to high. Cook until shrimp have turned pink and mussels have opened, discarding any that have not opened. Serve over pasta and garnish with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rwz3u1uownclWsG5UWF9Pc4q9DY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/203961_SeafoodMarinaraPasta_ddmfs_step6_4x3_1385-73b2b06583a44a71a94ccc8e52729f38.jpg"
      ],
      "image": "assets/images/203961/step_05.webp"
    }
  ],
