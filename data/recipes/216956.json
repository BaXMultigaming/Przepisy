  "ingredients": [
    "0.5 cup butter",
    "2 cups biscuit baking mix",
    "2 cups sugar, divided",
    "3 tablespoons cinnamon, divided",
    "0.75 cup Kikkoman Pearl® Organic Original Soymilk",
    "5 cups fresh peaches, peeled and sliced",
    "1 cup corn syrup"
  ],
  "steps": [
    {
      "text": "Heat oven to 375 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put butter in an 8 x 12-inch baking dish; place dish in oven until butter melts. In mixing bowl, mix biscuit mix with 1/2 cup sugar and 1 tablespoon cinnamon. Mix in soymilk. Place peaches in baking dish with butter. Add corn syrup, 1 1/2 cups sugar and 2 tablespoons cinnamon; toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of biscuit mixture over peaches, spreading with the back of the spoon to cover all the peaches. Bake about 30 minutes or until crust has risen and is golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
