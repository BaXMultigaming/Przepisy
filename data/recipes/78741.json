  "ingredients": [
    "4 boneless, skinless chicken breast halves",
    "1 teaspoon lemon pepper",
    "1 teaspoon salt",
    "1 teaspoon dried dill weed",
    "1 teaspoon garlic powder",
    "3 tablespoons butter",
    "0.5 cup whipping cream",
    "2 tablespoons capers, drained and rinsed"
  ],
  "steps": [
    {
      "text": "Season chicken breasts with lemon pepper, salt, dill weed, and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add breasts and increase heat to medium-high; flip frequently, until brown, about 5 minutes. Reduce heat to medium; cook until cooked through, 5 to 7 minutes. Transfer breasts to a warm serving platter; cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Increase heat to high. Whisk whipping cream into skillet, whisking continuously, until reduced to sauce consistency, about 3 minutes. Off heat, stir in capers; pour over breasts and serve.",
      "section": null,
      "name": null,
      "url": null,
