        "https://www.allrecipes.com/thmb/yRLkEx4QG3RFupBqftMY1_uJtyE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-20096-cheesy-ham-and-hash-brown-casserole-VAT-step-03-d76d153e09e24791aeb935f0472e4d0b.jpg"
      ],
      "image": "assets/images/20096/step_03.webp"
