  "ingredients": [
    "15 slices stale bread",
    "0.25 cup butter, melted",
    "2 teaspoons garlic salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice off crusts from stale bread slices. Brush bread on both sides with melted butter. Cut bread slices into small cubes. Sprinkle with garlic salt. Arrange cubes on an ungreased cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, about 15 minutes. Let cool completely, then store in a covered container or plastic bag.",
      "section": null,
      "name": null,
      "url": null,
