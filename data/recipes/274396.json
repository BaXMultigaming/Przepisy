  "ingredients": [
    "cooking spray",
    "1 cup all-purpose flour",
    "0.25 cup white sugar",
    "0.25 cup milk",
    "1 egg",
    "1.5 teaspoons baking powder",
    "1 pinch salt",
    "2 tablespoons white sugar",
    "0.5 teaspoon ground cinnamon",
    "1 apple - peeled, cored, and chopped",
    "0.5 cup confectioners' sugar",
    "1 tablespoon milk",
    "0.5 teaspoon caramel extract (such as Watkins™)",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C). Place a parchment paper round into the bottom of the air fryer. Spray with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, 1/4 cup sugar, milk, egg, baking powder, and salt together in a small bowl. Stir until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 2 tablespoons sugar with cinnamon in another bowl and sprinkle over apples until coated. Mix apples into the flour mixture until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop fritters using a cookie scoop onto the bottom of the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry in the preheated fryer for 5 minutes. Flip fritters and cook until golden, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix confectioners' sugar, milk, caramel extract, and cinnamon together in a bowl. Transfer fritters to a cooling rack and drizzle with glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
