  "ingredients": [
    "1 cup freshly squeezed orange juice",
    "0.5 cup white sugar",
    "0.5 cup brown sugar",
    "1 (12 ounce) package fresh cranberries, rinsed",
    "1 medium orange, finely zested, divided",
    "1 crystallized ginger",
    "0.25 cup chopped pecans",
    "0.125 teaspoon cinnamon (such as Supreme Saigon®)"
  ],
  "steps": [
    {
      "text": "Combine orange juice and both sugars in a saucepan over medium heat and allow the sugar to melt down. Add cranberries, 3/4 of the orange zest, and crystallized ginger.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sauce, mashing down berries, over medium-low heat for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, toast pecans in a small skillet over medium heat until fragrant, 2 to 3 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cinnamon and chopped pecans into the cranberry sauce until well combined. Transfer cranberry sauce to a serving dish and top with remaining orange zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
