  "ingredients": [
    "3 cups grated unpeeled zucchini",
    "3 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "1 teaspoon baking powder",
    "2 cups white sugar",
    "1 cup brown sugar",
    "1 tablespoon ground cinnamon",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground nutmeg",
    "0.5 teaspoon salt",
    "4 eggs",
    "1 cup unsweetened applesauce",
    "0.75 cup vegetable oil",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease one 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3sXulqJOIP3h462UrRDigTwjw3k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-163781-zucchini-spice-cake-VAT-step-01-402a4397b47c4ac7869fbf450dccd210.jpg"
      ],
      "image": "assets/images/163781/step_01.webp"
    },
    {
      "text": "Place grated zucchini in a colander and set aside to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Rd5HcMHRYXhpaZhpt2oB5nKeGtg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-163781-zucchini-spice-cake-VAT-step-02-64028e4fde9a4e98b48e9d85af6d3ff5.jpg"
      ],
      "image": "assets/images/163781/step_02.webp"
    },
    {
      "text": "Whisk together flour, baking soda, baking powder, white sugar, brown sugar, cinnamon, cloves, nutmeg, and salt in a large bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/02wdpJSCnUhiJpE8TecXwmuTXJE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-163781-zucchini-spice-cake-VAT-step-03-f156664a87894a3e9016dc18abdffbe6.jpg"
      ],
      "image": "assets/images/163781/step_03.webp"
    },
    {
      "text": "Beat eggs, applesauce, oil, and vanilla in a separate bowl until smooth. Fold in flour mixture, then stir in zucchini.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LPqvAGW72dfRwo94sDVVt6yEKtw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-163781-zucchini-spice-cake-VAT-step-04-1-3dfa5095fcc546ae99f3b52a15e5beb4.jpg"
      ],
      "image": "assets/images/163781/step_04.webp"
    },
    {
      "text": "Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C7G74NTxUtYLFoB_hg6ZHGe-ZmQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-163781-zucchini-spice-cake-VAT-step-05-4a476df2f74a4e328600c0e3f067559a.jpg"
      ],
      "image": "assets/images/163781/step_05.webp"
    },
    {
      "text": "Bake until a toothpick inserted in the center comes out clean, 45 to 55 minutes. Allow to cool completely before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J3BVuCss29CNr8OOGwIgp57Qhq8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-163781-zucchini-spice-cake-VAT-step-06-1718f60627a54779b08410a92223c7c8.jpg"
