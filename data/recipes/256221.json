  "ingredients": [
    "1.5 pounds ground beef",
    "1 (1.25 ounce) package ORTEGA® Taco Seasoning mix",
    "1 cup chopped tomato",
    "1 cup frozen corn, thawed and drained",
    "0.5 cup sliced pitted ripe olives",
    "1 cup shredded Mexican blend cheese",
    "1 (16 ounce) package Green Giant™ Cauliflower Veggie Tots"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brown ground beef in large skillet and drain. Stir in taco seasoning and 3/4 cup water and simmer 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn ground beef mixture into 2-quart baking dish. Top with tomato, corn, olives then cheese. Evenly arrange Green Giant® Cauliflower Veggie Tots™ over mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 minutes or until bubbling and tots are golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Garnish with additional tomato, olives, cheese and green onion if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
