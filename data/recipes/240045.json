  "ingredients": [
    "0.25 cup vegetable oil",
    "0.125 teaspoon mustard seed",
    "1 large head cauliflower, cut into bite-size pieces",
    "1 baking potato, peeled and cut into 1/4-inch cubes",
    "1.5 teaspoons salt",
    "0.125 teaspoon ground turmeric",
    "1.5 teaspoons white sugar",
    "0.125 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Heat oil in a large, deep skillet over medium-high heat. Saute mustard seeds in hot oil until popping and toasted, 10 to 15 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cauliflower, potato, salt, and turmeric into oil until coated completely; cover the skillet with a lid, reduce heat to medium, and cook, stirring every few minutes, until cauliflower and potato are tender, 15 to 20 minutes. Season with sugar and cayenne pepper and cook until flavors develop, about 2 minutes more.",
      "section": null,
