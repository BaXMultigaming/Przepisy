  "ingredients": [
    "10 ounces spinach, rinsed",
    "1 (16 ounce) package bow tie pasta",
    "0.25 cup olive oil",
    "salt and pepper to taste",
    "2.5 cups cherry tomatoes, quartered",
    "8 ounces crumbled goat cheese"
