  "ingredients": [
    "1 (1 pound) loaf cinnamon raisin bread, cubed",
    "1 (8 ounce) package cream cheese, diced",
    "1 cup diced peeled apples",
    "2.5 cups half-and-half cream",
    "8 eggs",
    "6 tablespoons butter, melted",
    "0.25 cup maple syrup"
  ],
  "steps": [
    {
      "text": "Coat a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ½ raisin bread in the prepared dish; sprinkle cream cheese evenly over top. Top with apples, then top with remaining ½ bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat half-and-half, eggs, butter, and maple syrup together in a large bowl; pour over bread mixture. Cover with plastic wrap; press down so all bread pieces are soaked. Refrigerate at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Let stand before serving for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
