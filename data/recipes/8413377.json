  "title": "Easy Grilled Sticky Ribs",
  "description": "Chef John's easy grilled sticky ribs recipe produces a caramelized, sticky rib that's tender on the inside and perfect for summer parties.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-07-01T09:00:00-04:00",
  "date_modified": "2023-08-23T13:00:00-04:00",
  "prep_time": "PT15M",
  "cook_time": "PT135M",
  "total_time": "PT300M",
