    "Dinner"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "4 teaspoons kosher salt",
    "4 teaspoons white sugar",
    "1 teaspoon freshly ground black pepper",
    "1 teaspoon paprika",
    "1 teaspoon garlic powder",
    "2 racks baby back pork ribs",
    "0.33 cup ketchup",
    "0.25 cup brown sugar",
    "2 tablespoons soy sauce",
    "2 tablespoons rice vinegar",
    "1 tablespoon vegetable oil",
    "1 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Gather all the ingredients and preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fcnQu4BWJaylpQLWf2ojdTG1_nI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8413377-easy-grilled-sticky-ribs-VAT-step-01-40aca16b1a464ca38e85ee186b4aaa95.jpg"
      ],
      "image": "assets/images/8413377/step_01.webp"
    },
    {
      "text": "Mix salt, sugar, black pepper, paprika, and garlic powder for dry rub together in a small bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mwNhLZGdcXEv1rdz4TGNyWQ82ds=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8413377-easy-grilled-sticky-ribs-VAT-step-02-c99fb619208540d193adf95414e716fb.jpg"
      ],
      "image": "assets/images/8413377/step_02.webp"
    },
    {
      "text": "Line a large sheet pan with heavy-duty aluminum foil. Place rack of ribs on the prepared pan, bone side down. Poke all over with a sharp knife. Make shallow slits across at an angle, and then repeat the opposite way; this allows the dry rub to penetrate. Transfer to the center of the preheated oven and bake for 2 hours. Remove from the oven and let cool to room temperature. Refrigerate until cold and firm, at least 2 hours, up to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zrzO675R5FsYUtOOYBANUrZQXe0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8413377-easy-grilled-sticky-ribs-VAT-step-03-147dcc2c48c04943abe853f25b732afc.jpg"
      ],
      "image": "assets/images/8413377/step_03.webp"
    },
    {
      "text": "Coat on both sides with rub; flip back over, ensuring the bone side is down. Wrap tightly with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aj5SR1kAioZj01RvXrK4LAaxY-o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8413377-easy-grilled-sticky-ribs-VAT-step-04-f5d70f0bf3604e679298a178bb70110e.jpg"
      ],
      "image": "assets/images/8413377/step_04.webp"
    },
    {
      "text": "Preheat a charcoal grill until coals are very ashy and hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RN6C2zNUQOKb14phMctvh4h2rm4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8413377-easy-grilled-sticky-ribs-VAT-Step-05-81cac0408e4b426fa0fae1eeb3dc74a2.jpg"
      ],
      "image": "assets/images/8413377/step_05.webp"
    },
    {
      "text": "Remove from the refrigerator, unwrap, and brush off excess fat. Slice between the bones to separate each rib.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Xh1z0JHCNBH1uYGasXfbVkycpHQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8413377-easy-grilled-sticky-ribs-VAT-step-06-5c61bf92c95a4f8298d3cad789e76745.jpg"
      ],
      "image": "assets/images/8413377/step_06.webp"
    },
    {
      "text": "Combine ketchup, brown sugar, soy sauce, vinegar, oil, and cayenne with a spoon in a bowl for glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UUiDIwb5eM_6J8H4SZFuMeuMpe4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8413377-easy-grilled-sticky-ribs-VAT-step-07-fa68c6d399974bffb9cf89b1a542f77f.jpg"
      ],
      "image": "assets/images/8413377/step_07.webp"
    },
    {
      "text": "Place ribs on the preheated grill and cook for 2 minutes; flip and brush over glaze. Flip and repeat process until ribs are as caramelized as you prefer, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1mXiHYp59qiO7sfvzMyji0wr4yo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8413377-easy-grilled-sticky-ribs-VAT-step-08-db7eb6e584bb49dd9b4824f7837904df.jpg"
      ],
      "image": "assets/images/8413377/step_08.webp"
    },
    {
      "text": "Remove to a plate and brush over one more application of glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o3nPjDvUI1s9TgLYbdIVVleGdj8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8413377-easy-grilled-sticky-ribs-VAT-step-09-d4d35fa5423549b59077163c27eae231.jpg"
      ],
      "image": "assets/images/8413377/step_09.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jZDe4jtRHfCmpQflaAoQPghfgX0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-8413377-easy-grilled-sticky-ribs-VAT-4x3-5b34f00dd4fc40f6b546507d95dca958.jpg"
      ],
      "image": "assets/images/8413377/step_10.webp"
    }
  ],
