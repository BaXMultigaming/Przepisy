  "ingredients": [
    "1 cup butter, softened",
    "1 cup brown sugar",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "3 cups oats",
    "1 cup cinnamon chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and brown sugar together in a bowl using an electric mixer until smooth and creamy. Beat in eggs and vanilla extract until incorporated. Mix flour, baking soda, salt, and ground cinnamon into butter mixture until just mixed; fold in oats and cinnamon chips. Drop 1 to 2 tablespoons batter per cookie onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
