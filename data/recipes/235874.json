  "ingredients": [
    "1 tablespoon butter",
    "0.5 onion, chopped",
    "0.25 cup melted butter",
    "0.25 cup flour",
    "2 cups milk",
    "2 cups chicken stock",
    "1.5 cups coarsely chopped broccoli florets",
    "1 cup matchstick-cut carrots",
    "1 stalk celery, thinly sliced",
    "2.5 cups shredded sharp Cheddar cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/opUsck4nuuDQkhdn0NYjf7KyjtM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-235874-copycat-panera-broccoli-cheddar-soup-ddmfs-step-1-23af0870f19f4a0f8051e8e680482753.jpg"
      ],
      "image": "assets/images/235874/step_01.webp"
    },
    {
      "text": "Melt 1 tablespoon butter in a skillet over medium-high heat. Add onion; cook and stir until tender and translucent, about 5 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ch5nZp0IGiuphi_V68_8KkUVbwU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-235874-copycat-panera-broccoli-cheddar-soup-ddmfs-step-2-21b1d1775e524767823869d4f9368fcb.jpg"
      ],
      "image": "assets/images/235874/step_02.webp"
    },
    {
      "text": "Whisk 1/4 cup melted butter and flour together in a large saucepan over medium-low heat. Continue to whisk and cook, adding 1 to 2 tablespoons of milk if necessary to keep the flour from burning, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bf77V3yNG9EBJR9zs4XVhigh6ZE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-235874-copycat-panera-broccoli-cheddar-soup-ddmfs-step-3-7132ad6f4e9f4f568dba020201db2214.jpg"
      ],
      "image": "assets/images/235874/step_03.webp"
    },
    {
      "text": "Gradually add milk while whisking constantly; stir in chicken stock and bring to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p5Quw1MX0YqAhmAIIPM8stbK7R8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-235874-copycat-panera-broccoli-cheddar-soup-ddmfs-step-4-36fef3c930cd4be68573bbe07f30bfec.jpg"
      ],
      "image": "assets/images/235874/step_04.webp"
    },
    {
      "text": "Cook until mixture is thickened, about 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q9Row5i7Zoi4LMeOZx06ir4CWGc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-235874-copycat-panera-broccoli-cheddar-soup-ddmfs-step-5-2f60644411f44e0cbdcf4c9d157da17c.jpg"
      ],
      "image": "assets/images/235874/step_05.webp"
    },
    {
      "text": "Add broccoli, carrots, celery, and sautéed onion; simmer until all the vegetables are tender, about 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tgbwaRYK5HGoIxbYR1500gFTXO0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-235874-copycat-panera-broccoli-cheddar-soup-ddmfs-step-6-32cff1a1580e4fdda1b76e4cc0bed8c7.jpg"
      ],
      "image": "assets/images/235874/step_06.webp"
    },
    {
      "text": "Stir in Cheddar cheese until melted; season with salt and pepper to taste before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/M_GRAnoYnOhEOmZPKUBG1KvjcxQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-235874-copycat-panera-broccoli-cheddar-soup-ddmfs-beauty-4x3-f787b66d927d44f18633a4499559611c.jpg"
      ],
