  "ingredients": [
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup softened butter",
    "0.75 cup white sugar",
    "0.75 cup brown sugar",
    "0.25 cup milk",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2 cups semisweet chocolate chips",
    "2 cups rolled oats"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, and salt together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter, white sugar, and brown sugar together in a large bowl with an electric mixer. Add milk, eggs, and vanilla extract. Stir in flour mixture; fold in chocolate chips and oats. Spread into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
