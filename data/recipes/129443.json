  "ingredients": [
    "0.66666668653488 cup milk",
    "3 drops apple cider vinegar",
    "1 cup white sugar",
    "0.66666668653488 cup packed brown sugar",
    "0.66666668653488 cup vegetable oil",
    "0.25 cup butter, melted",
    "0.5 teaspoon vanilla extract",
    "1 cup canned pumpkin puree",
    "2 cups all-purpose flour",
    "0.5 cup regular rolled oats",
    "1.25 teaspoons baking powder",
    "1.25 teaspoons baking soda",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.125 teaspoon ground cloves",
    "0.5 cup chopped walnuts",
    "1 (16 ounce) container cream cheese frosting",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish. Pour the milk into a small bowl, and stir in the vinegar. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the flour together with rolled oats, baking powder, baking soda, cinnamon, nutmeg, and cloves in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the white sugar, brown sugar, vegetable oil, butter, milk mixture, and vanilla together in a mixing bowl until smooth and well blended. Add the pumpkin and beat again until smooth. Gradually stir in the flour mixture until evenly blended. Mix in the walnuts. Pour the batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the top is golden brown and a toothpick inserted in the center comes out clean, about 45 minutes. Cool on a rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix the frosting with 1/4 teaspoon cinnamon in a bowl. When the cake is completely cool, spread over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
