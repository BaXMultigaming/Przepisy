  "ingredients": [
    "0.25 cup butter, softened",
    "0.5 cup corn flour",
    "0.33300000429153 cup water",
    "1 (10 ounce) package frozen corn kernels, thawed",
    "0.5 cup white sugar",
    "0.25 cup cornmeal",
    "0.125 cup heavy cream",
    "0.33300000429153 teaspoon baking powder",
    "0.25 cup chopped fresh parsley",
    "0.25 cup chili powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease an 8 x 8 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl beat butter until smooth. Stir in flour and beat on low, adding water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chop corn in food processor or blender. Stir into butter mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl combine sugar, cornmeal, cream, baking powder, parsley and chili powder; add to butter mixture. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 1 hour. Let stand 15 minutes before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
