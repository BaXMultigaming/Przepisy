  "ingredients": [
    "0.75 cup cocoa powder",
    "0.66666668653488 cup vegetable oil",
    "0.25 cup water",
    "1 cup sugar",
    "0.25 cup stevia powder",
    "0.75 cup soy milk",
    "1 teaspoon vanilla",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cocoa powder, oil, and water in a bowl; stir in sugar and stevia until combined. Stir in soy milk and vanilla until combined. Add flour and baking powder; stir until smooth. Transfer batter to the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is dry and edges start to pull away from the sides of the pan, about 35 minutes.",
      "section": null,
