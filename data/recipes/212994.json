  "ingredients": [
    "3 tablespoons olive oil",
    "1 onion, chopped",
    "2 cloves garlic, minced",
    "0.5 pound pork loin, chopped",
    "0.5 pound peeled and deveined prawns",
    "salt and pepper to taste",
    "1 tomato, chopped",
    "0.25 pound zucchini, seeded and cut into bite-size pieces",
    "0.25 pound fresh okra, ends trimmed",
    "0.25 pound fresh green beans, trimmed",
    "0.25 pound eggplant, cut into bite-size pieces",
    "1 small bitter melon, cut into bite-size pieces"
