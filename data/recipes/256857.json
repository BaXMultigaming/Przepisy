  "ingredients": [
    "1 gallon water",
    "3 cups tomato sauce",
    "1 yellow onion, quartered",
    "4 tablespoons chicken bouillon (such as Knorr®)",
    "3 cloves garlic, minced",
    "1 tablespoon dried oregano",
    "3 pounds lean ground beef",
    "3 eggs",
    "0.5 cup tomato sauce",
    "0.25 cup uncooked white rice",
    "0.25 cup chopped fresh cilantro",
    "1 tablespoon seasoned salt (such as Season-All®)",
    "1 tablespoon dried oregano leaves",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon ground cumin",
    "10 small baby potatoes",
    "5 large carrots, sliced diagonally",
    "5 stalks celery, sliced diagonally",
    "2 zucchini, chopped",
    "2 cups thickly shredded green cabbage",
    "1 lemon, sliced into wedges",
    "2 avocados, chopped",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Pour water into a large stockpot over high heat. Stir in 3 cups tomato sauce, yellow onion, chicken bouillon, garlic, and 1 tablespoon dried oregano. Bring broth to a slow boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, eggs, 1/2 cup tomato sauce, white rice, 1/4 cup cilantro, seasoned salt, 1 tablespoon dried oregano, onion powder, garlic powder, black pepper, and cumin in a large bowl. Squeeze mixture with your hands until thoroughly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop 1/4 cup of beef mixture and form in a ball. Lower gently into boiling broth. Repeat with remaining beef mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir potatoes, carrots, and celery into the broth. Cover and simmer until meatballs and potatoes are tender, about 30 minutes. Stir in zucchini and cabbage. Cover and simmer until cabbage is tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with a squeeze of lemon juice and garnish with avocado and 1/4 cup cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
