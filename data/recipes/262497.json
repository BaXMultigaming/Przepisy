  "ingredients": [
    "1 cup water",
    "0.5 cup milk",
    "0.75 cup rolled oats",
    "0.25 teaspoon maple syrup",
    "0.125 teaspoon ground cinnamon",
    "1 pinch salt",
    "2 tablespoons peanut butter",
    "2 tablespoons raspberry preserves"
  ],
  "steps": [
    {
      "text": "Combine water and milk in a saucepan and bring to a boil. Add oats and reduce heat to medium. Add maple syrup, cinnamon, and salt. Stir to mix well. Cook, stirring frequently, until oatmeal is softened to your preference, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 tablespoon peanut butter in the bottom of a serving bowl. Pour cooked oatmeal in; top with remaining peanut butter and raspberry preserves.",
