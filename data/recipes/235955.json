  "ingredients": [
    "1 cup white rice flour",
    "0.75 cup white sugar",
    "0.5 cup oat flour",
    "0.5 cup all-purpose gluten-free flour",
    "1 tablespoon baking powder",
    "0.5 teaspoon ground cinnamon",
    "1 egg",
    "0.66666668653488 cup milk",
    "0.33333334326744 cup vegetable oil",
    "0.33333334326744 cup yogurt",
    "0.5 teaspoon vanilla extract",
    "0.5 cup chopped walnuts",
    "0.5 cup raisins",
    "0.5 cup pumpkin puree"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix rice flour, sugar, oat flour, all-purpose flour, baking powder, and cinnamon together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg, milk, vegetable oil, yogurt, and vanilla together in a separate bowl until smooth; add to the dry ingredients and mix by hand until mostly smooth with only small lumps and you cannot see any patches of dry material in the batter. Gently stir walnuts, raisins, and pumpkin puree into the batter; spoon into prepared muffin cups to about 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
