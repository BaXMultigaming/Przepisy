  "ingredients": [
    "1 gallon vegetable broth",
    "1 cup sea salt",
    "1 tablespoon crushed dried rosemary",
    "1 tablespoon dried sage",
    "1 tablespoon dried thyme",
    "1 tablespoon dried savory",
    "1 gallon ice water"
  ],
  "steps": [
    {
      "text": "Combine broth, salt, rosemary, sage, thyme, and savory in a large stockpot. Bring to a boil, stirring frequently until salt dissolves; let cool to room temperature. Pour into a food-grade 5-gallon bucket. Stir in ice water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3HtMlEDZJU0VKTKbbrJ8YjKvGJQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/54614-turkey-brine-mfs-step2-104-65a3e85c3c344c848d58122291bcdfbf.jpg"
      ],
      "image": "assets/images/54614/step_01.webp"
    },
    {
      "text": "Pat turkey dry; remove giblets from cavity. Place turkey, breast-side down, into brine, making sure cavity fills. Refrigerate at least 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/11HbvKTCeNEaHuxvjR7-uhoI5tY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/54614-turkey-brine-mfs-step3-106-db051f73142240b6a46d4d9908353d7f.jpg"
      ],
      "image": "assets/images/54614/step_02.webp"
    },
    {
      "text": "Drain off and discard excess brine; pat turkey dry. Cook turkey as desired, reserving drippings for gravy. Note that brined turkeys often cook 20 to 30 minutes faster; start checking for doneness early.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kZJVbX3V-ZF3slmuv3AC4qI7VrE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/54614-turkey-brine-mfs-step4-107-a01b015284224db6bf99af3e4cb0ca01.jpg"
      ],
