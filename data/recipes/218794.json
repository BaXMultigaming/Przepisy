  "ingredients": [
    "1 tablespoon olive oil",
    "1 small onion, diced",
    "3 stalks celery, diced",
    "3 cloves garlic, minced",
    "2 carrots, shredded",
    "1 pound cooked, cubed chicken breast",
    "4 cups chicken broth",
    "1 (16 ounce) package mini potato gnocchi",
    "1 (6 ounce) bag baby spinach leaves",
    "1 tablespoon cornstarch",
    "2 tablespoons cold water",
    "2 cups half-and-half cream",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A7cglJtWRMsmkS2wMBfvl_DPub8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218794-Chicken-and-Gnocchi-Soup-ddms-4x3-step1-9f721dcc485c478f947ecdc3283c4984.jpg"
      ],
      "image": "assets/images/218794/step_01.webp"
    },
    {
      "text": "Heat oil in a large pot over medium heat. Cook carrots, celery, onion, and garlic in hot oil until onion is translucent, about 5 minutes. Stir in cubed chicken and chicken broth; bring to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZR98Byn6QoPs3BNIogV8-S59phU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218794-Chicken-and-Gnocchi-Soup-ddms-4x3-step2-c6f891356de04dd19e0cd3ad20ab815b.jpg"
      ],
      "image": "assets/images/218794/step_02.webp"
    },
    {
      "text": "Stir gnocchi into soup and cook until they begin to float, 3 to 4 minutes. Stir in spinach and cook until wilted, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e0Yh_njRtMU7rdN0mIktVWiyBDo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218794-Chicken-and-Gnocchi-Soup-ddms-4x3-step3-d96e51dda1424e18990d28de68896fde.jpg"
      ],
      "image": "assets/images/218794/step_03.webp"
    },
    {
      "text": "Whisk cornstarch into cold water in a measuring cup until smooth. Stir the cornstarch mixture and half-and-half into soup. Cook until soup thickens slightly, about 5 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
