  "ingredients": [
    "1 (29 ounce) can sweet potatoes",
    "2 large eggs",
    "1 cup packed brown sugar",
    "1 cup milk",
    "0.25 cup unsalted butter, melted",
    "2 teaspoons lemon juice",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground cloves",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 1 ½-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix drained sweet potatoes and eggs in a large bowl with an electric mixer until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bdxZqwF1s_rO-AxHtECX8BZ1RD8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/180868-all-time-favorite-sweet-potato-pudding-VAT-step-02-60399f40fce0496d8f4a7ab2aad00e13.jpg"
      ],
      "image": "assets/images/180868/step_02.webp"
    },
    {
      "text": "Beat in brown sugar, milk, melted butter, lemon juice, ginger, cloves, cinnamon, and salt until smooth. Pour into the prepared dish and spread evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zgtw4_yMFcUeYyLNW8W2r_NGsqk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/180868-all-time-favorite-sweet-potato-pudding-VAT-step-03-2305a5ab5b2b4ca892510dd9fbc1fda1.jpg"
      ],
      "image": "assets/images/180868/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until hot and golden brown on top, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ujeUtzPbnnj5ZsquU0bf8JvGaug=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/180868-all-time-favorite-sweet-potato-pudding-VAT-step-04-26ec2ae535294c318e9aef5ee50fe0e5.jpg"
