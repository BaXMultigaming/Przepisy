  "ingredients": [
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "2 teaspoons ground cloves",
    "2 teaspoons ground nutmeg",
    "0.125 teaspoon salt",
    "2 cups white sugar",
    "0.66666668653488 cup shortening",
    "2 large eggs",
    "2 cups mashed cooked potatoes",
    "0.75 cup milk",
    "1 cup chopped walnuts",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour a 10-inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, cinnamon, cloves, nutmeg, and salt together into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and shortening in a large bowl with an electric mixer until light and fluffy. Add eggs, one at a time, beating well after each addition. Mix in flour mixture alternately with mashed potatoes and milk. Stir in walnuts and raisins. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 1 1/2 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
