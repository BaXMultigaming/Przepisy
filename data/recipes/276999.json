  "ingredients": [
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "1.5 cups all-purpose flour",
    "1.75 teaspoons baking powder",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two 8-inch round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream sugar and butter together in a large bowl using an electric mixer until pale and fluffy, 6 to 7 minutes. Beat in eggs, 1 at a time. Stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and baking powder in a separate bowl. Add to butter mixture and mix well. Stir in milk until batter is smooth. Pour evenly into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
