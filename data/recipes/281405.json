  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup low-calorie natural sweetener (such as Swerve®)",
    "1.5 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.75 cup mashed Haas avocado",
    "0.75 cup buttermilk",
    "1 egg, at room temperature",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sweetener, baking powder, cinnamon, baking soda, and salt in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix avocado, buttermilk, egg, and vanilla together in a separate bowl. Add dry ingredients and mix until just combined. Stir in pecans. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, 60 to 75 minutes. Cool in the pan for 10 minutes. Invert onto a wire rack and cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
