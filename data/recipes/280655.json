  "ingredients": [
    "8 cups water, divided",
    "4 cups chopped rhubarb",
    "3 family-size tea bags",
    "4 fresh mint leaves",
    "1 cup white sugar",
    "3 tablespoons lemon juice",
    "ice cubes"
  ],
  "steps": [
    {
      "text": "Bring 4 cups of water to a boil. Add rhubarb, cover, and simmer for 30 minutes. Remove from heat. Stir in tea bags and mint leaves. Cover and let steep for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and lemon juice in a pitcher. Strain rhubarb and tea mixture over the sugar. Discard the solids.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a wooden spoon, stir tea until sugar has dissolved. Add remaining 4 cups of water to the pitcher and stir again. Serve over ice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
