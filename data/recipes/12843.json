  "ingredients": [
    "1 (12 ounce) package egg noodles",
    "2 tablespoons vegetable oil",
    "0.25 cup chopped onion",
    "0.25 cup chopped green bell pepper",
    "0.25 cup chopped red bell pepper",
    "1 (10.5 ounce) can condensed cream of Cheddar cheese soup",
    "1 (5 ounce) can tuna, drained",
    "0.25 cup milk",
    "0.25 teaspoon salt",
    "ground black pepper to taste",
    "0.25 cup Italian seasoned bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the noodles are cooking, heat oil in a medium saucepan over medium heat. Sauté onion and bell peppers in the hot oil until tender, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour condensed soup into the saucepan. Add tuna, milk, salt, and pepper; mix until well combined. Reduce heat to medium-low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain egg noodles well. Fold noodles into the tuna mixture until well coated. Transfer to a 2-quart casserole and sprinkle bread crumbs over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is crisp and golden brown, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
