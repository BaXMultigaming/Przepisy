  "ingredients": [
    "2 tablespoons butter",
    "2 pounds yellow onions, halved and sliced 1/2 inch thick",
    "4 (14 ounce) cans beef broth",
    "1 (10.5 ounce) can beef consomme",
    "0.25 cup grated Romano cheese",
    "salt and pepper to taste",
    "8 slices French bread, toasted",
    "0.5 cup shredded Gruyere cheese"
  ],
  "steps": [
    {
      "text": "In a large pot over low heat, melt butter. Cook onions in butter until soft and golden brown, 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in beef broth and consomme and simmer 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk Romano into soup and season with salt and pepper. Pour soup into 8 ovenproof bowls. Top with toasted slices of bread and grated Gruyere.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bowls under broiler until cheese melts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
