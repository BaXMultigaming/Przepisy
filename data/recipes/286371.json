  "ingredients": [
    "2 tablespoons rice wine vinegar",
    "2 tablespoons extra-virgin olive oil",
    "3 tablespoons low-sugar dried cranberries",
    "1 tablespoon minced shallot",
    "salt and freshly ground black pepper to taste",
    "4 ounces arugula",
    "1 ounce Asiago cheese, shaved",
    "2 tablespoons pine nuts"
  ],
  "steps": [
    {
      "text": "Whisk together vinegar and oil in a large bowl. Stir in cranberries, shallot, salt, and pepper. Set aside until cranberries begin to soften and flavors meld, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add arugula, Asiago cheese, and pine nuts to the bowl and toss to coat evenly. Serve immediately.",
