  "ingredients": [
    "2 large baking potatoes",
    "2 tablespoons butter",
    "0.25 cup chopped onion",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Scrub the potatoes well and pierce with a fork. Cook on full power in microwave oven for 5 minutes; turn the potatoes over and cook 5 more minutes. Remove the potatoes from the oven and set aside to cool. Thinly slice the cooled potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir the butter and onion in a large skillet over medium heat until the onion is translucent, about 5 minutes. Gently place the potatoes into the skillet and fry, carefully flipping the potatoes a few times, until slices are browned around the edges. Sprinkle with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
