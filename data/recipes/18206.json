  "ingredients": [
    "6 (3.5 ounce) links sweet Italian sausage, casings removed",
    "5 cups water",
    "1 (14.5 ounce) can stewed tomatoes, with juice",
    "2 teaspoons dried basil",
    "1 (1 ounce) package dry onion soup mix",
    "4 tomatoes, diced",
    "2 cups cheese tortellini",
    "3 cups shredded cabbage"
  ],
  "steps": [
    {
      "text": "Sauté sausage in a large pot over medium high heat until browned and crumbly, about 5 minutes. Pour in water, stewed tomatoes, basil, onion soup mix, and fresh tomatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring just to a boil, reduce heat to low and simmer for 15 minutes. Stir in the tortellini and cabbage. Simmer for 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
