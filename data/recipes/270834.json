  "ingredients": [
    "2 eggs",
    "1 cup packed fresh spinach",
    "0.75 cup oats",
    "0.5 cup cottage cheese",
    "0.33333334326744 cup applesauce",
    "1 tablespoon chia seeds",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat a waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, spinach, oats, cottage cheese, applesauce, chia seeds, and baking powder together in a smoothie blender (such as a NutriBullet®); blend until smooth, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture into the preheated waffle iron in batches if needed, and cook until each waffle is golden brown and the iron stops steaming, about 5 minutes.",
