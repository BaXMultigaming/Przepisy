  "title": "Pork Chop Packs",
  "description": "Pork chops baked in foil packets with sweet potato, onion, and apple. Very simple and easy to make for one or for the whole crew.",
  "authors": [
    "Lara Robinson"
  ],
  "date_published": "2000-03-13T08:49:07-05:00",
