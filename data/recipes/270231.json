  "ingredients": [
    "1 teaspoon butter, or as needed",
    "6 slices bread, or more to taste",
    "1 (12 fluid ounce) can evaporated milk",
    "0.25 cup white sugar",
    "0.25 cup brown sugar",
    "3 eggs",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "1 dash salt",
    "3 tablespoons melted butter",
    "0.33333334326744 cup chocolate-hazelnut spread (such as Nutella®)",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a pie dish and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Tear bread into 1- to 2-inch pieces and place in the bottom of the prepared pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine evaporated milk, white sugar, brown sugar, eggs, vanilla extract, cinnamon, and salt in a bowl. Mix well and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add melted butter to bread pieces in the pie dish and toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate-hazelnut spread in a microwave-safe bowl in a microwave to soften slightly, 15 to 30 seconds. Place dollops on top of bread mixture, spreading to make an even layer. Sprinkle with walnuts. Pour milk-egg mixture on top, making sure bread is completely covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
