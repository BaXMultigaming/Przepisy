  "ingredients": [
    "2 tablespoons vegetable oil, divided",
    "3 eggs, beaten",
    "2 tablespoons dark soy sauce",
    "2 tablespoons ketchup",
    "1 tablespoon brown sugar",
    "1 teaspoon toasted sesame oil",
    "1 teaspoon sweet chili sauce",
    "1 zucchini, chopped",
    "1 carrot, chopped",
    "8 green onions, sliced",
    "1 clove garlic, crushed",
    "2 cups cooked rice",
    "0.5 pound cooked prawns",
    "2 tablespoons fresh chives, chopped"
  ],
  "steps": [
    {
      "text": "Heat 1 tablespoon vegetable oil in a skillet over medium heat. Swirl the beaten egg into the pan so that it coats the surface. Flip the egg after 30 seconds, and cook for an additional 20 seconds on the other side. Remove the egg from the pan and, when cool enough to handle, roll up on a cutting board. Slice the rolled egg to make thin strips and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine soy sauce, ketchup, brown sugar, sesame oil, and chili sauce; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the remaining 1 tablespoon oil in a skillet or wok over medium-high heat. When hot, add the zucchini, carrot, and green onions. Stir-fry for three minutes. Add the garlic, rice, prawns, and sauce mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and serve immediately, topped with the egg strips and chopped chives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
