  "title": "Delicious Stuffed Banana Peppers",
  "description": "Cream cheese, sun-dried tomatoes, garlic, and cilantro are stuffed inside these bacon-wrapped banana peppers and grilled to make this crowd-pleasing appetizer.",
  "authors": [
    "Paulie"
  ],
  "date_published": "2018-07-26T22:26:55-04:00",
