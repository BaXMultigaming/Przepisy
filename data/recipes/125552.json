  "ingredients": [
    "2 tablespoons butter or oil",
    "1.5 pounds boneless pork, cut into 1/2-inch cubes",
    "1 medium onion, chopped",
    "2 cloves garlic, minced",
    "3 cups chicken broth",
    "1 bay leaf",
    "0.5 teaspoon salt",
    "0.25 teaspoon dried rosemary, crushed",
    "0.25 teaspoon rubbed sage",
    "3 cups frozen, cubed butternut squash",
    "2 MacIntosh apples, cored and cubed",
    "2 large potatoes, peeled and cubed",
    "2 cups carrots, peeled and diced"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium-high heat. Add pork; cook until lightly browned on all sides. Stir in onion and garlic; cook until onion softens and pork is no longer pink, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken broth, bay leaf, salt, rosemary, and sage; bring to a boil, then reduce heat to medium-low. Cover pot; simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add squash, apples, potatoes, and carrots; return to a simmer. Cook, uncovered, until squash and apples are tender, about 20 minutes. Remove and discard bay leaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
