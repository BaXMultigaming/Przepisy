  "ingredients": [
    "0.5 tablespoon butter",
    "2 tablespoons chopped onion",
    "3 slices stale bread, cut into cubes",
    "0.25 cup shredded sharp Cheddar cheese",
    "1 egg, beaten",
    "0.25 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon ground black pepper",
    "8 slices bacon",
    "toothpicks",
    "1 tablespoon bacon drippings"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium-low heat. Add onion; cook until soft and translucent, about 5 minutes. Transfer onion to a bowl; wipe skillet clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir bread cubes, Cheddar cheese, egg, salt, garlic powder, and black pepper into onion. Roll bread cube mixture into 8 equal-sized balls; wrap each in 1 strip bacon. Secure bacon with toothpicks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt bacon drippings in the same skillet over medium heat. Add bacon balls; cook, rolling constantly, until crisp, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
