  "ingredients": [
    "PAM® Coconut Oil No-Stick Cooking Spray",
    "1 (14 ounce) can sweetened condensed milk",
    "0.25 cup Peter Pan® Crunchy Peanut Butter, melted",
    "11 whole graham crackers, crushed into fine crumbs",
    "0.5 cup Parkay® Original Spread-tub, melted",
    "1 cup semisweet chocolate chunks",
    "0.25 cup toffee bits",
    "1.25 cups flaked coconut",
    "0.25 cup red and green candy-coated chocolate pieces"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Line 13x9-inch baking dish with aluminum foil; spray foil with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sweetened condensed milk and peanut butter in small bowl; set aside. Combine crumbs and Parkay until blended in second bowl. Press crumb mixture into bottom of dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle crust with chocolate chunks, toffee bits and coconut. Pour peanut butter mixture evenly over coconut. Sprinkle with chocolate pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 to 25 minutes or until bubbly and golden brown. Cool completely. Lift from dish, remove foil and cut into 30 bars.",
      "section": null,
      "name": null,
      "url": null,
