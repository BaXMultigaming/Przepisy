  "ingredients": [
    "2 cups gluten-free all-purpose baking flour (such as Gluten Free Mama)",
    "3 teaspoons gluten-free baking powder",
    "2 teaspoons xanthan gum",
    "1 teaspoon salt",
    "1.5 cups sour cream",
    "1 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, xanthan gum, and salt together in a mixing bowl. Add sour cream and butter and mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon evenly into the prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 20 to 30 minutes.",
