  "ingredients": [
    "3.25 cups all-purpose flour",
    "1 cup refined coconut oil",
    "1 teaspoon salt",
    "5 tablespoons ice cold water, or as needed"
  ],
  "steps": [
    {
      "text": "Combine flour, coconut oil, and salt in a food processor and pulse until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add 5 tablespoons ice cold water and pulse. With the food processor running at low speed, add 1 additional tablespoon of water at a time until a dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using your hands, pat dough to shape into a ball. Cut in half for 2 pie crusts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flour a work surface and rolling pin and roll out dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake as directed for any pie recipe you are following.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
