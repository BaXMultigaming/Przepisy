  "ingredients": [
    "2 eggplants",
    "0.5 cup canola oil",
    "2 tablespoons plain yogurt",
    "1 teaspoon salt",
    "1 small onion, chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Poke eggplant with a fork and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven until skin is charred and eggplant is soft, about 45 minutes. Cool until easily handled, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel eggplant and drain in a colander for 30 minutes. Chop eggplant very finely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggplant in a bowl and blend using an electric mixer. Gradually add oil and keep mixing until incorporated, about 2 minutes. Add yogurt and salt; mix well. Stir in chopped onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
