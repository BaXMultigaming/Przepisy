  "ingredients": [
    "1 cup shredded mozzarella cheese",
    "0.25 cup shredded sharp Cheddar cheese",
    "0.25 cup shredded Parmesan cheese",
    "2 tablespoons cream cheese",
    "0.75 cup almond flour",
    "1 egg",
    "1 teaspoon granulated garlic",
    "1 teaspoon dried parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mozzarella cheese, Cheddar cheese, Parmesan cheese, and cream cheese in a microwave safe bowl. Microwave for 1 minute. Remove and mix in almond flour, egg, garlic, and parsley until well combined. Spread dough onto a baking sheet and poke holes into the dough with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Remove and let cool for 20 minutes.",
