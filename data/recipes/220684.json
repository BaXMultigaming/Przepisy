  "ingredients": [
    "cooking spray",
    "1 (270 g) tub PHILADELPHIA Savory Garlic Cooking Creme Cream Cheese Product",
    "1 cup milk",
    "0.125 teaspoon ground black pepper",
    "3 pounds baking potatoes, peeled, very thinly sliced",
    "0.66666668653488 cup KRAFT 100% Grated Parmesan Cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a shallow, 2-liter casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together cooking creme, milk, and pepper in a medium bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer 1/2 of the potatoes evenly in the prepared dish. Top with 1/2 of the cooking creme mixture, then 1/2 of the Parmesan cheese. Repeat layers once more. Cover the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Uncover and continue baking until potatoes are tender and sauce is hot and bubbly, 30 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
