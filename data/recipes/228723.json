  "ingredients": [
    "1 cup white vinegar",
    "0.5 cup white sugar",
    "0.5 cup water",
    "1 tablespoon chopped fresh dill",
    "2 teaspoons salt",
    "2 cucumbers, peeled and thinly sliced",
    "0.33333334326744 cup sour cream"
  ],
  "steps": [
    {
      "text": "Combine vinegar, sugar, water, dill, and salt in a medium saucepan; boil until sugar dissolves. Pour vinegar mixture over cucumbers in a large bowl; toss to coat. Cover the bowl with plastic wrap; refrigerate until chilled, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain cucumber mixture; discard vinegar mixture. Transfer cucumbers to a bowl; stir in sour cream. Refrigerate until ready to serve.",
      "section": null,
