  "ingredients": [
    "3 cups all-purpose flour",
    "0.5 cup white sugar",
    "0.5 teaspoon salt",
    "1 cup margarine",
    "1.5 cups light corn syrup",
    "1.5 cups white sugar",
    "4 eggs",
    "3 tablespoons margarine, melted",
    "1.5 teaspoons vanilla extract",
    "2.5 cups chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 10x15-inch jellyroll pan, or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xFVLQk9QNdLN8cJ0LFDBBiUKCyo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13564-pecan-pie-bars-i-ddmfs-step-01-fd94432fb57044afbc561b77e8acecfe.jpg"
      ],
      "image": "assets/images/13564/step_01.webp"
    },
    {
      "text": "Combine flour, 1/2 cup sugar, and salt in a large bowl. Cut in 1 cup butter until mixture resembles coarse crumbs. Sprinkle mixture evenly over the prepared pan; press firmly to form a crust. Bake in the preheated oven for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m3lqFCUnpqeieEeZYYoZPKl7oco=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13564-pecan-pie-bars-i-ddmfs-step-02-0429644c227d4e978bdbb5f905d81a0e.jpg"
      ],
      "image": "assets/images/13564/step_02.webp"
    },
    {
      "text": "Meanwhile, mix corn syrup, 1 ½ cups sugar, eggs, 3 tablespoons melted butter, and vanilla extract together in a large bowl until smooth. Stir in pecans; spread filling evenly over hot crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rzUjx4CCFr9FRBwg9WjZXA7B_-g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13564-pecan-pie-bars-i-ddmfs-step-03-5f842a525a7f4fe9a87c0a967bfac2d7.jpg"
      ],
      "image": "assets/images/13564/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until filling is set, about 25 minutes. Allow to cool completely in the pan on a wire rack before slicing into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tc2EEWQbFGktL532Co5zYOegoq0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13564-pecan-pie-bars-i-ddmfs-step-04jpg-9a5e120ffcfd4957ba5be56c767442a1.jpg"
      ],
      "image": "assets/images/13564/step_04.webp"
    }
  ],
