  "ingredients": [
    "cooking spray",
    "1 pint cherry tomatoes",
    "0.5 medium onion, diced",
    "3 large cloves garlic, minced",
    "0.25 cup olive oil",
    "salt and freshly ground black pepper to taste",
    "1 (8 ounce) package feta cheese",
    "1 (8 ounce) package farfalle (bow-tie) pasta",
    "0.5 cup heavy cream",
    "2 tablespoons chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray a casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cherry tomatoes, onion, and garlic in the prepared dish. Drizzle olive oil over top and season with salt and pepper; toss to coat. Set feta block in the center of the dish and turn over to coat with olive oil and spices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tomatoes soften and feta is starting to brown, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring a large pot of lightly salted water to a boil. Cook pasta at a boil, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove casserole dish from the oven and stir in cream, basil, and pasta. Keep stirring until pasta and feta are well mixed with the sauce. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
