  "ingredients": [
    "3 heads broccoli",
    "3 tablespoons unsalted butter",
    "3 tablespoons all-purpose flour",
    "3 cups whole milk",
    "1.5 cups grated Parmesan cheese",
    "2 teaspoons freshly cracked black pepper",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil. Quarter broccoli heads lengthwise and add to the boiling water; simmer for 3 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a medium pot over medium heat. Stir in flour and cook for 1 minute. Whisk in milk. Bring to a simmer; cook until thickened, about 5 minutes. Remove from heat and stir in Parmesan cheese, pepper, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer drained broccoli to a 9x13-inch baking dish. Pour sauce on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until hot and bubbly, about 15 minutes. Broil until top starts to brown, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
