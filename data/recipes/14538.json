  "ingredients": [
    "1 tablespoon vegetable oil",
    "0.5 onion, finely diced",
    "1 stalk celery, diced",
    "1 teaspoon hot pepper sauce",
    "1 tablespoon Dijon-style prepared mustard",
    "2 skinless, boneless chicken breast halves"
