  "ingredients": [
    "1 recipe pastry for a 9 inch single crust pie",
    "2 (1 ounce) squares unsweetened chocolate",
    "0.25 cup butter",
    "1 tablespoon instant coffee powder",
    "1 (14 ounce) can sweetened condensed milk",
    "2 eggs, beaten",
    "1 teaspoon vanilla extract",
    "1 cup walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In medium saucepan, melt chocolate and butter or margarine over low heat. Dissolve coffee in 1/4 cup hot water, then stir it into saucepan with sweetened condensed milk, eggs, and vanilla. Mix well. Pour filling into pastry shell. Top with walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 40 to 45 minutes, or until center is set. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
