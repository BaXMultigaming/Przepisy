  "ingredients": [
    "2 cups shredded red cabbage",
    "2 cups matchstick-cut green apples",
    "2 tablespoons chopped green onions",
    "0.25 cup low-fat plain Greek yogurt",
    "2 teaspoons white wine vinegar",
    "2 teaspoons honey",
    "0.5 teaspoon celery seeds",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Toss cabbage, apples, and green onions together in a bowl. Whisk yogurt, vinegar, honey, celery seeds, and salt in another bowl. Add to vegetable mixture; toss to coat.",
