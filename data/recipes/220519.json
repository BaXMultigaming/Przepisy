  "title": "Irish Shepherd's Pie",
  "description": "This Irish shepherd's pie made with ground lamb and veggies baked under Irish Cheddar-mashed potatoes is Chef John's version of a comfort food classic.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-03-07T13:44:40-05:00",
