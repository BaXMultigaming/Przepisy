  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 tablespoon olive oil",
    "1 tablespoon butter",
    "2 pounds lean ground lamb",
    "1 onion, diced",
    "0.33333334326744 cup all-purpose flour",
    "3 cloves garlic, minced",
    "1 tablespoon ketchup",
    "2 teaspoons minced fresh rosemary",
    "1 teaspoon paprika",
    "0.125 teaspoon ground cinnamon",
    "salt and ground black pepper to taste",
    "2.5 cups water, or as needed",
    "1 (12 ounce) package frozen peas and carrots, thawed",
    "2.5 pounds Yukon Gold potatoes, peeled and halved",
    "0.25 pound Irish cheese (such as Dubliner®), shredded",
    "0.25 cup cream cheese",
    "1 tablespoon butter",
    "1 pinch ground cayenne pepper",
    "1 large egg yolk",
    "2 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place olive oil and butter in a Dutch oven over medium heat. Stir in ground lamb and onion; cook and stir until meat is brown and crumbly, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour until incorporated. Mix in garlic, ketchup, rosemary, paprika, cinnamon, salt, and pepper; cook and stir until garlic is fragrant, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in water, scraping up any brown bits from the bottom of the Dutch oven. Reduce heat to medium-low and bring mixture to a simmer; cook and stir until thick, 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove lamb mixture from heat, then stir in peas and carrots until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread lamb mixture into the bottom of a 9x13-inch baking dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes into a large pot of salted water. Bring to a boil, reduce heat to medium, and cook until tender, about 15 minutes. Drain well and return potatoes to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash Irish cheese, cream cheese, butter, and cayenne pepper into potatoes until smooth. Season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together egg yolk and milk in a small bowl; stir into mashed potato mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top lamb mixture in the baking dish with mashed potatoes; spread evenly to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is golden brown and sauce is bubbling up around the edges, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_JkcQh5FTLHDTVf-UfspBRnQw-M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/IMG_3038_IrishShepherdsPie4x3-37d92a9414f54995b3b4d7f7ad57044a.JPG"
      ],
