  "title": "French Onion Soup I",
  "description": "This French onion soup recipe features slices of toasted French bread topped with melted cheese in a bowl of rich, savory broth with caramelized onions.",
  "authors": [
    "chefbuzz"
  ],
  "date_published": "1999-01-20T14:50:46-05:00",
