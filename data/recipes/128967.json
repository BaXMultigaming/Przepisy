  "ingredients": [
    "2 delicata squash, halved and seeded",
    "3 tablespoons butter, softened",
    "1 tablespoon fresh lime juice",
    "1 teaspoon chili powder, or to taste",
    "0.5 teaspoon lime zest",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place squash, skin-side up, into a large baking dish. Fill the dish with 1/4 inch water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until squash pierces easily with a fork, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When the squash is almost finished, blend butter with lime juice and chili powder in a small bowl. Mix in lime zest, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove squash from the oven, flip, and spoon butter mixture into the cavities. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
