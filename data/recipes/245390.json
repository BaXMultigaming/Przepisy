  "ingredients": [
    "1 cup peanut butter",
    "0.5 cup vegetable shortening",
    "1 teaspoon vanilla extract",
    "2.5 cups confectioners' sugar",
    "0.25 cup soy milk, or more as needed"
  ],
  "steps": [
    {
      "text": "Whip peanut butter, shortening, and vanilla together in a mixing bowl until well blended. Add confectioners' sugar and soy milk; mix until light and fluffy. If mixture is too thick, add 1 tablespoon soy milk at a time until creamy and spreadable.",
