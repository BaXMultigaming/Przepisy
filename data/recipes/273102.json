  "ingredients": [
    "1 cup water",
    "0.5 cup quinoa",
    "1 cup rinsed canned chickpeas",
    "1 cup diced tomatoes",
    "1 cup diced cucumber",
    "1 cup chopped green onions",
    "1 cup chopped fresh parsley",
    "3 tablespoons lemon juice",
    "2 tablespoons extra-virgin olive oil",
    "3 cloves garlic, minced",
    "2 teaspoons chopped fresh mint",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender, 15 to 20 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chickpeas, tomatoes, cucumber, green onions, and parsley in a large bowl. Stir in cooled quinoa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix lemon juice, olive oil, garlic, mint, salt, and pepper together in a separate small bowl. Pour over quinoa mixture; toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
