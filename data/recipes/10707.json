  "ingredients": [
    "1 cup white sugar",
    "0.5 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "0.5 cup all-purpose flour",
    "0.33333334326744 cup unsweetened cocoa powder",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kfoMIvHS6MvjABi7OgQW7lKP7VY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10707-mmm-mmm-better-brownies-DDMFS-step-01-1197-722f2814d3fe4b9b9f3d10d6e663f188.jpg"
      ],
      "image": "assets/images/10707/step_01.webp"
    },
    {
      "text": "Mix sugar, oil, and vanilla together in a medium bowl; beat in eggs until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HctoLDr00n8EcJ3NVI6kCZmqBso=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10707-mmm-mmm-better-brownies-DDMFS-step-01-1-1198-71ed2b34124747c9b49c92db8e7c6f25.jpg"
      ],
      "image": "assets/images/10707/step_02.webp"
    },
    {
      "text": "Mix flour, cocoa, baking powder, and salt together in a separate bowl; gradually stir into egg mixture until well blended. Stir in walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mwNc8TGaPtrV21v7ulQtjG0rcbM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10707-mmm-mmm-better-brownies-DDMFS-step-03-1201-ce0b9a8ad7b744c4803513b0ac7b93a1.jpg"
      ],
      "image": "assets/images/10707/step_03.webp"
    },
    {
      "text": "Spread the batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DcPRaVgdox5aOmRV2BBCo21Xxik=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10707-mmm-mmm-better-brownies-DDMFS-step-03-1202-258cc50b11624a3db1e06793c4a25ac9.jpg"
      ],
      "image": "assets/images/10707/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until the brownie begins to pull away from the edges of the pan, about 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Nbi7qytlP3J3XKfzhBX6-vgOhoY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10707-mmm-mmm-better-brownies-DDMFS-step-04-1211-88715760986f479bb5013d35c17c309d.jpg"
