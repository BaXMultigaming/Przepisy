  "ingredients": [
    "1 (10 ounce) can refrigerated buttermilk biscuit dough",
    "1 pound bacon",
    "5 eggs",
    "0.25 cup milk",
    "3 tablespoons butter, softened",
    "10 slices Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place biscuits 2 inches apart on an ungreased cookie sheet. Bake in preheated oven for 8 to 11 minutes or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat together eggs and milk. Heat a lightly oiled skillet over medium heat. Scramble eggs to your liking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut open biscuits, lightly butter, layer with eggs, bacon, and cheese.",
      "section": null,
      "name": null,
