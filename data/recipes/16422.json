  "title": "Asian Chicken Noodle Salad",
  "description": "This Asian chicken noodle salad recipe features ramen noodles, chicken, crunchy vegetables, plenty of seeds and nuts, and a soy sauce-vinegar dressing.",
  "authors": [
    "Jackie"
  ],
  "date_published": "2000-03-10T19:04:24-05:00",
