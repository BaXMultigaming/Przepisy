  "ingredients": [
    "3 large bananas, mashed",
    "2 cups pancake mix",
    "1 cup chopped walnuts",
    "0.75 cup white sugar",
    "1 large egg",
    "3 tablespoons vegetable oil",
    "1 tablespoon vanilla extract",
    "1 cup blueberries",
    "0.33333334326744 cup packed brown sugar",
    "2 tablespoons all-purpose flour",
    "0.125 teaspoon ground cinnamon",
    "1 tablespoon cold butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Fill 12 to 16 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bananas, pancake mix, walnuts, sugar, egg, oil, and vanilla extract together. Fold in blueberries. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, flour, and cinnamon together in a small bowl. Cut in butter until mixture resembles coarse cornmeal. Sprinkle topping over muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
