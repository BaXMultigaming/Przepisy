  "steps": [
    {
      "text": "Heat olive oil in a large skillet over medium heat. Cook and stir onion in hot oil until tender, about 5 minutes; add garlic and continue to cook and stir until fragrant, about 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomatoes, chicken, red bell pepper, raisins, olives, red wine vinegar, oregano, cumin, and bay leaves into the onion mixture; cook until heated through, 5 to 7 minutes more. Remove and discard bay leaves before serving.",
