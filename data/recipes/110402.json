  "ingredients": [
    "0.25 cup margarine",
    "0.66666668653488 cup white sugar",
    "1 egg, beaten",
    "1 (8 ounce) package dates, pitted and finely chopped",
    "1 teaspoon vanilla extract",
    "2 cups crispy rice cereal",
    "0.75 cup walnuts, finely chopped",
    "1 cup sweetened flaked coconut"
  ],
  "steps": [
    {
      "text": "Combine the margarine, sugar, egg, and dates in a saucepan. Cook over medium heat until thick, about 7 to 10 minutes. Remove from heat; stir in vanilla.",
