  "ingredients": [
    "0.25 cup black cumin seed",
    "0.25 cup black peppercorns",
    "4 cinnamon sticks, broken",
    "2 tablespoons green cardamom seeds",
    "2 large bay leaves, crushed",
    "1 tablespoon fennel seed",
    "1.5 teaspoons whole cloves",
    "1 teaspoon chopped fresh mace",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Heat a small skillet over medium heat; add cumin seeds, black peppercorns, cinnamon sticks, cardamom seeds, bay leaves, fennel seeds, cloves, and mace. Dry-roast until fragrant, 6 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool spice mixture, then add nutmeg. Grind spice mixture in a spice grinder or coffee grinder into a fine powder. Store in an airtight container.",
