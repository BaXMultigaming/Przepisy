  "ingredients": [
    "1.75 cups all-purpose flour",
    "0.5 cup white sugar",
    "2 teaspoons baking powder",
    "1 egg",
    "0.75 cup vanilla soy milk",
    "0.33333334326744 cup vegetable oil",
    "1 teaspoon lemon zest",
    "4 ounces dairy-free cream cheese (such as Tofutti®)",
    "0.75 cup fresh blueberries",
    "3 tablespoons white sugar",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 1/2 cup sugar and baking powder in large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a second bowl, beat egg. Mix in soy milk, oil, and lemon zest. Pour egg mixture into flour mixture and mix batter with a spatula until just moistened. Fold in blueberries. Mix in dairy-free cream cheese by the 1/4 teaspoon so there are small chunks all around the batter. Gently blend in. Spoon batter into the prepared muffin cups, filling each 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 3 tablespoons sugar and lemon juice and in a small bowl. Brush onto the warm muffins immediately after they come out of the oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
