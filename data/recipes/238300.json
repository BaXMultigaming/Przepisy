  "ingredients": [
    "cooking spray",
    "2 (15 ounce) cans pork and beans",
    "1 (16 ounce) can kidney beans, rinsed and drained",
    "1 (15 ounce) can lima beans, rinsed and drained",
    "1 onion, chopped",
    "0.5 cup packed brown sugar",
    "0.5 cup ketchup",
    "0.5 teaspoon dry mustard",
    "4 strips cooked bacon, crumbled"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a 2 ½-quart baking dish with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pork and beans, kidney beans, lima beans, onion, brown sugar, ketchup, and dry mustard in a large bowl; transfer to the prepared baking dish. Sprinkle with bacon. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Remove foil; continue baking until bubbling, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
