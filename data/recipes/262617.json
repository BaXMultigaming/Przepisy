  "ingredients": [
    "1 avocado - peeled, pitted and diced",
    "0.5 white onion, chopped",
    "4 fresh tomatillos, husks removed",
    "1 jalapeno pepper, seeded and minced",
    "0.25 cup chopped fresh cilantro",
    "2 cloves garlic, finely chopped",
    "1.5 teaspoons salt",
    "1 pound uncooked medium shrimp, peeled and deveined",
    "1 teaspoon chili powder",
    "1 teaspoon salt",
    "1 tablespoon olive oil",
    "12 (6 inch) corn tortillas",
    "1 cup shredded cabbage",
    "2 limes"
  ],
  "steps": [
    {
      "text": "Place avocado, onion, tomatillos, jalapeno pepper, cilantro, garlic, and salt in the bowl of a food processor. Pulse until small chunks remain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill resealable plastic bag with shrimp, chili powder, and salt; shake to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium heat. Add shrimp and cook until pink and opaque, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide salsa, shrimp, and cabbage evenly to fill tortillas. Squeeze lime juice onto each taco.",
