  "ingredients": [
    "0.33333334326744 cup olive oil",
    "0.33333334326744 cup chopped fresh cilantro",
    "4 cloves garlic, peeled",
    "1 small lime, juiced",
    "1 teaspoon garlic and herb seasoning (such as Badia® Complete Seasoning®)",
    "0.125 teaspoon cayenne pepper",
    "1 pound uncooked medium shrimp, peeled and deveined",
    "3 slices white bread, crusts removed, toasted",
    "1 butter-flavored cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine olive oil, cilantro, garlic cloves, lime juice, garlic and herb seasoning, and cayenne pepper in the bowl of a food processor; pulse until well blended. Transfer mixture to an 8x8-inch glass baking dish; add shrimp and toss until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place toasted bread into the bowl of a food processor; pulse until becomes crumbs. Top shrimp with bread crumbs; generously coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and shrimp are bright pink, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
