  "ingredients": [
    "0.25 cup bulgur",
    "0.5 cup boiling water",
    "5 tomatoes, diced",
    "1 onion, finely diced",
    "1 cup chopped parsley",
    "0.25 cup chopped fresh mint leaves",
    "1 lemon, juiced",
    "2 teaspoons olive oil",
    "salt to taste"
