  "ingredients": [
    "2 pounds ground beef",
    "1 cup bread crumbs",
    "2 eggs",
    "0.25 cup chopped fresh parsley",
    "2 tablespoons grated onion",
    "2 tablespoons soy sauce",
    "0.25 teaspoon garlic powder",
    "1 (16 ounce) can jellied cranberry sauce (such as Ocean Spray®)",
    "1.5 cups ketchup",
    "2.5 tablespoons packed brown sugar",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VAox8lfCFEefKMuAzWGmIN1a6Us=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230537-cape-cod-cocktail-meatballs-VAT-005-step-01-0c0dff038e804a3ea8e024a73c596e7e.jpg"
      ],
      "image": "assets/images/230537/step_01.webp"
    },
    {
      "text": "Combine ground beef, bread crumbs, eggs, parsley, onion, soy sauce, and garlic powder in a bowl until thoroughly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F5CaYVhV3-B-fILfzT2bS478mLo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230537-cape-cod-cocktail-meatballs-VAT-006-step-02-ad86346c775e4df9aeb782e287f8b2bc.jpg"
      ],
      "image": "assets/images/230537/step_02.webp"
    },
    {
      "text": "Roll meat mixture into meatballs using about 2 teaspoons meat mixture per meatball; arrange meatballs in a large, deep baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KdjaYSXkJ8z_7V2cVTfD7dJZfvg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230537-cape-cod-cocktail-meatballs-VAT-007-step-03-6d10d949135649f89c1f4997b296ab58.jpg"
      ],
      "image": "assets/images/230537/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until meatballs are browned, about 25 minutes. Drain excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PRb_PQseK12qMQ93yiKfBS_Lcq4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230537-cape-cod-cocktail-meatballs-VAT-008-step-04-caaa9201d02e416b83c7cf4a44964f7c.jpg"
      ],
      "image": "assets/images/230537/step_04.webp"
    },
    {
      "text": "Combine cranberry sauce, ketchup, brown sugar, and lemon juice in a saucepan over medium heat; cook and stir until cranberry sauce melts and sugar dissolves. Pour sauce over meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8aYSpNJEKAdEps9NJRvDhh-d6Ko=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230537-cape-cod-cocktail-meatballs-VAT-009-step-05-7de1bec7655e488e918d6eace687d3a9.jpg"
      ],
      "image": "assets/images/230537/step_05.webp"
    },
    {
      "text": "Continue baking in the oven until sauce forms a glaze and meatballs are no longer pink inside, 25 to 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0mflfxP8ryCRkuiBTPvrj4Wt1TQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230537-cape-cod-cocktail-meatballs-VAT-010-step-06-ebb63225e0f646e2bb6b2f8fe4ae4354.jpg"
      ],
      "image": "assets/images/230537/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eUDENiWJEky18LV9wF9eZmAhCKk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/230537-cape-cod-cocktail-meatballs-VAT-001-4x3-43ba832b61174766bb917286334c8417.jpg"
