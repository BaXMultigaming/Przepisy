  "ingredients": [
    "2 cups almond milk (such as Silk®)",
    "1 (5 ounce) package non-instant chocolate pudding mix (such as JELL-O® Cook and Serve)",
    "0.25 cup vegan chocolate chips (such as Enjoy Life®)",
    "1 vegan graham cracker crust (such as Annie's®)",
    "0.5 cup vegan whipped cream (such as So Delicious® Cocowhip™)"
  ],
  "steps": [
    {
      "text": "Combine almond milk and pudding mix in a saucepan. Bring to a boil over medium heat, stirring constantly. When pudding boils, reduce heat to low and continue stirring until pudding thickens, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and stir in chocolate chips until melted. Pour into graham crust and refrigerate until set, about 2 hours.",
      "section": null,
