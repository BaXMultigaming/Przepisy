  "ingredients": [
    "1 (17.5 ounce) pouch sugar cookie mix",
    "0.75 cup all-purpose flour",
    "0.5 cup butter",
    "1 egg",
    "0.33333334326744 cup white sugar",
    "34 white chocolate kisses with candy cane stripes (such as Hershey's®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cookie mix, flour, butter, and egg in a mixing bowl. Mix until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sugar into a shallow dish. Roll dough into 1-inch balls; roll each in sugar. Place on ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set and golden, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cookies from the oven. Press a candy cane kiss in the center of each warm cookie. Let cool completely, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
