  "ingredients": [
    "2 jalapeno peppers, seeded",
    "1 medium lime, zested and juiced",
    "2 cloves garlic",
    "0.33333334326744 cup chopped fresh cilantro",
    "0.33333334326744 cup shredded coconut",
    "0.25 cup olive oil",
    "0.25 cup soy sauce",
    "1 pound uncooked medium shrimp, peeled and deveined",
    "bamboo skewers, soaked in water for 30 minutes"
  ],
  "steps": [
    {
      "text": "Combine jalapeños, lime zest, lime juice, and garlic in a blender. Add cilantro, coconut, oil, and soy sauce; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place shrimp in a large glass or ceramic bowl. Pour in marinade and toss to evenly coat. Cover with plastic wrap and marinate in the refrigerator for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove shrimp from marinade and gently shake off excess. Discard remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread shrimp onto skewers, piercing each shrimp near the head and tail.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place skewers onto the preheated grill; cook until nicely browned on all sides and the meat is opaque, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
