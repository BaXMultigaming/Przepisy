  "ingredients": [
    "1 (9 inch) pie shell",
    "2 cups chopped rhubarb",
    "1 cup white sugar",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon ground nutmeg",
    "2 eggs, beaten",
    "4 teaspoons milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread rhubarb evenly in unbaked pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, flour, and nutmeg in a medium bowl; mix well. Add eggs and milk; beat until smooth. Pour egg mixture over rhubarb layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover edges of pie shell with aluminum foil to prevent overbrowning. Bake in the preheated oven for 50 minutes. Remove foil; bake 10 minutes more.",
      "section": null,
