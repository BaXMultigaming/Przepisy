  "ingredients": [
    "0.5 cup chicken broth",
    "1 tablespoon sherry",
    "1 tablespoon soy sauce",
    "1 tablespoon cider vinegar",
    "1 tablespoon cornstarch",
    "0.25 teaspoon sugar",
    "0.25 teaspoon dry mustard",
    "0.25 teaspoon salt",
