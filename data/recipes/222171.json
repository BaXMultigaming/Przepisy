      "image_sources": [
        "https://www.allrecipes.com/thmb/QTi8PyUNXAuw35DJA_j1P8Uf6DY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222171-easy-parmesan-crusted-chicken-DDMFS-step-03-2-2939-2592b4e1cb8b42dd9a8474b8bec5cbad.jpg"
