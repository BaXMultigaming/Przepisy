  "ingredients": [
    "0.66666668653488 cup olive oil",
    "0.66666668653488 cup reduced-sodium soy sauce",
    "0.25 cup lemon juice",
    "2 tablespoons liquid smoke flavoring",
    "2 tablespoons spicy brown mustard",
    "2 teaspoons ground black pepper",
    "2 teaspoons garlic powder",
    "4 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kY8jtq8hkYxfd95c1xBVCH04hHY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/83793-best-chicken-marinade-VAT-ingredients-0fabd98ae84a4a36928af71cd8299abe.jpg"
      ],
      "image": "assets/images/83793/step_01.webp"
    },
    {
      "text": "Mix olive oil, soy sauce, lemon juice, liquid smoke, mustard, pepper, and garlic powder together in a large glass or ceramic bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fjdt7jvZ9j2l4a9tsrDfY4PRl7U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/83793-best-chicken-marinade-VAT-01-54ba727443c241ba874434329eb9fe9a.jpg"
      ],
      "image": "assets/images/83793/step_02.webp"
    },
    {
      "text": "Place chicken in the bowl and turn to coat with marinade. Cover and marinate in the refrigerator for 1 to 4 hours. For best results, do not marinate longer than 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2aJzkCLw06oiiAp_Frdfj5iSUW0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/83793-best-chicken-marinade-VAT-02-4b49b9e053ef4729ad3e5b848a4cdc93.jpg"
      ],
      "image": "assets/images/83793/step_03.webp"
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mIh2nC5_RRez3ihYYcCxd-w-bWE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/83793-best-chicken-marinade-VAT-03-0cfed6ea2c9f4f2fa18e602dda9fb8ae.jpg"
      ],
      "image": "assets/images/83793/step_04.webp"
    },
    {
      "text": "Remove chicken from the marinade and shake off excess. Discard the remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QzM0HhHP0HdjjZ0PxWKSpxxloYA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/83793-best-chicken-marinade-VAT-04-b995f4d85da7430089d3e5a1b7d1deaa.jpg"
      ],
      "image": "assets/images/83793/step_05.webp"
    },
    {
      "text": "Cook chicken on the preheated grill until no longer pink in the center and the juices run clear, 6 to 8 minutes per side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0GzVYuF7hyk900mntO8CMpSH99Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/83793-best-chicken-marinade-05-599004ff8c26404f8494819d420b766c.jpg"
      ],
      "image": "assets/images/83793/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HHPmatQ2CXEKAQEN-JrJQHlm7Fw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/83793-best-chicken-marinade-VAT-4x3-095dedf7849c460193b6149ed763b597.jpg"
