  "ingredients": [
    "5 cups sliced carrots",
    "3 tablespoons butter",
    "1 onion, chopped",
    "1 (10.5 ounce) can condensed cream of celery soup",
    "0.5 cup cubed processed cheese",
    "salt and pepper to taste",
    "2 cups seasoned croutons",
    "0.33333334326744 cup melted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a pot of water to a boil. Add carrots and cook until tender but still firm, about 8 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 3 tablespoons butter in a medium saucepan. Sauté onion and stir in condensed soup, cheese, salt, and pepper. Stir in cooked carrots. Transfer mixture to prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss croutons with 1/3 cup melted butter; scatter over casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
