  "ingredients": [
    "4 sweet potatoes, cut into large French fries",
    "1 tablespoon water",
    "2 tablespoons olive oil",
    "2 teaspoons Italian seasoning",
    "0.5 teaspoon lemon pepper",
    "1 pinch salt and pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sweet potatoes and water into a microwave-safe dish. Cook in the microwave on full power for 5 minutes; drain. Add olive oil, Italian seasoning, lemon pepper, salt, and pepper; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange fries on a baking sheet in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, turning once, until fries are crispy on the outside, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
