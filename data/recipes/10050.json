  "ingredients": [
    "1 cup butter",
    "1 cup packed brown sugar",
    "0.75 cup white sugar",
    "2 eggs",
    "1 tablespoon vanilla extract",
    "2.5 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1 teaspoon ground white pepper",
    "3 cups semisweet chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter or margarine and sugars. Add already beaten eggs and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix dry ingredients together and mix with creamed mixture. Add chocolate chips and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 8 to 10 minutes until done. These are not HOT HOT -- Just a little surprise, definitely a little kick, goes well with the chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
