  "ingredients": [
    "0.75 cup chopped pecans",
    "0.5 cup sweetened flaked coconut",
    "1.25 cups rolled oats",
    "1 cup brown sugar",
    "0.5 cup white sugar",
    "0.5 cup unsalted butter, melted",
    "0.5 cup crushed pineapple, well drained",
    "1 large egg",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon almond extract",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line cookie sheets with parchment paper. Spread pecans and coconut onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast in the preheated oven until coconut is very light golden brown and pecans become fragrant, 5 to 7 minutes. Remove from the oven and let cool, about 10 minutes. Leave the oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pulse oats in a blender or food processor until slightly ground.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, white sugar, and butter together in a bowl. Add pineapple, egg, vanilla extract, and almond extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, flour, baking powder, and salt together in a small bowl; mix into the wet ingredients. Stir in toasted coconut and pecans. Drop by spoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 12 to 15 minutes. Cool on the cookie sheets for 1 minute before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
