        "https://www.allrecipes.com/thmb/llAnA7jzbpEIaOGNJTkPJFGAIn0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235353-pasta-with-spinach-and-chickpeas-DDMFS-Step-05-112-a94fe8f1df4742aa9e5ef882e99e4f7d.jpg"
