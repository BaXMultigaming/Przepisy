  "ingredients": [
    "2 pounds baby red potatoes",
    "0.25 cup LAND O LAKES® Unsalted Butter",
    "1 cup chopped leeks, white part only",
    "0.25 cup minced fresh parsley",
    "1 teaspoon low-sodium seasoned salt",
    "Freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes in a steamer basket in a pan with water. Water shouldn't be higher than the base of the steamer. Cover. Bring to a boil; reduce heat and steam the potatoes until they are tender, 20 to 25 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add leeks; cook and stir until tender and translucent, about 7 minutes. Add parsley and seasoned salt, stirring to combine. Remove skillet from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently stir in warm potatoes; season with freshly ground black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
