  "ingredients": [
    "0.75 cup mayonnaise",
    "0.25 cup ketchup",
    "2 tablespoons sour cream",
    "1 tablespoon sweet pickle relish",
    "0.5 tablespoon minced red onion",
    "1 teaspoon Dijon mustard",
    "0.25 teaspoon garlic salt",
    "1 (11 ounce) package tortilla chips",
    "2 cups shredded Swiss cheese",
    "1 cup shredded Cheddar cheese",
    "0.5 teaspoon dried dill weed",
    "2 cups shredded cooked corned beef brisket",
    "1 cup Bavarian-style sauerkraut with caraway seeds, drained"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together mayonnaise, ketchup, sour cream, relish, red onion, Dijon mustard, and garlic salt in a small bowl until well blended. Set sauce aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer 1/2 of the tortilla chips in an even layer on a baking sheet. Top with 1 cup Swiss cheese, 1/2 cup Cheddar cheese, and 1/4 teaspoon dill. Repeat layers with remaining chips, cheeses, and dill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheeses are melted, about 5 minutes. Remove from the oven. Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top nachos evenly with corned beef and sauerkraut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook under the preheated broiler until heated through, 1 to 2 minutes. Top nachos with sauce to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
