  "ingredients": [
    "2 tablespoons butter",
    "1 yellow onion, chopped",
    "4 zucchinis, grated",
    "2 cloves garlic, crushed",
    "2.5 cups vegetable broth",
    "1.5 cups water",
    "0.25 cup heavy whipping cream",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium heat. Cook and stir onion in hot butter until tender, about 5 minutes. Add zucchini and garlic; continue to cook and stir another 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour vegetable broth and water into the skillet; bring to a boil, reduce heat to low, and cook mixture at a simmer for 10 minutes. Stir cream into the broth mixture; season with pepper. Cook until heated through, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
