  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup crumbled feta cheese",
    "1 carrot, shredded",
    "2 tablespoons garlic powder",
    "1 egg yolk",
    "0.5 teaspoon chopped fresh basil, or to taste",
    "0.5 teaspoon chopped fresh parsley, or to taste",
    "1 (12 ounce) package wonton wrappers",
    "0.66666668653488 cup soy sauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese, feta cheese, carrot, garlic powder, egg yolk, basil, and parsley together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a wonton wrapper on a work surface and wet the corners of the wrapper with a moist finger. Spoon 1 teaspoon of filling in the center of the wrapper; fold wrapper over the filling, sealing the edges shut. Repeat with remaining wrappers and filling. Place wontons on a baking sheet and brush with soy sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until corners of wontons are brown, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
