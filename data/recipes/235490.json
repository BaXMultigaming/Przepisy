  "ingredients": [
    "2 tablespoons olive oil",
    "0.5 cup diced shallots or onion",
    "0.25 teaspoon dried red pepper flakes",
    "1 (15 ounce) can Contadina® Tomato Sauce",
    "1 (14.5 ounce) can Contadina® Diced Tomatoes, undrained",
    "1 (15 ounce) can cannellini beans, rinsed and drained",
    "1 (14.5 ounce) can reduced sodium chicken broth",
    "0.25 teaspoon ground black pepper",
    "1 teaspoon Chopped fresh basil"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large saucepan over medium heat. Cook shallots and red pepper flakes until softened, 2 to 3 minutes, stirring frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in remaining ingredients, except basil. Puree in saucepan with a hand-held immersion blender or puree in batches in a blender or food processor. Return to saucepan and heat through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with fresh basil before serving, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
