  "ingredients": [
    "2 cups canned pumpkin",
    "3 large eggs",
    "0.5 cup olive oil",
    "0.25 cup maple syrup",
    "1 cup whole wheat flour",
    "1 cup rolled oats",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 cup frozen spinach, thawed and drained"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two 12-cup muffin tins with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin purée, eggs, oil, and maple syrup in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, oats, baking powder, baking soda, ground cinnamon, and ground nutmeg together in a bowl until evenly blended; stir into pumpkin mixture. Stir in spinach until evenly dispersed throughout batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter among the prepared muffin cups, filling each ⅔ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 20 minutes. Cool in the tins for 10 minutes, then transfer muffins to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
