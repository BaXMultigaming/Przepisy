  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 large green bell pepper",
    "12 jalapeno peppers",
    "1.5 cups apple cider vinegar",
    "1 pinch salt",
    "4.25 cups granulated sugar",
    "4 ounces liquid pectin",
    "4 jalapeno peppers, seeded and finely chopped"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/05szvHbOOPUcTmUkIELOrLlF4r0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47520-jalapeno-jelly-VAT-step-01-e8fa583d5736427e828160c331fa1ec2.jpg"
      ],
      "image": "assets/images/47520/step_01.webp"
    },
    {
      "text": "Combine green bell pepper and 12 whole jalapeño peppers in a food processor or blender, working in batches if necessary; process until finely chopped.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e-pvkdA3eq7z5_HN6-rKpYg03CA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47520-jalapeno-jelly-VAT-step-02-daa234d22729403ba5fac0662a44bf97.jpg"
      ],
      "image": "assets/images/47520/step_02.webp"
    },
    {
      "text": "Transfer peppers to a large saucepan. Stir in cider vinegar and bring to a boil. Reduce heat and simmer for 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4Zb0fuGZYubbrCcls2gPbyg1CgU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47520-jalapeno-jelly-VAT-step-03-6f65683fad424176bf497424af35c7e1.jpg"
      ],
      "image": "assets/images/47520/step_03.webp"
    },
    {
      "text": "Strain mixture through at least 2 layers of cheesecloth, and discard pulp. You should have about 1 cup of liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2mwtp2aLe0EEVmo_X9xHC7bJ_hg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47520-jalapeno-jelly-VAT-step-04-9754af4c1cb549df885a3dc5f008d7fe.jpg"
      ],
      "image": "assets/images/47520/step_04.webp"
    },
    {
      "text": "Return liquid to the saucepan; stir in salt and sugar until dissolved. Bring to a boil over medium-high heat. When the mixture comes to a rolling boil (one that cannot be stirred down), boil for one minute, then stir in liquid pectin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cn-CWp5Lf2pQ8MBVIq2lPYwIU-A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47520-jalapeno-jelly-VAT-step-05-c4bda9abe6a94be1ab0668ae535d2170.jpg"
      ],
      "image": "assets/images/47520/step_05.webp"
    },
    {
      "text": "Stir in remaining finely chopped jalapeño peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Za3pz2OYLGTYAHsMu1KeZSYL0rw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47520-jalapeno-jelly-VAT-step-06-72d11d28c63846a29726b4fcd6a685b4.jpg"
      ],
      "image": "assets/images/47520/step_06.webp"
    },
    {
      "text": "Ladle into sterile jars leaving 1/4-inch headspace.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lVq345TcTyjrthbomWP6APrRSYY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47520-jalapeno-jelly-VAT-step-07-10ff4443e3f544ada0d4b3ae69345497.jpg"
      ],
      "image": "assets/images/47520/step_07.webp"
    },
    {
      "text": "Place a rack in the bottom of a large saucepan and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 10 minutes. Seal jars in a hot water bath.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XW774wmArdSn-DGkJcDproq3hVc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47520-jalapeno-jelly-VAT-step-08-ada109f80c914b639dbc55777c692c7f.jpg"
      ],
      "image": "assets/images/47520/step_08.webp"
    },
    {
      "text": "Store in a cool place. Refrigerate jelly after the seal is broken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RN021rAHg1gSHNvCcBhkOPpjLL8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/47520-jalapeno-jelly-VAT-step-09-13d69a36b0c74e30a7beb629473a7ebc.jpg"
      ],
      "image": "assets/images/47520/step_09.webp"
    }
  ],
