      ],
      "image": "assets/images/264017/step_02.webp"
    },
    {
      "text": "Drain and discard grease. Add cumin and chili powder; cook 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BIAOb_fqDIqmlKOkLsWRDcg1RmQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-264017-CreamyKetoTacoSoupwithGroundBeef-ddmfs-Step4-3x4-5735-015f9c3b0c9843dd85877ba479fa4d05.jpg"
