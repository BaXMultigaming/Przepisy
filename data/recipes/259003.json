  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup almond flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "3 cups peeled, cored, and diced pears",
    "0.5 cup pecan pieces",
    "1 cup white sugar",
    "0.75 cup milk",
    "0.25 cup brown sugar",
    "0.25 cup butter, melted",
    "1 egg",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line with paper cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, almond flour, baking soda, cinnamon, and salt in a large bowl. Fold pears and pecans gently into flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix white sugar, milk, brown sugar, butter, egg, and vanilla extract together in a second bowl. Fold sugar mixture into the flour mixture until batter is blended. Spoon batter into the prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
