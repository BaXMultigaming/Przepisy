  "ingredients": [
    "10 cups chicken broth",
    "1 onion, chopped",
    "1 cup sliced celery",
    "1 cup sliced carrots",
    "0.25 cup snipped parsley",
    "0.5 teaspoon cracked black pepper",
    "0.5 teaspoon dried thyme leaves",
    "1 bay leaf",
    "0.75 pound chicken, cut into cubes",
    "2 cups cooked rice",
    "2 tablespoons lime juice",
    "lime for garnish"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rhpafGRDZUIPBWP6Ngk9i5HU61k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231291-hearty-chicken-and-rice-soup-DDMFS-122-4x3-step-01-63bb38f5b8da4dbc8194ab61d0b5dc5d.jpg"
      ],
      "image": "assets/images/231291/step_01.webp"
    },
    {
      "text": "Combine chicken broth, onion, celery, carrots, parsley, pepper, thyme, and bay leaf in a Dutch oven; bring to a boil. Reduce heat to low; simmer until the onion and celery begin to soften, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XMF_Xx18j1rtzbDLV3u28vLn-qY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231291-hearty-chicken-and-rice-soup-DDMFS-123-4x3-step-02-4e0208589ca34baba7b4e36662b2ffad.jpg"
      ],
      "image": "assets/images/231291/step_02.webp"
    },
    {
      "text": "Stir in chicken; simmer until chicken is no longer pink in the middle, 5 to 10 minutes. Remove and discard bay leaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hKv1Xp1SogqXkAPexIpO1aOoMHM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231291-hearty-chicken-and-rice-soup-DDMFS-125-4x3-step-03-675326c6b5e84afd9715ba4834d0ea31.jpg"
      ],
      "image": "assets/images/231291/step_03.webp"
    },
    {
      "text": "Stir in rice and lime juice; cook and stir until rice is heated through and grains separate, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/czG1f0ZPaG4lOUibQ7NzabX4vUE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/231291-hearty-chicken-and-rice-soup-DDMFS-127-4x3-step-04-2d03a90e921e4971b73995dcce2c6898.jpg"
