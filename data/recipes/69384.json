  "ingredients": [
    "1 cup all-purpose flour",
    "1.5 tablespoons white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup vanilla soy milk",
    "1 egg, lightly beaten",
    "2 teaspoons vegetable oil",
    "0.5 teaspoon vanilla extract",
    "0.5 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "In a medium bowl, whisk together the flour, sugar, baking powder, baking soda, and salt. In a small bowl, mix the vanilla soy milk, egg, oil, vanilla extract, and almond extract. Pour the soy milk mixture into the bowl with the flour mixture, and whisk together until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grease a skillet, and heat over medium low heat. Pour about 1/4 cup batter onto the heated skillet, and cook until bubbly. Flip with a spatula, and continue cooking about 1 minute, until golden brown. Repeat with the remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
