    "cooking spray",
    "6 beets, scrubbed",
    "2 tablespoons butter",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat an outdoor grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CEDcSA_pNXjhFurE_9tygvTSnZQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-144529-Beets-on-The-Grill-Step-1-8d5441b57743427ab9f9e753b05ed52d.jpg"
      ],
      "image": "assets/images/144529/step_01.webp"
    },
    {
      "text": "Coat one side of a large piece of aluminum foil with cooking spray. Place beets and butter on foil; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0VA7uydBVKngD-x3rlLow23J0Ao=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-144529-Beets-on-The-Grill-Step-2-ef1a0a9b2f884323ba5422b9fc58260f.jpg"
      ],
      "image": "assets/images/144529/step_02.webp"
    },
    {
      "text": "Wrap foil over beets. Place packet on the grill grate. Cook until beets are very tender, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AJFdRW0Xk4onPkWDiPGRGzmNYso=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-144529-Beets-on-The-Grill-Step-3-82cfaf2e36a84e30b1bc321a58c83571.jpg"
      ],
      "image": "assets/images/144529/step_03.webp"
    },
    {
      "text": "Allow beets to cool before serving, about 5 minutes. You don't even need to peel to enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Cnm8lAYtXdLPIOjRURHDDSJnrcc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-144529-Beets-on-The-Grill-Step-4-32d860b1f35140dfb5e62b7a76f3438f.jpg"
