  "ingredients": [
    "1 (9 inch) pie crust, baked",
    "5 (2.16 ounce) bars chocolate-coated caramel-peanut nougat candy",
    "0.5 cup white sugar",
    "4 (3 ounce) packages cream cheese, softened",
    "2 eggs",
    "0.33333334326744 cup sour cream",
    "0.33333334326744 cup creamy peanut butter",
    "3 tablespoons heavy whipping cream",
    "0.66666668653488 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Cut candy bars in half lengthwise, then into 1/4 inch pieces. Place candy pieces over bottom of pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, combine sugar and cream cheese; beat until smooth. Add eggs one at a time, beating well after each addition. Add sour cream and peanut butter; beat until mixture is smooth. Pour filling over candy pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C) for 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small saucepan, heat whipping cream until very warm. Remove from heat, and stir in chocolate chips until smooth. Spread over top of pie. Refrigerate 2 to 3 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
