  "ingredients": [
    "3 (15 ounce) cans tomato sauce",
    "1 pound kielbasa",
    "2 tablespoons chili sauce",
    "0.5 teaspoon onion salt",
    "1 tablespoon white sugar",
    "1 teaspoon ground black pepper",
    "1 pinch paprika",
    "Curry powder to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to Broil/Grill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour tomato sauce into a large saucepan, then stir in the chili sauce, onion salt, sugar and pepper. Let simmer over medium heat, occasionally stirring; bring to a gentle boil and reduce heat to low. Simmer another 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, broil/grill kielbasa sausage for 3 to 4 minutes each side, or until cooked through. Slice into pieces 1/4 inch to 1/2 inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour tomato sauce mixture over sausage, then sprinkle all with paprika and curry powder and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
