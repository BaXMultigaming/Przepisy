  "ingredients": [
    "1 (18.25 ounce) package lemon cake mix",
    "4 eggs",
    "0.5 cup vegetable oil",
    "1 (3 ounce) package instant lemon pudding mix",
    "1 cup water",
    "0.25 cup poppy seeds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour 2 - 8x4 inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the cake mix, eggs, oil, pudding mix, water, and poppy seeds. Spread batter into two greased 8x4 inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 25 minutes or until a toothpick inserted into the cake comes out clean.",
