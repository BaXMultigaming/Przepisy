  "title": "Vegan Potatoes au Gratin",
  "description": "Potatoes are baked with a vegetable broth and flour gravy, soy cheese, soy milk, and spices in this vegan potatoes au gratin recipe.",
  "authors": [
    "Krista B"
  ],
  "date_published": "2000-10-26T22:27:11-04:00",
