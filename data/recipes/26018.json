  "ingredients": [
    "3 cups all-purpose flour",
    "2 cups white sugar",
    "0.33333334326744 cup unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "2 large eggs",
    "1 cup milk",
    "1 cup water",
    "1 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "0.25 cup butter",
    "0.25 cup shortening",
    "2 cups confectioners' sugar",
    "1 pinch salt",
    "3 tablespoons milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line 36 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare the cupcakes: Mix together flour, sugar, cocoa, baking soda, and salt in a large bowl. Make a well in the center and pour in eggs, milk, water, oil, and vanilla. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dc8lrpaFOeiXSXsqbv4cQ472J5U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26018-cream-filled-cupcakes-ddmfs-step2-e980556355444fffa3852e0ce814e07e.jpg"
      ],
      "image": "assets/images/26018/step_02.webp"
    },
    {
      "text": "Fill each muffin cup halfway with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w9rx74QBFpc8LckAJGKX2Hk9Cfs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26018-cream-filled-cupcakes-ddmfs-step3-a1729746619a46e49fde08abc9bcea98.jpg"
      ],
      "image": "assets/images/26018/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, 15 to 20 minutes. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GvpO_EyQEaTaACsin40knMdrrVA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26018-cream-filled-cupcakes-ddmfs-step4-4460cd5414c54cadbd977e081f5742bd.jpg"
      ],
      "image": "assets/images/26018/step_04.webp"
    },
    {
      "text": "Make filling: Beat butter and shortening together in a large bowl until smooth. Blend in confectioners' sugar and salt. Gradually beat in milk and vanilla. Beat until light and fluffy. Place filling into a pastry bag with a small tip.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LamHwd1XyNf09BgOseW4xcpJOvg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26018-cream-filled-cupcakes-ddmfs-step6-091cfcbea9d64fd8805ff754617f4cc4.jpg"
      ],
      "image": "assets/images/26018/step_05.webp"
    },
    {
      "text": "Once cupcakes have cooled, push tip through bottom of paper liner to fill each cupcake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yr-jkZ4IFXqXH1Iudshfw59ohEU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26018-cream-filled-cupcakes-ddmfs-4x3-6715bef4a6874cc88e6bcbb11dc60250.jpg"
      ],
      "image": "assets/images/26018/step_06.webp"
    }
