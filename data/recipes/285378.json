  "ingredients": [
    "1 cup whole cashews",
    "1 cup chopped dried pineapple",
    "1 cup chopped dried mango",
    "1 cup pretzel sticks, broken in half",
    "0.5 cup macadamia nuts",
    "0.5 cup coconut flakes",
    "0.25 cup sweetened dried cranberries (such as Ocean Spray® Craisins®)",
    "1 tablespoon honey",
    "1 tablespoon butter",
    "0.25 teaspoon flaky sea salt (such as Maldon®)"
  ],
  "steps": [
    {
      "text": "Combine cashews, pineapple, mango, pretzels, macadamia nuts, coconut flakes, and cranberries in a large bowl; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add honey and butter to a small saucepan over medium heat. Cook and stir until butter is melted, about 1 minute. You also could do this in the microwave.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle honey-butter over snack mix and sprinkle salt over the top. Stir well to make sure everything is well coated.",
