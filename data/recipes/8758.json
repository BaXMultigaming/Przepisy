    "Italian Inspired",
    "American"
  ],
  "regions": [
    "Italian Inspired",
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "9 lasagna noodles",
    "0.5 cup butter",
    "1 onion, chopped",
    "1 clove garlic, minced",
    "0.5 cup all-purpose flour",
    "2 cups chicken broth",
    "1.5 cups milk",
    "1 teaspoon salt",
    "4 cups shredded mozzarella cheese, divided",
    "1 cup grated Parmesan cheese, divided",
    "1 teaspoon dried basil",
    "1 teaspoon dried oregano",
    "0.5 teaspoon ground black pepper",
    "2 cups ricotta cheese",
    "2 cups cubed, cooked chicken meat",
    "2 (10 ounce) packages frozen chopped spinach, thawed and drained",
    "1 tablespoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1X0L-D-TW-ecz79h7eqApepGDp0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8758-White-Cheese-Chicken-Lasagna-DDMFS-Step-1-0054-9294dd7bf489446ea910c31abd5bf42d.jpg"
      ],
      "image": "assets/images/8758/step_01.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add lasagna noodles and cook for 8 to 10 minutes or until al dente; drain and rinse with cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q3fEAoPHV_MYH2LsPudfYCnhCxc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8758-White-Cheese-Chicken-Lasagna-DDMFS-Step-2-0056-5d21ff655bd14161b9a0d3c53acdc11b.jpg"
      ],
      "image": "assets/images/8758/step_02.webp"
    },
    {
      "text": "Meanwhile, melt butter in a large saucepan over medium heat; stir in onion and garlic. Whisk in flour until lightly browned and onion is tender, about 2 minutes. Add chicken broth, milk, and salt; cook, whisking continuously, for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BT80JHHwCGW6mBCUStX9GI4aM70=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8758-White-Cheese-Chicken-Lasagna-DDMFS-Step-3-0059-ec9080e1fc114328ad1777c8db0938c0.jpg"
      ],
      "image": "assets/images/8758/step_03.webp"
    },
    {
      "text": "Stir in 2 cups mozzarella and 1/4 cup Parmesan until well combined. Season with basil, oregano, and black pepper; remove from heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FMcJ51ATQpmiW6bCofh4b38Jaig=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8758-White-Cheese-Chicken-Lasagna-DDMFS-Step-4-0062-9dea8bca15e44c3aa87000e8c0f8dfb0.jpg"
      ],
      "image": "assets/images/8758/step_04.webp"
    },
    {
      "text": "Spread 1/3 of the sauce mixture in the bottom of a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OgN0_03r1iYzvxSudykhOMJ19rI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8758-White-Cheese-Chicken-Lasagna-DDMFS-Step-5-0072-96fe5ba7c09049c8af1b022b1449a166.jpg"
      ],
      "image": "assets/images/8758/step_05.webp"
    },
    {
      "text": "Layer with 3 lasagna noodles, ricotta, and chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/neNJb8cNZp9hcamspvcm4lm2Teg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8758-White-Cheese-Chicken-Lasagna-DDMFS-Step-7-0075-423d75d34e8445d8af35cec9ff9013f9.jpg"
      ],
      "image": "assets/images/8758/step_06.webp"
    },
    {
      "text": "Arrange 3 lasagna noodles over the chicken and layer with 1/3 of the sauce mixture, spinach, remaining 2 cups mozzarella, and 1/2 cup Parmesan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AGzb-eKWDuc-iiHcG3feFGeGw_o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8758-White-Cheese-Chicken-Lasagna-DDMFS-Step-7-0077-97a499262e19447daf91f4cfd37eac78.jpg"
      ],
      "image": "assets/images/8758/step_07.webp"
    },
    {
      "text": "Arrange remaining noodles over cheese and spread remaining sauce evenly over noodles. Sprinkle with parsley and remaining 1/4 cup Parmesan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nuGoapGJbuDDpoti3iQOUCTIolI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8758-White-Cheese-Chicken-Lasagna-DDMFS-Step-8-0080-690a8b325171466491ce0a02b35b28a4.jpg"
      ],
      "image": "assets/images/8758/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven for 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GJFER0718AjJ1ylylzJkTb_yYSA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8758-White-Cheese-Chicken-Lasagna-DDMFS-Step-9-0104-a95a07d9f59c4d1b818aed6bdd98ecec.jpg"
      ],
      "image": "assets/images/8758/step_09.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aR092XCzdl_7RBgEKEp-7Wy71kI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8758-White-Cheese-Chicken-Lasagna-DDMFS-3x4-0177-2147ea1ce51c42228efdcb907819b5c2.jpg"
      ],
      "image": "assets/images/8758/step_10.webp"
    }
