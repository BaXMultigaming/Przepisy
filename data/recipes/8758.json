  "title": "White Cheese Chicken Lasagna",
  "description": "This cheesy chicken lasagna with spinach uses a creamy white sauce that's made with three kinds of cheese: mozzarella, Parmesan, and ricotta.",
  "authors": [
    "Lisa Humpf"
  ],
  "date_published": "1999-06-29T00:07:37-04:00",
  "date_modified": "2026-01-20T16:57:19-05:00",
  "prep_time": "PT25M",
  "cook_time": "PT50M",
  "total_time": "PT75M",
  "yield": [
    "12",
    "1 9x13-inch lasagna"
  ],
  "categories": [
    "Dinner"
  ],
