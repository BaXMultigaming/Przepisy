  "ingredients": [
    "3 tablespoons margarine",
    "2 cups white sugar",
    "3 egg yolks",
    "3 cups all-purpose flour",
    "1 tablespoon baking powder",
    "1 cup milk",
    "3 egg whites",
    "6 bananas",
    "2 tablespoons white sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together margarine and sugar until smooth. Mix in yolks. Stir in flour and baking powder alternately with the milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, beat egg whites until doubled in volume. Fold beaten whites into the dough. Spread into a greased 9 x 12 inch pan. Slice bananas over the top of the dough. In a small bowl, mix together the 2 tablespoons sugar and the cinnamon; sprinkle over bananas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 30 to 35 minutes, or until a toothpick inserted into the center comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
