  "title": "Brazilian Banana Bread",
  "description": "This Brazilian variation is baked in a cake pan, is sweeter than some, and has cinnamon sugar sprinkled on top.",
  "authors": [
    "Fernanda Esteves"
  ],
  "date_published": "1998-06-03T18:12:57-04:00",
