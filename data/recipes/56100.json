  "ingredients": [
    "2 egg whites",
    "0.125 teaspoon cream of tartar",
    "0.125 teaspoon salt",
    "0.75 teaspoon vanilla extract",
    "0.25 teaspoon peppermint extract",
    "0.25 teaspoon green food coloring",
    "0.66666668653488 cup white sugar",
    "30 milk chocolate candy kisses (such as Hershey's Kisses®)"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 375 degrees F (190 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine egg whites, cream of tartar, salt, vanilla extract, peppermint extract, and green food coloring in a large bowl. Use an electric mixer to beat until soft peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar into egg whites one tablespoon at a time. Continue to beat until stiff peaks form, and mixture is glossy and very smooth, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop the meringue by half teaspoons onto prepared cookie sheet; top with chocolate kisses. Spoon a scant teaspoon of meringue over chocolate, and smooth to cover completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cookies in the preheated oven; turn oven off. Leave meringues in oven overnight, or until oven has cooled completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
