  "ingredients": [
    "7 fluid ounces warm water (110 degrees F/45 degrees C)",
    "2 tablespoons lard",
    "1 (.25 ounce) package active dry yeast",
    "2.75 cups bread flour",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Ignore the bread machine directions. Place warm water and lard into the bread machine pan. Sprinkle in the yeast. Pour in flour and salt. Toss in cinnamon if desired. Select cycle; press Start.",
