  "ingredients": [
    "1 teaspoon instant coffee granules",
    "0.5 teaspoon ground cinnamon",
    "1 pinch salt",
    "1 teaspoon vanilla extract",
    "0.5 cup butter, softened",
    "3 cups confectioners' sugar",
    "0.33300000429153 cup milk"
  ],
  "steps": [
    {
      "text": "In a small bowl, mash instant coffee with the back of a spoon until powdery. Stir in cinnamon and salt. In a large bowl, beat the butter until smooth, then stir in spice mixture and vanilla. Alternately beat in confectioners' sugar and milk until desired consistency is achieved.",
