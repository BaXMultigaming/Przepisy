  "title": "Cream of Turkey Soup",
  "description": "This hearty cream of turkey soup simmers leftover Thanksgiving turkey with veggies and noodles in a rich, creamy broth for a comforting meal.",
  "authors": [
    "Paul"
  ],
  "date_published": "2019-04-02T03:01:18-04:00",
