  "ingredients": [
    "1 turkey carcass",
    "1 cup butter, cubed",
    "1 large onion, chopped",
    "2 stalks celery, diced",
    "2 large carrots, diced",
    "1 cup all-purpose flour",
    "2 cups half-and-half",
    "4 ounces fettuccine, broken into 2-inch pieces",
    "0.25 cup prepared stuffing, or more to taste",
    "2 teaspoons salt",
    "1 teaspoon chicken bouillon granules",
    "0.75 teaspoon ground black pepper",
    "1 pinch poultry seasoning, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qAbHsTWDTl0obUqIu7UEbpJeeIY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233288-cream-of-turkey-soup-VAT-step-01-1a8f2cec79d348e789ea94ec63b9a28b.jpg"
      ],
      "image": "assets/images/233288/step_01.webp"
    },
    {
      "text": "Place turkey carcass in a large pot or Dutch oven and cover with water. Bring to a boil. Reduce heat to medium, cover, and simmer for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z8QuQUDIyNuUzTc0nMwzczYCh4E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233288-cream-of-turkey-soup-VAT-step-02-f87183babbe04b77ba0ad9bb505cb080.jpg"
      ],
      "image": "assets/images/233288/step_02.webp"
    },
    {
      "text": "Remove carcass and allow to cool. Separate turkey meat from bones. Cut meat into bite-sized pieces; discard bones. Reserve 12 cups turkey broth in a large bowl. Save remaining broth for another use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/esaF0bvrG8M8CyZ3SlYHiwCosTM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233288-cream-of-turkey-soup-VAT-step-03-3e14ddb3717d4def9df14f88cfebd941.jpg"
      ],
      "image": "assets/images/233288/step_03.webp"
    },
    {
      "text": "Melt butter in the same large pot over medium heat; cook and stir onion, celery, and carrots in hot butter until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Lf7VMdQtcdPbbNbvTX-c9_cmlIU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233288-cream-of-turkey-soup-VAT-step-04-301049c77fb04dd4af89060f92ad57a7.jpg"
      ],
      "image": "assets/images/233288/step_04.webp"
    },
    {
      "text": "Sprinkle with flour; cook and stir until smooth, about 5 minutes. Gradually stir in 4 cups reserved turkey broth. Bring to a boil; cook and stir until thickened, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hGW29Bm4pU68U6tirf2XV3EwxnQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233288-cream-of-turkey-soup-VAT-step-05-a26899fbf67a4a3a99ef64d73e022713.jpg"
      ],
      "image": "assets/images/233288/step_05.webp"
    },
    {
      "text": "Stir in remaining 8 cups turkey broth, turkey meat, half-and-half, noodles, stuffing, salt, bouillon, pepper, and poultry seasoning. Reduce heat to medium-low, cover, and simmer until noodles are tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Tvtmh1VANMgf85-UXdtjiHTlCMc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233288-cream-of-turkey-soup-VAT-step-06-c8ab12b617814ec1ad6d0424feeef658.jpg"
      ],
      "image": "assets/images/233288/step_06.webp"
    }
  ],
