  "ingredients": [
    "1 pound lean ground beef",
    "2.5 cups chopped tomatoes",
    "1.3329999446869 (6 ounce) cans tomato paste",
    "1 (4.5 ounce) can sliced mushrooms",
    "2 tablespoons dried minced onion",
    "1 teaspoon salt",
    "1 teaspoon dried oregano",
    "0.75 teaspoon white sugar",
    "0.25 teaspoon ground black pepper",
    "0.125 teaspoon garlic powder",
    "12 ounces spaghetti"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kRPB5b8ceLSaWLkoAhJsLUs3cbY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Easyspaghettiwithtomatosauce_11715_DDMFS_Ingredient_Step1_2312-8f6c5645fa6e46f5a5cf2558f1e35afb.jpg"
      ],
      "image": "assets/images/11715/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nVfezvKU6CJayUv0nc96K5mrj7Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Easyspaghettiwithtomatosauce_11715_DDMFS_Step2_2322-d76e1986b1a14ee9804f7ede86f89089.jpg"
      ],
      "image": "assets/images/11715/step_02.webp"
    },
    {
      "text": "Transfer beef into a large pot over low heat; stir in tomatoes, tomato paste, mushrooms, onion, salt, oregano, sugar, pepper, and garlic powder. Cover and simmer, stirring occasionally, for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kn6HoLdUbEO6uiIGqmgGo3zBW2o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Easyspaghettiwithtomatosauce_11715_DDMFS_Step4_2402-19baf37ce34f41da82558f714696eba5.jpg"
      ],
      "image": "assets/images/11715/step_03.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes; drain. Serve meat sauce over spaghetti.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZhDrBmciWzegNpBWB-5LXEvULao=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Easyspaghettiwithtomatosauce_11715_DDMFS_4x3_2424-8d7bf30b2622465f9dd78a2c6277eeb8.jpg"
      ],
      "image": "assets/images/11715/step_04.webp"
    }
