  "ingredients": [
    "3 cups cooked rice",
    "0.5 cup raisins",
    "2.5 cups milk",
    "0.5 cup honey",
    "2 tablespoons butter",
    "1 teaspoon grated lemon rind",
    "1 tablespoon lemon juice",
    "0.125 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Combine rice, raisins, milk, honey, and butter in a saucepan. Bring mixture to a boil, reduce heat, and let it simmer for 15 minutes; occasionally stirring. Stir in lemon rind and juice.",
