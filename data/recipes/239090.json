  "ingredients": [
    "2 (10 ounce) packages frozen sliced peaches(such as Cascadian Farm®), thawed and drained",
    "1 (10 ounce) package frozen blueberries(such as Cascadian Farm®), thawed and drained",
    "2 teaspoons lemon juice",
    "2 tablespoons all-purpose flour",
    "2 tablespoons white sugar",
    "0.5 cup old-fashioned oats",
    "0.33333334326744 cup firmly packed brown sugar",
    "0.25 cup all-purpose flour",
    "0.25 cup chopped almonds",
    "0.5 teaspoon ground cinnamon",
    "0.125 teaspoon nutmeg",
    "0.25 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare fruit: Gently stir together peaches, blueberries, and lemon juice in an 8-inch square baking dish. Stir in flour and sugar until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make topping: Stir together oats, brown sugar, flour, almonds, cinnamon, and nutmeg in a medium bowl. Mash in butter with a pastry cutter or a fork until mixture is crumbly; sprinkle over fruit in the baking dish to cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fruit is bubbling and topping is golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
