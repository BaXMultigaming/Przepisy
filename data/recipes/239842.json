  "ingredients": [
    "4 potatoes, cut into cubes",
    "4 cups chicken broth",
    "1 (14 ounce) can whole kernel corn, drained",
    "1 onion, chopped",
    "0.25 cup flour",
    "1 cup heavy whipping cream",
    "0.5 pound sea scallops",
    "0.5 pound peeled, deveined, and cooked shrimp",
    "0.25 cup dry potato flakes",
    "0.25 teaspoon garlic pepper",
    "1 pinch salt, to taste"
  ],
  "steps": [
    {
      "text": "Stir together potatoes, broth, corn, onion, and flour in a 3 1/2-quart slow cooker crock until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until potatoes are tender, about 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream, scallops, shrimp, potato flakes, and garlic pepper into the crock.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High until chowder is slightly thickened, 35 to 45 minutes. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
