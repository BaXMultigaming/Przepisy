  "ingredients": [
    "1 pound sweet apples -- peeled, cored and thinly sliced",
    "0.25 cup golden raisins",
    "0.25 cup dried currants",
    "0.5 teaspoon ground cinnamon",
    "2 tablespoons white sugar",
    "2 slices brown bread, crumbled",
    "0.5 (16 ounce) package phyllo dough",
    "0.25 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, combine apples, raisins, currants, cinnamon, sugar and bread crumbs. Stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread several sheets of pastry generously with melted butter and lay them on atop the other on a baking sheet. Spread the fruit mixture evenly over the top sheet, then roll the sheets up to form a log shape. Brush with melted butter again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven 30 minutes, until pastry is golden brown and fruit is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
