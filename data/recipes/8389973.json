  "ingredients": [
    "1 pound ground lamb",
    "4 teaspoons minced garlic",
    "1 tablespoon finely chopped fresh mint",
    "1 tablespoon finely chopped fresh dill",
    "0.75 teaspoon salt",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon smoked paprika",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon cayenne pepper",
    "1 (4 ounce) goat cheese log",
    "4 (2 ounce) brioche buns, split and toasted",
    "2 cups loosely packed arugula",
    "0.25 cup prepared garlic aioli",
    "0.25 cup pickled red onions, or to taste"
  ],
  "steps": [
    {
      "text": "Stir together ground lamb, garlic, mint, dill, salt, cumin, smoked paprika, cinnamon, and cayenne in a large bowl until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape lamb mixture into four 3-inch patties. Slice goat cheese log into 4 equal pieces. Place one goat cheese piece in the center of each patty and carefully wrap edges around cheese to enclose. Gently flatten each into a 4 inch patty.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill to high heat (450°F to 650°F) or a stovetop griddle to medium-high heat. Oil grate or griddle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill patties until an instant-read thermometer inserted into centers registers 160 degrees F (71 degrees C) and goat cheese melts, 4 to 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve burgers on buns with arugula, aioli, and pickled red onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
