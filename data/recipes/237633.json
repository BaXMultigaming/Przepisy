  "ingredients": [
    "0.75 cup butter, softened",
    "0.75 cup brown sugar",
    "0.75 cup white sugar",
    "0.5 cup cookie butter",
    "0.5 cup peanut butter",
    "2 cups all-purpose flour",
    "1 egg",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.33333334326744 cup white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and 3/4 cup white sugar with an electric mixer in a large bowl until smooth. Add cookie butter and peanut butter; beat until fluffy. Mix flour, egg, baking soda, baking powder, and salt into butter mixture until dough comes together. Roll dough into teaspoon-size balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1/3 cup sugar into a shallow dish. Roll dough balls in sugar to coat and arrange onto the prepared baking sheet. Press the top of dough balls twice with a fork in a crosshatch shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
