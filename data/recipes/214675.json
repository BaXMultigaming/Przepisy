  "ingredients": [
    "3 cloves garlic, minced",
    "2 chipotle peppers in adobo sauce, chopped",
    "1 lemon, juiced",
    "1 tablespoon olive oil",
    "1 tablespoon paprika",
    "1 teaspoon chopped fresh cilantro",
    "1 teaspoon kosher salt",
    "0.5 teaspoon cracked black pepper",
    "0.5 teaspoon crushed red pepper flakes",
    "0.25 teaspoon cayenne pepper",
    "2 pounds uncooked medium shrimp, peeled and deveined",
    "wooden or metal skewers"
  ],
  "steps": [
    {
      "text": "Mix together the garlic, chipotle peppers, lemon juice, olive oil, paprika, cilantro, kosher salt, black pepper, red pepper flakes, and cayenne pepper in a bowl. Stir in the shrimp, and mix well to thoroughly coat. Marinate for 30 minutes in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat, and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the shrimp from the marinade, and discard excess marinade. Thread about 5 shrimp per skewer, and grill on the preheated grill until the shrimp turn pink and opaque in the center, about 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
