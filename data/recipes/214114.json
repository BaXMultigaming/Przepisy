  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup butter, softened",
    "1 tablespoon white sugar",
    "1 cup white sugar",
    "4 cups finely chopped rhubarb",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup white sugar",
    "1 egg",
    "0.5 cup sour cream",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Grease an 11x7-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together 1 cup flour, butter, and 1 tablespoon sugar in a large bowl until well combined; press into the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 10 minutes. Remove crust from the oven and set aside. Reduce oven temperature to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup sugar and remaining 1/4 cup flour in the same large bowl; stir in rhubarb and toss to coat. Spread rhubarb mixture over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash together cream cheese, 1/2 cup sugar, and egg in the same large bowl until creamy and well combined; spread over rhubarb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven until rhubarb is bubbling and topping is set, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix together sour cream and 1 tablespoon sugar in the same large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread sour cream mixture over hot dessert. Allow to cool completely before cutting into bars. Refrigerate leftovers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
