  "ingredients": [
    "1 cup butter, softened",
    "1 cup white sugar",
    "1 cup packed light brown sugar",
    "1 cup heavy cream",
    "2 eggs",
    "2 tablespoons all-purpose flour",
    "1 tablespoon vanilla extract",
    "2 unbaked pie shells",
    "1 cup heavy cream",
    "3 tablespoons white sugar",
    "2 tablespoons bourbon whiskey"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix white sugar, brown sugar, and flour in a large bowl. Add softened butter, 1 cup heavy cream, eggs, and vanilla; mix until well-blended. Pour into 2 unbaked pie shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes, then reduce temperature to 350 degrees F (175 degrees C) and continue baking until center is set, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip 1 cup heavy cream in a mixing bowl and add sugar gradually until stiff peaks form. Gently fold in bourbon. Serve pie slices with dollops of whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
