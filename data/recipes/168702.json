  "ingredients": [
    "2 pounds watermelon, seeded and cubed",
    "0.5 cup white sugar",
    "1 cup champagne",
    "4 slices watermelon"
  ],
  "steps": [
    {
      "text": "Place cubed watermelon and sugar in a blender; blend for 1 minute. Stir in Champagne. Pour watermelon mixture into a container; cover, and freeze. Stir mixture with a fork every 30 minutes until frozen, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove granita from the freezer; stir well using a fork. Or place granita in the bowl of a food processor; pulse until it reaches desired consistency. Serve in tall glasses garnished with sliced watermelon.",
      "section": null,
      "name": null,
      "url": null,
