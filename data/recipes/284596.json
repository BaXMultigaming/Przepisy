  "ingredients": [
    "1 pound ground pork",
    "0.25 cup dry red wine",
    "2 cloves garlic, minced",
    "1 teaspoon salt",
    "1 teaspoon dried parsley",
    "0.75 teaspoon paprika",
    "0.5 teaspoon dried rosemary",
    "0.25 teaspoon white pepper",
    "0.25 teaspoon black pepper"
  ],
  "steps": [
    {
      "text": "Combine ground pork, red wine, garlic, salt, parsley, paprika, rosemary, white pepper, and black pepper in a bowl and mix until evenly combined; do not overmix. Let sit in the fridge at least 4 hours, preferably overnight, in order for flavors to meld.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide the meat into 4 equal portions and form into patties. Cook on the preheated grill about 4 to 5 minutes per side. An instant-read thermometer inserted into the center should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
