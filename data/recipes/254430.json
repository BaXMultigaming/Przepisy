  "ingredients": [
    "1 cup white sugar",
    "0.5 cup melted butter",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon espresso powder",
    "2 egg whites, beaten",
    "0.5 cup all-purpose flour",
    "0.5 cup unsweetened cocoa powder",
    "0.25 teaspoon baking soda",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, butter, vanilla extract, and espresso powder together in a bowl; beat in egg whites. Stir flour, cocoa powder, baking soda, and salt together in a bowl. Mix flour mixture into egg mixture until batter is combined. Spread batter as thin as a slice of American cheese onto the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until batter is nearly cooked through, about 20 minutes. Remove from the oven; cut a shallow square pattern into the batter with a sharp knife. Place back into the oven; bake until batter is crisp, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool in the pan for 5 minutes before transferring to a wire rack to cool completely; break into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
