  "ingredients": [
    "1.125 cups all-purpose flour",
    "0.75 teaspoon baking powder",
    "0.75 teaspoon salt",
    "1 cup white sugar",
    "1.5 cups unsweetened cocoa powder",
    "0.66666668653488 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "0.75 cup evaporated milk",
    "0.5 cup evaporated milk",
    "0.33333334326744 cup sweetened cocoa mix",
    "1 teaspoon butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9 inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the flour, baking powder, salt, sugar and unsweetened cocoa. Stir in the oil, vanilla, and 3/4 cup of evaporated milk until well blended. Spread the mixture evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 to 30 minutes in the preheated oven, until a toothpick inserted into the center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the frosting: In a small saucepan, combine the remaining evaporated milk, sweetened cocoa, and butter. Cook over medium heat until almost boiling, remove from heat and chill until brownies are ready. When brownies are completely cool, frost with the chilled icing and cut into bars, or frost them individually.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
