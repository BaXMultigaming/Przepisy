  "title": "Homemade Mascarpone Cheese",
  "description": "Chef John makes homemade mascarpone cheese using only two ingredients. Perfect used in desserts like cheesecake, or as a spread.",
  "authors": [
    "Chef John"
  ],
  "date_published": "2022-08-09T09:00:00-04:00",
