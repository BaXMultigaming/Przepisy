  "ingredients": [
    "2 cups heavy cream",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l8T4QuN_zNBMXVhYcauprzjGVxA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8451392-homemade-mascarpone-cheese-VAT-4x3-ingredients-2-2b16e9d0b2e54085a590f86880903dd6.jpg"
      ],
      "image": "assets/images/8451392/step_01.webp"
    },
    {
      "text": "Pour heavy cream into a heavy-bottomed saucepan. Bring cream to 185 to 190 degrees F (85 to 88 degrees C) over medium heat, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d_mylkyGdLWuvY6ZplZEqtZ0jAo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8451392-homemade-mascarpone-cheese-VAT-4x3-step-02-d68e8e9d62b14e2dafca368667b0b24a.jpg"
      ],
      "image": "assets/images/8451392/step_02.webp"
    },
    {
      "text": "Reduce heat to medium-low and stir in lemon juice. Cook, stirring, for 3 minutes, maintaining the temperature at 185 to 190 degrees F (85 to 88 degrees C), then turn off the heat. The mixture should coat the back of a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Netw4lgSNt0bF0iLTQCe2jMfR6g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8451392-homemade-mascarpone-cheese-VAT-4x3-step-03-2-992225ded6cf44aa879252697046a051.jpg"
      ],
      "image": "assets/images/8451392/step_03.webp"
    },
    {
      "text": "Whisk well and let cool for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Zf4ud51El0FxNXfAO-t8llPy6Kc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8451392-homemade-mascarpone-cheese-VAT-4x3-step-04-5f411c722cd3453d91254c042b74fc45.jpg"
      ],
      "image": "assets/images/8451392/step_04.webp"
    },
    {
      "text": "Transfer into a clean towel-lined strainer. Cover top with plastic wrap, pressing down gently onto the surface of the cream, and let cool to room temperature, 20 to 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n_ygW0BLgNc17dfkRaa2H3DykOc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8451392-homemade-mascarpone-cheese-VAT-4x3-step-05-092b49bfffa64ede96fba0b72b53cf29.jpg"
      ],
      "image": "assets/images/8451392/step_05.webp"
    },
    {
      "text": "Chill in a refrigerator for 8 hours, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uJ99V9839F4mvgqufCOki_TaIxY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8451392-homemade-mascarpone-cheese-VAT-4x3-step-06-884756a66c024df7a9639aa614b30d45.jpg"
      ],
      "image": "assets/images/8451392/step_06.webp"
    },
    {
      "text": "Remove plastic wrap and store in a sealed container or use immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4WiC8tthUfBPAqc5uC3owjhAYyQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8451392-homemade-mascarpone-cheese-VAT-4x3-4-d8478b38c34643acbbc08a2f8f399471.jpg"
      ],
      "image": "assets/images/8451392/step_07.webp"
    }
  ],
