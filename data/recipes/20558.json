  "ingredients": [
    "1.25 cups uncooked white rice",
    "1.5 cups white sugar",
    "0.5 cup butter, melted",
    "5 cups milk",
    "2 eggs, beaten",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.75 cup raisins"
  ],
  "steps": [
    {
      "text": "In a saucepan, bring salted water to a boil. Add rice, reduce heat, cover and simmer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 1/2 cups cooked rice, sugar, melted butter, milk, eggs, cinnamon, nutmeg and raisins and mix well. Pour into a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until top is golden, 30 to 60 minutes. Serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
