  "ingredients": [
    "2 cups white sugar",
    "0.5 cup milk",
    "0.5 cup butter",
    "0.5 cup cocoa powder",
    "3 cups quick oats",
    "0.5 cup shredded coconut",
    "0.5 cup peanut butter",
    "1 teaspoon vanilla extract"
