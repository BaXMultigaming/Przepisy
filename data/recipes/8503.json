  "ingredients": [
    "6 skinless, boneless chicken breast halves",
    "2 cups teriyaki sauce, divided",
    "6 pineapple rings",
    "0.5 cup butter, melted",
    "0.75 cup packed brown sugar",
    "0.75 cup soy sauce",
    "0.75 cup unsweetened pineapple juice",
    "6 tablespoons Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Place the chicken breast halves in a dish with the 1 1/2 cups of teriyaki sauce. Cover and refrigerate 8 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil the grill grate. Place chicken breasts on grill, and discard marinade. Cook for 8 minutes per side, or until juices run clear. Brush with the remaining teriyaki sauce during the last 5 minutes. When almost done, place one pineapple ring on top of each breast, and brush with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, soy sauce, pineapple juice, and Worcestershire sauce in a small saucepan over medium heat. Cook, stirring occasionally, until the sugar dissolves. Serve with the grilled chicken for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
