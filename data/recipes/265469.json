  "ingredients": [
    "1.5 pounds fresh green beans, cut into 1 1/2 inch pieces",
    "1 tablespoon olive oil",
    "1 tablespoon garlic, minced",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried thyme",
    "0.25 teaspoon salt",
    "0.5 cup crumbled blue cheese"
  ],
  "steps": [
    {
      "text": "Combine beans, olive oil, garlic, oregano, thyme, and salt in a microwave-safe dish.",
