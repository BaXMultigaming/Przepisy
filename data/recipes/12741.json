  "title": "Wilma's Fish Casserole",
  "description": "Haddock filets baked in mushroom soup and stuffing seasoned with a blend of herbs.",
  "authors": [
    "Wilma Scott"
  ],
  "date_published": "1999-07-01T23:32:33-04:00",
