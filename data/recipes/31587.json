  "ingredients": [
    "1 tablespoon vegetable oil",
    "3 cloves garlic, minced",
    "0.5 large onion, chopped",
    "1 plum tomato, chopped",
    "6 potatoes, diced",
    "0.5 rutabaga, diced",
    "dried oregano, to taste",
    "salt and freshly ground black pepper to taste",
    "2 cups chicken broth"
  ],
  "steps": [
    {
      "text": "Heat the oil in a skillet over medium heat, and saute the garlic and onion until tender. Stir in the tomato, and cook until heated through. Mix in potatoes and rutabaga. Season with oregano, salt, and pepper. Pour in the broth, and bring to a boil. Reduce heat to low, and continue cooking 15 minutes, or until potatoes and rutabaga are tender.",
