  "ingredients": [
    "8 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground ginger",
    "2.25 cups brown sugar",
    "1 cup lard",
    "1 cup butter",
    "1 teaspoon white vinegar",
    "0.5 teaspoon baking soda",
    "4 cups molasses"
  ],
  "steps": [
    {
      "text": "Sift flour, cinnamon, and ginger together in a large bowl. Add sugar and mix well. Work lard and butter into the flour mixture using a pastry blender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine vinegar and baking soda in a small bowl; mix to dissolve. Add mixture to the flour mixture in the bowl. Add molasses and mix thoroughly. Place dough in the refrigerator until chilled, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough out very thin on a floured surface. Cut into shapes using fancy cookie cutters.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
