  "ingredients": [
    "1 cup cooked red beans",
    "1 cup cooked rice",
    "0.25 cup finely chopped ham",
    "2 green onions, chopped",
    "4 tablespoons panko bread crumbs",
    "3 large eggs, divided",
    "0.5 teaspoon Cajun or Creole seasoning, divided",
    "0.25 teaspoon ground black pepper",
    "0.25 cup milk",
    "1 cup all-purpose flour",
    "1 cup panko bread crumbs",
    "vegetable oil for deep frying",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Mix red beans, rice, ham, green onions, 4 tablespoons panko bread crumbs, 2 eggs, 1/4 teaspoon Cajun seasoning, and black pepper together in a bowl to form a tight mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form mixture into small, hush puppy-sized balls, pressing firmly together to hold their shape. Chill for 1 hour to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and remaining egg together in a small bowl to make an egg wash. Mix remaining bread crumbs and remaining Cajun seasoning together in a shallow dish. Roll chilled balls first in flour, coat with egg wash, and roll in bread crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 360 to 375 degrees F (182 to 190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry fritters in the hot oil until golden brown, about 10 minutes. Drain on paper towels and sprinkle with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
