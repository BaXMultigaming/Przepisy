  "ingredients": [
    "2 cups skim milk",
    "0.5 (12 fluid ounce) can evaporated milk",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "2 bananas, mashed",
    "0.5 cup golden raisins"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mix together the skim milk, evaporated milk, sugar and vanilla. Pour into an ice cream maker, and freeze according to the manufacturer's instructions.",
