  "ingredients": [
    "1 cup frozen strawberries",
    "0.75 cup pineapple juice",
    "0.75 cup milk",
    "0.5 cup vanilla yogurt",
    "2 tablespoons white sugar",
    "1 teaspoon wheat germ",
    "6 ice cubes"
  ],
  "steps": [
