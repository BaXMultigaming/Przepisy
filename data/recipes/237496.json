  "title": "Chef John's Pecan Pie",
  "description": "Chef John's recipe for pecan pie has the perfect blend of nuts and sticky toffee filling with a wonderfully crisp crust.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2014-04-28T18:15:57-04:00",
