  "ingredients": [
    "0.5 cup vegetable oil",
    "0.5 cup ketchup",
    "0.25 cup red wine",
    "2 tablespoons red wine vinegar",
    "2 cloves garlic, minced",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon dry mustard",
    "0.5 teaspoon celery salt",
    "0.5 teaspoon chili powder",
    "4 pounds chuck roast"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large, nonporous bowl, combine the oil, ketchup, wine, vinegar, garlic, salt, ground black pepper, mustard powder, celery salt and chili powder and mix well. Pierce the roast with a fork all over the meat. Place the meat in the bowl with the marinade and turn several times to coat. Cover and marinate in the refrigerator for at least 12 hours, turning occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill over medium heat for 10 to 12 minutes per side, or until internal temperature reaches at least 145 degrees F (65 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
