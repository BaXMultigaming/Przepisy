        "https://www.allrecipes.com/thmb/cfWpZLv7nsFT3kJ6AH6RoGEB6to=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/1207574-e7847ce7118d4125abfa40e22d492d70.jpg"
      ],
