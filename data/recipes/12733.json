  "ingredients": [
    "0.5 cup mayonnaise",
    "2 tablespoons all-purpose flour",
    "2 eggs, beaten",
    "0.5 cup milk",
    "1 cup crab meat",
    "1 cup diced Swiss cheese",
    "0.5 cup chopped green onions",
    "1 (9 inch) unbaked pie crust"
