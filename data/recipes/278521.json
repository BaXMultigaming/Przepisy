  "ingredients": [
    "1 cup water",
    "0.5 cup whole oats",
    "1 dash salt",
    "1 tablespoon peanut butter, or to taste",
    "1 teaspoon vanilla extract",
    "1 teaspoon white sugar",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Combine water and salt in a saucepan and bring to a boil. Stir in oats and cook, stirring, for 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop up all of the oatmeal and transfer into a small bowl. Stir in peanut butter until well combined. Use a butter knife to help mix it in if necessary. Mix in vanilla extract. Combine sugar and cinnamon and sprinkle over the top.",
      "section": null,
