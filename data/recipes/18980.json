  "ingredients": [
    "1 (16 ounce) can refrigerated flaky biscuit dough",
    "4 apples - peeled, cored and halved",
    "1 cup white sugar",
    "1 cup water",
    "0.5 cup butter, melted",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Butter a 7 x 11-inch baking pan. Separate dough into 8 pieces; flatten each into a circle. Wrap one biscuit around each apple half; place in the pan, seam-side down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, water, butter, and vanilla extract in a small bowl. Pour mixture over dumplings; sprinkle with cinnamon. Bake until golden, 35 to 40 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
