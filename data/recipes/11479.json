  "title": "Sweet Persimmon Fireside Cookies",
  "description": "This recipe is a wonderful way to use persimmons. These bars are moist and fragrant with sweet spices.",
  "authors": [
    "Alex"
  ],
  "date_published": "1999-11-04T14:24:40-05:00",
