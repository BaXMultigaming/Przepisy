  "ingredients": [
    "2 tablespoons olive oil",
    "1 tablespoon lemon-pepper seasoning, divided",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon paprika",
    "1 pound party chicken wings"
  ],
  "steps": [
    {
      "text": "Whisk olive oil, 2 teaspoons lemon-pepper seasoning, paprika, and garlic powder together in a bowl. Add wings and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle remaining 1 teaspoon lemon-pepper seasoning over the wings and let sit for 5 minutes while you preheat the air fryer to 360 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stand wings up along the sides of the air fryer basket making sure to not overcrowd.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook wings in the air fryer until chicken is no longer pink at the bone and the juices run clear, for 25 minutes. After the timer goes off, let wings sit inside the closed basket for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
