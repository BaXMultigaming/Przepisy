  "ingredients": [
    "0.25 cup unsalted butter",
    "0.125 teaspoon garlic powder",
    "12 slices white bread",
    "1 teaspoon dried oregano",
    "1 (8 ounce) package shredded mozzarella cheese",
    "1 (24 ounce) jar vodka marinara sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 6 slices of bread onto a baking sheet. Spread a small handful of mozzarella cheese over each slice. Top with remaining 6 slices of bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together butter and garlic powder in a small bowl; brush some garlic butter over tops of sandwiches or spread with the back of a spoon. Sprinkle with dried oregano.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sandwiches under the broiler until golden brown, 2 to 3 minutes. Remove the sheet from the oven, flip sandwiches, brush tops with garlic butter, and sprinkle with oregano. Return to the broiler; cook until tops are golden brown, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut sandwiches in half diagonally; serve immediately with vodka sauce on the side for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
