  "ingredients": [
    "3 cups all-purpose flour",
    "1.25 cups white sugar",
    "4 teaspoons baking powder",
    "1 (15 ounce) can pumpkin puree",
    "4 egg whites",
    "1 cup milk",
    "0.5 cup applesauce",
    "1.5 teaspoons salt",
    "1 teaspoon ground nutmeg",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground allspice, or more to taste",
    "0.25 teaspoon ground ginger"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 375 degrees F (190 degrees C). Grease 48 mini-muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the flour, sugar, baking powder, pumpkin puree, egg whites, milk, applesauce, salt, nutmeg, cinnamon, allspice, and ginger together in a large bowl until everything is just moistened; pour into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and the tops spring back when lightly pressed, about 15 minutes. Allow to cool completely on a wire rack before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
