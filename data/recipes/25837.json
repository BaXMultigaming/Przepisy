  "ingredients": [
    "1 cup butter, softened",
    "2 cups packed brown sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2.3333332538605 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2 cups rolled oats",
    "1 cup semisweet chocolate chips",
    "1 cup vanilla baking chips",
    "0.5 cup butterscotch chips",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream butter and brown sugar until smooth. Beat in eggs, one at a time, then stir in vanilla. Combine flour, baking soda, and salt in a bowl; stir flour mixture into butter mixture. Mix in oats, chocolate chips, vanilla chips, butterscotch chips, and pecans. Drop tablespoonfuls of dough 2 inches apart onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in batches in the preheated oven for 8 to 10 minutes. Allow cookies to cool on the baking sheets for 5 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
