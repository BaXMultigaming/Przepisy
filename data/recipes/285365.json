  "ingredients": [
    "1 (19.8 ounce) package bratwurst sausages",
    "2 medium carrots, chopped",
    "1 medium onion, chopped",
    "3 cups cooked navy beans",
    "2 cups chicken broth",
    "0.25 cup pickled jalapeno pepper slices, chopped",
    "1.5 cups milk, divided",
    "0.25 cup all-purpose flour",
    "1 (8 ounce) package shredded Cheddar cheese",
    "2 cups torn fresh spinach",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Remove and discard bratwurst casings. Cook bratwurst, carrots, and onion in a large skillet over medium-high heat until bratwurst is browned and crumbly, about 7 minutes. Add cooked navy beans, chicken broth, and jalapenos; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1/2 cup milk with flour; add to soup and stir until thickened, about 3 minutes. Reduce heat. Add remaining 1 cup milk and shredded Cheddar cheese; stir until cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in spinach and cook until wilted, 1 to 2 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
