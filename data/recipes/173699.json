  "ingredients": [
    "1 (13.8 ounce) package refrigerated pizza dough",
    "1 (18 ounce) container barbequed pulled pork",
    "0.25 red onion, thinly sliced",
    "0.5 cup dill pickle slices",
    "2 cups shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll the dough out into the prepared pan. Top the dough with the barbecued pork. Sprinkle with the red onions, and layer on the dill pickle slices. Sprinkle mozzarella cheese evenly over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is golden and cheese is melted, about 18 minutes.",
      "section": null,
