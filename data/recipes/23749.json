  "ingredients": [
    "0.5 cup butter, softened",
    "2 cups creamy peanut butter",
    "2 cups confectioners' sugar",
    "3 cups crispy rice cereal",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Butter a 9x13 inch baking dish. In a medium bowl, stir together the butter, peanut butter and confectioners' sugar until well blended. Mix in the rice cereal so that it is evenly distributed. Press the mixture into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In the microwave or over a double boiler, melt chocolate chips, stirring occasionally until smooth. Spread the melted chocolate evenly over the peanut butter bars. Refrigerate until set before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
