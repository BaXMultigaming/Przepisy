  "ingredients": [
    "0.75 cup individually wrapped caramels (such as Kraft®), unwrapped",
    "0.25 cup half-and-half",
    "1 cup butter, softened",
    "0.33333334326744 cup packed dark brown sugar",
    "1 egg",
    "0.75 teaspoon sea salt",
    "3 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine caramels and half-and-half in a saucepan. Cook over low heat, stirring until caramels are melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and brown sugar together in a bowl using an electric mixer until fluffy. Beat in egg and salt. Beat in fluid caramel sauce. Add flour; beat until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a cookie press with the dough and press onto baking sheets, 1 to 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
