        "https://www.allrecipes.com/thmb/XKNKxaugHG8NGpZ48W6C4xcr7WM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13466-cranberry-salad-ii-VAT-step-06-dc193c70109d45b9be95758b4a369af9.jpg"
