  "ingredients": [
    "cooking spray",
    "0.66666668653488 cup packed brown sugar",
    "0.5 cup butter",
    "1.25 cups whole wheat flour",
    "0.5 cup unbleached all-purpose flour",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon ground allspice",
    "2 cups rolled oats",
    "1 cup sliced fresh strawberries",
    "1 cup fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Coat a 10x14-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and butter in a large bowl; beat with an electric mixer until smooth and creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together whole wheat flour, all-purpose flour, salt, cinnamon, baking soda, and allspice in a separate bowl. Gradually pour flour mixture into the butter mixture; blend well. Stir in oats and mix with a wooden spoon until incorporated. Press 1/2 of the oat batter firmly into the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Spread strawberries and blueberries over the crust and sprinkle with remaining oat batter. Press slightly to flatten batter and fruit. Bake until edges are golden brown, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and let cool completely in the pan. Cut into 24 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
