  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup sour cream",
    "0.25 cup picante sauce",
    "2 tablespoons taco seasoning mix",
    "1 pinch garlic powder",
    "1 cup finely shredded Cheddar cheese",
    "1 (4.5 ounce) can chopped black olives, drained",
    "1 (4 ounce) can chopped green chilies",
    "8 flour tortillas"
  ],
  "steps": [
    {
      "text": "Beat cream cheese, sour cream, picante sauce, taco seasoning, and garlic powder together in a small bowl until smooth; stir in Cheddar cheese, olives, and chiles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread about ½ cup cream cheese mixture onto each tortilla; roll each like a jelly roll. Wrap rolls in plastic wrap. Refrigerate for 2 hours to overnight. Cut into 1-inch slices.",
      "section": null,
