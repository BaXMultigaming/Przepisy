  "ingredients": [
    "2 tablespoons butter",
    "2 slices bread",
    "1 egg",
    "1 slice Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Build a campfire and allow the fire to burn until it has accumulated a bed of coals. Rake the coals into a flat bed on one side of the fire.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a Hobo Pie toaster over hot coals, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread butter onto bread slices; place 1 bread slice, buttered-side down, in the preheated toaster. Crack egg onto bread slice; break yolk. Top with cheese slice and remaining bread slice, buttered-side up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Close the toaster; place into coals. Cook until bread has browned nicely on both sides, turning frequently, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
