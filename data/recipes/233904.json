  "ingredients": [
    "8 ounces orzo pasta",
    "1 tablespoon pesto, divided",
    "3 tablespoons extra-virgin olive oil, divided",
    "2 cups frozen cooked shrimp, thawed",
    "0.5 cup diced red bell pepper",
    "1 teaspoon capers",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon red pepper flakes",
    "salt and ground black pepper to taste",
    "0.25 cup grated Parmesan cheese",
    "1 tablespoon olive oil, or to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook orzo in boiling water, occasionally stirring until cooked through but firm to the bite, about 11 minutes. Drain and transfer to a bowl; mix 2 teaspoons pesto and 2 tablespoons extra-virgin olive oil into orzo.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining tablespoon extra-virgin olive oil in a skillet; cook and stir shrimp, red bell pepper, and capers in hot oil until shrimp is heated through, 3 to 5 minutes. Stir remaining teaspoon pesto, oregano, garlic powder, red pepper flakes, salt, and pepper into shrimp mixture; cook and stir until combined, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix orzo into shrimp mixture; sprinkle with Parmesan cheese and drizzle with olive oil.",
