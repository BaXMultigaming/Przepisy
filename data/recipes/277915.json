  "ingredients": [
    "1 cup water",
    "0.25 cup white sugar",
    "0.5 cup cocoa powder",
    "1 tablespoon black onyx cocoa powder (from Savory Spice Shop®)",
    "0.5 teaspoon vanilla bean paste (such as Nielsen-Massey®)"
  ],
  "steps": [
    {
      "text": "Combine water and sugar in a medium saucepan over medium heat. Bring to a simmer and cook until sugar is dissolved, about 3 minutes. Stir in both cocoa powders and vanilla bean paste until combined.",
