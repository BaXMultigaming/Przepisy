  "ingredients": [
    "1 cup unsweetened applesauce",
    "0.33333334326744 cup canola oil",
    "0.25 cup orange juice",
    "1 large egg, slightly beaten",
    "1 teaspoon vanilla extract",
    "1 cup whole wheat flour",
    "1 cup all-purpose flour",
    "0.5 cup regular oats, uncooked",
    "0.5 cup dark brown sugar",
    "0.25 cup white sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1.25 cups chopped fresh cranberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine applesauce, oil, orange juice, egg, and vanilla extract in a large bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine whole wheat flour, all-purpose flour, oats, brown sugar, white sugar, cinnamon, baking soda, and salt in another bowl. Add dry mix to wet mix, stirring just until moistened. Gently fold in cranberries; do not overmix. Divide batter evenly between the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed and muffins are light golden brown, 15 to 25 minutes. Cool in the tin for 5 minutes, then transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
