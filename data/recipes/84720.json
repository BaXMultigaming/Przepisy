  "ingredients": [
    "3.5 cups water, divided",
    "1.5 cups uncooked long grain white rice",
    "1 pound ground beef",
    "1 (14 ounce) can refried beans",
    "1 medium onion, chopped",
    "1 (4.5 ounce) can chopped green chiles, drained",
    "1.5 tablespoons ground cumin",
    "1 tablespoon prepared yellow mustard",
    "1 tablespoon seasoned salt",
    "1 teaspoon soy sauce",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon hot sauce",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Bring 3 cups water and rice to a boil in a pot. Cover, reduce the heat to low, and simmer until tender, about 20 minutes. Drain and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook ground beef in a large skillet over medium heat until browned and crumbly, 5 to 7 minutes; drain grease. Stir in refried beans, onion, remaining 1/2 cup water, chiles, mustard, seasoned salt, soy sauce, Worcestershire sauce, and hot sauce. Reduce heat to low and cook, stirring often, for 25 minutes. Serve over rice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
