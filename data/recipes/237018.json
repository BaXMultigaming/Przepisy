  "ingredients": [
    "0.75 cup pecans",
    "1 cup butter, softened",
    "0.75 cup white sugar",
    "1 large egg yolk",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "1.75 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pecans evenly onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fragrant and lightly toasted, 5 to 10 minutes. Cool completely, then coarsely chop in a food processor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter in a large bowl with an electric mixer until creamy. Add sugar; beat until light and fluffy. Beat in egg yolk, vanilla, and salt until well combined. Slowly mix in pecans. Stir in flour until dough begins to come together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into a ball and divide it in half. Roll each dough half into a 1 1/2-inch-thick log. Wrap each log in wax paper and refrigerate, 4 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unwrap dough logs and cut into slices, about 1/3-inch thick. Place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 12 to 15 minutes. Cool cookies on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
