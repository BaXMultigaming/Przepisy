  "ingredients": [
    "1 teaspoon salt",
    "1 teaspoon black pepper",
    "1 teaspoon hot Hungarian paprika",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon brown sugar",
    "4 skinless, boneless chicken breast halves",
