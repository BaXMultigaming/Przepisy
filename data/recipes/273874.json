  "ingredients": [
    "wood chips",
    "4 tomatoes, diced",
    "2 onions, diced",
    "1 green bell pepper, diced",
    "1 red bell pepper, diced",
    "1 yellow bell pepper, diced",
    "1 orange bell pepper, diced",
    "3 jalapeno peppers, diced",
    "1 lime, juiced",
    "0.25 teaspoon garlic powder, or to taste",
    "salt and ground black pepper to taste",
    "1 bunch fresh cilantro, finely chopped"
  ],
  "steps": [
    {
      "text": "Preheat a smoker grill to 250 degrees F (120 degrees C). Add wood chips according to the manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomatoes, onions, bell peppers, and jalapeños in an aluminum grill pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the pan onto the grate of the preheated smoker grill; smoke for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove vegetables from the smoker and transfer to a blender; blend to desired consistency. Mix in lime juice, garlic powder, salt, and pepper. Add fresh cilantro for decoration.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
