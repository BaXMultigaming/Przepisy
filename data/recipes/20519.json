  "ingredients": [
    "5 quarts plain popped popcorn",
    "2.625 cups confectioners' sugar",
    "1 cup marshmallows",
    "0.75 cup light corn syrup",
    "0.25 cup margarine",
    "2 teaspoons cold water",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Place popcorn in a large, heatproof bowl.",
