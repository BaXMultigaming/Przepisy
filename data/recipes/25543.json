  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "2 tablespoons mayonnaise",
    "1 tablespoon onion juice",
    "1 tablespoon grated onion",
    "1 (1 pound) loaf white bread, crusts trimmed",
    "1 (22 ounce) jar baby dill pickles"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mix cream cheese, mayonnaise, onion juice, and grated onion until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cream cheese mixture thinly on white bread slices. Roll 1 baby dill pickle in each slice of bread. Place rolls, seam-side down, in a medium glass baking dish. Cover and chill in the refrigerator, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To serve, slice each roll into 1-inch slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
