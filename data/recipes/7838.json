  "ingredients": [
    "2 cups graham cracker crumbs",
    "1 (16 ounce) package large marshmallows",
    "2 (15 ounce) cans crushed pineapple",
    "4 bananas",
    "0.25 cup chopped walnuts",
    "1 cup heavy whipping cream, whipped"
  ],
  "steps": [
    {
      "text": "Line a 9x13-inch baking pan with graham cracker crumbs, reserving some crumbs for garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pineapple, reserving the juice in a saucepan: add marshmallows and cook over low heat until melted. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bananas, chopped nuts, and crushed pineapple into marshmallow mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold fruit mixture into whipped cream; spoon into prepared pan. Sprinkle reserved cookie crumbs on top. Chill in the refrigerator before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
