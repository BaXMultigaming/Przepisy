  "ingredients": [
    "1 pound ground lamb",
    "1 tablespoon garlic powder",
    "1 4-inch sprig rosemary, chopped",
    "4 sprigs thyme, chopped",
    "1 pinch salt",
    "1 pinch ground black pepper",
    "3 tablespoons mayonnaise",
    "1 tablespoon Dijon mustard",
    "4 hamburger buns, split and toasted",
    "4 thick slices tomato",
    "1 cup baby mixed salad greens"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground lamb, garlic powder, rosemary, thyme, salt, and pepper together in a large bowl until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2tYll-qcu9T62jUHEzgOZNKtdyY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236679-lamb-burgers-step1-433-f921943c9c994c908b087e774a6aa75e.jpg"
      ],
      "image": "assets/images/236679/step_02.webp"
    },
    {
      "text": "Shape mixture into 4 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lAvulNCz4zBHK5J4VFT11PPzgF8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236679-lamb-burgers-step2-439-eac23eb0badf41179ce62e2649e01e80.jpg"
      ],
      "image": "assets/images/236679/step_03.webp"
    },
    {
      "text": "Place patties on the preheated grill and cook until firm and slightly pink in the center, about 5 minutes per side. An instant-read thermometer inserted into the center should read 140 degrees F (60 degrees C). Alternately, you can cook the patties to your desired degree of doneness. Rest patties while assembling toppings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AX0X9Jd-3tPFg14fmGCNc_YEHPU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236679-lamb-burgers-step3-450-14e82cfd61ad470aafd9d198948cfbd7.jpg"
      ],
      "image": "assets/images/236679/step_04.webp"
    },
    {
      "text": "Mix mayonnaise and mustard together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bFF5g5vDgsESQ2Yc0q0XOJeV1lI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/236679-lamb-burgers-step4-452-ca7076d60b29474d8fcea37215d8493e.jpg"
      ],
      "image": "assets/images/236679/step_05.webp"
    },
    {
      "text": "Spread 1 tablespoon of Dijon-mayonnaise on bottom of each hamburger bun; top each one with a lamb patty, tomato slice, and some greens. Sandwich with top bun to serve.",
      "section": null,
      "name": null,
      "url": null,
