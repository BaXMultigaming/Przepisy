  "ingredients": [
    "0.5 cup butter",
    "1.5 cups all-purpose flour",
    "1 cup chopped walnuts",
    "1 (8 ounce) package cream cheese",
    "1 cup confectioners' sugar",
    "1 (16 ounce) package frozen whipped topping, thawed",
    "1 (3.9 ounce) package instant chocolate pudding mix",
    "3 cups milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix butter, flour, and chopped walnuts until well combined. Pat into the bottom of a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Allow to cool, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat softened cream cheese with confectioners’ sugar until smooth. Fold in 1/2 of the whipped topping. Spread over cooled crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine chocolate pudding mix with milk. Mix well and spread over cream cheese layer. Spread remaining whipped topping over pudding. Sprinkle walnuts over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
