  "title": "Dairy-Free Chocolate Chip Cookies with Coconut Oil",
  "description": "If you love chocolate chip cookies, but need to avoid dairy, try this recipe made with coconut oil and dairy-free chocolate chips.",
  "authors": [
    "kndritter"
  ],
  "date_published": "2020-06-19T00:33:42-04:00",
