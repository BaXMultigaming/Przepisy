  "ingredients": [
    "1 cup coconut oil, softened",
    "0.75 cup white sugar",
    "0.75 cup brown sugar",
    "1 teaspoon vanilla extract",
    "2 large eggs",
    "2.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 (12 ounce) package dairy-free chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine coconut oil, white sugar, brown sugar, and vanilla extract in a large bowl. Refrigerate, stirring occasionally, until the coconut oil has thickened, but can still be stirred, about 5 minutes; the batter will lighten in color as it thickens. Add eggs to the batter one at a time, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, and salt in a bowl. Gradually beat dry ingredients into the bowl with the coconut oil mixture. Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by the tablespoon onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and lightly golden, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool cookies on the baking sheets for 2 minutes, then transfer to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
