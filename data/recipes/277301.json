  "title": "Cinnamon-Pecan Muffins",
  "description": "Perfect for breakfast or snacking, these muffins deliver a double dose of cinnamon-pecan flavor, from both the moist muffins and the sugary sweet topping.",
  "authors": [
    "Mamachef"
  ],
  "date_published": "2020-06-19T00:43:11-04:00",
