  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.75 cup white sugar",
    "2 teaspoons baking powder",
    "1.5 teaspoons ground cinnamon",
    "0.5 teaspoon salt",
    "0.66666668653488 cup milk",
    "0.33333334326744 cup vegetable oil",
    "1 egg",
    "0.5 cup chopped pecans",
    "0.25 cup chopped pecans",
    "1 tablespoon white sugar",
    "1 tablespoon butter, melted",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, baking powder, cinnamon, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine milk, vegetable oil, and egg in a separate bowl; beat with an electric mixer until thoroughly blended. Pour into flour mixture and mix until moist; do not overmix. Fold in pecans and transfer about 2/3 cup batter to each prepared muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake muffins in the preheated oven for 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While muffins are baking, mix pecans, sugar, melted butter, and cinnamon for the topping in a small bowl. Remove muffins from the oven, top with pecan-butter mixture, and return to the oven. Bake until muffins are golden and tops spring back when lightly pressed, 7 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
