  "ingredients": [
    "1 cup peanut butter",
    "0.5 cup butter, softened",
    "0.5 cup honey",
    "0.5 cup packed brown sugar",
    "1 egg",
    "1.25 cups whole wheat flour",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the peanut butter, butter, honey, brown sugar and egg until smooth. Combine the whole wheat flour and baking powder; stir into the batter until blended. Roll into small balls, and place on a greased cookie sheet. Flatten slightly using a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 13 to 15 minutes in the preheated oven, or until cookies are slightly toasted at the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
