  "ingredients": [
    "10 medium red potatoes, cubed",
    "0.5 yellow bell pepper, chopped",
    "0.5 red bell pepper, chopped",
    "0.5 onion, chopped",
    "0.5 cup chopped fresh basil",
    "0.5 tablespoon minced garlic",
    "2 tablespoons olive oil, or as needed",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon paprika",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Grease a large nonstick baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine potatoes, bell peppers, onion, basil, and garlic in a large mixing bowl. Lightly coat with olive oil. Sprinkle salt, black pepper, and paprika on top and toss to coat. Place in a single layer onto the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are golden brown and soft, 45 minutes to 1 hour. Remove from the oven and mix in Cheddar cheese. Return to the oven and bake for an additional 5 minutes. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
