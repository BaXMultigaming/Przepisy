  "ingredients": [
    "1 cup orange juice",
    "1 cup white sugar",
    "1 (12 ounce) package fresh cranberries",
    "2 pears, diced",
    "0.33333334326744 cup honey",
    "2 cinnamon sticks"
  ],
  "steps": [
    {
      "text": "Heat orange juice and sugar in a medium saucepan over medium heat until sugar is dissolved. Stir in cranberries; cook until they start to pop, 5 to 10 minutes. Stir in pears, honey, and cinnamon sticks; cook for 10 minutes. Remove from heat and transfer to a serving bowl. Sauce will thicken as it cools; remove cinnamon sticks before serving.",
