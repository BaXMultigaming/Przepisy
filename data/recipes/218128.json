  "ingredients": [
    "2 cups rolled oats",
    "1 cup flaked coconut",
    "1 cup peanut butter",
    "2 cups white sugar",
    "0.25 cup unsweetened cocoa powder",
    "0.25 cup butter",
    "0.5 cup milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Line baking sheets with waxed paper. Mix the oats, coconut, and peanut butter in a bowl until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sugar, cocoa powder, butter, and milk in a large saucepan, and bring to a boil over medium heat. Stir until the mixture is smooth and the sugar has dissolved, about 1 minute; remove from heat. Mix the oat mixture into the liquid mixture; stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop up about 1 tablespoonful of the dough, roll it into a ball, and flatten. Place on waxed paper, and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
