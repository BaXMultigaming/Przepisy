  "ingredients": [
    "2 tablespoons olive oil",
    "1 teaspoon balsamic vinegar",
    "1 teaspoon lemon juice",
    "0.5 teaspoon dried rosemary",
    "0.5 teaspoon dried oregano",
    "8 large mushrooms, quartered",
    "1 large zucchini, quartered",
    "1 large green bell pepper, cut into pieces",
    "1 large red onion, cut into pieces"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir olive oil, balsamic vinegar, lemon juice, rosemary, and oregano together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place mushrooms, zucchini, bell pepper, and onion in a deep grill-safe pan and brush with oil mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the pan on the preheated grill and cook until vegetables are tender, turning once, 10 to 15 minutes.",
