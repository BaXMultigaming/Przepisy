  "ingredients": [
    "2 (14.5 ounce) cans chicken broth",
    "1 (10 ounce) package frozen chopped spinach",
    "1 (9 ounce) package cheese tortellini",
    "0.25 tablespoon dried basil",
    "0.25 tablespoon garlic powder",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine chicken broth and spinach in a large pot over high heat; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium-low and stir in tortellini; cook uncovered, stirring occasionally, until the tortellini float to the top and the filling is hot, about 3 to 5 minutes. Season with basil, garlic powder, salt, and pepper.",
