  "ingredients": [
    "1 (15 ounce) can chickpeas, drained and rinsed",
    "3 tablespoons cocoa powder",
    "3 tablespoons maple syrup",
    "2 tablespoons water, or as needed",
    "2 tablespoons tahini",
    "0.5 teaspoon vanilla extract",
    "1 pinch salt"
