  "ingredients": [
    "0.5 cup mirin (Japanese sweet wine)",
    "0.25 cup miso paste",
    "0.25 cup soy sauce",
    "3 tablespoons brown sugar",
    "0.5 lime, juiced",
    "4 salmon fillets",
    "1 tablespoon oil, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mirin, miso, soy sauce, brown sugar, and lime juice together in a bowl or high-rimmed tray. Immerse salmon fillets in the marinade. Marinate for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a well oiled grill pan over medium heat. Add the salmon fillets, reserving marinade in the bowl. Cook, flipping as needed, until grill marks form, 2 to 3 minutes per side. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon fillets onto a baking sheet and spoon reserved marinade over each fillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, about 6 minutes.",
      "section": null,
