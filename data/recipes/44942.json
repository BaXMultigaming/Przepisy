  "ingredients": [
    "1 (15 ounce) can pineapple chunks, drained",
    "1 (15 ounce) can apricot halves, drained",
    "1 (15 ounce) can sliced peaches, drained",
    "1 (10 ounce) jar maraschino cherries, drained",
    "1.25 cups brandy",
    "1.25 cups white sugar"
  ],
  "steps": [
    {
      "text": "Combine pineapple chunks, apricot halves, sliced peaches, maraschino cherries, brandy, and white sugar in a large glass jar. Stir gently with a wooden spoon until the sugar is combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover loosely and let stand at room temperature for 3 weeks, stirring at least twice a week.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain the fruit, reserving the liquid. The reserved liquid is the starter for Thirty-Day Friendship Cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the brandied fruit to an airtight container and refrigerate until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
