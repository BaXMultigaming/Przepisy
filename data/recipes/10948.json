  "title": "Pistachio Cream Cheese Fingers",
  "description": "These are tender and delicately flavored cookies - the light green color and chocolate drizzle make them stand out on a cookie tray. Nice for holidays or bridal showers.",
  "authors": [
    "irenedee"
  ],
  "date_published": "1998-06-07T18:00:01-04:00",
