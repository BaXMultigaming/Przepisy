  "ingredients": [
    "2 hot dogs",
    "4 slices pepperoni, halved",
    "0.5 cup pizza sauce",
    "2 hot dog buns",
    "0.25 cup shredded mozzarella cheese",
    "2 teaspoons sliced olives"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat an air fryer to 390 degrees F (200 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J1HJv2hVPew4-HhofDv4iNObDtY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268495-air-fryer-pizza-dogs-VAT-009-step-01-afe6c3671a4c48ee8737df0f1f47bbac.jpg"
      ],
      "image": "assets/images/268495/step_01.webp"
    },
    {
      "text": "Make 4 slits down each hot dog. Place hot dogs in the air fryer basket; cook for 3 minutes. Transfer to a cutting board.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SlrbgR--liI6_lEIKdDORmyNxnY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268495-air-fryer-pizza-dogs-VAT-010-step-02-fed605555fea40559c7566a507c4fff5.jpg"
      ],
      "image": "assets/images/268495/step_02.webp"
    },
    {
      "text": "Place 1 pepperoni half in each slit; divide pizza sauce between buns. Add hot dogs, mozzarella cheese, and olives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7OCp5Od-Ei14UFGU3S1d8bKjtqQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268495-air-fryer-pizza-dogs-VAT-011-step-03-6dab6e14602149d69b851aa939bff768.jpg"
      ],
      "image": "assets/images/268495/step_03.webp"
    },
    {
      "text": "Return hot dogs to the air fryer basket; cook until buns are crisp and cheese is melted, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Bf6qN8762jh4al90819Jjy6pnUc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/268495-air-fryer-pizza-dogs-VAT-012-step-04-43d65ffca042442a80374b2a2ae5b032.jpg"
