  "title": "Salt and Pepper Ribeye Steak",
  "description": "Salting the ribeye steak two days prior to cooking brines the steak, helps tenderize it, and adds rich flavor.",
  "authors": [
    "Diamond Crystal Salt"
  ],
  "date_published": "2014-09-15T15:15:45-04:00",
