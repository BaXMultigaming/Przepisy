  "ingredients": [
    "0.33333334326744 cup olive oil",
    "2 cups sliced fresh mushrooms",
    "1 cup finely chopped onion",
    "1 cup chopped carrot",
    "0.75 cup chopped green bell pepper",
    "0.25 cup chopped celery",
    "1 tablespoon minced garlic",
    "1 tablespoon chili powder, or more to taste",
    "1 tablespoon ground cumin",
    "1.125 teaspoons salt",
    "0.75 teaspoon ground black pepper",
    "0.75 teaspoon dried basil",
    "0.75 teaspoon dried oregano",
    "1 (28 ounce) can whole peeled tomatoes with juice",
    "3 cups black beans, undrained",
    "2 cups water",
    "0.5 (6 ounce) can tomato paste",
    "0.25 cup red wine",
    "0.75 teaspoon hot pepper sauce (such as Tabasco®)"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large pot over medium heat; cook and stir mushrooms, onion, carrot, green bell pepper, celery, garlic, chili powder, cumin, salt, black pepper, basil, and oregano in hot oil until onion begins to soften, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomatoes with their liquid, black beans and their liquid, water, tomato paste, red wine, and hot pepper sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring chili to a boil, reduce heat to low, and simmer until vegetables are tender, about 20 minutes.",
