  "ingredients": [
    "1 pound Italian seasoned ground turkey",
    "0.75 cup diced onion",
    "1 (14.5 ounce) can fire-roasted diced tomatoes, undrained",
    "1 (5.6 ounce) package Knorr® Fiesta Sides™ - Spanish Rice",
    "2.75 cups water",
    "2 teaspoons chili powder",
    "1.5 teaspoons ground cumin",
    "1 teaspoon ground coriander"
  ],
  "steps": [
    {
      "text": "Brown turkey over medium heat in a heavy pot, stirring frequently and breaking up turkey. Cook until brown, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Raise heat to medium-high and add onions. Cook until onions are browned and caramelized, about 4 minutes. Add the fire roasted tomatoes. Stir to combine. Add the Knorr® Fiesta Sides™ - Spanish Rice, water, chili powder, cumin, and coriander. Stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring chili to a boil. Reduce heat to low; cover and simmer until flavors have blended, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
