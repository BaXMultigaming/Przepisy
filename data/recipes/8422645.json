  "ingredients": [
    "1 (10.5 ounce) can cream of chicken soup",
    "1 cup cottage cheese",
    "0.5 cup sour cream",
    "4 ounces cream cheese, at room temperature",
    "1.5 teaspoons Creole seasoning",
    "0.5 teaspoon onion powder",
    "1 teaspoon garlic powder, divided",
    "5 cups shredded rotisserie chicken",
    "1 tablespoon chopped fresh parsley",
    "30 buttery round crackers (such as Ritz®), crushed",
    "4 tablespoons unsalted butter, melted",
    "1 cup shredded mozzarella cheese",
    "1 teaspoon sliced scallions, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream of chicken soup, cottage cheese, sour cream, cream cheese, Creole seasoning, onion powder, and 1/2 teaspoon of the garlic powder in a medium bowl until well blended and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RGsDYDzefZHTt7k-vuUevv_c-Tw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/MillionDollarChickenCasserole-ddmfs-step1-2873-26ee5efc875f461a818494ae244758b0.jpg"
      ],
      "image": "assets/images/8422645/step_02.webp"
    },
    {
      "text": "Fold in chicken and parsley until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F7TDMVS222yPuMLd5Ok6-NFdGA0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/MillionDollarChickenCasserole-ddmfs-step2-2875-9bddde311cba428984cba58c061a4f41.jpg"
      ],
      "image": "assets/images/8422645/step_03.webp"
    },
    {
      "text": "Combine crackers, melted butter, and remaining 1/2 teaspoon garlic powder in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gcCDl4SW97RGFdWf9cBNzYpZ3Ac=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/MillionDollarChickenCasserole-ddmfs-step3-2876-8753b02bc63b4140ba12abb7436b35f5.jpg"
      ],
      "image": "assets/images/8422645/step_04.webp"
    },
    {
      "text": "Spoon chicken mixture evenly into an 11x7-inch or 9-inch square baking dish. Sprinkle evenly with mozzarella then top with cracker mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pK1NRNfNJFP8-Qzp3uc-PLEy5Q4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/MillionDollarChickenCasserole-ddmfs-step4-2880-ebbf36c3f5ad438393203cf62120cbb9.jpg"
      ],
      "image": "assets/images/8422645/step_05.webp"
    },
    {
      "text": "Place on a foil-lined baking sheet and bake in the preheated oven until crackers are golden brown and edges are bubbly, about 35 minutes. Garnish with scallions, if desired. Recipe developed by Amanda Stanfield",
