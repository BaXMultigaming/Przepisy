  "ingredients": [
    "4 cups rolled oats",
    "1 cup sliced almonds",
    "1 cup chopped pecans",
    "1 cup raw sunflower seeds",
    "0.33333334326744 cup canola oil",
    "0.5 cup honey",
    "1 tablespoon ground cinnamon",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir oats, almonds, pecans, and sunflower seeds together in a large bowl. Mix oil, honey, cinnamon, and vanilla together in a smaller bowl; pour over dry ingredients and mix well. Spread mixture onto two ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 20 minutes, stirring halfway through. Remove from the oven and let cool completely before storing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
