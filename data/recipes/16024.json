  "ingredients": [
    "1.5 quarts water",
    "1.5 pounds ham hocks",
    "4 pounds collard greens, rinsed and trimmed",
    "0.5 teaspoon crushed red pepper flakes",
    "0.25 cup vegetable oil",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Place the water and the ham hock in a large pot with a tight-fitting lid. Bring to a boil. Lower the heat to very low and simmer covered for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the collards and the hot pepper flakes the pot. Simmer covered for about 2 hours, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the vegetable oil and simmer covered for 30 minutes.",
