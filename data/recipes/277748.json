  "keywords": [],
  "ingredients": [
    "1 pound ground beef",
    "0.5 onion, chopped",
    "2 tablespoons ketchup",
    "3 teaspoons Dijon mustard, divided",
    "3 teaspoons Worcestershire sauce, divided",
    "0.5 teaspoon garlic powder",
    "salt and ground black pepper to taste",
    "1 (12 count) package Hawaiian bread rolls",
    "1 (8 ounce) package shredded Monterey Jack cheese",
    "0.25 cup butter",
    "1 tablespoon brown sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 11x7-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SaeAiQ-o0iXbJ14iIjj7aFa-SNE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-277748-cheeseburger-sliders-step-01-6f916e3463e5456d90bc72c0fe32049e.jpg"
      ],
      "image": "assets/images/277748/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir ground beef and onion in the hot skillet until meat is browned and crumbly, 5 to 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XwoVYfkYhJEny0W2yzWfS9mZrnE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-277748-cheeseburger-sliders-step-02-543dba68f02e46c9afb4427deca7d03d.jpg"
      ],
      "image": "assets/images/277748/step_02.webp"
    },
    {
      "text": "Stir in ketchup, 2 teaspoons Dijon mustard, 2 teaspoons Worcestershire, and garlic powder. Season with salt and pepper to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5T5O_0N7zRS4uVNeY-xOjQZh690=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-277748-cheeseburger-sliders-step-03-8ba3144785574f4f9238d29ed6d398f1.jpg"
      ],
      "image": "assets/images/277748/step_03.webp"
    },
    {
      "text": "Cut rolls in half horizontally without separating each roll from one another. Place bottom halves in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s1HlzL1i-kntA9yTEioaBz0Kgdw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-277748-cheeseburger-sliders-step-04-e0e6f949b9ff44d0ba0b839fbd93ddd2.jpg"
      ],
      "image": "assets/images/277748/step_04.webp"
    },
    {
      "text": "Spread meat mixture on rolls, top with Monterey Jack cheese, and cover with roll tops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dZ43HVBlM7Dgi_h1lRp2sMoVmfc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-277748-cheeseburger-sliders-step-05-b69dcb32f6f54b158bf6f1f5dcdc5b57.jpg"
      ],
      "image": "assets/images/277748/step_05.webp"
    },
    {
      "text": "Combine butter, brown sugar, remaining Dijon mustard, and remaining Worcestershire in a microwaveable bowl; cover loosely and microwave until butter is melted, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h6x1Ebs6ZHwU-NnhAHsocJik5l0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-277748-cheeseburger-sliders-step-06-8ddfcfaaea074c37acc83870343ae9a0.jpg"
      ],
      "image": "assets/images/277748/step_06.webp"
    },
    {
      "text": "Mix and pour mixture over the top of the rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TkVeyaJDSAz1ZA4apefZTYotYV0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-277748-cheeseburger-sliders-step-07-5d5afdddfadd41c199a31edc3d833488.jpg"
      ],
      "image": "assets/images/277748/step_07.webp"
    },
    {
      "text": "Bake, covered, in the preheated oven for 15 minutes. Uncover and bake until cheese is melted and rolls are golden brown, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hsacRFkQlQa--jRdmXsRn5e75Xk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-277748-cheeseburger-sliders-step-08-8bdc3bbc12944620bcf51d51a3deb7cd.jpg"
      ],
      "image": "assets/images/277748/step_08.webp"
    }
  ],
