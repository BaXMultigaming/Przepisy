  "ingredients": [
    "2 tablespoons vegetable oil",
    "1 cup uncooked converted white rice",
    "0.5 cup chopped onion",
    "0.5 cup chopped green bell pepper",
    "1 pound ground beef",
    "1 cup canned corn",
    "1 (6 ounce) can tomato sauce",
    "0.5 cup ketchup",
    "1 cup water",
    "salt and pepper to taste",
    "garlic powder to taste"
  ],
  "steps": [
    {
      "text": "In a large saucepan over medium heat, heat the oil. Add the rice, onion and bell pepper and saute for 5 minutes, or until onions are tender. Add the ground beef and saute until browned. Drain excess oil and fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the corn, tomato sauce, ketchup and water. Reduce heat to low, cover and simmer for 20 minutes or until rice is cooked, stirring occasionally. Season with salt, pepper and garlic powder to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
