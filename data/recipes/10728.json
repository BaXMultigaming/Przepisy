  "ingredients": [
    "1.3333300352097 cups sifted all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup packed brown sugar",
    "0.5 cup butter, softened",
    "1 egg",
