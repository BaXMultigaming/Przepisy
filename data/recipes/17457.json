  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "5 tablespoons instant lemon pudding mix",
    "2 eggs",
    "0.25 cup butter, softened",
    "0.33300000429153 cup water",
    "0.125 cup applesauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9 inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the cake mix and instant pudding. Add the eggs, butter, water and applesauce, mix with an electric mixer until smooth. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 35 minutes in the preheated oven, until a toothpick inserted comes out clean. Let cake cool in the pan for 10 minutes before removing from pan to cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
