  "ingredients": [
    "0.5 cup mashed Avocado from Mexico",
    "0.5 cup mashed ripe bananas",
    "2 large eggs",
    "0.5 cup low-fat milk",
    "2 cups all-purpose flour",
    "0.75 cup sugar",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Heat oven to 375 degrees F. Grease 12 muffin tin wells or line with paper cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix avocado, bananas, eggs and milk. In a separate bowl, whisk or sift together flour, sugar, baking soda and salt. Stir into avocado mixture; do not over-mix. Stir in walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into prepared muffin tin; bake 15 to 20 minutes or until tops start to brown and a toothpick inserted into a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
