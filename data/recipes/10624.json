  "ingredients": [
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground allspice",
    "0.5 cup white sugar",
    "0.5 cup butter, softened",
    "0.5 cup molasses",
    "2 egg whites",
    "1 egg",
    "0.5 cup raisins",
    "0.33333334326744 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium sized bowl, combine the flour, baking soda, cinnamon, and allspice. In a large bowl, with an electric mixer on medium, cream the sugar and butter until light yellow and fluffy. Add the molasses, egg whites, and egg; beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using a wooden spoon, stir in flour mixture until flour disappears. Fold in raisins and nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by tablespoons, 2 inches apart, onto lightly greased cookie sheets. Bake 8-9 minutes. Lightly sift confectioners' sugar over if you like.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
