  "ingredients": [
    "1 (8 ounce) package refrigerated crescent rolls",
    "0.25 cup shredded Cheddar cheese",
    "8 hot dogs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate dough into 8 triangles. Roll 1 dough triangle a bit larger; sprinkle 1 ½ teaspoons Cheddar cheese over top. Lay 1 hot dog at base of dough triangle; roll dough around hot dog. Transfer rolled hot dog to a baking sheet. Repeat with remaining dough triangles, cheese, and hot dogs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until rolls are golden and hot dogs are plump, about 12 minutes.",
