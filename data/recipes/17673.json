        "https://www.allrecipes.com/thmb/6SxwpJbri2fFefHrOfeirlpoHzQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-17673-carrot-bread-i-VAT-step-03-a8c9b238f02545f7b5fb27574ad8bf49.jpg"
