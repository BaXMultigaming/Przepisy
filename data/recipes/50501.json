  "ingredients": [
    "1 teaspoon olive oil",
    "3 cups sliced fresh mushrooms",
    "1 cup chopped onion",
    "0.5 cup chopped celery",
    "2 cloves garlic, minced",
    "0.5 cup uncooked barley",
    "3 cups vegetable broth",
    "1 (15.5 ounce) can white beans, drained"
