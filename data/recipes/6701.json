      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B1lEMeGBDAfuMRY7RclC9e4TKlc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-6701-persimmon-bread-VAT-step-03-3-da7cfcbf75194674b13d5309f9bf806e.jpg"
      ],
      "image": "assets/images/6701/step_03.webp"
    },
    {
      "text": "Fold in flour mixture. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
