  "ingredients": [
    "1 (15 ounce) can refried black beans",
    "1 (5 ounce) can chunk chicken",
    "3 tablespoons minced onion",
    "0.5 cup shredded Colby-Monterey Jack cheese",
    "1 teaspoon chili powder",
    "1 teaspoon ground cumin",
    "1 teaspoon seasoned salt",
    "0.25 cup shredded Colby-Monterey Jack cheese",
    "1 (16 ounce) package tortilla chips, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 4-cup casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix refried beans, chicken, onion, and 1/2 cup Colby-Monterey Jack cheese together in a large bowl. Stir until chicken is broken up and ingredients are well combined. Mix in chili powder, cumin, and seasoned salt and spoon mixture into the prepared casserole dish. Top with 1/4 cup Colby-Monterey Jack cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until hot and bubbly, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with tortilla chips and refrigerate any leftovers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
