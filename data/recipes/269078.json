  "ingredients": [
    "3 large onions, sliced into thin rings",
    "2 cups milk",
    "2 cups all-purpose flour",
    "1 pinch garlic powder, or to taste",
    "1 pinch onion powder, or to taste",
    "1 pinch ground white pepper, or to taste",
    "salt to taste",
    "vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Soak onions in milk for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, garlic powder, onion powder, white pepper, and salt. Add a handful of onions and toss to coat. Remove and repeat with remaining onions, one handful at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet or deep fryer. Fry onion in batches, stirring as needed, until evenly browned, 2 to 3 minutes each. Drain on paper towels and season with more salt. Store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
