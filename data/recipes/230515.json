  "ingredients": [
    "1.5 cups half-and-half",
    "8 eggs",
    "2 tablespoons vanilla extract",
    "1 tablespoon dark brown sugar",
    "8 slices French bread",
    "0.25 cup butter, or more as needed",
    "0.5 cup maple syrup",
    "0.75 cup chopped pecans",
    "2 tablespoons confectioners sugar, or more to taste"
  ],
  "steps": [
    {
      "text": "Mix half-and-half, eggs, vanilla, and 1 tablespoon sugar together in a large shallow bowl. Add French bread. Cover bowl with plastic wrap and refrigerate 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a 9x13-inch casserole dish. Transfer to the preheated oven until butter melts, about 5 minutes. Swirl butter over bottom of the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread maple syrup, pecans, and remaining 3/4 cup sugar over melted butter. Arrange soaked bread on top of pecan mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until top is golden and no longer runny, 30 to 35 minutes. Sprinkle with confectioners' sugar just before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
