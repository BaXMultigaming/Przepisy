  "ingredients": [
    "10 fresh mint leaves",
    "2 teaspoons white sugar",
    "2 fluid ounces white rum",
    "0.5 lime, quartered",
    "4 fluid ounces sparkling white wine",
    "0.25 cup crushed ice"
  ],
  "steps": [
    {
      "text": "Place mint leaves and sugar in the bottom of a Collins glass; mash well with a cocktail muddler. Add rum and lime wedges to the glass; muddle. Top with sparkling wine and crushed ice.",
