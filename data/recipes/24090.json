  "ingredients": [
    "1 (9 inch) unbaked pie crust",
    "36 individually wrapped caramels, unwrapped",
    "0.25 cup unsalted butter",
    "0.25 cup milk",
    "0.75 cup white sugar",
    "3 large eggs",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "1 cup pecan halves"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4bdRXpO142RiqK1itUDX7CMJuVw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24090-caramel-pecan-pie-step-01-fe4b5dd7a2b54c739b14f2366660e140.jpg"
      ],
      "image": "assets/images/24090/step_01.webp"
    },
    {
      "text": "Combine caramels, butter, and milk in a saucepan over low heat. Cook, stirring frequently, until caramels are melted and mixture is smooth, 10 to 15 minutes. Remove from the heat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SaFtSNcW7nEvXmJPUQD4rH8VR6A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24090-caramel-pecan-pie-step-02-78ac080ca3de4deabf755ffb0a613e26.jpg"
      ],
      "image": "assets/images/24090/step_02.webp"
    },
    {
      "text": "Mix together sugar, eggs, vanilla, and salt in a large bowl. Gradually mix in the melted caramel mixture, then stir in pecans. Pour filling into unbaked pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DaI81BDE1vnwW9sxyVasBofniE0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24090-caramel-pecan-pie-step-03-B-a5577db77963449a9ed81f77b91eaf39.jpg"
      ],
      "image": "assets/images/24090/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until pastry is golden brown, 45 to 50 minutes. Remove from the oven and let set on a wire rack until filling is firm, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pytTl3rlHKy9WLzymYACdIwGq60=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24090-caramel-pecan-pie-step-04-4e56c2250a93423396154d586acf4929.jpg"
      ],
      "image": "assets/images/24090/step_04.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4IWWgc6gS31Rxnah_w1NwMdCQDM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-24090-caramel-pecan-pie-VAT-02-4x3-a14a338999114096b19428a2ef0ab1a1.jpg"
