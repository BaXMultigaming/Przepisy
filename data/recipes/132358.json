  "ingredients": [
    "0.75 cup butter",
    "3 tablespoons minced garlic",
    "2 pounds large sea scallops",
    "2 tablespoons fresh lemon juice",
    "1 teaspoon salt",
    "0.125 teaspoon pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
