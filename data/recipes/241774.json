  "ingredients": [
    "1 (16 ounce) package uncooked spaghetti",
    "2 (24 ounce) jars RAGÚ® Old World Style® Traditional Sauce",
    "1 (8 ounce) package cream cheese",
    "2 cups mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook spaghetti in the boiling water, stirring occasionally, until tender yet firm to the bite, about 12 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat sauce in a saucepan over medium heat. Add cream cheese; stir until melted. Add spaghetti and sauce to an oven-safe baking dish; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Top with mozzarella cheese; continue baking until sauce is thick and cheese is melted, 10 to 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
