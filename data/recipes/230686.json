  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 2 cups whole wheat flour, rolled oats, butter, ½ cup brown sugar, ½ cup white sugar, 1 teaspoon cinnamon, and salt in a bowl with an electric mixer on medium speed until pea-sized and crumbly, 3 to 5 minutes. Refrigerate until ready to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine blueberries, apples, ¼ cup brown sugar, ¼ cup white sugar, 2 tablespoons whole wheat flour, lemon juice and zest, 1 teaspoon cinnamon, and nutmeg in a large bowl; transfer to the prepared baking dish. Sprinkle oat mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is browned and fruit is bubbly, 35 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
