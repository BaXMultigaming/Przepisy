  "ingredients": [
    "0.75 cup raisins",
    "0.25 cup orange juice",
    "1.5 cups rice flour",
    "0.75 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground allspice",
    "0.25 teaspoon xanthan gum",
    "1 cup finely shredded carrots",
    "0.25 cup vegetable oil",
    "2 tablespoons water",
    "1.5 teaspoons dry egg replacer (such as Ener-G®)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix raisins and orange juice together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine rice flour, sugar, baking powder, cinnamon, salt, allspice, and xanthan gum in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix carrots, oil, water, and dry egg replacer together in a separate bowl. Fold in raisin mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a well in the center of the flour mixture; pour in carrot mixture. Mix until batter is moistened. Spoon batter into the prepared tin, filling each cup 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
