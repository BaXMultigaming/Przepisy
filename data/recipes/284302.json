  "ingredients": [
    "1 medium cucumber",
    "1.5 tablespoons white wine vinegar",
    "1 tablespoon honey",
    "0.5 teaspoon red chile flakes",
    "0.5 teaspoon salt",
    "0.5 cup blanched hazelnuts",
    "8 ounces halloumi cheese",
    "2 tablespoons chopped fresh mint",
    "3 fresh figs, chopped"
  ],
  "steps": [
    {
      "text": "Cut cucumber into chunky half-moons, then scrape out the core. Place cucumber in a medium bowl with vinegar, honey, chile flakes, and salt; set aside to pickle for 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the cucumbers are pickling, toast hazelnuts in a medium skillet over medium heat until browned and fragrant, 5 to 10 minutes. Remove from the skillet and chop coarsely when cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice halloumi cheese into 3/8-inch slices and place in a nonstick skillet over medium heat. Cook until crisp, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chopped hazelnuts and mint into the pickled cucumbers. Add halloumi and figs and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
