  "ingredients": [
    "3 small cucumbers, thinly sliced",
    "1 teaspoon salt",
    "1 tomato, seeded and thinly sliced",
    "1 small red onion, thinly sliced",
    "0.25 cup cider vinegar",
    "1.5 teaspoons grapeseed oil",
    "1.5 teaspoons honey",
    "1 tablespoon reduced-fat sour cream",
    "0.25 teaspoon celery seed",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon dried dill weed",
    "0.5 teaspoon white sugar",
    "1 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Sprinkle cucumber slices with salt in a colander. Let stand until cucumbers are drained, about 30 minutes. Transfer to a large bowl and toss with tomato and onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk vinegar, grapeseed oil, honey, sour cream, celery seed, basil, garlic powder, oregano, dill weed, sugar, and cayenne pepper in a small bowl; stir into vegetable mixture. Cover and refrigerate for at least 1 hour to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
