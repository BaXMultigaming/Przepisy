  "ingredients": [
    "1 egg",
    "1 tablespoon pesto",
    "1 pinch salt",
    "1 cup crushed cornflakes",
    "1 ounce finely shredded Parmesan cheese",
    "0.5 teaspoon cantanzaro herbs (such as Savory Spice Shop®)",
    "0.5 teaspoon granulated garlic",
    "1 pinch salt",
    "1 pound chicken tenders"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together egg, pesto, and salt in a shallow dish. In a separate dish mix together cornflake crumbs, Parmesan cheese, cantanzaro herbs, garlic, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each piece of chicken piece first in egg wash, then dredge through the cornflake mixture, shaking off excess breading. Place chicken pieces in the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry for 5 minutes, rearrange chicken pieces, and fry until no longer pink in the center and the juices run clear, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
