  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup whole wheat flour",
    "1 tablespoon ground cinnamon",
    "1.5 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.5 teaspoon nutmeg",
    "1 cup packed brown sugar",
    "1 cup white sugar",
    "2 ripe bananas, mashed",
    "3 eggs",
    "0.5 cup vegetable oil",
    "0.5 cup unsweetened applesauce",
    "2 teaspoons vanilla extract",
    "2.5 cups grated zucchini",
    "1 cup chopped walnuts",
    "0.5 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk all-purpose flour, whole wheat flour, cinnamon, baking powder, baking soda, salt, and nutmeg together in a large bowl. Beat brown sugar, white sugar, bananas, eggs, oil, applesauce, and vanilla together in a separate large bowl. Stir flour mixture into banana mixture. Fold zucchini, walnuts, and coconut into batter until well combined; divide between the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 40 to 50 minutes. Cool loaves in the pans for 25 minutes before removing from the pans and transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
