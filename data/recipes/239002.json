  "ingredients": [
    "1 (17 ounce) package wheat bran flakes cereal with raisins",
    "1 quart buttermilk",
    "5 cups all-purpose flour",
    "3 cups white sugar",
    "1 (15 ounce) can fruit cocktail, drained",
    "1 cup vegetable oil",
    "4 large eggs",
    "4 teaspoons ground cinnamon",
    "2 teaspoons salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease 54 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat bran cereal, buttermilk, flour, sugar, fruit cocktail, vegetable oil, eggs, cinnamon, and salt together in a bowl with an electric mixer on medium speed until batter is blended, about 2 minutes. Spoon batter into prepared muffin cups, filling each about 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and set, 16 to 18 minutes.",
      "section": null,
