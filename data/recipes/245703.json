  "ingredients": [
    "2 (4.8 ounce) packages graham crackers, crushed",
    "0.5 cup butter, melted",
    "0.5 cup white sugar",
    "1 (8 ounce) package cream cheese, softened",
    "1 cup confectioners' sugar",
    "1 cup whipped topping (such as Cool Whip®)",
    "1 (21 ounce) can blueberry pie filling"
  ],
  "steps": [
    {
      "text": "Mix graham crackers, butter, and white sugar together in a medium bowl until well combined; press mixture into the bottom of a 9x13-inch baking dish. Chill crust in the refrigerator until firm, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and confectioners' sugar together in a large bowl until light and fluffy, 2 to 3 minutes. Fold in whipped topping until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cream cheese mixture evenly onto crust; top with blueberry pie filling. Chill in the refrigerator until firm, 4 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
