  "ingredients": [
    "1 cup butter, softened",
    "0.5 cup powdered sugar",
    "2 cups all-purpose flour",
    "2 egg yolks",
    "1.5 teaspoons ground cinnamon",
    "1.5 teaspoons ground allspice",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground cardamom",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon salt",
    "1 cup powdered sugar",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground cardamom"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and powdered sugar together until well blended. Add flour, egg yolks, cinnamon, allspice, nutmeg, cardamom, ginger, cloves, and salt. Mix until smooth. Roll dough into 1-inch balls and place on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 12 to 15 minutes. Cool on a wire rack for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix powdered sugar, cinnamon, and cardamom together in a shallow bowl. Roll cookies in the coating mixture while still warm. Allow to cool for 5 more minutes; roll again.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
