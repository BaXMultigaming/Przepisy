  "steps": [
    {
      "text": "Heat olive oil in a soup pot over medium-high heat. Cook and stir onion in hot oil until tender, about 5 minutes. Season with Italian seasoning; cook and stir for 1 more minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in chicken broth, white beans, tomatoes, cabbage, ham, and celery; bring to a boil. Reduce the heat to low and simmer until celery and cabbage are tender, 15 to 20 minutes.",
