  "ingredients": [
    "1 tablespoon olive oil",
    "1 onion, diced",
    "1.5 teaspoons Italian seasoning",
    "1 quart chicken broth",
    "1 (15.5 ounce) can white beans, drained",
    "1 (14.5 ounce) can petite diced tomatoes",
    "0.5 head cabbage, shredded",
    "0.75 pound ham, diced",
