  "ingredients": [
    "15 dates, pitted and chopped",
    "1 cup oat flour",
    "0.5 cup whey protein powder",
    "0.25 cup unsweetened cocoa powder",
    "0.75 cup chopped pecans, divided",
    "0.75 cup shredded coconut, divided",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "1 tablespoon water, or more as needed",
    "2 tablespoons semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Place dates in a bowl and add boiling water to cover. Let soak for 10 minutes. Strain dates and discard the water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend oat flour, protein powder, and cocoa powder in a food processor until well combined. Add dates, 1/2 cup pecans, 1/2 cup coconut, vanilla, and salt. Pulse to combine, adding water as needed, to get a soft dough consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dough to a bowl. Add remaining pecans, remaining coconut, and chocolate chips; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrape dough onto a piece of parchment paper and place another piece of parchment paper on top. Toll bars out to about 1/2-inch thick. Refrigerate until firm, 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice into 12 bars and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
