  "ingredients": [
    "1 cup caster (superfine) sugar",
    "6.5 tablespoons unsalted butter, softened",
    "1 large egg",
    "2 cups self-rising flour",
    "1 teaspoon vanilla extract",
    "1 pinch ground nutmeg",
    "1 cup flat beer",
    "1 cup all-purpose flour",
    "0.75 cup caster (superfine) sugar",
    "6.5 tablespoons unsalted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 9-inch square cake pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine superfine sugar and butter for cake in a large bowl; beat with an electric mixer until pale and creamy. Add egg and beat until well combined. Sift in self-rising flour; stir to combine. Add vanilla extract and nutmeg. Add beer and stir until well combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together flour, sugar, and melted butter for topping until just combined. Crumble over the cake batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean and crumble topping is golden brown, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
