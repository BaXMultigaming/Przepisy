  "ingredients": [
    "4 cups diced fresh rhubarb",
    "1 (9 inch) unbaked deep-dish pie crust",
    "1.25 cups white sugar",
    "0.66666668653488 cup evaporated milk",
    "3 large eggs",
    "3 tablespoons all-purpose flour",
    "0.5 teaspoon salt",
    "3 large egg whites",
    "6 tablespoons white sugar",
    "0.5 teaspoon salt",
    "0.5 teaspoon cream of tartar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place rhubarb into pie crust. Combine 1 ¼ cups sugar, evaporated milk, egg yolks, flour, and ½ teaspoon salt in a bowl; pour over rhubarb. Place pie onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 12 minutes. Reduce oven temperature to 350 degrees F (175 degrees C); bake 30 minutes more. Transfer pie to a wire rack. Reduce oven temperature to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a separate bowl until frothy. Slowly add 6 tablespoons sugar, ½ teaspoon salt, and cream of tartar; beat until stiff peaks form. Spread over baked pie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light golden brown, about 15 minutes. Cool slightly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
