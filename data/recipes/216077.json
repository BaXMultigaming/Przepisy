  "ingredients": [
    "0.5 cup butter, softened",
    "0.25 cup grated Parmesan cheese",
    "2 cloves garlic, minced",
    "0.25 teaspoon dried marjoram",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon fines herbs",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon dried parsley, or to taste",
    "ground black pepper to taste",
    "1 loaf unsliced Italian bread"
  ],
  "steps": [
    {
      "text": "Gather ingredients and preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
