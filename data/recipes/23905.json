  "ingredients": [
    "2.5 cups seasoned croutons",
    "1 pound spicy pork sausage",
    "4 eggs",
    "2.25 cups milk",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 (10 ounce) package frozen chopped spinach - thawed, drained and squeezed dry",
    "1 (4.5 ounce) can mushrooms, drained and chopped",
    "1 cup shredded sharp Cheddar cheese",
    "1 cup shredded Monterey Jack cheese",
    "0.25 teaspoon dry mustard",
    "2 sprigs fresh parsley, for garnish"
  ],
  "steps": [
    {
      "text": "Spread croutons on bottom of greased 9x13 inch baking dish. Crumble sausage into medium skillet. Cook over medium heat until browned, stirring occasionally. Drain off any drippings. Spread sausage over croutons.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, whisk together eggs and milk until well blended. Stir in soup, spinach, mushrooms, cheeses and mustard. Pour egg mixture over sausage and croutons. Refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "The next morning, preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 50 to 55 minutes or until set and lightly browned on top. Garnish with parsley sprigs and serve hot.",
      "section": null,
      "name": null,
      "url": null,
