  "ingredients": [
    "3 tablespoons butter",
    "1 cup chopped onion",
    "1 clove garlic, minced",
    "1 pound ground beef",
    "2 medium tomatoes, chopped",
    "1 cup frozen peas",
    "1 tablespoon Masala curry powder",
    "1.5 teaspoons salt",
    "1 teaspoon paprika",
    "0.5 teaspoon chili powder",
    "1 pinch ground black pepper",
    "0.25 cup flaked coconut, or to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium heat. Add onion and garlic; cook and stir until onion is translucent, 3 to 5 minutes. Stir in beef; cook until crumbly and no longer pink, 5 to 10 minutes. Drain excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomatoes, peas, curry powder, salt, paprika, chili powder, and pepper into beef mixture; cook until thickened, about 20 minutes. Garnish with coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
