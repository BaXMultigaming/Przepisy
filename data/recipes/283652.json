  "ingredients": [
    "cooking spray",
    "8 medium cherry tomatoes",
    "1 (11 ounce) can refrigerated pizza crust",
    "8 teaspoons shredded mozzarella cheese",
    "0.5 cup pizza sauce (such as Classico®)",
    "8 teaspoons finely chopped red onion",
    "0.5 cup shredded mozzarella cheese",
    "8 slices pepperoni, quartered",
    "Italian seasoning to taste",
    "red pepper flakes to taste",
    "garlic salt to taste"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat the oven to 400 degrees F (200 degrees C). Grease 8 cups of a muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-nueFbT7ipKtphcnHIPhVpRWdVs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283652-pizza-cupcakes-VAT-ingredients-1-24d213b9bb1d487fbaeb6197b9c21463.jpg"
      ],
      "image": "assets/images/283652/step_01.webp"
    },
    {
      "text": "Finely chop cherry tomatoes and drain any liquid; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FApy4jRT2l-vUbgR7apSrgxZA6A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283652-pizza-cupcakes-VAT-02-1d5caa58e49f4ca5bbab41434fd2e44e.jpg"
      ],
      "image": "assets/images/283652/step_02.webp"
    },
    {
      "text": "Unroll pizza crust on a floured work surface and roll out thinly into a large rectangle. Using a 4-inch round cookie or biscuit cutter, cut out 8 circles in dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y7-gIkTKSMIw0PJVMP-AtIhE5H8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283652-pizza-cupcakes-VAT-03-fb491f048d1240f48308816d556f9fc5.jpg"
      ],
      "image": "assets/images/283652/step_03.webp"
    },
    {
      "text": "Place dough circles in the prepared muffin cups, pressing dough into the bottom and up the sides of each cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2WIcC8UJVKOtYOiqAZ_k-vCUi2w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283652-pizza-cupcakes-VAT-04-4504e24b9c314dd6bd4d8606e5dd5885.jpg"
      ],
      "image": "assets/images/283652/step_04.webp"
    },
    {
      "text": "Drop 1 teaspoon mozzarella into each cup. Top with 1 tablespoon pizza sauce. then add tomatoes and red onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JPGGRbwjsRawZbdbIsO3reQunms=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283652-pizza-cupcakes-VAT-05-20968b1060074d2cba7dfe7b81b03192.jpg"
      ],
      "image": "assets/images/283652/step_05.webp"
    },
    {
      "text": "Add 1 tablespoon mozzarella to each cup and top with pepperoni. Sprinkle with Italian seasoning, red pepper flakes, and garlic salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fiAeouYOBWp1h_HdWSgDTjhzg8I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283652-pizza-cupcakes-VAT-06-e83e1671623a46d6a49176b2edbc9938.jpg"
      ],
      "image": "assets/images/283652/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until cheese is bubbling and melted, 14 to 15 minutes. Remove from the oven and let cool in the tins, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aVhUWUtlXxJcejPn7jkIvFheFKU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283652-pizza-cupcakes-VAT-07-1f6185f9a49144e2bdc0bcfb8b99fae6.jpg"
      ],
      "image": "assets/images/283652/step_07.webp"
    },
    {
      "text": "Remove pizzas from the tin and serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m5n81NDVMp2VJRJrgqQK1D0i7OA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/283652-pizza-cupcakes-VAT-4x3-173f8a23c58849d496fd29e9ffbd2a48.jpg"
      ],
      "image": "assets/images/283652/step_08.webp"
    }
