  "ingredients": [
    "0.25 cup Dijon mustard",
    "1 tablespoon brown sugar",
    "2 teaspoons minced garlic",
    "0.75 teaspoon kosher salt",
    "0.5 teaspoon freshly ground black pepper",
    "0.5 teaspoon freeze-dried dill",
    "2 (12 ounce) skin on frozen salmon fillets"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 390 degrees F (199 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together mustard, brown sugar, garlic, salt, pepper, and dill in a small bowl until well combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place frozen salmon, flesh-side down, in the air fryer basket and cook in the preheated air fryer for 6 minutes. Flip salmon, brush 1/4 of the sauce over each fillet, and continue cooking for 6 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush remaining sauce over fillets and cook until fish flakes easily with a fork, 3 to 4 more minutes",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
