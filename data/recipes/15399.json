  "title": "Cinnamon Coffee Cake",
  "description": "This cinnamon coffee cake recipe is perfectly spiced and easy to make with cake mix and instant puddings. Great for breakfast, brunch, or dessert.",
  "authors": [
    "Janis Woods"
  ],
  "date_published": "1998-11-13T16:04:45-05:00",
