  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "1 (3.4 ounce) package instant vanilla pudding mix",
    "1 (3.4 ounce) package instant butterscotch pudding mix",
    "4 eggs",
    "1 cup water",
    "1 cup vegetable oil",
    "1 cup packed brown sugar",
    "1 tablespoon ground cinnamon",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e0IGfMzEouUs7aDUTlMY6Q5I-v8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15399-cinnamon-coffee-cake-ii-VAT-step-01-5713dad276da499582ded52c53842116.jpg"
      ],
      "image": "assets/images/15399/step_01.webp"
    },
    {
      "text": "Stir cake mix, vanilla pudding mix, and butterscotch pudding mix together in a medium bowl. Add eggs, oil, and water; mix until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mVD51JbJEYJwlyq2mDOahF0wNew=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15399-cinnamon-coffee-cake-ii-VAT-step-02-f8ae506795184b09ab3ec989f1d9e215.jpg"
      ],
      "image": "assets/images/15399/step_02.webp"
    },
    {
      "text": "Stir brown sugar, cinnamon, and nuts together in a separate bowl. Pour half of the batter into the pan, spread evenly. Sprinkle with half of the nut mixture. Cover with remaining batter and sprinkle with remaining nut mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/x0ARqixWHFtrKDSGW1bIjI8F8Gw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15399-cinnamon-coffee-cake-ii-VAT-step-03-3ffbb04861ca48399d2a09ad4ae52f0d.jpg"
      ],
      "image": "assets/images/15399/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 20 minutes, then turn the oven down to 325 degrees F (165 degrees C) and bake until a toothpick inserted into the center comes out clean, an additional 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zdXnXLnufWIjnkaCwaPXXAlWIhc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15399-cinnamon-coffee-cake-ii-VAT-step-04-8e058d786abf4c43a14155af3ad782f3.jpg"
      ],
      "image": "assets/images/15399/step_04.webp"
    }
  ],
