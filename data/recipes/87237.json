  "ingredients": [
    "4 pounds bluefish fillets",
    "1 cup orange juice",
    "0.25 cup fresh lime juice",
    "0.25 cup fresh lemon juice",
    "0.25 cup olive oil",
    "1 tablespoon dry white wine",
    "kosher salt and ground black pepper to taste",
    "0.25 cup citrus flavored seafood rub"
  ],
  "steps": [
    {
      "text": "Place fish fillets into a large bowl. Pour in orange juice, lime juice, lemon juice, olive oil, and white wine. Season with salt, pepper, and seafood rub. Stir to blend and coat fish. Leave squeezed lemon and lime halves in the bowl too. Marinate for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a grill for high heat. When the grill is hot, oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fish fillets on the grill, and discard the marinade. Cook for 4 minutes on each side, or until fish flakes with a fork. Transfer to a serving platter, and remove the dark blue part of the fish before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
