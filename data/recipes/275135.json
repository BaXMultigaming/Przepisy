  "ingredients": [
    "2 slices bacon",
    "0.66666668653488 cup diced cherry tomatoes",
    "1 tablespoon shredded Parmesan cheese",
    "2 leaves fresh basil, minced",
    "salt and ground black pepper to taste",
    "2 thick slices crusty bread",
    "2 tablespoons olive oil",
    "0.25 cup ricotta cheese"
  ],
  "steps": [
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Drain bacon slices on paper towels. When cool enough to handle, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cherry tomatoes, Parmesan cheese, basil, salt, and pepper in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a cast iron grill pan over medium-high heat. Brush bread slices with olive oil on both sides. Cook in grill pan until grill marks appear and bread is toasted, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread toasted bread with ricotta cheese. Top with tomato mixture and sprinkle with bacon. Cut each toast in half and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
