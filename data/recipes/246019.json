  "ingredients": [
    "1 (12 ounce) box Barilla Gluten Free Penne",
    "4 tablespoons extra-virgin olive oil",
    "4 boneless, skinless chicken thighs",
    "1 Vidalia onion, cut julienne style",
    "1 red bell pepper, cut julienne style",
    "6 domestic mushrooms, quartered",
    "3 cloves garlic, chopped",
    "1 tablespoon Cajun seasoning",
    "0.5 cup dry white wine",
    "0.5 cup heavy cream",
    "0.5 cup Parmesan cheese, grated",
    "Salt and black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile in a hot skillet, brown the chicken in olive oil over high heat for approximately 5 minutes. Add onion, bell pepper, mushrooms, garlic and Cajun seasoning and saute for 3 additional minutes. Stir in wine then season with salt and pepper; reduce liquid by half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cream and bring to simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook pasta according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain and toss with sauce and stir in cheese before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
