  "ingredients": [
    "2 cups finely shredded Cheddar cheese",
    "1 (11 ounce) can Mexican-style corn (such as Green Giant®), drained",
    "1 (11 ounce) can white shoepeg corn, drained",
    "1 (11 ounce) can corn niblets, drained",
    "1 bunch green onions, thinly sliced",
    "0.75 cup mayonnaise",
    "0.75 cup sour cream",
    "1 (4 ounce) can diced green chile peppers, drained",
    "1 (4 ounce) can sliced jalapeno peppers, drained",
    "1 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Combine Cheddar cheese, Mexican-style corn, shoepeg corn, corn niblets, green onions, mayonnaise, sour cream, green chiles, jalapeños, and garlic powder in a large bowl.",
