  "ingredients": [
    "1 cup cooked white beans, drained",
    "2 cups milk",
    "0.33333334326744 cup white sugar",
    "1 egg, beaten",
    "1.5 tablespoons orange zest",
    "1.5 tablespoons ground ginger",
    "1.5 teaspoons cornstarch",
    "2 tablespoons butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Process beans and milk together in a blender until smooth; pour into a small saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, egg, orange zest, ginger, and cornstarch into the bean mixture until smooth; place over medium heat and cook, stirring constantly, until thickened, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter and vanilla extract into the thickened mixture until the butter is melted; pour into 4 dessert cups and refrigerate until chilled, at least 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
