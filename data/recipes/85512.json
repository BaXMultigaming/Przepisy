  "ingredients": [
    "1 (16 ounce) pork tenderloin",
    "1 tablespoon olive oil",
    "2 tablespoons all-purpose flour",
    "2 cups Russian-style salad dressing",
    "0.25 teaspoon honey",
    "1 (1 ounce) envelope dry onion soup mix"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the olive oil in a large skillet over medium-high heat. Coat the pork tenderloin with flour, and brown in the hot skillet on all sides. Transfer to a casserole dish. In a medium bowl, mix together the salad dressing, honey and onion soup mix. Slather the tenderloin with this mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the dish, and bake for 1 1/2 hours in the preheated oven. Pork should be fork tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
