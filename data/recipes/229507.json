  "ingredients": [
    "1.25 cups mayonnaise",
    "0.625 cup Thai sweet chili sauce",
    "7.5 dashes chile-garlic sauce (such as Sriracha®), or to taste",
    "2.5 pounds peeled and deveined shrimp",
    "0.5 cup cornstarch, or as needed",
    "2 cups vegetable oil for frying, or as needed",
    "4 lettuce leaves",
    "0.25 cup chopped green onion, or to taste"
  ],
  "steps": [
    {
      "text": "Stir mayonnaise and chili sauce together in a large bowl. Add chile-garlic sauce and stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread cornstarch into a wide dish. Press shrimp into cornstarch to coat in a thin layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Deep fry shrimp in batches until meat is no longer transparent in the center, about 5 minutes per batch; drain on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise sauce and shrimp in the large bowl; stir to coat shrimp in sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a bowl with lettuce leaves. Pile shrimp into bowl and garnish with green onion to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
