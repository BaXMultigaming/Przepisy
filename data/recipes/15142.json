  "title": "Award-Winning Peaches and Cream Pie",
  "description": "This award-winning peaches and cream pie recipe has pudding mix in the crust, a layer of canned peaches, and another layer of sweetened cream cheese.",
  "authors": [
    "Debbi Borsick"
  ],
  "date_published": "1999-07-08T12:56:19-04:00",
