  "ingredients": [
    "0.75 cup all-purpose flour",
    "1 (3 ounce) package cook-and-serve vanilla pudding (not instant)",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 cup milk",
    "3 tablespoons butter, softened",
    "1 large egg",
    "1 (29 ounce) can sliced peaches in heavy syrup",
    "1 tablespoon white sugar",
    "1 teaspoon ground cinnamon",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup white sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ltOsiMsrJqTX-RgGiOz9mk64Ayc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15142-award-winning-peaches-and-cream-pie-DDMFS-4x3-step-01-be880edc1af04a8082ac8ae265b3c570.jpg"
      ],
      "image": "assets/images/15142/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 10-inch deep-dish pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QYWXl_qnRUd0JmLBIxdVJon45_s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15142-award-winning-peaches-and-cream-pie-DDMFS-4x3-step-2-2f53eb7353b740eb99f5a8057d0d09d7.jpg"
      ],
      "image": "assets/images/15142/step_02.webp"
    },
    {
      "text": "Whisk flour, pudding mix, baking powder, and salt together in a bowl until evenly combined; add milk, butter, and egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DEaSfsZ_iM9eicmb2_8gLT0cVvo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15142-award-winning-peaches-and-cream-pie-DDMFS-4x3-step-3-9d8fe6e7f8504ac9b850777564c82f36.jpg"
      ],
      "image": "assets/images/15142/step_03.webp"
    },
    {
      "text": "Beat crust mixture with an electric mixer for 2 minutes; transfer to the prepared pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kSgAkOuu_0xFFKHfyKNh51pQFS4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15142-award-winning-peaches-and-cream-pie-DDMFS-4x3-step-4-33a50ae6d22d408d85bbd1195c9e3df5.jpg"
      ],
      "image": "assets/images/15142/step_04.webp"
    },
    {
      "text": "Drain peaches, reserving 3 tablespoons syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f6e8tJXbyyBNdWqRZqhkRk426IA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15142-award-winning-peaches-and-cream-pie-DDMFS-4x3-step-5-43766c69ee63474d9df877ea627ae35e.jpg"
      ],
      "image": "assets/images/15142/step_05.webp"
    },
    {
      "text": "Combine 1 tablespoon sugar and cinnamon in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5ok2cb_C2r45Vfd8Fr3Nn8dx1Ao=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15142-award-winning-peaches-and-cream-pie-DDMFS-4x3-step-6-d2c6fe50867c43a289fd4ba402f5234a.jpg"
      ],
      "image": "assets/images/15142/step_06.webp"
    },
    {
      "text": "Beat cream cheese in separate bowl with an electric mixer until fluffy; add ½ cup sugar and reserved syrup and beat for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zqp2PwwRPGclOCPDDAZMLQMhDvM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15142-award-winning-peaches-and-cream-pie-DDMFS-4x3-step-7-2b4b1054f0e44964ab9e8e42b454e882.jpg"
      ],
      "image": "assets/images/15142/step_07.webp"
    },
    {
      "text": "Arrange sliced peaches over crust mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T1a5izuCtQw7pq_ZV-l0kToTjUw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15142-award-winning-peaches-and-cream-pie-DDMFS-4x3-step-8-9bddc147975143e5aed17bce560e9068.jpg"
      ],
      "image": "assets/images/15142/step_08.webp"
    },
    {
      "text": "Spoon cream cheese mixture over peaches to within 1 inch of pie plate edge; sprinkle cinnamon sugar over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/heAYbC7zrxNHisQwLTl0AFE33Q4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15142-award-winning-peaches-and-cream-pie-DDMFS-4x3-step-10-93e2a7a93b3d49b6ab02368099e50a2f.jpg"
      ],
      "image": "assets/images/15142/step_09.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C9zjkmam_T7W_FZ2azyLOIz0rSE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15142-award-winning-peaches-and-cream-pie-DDMFS-4x3-step-11-27e3432e385f483aace8c74ee0453aef.jpg"
      ],
      "image": "assets/images/15142/step_10.webp"
    },
    {
      "text": "Set aside on the counter for 20 minutes, then chill in the refrigerator before serving for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Mm25mf8KzfFpfJhago7bbUn_Bho=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15142-award-winning-peaches-and-cream-pie-DDMFS-4x3-6a1aacdf941144b49709090a3d9a0e6f.jpg"
      ],
      "image": "assets/images/15142/step_11.webp"
    }
