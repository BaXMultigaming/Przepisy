  "ingredients": [
    "3 skinless, boneless chicken breasts, cubed",
    "4 small (3 ounce) potatoes, peeled and cubed",
    "1 red bell pepper, cored and sliced into 1/4-inch strips",
    "0.5 onion, chopped",
    "2 cups chicken broth",
    "2 tablespoons mild curry powder",
    "1 teaspoon red curry paste",
    "1 teaspoon ground cumin",
    "1 teaspoon salt, or more to taste",
    "0.5 teaspoon cayenne pepper, or to taste",
    "1 (14 ounce) can coconut milk",
    "freshly ground black pepper",
    "0.25 cup chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Combine chicken, potatoes, bell pepper, and onion in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine chicken broth, curry powder, curry paste, cumin, 1 teaspoon salt, and cayenne pepper in a bowl; stir into slow cooker with a wooden spoon until combined. Cover slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until chicken is tender on Low for 4 to 5 hours or High for 2 to 3 hours. Add coconut milk 15 minutes before cooking time ends; cook until heated through. Season with salt and black pepper; sprinkle with chopped cilantro to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
