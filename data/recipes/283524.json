  "ingredients": [
    "2 tablespoons olive oil",
    "2 Smoked link sausage, pork",
    "1 (16 ounce) package imitation crabmeat, chopped",
    "1 tablespoon margarine",
    "3 large eggs, lightly beaten",
    "2 cups hot cooked white rice",
    "0.25 cup Worcestershire sauce",
    "1 teaspoon seasoning salt",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon garlic powder",
    "1 teaspoon dried parsley"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large skillet over medium heat. Add sausage and fry for 5 minutes. Add imitation crab and cook for another 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Move imitation crab and sausage mixture to the edges of the pan. Melt margarine in the center of the pan. Add eggs and cook, stirring with a spatula, until eggs are soft scrambled, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked rice, Worcestershire sauce, seasoning salt, salt, pepper, garlic powder, and parsley flakes. Mix until combined and cook until hot, 3 to 5 minutes. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
