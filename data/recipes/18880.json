  "ingredients": [
    "1 pound ground turkey",
    "2 (7.75 ounce) cans Mexican-style hot tomato sauce (such as El Pato®)",
    "1 (15.25 ounce) can whole kernel corn, drained",
    "0.5 small onion, diced",
    "1 (16 ounce) can fat-free refried beans",
    "6 (10 inch) flour tortillas",
    "1 (16 ounce) container fat-free sour cream",
    "0.75 cup shredded reduced-fat Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Brown ground turkey in a large skillet over medium-high heat. Stir in tomato sauce, corn, and onion. Reduce heat to medium; simmer, stirring occasionally, until liquids reduce, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat beans in a separate medium skillet over medium-low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tortillas over a gas stovetop burner for 1 to 2 minutes, flipping a few times.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill tortillas with beans, turkey mixture, sour cream, and cheese; serve while still warm.",
      "section": null,
      "name": null,
      "url": null,
