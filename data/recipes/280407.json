  "ingredients": [
    "0.5 cup milk",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "4 stale bagels, split",
    "1 tablespoon powdered sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Beat milk, eggs, vanilla extract, cinnamon, and nutmeg together in a large, flat container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bagels, insides-down, into the egg mixture. Let sit for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat. Add bagel slices and cook, working in batches if needed, until browned on both sides, about 5 minutes. Sprinkle with powdered sugar and serve warm.",
      "section": null,
      "name": null,
      "url": null,
