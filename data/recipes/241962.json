  "ingredients": [
    "1 cup drained and rinsed canned navy beans",
    "2 tablespoons tahini",
    "1 tablespoon chopped onion",
    "1 tablespoon white miso paste",
    "1 tablespoon nutritional yeast flakes",
    "0.5 cup almond milk",
    "1.5 tablespoons fresh lemon juice",
    "1 pinch salt",
    "1 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Blend navy beans, tahini, onion, miso paste, and nutritional yeast in a food processor until smooth. Add almond milk, lemon juice, salt, and cayenne pepper; process until creamy.",
