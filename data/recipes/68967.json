  "ingredients": [
    "1 eggplant, peeled and diced",
    "1.5 cups shredded Cheddar cheese",
    "1 cup dry bread stuffing mix",
    "1 clove garlic, crushed",
    "2 tablespoons diced onion",
    "1 egg, lightly beaten",
    "1 teaspoon dried Italian seasoning",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uGPZgSQ20pRubPo12NtTqUBuufU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68967-cheesy-eggplant-casserole-recipe-VAT-Step-01-74dcb8d2e57647d19d151177268e3dad.jpg"
      ],
      "image": "assets/images/68967/step_01.webp"
    },
    {
      "text": "Place diced eggplant in a medium microwave-safe dish. Cook in the microwave until tender, stirring once, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mzYCqEgG9GajTR8M2U0PzOwwoF4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68967-cheesy-eggplant-casserole-recipe-VAT-Step-02-b47c7fcff82743849002075d95d92970.jpg"
      ],
      "image": "assets/images/68967/step_02.webp"
    },
    {
      "text": "Transfer into a 9-inch square baking dish. Mix in 1/2 cup Cheddar cheese, stuffing mix, garlic, onion, and egg. Season with Italian seasoning, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ogsc1xdQSh_5bDIrtUO3BGTFMpU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68967-cheesy-eggplant-casserole-recipe-VAT-Step-03-7b7a0edf99e54dd4bc4076125576ed17.jpg"
      ],
      "image": "assets/images/68967/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/202lW7mFvO525_z-wXM2zkI1eko=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68967-cheesy-eggplant-casserole-recipe-VAT-Step-04-a9a8fb606e5a491ead838f78d9264786.jpg"
      ],
      "image": "assets/images/68967/step_04.webp"
    },
    {
      "text": "Top with remaining cheese and continue baking until cheese is bubbly and lightly browned, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TrBbU5iKvAgSUIQMT8HfK6C-rv0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/68967-cheesy-eggplant-casserole-recipe-VAT-Step-05-245d50dcf8d0495a8c29a40ca0d11108.jpg"
