  "ingredients": [
    "0.25 cup olive oil, or as needed",
    "1 large zucchini, sliced into 1/4-inch pieces",
    "0.125 teaspoon red pepper flakes",
    "0.125 teaspoon garlic salt, or to taste",
    "0.125 teaspoon onion salt, or to taste",
    "0.25 cup grated Romano cheese",
    "1 cup tomato sauce",
    "1 cup shredded Mexican 4-cheese blend"
  ],
  "steps": [
    {
      "text": "Heat enough olive oil to coat the bottom of a large skillet over medium heat. Add zucchini slices; season with pepper flakes, garlic salt, and onion salt. Cook until slices are slightly softened, 3 to 4 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle each slice with Romano cheese and a spoonful of tomato sauce; cook until cheese just begins to melt, 2 to 3 minutes. Top tomato sauce with a layer of Mexican cheese blend; cover the skillet and cook until cheese has melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
