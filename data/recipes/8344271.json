  "ingredients": [
    "1 tablespoon extra-virgin olive oil",
    "1.5 teaspoons butter",
    "1 clove garlic, minced",
    "4 medium purple radishes, sliced",
    "1 bunch radish greens, washed and chopped",
    "0.25 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Heat olive oil and butter in a saucepan over medium-low heat until butter melts. Add garlic and sauté until softened and fragrant, about 1 minute. Add radish slices and sauté to bring out their sweetness, 1 to 2 minutes. Add greens and sauté until wilted, 1 to 2 minutes.",
      "section": null,
      "name": null,
