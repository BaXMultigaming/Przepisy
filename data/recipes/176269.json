  "ingredients": [
    "0.5 cup all-purpose flour",
    "0.5 cup brown sugar",
    "0.5 cup shredded Cheddar cheese",
    "0.25 cup butter",
    "6 cups peeled and sliced pears",
    "1 tablespoon fresh lemon juice",
    "0.5 cup brown sugar",
    "3 tablespoons cornstarch",
    "0.75 teaspoon ground cinnamon",
    "unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 1/2 cup brown sugar, and Cheddar cheese in a bowl; cut in butter until mixture resembles coarse crumbs. Set crumble topping aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss pears and lemon juice together in a large bowl. Combine 1/2 cup brown sugar, cornstarch, and cinnamon in a separate bowl; stir into pears and toss to coat. Transfer pear filling to pie crust; sprinkle with crumble topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is golden brown, about 45 minutes.",
      "section": null,
