  "ingredients": [
    "1 (16 ounce) package penne pasta",
    "2 tablespoons olive oil",
    "0.25 cup chopped red onion",
    "1 tablespoon chopped garlic",
    "0.25 cup white wine",
    "2 (14.5 ounce) cans diced tomatoes",
    "1 pound shrimp, peeled and deveined",
    "1 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oil in a skillet over medium heat. Stir in onion and garlic, and cook until onion is tender. Mix in wine and tomatoes, and continue cooking 10 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix shrimp into the skillet, and cook 5 minutes, or until opaque. Toss with pasta and top with Parmesan cheese to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
