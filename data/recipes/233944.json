  "ingredients": [
    "2.5 pounds Yukon Gold potatoes, peeled and cubed",
    "0.5 cup milk",
    "1 (4 ounce) package crumbled feta cheese",
    "2 tablespoons butter",
    "3 cloves garlic, minced",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon dried rosemary",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, about 20 minutes. Drain and return to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash potatoes with a potato masher until smooth. Stir in milk, feta, butter, garlic, oregano, and rosemary. Season with salt and pepper.",
