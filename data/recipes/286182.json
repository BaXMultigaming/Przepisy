  "ingredients": [
    "cooking spray",
    "4 (4 ounce) ahi tuna steaks",
    "1 tablespoon soy sauce, or to taste",
    "1 teaspoon honey, or to taste",
    "1 medium apple - peeled, cored, and chopped",
    "2 ounces minced fresh ginger, or to taste"
  ],
  "steps": [
    {
      "text": "Spray a large skillet with cooking spray; heat over medium-high heat. Add tuna steaks to the hot skillet and sear 90 seconds on each side. Remove tuna steaks to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium-low. Whisk soy sauce and honey together in small bowl. Add to the skillet with apple and ginger. Saute until tender, 5 to 10 minutes. Serve sauce on the side or on top of tuna steaks.",
      "section": null,
