  "ingredients": [
    "1 pound soybean sprouts",
    "0.25 cup sesame oil",
    "2 tablespoons soy sauce",
    "2 tablespoons Korean chile powder",
    "2 teaspoons sesame seeds",
    "1.5 teaspoons garlic, minced",
    "0.25 cup chopped green onion",
    "2 teaspoons rice wine vinegar, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EIPZpfWOIVqWWPi369kbu9oATNw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/192812-kongnamool-korean-soybean-sprouts-step-01-4x3-fc942d3f11a14da798bb4de99433b57f.jpg"
      ],
      "image": "assets/images/192812/step_01.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil; add bean sprouts and cook, uncovered, until tender yet still crisp, about 15 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p9vi3HvstwgPlsTgP_rWB4WStpk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/192812-kongnamool-korean-soybean-sprouts-step-02-4x3-f4d025c3ef0d4693b5ac71ba1be41aa0.jpg"
      ],
      "image": "assets/images/192812/step_02.webp"
    },
    {
      "text": "Drain in a colander, then immediately immerse in ice water for several minutes to stop the cooking process. Drain well and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NEWiYQzdN0lla-0hSn9whZ23yF8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/192812-kongnamool-korean-soybean-sprouts-step-03-4x3-67ec1ff3438747ecbf3e18f2474a274a.jpg"
      ],
      "image": "assets/images/192812/step_03.webp"
    },
    {
      "text": "Whisk sesame oil, soy sauce, Korean chile powder, sesame seeds, and garlic together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a46cemZc79eh3wFuFkUbt6kAcDI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/192812-kongnamool-korean-soybean-sprouts-step-04-4x3-e030de631ae84de19708931848c84afc.jpg"
      ],
      "image": "assets/images/192812/step_04.webp"
    },
    {
      "text": "Stir in bean sprouts and toss to coat; sprinkle with green onions and season with rice wine vinegar. Refrigerate before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WgNrR_FXtRDoq7xBNnNspwueqm0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/192812-kongnamool-korean-soybean-sprouts-step-05-4x3-00214aac148945e1abc539d0085f9a8d.jpg"
