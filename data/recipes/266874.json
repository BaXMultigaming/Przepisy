  "ingredients": [
    "6 egg yolks",
    "1 tablespoon water",
    "1.5 cups all-purpose flour",
    "1 cup butter, softened",
    "0.75 cup white sugar",
    "2 tablespoons cornstarch"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1 teaspoon egg yolk and water in a small bowl. Set aside for glazing the cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining egg yolks, flour, butter, sugar, and cornstarch in a large bowl. Mix with an electric mixer until dough is stiff and sticky, similar to cookie dough. Knead dough a little bit to bring it together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press dough into the prepared pan with your hands. Brush glaze on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Reduce temperature to 350 degrees F (175 degrees C). Continue baking until golden brown, about 25 minutes more. Cool for 10 minutes. Slice cake crosswise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
