  "ingredients": [
    "2 (9 inch) unbaked pie crust",
    "4 eggs, beaten",
    "0.75 cup white sugar",
    "0.25 cup packed brown sugar",
    "1 tablespoon all-purpose flour",
    "0.5 cup butter, softened",
    "1 cup light corn syrup",
    "1 teaspoon vanilla extract",
    "1 cup semi-sweet chocolate chips",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, blend together the eggs, white sugar, brown sugar, flour, butter, corn syrup and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the chocolate chips and pecans; mix well and pour into pie crusts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 40 to 45 minutes.",
