  "ingredients": [
    "12 egg yolks",
    "2 cups heavy whipping cream",
    "0.5 teaspoon vanilla extract",
    "1 (15 ounce) can pumpkin puree",
    "0.5 cup light brown sugar",
    "0.5 cup white sugar",
    "0.25 cup maple syrup",
    "0.25 cup evaporated milk",
    "1 teaspoon pumpkin pie spice",
    "0.25 teaspoon ground cinnamon",
    "1 pinch salt",
    "2 cups milk",
    "1 tablespoon brandy, or as needed"
  ],
  "steps": [
    {
      "text": "Place egg yolks in a large bowl and beat using an electric blender until pale yellow, about 5 minutes. Add whipping cream and vanilla extract; mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin puree, brown sugar, white sugar, maple syrup, evaporated milk, pumpkin pie spice, cinnamon, and salt in a saucepan over medium heat. Cook and stir until sugars are dissolved, 5 to 7 minutes. Remove from heat and let cool slightly. Stir in milk and mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly pour pumpkin mixture into the egg mixture and stir together until well combined. Pour eggnog through a wire-mesh strainer into a container and refrigerate overnight. Pour 1 tablespoon brandy into each cup of eggnog.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
