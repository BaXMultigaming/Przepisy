  "title": "Pumpkin Pie Eggnog",
  "description": "Have you ever had pumpkin pie-flavored eggnog? Try making this delicious holiday version of the popular drink for Thanksgiving or Christmas.",
  "authors": [
    "Bobbie Susan"
  ],
  "date_published": "2020-06-19T00:33:33-04:00",
