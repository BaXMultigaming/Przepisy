  "ingredients": [
    "2.25 cups bread flour",
    "1 cup milk",
    "0.75 teaspoon salt",
    "0.25 teaspoon onion salt",
    "2 tablespoons margarine",
    "0.5 cup sauerkraut - drained, rinsed and finely chopped",
