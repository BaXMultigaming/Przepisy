  "ingredients": [
    "0.66666668653488 cup evaporated milk",
    "1.6666667461395 cups white sugar",
    "0.5 teaspoon salt",
    "16 large marshmallows",
    "1 cup semisweet chocolate chips",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "In a medium saucepan over medium heat, combine evaporated milk, sugar and salt. Bring to a boil, then remove from heat and stir in marshmallows, chocolate chips, vanilla and nuts until marshmallows are melted. Pour into an 8x8 inch dish. Let cool completely before cutting into squares.",
