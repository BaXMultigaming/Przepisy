  "ingredients": [
    "1 tablespoon olive oil",
    "1 cup chopped carrots",
    "0.5 cup chopped onion",
    "4 cloves garlic, minced",
    "5 habanero peppers, stemmed",
    "1 medium tomato",
    "0.25 cup water",
    "0.25 cup lime juice",
    "0.25 cup white vinegar",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a saucepan over medium heat. Add carrots, onion, and garlic; cook and stir until onion is translucent, about 5 minutes. Remove from heat.",
