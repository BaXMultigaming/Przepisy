  "ingredients": [
    "2 eggs, beaten",
    "1.75 cups skim milk",
    "0.25 cup canola oil",
    "0.25 cup unsweetened applesauce",
    "1 teaspoon vanilla extract",
    "1 cup whole wheat pastry flour",
    "0.5 cup flax seed meal",
    "0.25 cup wheat germ",
    "0.25 cup all-purpose flour",
    "4 teaspoons baking powder",
    "1 tablespoon sugar",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "In a large bowl, whisk together the eggs, milk, oil, applesauce, and vanilla. Beat in whole wheat pastry flour, flax seed meal, wheat germ, all-purpose flour, baking powder, sugar, and salt until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat a waffle iron, and coat with cooking spray. Pour batter into waffle iron in batches, and cook until crisp and golden brown.",
