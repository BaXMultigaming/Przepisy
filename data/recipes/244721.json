  "ingredients": [
    "1 (1 ounce) packet Hidden Valley® Original Ranch® Salad Dressing & Seasoning Mix",
    "2 pounds lean ground beef",
    "1 small yellow onion, peeled and minced",
    "1 teaspoon freshly ground black pepper",
    "0.5 cup seasoned dry bread crumbs",
    "6 hamburger buns, lightly toasted",
    "6 leaves butter lettuce, or more as needed",
    "1 medium tomato, sliced"
  ],
  "steps": [
    {
      "text": "Preheat the grill or broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the beef, seasoning mix, onion, and pepper and mix well. If desired, add bread crumbs to meat mixture, too.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With wet hands shape the meat mixture into 6 patties, each about 1-inch thick. Grill the burgers for 5 to 7 minutes per side or until an internal temperature of 165 degrees F is reached and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve the burgers topped with the lettuce and tomato.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
