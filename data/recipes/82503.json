  "ingredients": [
    "6 sweet potatoes, cut into French fries",
    "2 tablespoons canola oil",
    "3 tablespoons taco seasoning mix",
    "0.25 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a plastic bag, combine the sweet potatoes, canola oil, taco seasoning, and cayenne pepper. Close and shake the bag until the fries are evenly coated. Spread the fries out in a single layer on two large baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes, or until crispy and brown on one side. Turn the fries over using a spatula, and cook for another 30 minutes, or until they are all crispy on the outside and tender inside. Thinner fries may not take as long.",
      "section": null,
      "name": null,
