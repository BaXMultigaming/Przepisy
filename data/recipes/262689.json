  "ingredients": [
    "1.75 cups self-rising flour",
    "1 cup unsweetened cocoa powder",
    "0.125 teaspoon salt",
    "2 cups white sugar",
    "1 cup water",
    "2 eggs",
    "0.25 cup vanilla Greek yogurt",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, cocoa powder, and salt together in a bowl. Mix sugar, water, eggs, Greek yogurt, and vanilla extract together in another bowl using an electric mixer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gradually add flour-cocoa mixture into the bowl with yogurt mixture. Mix until well blended. Pour batter into two 9-inch cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the centers comes out clean, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
