  "ingredients": [
    "0.5 cup unsalted butter, softened",
    "3 ounces cream cheese, softened",
    "0.5 cup white sugar",
    "1 large egg yolk",
    "1 tablespoon freshly grated lemon zest",
    "1 teaspoon lemon extract",
    "1.75 cups all-purpose flour",
    "0.5 teaspoon salt",
    "5 drops yellow food coloring",
    "60 cinnamon red hot candies, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and cream cheese together in a bowl. Add sugar and beat until light and fluffy. Add egg yolk, lemon peel, and lemon extract and beat well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour and salt together in a bowl. Add to the bowl with the butter mixture in 3 additions, mixing well after each. Add food coloring and mix in thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press cookies 1 inch apart onto the prepared baking sheet using a cookie press fitted with a flower disc. Press 1 red hot cinnamon candy into the center of each cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until just starting to turn golden brown on the edges, 14 to 16 minutes; do not overbake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cookies to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
