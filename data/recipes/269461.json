  "ingredients": [
    "1 cup soy milk",
    "0.33333334326744 cup vegetable oil",
    "0.5 teaspoon white vinegar",
    "0.5 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "2 tablespoons white sugar, or to taste",
    "1.5 teaspoons baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine soy milk, oil, vinegar, and vanilla extract in a large bowl. Let sit until milk starts to curdle, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, and salt in a separate bowl. Make a well in the center of the dry ingredients and add the soy milk mixture. Whisk together until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a greased frying pan over medium heat. Fry pancakes until edges are brown and bubbles form in the center, 3 to 4 minutes. Flip and cook about 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
