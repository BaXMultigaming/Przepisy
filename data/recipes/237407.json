  "ingredients": [
    "1 cup orange juice",
    "0.5 cup soy sauce",
    "0.5 cup honey",
    "0.33333334326744 cup balsamic vinegar",
    "1 teaspoon dry mustard",
    "1 teaspoon paprika",
    "0.5 teaspoon hot sauce",
    "0.25 teaspoon allspice",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground ginger",
    "3 cloves garlic, peeled",
    "1 (4.5 pound) pork shoulder roast",
    "2 tablespoons honey, or to taste",
    "0.5 cup brown sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Whisk orange juice, soy sauce, 1/2 cup honey, balsamic vinegar, mustard, paprika, hot sauce, allspice, cloves, cinnamon, and ginger together in the bottom of a slow cooker; add garlic. Lay the pork shoulder roast into the orange juice mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 10 to 12 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn roast over in the slow cooker, drizzle more honey over the roast, and pack brown sugar atop the pork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue cooking another 10 to 12 hours. Shred the pork with a pair of forks in the slow cooker and mix with the liquid until even in texture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
