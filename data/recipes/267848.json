  "ingredients": [
    "1 (9 inch) unbaked deep dish pie crust",
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup white sugar",
    "4 eggs, divided",
    "1 teaspoon vanilla extract",
    "1.25 cups chopped pecans",
    "1 (12 ounce) jar caramel ice cream topping"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a 9-inch deep dish pie pan with the crust; trim and flute the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, sugar, 1 egg, and vanilla extract together in a small bowl until smooth. Spread into pie crust and sprinkle pecans on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk remaining eggs in a small bowl; gradually whisk in caramel topping until blended. Pour on top of cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool on a wire rack for 1 hour. Refrigerate at least 4 hours to overnight before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
