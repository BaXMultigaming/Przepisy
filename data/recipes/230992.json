  "ingredients": [
    "1 (2 pound) loaf processed cheese (such as Velveeta®), cubed",
    "1 pound bulk spicy pork sausage",
    "1 (24 ounce) jar hot salsa",
    "0.5 cup hot pepper sauce (such as Frank's RedHot®)",
    "3 large jalapeno peppers, chopped"
  ],
  "steps": [
    {
      "text": "Melt processed cheese in a slow cooker on Low.",
