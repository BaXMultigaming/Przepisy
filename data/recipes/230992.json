      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir pork sausage in a large skillet over medium heat until browned and crumbly, about 10 minutes; drain excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sausage into processed cheese in the slow cooker. Stir in salsa, hot sauce, and jalapeño peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 2 hours; serve hot.",
