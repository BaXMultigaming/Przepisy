  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 cup brown sugar",
    "3 bananas, mashed",
    "2 large eggs",
    "0.25 cup milk",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.5 cup wheat bran",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a muffin pan or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together butter and brown sugar in a large bowl with an electric mixer on medium speed until fluffy. Add mashed bananas, eggs, milk, and vanilla; mix well. Stir in flour, bran, baking powder, baking soda, and salt; blend just until moistened. Stir in walnuts. Pour batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 20 to 25 minutes. Cool muffins in the pan for 5 minutes, then transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
