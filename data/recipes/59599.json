  "ingredients": [
    "5 tablespoons butter",
    "1 apple - peeled, cored, and chopped",
    "1 small onion, chopped",
    "1 celery stalk, diced",
    "0.5 cup chopped walnuts",
    "1 cup unsweetened applesauce",
    "1.5 cups water",
    "5 cups coarse dry breadcrumbs",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground ginger",
    "Kosher salt and fresh ground pepper to taste",
    "1 (3 pound) boneless rolled pork loin roast"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt the butter in a medium saucepan over medium heat. Stir in the apple, onion, celery, and walnuts, and cook 5 minutes, until vegetables are tender. Mix in the applesauce, water, and breadcrumbs. Cook and stir until the breadcrumbs have absorbed the liquid. Season with cinnamon, kosher salt, cloves, nutmeg, and ginger.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unroll the pork roast, and place in a baking dish. Season with salt and pepper to taste. Spoon the stuffing mixture over the roast. Arrange any excess stuffing around the roast. Roll the roast so that the fatty side is on top, and tie with kitchen twine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 45 to 50 minutes in the preheated oven, to an internal temperature of 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
