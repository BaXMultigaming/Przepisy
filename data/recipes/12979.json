  "ingredients": [
    "0.33333298563957 cup dried apricots",
    "1 onion, chopped",
    "2 cloves garlic, minced",
    "3 tablespoons olive oil",
    "5 cups chicken stock",
    "1.5 cups red lentils",
    "3 roma (plum) tomatoes - peeled, seeded and chopped",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon dried thyme",
    "salt to taste",
    "2 tablespoons fresh lemon juice"
  ],
  "steps": [
    {
      "text": "Sauté apricots, onion, and garlic in olive oil, about 5 minutes. Add chicken stock and lentils and bring to a boil. Reduce the heat and simmer for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomatoes and season with cumin, thyme, salt, and pepper to taste. Simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in lemon juice. Purée 1/2 of the soup in a blender, then return to the pot. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
