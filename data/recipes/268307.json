  "ingredients": [
    "4 (5 ounce) mild white fish fillets",
    "1 lemon, juiced",
    "salt to taste",
    "4 tablespoons all-purpose flour",
    "1 teaspoon Chinese five-spice powder",
    "4 tablespoons canola oil",
    "1 tablespoon sesame oil"
  ],
  "steps": [
    {
      "text": "Wash fish under cold running water, then pat dry with paper towels. Drizzle with lemon juice and season with salt on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and five-spice powder in a shallow bowl. Dip fish fillets into flour mixture to coat on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat canola and sesame oils in a large skillet over medium heat. Add fish and pan-fry for 2 to 3 minutes. Use two spatulas to carefully flip fillets; continue cooking until fish flakes easily with a fork, 2 to 3 more minutes.",
      "section": null,
