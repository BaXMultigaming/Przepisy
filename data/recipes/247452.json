  "ingredients": [
    "1 (2 pound) pork shoulder roast",
    "0.5 teaspoon salt and pepper",
    "7 tablespoons olive oil, divided",
    "1 cup water",
    "2 cups smoky barbeque sauce",
    "4 russet potatoes, cut into wedges",
    "1 cup Cheddar cheese curds",
    "1 cup diced bread-and-butter pickles",
    "1 sheet Reynolds Wrap® Aluminum Foil",
    "1 Reynolds® Slow Cooker Liner"
  ],
  "steps": [
    {
      "text": "Preheat the grill to medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season the pork on all sides with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 tablespoon of olive oil in a large frying pan and cook the pork shoulder on all sides, about 4 minutes per side until browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the pork into a slow cooker lined with a Reynolds® Slow Cooker Liner and pour in water and BBQ sauce and cook on high heat for 4 hours or low heat for 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pull the pork apart using two forks until it is shredded and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a 1 1/2- to 2-feet-long sheet of Reynolds Wrap® Aluminum Foil on a table and place the potato wedges in the center of the foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle on the remaining 6 tablespoons of olive oil, season with salt and pepper, and then fold up the outside of the foil to create a foil packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place packet directly on a medium-hot grill and cook for 25 to 30 minutes or until the potatoes are browned and cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve the pulled pork over top of the potato wedges, cheese curds and diced pickles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
