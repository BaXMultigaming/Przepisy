  "ingredients": [
    "1 pound ground beef",
    "1 (1 ounce) package taco seasoning mix",
    "6 (1.75 ounce) packages nacho cheese-flavored corn chips (such as Doritos®)",
    "1 (8 ounce) package taco cheese blend",
    "2 tomatoes, diced",
    "1 cup shredded lettuce",
    "1 (8 ounce) container sour cream"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 10 minutes. Drain and discard grease. Mix in taco seasoning until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Crush chips without opening the bags. Open each bag carefully and spoon in seasoned beef. Cover with cheese, tomatoes, lettuce, and sour cream. Stir to blend, then eat with forks right out of the bags.",
      "section": null,
