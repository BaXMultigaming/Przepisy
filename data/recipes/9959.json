      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5bAfr4kuXm3n6CXYXD2L5vh_i48=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9959-marshmallow-treats-step-2-0440-1-8902ccd7105b4e8eadaf0bbe0792ceca.jpg"
      ],
      "image": "assets/images/9959/step_02.webp"
    },
    {
      "text": "Stir in crispy rice cereal until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aZ5e4qNy3fC-G9dus--zsYJp1-s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9959-marshmallow-treats-step-3-0441-1-209e4dc9bd17479c89bc778412b433f3.jpg"
