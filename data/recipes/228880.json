  "ingredients": [
    "2.5 cups all-purpose flour",
    "2 tablespoons white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "6 tablespoons shortening",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking powder, and salt together in a large bowl. Cut in shortening with a fork, 2 knives, or pastry blender until mixture resembles coarse crumbs. Stir in milk until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a floured surface; knead until completely mixed, about 1 minute. Divide into 2 equal pieces. Pat or roll each piece into a ¾-inch-thick round. Cut each round into 4 pieces; arrange pieces on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
