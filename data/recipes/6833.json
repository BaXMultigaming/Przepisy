    "publisher-tested"
  ],
  "ingredients": [
    "1 cup milk",
    "0.5 cup water",
    "0.25 cup butter",
    "4.5 cups all-purpose flour",
    "2 tablespoons white sugar",
    "1 (.25 ounce) package instant yeast",
    "1.5 teaspoons salt",
    "1 large egg"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bDofTQshIc7JQ0mTdXD3Bz9UMig=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6833-burger-or-hot-dog-buns-ddmfs-step-1-0115-fde52d34a6aa48779802c4f774e7c2e6.jpg"
      ],
      "image": "assets/images/6833/step_01.webp"
    },
    {
      "text": "Heat milk, water, and butter in a small saucepan over medium heat until very warm, about 120 degrees F (50 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5I2J3-8akaWyE48hHNPLGyne_2c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6833-burger-or-hot-dog-buns-ddmfs-step-2-0126-172559ec7ca04cdeba4dfa74ce4fbb75.jpg"
      ],
      "image": "assets/images/6833/step_02.webp"
    },
    {
      "text": "Mix together 1 3/4 cups flour, sugar, yeast, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hOmiDOr0m6Kns7qw2uVHQdQaVZk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6833-burger-or-hot-dog-buns-ddmfs-step-3-0129-4159cd9d1b3b47398c6f172f07c5e5c8.jpg"
      ],
      "image": "assets/images/6833/step_03.webp"
    },
    {
      "text": "Pour in warm milk mixture; stir until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/q_toFR9JhNBmHV4WqyApRDOC4yc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6833-burger-or-hot-dog-buns-ddmfs-step-4-0136-135e1915929a48afb7a87350e66bf6d0.jpg"
      ],
      "image": "assets/images/6833/step_04.webp"
    },
    {
      "text": "Mix in egg. Add remaining flour, 1/2 cup at a time, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Te5FRKqEXBuoH8x2Xr4jcDDl7mg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6833-burger-or-hot-dog-buns-ddmfs-step-5-0137-2a4c9d5bf0464bcc9d9b07f064417b39.jpg"
      ],
      "image": "assets/images/6833/step_05.webp"
    },
    {
      "text": "Turn dough out onto a lightly floured surface; knead until smooth and elastic, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CC1FwKYKcuBebZUyUpLiUy96GGY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6833-burger-or-hot-dog-buns-ddmfs-step-7-0141-89f529938c64417695ec3d69c8dedd83.jpg"
      ],
      "image": "assets/images/6833/step_06.webp"
    },
    {
      "text": "If making burger buns: Divide dough into 12 equal pieces. Shape into smooth balls; place on a greased baking sheet and flatten slightly. Cover and let rise for 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "If making hot dog buns: Divide dough into 16 equal pieces. Shape each piece into a 6x4-inch rectangle. Starting with a long side, roll up tightly, then pinch edges and ends to seal. Place on a greased baking sheet. Cover and let rise for 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ijNW1CqMGP3JF7QWzfoLr0e5u1I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6833-burger-or-hot-dog-buns-ddmfs-step-8-0146-b9c2ebaf05ed4b51a776d3f71ebfcd50.jpg"
      ],
      "image": "assets/images/6833/step_08.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake buns in the preheated oven until golden brown, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EM89F9-1qtBouQLpwC9-jAGxUCc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6833-burger-or-hot-dog-buns-ddmfs-0154-4x5-512569bbb353464e8b55b821524969bc.jpg"
      ],
      "image": "assets/images/6833/step_10.webp"
    }
  ],
