  "title": "Burger or Hot Dog Buns",
  "description": "Make hot dog buns with this easy and versatile bread recipe for soft, homemade hamburger buns that are all-natural and much tastier than store-bought.",
  "authors": [
    "Sally"
  ],
  "date_published": "1998-08-10T22:43:43-04:00",
