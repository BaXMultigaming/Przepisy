  "ingredients": [
    "1 onion, thinly sliced",
    "0.25 cup distilled white vinegar",
    "2 tablespoons olive oil",
    "1 tablespoon minced garlic",
    "2 teaspoons salt",
    "0.5 teaspoon black pepper",
    "6 (6 ounce) lamb chops"
  ],
  "steps": [
    {
      "text": "Combine onion, vinegar, oil, garlic, salt, and pepper in a large resealable plastic bag. Add lamb chops; coat with the marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BUg34vDxOepLoIpoPHoIC9c65yA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/137917-simple-grilled-lamb-chops-ddmfs-Step2-1465-7629305cd54a477182d6f282484ba544.jpg"
      ],
      "image": "assets/images/137917/step_01.webp"
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove lamb from marinade and leave any onions on that are sticking to the chops; discard marinade. Wrap exposed ends of bones with aluminum foil to keep them from burning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook lamb chops on the preheated grill until grill marks appear and to desired doneness, about 3 minutes per side for medium. An instant-read thermometer inserted into the center should register 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ceTyZnhFhPe07SXEfp1AaqPWOhI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/137917-simple-grilled-lamb-chops-ddmfs-Step4-1535-f0c7c3bd5c28424cb9d1b699d2a474ff.jpg"
      ],
      "image": "assets/images/137917/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KED2_KBuwY-uiBkhA924ur0fFp4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/137917-simple-grilled-lamb-chops-DDMFS-4x3-e3fac5ea37f54abb9703a542e94f044a.jpg"
