  "ingredients": [
    "1 cup all-purpose flour",
    "1 egg",
    "0.5 cup water",
    "1 pinch salt",
    "1 large potato, diced",
    "1 onion, diced",
    "0.5 pound bacon, chopped",
    "3 cups milk",
    "1 cup heavy cream",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a medium bowl, combine flour, egg, 1/2 cup water and salt to form a dough. Cut into thin strips or small pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of water to boil. Stir in dough, potatoes and onion. Cook 20 minutes, until potatoes are tender. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While pasta and potatoes are cooking, cook bacon in a large skillet over medium heat until crisp. Save drippings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return pasta and potato mixture to large pot over medium-low heat, and combine with bacon, a teaspoon of bacon grease, milk, cream and salt and pepper. Adjust bacon grease to taste and milk or cream to cover. Simmer 20 minutes, without boiling. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
