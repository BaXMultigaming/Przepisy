  "ingredients": [
    "1 head cauliflower, separated into florets",
    "0.5 cup mayonnaise",
    "0.25 cup Dijon mustard",
    "1 cup shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Place cauliflower florets in a large glass bowl or casserole dish, and cover with plastic wrap. Poke a few holes in the plastic with a knife. Cook in the microwave for 5 to 7 minutes, or until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a cup or small bowl, stir together the mayonnaise, and Dijon mustard. Spread over the top of the cauliflower. Sprinkle shredded cheese over the top. Return to the microwave, and cook just until cheese has melted, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
