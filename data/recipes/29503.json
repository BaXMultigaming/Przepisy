  "ingredients": [
    "40 unsalted soda crackers, crushed",
    "1 cup fresh bread crumbs",
    "1 tablespoon garlic powder",
    "0.5 cup butter, melted",
    "1 tablespoon Worcestershire sauce",
    "2 tablespoons grated Parmesan cheese",
    "1 pinch ground black pepper",
    "0.5 cup dry white wine, or as needed",
    "16 jumbo shrimp, peeled and deveined, with tails"
  ],
  "steps": [
    {
      "text": "Mix together crushed crackers, bread crumbs, and garlic powder in a medium bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together butter and Worcestershire sauce in a small bowl. Pour butter mixture over cracker mixture. Add Parmesan cheese and pepper; mix until well combined. Stir in white wine, using only enough to hold mixture together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a sharp knife to butterfly shrimp, then arrange back-side up in a large baking dish. Stuff shrimp with heaping tablespoonfuls of cracker mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cracker mixture is lightly browned, shrimp is opaque, and tails have curled, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
