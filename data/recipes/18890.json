  "ingredients": [
    "0.5 cup uncooked white rice",
    "10 ounces broccoli florets",
    "10 ounces cauliflower florets",
    "0.5 cup butter",
    "1 onion, chopped",
    "1 pound processed cheese food, cubed",
    "1 (10.75 ounce) can condensed cream of chicken soup",
    "5.375 fluid ounces milk",
    "1.5 cups crushed buttery round crackers"
  ],
  "steps": [
    {
      "text": "In a saucepan bring water to a boil. Add rice and stir. Reduce heat, cover and simmer for 20 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Simmer broccoli and cauliflower florets in water for 10 minutes, or until crunchy. Meanwhile, preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan, melt butter and saute onion. Stir cauliflower, broccoli and rice into the saucepan. Once the vegetables and rice are coated, stir in the cheese, chicken soup and milk. Transfer the entire mixture to a 9x13 inch baking dish and sprinkle the crackers on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated 350 degrees F (175 degrees C) oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
