  "ingredients": [
    "2 (15 ounce) cans garbanzo beans, drained",
    "0.5 cup roasted tahini",
    "0.25 cup lemon juice",
    "1 teaspoon grated lemon zest, minced",
    "2 cloves garlic",
    "0.25 cup packed flat leaf parsley",
    "0.25 cup chopped green onions",
    "salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Place garbanzo beans, tahini, lemon juice, lemon zest, garlic, parsley, and green onion in the bowl of a food processor. Blend until smooth, adding water if the mixture is too thick. Season to taste with salt and pepper.",
