  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "3 cups all-purpose flour, divided",
    "0.25 cup white sugar",
    "1 teaspoon salt",
    "1 (.25 ounce) package active dry yeast",
    "0.66666668653488 cup milk",
    "2 tablespoons butter",
    "2 large eggs",
    "5 large whole eggs, dyed if desired",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/naTjxpBOmGhnYMaUBB_vRgsiiHE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17244-braided-easter-egg-bread-DDMFS-step01-5756b9a85fa64cbca16a736568774a77.jpg"
      ],
      "image": "assets/images/17244/step_01.webp"
    },
    {
      "text": "Stir 1 cup flour, sugar, salt, and yeast together in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DXm9Mft_LXfnjnIuwU8OAwV8vyI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17244-braided-easter-egg-bread-DDMFS-step02-57337e649b66468f89ba1ceeed995474.jpg"
      ],
      "image": "assets/images/17244/step_02.webp"
    },
    {
      "text": "Heat milk and 2 tablespoons butter in a small saucepan over medium-low heat until milk is warm and butter is softened but not melted, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qyjmUlBhYWAJn5WjF8gMJ3gAvwc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17244-braided-easter-egg-bread-DDMFS-step03-1b47b1a575e44ca2b4f148f3b454311d.jpg"
      ],
      "image": "assets/images/17244/step_03.webp"
    },
    {
      "text": "Gradually add milk mixture to flour mixture, stirring constantly. Add ½ cup flour and two eggs; mix until well combined. Add remaining 1 ½ cups flour in three batches, stirring well after each addition, until dough pulls together. Turn out onto a lightly floured surface and knead until smooth and elastic, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0EGi34r6oDwgX7oXGYtKqbCU6uk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17244-braided-easter-egg-bread-DDMFS-step04-41da3af983af4a3c8e6c1476e4f12096.jpg"
      ],
      "image": "assets/images/17244/step_04.webp"
    },
    {
      "text": "Place dough into a lightly oiled bowl; turn to coat all sides. Cover with a damp cloth and let rise in a warm place until doubled in volume, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kTRTZe5JJdYkuE3zWO7agoRZ1ao=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17244-braided-easter-egg-bread-DDMFS-step05-92a715b98e7f4a1f9cb52311b7a60c1f.jpg"
      ],
      "image": "assets/images/17244/step_05.webp"
    },
    {
      "text": "Punch down dough, then turn out onto a lightly floured surface. Divide in half and gently form into rounds; cover and let rest for 10 minutes. Meanwhile, butter a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aqKSQ2QLfFQ5ANqEFGpkbEfddSg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17244-braided-easter-egg-bread-DDMFS-step06-f7f33a73b376493cb31d13627d76373e.jpg"
      ],
      "image": "assets/images/17244/step_06.webp"
    },
    {
      "text": "Roll each dough round into a 36-inch-long roll about 1 ½ inches thick. Twist dough loosely and form into a ring on the prepared baking sheet, leaving five spaces for eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_-6hf_kcpmUzOZGtIqJvggN7MYo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17244-braided-easter-egg-bread-DDMFS-step07-97ecd6515912463fb089a699e6743c39.jpg"
      ],
      "image": "assets/images/17244/step_07.webp"
    },
    {
      "text": "Seal the ends of the ring together, and set whole eggs into the spaces in the dough. Cover loosely with a damp towel and let rise in a warm place until doubled in volume, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E6YYO6Fwa0Tsv_3pJhoKGYYCc0E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17244-braided-easter-egg-bread-DDMFS-step08-d2ec7ba515af4623b00bfb16772df012.jpg"
      ],
      "image": "assets/images/17244/step_08.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Brush risen loaf with melted butter. Bake in the preheated oven until golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fZ5YX88ra7gZRoCr3rrRMD-QGo0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17244-braided-easter-egg-bread-DDMFS-step09-09c151e73cd84a06a795005ef946d0e2.jpg"
      ],
      "image": "assets/images/17244/step_09.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OvK058T81F8Fq9w9CnuCJNWPN0o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17244-braided-easter-egg-bread-DDMFS-beauty-4x3-d9c6657f72ef4105816b0c657339f8f5.jpg"
      ],
      "image": "assets/images/17244/step_10.webp"
    }
  ],
