  "title": "Bacon Cheddar Chive Muffins",
  "description": "This tangy, savory muffin features Cheddar, Parmesan, bacon, chives and garlic. Cream of mushroom soups helps ensure a moist result.",
  "authors": [
    "Shelley Albeluhn"
  ],
  "date_published": "2000-02-11T19:45:26-05:00",
