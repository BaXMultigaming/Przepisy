  "ingredients": [
    "6 thick slices bacon",
    "2 cups all-purpose flour",
    "1.5 tablespoons white sugar",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1.5 teaspoons garlic powder",
    "4 teaspoons dried chives",
    "0.33333298563957 cup grated Parmesan cheese",
    "1 cup shredded sharp Cheddar cheese",
    "1 egg, beaten",
    "0.5 cup milk",
    "0.5 cup cream of mushroom soup",
    "0.5 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease muffin pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, combine flour, sugar, baking powder, salt, garlic powder, chives, parmesan cheese, cheddar cheese and crumbled bacon. Combine the egg, milk, cream of mushroom soup and vegetable oil. Mix into the dry ingredients and stir together just to moisten.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon the batter into prepared muffin pans and bake at 400 degrees F (200 degrees C) for 20 to 25 minutes, or until a toothpick inserted into a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
