  "ingredients": [
    "1 (9 inch) pie crust pastry",
    "1 cup sour cream",
    "0.5 cup white sugar",
    "0.25 cup all-purpose flour",
    "1 egg, beaten",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "4 large pears - peeled, cored and sliced",
    "0.66666668653488 cup all-purpose flour",
    "0.66666668653488 cup rolled oats",
    "0.33333334326744 cup white sugar",
    "5 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll pastry out to fit a 9-inch pie plate; place in pie plate. Trim any extra dough; crimp edge.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sour cream, ½ cup sugar, ¼ cup flour, egg, vanilla, and salt in a bowl until blended. Fold in pears; pour into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine ⅔ cup flour, rolled oats, ⅓ cup sugar, and melted butter in a bowl; set topping aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pie from oven; sprinkle with crumble topping. Continue baking until filling is set and crust is brown, about 20 minutes more. Cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
