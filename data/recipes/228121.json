  "ingredients": [
    "6 cups half-and-half",
    "4 cups shredded cooked chicken breast",
    "3 (10.75 ounce) cans condensed cream of chicken soup",
    "4 carrots, diced",
    "3 celery stalks, diced",
    "3 potatoes, peeled and cubed",
    "1 cup sour cream",
    "1 cup hot pepper sauce, or to taste",
    "5 ounces crumbled blue cheese"
  ],
  "steps": [
    {
      "text": "Combine half-and-half, chicken, soup, carrots, celery, potatoes, sour cream, and hot sauce in a slow cooler. Cover and cook on Low for 6 1/2 hours, stirring occasionally. Stir in blue cheese after 5 hours.",
