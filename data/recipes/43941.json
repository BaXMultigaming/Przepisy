  "ingredients": [
    "1 cup white sugar",
    "3 eggs",
    "0.33333334326744 cup vegetable oil",
    "0.25 cup molasses",
    "2.25 cups all-purpose flour",
    "1 cup whole wheat flour",
    "1.5 tablespoons ground ginger",
    "1 tablespoon baking powder",
    "0.75 tablespoon ground cinnamon",
    "0.5 tablespoon ground cloves",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 375 degrees F (190 degrees C). Grease a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KqXgc11XAGOlPYNBRfAPuOgNjPE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-43941-gingerbread-biscotti-VAT-step-01-a2db16cbce7c4d62ac9d47474da3c8c2.jpg"
      ],
      "image": "assets/images/43941/step_01.webp"
    },
    {
      "text": "Combine sugar, eggs, oil, and molasses in a large bowl. Combine all-purpose flour, whole wheat flour, ground ginger, baking powder, ground cinnamon, ground cloves, and ground nutmeg in a separate bowl; stir into sugar mixture until a stiff dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TWMf3cRqlDGmKJvkzJ2Ig0Ykw4M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-43941-gingerbread-biscotti-VAT-step-02-1-039cfaab07784bad8c686971a7c6354b.jpg"
      ],
      "image": "assets/images/43941/step_02.webp"
    },
    {
      "text": "Divide dough in half; shape each into a roll the length of the cookie sheet. Place rolls on the prepared cookie sheet; pat down to flatten dough until ½-inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tdsLe2BXMJRCutlRReluV65K5wI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-43941-gingerbread-biscotti-VAT-step-03-2handinframe-816c2588b3a444a7bfd40df9618aef1b.jpg"
      ],
      "image": "assets/images/43941/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven for 25 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G4L8xNxJzbVb4CnTPIzuNrqD_Js=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-43941-gingerbread-biscotti-VAT-step-04-ac280cea4e9a4e008f459377ff77c6e1.jpg"
      ],
      "image": "assets/images/43941/step_04.webp"
    },
    {
      "text": "When cool enough to touch, cut into ½-inch thick diagonal slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RbqVfAxX5rbdwau3v52iiEeZtEI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-43941-gingerbread-biscotti-VAT-step-05-0f4733534fc2498db6226779c96bf07e.jpg"
      ],
      "image": "assets/images/43941/step_05.webp"
    },
    {
      "text": "Place sliced biscotti on the cookie sheet; bake until toasted and crispy, 5 to 7 minutes on each side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mz990X57rdl-pZiI2R3O6GQCJfw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-43941-gingerbread-biscotti-VAT-step-06-5feb14d0b81f4edea9d2d2b4bb535b6e.jpg"
      ],
      "image": "assets/images/43941/step_06.webp"
