  "ingredients": [
    "12 ounces fingerling potatoes, halved lengthwise",
    "1 tablespoon olive oil",
    "1 teaspoon garlic powder",
    "0.25 teaspoon paprika",
    "salt and ground black pepper to taste",
    "0.33333334326744 cup reduced-fat sour cream",
    "2 tablespoons mayonnaise",
    "2 tablespoons finely grated Parmesan cheese",
    "1.5 tablespoons ranch dressing mix (such as Hidden Valley Ranch®)",
    "1 tablespoon white vinegar",
    "1 tablespoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 390 degrees F (200 degrees C) for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a bowl and add olive oil, garlic powder, paprika, salt, and pepper. Toss until potatoes are coated and transfer to the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer, shaking the basket halfway through, until potatoes are cooked through and crispy, 15 to 17 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While potatoes are cooking, mix sour cream, mayonnaise, Parmesan cheese, ranch dressing mix, and vinegar in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cooked potatoes to a plate and garnish with parsley. Serve immediately with dipping sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
