  "ingredients": [
    "1 (9 inch) unbaked pie crust",
    "1 (16 ounce) can pumpkin puree",
    "1 (14 ounce) can sweetened condensed milk",
    "2 large eggs",
    "1 teaspoon pumpkin pie spice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_KCfvsuKYPleCA86EiEA02qzYhY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229932-Simple-Pumpkin-Pie-Ingredients-e3f010130dfb41a8877c4cf5b147b17d.jpg"
      ],
      "image": "assets/images/229932/step_01.webp"
    },
    {
      "text": "Fit pie crust into a 9-inch pie dish and place it on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wd1Jd3kCJppfvABNiEeWF9mwdS8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229932-Simple-Pumpkin-Pie-Step-01-d6cddc87ac804240b7fe4a56ee8a5aa2.jpg"
      ],
      "image": "assets/images/229932/step_02.webp"
    },
    {
      "text": "Add pumpkin puree, condensed milk, eggs, and pumpkin pie spice together in a large bowl; mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S6yMMfx3M4Y9e9JepEh862nlYbY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229932-Simple-Pumpkin-Pie-Step-02-1-68f55e8658084ab2b4d54ad11e06d972.jpg"
      ],
      "image": "assets/images/229932/step_03.webp"
    },
    {
      "text": "Pour mixture into pie crust. Bake in the preheated oven for 15 minutes. Reduce heat to 350 degrees F (175 degrees C); continue to bake until filling is set, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OnJBYDQCf06SP5mGeoxfnag7vEc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229932-Simple-Pumpkin-Pie-Step-02-2-5bef82f516714505bbd1df35d705412e.jpg"
      ],
      "image": "assets/images/229932/step_04.webp"
    },
    {
      "text": "Remove from the oven, cool completely on a wire rack before serving.",
      "section": null,
      "name": null,
