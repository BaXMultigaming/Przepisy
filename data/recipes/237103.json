  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "1 cup mayonnaise",
    "1 cup water",
    "0.25 cup unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "1 cup white sugar",
    "0.5 cup evaporated milk",
    "1 tablespoon margarine",
    "0.5 cup miniature marshmallows",
    "1 cup peanut butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, 1 cup sugar, mayonnaise, water, cocoa powder, and baking soda together in a bowl until smooth; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cake comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir 1 cup sugar, evaporated milk, and margarine together in a saucepan; bring to a boil and cook for 2 minutes. Remove saucepan from heat, add marshmallows, and stir to melt them completely into the mixture. Stir peanut butter and vanilla extract into marshmallow mixture until icing is smooth; pour over warm cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
