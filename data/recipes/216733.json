  "ingredients": [
    "4 teaspoons white truffle oil",
    "2 tablespoons dried parsley",
    "0.25 cup grated Parmesan cheese",
    "1 (3.5 ounce) package microwave popcorn, popped",
    "0.25 teaspoon sea salt, or to taste"
  ],
  "steps": [
    {
      "text": "Mix the truffle oil, parsley, and Parmesan cheese in a heat-safe bowl.",
      "section": null,
