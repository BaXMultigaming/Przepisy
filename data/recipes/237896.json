  "ingredients": [
    "1 cup brown sugar",
    "0.25 cup yellow mustard",
    "9 pounds fully-cooked, bone-in ham"
  ],
  "steps": [
    {
      "text": "Preheat the grill to 350 degrees F (175 degrees C). Mix brown sugar and mustard together in a bowl until a paste forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ham onto a large piece of heavy-duty aluminum foil. Spread brown sugar paste over entire ham. Wrap foil securely around ham, sealing all of the edges together. Place wrapped ham into a disposable grill pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill ham on the preheated grill until heated through, about 2 1/2 hours. An instant-read thermometer inserted into the center should read at least 145 degrees F (63 degrees C). Remove ham from the grill and let rest for 30 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
