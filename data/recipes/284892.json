  "ingredients": [
    "1.5 cups unsalted butter, softened",
    "0.75 cup white sugar",
    "0.75 cup brown sugar",
    "0.5 cup shortening",
    "0.25 cup hot fudge sauce",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "0.66666668653488 cup cocoa powder",
    "0.75 teaspoon baking soda",
    "0.25 teaspoon salt",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white and brown sugars, shortening, fudge sauce, eggs, and vanilla together in a large bowl until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, cocoa, baking soda, and salt in a bowl. Stir flour mixture into the butter mixture until well blended. Mix in the chocolate chips. Drop by rounded teaspoonfuls onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until just set (cookies will be very soft), 8 to 10 minutes. Cool slightly on the cookie sheets before transferring to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
