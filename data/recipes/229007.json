  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup unprocessed wheat bran",
    "0.75 cup lightly packed brown sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon salt",
    "1 cup milk",
    "0.5 cup vegetable oil",
    "2 large eggs",
    "2 large apples - peeled, cored, and chopped",
    "0.25 cup all-purpose flour",
    "0.25 cup packed brown sugar",
    "0.5 teaspoon ground cinnamon",
    "2 tablespoons cold butter, cut into pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make muffins: Whisk flour, bran, brown sugar, baking powder, baking soda, cinnamon, and salt together in a large bowl until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, vegetable oil, and eggs together in a separate bowl. Pour milk mixture into flour mixture and stir just until combined. Gently stir in apples. Fill the prepared muffin cups about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make streusel: Mix flour, brown sugar, and cinnamon in a bowl. Cut in butter until mixture is crumbly. Sprinkle about 1 heaping teaspoon on top of each muffin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted into the center of a muffin comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
