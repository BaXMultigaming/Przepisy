  "title": "Brandy Glazed Carrots",
  "description": "A touch of brandy gives a simple carrot side dish a sophisticated taste. Best of all, it can be prepared 1 or 2 days in advance if needed.",
  "authors": [
    "Joanne Marie"
  ],
  "date_published": "2020-03-05T00:10:28-05:00",
