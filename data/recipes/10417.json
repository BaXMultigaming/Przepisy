  "ingredients": [
    "0.5 cup butter, softened",
    "1 cup packed light brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon baking soda",
    "2 cups sifted all-purpose flour",
    "0.75 cup milk",
    "2 (1 ounce) squares unsweetened chocolate, melted",
    "0.5 cup chopped black walnuts",
    "2.5 cups confectioners' sugar",
    "0.25 cup unsweetened cocoa powder",
    "2 tablespoons butter, softened",
    "0.5 teaspoon vanilla extract",
    "4 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together 1/2 cup butter or margarine and 1 cup light brown sugar until light and fluffy. Add egg, beat thoroughly. Add 1 teaspoon vanilla and mix well. Sift together flour and 1/2 teaspoon baking soda, add alternating with 3/4 cup milk to creamed mixture beginning and ending with dry ingredients. Blend in melted chocolate, then nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by teaspoonfuls onto greased cookie sheets. Bake 10 -12 minutes. Cool on wire rack. When cool, frost with Chocolate Icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Icing: Mix confectioners' sugar; 1/4 cup cocoa ; 2 tablespoons butter or margarine, 1/2 teaspoon vanilla and milk. Mix all ingredients until smooth and creamy (may need to add more milk to get creamy consistency) . Frost cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
