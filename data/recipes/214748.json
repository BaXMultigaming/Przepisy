  "ingredients": [
    "1 cup whipping cream",
    "3 tablespoons white sugar",
    "4 ounces mascarpone cheese",
    "2 tablespoons apricot nectar",
    "0.5 teaspoon vanilla extract",
    "1 pinch ground cardamom",
    "0.25 cup honey",
    "3 tablespoons apricot preserves",
    "1 tablespoon balsamic vinegar",
    "8 fresh apricots, pitted and halved"
  ],
  "steps": [
    {
      "text": "Beat cream in a chilled bowl with an electric mixer until soft peaks form; beat in sugar until incorporated. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat mascarpone cheese in a separate bowl with an electric mixer until very soft; beat in apricot nectar, vanilla, and cardamom. Gently fold mascarpone mixture into whipped cream until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place honey and apricot preserves in a microwave-safe bowl; microwave until warm but not hot, about 30 seconds. Stir in balsamic vinegar until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stuff each apricot half with a dollop of mascarpone cream. Place filled apricot halves on a serving dish; drizzle with balsamic sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
