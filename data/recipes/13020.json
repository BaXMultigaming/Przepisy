  "ingredients": [
    "0.25 red onion, minced",
    "1.5 tablespoons butter",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 cup milk",
    "0.5 cup frozen green peas",
    "3 tablespoons sour cream"
