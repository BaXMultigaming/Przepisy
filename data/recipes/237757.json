  "ingredients": [
    "1.5 pounds ground beef",
    "1.5 cups chopped onion",
    "0.5 cup chopped bell pepper",
    "1 clove minced garlic",
    "1 teaspoon chili powder",
    "1 teaspoon salt",
    "1.5 cups water",
    "0.75 cup uncooked white rice",
    "1 (16 ounce) can kidney beans, rinsed and drained",
    "1 (14.5 ounce) can whole peeled tomatoes",
    "0.75 cup grated American cheese",
    "0.33333334326744 cup chopped black olives"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir onion, bell pepper, garlic, chili powder, and salt with the ground beef; cook and stir until the onion is softened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir kidney beans, tomatoes, and rice into the beef mixture; pour into a large casserole dish and top with American cheese and olives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the cheese is beginning to brown around the edges, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
