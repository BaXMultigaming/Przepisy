  "ingredients": [
    "2 tablespoons Country Crock® Spread",
    "2 medium red or yellow bell peppers, sliced",
    "1 medium sweet onion, cut into thin wedges",
    "1 clove garlic, finely chopped",
    "0.5 teaspoon ground cumin",
    "0.25 teaspoon chili powder",
    "1 tablespoon lime juice",
    "1 tablespoon chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Melt Country Crock® Spread in 12-inch nonstick skillet over medium-high heat and cook red peppers and onion until tender and golden, about 8 minutes. Stir in garlic, cumin and chili powder and cook, stirring frequently, 2 minutes. Remove from heat, stir in lime juice and cilantro.",
