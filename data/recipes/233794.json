  "title": "Slow-Cooked Green Beans",
  "description": "Chef John’s Southern-style green beans make plenty of delicious juice that’s just right for dipping corn bread into.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2013-08-06T17:52:37-04:00",
