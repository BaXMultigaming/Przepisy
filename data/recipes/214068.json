  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup butter, softened",
    "1 cup confectioners' sugar",
    "2 teaspoons vanilla extract",
    "1 cup oatmeal",
    "1 cup chopped pecans",
    "1 tablespoon confectioners' sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, mix the flour, baking soda, and salt. In a separate large bowl, mix the butter, 1 cup confectioners' sugar, and vanilla until the mixture is smooth and creamy. Stir in the flour mixture; gently stir in the oatmeal and pecans and lightly mix until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With a spoon, drop about 1 scant tablespoon of dough per cookie onto the prepared baking sheet. Bake in the preheated oven until lightly browned, about 20 minutes. Let cool completely before sprinkling cookies with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
