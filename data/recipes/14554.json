        "https://www.allrecipes.com/thmb/ba9j8xxfYoKfZXuwunASxbu3ePA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14554-sirloin-steak-with-garlic-butter-step-05-4x3-803146d0622c40dab594b4b9c74fae22.jpg"
