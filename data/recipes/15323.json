  "ingredients": [
    "1.5 cups white sugar",
    "0.5 cup butter",
    "3 eggs",
    "2.5 cups sifted all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon hot water",
    "2 cups dates, pitted and chopped",
    "3 cups chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, cream the butter and sugar. Add eggs, one at a time, beating after each. Dissolve the baking soda in the hot water, add it to the egg mixture. Stir in the flour and cinnamon until well blended. Finally, stir in the dates and walnuts so they are evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by heaping spoonfuls onto an ungreased cookie sheet. Bake for 10 to 15 minutes in the preheated oven, until golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
