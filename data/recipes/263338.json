  "ingredients": [
    "1 tablespoon cooking oil",
    "1 onion, finely chopped",
    "1 green bell pepper, finely chopped",
    "1 clove garlic, finely chopped",
    "1 tablespoon garam masala",
    "1 tablespoon mild curry powder",
    "2 teaspoons ground cumin",
    "1 teaspoon ground turmeric",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (15 ounce) can cooked green lentils"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat and cook onion, bell pepper, and garlic until soft, about 5 minutes. Stir in garam masala, curry powder, cumin, and turmeric; cook until fragrant, 1 to 2 minutes. Add tomatoes, bring to a simmer, and cook for 5 minutes. Add lentils and stir well. Simmer for 10 minutes, but do not bring to a boil.",
