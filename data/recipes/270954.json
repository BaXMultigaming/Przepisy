  "ingredients": [
    "1 teaspoon kosher salt",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon freshly ground black pepper",
    "1 teaspoon dried dill weed",
    "0.5 teaspoon dried rosemary",
    "0.5 teaspoon dried thyme",
    "2 tablespoons finely grated Parmigiano-Reggiano cheese",
    "2.5 pounds boneless beef short ribs",
    "salt and freshly ground black pepper to taste",
    "1 pinch cayenne pepper",
    "1 tablespoon olive oil",
    "1 large onion, sliced",
    "0.33333334326744 cup sliced fresh mushrooms",
    "1 tablespoon all-purpose flour",
    "0.66666668653488 cup chicken broth",
    "1 tablespoon soy sauce",
    "0.5 teaspoon Worcestershire sauce",
    "6 whole pepperoncini peppers",
    "0.25 cup unsalted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together kosher salt, garlic powder, onion powder, pepper, dill, rosemary, thyme, and Parmesan cheese in a small bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season short ribs with salt, pepper, and cayenne. Heat oil in a pan over high heat. Add short ribs and sear until well browned, 3 to 5 minutes per side. Transfer beef to a baking dish and sprinkle seasoning mixture evenly over beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium-high and add onion and mushrooms to the pan. Season with salt. Sauté until mushrooms are golden brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle flour over onion and mushrooms. Stir to coat and cook for 2 minutes. Pour in chicken broth, soy sauce, and Worcestershire sauce. Stir and bring to a boil; remove from heat. Pour mixture over beef and cover with pepperoncini. Place butter on top. Cover baking dish with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until meat is fork-tender and falls apart easily, about 2 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon sauce from the bottom of the pan onto beef to serve. Skim off excess fat as desired.",
      "section": null,
      "name": null,
      "url": null,
