  "ingredients": [
    "1 cup grated summer squash",
    "0.5 cup all-purpose flour",
    "1 large egg, beaten",
    "2 tablespoons milk",
    "2 tablespoons grated onion",
    "1 tablespoon white sugar",
    "1 teaspoon salt, or to taste",
    "0.25 teaspoon ground black pepper",
    "2 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Mix grated squash, flour, egg, milk, onion, sugar, 1 teaspoon salt, and pepper in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a pan over medium heat. Working in batches, add tablespoonfuls of the squash mixture to the hot oil. Cook until the edges start to brown, 2 to 3 minutes. Flip patties and cook for 2 to 3 more minutes. Drain on paper towels. Repeat to cook remaining patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve hot and sprinkle with more salt, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
