  "ingredients": [
    "0.5 cup margarine, softened",
    "2 cups white sugar",
    "3 tablespoons all-purpose flour",
    "0.25 teaspoon salt",
    "3 eggs",
    "1 cup buttermilk",
    "1 teaspoon vanilla extract",
    "1 (9 inch) deep dish pie crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream margarine and sugar. Beat in flour and salt. Blend in the eggs. Stir in the buttermilk and vanilla. Pour into pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes, then reduce temperature to 325 degrees F (165 degrees C) and bake 45 minutes, or until filling is set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
