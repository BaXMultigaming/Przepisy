  "ingredients": [
    "2 (15 ounce) cans black beans, rinsed and drained",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (14 ounce) can coconut milk",
    "1 cup vegetable broth",
    "2 green onions, chopped, or more to taste",
    "1 tablespoon ground ginger",
    "1 tablespoon ground cumin",
    "1 tablespoon ground turmeric",
    "2 cloves garlic, minced, or more to taste",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Combine black beans, tomatoes, coconut milk, broth, green onions, ginger, cumin, turmeric, and garlic in a large saucepan; bring to a boil. Reduce the heat and simmer until desired consistency is reached, 30 to 45 minutes. Season with salt.",
