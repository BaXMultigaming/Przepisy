  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.5 cup brown sugar",
    "0.25 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 (8 ounce) package toffee baking bits",
    "4 Granny Smith apple, cored and sliced",
    "1 tablespoon lime juice",
    "1 tablespoon lemon juice"
  ],
  "steps": [
    {
      "text": "Beat cream cheese, brown sugar, white sugar, and vanilla extract together in a large bowl until smooth. Stir in toffee bits. Pour lime and lemon juice over apples to prevent browning. Serve dip with apples on the side.",
