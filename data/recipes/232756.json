  "ingredients": [
    "2 pounds beef pot roast, fat trimmed and discarded",
    "3 potatoes, peeled and cut into 6 pieces",
    "1 large onion, cut into 8 pieces",
    "2 carrots, cut into 1-inch pieces",
    "2 stalks celery, cut into 1-inch pieces",
    "3.5 cups water, divided",
    "salt and ground black pepper to taste",
    "1 pinch garlic salt, or to taste",
    "0.5 cup water",
    "3 tablespoons cornstarch",
    "0.5 teaspoon browning sauce (such as Gravy Master®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place roast in a large baking pan; arrange potatoes, onion, carrots, and celery around roast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f28sqAYX0H1JBtEDuQwdiEPoe-k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232756-pot-roast-ddmfs-step-1-0024-ff054b01ac804abeb93bda21be0f5c7c.jpg"
      ],
      "image": "assets/images/232756/step_02.webp"
    },
    {
      "text": "Pour 3 cups water into the baking pan. Season roast with salt, pepper, and garlic salt. Cover pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until roast is browned and fork tender, 3 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/23C8Al30G8zmHGYS8AbsCc6ZetU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/232756-pot-roast-ddmfs-step-3-0181-4a6be44867f94977b0012d228601bf00.jpg"
      ],
      "image": "assets/images/232756/step_04.webp"
    },
    {
      "text": "Transfer roast to an oven-safe platter. Remove vegetables using a slotted spoon and arrange them around roast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce oven temperature to 200 degrees F (95 degrees C). Place the platter with roast and vegetables in the oven to keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour remaining pan juices into a saucepan; bring to a boil. Stir together remaining 1/2 cup water and cornstarch in a bowl until smooth; pour into boiling pan juices. Reduce heat to medium; cook, stirring constantly, until gravy is thick, about 5 minutes; season with salt and pepper. Stir in browning sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
