  "title": "Chicken Breasts with Chipotle Green Onion Gravy",
  "description": "These simple chicken breasts are served with chipotle and green onion gravy made in the same pan with the flavorful drippings for an easy meal for two.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-04-10T12:23:46-04:00",
