  "ingredients": [
    "2 pounds ground beef",
    "2 (16 ounce) cans kidney beans, rinsed and drained",
    "2 (14.5 ounce) cans diced tomatoes, undrained",
    "1 onion, chopped",
    "2 green bell peppers, chopped, divided",
    "1 red bell pepper, chopped, divided",
    "2 tablespoons chili powder",
    "2 cloves garlic, minced",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "10 tablespoons shredded Cheddar cheese for garnish"
  ],
  "steps": [
    {
      "text": "Cook and stir ground beef in a skillet over medium heat until no longer pink, about 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer ground beef to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in kidney beans, diced tomatoes, onion, half the green bell peppers, half the red bell peppers, chili powder, garlic, salt, and ground black pepper until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place remaining green bell peppers and red bell peppers on top of mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the cooker and cook on High setting until vegetables are soft and the flavors have blended, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir chili and cook on Low setting for 6 more hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve in bowls; garnish each serving with 1 tablespoon of shredded Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
