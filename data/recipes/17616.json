  "title": "Beer Spice Cake",
  "description": "A quick and easy spice cake made with beer! Our family enjoys this cake as a Christmas Eve goodie!",
  "authors": [
    "Adriander"
  ],
  "date_published": "2000-02-22T10:06:38-05:00",
