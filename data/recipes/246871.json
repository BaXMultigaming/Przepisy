  "ingredients": [
    "8 cups puffed wheat cereal",
    "1 cup brown sugar, not packed",
    "0.5 cup butter",
    "0.5 cup corn syrup",
    "3 tablespoons Dutch-process cocoa (such as Fry's®)",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Line a 9x13-inch baking pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place puffed wheat cereal in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, butter, corn syrup, and cocoa in a saucepan. Bring to a boil; cook, stirring constantly, until sugar is dissolved, about 2 minutes. Remove from heat. Stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour sugar mixture over puffed wheat cereal in the bowl; stir until cereal is evenly coated. Spread evenly into the lined pan. Cool until set, about 30 minutes. Cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
