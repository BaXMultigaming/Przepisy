  "ingredients": [
    "1 (14 ounce) can artichoke hearts, drained",
    "16 ounces crabmeat",
    "1 cup mayonnaise",
    "0.33333334326744 cup chopped onion",
    "0.75 cup grated Parmesan cheese",
    "1 (12 ounce) package English muffins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium size mixing bowl, combine artichoke hearts, crabmeat, mayonnaise, onions, and cheese. Mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Split each English muffin in half ,and spread the mixture on the cut side of the split muffins. Cut each of the sliced muffins into quarters. Arrange the muffin-bites on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 minutes, or until golden brown. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
