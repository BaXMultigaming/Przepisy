  "ingredients": [
    "0.25 cup butter",
    "2 cloves garlic, finely chopped",
    "0.5 cup heavy cream",
    "0.5 cup mashed ripe avocado",
    "0.5 pound large shrimp, peeled and deveined",
    "ground black pepper to taste"
