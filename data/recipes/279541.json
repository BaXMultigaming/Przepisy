  "ingredients": [
    "cooking spray",
    "1 (15.25 ounce) package strawberry cake mix",
    "0.5 cup butter, softened",
    "2 (8 ounce) packages cream cheese, softened",
    "1 (16 ounce) container cream cheese frosting",
    "3 large eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly spray the bottom of a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cake mix and butter together in a large bowl with an electric mixer on low speed until crumbly. Reserve 1 cup of crumble mixture; press the rest into the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and frosting together in the same bowl until smooth. Beat in eggs until well blended. Pour over the crust and spread evenly. Sprinkle the reserved crumble mixture evenly on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and golden, 45 to 50 minutes. Let cool completely, about 30 minutes. Cover and refrigerate until chilled, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut bars into 6x6 rows.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
