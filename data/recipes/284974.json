  "ingredients": [
    "1 tablespoon coconut oil",
    "2 (4 ounce) mahi mahi fillets",
    "1 cup fresh spinach leaves",
    "4 medium mushrooms, sliced",
    "3 cloves garlic, minced, or to taste",
    "1 tablespoon green onions, chopped, or to taste",
    "1 tablespoon chopped fresh basil, or to taste",
    "sea salt to taste",
    "1 cup hot cooked wild rice"
  ],
  "steps": [
    {
      "text": "Heat oil on a griddle over medium heat. Add mahi mahi to one side of the griddle; cook until it flakes easily with a fork, about 12 minutes, turning halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook spinach, mushrooms, garlic, and green onions on the other side of the griddle. Season mahi mahi and vegetables with basil and salt. Serve over wild rice.",
