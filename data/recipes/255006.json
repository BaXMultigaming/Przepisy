  "ingredients": [
    "0.25 cup butter, melted",
    "2 cups packed brown sugar",
    "4 eggs",
    "0.66666668653488 cup all-purpose flour",
    "2 teaspoons vanilla extract",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "2 cups chopped pecans",
    "1 teaspoon confectioners' sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Pour melted butter into a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar, eggs, flour, vanilla extract, baking soda, and salt together in a bowl until smooth; stir in pecans. Spread the sugar mixture over the butter in the baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and golden, 30 to 35 minutes. Remove from oven; dust with confectioners' sugar. Cool until easily touched, about 10 minutes; cut into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
