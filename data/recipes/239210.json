  "ingredients": [
    "3 cups unsweetened flaked coconut",
    "2 cups white sugar",
    "6 eggs",
    "8 ounces cream of coconut",
    "1 quart half-and-half",
    "1 tablespoon vanilla extract",
    "1 cup flaked coconut",
    "0.5 cup whole milk, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spread 3 cups flaked coconut onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake coconut in the preheated oven, turning once, until toasted, 6 to 10 minutes. Cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and eggs together in a bowl until light and frothy; add cream of coconut and beat well. Add half-and-half and vanilla extract into egg mixture, beating well after each addition. Stir toasted coconut and flaked coconut into half-and-half mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour coconut mixture into the bowl of an ice-cream maker. Pour milk into coconut mixture to fill machine to the fill-line, if necessary. Freeze according to the manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
