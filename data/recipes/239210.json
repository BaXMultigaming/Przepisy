  "title": "Toasted Coconut Ice Cream",
  "description": "Eggs, sugar, cream of coconut, toasted coconut, and coconut flakes combine to create this refreshing tropical ice cream treat!",
  "authors": [
    "billie caren"
  ],
  "date_published": "2020-06-19T00:00:35-04:00",
