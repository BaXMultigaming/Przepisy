  "title": "White Chocolate Thumbprint Cookies",
  "description": "Festive white chocolate thumbprint cookies are drizzled with melted white chocolate for a colorful holiday treat. For the centers, use any flavored jam.",
  "authors": [
    "Sharon"
  ],
  "date_published": "2020-06-18T23:52:36-04:00",
