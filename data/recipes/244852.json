  "ingredients": [
    "2.5 cups all-purpose flour",
    "0.5 cup raisins",
    "0.25 cup hemp seed hearts",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.75 cup brown sugar",
    "0.75 cup white sugar",
    "0.5 cup butter, softened",
    "0.5 cup applesauce",
    "1 cup natural peanut butter",
    "2 eggs",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, raisins, hemp seed hearts, baking powder, and baking soda together in a bowl. Beat brown sugar, white sugar, butter, and applesauce together in a bowl using an electric mixer until smooth and creamy; add peanut butter and beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and vanilla extract together in a bowl; stir into peanut butter mixture. Mix flour mixture into peanut butter mixture until a smooth dough forms. Roll dough into small balls and place on a baking sheet; press each with a fork to flatten.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
