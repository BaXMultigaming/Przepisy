  "ingredients": [
    "3 large avocados, peeled and pitted",
    "1 teaspoon lemon juice",
    "1 cup sour cream",
    "2 tablespoons mayonnaise",
    "1 (1.25 ounce) package taco seasoning mix (such as Lawry's®)",
    "1 (16 ounce) can refried beans",
    "1 cup shredded Mexican blend cheese",
    "2 chopped green onion tops",
    "2 tomatoes, seeded and diced",
    "1 (2.25 ounce) can sliced black olives, drained"
  ],
  "steps": [
    {
      "text": "In a bowl, mash the avocados and mix in the lemon juice. In a separate bowl, mix the sour cream, mayonnaise, and taco seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the refried beans over the bottom of a large serving platter or bowl. Top with avocado mixture. Spread sour cream mixture over the avocado, and sprinkle with cheese. Layer cheese with green onions (just the green part), then tomatoes, and top with the olives. Cover, and chill in the refrigerator 2 to 4 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
