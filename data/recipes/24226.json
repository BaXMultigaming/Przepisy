  "ingredients": [
    "2 pounds beef stew meat, cut into 1 inch cubes",
    "1 (14.5 ounce) can diced tomatoes with juice",
    "1 cup water",
    "3 tablespoons instant tapioca",
    "1 tablespoon beef bouillon granules",
    "2 teaspoons white sugar",
    "1.5 teaspoons salt",
    "0.25 teaspoon ground black pepper",
    "4 carrots, cut into 1 inch pieces",
    "2 strips celery, cut into 3/4 inch pieces",
    "3 potato, peeled and cubed",
    "1 onion, roughly chopped",
    "1 slice bread, cubed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brown stew meat in a large skillet over medium heat. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomatoes, water, tapioca, beef bouillon granules, sugar, salt, and pepper in a mixing bowl. Stir in the beef, carrots, celery, potatoes, onion, and bread cubes. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake in the preheated oven until beef and vegetables are tender, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
