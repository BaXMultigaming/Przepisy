  "ingredients": [
    "1 tablespoon olive oil",
    "4 ribs celery, diced",
    "1 onion, diced",
    "0.5 (16 ounce) package baby carrots, diced",
    "1 tablespoon chopped fresh basil, or to taste",
    "1 clove garlic, minced, or more to taste",
    "black pepper to taste",
    "3 (14.5 ounce) cans stewed tomatoes",
    "4 (6.5 ounce) cans minced clams, undrained",
    "2 (8 ounce) bottles clam juice",
    "1 (14.5 ounce) can whole potatoes, drained and diced",
    "1 dash Worcestershire sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large pot over medium heat. Add celery, onion, carrots, basil, garlic, and black pepper until tender, about 10 minutes. Transfer 1/2 vegetable mixture to a food processor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain 1 can stewed tomatoes; add to the food processor; pulse until smooth. Stir mixture into pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir remaining 2 cans stewed tomatoes, clams, clam juice, and potatoes into pot; bring to a boil. Reduce heat and simmer soup until heated through, 15 to 20 minutes. Season soup with Worcestershire sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
