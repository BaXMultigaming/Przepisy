      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZsMBJIoy5HyOT3oA2A0oGksOLok=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/72471-miss-bettys-24-hour-lettuce-salad-VAT-step-03-aa949084b95b4725832a1ad752e00025.jpg"
