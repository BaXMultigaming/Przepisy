  "ingredients": [
    "1 cup pure maple syrup",
    "0.5 cup packed light brown sugar",
    "3 large eggs",
    "2 tablespoons unsalted butter, melted",
    "1 teaspoon vanilla extract",
    "1.25 cups pecan halves or pieces",
    "1 (9 inch) unbaked pie shell"
  ],
