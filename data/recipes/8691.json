  "ingredients": [
    "1 tablespoon olive oil, or as needed",
    "4 skinless, boneless chicken breast halves",
    "1 onion, chopped",
    "1.75 cups shredded Cheddar cheese, divided",
    "0.5 pint sour cream",
    "1 tablespoon dried parsley",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon ground black pepper",
    "1 (15 ounce) can tomato sauce",
    "0.33333334326744 cup chopped green bell pepper",
    "1 clove garlic, minced",
    "1 tablespoon chili powder",
    "0.5 teaspoon salt",
    "0.5 cup water",
    "8 (10 inch) flour tortillas",
    "1 (12 ounce) jar taco sauce"
  ],
  "steps": [
    {
      "text": "Gather all ingredients and preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QmMGjX-OdIUr-prmqqSObtfI4-Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8691-chicken-enchiladas-DDMFS-Step-01-280-d2b6ff1a036449819e3241e4b1a99a1c.jpg"
      ],
      "image": "assets/images/8691/step_01.webp"
    },
    {
      "text": "Heat oil in a nonstick skillet over medium heat. Add chicken and cook until no longer pink and juices run clear, 5 to 7 minutes per side. Transfer chicken to a cutting board and slice into cubes. Return chicken to the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NpfSWePD0AtRdEWgO-3CxTCIiTM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8691-chicken-enchiladas-DDMFS-Step-02-283-f8a488deea2045e68641ace249785516.jpg"
      ],
      "image": "assets/images/8691/step_02.webp"
    },
    {
      "text": "Add onion, 1 cup Cheddar cheese, sour cream, parsley, oregano, and black pepper. Cook and stir over low heat until cheese melts. Stir in tomato sauce, green pepper, garlic, chili powder, and salt. Add water if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dl1LugNRDATth514eK1UxtEdlig=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8691-chicken-enchiladas-DDMFS-Step-03-285-c89bfa7f446a4d2c828c0987bf83f48c.jpg"
      ],
      "image": "assets/images/8691/step_03.webp"
    },
    {
      "text": "Spoon chicken mixture into tortillas and roll into enchiladas. Arrange enchiladas, seam-side down, in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PXPzbpBK9yKY_UwUSAqCRDjytxo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8691-chicken-enchiladas-DDMFS-Step-04-286-eed91cfa95444c51ab23737819c89c4f.jpg"
      ],
      "image": "assets/images/8691/step_04.webp"
    },
    {
      "text": "Top with taco sauce and remaining 3/4 cup Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dbeUesGp8gK9FGboYSpy_f62-Sk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8691-chicken-enchiladas-DDMFS-Step-05-287-b21ac4966a9e4f1486996bf3173a327d.jpg"
      ],
      "image": "assets/images/8691/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven, uncovered, until cheese has melted, about 20 minutes. Let cool briefly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xYYI3BHVRYdgF8zYTEGA1lx6WEI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8691-chicken-enchiladas-DDMFS-Step-06-305-41620d763e104cfaa2801ec43c1123d3.jpg"
      ],
      "image": "assets/images/8691/step_06.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tc829Re3dQr_49ETCLFBZnKYb7o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8691-chicken-enchiladas-DDMFS-4x3-322-de64088bd2e248c7b6f86572e821e9f7.jpg"
      ],
      "image": "assets/images/8691/step_07.webp"
    }
