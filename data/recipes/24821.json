  "ingredients": [
    "6 slices bacon",
    "0.25 cup pineapple juice",
    "3 tablespoons red wine vinegar",
    "0.25 cup olive oil",
    "freshly ground black pepper to taste",
    "salt to taste",
    "1 (10 ounce) package chopped romaine lettuce",
    "1 cup diced fresh pineapple",
    "0.5 cup chopped and toasted macadamia nuts",
    "3 green onions, chopped",
    "0.25 cup flaked coconut, toasted"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly browned, about 10 minutes. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pineapple juice, red wine vinegar, oil, pepper and salt in a lidded jar or cruet. Cover and shake well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss lettuce, pineapple, macadamia nuts, green onions and bacon together in a large bowl. Pour dressing over salad and toss to coat. Garnish with toasted coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
