  "ingredients": [
    "4 cups frozen blackberries",
    "2 tablespoons white sugar",
    "2 teaspoons cornstarch",
    "1 teaspoon water",
    "1 teaspoon lemon juice",
    "1 teaspoon vanilla extract",
    "1 cup quick-cooking oats",
    "0.5 cup all-purpose flour",
    "0.5 cup packed brown sugar",
    "1 teaspoon ground cinnamon",
    "0.5 cup cold unsalted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 1-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine blackberries, sugar, cornstarch, water, lemon juice, and vanilla in a small bowl; toss gently to coat berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, flour, brown sugar, and cinnamon in another bowl; cut in butter until crumbly. Sprinkle over berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until filling is bubbly, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
