  "ingredients": [
    "12 cups popped popcorn",
    "1 cup granulated sugar",
    "0.5 cup Karo® Light or Dark Corn Syrup",
    "0.25 cup butter or margarine",
    "0.5 teaspoon salt",
    "1 teaspoon Spice Islands® Pure Vanilla Extract",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Coat a large roasting pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add popcorn to the prepared roasting pan; place in oven until warm. (Popcorn can also be warmed in a large microwave-safe bowl on High (100%) power for 1 to 2 minutes.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, corn syrup, butter, and salt in a heavy 2-quart saucepan; bring to boil over medium heat, stirring constantly. Boil 2 minutes, continuing to stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, stir in vanilla and baking soda; pour over warm popcorn, stirring until well coated. Cover hands with two plastic bags, coat bags lightly with cooking spray; shape mixture into twelve 3-inch popcorn balls, working quickly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool completely. Wrap individually in plastic wrap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
