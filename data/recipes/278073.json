  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 egg",
    "2 tablespoons pineapple juice",
    "1 tablespoon vegetable oil",
    "1 cup grated zucchini",
    "0.5 cup crushed pineapple, drained",
    "0.25 cup oats",
    "0.25 cup sweetened flaked coconut",
    "0.25 cup packed brown sugar",
    "2 tablespoons melted margarine"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 4x6-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, white sugar, cinnamon, baking soda, baking powder, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg, pineapple juice, and oil together in a separate bowl until well combined; stir into flour mixture until crumbly and dry. Stir in zucchini and crushed pineapple until moist, blended, and very thick; pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, coconut, and brown sugar in a separate bowl; toss in margarine with a fork until crumbly. Sprinkle topping over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 40 to 60 minutes. Cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
