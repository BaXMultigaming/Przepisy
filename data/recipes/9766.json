  "ingredients": [
    "1 cup butter, softened",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1.25 cups packed brown sugar",
    "2.25 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "2 cups chopped semisweet chocolate",
    "0.5 cup chopped cashews",
    "0.5 cup whole cashews"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In large bowl, cream together the brown sugar and butter. Beat in the eggs one at a time, then stir in the vanilla. Sift flour and baking soda together and mix into butter mixture. Stir in cashews and chocolate. Drop by teaspoonfuls onto ungreased cookie sheets",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 to 12 minutes, or until lightly brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
