  "ingredients": [
    "8 ounces dried rice noodles",
    "0.25 cup oyster sauce",
    "0.25 cup soy sauce",
    "1 tablespoon Asian fish sauce",
    "1 tablespoon maple syrup",
    "1 teaspoon white sugar",
    "2 tablespoons cold water",
    "2 tablespoons vegetable oil",
    "1 teaspoon sesame oil",
    "1 cup shallots, thinly sliced",
    "6 teaspoons chile padi (bird's eye chiles), thinly sliced",
    "4 cloves garlic, minced",
    "2.5 pounds skinless, boneless chicken thighs, cut into strips",
    "1 pound Chinese broccoli, sliced",
    "4 green onions, thinly sliced",
    "1 cup fresh Thai basil leaves"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JUmgVV2uzsLc5DbDdMlJLDLdiF0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8385585-chef-johns-drunken-noodles-VAT-Ingredients-d9e41ecd6c074b6db4a42e2c8d58735a.jpg"
      ],
      "image": "assets/images/8385585/step_01.webp"
    },
    {
      "text": "Soak rice noodles in hot water until flexible, 10 to 15 minutes. Occasionally move the noodles around to separate them. Drain the water and cover with a wet paper towel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n3-nZfD8pQD5RS2kMLl5WKFIFPs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8385585-chef-johns-drunken-noodles-VAT-01-1b6fe8d2be464bfeb1404d9e7992d9cc.jpg"
      ],
      "image": "assets/images/8385585/step_02.webp"
    },
    {
      "text": "Combine oyster sauce, soy sauce, Asian fish sauce, maple syrup, sugar, and water in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zouAxJMZwpdCN9AfjnHh0xoaXSA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8385585-chef-johns-drunken-noodles-VAT-02-e9238dd1984244829f88e505aff01ffe.jpg"
      ],
      "image": "assets/images/8385585/step_03.webp"
    },
    {
      "text": "Heat vegetable oil and sesame oil in a wok or large frying pan, over medium-high heat. Stir-fry shallots, chile peppers, and garlic until shallots are soft, about 2 minutes. Move the mixture around the outside of the pan to create a space and add chicken. Sear for 1 minute, then combine with shallot mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AI6KlcplwdtFYBKfa0yDo3K-xU0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8385585-chef-johns-drunken-noodles-VAT-03-616a92f3ecab4a79850a2f4b23a9cba6.jpg"
      ],
      "image": "assets/images/8385585/step_04.webp"
    },
    {
      "text": "Add Chinese broccoli stems and stir-fry until tender, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ObInzu930bYxvn6NrfSLfe4m1M0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8385585-chef-johns-drunken-noodles-VAT-04-bfac94d27e374d628ecab8cc622f66ed.jpg"
      ],
      "image": "assets/images/8385585/step_05.webp"
    },
    {
      "text": "Add Chinese broccoli leaves and stir-fry until wilted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pmC5fj8VE9_8tNzViIEsnuTn2lY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8385585-chef-johns-drunken-noodles-VAT-05-924d7f8c4de34596b7a1dfdfe64fc4c8.jpg"
      ],
      "image": "assets/images/8385585/step_06.webp"
    },
    {
      "text": "Add drunken noodle sauce and sliced scallions; mix well and cook until sauce begins to simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RhI6olhHGFsWHQ95NgGQlpkdE2c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8385585-chef-johns-drunken-noodles-VAT-06-7ade6012f7ff4a50b0887466eae7fadc.jpg"
      ],
      "image": "assets/images/8385585/step_07.webp"
    },
    {
      "text": "Add soaked rice noodles and toss to coat until noodles have absorbed the sauce and are cooked through, about 2 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QYMh8Zf-VK-zn_AsIb9Mn16_FH0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8385585-chef-johns-drunken-noodles-VAT-07-58baba98ab0b40cf852303142dff7354.jpg"
      ],
      "image": "assets/images/8385585/step_08.webp"
    },
    {
      "text": "Stir in Thai basil leaves until wilted. Taste and adjust seasoning if needed. Serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6ec76nMryzUn9dOk2kfp0AaplQ4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8385585-chef-johns-drunken-noodles-VAT-Beauty-4x3-77955c8ed35243d0b005e657abc623f8.jpg"
      ],
      "image": "assets/images/8385585/step_09.webp"
    }
