  "title": "Chocolate Chocolate Chip Cookies",
  "description": "These chocolate chocolate chip cookies are impossible to resist thanks to a double helping of chocolate in the form of cocoa and chocolate chips.",
  "authors": [
    "KATHY"
  ],
