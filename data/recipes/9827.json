  "ingredients": [
    "1.5 cups white sugar",
    "1 cup butter, softened",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "0.66666668653488 cup cocoa powder",
    "0.75 teaspoon baking soda",
    "0.25 teaspoon salt",
    "2 cups semisweet chocolate chips",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y46FXcTgsgfVVH-q_WBgcupziQM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9827-chocolate-chocolate-chip-cookies-i--DDMFS-038-4x3-step-01-e93c93baa4584b14ba0afeee040df584.jpg"
      ],
      "image": "assets/images/9827/step_01.webp"
    },
    {
      "text": "Beat sugar, butter, eggs, and vanilla in a large bowl until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/X9XzHMUWzrvXSE8_QltFa-XAVHU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9827-chocolate-chocolate-chip-cookies-i--DDMFS-039-4x3-step-02-300abe4862bc43f0a5d9b9c5670ac7ea.jpg"
      ],
      "image": "assets/images/9827/step_02.webp"
    },
    {
      "text": "Combine flour, cocoa powder, baking soda, and salt in another bowl; stir into butter mixture until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v35SSqZRayRbYTDKtX9TqP8Y_p4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9827-chocolate-chocolate-chip-cookies-i--DDMFS-040-4x3-step-031-ecee41a4912645099607df747301f7c5.jpg"
      ],
      "image": "assets/images/9827/step_03.webp"
    },
    {
      "text": "Stir chocolate chips and walnuts into dough until evenly distributed. Drop rounded tablespoonfuls of dough 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U70-RboREpS2aIMrSCv4TGVAivg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9827-chocolate-chocolate-chip-cookies-i--DDMFS-043-4x3-step-05-e913ab74df4344b7a729984cfe0f9810.jpg"
      ],
      "image": "assets/images/9827/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven just until set, 8 to 10 minutes. Cool slightly on the cookie sheets before transferring to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TNXq7YT7oi8Gy-ddb0c13dXwLz0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9827-chocolate-chocolate-chip-cookies-i--DDMFS-069-4x3-step-07-b898e34770ac44f7810f5e04e64b697e.jpg"
      ],
      "image": "assets/images/9827/step_05.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JCMYBY68TG5gPrZLIx8x_AgcVRg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/9827-chocolate-chocolate-chip-cookies-i--DDMFS-092-4x3-c8227481fd804270a50256498cf8f05f.jpg"
      ],
