  "ingredients": [
    "1 cup all-purpose flour",
    "3 teaspoons baking powder",
    "2 teaspoons white sugar",
    "1 teaspoon salt",
    "2 tablespoons shortening",
    "0.75 cup mashed sweet potatoes",
    "0.25 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together the flour, baking powder, sugar and salt. Cut in the shortening until pieces of shortening are pea-sized or smaller. Mix in the sweet potatoes, and enough of the milk to make a soft dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a floured surface, and roll or pat out to 1/2 inch thickness. Cut into circles using a biscuit cutter or a drinking glass. Place biscuits 1 inch apart onto a greased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 12 to 15 minutes in the preheated oven, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
