  "ingredients": [
    "3 tablespoons white sugar",
    "1 teaspoon ground cinnamon",
    "6 large Granny Smith apples - peeled, cored and sliced",
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "1 large egg",
    "1 teaspoon baking powder",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 3 tablespoons sugar and cinnamon in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer apples in an ungreased 9x13-inch baking pan, sprinkling each layer with cinnamon-sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 1 cup sugar, egg, and baking powder with a fork. Sprinkle over apples in the baking pan. Lightly sprinkle water over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is golden brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
