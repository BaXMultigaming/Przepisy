  "title": "Ukrainian Goulash",
  "description": "This Ukrainian take on a beef stew is a mixture of beef, onions, and garlic in a sauce made with steak sauce and paprika.",
  "authors": [
    "John and Karen K"
  ],
  "date_published": "2019-04-03T23:54:12-04:00",
