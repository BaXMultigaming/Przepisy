  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup graham cracker crumbs",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 pinch ground cinnamon",
    "1 cup butter, softened",
    "0.75 cup white sugar",
    "0.75 cup brown sugar",
    "1 teaspoon vanilla extract",
    "2 eggs",
    "2 cups miniature semisweet chocolate chips",
    "1.5 cups miniature marshmallows",
    "4 (1.55 ounce) bars milk chocolate candy bars (such as Hershey's®), chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, graham cracker crumbs, salt, baking soda, and cinnamon in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, brown sugar, and vanilla extract in a larger bowl until creamy. Add eggs, 1 at a time, beating well after each addition. Slowly beat in the flour mixture until smooth. Stir in chocolate chips. Drop dough by rounded tablespoons onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 8 minutes. Remove from oven. Push 3 to 4 marshmallows and a few pieces of milk chocolate into each cookie. Continue baking until chocolate is melted and cookies are golden, 3 to 4 minutes more. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
