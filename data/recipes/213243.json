  "ingredients": [
    "1 red bell pepper, cut into thin strips",
    "3 tomatoes, sliced",
    "6 (6 ounce) tilapia fillets",
    "1 cup water",
    "0.25 cup olive oil",
    "2 tablespoons paprika",
    "1 tablespoon chicken bouillon granules",
    "1 teaspoon cayenne pepper",
    "salt and pepper to taste",
    "0.25 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 200 degrees F (95 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer sliced red peppers and tomatoes in the bottom of a baking dish. Arrange tilapia fillets on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk water, oil, paprika, bouillon granules, cayenne, salt, and pepper together in a bowl; pour over tilapia, then sprinkle with parsley. Cover the baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tilapia flakes easily with a fork and vegetables tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
