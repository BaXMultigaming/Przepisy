  "ingredients": [
    "1 (6 ounce) package feta cheese, crumbled",
    "2 tablespoons olive oil",
    "1 teaspoon lemon juice",
    "0.5 teaspoon minced garlic",
    "2 ounces sun-dried tomatoes, softened",
    "0.5 teaspoon dried oregano",
    "1 tablespoon chopped black olives, drained"
  ],
  "steps": [
    {
      "text": "In a food processor, place the feta cheese, olive oil, lemon juice, garlic, sun-dried tomatoes and oregano. Using the pulse setting, blend the mixture until smooth. Transfer to a medium bowl. Blend in the olives by hand or with a spoon. Refrigerate until serving.",
