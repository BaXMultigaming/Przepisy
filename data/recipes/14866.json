  "ingredients": [
    "0.5 cup butter, softened",
    "1.5 cups all-purpose flour",
    "0.5 pound shredded Cheddar cheese",
    "1 teaspoon salt",
    "1 pinch crushed red pepper flakes",
    "1 dash hot pepper sauce",
    "0.75 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Blend together butter and flour in a medium bowl. Mix in Cheddar cheese, salt, red pepper flakes, hot pepper sauce, and pecans. Form dough into a roll and wrap in parchment paper. Refrigerate dough 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice dough into very thin wafers and place onto a baking tray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake wafers in the preheated oven until crisp, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
