  "ingredients": [
    "2 cups hot water",
    "2 (3 ounce) packages raspberry flavored Jell-O® mix",
    "1 (21 ounce) can blueberry pie filling",
    "1 (20 ounce) can crushed pineapple, drained",
    "1 (8 ounce) package cream cheese",
    "0.5 cup white sugar",
    "1 cup sour cream",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine hot water and gelatin in a bowl; stir until gelatin dissolved. Stir in pie filling and pineapple. Pour mixture into a 9x13-inch dish; chill until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and sugar together in a bowl until fluffy; beat in sour cream and vanilla until combined. Spread over fruit-gelatin mixture. Chill until ready to serve.",
      "section": null,
      "name": null,
