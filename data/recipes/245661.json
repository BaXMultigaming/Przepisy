  "ingredients": [
    "1 (14.5 ounce) can whole berry cranberry sauce",
    "1 (14 ounce) can jellied cranberry sauce",
    "0.5 (14.4 ounce) package graham crackers",
    "8 ounces heavy whipping cream",
    "2 teaspoons white sugar",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Chill a large metal bowl in the refrigerator or freezer, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine whole berry cranberry sauce and jellied cranberry sauce in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place graham crackers in a large resealable plastic bag; crush into crumbs using a rolling pin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat heavy cream in the chilled bowl with an electric mixer on high speed until soft peaks form, about 2 minutes. Add sugar and vanilla extract; beat until medium peaks form, about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1/2 graham cracker crumbs in the bottom of a trifle bowl; top with 1/2 each cranberry sauce and whipped cream. Repeat layers, ending with whipped cream. Chill until set, at least 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
