  "title": "Chewy Almond Butter Cookies",
  "description": "These almond butter cookies are easy to make with creamy almond butter for a nutty, sweet treat. A tasty alternative for anyone with peanut allergies.",
  "authors": [
    "mseve"
  ],
  "date_published": "2020-06-18T23:53:30-04:00",
