  "ingredients": [
    "1 cup shredded Monterey Jack cheese",
    "0.5 cup shredded Parmesan cheese",
    "1 green onion, chopped",
    "2 teaspoons minced fresh garlic",
    "1 teaspoon seasoned salt",
    "1 teaspoon paprika",
    "0.125 teaspoon red pepper flakes",
    "2 (6 ounce) cans white crabmeat, drained",
    "1 (17.5 ounce) package frozen puff pastry, thawed",
    "1 egg white, beaten"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease 2 baking sheets or use parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Monterey Jack cheese, Parmesan cheese, green onion, garlic, seasoned salt, paprika, and red pepper flakes together in a bowl. Fold in drained crabmeat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unfold pastry sheet on a lightly floured surface. Brush with some of the beaten egg white. Top with crab mixture. Roll up like a jelly roll starting at the short side. Cut into 1/2-inch slices. Place slices cut-side down on the prepared baking sheets. Brush with remaining egg white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 15 to 20 minutes. Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
