  "title": "Golden Rum Cake",
  "description": "This rum cake is buttery and delicious, topped with walnuts, and soaked in a decadent rum glaze for a super moist, crowd-pleasing holiday dessert.",
  "authors": [
    "Jackie"
  ],
  "date_published": "2000-02-25T20:20:33-05:00",
