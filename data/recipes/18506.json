  "ingredients": [
    "0.75 cup butter",
    "1.5 cups white sugar",
    "3 eggs",
    "1.5 teaspoons vanilla extract",
    "3.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons baking soda",
    "0.75 teaspoon salt",
    "1.5 cups sour cream",
    "1 (21 ounce) can apple pie filling",
    "1 cup chopped walnuts",
    "0.25 cup white sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease or line 24 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together butter and 1 1/2 cup sugar. Beat in eggs and vanilla. Combine flour, baking powder, baking soda and salt. Stir into the creamed mixture alternately with sour cream. Fold in apple pie filling and walnuts. Spoon batter into prepared muffin cups. Combine 1/4 cup sugar and cinnamon; sprinkle over the muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 16 to 18 minutes, until a toothpick inserted into the center of a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
