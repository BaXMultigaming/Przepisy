  "ingredients": [
    "1 cup white sugar",
    "0.66666668653488 cup vegetable oil",
    "2 eggs, beaten",
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1 cup finely grated carrot",
    "1 cup crushed pineapple, drained",
    "1 teaspoon vanilla extract",
    "0.5 cup butter, softened",
    "1 (8 ounce) package cream cheese, softened",
    "3 cups confectioners' sugar",
    "1 teaspoon vanilla extract",
    "1 tablespoon milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 12-cup muffin pan or line with paper cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the cupcakes: Stir white sugar, vegetable oil, and eggs together in a large mixing bowl until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, baking soda, cinnamon, and salt in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour mixture into egg mixture until thoroughly moistened. Mix in carrot, pineapple, and 1 teaspoon vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared muffin cups, filling them 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until muffin tops spring back when lightly pressed, about 20 minutes. Set aside to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the frosting: Cream butter and cream cheese in a bowl with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat in confectioners’ sugar, vanilla extract, and milk to make a spreadable frosting; frost the cooled cupcakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
