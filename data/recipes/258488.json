  "ingredients": [
    "0.75 cup brown sugar",
    "0.5 cup honey",
    "0.25 cup garlic powder",
    "0.25 cup onion powder",
    "1 tablespoon salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon ground cumin",
    "1 teaspoon cayenne pepper, or more to taste",
    "1 lime, sliced into wedges",
    "1 rack pork ribs",
    "1 (20 ounce) can pineapple chunks drained, juice reserved",
    "1 (12 fluid ounce) can or bottle beer"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, honey, garlic powder, onion powder, salt, black pepper, cumin, and cayenne pepper in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Squeeze lime juice over ribs; rub seasoning mixture on both sides. Place ribs in a large roasting pan (you may need to cut ribs in half to fit). Distribute pineapple chunks on top of ribs. Pour reserved pineapple juice and beer into the roasting pan around ribs. Cover pan tightly with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tender, 3 to 3 ½ hours. Cool before serving, 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
