  "ingredients": [
    "1 cup all-purpose flour",
    "3 tablespoons all-purpose flour",
    "0.5 teaspoon baking powder",
    "1 (14 ounce) can sweetened condensed milk",
    "4 eggs",
    "4 tablespoons unsalted butter, melted",
    "2 tablespoons confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1 cup plus 3 tablespoons flour and baking powder together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sweetened condensed milk, eggs, and melted butter in a medium bowl; add to flour mixture and beat with an electric mixer until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cake batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes; cool on a wire rack for 5 minutes. Run a knife around the edges to loosen; invert cake carefully onto a serving plate to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dust with confectioners' sugar before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
