  "ingredients": [
    "0.25 cup hot water",
    "2 tablespoons dried oregano",
    "1 teaspoon salt",
    "1 cup chopped fresh parsley, or more to taste",
    "0.66666668653488 cup chopped fresh cilantro",
    "6 cloves garlic",
    "1 shallot, roughly chopped",
    "1 red jalapeno pepper, chopped",
    "0.5 cup red wine vinegar",
    "0.75 cup extra virgin olive oil"
  ],
  "steps": [
    {
      "text": "Combine water, oregano, and salt in a small bowl and set aside until oregano has softened, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine parsley, cilantro, garlic, shallot, and jalapeno in the bowl of a food processor; pulse until chopped. Add water-oregano mixture and red wine vinegar and pulse until finely chopped. Transfer to a bowl and whisk in olive oil until emulsified.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover chimichurri sauce and let sit at room temperature until flavors have melded, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
