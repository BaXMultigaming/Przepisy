  "ingredients": [
    "2.25 cups brown rice flour",
    "0.75 cup packed brown sugar",
    "0.25 cup pecans, coarsely chopped",
    "1 teaspoon baking soda",
    "1 teaspoon lemon zest",
    "2 green tea bags (such as Organo™ Gold)",
    "1 cup butter, melted",
    "0.25 cup agave syrup",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown rice flour, brown sugar, pecans, baking soda, and lemon zest together in a mixing bowl. Cut open tea bags and add contents to the bowl. Add butter, agave syrup, and vanilla extract. Blend with a fork until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1-inch balls and place on a baking stone.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 11 to 13 minutes. Cool for 1 minute before transferring to a cooling rack. Gently press any broken cookies back together. Let cool. Repeat with remaining cookie dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
