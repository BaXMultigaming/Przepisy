  "ingredients": [
    "3 cups Pepperidge Farm® Cornbread Stuffing",
    "0.25 cup butter or margarine, melted",
    "1 (10.75 ounce) can Campbell's® Condensed Cream of Chicken Soup (Regular or 98% Fat Free)",
    "0.5 cup sour cream",
    "2 small yellow squash, shredded",
    "2 small zucchini, shredded",
    "0.25 cup shredded carrot",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix stuffing and melted butter together in a bowl. Spoon all but 1/2 cup stuffing into a shallow 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix condensed soup, sour cream, yellow squash, zucchini, carrot, and Cheddar together in another bowl. Spread over stuffing in the baking dish, then sprinkle remaining 1/2 cup stuffing over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until hot, about 40 minutes.",
      "section": null,
