  "ingredients": [
    "0.5 cup light mayonnaise",
    "0.5 cup milk",
    "4 large eggs, lightly beaten",
    "1 (10 ounce) package frozen chopped spinach, thawed and squeezed dry",
    "8 ounces shredded reduced-fat Cheddar cheese",
    "0.25 cup chopped onion",
    "1 (9 inch) unbaked pie shell"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a cookie sheet with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together mayonnaise and milk in a large bowl until smooth. Whisk in eggs; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer spinach, cheese, and onion in the pie shell, making several layers of each. Place on the prepared cookie sheet. Slowly pour egg mixture into the pie shell, then cover quiche with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Uncover and continue baking until the top is golden brown and filling is set, 10 to 15 more minutes.",
      "section": null,
      "name": null,
      "url": null,
