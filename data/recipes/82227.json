  "ingredients": [
    "4 (8 ounce) yams",
    "1 medium red bell pepper, seeded and diced",
    "2 avocados - peeled, pitted, and mashed",
    "0.25 cup chopped fresh cilantro",
    "0.25 cup olive oil",
    "2 green onions, sliced",
    "0.5 teaspoon ground cumin",
    "3 tablespoons lime juice",
    "salt and ground black pepper to taste",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place yams on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake yams for 40 minutes, or until tender, turning occasionally. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the red pepper, avocado, cilantro, olive oil, green onions, cumin and lime juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut yams in half lengthwise, and fluff the centers with a fork. Top with the avocado stuffing. Season with salt and pepper, and top with shredded Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
