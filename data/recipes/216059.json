  "title": "Kelsandra's Pumpkin Cinnamon Rolls",
  "description": "These pumpkin cinnamon rolls made with pumpkin puree are tender and moist with a swirl of sweet spices topped with a decadent cream cheese glaze.",
  "authors": [
    "dpht3"
  ],
  "date_published": "2020-06-18T23:43:38-04:00",
  "date_modified": "2026-01-20T15:26:19-05:00",
