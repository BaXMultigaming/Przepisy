    "Brunch"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "0.25 cup warm water (100 degrees F/38 degrees C)",
    "1 (.25 ounce) package active dry yeast",
    "1 (15 ounce) can pumpkin puree",
    "0.75 cup white sugar",
    "1 (5 ounce) can evaporated milk",
    "3 tablespoons olive oil",
    "1 large egg, beaten",
    "2 teaspoons pumpkin pie spice",
    "5 cups all-purpose flour, or more if needed",
    "0.25 cup melted butter",
    "1.25 cups brown sugar, packed",
    "2 tablespoons pumpkin pie spice",
    "1 cup confectioners' sugar",
    "0.25 cup milk",
    "2 tablespoons butter, melted",
    "1 (3 ounce) package cream cheese, softened",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/V5mcTiTcf085lkRscAo6oeOqJjU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216059-kelsandras-pumpkin-cinnamon-rolls-ddmfs-step-1-BG-25459-12a8e0b4287346b79036dcf1383de25a.jpg"
      ],
      "image": "assets/images/216059/step_01.webp"
    },
    {
      "text": "To make the dough: Pour warm water into a large mixing bowl and sprinkle yeast over top. Allow to stand until yeast begins to form a creamy foam, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ChMv2Z8ByIMQpAytB7omZ_6KH2c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216059-kelsandras-pumpkin-cinnamon-rolls-ddmfs-step-2-BG-25463-88635cdf3a3244808c0635ad3e9e4c08.jpg"
      ],
      "image": "assets/images/216059/step_02.webp"
    },
    {
      "text": "Add pumpkin puree, sugar, evaporated milk, olive oil, and egg to the yeast mixture; mix until thoroughly combined. Stir in pumpkin pie spice, then mix in about 5 cups of flour, or as needed, until a stiff dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SY3HLu3vJWUKEXzbv86SY2h5fbs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216059-kelsandras-pumpkin-cinnamon-rolls-ddmfs-step-4-BG-25468-228a6e14df704f2fb28c0556212a674b.jpg"
      ],
      "image": "assets/images/216059/step_03.webp"
    },
    {
      "text": "Turn dough out onto a floured work surface and knead until smooth and elastic, but still slightly sticky, about 8 minutes. Form dough into a ball, then place in an oiled bowl, cover with a cloth, and let rise in a warm place for about 45 minutes. (The dough will rise, but it won't double.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g-gYTaeUNqMYSPpk1yBgLE5jMto=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216059-kelsandras-pumpkin-cinnamon-rolls-ddmfs-step-7-BG-25506-22d34745041e433c92beacc58d7daa5e.jpg"
      ],
      "image": "assets/images/216059/step_04.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Punch down the dough, then roll it out on a floured work surface to an 18x26-inch rectangle. Brush the top with melted butter. Make the filling: Mix together brown sugar and pumpkin pie spice in a small bowl; sprinkle evenly over the buttered dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3WjD0sWgcM3WsVgWBFovQeaUFdk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216059-kelsandras-pumpkin-cinnamon-rolls-ddmfs-step-10-25515-3bdf3282d4ab443b935cd8d768ddf61f.jpg"
      ],
      "image": "assets/images/216059/step_06.webp"
    },
    {
      "text": "Start at the longer edge and roll dough over filling into a log. Pinch the seam closed, then use a serrated knife to cut the log into 12 equal rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MjOjhMCYnMhOFrtK5FnjJFjjIqM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216059-kelsandras-pumpkin-cinnamon-rolls-ddmfs-step-13-BG-25529-4d7d2a103f7140b3858153e94cf316df.jpg"
      ],
      "image": "assets/images/216059/step_07.webp"
    },
    {
      "text": "Transfer rolls to the prepared baking dish with the cut-sides facing up. Bake in the preheated oven until light golden brown on the edges, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/maZTHMhdwkEX5Cbrf4luSxWNcmQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216059-kelsandras-pumpkin-cinnamon-rolls-ddmfs-step-15-BG-25539-90158b9dd5934c8baf91ab15bf917d03.jpg"
      ],
      "image": "assets/images/216059/step_08.webp"
    },
    {
      "text": "While the rolls are baking, make the glaze: Beat confectioners' sugar, milk, butter, cream cheese, and vanilla in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-MRCcXS9djD_a4aBuoHYKiWBA_g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216059-kelsandras-pumpkin-cinnamon-rolls-ddmfs-step-16-BG-25536-52e8db73a9f24562acdf30a8c9d5fcfe.jpg"
      ],
      "image": "assets/images/216059/step_09.webp"
    },
    {
      "text": "Remove pumpkin rolls from the oven and immediately spread glaze over top. Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NFCBzdcVEBStcTO6sfun_pnEBoY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216059-kelsandras-pumpkin-cinnamon-rolls-ddmfs-beauty-4x3-BG-25550-89d8aecf12ce4e2fb4aa1fdda28586ef.jpg"
      ],
      "image": "assets/images/216059/step_10.webp"
    }
  ],
