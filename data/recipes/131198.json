  "title": "Tropical Shrimp Scampi",
  "description": "Pineapple juice adds a tropical flair to this yummy, sweet, and garlicky shrimp and pasta dish.",
  "authors": [
    "marcod"
  ],
  "date_published": "2018-06-08T09:44:04-04:00",
