  "ingredients": [
    "9-inch ready-made shortcrust pastry base",
    "0.25 cup butter",
    "1 leek, thinly sliced",
    "4 slices bacon, finely chopped",
    "3 eggs",
    "2 tablespoons Maille® Dijon Originale mustard",
    "0.33333334326744 cup cream",
    "0.66666668653488 cup Swiss cheese, grated"
  ],
  "steps": [
    {
      "text": "Prepare shortcrust pastry base in pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently fry leek and bacon in butter until leek softens. Whisk eggs, Maille® Dijon Originale mustard and cream together. Add the leek, bacon and cheese. Season and pour into pastry base.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 320 degrees F for 20-25 minutes or until set. Serve warm.",
