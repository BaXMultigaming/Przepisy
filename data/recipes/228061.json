  "ingredients": [
    "3 tablespoons butter",
    "4 (1 inch) cubes salt pork",
    "3 ribs celery, diced",
    "1 Spanish onion, diced",
    "1 clove garlic, minced",
    "5 potatoes, peeled and cut into 3/4 inch cubes",
    "5 cups clam juice",
    "2 bay leaves",
    "1 teaspoon dried tarragon",
    "1 teaspoon celery salt",
    "1.5 pounds fresh clams, shelled and chopped",
    "2 cups heavy cream",
    "5 dashes Worcestershire sauce",
    "0.25 teaspoon chopped fresh dill",
    "salt and ground black pepper to taste",
    "10 sprigs fresh parsley, for garnish"
  ],
  "steps": [
    {
      "text": "Melt butter in a stockpot over medium-high heat. Add salt pork, celery, onion, and garlic; cook until softened, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add potatoes, clam juice, bay leaves, tarragon, and celery salt; bring to a boil. Reduce heat to medium-low, cover the pot, and simmer until potatoes tender, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add clams; simmer, uncovered, for 5 minutes. Add cream, Worcestershire sauce, dill, salt, and black pepper; cook until flavors blend, about 7 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, remove and discard bay leaves; garnish with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
