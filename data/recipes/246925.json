  "ingredients": [
    "1 cup water",
    "1 cup all-purpose flour",
    "1 teaspoon white sugar",
    "1 teaspoon ground turmeric",
    "1 pinch salt",
    "oil for frying",
    "6 pods jackfruit, seeded",
    "2 cups milk",
    "4 (1 ounce) squares chocolate",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Mix water, flour, 1 teaspoon sugar, turmeric, and salt together in a bowl into a thick batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large saucepan or fryer. Dip jackfruit into the batter and deep-fry until golden brown, 2 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring milk to a boil in a small pot; boil for 2 minutes. Add chocolate; stir until melted and smooth. Add 1 tablespoon sugar; stir until dissolved, about 1 minute. Simmer chocolate sauce over low heat, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place fried jackfruit on a serving plate. Pour chocolate sauce on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
