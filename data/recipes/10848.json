  "ingredients": [
    "1 cup butter",
    "0.5 cup confectioners' sugar",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1 cup confectioners' sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease two cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and 1/2 cup confectioners' sugar in a bowl using an electric mixer until smooth. Stir in vanilla. Combine flour, salt, and 1/2 teaspoon of cinnamon; stir into butter mixture to form a stiff dough. Shape dough into 1-inch balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1 cup confectioners' sugar and 1 teaspoon cinnamon together in a shallow bowl. Roll balls in cinnamon mixture to coat; transfer cookies to prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until nicely browned, about 15 to 20 minutes. Cool cookies on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
