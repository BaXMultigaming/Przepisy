  "ingredients": [
    "0.25 cup olive oil",
    "1 onion, chopped",
    "2 carrots, diced",
    "2 stalks celery, chopped",
    "2 cloves garlic, minced",
    "1 bay leaf",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil",
    "2 cups dry lentils",
    "8 cups water",
    "1 (14.5 ounce) can crushed tomatoes",
    "0.5 cup spinach, rinsed and thinly sliced",
    "2 tablespoons vinegar",
    "salt to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HcvmuZDnN565Rd60YwoI7XYUuVU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13978-lentil-soup-DDMFS-046-56e200d7dba248bfae49223376224ca8.jpg"
      ],
      "image": "assets/images/13978/step_01.webp"
    },
    {
      "text": "Heat oil in a large soup pot over medium heat. Add onions, carrots, and celery; cook and stir until onion is tender, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pH-j5ZfM1Uvf346pG5kzyssjTZg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13978-Lentil-Soup-mfs-Steps-004-72279551d4434286a2dd2c6cd18a5d1a.jpg"
      ],
      "image": "assets/images/13978/step_02.webp"
    },
    {
      "text": "Stir in garlic, bay leaf, oregano, and basil; cook for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iyAlFTFm5CYpnv-VzG4XAdYopVc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13978-Lentil-Soup-mfs-Steps-006-6e7f16afcb8b4cb5b7847ce49dbb8ded.jpg"
      ],
      "image": "assets/images/13978/step_03.webp"
    },
    {
      "text": "Stir in lentils, and add water and tomatoes. Bring to a boil. Reduce heat and let simmer until lentils are tender, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tmQMsohu3GMDBwIGcIkAQc-ZEJw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13978-Lentil-Soup-mfs-Steps-011-437b7a5a454143cca4a70fce22de80de.jpg"
      ],
      "image": "assets/images/13978/step_04.webp"
    },
    {
      "text": "When ready to serve, stir in spinach and cook until it wilts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eK_7PY5_y9kFni5umOazZ_B63E4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13978-Lentil-Soup-mfs-Steps-014-4a7bf3ae34204618aa7e2f53684a6dbb.jpg"
      ],
      "image": "assets/images/13978/step_05.webp"
    },
    {
      "text": "Stir in vinegar and season with salt and pepper; taste and adjust as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s10cKCBwr-Gr5PJpfoWzng7ksWQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13978-Lentil-Soup-mfs-Steps-016-af33e3e305584caaad74103266ec1aa0.jpg"
      ],
      "image": "assets/images/13978/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
