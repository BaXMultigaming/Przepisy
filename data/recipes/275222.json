  "ingredients": [
    "0.5 cup fresh blackberries",
    "1 tablespoon white sugar",
    "0.5 tablespoon cornstarch",
    "2 tablespoons all-purpose flour",
    "2 tablespoons rolled oats",
    "2 tablespoons white sugar",
    "2 tablespoons melted butter",
    "0.25 teaspoon ground allspice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine blackberries, 1 tablespoon sugar, and cornstarch in a bowl; place into an oven-safe ramekin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, oats, 2 tablespoons sugar, butter, and allspice in a bowl until butter fully incorporated; place on top blackberry mixture.",
