  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9-inch baking dish with 1 tablespoon butter. Sprinkle 1 tablespoon sugar into buttered dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub remaining 1 tablespoon butter over pear halves; arrange pears cut sides down in prepared baking dish and sprinkle with remaining 1 tablespoon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Pour cream over pears and continue baking until tender, about 20 minutes more.",
      "section": null,
