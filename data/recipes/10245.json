  "ingredients": [
    "1.25 cups packed brown sugar",
    "1 cup butter, softened",
    "0.5 cup white sugar",
    "2 large eggs",
    "2 tablespoons milk",
    "2 teaspoons vanilla extract",
    "1.75 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "3 cups rolled oats",
    "2 cups semisweet chocolate chips",
    "1 cup chopped walnuts",
    "1 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OSJFWFfNpZX-r01SCvANr85dmIM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10245-Oatmeal-Chocolate-Coconut-Chewy-DDMFS-Step-1-d623a8c9c1f947f485d235c2d5ffc2d4.jpg"
      ],
      "image": "assets/images/10245/step_01.webp"
    },
    {
      "text": "Cream together brown sugar, butter, and white sugar in a large bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YeUa3jUCI-rxBoTgqOn6g2ST87w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10245-Oatmeal-Chocolate-Coconut-Chewy-DDMFS-Step-2-8b06d2dd6a204ab0a620b2510fd04941.jpg"
      ],
      "image": "assets/images/10245/step_02.webp"
    },
    {
      "text": "Beat in eggs one at a time, then stir in milk and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bPoYSGA0mJmv0txYjx03_72Y1G4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10245-Oatmeal-Chocolate-Coconut-Chewy-DDMFS-Step-3-50045cafcc78474bb69b84ac9e1937cf.jpg"
      ],
      "image": "assets/images/10245/step_03.webp"
    },
    {
      "text": "Combine flour, baking soda, and salt; stir into sugar mixture until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/24K3rj2H-fEFqWdL78twKze_Wac=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10245-Oatmeal-Chocolate-Coconut-Chewy-DDMFS-Step-5-b47fc8a32f13452d8630ae68582e9735.jpg"
      ],
      "image": "assets/images/10245/step_04.webp"
    },
    {
      "text": "Stir in oats, chocolate chips, walnuts, and coconut until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f2El0KFODPpz8pgiTneM-IrM-j4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10245-Oatmeal-Chocolate-Coconut-Chewy-DDMFS-Step-6-f31f8505237a4dc3bcf67b62306278b4.jpg"
      ],
      "image": "assets/images/10245/step_05.webp"
    },
    {
      "text": "Drop by rounded spoonfuls onto ungreased cookie sheets. Bake in the preheated oven for 10 to 12 minutes for a chewy cookie or 14 minutes for a firmer cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vf8HnDLDuNqZOUX4iWpcK-bbOOI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10245-Oatmeal-Chocolate-Coconut-Chewy-DDMFS-Step-7-23dfff937cfc460cb7b1f9735dbb5a87.jpg"
      ],
      "image": "assets/images/10245/step_06.webp"
    },
    {
      "text": "Cool for 1 minute on the cookie sheets and then remove to wire rack. Cool completely and then store in a tightly sealed container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w28L-n1ZUlvlBWYh_HrJUqjCKQo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10245-Oatmeal-Chocolate-Coconut-Chewy-DDMFS-4x3-c17991aef3054090aee5ebe26e45000c.jpg"
      ],
      "image": "assets/images/10245/step_07.webp"
    }
  ],
