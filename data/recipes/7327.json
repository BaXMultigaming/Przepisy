  "ingredients": [
    "1 (18.25 ounce) package German chocolate cake mix without pudding",
    "1 cup flaked coconut",
    "1 cup chopped walnuts",
    "4 cups confectioners' sugar",
    "2 tablespoons unsweetened cocoa powder",
    "6 tablespoons cola-flavored carbonated beverage",
    "1 cup butter",
    "1 (8 ounce) package cream cheese"
  ],
  "steps": [
    {
      "text": "Prepare cake mix as directed on package.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly grease the bottom and sides of one 9 x 13 inch baking pan. Sprinkle coconut and nuts over bottom of pan. Pour cake batter over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup melted butter or margarine, cream cheese and 2 cups confectioners' sugar. Beat until smooth. Pour (spoon) over cake batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 45 minutes or until a toothpick comes out clean. Let cake cool before frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Frosting: Combine cocoa, cola and 1/2 cup margarine in a saucepan. Cook over medium heat until mixture boils, stirring constantly. Remove from heat. Pour mixture over remaining confectioners' sugar. Beat until smooth. Spread icing over cake. (If you like a thicker icing add more confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
