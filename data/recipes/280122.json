  "title": "Blackberry and Ginger Cream Scones",
  "description": "Fresh blackberries, ginger, and heavy cream bring flavor and texture to these quick and easy baked scones.",
  "authors": [
    "Karen Shaw Whipple"
  ],
  "date_published": "2020-05-07T04:04:04-04:00",
