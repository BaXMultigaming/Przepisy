  "ingredients": [
    "2 cups all-purpose flour",
    "3 tablespoons white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground ginger",
    "5 tablespoons cold unsalted butter, cut into 1/4-inch pieces",
    "1 cup blackberries",
    "1 cup heavy cream",
    "2 tablespoons turbinado sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking powder, salt, and ginger together in a large bowl. Cut in butter with a pastry blender. Fold blackberries into the flour mixture gently. Add heavy cream and mix until batter just comes together, so berries don't get too mashed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into 6 large scones. Sprinkle with turbinado sugar and place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until scones are browned on top, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
