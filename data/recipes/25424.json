  "ingredients": [
    "0.5 cup ketchup",
    "0.25 cup molasses",
    "1 teaspoon dry mustard",
    "1 (16 ounce) can baked beans with pork",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "4 slices bacon",
    "1 large green bell pepper, chopped",
    "1.5 pounds ground beef"
  ],
  "steps": [
    {
      "text": "In a slow cooker, mix together ketchup, molasses, mustard, pork and beans, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon and bell pepper in a large skillet over medium heat for about 5 to 7 minutes, then add to the slow cooker. In same skillet, brown beef, and stir into the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook on High setting for 1 hour.",
