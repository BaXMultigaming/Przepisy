  "ingredients": [
    "3 eggs",
    "0.75 cup vegetable oil",
    "1 cup sugar",
    "1 teaspoon vanilla extract",
    "3 cups all-purpose flour",
    "0.25 teaspoon salt",
    "1 teaspoon baking powder",
    "1 cup mini semisweet chocolate chips",
    "1 cup coarsely chopped almonds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together eggs, oil, sugar, and vanilla extract until well blended. Sift together flour, salt, and baking powder; and stir into egg mixture until well mixed. Fold in chocolate chips and almonds. Form two logs, 3 inches in diameter, and place onto the baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes, then remove from the oven and cut into 1-inch diagonal slices. Lay slices on their sides on the cookie sheet and return to the oven for 10 minutes. Remove to cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
