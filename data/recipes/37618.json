  "ingredients": [
    "1.75 cups whole wheat flour",
    "1.5 cups all-purpose flour",
    "0.75 teaspoon salt",
    "0.33333334326744 cup vegetable oil",
    "1 cup water",
    "salt for sprinkling"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, stir together whole wheat flour, all-purpose flour, and 3/4 teaspoon salt. Pour in vegetable oil and water; mix until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough out on a lightly floured surface to a thickness of 1/8 inch or less. Place dough on an ungreased baking sheet, and mark squares out with a knife, but don't cut through. Prick each cracker with a fork a few times, and sprinkle with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 20 minutes in the preheated oven, or until crisp and light brown. Cool on the baking sheet, then separate into individual crackers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
