  "ingredients": [
    "2 tablespoons olive oil",
    "1 large onion, thinly sliced",
    "1.5 cups canned chickpeas, drained",
    "1 pound spinach",
    "0.5 cup minced fresh dill weed",
    "2 lemons, juiced",
    "salt and pepper to taste"
