  "ingredients": [
    "2 cups white sugar",
    "0.5 cup unsalted butter",
    "0.5 cup milk",
    "3 tablespoons cocoa powder",
    "2 cups rolled oats",
    "0.5 cup peanut butter",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Stir sugar, butter, milk, and cocoa powder together in a saucepan over medium heat; bring to a boil. Boil for 1 to 2 minutes; err on the side of longer because if it doesn't boil enough, it won't set. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Immediately stir in oats, peanut putter, and vanilla. Stir until completely mixed. Spoon onto waxed paper and let sit until hard, 10 to 15 minutes.",
