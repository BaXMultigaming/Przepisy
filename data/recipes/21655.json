  "ingredients": [
    "cooking spray",
    "2 (16 ounce) cans baked beans with pork",
    "0.25 cup molasses",
    "0.25 cup chopped onions",
    "4 tablespoons brown sugar",
    "2 tablespoons ketchup",
    "1 tablespoon prepared mustard",
    "2 slices bacon, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together baked beans with pork, molasses, onions, brown sugar, ketchup, and mustard together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vTKLga6eSLP-WjQxt_2JdagpRPc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/21655-Simple-Baked-Beans_Shot1_CD_555951-ba11b1a8a7f64a46beaecda435e84101.jpg"
      ],
      "image": "assets/images/21655/step_02.webp"
    },
    {
      "text": "Transfer mixture to the prepared dish and top with chopped bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Exe_5jh5e40xRFGORCLMmiSjJ7c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/757_SimpleBakedBeans_Shot2_CD_555981_A-77fe65f845a245eb91cc60249e77d085.jpg"
      ],
      "image": "assets/images/21655/step_03.webp"
    },
    {
      "text": "Cover and bake in the preheated oven until thickened, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve hot and enjoy!",
