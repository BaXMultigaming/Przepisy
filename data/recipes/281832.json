  "ingredients": [
    "1 cup cauliflower florets",
    "1 cup broccoli florets",
    "0.25 cup diced carrots",
    "cooking spray",
    "6 large eggs",
    "2.5 ounces shredded Cheddar cheese",
    "0.25 cup low-fat half-and-half",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cauliflower, broccoli, and carrots in a microwave-safe steamer; add water. Microwave vegetables until they are crisp-tender, about 3 minutes. Drain off water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray an 9-inch pie pan with nonstick spray. Spread vegetables in the pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a bowl until light and lemon colored. Add Cheddar cheese, half-and-half, salt, and pepper. Stir to combine and pour over the vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until eggs are set, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
