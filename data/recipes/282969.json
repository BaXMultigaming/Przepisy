  "ingredients": [
    "3 (5 ounce) cans chicken chunks, drained",
    "1.5 (8 ounce) packages cream cheese, softened",
    "1 (8 ounce) package shredded Cheddar cheese",
    "0.75 (12 fluid ounce) bottle Buffalo wing sauce (such as Frank's RedHot®), or to taste",
    "0.75 (8 ounce) bottle ranch dressing"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chicken chunks, cream cheese, Cheddar cheese, Buffalo sauce, and ranch dressing together until well combined. Transfer to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and browned, stirring at least once so the top doesn't burn, 30 to 40 minutes.",
