  "ingredients": [
    "0.75 cup superfine sugar",
    "0.66666668653488 cup butter, softened",
    "3 large eggs",
    "1 teaspoon vanilla extract",
    "1.5 cups self-rising flour",
    "1/4 cup milk"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a large bowl with an electric mixer until light and fluffy. Add eggs one at a time, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ai4MhGq18wzBdnFH3V_eAKt-mic=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/157877-vanilla-cupcakes-ddmfs-Step2-0383-8924198bdf2e4e19b57b9fa44f79aa3c.jpg"
      ],
      "image": "assets/images/157877/step_02.webp"
    },
    {
      "text": "Beat in vanilla extract. Add flour mixture, alternating with milk; mix only until no streaks of flour remain. Spoon batter into the prepared muffin cups, filling each 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z46dXmrbLzPd81O6AWI3TRt2IE0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/157877-vanilla-cupcakes-ddmfs-Step3-0384-607d461caac447cf962c4309b5f3c512.jpg"
      ],
      "image": "assets/images/157877/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until the tops spring back when lightly pressed, 18 to 20 minutes. Remove from the oven and let cool in the pan for a few minutes before transferring to a wire rack to cool completely before serving or frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yl0nWL0CggVbvQj1b3eh6fFrGLk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/157877-vanilla-cupcakes-ddmfs-Step5-0390-0cf507ffd50a42ce84c2f3b993da613e.jpg"
      ],
      "image": "assets/images/157877/step_04.webp"
    }
