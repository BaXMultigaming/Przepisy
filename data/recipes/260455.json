  "ingredients": [
    "3 pounds boneless, skinless chicken breasts, cut into large cubes",
    "1 cup plain yogurt",
    "1 cup lemon juice",
    "1 cup onion juice",
    "1 cup olive oil",
    "0.5 teaspoon chopped garlic",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon saffron",
    "8 skewers, or as needed"
  ],
  "steps": [
    {
      "text": "Mix yogurt, lemon juice, onion juice, olive oil, garlic, black pepper, and saffron together in a large bowl. Add chicken pieces to the marinade and toss to coat. Cover with plastic wrap and marinate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from marinade; thread through skewers. Discard unused marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, turning frequently, until golden brown on all sides and meat is no longer pink in the center, about 8 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
