  "ingredients": [
    "cooking spray",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons ground cinnamon",
    "1.5 teaspoons baking soda",
    "1.5 teaspoons salt",
    "4 large eggs",
    "2 cups white sugar",
    "1.5 cups oil",
    "1 (8 ounce) can crushed pineapple, drained",
    "1.3333333730698 cups finely grated carrots",
    "1 cup sweetened flaked coconut",
    "0.5 cup chopped walnuts",
    "1 stick unsalted butter, softened",
    "1 (8 ounce) package cream cheese, softened",
    "1.3333333730698 cups sifted powdered sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly spray a sheet cake pan or a 10x15-inch glass casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour, baking powder, cinnamon, baking soda, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in the bowl of a stand mixer until foamy. Slowly add in sugar and mix until incorporated. Beat in flour mixture alternately with the oil, beginning and ending with flour mixture. Fold in pineapple, carrots, coconut, and walnuts. Pour batter into the prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Remove from oven and cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine softened butter and cream cheese in a bowl. Whip until fluffy using an electric mixer. Add sifted powdered sugar and vanilla extract. Mix until well incorporated and fluffy. Spread over the cooled carrot cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
