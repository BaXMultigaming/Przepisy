  "ingredients": [
    "1 cup boiling water",
    "1 cup dates, pitted and chopped",
    "0.25 cup butter, softened",
    "1 cup white sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 cup chopped walnuts",
    "1 cup flaked coconut",
    "0.66666668653488 cup packed brown sugar",
    "6 tablespoons butter",
    "0.25 cup cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking pan. Pour boiling water over dates in a small bowl, and let stand until cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Measure flour, baking powder, soda, salt, and nuts into a small bowl. Stir to mix.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream 1/4 cup butter and white sugar together in a mixing bowl; beat in egg and vanilla. Add flour mixture to creamed mixture in three parts alternately with date mixture in two parts, beginning and ending with dry mixture. Spread cake batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until an inserted wooden pick comes out clean, 30 t0 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the topping: Mix coconut, brown sugar, 6 tablespoons butter and cream in a small saucepan over medium heat. Boil for three minutes. Spread over warm cake, and brown under broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
