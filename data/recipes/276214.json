  "ingredients": [
    "1.25 cups crushed cookies (such as Biscoff®)",
    "0.5 cup ground almonds, toasted",
    "0.25 cup powdered sugar",
    "0.5 teaspoon pumpkin pie spice",
    "0.25 cup pumpkin-flavored coffee liqueur (such as Pumpkin Spice Kahlua®)",
    "0.5 cup chocolate chips, melted",
    "0.25 cup pumpkin puree",
    "1 tablespoon pumpkin syrup (such as Torani®)",
    "24 pumpkin seeds"
  ],
  "steps": [
    {
      "text": "Combine crushed cookies, ground almonds, powdered sugar, and pumpkin spice in a bowl. Mix in coffee liqueur, melted chocolate chips, pumpkin puree, and pumpkin syrup until combined but sticky. Place in freezer until firm, 30 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll mixture into 1-inch balls. Sprinkle each ball with powdered sugar and top with 1 pumpkin seed.",
      "section": null,
