  "ingredients": [
    "0.33300000429153 cup boiling water",
    "2 cups dates, pitted and chopped",
    "0.5 cup shortening",
    "1 cup white sugar",
    "0.125 teaspoon ground cinnamon",
    "0.75 teaspoon salt",
    "0.125 teaspoon ground nutmeg",
    "2 eggs",
    "1 cup all-purpose flour",
    "0.25 teaspoon baking soda",
    "0.5 cup chopped walnuts",
    "0.25 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Pour boiling water over dates in a small bowl; set aside to cool. Preheat the oven to 325 degrees F (165 degrees C). Grease a 10x10-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream shortening and white sugar together in a medium bowl. Add eggs, one at a time, beating after each addition. Add dates, including any water; mix well. Sift together flour, cinnamon, salt, nutmeg, and baking soda; stir into date mixture. Then stir in the nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the mixture evenly into the prepared pan. Bake in the preheated oven for 45 minutes. Let cool, then cut into bars and roll each bar in confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
