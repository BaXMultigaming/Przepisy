  "title": "Beef Stew III",
  "description": "A can of beefy mushroom soup is added to this corn starch thickened beef, carrot and potato stew.",
  "authors": [
    "Jane Snider"
  ],
  "date_published": "1999-01-30T13:23:06-05:00",
