  "ingredients": [
    "1 cup Becel&reg; Salted Plant-Based Bricks",
    "1 cup icing sugar",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "2 cups all-purpose flour",
    "1 cup mini semi-sweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (160 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat Becel® Salted Plant-Based Bricks and sugar until well blended and lightened in color, about 2-3 minutes. Stir in vanilla extract and salt until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour until you almost have a ball of dough. Stir in mini chocolate chips and mix until the dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide dough into sixteen 1/2-inch to 1-inch (1.25 to 2.5-cm) balls, flattening with a fork dipped in flour or icing sugar. Arrange on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 12 to 17 minutes or until edges and bottoms are very lightly browned. Transfer cookies to wire rack and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
