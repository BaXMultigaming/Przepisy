  "ingredients": [
    "1 teaspoon margarine",
    "1 (14 ounce) can sweetened condensed milk",
    "1.25 cups heavy cream",
    "4 tablespoons unsweetened cocoa powder",
    "3 eggs",
    "2 tablespoons chocolate sprinkles, or as needed"
  ],
  "steps": [
    {
      "text": "Grease a 9-inch glass tube pan with margarine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sweetened condensed milk, cream, cocoa powder, and eggs in a blender; blend until smooth for 3 minutes. Pour in the prepared tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on high power until set, 7 to 8 minutes. Remove from microwave and cool slightly. Refrigerate until set completely. Cover with sprinkles before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
