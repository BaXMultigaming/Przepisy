  "title": "Persimmon Bars",
  "description": "Persimmon bars as done by my husband's grandmother for years. A family holiday favorite. Sweet frosting tops these delicious cakes.",
  "authors": [
    "Jessica Eymann"
  ],
  "date_published": "2020-06-18T23:06:09-04:00",
