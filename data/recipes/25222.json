  "ingredients": [
    "1 cup persimmon pulp",
    "1 teaspoon baking soda",
    "1 egg, beaten",
    "1 cup white sugar",
    "0.5 cup vegetable oil",
    "1 cup raisins",
    "1.5 cups all-purpose flour",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "1 teaspoon salt",
    "0.25 teaspoon ground cloves",
    "1 cup chopped walnuts",
    "1 cup confectioners' sugar",
    "2 tablespoons lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 10x15 inch jelly roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, stir together persimmon pulp and baking soda; set aside. In a separate bowl, mix together egg, white sugar, vegetable oil and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together flour cinnamon, nutmeg, salt and cloves. Stir persimmon mixture and egg mixture into the dry ingredients. Fold in walnuts. Spread batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 minutes. Meanwhile, combine confectioners' sugar and lemon juice. Stir until sugar is dissolved. Remove bars from oven and spread with glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
