  "ingredients": [
    "1 sleeve buttery round crackers (such as Ritz®), crushed",
    "2 tablespoons butter, melted",
    "4 cups water",
    "1 (32 fluid ounce) container chicken stock",
    "salt and ground black pepper to taste",
    "3 skinless, boneless chicken breast halves, cubed",
    "1 (26 ounce) can condensed cream of chicken soup",
    "1 (24 ounce) container sour cream, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Combine crackers and melted butter together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aHB1Pt31SiqK70Gh_kWu3LdCdow=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218621-easy-creamy-chicken-casserole-VAT-step-01-a27435cbd2fa43ba8e0c32cf19161019.jpg"
      ],
      "image": "assets/images/218621/step_01.webp"
    },
    {
      "text": "Bring water and chicken stock to a boil in a pot over high heat; season with salt and black pepper. Add chicken; reduce heat to a simmer, and cook, stirring occasionally, until chicken is no longer pink in the center, 5 to 7 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p1qE_4nv4vXfKmFs2o0nAJDjtJk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218621-easy-creamy-chicken-casserole-VAT-step-02-002eb72e571b4f9fac4a784c408dfd41.jpg"
      ],
      "image": "assets/images/218621/step_02.webp"
    },
    {
      "text": "Whisk cream of chicken soup and sour cream together in a large bowl. Stir in cooked chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5_N_ukOIWBsBUfSTnIUW8CYs_Po=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218621-easy-creamy-chicken-casserole-VAT-step-03-675788b7509240448a8d56b2b24b9106.jpg"
      ],
      "image": "assets/images/218621/step_03.webp"
    },
    {
      "text": "Transfer mixture into a 9x13-inch baking dish. Sprinkle cracker mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zDk1Qj0f2OIkuat1R2azkdLn6cM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218621-easy-creamy-chicken-casserole-VAT-step-04-f40d96b446904e488b48128913e5d430.jpg"
      ],
      "image": "assets/images/218621/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until bubbly, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/McVJ4NlqXyR-oWaBuxd1bvGSHjk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/218621-easy-creamy-chicken-casserole-VAT-step-05-171e9ce3f2584baea78fd5f19d2a542b.jpg"
