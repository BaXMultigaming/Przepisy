  "ingredients": [
    "1 pound kielbasa sausage",
    "1.5 cups ginger ale",
    "1 teaspoon brown sugar",
    "8 ounces honey mustard"
  ],
  "steps": [
    {
      "text": "Preheat oven to broil. Line a baking sheet with aluminum foil. Slice kielbasa diagonally into 1/4 inch pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium-size skillet saute kielbasa in ginger ale until they are heated through. Drain well. Arrange the kielbasa on the prepared baking sheet, then sprinkle them with brown sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil the kielbasa until the brown sugar melts and begins to crystallize, check after 3 to 5 minutes. Serve the kielbasa with honey mustard for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
