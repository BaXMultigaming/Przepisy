  "ingredients": [
    "6 tablespoons butter",
    "0.25 cup diced onion",
    "0.5 cup diced celery",
    "6 tablespoons all-purpose flour",
    "2 (14.5 ounce) cans vegetable broth",
    "2 (15 ounce) cans creamed corn",
    "1 (15 ounce) can whole kernel corn, drained",
    "2 tablespoons shredded carrot",
    "1 cup half-and-half cream",
    "0.75 cup skim milk",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground black pepper",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "In a large saucepan over medium heat, melt butter. Cook onions and celery in butter 3 minutes. Whisk in flour and cook 6 minutes more, until light brown. Whisk in broth and simmer 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in creamed corn, corn, carrot, half-and-half, milk, nutmeg, pepper and salt. Simmer over low heat 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
