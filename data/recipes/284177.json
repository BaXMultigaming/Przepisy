  "ingredients": [
    "0.5 cup mayonnaise",
    "0.5 cup sour cream",
    "1 tablespoon curry powder",
    "2 teaspoons turmeric powder",
    "1 teaspoon dried minced onion",
    "1 teaspoon lemon juice",
    "0.5 teaspoon garlic salt",
    "0.25 teaspoon ground cumin",
    "0.125 teaspoon cayenne pepper, or more to taste"
