  "ingredients": [
    "1 loaf Italian bread, cut into 1-inch cubes",
    "2 tablespoons olive oil",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 pint fresh strawberries, diced",
    "3 roma (plum) tomatoes, seeded and diced",
    "2 ounces crumbled feta cheese",
    "3 tablespoons red onion, diced",
    "0.25 cup olive oil",
    "0.25 cup red wine vinegar",
    "2 tablespoons honey"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss bread cubes with 2 tablespoons olive oil, garlic powder, onion powder, salt, and black pepper on a large baking sheet until evenly coated; spread mixture into a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until toasted, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer toasted bread to a large bowl and mix with strawberries, tomatoes, feta cheese, and onion. Whisk 1/4 cup olive oil, red wine vinegar, and honey in a small bowl; drizzle over bread and tomato salad. Toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
