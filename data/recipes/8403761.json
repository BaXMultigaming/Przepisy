  "ingredients": [
    "nonstick cooking spray",
    "1 (26 ounce) package frozen hash brown potatoes, thawed",
    "1 (10.75 ounce) can cream of chicken soup",
    "1 (8 ounce) package shredded Colby-Jack cheese, divided",
    "4 ounces sour cream",
    "4 ounces full-fat plain Greek yogurt",
    "3 tablespoons unsalted butter",
    "salt and freshly ground black pepper to taste",
    "0.25 teaspoon smoked paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Spray a 9x12-inch casserole dish with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain hash browns. Combine hash browns, soup, 5 ounces of shredded Colby-Jack cheese, sour cream, Greek yogurt, butter, salt, pepper, and paprika in a large bowl. Pour mixture into the prepared dish. Sprinkle remaining cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until casserole is bubbling and cheese has melted, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
