  "ingredients": [
    "0.25 cup maple syrup",
    "0.5 teaspoon ground chipotle pepper",
    "1 pound thick-cut bacon"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine maple syrup and chipotle powder in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a disposable aluminum pan on the upper rack of your grill or over one burner on indirect heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon strips directly on the hot grate and reduce heat to low. Grill bacon, turning frequently, until evenly browned and crisped to your liking, 4 to 6 minutes. Transfer cooked bacon to the prepared pan to keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return all cooked strips to grill and brush with maple-chipotle glaze on both sides and cook for 1 minute more. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
