  "ingredients": [
    "2 cups white sugar",
    "0.5 cup evaporated milk",
    "0.25 cup unsweetened cocoa powder",
    "0.5 cup butter",
    "0.5 cup peanut butter",
    "2 cups rolled oats"
  ],
  "steps": [
    {
      "text": "In a medium saucepan, put together the sugar, evaporated milk, cocoa powder, and butter; bring to a boil while stirring. Boil for 1 minute; remove from heat. Stir in the peanut butter and rolled oats. Drop by heaping teaspoonfuls onto waxed paper. Cool and serve.",
