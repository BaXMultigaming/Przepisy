  "ingredients": [
    "6 large yellow potatoes, peeled and cut into thin wedges",
    "0.75 cup water",
    "0.5 cup lemon juice",
    "0.33333334326744 cup extra-virgin olive oil",
    "1 tablespoon Dijon mustard",
    "1 teaspoon dried oregano",
    "1 pinch salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange potatoes in a single layer in a large baking dish or roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix water, lemon juice, olive oil, mustard, oregano, salt, and pepper together. Pour over the potatoes and stir to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, carefully turning over halfway through, until potatoes are tender and nearly all excess liquid has evaporated, 75 to 90 minutes.",
