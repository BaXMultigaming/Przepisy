  "ingredients": [
    "0.5 cup frozen blueberries",
    "0.25 cup frozen strawberries",
    "0.25 cup frozen raspberries",
    "0.25 cup raw sugar",
    "0.25 cup water",
    "1 tablespoon unsalted butter",
    "1 tablespoon unbleached all-purpose flour"
  ],
  "steps": [
    {
      "text": "Combine blueberries, strawberries, raspberries, sugar, water, and butter in a small saucepan. Bring to a boil and cook until berries break down, about 5 minutes. Reduce heat to medium and continue to simmer mixture, stirring occasionally, for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and allow to thicken until consistency is similar to a chutney or thick jam, adding flour to thicken even more if desired. Serve warm or chilled.",
