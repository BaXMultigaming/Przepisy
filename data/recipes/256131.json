  "ingredients": [
    "1 (4 ounce) bar white chocolate, chopped",
    "0.25 cup butter",
    "0.5 lime, zested",
    "1 egg",
    "0.33333334326744 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 teaspoon fresh lime juice",
    "0.66666668653488 cup all-purpose flour",
    "1 tablespoon all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white chocolate, butter, and lime zest in a saucepan over medium-low heat; cook and stir until completely melted, 5 to 10 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a bowl using an electric mixer until thickened and foamy; add white chocolate mixture, sugar, vanilla extract, and lime juice. Mix well. Fold 2/3 cup plus 1 tablespoon flour into mixture until batter is just mixed. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 15 to 25 minutes. Cool blondies before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
