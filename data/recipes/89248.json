  "ingredients": [
    "4 boneless, center cut pork chops",
    "0.33333334326744 cup uncooked brown rice",
    "0.66666668653488 cup uncooked white rice",
    "0.5 cup chopped onion",
    "0.25 cup butter",
    "8 ounces green peas",
    "1 (5 ounce) can sliced water chestnuts, drained",
    "4 ounces fresh mushrooms, sliced",
    "0.5 cup water",
    "10 ounces beef broth",
    "1 tablespoon Worcestershire sauce",
    "1 (1 ounce) envelope dry onion soup mix",
    "0.5 teaspoon pepper"
  ],
  "steps": [
    {
      "text": "In a large skillet over medium heat, brown pork chops on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly spray the slow cooker with cooking spray. Then place brown and white rice, onion, butter, peas, water chestnuts, and mushrooms in the slow cooker. Pour in water, broth, and Worcestershire sauce. Stir in onion soup mix, season with pepper, and top with pork chops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover, and cook on Low setting for 7 to 9 hours, or on High setting for 4 to 5 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
