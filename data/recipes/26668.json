  "ingredients": [
    "0.5 pound ground beef",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "10.75 fluid ounces skim milk",
    "1 teaspoon garlic salt",
    "1 (14.5 ounce) can French style green beans",
    "0.5 (32 ounce) package tater tots"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brown ground beef in a large skillet over high heat until browned and crumbly; drain fat. Stir in condensed soup, milk, garlic salt, and green beans. Pour mixture into a medium-sized casserole dish and top with a layer of tater tots.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until tater tots are browned and crispy, about 30 minutes.",
      "section": null,
