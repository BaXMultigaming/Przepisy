    "publisher-tested"
  ],
  "ingredients": [
    "0.25 cup warm water",
    "1 teaspoon active dry yeast",
    "1 cup cold water",
    "1 teaspoon salt",
    "3 cups bread flour",
    "1 tablespoon extra-virgin olive oil",
    "6 ounces low moisture mozzarella cheese, thinly sliced",
    "0.5 teaspoon dried oregano",
    "0.25 teaspoon freshly ground black pepper",
    "0.5 cup no salt added canned crushed tomatoes",
    "2 tablespoons extra-virgin olive oil",
    "6 leaves fresh basil, torn"
  ],
  "steps": [
    {
      "text": "Make the dough: Pour warm water into a large bowl, then sprinkle yeast over the top. Let stand for 5 minutes. Stir in cold water and salt. Stir in flour, 1 cup at a time until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4aHiNouO9t5ifT8jb1JlMheH6sE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70801_BrickOvenPizzaBrooklynStyle_ddmfs_Shot1_3x4_3794-bfdc38cb60984cb69d930638acaee72a.jpg"
      ],
      "image": "assets/images/70801/step_01.webp"
    },
    {
      "text": "Knead dough on a floured surface until smooth, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nwe37p5VDCEiYq8rl6cGX1KRBzY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70801_BrickOvenPizzaBrooklynStyle_ddmfs_Shot2_3x4_3800-ecf5300d9b044bb6adfef191ce23917f.jpg"
      ],
      "image": "assets/images/70801/step_02.webp"
    },
    {
      "text": "Divide in half and form into two tight dough balls. Coat with olive oil and refrigerate in a sealed container for at least 16 hours. Be sure to use a big enough container to allow dough to rise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Tu8L95uFVinbe7pTRUB7TV-K3Jo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70801_BrickOvenPizzaBrooklynStyle_ddmfs_Shot3_3x4_3805-208572f676254037a97b81ff46a33d3f.jpg"
      ],
      "image": "assets/images/70801/step_03.webp"
    },
    {
      "text": "Make the pizzas: Remove dough from the refrigerator one hour prior to using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven, with a pizza stone on the lowest rack, to 550 degrees F (288 degrees C). Lightly dust a pizza peel with flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare the first pizza: Lightly dust one dough ball with flour and stretch gradually until about 14 inches in diameter, or about the size of the pizza stone. Place on the floured peel.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4ACv2vx85CenByKauTFfG3NHPFg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70801_BrickOvenPizzaBrooklynStyle_ddmfs_Shot4_3x4_3842-92e01876be4f419e878154aa862dd459.jpg"
      ],
      "image": "assets/images/70801/step_06.webp"
    },
    {
      "text": "Lay 1/2 of the mozzarella on the crust, then sprinkle 1/4 teaspoon oregano and 1/8 teaspoon pepper over the top. Randomly arrange 1/4 cup crushed tomatoes over the pizza, leaving some empty areas, then drizzle 1 tablespoon olive oil over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f06rINDjktSDUs2o6HH9Eo6VCSo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70801_BrickOvenPizzaBrooklynStyle_ddmfs_Shot5_3x4_3844-dfa3954cae6c4b75868c0a7a6e131579.jpg"
      ],
      "image": "assets/images/70801/step_07.webp"
    },
    {
      "text": "With a quick back and forth jerk, make sure dough will release from the peel easily. Place the tip of the peel at the back of the preheated pizza stone, and remove the peel so that the pizza is left on the stone.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the crust begins to brown, 4 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slide the pizza onto the peel and remove from the oven; then slide off the peel onto a work surface. Sprinkle 1/2 of the basil leaves randomly over the pizza. Cut into wedges and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hzO9lkVt7QecqX8Ta-9ZUkXjL-o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70801_BrickOvenPizzaBrooklynStyle_ddmfs_Shot6_3x4_3847-0dee41cde0d84db788493a58a95afc88.jpg"
      ],
      "image": "assets/images/70801/step_10.webp"
    },
    {
      "text": "Follow Steps 5 through 9 to make the second pizza.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MQIuAFCtBJWiX9zk5Peh5Z1yTFk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/70801_BrickOvenPizzaBrooklynStyle_ddmfs_3x4_3852-2ef5d5e09aa6401d8041dc0a32c8aa27.jpg"
      ],
      "image": "assets/images/70801/step_11.webp"
    }
  ],
