  "ingredients": [
    "cooking spray",
    "1 spaghetti squash",
    "2 tablespoons butter",
    "0.25 cup brown sugar",
    "1 pinch ground nutmeg, or to taste",
    "1 pinch ground cinnamon, or to taste",
    "2 apples, peeled and thinly sliced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a baking sheet lightly with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat spaghetti squash in the microwave for 1 minute. Cut in half and scoop out seeds. Place cut-side down on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake squash in the preheated oven until softened, about 30 minutes. Flip over with tongs. Place 1 tablespoon butter into each cavity; sprinkle brown sugar inside. Dust squash with nutmeg and cinnamon and fill with sliced apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue baking squash until apple slices are tender, 30 to 40 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide apple slices among serving plates. Scrape squash out of the skin with a fork and drop over apple slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
