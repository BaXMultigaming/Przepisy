  "ingredients": [
    "18 ounces marzipan",
    "1 cup confectioners' sugar",
    "1 large egg white",
    "2.5 tablespoons all-purpose flour",
    "2 tablespoons rose water, or to taste"
  ],
  "steps": [
    {
      "text": "Combine marzipan, confectioners' sugar, egg white, and flour in a bowl. Knead into a smooth dough. Roll out to 1/3-inch thickness and cut into whatever shapes you like.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking sheet with baking parchment and place cookies onto it. Allow to dry, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies in the preheated oven until lightly browned, 12 to 15 minutes. Transfer to a wire rack and let cool. Brush the cooled cookies with rose water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
