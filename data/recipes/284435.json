  "ingredients": [
    "3.5 cups all-purpose flour",
    "5 large eggs",
    "1 tablespoon vegetable oil, or as needed",
    "1 tablespoon water, or as needed",
    "0.5 cup butter",
    "3 cloves garlic, minced",
    "salt to taste",
    "0.5 cup chopped fresh parsley",
    "0.25 cup grated Parmesan cheese, or to taste"
  ],
  "steps": [
    {
      "text": "Pour flour on a countertop and create a well in the center of the pile. Place eggs in the center with a splash of water and oil; use a fork to whisk and bring dough together. Knead until it forms a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut the dough ball into quarters on a floured surface and roll each piece out to 1/8- or 1/4-inch thickness. Cut into desired lengths and shapes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a pot of salted water to a boil. Add noodles and cook until tender yet firm to the bite, 4 to 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, bring butter to a simmer in a saucepan. Add garlic and salt. Mix in cooked noodles and top with parsley and Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
