  "ingredients": [
    "1 red bell pepper, cut into matchstick-sized pieces",
    "1 small onion, cut into matchstick-sized pieces",
    "4 cloves garlic, minced",
    "1 teaspoon dried basil",
    "0.25 teaspoon dried rosemary",
    "salt and ground black pepper to taste",
    "3.3333332538605 tablespoons olive oil",
    "3.3333332538605 tablespoons balsamic vinegar",
    "1 eggplant, sliced lengthwise 3/8-inch thick",
    "2 tablespoons olive oil, or as needed",
    "0.25 cup grated mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix red bell pepper, onion, and garlic in a large mixing bowl; season with basil, rosemary, salt, and pepper. Drizzle olive oil and balsamic vinegar over pepper mixture; toss to coat vegetables evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush eggplant slices with olive oil to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread about 1/3 of the pepper mixture into the bottom of a square glass baking dish; top with a layer of about 1/3 of the eggplant. Repeat layering twice more. Top final layer with mozzarella cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until cheese is browned and vegetables are bubbling, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
