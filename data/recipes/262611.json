  "title": "Dee-licious Greek Yogurt Banana Bread",
  "description": "Greek yogurt and 2 cups of mashed bananas add plenty of moisture to this delicious banana bread studded with chocolate chips and chopped walnuts.",
  "authors": [
    "Debbie Wind Bailey"
  ],
  "date_published": "2020-06-19T00:27:02-04:00",
