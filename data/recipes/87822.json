  "ingredients": [
    "0.125 cup extra virgin olive oil",
    "7 cloves garlic, sliced",
    "1 chile pepper, chopped",
    "1 head fresh broccoli, chopped",
    "1 bunch kale, stems removed and chopped",
    "0.25 cup sun-dried tomatoes, cut in thin strips",
    "juice of 2 limes",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large wok or skillet over high heat. Add garlic and chile pepper; cook and stir for 2 minutes, stirring frequently. Stir in broccoli; cook for 1 minute. Add kale and cook for 2 minutes, stirring frequently. Stir in sun-dried tomatoes. Pour in lime juice and season with salt; toss well.",
