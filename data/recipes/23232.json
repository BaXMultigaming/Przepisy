  "ingredients": [
    "4 cups confectioners' sugar",
    "0.5 cup unsweetened cocoa powder",
    "6 tablespoons butter",
    "0.25 cup milk",
    "1 tablespoon vanilla extract",
    "0.25 teaspoon salt",
    "1 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Butter a 9x9 inch dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, cocoa, butter, milk, vanilla and salt in the top of a double boiler over simmering water. Cook, stirring, until smooth. Remove from heat and beat until mixture loses its gloss. Stir in chopped nuts and pour quickly into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cool completely before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
