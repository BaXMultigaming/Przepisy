  "ingredients": [
    "1 pound purple sprouting broccoli",
    "2 tablespoons vegetable oil",
    "2 tablespoons toasted sesame oil",
    "6 cloves garlic, thinly sliced",
    "salt to taste",
    "2 teaspoons toasted sesame seeds, or to taste"
  ],
  "steps": [
    {
      "text": "Bring a large wide pot of salted water to a boil. Drop in broccoli and boil until dark green, 3 to 4 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable and sesame oils in a large skillet over medium-low heat. Add garlic and cook, stirring frequently, until fragrant and light brown, 2 to 3 minutes. Add broccoli and stir-fry until well seasoned with garlic oil, 2 to 3 minutes. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve sprinkled with sesame seeds.",
      "section": null,
