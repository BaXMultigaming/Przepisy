  "ingredients": [
    "3 tablespoons olive oil",
    "4 pounds beef oxtail, cut into pieces",
    "2 onions, chopped",
    "2 green bell pepper, chopped",
    "1 tablespoon minced garlic",
    "4 cups dry white wine",
    "1 cup beef broth",
    "3 bay leaves",
    "1 (1 ounce) square unsweetened chocolate",
    "2 tablespoons paprika",
    "0.5 teaspoon salt",
    "2 carrots, thickly sliced"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a Dutch oven over medium-high heat until smoking. Add oxtails; brown in batches and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onions, bell peppers, and garlic to the Dutch oven; cook, stirring constantly, until onions have softened and turned translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in white wine, bring to a simmer, and cook for 5 minutes. Add browned oxtails, beef broth, bay leaves, and chocolate; return to a simmer, then reduce heat to medium-low, cover, and simmer for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with paprika and salt; stir in carrots. Cover and simmer until carrots are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
