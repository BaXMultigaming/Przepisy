  "ingredients": [
    "4 large sweet potatoes",
    "0.5 cup softened butter",
    "1 cup heavy cream",
    "2 tablespoons vanilla extract",
    "0.5 cup packed light brown sugar",
    "1 teaspoon salt",
    "1 cup chopped pecans",
    "0.5 cup maple syrup",
    "2 eggs, beaten",
    "2 tablespoons maple syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sweet potatoes onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until soft, 45 minutes to 1 hour. Remove from the oven and cool slightly before peeling and placing into a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce the oven temperature to 350 degrees F (175 degrees C). Butter a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash warm potatoes with butter, cream, vanilla, brown sugar, salt, 1 cup pecans, 1/2 cup maple syrup, and beaten eggs. Spread potato mixture into the prepared casserole dish; sprinkle with remaining 1/4 cup pecans and 2 tablespoons maple syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until thoroughly hot, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
