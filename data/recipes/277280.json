  "ingredients": [
    "1 (10.5 ounce) can condensed cream of chicken soup",
    "1 cup water",
    "1 (1 ounce) packet ranch seasoning mix",
    "6 (4 ounce) pork chops",
    "1 cup sour cream"
  ],
  "steps": [
    {
      "text": "Stir condensed soup, water, and seasoning mix together in a slow cooker until well combined. Add pork chops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until pork chops are no longer pink in the center, 4 to 6 hours. An instant-read thermometer inserted into the center should read 145 degrees F (63 degrees C). Stir in sour cream during the last 10 minutes of cooking.",
