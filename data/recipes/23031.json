  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and reserve apple tops, then remove all but the bottom ½ inch of cores; arrange in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, cinnamon candies, and cinnamon in a small bowl; fill apples with brown sugar mixture. Add apple tops; sprinkle remaining mixture over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until apples are tender, 30 to 35 minutes.",
