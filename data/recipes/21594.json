  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "2.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.66000002622604 cup milk",
    "1 large egg, beaten",
    "3 tablespoons butter, melted",
    "1 teaspoon vanilla extract",
    "2 cups raspberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, and salt in a large bowl. Stir in milk, egg, butter, and vanilla until smooth. Fold in raspberries. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is firm, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
