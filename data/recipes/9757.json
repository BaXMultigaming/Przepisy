  "ingredients": [
    "1 cup butter, softened",
    "1.5 cups white sugar",
    "1 teaspoon ground allspice",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "3 eggs",
    "3.25 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 cup raisins",
    "0.5 cup molasses",
    "0.5 teaspoon salt",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (160 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl cream together butter, sugar and spices. Beat in the eggs one at a time. Sift in the flour, baking soda and salt and stir until well blended. Stir in molasses and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make bar cookies: Spread mixture on cookie sheet and bake for 25 minutes. Cut into bars while warm and let cool on wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make drop cookies: Preheat oven to 375 degrees F (190 degrees C). Drop batter about 2 inches apart on greased cookie sheet and bake 12 to 15 minutes. Let cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
