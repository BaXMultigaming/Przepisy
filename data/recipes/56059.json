        "https://www.allrecipes.com/thmb/t3-Gc2WGwwrceuZUf38Z_TR52qA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/56059-asian-coconut-rice-ddmfs-5474-hero-3x4-f887966c55854af2bf830296ecfad9e0.jpg"
