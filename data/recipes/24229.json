  "ingredients": [
    "1.5 cups shredded Cheddar cheese",
    "1 cup chunky salsa",
    "1 cup sour cream",
    "1 (8 ounce) package cream cheese, softened",
    "1 (1 ounce) package dry fiesta-style ranch dressing mix",
    "10 (10 inch) flour tortillas"
