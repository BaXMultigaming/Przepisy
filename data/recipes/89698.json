  "ingredients": [
    "1 cup unsweetened flaked coconut",
    "0.25 cup castor sugar or superfine sugar",
    "3 egg yolks",
    "0.5 cup self-rising flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the coconut, sugar and egg yolks to form a stiff dough. Squeeze into 1 inch balls, and roll each ball in flour to coat. Place on a baking sheet, spacing about 2 inches apart.",
