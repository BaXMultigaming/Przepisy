  "ingredients": [
    "1 lemon",
    "3 pounds uncooked medium shrimp, peeled and deveined",
    "1 tablespoon olive oil",
    "1 small onion, chopped",
    "2 ribs celery, chopped",
    "2 cloves garlic, crushed and chopped",
    "salt and ground black pepper to taste",
    "1 sprig fresh rosemary, chopped, or to taste",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon ground coriander",
    "1 bay leaf",
    "0.75 cup white wine, or to taste",
    "1 teaspoon Worcestershire sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Squeeze lemon over shrimp and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil over medium heat. Add onion, celery, and garlic. Season with salt and pepper and cook until tender, about 5 minutes. Stir in rosemary, basil, oregano, coriander, and bay leaf. Add white wine and Worcestershire sauce; cook until sauce is slightly reduced, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add shrimp to sauce and cook until pink, 5 to 7 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
