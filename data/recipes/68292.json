  "ingredients": [
    "3 slices bacon",
    "16 canned beef tamales, cut into 2-inch pieces",
    "4 cups diced cooked chicken",
    "2 cups whole kernel corn, drained",
    "2 cups canned tomatoes, drained",
    "1 cup raisins",
    "0.5 cup stuffed green olives",
    "1 tablespoon chili powder",
    "0.5 teaspoon salt",
    "0.25 cup butter",
    "1 cup chicken broth",
    "1 teaspoon Worcestershire sauce",
    "2 cups shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "In a skillet over medium heat, fry the bacon until evenly brown and crisp. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 4 quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix the tamales, chicken, corn, tomatoes, raisins, and olives. Season with chili powder and salt. Transfer to the prepared casserole dish. Dot with butter. In a separate bowl, mix the chicken broth and Worcestershire sauce. Pour over the casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 45 minutes in the preheated oven. Top with Cheddar cheese, and continue baking 15 minutes, or until cheese is melted and lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
