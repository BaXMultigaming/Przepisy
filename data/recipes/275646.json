  "ingredients": [
    "2 heads garlic",
    "0.5 teaspoon salt",
    "0.125 teaspoon red pepper flakes",
    "0.66666668653488 cup olive oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel garlic cloves and place into a small 2-cup baking dish or large ramekin. Sprinkle with salt and red pepper flakes. Drizzle with oil, ensuring all cloves are covered. Cover dish with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven until garlic cloves are soft and just starting to brown around the edges, 1 1/2 to 2 hours. Do not overcook, as garlic will become bitter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer garlic cloves to a clean jar. Cover lightly with oil. Seal lid and refrigerate; use within 3 to 5 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
