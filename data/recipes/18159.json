  "ingredients": [
    "4 cups white sugar",
    "4 cups water",
    "0.75 cup instant coffee granules",
    "4 cups vodka",
    "2 tablespoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Bring sugar and water to a boil in a 3-quart saucepan over medium heat. Reduce the heat and simmer for 10 minutes. Remove from the heat, stir in instant coffee, and allow to cool, 30 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When cool, stir in vodka and vanilla extract. Pour into clean bottles. Close the bottles tightly and store in a cool dark place.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
