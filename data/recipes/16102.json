  "title": "Chicken Biryani",
  "description": "Chicken biryani is a traditional South Asian rice dish with tender chunks of chicken in a creamy, spicy blend of onion, garlic, tomatoes, and spices.",
  "authors": [
    "Nazia"
  ],
  "date_published": "1999-12-19T23:47:13-05:00",
  "date_modified": "2026-02-23T08:06:49-05:00",
