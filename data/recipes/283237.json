  "ingredients": [
    "3/4 cup chocolate almond milk",
    "2 tablespoons powdered peanut butter (such as PB2®)",
    "1 tablespoon cacao powder",
    "0.25 cup black beans, rinsed and drained",
    "0.5 cup ice"
  ],
  "steps": [
    {
      "text": "Combine chocolate almond milk, peanut butter powder, and cacao powder in a high-speed blender (such as Vitamix®). Add black beans and ice. Secure lid into place. Blend on speed variable 1, slowly moving up to the top speed. Blend for 1 minute until ice is incorporated.",
      "section": null,
      "name": null,
