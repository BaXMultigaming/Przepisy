  "ingredients": [
    "3 ounces butter",
    "4 cloves garlic, crushed",
    "salt and ground black pepper to taste",
    "1 pinch dried oregano, or to taste",
    "2 salmon steaks"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in the microwave, about 30 seconds. Stir in crushed garlic; season with salt, pepper, and oregano.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon steaks on a large sheet of aluminum foil; pour butter sauce on top. Wrap tightly to enclose; place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
