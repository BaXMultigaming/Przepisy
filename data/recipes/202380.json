  "ingredients": [
    "2.5 cups milk",
    "1 (16 ounce) box sweet rice flour (mochiko)",
    "1.5 cups white sugar",
    "1 cup canola oil",
    "1 teaspoon baking powder",
    "3 eggs, beaten",
    "0.5 (18.75 ounce) can sweetened red bean paste",
    "2 tablespoons toasted sesame seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together milk, rice flour, sugar, canola oil, and baking powder in a large bowl until combined. Stir in beaten eggs until incorporated. Pour mixture into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop small spoonfuls of red bean paste into batter, 1 to 2 inches apart; make sure red bean paste is covered by batter. Sprinkle with sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 55 minutes. Cool in the pan for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
