  "ingredients": [
    "2 cups cubed, cooked chicken",
    "1 cup chopped celery",
    "1 cup mayonnaise",
    "0.5 teaspoon curry powder, or more to taste",
    "1 (20 ounce) can pineapple chunks, drained",
    "1 (11 ounce) can mandarin oranges, drained",
    "2 large firm bananas. sliced",
    "0.5 cup sweetened flaked coconut",
    "0.75 cup salted peanuts"
  ],
  "steps": [
    {
      "text": "Place chicken and celery into a large bowl. Combine mayonnaise and curry powder in another bowl; add to chicken mixture and mix well. Cover and chill for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pineapple, oranges, bananas, and coconut before serving; toss gently. Sprinkle with peanuts.",
