  "ingredients": [
    "2 pounds buttercup squash, halved and seeded",
    "2 baking apples, cut into 1/2-inch slices, or more to taste",
    "0.5 cup packed brown sugar",
    "0.25 cup butter, melted",
    "1 tablespoon all-purpose flour",
    "1 teaspoon salt",
    "0.5 teaspoon ground mace",
    "0.5 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x11-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place squash on a flat work surface. Trim off the hard outer rind with a knife. Cut squash into 1/2-inch slices; arrange slices over the bottom of the prepared dish. Arrange apples on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, butter, flour, salt, and mace together in a bowl. Pour mixture over the apples. Sprinkle cranberries on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown and apples are tender, 50 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
