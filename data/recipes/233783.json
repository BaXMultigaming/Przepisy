  "ingredients": [
    "3 cups all-purpose flour",
    "1.5 tablespoons baking powder",
    "1.25 teaspoons garlic powder, divided",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground white pepper",
    "0.25 cup shortening",
    "1 cup milk",
    "0.5 cup shredded Cheddar cheese",
    "12 slices pepperoni, diced",
    "0.25 cup melted butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, 3/4 teaspoon garlic powder, salt, and white pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut shortening into flour mixture with a knife or pastry blender until the mixture is slightly lumpy. Stir milk, Cheddar cheese, and pepperoni into flour mixture until well blended. Drop 2-inch balls onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter and remaining 1/2 teaspoon garlic powder together in a small bowl; brush onto biscuits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
