  "ingredients": [
    "1 fresh pineapple",
    "0.25 cup rum",
    "0.25 cup brown sugar",
    "1 tablespoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Peel and core whole pineapple, then slice into eight rings. Place pineapple rings in a shallow dish or resealable plastic bag. Mix together rum, brown sugar, cinnamon, ginger, nutmeg, and cloves in a small bowl. Pour marinade over pineapple. Cover and refrigerate 1 hour to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill for high heat. Lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pineapple rings from the dish and reserve remaining marinade for serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill pineapple rings until dry and char-marked, about 7 minutes on each side. Serve with remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
