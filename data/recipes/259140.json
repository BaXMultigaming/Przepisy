  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "5 tablespoons butter, softened",
    "1 (3 ounce) package smoked salmon, cut into 1-inch chunks",
    "1 teaspoon Worcestershire sauce",
    "1 teaspoon dried dill weed",
    "0.25 teaspoon paprika",
    "3 drops liquid smoke flavoring",
    "0.25 cup heavy whipping cream, or as needed"
  ],
  "steps": [
    {
      "text": "Beat cream cheese and butter together in a bowl using an electric mixer. Fold in salmon, Worcestershire sauce, dill, paprika, and liquid smoke; stir well. Stir in cream until reaches desired consistency.",
