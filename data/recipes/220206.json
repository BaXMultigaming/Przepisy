  "ingredients": [
    "0.75 cup brown mustard seeds",
    "0.25 cup yellow mustard seeds",
    "1 cup dark beer, or as needed",
    "2 cloves garlic, minced",
    "0.5 cup apple cider vinegar",
    "2 tablespoons brown sugar",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Soak brown and yellow mustard seeds with dark beer in a large bowl; set in the refrigerator for 24 hours. If the seeds soak up the beer too quickly, add more beer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer soaked mustard seeds to a food processor along with garlic, apple cider vinegar, brown sugar, salt, and black pepper. Pulse until desired consistency is reached.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sterilize three 1/2-pint canning jars and lids in boiling water for at least 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pack mustard into the hot, sterilized jars, filling the jars to within 1/4 inch of the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Run a knife or a thin spatula around the insides of the jars after they have been filled to remove any air bubbles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wipe the rims of the jars with a moist paper towel to remove any food residue. Top with lids, and screw on the rings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate the jars of mustard for 2 weeks before using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
