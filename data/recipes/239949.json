  "ingredients": [
    "cooking spray",
    "1 cup rolled oats",
    "1 cup brown sugar",
    "1 cup all-purpose flour",
    "0.75 cup melted butter",
    "4 Red Delicious apples - peeled, cored, and thinly sliced",
    "0.75 cup white sugar",
    "3 tablespoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch square baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together oats, brown sugar, flour, and melted butter in a large bowl until crumbly. Spread 1/2 of the oat mixture into the bottom of the prepared baking dish and press firmly to form a crust. Arrange apple slices over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together white sugar and cinnamon in a medium bowl; sprinkle over apples. Crumble remaining oat mixture on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is golden brown, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
