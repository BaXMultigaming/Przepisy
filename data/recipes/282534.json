  "ingredients": [
    "2 (14.5 ounce) cans vegetable broth",
    "1 cup dry lentils, rinsed",
    "2 (14.5 ounce) cans stewed tomatoes, undrained",
    "1 small sweet potato (garnet yam), cut into small cubes",
    "0.5 cup chopped onion",
    "6 cloves garlic, minced, or more to taste",
    "2 bay leaves",
    "1 teaspoon yellow curry powder",
    "0.5 teaspoon cumin seeds",
    "0.5 teaspoon kosher salt",
    "1 pint cream"
  ],
  "steps": [
    {
      "text": "Combine broth and lentils in a large pot over medium-high heat; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in stewed tomatoes, sweet potato, onion, garlic, and bay leaves. Return to a boil, then reduce heat and simmer for 35 minutes. Stir in curry powder, cumin seeds, and salt. Simmer until lentils are soft, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Taste to adjust spices. Stir in cream and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
