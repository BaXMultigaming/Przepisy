  "ingredients": [
    "3 cups all-purpose flour",
    "0.5 cup white sugar",
    "1 cup butter",
    "0.5 teaspoon salt",
    "4 eggs",
    "1.5 cups light corn syrup",
    "1.5 cups white sugar",
    "3 tablespoons margarine, melted",
    "1.5 teaspoons vanilla extract",
    "2.5 cups chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease the sides and bottom of one 15x10 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine the flour, 1/2 cup sugar, margarine or butter and salt until the mixture resemble coarse crumbs. Press firmly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl stir the eggs, corn syrup 1 1/2 cups white sugar, melted margarine and vanilla until blended. Stir in the chopped pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread the filling evenly over the hot crust. Bake at 350 degrees F (175 degrees C) for 25 minutes or until set. Let cool before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
