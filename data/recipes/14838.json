  "ingredients": [
    "1 French baguette, cut into 1/2 inch thick circles",
    "8 plum tomatoes, diced",
    "1 cup chopped fresh basil",
    "0.5 red onion, minced",
    "freshly ground black pepper",
    "3 cloves garlic"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine tomato, basil, and red onion in a small mixing bowl; stir well. Season with freshly ground black pepper. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bread on a baking sheet. Place in oven, and bake until well toasted, approximately 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove bread from oven, and transfer to a large serving platter. Let bread cool 3 to 5 minutes. Rub garlic into the top of each slice of toast; the toast should glisten with the garlic. Spoon the tomato mixture generously onto each slice, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
