  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup buckwheat flour",
    "0.75 cup white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "0.75 cup milk",
    "1 egg",
    "2 tablespoons margarine, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk all-purpose flour, buckwheat flour, sugar, baking powder, and salt together in a bowl. Add milk, egg, and margarine; beat until batter is smooth. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted into the center of the cake comes out clean, 30 to 40 minutes.",
