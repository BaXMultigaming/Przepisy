  "title": "Cranberry Oatmeal Drops",
  "description": "An oatmeal drop cookie with tangy cranberries added to it. These are great topped with orange icing.",
  "authors": [
    "Tammy M Curry"
  ],
  "date_published": "2000-01-01T11:27:59-05:00",
