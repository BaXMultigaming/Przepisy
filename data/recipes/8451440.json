  "ingredients": [
    "2 pounds patty pan squash",
    "1 small red onion",
    "2 tablespoons olive oil",
    "2 teaspoons ground coriander",
    "1 teaspoon kosher salt",
    "0.5 teaspoon ground black pepper",
    "3 tablespoons unsalted butter, melted",
    "1 tablespoon lemon zest",
    "2 tablespoons lemon juice",
    "2 tablespoons chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a rimmed baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut squash into 1/2-inch wedges. Slice onion vertically into thin slices. Combine squash, onion, oil, coriander, salt, and pepper in a large bowl; toss to coat. Spread in an even layer on the prepared baking sheet. Set bowl aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until squash is tender and slightly browned, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, lemon zest, lemon juice, and chives in the reserved bowl. Add squash; toss well and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
