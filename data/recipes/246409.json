  "ingredients": [
    "2 whole roasted red peppers",
    "0.66666668653488 cup fresh basil leaves",
    "2 tablespoons lemon juice",
    "3 cloves garlic, peeled and halved, or more to taste",
    "1.5 cups light mayonnaise (such as Hellmann's® Light)",
    "2 teaspoons white sugar",
    "1 teaspoon salt, or to taste",
    "1 teaspoon ground black pepper, or to taste"
  ],
  "steps": [
    {
      "text": "Place roasted red peppers and basil in a food processor; pulse until coarsely chopped and combined. Add lemon juice; pulse 3 times. Scatter garlic halves over mixture; pulse to chop, 4 to 5 times. Add mayonnaise and sugar; pulse until smooth, 5 to 7 times. Season with salt and pepper.",
