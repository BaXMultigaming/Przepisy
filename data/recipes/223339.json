  "ingredients": [
    "3 cups brown sugar",
    "3 eggs, beaten well",
    "2 tablespoons anise seed",
    "0.5 teaspoon salt",
    "1 teaspoon baking soda",
    "2 tablespoons hot water",
    "4.5 cups all-purpose flour",
    "0.5 cup white sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and eggs together in a large bowl until smooth; stir in anise seeds and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dissolve baking soda in hot water in a small bowl; stir into brown sugar mixture. Add flour; mix to form a dough. Roll dough into 36 small balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place white sugar in a wide, shallow dish. Roll dough balls in sugar to coat; place on the prepared baking sheets about 1 inch apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are crispy, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
