  "ingredients": [
    "4 tablespoons butter, divided",
    "0.5 pound ground beef",
    "0.75 cup chopped onion",
    "0.75 cup shredded carrots",
    "0.75 cup chopped celery",
    "4 cups cubed potatoes",
    "3 cups chicken broth",
    "1 teaspoon dried basil",
    "1 teaspoon dried parsley",
    "0.25 cup all-purpose flour",
    "1.5 cups milk",
    "2 cups cubed Cheddar cheese",
    "0.25 cup sour cream",
    "sliced green onions for garnish"
  ],
  "steps": [
    {
      "text": "Melt 1 tablespoon butter in a large pot over medium heat; add ground beef, onion, carrots, and celery. Cook and stir until beef is brown and crumbly, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HscUpRut7e4V20oZy316Z45u8Hs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13062-cheeseburger-soup-step1-552-13a5e163a44a47599d1c029b674fc1da.jpg"
      ],
      "image": "assets/images/13062/step_01.webp"
    },
    {
      "text": "Stir in potatoes, broth, basil, and parsley; bring soup to a boil. Reduce heat to low and simmer until potatoes are tender, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Mlsc5JwVFY0UhSlQaNWIC8uo2KM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13062-cheeseburger-soup-step2-599-346b9148b5bf455ebbcbf91b55e5efe2.jpg"
      ],
      "image": "assets/images/13062/step_02.webp"
    },
    {
      "text": "Melt remaining 3 tablespoons butter in a small saucepan over medium heat. Add flour; whisk until smooth, about 1 minute. Gradually whisk in milk. Simmer, whisking continuously, until sauce is thick and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6NV0zg1gSeQAXjhaFH1z_qj1jmc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13062-cheeseburger-soup-step3-554-2260de077a0249e999c11e763c70da12.jpg"
      ],
      "image": "assets/images/13062/step_03.webp"
    },
    {
      "text": "Pour sauce into soup mixture, stirring constantly. Bring to a boil over high heat; reduce heat to low. Add cheese and stir until melted. Add sour cream; stir until just heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/h8kRi9NnRcqTi2Py9Qsfm-htBZc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13062-cheeseburger-soup-step5-609-2430201d277c41a08e198948a44eef50.jpg"
      ],
      "image": "assets/images/13062/step_04.webp"
    },
    {
      "text": "Serve garnished with green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oTQRFMStJ4zxoBRWm1gYDvJoays=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13062-cheeseburger-soup-3x4-638-45cf610a6271431aa5f60f3762bf0b5a.jpg"
      ],
