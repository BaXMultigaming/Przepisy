  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup brown sugar",
    "0.75 cup old-fashioned oats",
    "0.5 cup butter, melted",
    "1 teaspoon ground cinnamon",
    "4 cups chopped rhubarb",
    "1 cup water",
    "1 cup white sugar",
    "2 tablespoons cornstarch",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, oats, melted butter, and cinnamon in a medium bowl until crumbly; press into the bottom of a 9-inch square baking dish. Spread rhubarb in an even layer over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, white sugar, cornstarch, and vanilla in a small saucepan over medium-low heat; cook, stirring occasionally, until thick and clear, 5 to 10 minutes. Drizzle sauce over rhubarb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is set, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
