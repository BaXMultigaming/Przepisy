  "ingredients": [
    "2 tablespoons olive oil",
    "1 pound Japanese or other small eggplant, cut into 1/2-inch cubes",
    "1 onion, chopped",
    "3 cloves garlic, minced",
    "1 teaspoon dried oregano",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground allspice",
    "0.5 teaspoon salt",
    "0.5 teaspoon black pepper",
    "1 (14.5 ounce) can fire-roasted diced tomatoes",
    "1 cup water",
    "0.33333334326744 cup dry red wine",
    "1 bay leaf",
    "2 tablespoons white sugar",
    "3 tablespoons capers, drained",
    "2 tablespoons red wine vinegar"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Cook eggplant, onion, garlic, oregano, cinnamon, allspice, salt, and pepper, stirring frequently, until onion is slightly browned, 7 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium and add tomatoes, water, wine, and bay leaf. Simmer, stirring frequently, until eggplant is tender and mixture is thickened, 13 to 15 minutes. Remove from heat and stir in sugar, capers, and vinegar. Let cool 30 minutes, then discard bay leaf. Serve at room temperature or chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
