  "ingredients": [
    "2 red apples",
    "0.25 cup raisins",
    "1 tablespoon peanut butter",
    "8 thin pretzel sticks"
  ],
  "steps": [
    {
      "text": "Slice apples in half from top to bottom and scoop out the cores using a knife or melon baller. If you have an apple corer, core them first, then slice. Place each apple half flat side down on a small plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dab peanut butter on to the back of the 'lady bug', then stick raisins onto the dabs for spots. Use this method to make eyes too. Stick one end of each pretzel stick into a raisin, then press the other end into the apples to make antennae.",
      "section": null,
      "name": null,
