  "ingredients": [
    "0.5 white onion, minced",
    "4 serrano chile peppers, minced",
    "1 teaspoon kosher salt",
    "4 avocados - peeled, pitted and diced",
    "2.5 tablespoons fresh lime juice",
    "1 pear - peeled, cored and diced",
    "1 cup seedless green grapes, halved",
    "1 cup pomegranate seeds"
  ],
  "steps": [
    {
      "text": "Mix the onion, chile peppers, and salt in a bowl. Fold in the avocados and lime juice. Stir in pear, grapes, and pomegranate. Chill until serving.",
