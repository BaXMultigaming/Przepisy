  "ingredients": [
    "1 pound ground beef",
    "0.25 white onion, chopped",
    "1.5 teaspoons garlic salt",
    "salt and ground black pepper to taste",
    "2 zucchini",
    "1 (15 ounce) can tomato sauce",
    "1 tablespoon oil, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, onion, garlic salt, salt, and pepper in a bowl; mix well. Shape into 1 1/2-inch balls. Arrange meatballs in a glass baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until meatballs are browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut zucchini into noodle shapes with a spiralizer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tomato sauce in a saucepan over medium heat; add meatballs. Reduce heat to low. Cook, covered, until sauce and meatballs are evenly warmed, about 5 minutes. Remove from heat; keep covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat. Add zucchini, salt, and pepper; cook and stir until tender but firm to the bite, about 5 minutes. Transfer zucchini to a serving plate; top with tomato sauce and meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
