  "ingredients": [
    "0.5 cup heavy whipping cream",
    "1 small cinnamon stick",
    "0.25 teaspoon ground cardamom",
    "3 tablespoons pure maple syrup",
    "4 cups water",
    "2 cups old-fashioned oats",
    "1 teaspoon salt",
    "2 tablespoons brown sugar",
    "2 tablespoons maple syrup",
    "2 tablespoons butter",
    "1 cup blueberries",
    "0.25 cup white sugar"
  ],
  "steps": [
    {
      "text": "Combine heavy cream and cinnamon stick in a small saucepan. Bring to a boil; reduce heat, cover, and simmer for 10 minutes. Remove pan from heat; discard cinnamon stick. Add 3 tablespoons maple syrup and cardamom.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water to a boil in a large saucepan; add oats and salt. Cook and stir for 5 minutes. Remove from heat, add cream mixture, 2 tablespoons maple syrup, and brown sugar; stir to combine. Cover and let stand for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set oven rack 4 to 6 inches from the heat source and preheat the oven's broiler. Grease seven 6-ounce ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide blueberries equally among the ramekins. Spoon oatmeal mixture on top. Sprinkle white sugar over oatmeal. Place filled ramekins on a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until sugar is melted, 7 to 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
