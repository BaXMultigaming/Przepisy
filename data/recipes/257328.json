  "title": "Lebanese Chicken Shawarma",
  "description": "This chicken breast marinated in a savory yogurt can be served in shawarma sandwiches for lunch or as an entree at a Lebanese dinner.",
  "authors": [
    "Christopher Walters"
  ],
