  "ingredients": [
    "1 tablespoon miso paste",
    "1 tablespoon sake",
    "1 teaspoon soy sauce",
    "1 teaspoon white sugar",
    "1 tablespoon oil",
    "0.5 pound sea scallops",
    "1 teaspoon water, if needed",
    "1 tablespoon butter"
  ],
  "steps": [
    {
      "text": "Combine miso paste, sake, soy sauce, and sugar in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat. Add scallops; cook 3 to 4 minutes. Flip scallops; cook until no longer translucent and cooked through, about 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low; let the skillet cool down for 1 minute. Add miso sauce; cook about 3 minutes, thinning with water if necessary. Add butter; stir until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
