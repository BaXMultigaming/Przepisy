  "ingredients": [
    "2 cups all-purpose flour",
    "2 tablespoons ground paprika",
    "2 tablespoons garlic powder",
    "1 tablespoon baking powder",
    "1 tablespoon salt",
    "2 large eggs",
    "1 cup buttermilk",
    "2 cups Italian-seasoned bread crumbs",
    "0.5 cup grated Parmesan cheese",
    "1 bunch fresh asparagus, trimmed",
    "1 cup peanut oil for frying, or as needed"
  ],
  "steps": [
    {
      "text": "Mix together flour, paprika, garlic powder, baking powder, and salt in one bowl, eggs and buttermilk in another, and bread crumbs and Parmesan cheese in a third.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat each asparagus stalk in the flour blend, dunk into the egg mixture, then roll in the bread crumbs. Transfer to the refrigerator and let them rest for 30 minutes; this will help the breading stick during frying.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry asparagus in the hot oil, working in batches as needed, until breading is golden brown, about 4 minutes. Transfer to a paper towel-lined plate to drain excess grease. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
