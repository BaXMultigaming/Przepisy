  "ingredients": [
    "4 small zucchini, thinly sliced",
    "0.5 small sweet onion (such as Vidalia®), thinly sliced",
    "0.5 bunch fresh parsley, minced",
    "1 lemon, zested and juiced",
    "1 teaspoon Dijon mustard",
    "2 teaspoons white sugar",
    "salt and ground black pepper to taste",
    "0.25 cup light olive oil"
  ],
  "steps": [
    {
      "text": "Place zucchini slices in a colander for 10 minutes, allowing juices to release; pat dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine zucchini, onion, and parsley together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix lemon zest, lemon juice, Dijon mustard, and sugar together in a separate bowl; season with salt and pepper. Slowly stream olive oil into lemon juice mixture while whisking constantly until dressing emulsifies. Pour dressing over zucchini mixture; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
