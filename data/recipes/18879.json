  "ingredients": [
    "1 (14 ounce) package boil in bag rice",
    "1.5 pounds lean ground beef",
    "2 (15 ounce) cans kidney beans, drained and rinsed",
    "1 (24 ounce) jar picante sauce",
    "1.5 tablespoons paprika",
    "1 tablespoon chili powder",
    "0.5 teaspoon crushed red pepper flakes",
    "12 ounces shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Cook the rice according to package directions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the ground beef in a large skillet over medium high heat. Saute for 5 to 10 minutes, or until browned and crumbly. Drain well and transfer meat to a large pot over low heat. Add the rice, beans, picante sauce, paprika, chili powder and crushed red pepper flakes. Stir well and let simmer for 20 minutes. Stir in cheese and let simmer for 10 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
