  "ingredients": [
    "0.5 cup peanut butter",
    "0.33333334326744 cup margarine, softened",
    "0.66666668653488 cup white sugar",
    "0.5 cup packed brown sugar",
    "2 large egg",
    "0.5 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C ). Grease a 9x9-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lpU_GBHteHoTayFj-Iyh9KqHFec=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11504-chewy-peanut-butter-brownies-DDMFS-step-01-c9577242f8f64378bafc75b41d866bc9.jpg"
      ],
      "image": "assets/images/11504/step_01.webp"
    },
    {
      "text": "Cream together peanut butter and margarine in a medium bowl. Gradually blend in white sugar, brown sugar, eggs, and vanilla; mix until fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/03VU8PTBtCecYrEIJHiSYb3FboA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11504-chewy-peanut-butter-brownies-DDMFS-step-02-13be2e72ff734ae28129ba8711c77af8.jpg"
      ],
      "image": "assets/images/11504/step_02.webp"
    },
    {
      "text": "Combine flour, baking powder, and salt in a separate bowl. Stir into the peanut butter mixture until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/25-v4jxtuWDKhlDFGzIQai010Yk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-11504-chewy-peanut-butter-brownies-DDMFS-step-04-c123d51539684d2ca54e9cf78e3a7900.jpg"
      ],
      "image": "assets/images/11504/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until the top springs back when touched, 30 to 35 minutes. Cool and cut into 16 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2WS41nejzDTD8Gxx_Vrmu5oa7uQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/1x1-GOLDMAN_ALR0123_Faves_PB_Bars_6547-b96589dc953a4f86b565ef4bc29c2d5b.jpg"
