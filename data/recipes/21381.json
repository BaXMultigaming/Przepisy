  "ingredients": [
    "1 (16 ounce) can sliced beets, drained with liquid reserved",
    "1 tablespoon brown sugar",
    "2 teaspoons lemon juice",
    "1 teaspoon cornstarch",
    "0.5 teaspoon salt",
    "1 tart green apple, peeled and sliced"
  ],
  "steps": [
    {
      "text": "Combine ½ cup beet liquid, brown sugar, lemon juice, cornstarch, and salt in a large skillet over medium heat; cook and stir until thickened and clear.",
