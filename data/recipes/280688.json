  "ingredients": [
    "1.75 cups skim milk",
    "0.5 cup water",
    "3 cups frozen 1/2-inch seedless watermelon cubes",
    "0.5 cup fresh raspberries",
    "0.5 cup low-fat Greek-style yogurt (such as Fage®)",
    "1 teaspoon freshly squeezed lime juice",
    "4 sprigs fresh mint",
    "4 small slices (0.5 oz) watermelon"
  ],
  "steps": [
    {
      "text": "Combine milk, water, frozen watermelon cubes, raspberries, yogurt, and lime juice in a blender, in that order; blend until smooth. Add a bit more water if your blender is struggling to blend the frozen fruit; pulse a few times then blend until it reaches desired consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into 4 glasses; garnish with mint sprigs and watermelon wedges. Serve immediately.",
      "section": null,
