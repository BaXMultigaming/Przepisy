  "ingredients": [
    "cooking spray",
    "0.25 cup miso",
    "2 tablespoons rice wine",
    "2 tablespoons mirin (Japanese sweet rice wine)",
    "1.5 pounds halibut fillets, bones removed",
    "1 tablespoon sesame seeds"
  ],
  "steps": [
    {
      "text": "Set oven rack about 4 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil and brush with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk miso, rice wine, and mirin together in a small bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place halibut on the baking sheet and cover with 1/2 the miso mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until golden, 4 to 5 minutes. Turn and brush with remaining miso mixture. Sprinkle sesame seeds on top. Continue broiling until second side is golden, 3 to 4 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
