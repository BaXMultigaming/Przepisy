  "title": "Roasted Spicy Salsa Verde",
  "description": "A bold green tomatillo and chile salsa has the authentic taste of grilled, charred peppers and fruity, tangy tomatillos.",
  "authors": [
    "SpeedySanchez"
  ],
  "date_published": "2009-06-27T23:59:44-04:00",
