  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place apples in a 9x13-inch glass baking dish. Mix in apple cider and lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together sugar, brown sugar, graham cracker crumbs, and 1/2 cup flour in a bowl. Sprinkle sugar mixture over sliced apples and top with evenly spaced caramel squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together brown sugar, oats, 1/2 cup flour, cinnamon, nutmeg, and pumpkin pie spice for the topping in a large bowl. Cut in butter cubes with 2 knives or pastry blender until the mixture resembles coarse crumbs. Sprinkle topping over apples in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until filling is bubbly and topping is golden brown, about 50 minutes. Let cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
