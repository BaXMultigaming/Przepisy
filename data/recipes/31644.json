  "ingredients": [
    "1 cup milk",
    "2 tablespoons all-purpose flour",
    "2 tablespoons butter",
    "0.25 teaspoon salt",
    "1 dash ground black pepper",
    "1 medium head cabbage, shredded",
    "1 cup grated Romano cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend milk, flour, butter, salt, and pepper in a medium saucepan over medium heat. Stir constantly until a thick white sauce has formed. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water to a boil in a separate medium saucepan. Place cabbage in a steamer set over the saucepan and steam until tender but firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Alternate layers of white sauce, steamed cabbage, and grated Romano cheese in a small baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until sauce and cheese are bubbly, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
