  "ingredients": [
    "1 (9 inch) prepared graham cracker crust",
    "2 (8 ounce) packages cream cheese, softened",
    "0.5 cup white sugar",
    "2 eggs, beaten",
    "1 teaspoon vanilla extract",
    "4 (2.16 ounce) bars chocolate-coated caramel-peanut nougat candy, chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium mixing bowl, beat softened cream cheese until fluffy. Mix in sugar until well combined. Add eggs and vanilla. Beat until smooth. Fold in all but 1/2 cup of chopped candy bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle reserved 1/2 cup of chopped candy bars onto bottom of graham cracker crust. Pour cream cheese mixture into crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 to 25 minutes; do not brown on top. Will be soft in middle. Chill before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
