  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups white sugar",
    "0.75 cup unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "1 teaspoon baking powder",
    "1 pinch salt",
    "1 cup milk",
    "0.5 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "1 cup hot, brewed coffee",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "In a large bowl, sift together flour, sugar, cocoa, baking powder, soda, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add oil, milk, vanilla, coffee, and eggs; beat well. Batter will be thin. Pour into two 9 inch greased and floured round pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C) for 25 minutes, or when top springs back when done. Cool layers on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
