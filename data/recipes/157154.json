  "ingredients": [
    "3 pounds flank steak",
    "salt and ground black pepper to taste",
    "1 large carrot, chopped",
    "1 large onion, chopped",
    "0.25 teaspoon ground dried thyme",
    "1 bay leaf",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Season flank steak with salt and pepper and place into a slow cooker. Add carrot and onion; season with thyme and add bay leaf. Pour in water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on High for 4 hours; turn steak over and press down into the liquid. Continue cooking until a fork easily passes through the meat, about 4 hours more.",
