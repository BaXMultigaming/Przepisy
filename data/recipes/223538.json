  "ingredients": [
    "1 pound ground beef",
    "0.33333334326744 cup water",
    "0.5 (10 ounce) can tomato sauce",
    "0.5 cup ketchup",
    "2.5 teaspoons chili powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon white sugar",
    "0.5 teaspoon onion powder",
    "1 dash Worcestershire sauce"
  ],
