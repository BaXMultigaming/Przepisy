  "title": "Black Garlic Chocolate Muffins",
  "description": "These chocolate muffins, enhanced with the sweetness of black garlic, are great for breakfast or a quick on-the-go snack.",
  "authors": [
    "Yoly"
  ],
  "date_published": "2020-06-19T00:44:34-04:00",
