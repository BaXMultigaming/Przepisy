  "ingredients": [
    "1.5 cups white sugar",
    "1 cup all-purpose flour",
    "0.33333334326744 cup cocoa powder",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "7 solo black garlic bulbs, mashed",
    "0.5 cup oil",
    "0.5 cup milk",
    "0.5 cup sour cream",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.5 cup semisweet chocolate chips, melted",
    "0.5 cup semisweet chocolate chunks",
    "0.5 cup chopped nuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, flour, cocoa powder, baking powder, baking soda, cinnamon, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together mashed black garlic, oil, milk, sour cream, egg, and vanilla extract in a second bowl. Add to flour mixture and mix well. Add melted chocolate, stirring until well combined. Fold in chocolate chunks and chopped nuts. Spoon batter into the prepared muffin cups, filling each almost to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in center comes out clean, 22 to 26 minutes. Cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
