  "ingredients": [
    "1 (15 ounce) can black beans, rinsed and drained",
    "1 (11 ounce) can shoepeg corn, drained",
    "1 (8 ounce) package crumbled feta cheese",
    "4 green onions, chopped",
    "0.25 cup olive oil",
    "0.25 cup cider vinegar",
    "2 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Combine black beans, corn, feta cheese, and green onions in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, vinegar, and sugar together in a small bowl until smooth; drizzle over corn mixture and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl with plastic wrap; refrigerate until flavors blend, at least 30 minutes.",
