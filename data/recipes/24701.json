  "ingredients": [
    "4 eggs",
    "2.5 cups white sugar",
    "2 cups heavy cream",
    "2 cups evaporated milk",
    "5 cups whole milk",
    "2.25 teaspoons vanilla extract",
    "2.25 teaspoons lemon extract",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Beat eggs and sugar in a large mixing bowl until stiff. Stir in cream, evaporated milk, whole milk, vanilla, lemon extract, and salt until well combined. Pour into the freezer canister of an ice cream maker and freeze according to the manufacturer's instructions.",
