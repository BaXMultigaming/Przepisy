  "ingredients": [
    "2 tablespoons canola oil",
    "0.5 cup white popcorn kernels",
    "0.5 teaspoon popcorn salt, divided",
    "0.125 teaspoon garlic powder",
    "0.125 teaspoon onion powder",
    "0.125 teaspoon ground cayenne pepper",
    "0.125 teaspoon ground chipotle chile pepper",
    "0.125 teaspoon ground ancho chile pepper"
  ],
  "steps": [
    {
      "text": "Heat canola oil in a large pot over medium-high heat; add 1 popcorn kernel to hot oil. The oil is ready when kernel pops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour popcorn kernels into hot oil; season with 1/2 of the popcorn salt. Stir to coat. Cover the pot with a sheet of aluminum foil. Poke about 10 holes into the aluminum foil using a knife. Cook popcorn until all kernels are popped, 5 to 10 minutes. Remove the pot from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle popcorn with remaining popcorn salt, garlic powder, onion powder, cayenne pepper, chipotle chile pepper, and ancho chile pepper. Toss to evenly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
