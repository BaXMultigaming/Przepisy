  "ingredients": [
    "cooking spray",
    "1 (16 ounce) carton liquid egg whites",
    "0.5 cup low-fat cottage cheese",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 cup packed fresh spinach, finely chopped",
    "0.33333334326744 cup roasted red peppers, drained and chopped",
    "1 tablespoon fresh basil, minced",
    "0.25 cup crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 12-cup muffin pan generously with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine egg whites, cottage cheese, garlic powder, salt, and pepper in a blender; blend until smooth, about 15 seconds.",
