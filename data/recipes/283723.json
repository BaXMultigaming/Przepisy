  "ingredients": [
    "0.25 cup butter",
    "3 tablespoons olive oil",
    "2 medium sweet onions (such as Vidalia®), thinly sliced",
    "2 tablespoons minced garlic",
    "2 pounds lean ground beef",
    "3 tablespoons chili powder",
    "1 (12 ounce) bottle zesty Italian-style salad dressing",
    "1 cup chunky salsa",
    "2 (20.5 ounce) cans refried black beans",
    "1 pound grated Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter and oil in a very large skillet over medium heat. Add onions and garlic and saute until translucent, about 5 minutes. Add ground beef and chili powder; cook and stir until browned and crumbly, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add salad dressing and salsa and bring to a boil. Add beans and stir until smooth. Pour into a baking dish or foil pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring every 15 minutes, until hot, about 1 hour. Sprinkle cheese on top if desired and cook until melted, about 15 more minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
