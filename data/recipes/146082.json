  "ingredients": [
    "6 bananas, sliced lengthwise",
    "0.5 cup light brown sugar",
    "0.5 cup unsalted butter, cut into small pieces",
    "0.5 cup chopped pecans",
    "0.5 cup raisins",
    "1 tablespoon brandy"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly butter a 9x13 inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bottom of the prepared casserole dish with half of the banana slices. Sprinkle the bananas with half the brown sugar, butter pieces, pecans, and raisins. Form another layer with the remaining banana slices and repeat layering with remaining brown sugar, butter, pecans, and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes; remove from oven and cool for 5 minutes. Sprinkle brandy over top of dish to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
