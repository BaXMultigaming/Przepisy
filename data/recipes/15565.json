  "ingredients": [
    "1.5 cups white sugar",
    "1.5 cups shortening",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "3.5 cups cake flour",
    "1.25 teaspoons baking soda",
    "0.75 teaspoon salt",
    "0.5 cup ground walnuts",
    "1 cup prepared chocolate fudge frosting"
  ],
  "steps": [
    {
      "text": "Cream together sugar and shortening in a medium bowl. Stir in egg and vanilla, beat until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake flour, baking soda, and salt; stir into the creamed mixture. Dough will be stiff, you may need to use your hands to mix. Roll dough into a log about 15 inches long, and roll in the ground nuts. Wrap and chill dough for at least an hour or until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Unwrap dough and cut into 1/2-inch slices. Place cookies 1 1/2 inches apart on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 to 15 minutes. Allow cookies to cool for a few minutes on the baking sheets before removing to cool completely on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When cool, place a dollop of fudge icing onto the center of each cookie.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
