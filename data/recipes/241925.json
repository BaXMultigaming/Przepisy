  "ingredients": [
    "6 eggs, whisked",
    "1 cup shredded Cheddar cheese",
    "6 slices bacon, diced",
    "2 slices bread, cubed",
    "0.33 red bell pepper, diced",
    "2 green onions, chopped",
    "3 tablespoons milk",
    "0.5 teaspoon minced garlic, or to taste",
    "salt and ground black pepper to taste"
