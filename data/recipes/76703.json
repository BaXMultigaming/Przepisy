  "ingredients": [
    "1 cup sugar",
    "0.5 cup light corn syrup",
    "1 cup dry-roasted peanuts",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon cayenne pepper",
    "1 teaspoon butter or margarine",
    "1 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "In a glass bowl, stir together the sugar, corn syrup, peanuts, cinnamon, and cayenne pepper until thoroughly blended. Microwave on high for 6 minutes. Slowly stir in the butter, and microwave an additional 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Very carefully remove bowl from the microwave as the contents will be extremely hot. Gently stir in baking soda until mixture becomes light and foamy. Turn batter out onto a lightly oiled cookie sheet, scraping sides of bowl with a rubber spatula. Allow brittle to cool for 1 hour, then break into pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
