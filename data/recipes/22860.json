  "ingredients": [
    "3 cups white sugar",
    "0.66666668653488 cup heavy cream",
    "0.75 cup butter",
    "1 (7 ounce) jar marshmallow creme",
    "1 (11 ounce) package white chocolate chips",
    "3 teaspoons orange extract",
    "12 drops yellow food coloring",
    "9 drops red food coloring"
  ],
  "steps": [
    {
      "text": "Grease a 9 x 13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium saucepan over medium heat, combine sugar, cream and butter. Heat to soft ball stage, 234 degrees F (112 degrees C). Remove from heat and stir in marshmallow creme and white chocolate chips; mix well until the chips melt. Reserve 1 cup of mixture and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To the remaining mixture add orange flavoring, yellow and red food coloring. Stir well and pour into prepared pan. Pour reserved cream mixture on top. Using a knife, swirl layers for decorative effect.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill for 2 hours, or until firm, and cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
