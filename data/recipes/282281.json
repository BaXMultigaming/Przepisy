  "ingredients": [
    "1 (12 ounce) package Impossible Burger",
    "0.25 cup dry bread crumbs",
    "0.5 small onion, diced",
    "1 large egg",
    "2 cloves garlic, minced",
    "4 large basil leaves, roughly chopped",
    "1 teaspoon curry powder",
    "1 teaspoon ground ginger",
    "0.5 teaspoon smoked paprika",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground white pepper",
    "1 tablespoon vegetable oil",
    "0.5 cup diced green bell pepper",
    "0.5 cup diced carrots",
    "0.5 cup diced celery",
    "1 cup crushed tomatoes",
    "1 large bay leaf",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix meatless ground beef, bread crumbs, onion, egg, garlic, basil, curry powder, ginger, paprika, salt, and white pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form mixture into 16 balls and lay out in a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the meatballs are baking, heat oil in a pan over medium-high heat. Saute bell pepper, carrots, and celery in the hot oil, stirring constantly, until translucent, about 7 minutes. Add crushed tomatoes, bay leaf, and salt; cook over low heat for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the cooked meatballs, including any pan juices, to the sauce and stir, making sure to coat evenly. Cook over low heat for 5 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
