  "title": "Gluten-Free Gingersnaps",
  "description": "Use oat flour to create gluten-free gingersnaps that are as crispy and easy to make as the original.",
  "authors": [
    "Cameron Houser"
  ],
  "date_published": "2020-06-19T00:33:26-04:00",
