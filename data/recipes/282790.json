  "ingredients": [
    "0.75 cup milk",
    "0.25 cup heavy whipping cream",
    "2 tablespoons stevia powder, or to taste",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon peppermint extract, or more to taste"
  ],
  "steps": [
    {
