  "ingredients": [
    "3 tablespoons butter",
    "0.25 cup chopped fresh mushrooms",
    "2 tablespoons chopped onion",
    "2 tablespoons chopped celery",
    "2 tablespoons chopped carrot",
    "1 (14.5 ounce) can chicken broth",
    "0.125 teaspoon salt",
    "0.125 teaspoon cayenne pepper",
    "1.5 cups half-and-half",
    "0.5 cup dry white wine",
    "0.5 pound cooked lump lobster meat"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan over medium-low heat. Add mushrooms, onion, celery, and carrot. Cook and stir until tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e92u67EfifsvTLmqeSSjOPZ2oZ8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76637-perfect-lobster-bisque-ddmfs-Step1-5707-4x3-e8c43e8e0bfa45b5b522a9a1ee4fdefe.jpg"
      ],
      "image": "assets/images/76637/step_01.webp"
    },
    {
      "text": "Stir in chicken broth, and season with salt and cayenne pepper. Bring to a boil, then simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6uIthOxXggWAteZbPu2htmf7mVg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76637-perfect-lobster-bisque-ddmfs-Step2-5715-4x3-43acdc2fbf6446aeb4bfa4c0fa8210e0.jpg"
      ],
      "image": "assets/images/76637/step_02.webp"
    },
    {
      "text": "Pour vegetable and broth mixture into the container of a blender, and add 1/4 cup of the lobster meat. Cover, and process until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/T4RWLq8OrO5HPTYtpkMyz7w_GaI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76637-perfect-lobster-bisque-ddmfs-Step3-5720-4x3-7e6f3a1c14e849ff9b9e5b85efae786d.jpg"
      ],
      "image": "assets/images/76637/step_03.webp"
    },
    {
      "text": "Return to the saucepan, and stir in half-and-half, white wine, and remaining lobster meat. Cook over low heat, stirring frequently until thickened, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YSPdF_mLJiOU_LinPPGm7jq-pFc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76637-perfect-lobster-bisque-ddmfs-Step4-5723-4x3-66bd3303a2f84e7d99606a7ab78dc86f.jpg"
      ],
      "image": "assets/images/76637/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RyyLV4jtk70xjt6l8HtRMn8CeuU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/76637-perfect-lobster-bisque-ddmfs-4X3-5729-931d38c33a7f41359a003ff417b0904a.jpg"
