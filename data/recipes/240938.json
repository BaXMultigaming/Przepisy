  "ingredients": [
    "2 (28 ounce) cans crushed tomatoes",
    "1 (14.5 ounce) can chicken broth",
    "18 fresh basil leaves, or more to taste, finely chopped",
    "1 teaspoon white sugar",
    "1 cup heavy whipping cream",
    "0.5 cup butter"
  ],
  "steps": [
    {
      "text": "Stir together tomatoes and chicken broth in a large saucepan; bring to a boil, reduce heat to medium-low, and cook at a simmer until slightly reduced, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in basil and sugar; reduce heat to low and continue cooking until basil is wilted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream into tomato mixture; add butter and continue cooking, stirring occasionally, until butter is completely melted, 5 to 7 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
