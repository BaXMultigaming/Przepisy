  "ingredients": [
    "1 pound ground turkey",
    "1 tablespoon apple cider vinegar",
    "2 teaspoons chili powder",
    "2 teaspoons smoked paprika",
    "2 teaspoons garlic powder",
    "1 teaspoon kosher salt",
    "1 teaspoon ground cumin",
    "1 teaspoon ground coriander",
    "1 teaspoon dried oregano",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon red pepper flakes",
    "1 tablespoon olive oil, or more to taste"
  ],
  "steps": [
    {
      "text": "Place turkey, vinegar, chili powder, paprika, garlic powder, salt, cumin, coriander, oregano, pepper, and red pepper flakes in a medium bowl. Mix well using your hands. Refrigerate for best flavor, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium heat. Cook chorizo, breaking up with a wooden spoon, until browned, 8 to 10 minutes.",
