  "ingredients": [
    "2 eggs",
    "1.5 teaspoons prepared horseradish",
    "1 teaspoon salt-free herb seasoning blend",
    "0.5 cup shredded Cheddar cheese",
    "0.25 cup freshly grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "In a medium bowl, whisk together the eggs and herb seasoning blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a lightly greased skillet over medium-high heat. When hot, pour the egg mixture in, and turn the skillet to coat evenly. Cook until almost done, then flip over. Spread the top with horseradish and sprinkle with Cheddar and Parmesan cheeses. Continue to cook until the bottom is no longer raw. Fold in half and transfer to a plate for serving.",
