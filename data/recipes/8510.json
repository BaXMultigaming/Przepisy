  "ingredients": [
    "4 cups diced, cooked chicken meat",
    "2 cups chopped celery",
    "1 cup almonds",
    "1 cup mayonnaise",
    "1 cup sour cream",
    "1 cup shredded American cheese",
    "4 tablespoons lemon juice",
    "2 tablespoons chopped onion",
    "2 cups crushed cornflakes cereal"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a 9x13-inch baking dish.",
