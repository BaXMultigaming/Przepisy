  "ingredients": [
    "0.75 cup white sugar",
    "2 tablespoons all-purpose flour",
    "2 tablespoons grated orange zest",
    "0.5 cup orange juice",
    "2 tablespoons fresh lemon juice",
    "1 egg",
    "1 cup whipped cream"
  ],
  "steps": [
    {
      "text": "In a saucepan over medium heat mix the white sugar, flour, orange juice, orange zest, lemon juice and the egg. Cook until thickened. Remove from heat and let cool completely before folding in the whipped cream. Makes enough to fill one 2 layer 9 inch round layer cake.",
