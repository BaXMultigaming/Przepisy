  "ingredients": [
    "5 cups cubed bread",
    "0.25 cup raisins",
    "2.25 cups eggnog",
    "4 large eggs",
    "0.33333334326744 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 cup packed brown sugar",
    "0.5 cup unsalted butter",
    "0.5 cup heavy cream",
    "3 tablespoons coconut-flavored rum"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread and raisins together in a bowl; transfer mixture to the loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggnog, eggs, white sugar, and vanilla extract together in a separate bowl. Pour over the bread mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt brown sugar and butter in a saucepan over medium heat. Add cream and rum; simmer until sauce thickens and is reduced to 1 1/2 cups, about 5 minutes. Serve warm over the bread pudding.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
