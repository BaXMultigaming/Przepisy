      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in potatoes, sliced onion, and sliced mushrooms. Add pork chops; turn to coat both sides in soup mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker. Cook on Low for 6 hours.",
