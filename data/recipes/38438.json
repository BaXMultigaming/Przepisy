  "ingredients": [
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "6 tablespoons white sugar",
    "1 egg",
    "2 tablespoons butter or margarine",
    "0.66666668653488 cup water",
    "0.25 cup dry milk powder",
    "1 teaspoon vanilla extract",
    "2 cups pitted and diced fresh apricots",
    "0.25 teaspoon ground cinnamon, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease an 8-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, and salt in a large bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat 6 tablespoons sugar, egg, and butter together in a separate bowl until smooth; stir in water, milk powder, and vanilla extract until well blended. Beat egg mixture into flour mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter into the prepared pan; sprinkle with apricots. Stir remaining 1 tablespoon sugar and cinnamon together in a small bowl until evenly combined; sprinkle over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
