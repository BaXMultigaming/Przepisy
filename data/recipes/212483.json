  "ingredients": [
    "1 (15.25 ounce) can whole kernel corn, drained",
    "1 (14.5 ounce) can French cut green beans, drained",
    "1 (10.5 ounce) can condensed cream of celery soup",
    "0.75 cup shredded Cheddar cheese",
    "0.5 cup sour cream",
    "0.5 cup chopped onion",
    "1 pinch salt",
    "2 sleeves buttery round crackers, crushed",
    "0.5 cup melted butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together corn and green beans in the prepared dish. Stir together condensed soup, Cheddar cheese, sour cream, onion, and salt in a large bowl until well combined. Spread over corn mixture in the dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place crushed crackers in a medium bowl and stir in melted butter until combined. Spread cracker mixture over the top of casserole.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until casserole is bubbly and topping is golden brown, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
