  "ingredients": [
    "3 cups peeled and chopped sweet potatoes",
    "0.25 cup butter, softened",
    "0.75 cup brown sugar",
    "2 tablespoons milk",
    "0.25 teaspoon salt",
    "0.5 teaspoon grated lemon zest",
    "8 large marshmallows",
    "0.5 cup crushed corn flake cereal"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a pot of water to a boil. Add sweet potatoes and cook until tender, about 15 minutes. Drain and mash with butter, sugar, milk, salt and lemon zest. Shape mixture into balls, with a marshmallow in the center of each. Roll in cereal crumbs and place in prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 minutes, or until marshmallows begin to ooze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
