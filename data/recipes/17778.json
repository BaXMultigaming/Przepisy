  "ingredients": [
    "1 cup chopped pitted dates",
    "1 cup chopped dried figs",
    "0.25 cup cold unsalted butter, cut into chunks",
    "1.5 teaspoons baking soda",
    "1 cup boiling water",
    "0.5 cup white sugar",
    "0.5 cup chopped walnuts",
    "2 large eggs",
    "0.75 cup all-purpose flour",
    "0.75 cup whole wheat flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8x4-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine dates, figs, butter, and baking soda in a medium bowl. Pour in boiling water, stir well, and let stand for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, walnuts, and eggs into date mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk both flours, baking powder, and salt together in a bowl. Stir flour mixture into date mixture just until blended. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the loaf comes out clean, 55 to 65 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and cool in the pan for 10 minutes, then turn out onto a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
