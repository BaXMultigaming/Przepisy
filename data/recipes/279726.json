  "ingredients": [
    "2 tablespoons vegetable oil",
    "2.5 pounds chicken, cut into bite-sized pieces",
    "0.25 cup chopped white onion",
    "2 cloves garlic, minced",
    "1 (13.5 ounce) can unsweetened coconut milk",
    "0.66666668653488 cup white sugar",
    "0.5 cup diced jarred jalapeno peppers (such as Mt. Olive®)",
    "0.25 cup rice vinegar",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground turmeric",
    "0.25 cup chopped Thai basil"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a skillet over medium-high heat. Saute chicken, onion, and garlic in the hot oil until chicken is no longer pink, about 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine coconut milk, sugar, diced jalapenos, rice vinegar, salt, and turmeric in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium and pour coconut mixture into the pan with the chicken. Bring to a simmer, reduce heat to low, and cook until chicken is cooked through and sauce has thickened, about 6 minutes. Remove from heat and stir in basil.",
