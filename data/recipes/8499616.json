  "ingredients": [
    "1.5 cups cottage cheese",
    "1.5 cups evaporated milk",
    "3.5 ounces freshly grated Parmesan cheese",
    "0.25 teaspoon granulated garlic",
    "1 pinch ground white pepper",
    "1 tablespoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Add cottage cheese and evaporated milk to the jar of a Vitamix blender (or other high-powered blender); blend on high until smooth, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cottage cheese mixture into a sauce pan over medium high heat. Stir in Parmesan cheese. garlic, and white pepper. Cook, stirring often, until sauce has thickened, 15 to 20 minutes; stir in parsley.",
      "section": null,
      "name": null,
      "url": null,
