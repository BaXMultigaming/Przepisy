  "ingredients": [
    "7 tablespoons butter, softened",
    "2 ounces cream cheese, softened",
    "2 tablespoons milk",
    "0.5 teaspoon vanilla extract",
    "1.5 cups confectioners' sugar, sifted",
    "0.25 teaspoon salt"
  ],
