  "ingredients": [
    "cooking spray",
    "1 (13.5 ounce) can spinach, drained and squeezed",
    "1 cup cottage cheese",
    "2 eggs, beaten",
    "0.25 cup crumbled feta cheese",
    "2 tablespoons all-purpose flour",
    "2 tablespoons butter, melted",
    "1 clove garlic, minced, or more to taste",
    "1.5 teaspoons onion powder",
    "0.125 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 375 degrees F (190 degrees C). Grease an 8-inch pie pan with cooking spray and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine spinach, cottage cheese, eggs, feta cheese, flour, butter, garlic, onion powder, and nutmeg in a bowl. Stir until all ingredients are well incorporated. Pour into the prepared pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry until the center is set, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
