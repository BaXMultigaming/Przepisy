  "ingredients": [
    "1.5 cups all-purpose flour",
    "2 cups white sugar",
    "2 teaspoons baking powder",
    "4 eggs",
    "1 cup vegetable oil",
    "0.75 cup orange juice",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the flour, sugar and baking powder. Make a well in the center and pour in the eggs, oil, orange juice and vanilla. Mix well and pour into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
