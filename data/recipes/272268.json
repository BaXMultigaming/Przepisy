  "ingredients": [
    "1 medium eggplant",
    "0.5 cup Italian bread crumbs",
    "0.25 cup freshly grated Parmesan cheese",
    "1 teaspoon Italian seasoning",
    "1 teaspoon salt",
    "0.5 teaspoon dried basil",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon ground black pepper",
    "0.25 cup all-purpose flour",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "Cut eggplant into 1/2-inch rounds, then cut each round into 1/4-inch sticks. Pat dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs, Parmesan, Italian seasoning, salt, basil, garlic powder, onion powder, and pepper in a shallow bowl. Pour flour into a second shallow bowl. Whisk eggs in a third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip eggplant sticks in flour, then in beaten eggs, and then coat with bread crumb mixture. Transfer to a plate and let rest for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 370 degrees F (185 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place breaded eggplant sticks in the air fryer basket, making sure they are not touching; cook in batches if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 8 to 10 minutes. Shake the basket and continue cooking to desired crispiness, 4 to 6 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
