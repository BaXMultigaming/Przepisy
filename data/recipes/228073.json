  "ingredients": [
    "8 ounces cream cheese",
    "1 cup seeded, chopped cucumber",
    "0.5 cup shredded Cheddar cheese",
    "0.5 teaspoon dried dill weed",
    "0.5 teaspoon lemon juice",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine cream cheese, cucumber, Cheddar cheese, dill, lemon juice, garlic powder, and salt in a bowl. Cover the bowl; refrigerate to blend flavors before serving, 2 hours.",
