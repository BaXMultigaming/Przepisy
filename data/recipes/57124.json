  "ingredients": [
    "4 eggs",
    "1 cup shredded Cheddar cheese",
    "0.5 cup cottage cheese",
    "1 cup finely chopped pecans",
    "0.5 cup finely chopped onion",
    "1.5 teaspoons salt",
    "1 teaspoon dried basil",
    "0.25 teaspoon dried sage",
    "2 cups Italian seasoned bread crumbs",
    "1 cup ketchup",
    "0.75 cup apricot jam",
    "0.25 cup vegetable oil",
    "0.25 cup white vinegar",
    "0.25 cup minced onion",
    "1 teaspoon dried oregano",
    "1 dash hot pepper sauce"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, Cheddar cheese, and cottage cheese in a bowl until well blended. Add pecans, ½ cup onion, salt, basil, and sage; stir in bread crumbs. Roll mixture into 2-inch balls; place in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk ketchup, apricot jam, vegetable oil, vinegar, ¼ cup onion, oregano, and hot pepper sauce together in a bowl; pour over meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until meatballs are firm and sauce is thick and bubbly, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
