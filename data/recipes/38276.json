  "ingredients": [
    "2 pounds cod fillets",
    "3 tablespoons margarine",
    "6 tablespoons all-purpose flour",
    "2 cups milk",
    "salt and ground black pepper to taste",
    "1.5 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease an 8x 12 inch baking dish. Bring a large pot of lightly salted water to a boil. Add cod fillets and cook for 4 to 6 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt margarine in a medium saucepan. Remove from heat and mix in the flour and milk. Return to stove over medium heat, and stir until thickened. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flake fish into baking dish, alternating layers with sauce. Sprinkle top with shredded cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 20 to 25 minutes, or until cheese is browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
