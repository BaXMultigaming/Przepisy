  "ingredients": [
    "5 dried Anaheim chile peppers, stemmed and seeded",
    "5 guajillo chile peppers, stemmed and seeded",
    "water to cover",
    "0.25 onion",
    "1 tablespoon mixed spices, or more to taste",
    "1 tablespoon salt, or to taste",
    "3 pounds cubed beef stew meat",
    "6 bay leaves"
  ],
  "steps": [
    {
      "text": "Place Anaheim and guajillo peppers in a saucepan; cover with water and bring to a boil. Reduce heat to medium-low and simmer until tender, about 15 minutes. Set aside to cool for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hc7TYBqZw8_bkCfBoOQNCByiUd0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235755-birria-recipe-step2-238-c51d043beedc443eb7be84cae661327f.jpg"
      ],
      "image": "assets/images/235755/step_01.webp"
    },
    {
      "text": "Transfer chiles and water into a blender; add onion, mixed spices, and salt. Blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s7bOTzJ9RmG08bp3kmLkB9_fTLo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235755-birria-recipe-step3-242-4d59b3a3a3254e1e97cd9d1314b79f46.jpg"
      ],
      "image": "assets/images/235755/step_02.webp"
    },
    {
      "text": "Place stew meat in a large pot; stir in pureed chile mixture and add bay leaves. Cook over medium-low heat until meat is very tender, 3 to 5 hours.",
