  "ingredients": [
    "1.5 pounds lean ground beef",
    "1 onion, chopped",
    "0.75 teaspoon salt",
    "1 pinch ground black pepper",
    "1 (32 ounce) package tater tots, thawed",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 (10.75 ounce) can condensed cream of celery soup",
    "1 (6 ounce) can French-fried onion rings"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet cook ground beef with onion, salt and pepper; drain and spread into the bottom of a 9x13 inch baking dish. Add tater tots; mix cream of mushroom and cream of celery soup together and pour mixture over dish. Top with onion rings, if using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 1 hour.",
      "section": null,
