  "ingredients": [
    "4 bratwurst",
    "3 (12 ounce) cans light beer",
    "5 tablespoons brown sugar",
    "1 teaspoon cayenne pepper",
    "6 slices bacon, cut in half"
  ],
  "steps": [
    {
      "text": "Poke bratwurst several times with a small fork and place into a saucepan. Pour in beer and bring to a boil. Reduce heat to medium and simmer for 15 minutes. Remove bratwurst from beer and allow to cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line a baking sheet with aluminum foil and place a wire rack on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss brown sugar and cayenne pepper together in a large bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each boiled bratwurst into thirds. Wrap each piece with 1/2 strip bacon; secure with a toothpick. Toss bacon wrapped bratwurst with cayenne mixture to coat, then place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bacon is brown and crisp, 25 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
