  "title": "Polish Style Chocolate Cake",
  "description": "A simple chocolate cake served with bananas and whipped topping. a different kind of chocolate cake. but a very good one.",
  "authors": [
    "Anna Lombard"
  ],
  "date_published": "2000-02-05T12:49:56-05:00",
