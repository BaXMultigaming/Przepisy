  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup sour cream",
    "0.25 cup mayonnaise",
    "0.25 cup grated white onion",
    "1 (10 ounce) can diced tomatoes with green chile peppers (such as RO*TEL®)",
    "0.5 teaspoon garlic powder",
    "salt and ground black pepper to taste",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Stir together cream cheese, sour cream, and mayonnaise until smooth. Add onion, canned tomatoes with green chilies, garlic powder, salt, and pepper. Stir in Cheddar cheese. Refrigerate until set, at least 2 hours.",
