  "ingredients": [
    "0.25 cup chopped onion",
    "2 cloves garlic, minced",
    "2 tablespoons vegetable oil",
    "3 cups uncooked instant rice (such as Minute®)",
    "2.25 cups chicken broth",
    "1 cup vegetable juice (such as V8®)",
    "1.5 teaspoons taco seasoning"
