  "ingredients": [
    "1 head cauliflower, broken into florets",
    "salt and ground black pepper to taste",
    "4 cloves garlic, chopped, or more to taste",
    "0.33333334326744 cup extra virgin olive oil",
    "0.33333334326744 cup skim milk",
    "0.33333334326744 cup shredded Cheddar cheese",
    "0.125 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss cauliflower, garlic, salt, and pepper together in a large bowl. Pour cauliflower onto a large sheet of aluminum foil and wrap tightly; place on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cauliflower is tender, 45 to 55 minutes. Transfer cauliflower mixture to a bowl and mash to desired consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix olive oil and milk into mashed cauliflower mixture. Drop cauliflower mixture by the spoonful into muffin cups and top with Cheddar cheese and red pepper flakes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted, 10 to 15 minutes. Cool for 2 minutes before removing from the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
