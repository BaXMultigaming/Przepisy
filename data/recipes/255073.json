  "ingredients": [
    "nonfat cooking spray",
    "2 tablespoons extra-virgin olive oil",
    "1.5 tablespoons seafood seasoning (such as Old Bay®)",
    "1 teaspoon onion powder",
    "0.5 teaspoon hot sauce",
    "0.5 teaspoon garlic powder",
    "2 large russet potatoes",
    "1 tablespoon malt vinegar, or to taste",
    "sea salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Line 2 baking sheets with aluminum foil; spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oil, seafood seasoning, onion powder, hot sauce, and garlic powder together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut potatoes into spirals using a spiralizer fitted with a large shredder blade; snip long spirals into smaller lengths.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes into a large bowl; drizzle with oil mixture. Toss until potatoes are evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread coated potatoes in a single layer onto the baking sheets, leaving 1/4-inch of space between potato spirals.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bottom of potatoes are browned, 8 to 9 minutes. Flip potatoes with a spatula. Bake until potatoes are browned and crisp on top, about 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle malt vinegar and sea salt over potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
