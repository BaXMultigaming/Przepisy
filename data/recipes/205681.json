  "ingredients": [
    "1 tablespoon olive oil",
    "2 tablespoons minced garlic",
    "4.5 teaspoons red pepper flakes",
    "3 cups soy sauce",
    "3 cups honey",
    "1 cup orange juice",
    "2 tablespoons minced fresh ginger root",
    "1 tablespoon sesame oil",
    "1 tablespoon sesame seeds",
    "0.5 lime, juiced"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large skillet over medium heat. Cook and stir garlic and red pepper flakes in hot oil until fragrant, 2 to 3 minutes. Add soy sauce, honey, orange juice, ginger, sesame oil, sesame seeds, and lime juice. Cook and stir until heated through, 2 to 3 minutes more.",
