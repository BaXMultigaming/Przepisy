  "ingredients": [
    "1 (12 ounce) package macaroni",
    "2 cups milk",
    "1 egg",
    "2.5 cups shredded Cheddar cheese",
    "2 tablespoons butter, melted",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Boil macaroni in a large pot of salted water until barely done, about 5 minutes. Drain and set aside to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uJ7FrELpbNc9mW8B2gl294Fwk04=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14140-baked-macaroni-and-cheese-ddmfs-step-1-0198-4x3-293860f422874d8da25ccd2e976da2ef.jpg"
      ],
      "image": "assets/images/14140/step_02.webp"
    },
    {
      "text": "Whisk milk and egg together in a large bowl; stir in cheese and butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YQme7wYoNI6QSQSn31bbHre5BqI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14140-baked-macaroni-and-cheese-ddmfs-step-3-0207-4x3-68faa77c471a4e6daa08a0fae6794675.jpg"
      ],
      "image": "assets/images/14140/step_03.webp"
    },
    {
      "text": "Place par-boiled macaroni in the prepared baking dish. Pour milk mixture over macaroni, season with salt and pepper, and stir until combined. Press mixture evenly into the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake, uncovered, in the preheated oven until top is golden brown, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FeFqgrEX_PPG5qAG99IqCn4inaA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14140-baked-macaroni-and-cheese-ddmfs-step-4-4x3-606dcb2c6f554aca9d971c6589eb2b86.jpg"
      ],
      "image": "assets/images/14140/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_TpDrBwFIQbT_A6Pn6XZYC_8ioc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14140-baked-macaroni-and-cheese-ddmfs-0346-beauty-4x3-9b975d9c35f04f459a661405c1c85b7d.jpg"
      ],
      "image": "assets/images/14140/step_06.webp"
    }
