  "ingredients": [
    "1.75 pounds Yukon Gold potatoes",
    "1 white onion, chopped",
    "2 bunches radishes, sliced",
    "4 tablespoons red wine vinegar",
    "1 teaspoon Dijon mustard",
    "salt and freshly ground black pepper",
    "0.5 cup extra-virgin olive oil",
    "2 tablespoons chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 20 to 25 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool potatoes until easily handled. Peel and slice into a large bowl. Cool completely, about 30 minutes. Add onion and radishes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk red wine vinegar, mustard, salt, and pepper in a bowl or cup. Drizzle in olive oil, while whisking, until well combined. Stir in chives. Drizzle over potato mixture and carefully mix in. Set aside for 15 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
