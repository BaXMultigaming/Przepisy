  "ingredients": [
    "0.5 cup shortening",
    "0.75 cup packed brown sugar",
    "1 teaspoon vanilla extract",
    "2 cups whole wheat flour",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.25 cup milk"
  ],
  "steps": [
    {
      "text": "Cream together shortening and brown sugar in a medium bowl. Stir in vanilla. Combine whole wheat flour, all-purpose flour, baking powder, baking soda, and salt in a separate bowl; stir into creamed mixture alternately with milk. Cover and chill dough until firm, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll chilled dough out to 1/8-inch thickness on a lightly floured surface. Cut into 48 rectangles. Place 1/2 inch apart on the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crisp and edges are golden brown, 10 to 12 minutes. Remove crackers from the baking sheet to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
