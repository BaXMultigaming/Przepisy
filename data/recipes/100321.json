  "title": "Chocolate Dipped Bing Cherries",
  "description": "This recipe features fresh sweet Bing cherries, infused with vanilla, and dipped in dark chocolate. Best if eaten fresh but can be frozen for weeks.",
  "authors": [
    "Barry"
  ],
  "date_published": "2020-06-18T23:13:22-04:00",
