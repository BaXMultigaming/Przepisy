  "ingredients": [
    "1 cup white sugar",
    "1.5 teaspoons vanilla extract",
    "24 Bing cherries with stems",
    "8 ounces semisweet chocolate, chopped"
  ],
  "steps": [
    {
      "text": "Pour sugar into a shallow dish; add 2 drops vanilla at a time in 24 separate places to form lumps of vanilla sugar. Set aside to allow lumps to harden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, carefully pit cherries from the bottom. Make sure stems stay intact.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Insert 1 hardened lump sugar into 1 cherry where pit was; repeat with remaining sugar lumps and cherries. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate in a microwave-safe dish; microwave until melted and smooth, stirring every 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip cherries into melted chocolate, holding cherries by the stems, leaving the very tops undipped; set dipped cherries on waxed paper to dry, then refrigerate to allow sugar lumps to dissolve, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
