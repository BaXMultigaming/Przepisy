  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "0.5 cup white sugar",
    "1 (12 ounce) container frozen whipped topping, thawed",
    "2 bananas, sliced",
    "1 (11 ounce) can mandarin oranges, drained",
    "1 (16 ounce) package frozen raspberries"
  ],
  "steps": [
    {
      "text": "In a medium bowl, mix together the cream cheese and sugar until smooth and fluffy. Stir in the whipped topping. Fold in the bananas, mandarin oranges and raspberries. Transfer to a 9x13 inch baking dish, cover, and freeze for at least 4 hours. Remove from the freezer 1/2 hour prior to serving.",
