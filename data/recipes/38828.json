  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Coat a medium baking dish with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs, Parmesan cheese, Romano cheese, salt, and garlic powder together in a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush orange roughy fillets on both sides with melted butter, then dredge in the bread crumb mixture. Arrange fillets in a single layer in the prepared baking dish and sprinkle with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 10 to 15 minutes.",
      "section": null,
