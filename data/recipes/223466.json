  "ingredients": [
    "3 mangos - peeled, seeded, and cut into chunks",
    "2 limes, juiced",
    "1 tablespoon chopped fresh basil",
    "0.5 teaspoon cayenne pepper",
    "0.25 teaspoon salt",
    "0.5 cup white sugar",
    "1 mango, peeled, seeded, and diced"
  ],
  "steps": [
    {
      "text": "Combine mango chunks, lime juice, basil, cayenne pepper, and salt in a blender; blend until smooth. Pour mango purée into a large bowl; stir in sugar until sugar dissolves. Fold in diced mango. Pour into freezer pop molds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Freeze until firm, 14 to 24 hours.",
