  "ingredients": [
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "2 pounds pork loin",
    "1 cup packed brown sugar",
    "0.5 cup bourbon",
    "0.33333334326744 cup apple cider vinegar",
    "8 slices cooked bacon, crumbled"
  ],
  "steps": [
    {
      "text": "Combine garlic powder, onion powder, salt, and pepper in a small bowl. Massage over all sides of pork loin for 1 minute. Place pork in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, bourbon, and apple cider vinegar together in a bowl and pour over pork loin. Close slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low until pork is tender, 8 to 10 hours. Remove pork from slow cooker and shred with two forks. Mix with bacon.",
      "section": null,
      "name": null,
      "url": null,
