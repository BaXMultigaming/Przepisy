  "ingredients": [
    "1 (16 ounce) package uncooked spaghetti",
    "0.5 cup butter",
    "0.5 cup all-purpose flour",
    "3 cups chicken broth",
    "2 cups milk",
    "1.6666667461395 cups grated Parmesan cheese",
    "4 cups chopped cooked turkey"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0tWwNfIX3bn0YGArepCge7m1x8U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-40545-turkey-tetrazzini-step-01-33937d21f0e34632b14a0e68e530e4f3.jpg"
      ],
      "image": "assets/images/40545/step_01.webp"
    },
    {
      "text": "Cook spaghetti according to package directions until al dente. Drain and transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dTB8LYnvf8aklHmHJr1dVzbdS4Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-40545-turkey-tetrazzini-step-02-37402733fa024a62aff56bdd294296eb.jpg"
      ],
      "image": "assets/images/40545/step_02.webp"
    },
    {
      "text": "Melt butter in a medium saucepan over medium heat. Whisk in flour until smooth and lightly golden, about 1 minute. Gradually whisk in chicken broth and milk. Stir until mixture comes to a gentle boil and thickens slightly, about 5 minutes. Stir in 1 1 ⁄3 cups cheese until melted; remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5wiZX3Kr29VoQv35fHCvpNuZjeA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-40545-turkey-tetrazzini-step-03-f7bdf1d5ccf84ae2a1046d997b457d9e.jpg"
      ],
      "image": "assets/images/40545/step_03.webp"
    },
    {
      "text": "Mix broth mixture and turkey with spaghetti. Top with remaining 1/3 cup cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I6G8JIBBcImCkYKjDWnQhZVWaAQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-40545-turkey-tetrazzini-step-04-A-2a3dfdbc0f74423e95127a8a2dc31f84.jpg"
      ],
      "image": "assets/images/40545/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until top is lightly browned, 45 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IXr-OWrQsNx3JlVACT19OCyNGq4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-40545-turkey-tetrazzini-step-04-B-c12f60efc37c4806ac5d8750633fbcda.jpg"
      ],
