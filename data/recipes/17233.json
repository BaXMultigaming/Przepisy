  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "0.5 teaspoon baking soda",
    "1 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.75 teaspoon ground cinnamon",
    "0.75 cup shortening",
    "1 egg, beaten",
    "1 banana",
    "1.75 cups rolled oats"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the flour, sugar, baking soda, salt, nutmeg and cinnamon. Cut in the shortening, until the mixture appears mealy. Stir in the egg, mashed banana and oatmeal until well blended. Drop by rounded spoonfuls onto an unprepared cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 8 to 10 minutes in the preheated oven. Remove from baking sheet to cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
