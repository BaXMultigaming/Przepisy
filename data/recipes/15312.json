  "title": "Chewy Gooey Cookies",
  "description": "These cookies have a slight nutty flavor without actually having nuts...great for kids who don't like them! Gooey and delicious!",
  "authors": [
    "Gretchen Mapel"
  ],
  "date_published": "1999-03-18T19:32:35-05:00",
