  "ingredients": [
    "0.5 cup walnut halves",
    "0.25 cup sugar",
    "3 cups mixed greens",
    "0.5 cup dried cranberries",
    "0.5 cup crumbled Gorgonzola cheese",
    "1 tablespoon raspberry vinaigrette",
    "1 tablespoon white vinegar",
    "1 tablespoon olive oil"
