  "ingredients": [
    "1.5 cups grated daikon radish",
    "2 teaspoons salt",
    "0.5 red onion, chopped",
    "0.5 cup Italian seasoned bread crumbs",
    "1 egg, beaten",
    "1 clove garlic, minced",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon paprika",
    "0.5 teaspoon chile-garlic sauce (such as Sriracha®)",
    "1.5 cups vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Place daikon in a large bowl; sprinkle with salt. Refrigerate for 30 minutes. Drain daikon. Transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion, bread crumbs, egg, garlic, black pepper, paprika, and chili garlic sauce to daikon; mix well. Form into 8 patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Add patties; cook until firm and nicely brown, about 3 minutes per side. Drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
