  "ingredients": [
    "5.25 cups vegetable broth, divided",
    "4 onions, sliced",
    "0.125 teaspoon white sugar",
    "2 tablespoons all-purpose flour",
    "0.5 cup dry white wine",
    "1 bay leaf",
    "0.5 teaspoon ground thyme",
    "0.5 teaspoon ground black pepper",
    "1 tablespoon brandy",
    "4 slices French bread, toasted",
    "1 clove garlic, halved",
    "2 tablespoons grated fat-free Parmesan cheese"
  ],
  "steps": [
    {
      "text": "In a large non-stick saucepan, heat 1/4 cup vegetable broth. Stir in the onion and cook over medium heat until golden, 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the sugar and flour. Pour in the remaining 5 cups vegetable broth and the wine. Stir in the bay leaf, thyme and black pepper. Bring to a boil and let boil 8 minutes, stirring constantly; then reduce heat, partly cover, and simmer 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat, remove bay leaf and stir in brandy. Rub garlic clove over toast. Ladle the soup into 4 ovenproof bowls and float a piece of toast on top of each bowl. Sprinkle with the Parmesan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bowls under broiler until cheese melts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
