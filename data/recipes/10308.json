  "title": "Oatmeal Peanut Butter Cookies",
  "description": "This peanut butter oatmeal cookie recipe is loaded with peanut butter flavor and packed with heart-healthy oats for a tasty twist on a classic treat.",
  "authors": [
    "Michele"
  ],
  "date_published": "1997-11-15T06:15:37-05:00",
