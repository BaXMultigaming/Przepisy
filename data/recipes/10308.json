  "ingredients": [
    "1 cup peanut butter",
    "1 cup packed brown sugar",
    "0.75 cup white sugar",
    "0.5 cup shortening",
    "0.5 cup margarine, softened",
    "2 large eggs",
    "1.5 cups all-purpose flour",
    "2 teaspoons baking soda",
    "1 teaspoon salt",
    "1 cup quick-cooking oats"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat peanut butter, brown sugar, white sugar, shortening, and margarine in a large bowl with an electric mixer on medium speed until smooth and creamy. Beat in eggs, one at a time, until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Vv7h-c9MDbIlPFA3uECnPdu-5s4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10308-oatmeal-peanut-butter-cookies-DDMFS-step2-3112-1a00e4e6f1fa418282cd4034c2f40f64.jpg"
      ],
      "image": "assets/images/10308/step_02.webp"
    },
    {
      "text": "Combine flour, baking soda, and salt in a separate bowl; stir into creamed mixture until incorporated. Mix in oats until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MJ4IVcIl1LyuAzCuUkkTen3qo7o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10308-oatmeal-peanut-butter-cookies-DDMFS-step4-3117-1-d25ecc4fe6a9419cb994c5019da863fa.jpg"
      ],
      "image": "assets/images/10308/step_03.webp"
    },
    {
      "text": "Drop teaspoonfuls of dough onto ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sMZ9Gas_pMmx0GhEk3vwscHn8Gk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10308-oatmeal-peanut-butter-cookies-DDMFS-step5-3119-b0dd9517f0a34cec8bf27f1b7dc5e272.jpg"
      ],
      "image": "assets/images/10308/step_04.webp"
    },
    {
      "text": "Bake cookies in the preheated oven until just lightly browned, 10 to 15 minutes. Do not overbake. Cool and store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/92Z82l-eVcRoQNnutlo_HExmM8Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10308-oatmeal-peanut-butter-cookies-DDMFS-4x3-0ea3ce0c182d4dd29d5fa59581252f6a.jpg"
      ],
      "image": "assets/images/10308/step_05.webp"
    }
  ],
