  "ingredients": [
    "1 cup flour",
    "1 teaspoon baking powder",
    "4 eggs",
    "0.5 cup vegetable oil",
    "2 pounds zucchini, peeled and diced",
    "1 onion, chopped",
    "salt and pepper to taste",
    "paprika",
    "chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Generously grease a 9x13-inch baking dish.",
