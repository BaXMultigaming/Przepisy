  "ingredients": [
    "0.25 cup vegetable oil",
    "1 onion, chopped",
    "1 tablespoon minced garlic",
    "3 whole cloves",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon cumin seeds",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon red chile powder",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon ground ginger",
    "0.5 cup water",
    "0.5 teaspoon tomato paste",
    "2 (5 ounce) packages baby spinach",
    "1.5 cups cubed paneer (Indian cheese curd)",
    "0.25 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat. Add onion and garlic; cook and stir until lightly browned, about 8 minutes. Reduce heat to medium-low; stir in cloves, salt, pepper, garlic powder, cumin seeds, cinnamon, red chile powder, onion powder, and ground ginger. Cook until fragrant, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water and tomato paste into the pot. Bring to a boil; reduce heat to low and simmer until flavors combine, about 10 minutes. Stir spinach into the pot; simmer, covered, until wilted, about 10 minutes. Uncover and cook until liquid evaporates and oil separates, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer spinach mixture carefully to a blender. Cover and hold lid down with an oven mitt; puree until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour spinach puree back into the pot. Stir in paneer and heavy cream. Cover and simmer over medium heat until paneer is heated through, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
