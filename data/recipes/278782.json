  "ingredients": [
    "1 cup dry lentils",
    "5 cups water",
    "1 cube beef bouillon",
    "0.5 cup uncooked white rice",
    "3 tablespoons vegetable oil",
    "1 medium onion, chopped",
    "2 tablespoons chopped red bell pepper",
    "2 cloves garlic, minced",
    "2.5 teaspoons ground cumin",
    "salt and ground black pepper to taste",
    "1 pound lean ground beef",
    "1.5 teaspoons ground paprika"
  ],
  "steps": [
    {
      "text": "Place lentils in a bowl and cover with cold water. Soak for at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain lentils and put in a large pot with 5 cups water and bouillon cube; bring to a boil. Reduce heat to a simmer and cook for 15 minutes. Add rice and simmer until rice and lentils are tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat oil in a skillet over medium heat. Add onion, bell pepper, garlic, cumin, salt, and pepper; sauté until onion is golden brown and tender, 5 to 7 minutes. Add ground beef; cook and stir until browned and crumbly, 7 to 9 minutes. Add paprika and cook for 1 more minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add meat mixture to lentils and rice. Simmer over low heat for 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
