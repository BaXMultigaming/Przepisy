  "title": "Mushroom Swiss Burger",
  "description": "A satisfying mushroom Swiss burger, made with a juicy homemade beef patty, topped with savory sliced mushrooms and gooey melted Swiss cheese.",
  "authors": [
    "Ms Stephanie"
  ],
  "date_published": "2018-06-08T09:18:05-04:00",
