    "1 tablespoon butter",
    "6 ounces diced cooked ham",
    "2 cups heavy cream",
    "1 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium sauce pan over medium heat, melt butter. Stir in ham and cook 1 minute. Stir in cream and heat through. Stir in Parmesan and cook until thick and smooth. Toss with cooked pasta.",
