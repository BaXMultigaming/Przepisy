  "ingredients": [
    "2 medium cucumbers",
    "6 tablespoons rice wine vinegar",
    "6 tablespoons white sugar",
    "2 tablespoons soy sauce",
    "0.5 teaspoon sesame seeds, or more to taste"
  ],
  "steps": [
    {
      "text": "Peel cucumbers. Halve lengthwise and remove seeds. Slice into 1/4-inch thick half moons.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix vinegar, sugar, and soy sauce together in a bowl until sugar is completely dissolved. Add cucumbers and stir until coated. Cover and refrigerate for at least 2 hours before serving. Sprinkle with sesame seeds and serve cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
