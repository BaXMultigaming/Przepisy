  "ingredients": [
    "2 tablespoons olive oil",
    "0.5 fresh poblano pepper, seeded and finely chopped",
    "0.5 onion, finely chopped",
    "1 teaspoon honey",
    "3 tablespoons dark molasses",
    "0.33333334326744 cup packed brown sugar",
    "1 (6 ounce) can tomato paste",
    "0.5 cup apple cider vinegar",
    "0.25 cup Marsala wine",
    "0.5 teaspoon crushed red pepper flakes, or to taste",
    "0.75 teaspoon garlic powder",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon dried oregano",
    "0.5 teaspoon liquid smoke flavoring",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat the olive oil in a saucepan over medium heat, and cook and stir the poblano pepper and onion for 6 to 8 minutes, until the onion is translucent.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in the honey, molasses, brown sugar, tomato paste, vinegar, Marsala wine, red pepper flakes, garlic powder, cumin, oregano, smoke flavoring, salt and pepper, and whisk until smooth. Bring the sauce to a boil over medium-low heat, reduce heat to low, and simmer for about 35 minutes, stirring occasionally, until the sauce is thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Store refrigerated.",
