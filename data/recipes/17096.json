  "ingredients": [
    "0.5 pound bacon",
    "1 teaspoon minced garlic",
    "3 (8 ounce) packages cream cheese, softened",
    "4 ounces blue cheese",
    "0.25 cup chopped walnuts or pecans to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, fry chopped bacon until it is almost done. Stir garlic into the skillet. Remove from skillet and drain excess fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium mixing bowl, mix bacon with cream cheese and blue cheese. Transfer the mixture to a casserole dish. Sprinkle nuts over the dip.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
