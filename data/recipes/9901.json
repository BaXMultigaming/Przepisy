  "title": "Chocolate Brittle Surprise",
  "description": "Like chocolate-covered toffee! Disappears like magic! Great for holiday parties, gifts!",
  "authors": [
    "ShanaLee"
  ],
  "date_published": "1997-08-18T15:20:21-04:00",
