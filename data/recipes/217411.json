  "ingredients": [
    "1.5 teaspoons ground black pepper",
    "1 tablespoon dried oregano",
    "1.5 teaspoons cayenne pepper",
    "1.5 teaspoons chili powder",
    "1.5 teaspoons garlic powder",
    "1 teaspoon ground cumin",
    "1 teaspoon salt",
    "1 teaspoon seasoned salt",
    "1 (3 pound) boneless beef chuck roast"
  ],
  "steps": [
    {
      "text": "Prepare a smoker with dampened hickory wood charcoal. The heat inside your grill or smoker should be around 180 to 200 degrees F (80 to 95 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine black pepper, oregano, cayenne pepper, chili powder, garlic powder, cumin, salt, and seasoned salt in a small bowl until thoroughly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chuck roast in a mixing bowl, and rub all over with the spice mixture. Place meat into smoker, and smoke for 1 1/2 hours, turning about every half hour. The meat should be dark red and the edges should be darkened. Place meat in a roasting pan, and seal tightly with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake meat in the preheated oven for 1 1/2 hours or until very tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Uncover meat, and shred with two forks while still hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
