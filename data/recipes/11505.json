  "title": "Macadamia Coconut Icebox Cookies",
  "description": "A great refrigerator cookie with a tropical twist. This dough freezes well and only takes a few minutes to thaw and then bake.",
  "authors": [
    "LYNN SEVERNS"
  ],
  "date_published": "1999-09-30T22:06:36-04:00",
