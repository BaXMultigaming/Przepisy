  "title": "Food Processor Pie Crust",
  "description": "Homemade pie crust is easy to make in the food processor with flour, very cold butter, and ice water for a flaky dough that comes together quickly.",
  "authors": [
    "Charlotte"
  ],
  "date_published": "1998-08-18T16:33:36-04:00",
