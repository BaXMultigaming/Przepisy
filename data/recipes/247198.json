  "ingredients": [
    "2 cups all-purpose flour",
    "1 tablespoon salt",
    "1 tablespoon baking powder",
    "1 cup water, or as needed",
    "2 tablespoons vegetable oil, or as needed",
    "1 (15 ounce) can chili",
    "1 tomato, chopped",
    "1 cup shredded Cheddar cheese",
    "1 cup shredded lettuce"
  ],
  "steps": [
    {
      "text": "Mix flour, salt, and baking powder together in a bowl. Stir in enough water to make a dough. Divide dough into 4 pieces and form into 6-inch patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Fry patties in batches until puffed and golden, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bannocks on serving plates and top with chili, tomato, Cheddar cheese, and lettuce.",
