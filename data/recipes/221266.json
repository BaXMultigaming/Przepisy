  "ingredients": [
    "2 tablespoons butter, softened",
    "4 thick slices Italian bread, toasted",
    "1.5 tablespoons olive oil",
    "1.5 pounds fresh or frozen bay scallops, thawed, rinsed and patted dry",
    "4 cloves garlic, minced",
    "0.5 cup white wine",
    "2 tablespoons lemon juice",
    "0.25 cup chopped fresh flat-leaf parsley",
    "4 tablespoons cold butter, cut into cubes",
    "1 pinch cayenne pepper",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VFuVZJqSNpySYiz7OecBaQ75HfY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221266-Bay-Scallops-with-Garlic-Parsley-Butter-Sauce-step-01-51770970efa14a3f8a3acea90ed394ba.jpg"
      ],
      "image": "assets/images/221266/step_01.webp"
    },
    {
      "text": "Spread 1/2 tablespoon softened butter onto one side of each piece of toast.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/93b4v-OhRN_3tOGuEKTbSGTL3Fw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221266-Bay-Scallops-with-Garlic-Parsley-Butter-Sauce-step-02-7a7bbb2c32f94f329b76a0914e037454.jpg"
      ],
      "image": "assets/images/221266/step_02.webp"
    },
    {
      "text": "Heat oil in a skillet over high heat. When oil begins to smoke, pour scallops into the pan; cook for 30 seconds without stirring.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TPMJRziLzRdD3SP3iLhzd0FZ7KI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221266-Bay-Scallops-with-Garlic-Parsley-Butter-Sauce-step-03-18eb49bbed284b669d92826e131ea50f.jpg"
      ],
      "image": "assets/images/221266/step_03.webp"
    },
    {
      "text": "Toss scallops in the pan and stir in garlic. Cook and stir until fragrant, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yr2zQfintGdBKVKC3KzqCvUqR-8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221266-Bay-Scallops-with-Garlic-Parsley-Butter-Sauce-step-04-d02761f30f1f44288b02319496a0ca7e.jpg"
      ],
      "image": "assets/images/221266/step_04.webp"
    },
    {
      "text": "Stir in wine and lemon juice; bring to a boil and cook for 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AzyJ49cvjogDLCCUm0syLlXMwTQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221266-Bay-Scallops-with-Garlic-Parsley-Butter-Sauce-step-05-4e04504d8dd940aa9d702e0e4bf871df.jpg"
      ],
      "image": "assets/images/221266/step_05.webp"
    },
    {
      "text": "Stir in parsley and cold butter; remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xfxBGAAXjMaQBFAkFuvgL38VlDE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221266-Bay-Scallops-with-Garlic-Parsley-Butter-Sauce-step-06-1e6e90ba3eba4ecbb69d6e29db04fb5c.jpg"
      ],
      "image": "assets/images/221266/step_06.webp"
    },
    {
      "text": "When butter melts, stir in cayenne, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KnqaqriHY7JM5FD8iI2Z0lK-hPs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221266-Bay-Scallops-with-Garlic-Parsley-Butter-Sauce-step-07-b7a26ad25ec7431fa674ffd95623dee0.jpg"
      ],
      "image": "assets/images/221266/step_07.webp"
    },
    {
      "text": "Spoon scallops over buttered toast and serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hvGX0u5UmUAEhzdUsEODAnR0Mcw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-221266-Bay-Scallops-with-Garlic-Parsley-Butter-Sauce-4x3-faf5b48f9f9840ea8f135bb2eb85b26e.jpg"
      ],
      "image": "assets/images/221266/step_08.webp"
    }
