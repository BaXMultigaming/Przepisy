  "ingredients": [
    "1.5 cups all-purpose flour",
    "1.5 cups whole wheat flour",
    "1.25 cups rolled oats",
    "2 tablespoons white sugar",
    "4 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "1.5 cups low-fat buttermilk",
    "0.66666668653488 cup unsweetened applesauce",
    "1 egg",
    "0.5 cup dried cranberries",
    "0.25 cup sliced almonds",
    "2 tablespoons white sugar",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir all-purpose flour, whole wheat flour, oats, sugar, baking powder, salt, and baking soda together in a mixing bowl until all ingredients are evenly dispersed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir buttermilk, applesauce, and egg together in a separate bowl. Add to flour mixture and stir until dough is sticky. Fold in cranberries and almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and cinnamon in a bowl for the topping. Drop 1/4 cup-size dollops of batter onto the prepared baking sheet. Sprinkle with cinnamon-sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are golden brown, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
