  "ingredients": [
    "3 tablespoons Greek yogurt",
    "3 tablespoons chile sauce",
    "2 tablespoons white vinegar",
    "2 tablespoons barbeque sauce (such as HP®)",
    "1 tablespoon dark soy sauce",
    "4 cloves garlic, minced",
    "0.5 teaspoon ground white pepper",
    "0.5 teaspoon ground black pepper",
    "1 pinch ground cinnamon",
    "1 pound boneless chicken breast, cut into cubes",
    "0.5 cup Greek yogurt",
    "3 tablespoons tahini",
    "2 tablespoons lemon juice",
    "2 cloves garlic, chopped",
    "0.5 teaspoon ground white pepper",
    "0.5 teaspoon salt",
    "0.25 cup cooking oil",
    "6 pita bread rounds",
    "0.5 head cabbage, finely shredded",
    "1 onion, cut into matchstick-size pieces",
    "2 pickled cucumbers, sliced"
  ],
  "steps": [
    {
      "text": "Combine 3 tablespoons Greek yogurt, chile sauce, vinegar, barbeque sauce, soy sauce, minced garlic, 1/2 teaspoon white pepper, black pepper, and cinnamon in a bowl; add chicken. Marinate chicken in the refrigerator for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1/2 cup Greek yogurt, tahini, lemon juice, chopped garlic, 1/2 teaspoon white pepper, and salt in a bowl until sauce is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat cooking oil in a skillet or wok over high heat; add chicken. Cook and stir until chicken is no longer pink in the center and juices run clear, 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast pita bread on a flat pan or skillet over medium heat until golden, 1 to 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread sauce on pita bread (or make pocket in the pita and spread sauce inside). Layer chicken, cabbage, onion, and pickles over sauce. Fold or wrap sandwiches with aluminum foil or parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
