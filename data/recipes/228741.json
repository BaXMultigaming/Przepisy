  "ingredients": [
    "1 yellow onion, chopped",
    "0.25 pound pork belly, diced",
    "4 cups water, more if needed",
    "1 cup vegetable broth, or more if needed",
    "0.5 cup white wine",
    "2 cups split peas",
    "1 teaspoon ground thyme",
    "0.5 teaspoon celery seed",
    "2 bay leaves",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Cook and stir onion and pork belly in a large pot over medium heat until onion is translucent and pork is browned, 10 to 15 minutes. Add water, vegetable broth, and white wine, then stir in split peas, thyme, celery seed, and bay leaves. Season with salt and pepper and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce the heat, cover, and simmer, stirring occasionally, until flavors have combined, about 2 hours. Remove bay leaves before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
