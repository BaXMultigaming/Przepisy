  "ingredients": [
    "0.25 cup unsalted butter, softened",
    "1 tablespoon Dijon mustard",
    "1 clove garlic, minced",
    "0.5 teaspoon anchovy paste",
    "2 dashes Worcestershire sauce, or to taste",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine butter, mustard, garlic, anchovy paste, Worcestershire sauce, salt, and pepper in a bowl. Mix until garlic and anchovy paste are evenly distributed. Serve immediately over warm food or cover and chill until needed.",
