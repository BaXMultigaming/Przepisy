  "ingredients": [
    "cooking spray",
    "4 cups all-purpose flour",
    "1 cup white sugar",
    "1 cup brown sugar",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1 teaspoon cinnamon",
    "0.5 teaspoon salt",
    "3 eggs, beaten",
    "2 cups milk",
    "2.5 cups persimmon pulp",
    "6 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Coat a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, white sugar, brown sugar, baking soda, baking powder, cinnamon, and salt together in a large bowl until thoroughly combined. Briefly beat eggs together in a separate large bowl, then whisk in milk until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour mixture to egg mixture in batches, alternating with persimmon pulp, mixing well after each addition. Stir in melted butter; transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 1 hour. Cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
