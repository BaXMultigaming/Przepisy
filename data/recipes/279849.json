  "ingredients": [
    "0.75 cup frozen peas",
    "1.5 cups shredded cooked chicken",
    "1 (10.75 ounce) can condensed cream of celery soup",
    "0.5 cup milk",
    "2 tablespoons chopped onion",
    "1.75 cups dry bread stuffing mix (such as Pepperidge Farm®)",
    "0.5 cup salted butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a medium saucepan with 3 cups water and bring to a boil. Add peas and boil, stirring gently, until cooked, 2 to 3 minutes. Drain and transfer peas to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken, condensed soup, milk, and onion to the peas; mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine stuffing mix and melted butter in a separate bowl. Transfer 3/4 of the stuffing mixture to a 2-quart casserole. Pour chicken mixture over top, then top with remaining stuffing mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and bake in the preheated oven until heated through, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
