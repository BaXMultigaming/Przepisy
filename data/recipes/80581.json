  "ingredients": [
    "1 egg",
    "0.5 cup cola-flavored carbonated beverage, divided",
    "0.5 cup crushed saltine crackers",
    "6 tablespoons French salad dressing, divided",
    "2 tablespoons grated Parmesan cheese",
    "1.5 pounds ground beef"
  ],
  "steps": [
    {
      "text": "Preheat a grill for high heat. When the grill is hot, lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the egg, 1/4 cup of cola, crackers, 2 tablespoons of French dressing, and Parmesan cheese. Crumble in the ground beef, and mix well. Form into 6 balls, and pat into 3/4 inch patties. Pour the remaining cola and dressing into a small bowl, and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill burgers for about 3 minutes per side. Brush with the dressing and cola, then grill for 8 to 10 more minutes, basting occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
