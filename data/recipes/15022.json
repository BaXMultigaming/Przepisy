  "ingredients": [
    "2 (8 ounce) packages refrigerated crescent rolls",
    "1 cup sour cream",
    "1 (8 ounce) package cream cheese, softened",
    "1 (1 ounce) package ranch seasoning mix",
    "1 teaspoon dried dill weed",
    "0.25 teaspoon garlic salt",
    "1.5 cups chopped fresh broccoli",
    "0.5 cup halved and thinly-sliced radishes",
    "1 small onion, finely chopped",
    "1 red bell pepper, chopped",
    "1 carrot, grated",
    "1 stalk celery, thinly sliced"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Spray a 15x10-inch pan with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ou5dddDcaaP9PcGKcGU9QWZQew0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15022-veggie-pizza-DDMFS-4x3-step-01-a32ad6054e974ecd9f79c8627bc9e811.jpg"
      ],
      "image": "assets/images/15022/step_01.webp"
    },
    {
      "text": "Press crescent roll dough into the prepared jelly roll pan to form a crust. Let stand 5 minutes. Pierce with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l8TuL2-DzFXeQ-B8OpHchqM4kYo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15022-veggie-pizza-DDMFS-4x3-step-02-35b903cb75e9496b81737f722eeb1389.jpg"
      ],
      "image": "assets/images/15022/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until dough is fully cooked and golden brown, about 10 minutes. Let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1EhDF5hQbNmEY_xpOgoW0PCiH4E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15022-veggie-pizza-DDMFS-4x3-step-03-66b2d3032dde4a26bde9b830c76274c4.jpg"
      ],
      "image": "assets/images/15022/step_03.webp"
    },
    {
      "text": "Combine sour cream, cream cheese, ranch seasoning mix, dill, and garlic salt in a medium mixing bowl. Spread the cream cheese mixture on top of cooled crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B1QhEoRS3J_Cjj5gjtSeIyOb39c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15022-veggie-pizza-DDMFS-4x3-step-04-6fce0ce229f4439ea44f2ccd5f2f305f.jpg"
      ],
      "image": "assets/images/15022/step_04.webp"
    },
    {
      "text": "Arrange broccoli, radish, onion, bell pepper, carrot, and celery on top of the cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JwvFbfojX2kFIUv1JNcI5J9wy9o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15022-veggie-pizza-DDMFS-4x3-step-05-433614e3a1274e479c823d6beea3422a.jpg"
      ],
      "image": "assets/images/15022/step_05.webp"
    },
    {
      "text": "Cover and let chill, 1 to 2 hours. Cut chilled pizza into 16 squares to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gKD4hlJ26TYEvBTrYzX2SiF95Io=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-15022-veggie-pizza-DDMFS-4x3-hero-3dabf0783ef544eeaa23bdf28b48b178.jpg"
