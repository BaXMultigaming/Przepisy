  "ingredients": [
    "2 tablespoons olive oil",
    "1 stalk celery, finely chopped",
    "2 carrots, sliced",
    "1 small onion, minced",
    "1 clove garlic, minced",
    "1 cup vegetable stock",
    "0.5 cup uncooked quinoa, rinsed",
    "0.25 teaspoon dried basil",
    "1 teaspoon ground turmeric",
    "1 teaspoon lime juice",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a saucepan over medium heat. Stir in celery, carrots, onion, and garlic. Cook and stir until onion has softened and turned translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in vegetable stock, quinoa, basil, and turmeric. Bring to a simmer, then reduce heat to low. Cover and simmer until quinoa is tender and liquid is absorbed, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in lime juice and season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
