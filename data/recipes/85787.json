  "ingredients": [
    "2 cups long grain white rice",
    "4 cups water",
    "0.5 (12 ounce) container Spam™ sliced into 1/4 inch thick slices",
    "4 eggs, beaten",
    "1 (10.5 ounce) can brown gravy, heated"
  ],
  "steps": [
    {
      "text": "Combine the rice and water in a saucepan and bring to a boil. Reduce heat to low, cover, and simmer for 15 minutes or until rice is tender and water is absorbed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat a non-stick skillet over medium heat until hot. Fry Spam™ slices until browned. Remove from the skillet, and set aside. Pour the eggs into the skillet; cook and stir until scrambled and cooked through. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "For each plate, place two scoops of rice, two scrambled eggs, and two slices of spam. Top with brown gravy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
