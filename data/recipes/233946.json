  "ingredients": [
    "2 cucumbers - peeled, seeded, and diced",
    "1 pinch salt, or as needed",
    "1 onion, diced",
    "0.25 cup crushed pistachios, or to taste",
    "1 lemon, juiced and zested",
    "2 cloves garlic, pressed",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon cayenne pepper",
    "3 tablespoons low-fat Greek-style yogurt, or to taste",
    "4 lettuce leaves",
    "4 small tomatoes, quartered"
  ],
  "steps": [
    {
      "text": "Place cucumbers in a colander; sprinkle with salt. Set aside until cucumbers release water, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat cucumbers dry to remove excess salt; transfer to a large bowl. Add onion, pistachios, lemon zest, lemon juice, garlic, black pepper, and cayenne pepper; stir in yogurt until evenly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange lettuce leaves in a serving bowl; add cucumber salad to middle of the bowl. Surround cucumber salad with tomatoes. Refrigerate for flavors to blend, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
