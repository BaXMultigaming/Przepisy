  "ingredients": [
    "1 cup blackberries",
    "0.25 cup white sugar",
    "0.33333334326744 cup quick-cooking oats",
    "0.25 cup brown sugar",
    "1.5 teaspoons ground cinnamon",
    "1 cup all-purpose flour",
    "0.75 cup white sugar",
    "1 teaspoon salt",
    "1 teaspoon baking powder",
    "0.25 cup milk, or as needed",
    "0.25 cup butter, cut into small chunks"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter a 9x12-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir blackberries and 1/4 cup white sugar together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oats, brown sugar, and cinnamon together in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, 3/4 cup white sugar, salt, and baking powder together in a third bowl. Add milk to flour mixture; mix well. Pour batter into prepared baking dish. Top with blackberry mixture; sprinkle oat mixture over blackberries. Top oat mixture with butter chunks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
