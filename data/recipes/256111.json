  "ingredients": [
    "0.5 dragon fruit",
    "1 horned melon, halved",
    "1 passion fruit, halved",
    "1 cup white sugar",
    "6 strawberries, quartered",
    "1 starfruit, cut into 1/4-inch slices",
    "1 tablespoon honey",
    "1 splash lime juice",
    "0.5 (0.13 ounce) package raspberry-flavored drink mix (such as Kool-Aid®)"
