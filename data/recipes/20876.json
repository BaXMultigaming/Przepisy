  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 medium onion, chopped",
    "1 (10 ounce) package frozen chopped spinach - thawed, drained, and squeezed dry",
    "5 large eggs, beaten",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "3 cups shredded Muenster cheese"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9-inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vtWeVTZ4rIw2-mYtHhKV-kF01yo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-20876-crustless-spinach-quiche-VAT-4x3-step-01-f2c596747cda461186ce06a1f9c91ae2.jpg"
      ],
      "image": "assets/images/20876/step_01.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add onions and cook, stirring occasionally, until soft, about 3 minutes. Stir in spinach and continue to cook until excess moisture has evaporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_qNK17fwW4AVOfGfl9dq1zAkBDQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-20876-crustless-spinach-quiche-VAT-4x3-step-02-c22593666c4e435b8277c1c2d890fa68.jpg"
      ],
      "image": "assets/images/20876/step_02.webp"
    },
    {
      "text": "Whisk together eggs, salt, and pepper in a large bowl. Add Muenster cheese and spinach mixture and stir until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4CiecqqEzMZpB_BmfxFODL84JB8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-20876-crustless-spinach-quiche-VAT-4x3-step-03-4bd89c941c5a49a2835d285a2079ac0a.jpg"
      ],
      "image": "assets/images/20876/step_03.webp"
    },
    {
      "text": "Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8AJ1LjaeZEyk_nagvZdyxgH4b-0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-20876-crustless-spinach-quiche-VAT-4x3-step-04-78dfec513cab427f836df47fab1c8be9.jpg"
      ],
      "image": "assets/images/20876/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until eggs have set, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/a054Jt4OSW1qKh1BBIIp9zpAn28=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-20876-crustless-spinach-quiche-VAT-4x3-step-05-1341588f521043a180ae5a10379c96cf.jpg"
      ],
      "image": "assets/images/20876/step_05.webp"
    },
    {
      "text": "Remove from the oven and let cool for 10 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rgwlXS3PbC4ywzP_wxxml065Yis=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-20876-crustless-spinach-quiche-VAT-4x3-step-06-0b599a3ab61449fe9286cc9da80e62fa.jpg"
      ],
      "image": "assets/images/20876/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ccyb8eaL-AzVC-egaPGOTCifEMA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-20876-crustless-spinach-quiche-VAT-4x3-step-07-1b038ac5743e45d3888a556ad4e87e87.jpg"
