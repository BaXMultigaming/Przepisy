  "ingredients": [
    "1 (8 ounce) container firm tofu, drained and pressed",
    "0.33333334326744 cup dry bread crumbs",
    "1 tablespoon taco seasoning mix",
    "2 eggs",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Cut tofu lengthwise into 2 slabs. Cut each slab into two triangles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs and taco seasoning together in a shallow pan or plate. Lightly beat eggs in a separate shallow pan or plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the air fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip each tofu triangle into the beaten eggs. Dredge them in the bread crumb mixture. Gently press down to coat each side. Arrange in a single layer on a plate. Spray lightly with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the air fryer on one side for 15 minutes. Flip each triangle and spray lightly with cooking spray. Cook until browned, about 10 minutes more. You may need to cook in batches, depending on the size of your air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
