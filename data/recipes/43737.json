    "1 cup dry lentils",
    "1 quart water",
    "1 cube vegetable bouillon",
    "3 medium tomatoes, peeled and diced",
    "1 large onion, diced",
    "1 carrot, sliced",
    "1 medium apple - peeled, cored and diced",
    "0.5 cup frozen peas",
