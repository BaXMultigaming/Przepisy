  "ingredients": [
    "1.3333333730698 cups almond milk",
    "2 ripe bananas, mashed",
    "1.25 cups rolled oats",
    "0.75 cup water",
    "4 tablespoons chia seeds",
    "0.5 teaspoon ground cinnamon",
    "0.25 cup fresh blueberries",
