  "ingredients": [
    "1.25 cups all-purpose flour, divided",
    "1 cup white sugar, divided",
    "0.33333334326744 cup butter, softened",
    "0.75 cup white chocolate chips",
    "2 eggs, slightly beaten",
    "0.25 cup lemon juice",
    "2 teaspoons lemon zest",
    "1 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup flour and 1/4 cup sugar in a bowl; mash in butter until it resembles coarse crumbs. Press crust into the bottom of a 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crusty and golden brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle white chocolate chips over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, lemon juice, and lemon zest together until eggs are beaten. Stir in remaining each 1/4 cup flour and 3/4 cup sugar; pour over white chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set in the middle, about 15 minutes. Transfer to a wire rack; cool slightly in baking dish. Sift confectioners' sugar over bars; cool completely before cutting and serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
