  "ingredients": [
    "1 cup white sugar",
    "1 stick butter, melted",
    "6 tablespoons unsweetened cocoa powder",
    "2 tablespoons vegetable oil",
    "1 teaspoon vanilla extract",
    "2 eggs, beaten",
    "0.25 cup bourbon",
    "6 tablespoons all-purpose flour",
    "0.5 teaspoon baking powder",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease an 8-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, melted butter, cocoa powder, oil, and vanilla extract together until smooth. Mix in eggs, then add bourbon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, and salt in a separate bowl. Add to the cocoa mixture. Smooth batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is dry and edges have started to pull away from the sides of the pan, about 25 minutes. Let cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
