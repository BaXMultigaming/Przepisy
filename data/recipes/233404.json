  "ingredients": [
    "Reynolds Wrap® Non-Stick Aluminum Foil",
    "8 medium Granny Smith apples, peeled, cored, and sliced",
    "1 teaspoon ground cinnamon",
    "0.5 cup sugar",
    "1 cup flour",
    "1 cup quick cooking oats",
    "1 cup lightly packed brown sugar",
    "0.5 cup chopped walnuts",
    "0.25 teaspoon salt",
    "0.5 cup butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Line 13x9x2-inch baking dish with Reynolds Wrap Non-Stick Foil with the non-stick (dull) side facing up towards the food and the shiny side facing the dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange apples evenly in dish. Sprinkle with cinnamon and sugar; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, oats, brown sugar, walnuts and salt in a medium bowl. Cut in shortening until well blended. Sprinkle flour mixture over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 40 to 45 minutes, until apples are soft and topping is lightly browned. Serve warm with ice cream.",
      "section": null,
      "name": null,
      "url": null,
