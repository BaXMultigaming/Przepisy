  "ingredients": [
    "1 (2 ounce) package chipped beef",
    "1 pound sliced bacon",
    "6 skinless, boneless chicken breast halves",
    "1 (16 ounce) container sour cream",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "0.5 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 275 degrees F (135 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line the bottom of a 9x13-inch baking dish with slices of chipped beef. Wrap bacon slices around chicken breasts and place on top of chipped beef.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together sour cream and condensed soup in a medium bowl until well combined. Pour over bacon-wrapped chicken breasts and sprinkle with paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 2 hours. An instant-read thermometer inserted into the center of chicken should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
