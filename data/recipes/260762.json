  "ingredients": [
    "1 cup milk",
    "0.25 cup white chocolate chips",
    "1 teaspoon unsweetened cocoa powder",
    "0.25 cup pumpkin puree",
    "0.5 teaspoon pumpkin pie spice",
    "0.25 teaspoon vanilla extract",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Combine milk, chocolate chips, and cocoa powder in a saucepan over medium heat. Bring a simmer, stirring constantly until chips are melted, about 5 minutes. Add pumpkin puree, pumpkin pie spice, vanilla extract, and cinnamon; whisk until well combined and heated through, 2 to 3 minutes.",
