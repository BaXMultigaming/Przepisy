  "ingredients": [
    "1 teaspoon salt",
    "3 eggs",
    "1 tablespoon white sugar",
    "1 teaspoon dry mustard",
    "1 tablespoon lemon juice",
    "1 teaspoon grated Parmesan cheese",
    "2 cloves garlic, crushed",
    "3 tablespoons red wine vinegar",
    "1.125 cups canola oil",
    "6 drops hot pepper sauce (such as Tabasco®)",
    "6 drops Worcestershire sauce",
    "3 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Place salt, eggs, sugar, dry mustard, lemon juice, Parmesan cheese, garlic, red wine vinegar, canola oil, hot pepper sauce, Worcestershire sauce, and olive oil in a blender in the order listed. Blend on high until creamy.",
