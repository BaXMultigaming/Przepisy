  "ingredients": [
    "4 tablespoons unsalted butter",
    "1 cup brown sugar",
    "1 tablespoon ground cinnamon",
    "3 fluid ounces banana liqueur",
    "4 medium bananas, peeled",
    "4 fluid ounces coffee-flavored liqueur (such as Kahlua®)",
    "4 scoops vanilla ice cream"
  ],
  "steps": [
    {
      "text": "Melt butter in a medium skillet over low heat. Add brown sugar and cinnamon; stir frequently and cook until sugar dissolves and sauce is thick, about 3 minutes. Add banana liqueur.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice bananas in half lengthwise and gently place in the skillet. Cook for 1 minute, then gently turn and cook until brown and soft, about 1 to 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add coffee-flavored liqueur and cook until hot, 1 to 2 minutes. Tip the skillet slightly and ignite the rum with a lighter. Remove skillet from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop ice cream into 4 bowls. Add a banana to each bowl and pour warm sauce over top. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
