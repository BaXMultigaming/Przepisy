  "ingredients": [
    "2 (15.25 ounce) cans shoepeg corn, drained",
    "1 (10.75 ounce) can condensed cream of celery soup",
    "1 (8 ounce) container sour cream",
    "1 cup grated Cheddar cheese",
    "0.5 cup butter",
    "1 sleeve crushed buttery round crackers (such as Ritz®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place drained corn in a shallow 2-quart casserole dish. Combine soup, sour cream, and Cheddar in a bowl; spread evenly over the corn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium-low heat. Add crackers; stir to combine. Spread over corn.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until casserole is hot and topping is golden brown, about 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
