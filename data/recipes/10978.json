  "ingredients": [
    "0.5 cup margarine, softened",
    "0.5 cup peanut butter",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 large egg",
    "0.5 teaspoon vanilla extract",
    "1.75 cups all-purpose flour",
    "0.75 teaspoon baking soda",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together margarine, peanut butter, sugars, egg, and vanilla in a large bowl with an electric mixer until light and fluffy. Add flour, baking soda, and salt; mix until well combined. Chill dough in the refrigerator for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll chilled dough into walnut-size balls and place 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are lightly browned, 7 to 10 minutes. Do not overbake. Cool cookies on a wire rack, then store in an airtight plastic container to keep soft.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
