  "title": "Soft Peanut Butter Cookies",
  "description": "These easy peanut butter cookies are simple to make with pantry staples and stay soft for days in an airtight container for sweet treats all week.",
  "authors": [
    "Cindy Duvall"
  ],
  "date_published": "1998-08-11T18:02:54-04:00",
