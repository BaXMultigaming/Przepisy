  "ingredients": [
    "6 cups peeled and sliced fresh peaches",
    "1.75 cups white sugar",
    "0.5 cup unsalted butter, melted",
    "1 tablespoon lemon juice",
    "1 cup all-purpose flour",
    "1 cup milk",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 teaspoon ground cinnamon, or to taste",
    "1 cup shredded jalapeno Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix peaches with 1 cup sugar in a bowl until coated; set aside. Combine flour, milk, 3/4 cup sugar, baking powder, and salt in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour butter into a 9x13-inch glass baking dish. Pour flour mixture over the melted butter. Spoon peaches over the flour, sprinkle generously with cinnamon, and sprinkle with shredded cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is bubbly and cheese is golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
