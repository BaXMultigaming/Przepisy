  "ingredients": [
    "6 medium potatoes, chopped",
    "6 medium carrots, peeled and chopped",
    "3 medium onions, chopped",
    "6 cloves garlic, crushed",
    "0.25 teaspoon dried sage",
    "0.25 teaspoon dried basil",
    "0.25 cup extra-virgin olive oil",
    "2 tablespoons balsamic vinegar",
    "2 tablespoons light brown sugar",
    "sea salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes, carrots, onions, garlic, sage, and basil into a large bowl; add olive oil and balsamic vinegar and toss to coat. Transfer to a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven, tossing a couple of times for even cooking, until tender, about 30 minutes. Remove from the oven and sprinkle with brown sugar. Continue to roast for 10 more minutes. Season with sea salt and pepper just prior to serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
