  "ingredients": [
    "16 cups popped popcorn, or more to taste",
    "1 cup packed light brown sugar",
    "0.5 cup butter",
    "0.5 cup light corn syrup",
    "16 drops green food coloring",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon baking soda"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C). Spread popcorn into 1 large or 2 smaller greased roasting pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, butter, corn syrup, and food coloring in a medium saucepan over medium heat. Stir constantly until boiling. Let boil undisturbed for 5 minutes. Remove from heat. Stir in vanilla extract and baking soda; mixture will foam up then subside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture over popcorn and stir until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring every 15 minutes, for 45 minutes. Stir popcorn as it cools to break it apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
