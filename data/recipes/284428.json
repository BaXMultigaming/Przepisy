  "ingredients": [
    "4 cups milk, divided",
    "0.25 cup all-purpose flour",
    "4 egg whites",
    "0.75 cup white sugar",
    "1 pinch salt",
    "1 pinch ground cinnamon"
  ],
  "steps": [
    {
      "text": "Mix 1 cup milk, flour, and egg whites in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour remaining milk into a saucepan. Add sugar and salt and bring to a boil over medium heat. Add egg white mixture. Cook, stirring constantly, until a frothy custard has formed, about 10 minutes. Remove from the heat and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve in a large dish or in individual cups with cinnamon sprinkled on top.",
      "section": null,
      "name": null,
