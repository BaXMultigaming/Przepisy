  "ingredients": [
    "4 (10 ounce) cans refrigerated biscuit dough",
    "1 cup barbeque sauce",
    "1 cup shredded Cheddar cheese",
    "1 (16 ounce) package cocktail wieners"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove biscuits from cans. Flatten each biscuit slightly. Spoon a teaspoon of barbeque sauce in the center of each flattened biscuit. Sprinkle a teaspoon of cheese over barbeque sauce; top with cocktail wiener.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pull opposite sides of each biscuit together to form a taco shape. Press edges together to seal; fold over to one side, pressing biscuit down on itself. Arrange filled biscuits on 2 baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden brown, about 10 minutes. Allow to cool slightly before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
