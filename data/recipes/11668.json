  "ingredients": [
    "1 onion, chopped",
    "2 stalks celery, chopped",
    "3 cloves garlic, minced",
    "0.25 cup olive oil",
    "0.25 pound thinly sliced prosciutto",
    "0.75 cup vodka",
    "1 (28 ounce) can crushed tomatoes",
    "0.25 teaspoon dried oregano",
    "2 tablespoons chopped fresh parsley",
    "1 tablespoon dried basil",
    "0.25 teaspoon cayenne pepper",
    "1 cup half-and-half cream",
    "1 pound penne pasta"
  ],
  "steps": [
    {
      "text": "In a large skillet, heat oil over medium heat. Cook onion, celery, and garlic in oil; stir until soft. Add prosciutto and vodka. Simmer until almost all liquid is gone.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomatoes, cayenne, and herbs. Simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in half and half, and heat for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cook pasta in boiling salted water until done. Drain. Serve sauce over noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
