  "ingredients": [
    "0.75 cup water, or as needed",
    "2 whole star anise",
    "12 whole cloves, or more to taste",
    "1 (7 pound) country-style ham",
    "1 cup firmly packed light brown sugar",
    "0.25 cup honey",
    "2 tablespoons Dijon mustard",
    "2 tablespoons rice vinegar",
    "1.5 teaspoons freshly ground black pepper",
    "0.5 teaspoon Worcestershire sauce",
    "1 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare ham: Add water, star anise, and cloves to the bottom of a roasting pan. Place a roasting rack into the pan; place ham on the rack. Cut 1/4-inch-deep slashes, 1/2-inch apart, lengthwise and crosswise across the top of ham.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While ham is baking, make glaze: Whisk together brown sugar, honey, mustard, vinegar, black pepper, Worcestershire sauce, and cayenne pepper in a medium bowl until thick and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush glaze all over ham. Continue baking ham, brushing with glaze every 20 minutes, until glaze is deep golden and ham is heated through, about 2 hours 10 minutes. An instant-read thermometer inserted into the center of ham should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Run a kitchen torch over ham until glaze is crispy and caramelized, 2 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
