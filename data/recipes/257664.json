  "ingredients": [
    "4 thin slices cucumber",
    "1 sprig fresh mint",
    "0.5 teaspoon white sugar",
    "3 dashes orange bitters",
    "0.5 cup frozen tropical fruit medley",
    "2 fluid ounces London dry gin",
    "0.5 lime, juiced",
    "0.5 fluid ounce red wine",
    "1 splash club soda, or as needed"
  ],
  "steps": [
    {
      "text": "Combine cucumber, mint, sugar, and orange bitters in a highball glass; muddle until fragrant. Fill the glass with frozen fruit, then pour in gin, lime juice, and red wine. Top with club soda and stir.",
