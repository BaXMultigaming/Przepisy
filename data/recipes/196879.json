  "ingredients": [
    "0.5 pound Korean dang myun noodles",
    "2.5 teaspoons sesame oil, divided",
    "2 tablespoons soy sauce",
    "2 teaspoons white sugar",
    "1 tablespoon vegetable oil",
    "2 carrots, cut into match-stick size pieces",
    "0.5 pound asparagus, thinly sliced",
    "0.75 cup thinly sliced onions",
    "2 cloves garlic, minced",
    "3 green onions cut into 1-inch pieces",
    "0.5 cup dried shiitake mushrooms, soaked until soft, then sliced into strips",
    "1 tablespoon sesame seeds"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JzjPHB7LFLtqJnRdlNPPrCKvXuQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/196879-Jap-Chae-Korean-Glass-Noodles-ddmfs-step-1-034-8771051d86eb448e8311d20d5129f653.jpg"
      ],
      "image": "assets/images/196879/step_01.webp"
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook noodles in boiling water, stirring occasionally, until tender yet firm to the bite, 4 to 5 minutes. Drain, then rinse with cold water. Toss noodles with 1 teaspoon sesame oil; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lbEd2pxxHHQ04cMj4R_LBh4Gxng=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/196879-Jap-Chae-Korean-Glass-Noodles-ddmfs-step-3-113-58af82b33ccb4a25bf0790e3b8874943.jpg"
      ],
      "image": "assets/images/196879/step_02.webp"
    },
    {
      "text": "Whisk together soy sauce and sugar in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g6zU0WRpqpXQscQiDcNCJLNi7xg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/196879-Jap-Chae-Korean-Glass-Noodles-ddmfs-step-4-114-573264dfddf640749e0989e6f445b377.jpg"
      ],
      "image": "assets/images/196879/step_03.webp"
    },
    {
      "text": "Heat vegetable oil in a skillet over medium-high heat. Cook and stir carrots, asparagus, onions, and garlic in hot oil until softened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5jovKevjx6hyoW3lSFmjIEA5LVc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/196879-Jap-Chae-Korean-Glass-Noodles-ddmfs-step-5-A-115-42b1f5b797c4484f9fe3835b9a04b5e0.jpg"
      ],
      "image": "assets/images/196879/step_04.webp"
    },
    {
      "text": "Stir in green onions and mushrooms; continue cooking and stirring for 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U-7x_pZnBrBcwzhJ1x9_WlMKJ4M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/196879-Jap-Chae-Korean-Glass-Noodles-ddmfs-step-5-B-116-a01e98cfdf4b413c917febb8cfc08b26.jpg"
      ],
      "image": "assets/images/196879/step_05.webp"
    },
    {
      "text": "Pour in soy sauce mixture, then add noodles. Cook and stir until noodles are warmed through, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BysknORoURYPFCduzVHqn2iCwLM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/196879-Jap-Chae-Korean-Glass-Noodles-ddmfs-step-6-117-a8c309ab8545484f953dba8161d70b86.jpg"
      ],
      "image": "assets/images/196879/step_06.webp"
    },
    {
      "text": "Remove from heat and toss with sesame seeds and remaining 1 1/2 teaspoons sesame oil.",
      "section": null,
