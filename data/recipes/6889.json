  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups shredded sharp Cheddar cheese",
    "0.75 cup margarine",
    "1 teaspoon baking powder",
    "0.25 teaspoon cayenne pepper",
    "0.5 teaspoon salt",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (205 degrees C). Grease or line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the flour, baking powder, cayenne pepper, salt, grated cheese and butter or margarine in a bowl and mix until well combined. Add water a little bit at a time to make a very stiff dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a lightly floured surface, roll pieces of the dough into just slightly thicker than pencil shaped sticks. Cut sticks into 4 to 5 inch lengths. Arrange the pieces on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 400 degrees F (205 degrees C) for 5 minutes or until browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
