  "ingredients": [
    "2 slices thick-cut bacon, chopped",
    "1 (16 ounce) package hot dogs , cut into 1/4-inch slices",
    "1 tablespoon olive oil",
    "1 (28 ounce) can baked beans with pork",
    "0.66666668653488 cup ketchup",
    "0.25 cup Worcestershire sauce",
    "1 ½ teaspoons yellow mustard",
    "1.5 teaspoons garlic powder",
    "1/2 teaspoon onion powder",
    "1 tablespoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PYPb5Ysy5q2GWtaGCOWA4swB1o8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/60522-beanie-weenie-ddmfs-step1-4x3-0032-a2496e73a6f14031b845f2e54ba38309.jpg"
      ],
      "image": "assets/images/60522/step_01.webp"
    },
    {
      "text": "Heat a large skillet over medium-high. Add bacon, if using, and hot dogs (if not using bacon, add 1 tablespoon oil to skillet). Cook, stirring occasionally, until browned on both sides, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1rgCNc_F87u6h1B9Ip66V-B_DGA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/60522-beanie-weenie-ddmfs-step2-4x3-0040-ab04e1fda4ab4f86af3162f59baf91b7.jpg"
      ],
      "image": "assets/images/60522/step_02.webp"
    },
    {
      "text": "Stir in baked beans, ketchup, Worcestershire, mustard, garlic powder, and onion powder until evenly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/axBbYMsl_CujfsmU8V__jgDC6yI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/60522-beanie-weenie-ddmfs-step3-4x3-0045-95242d36d55a4d6084388a3225636403.jpg"
      ],
      "image": "assets/images/60522/step_03.webp"
    },
    {
      "text": "Bring to a boil over medium-high. Reduce heat to low and simmer until thickened, about 10 minutes, stirring occasionally. Stir in parsley. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
