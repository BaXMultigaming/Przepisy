  "ingredients": [
    "1 egg",
    "2 tablespoons vegetable oil",
    "1 cup milk",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup light brown sugar",
    "1 packet instant, banana-flavored oatmeal"
  ],
  "steps": [
    {
      "text": "Whisk together egg, oil, and milk until smooth. Sift together flour, baking soda, and salt; add to egg mixture along with brown sugar, and oatmeal; stir until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle or frying pan over medium high heat. Pour or spoon the batter onto the griddle, using approximately 1/4 cup for each pancake. Brown on both sides and serve hot.",
