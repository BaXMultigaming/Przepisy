  "ingredients": [
    "1 pound assorted root vegetables (carrots, parsnips, beets, onions, and or sweet potatoes) peeled and cut into bite-size pieces",
    "1 tablespoon olive oil",
    "1 teaspoon seasoning blend",
    "0.25 teaspoon salt",
    "0.25 teaspoon freshly ground black pepper",
    "0.5 cup plain Greek-style yogurt",
    "1 teaspoon lemon zest",
    "1 tablespoon lemon juice",
    "1 tablespoon chopped fresh herbs",
    "0.125 teaspoon salt",
    "0.125 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C). Add root vegetables to a large bowl and toss with oil, seasoning, 1/4 teaspoon salt, and 1/4 teaspoon pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches as needed, spread out sticks in the air-fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry, turning or stirring halfway through, until sticks are tender and golden, about 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together yogurt, citrus zest, citrus juice, herbs, 1/8 teaspoon salt, and 1/8 teaspoon pepper in a small bowl for the dip. Serve dip with veggie sticks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
