  "ingredients": [
    "4 boneless pork chops",
    "Kosher salt and fresh cracked pepper to taste",
    "1 tablespoon olive oil",
    "2 tablespoons honey",
    "4 fresh apricots, pitted and cut into wedges",
    "3 cloves garlic, minced, or to taste",
    "1 teaspoon chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Pat pork chops dry with paper towels, then sprinkle both sides with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium-high heat. Add chops and brown well, about 5 minutes per side. Stir in honey, apricots, and garlic; cover and simmer until pork is tender, about 8 minutes. An instant-read thermometer, inserted into the center, should read at least 145 degrees F (63 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve chops topped with apricots and pan juices. Garnish with parsley.",
      "section": null,
