  "ingredients": [
    "1 cup semisweet chocolate chips",
    "0.5 cup bourbon",
    "0.25 cup corn syrup",
    "3 cups crushed vanilla wafers",
    "1.5 cups ground walnuts",
    "24 candied cherries, halved",
    "0.5 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "In the microwave oven or over a double boiler, melt chocolate chips, stirring occasionally until smooth. Remove from heat and stir in the bourbon and corn syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, toss together the crushed vanilla wafers and ground walnuts. Pour the chocolate mixture over the crumbs in the bowl and blend well using your hands. Shape into 1 inch balls and press a cherry half into the center of each one. Roll each cookie in confectioners' sugar to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Store in an airtight tin for at least a week before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
