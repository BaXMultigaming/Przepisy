  "ingredients": [
    "cooking spray",
    "2 cups egg whites",
    "0.33333334326744 cup Greek yogurt",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon dried oregano",
    "0.125 teaspoon cayenne pepper",
    "1 cup finely chopped red bell pepper",
    "1 cup finely chopped fresh spinach",
    "0.5 cup shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Generously grease a 12-cup muffin tin with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg whites, yogurt, salt, black pepper, garlic powder, onion powder, oregano, and cayenne together in a bowl until smooth and no lumps remain. Mix in red bell pepper, spinach, and Cheddar. Divide between the 12 muffin cups, filling each until almost full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until egg bites puff up substantially and begin to brown, 20 to 25 minutes. Allow to cool for 5 minutes; bites will deflate as they cool. Run a knife around the edges and bottoms to loosen and remove from the cups. Allow to cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
