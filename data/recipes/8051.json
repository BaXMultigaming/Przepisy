  "ingredients": [
    "2 cups white sugar",
    "1 cup shortening",
    "4 large eggs",
    "2 teaspoons vanilla extract",
    "2.75 cups all-purpose flour",
    "1 tablespoon baking powder",
    "1 teaspoon salt",
    "1.75 cups milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together sugar and shortening. Beat in eggs and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, combine flour, baking powder, and salt. Add to creamed mixture alternately with milk. Mix well. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes, or until cake tests done. Cool.",
      "section": null,
      "name": null,
