  "ingredients": [
    "4 large potatoes, cut into small chunks",
    "1 onion, cut into chunks",
    "2 cups baby carrots",
    "1 large green bell pepper, cut into chunks",
    "2 cloves garlic",
    "4 cubes chicken bouillon",
    "salt and pepper to taste",
    "3 squirrels - skinned, gutted, and cut into pieces",
    "water to cover",
    "2 tablespoons flour"
  ],
  "steps": [
    {
      "text": "Place potatoes, onion, carrots, bell pepper, garlic, chicken bouillon, salt, and pepper in a slow cooker. Lay squirrel meat on top of vegetable mixture. Pour in enough water to cover completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on High for 6 hours. Stir in flour until incorporated and continue cooking for 2 more hours.",
      "section": null,
