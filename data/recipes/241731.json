  "ingredients": [
    "1 cup basmati rice",
    "2 teaspoons vegetable oil",
    "1 teaspoon cumin seeds",
    "4 whole cloves",
    "4 whole black peppercorns",
    "2 cardamom pods",
    "1 bay leaf",
    "1.5 cups water",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Rinse rice 3 to 4 times and transfer to a bowl; cover with water and soak for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium heat; cook and stir cumin until starting to pop, 2 to 4 minutes. Add cloves, peppercorns, cardamom pods, and bay leaf; cook and stir until fragrant, about 1 1/2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain rice and mix into spice mixture; add 1 1/2 cups water and salt. Cover skillet and cook on high for 5 minutes. Reduce heat to medium and continue cooking for 10 minutes. Reduce heat to low and cook for 15 minutes. Remove skillet from heat and let rest with cover on, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cover and fluff rice with a fork. Remove bay leaf, cardamom pods, cloves, and peppercorns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
