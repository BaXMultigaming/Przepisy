  "ingredients": [
    "1 tablespoon butter",
    "2 teaspoons olive oil",
    "0.66666668653488 cup chopped green onions",
    "2 cloves garlic, minced",
    "0.5 teaspoon dried parsley",
    "0.25 teaspoon sea salt",
    "0.25 teaspoon ground black pepper",
    "0.25 cup lemon juice",
    "0.25 cup lightly packed brown sugar",
    "2 (3 ounce) fillets catfish",
    "1 teaspoon brown sugar"
  ],
  "steps": [
    {
      "text": "Melt butter with olive oil in a large skillet over medium heat. Cook and stir green onions, garlic, parsley, salt, and pepper in the hot oil until vegetables are softened, about 2 minutes. Stir lemon juice and 1/4 cup brown sugar into green onion mixture, stirring constantly until sugar is dissolved, about 2 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place catfish fillets into the skillet; cook until catfish easily flakes with a fork, 3 to 4 minutes per side. Transfer catfish to a plate and pour remaining lemon juice sauce on top. Sprinkle with remaining brown sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
