  "ingredients": [
    "flour",
    "1 (18.25 ounce) package lemon cake mix",
    "1 cup vegetable oil",
    "4 eggs, beaten",
    "1 (3.4 ounce) package instant vanilla pudding mix",
    "10 fluid ounces Mountain Dew™",
    "1 (20 ounce) can crushed pineapple with juice",
    "1 cup white sugar",
    "3 tablespoons cornstarch",
    "1 cup flaked coconut",
    "0.25 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together cake mix, oil, beaten eggs, pudding mix, and Mountain Dew in a large bowl until well combined. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 30 to 35 minutes. Allow cake to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pineapple with juice, sugar, and cornstarch in a saucepan. Bring to a boil and cook, stirring constantly, until thick. Remove from heat. Stir in coconut and butter. Spread evenly over cooled cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
