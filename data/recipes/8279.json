  "title": "Mountain Dew Cake",
  "description": "This Mountain Dew cake is made with boxed mix, instant pudding, eggs, oil, and crushed pineapple and features a buttery coconut-pineapple topping.",
  "authors": [
    "MARBALET"
  ],
  "date_published": "1999-06-03T20:02:32-04:00",
