  "ingredients": [
    "2.75 cups sifted all-purpose flour",
    "1 cup white sugar",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup lard",
    "1 egg",
    "1 teaspoon almond extract",
    "48 almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, baking soda and salt together into a bowl. Cut in the lard until mixture resembles cornmeal. Add egg and almond extract. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1-inch balls. Set them 2 inches apart on an ungreased cookie sheet. Place an almond on top of each cookie and press down to flatten slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the edges of the cookies are golden brown, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
