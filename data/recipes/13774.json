  "ingredients": [
    "8 ounces butter, softened",
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "1 cup pumpkin puree",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "1 cup raisins",
    "1 cup rolled oats",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together butter, white sugar, and brown sugar with an electric mixer in a large bowl until fluffy. Beat in pumpkin, egg, and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, raisins, oats, baking powder, cinnamon, and salt in a separate bowl. Stir into pumpkin mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 2 inches apart onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until slightly browned around edges, 12 to 15 minutes. Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
