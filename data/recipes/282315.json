  "ingredients": [
    "1 (6 ounce) French baguette, sliced into 1/2-inch rounds",
    "2 large eggs",
    "2 medium red onions, finely chopped",
    "2 medium tomatoes, cored and diced",
    "0.5 cup chopped fresh mushrooms",
    "2 cloves garlic, finely chopped",
    "1 (1 inch) piece fresh ginger, finely chopped",
    "0.5 cup grated Cheddar cheese, divided",
    "0.5 teaspoon dried sage",
    "salt and ground black pepper to taste",
    "0.25 cup real bacon bits"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Arrange baguette slices in the bottom of a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs well in a bowl. Add onions, tomatoes, mushrooms, garlic, and ginger in a bowl. Sprinkle 2 tablespoons of Cheddar cheese on top and mix until well combined. Add sage, salt, and pepper. Pour egg mixture over the baguette slices and sprinkle with bacon bits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 17 minutes. Sprinkle with remaining Cheddar and bake until fully melted, about 5 more minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
