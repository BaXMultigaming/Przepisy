  "ingredients": [
    "4 (5 ounce) skinless, boneless chicken breast halves",
    "1 cup bottled buffalo wing sauce",
    "salt and ground black pepper to taste",
    "4 tablespoons olive oil",
    "4 Ball Park® Golden Hamburger Buns",
    "4 leaves Bibb lettuce",
    "4 slices beefsteak tomato",
    "4 tablespoons blue cheese salad dressing"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush chicken breasts with wing sauce; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook chicken breasts on the preheated grill, basting with wing sauce, until no longer pink in the center, the juices run clear, and fully cooked. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle each hamburger bun with 1 tablespoon olive oil; grill until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange 1 lettuce leaf on each bottom bun; top each with 1 tomato slice, 1 chicken breast, 1 tablespoon blue cheese dressing, and top bun.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
