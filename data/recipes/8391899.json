  "ingredients": [
    "2 tablespoons apple cider vinegar",
    "2 teaspoons Dijon mustard",
    "1.5 teaspoons pure maple syrup",
    "0.25 teaspoon salt",
    "0.25 teaspoon freshly ground black pepper",
    "3 tablespoons extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "Whisk apple cider vinegar, Dijon mustard, maple syrup, salt, and pepper together in a small bowl. Add olive oil and whisk until incorporated.",
