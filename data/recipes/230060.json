  "ingredients": [
    "1 butternut squash, peeled and cut into 1-inch cubes",
    "2 tablespoons olive oil",
    "0.125 teaspoon ground thyme",
    "0.125 teaspoon ground black pepper",
    "salt to taste",
    "0.5 cup shredded Romano cheese (such as Locatelli®)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butternut squash, olive oil, thyme, black pepper, and salt in a large bowl until evenly coated. Spread mixture in a large baking dish in an even layer; cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes; remove foil and stir in half the Romano cheese. Sprinkle remaining cheese on top. Return to oven, uncovered, and continue to bake until tender and golden brown, about 20 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
