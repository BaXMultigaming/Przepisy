  "ingredients": [
    "1.5 cups water",
    "0.5 cup cider vinegar",
    "2 tablespoons oil",
    "1 (5 pound) boneless pork shoulder, trimmed",
    "0.25 cup packed brown sugar",
    "1 teaspoon seasoned salt",
    "1 teaspoon ground black pepper",
    "1 teaspoon ground cumin",
    "1 teaspoon cayenne pepper",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "0.5 teaspoon ground cinnamon",
    "1 (18 ounce) bottle barbeque sauce"
  ],
  "steps": [
    {
      "text": "Combine water and vinegar in a slow cooker set to Low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rub oil over entire pork shoulder and let rest for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix brown sugar, seasoned salt, black pepper, cumin, cayenne pepper, garlic powder, onion powder, and cinnamon together in a bowl; rub over entire pork shoulder. Place pork shoulder into the slow cooker. Cover and cook on Low for 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pork shoulder to a work surface and let rest for 10 minutes. Discard cooking liquid from the slow cooker. Place pork back into the slow cooker and shred. Stir in barbecue sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
