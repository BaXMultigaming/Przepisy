  "ingredients": [
    "5 ounces red grape tomatoes, halved",
    "0.25 teaspoon olive oil",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 240 degrees F (115 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tomatoes in a small bowl. Add olive oil and salt. Stir until evenly combined. Transfer tomato halves to the air fryer basket, skin-side down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry for 45 minutes. Using a spatula, smash tomato halves and air fry for an additional 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer tomatoes to a paper towel-lined plate and let sit for 1 hour. Repeat with remaining tomatoes you are needing to use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
