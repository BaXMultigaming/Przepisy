  "title": "My-Hop Pancakes",
  "description": "These delicious pancakes are said to resemble those from a famous pancake house. The batter rests in the refrigerator for 30 minutes, making the cakes extra fluffy.",
  "authors": [
    "drewface"
  ],
  "date_published": "2020-06-18T23:42:26-04:00",
