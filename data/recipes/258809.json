  "ingredients": [
    "2 large zucchini, ends trimmed",
    "2 tablespoons extra virgin olive oil, divided",
    "12 cherry tomatoes, halved",
    "2 cloves garlic, minced",
    "1 teaspoon kosher salt",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon freshly ground black pepper",
    "4 cups baby spinach",
    "0.5 cooked chicken breast, chopped",
    "0.5 cup frozen peas",
    "2 lemons, juiced",
    "1 lemon, zested"
  ],
  "steps": [
    {
      "text": "Cut zucchini into noodles using a spiralizer; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 tablespoon olive oil in a large skillet over medium heat. Add tomatoes; cook until starting to brown, 6 to 7 minutes. Add garlic; cook and stir for 30 seconds. Add zucchini noodles; season with salt, Italian seasoning, and black pepper. Stir to distribute. Add spinach, chicken, peas, lemon juice, and lemon zest; drizzle with remaining 1 tablespoon olive oil. Cover; simmer until heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
