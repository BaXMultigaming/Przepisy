  "ingredients": [
    "1 (9 inch) store-bought pie crust, unbaked",
    "3 tablespoons bourbon whiskey",
    "0.75 teaspoon instant coffee granules",
    "0.75 cup chopped pecans",
    "0.75 cup white sugar",
    "3 eggs",
    "0.75 cup white corn syrup",
    "6 tablespoons butter, melted",
    "1.5 teaspoons vanilla extract",
    "0.75 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press pie crust into a 9-inch pie plate; prick bottom with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust looks dry, 4 to 5 minutes. Cool. Reduce the oven temperature to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat whiskey in a small saucepan over very low heat; stir in instant coffee until dissolved. Stir in pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and eggs together in a large bowl until well blended; beat in corn syrup, butter, and vanilla extract. Fold in bourbon-pecan mixture and chocolate chips; pour filling into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is firm and golden, and crust is light brown, 40 to 45 minutes. Cool completely before slicing, at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
