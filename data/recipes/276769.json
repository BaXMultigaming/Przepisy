  "ingredients": [
    "cooking spray",
    "0.5 cup white sugar",
    "3 tablespoons butter, softened",
    "0.75 cup all-purpose flour",
    "0.33333334326744 cup finely chopped almonds",
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup white sugar",
    "1 egg",
    "0.75 teaspoon almond extract",
    "1 (15 ounce) can pears, drained and thinly sliced",
    "1 tablespoon white sugar",
    "0.75 teaspoon ground cardamom",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Coat a 9-inch fluted tart pan with a removable bottom with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a small bowl until crumbly. Beat in flour and almonds. Press over the bottom and up the sides of the prepared tart pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese in another small bowl until smooth. Beat in sugar, egg, and vanilla extract. Spread over the crust. Arrange pear slices over the cream cheese layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, cardamom, and cinnamon in a small bowl. Sprinkle over the pears.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Reduce oven temperature to 350 degrees F (175 degrees C). Continue baking until filling is set and an instant-read thermometer inserted into the center reads 160 degrees F (71 degrees C), 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool tart on a wire rack for 1 hour. Refrigerate for at least 2 hours before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
