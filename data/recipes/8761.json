  "ingredients": [
    "0.5 cup butter",
    "0.25 cup olive oil",
    "1 teaspoon dried parsley",
    "1 teaspoon dried basil",
    "0.25 teaspoon dried oregano",
    "3 cloves garlic, minced",
    "0.75 teaspoon salt",
    "1 tablespoon lemon juice",
    "4 boneless chicken breast halves, sliced lengthwise into thirds"
  ],
  "steps": [
    {
      "text": "In a large skillet, heat the butter and oil over medium high until the butter melts. Add the parsley, basil, oregano and garlic and salt and mix together in the skillet. Stir in lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Then add the chicken and saute for about 3 minutes or until white. Lower the heat and cook for about 10 to 15 minutes or until chicken is cooked through and the juices run clear. More butter can be added if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
