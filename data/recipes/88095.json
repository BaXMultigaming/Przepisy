  "ingredients": [
    "2 tablespoons vegetable oil",
    "1 onion, chopped",
    "1 teaspoon minced garlic",
    "1 teaspoon chili powder",
    "1 tablespoon ground cumin",
    "1 cup uncooked short-grain white rice",
    "1.75 cups chicken broth",
    "0.25 cup tomato paste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oil in a large skillet over medium heat. Add the onion and garlic; cook and stir until onion is translucent. Stir in the chili powder and cumin, and cook for about 30 seconds. Add the rice, chicken broth and tomato paste, and bring to a boil. Transfer to a 1 quart casserole dish, and cover with aluminum foil or a lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 to 40 minutes, or until liquid has been absorbed and rice is tender. Let rest for 3 to 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
