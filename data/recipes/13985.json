  ],
  "steps": [
    {
      "text": "In a large pot of salted water boil pasta until al dente. Drain well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small saucepan heat oil slightly, add garlic. Saute garlic until it is lightly browned. Be careful not to burn garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pasta and garlic, salt and pepper to taste. Top with Parmesan or Romano cheese and serve.",
