  "ingredients": [
    "1 tablespoon olive oil",
    "2 cups chopped onion",
    "2 cups chopped carrot",
    "2 cups finely chopped celery",
    "1.5 teaspoons minced garlic",
    "1 cup yellow split peas",
    "1 cup green split peas",
    "8 cups fat-free chicken broth",
    "1.5 teaspoons salt-free seasoning blend (such as Mrs. Dash®)",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YYHkn8EIQwYfGPbFJbuZon_6p0Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23860-best-ever-split-pea-soup-DDMFS-008-step-01-bab72d376e9f4d378944ecb443189b8c.jpg"
      ],
      "image": "assets/images/23860/step_01.webp"
    },
    {
      "text": "Heat oil in a Dutch oven over medium heat. Add onion, carrot, celery, and garlic; cook and stir until onion is translucent, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uODBoGvAo8q3a1TnbmqIidTwOAQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23860-best-ever-split-pea-soup-DDMFS-014-step-02-1254cac709e44f7c93c3d6e3037dbf75.jpg"
      ],
      "image": "assets/images/23860/step_02.webp"
    },
    {
      "text": "Stir in broth, split peas, and seasoning blend; cover and bring to a boil. Reduce heat to low and simmer, stirring frequently, until split peas are tender, about 2 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XIpDajNU4T6Q5V7UTHeik4RvP18=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23860-best-ever-split-pea-soup-DDMFS-016-step-03-076c483804dd49d694d4fc8267283f62.jpg"
      ],
      "image": "assets/images/23860/step_03.webp"
    },
    {
      "text": "Puree the soup with an immersion blender and serve.",
      "section": null,
