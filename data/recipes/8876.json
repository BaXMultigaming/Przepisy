  "title": "Mozzarella Chicken",
  "description": "Breaded and baked chicken oozes with a delectable mozzarella filling tinged with garlic.",
  "authors": [
    "Amber Lazier"
  ],
  "date_published": "1999-07-23T11:54:27-04:00",
