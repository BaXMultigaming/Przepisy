  "ingredients": [
    "1 cup white whole wheat flour, sifted",
    "1 cup rolled oats",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "2 (4 ounce) jars sweet potatoes baby food",
    "0.66666668653488 cup vegetable oil",
    "0.5 cup honey",
    "1 (4 ounce) jar carrot baby food",
    "2 eggs",
    "2 tablespoons brown sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 12 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, oats, baking soda, and cinnamon together in a bowl. Mix sweet potatoes, oil, honey, carrots, eggs, and brown sugar together in a separate bowl; stir into flour mixture until batter is just combined. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
