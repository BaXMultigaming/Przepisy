  "ingredients": [
    "cooking spray",
    "1 (10 ounce) package frozen chopped spinach, thawed and drained",
    "2 (4 ounce) cartons liquid egg whites",
    "6 ounces shredded reduced-fat sharp Cheddar cheese, or more to taste",
    "1 teaspoon hot sauce",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat 10 muffin cups with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine spinach, egg whites, Cheddar cheese, hot sauce, salt, and black pepper in a bowl. Ladle mixture into the prepared muffin cups, filling each cup ¾ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into centers of muffins comes out clean, 20 to 25 minutes. Serve warm or cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
