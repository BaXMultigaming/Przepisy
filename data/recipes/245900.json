  "ingredients": [
    "2 eggs, separated",
    "1.75 cups warm milk",
    "0.33333334326744 cup butter, melted",
    "2 tablespoons honey",
    "1.25 cups cornmeal",
    "1 cup all-purpose flour",
    "4 teaspoons baking powder",
    "2 teaspoons salt",
    "0.5 cup corn",
    "2 green chile peppers, seeded and minced, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat waffle iron according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a large bowl until fluffy. Fold in milk, butter, and honey. Add cornmeal, flour, baking powder, and salt, stirring slowly until batter is smooth. Fold in corn and green chile peppers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop some batter onto waffle iron; cook until golden brown and crisp or until waffle iron stops steaming, 3 to 4 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
