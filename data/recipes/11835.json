  "ingredients": [
    "8 ounces Udon noodles",
    "0.5 cup chicken broth",
    "3 tablespoons soy sauce",
    "3 tablespoons peanut butter",
    "1.5 tablespoons minced fresh ginger root",
    "1.5 tablespoons honey",
    "3 cloves garlic, minced",
    "2 teaspoons hot chile paste",
    "0.25 cup chopped green onions",
    "0.25 cup chopped peanuts"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook udon in boiling water, stirring occasionally, until noodles are tender yet firm to the bite, 10 to 12 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine chicken broth, soy sauce, peanut butter, ginger, honey, garlic, and chili paste in a medium saucepan. Cook and stir over medium heat until peanut butter melts and sauce is heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add drained noodles to peanut butter sauce; toss to coat. Garnish with green onions and peanuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
