  "ingredients": [
    "cooking spray",
    "0.5 pound paneer, cubed",
    "2 tablespoons canola oil, divided",
    "1 teaspoon cumin seeds",
    "1.5 cups water",
    "1 (10 ounce) package fresh spinach",
    "1 large tomato, diced",
    "3 cloves garlic",
    "2 dried red chile peppers, or to taste",
    "1 tablespoon chopped fresh ginger root",
    "1 teaspoon curry powder",
    "1 teaspoon ground coriander",
    "1 teaspoon ground turmeric",
    "1 pinch salt to taste"
  ],
  "steps": [
    {
      "text": "Heat a skillet coated with cooking spray over medium heat; fry paneer cubes until lightly browned on each side, about 5 minutes. Transfer paneer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 1 tablespoon canola oil in the same skillet used to cook paneer over medium heat. Add cumin seeds and cook until seeds are slightly red. Stir water, spinach, tomato, garlic, chile peppers, ginger, curry powder, ground coriander, and ground turmeric into cumin seeds. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring spinach mixture to a boil and simmer until garlic is very soft, 15 to 20 minutes. Remove from heat and allow mixture to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer spinach mixture to a blender or food processor; puree until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining 1 tablespoon canola oil in a saucepan over medium heat; add spinach puree and paneer cubes. Simmer until hot, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
