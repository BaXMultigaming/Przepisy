  "title": "Palak Paneer (Indian Spinach and Paneer)",
  "description": "Cubes of paneer simmer in a smooth spinach puree, fragrant with cumin seeds, ground coriander, ground turmeric, and curry powder.",
  "authors": [
    "International Recipes"
  ],
  "date_published": "2010-01-25T15:10:29-05:00",
