  "ingredients": [
    "6 large eggs",
    "0.33333334326744 cup mayonnaise",
    "2 tablespoons sweet India pickle relish",
    "2 teaspoons yellow mustard",
    "1 teaspoon white sugar",
    "1 teaspoon lemon juice",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "3 dashes hot sauce (such as Tabasco®)"
  ],
  "steps": [
    {
      "text": "Cover eggs with water in a saucepan, bring to a low boil, let boil slowly for 5 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer eggs to ice water to chill for 5 minutes; peel. Grate eggs into a medium mixing bowl and add mayonnaise, relish, mustard, sugar, lemon juice, salt, pepper, and hot sauce. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill in the refrigerator for at least 30 minutes.",
      "section": null,
      "name": null,
