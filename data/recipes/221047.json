  "ingredients": [
    "3 extra large eggs",
    "2 tablespoons corn oil",
    "1 tablespoon bourbon whiskey",
    "1 teaspoon vanilla extract",
    "0.75 cup all-purpose flour",
    "0.75 cup white sugar",
    "0.75 cup packed light brown sugar",
    "1.125 cups butter, softened",
    "1.5 cups chopped toasted pecans",
    "9 ounces semisweet chocolate chips",
    "1 (9 inch) unbaked pie crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large mixing bowl with an electric mixer on high speed until eggs are foamy, about 3 minutes; beat corn oil, bourbon whiskey, and vanilla extract into the eggs until just incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat flour, white sugar, and light brown sugar into egg mixture until smoothly blended, then beat in butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently stir pecans and chocolate chips into the filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fit the pie crust into a 9-inch pie dish and pour the filling into the crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until top is golden brown and a knife inserted halfway between the center and edge of the filling comes out clean, 55 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool the pie on a wire rack for at least 15 minutes before serving. Serve warm or at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
