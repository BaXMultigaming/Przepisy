  "ingredients": [
    "1 head red cabbage, cored and sliced as thinly as possible",
    "0.75 cup red wine vinegar",
    "5 tablespoons white sugar",
    "2 tablespoons balsamic vinegar",
    "1 tablespoon salt",
    "1.5 teaspoons onion powder",
    "1 teaspoon seasoned salt (such as LAWRY'S®)",
    "0.5 teaspoon ground black pepper",
    "0.5 cup olive oil"
  ],
  "steps": [
    {
      "text": "Put sliced cabbage into a large sealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk red wine vinegar, sugar, balsamic vinegar, salt, onion powder, seasoned salt, and black pepper together in a bowl; pour into bag with the cabbage. Massage the bag to ensure cabbage is completely coated with liquid. Squeeze as much air from the bag as possible and seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Marinate cabbage in refrigerator, massaging the bag several times a day, until the cabbage is softened and the marinade is deep purple in color, at least 2 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour olive oil into the bag and mix with the cabbage mixture. Seal bag and refrigerate 1 hour more before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
