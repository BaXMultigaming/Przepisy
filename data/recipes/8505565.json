  "ingredients": [
    "0.75 cup extra-virgin olive oil",
    "0.5 cup red wine vinegar",
    "2 tablespoons lemon juice",
    "1 clove garlic, minced",
    "0.5 teaspoon dry mustard",
    "0.5 teaspoon dried minced onion",
    "0.25 teaspoon freshly ground black pepper",
    "0.25 teaspoon salt",
    "0.25 teaspoon smoked paprika",
    "pinch of turmeric (optional)"
  ],
  "steps": [
    {
      "text": "Pour olive oil, red wine vinegar, and lemon juice into a sealable glass jar. Add garlic. Season with dry mustard, dried onion, pepper, salt, paprika, and turmeric. Shake until well combined. Keep refrigerated until ready to use.",
