  "ingredients": [
    "2 tablespoons butter, divided",
    "1 pound fresh asparagus, cut into 2-inch pieces",
    "2 cups sliced fresh mushrooms",
    "1 small onion, sliced",
    "0.5 pound medium raw shrimp, peeled and deveined",
    "0.5 pound raw scallops",
    "2 cloves garlic, minced",
    "1 tablespoon dried parsley",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "3 tablespoons lemon juice"
  ],
  "steps": [
    {
      "text": "Melt 1 tablespoon butter in a large skillet over medium heat. Add asparagus, mushrooms, and onion; stir-fry until tender yet still firm to the bite, about 5 minutes. Transfer to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt remaining butter in the same skillet. Stir-fry shrimp and scallops until almost opaque, about 2 minutes. Stir in garlic, parsley, salt, and pepper; cook for 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return cooked vegetables to the skillet; stir in lemon juice. Cook and stir until heated through, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
