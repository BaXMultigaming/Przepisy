  "ingredients": [
    "2 cups chopped fresh spinach",
    "1 sweet onion, chopped",
    "4 eggs",
    "2 cups milk",
    "1 cup baking mix (such as Bisquick ®)",
    "1 cup chopped ham",
    "2 cups shredded Cheddar cheese",
    "1 tomato, thickly sliced"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 325 degrees F (165 degrees C). Coat the bottom of a 9x13 inch pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine spinach and onion in the bowl of a food processor. Process to finely chop. Add eggs, milk, and baking mix; process to mix. Pour mixture into prepared pan. Sprinkle ham and cheese over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 35 to 45 minutes. Quiche is done when toothpick inserted in the center comes out clean. Garnish with tomato slices to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
