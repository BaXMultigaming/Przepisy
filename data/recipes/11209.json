  "ingredients": [
    "0.5 cup butter",
    "1.5 cups graham cracker crumbs",
    "7 ounces flaked coconut",
    "14 ounces sweetened condensed milk",
    "12 ounces semisweet chocolate chips",
    "0.5 cup creamy peanut butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In one 13x9 inch baking dish, melt the butter. Sprinkle the graham cracker crumbs over the melted butter . Top with the coconut, then the sweetened condensed milk and bake for 25 minutes or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a saucepan over low heat melt the chocolate chips and peanut butter together. Stir until creamy and pour over the baked bars. Let cool thoroughly then cut into bars. Garnish with more flaked coconut. Store bars in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
