  "ingredients": [
    "0.5 cup olive oil",
    "2 tablespoons Cajun seasoning",
    "2 tablespoons lemon juice",
    "2 tablespoons chopped fresh parsley",
    "1 tablespoon honey",
    "1 tablespoon soy sauce",
    "1 pinch cayenne pepper",
    "1 pound uncooked shrimp, peeled and deveined",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Whisk olive oil, Cajun seasoning, lemon juice, parsley, honey, soy sauce, and cayenne pepper together in a large glass or ceramic bowl. Add shrimp; toss to evenly coat. Cover the bowl with plastic wrap; marinate in the refrigerator for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Coat a baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer shrimp to the prepared baking dish; pour any remaining marinade over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until shrimp are bright pink on the outside and insides are opaque, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
