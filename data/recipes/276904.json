  "title": "Gemelli Pasta with Roasted Pumpkin and Pancetta",
  "description": "Roasted pumpkin, savory pancetta, and Parmesan cheese give this easy pasta dish way more flavor than you'd expect on a weeknight.",
  "authors": [
    "Kim's Cooking Now"
  ],
  "date_published": "2019-11-02T03:24:39-04:00",
