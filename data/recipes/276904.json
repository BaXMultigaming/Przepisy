  "ingredients": [
    "2 cups peeled, cubed pumpkin",
    "2 tablespoons extra-virgin olive oil, divided",
    "1 teaspoon fresh thyme",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "0.5 (16 ounce) package gemelli pasta",
    "1 (4 ounce) package diced pancetta",
    "1 cup chicken broth",
    "0.25 cup grated Parmigiano-Reggiano cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pile diced pumpkin on the baking sheet. Drizzle with 1 tablespoon olive oil and toss lightly to coat. Spread pumpkin out and sprinkle with thyme, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Remove and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of unsalted water to a boil. Add gemelli pasta and boil until just nearly tender, about 9 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining olive oil in a large pan over medium heat. Add pancetta and cook until starting to brown, 4 to 5 minutes. Add the roasted pumpkin and cook, stirring frequently, 2 to 3 minutes more. Pour in chicken broth and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta and add to the pan with the pumpkin mixture. Continue cooking until pasta is tender yet firm to the bite, 1 to 2 minutes more. Serve immediately, topped with Parmigiano-Reggiano cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
