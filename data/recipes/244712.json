  "ingredients": [
    "0.25 cup soy sauce",
    "0.25 cup miso paste",
    "0.25 cup lemon juice",
    "0.25 cup rice wine vinegar",
    "1.5 tablespoons grated garlic",
    "1.5 tablespoons grated fresh ginger",
    "1.5 tablespoons red chile paste",
    "2 tablespoons honey",
    "2 tablespoons sesame oil",
    "0.25 cup olive oil"
  ],
  "steps": [
    {
      "text": "Place soy sauce, miso paste, lemon juice, rice wine vinegar, garlic, ginger, and red chile paste in a food processor or blender; begin processing on low speed. Keeping the processor running, slowly stream honey into the food processor until smooth. Slowly stream sesame oil into mixture until evenly combined. Slowly stream olive oil into the food processor until dressing is smooth.",
