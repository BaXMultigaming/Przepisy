  "ingredients": [
    "2 tablespoons chili powder",
    "1 teaspoon salt",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon dried thyme",
    "0.25 teaspoon ground black pepper",
    "2 (1 pound) pork tenderloins"
  ],
  "steps": [
    {
      "text": "In a small bowl, mix together chili powder, salt, ginger, thyme, and black pepper. Rub spice mix into pork tenderloins. Place meat in a baking dish, cover, and refrigerator for 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill to medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush oil onto grill grate, and arrange meat on grill. Cook for 30 minutes, or to desired doneness, turning to cook evenly.",
