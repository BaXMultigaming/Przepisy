  "ingredients": [
    "6 tablespoons butter",
    "2 (6 ounce) containers fresh raspberries",
    "6 egg yolks, beaten",
    "0.75 cup white sugar",
    "2 tablespoons lemon juice",
    "0.25 teaspoon lemon zest",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium-low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add raspberries, egg yolks, sugar, lemon juice, zest, and salt. Cook, stirring constantly, until curd coats the back of a spoon and is slightly thickened, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain curd through a fine mesh sieve, mashing raspberries with the back of a spoon.",
