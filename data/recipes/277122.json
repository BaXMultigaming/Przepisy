  "ingredients": [
    "0.5 (16 ounce) package rotini pasta",
    "1 teaspoon salt",
    "1 teaspoon olive oil",
    "0.5 red bell pepper, diced",
    "0.5 green bell pepper, diced",
    "1 cup diced smoked Gouda cheese",
    "0.5 cup chopped fresh parsley",
    "0.33333334326744 cup lemon balsamic vinegar",
    "0.66666668653488 cup soybean oil",
    "1 teaspoon chopped fresh dill",
    "0.5 teaspoon garlic salt"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil; add rotini, salt, and olive oil. Cook rotini at a boil until tender yet firm to the bite, about 8 minutes. Drain pasta, rinse with cold water, and transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add red bell pepper, green bell pepper, Gouda cheese, and parsley to rotini.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour balsamic vinegar in a small bowl. Add soybean oil in a small stream, whisking constantly until mixture emulsifies. Mix in dill and garlic salt. Slowly drizzle just enough of the vinaigrette over the pasta mixture until the pasta glistens. You may not need all of the vinaigrette, so store any leftovers for another use.",
      "section": null,
