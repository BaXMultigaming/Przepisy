  "ingredients": [
    "18 fresh Scotch Bonnet peppers, sliced and seeded",
    "6 fresh jalapeno peppers, sliced",
    "0.5 cup minced onion",
    "6 cloves garlic, crushed",
    "1 teaspoon vegetable oil",
    "0.75 teaspoon salt",
    "2 cups water",
    "0.25 cup distilled white vinegar",
    "2 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TAb7U0WOv6jY1UYodci4V4XiqiA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/152262-ScotchBonnetHotSauce-ddmfs-Step1-3x4-7756-926870fb6eeb4a458d37d194c1d880dc.jpg"
      ],
      "image": "assets/images/152262/step_01.webp"
    },
    {
      "text": "Cook peppers, onion, garlic, oil, and salt in a large saucepan over medium-high heat, stirring frequently, 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kOjLQ7ANi6drLBZd557ByMV0nS4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/152262-ScotchBonnetHotSauce-ddmfs-Step2-3x4-7762-8353314262ea4f3abf291677507999bc.jpg"
      ],
      "image": "assets/images/152262/step_02.webp"
    },
    {
      "text": "Pour in water; cook and stir until peppers are soft, about 20 minutes. Cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/edhX1wUi7x3v1HLuPpopqQNdGrU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/152262-ScotchBonnetHotSauce-ddmfs-Step3-3x4-7768-0b194262d07740d1b86269b4e45c82e0.jpg"
      ],
      "image": "assets/images/152262/step_03.webp"
    },
    {
      "text": "Transfer mixture to a blender and purée until smooth. Pour in vinegar and sugar; blend until mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OUQOPwBfAQcb8vZSCb1CjlZzUd0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/152262-ScotchBonnetHotSauce-ddmfs-Step4-3x4-7812-fe50624ee56d41718a7cdfad5e1ac0a9.jpg"
      ],
      "image": "assets/images/152262/step_04.webp"
    },
    {
      "text": "Transfer to a container. Cover and store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CiRU6oNtqg38B6CSQchODKsS9K0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/152262-ScotchBonnetHotSauce-ddmfs-3x4-7842-394ec3254475475494c0fa82ac7a674b.jpg"
