  "ingredients": [
    "1 cup orzo pasta",
    "0.25 cup butter",
    "2 teaspoons minced garlic",
    "0.25 cup Parmesan cheese",
    "2 tablespoons milk",
    "1 tablespoon chopped fresh parsley",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
