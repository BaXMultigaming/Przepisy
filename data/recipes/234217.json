  "title": "Pineapple and Pecan Cake",
  "description": "Sweet pineapple cake gets an extra crunch thanks to the toasted pecans in the batter. Frost with homemade cream cheese icing!",
  "authors": [
    "Hellokitty_50512"
  ],
  "date_published": "2020-06-18T23:56:02-04:00",
