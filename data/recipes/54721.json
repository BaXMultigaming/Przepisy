  "ingredients": [
    "2 medium delicata squash, halved and seeded",
    "2 tablespoons honey",
    "1 tablespoon dark brown sugar",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon allspice"
  ],
  "steps": [
    {
      "text": "Place squash in a large saucepan with enough water to cover. Bring to a boil, and cook 10 minutes or until tender. Drain, and cool slightly. When cool enough, remove the skin.",
