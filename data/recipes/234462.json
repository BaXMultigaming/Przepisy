  "ingredients": [
    "cooking spray",
    "1 pound ground beef",
    "0.5 cup chopped onion",
    "0.5 cup rolled oats",
    "1 cup shredded Cheddar cheese",
    "0.75 cup milk",
    "1 egg",
    "1 teaspoon salt",
    "0.66666668653488 cup ketchup",
    "0.5 cup brown sugar",
    "1.5 teaspoons dry mustard"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ground beef, onion, oats, Cheddar cheese, milk, egg, and salt together in a bowl; mix well. Divide meat mixture into 8 equal portions and form each into a loaf shape. Place loaves in prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ketchup, brown sugar, and mustard together in a bowl until smooth. Spread ketchup mixture over meat loaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, about 40 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
