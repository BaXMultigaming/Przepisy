  "ingredients": [
    "2 red bell pepper, cut into strips",
    "2 red onions, cut into strips",
    "1 tablespoon olive oil",
    "1 teaspoon butter",
    "0.25 cup red wine",
    "1 pinch salt",
    "1 pinch ground black pepper",
    "1 pinch dried basil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/81VC_Com-YGbvekyfEY2VxF3IYQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18258-CaramelizedRedBellPeppersandOnions-ddmfs-4x3-gw-step-01-0199-adbb6016af0d4fc180e075aef2ab2e7f.jpg"
      ],
      "image": "assets/images/18258/step_01.webp"
    },
    {
      "text": "Combine bell pepper, onions, oil, and butter in a hot saucepan over medium heat; sauté for 2 minutes. Reduce heat to medium-low and continue cooking, stirring occasionally, until onions and peppers soften.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S6MKeqLfupMTHAbPoUAy6TJ528s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/18258-CaramelizedRedBellPeppersandOnions-ddmfs-4x3-gw-step-03-0209-d42801eb323d444a91b7afc1bf86b0a2.jpg"
      ],
      "image": "assets/images/18258/step_02.webp"
    },
    {
      "text": "Stir red wine into vegetables and cook until wine evaporates, 15 to 25 minutes. Season with salt, pepper, and basil. Serve warm.",
