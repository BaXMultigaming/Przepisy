  "title": "Fudgy Chocolate Crackle Cookies",
  "description": "These fudgy chocolate crackle cookies are studded with white chocolate chips and rolled in sugar for extra sweetness.",
  "authors": [
    "Kristen Moreland"
  ],
  "date_published": "2017-12-15T20:18:37-05:00",
