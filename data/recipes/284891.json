  "ingredients": [
    "1 cup white sugar",
    "2 large eggs",
    "3 tablespoons vegetable oil",
    "1 teaspoon vanilla extract",
    "0.25 cup margarine, melted",
    "1 cup all-purpose flour",
    "9 tablespoons unsweetened cocoa powder",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "1 cup white chocolate chips",
    "3 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Mix 1 cup sugar, eggs, oil, and vanilla together in a large bowl until well blended. Stir in melted margarine. Stir in flour, cocoa, baking powder, and salt. Mix until well blended. Stir in white chocolate chips. Mix until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and chill until dough is firm enough to shape into balls, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1 1/2-inch balls. Roll balls in remaining 3 tablespoons sugar. Place 2 inches apart on ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crackled on top and slightly firm to the touch, about 20 minutes. Cool on the baking sheet for 1 minute before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
