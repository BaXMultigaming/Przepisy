  "ingredients": [
    "1.5 cups mayonnaise",
    "0.25 cup apple cider vinegar",
    "1 tablespoon coarse-ground black pepper",
    "1 tablespoon spicy brown mustard",
    "2 teaspoons prepared horseradish",
    "1 clove garlic, minced",
    "1 teaspoon white sugar",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Combine mayonnaise, cider vinegar, black pepper, brown mustard, horseradish, garlic, sugar, and salt in a bowl. Cover bowl; refrigerate 24 to 36 hours.",
