  "ingredients": [
    "cooking spray",
    "5 large eggs",
    "3 tablespoons all-purpose flour",
    "3 tablespoons white sugar",
    "2 tablespoons sour cream",
    "0.5 teaspoon salt",
    "1 cup fresh blueberries",
    "1 tablespoon confectioners' sugar, or as needed"
  ],
  "steps": [
    {
      "text": "Spray a 1-quart microwave-safe casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs by hand in a bowl until slightly frothy; add flour, sugar, sour cream, and salt. Beat until all ingredients are fully incorporated. Pour batter into prepared casserole dish; sprinkle blueberries over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on high, turning dish around every minute, until center is set, 4 to 5 minutes. Divide onto plates and sprinkle with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
