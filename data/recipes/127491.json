  "title": "Easy Oreo Truffles",
  "description": "These delicious Oreo truffles are bite-sized chocolaty treats easily made with 3 simple ingredients: Oreo cookies, cream cheese, and melted chocolate.",
  "authors": [
    "Baker's"
  ],
  "date_published": "2013-03-13T02:05:08-04:00",
