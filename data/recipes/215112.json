  "ingredients": [
    "4 cups apricot halves",
    "0.25 cup white sugar",
    "0.75 cup brown sugar",
    "0.5 cup all-purpose flour",
    "0.5 cup butter",
    "0.75 cup rolled oats"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange apricots in a 9x12-inch baking dish and sprinkle with white sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together brown sugar and flour in a bowl; cut in butter with a pastry cutter until mixture resembles coarse crumbs. Lightly stir in rolled oats and spoon mixture over apricots.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fruit is soft and topping is browned and crisp, 35 to 40 minutes.",
