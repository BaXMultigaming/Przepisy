  "ingredients": [
    "0.25 cup bacon drippings",
    "4 bunches collard greens, tough stems removed",
    "salt to taste",
    "3 cups water, or more as needed"
  ],
  "steps": [
    {
      "text": "Heat bacon drippings in a cast iron skillet over medium heat. Cook and stir greens in hot drippings until limp, tender, and significantly reduced in size, 1 to 4 minutes, depending on how tough the greens are. Season with salt and serve straight from the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "If you prefer extra-tender greens, add 3 cups water to greens in the skillet; season with salt. Bring to a boil and cook for 1 hour, adding more water as needed.",
      "section": null,
      "name": null,
