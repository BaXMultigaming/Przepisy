  "title": "Herb, Garlic and Bacon Pork Loin",
  "description": "This roasted pork loin with bacon, garlic, herbs, and sweet pearl onions is tender, flavorsome, and super satisfying.",
  "authors": [
    "Wanda A Skinner"
  ],
  "date_published": "2019-04-02T02:47:56-04:00",
