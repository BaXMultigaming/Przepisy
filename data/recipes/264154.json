  "ingredients": [
    "1 avocado, mashed",
    "0.75 cup white sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "1.75 cups all-purpose flour",
    "0.66666668653488 tablespoon baking soda",
    "0.5 teaspoon salt",
    "3 cups quick-cooking oats",
    "1 cup chocolate chips",
    "0.5 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat avocado and sugar together in a large bowl using an electric mixer until creamy and mostly smooth. Beat in eggs 1 at a time. Stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, and salt in a separate bowl. Stir into the avocado mixture until well blended. Mix in oats until combined. Fold in chocolate chips and raisins. Spoon cookie-sized portions of dough onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cookies in the preheated oven until edges are golden, about 12 minutes. Allow cookies to cool on baking sheet for 5 minutes before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
