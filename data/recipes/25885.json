  "ingredients": [
    "3.5 pounds lamb ribs",
    "2 onions, chopped",
    "1 cup dry white wine",
    "0.25 cup soy sauce",
    "0.25 cup fresh lemon juice",
    "1 tablespoon honey",
    "1 tablespoon olive oil",
    "2 teaspoons minced garlic",
    "1 teaspoon ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Place lamb ribs in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onions, white wine, soy sauce, lemon juice, honey, olive oil, garlic, cinnamon, salt, and pepper in a medium bowl. Mix well, then pour mixture all over lamb. Cover the dish with plastic wrap and marinate in the refrigerator for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the plastic wrap and roast lamb in the preheated oven until browned and tender, about 1 hour 10 minutes. An instant-read thermometer inserted into the center should read 130 degrees F (55 degrees C) for medium doneness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
