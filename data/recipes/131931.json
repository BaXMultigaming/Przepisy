  "ingredients": [
    "2 tablespoons vegetable oil",
    "1 (3 pound) beef chuck roast",
    "4 cups water, or as needed",
    "4 stalks celery, chopped",
    "4 cloves garlic, crushed",
    "1 red onion, chopped",
    "1 tablespoon dried basil",
    "salt and pepper to taste",
    "6 turnips, peeled and cut into chunks",
    "6 medium red potatoes, quartered",
    "6 carrots, peeled and cut into chunks"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot or Dutch oven over medium-high heat; add roast and quickly brown on all sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MAPd_SGIQIqyj4uWdJpa4al4fvg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/131931-stove-top-pot-roast-ddmfs-step1-186-d2d889cb0be146849238c1316c23e64d.jpg"
      ],
      "image": "assets/images/131931/step_01.webp"
    },
    {
      "text": "Add enough water to the pot to cover roast; add celery, garlic, onion, basil, salt, and pepper. Bring to a boil; reduce heat to low and simmer for 2 hours and 15 minutes, adding additional water if needed to keep the roast covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uCWiKECdXiIAAWWfXQWD-PWXgaU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/131931-stove-top-pot-roast-ddmfs-step3-195-2f5cfe3dd2884079bb910d3645e51e73.jpg"
      ],
      "image": "assets/images/131931/step_02.webp"
    },
    {
      "text": "Add turnips and potatoes; simmer for an additional 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/omZe1iuxZiyuzv2VUc9quLyRFAg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/131931-stove-top-pot-roast-ddmfs-step4-258-1-bc0d907a174f4285ac94eb63be06b97c.jpg"
      ],
      "image": "assets/images/131931/step_03.webp"
    },
    {
      "text": "Add carrots; simmer for 30 minutes, or until roast can be pulled apart with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jr5yycUSfLh-YcwE1KVzJ3i3Jy4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/131931-stove-top-pot-roast-ddmfs-step5-261-09d4a68209784d539e1f9cd3df827e36.jpg"
      ],
      "image": "assets/images/131931/step_04.webp"
    },
    {
      "text": "Season to taste with salt and pepper if needed before serving.",
      "section": null,
      "name": null,
