  "ingredients": [
    "1 cup part-skim ricotta",
    "2 tablespoons unsweetened cocoa powder",
    "1.5 tablespoons honey, or to taste",
    "0.5 teaspoon almond extract",
    "2 tablespoons miniature semisweet chocolate chips",
    "0.25 cup sliced almonds",
    "1 (7.2 ounce) package Original Snack Factory® Pretzel Crisps®"
  ],
  "steps": [
    {
      "text": "Combine ricotta, cocoa powder, honey, and almond extract in a bowl. Mix with electric hand mixer or whisk until thoroughly blended, about 2 minutes. Transfer mixture to a serving bowl. Top with mini chocolate chips and almonds.",
