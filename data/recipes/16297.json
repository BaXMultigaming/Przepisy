  "ingredients": [
    "2 cups all-purpose flour",
    "0.25 teaspoon salt",
    "0.25 teaspoon baking powder",
    "4 egg yolks"
  ],
  "steps": [
    {
      "text": "Sift together the flour, salt and baking powder. Add egg yolks and mix until dry ingredients are moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press into a ball and cut in quarters. Roll out on floured surface 1/8 to 1/4 inch thick; cut to desired width and length. Lay on linen dish towel or wooden dowel to dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add to broth such as chicken or turkey and cook until done.",
