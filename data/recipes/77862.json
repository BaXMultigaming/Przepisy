  "ingredients": [
    "1 egg",
    "3 egg yolks",
    "1.5 cups whole milk",
    "0.66666668653488 cup sugar",
    "0.75 cup canned pumpkin puree",
    "1 teaspoon vanilla extract",
    "0.125 teaspoon salt",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "3.5 cups white bread cubes",
    "0.375 cup miniature chocolate chips",
    "2 tablespoons brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease 6 large custard cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together the egg and egg yolks in a large bowl. Add the milk, sugar, pumpkin puree, vanilla extract, salt, cinnamon, nutmeg, and cloves; whisk into a smooth batter. Add the bread cubes and toss gently to dampen. Set aside for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the batter evenly into the prepared cups. Sprinkle chocolate chips and brown sugar over each portion. Arrange the custard cups in a shallow baking pan. Pour hot water into the baking pan to halfway up the sides of the custard cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until pudding is golden brown and puffy, about 40 minutes; transfer to cooling rack for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
