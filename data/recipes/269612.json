  "ingredients": [
    "cooking spray",
    "4 flounder fillets",
    "salt and ground black pepper to taste",
    "0.25 cup butter, melted",
    "3 tablespoons white wine",
    "3 tablespoons seasoned bread crumbs",
    "1 pinch paprika, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a baking sheet with aluminum foil and coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Rinse flounder fillets, pat dry, and place on the baking sheet. Season with salt and pepper. Whisk butter and wine together in a bowl; pour over flounder. Sprinkle each fillet with bread crumbs and then paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until flounder flakes easily with a fork, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
