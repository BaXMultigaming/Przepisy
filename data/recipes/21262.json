  "ingredients": [
    "1 pound crabmeat",
    "0.5 cup mayonnaise",
    "1 tablespoon fresh lemon juice",
    "1 teaspoon Worcestershire sauce",
    "0.5 teaspoon Old Bay Seasoning TM",
    "0.5 teaspoon salt",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon dry mustard",
    "1 egg, beaten",
    "0.25 cup fresh bread crumbs",
    "1 teaspoon paprika",
    "3 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine crab meat, mayonnaise, lemon juice, Worcestershire sauce, Old Bay Seasoning, salt, cayenne pepper, dry mustard, and beaten egg.. Mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In an 8\" pie dish, spread mixture and lightly coat the entire dish with bread crumbs. Then sprinkle the top with paprika. Dot the dish with the butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in a preheated oven for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
