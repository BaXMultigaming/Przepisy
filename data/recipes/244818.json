  "ingredients": [
    "0.5 cup rolled oats",
    "1 tablespoon unsweetened cocoa powder",
    "1 tablespoon ground flax seed",
    "1.5 teaspoons maple syrup",
    "0.25 teaspoon vanilla extract",
    "1 pinch salt",
    "1.5 teaspoons honey",
    "1 teaspoon coconut oil",
    "2 tablespoons crushed pecans",
    "1 tablespoon unsweetened flaked coconut"
  ],
  "steps": [
    {
      "text": "Combine oats, cocoa powder, flax seed, maple syrup, vanilla extract, and salt in a saucepan over medium heat; cook and stir until thick, 10 to 15 minutes. Transfer oatmeal to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine honey and coconut oil in a microwave-safe bowl; heat in microwave until melted, about 20 seconds. Pour honey mixture over oatmeal and top with pecans and coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
