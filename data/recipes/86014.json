  "ingredients": [
    "6 ounces Cinnamon Graham Crackers",
    "5 Mission® Soft Taco Size Flour Tortillas",
    "0.5 cup Butter, melted",
    "1 (10 ounce) jar Chocolate sauce",
    "1.5 cups Miniature Marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Using a food processor, process the graham crackers into fine crumbs. Cut each tortilla into 8 equal size wedges. Dip wedges into melted butter and then into cracker crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread out tortillas onto a baking sheet and bake for 5 minutes. Turn chips over and bake for another 5 minutes or until golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pile chips onto an oven safe platter, drizzle with chocolate sauce and sprinkle with marshmallows.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "(Optional) Return platter to the oven until marshmallows are lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
