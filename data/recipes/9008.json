  "ingredients": [
    "6 skinless, boneless chicken breasts",
    "salt and pepper to taste",
    "6 slices Swiss cheese",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "0.5 cup sherry",
    "0.25 cup sour cream",
    "1 cup croutons",
    "0.5 cup butter, melted",
    "0.125 teaspoon dried dill weed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken in a 9x13 inch baking dish and season with salt and pepper to taste. Cover each chicken breast with a slice of cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl mix together the soup, sherry and sour cream, and pour mixture over chicken. Soften dill in melted butter; toss croutons in butter, and sprinkle them on top of chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes, or until chicken is cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
