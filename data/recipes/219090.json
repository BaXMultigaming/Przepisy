  "ingredients": [
    "0.5 cup unsalted butter",
    "0.5 cup all-purpose flour",
    "1 quart cold chicken stock, or more if needed",
    "0.33333334326744 cup heavy cream",
    "salt and ground white pepper to taste",
    "1 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium-low heat. Gradually whisk in flour, reduce heat to low, and stir until the roux has turned golden and smells like a cooked pie crust, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/e0nWmD9qVv4tJTqa0lDlSeiiSdw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219090_HomemadeChickeyGravy-mfs-Step-2-f00c0d445fda4d7caabe1d8c4299f797.jpg"
      ],
      "image": "assets/images/219090/step_01.webp"
    },
    {
      "text": "Whisk in about 2 cups of cold stock, a little at a time, stirring to remove any lumps. Add remaining 2 cups stock.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pzxBfKbtG-JiPowOpEfzhfvvd0I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219090_HomemadeChickeyGravy-mfs-Step-3-71220b3e65b44e16a114bbeb76556ef8.jpg"
      ],
      "image": "assets/images/219090/step_02.webp"
    },
    {
      "text": "Cook, stirring occasionally, until gravy is thick enough to coat the back of a spoon, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qv0klGLpSTJMjaCnnDuYphF4Kr0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219090_HomemadeChickeyGravy-mfs-Step-4-afe48026dcc64c6f88b73ef53df4071f.jpg"
      ],
      "image": "assets/images/219090/step_03.webp"
    },
    {
      "text": "Stir in heavy cream, and season with salt, white pepper, and cayenne. Taste and if the gravy still tastes starchy, let it simmer a little longer, adding more cold stock if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2I8bDZn-xW87F3m_shma836aoMo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219090-homemade-chicken-gravy-Ramona-Cruz-Peters-Horizonta-4x3-384f61e0469b479f82ad7487e80a680a.jpg"
      ],
      "image": "assets/images/219090/step_05.webp"
    }
