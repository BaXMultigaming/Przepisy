  "ingredients": [
    "2 cups milk",
    "1 cup confectioners' sugar",
    "1 tablespoon vanilla extract",
    "0.25 cup unsweetened cocoa powder",
    "1 teaspoon powdered instant coffee",
    "1 gallon clean fresh snow"
  ],
  "steps": [
    {
      "text": "In a bowl, whisk together milk, confectioners' sugar, vanilla extract, cocoa powder, and instant coffee until the sugar has dissolved and the mixture is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place snow in a large bowl, and pour the chocolate mixture over the snow. With a large spoon, stir until the ingredients are thoroughly combined. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
