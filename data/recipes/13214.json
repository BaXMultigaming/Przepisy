  "ingredients": [
    "1 pound Italian sausage",
    "2 onions, chopped",
    "1 cup chopped celery",
    "1 cup chopped carrots",
    "6 cups chicken broth",
    "1 (28 ounce) can whole peeled tomatoes with juice",
    "1.5 cups shredded cabbage",
    "2 teaspoons dried basil",
    "2 cups bow tie pasta",
    "0.5 teaspoon garlic salt"
  ],
  "steps": [
    {
      "text": "Cook and stir sausage in a soup pot over medium heat until crumbly and no longer pink.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onions, celery, and carrots. Cook, stirring occasionally, until onions are soft, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add broth, tomatoes, cabbage, and basil; bring to a boil. Stir in pasta; cover and simmer until pasta is tender, about 10 minutes. Season with garlic salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
