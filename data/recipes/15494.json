  "ingredients": [
    "1.5 cups all-purpose flour",
    "1.5 teaspoons baking soda",
    "0.33333298563957 cup unsweetened cocoa powder",
    "0.75 cup creamy salad dressing",
    "1 cup white sugar",
    "1 cup warm water",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 12 muffin cups or use paper liners. Sift all-purpose flour, baking soda and cocoa together and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip salad dressing, white sugar, water, and vanilla together until mixed thoroughly. Add flour mixture slowly and beat at medium speed of an electric mixer for 2 minutes. Divide batter into prepared muffin pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 15 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
