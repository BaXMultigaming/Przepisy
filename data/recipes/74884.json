  "ingredients": [
    "0.5 cup vegetable oil",
    "0.25 cup white sugar",
    "0.25 cup white vinegar",
    "0.5 teaspoon salt",
    "1 teaspoon salt-free herb and spice blend",
    "0.25 teaspoon ground black pepper",
    "1.5 heads iceberg lettuce, torn into bite-sized pieces",
    "1 pound chopped cooked chicken breast meat",
    "1 (5 ounce) can chow mein noodles",
    "1 (2.25 ounce) package blanched slivered almonds",
    "0.25 cup sesame seeds, lightly toasted",
    "4 green onions, chopped",
    "2 teaspoons poppy seeds"
  ],
  "steps": [
    {
      "text": "In small bowl, whisk together the oil, sugar, vinegar, salt, seasoning blend, and pepper. Set aside.",
