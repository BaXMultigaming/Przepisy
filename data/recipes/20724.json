      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p-nnnnY0-PaoWEPt_cq_MEsr1HI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20724-grilled-corn-on-the-cob-ddmfs-4x3-step2-0019-0c9ad674be044355ac93fdbbbd744e67.jpg"
      ],
      "image": "assets/images/20724/step_03.webp"
    },
    {
      "text": "Wrap each ear of corn tightly in aluminum foil.",
