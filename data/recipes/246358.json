  "ingredients": [
    "1 (2.85 lb) package Johnsonville® Original Bratwurst Party Pack",
    "1 aluminum foil baking pan (11x9x2 3/8-inch)",
    "2 (12 ounce) cans beer, or as needed",
    "1 large yellow or white onion, sliced",
    "2 tablespoons butter",
    "12 bratwurst buns"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-low heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook brats, covered, on preheated grill, turning often, until browned and an instant-read thermometer inserted into centers reads 160 degrees F (70 degrees C). Transfer brats to foil baking pan. Increase grill heat to medium.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place foil pan on grill; add beer, onions, and butter. Cover grill; simmer brats. Serve brats and onions on buns.",
      "section": null,
      "name": null,
      "url": null,
