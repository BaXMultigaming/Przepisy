  "ingredients": [
    "6 large eggs, divided",
    "2 tablespoons milk",
    "4 thick slices bread",
    "1 (5 ounce) package Jones Dairy Farm All Natural Golden Brown® Chicken Sausage Patties",
    "1 tablespoon olive oil",
    "1 clove garlic, minced",
    "0.5 red bell pepper, thinly sliced",
    "0.5 green bell pepper, thinly sliced",
    "0.5 small red onion, thinly sliced",
    "2 slices provolone cheese",
    "Salt and pepper, to taste"
  ],
  "steps": [
    {
      "text": "In medium bowl, whisk together 2 eggs and milk; dip bread into egg mixture until fully coated. Cook French toast on griddle or large skillet over medium heat until golden brown on both sides.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sausage patties according to package instructions. Cut into strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In separate skillet, heat olive oil over medium heat. Add garlic, peppers and onions and saute until browned and tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked sausage strips to pepper and onion mixture; top with cheese and heat until cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook remaining eggs over easy, or as desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Assemble cheesesteaks by layering french toast with eggs, and pepper, sausage and cheese mixture. Season with salt & pepper and serve open-faced.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
