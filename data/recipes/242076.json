  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup brown sugar",
    "0.75 cup rolled oats",
    "0.5 cup melted butter",
    "2 eggs",
    "0.33333334326744 cup milk",
    "2 cups diced rhubarb",
    "2 cups diced strawberries",
    "1 cup white sugar",
    "0.25 cup all-purpose flour",
    "0.5 teaspoon ground allspice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir 1 cup flour, brown sugar, oats, and melted butter together in a medium bowl until well combined; press ½ to ¾ crust mixture into bottom of a 9-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and milk together in a large bowl until smooth; stir in rhubarb, strawberries, white sugar, ¼ cup flour, and allspice until sugar and flour dissolve completely. Pour filling over crust; sprinkle remaining crust mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until filling is set, 45 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
