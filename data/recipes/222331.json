  "title": "Chef John&#39;s Gazpacho",
  "description": "Gazpacho is an incredibly refreshing tomato and vegetable soup served cold for a delicious summer appetizer. Best made with fresh, super sweet tomatoes.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-05-09T19:49:30-04:00",
