  "ingredients": [
    "4 large fresh tomatoes, peeled and diced",
    "0.5 English cucumber, peeled and finely diced",
    "0.5 cup finely diced red bell pepper",
    "0.25 cup minced green onion",
    "1 large jalapeno pepper, seeded and minced",
    "2 cloves garlic, minced",
    "1 teaspoon salt",
    "0.5 teaspoon ground cumin",
    "1 pinch dried oregano",
    "1 pinch cayenne pepper, or to taste",
    "freshly ground black pepper to taste",
    "1 pint cherry tomatoes",
    "0.25 cup extra-virgin olive oil",
    "1 lime, juiced",
    "1 tablespoon balsamic vinegar",
    "1 teaspoon Worcestershire sauce",
    "salt and ground black pepper to taste",
    "2 tablespoons thinly sliced fresh basil"
  ],
  "steps": [
    {
      "text": "Combine diced tomatoes, cucumber, bell pepper, green onion, jalapeño, and garlic in a large bowl. Stir in salt, cumin, oregano, cayenne pepper, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pfzxGUSDJvCwirGDtmNaA2kdwVk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222331-Chef-Johns-Gazpacho-Step1a-4x3-2740-bbc8846f538f412e9f74a87932d121af.jpg"
      ],
      "image": "assets/images/222331/step_01.webp"
    },
    {
      "text": "Place cherry tomatoes, olive oil, lime juice, balsamic vinegar, and Worcestershire sauce in a blender. Cover and purée until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wN3uBp0PTH5C1-48nr_hkBl7gmA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222331-Chef-Johns-Gazpacho-Step3a-4x3-2751-e77bef3b83634b849b8e6752580d3a27.jpg"
      ],
      "image": "assets/images/222331/step_02.webp"
    },
    {
      "text": "Pour puréed mixture through a strainer into the tomato-cucumber mixture; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7QMKBlO05qog9-vNVfp1oUg9bPg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222331-Chef-Johns-Gazpacho-Step4-4x3-2754-5099630ec02c47bf916cda78e5468c47.jpg"
      ],
      "image": "assets/images/222331/step_03.webp"
    },
    {
      "text": "Place 1/3 of the tomato mixture into the blender. Cover, turn blender on, and purée until smooth. Return puréed mixture to the remaining tomato-cucumber mixture. Stir to combine. Cover and chill in the refrigerator for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W6ZunP-oKCv_zgoICfuAcZ4I1uU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222331-Chef-Johns-Gazpacho-Step6-4x3-2760-7eccb88ceda34bb6af1ecdc3ffb0f836.jpg"
      ],
      "image": "assets/images/222331/step_04.webp"
    },
    {
      "text": "Season cold soup with salt and black pepper to taste. Ladle into bowls and top with basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/d_1S6Av48F5LBfP-Z4W8VTD9U4I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222331-Chef-Johns-Gazpacho-ddmfs-4x3-2781-67624a59fa4c4375b9149d06f6c32348.jpg"
      ],
      "image": "assets/images/222331/step_05.webp"
    }
