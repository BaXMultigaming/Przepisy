  "ingredients": [
    "3 cups water",
    "1 cup fresh elderberries",
    "1 cinnamon stick",
    "3 whole cloves",
    "1 teaspoon minced fresh ginger root",
    "1 cup honey"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
