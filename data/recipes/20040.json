  "ingredients": [
    "1.5 pounds ground turkey",
    "1 large egg, lightly beaten",
    "1 (1 ounce) package dry onion soup mix",
    "1.5 tablespoons soy sauce",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon garlic powder",
    "6 hamburger buns, split"
  ],
  "steps": [
    {
      "text": "Mix turkey, egg, onion soup mix, soy sauce, pepper, and garlic powder in a large bowl until well combined; refrigerate mixture for about 10 minutes, then form into 6 equal-sized patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook turkey burgers on the preheated grill, turning once, until no longer pink in the center and the juices run clear, about 20 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Serve on buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
