  "ingredients": [
    "3 eggs",
    "2 cups white sugar",
    "3 tablespoons butter",
    "0.75 cup all-purpose flour",
    "2 cups milk",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a blender, combine eggs, sugar, and butter. Blend until smooth. Pour in flour and milk, a little at a time, blending until smooth again. Stir in vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into muffin tins, filling 3/4 full. Bake in the preheated oven, 45 minutes, until golden brown. Serve hot or cold.",
