  "ingredients": [
    "1 tablespoon olive oil",
    "2 cups chopped broccoli",
    "1 cup chopped onion",
    "2 cloves garlic, minced, or more to taste",
    "2 cups cubed cooked sweet potato",
    "2 cups fresh spinach",
    "6 slices cooked bacon, chopped",
    "10 large eggs",
    "1 cup half-and-half",
    "1 tablespoon chopped fresh sage",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "fresh sage leaves for garnish"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a 10-inch, oven-safe skillet over medium heat. Add broccoli and onion. Cook, stirring occasionally, until broccoli is tender and onion is just translucent, about 5 minutes. Add garlic; cook 30 seconds. Stir in sweet potato and spinach; cook until spinach wilts, about 1 minute. Stir in bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together eggs, half-and-half, chopped sage, salt, and pepper in a bowl. Pour mixture over vegetables in skillet. Gently mix to evenly distribute egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer the skillet to the preheated oven and bake until eggs are completely set but not overcooked, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let stand 5 minutes before serving. Garnish with sage leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
