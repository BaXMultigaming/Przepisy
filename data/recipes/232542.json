  "ingredients": [
    "2 cups whole wheat flour",
    "0.5 cup packed brown sugar",
    "1 tablespoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground nutmeg",
    "1 (15 ounce) can solid-pack pumpkin",
    "0.5 cup water",
    "0.5 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line 12 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk whole wheat flour, brown sugar, baking powder, cinnamon, baking soda, salt, and nutmeg in a large bowl. Stir pumpkin and water into dry ingredients, mixing until just moistened; fold in chocolate chips. Spoon batter into prepared muffin cups, filling them to just below the tops.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned and tops of muffins bounce back when pressed lightly, 25 to 30 minutes. Let muffins cool in pans for 5 minutes until removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
