  "ingredients": [
    "0.25 cup butter, softened",
    "1 cup white sugar",
    "1 cup chunky applesauce",
    "1.5 teaspoons ground cinnamon",
    "2 packets instant apple cinnamon oatmeal (single serving size)",
    "2 eggs",
    "1 teaspoon baking soda",
    "1.5 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease and flour a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together the butter and sugar until light and fluffy. Mix in applesauce, cinnamon and one packet oatmeal. Stir in the eggs one at a time, beating well with each addition. Mix in the baking soda and flour. Pour batter into prepared pan and sprinkle with remaining packet of oatmeal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 60 minutes, until a toothpick inserted into center of the loaf comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
