  "keywords": [],
  "ingredients": [
    "1 cup walnuts, chopped",
    "2 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup granulated sugar",
    "2 tablespoons lemon zest",
    "0.75 cup buttermilk",
    "2 eggs",
    "1 teaspoon pure vanilla extract",
    "2 tablespoons unsalted butter, melted",
    "2 tablespoons canola oil",
    "1 cup fresh or frozen blueberries",
    "3 tablespoons granulated sugar",
    "2 tablespoons fresh lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a dry skillet, toast walnuts over medium-high heat for 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine all-purpose flour, baking powder, baking soda and salt. Whisk to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine sugar, lemon zest, buttermilk, eggs, vanilla, melted butter and oil. Whisk just to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make a well in center of dry ingredients. Add liquid ingredients and mix gently just to combine; do not over-mix. Gently fold in walnuts and blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into a greased and floured 8 x 4-inch loaf pan. Bake in preheated oven for 55 to 60 minutes or until tester inserted in center comes out clean. Cool on rack for 20 minutes; remove from pan, cool to room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the glaze, combine sugar and lemon juice in a small saucepan. Bring to boil over high heat, then reduce heat and continue stirring until sugar dissolves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush glaze over bread while still warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
