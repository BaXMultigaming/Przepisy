  "title": "Blueberry Lemon Walnut Bread",
  "description": "The tartness of lemons complements the sweet subtle taste of walnuts in this quick bread recipe. The addition of blueberries offers a colorful antioxidant boost.",
  "authors": [
    "California Walnuts"
  ],
  "date_published": "2021-08-04T08:15:08-04:00",
