  "ingredients": [
    "1 cup unsulfured molasses",
    "1.5 cups white sugar",
    "1 cup melted butter",
    "2 eggs",
    "1 teaspoon ground ginger",
    "3 tablespoons cider vinegar",
    "3 teaspoons baking soda",
    "0.5 cup warm water",
    "6 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ingredients in order given, by hand (mixers ruin this recipe!). Mix in baking soda dissolved in water. Add the flour last.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly flour board, and add flour as needed to keep dough from being really sticky. Roll out thin and cut into any shapes you want.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 10 to 12 minutes.",
