  "ingredients": [
    "0.25 cup vegetable oil",
    "1 (1 ounce) package Ranch-style dressing mix",
    "0.5 teaspoon dried dill weed",
    "0.25 teaspoon lemon pepper",
    "0.25 teaspoon garlic powder",
    "5 cups oyster crackers"
  ],
  "steps": [
