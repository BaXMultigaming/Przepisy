  "ingredients": [
    "16 pieces frozen popcorn chicken",
    "15 ounces frozen mini waffles",
    "20 4- to 6-inch wooden skewers",
    "1 cup halved fresh strawberries",
    "0.25 cup fresh blueberries",
    "0.25 cup fresh raspberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 200 degrees F (93 degrees C). Preheat an air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange popcorn chicken in a single layer in the air fryer basket. Cook chicken for 7 minutes, then flip and cook until lightly browned and crispy, 2 to 3 minutes more. Transfer chicken pieces to a baking sheet; keep warm in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, arrange half the waffles in a single layer in the air fryer basket. Cook for 90 seconds; flip and continue to cook until light brown in spots and crispy, about 20 seconds more. Transfer to baking sheet. Repeat with remaining waffles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread 2 waffles and 2 pieces of chicken onto each of 8 skewers. Thread berries onto remaining 12 skewers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
