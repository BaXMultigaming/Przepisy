  "title": "Applesauce Walnut Bars",
  "description": "These cinnamon-accented bar cookies with chocolate and walnuts are very moist and chewy!",
  "authors": [
    "Marsha Dill"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
