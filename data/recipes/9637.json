  "ingredients": [
    "2 (1 ounce) squares unsweetened chocolate, chopped",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup shortening",
    "1.25 cups white sugar",
    "2 eggs",
    "0.5 cup applesauce",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 13x9 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate in the microwave or in a bowl over a pan of simmering water. Stir frequently until smooth. Remove from heat, and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream together the shortening and sugar until smooth. Beat in the eggs one at a time, stirring constantly until well blended. In a separate bowl, mix together applesauce, melted chocolate and vanilla. Add to the egg mixture, stirring until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the flour, baking powder, cinnamon and salt; gradually stir into the batter. Fold in chopped walnuts. Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 20 to 25 minutes in the preheated oven, or until a toothpick inserted in the middle of cake comes out clean. Let cool in pan before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
