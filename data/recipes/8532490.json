  "ingredients": [
    "1 (14.5 ounce) can black-eyed peas, rinsed and drained",
    "1 tablespoon olive oil",
    "1.5 teaspoons Cajun seasoning (such as Old Bay®)"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with paper towels; spread drained peas out in an even layer, discarding shells and mushed peas. Pat dry with additional paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 400 degrees Fahrenheit (200 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil and Cajun seasoning in a bowl. Stir in peas until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place peas in the basket of the air fryer. Cook for 7 minutes. Shake the basket and cook 7 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
