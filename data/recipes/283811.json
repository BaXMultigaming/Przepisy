  "ingredients": [
    "2 heads romaine lettuce, chopped",
    "4 medium tomatoes (such as Campari®), cut into wedges",
    "2 medium avocados - peeled, pitted, and cubed",
    "1 medium red onion, halved and thinly sliced",
    "0.5 (15.5 ounce) can black beans, rinsed and drained",
    "0.25 cup fresh lime juice",
    "1 teaspoon honey",
    "1 clove garlic, minced",
    "0.5 teaspoon ground cumin",
    "0.25 teaspoon salt",
    "freshly ground black pepper to taste",
    "0.5 cup extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "Combine romaine, tomatoes, avocados, onion, and black beans in a large bowl; toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk lime juice, honey, garlic, cumin, salt, and pepper together in a small bowl. While constantly whisking, stream in the olive oil until dressing is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle some of the dressing over the salad, toss, taste, and add more dressing if desired. If there's any extra dressing, refrigerate for later use.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
