  "ingredients": [
    "1 medium zucchini, halved and sliced",
    "0.25 cup diced red onion",
    "0.25 cup diced green bell pepper",
    "2 (4 ounce) cans sliced black olives, drained",
    "0.25 cup crumbled feta cheese",
    "2 tablespoons Greek vinaigrette salad dressing",
    "0.25 cup grape or cherry tomatoes, halved"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a large piece of aluminum foil with nonstick cooking spray. Layer the zucchini, onion, pepper, and olives onto the center. Sprinkle with feta cheese and drizzle with vinaigrette. Fold into a packet and seal the edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until vegetables are tender, about 30 minutes. Open the foil packet, turn the oven onto Broil, and broil until the feta lightly browns. Add the grape tomatoes and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
