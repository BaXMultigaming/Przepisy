  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup white sugar",
    "1.5 teaspoons baking powder",
    "0.5 cup milk",
    "0.25 cup butter, softened",
    "0.5 cup cold water",
    "0.25 cup packed brown sugar",
    "1 tablespoon cornstarch",
    "3 cups fresh peaches - peeled, pitted, and sliced",
    "1 cup fresh blueberries",
    "1 tablespoon butter",
    "1 tablespoon lemon juice",
    "2 tablespoons coarse granulated sugar",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C) with a baking sheet inside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, ½ cup white sugar, and baking powder in a medium bowl; stir in milk and ¼ cup butter until smooth. Set batter aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, brown sugar, and cornstarch in a medium saucepan; stir in peaches and blueberries. Cook and stir over medium heat until thick and bubbly; stir in 1 tablespoon butter and lemon juice until butter melts. Transfer peach mixture to a 1 ½-quart ungreased baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dollop batter in mounds over hot fruit mixture. Combine coarse sugar and nutmeg in a small bowl; sprinkle over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the baking dish on the baking sheet and bake in the preheated oven until bubbly and a toothpick inserted into biscuit topping comes out clean, about 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
