  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "1 cup Worcestershire sauce",
    "1 cup vegetable oil",
    "1 cup lemon juice",
    "1 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Place chicken in a single layer in a bowl or pan. Mix together Worcestershire sauce, oil, lemon juice, and garlic; pour over chicken. Cover. Refrigerate for at least 6 hours.",
