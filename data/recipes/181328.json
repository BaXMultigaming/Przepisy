  "title": "Baked Pumpkin, Sweet Potato, and Coconut Milk Soup",
  "description": "Pumpkin, acorn squash, and sweet potatoes are mashed together in this silky and satisfying soup.",
  "authors": [
    "SerenaBloom"
  ],
  "date_published": "2019-04-02T02:51:22-04:00",
