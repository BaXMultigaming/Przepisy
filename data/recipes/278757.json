  "ingredients": [
    "1 head cauliflower, chopped",
    "2 ounces fat-free cream cheese, softened",
    "0.25 cup fat-free milk",
    "0.25 cup grated Parmesan cheese",
    "0.25 cup shredded Cheddar cheese",
    "0.5 cup bread crumbs",
    "2 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add cauliflower, cover, and steam until fork-tender, 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, beat cream cheese and milk together in a bowl. Stir in Parmesan and Cheddar cheeses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs and melted butter together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer steamed cauliflower to a 2 1/2-quart casserole dish. Add cheese-milk mixture and stir. Sprinkle with bread crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
