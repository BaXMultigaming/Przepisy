  "ingredients": [
    "1 cup milk",
    "1 scoop vanilla ice cream",
    "1 ripe banana",
    "1 pinch ground cinnamon, or to taste",
    "2 tablespoons whipped cream, or more to taste",
    "1 tablespoon caramel topping"
  ],
  "steps": [
    {
      "text": "Combine milk, ice cream, banana, and cinnamon in a blender; blend on low speed until the mixture reaches the consistency of a thick milkshake. Pour milkshake into a cup and top with whipped cream and drizzled caramel.",
