  "ingredients": [
    "1 (14 ounce) package double-crust pie pastry, thawed",
    "4 cups sliced fresh strawberries",
    "3 cups chopped fresh rhubarb",
    "0.66666668653488 cup white sugar",
    "3 tablespoons all-purpose flour",
    "Crust:",
    "2 cups all-purpose flour",
    "2 cups packed brown sugar",
    "2 cups rolled oats",
    "1 stick unsalted butter, cubed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut each pie crust into a square and piece together to cover the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 12 minutes. Remove from the oven; leave oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix strawberries, rhubarb, sugar, and flour for filling together in a large bowl; pour into the crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, and oats for topping in another bowl. Add butter and cut in with a pastry blender until crumbly. Sprinkle over the filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake until crisp and lightly browned, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
