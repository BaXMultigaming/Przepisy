  "ingredients": [
    "1 cup mozzarella cheese, fresh",
    "3 tablespoons grated Parmesan-Reggiano cheese",
    "10 zucchini blossoms",
    "7 tablespoons rice flour",
    "2 eggs",
    "0.25 cup milk",
    "0.25 cup sparkling water",
    "2 tablespoons sweet rice flour",
    "salt and ground black pepper to taste",
    "1 cup oil for frying"
  ],
  "steps": [
    {
      "text": "Combine mozzarella cheese and Parmigiano-Reggiano cheese in a bowl until well mixed. Stuff each zucchini blossom with 1 tablespoon cheese mixture; pinch ends closed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk rice flour, eggs, milk, sparkling water, sweet rice flour, salt, and black pepper together in a bowl. Dip stuffed blossoms into rice flour mixture; toss gently until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a saucepan over medium heat. Lower blossoms carefully into the hot oil in batches. Fry until crisp and pale golden brown, about 2 minutes. Transfer to a paper towel-lined plate to drain. Repeat with remaining blossoms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
