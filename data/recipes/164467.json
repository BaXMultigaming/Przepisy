  "ingredients": [
    "2 tablespoons honey mustard",
    "1 tablespoon butter, melted",
    "1 tablespoon vegetable oil",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon brown sugar",
    "1 tablespoon garlic powder",
    "1 pound salmon fillet"
  ],
  "steps": [
    {
      "text": "Whisk honey mustard, melted butter, oil, Worcestershire sauce, brown sugar, and garlic powder together in a bowl until well combined. Reserve 2 tablespoons marinade for basting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon into a shallow baking dish and pour remaining marinade over top. Cover and refrigerate for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven's broiler and set the oven rack about 5 inches from the heat source.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil salmon in the preheated oven, brushing occasionally with the reserved 2 tablespoon marinade, until fish flakes easily with a fork and marinade has cooked into a glaze, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
