  "ingredients": [
    "3.5 tablespoons butter",
    "4 tablespoons golden syrup",
    "4 ounces semisweet chocolate, chopped",
    "2.75 cups cornflakes cereal"
  ],
  "steps": [
    {
      "text": "In a saucepan over low heat, combine the butter, golden syrup and chocolate. Cook and stir until butter and chocolate have melted and everything is well blended. Mix in the cornflakes cereal. Drop by heaping spoonfuls onto waxed paper or a buttered baking sheet. Place in the refrigerator until set, about 15 minutes.",
