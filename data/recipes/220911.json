  "ingredients": [
    "1 pound bacon",
    "5 cups chopped broccoli florets",
    "2 cups grapes",
    "1 cup diced celery",
    "1 cup diced jicama",
    "0.5 cup chopped green onions",
    "1 cup mayonnaise",
    "0.25 cup white sugar",
    "2 tablespoons vinegar",
    "0.5 teaspoon curry powder",
    "1 tablespoon pine nuts, or to taste"
  ],
  "steps": [
    {
      "text": "Cook bacon in a large, deep skillet over medium-high heat, turning occasionally, until crisp, about 10 minutes. Drain on a paper towel-lined plate; crumble.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss broccoli, grapes, celery, jicama, and green onions together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk mayonnaise, sugar, vinegar, and curry powder together in a bowl until dressing well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing over vegetables; toss to coat. Add crumbled bacon and pine nuts; toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
