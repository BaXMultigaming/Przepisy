  "ingredients": [
    "2.5 tablespoons butter",
    "0.5 cup chopped carrots",
    "0.5 cup chopped scallions",
    "1 clove garlic, minced",
    "6 cups chicken broth",
    "0.5 cup orzo",
    "1 (10 ounce) bag fresh spinach, chopped",
    "salt and ground black pepper to taste"
