  "ingredients": [
    "4 (4 ounce) salmon fillets, skin removed",
    "1 tablespoon lime or lemon juice",
    "0.5 cup panko (Japanese bread crumbs, available in the Asian food aisle), or substitute dry bread crumbs",
    "0.25 cup flaked sweetened coconut",
    "Salt and freshly ground pepper, to taste",
    "Cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place salmon fillets on a nonstick baking pan; brush juice on salmon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a shallow dish, combine panko, coconut, salt, and pepper. Dredge each salmon fillet in panko mixture and return to the baking pan. Spread leftover crumbs on top of each salmon fillet. Coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 12 to 15 minutes. If desired, put under broiler until crust is golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
