  "ingredients": [
    "0.25 cup milk chocolate chips",
    "1 (15 ounce) can chickpeas (garbanzo beans), drained and rinsed",
    "0.5 cup unsweetened cocoa powder",
    "2 tablespoons maple syrup, or to taste",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "2 tablespoons almond milk, or more as needed"
  ],
  "steps": [
    {
      "text": "Place chocolate chips in a microwave-safe bowl and heat in the microwave until melted, 1 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine melted chocolate, garbanzo beans, cocoa powder, maple syrup, vanilla extract, and salt in the bowl of a food processor. Add almond milk, 1 tablespoon at a time, while blending to desired smoothness.",
