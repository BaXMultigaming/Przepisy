  "ingredients": [
    "1 clove garlic",
    "0.25 cup olive oil",
    "0.25 cup grated Parmesan cheese",
    "0.125 stick butter, melted",
    "0.5 teaspoon salt",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon onion powder",
    "3.5 cups rosemary focaccia bread, cut into thumbnail-sized pieces"
  ],
  "steps": [
    {
      "text": "Crush garlic into a paste with a mortar and pestle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix crushed garlic, olive oil, Parmesan cheese, butter, salt, thyme, and onion powder together until relatively homogenous. Let sit for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bread cubes in a large bowl and spoon butter mixture on top. Toss well to make sure all cubes are coated. Cover and let sit until bread soaks up the mixture, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spread bread on a cookie sheet in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, flipping once halfway, until golden brown and firm to the touch, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
