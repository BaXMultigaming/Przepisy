  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place carrots into a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until slightly tender, about 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk butter, orange juice, brown sugar, white sugar, and cinnamon together in a large bowl until sugars are dissolved. Add carrots to the glaze mixture; toss to coat. Transfer carrots and glaze to a 1-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until carrots are tender, 15 to 20 minutes.",
