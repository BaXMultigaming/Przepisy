  "ingredients": [
    "1 cup long grain rice, rinsed",
    "2 quarts water",
    "1 cinnamon stick, broken into pieces",
    "1 teaspoon vanilla",
    "0.5 cup white sugar"
  ],
  "steps": [
    {
      "text": "In a large saucepan, combine rice, water and cinnamon stick. Set aside for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "After 3 hours, bring to a boil, reduce heat, and simmer for 30 minutes. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree rice mixture in a blender until smooth. Strain through cheesecloth or a fine sieve. Flavor with vanilla and sugar to taste. Chill, and serve over ice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
