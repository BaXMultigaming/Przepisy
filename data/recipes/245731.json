  "title": "Baked Stuffed Brie with Cranberries & Walnuts",
  "description": "Chef John's Brie with cranberries is wrapped in puff pastry dough, chilled, and then baked until perfectly browned and the cheese is warm and melty.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2015-12-17T15:22:22-05:00",
  "date_modified": "2026-05-01T16:00:31-04:00",
  "prep_time": "PT20M",
  "cook_time": "PT20M",
  "total_time": "PT100M",
