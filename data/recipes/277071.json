  "ingredients": [
    "2 tablespoons olive oil",
    "2 teaspoons salt",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon jalapeno chili powder",
    "0.25 teaspoon chili powder",
    "0.25 teaspoon ground coriander",
    "1 pound skirt steak, sliced into strips against the grain",
    "1 onion, sliced into strips",
    "1 bell pepper, seeded and sliced into strips"
  ],
  "steps": [
    {
      "text": "Combine olive oil, salt, garlic powder, cumin, jalapeño chile powder, chili powder, and coriander in a resealable plastic bag. Add steak, onion, and bell pepper, coat with the marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line an air fryer basket with a sheet of perforated parchment paper. Add marinated onion, pepper, and steak.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air fry for 5 minutes at 400 degrees F (200 degrees C). Remove the air fryer basket and shake to ensure even cooking. Air fry until steak is cooked through, about 4 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
