  "title": "Flourless Chocolate Cake",
  "description": "This decadent flourless chocolate cake is easy to make for a rich, fudgy, and naturally gluten-free dessert that's perfect for any special occasion.",
  "authors": [
    "Maggie"
  ],
  "date_published": "1999-02-03T21:40:43-05:00",
  "date_modified": "2026-02-05T11:57:21-05:00",
