  "ingredients": [
    "1.5 cups cashews, soaked overnight and drained",
    "1 orange bell pepper, roughly chopped",
    "1 cup So Delicious® Dairy Free Unsweetened Cashewmilk Beverage",
    "2 teaspoons chili powder",
    "0.25 cup nutritional yeast",
    "0.25 cup minced onion",
    "2 tablespoons taco seasoning mix",
    "2 (15 ounce) cans black beans, rinsed and drained",
    "1.5 cups fresh salsa",
    "Chopped fresh cilantro",
    "Sliced green onions"
  ],
  "steps": [
    {
      "text": "Place the cashews, orange bell pepper, Cashewmilk, chili powder, and nutritional yeast in a high-powered blender and puree, about 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan, heat the minced onion, taco seasoning, black beans and fresh salsa. Stir constantly until thoroughly heated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add in the cheese mixture and stir to combine. Season to taste with salt/pepper and garnish with cilantro and/or sliced green onions before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Enjoy with your favorite chips or raw vegetables!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
