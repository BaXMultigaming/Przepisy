  "ingredients": [
    "cooking spray",
    "1 pound lean (at least 80%) ground beef",
    "1 large onion, chopped",
    "1 cup milk",
    "0.5 cup Original Bisquick® mix",
    "2 large eggs",
    "0.5 teaspoon salt",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Spray 9-inch glass pie pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook beef and onion in a nonstick skillet over medium heat, stirring occasionally, until beef is browned and crumbly, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk milk, Bisquick, and eggs together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain beef and onion mixture; transfer to the prepared pie pan. Stir in salt, sprinkle with Cheddar, and pour Bisquick mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted in the center comes out clean, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
