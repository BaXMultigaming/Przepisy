  "ingredients": [
    "0.5 cup grapefruit juice",
    "3 tablespoons white sugar",
    "1 (750 milliliter) bottle dry rosé",
    "1 cup fresh raspberries",
    "0.5 cup fresh blackberries",
    "2 medium limes, sliced",
    "0.25 cup brandy",
    "1.5 cups club soda",
    "3 cups ice, or as needed",
    "8 sprigs fresh rosemary"
  ],
  "steps": [
    {
      "text": "Stir together grapefruit juice and sugar in a pitcher until sugar dissolves. Add wine, raspberries, blackberries, lime slices, and brandy.",
