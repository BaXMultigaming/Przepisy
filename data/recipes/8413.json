  "ingredients": [
    "1.5 cups cake flour",
    "1 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "0.33333334326744 cup shortening",
    "0.66666668653488 cup milk",
    "1 teaspoon vanilla extract",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C), grease and flour an 8x8 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, sugar, baking powder and salt into a large bowl. Add shortening and milk. Mix until smooth, then add vanilla and egg. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into an 8x8 inch pan. Bake at 350 degrees F (175 degrees C) for 30 to 35 minutes or until a toothpick inserted into the cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
