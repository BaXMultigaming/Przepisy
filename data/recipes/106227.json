  "ingredients": [
    "2 (1 1/2-pound) salmon fillets, skin removed",
    "1 cup miso paste",
    "0.5 cup brown sugar",
    "0.5 cup prepared soy-ginger salad dressing",
    "0.25 cup sake",
    "0.25 cup water",
    "3 tablespoons seasoned rice vinegar",
    "2 tablespoons sesame seeds",
    "1 teaspoon sesame oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large skillet with about 1 inch of water and bring to a boil. Poach fish just until cooked on the outside, about 2 minutes per side. Transfer fillets to a broiler pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together miso paste, brown sugar, salad dressing, sake, water, rice vinegar, sesame seeds, and sesame oil in a small bowl. Spread over the tops of the salmon fillets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until almost cooked through, about 15 minutes. Switch the oven to broil, and broil until the top is browned and bubbly, about 5 more minutes. Cut fillets into portions to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
