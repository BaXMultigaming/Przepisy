  "title": "Miso Salmon",
  "description": "A Japanese-style broiled miso salmon just like you'll find at a restaurant. This easy recipe is full of flavor. Serve with white rice and salad.",
  "authors": [
    "Kalyn"
  ],
  "date_published": "2020-03-05T00:00:12-05:00",
