  "ingredients": [
    "1.5 cups brown sugar",
    "2 eggs",
    "0.5 cup vegetable oil",
    "0.5 cup applesauce",
    "2 lemons, zested",
    "1 teaspoon vanilla extract",
    "1 teaspoon lemon extract",
    "1 cup all-purpose flour",
    "1 cup whole wheat flour",
    "1.25 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "3 cups peeled and grated zucchini",
    "3 tablespoons poppy seeds"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 18 muffin cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar and eggs in a large bowl. Beat on medium-high speed for 1 to 2 minutes. Beat in oil, applesauce, lemon zest, vanilla extract, and lemon extract until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine all-purpose flour, whole wheat flour, baking powder, baking soda, and salt in a separate bowl. Blend into the brown sugar mixture. Stir in zucchini and poppy seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the lined muffin cups. Fill any empty muffin cups with water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center come out clean, 17 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
