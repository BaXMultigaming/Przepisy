  "ingredients": [
    "1 cup beer",
    "1 cup all-purpose flour",
    "2 teaspoons salt",
    "0.5 teaspoon ground black pepper",
    "1 (12 ounce) package fresh green beans, trimmed",
    "1 cup ranch dressing",
    "2 teaspoons Sriracha sauce",
    "1 teaspoon prepared horseradish, or to taste"
  ],
  "steps": [
    {
      "text": "Mix beer, flour, salt, and pepper together in a bowl. Coat beans with batter in small batches and shake off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturers' instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line the bottom of the air fryer basket with parchment paper. Place battered beans into the prepared basket in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer until golden brown and crispy on the outside, 8 to 10 minutes. Repeat to cook remaining batches if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the beans are cooking, mix ranch dressing, Sriracha, and horseradish together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve green beans with dipping sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
