  "ingredients": [
    "1 cup water",
    "0.33333334326744 cup white sugar",
    "1 cup strong espresso coffee",
    "1 teaspoon vanilla extract",
    "1 cup whipped cream, or to taste"
  ],
  "steps": [
    {
      "text": "Bring water and sugar to a boil in a small saucepan; simmer until a candy thermometer reads 250 degrees F (120 degrees C), about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove saucepan from heat; add coffee and vanilla. Pour into a metal bowl and mix well. Cool granita mixture to room temperature, about 10 minutes. Freeze for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the granita vigorously to break up ice crystals. Repeat freezing and breaking up process 4 to 5 more times, 2 to 2 1/2 hours total.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of whipped cream into 4 short glasses. Divide granita mixture evenly among the glasses. Top with remaining whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
