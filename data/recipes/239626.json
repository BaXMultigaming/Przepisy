  "ingredients": [
    "2 (10.75 ounce) cans cream of chicken soup",
    "1 (8 ounce) package cream cheese",
    "0.75 cup milk",
    "2 pounds hash brown potatoes",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream of chicken soup, cream cheese, and milk together in a saucepan over medium heat and cook until the cheese is completely melted and the liquid is heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread hash brown potatoes into a casserole dish; pour soup mixture over the potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until the edges begin to brown, about 1 hour and 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle Cheddar cheese over the dish; let the cheese melt as the dish cools slightly before serving, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
