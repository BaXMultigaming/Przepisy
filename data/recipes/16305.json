  "ingredients": [
    "1 pound ground beef",
    "1 cup dry bread crumbs",
    "1 onion, chopped",
    "1 egg",
    "salt and pepper to taste",
    "1 cup brown sugar",
    "1 cup water",
    "0.5 cup ketchup",
    "0.5 cup cider vinegar",
    "2 tablespoons soy sauce",
    "2 tablespoons cornstarch"
  ],
  "steps": [
