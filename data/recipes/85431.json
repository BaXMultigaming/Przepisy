  "ingredients": [
    "8 medium red potatoes, with peel, shredded",
    "1 large sweet onion, minced",
    "3 eggs, lightly beaten",
    "3 tablespoons all-purpose flour",
    "0.5 teaspoon baking powder",
    "1 tablespoon dried rosemary",
    "1 tablespoon salt",
    "2 teaspoons ground black pepper",
    "1.5 teaspoons lime juice",
    "2 tablespoons vegetable oil"
  ],
  "steps": [
    {
      "text": "In a large bowl, mix the red potatoes, onion, eggs, flour, baking powder, rosemary, salt, pepper, and lime juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oil in a skillet over medium-high heat. Scoop about 2/3 cup at a time of the potato mixture into the skillet, and press down with a spatula into a pancake shape. Cook 3 to 4 minutes on each side, until crisp and golden brown. Drain on paper towels. Repeat with remaining potato mixture.",
