  "ingredients": [
    "nonstick cooking spray",
    "4 medium zucchini",
    "1 pound ground beef",
    "1 pound Italian sausage",
    "1 small onion, chopped",
    "0.5 cup dried bread crumbs",
    "1 egg, beaten",
    "1 (28 ounce) can crushed tomatoes",
    "1 (10.75 ounce) can condensed tomato soup",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees (175 degrees C). Coat a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut zucchini in half lengthwise; scoop out seeds with a large spoon. Chop and reserve about ¾ seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, sausage, onion, bread crumbs, egg, and chopped zucchini seeds in a bowl. Divide mixture among zucchini halves until piled up over tops; place zucchini in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine crushed tomatoes, tomato soup, and water in a bowl; liberally spoon over zucchini.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
