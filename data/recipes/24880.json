  "ingredients": [
    "2 bunches arugula - rinsed, dried and torn",
    "2 (11 ounce) cans mandarin orange segments, drained",
    "1 large red onion, thinly sliced",
    "1 pint cherry tomatoes",
    "2 yellow bell peppers, seeded and diced",
