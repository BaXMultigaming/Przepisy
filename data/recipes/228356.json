  "title": "Asopao de Pollo",
  "description": "This traditional Puerto Rican stew is rich with chicken thighs and flavorful green olives, adobo seasoning, garlic, cilantro, onions, and rice.",
  "authors": [
    "The Gruntled Gourmand"
  ],
  "date_published": "2016-06-04T09:56:13-04:00",
