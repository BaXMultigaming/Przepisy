  "ingredients": [
    "2 tablespoons olive oil",
    "1 shallot, diced",
    "1 cup pinot noir wine",
    "1 cup beef broth",
    "1 tablespoon butter",
    "1 tablespoon Italian seasoning",
    "1 pinch salt to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a small saucepan over medium heat. Cook shallot in hot oil until golden brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add wine into the saucepan; cook, stirring regularly, until reduced in volume by half, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in beef broth. Reduce heat to medium-low and cook at a simmer until slightly reduced, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter and Italian seasoning into the sauce; cook until butter is completely melted, 2 to 3 minutes. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
