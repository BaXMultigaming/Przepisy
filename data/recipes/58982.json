  "ingredients": [
    "1 cup water",
    "1.5 teaspoons sugar",
    "1 whole cardamom pod",
    "1 whole clove",
    "2 black peppercorns",
    "3 teaspoons black tea leaves",
    "0.5 cup warm milk"
  ],
  "steps": [
    {
      "text": "Combine the water and sugar in a small saucepan, and bring to a boil. Add the cardamom pod, clove, peppercorns and tea leaves. Remove from heat, and let the mixture steep for 2 to 3 minutes. Strain into a cup, and fill cup the rest of the way with milk. Sit back, relax, and enjoy!",
