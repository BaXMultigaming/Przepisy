  "ingredients": [
    "2 (12 ounce) packages bulk pork sausage",
    "1 medium bell pepper, chopped",
    "1 medium onion, chopped",
    "3 cups frozen hash brown potatoes",
    "2 cups shredded Cheddar cheese",
    "2 cups milk",
    "1 cup Original Bisquick® mix",
    "4 eggs",
    "0.25 teaspoon pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 400 degrees F (200 degrees C). Grease a 13 x 9 x 2-inch baking dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/060All5tnOVLSMQOyadLu6oyoyA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/179351-impossibly-easy-breakfast-bake-crowd-size-VAT-9662-step-01-b01be7c0bb0a4423ab30b72ce6e32a9f.jpg"
      ],
      "image": "assets/images/179351/step_01.webp"
    },
    {
      "text": "Cook sausage, bell pepper, and onion in a medium skillet over medium heat, stirring occasionally, until sausage is no longer pink; drain and transfer to the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4-fwnScd3_zD1OI5bZ7DBJ69Z5k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/179351-impossibly-easy-breakfast-bake-crowd-size-VAT-9663-step-02-c746cff3d8e94788b857e4e5ec018c64.jpg"
      ],
      "image": "assets/images/179351/step_02.webp"
    },
    {
      "text": "Stir in potatoes, and 1 1/2 cups cheese until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Pzh9izWEOkqgjXzTElFsUFjokJY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/179351-impossibly-easy-breakfast-bake-crowd-size-VAT-9667-step-03-9a26b158771843459ed1d26f8c4ef586.jpg"
      ],
      "image": "assets/images/179351/step_03.webp"
    },
    {
      "text": "Stir milk, Bisquick, eggs, and pepper together in a bowl until well combined. Pour into baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w6D4xaILIyZzZataNv41m-ZROGo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/179351-impossibly-easy-breakfast-bake-crowd-size-VAT-9672-step-04-fde2513067e048fa9690fd6b54c742dc.jpg"
      ],
      "image": "assets/images/179351/step_04.webp"
    },
    {
      "text": "Bake, uncovered, until a knife inserted in center comes out clean, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G0XhQFxfZWTEBawMx2oCV2je2AY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/179351-impossibly-easy-breakfast-bake-crowd-size-VAT-9674-step-05-6c6967465a42481592933888d6dadc66.jpg"
      ],
      "image": "assets/images/179351/step_05.webp"
    },
    {
      "text": "Sprinkle with remaining 1/2 cup cheese. Continue to bake until cheese melts, 1 to 2 minutes more. Cool 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kOyJvOohZmMXfltaqtpuOSGmvHY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/179351-impossibly-easy-breakfast-bake-crowd-size-VAT-9675-step-06-44b28caf1bba49b6a0fb014717b2866c.jpg"
      ],
