  "ingredients": [
    "3 Yukon Gold potatoes, cubed",
    "3 carrots, sliced",
    "2 onions, sliced",
    "2 cloves garlic, minced",
    "1 (2 pound) boneless pork shoulder roast, trimmed of excess fat and cut into 1-inch cubes",
    "1 cup beef stock",
    "0.75 cup tomato sauce",
    "2.5 tablespoons ground paprika",
    "2 tablespoons Worcestershire sauce",
    "2 tablespoons brown sugar",
    "1 tablespoon dried oregano",
    "0.5 teaspoon dry mustard",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 cup cold water",
    "3 tablespoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Place potatoes, carrots, onions, and garlic in a slow cooker. Place pork on top of vegetables.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beef stock, tomato sauce, paprika, Worcestershire sauce, brown sugar, oregano, mustard, salt, and pepper in a bowl; pour into the slow cooker. Stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until pork is fork tender, 6 to 7 hours. Skim off fat and move meat and vegetables to one side of the cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cold water and flour together in a small bowl and pour into the empty space in the slow cooker. Stir to redistribute ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on High until sauce has thickened, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
