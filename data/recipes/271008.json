  "ingredients": [
    "0.5 cup butter",
    "0.33333334326744 cup white sugar",
    "0.33333334326744 cup brown sugar",
    "1 egg",
    "0.5 teaspoon salt",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon vanilla extract",
    "1.25 cups all-purpose flour",
    "0.5 cup rolled oats",
    "1 cup jelly beans, cut in half"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease 2 cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, white sugar, and brown sugar together in a bowl using an electric mixer until creamy; beat in egg, salt, baking soda, baking powder, and vanilla extract. Stir in flour and oats until just blended; fold in jelly beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop rounded spoonfuls dough about 2 inches apart onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 9 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
