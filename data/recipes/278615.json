  "ingredients": [
    "3 large eggs, divided",
    "2.5 cups cooked rice",
    "0.66666668653488 cup grated Parmesan cheese",
    "0.33333334326744 cup butter, melted",
    "1/2 teaspoon Highlands Italian cheese sprinkle (optional)",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "2 ounces fresh mozzarella cheese, cubed",
    "1 cup panko bread crumbs",
    "0.5 teaspoon Italian seasoning",
    "1 pinch salt",
    "1 pinch ground black pepper",
    "nonstick cooking spray"
  ],
  "steps": [
    {
      "text": "Beat 2 eggs lightly in a large bowl. Stir in rice, Parmesan cheese, butter, cheese sprinkle, 1/2 teaspoon salt, and 1/4 teaspoon pepper; mix to combine. Cover and refrigerate the mixture for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 370 degrees F (187 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll mixture into 1 1/2-inch balls. Press a mozzarella cube into the center of each ball and reshape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs, Italian seasoning, salt, and pepper in a shallow dish. Beat remaining egg lightly in a second bowl. Dip each rice ball first into egg, then roll in the bread crumb mixture. Place rice balls in air fryer basket and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 6 minutes. Increase temperature to 400 degrees F (200 degrees C) and air fry for 3 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
