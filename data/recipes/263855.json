  "ingredients": [
    "1 tablespoon olive oil",
    "0.5 onion, chopped",
    "2 carrots, sliced",
    "1 green bell pepper, cubed",
    "1 red bell pepper, cubed",
    "1 fennel bulb, thinly sliced",
    "2 teaspoons dried Italian herb mix, or to taste",
