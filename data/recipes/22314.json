  "ingredients": [
    "2 cups canned black beans, divided",
    "0.5 cup water",
    "2 cloves garlic, minced",
    "1 teaspoon pepper",
    "1 teaspoon salt",
    "1 teaspoon liquid smoke flavoring",
    "0.75 cup diced onion"
  ],
  "steps": [
    {
      "text": "Mash 2/3 cup beans in a small bowl to a smooth paste; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place remaining beans and water in a medium saucepan over medium heat. Cook at a simmer until heated through. Stir in garlic, pepper, salt, and liquid smoke.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir bean paste into whole beans until well combined. Add onion and simmer until onion is slightly cooked, about 10 minutes.",
      "section": null,
