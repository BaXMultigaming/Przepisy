  "ingredients": [
    "1 (12 ounce) package linguine pasta",
    "0.25 cup olive oil",
    "1 clove garlic, minced",
    "3 (8 ounce) cans minced clams, with juice",
    "0.75 cup chopped parsley",
    "2 tablespoons white wine",
    "1 teaspoon dried basil",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook linguine at a boil until tender yet firm to the bite, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat olive oil in a large skillet over medium heat. Add garlic; cook and stir until fragrant, about 1 minute. Stir in liquid from clams, parsley, white wine, basil, and salt; simmer for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in clams until heated through. Add cooked linguine pasta; toss to combine and serve warm.",
      "section": null,
      "name": null,
      "url": null,
