  "ingredients": [
    "0.5 cup heavy cream",
    "2 large egg yolks, beaten",
    "0.25 cup butter or margarine",
    "2 tablespoons dry sherry or madeira",
    "0.5 teaspoon salt",
    "1 pinch cayenne pepper",
    "1 pinch ground nutmeg",
    "0.75 pound cooked lobster meat, broken into chunks"
  ],
  "steps": [
    {
      "text": "Whisk cream and egg yolks together in a small bowl until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over low heat. Stir in cream mixture and sherry; cook, stirring constantly, until mixture thickens, 5 to 8 minutes; do not boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the heat and season with salt, cayenne, and nutmeg. Stir in lobster.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the stove and cook gently over low heat until heated through, about 5 minutes. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
