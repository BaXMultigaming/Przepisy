  "title": "Marietta's Butterscotch Bourbon Biscotti",
  "description": "This biscotti recipe includes bourbon, butterscotch, and pecans to yield a delicious caramel-like flavor that is not too sweet.",
  "authors": [
    "Marietta Higgins-Spillone"
  ],
  "date_published": "2020-06-19T00:04:16-04:00",
