  "ingredients": [
    "8 ounces dry fettuccine pasta",
    "1 (5 ounce) can tuna, drained",
    "1 (15 ounce) can peas, drained",
    "0.5 (16 ounce) jar Alfredo-style pasta sauce",
    "1 teaspoon garlic powder",
    "1 teaspoon dried oregano",
    "1 teaspoon dried basil"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook for 8 to 10 minutes or until al dente; drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan over medium heat, combine tuna, peas, Alfredo sauce, garlic powder, oregano, and basil; mix well. Cook until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cooked pasta to sauce; mix well. Adjust seasoning as needed; serve.",
