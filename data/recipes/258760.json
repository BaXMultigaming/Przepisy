  "ingredients": [
    "3 eggs, separated",
    "1 (4 ounce) bar dark chocolate, chopped",
    "0.5 cup white sugar",
    "2 tablespoons white sugar",
    "0.5 cup butter",
    "1 tablespoon butter",
    "1 cup ground walnuts",
    "0.33333334326744 cup all-purpose flour",
    "1 tablespoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease and flour a 9-inch round cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a glass, metal, or ceramic bowl until stiff peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg yolks lightly in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat chocolate in top of a double boiler over simmering water, stirring frequently and scraping down the sides, until melted, about 5 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup plus 2 tablespoons sugar and 1/2 cup plus 1 tablespoon butter in a large bowl; beat with an electric mixer until creamy. Stir in egg yolks, melted chocolate, walnuts, flour, and baking powder until smooth. Fold egg whites gently into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes. Let cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
