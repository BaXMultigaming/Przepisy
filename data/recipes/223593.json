  "ingredients": [
    "6 hard-boiled eggs",
    "0.25 cup mayonnaise",
    "2 tablespoons sliced bread-and-butter pickles",
    "1 tablespoon honey mustard, or more to taste",
    "0.25 teaspoon ground black pepper",
    "1 pinch paprika, or as needed"
  ],
  "steps": [
    {
      "text": "Halve eggs lengthwise. Carefully remove yolks to a small bowl and mash with a fork; add mayonnaise, pickles, honey mustard, and black pepper. Blend the mixture until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop yolk mixture into egg halves; garnish with paprika. Keep refrigerated until ready to serve.",
