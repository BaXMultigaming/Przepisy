  "ingredients": [
    "1 cup yellow cornmeal",
    "2 tablespoons whole wheat flour",
    "0.5 teaspoon salt",
    "1 tablespoon white sugar",
    "1 teaspoon baking powder",
    "1.5 tablespoons shortening, melted",
    "1 cup boiling milk",
    "1 egg, separated"
  ],
  "steps": [
    {
      "text": "Preheat oven to 275 degrees F (135 degrees C). Lightly grease a 9x9 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift cornmeal and flour together and spread thinly on a baking sheet. Bake in preheated oven until lightly brown, about 10 minutes. Let cool. Raise oven temperature to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine cornmeal mixture, salt, sugar and baking powder. Pour in shortening and milk; stir to blend.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate large bowl, beat egg white until stiff. In a third bowl, beat egg yolk then fold into egg white. Gently stir flour mixture into beaten egg. Pour into prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 45 to 50 minutes, until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
