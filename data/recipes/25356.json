  "title": "Old-Fashioned Johnny Cake",
  "description": "This is a very old time recipe. My great grandparents used to eat this in a bowl with milk on it.",
  "authors": [
    "EDSELS1959"
  ],
  "date_published": "2020-06-18T23:06:11-04:00",
