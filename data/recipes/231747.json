  "title": "Probiotic Chocolate Chocolate Chip Muffins",
  "description": "Get a little probiotic boost in your breakfast by adding buttermilk to this chocolate chocolate chip muffin recipe.",
  "authors": [
    "Carissa Fain"
  ],
  "date_published": "2020-06-18T23:53:37-04:00",
