  "ingredients": [
    "6 (1 ounce) squares semisweet chocolate",
    "0.33333334326744 cup unsalted butter",
    "2 eggs",
    "0.75 cup buttermilk",
    "0.5 cup white sugar",
    "0.5 cup sour cream",
    "1.5 teaspoons vanilla extract",
    "1.6666667461395 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat semisweet chocolate and butter together in a saucepan over low heat until melted, 3 to 5 minutes. Remove from heat and cool for about 10 minutes. Lightly beat eggs into cooled chocolate mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk chocolate-butter mixture, buttermilk, sugar, sour cream, and vanilla extract together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking soda, and salt in a large bowl; form a well in the center of the flour mixture. Stir chocolate mixture into flour mixture until just combined. Fold chocolate chips into batter. Spoon batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, about 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
