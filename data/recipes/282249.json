  "ingredients": [
    "0.25 cup milk",
    "1 large egg",
    "0.5 cup all-purpose flour",
    "0.25 cup dry bread crumbs",
    "1 tablespoon Creole seasoning",
    "1 pinch ground black pepper",
    "2 (5 ounce) skinless, boneless chicken breasts, sliced into strips",
    "0.5 cup oil for frying, or as needed"
  ],
  "steps": [
    {
      "text": "Mix milk and egg together in a medium bowl. Mix flour, bread crumbs, Creole seasoning, and pepper together in a second bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken strips into egg wash, and then roll through flour mixture until fully coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry the chicken strips in the hot oil until golden brown, no longer pink in the centers, and juices run clear, 10 to 12 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
