  "ingredients": [
    "0.33333334326744 cup all-purpose flour",
    "3 tablespoons chick pea flour",
    "1 cup white sugar",
    "2 tablespoons grated lemon zest",
    "1 pinch ground cardamom",
    "1 pinch ground nutmeg",
    "0.25 teaspoon baking soda",
    "1 pinch salt",
    "1 cup soy milk",
    "0.5 cup water",
    "0.33333334326744 cup fresh lemon juice",
    "2 tablespoons powdered egg substitute",
    "0.25 cup water",
    "2 tablespoons white sugar",
    "2 tablespoons powdered fruit pectin"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Set out 8 (4 inch) ramekins on a baking tray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the all-purpose flour, chick pea flour, 1 cup sugar, lemon zest, cardamom, nutmeg, baking soda, and salt. Combine the soy milk, water and lemon juice; stir into the dry ingredients until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate large bowl, stir together the egg substitute and 1/4 cup water. Whip with an electric mixer until foamy. Gradually mix in the sugar and fruit pectin while whipping until thick. Fold the egg substitute mixture into the batter, and fill ramekins about 3/4 full with the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 to 40 minutes in the preheated oven, or until set and golden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
