  "ingredients": [
    "1.75 cups oats",
    "3 bananas",
    "1 cup crunchy almond butter",
    "0.5 cup milk",
    "0.33333334326744 cup agave nectar",
    "0.25 cup coconut oil, melted",
    "1 large egg",
    "2 teaspoons vanilla extract",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 18 miniature muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend oats in a blender until consistency of flour. Add bananas, almond butter, milk, agave nectar, coconut oil, egg, vanilla extract, baking powder, cinnamon, baking soda, and salt to oat flour and blend until batter is smooth. Pour batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, 15 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
