  "ingredients": [
    "3 eggs",
    "0.25 cup milk",
    "1 tablespoon heavy cream",
    "1 slice bacon, thinly sliced",
    "salt and ground black pepper to taste",
    "4 slices bread",
    "1 tablespoon butter, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 2 ceramic ramekins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together eggs, milk, and heavy cream in a bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1/2 bacon into each prepared ramekin. Pour 1/2 egg mixture into each ramekin. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until domed on top, golden, and baked through, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While eggs bake, toast bread slices in a toaster to desired doneness. Slice into thin strips; spread with butter. Serve with baked eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
