  "ingredients": [
    "0.25 cup olive oil",
    "4 onions, thinly sliced",
    "1 teaspoon salt",
    "0.5 teaspoon sugar",
    "1 tablespoon all-purpose flour",
    "1 cup chicken broth",
    "4 links pork sausage"
  ],
  "steps": [
    {
      "text": "Warm oil in a large skillet over medium heat. Stir in onions, and cook until soft, about 10 minutes. Stir in salt and sugar. Reduce heat to medium low, cover, and cook 20 minutes. Stir in flour, then add broth. Stir well. Cover, leaving the lid slightly ajar, and cook 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, prepare oven broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sausages on a broiling pan; place under the broiler, and cook, turning occasionally, until the skin is dark brown and the sausages are cooked through, about 20 minutes. Pour onion sauce over sausages.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
