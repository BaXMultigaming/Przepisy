  "ingredients": [
    "1 cup milk",
    "0.66666668653488 cup all-purpose flour",
    "2 large eggs",
    "2.5 teaspoons vegetable oil, divided",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Combine milk, flour, eggs, 1 1/2 teaspoons oil, and salt in a blender; process until smooth. Cover and refrigerate for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a skillet over medium-high heat and brush with remaining oil. Pour 1/8 of the crêpe batter (about 1/4 cup) into the pan; tilt the pan until batter coats the entire surface. Cook until golden brown, 1 to 2 minutes per side, then remove to a plate. Repeat to cook remaining crêpes.",
