  "ingredients": [
    "1 cube chicken bouillon",
    "1 (16 ounce) package frozen Brussels sprouts",
    "0.5 pound smoked bacon, diced",
    "1 large onion, minced",
    "3 tablespoons honey",
    "3 tablespoons soy sauce",
    "0.5 cup raisins",
    "3 tablespoons pine nuts",
    "1 tablespoon toasted sesame seeds"
  ],
  "steps": [
    {
      "text": "Bring a pot of water to a boil; dissolve bouillon cube in the boiling water. Add Brussels sprouts; cook until tender, about 10 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes. Transfer bacon to a paper towel-lined plate, leaving bacon drippings in the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir onion in bacon drippings until transparent and tender, about 10 minutes. Add honey and soy sauce; stir until liquid starts to bubble, 1 to 2 minutes. Stir in Brussels sprouts, bacon, raisins, and pine nuts; cook until Brussels sprouts are heated through and well coated, 3 to 5 minutes. Garnish with sesame seeds before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
