  "ingredients": [
    "2 cups baking mix (such as Bisquick®)",
    "0.75 cup rolled oats",
    "0.5 cup skim milk",
    "1 tablespoon hemp seeds",
    "1 cup blueberries",
    "2 tablespoons light butter, melted",
    "1 tablespoon brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine baking mix, oats, milk, and hemp seeds in a bowl; stir until dough forms a ball. Fold in blueberries until evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop heaping teaspoonfuls of dough onto an ungreased baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 8 to 10 minutes. Brush each biscuit with melted butter; sprinkle with brown sugar.",
