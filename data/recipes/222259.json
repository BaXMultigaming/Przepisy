  "ingredients": [
    "1 pound bacon, diced",
    "4 (16 ounce) cans baked beans",
    "1 (16 ounce) can kidney beans, drained",
    "1 (16 ounce) can pinto beans, drained",
    "1 (16 ounce) can chili beans, drained",
    "0.5 cup brown sugar",
    "0.5 cup ketchup",
    "1 teaspoon Worcestershire sauce",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook and stir bacon in a large, deep skillet over medium-high heat until evenly browned, about 10 minutes. Drain on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bacon, baked beans, kidney beans, pinto beans, chili beans, brown sugar, ketchup, and Worcestershire sauce in a large bowl; transfer to a large baking dish and top with Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese melts and beans are bubbling, about 45 minutes. Cool before serving, 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
