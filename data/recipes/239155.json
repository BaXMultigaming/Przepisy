  "ingredients": [
    "1 pound hot Italian sausage links, cut into pieces",
    "6 small bell peppers, cut into strips",
    "1 zucchini, cut into small chunks",
    "2 small tomatoes, cut into chunks",
    "3 tablespoons grapeseed oil",
    "2 tablespoons chicken bouillon granules",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Cook and stir sausage in a skillet over medium heat until cooked through, 5 to 7 minutes, partially draining the drippings. Add bell peppers and zucchini to the sausage; cook and stir until tender, about 5 minutes. Stir tomatoes, oil, chicken bouillon, salt, and pepper to sausage mixture; cook and stir until heated through, about 3 minutes.",
