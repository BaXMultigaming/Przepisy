  "ingredients": [
    "1.3333333730698 cups water",
    "0.66666668653488 cup quinoa",
    "0.25 cup shredded unsweetened coconut",
    "0.25 cup brown sugar",
    "2 tablespoons whole wheat flour",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "2 large eggs, beaten"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease 24 non-stick mini-muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and quinoa to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until quinoa is tender and water has been absorbed, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir coconut, brown sugar, whole wheat flour, cinnamon, and salt together in a bowl. Add quinoa and eggs to coconut mixture; stir until completely combined. Drop coconut mixture by the tablespoonful into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until slightly crisp and golden brown, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
