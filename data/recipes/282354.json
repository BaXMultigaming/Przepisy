  "ingredients": [
    "2 tablespoons unsalted butter",
    "1 teaspoon olive oil",
    "1 large yellow onion, thinly sliced",
    "1 tablespoon garlic, minced",
    "6 medium sweet potatoes",
    "1 tablespoon coconut oil",
    "1 tablespoon crushed fresh ginger root",
    "1 tablespoon creme fraiche",
    "0.125 teaspoon curry powder",
    "0.125 teaspoon ground turmeric",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat butter and olive oil in a skillet over medium heat; stir in onion and garlic. Reduce heat to low and saute until onions are soft and clear but not toasted, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pierce potatoes with a fork. Microwave 3 at a time on high power until tender, but not overdone, 5 to 6 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash and mix sweet potatoes with onion-garlic mixture, ginger, creme fraiche, curry powder, turmeric, and pepper until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
