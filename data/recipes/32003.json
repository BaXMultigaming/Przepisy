  "ingredients": [
    "1 cup dry bread crumbs",
    "0.25 cup grated Parmesan cheese",
    "2 teaspoons Italian-style seasoning",
    "1 cup milk",
    "1 pound skinless, boneless turkey breast meat - cut into strips",
    "0.25 cup olive oil"
