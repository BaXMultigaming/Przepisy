  "ingredients": [
    "2 tablespoons olive oil",
    "0.5 cup chopped green onions",
    "2 cups red Zinfandel wine",
    "2 cups ketchup",
    "1 cup soy sauce",
    "0.5 cup Dijon mustard",
    "0.25 cup brown sugar",
    "0.25 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Heat the olive oil in a saucepan over medium heat, and cook and stir the green onions about 5 minutes, until tender. Pour in the wine, and cook until reduced by about 1/2.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the ketchup, soy sauce, mustard, and brown sugar into the saucepan with the wine. Reduce heat, and simmer 30 minutes, until thickened and well blended. Remove from heat, and mix in the parsley. Refrigerate until ready to serve.",
