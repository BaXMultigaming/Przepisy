  "ingredients": [
    "1 pound small new potatoes, halved",
    "1 head garlic, cloves separated but not peeled",
    "2 tablespoons olive oil",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange potatoes and garlic cloves in a 9x13-inch pan. Drizzle with oil and sprinkle with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are tender and garlic cloves are soft, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven. Squeeze garlic cloves to release roasted garlic onto the potatoes; discard garlic skins. Mix potatoes and garlic together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
