  "ingredients": [
    "3 skinless, boneless chicken breast halves",
    "0.5 (8 ounce) jar medium salsa",
    "0.25 cup tomato sauce",
    "2 cloves garlic, minced",
    "1 small red onion, chopped",
    "1 teaspoon ground cumin",
    "1 teaspoon chili powder",
    "1 pinch salt and fresh ground pepper to taste"
  ],
  "steps": [
    {
      "text": "Arrange the chicken breasts in the bottom of a slow cooker, and pour in the salsa and tomato sauce. Add the garlic and onion, and sprinkle in the cumin, chili powder, salt, and pepper. Set the cooker on Low, and cook until the chicken is very tender, 4 to 5 hours. Shred the chicken with two forks for serving.",
