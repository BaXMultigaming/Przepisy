  "ingredients": [
    "3 pounds chicken wings",
    "2 tablespoons olive oil",
    "0.5 cup soy sauce",
    "2 tablespoons ketchup",
    "1 cup honey",
    "1 clove garlic, minced",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
