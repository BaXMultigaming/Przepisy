  "ingredients": [
    "1 (9 inch) prepared graham cracker crust",
    "1 large banana, sliced",
    "2 cups cold milk",
    "2 (3.5 ounce) packages instant vanilla pudding mix",
    "0.5 teaspoon ground cinnamon",
    "1 (8 ounce) container frozen whipped topping, thawed",
    "0.25 cup caramel ice cream topping"
  ],
  "steps": [
    {
      "text": "Place banana slices in bottom of pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine milk, pudding mixes and cinnamon. Beat with wire whisk for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently stir in whipped topping to pudding, then spoon mixture into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate for 4 hours until pie is set up. When pie is ready serve with caramel topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
