  "ingredients": [
    "0.25 cup lingonberry jam",
    "0.25 cup melted butter",
    "2 cups milk",
    "4 eggs",
    "2 tablespoons melted butter",
    "3 teaspoons vanilla extract",
    "1 cup all-purpose flour, sifted",
    "2 tablespoons white sugar",
    "1 dash salt"
  ],
  "steps": [
    {
      "text": "Whisk lingonberry jam and ¼ cup melted butter together in a small bowl until well combined. Set topping aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, eggs, 2 tablespoons melted butter, and vanilla together in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, and salt together in a bowl until well mixed; gradually whisk into milk mixture until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop ½ cup batter onto a lightly buttered skillet or crêpe pan over medium heat; swirl the skillet to spread batter. Cook until top looks dry, about 2 minutes. Flip with a spatula; cook until light golden, 1 to 2 minutes more. Transfer to a plate; spread with topping and roll up pancake. Repeat with remaining batter and topping.",
      "section": null,
