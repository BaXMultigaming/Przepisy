  "ingredients": [
    "2 quarts chicken broth",
    "5 pounds potatoes, peeled and quartered",
    "5 cloves garlic, chopped",
    "1 cup heavy cream",
    "0.5 cup sour cream",
    "3 tablespoons chopped fresh chives",
    "0.5 teaspoon salt",
    "0.25 cup melted butter"
  ],
  "steps": [
    {
      "text": "Bring chicken broth to a boil. Add potatoes and cook until tender but still firm, about 15 minutes; drain, reserving broth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in garlic, cream and 1 to 2 tablespoons broth; mash until creamy. Blend in sour cream, chives, salt and butter. Heat through and serve.",
      "section": null,
