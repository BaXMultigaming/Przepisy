  "ingredients": [
    "8 cups cubed bread",
    "1 cup raisins",
    "2 cups milk",
    "4 eggs",
    "0.25 cup butter, melted",
    "0.25 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Place bread and raisins into a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, eggs, melted butter, sugar, vanilla, and nutmeg together in a bowl; pour over bread and raisins. Toss to evenly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low until a knife inserted near the center comes out clean, about 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
