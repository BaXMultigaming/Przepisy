  "ingredients": [
    "1 pound peeled crawfish tails",
    "1.5 tablespoons Creole seasoning, or to taste",
    "0.5 cup butter",
    "1 onion, finely chopped",
    "1 green bell pepper, finely chopped",
    "2 teaspoons minced garlic",
    "1 cup water, or to taste",
    "0.25 teaspoon ground black pepper",
    "2 tablespoons cornstarch",
    "2 tablespoons water",
    "3 small bread loaves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss crawfish tails with Creole seasoning in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Add onion and green bell pepper; cook and stir until soft, about 5 minutes. Stir in garlic. Thin mixture with 1 cup water. Stir in crawfish tails; season with black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cornstarch with 2 tablespoons water in a small bowl until smooth. Pour into the saucepan, stirring constantly, until crawfish mixture thickens, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut tops off bread loaves; hollow out center to create a \"boat.\" Place bread loaves on a baking sheet; spoon crawfish mixture into the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bread is warm and lightly toasted, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
