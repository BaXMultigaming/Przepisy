  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 cup vegetable shortening",
    "1 cup brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon maple extract",
    "2 cups all-purpose flour",
    "0.5 teaspoon salt",
    "1 (12 ounce) bag chocolate chips",
    "2 tablespoons chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and vegetable shortening with brown sugar, egg, vanilla extract, and maple extract until smooth; stir in flour and salt. Lightly press the dough into a 10x15-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until the crust is set and lightly browned, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate chips in the top of a double boiler over simmering water, stirring frequently and scraping down the sides with a rubber spatula to avoid scorching. Remove crust from oven and spread melted chocolate in a layer on top. Sprinkle with walnuts. Cut bars while still warm; let chocolate set, about 1 hour, before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
