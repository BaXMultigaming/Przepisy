  "ingredients": [
    "6 (5 ounce) red snapper fillets",
    "1 (8 ounce) bottle Italian-style salad dressing",
    "1 serving cooking spray",
    "1 lemon, thinly sliced",
    "1 jalapeno pepper, thinly sliced"
  ],
  "steps": [
    {
      "text": "Place snapper fillets in a glass baking dish and pour Italian dressing over top. Gently turn fish to evenly coat. Cover the dish with plastic wrap and marinate in the refrigerator, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat. Make a tray with aluminum foil and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove fish from the dressing and place on the foil tray. Place lemon slices and jalapenos on top. Discard any remaining dressing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the tray on the preheated grill and cook until fish begins to turn a nice, light color and flakes easily with a fork, 5 to 6 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
