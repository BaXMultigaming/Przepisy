  "ingredients": [
    "1 large head cabbage, cored and cut into 8 wedges",
    "0.25 cup water",
    "8 teaspoons butter",
    "0.5 teaspoon garlic powder, or to taste",
    "0.5 teaspoon seasoned salt, or to taste",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium-high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange cabbage wedges in the bottom of a large metal baking dish; add water to dish. Place 1 teaspoon butter onto each wedge; season liberally with garlic powder, seasoned salt, and black pepper. Cover the dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the dish on the preheated grill; cook until cabbage is tender, about 30 minutes.",
