  "ingredients": [
    "1 pound ground turkey breast",
    "2 (14 ounce) cans chicken broth",
    "1 (20 ounce) jar picante sauce",
    "0.25 cup chopped fresh cilantro",
    "1 tablespoon lime juice",
    "1 tablespoon olive oil",
    "0.5 cup crushed tortilla chips, or to taste"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir turkey in the hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Transfer turkey to a 5-quart pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix broth, picante sauce, cilantro, lime juice, and olive oil into turkey; bring to a boil. Reduce heat, cover pot, and simmer until flavors blend, about 40 minutes. Transfer soup to serving bowls and top with tortilla chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
