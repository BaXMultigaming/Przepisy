  "ingredients": [
    "1.5 cups water",
    "1 (8 ounce) can pineapple chunks, drained (juice reserved)",
    "0.75 cup white sugar",
    "0.5 cup distilled white vinegar",
    "2 drops orange food color",
    "0.25 cup cornstarch",
    "2.25 cups self-rising flour",
    "2 tablespoons vegetable oil",
    "2 tablespoons cornstarch",
    "1 egg",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground white pepper",
    "8 skinless, boneless chicken breast halves - cut into 1 inch cubes",
    "1 quart vegetable oil for frying",
    "2 green bell pepper, cut into 1 inch pieces"
  ],
  "steps": [
    {
      "text": "Combine 1 ½ cups water, reserved pineapple juice, sugar, vinegar, and orange food coloring in a medium saucepan over medium heat; bring to a boil. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/n7l2XB3EIDVZHgCEvvyQAfPFfzI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8536-sweet-and-sour-chicken-step1-151copy-5b9d0c17b133409ca55c97348c7e2cf3.jpg"
      ],
      "image": "assets/images/8536/step_01.webp"
    },
    {
      "text": "Whisk ¼ cup cornstarch and ¼ cup water together in a small bowl until smooth; stir into sauce, stirring continuously, until slightly thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_iMDfSDtEilcoTKSARDrNLqg9-I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8536-sweet-and-sour-chicken-step2-153copy-113faf97f47c4e27a6de9a801fe45f34.jpg"
      ],
      "image": "assets/images/8536/step_02.webp"
    },
    {
      "text": "Combine flour, 2 tablespoons oil, 2 tablespoons cornstarch, egg, salt, and white pepper in a large bowl; gradually whisk in remaining 3/4 cup water, or as needed to form a thick, scoopable batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/y_sfuMEec6D6pY41NS5CsEUV4lo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8536-sweet-and-sour-chicken-step3-156copy-b53337b196484bee80747ffb550e6448.jpg"
      ],
      "image": "assets/images/8536/step_03.webp"
    },
    {
      "text": "Add chicken pieces; stir until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2PEUgZHzSKL9r4_F6yBcM__CQDM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8536-sweet-and-sour-chicken-step4-158copy-024cd9b74e20430b8351ca2784ff6310.jpg"
      ],
      "image": "assets/images/8536/step_04.webp"
    },
    {
      "text": "Heat 1 quart oil in a large, deep skillet or wok to 360 degrees F (180 degrees C). Fry chicken pieces in hot oil until golden, about 10 minutes; transfer to paper towels to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/s25YEOljnOkFFrPOfysOkp7DWQc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8536-sweet-and-sour-chicken-step5-197copy-ad8cba31543843d1afaf8dd26e3516d5.jpg"
      ],
      "image": "assets/images/8536/step_05.webp"
    },
    {
      "text": "Layer bell peppers, pineapple chunks, and chicken pieces on a platter; pour hot sweet and sour sauce over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W90xU0DPyuBunS-edPiGrlWKwYc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8536-sweet-and-sour-chicken-step6-202copy-c3bfed4a06de4f7f8e918d50c512bd3e.jpg"
      ],
      "image": "assets/images/8536/step_06.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
