  "ingredients": [
    "1 head radicchio, quartered",
    "3 tablespoons extra virgin olive oil, divided",
    "1 teaspoon salt",
    "1 teaspoon Dijon mustard",
    "1 teaspoon balsamic vinegar"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place radicchio in a large bowl. Add 1 tablespoon olive oil and salt; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together remaining 2 tablespoons olive oil, mustard, and vinegar in a separate bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill radicchio on the preheated grill for 3 minutes on each side. Transfer to a serving dish and drizzle reserved dressing over the top. Serve immediately.",
