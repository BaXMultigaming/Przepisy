  "ingredients": [
    "1 pound pork sausage",
    "8 eggs, beaten",
    "2 cups shredded mozzarella cheese",
    "2 cups shredded Cheddar cheese",
    "1 teaspoon dried oregano",
    "1 (8 ounce) package refrigerated crescent roll dough"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook sausage in a large, deep skillet over medium-high heat, until evenly browned, 7 to 9 minutes. Drain and crumble into small pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix beaten eggs, mozzarella, Cheddar, and oregano together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line the bottom of the prepared baking dish with crescent roll dough, then sprinkle crumbled sausage over top. Pour egg mixture over sausage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
