  "ingredients": [
    "1 cup bread crumbs",
    "2 tablespoons grated Parmesan cheese",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon dried parsley",
    "salt to taste",
    "1 large egg",
    "12 medium mushrooms",
    "2 cups oil for frying, or as needed",
    "3 tablespoons tartar sauce",
    "2 cloves garlic"
  ],
  "steps": [
    {
      "text": "Combine bread crumbs, Parmesan cheese, garlic powder, parsley, and salt in a medium resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a large bowl. Add mushrooms and toss until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 mushroom in bread crumb mixture in the bag; seal and shake to coat. Repeat with remaining mushrooms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a deep fryer or large saucepan to 375 degrees F (190 degrees C). Cook mushrooms in hot oil until golden brown, about 5 minutes. Remove to a paper towel-lined plate to cool and drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tartar sauce in a small bowl. Crush garlic cloves into tartar sauce and mix well. Serve alongside fried mushrooms for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
