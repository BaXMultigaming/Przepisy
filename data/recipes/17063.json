  "ingredients": [
    "1 cup brown sugar",
    "0.75 cup butter, melted",
    "1 teaspoon ground cinnamon",
    "2 (21 ounce) cans apple pie filling",
    "20 slices white bread",
    "1.5 cups milk",
    "6 eggs",
    "1 teaspoon vanilla extract",
    "0.5 cup maple syrup"
  ],
  "steps": [
    {
      "text": "Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar, melted butter, and cinnamon together in a small bowl; spread into the prepared pan. Spread apple pie filling evenly over top, then layer on bread slices, pressing down as you go.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat milk, eggs, and vanilla together in a bowl; slowly pour over bread, making sure egg mixture is completely absorbed. Cover pan with aluminum foil; refrigerate 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, covered, for 1 to 1 ¼ hours. Turn on the broiler. Uncover pan; drizzle maple syrup on top. Broil until syrup begins to caramelize, 2 minutes. Remove from oven; let stand for 10 minutes, then cut into squares. Invert pan onto a serving tray or baking sheet so apple filling is on top. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
