  "title": "Overnight Apple Cinnamon French Toast",
  "description": "Overnight apple cinnamon French toast, made with apple pie filling, cinnamon, and white bread, is a great brunch recipe — perfect for large gatherings.",
  "authors": [
    "CALJAKE"
  ],
  "date_published": "2000-03-17T12:40:23-05:00",
