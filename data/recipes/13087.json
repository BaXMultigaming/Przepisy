  "ingredients": [
    "0.5 cup chopped onion",
    "2 stalks celery, chopped",
    "1 carrot, diced",
    "0.25 cup butter",
    "1.5 tablespoons all-purpose flour",
    "1.5 teaspoons curry powder",
    "4 cups chicken broth",
    "0.5 apple, cored and chopped",
    "0.25 cup white rice",
    "1 skinless, boneless chicken breast half - cut into cubes",
    "1 pinch dried thyme",
    "salt and ground black pepper to taste",
    "0.5 cup heavy cream, heated"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ff2yc2X6EuiiFLpzRpwC4nWkg5c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13087-Mulligatawny-Soup-ddmfs-4x3-step-01-f1825677fb49429387154c4d547fc47a.jpg"
      ],
      "image": "assets/images/13087/step_01.webp"
    },
    {
      "text": "Melt butter in a large soup pot over medium heat. Add onions, celery, and carrot and sauté until soft, 5 to 7 minutes. Add flour and curry, and cook 5 more minutes, stirring frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f-tct5iCjWfCMkTYyS_GF27R_bI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13087-Mulligatawny-Soup-ddmfs-4x3-step-03-a774b5ef32a1451586b811131779970d.jpg"
      ],
      "image": "assets/images/13087/step_02.webp"
    },
    {
      "text": "Add chicken broth, mix well, and bring to a boil. Reduce heat and simmer for about 30 minutes. Add apple, rice, chicken, thyme, salt, and pepper. Simmer until rice is tender, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/H3eJN2UA2pipz4yo2gJ29OhjIoY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13087-Mulligatawny-Soup-ddmfs-4x3-step-04-dedba004977a4e9980cfd043e6d067ea.jpg"
      ],
      "image": "assets/images/13087/step_03.webp"
    },
    {
      "text": "Just before serving, stir in hot cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B5KKxil9-SBcY0gWg67iJUATfm4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-13087-Mulligatawny-Soup-ddmfs-4x3-step-05-278fdf43833d4190ae7d541023c5c7ca.jpg"
      ],
      "image": "assets/images/13087/step_04.webp"
    },
    {
      "text": "Serve and enjoy!",
