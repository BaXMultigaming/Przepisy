  "ingredients": [
    "3 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 cup unsweetened cocoa powder",
    "1 cup butter, softened",
    "0.5 cup shortening",
    "3 cups white sugar",
    "1 teaspoon vanilla extract",
    "5 eggs",
    "1 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease and flour a 10 inch Bundt pan. Sift flour, baking powder, salt and cocoa. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream butter, shortening, sugar, and vanilla until light and fluffy. Add eggs one at a time, beating well after each. Add flour mixture alternately with the milk. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into 10 inch Bundt pan. Bake at 325 F (165 degrees C) for 70 minutes or until a toothpick inserted into cake comes out clean. Let cool for 10 minutes in the pan, then turn out onto a wire rack and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
