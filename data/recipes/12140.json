  "title": "Bev's Chocolate Pie",
  "description": "This chocolate pie has a luscious filling made with cocoa, sugar, egg yolks, and evaporated milk baked in a pie shell with fluffy meringue on top.",
  "authors": [
    "Diana Barnes"
  ],
  "date_published": "1998-04-25T12:44:50-04:00",
