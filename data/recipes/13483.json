  "ingredients": [
    "1 (15 ounce) can pumpkin puree",
    "1 (12 fluid ounce) can evaporated milk",
    "1.5 cups white sugar",
    "4 large eggs",
    "2 teaspoons pumpkin pie spice",
    "1 teaspoon salt",
    "1 (15.25 ounce) package yellow cake mix",
    "1 cup chopped pecans",
    "1 cup margarine, melted",
    "1 (8 ounce) container frozen whipped topping"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-c72aUKhFfg0wCqX-rsix_jWvWg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13483-pumpkin-crunch-cake-ddmfs-step01_7827-70411559648b452e9e54d94458d5581d.jpg"
      ],
      "image": "assets/images/13483/step_01.webp"
    },
    {
      "text": "Combine pumpkin, evaporated milk, sugar, eggs, pumpkin pie spice, and salt in a large bowl; mix well. Spread batter in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SMDzI0E7-pkeND_u9JjmWWMC0PU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13483-pumpkin-crunch-cake-ddmfs-step02_7829-cea4461afcae415fae22ef4dacea1534.jpg"
      ],
      "image": "assets/images/13483/step_02.webp"
    },
    {
      "text": "Sprinkle cake mix over pumpkin batter; pat down gently. Sprinkle chopped pecans evenly over cake; drizzle with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SZWIoEqY2XlQw4BaYCMaiqYxJSw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13483-pumpkin-crunch-cake-ddmfs-step03_7830-54f9a9131a604160807e72920cdd2f20.jpg"
      ],
      "image": "assets/images/13483/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until golden, and a toothpick inserted into center comes out clean, 60 to 80 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_NE2fUfLj4IB8t0C2QyKz4llt24=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13483-pumpkin-crunch-cake-ddmfs-step04_7831-0379cc539ba44df0a7a83ecabd79c567.jpg"
      ],
      "image": "assets/images/13483/step_04.webp"
    },
    {
      "text": "Let cake cool; spread with whipped topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
