  "ingredients": [
    "2 cups graham cracker crumbs",
    "0.75 cup white sugar",
    "0.25 pound butter, melted",
    "2 (8 ounce) packages cream cheese",
    "1.5 cups confectioners' sugar",
    "4 bananas, sliced",
    "1 (15 ounce) can crushed pineapple, drained",
    "1 (16 ounce) container frozen whipped topping, thawed",
    "1 (16 ounce) jar maraschino cherries, drained",
    "12 ounces crushed peanuts"
  ],
  "steps": [
    {
      "text": "Combine graham cracker crumbs, white sugar, and melted butter in a large bowl; mix well. Press into a 9x13-inch cake pan; refrigerate until chilled, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together cream cheese and confectioners' sugar in the large bowl until smooth; spread over chilled graham cracker crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer sliced bananas and crushed pineapple over cream cheese mixture; cover with whipped topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with cherries and chopped nuts. Refrigerate for at least 1 hour and serve chilled.",
      "section": null,
      "name": null,
      "url": null,
