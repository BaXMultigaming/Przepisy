  "ingredients": [
    "1 cup all-purpose flour",
    "1 tablespoon all-purpose flour",
    "1 teaspoon baking soda",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1.75 sticks cold salted butter",
    "0.5 cup brown sugar",
    "0.5 cup white sugar",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "2 cups rolled oats",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A9yo3RE6TyGDiM8ohHWnj8H2Pcs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/278881-thin-and-crispy-oatmeal-raisin-cookies-ddmfs-Step1-4531-cbccc439f9f8404e8e11523c2bd00eed.jpg"
      ],
      "image": "assets/images/278881/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 cup plus 1 tablespoon flour, baking soda, baking powder, and salt in a large bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xwxv1BmfNvnLGJ-N217Ps0ClDxY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/278881-thin-and-crispy-oatmeal-raisin-cookies-ddmfs-Step2-4533-aebcc4ecc9aa49ef96a4a8d6f412b5cb.jpg"
      ],
      "image": "assets/images/278881/step_03.webp"
    },
    {
      "text": "Place cold butter in a microwave-safe bowl and heat until soft, but not melted, 20 to 30 seconds. Add brown and white sugars; mix with a metal whisk or spoon until combined, about 45 seconds. Add egg, vanilla, cinnamon, and nutmeg; mix for 20 seconds. Pour in flour mixture and mix for 10 to 20 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/SbmKRBp8jG9YVDHQmVPX4tqx9SU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/278881-thin-and-crispy-oatmeal-raisin-cookies-ddmfs-Step5-4536-2cec160300b34ed8b8a2f9e8bf556d85.jpg"
      ],
      "image": "assets/images/278881/step_04.webp"
    },
    {
      "text": "Fold in oats and raisins until incorporated, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GqaS8xJjLOwHagAnS2SHbx-rkFU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/278881-thin-and-crispy-oatmeal-raisin-cookies-ddmfs-Step5-4537-9b7b913b6546472983e745119d086090.jpg"
      ],
      "image": "assets/images/278881/step_05.webp"
    },
    {
      "text": "Scoop or roll dough into small balls, about 1 1/2-inches in diameter. Arrange balls 3 inches apart on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7YU_1rHlXU2PY2oYMdTeBgYpSVE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/278881-thin-and-crispy-oatmeal-raisin-cookies-ddmfs-Step5-4539-62b1bc35f6234ee1b551a40e643a3142.jpg"
      ],
      "image": "assets/images/278881/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven until tops are golden brown and edges are crisp, 13 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wqpkdub_s87IM7vUET-f8QTvr7Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/278881-thin-and-crispy-oatmeal-raisin-cookies-ddmfs-Step6-4546-a7caae3f558843e88548b2e6fbfc032f.jpg"
      ],
      "image": "assets/images/278881/step_07.webp"
    }
  ],
