  "ingredients": [
    "1 cup pecan halves",
    "2 tablespoons raspberry vinegar",
    "0.5 teaspoon Dijon mustard",
    "0.5 teaspoon sugar",
    "0.5 teaspoon salt",
    "1 pinch freshly ground black pepper to taste",
    "6 tablespoons olive oil",
    "6 cups mixed salad greens, rinsed and dried",
    "0.75 cup dried cranberries",
    "0.5 medium red onion, thinly sliced",
    "crumbled feta cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pecans evenly on a baking sheet. Toast in the preheated oven until lightly browned and fragrant, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk vinegar, Dijon mustard, sugar, salt, and pepper together in a small bowl until sugar and salt dissolve. Whisk in olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss salad greens, pecans, cranberries, onion, and feta together in a salad bowl. Drizzle with vinaigrette; toss gently to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
