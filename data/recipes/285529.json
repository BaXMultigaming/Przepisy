  "ingredients": [
    "14 ounces white chocolate chips",
    "5 cups whole milk",
    "2 cups heavy cream",
    "2 teaspoons vanilla extract",
    "0.25 cup whipped cream, or to taste",
    "1 teaspoon pumpkin pie spice, or more to taste"
  ],
  "steps": [
    {
      "text": "Combine chocolate chips, milk, cream, and vanilla in a slow cooker. Cover and cook on Low, stirring every 30 minutes, until chocolate is melted and ingredients are combined, about 3 hours total.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn slow cooker to Warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve hot chocolate in glasses topped with whipped cream and a pinch of pumpkin pie spice.",
      "section": null,
