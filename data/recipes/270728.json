  "ingredients": [
    "1 pound bulk Italian sausage",
    "1 bunch kale, chopped into bite-sized pieces",
    "4 medium carrots, diced",
    "1 medium onion, diced",
    "9 cups water",
    "1.3333333730698 cups lentils, rinsed",
    "1 (6 ounce) can tomato paste",
    "2 tablespoons white vinegar",
    "1 tablespoon brown sugar",
    "2 teaspoons garlic powder",
    "1.25 teaspoons garam masala",
    "1 teaspoon dried thyme",
    "0.5 teaspoon dried dill weed",
    "0.5 teaspoon dried tarragon",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Heat a large pot over medium heat. Cook and stir sausage until browned, about 5 minutes. Add kale stems, carrots, and onion; saute until soft, about 5 minutes. Pour in water and lentils; bring to a boil. Reduce heat to a simmer until lentils are tender, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomato paste, vinegar, brown sugar, garlic powder, garam masala, thyme, dill, tarragon, and salt into the pot. Return to a boil. Reduce heat; simmer, uncovered, until flavors blend, about 15 minutes. Toss in kale leaves and let wilt, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
