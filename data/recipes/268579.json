  "ingredients": [
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "2 cups low-fat milk",
    "0.25 cup white sugar",
    "0.25 cup Dutch-process cocoa powder",
    "2 tablespoons cornstarch",
    "1 tablespoon brandy",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Beat eggs and vanilla extract together in a medium bowl until combined; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, sugar, cocoa powder, cornstarch, brandy, and salt together in a saucepan. Cook over medium heat, stirring constantly, until boiling and thickened, 6 to 8 minutes. Reduce heat to low.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slowly pour 1/2 of the milk mixture into the beaten eggs while stirring; pour mixture back into the saucepan. Cook, stirring constantly, until thick, 2 to 3 minutes. Do not boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let custard cool to room temperature, at least 10 minutes. Refrigerate until set, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
