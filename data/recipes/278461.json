  "ingredients": [
    "10 mini sweet peppers, sliced in half lengthwise",
    "2 teaspoons extra virgin olive oil",
    "salt to taste",
    "1 (5.5 ounce) package goat cheese, softened",
    "0.33333334326744 cup grated Parmesan cheese",
    "1 medium jalapeno pepper, seeded and minced",
    "0.5 teaspoon minced garlic",
    "0.5 teaspoon dried chopped chives",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pepper halves in a bowl. Add olive oil and salt; toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix goat cheese, Parmesan cheese, jalapeño, garlic, chives, and black pepper together in a separate bowl until evenly combined. Spoon cheese mixture into pepper halves and place onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until peppers have softened and cheese is browned, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
