  "ingredients": [
    "1 cup creamy peanut butter",
    "0.25 cup stevia sweetener (such as Truvia®)",
    "1 large egg",
    "2 tablespoons unsweetened cocoa powder",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix peanut butter, stevia, egg, cocoa powder, and vanilla with an electric mixer or in a food processor until well combined. Roll dough into sixteen 1-inch balls. Place 1 to 2 inches apart onto an ungreased baking sheet. Flatten balls with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set, about 10 minutes. Remove from the oven and let cool on the baking sheet for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a tray with waxed paper. Carefully transfer cookies to the tray and let cool to room temperature, about 15 minutes. Refrigerate until fully set, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
