  "ingredients": [
    "2 (15 ounce) cans garbanzo beans, drained",
    "1 (15 ounce) can garbanzo beans, drained with liquid reserved",
    "6 cloves garlic, minced",
    "2 lemons, zested and juiced",
    "1 tablespoon ground cumin",
    "2 teaspoons dried basil",
    "1 teaspoon salt",
    "1 teaspoon cayenne pepper",
    "1 teaspoon ground black pepper",
    "0.75 cup olive oil",
    "1 teaspoon sesame oil"
  ],
  "steps": [
    {
      "text": "Pour all garbanzo beans into the bowl of a food processor; pulse several times to slightly break some of the beans. Add garlic, lemon zest, lemon juice, cumin, basil, salt, cayenne pepper, and ground black pepper; blend until the beans are beginning to look like large crumbs, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With the food processor running, gradually stream reserved liquid from garbanzo beans, olive oil, and sesame oil into the beans mixture; continue to blend until all liquids are integrated with the garbanzo bean mixture into a smooth hummus.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
