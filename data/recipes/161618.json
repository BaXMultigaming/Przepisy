  "ingredients": [
    "1 slice bacon, chopped",
    "0.5 onion, chopped",
    "0.25 green bell pepper, chopped",
    "0.5 teaspoon chopped fresh thyme",
    "0.5 cup tomato sauce",
    "1 teaspoon browning sauce",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 pinch red pepper flakes",
    "2 (14 ounce) cans whole kernel corn, drained",
    "3.5 cups water",
    "2 cups white rice"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium heat. Cook and stir bacon in the hot skillet until grease begins to render. Add onion, bell pepper, and thyme; cook, stirring occasionally, until onion is nearly translucent. Reduce heat to medium-low and stir in tomato sauce, browning sauce, salt, black pepper, and red pepper flakes; simmer for 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add corn; simmer for 3 more minutes. Slowly pour in water while stirring. Increase heat to high and stir in rice; bring to a boil. Cover, reduce heat to low, and simmer until liquid is absorbed, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fluff rice mixture with a fork to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
