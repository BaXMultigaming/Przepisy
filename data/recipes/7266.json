  "ingredients": [
    "3 eggs",
    "2 cups white sugar",
    "1 cup butter, softened",
    "0.5 cup water",
    "2.25 cups all-purpose flour",
    "2 tablespoons unsweetened cocoa powder",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground allspice",
    "0.5 cup semisweet chocolate chips",
    "2 cups grated apple",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Cream together until fluffy the eggs, sugar, butter or margarine, and water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, sift together the flour, cocoa, baking soda, and spices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add dry ingredients to creamed mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold in chocolate chips, apple, and vanilla extract. Stir until these ingredients are evenly distributed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon into greased, floured 10 inch bundt or loose bottom tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 325 degrees F (165 degrees C) for 60 to 70 minutes until cake tests done.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
