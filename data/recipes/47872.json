  "ingredients": [
    "3 pounds beef sirloin tip roast",
    "4 cloves garlic, peeled and halved",
    "1 teaspoon coarsely ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Secure roast with cooking twine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make eight 1/2-inch slits around the roast. Insert a garlic piece into each slit, then sprinkle with pepper. Place onto a rack in a roasting pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 20 minutes. Reduce the heat to 325 degrees F (165 degrees C) and insert a meat thermometer into the center. Continue cooking for about 1 hour, or to desired doneness. The thermometer should read 140 degrees F (60 degrees C) for medium.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and loosely cover with foil. Let stand for 15 minutes, then thinly slice against the grain. Use the pan drippings for gravy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
