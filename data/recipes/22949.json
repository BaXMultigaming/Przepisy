  "regions": [],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "1.5 teaspoons baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "0.25 cup butter",
    "1 egg",
    "0.75 cup orange juice",
    "1 tablespoon grated orange zest",
    "1.5 cups fresh or frozen cranberries",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease an 8x4 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the flour, sugar, baking powder, salt and baking soda. Cut in the butter until the mixture resembles coarse crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, beat the egg, orange juice and orange zest. Blend into the dry mixture. Stir in the cranberries and walnuts. Transfer to the loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 65 to 70 minutes, or until a wooden toothpick inserted at center comes out clean. Cool in pan 10 minutes, remove to wire rack and cool completely before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
