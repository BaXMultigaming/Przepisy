  "title": "Holiday Cranberry Nut Bread",
  "description": "This is a fast, festive bread for the Thanksgiving or Christmas holiday dinner table. Tart, fragrant and filled with nuts!",
  "authors": [
    "ANDROMEDA050456"
  ],
  "date_published": "2000-10-16T22:40:03-04:00",
  "date_modified": "2022-07-14T15:59:44-04:00",
