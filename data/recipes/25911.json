  "ingredients": [
    "2 tablespoons olive oil",
    "2 tablespoons balsamic vinegar",
    "4 ripe tomatoes, sliced",
    "3 tablespoons mayonnaise",
    "0.5 teaspoon dried parsley",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon black pepper",
    "3 tablespoons grated Parmesan cheese, divided",
    "4 slices bread, lightly toasted"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler to high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil and vinegar together in a shallow bowl until well combined; add tomatoes, marinate, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine mayonnaise, parsley, oregano, and black pepper in a small bowl; stir in 4 teaspoons Parmesan cheese until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place toasted bread slices on a baking sheet; spread mayonnaise mixture over slices. Top with marinated tomatoes; sprinkle with remaining Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook under the preheated broiler until cheese turns golden brown, about 5 minutes. Serve hot, open-faced or closed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
