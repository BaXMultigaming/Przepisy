  "yield": [
    "6",
    "1 (8x8-inch) casserole"
  ],
  "categories": [
    "Dinner"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "1 (16 ounce) package elbow macaroni",
    "0.25 cup butter",
    "0.25 cup all-purpose flour",
    "0.25 teaspoon dried thyme",
    "0.25 teaspoon cayenne pepper",
    "0.125 teaspoon white pepper",
    "3 cups milk",
    "1 teaspoon salt",
    "0.25 teaspoon Worcestershire sauce",
    "1 pinch ground nutmeg",
    "3 cups shredded sharp Cheddar cheese, divided",
    "1 teaspoon Dijon mustard",
    "0.5 cup panko bread crumbs",
    "1 tablespoon butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt 1/4 cup butter in a large saucepan over medium heat. When butter starts to foam and bubble, stir in flour; cook on medium heat until flour begins to turn pale yellow, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ylez5wkhajtp8Qj89Vceqw5ZC14=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219166-ChefJohnsMacaroniAndCheese-MFS-Step1-0082-62ee2b56941a472d84afc8d71be21d2b.jpg"
      ],
      "image": "assets/images/219166/step_03.webp"
    },
    {
      "text": "Add thyme, cayenne, and white pepper; cook and stir another minute, then whisk in 1 cup milk until smooth. Pour in remaining milk and whisk again. Bring sauce just to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in salt, Worcestershire sauce, and nutmeg. Simmer, whisking often, on medium-low heat until thickened, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn heat off, then add 2 1/4 cups Cheddar cheese; stir until melted and combined. Mix in Dijon mustard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xF4Xzlwa_Qo228-L0ToWT-Wy5Z4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219166-ChefJohnsMacaroniAndCheese-MFS-Step2-0094-436e0963ed224ebead7a6f8fdd7f7823.jpg"
      ],
      "image": "assets/images/219166/step_06.webp"
    },
    {
      "text": "Transfer macaroni into a 8x8-inch casserole dish, then pour in cheese sauce; stir to thoroughly combine pasta with sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together panko bread crumbs and 1 tablespoon melted butter in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle mixture over macaroni and cheese. Sprinkle remaining 3/4 cup Cheddar cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IqrUqTJiXVuGOVMO_siF_9HN1mQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219166-ChefJohnsMacaroniAndCheese-MFS-Step3-0106-a60342a21fef4c00891de7b324b41c47.jpg"
      ],
      "image": "assets/images/219166/step_09.webp"
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WoAnleSmuROMMtbb3ICS1cjKOMQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/219166-ChefJohnsMacaroniAndCheese-MFS-2X3-0124-3b5c759edb62482089109ef02726ab4d.jpg"
      ],
      "image": "assets/images/219166/step_10.webp"
    }
  ],
