  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.5 cup unsalted butter, melted",
    "0.25 cup non-fat plain yogurt",
    "1 cup packed brown sugar",
    "0.5 cup white sugar",
    "1 tablespoon vanilla extract",
    "1 egg",
    "1 egg yolk",
    "1 cup semisweet chocolate chips",
    "0.5 cup blueberries",
    "0.5 cup dried cranberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease baking sheets or line with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together flour and baking soda in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat melted butter, yogurt, brown sugar, and white sugar in a bowl until blended. Beat in vanilla extract, egg, and egg yolk until light and creamy; mix in flour mixture until just blended. Stir in chocolate chips, blueberries, and cranberries by hand using a wooden spoon. Drop 1/4 cup cookie dough 3-inches apart on prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until edges are lightly toasted, 15 to 17 minutes. Cool on baking sheets for 5 minutes before transferring to wire racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
