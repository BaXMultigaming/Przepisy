  "ingredients": [
    "1 gallon apple juice",
    "1 cup orange juice",
    "2 tablespoons lemon juice",
    "6 cinnamon sticks",
    "0.75 cup brown sugar",
    "4 teaspoons whole cloves",
    "2 teaspoons whole allspice",
    "1 orange, sliced"
  ],
  "steps": [
    {
      "text": "Pour apple juice, orange juice, and lemon juice into a large pot. Place the cinnamon sticks, brown sugar, cloves, and allspice onto the center of a 8 inch square piece of cheesecloth. Gather together the edges of the cheesecloth, and tie with kitchen twine to secure then add to the juice mixture. Float orange slices on top of the juices. Simmer over medium heat for 1 hour.",
