  "ingredients": [
    "1 cup butter, softened",
    "1 cup white sugar",
    "3 Hachiya persimmons, pulp extracted",
    "1 egg",
    "1.5 teaspoons vanilla extract",
    "3 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "2.5 cups chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, sugar, and persimmon pulp together in a large bowl with an electric mixer until light and fluffy; beat in egg and vanilla extract. Sift flour, baking soda, and salt together in a separate bowl; gradually add to persimmon mixture until thoroughly combined. Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of dough 1 inch apart onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 10 to 13 minutes. Cool on the baking sheet for 1 minute before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
