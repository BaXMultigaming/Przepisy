  "ingredients": [
    "1 cup butter, softened",
    "0.5 cup confectioners' sugar",
    "0.5 teaspoon salt",
    "0.125 teaspoon ground nutmeg",
    "1 egg yolk",
    "2 cups all-purpose flour",
    "1 (2.25 ounce) jar red decorator sugar",
    "1 (10 ounce) jar maraschino cherries, drained"
  ],
  "steps": [
