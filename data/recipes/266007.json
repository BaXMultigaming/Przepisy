  "ingredients": [
    "1 (12 ounce) can fully cooked luncheon meat (such as SPAM®), finely chopped",
    "4 hard-cooked eggs, peeled and chopped",
    "1 (8 ounce) package shredded Cheddar cheese",
    "0.5 cup finely chopped onion",
    "0.5 cup mayonnaise",
    "0.25 cup chili sauce",
    "0.5 teaspoon salt",
    "0.25 teaspoon hot sauce",
    "12 hamburger buns, split"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
