  "ingredients": [
    "1.5 cups eggnog",
    "1.5 cups cooked rice",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "0.5 cup half-and-half",
    "1 egg"
  ],
  "steps": [
    {
      "text": "Combine eggnog, rice, vanilla extract, nutmeg, and salt in a saucepan; cook and stir over medium heat until bubbling, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk half-and-half and egg together in a heatproof bowl; whisk in some of the hot eggnog mixture, whisking quickly to avoid scrambling the egg. Pour the mixture back into the saucepan; cook and stir until pudding is thick, about 5 minutes.",
      "section": null,
