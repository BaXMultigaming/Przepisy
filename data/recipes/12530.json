  "ingredients": [
    "1 (9 inch) pie crust, baked",
    "4 pink grapefruit",
    "0.5 cup white sugar",
    "1 tablespoon cornstarch",
    "0.75 cup grapefruit juice",
    "1 (3 ounce) package strawberry flavored Jell-O®"
  ],
  "steps": [
    {
      "text": "Peel grapefruit, removing all pith. Cut up into bite-size pieces. Drain in a strainer for 4 or more hours, collecting the juice. (This can be done the day before.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the sugar, cornstarch, and 3/4 cup juice in a small saucepan; if the collected juice does not measure 3/4 cup, top it off with water. Bring to a boil. Stir in strawberry gelatin. Cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread grapefruit in the bottom of the baked shell, and pour gelatin over the fruit. Chill several hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
