  "ingredients": [
    "1 (15.25 ounce) can whole kernel corn",
    "1 (14.75 ounce) can cream-style corn",
    "0.5 cup sour cream",
    "1 cup butter or margarine, melted",
    "2 eggs",
    "1 (12 ounce) package corn muffin mix"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
