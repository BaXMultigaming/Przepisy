  "title": "Rhubarb Upside Down Cake",
  "description": "This yummy rhubarb upside-down cake recipe is incredibly easy to make with boxed yellow cake mix, chopped fresh rhubarb, sugar, and marshmallows.",
  "authors": [
    "Doll Face"
  ],
  "date_published": "1999-06-22T20:26:42-04:00",
