  "ingredients": [
    "4 (4 ounce) fillets grouper",
    "0.25 cup fresh lime juice",
    "1 pinch red pepper flakes (to taste)",
    "salt and ground black pepper to taste",
    "1 tomato, thinly sliced",
    "1 onion, thinly sliced",
    "1 green bell pepper, thinly sliced"
