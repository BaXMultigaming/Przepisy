  "ingredients": [
    "1 pound ground beef",
    "1 (26 ounce) jar spaghetti sauce",
    "0.5 teaspoon garlic powder",
    "3 cups cooked rice, cooled",
    "2 eggs, lightly beaten",
    "0.75 cup shredded Parmesan cheese, divided",
    "2.25 cups shredded mozzarella cheese",
    "2 cups cottage cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in hot skillet until browned and crumbly, 5 to 7 minutes; drain and discard grease. Add spaghetti sauce and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix rice, eggs, and 1/4 cup Parmesan cheese in a bowl. Mix 2 cups mozzarella cheese, cottage cheese, and 1/4 cup Parmesan cheese in another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1/2 of the rice mixture in a 3-quart baking dish, followed by 1/2 of the cheese mixture and 1/2 of the meat sauce. Repeat layers. Sprinkle remaining 1/4 cup Parmesan cheese and 1/4 cup mozzarella cheese over final layer of meat sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and sauce is bubbly, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
