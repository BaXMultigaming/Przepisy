  "title": "Rice Lasagna",
  "description": "This cheesy beef lasagna-style dish uses cooked rice instead of noodles for a simple and delicious twist on traditional lasagna.",
  "authors": [
    "SarahD"
  ],
  "date_published": "2019-04-02T03:01:12-04:00",
