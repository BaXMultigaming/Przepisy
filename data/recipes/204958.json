  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 small onion, chopped",
    "1 teaspoon salt",
    "1 (1/2 inch) piece fresh ginger, chopped",
    "2 plum tomatoes, cut into 1/2-inch dice",
    "1 pound bone-in pork chops",
    "4 cups water, more if needed",
    "1 (1.41 ounce) package tamarind soup base (such as Knorr®)",
    "0.5 pound fresh green beans, trimmed"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a skillet over medium heat. Add onion; cook and stir until softened and translucent, about 5 minutes. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iNamA9YX0ZSPygTZV9zSpm_QeNk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/204958-pork-sinigang-mfs-step-1-6a49a6c5f05941bbbbe91ed06a471532.jpg"
      ],
      "image": "assets/images/204958/step_01.webp"
    },
    {
      "text": "Stir in ginger, tomatoes, and pork chops. Cover and reduce heat to medium-low. Turn the pork occasionally, until browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cvE-tL8rdOxjc93_6D7GsH81FMw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/204958-pork-sinigang-mfs-step-2-92d055ad6bf2419fa591ab7057a3feb4.jpg"
      ],
      "image": "assets/images/204958/step_02.webp"
    },
    {
      "text": "Pour in water and tamarind soup base. Bring to a boil, then reduce heat and simmer until the pork is tender and cooked through, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BkCLm2xPtMWMQxIj0rtulonlFAg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/204958-pork-sinigang-mfs-step-3-3b3cc82cc5c24631b82c51e51003c375.jpg"
      ],
      "image": "assets/images/204958/step_03.webp"
    },
    {
      "text": "Stir in green beans and cook until tender.",
      "section": null,
      "name": null,
      "url": null,
