  "ingredients": [
    "2 tablespoons bacon grease",
    "1 large onion, diced",
    "2 carrots, peeled and diced",
    "3 stalks celery, diced",
    "2 cloves garlic, crushed",
    "3 potatoes, diced",
    "8 cups hot water",
    "8 cubes chicken bouillon",
    "1 ham bone",
    "1 (14 ounce) can diced tomatoes",
    "0.5 (16 ounce) package frozen corn",
    "1 (8 ounce) can tomato sauce",
    "1 teaspoon black pepper",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Aik1-FBhngLG75lsEJV6lYEPC8o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235951_hearty-ham-bone-soup-VAT-001-Step1-1967784db9754153a5655dc78bb7fb90.jpg"
      ],
      "image": "assets/images/235951/step_01.webp"
    },
    {
      "text": "Melt bacon grease in a large skillet over medium-high heat. Cook and stir onion, carrots, celery, and garlic in hot bacon grease until vegetables are slightly tender and fragrant, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7j5h11FDoAmW8nNnbtaixWGelzU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235951_hearty-ham-bone-soup-VAT-002-Step2-C-8a0146a57ee74146b1498cd80b9f638f.jpg"
      ],
      "image": "assets/images/235951/step_02.webp"
    },
    {
      "text": "Stir potatoes into onion mixture; cook and stir until golden, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dNA7AEJZpjjQzGxM64BtBkJJYdM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235951_hearty-ham-bone-soup-VAT-005-Step3-B-90d018c5ed58459e9c5bfb4c6eac503e.jpg"
      ],
      "image": "assets/images/235951/step_03.webp"
    },
    {
      "text": "Stir hot water and chicken bouillon together in a slow cooker until bouillon is dissolved; add onion mixture, ham bone, diced tomatoes, corn, tomato sauce, black pepper, and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Su0mnjOlEH3yFS88lDXrZ-KllXc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235951_hearty-ham-bone-soup-VAT-007-Step4-B-776f0d42e2914414a07671915280c391.jpg"
      ],
      "image": "assets/images/235951/step_04.webp"
    },
    {
      "text": "Cook soup in the slow cooker set to Low for 4 to 6 hours. Remove ham bone from soup and let rest until cool enough to handle. Remove meat from ham bone and stir meat into soup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ez8sn8s87ZoJs9VoExYjw2eJC1g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/235951_hearty-ham-bone-soup-VAT-009-Step5-B-29082a59e74f4f45b09ba40acf2668ac.jpg"
