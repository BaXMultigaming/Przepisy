  "ingredients": [
    "3 medium beets",
    "1 cup butter",
    "4 (1 ounce) squares unsweetened chocolate",
    "1.5 cups all-purpose flour",
    "0.5 cup whole wheat flour",
    "1 tablespoon baking soda",
    "2 teaspoons salt",
    "1.5 cups white sugar",
    "3 eggs",
    "1 teaspoon vanilla extract",
    "1 cup bittersweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Place beets in a pot with water to cover. Bring to a boil and cook for 30 minutes. Remove skin and puree beets in a blender or food processor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Butter a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over low heat. Add unsweetened chocolate and stir until melted. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine all-purpose flour, whole wheat flour, baking soda, and salt in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and eggs together in a large bowl using an electric mixer until creamy. Add the melted chocolate, beets, and vanilla extract. Beat until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the flour mixture and chocolate chips into the beet mixture just until combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a fork inserted into the center comes out clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
