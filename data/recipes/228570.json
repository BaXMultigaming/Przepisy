  "ingredients": [
    "0.25 cup vegetable oil",
    "2 tablespoons all-purpose flour",
    "2 tablespoons chili powder",
    "1 (8 ounce) can tomato sauce",
    "1 cup water, or more if needed",
    "0.25 teaspoon cumin",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "2 tablespoons brown sugar",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Stir flour and chili powder into the oil; cook and stir until smooth. Gradually stir tomato sauce, water, cumin, garlic powder, onion powder, and brown sugar into the flour mixture, respectively. Reduce heat to low and cook until thickened, about 10 minutes.",
