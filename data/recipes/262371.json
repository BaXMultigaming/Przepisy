  "ingredients": [
    "0.5 cup coconut oil, melted",
    "2 eggs, beaten",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "1 pinch salt",
    "3 very ripe bananas, mashed",
    "0.5 (8 ounce) can crushed pineapple, drained",
    "0.5 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine coconut oil, eggs, and vanilla extract in a large bowl; whisk well to combine. Add flour, sugar, baking soda, cinnamon, and salt. Stir well until combined. Fold in bananas, pineapple, and coconut; stir until just blended. Pour batter evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool in the pan for 10 minutes. Remove to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
