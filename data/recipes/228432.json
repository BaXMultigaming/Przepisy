  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt",
    "3 very ripe bananas, mashed",
    "0.75 cup packed brown sugar",
    "1 tablespoon agave syrup",
    "1 egg, beaten",
    "0.33333334326744 cup unsweetened applesauce",
    "0.33333334326744 cup packed brown sugar",
    "2 tablespoons all-purpose flour",
    "0.125 teaspoon ground cinnamon",
    "1.5 teaspoons unsweetened applesauce"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Grease 12 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1 1/2 cup flour, baking soda, baking powder, and salt in a bowl. Beat bananas, 3/4 cup brown sugar, agave syrup, egg, and 1/3 cup applesauce in a separate bowl until thoroughly combined. Stir banana mixture into the dry ingredients to make a smooth batter. Fill muffin cups about 2/3 full of batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1/3 cup brown sugar, 2 tablespoons flour, and cinnamon in a bowl; stir 1 1/2 teaspoons of applesauce into the mixture until it resembles coarse crumbs. Sprinkle topping over muffins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly golden brown and a toothpick inserted into center of a muffin comes out clean, 18 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
