  "title": "Louisiana Sweet Potato Pancakes",
  "description": "This sweet potato pancake recipe combines mashed sweet potatoes and nutmeg with regular pancake batter for a delicious twist on classic pancakes.",
  "authors": [
    "SWIZZLESTICKS"
  ],
