  "ingredients": [
    "2 (16 ounce) packages small curd cottage cheese",
    "1 (16 ounce) container sour cream",
    "2 (8 ounce) packages shredded pepper Jack cheese",
    "2 bunches scallions, chopped",
    "0.5 cup chopped cilantro",
    "2 tablespoons Worcestershire sauce",
    "3 cloves garlic, minced",
    "2 teaspoons ground cumin",
    "1 teaspoon salt",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine cottage cheese, sour cream, pepper Jack cheese, scallions, cilantro, Worcestershire sauce, garlic, cumin, salt, and black pepper in a large bowl; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl with plastic wrap; refrigerate to allow flavors to develop, about 2 hours.",
