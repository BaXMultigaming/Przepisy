  "ingredients": [
    "olive oil, or as needed",
    "4 hamburger buns, cut into 1-inch cubes",
    "0.5 teaspoon garlic powder",
    "0.125 teaspoon dried oregano",
    "0.125 teaspoon ground thyme",
    "0.125 teaspoon dried basil",
    "salt to taste",
    "coarsely ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle olive oil over hamburger bun cubs in a large bowl; toss to coat. Spread cubes onto a baking sheet. Sprinkle garlic powder, oregano, thyme, basil, salt, and black pepper over the cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until brown and crispy, 8 to 10 minutes. Cool completely before storing in an airtight container for up to 2 weeks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
