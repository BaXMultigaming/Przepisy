  "ingredients": [
    "12 egg yolks",
    "1.75 cups white sugar",
    "2 quarts heavy whipping cream",
    "0.5 cup dark rum (such as Bacardi®)",
    "0.5 cup cognac",
    "2 teaspoons ground cinnamon",
    "2 teaspoons ground nutmeg",
    "1 teaspoon ground cloves"
  ],
  "steps": [
