  "ingredients": [
    "0.75 cup all-purpose flour",
    "1.5 tablespoons unsweetened cocoa powder",
    "0.5 teaspoon baking soda",
    "0.33333334326744 cup applesauce",
    "0.33333334326744 cup finely chopped kale",
    "0.33333334326744 cup white sugar",
    "1 tablespoon butter, softened",
    "1 egg white",
    "1 teaspoon vanilla extract",
    "1 tablespoon canola oil",
    "1 teaspoon honey",
    "2 tablespoons dark chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cocoa powder, and baking soda together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine applesauce and kale in a blender; blend until smooth, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, egg white, and vanilla with an electric mixer in a bowl until smooth and creamy; beat in kale mixture, canola oil, and honey. Stir flour mixture into kale mixture until dough is just mixed; fold in chocolate chips. Drop spoonfuls of dough onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are slightly hardened, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
