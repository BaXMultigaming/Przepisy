  "ingredients": [
    "0.5 cup brown sugar, firmly packed",
    "0.5 cup apple juice",
    "4 tablespoons vegetable oil",
    "1 tablespoon soy sauce",
    "0.5 teaspoon ground ginger",
    "salt and pepper to taste",
    "2 teaspoons cornstarch",
    "0.5 cup water",
    "6 boneless pork chops"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small saucepan, combine brown sugar, apple juice, oil, soy sauce, ginger, salt , and pepper. Bring to boil. Combine water and cornstarch in small bowl, and whisk into brown sugar mixture. Stir until thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush grate lightly with oil before placing pork chops on the grill. Cook over hot coals for 10 to 12 minutes, turning once. Brush with sauce just before removing chops from grill. Serve with remaining sauce.",
      "section": null,
      "name": null,
      "url": null,
