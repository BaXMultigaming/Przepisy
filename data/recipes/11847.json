  "ingredients": [
    "1 pound lean ground beef",
    "1 quart stewed tomatoes",
    "1.5 cups uncooked macaroni",
    "0.5 cup chopped onion",
    "1 clove garlic, minced",
    "1 tablespoon chili powder",
    "2 teaspoons paprika",
    "6 ounces tomato paste",
    "water, as needed"
  ],
  "steps": [
    {
      "text": "Heat a large saucepan over medium-high heat. Add ground beef; cook and stir until browned and crumbly, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low. Add stewed tomatoes, macaroni, onion, garlic, chili powder, and paprika; mix well. Stir in tomato paste. Simmer, adding a little water as needed if the mixture gets too dry, until macaroni is tender, about 20 minutes.",
