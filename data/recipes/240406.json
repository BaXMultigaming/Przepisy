  "ingredients": [
    "cooking spray",
    "12 whole fresh mushrooms, tough ends trimmed",
    "1 tablespoon vegetable oil",
    "1 tablespoon minced garlic",
    "1 (8 ounce) package cream cheese, softened",
    "0.25 cup grated Parmesan cheese",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rTg3RACXv41UkjDuJNaaYZnzHnQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240406-stuffed-cream-cheese-mushrooms-DDMFS_4x3_Step_01-ffa4c5441fa34fe08fbaafa20aecede9.jpg"
      ],
      "image": "assets/images/240406/step_01.webp"
    },
    {
      "text": "Clean mushrooms with a damp paper towel. Carefully break stems from mushrooms. Finely chop stems and set caps aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Pwa6dae2mb10sv0dOrfJDCQa1RI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240406-stuffed-cream-cheese-mushrooms-DDMFS_4x3_Step_02-1a16945f677d4bd8b9a4f4e3bf41c5eb.jpg"
      ],
      "image": "assets/images/240406/step_02.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Fry chopped mushroom stems and garlic in hot oil until any moisture has disappeared, taking care not to burn the garlic, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oReSuNST4zkfzJLtCOE6F62F6QI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240406-stuffed-cream-cheese-mushrooms-DDMFS_4x3_Step_03-2bdac8b4c3844d08814a48980e99f75a.jpg"
      ],
      "image": "assets/images/240406/step_03.webp"
    },
    {
      "text": "Spread mushroom mixture into a bowl to cool completely, about 10 minutes. Stir cream cheese, Parmesan cheese, black pepper, onion powder, and cayenne pepper into the cooled mushroom mixture until very thick and completely mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uFJWHsfqQYvaUVMnltdhJNRytoA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240406-stuffed-cream-cheese-mushrooms-DDMFS_4x3_Step_04-30d3f3028615411cab341e75a46d8f10.jpg"
      ],
      "image": "assets/images/240406/step_04.webp"
    },
    {
      "text": "Use a small spoon to fill each mushroom cap with a generous amount of stuffing. Arrange stuffed mushrooms on the prepared cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3iUSpes1sVXBQANd9bqzL3X8vGM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240406-stuffed-cream-cheese-mushrooms-DDMFS_4x3_Step_06-7a7b5245812c40e8a582f4d0766b602b.jpg"
      ],
      "image": "assets/images/240406/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until piping hot and liquid starts to form under each cap, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6co7n2UAtwv7mIUKEkkWks9eC70=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/240406-stuffed-cream-cheese-mushrooms-DDMFS_4x3_Beauty-574e786e730342e5b7c4036d336bfa66.jpg"
      ],
      "image": "assets/images/240406/step_06.webp"
    }
