  "ingredients": [
    "1 pound sliced bacon, cut into thirds",
    "1 (14 ounce) package beef cocktail wieners",
    "toothpicks",
    "0.75 cup brown sugar, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
