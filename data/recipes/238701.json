  "ingredients": [
    "1 very ripe banana",
    "0.5 cup applesauce",
    "0.5 cup honey",
    "0.33333334326744 cup almond butter",
    "0.25 cup butter",
    "1 egg",
    "0.66666668653488 cup coconut flour",
    "0.5 cup gluten-free oats",
    "0.5 cup dark chocolate chunks",
    "0.33333334326744 cup tapioca flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "dash salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash banana, applesauce, and honey together in a bowl; add almond butter, butter, egg and stir until combined. Add coconut flour, oats, chocolate chunks, tapioca flour, baking soda, cinnamon, and salt to banana mixture, stir until dry ingredients are moist and form a dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop rounded tablespoonfuls of dough onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until lightly brown, about 15 minutes. Let cool to room temperature, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
