  "ingredients": [
    "1 cup all-purpose flour",
    "1 (4.8 ounce) package graham crackers, finely crushed",
    "1.5 teaspoons baking powder",
    "1 stick unsalted butter, softened",
    "0.5 cup brown sugar",
    "1 large egg, divided",
    "0.33333334326744 cup cream cheese, softened",
    "0.25 cup white sugar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, crushed graham crackers, and baking powder in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and egg white together in a separate bowl with an electric mixer until creamy. Add to the dry ingredients and mix until moist.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, sugar, and egg yolk in another bowl; beat until creamy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a small ice cream scoop to scoop cookie batter onto the prepared baking sheet. Press a little pocket into the center of each cookie with a small spoon. Add equal amounts of cream cheese filling to each pocket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 12 minutes. Remove from the oven and let cool before removing from the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
