  "ingredients": [
    "0.5 medium head cabbage, shredded",
    "5 green onions, chopped",
    "1 (3 ounce) package chicken flavored ramen noodles, crushed, seasoning packet reserved",
    "0.25 cup sliced almonds",
    "2 tablespoons sesame seeds",
    "3 tablespoons white wine vinegar",
    "2 tablespoons vegetable oil",
    "2 tablespoons white sugar",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cabbage, green onions, and crushed ramen noodles in a large salad bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread almonds and sesame seeds evenly onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make dressing: Whisk together vinegar, oil, sugar, salt, pepper, and seasoning packet in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dressing over cabbage mixture; toss to coat evenly. Sprinkle with toasted almonds and sesame seeds.",
      "section": null,
