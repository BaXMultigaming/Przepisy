  "ingredients": [
    "0.5 cup DeKuyper® Triple Sec",
    "1 (750 milliliter) bottle dry white wine",
    "3 cups apple cider",
    "2 medium apples, cored and diced",
    "2 medium oranges, cut into wedges",
    "2 medium lemons, cut into wedges",
    "3 cinnamon sticks",
    "Ice",
    "Soda water"
  ],
