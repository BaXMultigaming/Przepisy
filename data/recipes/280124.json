  "ingredients": [
    "1.25 cups all-purpose flour",
    "0.5 cup salted butter, softened",
    "1.6666667461395 cups grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Mix the flour and butter together. Add Parmesan cheese and work into a solid dough. Form into a ball, wrap in plastic wrap, and refrigerate for at least 1 hour, or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out chilled dough between 2 sheets of parchment paper to a thickness of 1/8 to 1/4-inch. Use a small cookie cutter or a glass to cut out circles. Re-roll dough and cut out as many circles as possible. Place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 to 15 minutes. Transfer to a wire rack and cool before serving.",
      "section": null,
      "name": null,
      "url": null,
