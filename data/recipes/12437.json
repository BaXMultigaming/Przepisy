  "ingredients": [
    "3 eggs",
    "0.75 cup all-purpose flour",
    "0.75 cup white sugar",
    "0.75 cup packed brown sugar",
    "1 cup butter, melted",
    "1.5 cups semisweet chocolate chips",
    "1 cup chopped walnuts",
    "1 recipe pastry for a 9 inch single crust pie"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat the eggs until foamy. Mix in flour, sugar, and brown sugar until well blended. Blend in melted butter or margarine. Stir in chocolate chips and nuts. Pour filling into pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 1 hour. Remove from oven, and cool for 30 minutes before cutting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
