  "ingredients": [
    "1 cup fresh parsley",
    "0.75 cup extra virgin olive oil",
    "3 tablespoons red wine vinegar",
    "2 tablespoons dried oregano",
    "2 teaspoons ground cumin",
    "1.5 teaspoons minced garlic",
    "1.5 teaspoons pepper sauce (such as Frank's Red Hot®)",
    "1 teaspoon salt"
  ],
