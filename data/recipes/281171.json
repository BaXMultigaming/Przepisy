  "ingredients": [
    "2 (12 ounce) rings smoked sausage",
    "4 large potatoes, peeled and cubed",
    "1 medium head cabbage, cut into thin wedges",
    "aluminum foil",
    "0.5 cup salted butter",
    "2 teaspoons minced garlic",
    "1 teaspoon caraway seeds"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice the sausage links in half lengthwise, then cut into 3-inch chunks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the sausage, potatoes, and cabbage into a foil bag, or lay out on a sheet of foil to be made into a sealed pouch. Slice butter into pats and place over the mixture. Sprinkle on garlic and caraway seeds. Seal the bag or pouch to prevent leakage.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill, flipping over halfway through cook time, until sausage is browned and potatoes and cabbage are tender, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
