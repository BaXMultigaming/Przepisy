  "ingredients": [
    "0.25 cup cider vinegar",
    "2 tablespoons vegetable oil",
    "1 teaspoon white sugar",
    "0.5 teaspoon salt",
    "0.5 teaspoon chopped fresh dill weed",
    "0.25 teaspoon ground black pepper",
    "2 cucumbers, sliced",
    "2 ripe tomatoes, cut into wedges",
    "1 cup sliced red onion"
  ],
  "steps": [
    {
      "text": "Whisk vinegar, oil, sugar, salt, dill, and black pepper together in a large bowl. Add cucumbers, tomatoes, and onion; toss to coat. Set aside before serving, at least 15 minutes.",
