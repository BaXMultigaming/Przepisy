  "ingredients": [
    "4 eggs",
    "2 tablespoons butter",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "2 cups white sugar",
    "4 cups all-purpose flour",
    "0.25 cup anise seed"
  ],
  "steps": [
    {
      "text": "Beat eggs in large mixing bowl until very light.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add sugar and butter. Cream together until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking powder, and salt. Add dry ingredients and combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead dough until smooth ... add more flour to get a smooth dough if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover dough and allow to chill in refrigerator for at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll onto slightly floured board to 1/2 inch thickness. Then roll again with springerle roller to make designs. Cut at border. Sprinkle anise seed on clean tea towel and place cookies on this. Allow to stand overnight (don't cover) to dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 12 to 15 minutes at 325 degrees F (170 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool completely. Store in tight tin container ... the longer they are stored, the more anise flavor they take up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
