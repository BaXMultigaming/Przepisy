  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add fettuccine and boil until tender yet firm to the bite, about 8 minutes. Drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together Alfredo sauce, lemon juice, capers, lemon zest, and pepper in a small saucepan. Stir in tuna; cook over medium heat until heated through, about 5 minutes. Serve over fettuccine.",
