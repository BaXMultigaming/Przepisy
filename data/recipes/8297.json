  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "2 (5 ounce) packages instant vanilla pudding mix",
    "5 cups milk",
    "6 bananas",
    "2 (21 ounce) cans cherry pie filling",
    "2 (20 ounce) cans crushed pineapple, drained",
    "6 ounces flaked coconut",
    "1 (16 ounce) package frozen whipped topping, thawed",
    "0.25 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Bake cake mix according to package directions for two layers, let cakes cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare the pudding according to package with the 5 cups of milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange half of the cake pieces in the bottom of a large punch bowl. Spread with half of the pudding, then top with sliced bananas, drained pineapple, pie filling, and half of the coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Repeat in the same order with the remaining ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with whipped topping, then sprinkle with chopped walnuts. Chill and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
