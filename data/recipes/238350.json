  "ingredients": [
    "1 cup cooked rice",
    "0.5 small onion, chopped",
    "0.25 cup shredded Cheddar cheese",
    "1 large egg, beaten",
    "1 teaspoon minced garlic",
    "0.25 teaspoon salt",
    "0.25 teaspoon red pepper flakes",
    "0.25 teaspoon ground black pepper, or more to taste",
    "0.25 teaspoon chopped fresh parsley, or to taste",
    "1 pinch onion powder, or to taste",
    "1 tablespoon vegetable oil, or as needed"
  ],
  "steps": [
    {
      "text": "Mix together cooked rice, onion, Cheddar cheese, egg, garlic, salt, red pepper flakes, black pepper, parsley, and onion powder by hand in a large bowl until well combined. Cover the bowl with plastic wrap and refrigerate for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
