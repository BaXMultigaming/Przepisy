  "ingredients": [
    "3 cups mashed potatoes",
    "0.25 cup shortening",
    "3 tablespoons half-and-half",
    "0.75 cup all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Mix potatoes, shortening, and half-and-half in a bowl; cover with plastic wrap and let stand 8 hours or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, salt, and sugar with the potato mixture. Stir dough until uniform and form into 12 small balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place balls in refrigerator; remove one at a time to keep the rest cool. Roll dough out on a floured surface using a floured rolling pin, into a very thin circle slightly smaller than the diameter of your skillet. Use more flour as needed to prevent sticking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lefsa pan or skillet over medium-high heat. Cook the dough circle until bubbles form, about 1 minute; flip and cook until done, about 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Repeat rolling and cooking steps with the remaining dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
