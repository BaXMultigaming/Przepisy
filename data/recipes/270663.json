  "ingredients": [
    "2 (14 ounce) cans chicken broth",
    "2 cups fresh or frozen corn",
    "1 cup half-and-half cream",
    "0.33333334326744 cup chopped onion",
    "0.33333334326744 cup chopped sweet red pepper",
    "0.25 cup all-purpose flour",
    "3 tablespoons all-purpose flour",
    "0.5 cup cold water",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 cup Pure Farmland® Bacon, fully cooked, chopped",
    "1 cup Farmland® Cubed Ham",
    "1 sprig Snipped fresh dill"
  ],
  "steps": [
    {
      "text": "In a large saucepan, combine chicken broth, corn, cream, onion, and red pepper and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, combine flour, water, salt, and pepper until smooth and gradually stir into the saucepan. Bring back to a boil and stir for approximately 2 minutes, or until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add bacon and ham. Reduce heat and simmer for 10 to 15 minutes, or until veggies are desired tenderness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve and garnish with dill if desired.",
      "section": null,
