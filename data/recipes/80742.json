  "ingredients": [
    "2 tablespoons olive oil",
    "3 pounds beef sirloin, sliced into strips",
    "1 tablespoon minced garlic",
    "1 onion, chopped",
    "0.5 cup soy sauce",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "2 teaspoons white sugar",
    "3 green bell peppers, cut into strips",
    "1 tablespoon cornstarch",
    "0.25 cup cold water"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add steak strips, and quickly brown on both sides, adding garlic while the steak cooks. Transfer steak and its juices to a slow cooker. Add onion, soy sauce, salt, pepper and sugar. Cover, and cook on Low until the beef is fork tender, 6 to 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "One hour before the end of the cooking time, add green peppers. Stir cornstarch and cold water together in a small bowl; pour into the slow cooker during the last few minutes, and cook until the sauce has thickened.",
      "section": null,
      "name": null,
      "url": null,
