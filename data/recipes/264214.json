  "ingredients": [
    "1.5 cups lime juice",
    "3 tablespoons olive oil",
    "2 tablespoons chili powder",
    "1 teaspoon mayonnaise",
    "3 pounds uncooked medium shrimp, peeled and deveined",
    "0.5 cup enchilada sauce",
    "0.5 (4 ounce) jar diced jalapeno peppers",
    "5 teaspoons honey",
    "3 teaspoons lime juice",
    "salt to taste",
    "0.5 head red cabbage, shredded, or more to taste",
    "2 bunches scallions, chopped",
    "3 tablespoons olive oil",
    "3 tablespoons white vinegar",
    "1 small bunch cilantro, chopped",
    "20 (8 inch) corn tortillas"
  ],
  "steps": [
    {
      "text": "Mix lime juice, olive oil, chili powder, and mayonnaise together in a bowl. Add shrimp and marinade for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix enchilada sauce, jalapeños, honey, lime juice, and salt together in a separate bowl for sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss cabbage with scallions, olive oil, vinegar, and cilantro in a large bowl for slaw.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tortillas in a frying pan over medium-high heat, about 30 seconds per side. Keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove shrimp from marinade. Grill until opaque, about 5 minutes. Add shrimp to each tortilla; top with sauce and slaw.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
