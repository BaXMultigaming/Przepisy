  "ingredients": [
    "1 cup mashed strawberries",
    "0.75 cup water, or more if needed",
    "0.75 cup white sugar",
    "3 tablespoons cornstarch",
    "1 tablespoon lemon juice",
    "0.25 teaspoon salt",
    "4 cups sliced strawberries"
  ],
  "steps": [
    {
      "text": "Combine mashed strawberries and water in a saucepan; bring to a boil and simmer for about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain juice from cooked strawberries and add enough cold water to make 1 cup of juice. Discard pulp.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, cornstarch, lemon juice, and salt in a saucepan; stir strawberry juice into the sugar mixture. Bring to a boil, stirring constantly, until clear and thick, 3 to 5 minutes. Remove from heat and cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sliced strawberries into strawberry sauce until evenly coated. Chill before serving to allow filling to set completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
