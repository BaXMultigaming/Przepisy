  "ingredients": [
    "3 tablespoons butter",
    "8 eggs",
    "0.25 cup honey",
    "2.5 cups milk",
    "1 teaspoon vanilla extract",
    "0.66000002622604 cup all-purpose flour",
    "0.5 teaspoon salt",
    "1 cup blueberries",
    "0.5 teaspoon ground nutmeg",
    "3 tablespoons confectioners' sugar for dusting"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Place butter in a 9x13-inch baking dish and place the dish in the oven to melt butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a blender, combine eggs, honey, milk, vanilla, flour, and salt. Blend until smooth. Pour over melted butter in the hot dish. Sprinkle blueberries on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 20 to 25 minutes, until puffed and golden. Sprinkle with nutmeg and confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
