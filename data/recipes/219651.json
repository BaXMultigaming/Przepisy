  "ingredients": [
    "4 (1 ounce) squares unsweetened chocolate",
    "0.5 cup butter",
    "3 cups white sugar",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "1 (12 fluid ounce) can evaporated milk"
  ],
  "steps": [
    {
      "text": "Melt the chocolate and butter in a heavy pot over low heat, stirring constantly. Gradually stir in the sugar, vanilla extract, salt, and evaporated milk. Cook and stir until the mixture is thickened, 5 to 7 minutes.",
