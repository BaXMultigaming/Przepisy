  "ingredients": [
    "0.25 cup butter, softened",
    "0.125 cup white sugar",
    "0.125 cup brown sugar",
    "0.5 cup applesauce",
    "6 tablespoons Grade A maple syrup",
    "1 egg",
    "0.5 teaspoon vanilla extract",
    "0.5 cup all-purpose flour",
    "0.5 cup chopped walnuts",
    "0.5 cup quick-cooking oats",
    "0.25 cup whole wheat flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, white sugar, and brown sugar in a large bowl; beat with an electric mixer until creamy. Add applesauce, maple syrup, egg, and vanilla extract; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, walnuts, oats, whole wheat flour, baking powder, baking soda, cinnamon, and salt in a separate bowl. Add to the butter mixture, stirring just until all ingredients are moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 15 to 18 minutes. Allow to cool in the tin for several minutes before removing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
