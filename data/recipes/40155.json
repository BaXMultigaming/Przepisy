  "ingredients": [
    "2 cups fresh basil leaves",
    "4 cloves garlic, minced",
    "0.25 cup olive oil",
    "0.5 cup grated Parmesan cheese",
    "2 ounces pine nuts",
    "salt and pepper to taste",
    "1 pint light cream"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R7oLWKL1Wpr2g9QDDfUPzfom_p0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/40155-basil-cream-sauce-ddmfs-4x3-step-01-1284-3884d4be0a4b4632ad58a940f3670b64.jpg"
      ],
      "image": "assets/images/40155/step_01.webp"
    },
    {
      "text": "Combine basil and garlic in a food processor.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zdP-yjLCyLhj_NFiN2lqCUmmFrw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/40155-basil-cream-sauce-ddmfs-4x3-step-03-1287-1c4a116815714b42b50a25d2eaef4f75.jpg"
      ],
      "image": "assets/images/40155/step_02.webp"
    },
    {
      "text": "Pour oil in slowly, with the processor running, until mixture begins to emulsify, about 40 seconds. Add Parmesan, pine nuts, salt, and pepper; blend for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/u0Ik8X7RkXW8PSrIetYaJxDmTW4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/40155-basil-cream-sauce-ddmfs-4x3-step-04-1288-b0725486df17484382ae339cd6e6a881.jpg"
      ],
      "image": "assets/images/40155/step_03.webp"
    },
    {
      "text": "Bring cream to a simmer in a saucepan over low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lpeHnOFwjKFAWkjiua4BcYn_uHs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/40155-basil-cream-sauce-ddmfs-4x3-step-05-1291-9c2d894927f7421da9b6c00fb3a711f8.jpg"
      ],
      "image": "assets/images/40155/step_04.webp"
    },
    {
      "text": "Pour 1/2 of the hot cream into the food processor, and pulse for 20 seconds until incorporated with basil mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TI_fPU2UbAXUqqSLhdLCwDpvGTs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/40155-basil-cream-sauce-ddmfs-4x3-step-06-11295-b8df6dbc01a84355b41a5df1b1863fea.jpg"
      ],
      "image": "assets/images/40155/step_05.webp"
    },
    {
      "text": "Transfer basil-cream mixture to the saucepan. Stir with cream until well blended, then simmer until thickened, about 5 minutes.",
      "section": null,
      "name": null,
