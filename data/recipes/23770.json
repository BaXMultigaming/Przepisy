  "ingredients": [
    "1 egg",
    "0.5 cup brown sugar",
    "0.125 teaspoon salt",
    "0.5 teaspoon vanilla extract",
    "0.25 teaspoon lemon extract",
    "1 tablespoon melted butter",
    "0.5 cup raisins",
    "8 (3 inch) unbaked tart shells"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg in a large bowl. Mix in brown sugar and salt. Stir in vanilla and lemon extract. Beat until light and bubbly, then stir in melted butter. Fold in raisins. Drop filling by spoonfuls into tart shells.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Reduce oven temperature to 350 degrees F (175 degrees C); bake until filling is set and pastry is golden brown, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
