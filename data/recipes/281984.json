  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup white sugar",
    "0.25 cup cold salted butter, cubed",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon ground nutmeg",
    "cooking spray",
    "2.5 cups peeled, cored, and diced apples"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour, sugar, and butter in a medium bowl. Mix with fingers until crumbly. Stir in cinnamon, baking powder, and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray two 4 1/2-inch ramekins with cooking spray. Add some crumble to the bottom of ramekins; top with some apples. Repeat 2 more times, ending with mounded crumble on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the ramekins with large pieces of foil, tucking ends underneath to prevent it from flying off. Air fry until apples are tender, 16 to 20 minutes. Remove foil and air fry until top is golden, 2 to 4 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
