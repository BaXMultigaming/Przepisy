  "ingredients": [
    "4 slices bread",
    "0.25 cup raisins, or to taste",
    "0.125 teaspoon ground cinnamon, or to taste",
    "1 quart half-and-half",
    "1 cup white sugar",
    "4 large eggs",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange bread in a 9x13-inch baking dish; sprinkle with raisins and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend half-and-half, sugar, eggs, vanilla, and salt in a blender until smooth. Pour egg mixture over bread in the baking dish. Place the baking dish into a large roasting pan; fill the pan with boiling water halfway up the sides of the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, about 1 1/2 hours. Serve warm or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
