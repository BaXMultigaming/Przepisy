  "ingredients": [
    "3 cups dried navy beans",
    "water, to cover",
    "1.5 cups ketchup",
    "0.5 pound fully cooked ham",
    "1.5 cups water",
    "0.5 cup brown sugar",
    "0.25 cup molasses",
    "1.5 tablespoons onion powder",
    "1 tablespoon dry mustard",
    "1 tablespoon salt",
