  "ingredients": [
    "3 cups all-purpose flour",
    "1 cup white sugar",
    "4 teaspoons baking powder",
    "1 teaspoon salt",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "1.5 cups milk",
    "1 egg",
    "2 tablespoons vegetable oil",
    "1.5 cups diced apples"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C) and lightly grease a 9x5 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine flour, sugar, baking powder, salt, cinnamon and cloves. In a separate bowl, mix together milk, egg and oil until well blended. Stir milk mixture into flour mixture. Fold in apple. Pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 1 hour 20 minutes, until loaf springs back when touched lightly in center. Cool in pan 10 minutes before removing to wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
