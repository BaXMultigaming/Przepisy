  "ingredients": [
    "1 large head cauliflower, broken into small florets",
    "0.5 cup butter, melted",
    "0.25 cup grated Parmesan cheese",
    "0.66666668653488 cup Italian seasoned bread crumbs",
    "1 pinch salt",
    "1 teaspoon crushed red pepper flakes",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring 2 inches of water to a boil in a medium saucepan. Add cauliflower, cover, and cook for about 10 minutes. Drain, and place in a 2 quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl mix together butter, Parmesan cheese, bread crumbs, salt, and red pepper flakes. Sprinkle mixture over cauliflower, and top with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes, or until cheese is melted and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
