  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a rimmed baking sheet with aluminum foil; coat with nonstick spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out and separate crescent roll dough on a work surface.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate-hazelnut spread in a small resealable plastic bag, squeeze out excess air, and seal the bag; snip off one corner of the bag. Pipe chocolate-hazelnut spread onto each crescent roll, using a zig-zag motion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll up crescent roll dough, starting at larger edges. Place rolls on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed up and lightly browned, about 14 minutes. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
