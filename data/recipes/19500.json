  "title": "Seafood au Gratin",
  "description": "This seafood casserole au gratin is delicious and well worth the effort! Use the freshest seafood possible and serve in individual baking dishes.",
  "authors": [
    "JELI"
  ],
  "date_published": "2000-04-27T11:42:46-04:00",
