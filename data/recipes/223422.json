  "ingredients": [
    "1 (16 ounce) package elbow macaroni",
    "6 hard-cooked eggs, diced",
    "0.5 cup diced onion",
    "0.5 cup diced celery",
    "0.5 cup diced green bell pepper",
    "2 cups mayonnaise",
    "1 cup milk",
    "0.5 cup sweet pickle relish",
    "0.33333334326744 cup prepared honey mustard",
    "0.5 teaspoon sea salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook macaroni in boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Drain and rinse macaroni under cold water until chilled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chilled macaroni to a large serving bowl. Add hard-cooked eggs, onion, celery, and bell pepper; toss until salad is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together mayonnaise, milk, pickle relish, and honey mustard in a medium bowl until combined; pour over salad and stir to coat. Season with sea salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
