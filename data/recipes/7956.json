  "ingredients": [
    "10 tablespoons butter, softened",
    "1.5 cups white sugar",
    "4 eggs",
    "0.66666698455811 cup sour cream",
    "1 teaspoon vanilla extract",
    "2 tablespoons grated orange zest",
    "2 cups all-purpose flour",
    "0.66666698455811 cup unsweetened cocoa powder",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup chopped almonds"
  ],
  "steps": [
    {
      "text": "In a bowl, cream the butter with the sugar. Beat in the eggs, then the sour cream, vanilla and orange rind.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, stir together the flour, cocoa, baking soda and salt. Beat into the creamed mixture just until incorporated and then stir in the almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the batter into a greased and floured tube pan. Bake in a 350 degrees F (175 degree C) oven for 1 hour, or until it tests done with a toothpick. Let cool on a rack. Makes 16 servings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
