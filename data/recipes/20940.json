  "ingredients": [
    "2 quarts oil for frying",
    "4 eggs",
    "0.25 cup heavy cream",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon salt",
    "3 zucchini, quartered",
    "0.75 cup Italian-style dry bread crumbs"
  ],
  "steps": [
    {
      "text": "In a heavy saucepan or deep fryer, preheat oil to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a blender, mix the eggs, whipped cream, pepper and salt. Transfer the mixture to a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice the zucchini into pieces 2 to 3 inches long. Dip the pieces into the egg mixture, then coat them with the bread crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully place the battered pieces in the oil and fry 3 to 4 minutes, until brown and crispy. Drain fried pieces on a paper towel. Repeat until all the slices have been fried.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
