  "ingredients": [
    "1 tablespoon vegetable oil",
    "0.5 cup cashews",
    "2 green chile peppers, chopped",
    "1 large onion, chopped",
    "0.66666668653488 cup corn kernels",
    "0.5 cup paneer, cubed",
    "1 pinch salt to taste",
    "1 pinch white sugar",
