  "ingredients": [
    "0.25 cup butter or margarine, softened",
    "0.66666668653488 cup brown sugar",
    "1 egg",
    "1 cup applesauce",
    "1 cup all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 teaspoon pumpkin pie spice",
    "1.5 cups confectioners' sugar",
    "3 tablespoons margarine, melted",
    "1 tablespoon milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the butter, brown sugar and egg until smooth. Stir in applesauce. Combine the flour, baking soda, salt and pumpkin pie spice; stir into the applesauce mixture until well blended. Spread evenly into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 minutes in the preheated oven, or until edges are golden. Cool in the pan over a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix together the confectioners' sugar and margarine. Stir in vanilla and milk until smooth. Spread over cooled bars before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
