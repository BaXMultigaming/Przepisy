  "ingredients": [
    "2 tablespoons butter",
    "1.5 cups zucchini, sliced",
    "1.5 cups yellow squash, sliced",
    "1 red bell pepper, chopped",
    "0.75 cup white onion, diced",
    "0.5 cup chicken broth, or as needed",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 (6 ounce) package cornbread stuffing mix",
    "0.5 cup reduced-fat sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease a 7x7-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add zucchini, squash, bell pepper, onion, and chicken broth; bring to a simmer and cook until vegetables softened, about 10 minutes. Add more broth to keep mixture moist if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, stir condensed soup, ¾ stuffing mix, and sour cream into vegetables until well combined; transfer to the prepared dish. Sprinkle remaining ¼ stuffing mix over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
