  "ingredients": [
    "cooking spray",
    "2 pounds haddock fillets, each cut into thirds",
    "6 tablespoons butter, melted",
    "1 limes, juiced (with pulp)",
    "1 tablespoon dried dill weed",
    "1 teaspoon kosher salt",
    "1 teaspoon red pepper flakes",
    "1 onion, sliced crosswise 1/8-inch thick"
  ],
  "steps": [
    {
      "text": "Preheat grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay 4 8x10-inch pieces of aluminum foil onto a flat work surface and spray with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange equal amounts of the haddock into the center of each foil square.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir butter, lime juice, dill, kosher salt, and red pepper flakes together in a small bowl; drizzle evenly over each portion of fish. Top each portion with onion slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring opposing ends of the foil together and roll together to form a seam. Roll ends toward fish to seal packets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook packets on the preheated grill until fish flakes easily with a fork, 5 to 7 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
