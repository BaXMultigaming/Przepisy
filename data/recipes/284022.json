  "ingredients": [
    "1.25 pounds ground pork",
    "1 cup cooked rice",
    "0.33333334326744 cup minced red onion",
    "0.33333334326744 cup diced dried apricots",
    "1 tablespoon rice vinegar",
    "1 tablespoon sesame oil",
    "2 teaspoons ground coriander",
    "1 teaspoon salt, or to taste",
    "0.5 teaspoon white pepper",
    "0.25 teaspoon crushed red pepper flakes, or to taste",
    "1.5 cups apricot preserves",
    "0.33333334326744 cup hoisin sauce",
    "2 teaspoons grated fresh ginger",
    "2 teaspoons chili-garlic sauce",
    "1 medium lime, juiced",
    "2 tablespoons chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a 12x18-inch baking sheet with parchment paper or aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pork, cooked rice, onion, apricots, vinegar, sesame oil, coriander, salt, pepper, and pepper flakes in a medium mixing bowl; mix until well blended. Form into 24 meatballs, each about 1 1/2 inch in diameter. Place meatballs on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 30 to 35 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (71 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove meatballs from the oven and allow to cool for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt apricot preserves in a small saucepan over medium heat, 2 to 3 minutes. Stir in hoisin sauce, ginger, chili-garlic sauce, and lime juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place meatballs in a serving dish and pour glaze over top. Garnish with cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
