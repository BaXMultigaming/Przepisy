  "ingredients": [
    "6 medium sweet potatoes",
    "1 cup Dannon Oikos Plain Greek Nonfat Yogurt",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon ground nutmeg",
    "Kosher salt and cracked pepper to taste",
    "2 tablespoons brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven 400 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scrub sweet potatoes and then oven roast, skin on for 40-45 minutes or until soft to the touch. Cool slightly. Gently cut the top third off the sweet potatoes and scoop filing into a bowl. Reserve skins if using.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash potatoes with a fork. Add yogurt and spices and mix well. Spoon filling back into the skins or into 6 lightly buttered ramekins. Sprinkle each with 1 tsp. brown sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set to bake for 15-18 minutes or until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
