  "ingredients": [
    "1 (16 ounce) can refried beans",
    "1 (1.25 ounce) package taco seasoning mix",
    "1 large tomato, seeded and chopped",
    "1 cup sour cream, room temperature",
    "1 cup guacamole",
    "1 cup shredded sharp Cheddar cheese",
    "0.5 cup chopped green onions",
    "0.25 cup chopped black olives"
  ],
  "steps": [
    {
      "text": "Spread refried beans in the bottom of a 1-quart shallow glass serving dish. Sprinkle taco seasoning over beans; top with a layer of diced tomatoes, a layer of sour cream, and a layer of guacamole. Sprinkle Cheddar cheese evenly over dip; top with green onions and black olives.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate for 2 hours or until ready to serve.",
      "section": null,
      "name": null,
