  "ingredients": [
    "2 pounds yellow squash, cut in 1/4 inch slices",
    "2 sweet onions, quartered and separated",
    "1 red bell pepper, cut into 1/2 inch pieces",
    "1 pound fresh mushrooms, sliced",
    "1 (8 ounce) package shredded Monterey Jack cheese",
    "1 cup sour cream",
    "1 (4 ounce) can chopped green chile peppers",
    "2 fresh jalapeno peppers, chopped",
    "0.75 cup crushed tortilla chips"
  ],
  "steps": [
    {
      "text": "Lightly grease a large microwave-safe casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place squash, onions, and bell pepper in the prepared casserole dish. Microwave on high until tender, 10 minutes, stirring once.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently stir mushrooms, cheese, sour cream, green chiles, and jalapeños into squash mixture; sprinkle with crushed tortilla chips. Cover the dish with a microwave-safe cover; microwave on medium-high power until cheese melted and casserole heated through, 10 minutes.",
      "section": null,
