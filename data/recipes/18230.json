  "ingredients": [
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon salt",
    "0.25 teaspoon white pepper",
    "1 teaspoon chicken bouillon granules",
    "2 tablespoons finely chopped onion",
    "1.5 cups half-and-half cream",
    "0.5 pound medium shrimp - peeled and deveined",
    "0.5 pound pre-cooked crab meat",
    "0.5 cup white wine"
  ],
  "steps": [
    {
      "text": "In a large saucepan, melt butter over a low heat. Stir in flour, salt, white pepper, bouillon granules, and onion. Blend 3/4 cup half-and-half cream into the mixture. Mix in shrimp and crab meat. Turn the temperature to medium heat and continue stirring until the mixture thickens.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend the remaining half-and-half cream and wine into the mixture. Serve and enjoy!",
