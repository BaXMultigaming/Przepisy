  "ingredients": [
    "1 cup rolled oats",
    "0.5 cup pumpkin seeds",
    "0.5 cup walnuts",
    "0.5 cup pecans",
    "15 pitted Medjool dates",
    "0.5 cup brown rice syrup",
    "1 cup mini chocolate chips",
    "0.5 cup shredded coconut",
    "0.5 cup raisins",
    "0.25 cup sunflower seeds"
  ],
  "steps": [
    {
      "text": "Burst oats into a coarse meal in the bowl of a food processor. Add pumpkin seeds, walnuts, and pecans; pulse 10 to 15 times, until chunks are desired size.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss dates into the food processor and mix for 30 seconds. Pour rice syrup in slowly, with the processor running, until combined and starting to ball up.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a bowl and mix in chocolate chips, coconut, raisins, and sunflower seeds. Pull off dough in 25 gram sections and roll into balls. Place in a single layer on a cookie sheet; it's okay if they touch but make sure they are not stacked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate for 2 to 24 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
