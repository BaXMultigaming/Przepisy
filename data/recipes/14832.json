  "ingredients": [
    "0.5 cup soy sauce",
    "3 tablespoons white sugar",
    "2 tablespoons minced onion",
    "2 cloves garlic, minced",
    "2 teaspoons ground ginger",
    "0.25 cup sesame seeds",
    "2 tablespoons vegetable oil",
    "1 pound pork tenderloin"
  ],
  "steps": [
    {
      "text": "Mix together soy sauce, sugar, onion, garlic, ginger, sesame seeds, and oil in a large dish. Add pork; turn to coat. Cover and refrigerate for 3 hours, turning and basting often.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pork from marinade, reserving marinade; transfer pork to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 45 minutes. Cut into 1/4-inch-thick slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While meat is roasting, boil reserved marinade for 3 to 5 minutes. Serve with pork strips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
