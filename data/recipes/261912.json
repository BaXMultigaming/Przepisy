  "ingredients": [
    "1 teaspoon olive oil",
    "0.5 white onion, chopped",
    "3 cloves garlic, crushed",
    "3 cups chopped cauliflower",
    "1 cup vegetable broth",
    "1 tablespoon nutritional yeast",
    "2 teaspoons Himalayan salt",
    "1.5 teaspoons lemon juice",
    "0.5 teaspoon soy sauce"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a saucepan over medium heat. Add onion and cook until soft, about 3 minutes. Add garlic and cook for 1 minute more. Add cauliflower and vegetable broth; cover with lid and simmer over medium heat until tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cauliflower mixture in a blender. Add nutritional yeast, salt, lemon juice, and soy sauce; blend until smooth and creamy, about 3 minutes.",
      "section": null,
