  "ingredients": [
    "8 cups water",
    "1 teaspoon garlic powder",
    "1 tablespoon hot pepper sauce",
    "2 carrots, sliced thin",
    "4 ounces fresh mushrooms",
    "1 (10 ounce) package frozen okra, thawed and sliced",
    "0.25 cup uncooked wild rice",
    "1 skinless, boneless chicken breast half - cut into cubes",
    "1.5 cups uncooked rotini pasta",
    "salt and ground black pepper to taste",
    "3 green onions, thinly sliced"
  ],
  "steps": [
    {
      "text": "Bring water to a boil. Season with garlic powder and hot pepper sauce. Add in carrots and mushrooms. Cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add okra, wild rice, and chicken. Reduce the heat to low, and cook for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pasta and cook for 10 minutes. Season with salt and pepper. Serve hot, garnished with green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
