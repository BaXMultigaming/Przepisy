  "ingredients": [
    "1.5 pounds zucchini, halved",
    "1.5 cups dry bread crumbs",
    "2 ounces shredded Cheddar cheese",
    "0.25 cup minced onion",
    "2 tablespoons chopped fresh parsley",
    "1.25 teaspoons salt",
    "2 eggs, beaten",
    "0.25 cup grated Parmesan cheese, divided",
    "2 tablespoons butter, diced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of salted water to a boil. Add zucchini and cook until tender, about 15 minutes; drain. Scoop out the flesh of the zucchini to make a boat shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine zucchini flesh, bread crumbs, Cheddar cheese, onion, parsley, salt, eggs, and most of the Parmesan cheese in a medium bowl; stuff zucchini boats with mixture. Dot tops of stuffed zucchini with butter and sprinkle with remaining Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
