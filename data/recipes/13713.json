  "ingredients": [
    "6 sweet potatoes",
    "1 (20 ounce) can crushed pineapple",
    "1 cup packed brown sugar",
    "1 pinch ground cinnamon",
    "1 pinch ground ginger",
    "1 pinch ground nutmeg",
    "1 pinch ground cloves"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Butter one 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a pot of salted water to a boil. Add potatoes; cook until tender but still firm. Drain, and transfer to a large bowl to cool. Peel and quarter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a sauce pan, combine pineapple, sugar, cinnamon, ginger, nutmeg and cloves. Bring to boil and reduce heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange potatoes in a single layer in baking dish. Pour sauce over potatoes and bake for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
