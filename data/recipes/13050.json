  "ingredients": [
    "0.5 cup butter",
    "6 tablespoons all-purpose flour",
    "2 cups milk, or more as needed",
    "2 cubes chicken bouillon",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan. Add flour and make a paste. Add milk and bouillon. Cook over low heat until thickened. Add pepper to taste. Add more milk when adding the other soup ingredients, depending on the thickness you desire.",
