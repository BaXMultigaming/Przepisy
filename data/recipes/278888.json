  "ingredients": [
    "1 serving nonstick cooking spray",
    "1 cup diced onion",
    "1 cup diced bell pepper",
    "2 teaspoons salt, divided",
    "2 cups chicken broth",
    "1 (10 ounce) can diced tomatoes and green chiles (such as RO*TEL®)",
    "1 (10 ounce) can condensed cream of mushroom soup",
    "1 (4 ounce) can chopped green chiles (such as Ortega®)",
    "2 tablespoons oil",
    "1 tablespoon taco seasoning",
    "0.5 teaspoon ground cumin",
    "0.25 teaspoon ground black pepper",
    "1 pound skinless, boneless chicken breast",
    "1 (8 ounce) package Neufchatel cheese, softened"
  ],
  "steps": [
    {
      "text": "Spray a slow cooker with cooking spray. Add onions, bell pepper, and 1 teaspoon salt. Stir in chicken broth, diced tomatoes, condensed soup, and chiles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oil, taco seasoning, 1 teaspoon salt, cumin, and black pepper in a bowl. Add chicken and toss to coat on all sides. Transfer to the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oLYEnN34DrLZataI8XEMGFi_RVM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/278888-slow-cooker-creamy-chicken-taco-soup-step-1-0311-1-212921831bc64cf5a614e0f2f02f2c54.jpg"
      ],
      "image": "assets/images/278888/step_02.webp"
    },
    {
      "text": "Cook on Low until chicken is no longer pink in the center and the juices run clear, 2 to 3 hours. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C). Remove from the slow cooker and shred.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xZ0yOO_ZdG5JMVuj9-I9sJqU03s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/278888-slow-cooker-creamy-chicken-taco-soup-step-2-0316-1-6050357738f4460ba2b7f457b26e07e5.jpg"
      ],
      "image": "assets/images/278888/step_03.webp"
    },
    {
      "text": "Add Neufchatel cheese to the slow cooker and stir until melted. Return chicken to the slow cooker and cook until warmed through, 20 to 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xrcJq0OvdtqZ64vR6tBCdVKfR_A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/278888-slow-cooker-creamy-chicken-taco-soup-step-4-0318-1-6a778c61cb6d4b18889e3d7bf9b74f07.jpg"
      ],
      "image": "assets/images/278888/step_04.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
