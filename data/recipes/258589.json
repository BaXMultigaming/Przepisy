  "ingredients": [
    "0.5 cup green lentils",
    "7 ounces soft tofu, drained and cut into cubes",
    "1 cup fresh spinach leaves, thinly sliced",
    "1 teaspoon white sugar",
    "0.5 teaspoon salt",
    "ground black pepper to taste",
    "0.75 cup all-purpose flour",
    "vegetable oil for frying",
    "1 cup sunflower seed oil",
    "0.5 cup unsweetened soy milk",
    "2 teaspoons apple cider vinegar",
    "sea salt to taste"
  ],
  "steps": [
    {
      "text": "Place lentils into a large container and cover with several inches of cool water; soak for 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place lentils, tofu, spinach, sugar, 1/2 teaspoon salt, and pepper in a bowl; mix by hand. Incorporate flour until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat vegetable oil in a saucepan over medium heat. Drop rounded teaspoonfuls of the tofu mixture gently into the hot oil. Fry until golden brown, about 2 minutes per side. Drain on a paper towel-lined plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sunflower seed oil, soy milk, apple cider vinegar, and sea salt in a bowl; blend with an immersion blender until mayonnaise is smooth. Serve with tofu bites.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
