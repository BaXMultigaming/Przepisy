  "ingredients": [
    "2 cups buttermilk",
    "2 teaspoons baking soda",
    "2 cups white sugar",
    "2.5 tablespoons butter, softened",
    "2 eggs",
    "3 cups all-purpose flour",
    "2.5 tablespoons unsweetened cocoa powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x12-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir buttermilk and baking soda together in a bowl until dissolved and foaming.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a bowl using an electric mixer until smooth and creamy. Beat the first egg into butter mixture until completely blended; beat in the second egg until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour and cocoa powder together in a bowl. Beat flour mixture, alternating with buttermilk mixture, into creamed butter mixture using an electric mixer until batter is smooth. Pour batter into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of the cake comes out clean, 30 to 40 minutes. Cool cake for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
