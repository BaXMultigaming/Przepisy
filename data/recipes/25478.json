  "ingredients": [
    "2.5 pounds new potatoes, thinly sliced",
    "1 large sweet potato, thinly sliced",
    "2 Vidalia onions, sliced 1/4 inch thick",
    "0.5 pound fresh green beans, cut into 1 inch pieces",
    "1 sprig fresh rosemary",
    "1 sprig fresh thyme",
    "2 tablespoons olive oil",
    "salt and pepper to taste",
    "0.25 cup olive oil"
  ],
  "steps": [
    {
      "text": "Preheat grill for high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine the new potatoes, sweet potato, Vidalia onions, green beans, rosemary, and thyme. Stir in 2 tablespoons olive oil, salt, and pepper to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Using 2 to 3 layers of foil, create desired number of foil packets. Brush inside surfaces of packets liberally with remaining olive oil. Distribute vegetable mixture evenly among the packets. Seal tightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place packets on the preheated grill. Cook 30 minutes, turning once, or until potatoes are tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
