  "ingredients": [
    "1.5 cups all-purpose flour",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 teaspoon cinnamon",
    "1 teaspoon pumpkin pie spice",
    "4 bananas, mashed",
    "2 eggs",
    "2 (4 ounce) containers applesauce",
    "0.25 cup real maple syrup",
    "0.25 cup agave nectar",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, salt, cinnamon, and pumpkin pie spice in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bananas and eggs in a second bowl and beat using an electric mixer until well combined. Mix applesauce, maple syrup, agave nectar, and vanilla extract into the bowl. Add banana mixture to flour mixture and mix using a spatula until fully moistened. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 80 to 90 minutes. Cool on a wire rack for 5 minutes. Run a table knife around the edges to loosen. Invert carefully onto a serving plate or cooling rack. Let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
