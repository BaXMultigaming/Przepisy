  "title": "Totally Natural Maple-Banana Bread",
  "description": "This banana bread is made with maple syrup instead of sugar. It uses all natural ingredients and is incredibly moist with a great taste.",
  "authors": [
    "v4j"
  ],
  "date_published": "2020-04-24T16:39:58-04:00",
