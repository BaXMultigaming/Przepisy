      ],
      "image": "assets/images/276505/step_02.webp"
    },
    {
      "text": "Sprinkle cornflakes on top, then drizzle with remaining melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mEFhh0ru-5Rm-7MeexHDqbMyZ5o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/276505-grandmas-hashbrown-casserole-PICS-step-03-203a0874d16d44d98d7ee68353c93987.jpg"
