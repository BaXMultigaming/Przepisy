  "title": "Lemon Pie without Condensed Milk",
  "description": "Made without condensed milk, this easy, no-bake, chilled lemon pie is prepared with lemon instant pudding mix, pie filling, cream cheese, and whipped topping for sweet flavor.",
  "authors": [
    "Barbara West Smith"
  ],
  "date_published": "2013-01-01T22:57:42-05:00",
