  "ingredients": [
    "0.5 bunch leeks",
    "0.25 cup water, or as needed",
    "1 tablespoon dry white wine",
    "1 pinch salt",
    "0.25 cup capers",
    "0.25 cup Dijon vinaigrette"
  ],
  "steps": [
    {
      "text": "Chop off the root and dark green ends off the leek. Keep only the whites and light green center. Slice leek in half lengthwise, then slice each half lengthwise into quarters.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour water into a saucepan. Add white wine and salt, and bring to a simmer over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add leeks to the hot liquid and reduce heat to medium-low. Cover saucepan and simmer until leeks are fork-tender, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, pour capers into a mesh strainer and run under the faucet for about 5 minutes to wash off the brine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain leeks and arrange on plates. Sprinkle with vinaigrette and capers. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
