  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup white sugar",
    "0.25 teaspoon salt",
    "2 cups cranberries",
    "0.5 cup chopped walnuts",
    "0.5 cup butter, melted",
    "2 large eggs, beaten",
    "1 teaspoon almond extract"
