  "ingredients": [
    "0.5 cup butter",
    "0.25 cup vegetable shortening",
    "1 cup white sugar",
    "0.5 cup brown sugar",
    "2 eggs",
    "1.5 teaspoons vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.25 cup unsweetened cocoa powder",
    "0.125 teaspoon salt",
    "1 (12 ounce) package peanut butter chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, shortening, white sugar, and brown sugar with an electric mixer in a large bowl until smooth. Beat the first egg into the butter until completely blended, then beat in the vanilla with the second egg. Mix flour, baking powder, cocoa powder, and salt in another bowl; mix the flour mixture into the butter mixture until just incorporated. Fold in peanut butter chips, mixing just enough to evenly combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop spoonfuls of the dough 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until cookies are set, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
