  "ingredients": [
    "0.5 cup butter, melted",
    "2 large peaches, peeled and sliced",
    "1.5 cups white sugar, divided",
    "1 cup all-purpose flour",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "1 pinch ground nutmeg",
    "0.75 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Pour butter into an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine peaches and 3/4 cup sugar together in a bowl. Whisk flour, remaining sugar, baking powder, salt, and nutmeg together in a bowl; stir in milk just until batter is combined. Pour batter over butter and top with peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cobbler is golden brown, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
