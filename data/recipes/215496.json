  "ingredients": [
    "1 head napa cabbage, chopped",
    "0.25 cup salt, divided",
    "6 cloves garlic",
    "1 (1 inch) piece fresh ginger root, peeled and chopped",
    "1 small white onion, peeled and chopped",
    "2 tablespoons water",
    "3 green onions, minced",
    "1 ripe persimmon, chopped",
    "1 cucumber, diced",
    "1 small radish, shredded",
    "cayenne pepper to taste"
  ],
  "steps": [
    {
      "text": "Rinse cabbage well. Put cabbage in a bowl and sprinkle liberally with salt, tossing to mix. Set aside for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix more salt into cabbage and set aside for another hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash and drain cabbage. Combine onion, garlic, and ginger in a blender with water. Blend on high speed until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together rinsed drained cabbage, garlic-ginger mixture, minced green onions, persimmon, cucumber, radish, and cayenne pepper, and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer mixture into airtight containers and refrigerate for 3 days before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
