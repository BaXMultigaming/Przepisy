  "ingredients": [
    "2 cups white sugar",
    "0.5 cup margarine",
    "0.5 cup almond milk",
    "4 tablespoons unsweetened cocoa powder",
    "0.5 cup peanut butter",
    "1 teaspoon vanilla extract",
    "1 teaspoon almond extract",
    "2.5 cups quick oats",
    "1 cup sweetened flaked coconut"
  ],
  "steps": [
    {
      "text": "Combine sugar, margarine, almond milk, and cocoa in a saucepan. Bring to a boil, about 5 minutes. Let boil for 1 minute and remove from heat. Stir in peanut butter until melted. Pour in vanilla extract and almond extract and stir well. Add oats and coconut and mix dough until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop cookie dough by tablespoons onto wax paper. Let set and cool completely, about 30 minutes.",
