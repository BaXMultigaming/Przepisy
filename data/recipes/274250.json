  "ingredients": [
    "cooking spray",
    "1 (15 ounce) can pumpkin puree",
    "0.75 cup melted butter",
    "0.75 cup brown sugar",
    "0.25 cup water",
    "2 eggs",
    "1 teaspoon vanilla extract",
    "1.75 cups all-purpose flour",
    "0.5 cup white sugar",
    "2 teaspoons pumpkin pie spice",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 14 muffin cups or line with paper liners sprayed with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/o9ha73-QIaf5F7pGwTPj9t_Mn8s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-274250-perfect-pumpkin-muffins-VAT-step-01-1802a740b86b4aafaf403565301d0ac9.jpg"
      ],
      "image": "assets/images/274250/step_01.webp"
    },
    {
      "text": "Mix pumpkin, butter, brown sugar, water, eggs, and vanilla extract together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wWKGnhqEoaRHy4q3ZDZ6hXH0zKU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-274250-perfect-pumpkin-muffins-VAT-step-02-1-69ad005150f4495d9fab39d9f8c99ac8.jpg"
      ],
      "image": "assets/images/274250/step_02.webp"
    },
    {
      "text": "Mix flour, white sugar, pumpkin spice, salt, baking soda, cinnamon, and baking powder together in another large bowl; pour into pumpkin mixture. Stir until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IVFKi0-akcslPKrLK6V6grGn-S8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-274250-perfect-pumpkin-muffins-VAT-step-03-1-821cb5e8987c4b3ea576ab37cbf91f66.jpg"
      ],
      "image": "assets/images/274250/step_03.webp"
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KjYGBqPnYQZBDq6dDBET7U0rqEc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-274250-perfect-pumpkin-muffins-VAT-step-04-68484de43cb34425a32ac3f578c391f1.jpg"
      ],
      "image": "assets/images/274250/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until muffins are golden and spring back easily when pressed, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Bq8tp5s17hgBOP4dqnNl8D_oxl0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-274250-perfect-pumpkin-muffins-VAT-step-05-670bd22d3f4f4577a2ce3295e169898c.jpg"
