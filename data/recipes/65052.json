  "ingredients": [
    "16 ounces uncooked elbow macaroni",
    "4 carrots, shredded",
    "1 large red onion, chopped",
    "0.5 green bell pepper, seeded and chopped",
    "0.5 red bell pepper, seeded and chopped",
    "1 cup chopped celery",
    "2 cups mayonnaise",
    "1 (14 ounce) can sweetened condensed milk",
    "0.5 cup white sugar",
    "0.5 cup white vinegar",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RsU7EXvNUKDYZf-LBFgIaNhg__Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/65052-MomsBestMacaroniSalad-ddmfs-Step1-3x4-8257-15ab4b7080d14510bced906da141bc83.jpg"
      ],
      "image": "assets/images/65052/step_01.webp"
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes. Rinse under cold water; drain and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6YRLgPTOctPGls86kCMHgjj26zo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/65052-MomsBestMacaroniSalad-ddmfs-Step2-3x4-8270-26c6eb4e9a4b430ab85af84e3a6c48f8.jpg"
      ],
      "image": "assets/images/65052/step_02.webp"
    },
    {
      "text": "Stir together carrots, red onion, bell peppers, and celery in a large serving bowl. Mix in mayonnaise, condensed milk, sugar, vinegar, salt, and pepper until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QO5x2v3-z_F7N4HgPpcBjhqnPPo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/65052-MomsBestMacaroniSalad-ddmfs-Step4-3x4-8262-8b2f0f5880934ebca6311f5c067febd9.jpg"
      ],
      "image": "assets/images/65052/step_03.webp"
    },
    {
      "text": "Add macaroni; toss gently, then cover and refrigerate for at least 8 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vzZfv1J9L60vdMhWvjYRw3UN7yE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/65052-MomsBestMacaroniSalad-ddmfs-Step5-3x4-8264-d2749fedfa884a5f98186ec840c18965.jpg"
      ],
      "image": "assets/images/65052/step_04.webp"
    },
    {
      "text": "Enjoy!",
