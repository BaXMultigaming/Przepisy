  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup vegan chocolate chips",
    "0.5 cup vegan white sugar",
    "1 tablespoon flax seeds",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1.5 cups almond milk",
    "3 tablespoons water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a cookie sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, chocolate chips, sugar, flax seeds, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk almond milk and water together in a separate bowl. Pour into the dry ingredients and mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, 15 to 18 minutes. Cool on the baking sheet for 3 minutes before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
