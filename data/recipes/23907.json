  "ingredients": [
    "1 cup quick cooking oats",
    "1 cup buttermilk",
    "0.33333298563957 cup brown sugar",
    "0.33333298563957 cup applesauce",
    "0.25 cup molasses",
    "2 eggs",
    "1.3333300352097 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "1.5 cups pitted and diced fresh peaches",
    "2 tablespoons white sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Grease muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together oats, buttermilk, brown sugar, applesauce, molasses and eggs. In a separate bowl, stir together flour, baking soda and baking powder. Stir flour mixture into eggs mixture, just until moistened. Fold in peaches. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 15 minutes. While muffins are baking, combine 2 tablespoons sugar and 1/2 teaspoon cinnamon. After 15 minutes of baking, remove muffins from oven and sprinkle with cinnamon sugar. Return to oven and continue baking for 3 minutes, until a toothpick inserted into center of a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
