  "ingredients": [
    "1.5 cups water",
    "1 cup uncooked quinoa, rinsed",
    "1 small red onion, finely chopped",
    "0.5 cup minced carrots",
    "0.5 cup dried cranberries",
    "0.25 cup red bell pepper, chopped",
    "0.25 cup yellow bell pepper, chopped",
    "0.25 cup chopped fresh cilantro",
    "0.25 cup toasted sliced almonds",
    "1 lime, juiced",
    "1.5 teaspoons curry powder",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring water to a boil, covered, in a saucepan over high heat; add quinoa. Reduce heat to low; simmer quinoa, covered, until water has been absorbed, 15 to 20 minutes. Transfer to a bowl; refrigerate until cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in red onion, carrots, cranberries, red bell pepper, yellow bell pepper, cilantro, almonds, lime juice, and curry powder; season with salt and black pepper. Chill before serving.",
