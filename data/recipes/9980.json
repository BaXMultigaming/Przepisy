  "ingredients": [
    "1.5 cups shortening",
    "1.5 cups peanut butter",
    "2 cups packed brown sugar",
    "3 eggs",
    "2 teaspoons vanilla extract",
    "3 cups quick cooking oats",
    "2 cups whole wheat flour",
    "2 teaspoons baking soda",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, cream shortening and peanut butter. Add brown sugar, eggs, and vanilla; mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine oats, flour, baking soda, and salt in a separate bowl; add to the creamed mixture and mix well. Drop by rounded teaspoonfuls onto ungreased baking sheets. Flatten with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
