  "ingredients": [
    "8 ounces feta cheese",
    "1 egg",
    "1 teaspoon finely chopped fresh oregano",
    "0.5 cup all-purpose flour",
    "2 tablespoons olive oil",
    "freshly ground black pepper",
    "2 large ripe tomatoes, sliced",
    "1 lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Slice feta into 2x3/8 inch squares, about 8 slices. In a small bowl, beat the egg with the oregano. Dip each slice of feta in egg, shake off excess, and coat in flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a frying pan over medium heat. Quickly cook cheese in olive oil until golden, turning once. Pat dry with paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange feta on a plate with thick tomato slices, season with black pepper, and garnish with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
