        "https://www.allrecipes.com/thmb/1CgRqiAMVRJt305_9HpZScWoFiQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17515-quiche-lorraine-i-ddmfs-Step-03-bb438a4bc4994fa2af9cc09141a40b4f.jpg"
