  "ingredients": [
    "12 slices bacon",
    "1 cup shredded Swiss cheese",
    "0.33333334326744 cup minced onion",
    "1 (9 inch) prepared pie crust",
    "2 cups light cream",
    "4 large eggs, beaten",
    "0.75 teaspoon salt",
    "0.25 teaspoon white sugar",
    "0.125 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
