  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "2 teaspoons ground cinnamon",
    "2 teaspoons baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground cloves",
    "1 cup vegetable oil",
    "2 eggs",
    "2 cups applesauce",
    "0.5 cup chopped walnuts",
    "0.5 cup raisins",
    "1 cup chocolate chips",
    "0.5 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, white sugar, cinnamon, baking powder, baking soda, salt, and cloves together in a bowl until well combined; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat oil and eggs together in a large bowl until creamy; stir in applesauce until well combined. Add flour mixture; stir until batter is smooth. Fold in ½ cup walnuts and raisins until incorporated; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1 cup walnuts, chocolate chips, and brown sugar in a small bowl; spread over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
