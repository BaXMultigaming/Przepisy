  "ingredients": [
    "2 tablespoons butter",
    "8 ounces mushrooms, sliced",
    "4 cloves garlic, sliced",
    "2 tablespoons chicken broth",
    "0.5 cup heavy whipping cream",
    "1 teaspoon paprika",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a skillet over medium heat. Add mushrooms and saute until tender, 4 to 5 minutes. Add garlic and cook until fragrant, about 1 more minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken broth and simmer for 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in heavy whipping cream and season with paprika, salt, and pepper. Simmer until stew starts to thicken, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
