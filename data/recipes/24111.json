  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "0.75 cup white sugar",
    "1.5 cups peanut butter",
    "2 (8 ounce) containers frozen whipped topping, thawed",
    "1 (9 inch) pie shell, baked"
  ],
  "steps": [
    {
      "text": "In a large bowl, beat cream cheese and sugar until smooth. Beat in the peanut butter. Fold in 1 container of whipped topping. Spread filling in baked pie shell. Chill for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread top with remaining container of whipped topping. Refrigerate 1 hour before serving.",
