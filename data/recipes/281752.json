  "ingredients": [
    "1 (16 ounce) package tricolor rotini pasta",
    "1.5 cups Italian-style salad dressing",
    "0.5 cup diced pepperoni",
    "0.5 cup diced salami",
    "0.5 cup diced Cheddar cheese",
    "0.5 cup diced Monterey Jack cheese",
    "0.5 cup crumbled feta cheese",
    "0.5 medium cucumber, diced",
    "0.33333334326744 cup sliced black olives",
    "0.33333334326744 medium red onion, diced",
    "12 cherry tomatoes, halved"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil; cook rotini at a boil until tender yet firm to the bite, about 8 minutes. Drain; run under cold water to stop the cooking process. Drain; transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir dressing, pepperoni, salami, Cheddar cheese, Monterey Jack cheese, feta cheese, cucumber, black olives, red onion, and cherry tomatoes into rotini; toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the bowl with plastic wrap; set aside in the refrigerator before serving, at least 1 hour.",
      "section": null,
