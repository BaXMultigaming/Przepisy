  "ingredients": [
    "0.5 cup all-purpose flour",
    "2 teaspoons baking powder",
    "2 teaspoons sugar",
    "1 teaspoon salt",
    "2 cups sour cream",
    "4 eggs",
    "1 teaspoon vanilla extract",
    "butter to taste",
    "maple syrup"
  ],
  "steps": [
    {
      "text": "Slowly preheat your griddle or skillet to medium-low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine all-purpose flour, baking powder, sugar, and salt in a bowl. Add sour cream and gently mix together; batter may be slightly lumpy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and vanilla together in a separate bowl, then add to sour cream mixture. Gently stir together without over mixing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat about 1 tablespoon of butter in your preheated skillet or griddle. Use a 1/4 cup measure to drop pancake batter onto the griddle or skillet. Allow pancakes to cook for approximately 2 to 3 minutes on one side, or until bubbles appear all over the surface of your pancake, then flip. Continue cooking your pancakes for another 1 to 2 minutes on the other side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve a stack of pancakes at a time with butter and syrup on top!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
