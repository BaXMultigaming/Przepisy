  "ingredients": [
    "1 pound cranberries, finely ground",
    "2 cups white sugar",
    "1 (20 ounce) can crushed pineapple, drained",
    "1 (16 ounce) package miniature marshmallows",
    "1 cup chopped pecans",
    "1 pint whipped cream, beaten stiff"
  ],
  "steps": [
    {
      "text": "Mix cranberries and sugar together in a bowl. Cover and refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "The next day, beat cream in a chilled glass or metal bowl with an electric mixer until soft peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cranberries from the refrigerator. Mix in drained pineapple, marshmallows, pecans, and whipped cream until well combined. Pour into a 3-quart dish, cover, and refrigerate or freeze for at least 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
