  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups crushed pineapple, undrained",
    "1.5 cups white sugar",
    "0.33333334326744 cup vegetable oil",
    "3 egg whites",
    "2 teaspoons baking soda",
    "0.25 teaspoon salt",
    "0.66666668653488 cup white sugar",
    "0.66666668653488 cup evaporated milk",
    "9 tablespoons margarine",
    "3 egg yolks, beaten"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, pineapple, 1 1/2 cups white sugar, oil, egg whites, baking soda, and salt together in a bowl; pour into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat 2/3 cup sugar, evaporated milk, and margarine together in a saucepan; bring to a boil. Stir 1/2 cup sugar mixture into egg yolks until egg yolks are warmed. Stir egg yolk mixture back into saucepan with sugar mixture; bring to a boil and cook, stirring often, until reduced and thickened, at least 7 minutes. Pour hot mixture over cake. Set cake aside to cool until set, at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
