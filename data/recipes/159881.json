  "ingredients": [
    "3 pounds beef rump roast",
    "3 pounds pork loin roast",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "2 (14.5 ounce) cans green enchilada sauce",
    "2 (4 ounce) cans diced green chiles"
  ],
  "steps": [
    {
      "text": "Season beef roast and pork loin all over with salt and pepper. Place into a slow cooker. Cover and cook on Low for 8 to 10 hours.",
