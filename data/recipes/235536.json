  "ingredients": [
    "1.25 cups buttermilk",
    "0.75 cup pumpkin puree",
    "4 large eggs, separated",
    "0.25 cup white sugar",
    "0.75 teaspoon vanilla extract",
    "0.25 cup unsalted butter, melted",
    "1.3333333730698 cups cake flour",
    "1.75 teaspoons pumpkin pie spice",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Whisk buttermilk, pumpkin puree, egg yolks, sugar, and vanilla extract together in a bowl until blended. Whisk in melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cake flour, pumpkin pie spice, baking soda, baking powder, and salt together in a bowl. Add flour mixture to buttermilk mixture and whisk to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg whites in a glass or metal bowl until soft peaks form. Lift your beater or whisk straight up: the egg whites will form soft mounds rather than a sharp peak. Fold egg whites into buttermilk-flour mixture to form pancake batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a lightly oiled griddle or skillet over medium heat. Drop batter by large spoonfuls onto the griddle and cook until bubbles form on top, 1 to 2 minutes. Flip and cook until browned on the other side, 1 to 2 minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
