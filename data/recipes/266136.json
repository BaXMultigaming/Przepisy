  "ingredients": [
    "2 pounds boneless chicken breasts",
    "2 teaspoons garlic salt",
    "ground black pepper to taste",
    "6 tablespoons pesto",
    "2 medium Roma (plum) tomatoes, thinly sliced",
    "1.5 cups shredded mozzarella cheese",
    "1 head broccoli, cut into florets",
    "2 tablespoons olive oil",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Lightly grease a large sheet pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken with garlic salt and pepper; place onto the prepared sheet pan. Spread pesto over chicken, then top with tomatoes and mozzarella.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss broccoli and oil together in a bowl; season with salt and pepper. Scatter around chicken on the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until broccoli is tender and chicken is no longer pink in the center and the juices run clear, 15 to 20 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
