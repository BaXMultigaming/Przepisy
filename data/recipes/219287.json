  "ingredients": [
    "1.5 pounds ground beef",
    "2 eggs",
    "1.5 cups bread crumbs",
    "0.25 cup finely chopped onion",
    "0.75 cup milk",
    "salt and ground black pepper to taste",
    "2 cups ketchup",
    "2 (8 ounce) cans tomato sauce",
    "2 cups water",
    "0.66666668653488 cup brown sugar",
    "0.66666668653488 cup white sugar",
    "1 tablespoon Worcestershire sauce",
    "1 teaspoon Italian seasoning",
    "1 teaspoon chili powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the ground beef, eggs, bread crumbs, onion, milk, salt, and black pepper together in a large mixing bowl until evenly combined. Form the mixture into 12 large meatballs. Arrange the meatballs into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the ketchup, tomato sauce, water, brown sugar, white sugar, Worcestershire sauce, Italian seasoning, and chili powder together in a saucepan over medium heat; cook and stir until well combined and hot, about 5 minutes. Pour the tomato sauce mixture over the meatballs in the baking dish. Turn the meatballs to coat in the sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the meatballs are cooked through and no longer pink in the center, 60 to 90 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
