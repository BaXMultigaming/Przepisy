  "title": "Cheesy Beef and Bean Bake",
  "description": "Baked casserole combines vegetarian baked beans, instant mashed potatoes, and cheese with browned ground beef for a quick and easily prepared meal.",
  "authors": [
    "Maggie Bomis"
  ],
  "date_published": "1999-10-02T20:10:05-04:00",
