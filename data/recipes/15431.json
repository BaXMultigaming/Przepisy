  "title": "Beef and Vegetable Stew",
  "description": "This tender beef and vegetable stew is packed with flavor thanks to the addition of tomato paste, rosemary, thyme, and spicy red pepper flakes.",
  "authors": [
    "Marianne"
  ],
  "date_published": "2000-01-14T14:46:04-05:00",
