  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 pound cubed beef stew meat, trimmed",
    "1 onion, thinly sliced",
    "1 (6 ounce) can tomato paste",
    "1 (14.5 ounce) can low fat, low sodium beef broth",
    "3 potatoes, cubed",
    "1 cup chopped carrots",
    "1 teaspoon dried thyme",
    "0.25 teaspoon crushed red pepper flakes",
    "1 sprig fresh rosemary",
    "1 bay leaf",
    "10 ounces button mushrooms, quartered",
    "1 (10 ounce) package frozen green peas, thawed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0lbGC-9mnBJshS8wMAMn-GLTSmQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15431-BeefandVegetableStew-DDMFS-035-step1-42b41e0234b34a64a3a91847a6cf6604.jpg"
      ],
      "image": "assets/images/15431/step_01.webp"
    },
    {
      "text": "Heat oil in a large pot over medium-high heat. Add beef and cook until browned on all sides, about 10 minutes; remove meat and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P2FkYomXFfbkESpDyGoMx1gwM7U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15431-BeefandVegetableStew-DDMFS-036-step2-4bf4cc69099a4c1d8c8f8153340db6be.jpg"
      ],
      "image": "assets/images/15431/step_02.webp"
    },
    {
      "text": "Add onion and tomato paste to the same pot; cook and stir until onion is tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hSziXr5ekqYeGKT49Vvx7mg-5mE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15431-BeefandVegetableStew-DDMFS-037-step3-c8d3844f326842a2a0350049143f89bc.jpg"
      ],
      "image": "assets/images/15431/step_03.webp"
    },
    {
      "text": "Return beef to the pot; stir in beef broth. Reduce heat to low, cover, and simmer until meat is tender, about 1 to 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P4THm_HGzj4INwfwSMD7WFvPOvY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15431-BeefandVegetableStew-DDMFS-039-step5-39d10b2c07d749cba152d86b723044f7.jpg"
      ],
      "image": "assets/images/15431/step_04.webp"
    },
    {
      "text": "Add potatoes, carrots, thyme, crushed red pepper flakes, rosemary, and bay leaf; simmer, covered, for 45 minutes, adding some water if stew gets too thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xNeB2_JFUjZYcSRz4nBdJzMEoFU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15431-BeefandVegetableStew-DDMFS-040-step6-44f77d8d687a4e878fcbf23bb180528f.jpg"
      ],
      "image": "assets/images/15431/step_05.webp"
    },
    {
      "text": "Add mushrooms and peas; cook and stir until heated through, about 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kDltpI_wS4h9k4eo9iXCn0Ji4_Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15431-BeefandVegetableStew-DDMFS-042-step8-40d4270053e84453bb7fb8540c7efe40.jpg"
      ],
      "image": "assets/images/15431/step_06.webp"
    },
    {
      "text": "Remove rosemary sprig and bay leaf before serving. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lX85_4szb2rDeKpCAg_pkFv7i_o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15431-BeefandVegetableStew-DDMFS-046-4x3-b3fda948241d4087b68955e080e882ac.jpg"
      ],
      "image": "assets/images/15431/step_07.webp"
    }
