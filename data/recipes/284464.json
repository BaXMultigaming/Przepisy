  "ingredients": [
    "2 cups all-purpose flour",
    "1 tablespoon baking powder",
    "1 tablespoon white sugar",
    "0.5 teaspoon salt",
    "0.66666668653488 cup milk",
    "5 tablespoons butter, cut into bits"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, sugar, and salt together in a large bowl. Add milk and butter and work it in with your fingers until a dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough on a floured surface to a thickness of 1/2 inch. Use cookie cutters to shape biscuits. Place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light brown, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
