  "ingredients": [
    "2 cups fresh baby spinach, stems removed",
    "1 cup freshly grated Parmesan cheese",
    "1 cup fresh parsley leaves, chopped",
    "0.5 cup chopped walnuts",
    "0.25 cup water",
    "3 cloves garlic",
    "0.25 teaspoon salt, or more to taste",
    "0.125 teaspoon ground black pepper",
    "0.5 cup extra-virgin olive oil"
  ],
  "steps": [
    {
      "text": "Place spinach, Parmesan cheese, parsley, walnuts, water, garlic, salt, and pepper in a food processor; blend until well combined. Pour in oil slowly, while processor is running, until mixture forms a smooth paste.",
