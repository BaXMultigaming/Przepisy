  "title": "Creamy Linguini for Two",
  "description": "A very quick and delicious pasta dish with a light, creamy blend of Parmesan cheese and ground nutmeg. Serve with a tossed green salad and some garlic bread.",
  "authors": [
    "Sherrance"
  ],
  "date_published": "2000-03-30T16:44:48-05:00",
