  "ingredients": [
    "1 quart vegetable oil for frying, or as needed",
    "1 cup buttermilk",
    "2 eggs, room temperature",
    "0.25 cup vegetable oil",
    "1 cup cornmeal",
    "1 cup all-purpose flour",
    "0.25 cup white sugar",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "4 green onions, minced",
    "0.5 cup minced onion"
  ],
  "steps": [
    {
      "text": "Heat 1 quart vegetable oil in a deep fryer or large saucepan to 365 degrees F (185 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 200 degrees F (95 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk buttermilk, eggs, and 1/4 cup vegetable oil together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cornmeal, flour, sugar, baking soda, and salt together in a separate bowl; fold in buttermilk mixture, green onions, and minced onion until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Carefully drop batter by tablespoon-sized balls into the hot oil in batches of 6 to 8 balls. Fry until golden brown, flipping to cook evenly, 6 to 10 minutes. Transfer hush puppies with a slotted spoon onto brown paper bags to drain. Repeat with any remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer hush puppies to a baking sheet; keep warm in the preheated oven until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
