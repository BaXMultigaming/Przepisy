  "ingredients": [
    "2 cups self-rising flour",
    "1 cup white sugar",
    "1 teaspoon salt",
    "0.25 cup shortening",
    "0.5 cup evaporated milk",
    "0.5 cup orange juice",
    "1 egg",
    "0.25 cup brown sugar, or more to taste",
    "0.5 stick butter, cut into small cubes",
    "0.5 cup pecan pieces"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 12-inch skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, white sugar, and salt together in a bowl. Mix in shortening. Add evaporated milk, orange juice, and egg. Fold gently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour batter into the skillet. Sprinkle brown sugar on top. Dot with butter. Cover with pecan pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until coffeecake springs back when touched in the center, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
