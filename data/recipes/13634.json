  "ingredients": [
    "2 pounds fresh broccoli florets",
    "2 eggs, beaten",
    "1 onion, chopped",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "0.5 cup mayonnaise",
    "10 ounces dry bread stuffing mix",
    "0.5 cup butter, melted",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook broccoli in a large pot of salted boiling water until just slightly tender. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine eggs, onion, mushroom soup and mayonnaise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a layer of broccoli in the prepared baking dish. Pour mayonnaise sauce over broccoli. Spread stuffing mix over the sauce. Drizzle butter or margarine over all and top with shredded cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
