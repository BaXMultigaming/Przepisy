  "ingredients": [
    "1 (12 ounce) package egg noodles",
    "2 tablespoons salted butter",
    "1 (8 ounce) package sliced mushrooms",
    "0.5 medium onion, chopped",
    "2 cloves garlic, chopped",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "1.25 cups leftover turkey gravy",
    "0.5 cup milk",
    "0.5 teaspoon curry powder",
    "0.5 teaspoon poultry seasoning",
    "salt to taste",
    "2 cups diced cooked turkey",
    "1 (10 ounce) package frozen peas, thawed",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 2 ½-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Cook egg noodles at a boil until tender yet firm to the bite, 7 to 9 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, melt butter in a saucepan over medium heat. Add mushrooms, onion, and garlic; cook until tender, 5 to 7 minutes. Add soup, gravy, milk, curry powder, poultry seasoning, and salt; cook and stir until combined and hot, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooked egg noodles, turkey, and peas in the prepared baking dish; pour hot soup mixture over top. Sprinkle with Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until hot and bubbly, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
