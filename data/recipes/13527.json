  "ingredients": [
    "5 cups turkey stock",
    "1 cup water",
    "0.25 cup all-purpose flour",
    "1 teaspoon poultry seasoning",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 teaspoon celery salt"
  ],
  "steps": [
    {
      "text": "Bring turkey stock to a boil in a medium saucepan.",
