  "title": "Easy Rum Cake",
  "description": "This easy rum cake recipe uses box cake mix to make a moist Bundt topped with walnuts and glazed with a rum sauce perfect for holiday entertaining.",
  "authors": [
    "Mariann"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
