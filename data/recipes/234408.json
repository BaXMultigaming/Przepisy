  "ingredients": [
    "3 cups self-rising flour",
    "0.5 cup white sugar",
    "1 (12 fluid ounce) can or bottle beer",
    "3 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and sugar together in a bowl. Pour beer into a separate large bowl; add flour mixture and stir until moistened. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until nearly set, 40 to 50 minutes. Pour melted butter over the top of the bread and continue baking until a toothpick inserted into the center comes out clean, about 10 minutes more.",
