  "ingredients": [
    "6 cups water",
    "1 medium yellow onion, halved",
    "1 large carrot, trimmed and peeled",
    "0.33333334326744 cup raw cashews",
    "1 large clove garlic",
    "1.5 teaspoons salt",
    "0.25 teaspoon ground black pepper",
    "2 cups red lentils, rinsed and drained",
    "lemon, juiced"
  ],
  "steps": [
    {
      "text": "Combine water, onion, carrot, cashews, garlic, salt, and pepper in a high-speed blender; blend until completely smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the blended mixture into a multi-functional pressure cooker (such as Instant Pot). Stir in red lentils. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 10 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Stir in lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
