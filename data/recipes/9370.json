  "ingredients": [
    "1 (1 pound) loaf white bread",
    "1 small onion, chopped",
    "1 teaspoon poultry seasoning",
    "1 pinch salt",
    "1 pinch ground black pepper",
    "0.25 cup water"
  ],
  "steps": [
    {
      "text": "Moisten all the bread with as much water as is needed to make moist. Add the onion, seasoning, and salt and pepper. Mix with hands.",
