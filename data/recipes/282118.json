  "ingredients": [
    "1.75 cups almond milk",
    "1 pinch salt",
    "1 cup old-fashioned oats",
    "1 cup shredded zucchini",
    "1 teaspoon ground cinnamon",
    "0.125 teaspoon ground nutmeg",
    "2 tablespoons maple syrup",
    "0.5 tablespoon salted butter",
    "1 teaspoon vanilla extract",
    "2 tablespoons crushed walnuts"
  ],
  "steps": [
    {
      "text": "Bring almond milk and salt to a boil in a saucepan over medium-high heat. Add oats, zucchini, cinnamon, and nutmeg. Reduce heat to medium and cook, stirring often, for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and stir in maple syrup, butter, and vanilla. Top with crushed walnuts.",
