  "ingredients": [
    "1 teaspoon onion powder",
    "1 teaspoon garlic powder",
    "3 tablespoons chipotle chile powder",
    "1.5 teaspoons salt",
    "4 tablespoons brown sugar",
    "2 (3/4 pound) pork tenderloins"
  ],
  "steps": [
    {
      "text": "Preheat grill for medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large resealable plastic bag, combine the onion powder, garlic powder, chipotle chile powder, salt, and brown sugar. Place tenderloins in bag and shake, coating meat evenly. Refrigerate for 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil grill grate, and arrange meat on grate. Cook for 20 minutes, turning meat every 5 minutes. Remove from grill, let stand for 5 to 10 minutes before slicing.",
      "section": null,
      "name": null,
      "url": null,
