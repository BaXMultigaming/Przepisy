  "ingredients": [
    "cooking spray",
    "0.5 cup vegan butter, melted",
    "0.5 cup coconut sugar",
    "0.25 cup brown sugar",
    "2 cups mashed bananas",
    "0.5 cup plain applesauce",
    "2 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x5-inch loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, coconut sugar, and brown sugar in a large bowl; beat with an electric mixer until smooth and creamy, 2 to 3 minutes. Stir in mashed bananas and applesauce until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking soda, baking powder, and salt in a separate bowl. Add banana mixture, stirring just enough to moisten. Fold in walnuts. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center of the loaf comes out clean, 60 to 65 minutes. Let bread cool in the pan for 10 minutes, then turn out onto a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
