  "title": "Vegan Banana Bread",
  "description": "This vegan banana bread is made with mashed bananas, applesauce, and vegan butter for a moist and delicious treat for vegans and non-vegans alike.",
  "authors": [
    "Hrdlicka"
  ],
  "date_published": "2020-03-05T00:19:33-05:00",
