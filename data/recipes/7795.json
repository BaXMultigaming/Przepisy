  "title": "Coconut Chiffon Cake",
  "description": "This coconut chiffon cake has a light spongy texture with the taste and aroma of coconut. It is simple and delicious and makes a perfect dessert.",
  "authors": [
    "Carolyn Williams"
  ],
  "date_published": "1998-06-29T19:33:07-04:00",
