  "ingredients": [
    "1 pound bulk mild Italian sausage",
    "1 pound kielbasa smoked sausage, cut lengthwise and sliced into 1/2-inch pieces",
    "4 cups diced potatoes, or more to taste",
    "4 cups water",
    "2 cups chicken broth",
    "1 cup heavy whipping cream",
    "1 stalk celery, diced, or more to taste",
    "2 cubes chicken bouillon",
    "1 tablespoon minced garlic",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon garlic powder",
    "0.33333334326744 teaspoon crushed red pepper, or more to taste"
  ],
  "steps": [
    {
      "text": "Heat a large pot over medium-high heat. Cook and stir Italian and kielbasa sausages in the hot pot until browned, 5 to 7 minutes. Drain grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir potatoes, water, chicken broth, heavy cream, celery, bouillon, garlic, salt, pepper, garlic powder, and red pepper into the pot. Reduce heat and let simmer until potatoes are tender, about 1 hour 30 minutes.",
