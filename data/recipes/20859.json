  "ingredients": [
    "1 cup mayonnaise",
    "1 cup grated Parmesan cheese",
    "2 (6.5 ounce) jars marinated artichoke hearts, drained",
    "2 cups shredded mozzarella cheese",
    "1.5 teaspoons garlic powder",
    "1 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, thoroughly mix mayonnaise, Parmesan, artichoke hearts, mozzarella, and garlic powder; transfer to an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes, or until the surface is lightly browned and bubbly. Sprinkle with paprika and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
