  "ingredients": [
    "1 cup butter",
    "1 cup brown sugar",
    "1 cup white sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "3 cups oats",
    "1.5 cups all-purpose flour",
    "1 cup chocolate chips, or more to taste",
    "0.5 cup cocoa powder",
    "1 teaspoon baking soda",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, brown sugar, and white sugar together in a bowl using an electric mixer until smooth and creamy. Beat eggs and vanilla extract into butter mixture until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oats, flour, chocolate chips, cocoa powder, baking soda, and salt together in a bowl; slowly stir into butter mixture until dough is just mixed. Scoop dough using a small scooper onto baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges of cookies are lightly browned, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
