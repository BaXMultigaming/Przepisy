  "ingredients": [
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "1 cup vegetable oil",
    "1 cup butter",
    "1 egg",
    "3.5 cups sifted all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "1 teaspoon cream of tartar",
    "1 teaspoon vanilla extract",
    "1 cup crisp rice cereal",
    "1 cup flaked coconut",
    "1 cup rolled oats",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Mix together the sugars, oil, butter and egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together the flour, baking soda, salt, cream of tartar and vanilla. Stir into butter mixture. Stir in vanilla",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in cereal, coconut, oatmeal, and chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill for at least an hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make into balls the size of walnuts. Mix and flatten with a glass dipped in sugar and bake for 8-10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
