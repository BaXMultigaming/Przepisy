  "ingredients": [
    "1 (8 ounce) package wide egg noodles",
    "2 cups sour cream",
    "0.25 cup grated Parmesan cheese",
    "1 tablespoon chopped fresh chives",
    "1 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "1 clove crushed garlic",
    "2 tablespoons butter",
    "0.25 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "In a large pot with boiling salted water cook egg noodles until al dente. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl mix together the sour cream, 1/4 cup of the grated Parmesan cheese, chives, salt, ground black pepper, and garlic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in butter or margarine to hot egg noodles. Stir in sour cream mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange noodles on warm platter and sprinkle with remaining 1/4 cup of grated Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
