  "ingredients": [
    "3 medium russet potatoes, peeled and shredded",
    "0.5 medium yellow onion, chopped",
    "0.25 cup all-purpose flour",
    "salt and ground black pepper to taste",
    "1 large egg",
    "0.5 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Rinse shredded potatoes in a colander with cold water until water runs clear. Place in a cheesecloth or clean dish towel and twist tightly to squeeze out all moisture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a bowl with onion, flour, salt, and pepper. Add egg and mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a shallow, cast iron frying pan. Add potato mixture to the hot oil to form either on large or several smaller pancakes. Cook until browned and crispy, about 5 minutes per side. Drain on a paper towel and serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
