  "ingredients": [
    "4 tablespoons butter",
    "2 tablespoons Worcestershire sauce",
    "2 cloves garlic, minced",
    "1 tablespoon dried dill",
    "1 tablespoon dried parsley",
    "1 tablespoon dried chives",
    "1 tablespoon salt",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon chipotle chile powder",
    "3 cups crispy wheat cereal squares (such as Wheat Chex®)",
    "3 cups crispy rice cereal squares (such as Rice Chex®)",
    "3 cups crispy corn cereal squares (such as Corn Chex®)",
    "2 cups mixed nuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 200 degrees F (95 degrees C). Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small saucepan. Add Worcestershire sauce, minced garlic, dill, parsley, chives, salt, garlic powder, and chipotle powder. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place wheat, rice, and corn cereal squares in a large bowl. Add nuts. Stir in the seasoned butter. Spread mixture evenly on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring once halfway through, until toasted and fragrant, about 1 hour. Let cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
