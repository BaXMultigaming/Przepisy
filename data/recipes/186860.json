  "ingredients": [
    "2 teaspoons vegetable oil",
    "1 onion, chopped",
    "2 pounds ground beef",
    "4 green bell peppers, chopped",
    "1 (14.5 ounce) can diced tomatoes",
    "1 (8 ounce) can tomato sauce",
    "1 (6 ounce) can tomato paste",
    "1 teaspoon crushed red pepper flakes"
  ],
  "steps": [
    {
      "text": "Heat the oil in a saucepan over medium-high heat; cook the onion in the hot oil until tender, about 5 minutes. Add the ground beef, bell peppers, tomatoes, tomato sauce, tomato paste, and red pepper flakes to the saucepan; stir.",
