  "title": "Plum Jam",
  "description": "This plum jam recipe is easy to make with ripe and juicy fresh plums for a delicious spread on toast, ice cream, or waffles.",
  "authors": [
    "DelightfulDines"
  ],
  "date_published": "2020-06-18T23:42:55-04:00",
  "date_modified": "2024-07-26T09:30:49-04:00",
  "prep_time": "PT30M",
