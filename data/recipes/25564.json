  "ingredients": [
    "1.5 cups crushed chocolate graham crackers",
    "6 tablespoons butter, softened",
    "2 (1 ounce) squares semisweet chocolate, chopped",
    "2 (8 ounce) packages cream cheese, softened",
    "0.5 cup white sugar",
    "0.5 teaspoon vanilla extract",
    "2 eggs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs and butter in a medium bowl; mix well. Press into the bottom of a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate in a microwave-safe bowl; heat in the microwave until melted, stirring occasionally until chocolate is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat softened cream cheese, sugar, and vanilla in a large bowl until creamy and smooth. Blend in eggs, one at a time. Remove 1 cup cream cheese mixture and mix with melted chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread plain batter into baked crust. Drop chocolate batter randomly over the top. Swirl batter with a knife tip to create a marbled effect.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the center is set, 30 to 35 minutes. Cool to room temperature, then refrigerate for 3 hours to overnight before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
