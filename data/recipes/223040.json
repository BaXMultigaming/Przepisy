  "ingredients": [
    "1.5 tablespoons olive oil",
    "3 large chicken breasts",
    "1 large onion, diced",
    "3 cloves garlic, crushed",
    "13 cups water",
    "2 cups white wine",
    "0.75 cup fresh lemon juice",
    "1 (4 inch) piece fresh ginger, peeled and thinly sliced",
    "1 tablespoon white sugar",
    "4 cubes chicken bouillon",
    "3 bay leaves",
    "7 whole black peppercorns",
    "0.75 cup peeled and sliced carrots",
    "2 stalks celery, diced",
    "1 kohlrabi bulb, peeled and diced",
    "2.5 tablespoons fresh rosemary",
    "2 tablespoons fresh thyme",
    "1 (8 ounce) package egg noodles",
    "1 large clove garlic, minced",
    "1 tablespoon grated ginger",
    "1 teaspoon salt, or to taste",
    "0.5 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large pot over medium heat. Add chicken, onion, and crushed garlic cloves; cook until chicken is browned and onion starts to turn translucent, about 5 minutes. Pour water, wine, and lemon juice over chicken mixture; stir in sliced ginger, sugar, bouillon cubes, bay leaves, and peppercorns. Bring to a simmer, then reduce the heat to medium-low and cook for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mW2ARqiV4sieHecJlEp-yF-MYGc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223040-cold-busting-ginger-chicken-noodle-soup-PICS-Step-01-97d46f8999c2434ea5f6cb0bc240dbeb.jpg"
      ],
      "image": "assets/images/223040/step_01.webp"
    },
    {
      "text": "Remove and discard garlic cloves. Transfer chicken to a cutting board and chop into bite-size pieces.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Knv8RD3DxOJqX73I-4YY2haXEY8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223040-cold-busting-ginger-chicken-noodle-soup-PICS-Step-02-ba137b71085e404e82ddc5b9c1cfcdab.jpg"
      ],
      "image": "assets/images/223040/step_02.webp"
    },
    {
      "text": "Add carrots, celery, kohlrabi, rosemary, and thyme to the pot. Reduce the heat to low and cook until vegetables begin to soften, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qPkGWdCoYgpYt_-8yxjwmCaCAZM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223040-cold-busting-ginger-chicken-noodle-soup-PICS-Step-03-5d9edf12b8e14caca314e06cfd9cf849.jpg"
      ],
      "image": "assets/images/223040/step_03.webp"
    },
    {
      "text": "Bring soup to a boil. Return chopped chicken to the pot along with egg noodles, minced garlic, and grated ginger. Remove from the heat and let sit until noodles have softened, about 10 minutes. Season with salt and garnish with parsley.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qRY5Cp1uw2zFZ_6-P7l2-F6rf9w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/223040-cold-busting-ginger-chicken-noodle-soup-PICS-Step-04-918cc05a67494fa3bf12429ba64815e7.jpg"
