  "ingredients": [
    "2 cups white sugar",
    "0.5 cup milk",
    "0.5 cup butter",
    "4 teaspoons cocoa powder",
    "0.5 cup creamy peanut butter",
    "2 teaspoons pure vanilla extract",
    "2 cups quick cooking oats"
  ],
  "steps": [
    {
      "text": "Combine sugar, milk, butter, and cocoa powder in a large saucepan over medium heat. Bring to a boil; cook, stirring constantly, until sugar is dissolved completely, 1 1/2 to 2 minutes. Immediately remove saucepan from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir peanut butter and vanilla into milk mixture until smooth. Add oats; stir to coat. Spoon oats mixture onto a sheet of parchment paper; let sit until mixture holds together, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
