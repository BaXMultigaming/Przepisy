  "ingredients": [
    "2 tablespoons dill seed",
    "2 tablespoons mustard seed",
    "2 tablespoons cumin seed",
    "2 tablespoons chili powder",
    "2 tablespoons paprika",
    "1 tablespoon red pepper flakes",
    "0.5 bunch parsley",
    "10 sprigs thyme",
    "3 sprigs dill",
    "2 sprigs rosemary",
    "2 sprigs sage",
    "30 live, hard-shell blue crabs"
  ],
  "steps": [
    {
      "text": "Crush dill, mustard, and cumin seeds in a spice grinder, or with a mortar and pestle. Pour spices into a 5-gallon stockpot; add chili powder, paprika, red pepper flakes, parsley, thyme, dill, rosemary, and sage. Fill the pot 3/4 full with water; bring to a boil over high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add crabs, cover, and boil until shells turn red and meat is opaque, about 20 minutes. Stir crabs occasionally as they boil to ensure even cooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
