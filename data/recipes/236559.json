  "ingredients": [
    "1.5 cups white sugar",
    "1 cup butter, softened",
    "0.75 cup mashed avocado",
    "2 eggs",
    "3.25 cups unbleached all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon baking powder",
    "0.25 teaspoon sea salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, and avocado together in a bowl using an electric mixer until smooth. Add eggs and beat until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, baking powder, and salt together in a separate bowl; stir into avocado mixture until dough is well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into walnut-sized balls. Arrange balls 2 inches apart on a nonstick baking sheet; flatten dough slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the bottoms of cookies are lightly browned, 8 to 10 minutes. Cool cookies on the baking sheet for 5 minutes before transferring them to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
