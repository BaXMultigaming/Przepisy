  "ingredients": [
    "1 cup butter, softened",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 large egg",
    "1 tablespoon orange zest",
    "2.25 cups all-purpose flour",
    "0.75 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2 cups white chocolate chips",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and both sugars together in a mixing bowl until light and fluffy. Beat in egg and orange zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, baking soda, and salt together in a separate bowl. Gradually mix flour mixture into butter mixture. Stir in white chocolate chips and walnuts. Drop tablespoonfuls of dough 2 inches apart onto ungreased baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 to 12 minutes in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and cool briefly on the baking sheets before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
