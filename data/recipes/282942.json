  "ingredients": [
    "2 cups cold milk",
    "2 (3.4 ounce) packages instant French vanilla pudding mix",
    "1 (14 ounce) can sweetened condensed milk",
    "1 (8 ounce) package cream cheese, softened",
    "1 (8 ounce) container whipped topping (such as Cool Whip®)",
    "2 (7.25 ounce) packages butter cookies (such as Pepperidge Farm® Chessmen®)",
    "6 medium bananas, sliced"
  ],
  "steps": [
    {
      "text": "Combine milk and pudding mix in a bowl. Whisk for 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine condensed milk and cream cheese in a separate bowl; beat with an electric mixer until smooth. Fold in whipped topping. Slowly fold in pudding mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer 1/2 of the cookies in the bottom of a 9x13-inch pan. Top with 1/2 of the bananas, 1/2 of the pudding mixture, remaining bananas, remaining pudding mixture, and remaining cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill for 2 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
