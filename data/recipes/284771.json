  "ingredients": [
    "1 (16 ounce) bottle root beer",
    "3 tablespoons cold heavy cream",
    "0.25 teaspoon vanilla extract",
    "1.5 cups root beer, cold"
  ],
  "steps": [
    {
      "text": "Pour 1 bottle root beer into a standard-sized ice cube tray. Carefully transfer to the freezer until frozen, 3 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cold cream and vanilla in a small bowl until slightly thickened. Cover and place in the refrigerator until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer root beer ice cubes into a blender. Add 1 1/2 cups cold root beer and blend until a smooth, thick slush forms, stopping and shaking the blender as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into 2 frozen mugs, leaving about 1 inch of room at the top. Spoon vanilla cream over top and serve.",
      "section": null,
      "name": null,
      "url": null,
