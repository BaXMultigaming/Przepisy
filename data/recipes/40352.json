  "ingredients": [
    "0.5 cup soy sauce",
    "1 tablespoon Worcestershire sauce",
    "4 cloves garlic, minced",
    "2 tablespoons lemon juice",
    "0.5 teaspoon ground black pepper",
    "1 teaspoon vegetable oil",
    "4 pork chops"
  ],
  "steps": [
    {
      "text": "In a shallow dish, combine soy sauce, Worcestershire sauce, garlic, lemon juice, pepper and oil. Add pork chops, and turn to coat evenly. Cover, and refrigerate for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place marinated pork chops in a roasting pan, and bake in preheated oven for 35 to 40 minutes, basting meat often with marinade.",
