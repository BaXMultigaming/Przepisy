  "ingredients": [
    "cooking spray",
    "2 cups white whole wheat flour",
    "0.5 cup brown sugar",
    "0.25 cup white sugar",
    "2 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.75 cup pumpkin puree",
    "0.75 cup mashed ripe banana",
    "0.5 cup vanilla Greek yogurt",
    "2 tablespoons unsalted butter, softened",
    "2 teaspoons unsalted butter, softened",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "1 cup candied pecans",
    "0.5 cup white sugar",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 12-cup muffin tin with cooking spray, or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, white sugar, cinnamon, baking soda, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin puree, mashed banana, yogurt, butter, eggs, and vanilla extract in a large mixing bowl; beat with an electric mixer until well combined. Add dry ingredients and mix until just combined. Scoop batter into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pecans, sugar, and cinnamon together in a small bowl. Spoon or sprinkle on top of each muffin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a knife inserted into the center comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
