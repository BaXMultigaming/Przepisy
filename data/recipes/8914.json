  "ingredients": [
    "3.5 boneless chicken breast halves, cooked and diced",
    "1 head lettuce, torn into small pieces",
    "4 green onions, sliced",
    "4 stalks celery, sliced thin",
    "6 ounces Chinese noodles, heated briefly to crisp",
    "0.5 cup walnuts, chopped",
    "2 tablespoons sesame seeds, toasted",
    "6 tablespoons seasoned rice vinegar",
    "4 tablespoons white sugar",
    "1 teaspoon salt",
    "0.5 cup peanut oil"
  ],
  "steps": [
    {
      "text": "Prepare salad: Combine chicken, lettuce, green onion, celery, noodles, nuts, and sesame seeds in a large salad bowl. Mix all together. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make dressing: Put vinegar in a small bowl. Dissolve sugar and salt in vinegar before adding oil. Shake, or beat, well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add dressing to salad, toss to coat, and serve.",
