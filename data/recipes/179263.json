  "ingredients": [
    "2 pounds sweet potatoes",
    "0.25 cup unsalted butter, melted",
    "1.5 cups white sugar",
    "3 eggs",
    "1 (12 fluid ounce) can evaporated milk",
    "1 cup whole milk",
    "1.5 teaspoons vanilla extract",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves",
    "10 large marshmallows"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 2-quart baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel and grate sweet potatoes; add to a large bowl. Add melted butter; toss to combine. Beat sugar and eggs together in a medium bowl until combined; add to sweet potato mixture. Stir in evaporated milk, whole milk, cinnamon, vanilla extract, allspice, nutmeg, and cloves until well combined; transfer to the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until sweet potatoes are tender and top is lightly browned, 60 to 70 minutes. Place marshmallows on top of sweet potatoes; continue baking until marshmallows are lightly browned, 5 to 10 minutes more. Let stand before serving, 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
