  "ingredients": [
    "3 tablespoons olive oil",
    "3 cloves garlic, minced",
    "1 (28 ounce) can tomato sauce",
    "0.5 teaspoon crushed red pepper",
    "2 teaspoons dried thyme",
    "2 teaspoons Italian seasoning",
    "2 teaspoons dried basil",
    "2 teaspoons dried oregano",
    "1 pinch salt",
    "1 tablespoon brown sugar, or more to taste"
  ],
  "steps": [
    {
      "text": "Stir the olive oil, garlic, tomato sauce, red pepper, thyme, Italian seasoning, basil, oregano, salt, and brown sugar together in a saucepan over low heat; simmer, stirring occasionally, for 45 minutes. Refrigerate overnight before using.",
