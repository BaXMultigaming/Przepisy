  "ingredients": [
    "2 tablespoons duck fat, or more as needed",
    "2 pounds Brussels sprouts, trimmed and halved lengthwise",
    "salt and freshly ground black pepper to taste",
    "1 pinch cayenne pepper, or more to taste",
    "1 lemon, juiced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Line a baking sheet with parchment paper or a silicone baking mat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat duck fat in a small saucepan over low heat until melted. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Brussels sprouts, salt, black pepper, and cayenne pepper in a large bowl. Pour melted duck fat over Brussels sprouts and stir to coat evenly. Spread evenly onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until Brussels sprouts are browned and tender, but still slightly firm, 15 to 20 minutes, flipping sprouts halfway through. Top with freshly squeezed lemon juice.",
      "section": null,
      "name": null,
      "url": null,
