  "ingredients": [
    "1 teaspoon canola oil",
    "0.66666668653488 cup finely chopped onion",
    "1 small clove garlic, minced",
    "0.66666668653488 cup dried lentils, rinsed",
    "1 tablespoon taco seasoning, or to taste",
    "1.6666667461395 cups chicken broth",
    "0.66666668653488 cup salsa",
    "12 taco shells"
  ],
  "steps": [
    {
      "text": "Heat oil in a skillet over medium heat. Add onion and garlic; cook and stir until tender, about 5 minutes. Add lentils and taco seasoning; cook and stir 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken broth; bring to a boil. Reduce heat to low, cover, and simmer until lentils are tender, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Uncover the skillet; cook until mixture is slightly thickened, 6 to 8 minutes. Mash lentils slightly; stir in salsa.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve about 1/4 cup lentil mixture in each taco shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
