  "ingredients": [
    "5 pounds Yukon Gold potatoes",
    "2 cups Parmesan cheese",
    "1.5 cups cream cheese",
    "1 cup chopped fresh chives",
    "0.5 cup butter",
    "0.5 medium head garlic, peeled and minced",
    "1 pinch salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pSf4jHy0qKB_JuSYg-gPaB3RcUk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15213-the-best-mashed-potatoes-step-1-00005-68f673a896564ad7a4042873cd150c4a.jpg"
      ],
      "image": "assets/images/15213/step_01.webp"
    },
    {
      "text": "Peel and quarter potatoes; place in a large pot. Cover with salted water and bring to a boil. Cook until tender but still firm, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZosWvMcDfLTXTpJ6WdCXl4CM1No=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15213-the-best-mashed-potatoes-step-2-00018-d3dd2a54da164980be0289343251336e.jpg"
      ],
      "image": "assets/images/15213/step_02.webp"
    },
    {
      "text": "Drain and return potatoes to the pot over low heat to dry for 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FJzzbZ78ktFYEx5MjSE2ZLc5x94=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15213-the-best-mashed-potatoes-Step-3-00049-cec8c2f8f9754bdd8cf6a77f7b8a1c74.jpg"
      ],
      "image": "assets/images/15213/step_03.webp"
    },
    {
      "text": "Add Parmesan cheese, cream cheese, chives, butter, garlic, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KCnLKT36Cwz71SRFM_vCr_WgkT8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15213-the-best-mashed-potatoes-Step-4-00051-dc78e6f5972345ddbe394b579b660ae0.jpg"
      ],
      "image": "assets/images/15213/step_04.webp"
    },
    {
      "text": "Use a potato masher to mash until smooth and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LczhAB7OjqBSYJmoy69blQ8Po6s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/15213-the-best-mashed-potatoes-Step-5-00053-b4ae4a47bba041e6992d542d2df0ca51.jpg"
