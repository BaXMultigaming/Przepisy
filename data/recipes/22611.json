  "ingredients": [
    "2 tablespoons olive oil",
    "7 cloves garlic, minced",
    "1 (6 ounce) can tomato paste",
    "1 (28 ounce) can crushed tomatoes",
    "2 (28 ounce) cans tomato puree",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "2 teaspoons dried basil leaves",
    "1 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large saucepan over medium-low heat. Cook and stir garlic in the hot oil until fragrant, about 1 minute, being careful not to burn it. Pour in tomato paste, reduce heat to low, and simmer for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add crushed tomatoes, tomato puree, pepper, salt, basil, and sugar; stir. Cook over low heat, stirring occasionally, for 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
