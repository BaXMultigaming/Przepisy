  "ingredients": [
    "1.75 cups bran cereal",
    "1.25 cups all-purpose flour",
    "0.75 cup white sugar",
    "1.25 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon salt",
    "0.75 cup buttermilk",
    "0.25 cup canola oil",
    "1 egg",
    "0.75 cup peeled and finely chopped apple",
    "0.75 cup grated carrot",
    "0.25 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk bran cereal, flour, sugar, baking soda, cinnamon, and salt together in a bowl. Beat buttermilk, canola oil, and egg together in a separate bowl; stir into bran cereal mixture. Gently stir in apple, carrot, and walnuts. Spoon batter into the prepared muffin cups, filling them about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 20 to 25 minutes. Cool muffins in tin for 5 minutes before transferring to a wire rack to completely cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
