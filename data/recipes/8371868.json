  "ingredients": [
    "2 teaspoons butter, softened",
    "2 slices bread",
    "2 tablespoons peanut butter, or more to taste",
    "1 tablespoon any flavor fruit jam"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly spread butter on one side each bread slice; spread peanut butter on 1 bread slice, unbuttered side, and jam on remaining 1 bread slice, unbuttered side. Press sandwich together to enclose peanut butter and jam, buttered-sides out.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove and discard crusts; seal all sides using a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Air-fry sandwich in the preheated air fryer until golden brown, about 5 minutes, flipping halfway through.",
