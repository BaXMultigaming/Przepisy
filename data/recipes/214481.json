  "ingredients": [
    "0.25 cup dry buttermilk powder",
    "2 tablespoons dried minced onion",
    "2 tablespoons dried parsley",
    "1 tablespoon dried chives",
    "0.25 teaspoon salt, or to taste",
    "1 teaspoon garlic powder",
    "1 teaspoon dried celery flakes",
    "0.5 teaspoon white pepper",
    "0.25 teaspoon paprika",
    "0.25 teaspoon dried dill weed"
  ],
  "steps": [
    {
      "text": "Mix the buttermilk powder, dried onion, parsley, chives, salt, garlic powder, dried celery flakes, white pepper, paprika, and dill together, and store in a cool, dry place. For a finer texture, place ingredients in a blender and pulse several times.",
