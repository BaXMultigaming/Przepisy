  "ingredients": [
    "1 (9 inch) unbaked pie crust",
    "2 eggs",
    "1 cup sour cream",
    "0.75 cup white sugar",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine eggs, sour cream, sugar, vanilla, salt and nutmeg. Beat until smooth. stir in raisins. Pour filling into pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the lower half of preheated oven for 40 minutes, or until filling is set. Allow to cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
