  "ingredients": [
    "4 cups vegetable oil for deep-frying",
    "1 cup cream-style corn",
    "1 egg",
    "1 cup all-purpose flour",
    "1 teaspoon sugar",
    "0.75 teaspoon baking powder",
    "0.5 teaspoon salt",
    "1 cup maple flavored pancake syrup"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep fryer to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream-style corn and egg in a small bowl. Combine flour, sugar, baking powder, and salt in a medium bowl; stir in corn mixture until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter by ⅛ cupfuls into hot oil. Fry until golden brown, turning once if fritters don't turn over by themselves. Drain on paper towels; serve with syrup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
