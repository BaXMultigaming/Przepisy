  "steps": [
    {
      "text": "Heat oil in a large stockpot over medium heat. Add sausages; cook until begin to brown, about 5 minutes. Transfer sausages to a paper-towel-lined plate; leave browned bits and drippings in the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add carrots, celery, and onion to the pot; cook until onion is soft and translucent, about 5 minutes. Add garlic; cook until fragrant, about 1 minute. Add lentils and tomatoes; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken stock, bay leaves, and sausages; bring to a boil over medium-high heat. Reduce heat to medium, cover the pot, and simmer for 25 minutes. Season soup with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
