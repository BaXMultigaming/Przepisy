  "ingredients": [
    "4 bananas, peeled and sliced",
    "4 tablespoons butter, melted",
    "1 cup packed brown sugar",
    "0.25 cup rum",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 cup chopped walnuts",
    "0.25 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Layer sliced bananas in the bottom of a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, brown sugar, rum, vanilla and cinnamon in a small bowl; pour over bananas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and cook on Low for 2 hours. Top bananas with walnuts and coconut during the last 30 minutes of cooking.",
