  "ingredients": [
    "4 large potatoes, peeled and cut into strips",
    "1 cup all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 cup milk",
    "1 egg",
    "1 quart vegetable oil for frying",
    "1.5 pounds cod fillets"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Kvj-SsydAjxlLXTuVhUa0mkgQuo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16580-Classic-Fish-and-chips-Step-0jpg-3d4d38123487487793ef841fa8cd4137.jpg"
      ],
      "image": "assets/images/16580/step_01.webp"
    },
    {
      "text": "Place sliced potatoes in a medium bowl and cover with cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Yi4LahLuPuJumjaINNFTCYirZqU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16580-Classic-Fish-and-chips-Step1-364d805e1ca645beb640f7c2221bdba5.jpg"
      ],
      "image": "assets/images/16580/step_02.webp"
    },
    {
      "text": "Mix flour, baking powder, salt, and pepper together in a separate medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pJBdNfD1eKkPA0xiOAfsQSmRffk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16580-Classic-Fish-and-chips-Step2-03569424a4b3480989511eb5badad149.jpg"
      ],
      "image": "assets/images/16580/step_03.webp"
    },
    {
      "text": "Add milk and egg; stir until batter is smooth. Let stand for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YG289fME69ocN_UGc8UomnNzkUM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16580-Classic-Fish-and-chips-Step3-31ce177e25b14dd3b5c18156d7d37d30.jpg"
      ],
      "image": "assets/images/16580/step_04.webp"
    },
    {
      "text": "Meanwhile, heat oil in a large pot or electric skillet to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5pnQKouIYT2hL16yFEy1tKtQbG0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16580-Classic-Fish-and-chips-Step4-6bdb653605ad46889f89cbc0fc65366b.jpg"
      ],
      "image": "assets/images/16580/step_05.webp"
    },
    {
      "text": "Drain and pat dry potatoes. Fry in hot oil until tender, about 5 minutes; drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9HAWZlBZ_Nfiu263BYElBuEH1lU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16580-Classic-Fish-and-chips-Step5-629c7ff8032645a4befc7613a940747d.jpg"
      ],
      "image": "assets/images/16580/step_06.webp"
    },
    {
      "text": "Dredge cod in batter, one piece at a time, and place in hot oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RbfEjW3pBnbl1q0HwX20W2dtE0E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16580-Classic-Fish-and-chips-Step6-9a1e816307bd4f2a9ebab0fe595202c5.jpg"
      ],
      "image": "assets/images/16580/step_07.webp"
    },
    {
      "text": "Fry fish in batches until golden brown on all sides; drain on paper towels. Monitor oil temperature, increasing the heat as needed to maintain 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aAoIqVInEVLAa6b6iv33tUKXz4E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16580-Classic-Fish-and-chips-Step7-3-368b1ccd37e64587adba77c299f9ac12.jpg"
      ],
      "image": "assets/images/16580/step_08.webp"
    },
    {
      "text": "Fry potatoes again in hot oil until crisp, 1 to 2 minutes; drain on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rRYdpuqpK-99AjeqqXh7Re5Rwuw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16580-Classic-Fish-and-chips-Step8-14df0c440532453095634b7b138418e9.jpg"
      ],
      "image": "assets/images/16580/step_09.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UzOz1b8iWbaX9ORD5jnW6RM0OoQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-16580-Classic-Fish-and-chips-Beauty-4x3-9ca78f2929a64d48ae052008d02358e2.jpg"
      ],
      "image": "assets/images/16580/step_10.webp"
    }
