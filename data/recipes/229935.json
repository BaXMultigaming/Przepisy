  "ingredients": [
    "1 cup chopped pecans",
    "0.33333334326744 cup white sugar",
    "1 (8 ounce) package cream cheese, softened",
    "1 teaspoon vanilla extract",
    "2 pounds red seedless grapes"
  ],
  "steps": [
    {
      "text": "Place pecans in a skillet over medium-low heat; cook and stir until pecans are toasted and fragrant, 3 to 5 minutes. Remove from heat and pour into a heatproof bowl; stir to prevent nuts from overcooking.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, cream cheese, and vanilla extract together with an electric mixer in a bowl until smooth. Fold in pecans and grapes. Stir gently until grapes are coated.",
      "section": null,
      "name": null,
      "url": null,
