  "ingredients": [
    "2 medium oranges",
    "1 cup water",
    "5 leaves fresh mint, or more to taste",
    "1 lemon, juiced",
    "0.125 teaspoon black salt (kala namak), or more to taste",
    "0.125 teaspoon powdered sugar, or to taste",
    "0.5 cup ice as needed",
    "2 slices jalapeno pepper, or more to taste"
  ],
  "steps": [
    {
      "text": "Peel oranges, removing threads and seeds. Cut roughly into cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer oranges into a blender with water, 3 mint leaves, lemon juice, black salt, and powdered sugar. Blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain into a large glass over ice. Add jalapeno. Taste and adjust salt and sugar as needed. Stir continuously, 10 to 15 times. Add remaining mint leaves as garnish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
