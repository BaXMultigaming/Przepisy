  "ingredients": [
    "1 cup whole wheat flour",
    "1 cup all-purpose flour",
    "1.25 teaspoons instant yeast",
    "0.5 teaspoon white sugar",
    "0.25 teaspoon salt",
    "0.75 cup warm water",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Mix whole wheat flour, all-purpose flour, yeast, sugar, and salt in a large bowl using a spoon. Pour in water and oil; mix until dough no longer sticks to the bowl. Turn dough onto a lightly floured surface and knead for 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer dough to a greased bowl; cover bowl with a clean towel. Place bowl in the oven with the light turned on until risen, about 1 hour.",
