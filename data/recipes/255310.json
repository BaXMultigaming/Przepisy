  "ingredients": [
    "0.33333334326744 cup low-calorie natural sweetener (such as Swerve®)",
    "0.25 cup almond flour",
    "0.25 cup coconut flour",
    "1 tablespoon poppy seeds",
    "1 lemon, zested",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon xanthan gum",
    "3 large eggs",
    "3 tablespoons butter",
    "2 tablespoons sour cream",
    "0.5 teaspoon vanilla extract",
    "2 tablespoons heavy whipping cream, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a muffin tin or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sweetener, almond flour, coconut flour, poppy seeds, lemon zest, baking powder, salt, and xanthan gum together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a bowl with an electric mixer on high speed until fluffy, about 2 minutes. Beat in butter, sour cream, and vanilla. Add sweetener mixture. Stir in cream slowly until batter is thick and smooth. Pour into the prepared muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops are golden, 15 to 20 minutes.",
      "section": null,
      "name": null,
