  "ingredients": [
    "1 (15 ounce) can black beans, rinsed and drained",
    "2 avocados - peeled, pitted, and cut into small cubes",
    "1 (8.75 ounce) can whole kernel corn, drained",
    "1 small red bell pepper, diced",
    "0.75 cup picante sauce",
    "0.5 cup chopped cilantro",
    "0.25 yellow onion, diced",
    "2 tablespoons lemon juice",
    "1 tablespoon olive oil",
    "1 clove garlic, minced",
    "0.5 teaspoon ground cumin"
  ],
  "steps": [
    {
      "text": "Mix together black beans, avocados, corn, red bell pepper, picante sauce, cilantro, onion, lemon juice, olive oil, garlic, and cumin in a large bowl until well combined.",
