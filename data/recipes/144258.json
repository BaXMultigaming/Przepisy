  "ingredients": [
    "2 small yellow squash, sliced",
    "2 small zucchini, sliced",
    "1 small onion, diced",
    "1 red bell pepper, minced",
    "1.5 tablespoons extra-virgin olive oil",
    "1 tablespoon lemon-pepper seasoning"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine yellow squash, zucchini, onion, and bell pepper in a bowl; drizzle with olive oil, sprinkle with lemon-pepper seasoning, and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer squash mixture to center of a large sheet of aluminum foil; top with another large sheet of aluminum foil. Roll edges of foil sheets together to seal into a packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place packet on the preheated grill; cook until vegetables are tender, about 30 minutes, flipping packet every 5 to 10 minutes.",
