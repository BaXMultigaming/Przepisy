  "ingredients": [
    "4 cups old-fashioned rolled oats",
    "1 cup sliced almonds",
    "0.5 cup unsweetened shredded coconut",
    "0.25 cup raw cashews",
    "0.25 cup whole raw hazelnuts",
    "0.25 cup raw sunflower seeds",
    "0.25 cup unsalted pumpkin seeds (pepitas)",
    "0.5 cup pure maple syrup",
    "2 tablespoons safflower oil",
    "0.5 teaspoon kosher salt",
    "0.5 cup dried cranberries",
    "0.5 cup dried hibiscus petals, coarsely chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour oats, almonds, coconut, cashews, hazelnuts, sunflower seeds, and pumpkin seeds onto a rimmed baking sheet. Add maple syrup, oil, and salt; toss together until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, tossing once, until golden and crisp, 25 to 30 minutes. Add cranberries and hibiscus petals and toss with a spoon to combine. Let cool.",
