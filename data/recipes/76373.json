  "ingredients": [
    "2 tablespoons olive oil",
    "1 pound ground beef",
    "0.5 pound chorizo sausage, chopped",
    "1 large onion, chopped",
    "0.5 cup chopped red bell pepper",
    "2 cloves garlic, chopped",
    "1 tablespoon ground cumin",
    "2 teaspoons chili powder",
    "1 teaspoon dried oregano",
    "1 teaspoon paprika",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon ground cinnamon",
    "1.5 cups canned diced tomatoes",
    "0.75 cup beef stock",
    "1 tablespoon white sugar",
    "0.5 cup raisins",
    "0.25 cup chopped pimento-stuffed green olives",
    "2 tablespoons apple cider vinegar",
    "1 tablespoon capers, drained",
    "0.33333331346512 cup slivered almonds, toasted",
    "1 tablespoon lime juice"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add ground beef and sausage; cook and stir until browned and crumbly, about 10 minutes. Drain some grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onion and bell pepper; cook and stir until soft, about 5 minutes. Stir in garlic, cumin, chili powder, oregano, paprika, cayenne pepper, and cinnamon; cook until fragrant, about 1 minute. Add tomatoes, stock, and sugar; stir to combine. Reduce the heat to low, cover, and simmer for 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add raisins, olives, vinegar, and capers to the skillet; simmer, uncovered, for 5 minutes. Stir in almonds and lime juice, and cook until warm, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
