  "ingredients": [
    "3 tablespoons canola oil",
    "2 tablespoons minced onion",
    "1 tablespoon lemon juice",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon soy sauce",
    "1 teaspoon garlic powder",
    "0.5 teaspoon ground black pepper",
    "1.5 pounds elk steak"
  ],
  "steps": [
    {
      "text": "Whisk together canola oil, onion, lemon juice, Worcestershire sauce, soy sauce, garlic powder, and pepper in a small bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place elk steak in a large resealable plastic bag and pour in Worcestershire mixture. Coat steak with marinade, squeeze out excess air, and seal the bag. Marinate in the refrigerator for at least 4 hours, turning occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain steak and discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook steaks on the preheated grill until they begin to firm up and are hot and slightly pink in the center, about 5 minutes per side. An instant-read thermometer inserted into the center should read at least 140 degrees F (60 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
