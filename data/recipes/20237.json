  "ingredients": [
    "2.5 cups all-purpose flour",
    "0.25 cup white sugar",
    "1 tablespoon pumpkin pie spice",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup canned pumpkin puree",
    "0.5 cup vegetable oil",
    "2 eggs, lightly beaten",
    "2 cups peeled, cored and chopped apple",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "4 teaspoons butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 18 muffin cups or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift 2 ½ cups flour, 2 cups sugar, pumpkin pie spice, baking soda, and salt together into a bowl. Combine pumpkin purée, oil, and eggs in a separate bowl; stir into flour mixture until batter is just moistened. Fold in apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter among the prepared muffin cups, filling each to the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk remaining ¼ cup sugar, 2 tablespoons flour, and cinnamon together in a bowl; cut in butter with 2 knives or a pastry blender until mixture resembles coarse crumbs. Sprinkle cinnamon topping evenly over muffin batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into muffins comes out clean, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
