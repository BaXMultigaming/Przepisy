  "ingredients": [
    "1 tablespoon olive oil",
    "3 cups chopped fresh mushrooms",
    "3 cups chopped fresh green beans",
    "2 tablespoons rice vinegar",
    "1 tablespoon light soy sauce, or to taste",
    "1 teaspoon honey",
    "0.5 teaspoon sesame oil",
    "2 dashes hot pepper sauce (such as Tabasco®)",
    "salt and ground pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a skillet over medium-high heat. Add mushrooms and saute for 2 to 3 minutes. Add green beans and cook until bright green, about 3 minutes. Drain off excess water, if needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add vinegar, soy sauce, honey, sesame oil, hot sauce, salt, and pepper; saute until mushrooms are soft and beans are well coated, about 3 more minutes. Serve.",
      "section": null,
      "name": null,
      "url": null,
