  "ingredients": [
    "0.75 cup chopped green olives",
    "0.75 cup chopped kalamata olives",
    "0.5 cup crumbled Gorgonzola cheese",
    "0.75 cup chopped macadamia nuts",
    "5 tablespoons chopped fresh basil leaves",
    "4 roma (plum) tomatoes, seeded and chopped",
    "1 red bell pepper, chopped",
    "3.5 tablespoons chopped fresh garlic",
    "2 tablespoons brown sugar",
    "salt to taste",
    "ground black pepper to taste",
    "1 (8 ounce) jar grape leaves packed in brine"
