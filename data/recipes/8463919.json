  "title": "Birria de Pollo (Chicken Birria)",
  "description": "This Mexican birria de pollo, or chicken birria stew is rich, hearty, and smoky. Perfect for serving with crisp tortilla chips.",
  "authors": [
    "Liv Dansky"
  ],
  "date_published": "2022-08-29T20:36:29-04:00",
