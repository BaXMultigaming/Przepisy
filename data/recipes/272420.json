  "ingredients": [
    "1.75 cups warm water",
    "2 tablespoons honey",
    "0.75 teaspoon active dry yeast",
    "3.5 cups whole wheat flour, or more as needed, divided",
    "1 tablespoon olive oil",
    "1 teaspoon sea salt"
  ],
  "steps": [
    {
      "text": "Combine warm water, honey, and yeast in the bowl of a stand mixer; let stand until foamy, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ww1e9eAuqG__rb8igsPbEJ3b4tA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272420-easy-100-whole-wheat-bread-VAT-step-01-71f05d02e32a4b6fa58df583d841ea6b.jpg"
      ],
      "image": "assets/images/272420/step_01.webp"
    },
    {
      "text": "Add 4 cups whole wheat flour, olive oil, and salt. Mix on low with the dough hook until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W6F5Jd7GPCqCTtzbW0ux2LVaM64=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272420-easy-100-whole-wheat-bread-VAT-step-02-af85b0339d7a492fb8ae4596bbbfc5a3.jpg"
      ],
      "image": "assets/images/272420/step_02.webp"
    },
    {
      "text": "Cover the bowl and let dough rest for 15 minutes to allow gluten to begin developing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6IX_Ji865D9O1psDYxOT6unyFVg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272420-easy-100-whole-wheat-bread-VAT-step-03-76ee348d2d2e4d4da4a7fb7bd9784b35.jpg"
      ],
      "image": "assets/images/272420/step_03.webp"
    },
    {
      "text": "Knead dough on medium speed until smooth and elastic and the sides of the bowl are clean, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r7FoppTc5c6k3tix9-VB3TczFxU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272420-easy-100-whole-wheat-bread-VAT-step-04-b49e4f46ab90427e8417cdd9c96670bb.jpg"
      ],
      "image": "assets/images/272420/step_04.webp"
    },
    {
      "text": "Cover the bowl and let dough rise in a warm, draft-free place until doubled in size, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xVXWH2OgE5HiSqXVCl3UDEQCvUc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272420-easy-100-whole-wheat-bread-VAT-step-05-bcd189875cef4f87b35d20029a3cf2d5.jpg"
      ],
      "image": "assets/images/272420/step_05.webp"
    },
    {
      "text": "Lightly grease a 9x5-inch loaf pan. Turn dough onto a lightly floured surface, shape into a loaf, and place seam-side down in the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BNcc228FF-IQQ1qa5J-61-L7lkM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272420-easy-100-whole-wheat-bread-VAT-step-06-ecaea06183a34f43972de87d58fbede3.jpg"
      ],
      "image": "assets/images/272420/step_06.webp"
    },
    {
      "text": "Let dough rise until it domes 1 inch above the rim of the pan, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_zjdl6bWVJWwj2Wvc0Dx-lxcbn0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272420-easy-100-whole-wheat-bread-VAT-step-07-bdfde252a31248e7ac81563a94edab1f.jpg"
      ],
      "image": "assets/images/272420/step_07.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Bake loaf in the preheated oven until golden brown and loaf sounds hollow when tapped, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XAdg7ivWSa_usYqCQXmrZ-CxvXw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272420-easy-100-whole-wheat-bread-VAT-step-08-c205a4fc8a7e4bdeafe2f6f3bcbedec6.jpg"
      ],
      "image": "assets/images/272420/step_08.webp"
    },
    {
      "text": "Remove loaf from the pan immediately and cool completely on a wire rack before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U7MNdhHhT39K-15OFA6KJ26UGy4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/272420-easy-100-whole-wheat-bread-VAT-step-09-4eddbcfe56db4970a5ecd43fb7f559fa.jpg"
      ],
      "image": "assets/images/272420/step_09.webp"
    }
  ],
