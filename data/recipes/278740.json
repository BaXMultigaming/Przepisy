  "ingredients": [
    "5 large russet potatoes, scrubbed and quartered",
    "3 cloves garlic, minced",
    "1 pinch sea salt and ground black pepper to taste",
    "1 cup water",
    "0.5 cup olive oil",
    "0.25 cup lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a 9x13-inch baking dish and season with garlic, sea salt, and pepper. Pour in water, oil, and lemon juice and mix for a few seconds with a wooden spoon to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast in the preheated oven for 40 minutes. Turn the potatoes and continue to cook until all sides are golden brown, about 25 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
