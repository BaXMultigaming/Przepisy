  "ingredients": [
    "1 (9 inch) deep dish frozen pie crust",
    "4 large eggs",
    "1 cup heavy cream",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "3 dashes hot pepper sauce (e.g. Tabasco™), or to taste",
    "1 (8 ounce) package imitation crabmeat, flaked",
    "1 cup shredded Monterey Jack cheese",
    "0.25 cup grated Parmesan cheese",
    "1 stalk green onion, chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pie crust in the preheated oven until just starting to brown, about 10 minutes. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, whisk together eggs, cream, salt, pepper, and hot sauce in a large bowl until well combined. Stir in crabmeat, Monterey Jack, Parmesan, and green onion.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour crab mixture into cooled pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes. Turn the oven off, keep the door closed, and leave quiche in the oven until firm, 20 to 30 minutes. Remove from the oven and serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
