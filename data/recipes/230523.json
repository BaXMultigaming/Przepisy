  "ingredients": [
    "2 cups water",
    "1 cup white rice",
    "1 tablespoon sesame oil",
    "5 cups chopped collard greens",
    "0.125 teaspoon minced garlic",
    "1 pinch red pepper flakes, or to taste",
    "0.33333334326744 cup almonds",
    "1 teaspoon lemon juice, or as needed",
    "1 teaspoon soy sauce",
    "0.25 teaspoon chopped fresh ginger"
  ],
  "steps": [
    {
      "text": "Bring water and rice to a boil in a saucepan. Reduce heat to medium-low, cover, and simmer until the rice is tender and the liquid has been absorbed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat sesame oil in a large skillet over medium heat; cook and stir collard greens, garlic, and red pepper flakes in the hot oil until collard greens are wilted and tender, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix almonds, lemon juice, soy sauce, and ginger into collard green mixture; simmer until liquid evaporates, about 5 minutes. Serve with rice on the side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
