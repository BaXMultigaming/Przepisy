  "ingredients": [
    "3 sweet potatoes, peeled and quartered",
    "0.5 cup firmly packed brown sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "2 large cooking apples - peeled, cored and cut into 1/4 inch rings",
    "0.25 cup all-purpose flour",
    "0.25 cup firmly packed brown sugar",
    "0.25 cup butter",
    "0.25 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Place sweet potatoes in a large saucepan with enough water to cover. Bring to a boil and cook 25 minutes, or until tender but firm. Drain, cool and cut into 1/4 inch slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease a 7x11 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix brown sugar, cinnamon and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Layer sweet potatoes, brown sugar mixture and apples in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix flour, brown sugar, butter and pecans. Sprinkle over the sweet potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven 30 minutes, or until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
