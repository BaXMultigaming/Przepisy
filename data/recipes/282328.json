  "ingredients": [
    "3 cups cooked rice",
    "1 (16 ounce) package frozen stir-fry vegetables, thawed",
    "6 ounces shredded sharp Cheddar cheese",
    "6 tablespoons salted butter",
    "0.25 cup lemon juice",
    "2 teaspoons chicken bouillon granules",
    "0.5 teaspoon ground paprika",
    "0.5 teaspoon ground black pepper",
    "1 pound tilapia fillets"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooked rice, thawed vegetables, and Cheddar cheese in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a small saucepan over low heat; stir in lemon juice, bouillon granules, paprika, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add ½ butter mixture to rice mixture; stir to combine. Transfer rice mixture to the prepared baking dish. Place tilapia fillets in a single layer on top of rice; pour remaining butter mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
