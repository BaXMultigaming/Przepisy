  "ingredients": [
    "1 (3 pound) cauliflower",
    "0.25 cup water, or as needed",
    "0.75 cup mayonnaise",
    "0.25 cup grated Parmesan cheese",
    "2 cloves garlic, minced",
    "1 tablespoon chopped fresh chives"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees F).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut off leaves and bottom core from cauliflower. Place in a shallow microwave-safe baking dish and add about 1-inch water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on high for 8 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together mayonnaise, Parmesan cheese, and garlic in a small bowl until combined. Spread all over cauliflower.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tender and golden brown, 15 to 20 minutes. Sprinkle with chives to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
