  "ingredients": [
    "3 cups all-purpose flour",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1 cup butter, softened",
    "1 cup white sugar",
    "0.33333334326744 cup lemon juice",
    "1.25 cups powdered sugar",
    "2 tablespoons lemon juice"
  ],
  "steps": [
    {
      "text": "Sift flour, baking powder, and baking soda together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter and sugar together in a bowl using an electric mixer until fluffy. Mix in lemon juice. Add flour mixture gradually, beating well after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into a log shape and wrap with waxed paper. Refrigerate for 3 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line cookie sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice chilled dough into roughly 1/8-inch slices. Place onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set and golden, 7 to 8 minutes. Remove from the oven and let cool completely, 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine powdered sugar and lemon juice in a bowl until smooth. Frost cooled cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
