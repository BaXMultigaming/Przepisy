  "ingredients": [
    "2 cups all-purpose flour",
    "0.25 cup white sugar",
    "2 teaspoons baking powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "1 cup milk",
    "1 large egg, beaten",
    "0.25 cup butter, melted",
    "1 cup apple - peeled, cored, and chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease 12 muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together flour, sugar, baking powder, cinnamon, and salt. Stir together milk, egg, and butter in a separate bowl. Stir egg mixture into flour mixture just until combined. Fold in chopped apples. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center of muffins comes out clean, 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
