  "ingredients": [
    "1 cup white sugar",
    "0.33333334326744 cup packed brown sugar",
    "0.25 cup unsalted butter, softened",
    "2 large eggs",
    "1 cup mashed ripe banana",
    "1 cup sour cream",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "0.5 cup semisweet chocolate chips",
    "0.5 cup unsweetened flaked coconut",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream white sugar, brown sugar, and butter together in a large bowl until smooth. Beat in eggs, one at a time. Stir in banana, sour cream, and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, baking soda, and salt together in another bowl; gently stir into wet mixture just until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss together chocolate chips, coconut, and cinnamon in a small bowl. Fold about 2/3 of the mixture into the batter, then pour batter into the prepared pan. Sprinkle with remaining chocolate chip mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until a toothpick inserted into the center of the loaf comes out clean, 60 to 65 minutes. Cool in the pan for 10 minutes, then transfer to a wire rack and cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
