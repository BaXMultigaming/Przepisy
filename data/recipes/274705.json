  "ingredients": [
    "4 cups brown sugar",
    "3.5 cups fresh pumpkin puree",
    "1 mashed ripe banana",
    "1 cup vegetable oil",
    "6 large eggs",
    "4.5 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1.5 teaspoons baking soda",
    "1.25 teaspoons salt",
    "3 teaspoons ground cinnamon",
    "3 teaspoons ground nutmeg",
    "3 teaspoons ground cloves",
    "2 cups chopped walnuts",
    "0.75 cup green hulled pumpkin seeds (pepitas)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour three 9x5-inch inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, pumpkin puree, banana, oil, and eggs in a bowl and beat with an electric mixer until well combined. Mix together flour, baking powder, baking soda, salt, cinnamon, nutmeg, cloves, and walnuts. Slowly mix into pumpkin mixture until well blended. Divide batter evenly between the prepared pans. Sprinkle with pepitas.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top of the loaf springs back when lightly pressed, 45 minutes to 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
