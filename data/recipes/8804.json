  "ingredients": [
    "0.5 cup all-purpose flour",
    "1 cup water",
    "0.5 cup drippings from a roast chicken",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
