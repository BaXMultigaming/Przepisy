  "ingredients": [
    "1 pound lean ground beef",
    "4 ounces bacon, chopped",
    "0.5 cup chopped onion",
    "1 (16 ounce) can baked beans with pork",
    "1 (15 ounce) can kidney beans, undrained",
    "1 (15 ounce) can butter beans, undrained",
    "0.75 cup packed brown sugar",
    "0.5 cup ketchup",
    "1 tablespoon dry mustard",
    "2 teaspoons white vinegar",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat. Cook and stir beef, bacon, and onion in the hot skillet until beef is browned and crumbly, 5 to 7 minutes. Drain fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine baked beans with pork, kidney beans, and butter beans in a large bowl. Stir in brown sugar, ketchup, mustard, and vinegar. Add cooked beef mixture; mix thoroughly and season with salt and pepper. Transfer mixture to a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
