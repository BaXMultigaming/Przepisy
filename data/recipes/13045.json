  "ingredients": [
    "0.5 cup butter",
    "1 onion, chopped",
    "1 (16 ounce) package frozen chopped broccoli",
    "4 (14.5 ounce) cans chicken broth",
    "1 (1 pound) loaf processed cheese food, cubed",
    "2 cups milk",
    "1 tablespoon garlic powder",
    "0.66666668653488 cup cornstarch",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium heat. Add onion and cook, stirring occasionally, until soft; stir in broccoli.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N_dLjls__Tljh1laATe9ZSs8gxw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13045-broccoli-cheese-soup-VAT-step-02-bc529e7207a34b8c8b6e2ecb8d0afe02.jpg"
      ],
      "image": "assets/images/13045/step_01.webp"
    },
    {
      "text": "Add broth and simmer until broccoli is tender, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XZXLn3FwBL5Z1pfSJe7GjA8ga1s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13045-broccoli-cheese-soup-VAT-step-03-203204187672474a8d715fe00942e8b6.jpg"
      ],
      "image": "assets/images/13045/step_02.webp"
    },
    {
      "text": "Reduce heat; add cheese, and stir until melted. Stir in milk and garlic powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N3yVyRkO7cNyKyrXSuS7dd2f0Y8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-13045-broccoli-cheese-soup-VAT-step-04-2beafa6041354c1e9502fdd568870f09.jpg"
      ],
      "image": "assets/images/13045/step_03.webp"
    },
    {
      "text": "Stir cornstarch and water together in a small bowl until smooth. Stir into soup; cook, stirring frequently, until thick.",
