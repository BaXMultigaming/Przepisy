  "ingredients": [
    "1.5 cups packed brown sugar",
    "0.5 cup butter, softened",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "1.5 teaspoons baking powder",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground ginger",
    "1 pear - peeled, cored and diced",
    "0.5 cup raisins",
    "0.5 cup chopped walnuts",
    "1.5 cups confectioners' sugar",
    "2.5 tablespoons lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat white sugar and butter together in a large bowl with an electric mixer until smooth; beat in egg and vanilla extract. Whisk flour, baking powder, cinnamon, and ginger together in a separate bowl; stir into sugar mixture until well combined. Stir in pear, raisins, and walnuts until evenly distributed. Drop dough by rounded tablespoonfuls about 2 inches apart onto baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden brown and centers spring back when lightly pressed, about 15 minutes. Transfer to wire racks to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine confectioners' sugar and lemon juice in a bowl until smooth; drizzle over cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
