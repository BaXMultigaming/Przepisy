  "ingredients": [
    "1 (8 ounce) package reduced-fat cream cheese, softened",
    "1 tablespoon apple juice",
    "2 tablespoons brown sugar",
    "0.5 teaspoon apple pie spice",
    "1 red apple, chopped",
    "0.25 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Combine cream cheese and apple juice in a bowl and beat with the electric mixer on medium speed until fluffy. Beat in brown sugar and apple pie spice. Fold in apple and pecans.",
