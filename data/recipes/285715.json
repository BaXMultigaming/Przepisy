  "steps": [
    {
      "text": "Combine 1 cup blackberries, water, 1/2 cup sugar, zest and juice of 1 lime, and saffron in a saucepan over medium heat. Bring to a boil and stir until sugar is dissolved, about 3 minutes. Remove from heat and allow syrup to cool completely, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 2 tablespoons sugar on a saucer. Dip rim of champagne glasses in lime juice and dip in sugar to create a sugar-rimmed glass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1 tablespoon syrup into each champagne glass and top with about 4 ounces sparkling wine. Garnish with a blackberry and lime wedge.",
