  "ingredients": [
    "2 cups whole wheat flour",
    "1 cup all purpose flour",
    "3 tablespoons baking powder",
    "0.25 teaspoon salt",
    "1 tablespoon sugar",
    "1 teaspoon cinnamon",
    "0.33333334326744 cup cold butter",
    "0.75 cup chopped dates",
    "0.5 cup chocolate chips",
    "1.5 cups milk",
    "milk for brushing",
    "extra sugar and cinnamon to sprinkle"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift together wheat and all-purpose flours, baking powder, salt, sugar and cinnamon into a large bowl. Rub butter into dry ingredients until it resembles fine breadcrumbs. Stir in dates and chocolate chips. Mix in the milk, just until blended and form dough into a ball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the dough out onto a floured surface. Roll into a circle about 1/2 inch thick. Dip a round cookie cutter into flour (to prevent sticking) then cut out round scones. Place scones on a greased baking sheet. Brush with milk and sprinkle with cinnamon and sugar mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until risen and golden brown, 10 to 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
