  "ingredients": [
    "1 (5.3 ounce) container low-fat vanilla Greek yogurt",
    "0.5 cup chopped kiwi",
    "2 tablespoons chopped macadamia nuts",
    "1 teaspoon agave nectar",
    "1 teaspoon chopped fresh mint"
  ],
  "steps": [
    {
      "text": "Spoon 1/3 cup yogurt into a 6- to 8-ounce parfait glass or jar. Top yogurt with 1/2 of the kiwi, 1/2 of the macadamia nuts, 1/2 of the agave. Repeat layers with the remaining yogurt, kiwi, nuts, and agave. Top parfait with mint.",
