  "ingredients": [
    "2 tablespoons sesame oil",
    "2 tablespoons soy sauce",
    "1 tablespoon honey",
    "1 tablespoon sriracha sauce",
    "1 teaspoon rice vinegar",
    "2 pounds chicken thighs",
    "1 green onion, chopped",
    "2 tablespoons toasted sesame seeds"
  ],
  "steps": [
    {
      "text": "Combine sesame oil, soy sauce, honey, sriracha, and vinegar in a large bowl. Add chicken and stir to combine. Cover and refrigerate for at least 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C). Drain marinade from the chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken thighs skin-side up in the basket of the air fryer. Cook for 5 minutes. Flip and cook an additional 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken to a plate and let rest 5 minutes before serving. Garnish with green onion and sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
