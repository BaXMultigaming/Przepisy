  "ingredients": [
    "1.5 cups cottage cheese",
    "1 cup eggs",
    "2 tablespoons all-purpose flour",
    "2 tablespoons coconut oil",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Blend cottage cheese, eggs, flour, coconut oil, and vanilla extract together in a blender until batter is smooth.",
      "section": null,
      "name": null,
