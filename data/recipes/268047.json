  "ingredients": [
    "4 cups dry white wine",
    "2.25 cups apple juice",
    "1 lemon, zest cut off in a spiral",
    "1 (1 inch) piece fresh ginger root, sliced",
    "0.25 cup white sugar",
    "1 cinnamon stick",
    "6 tablespoons rum"
  ],
  "steps": [
    {
      "text": "Combine white wine, apple juice, lemon zest, ginger, sugar, and cinnamon stick in a saucepan over medium-low heat and slowly heat, but do not boil. Keep hot on low heat without simmering for 1 hour to infuse the wine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Strain hot mulled wine through a small sieve into heatproof glasses. Add 1 tablespoon rum to each glass.",
      "section": null,
