  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup yellow cornmeal",
    "1 tablespoon white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon cayenne pepper",
    "0.25 cup chopped fresh chives",
    "0.25 cup chopped fresh dill",
    "1.5 cups plain yogurt",
    "2 large eggs",
    "3 tablespoons butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F (220 degrees C). Grease 12 muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cornmeal, sugar, baking powder, salt, baking soda, and cayenne pepper together in a bowl. Stir in chives and dill.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk yogurt, eggs, and melted butter together in a separate bowl; add to the dry ingredients and stir until just blended into a batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/3 cup batter into each prepared muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until golden and a toothpick inserted into the center comes out clean, about 20 minutes. Cool in the pans for 10 minutes before removing. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
