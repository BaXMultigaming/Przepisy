  "ingredients": [
    "0.5 cup butter, melted",
    "1.25 cups white sugar, divided",
    "1 cup all-purpose flour",
    "2 teaspoons baking powder",
    "0.75 cup milk",
    "1 (20 ounce) can sliced apples",
    "1 teaspoon ground cinnamon",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Pour butter into 9-inch round baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1 cup sugar, flour, and baking powder together in a bowl. Stir in milk. Pour batter into the baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange apples over the batter; sprinkle remaining 1/4 cup sugar and cinnamon on top. Pour in water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 45 minutes.",
