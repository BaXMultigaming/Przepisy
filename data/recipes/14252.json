  "title": "Asian Chicken Salad",
  "description": "This Asian chicken has it all — crisp iceberg lettuce, tender chicken, crunchy fried rice noodles, and a sweet and sour sesame and soy dressing.",
  "authors": [
    "Jill Lopez"
  ],
  "date_published": "1999-08-24T05:58:44-04:00",
