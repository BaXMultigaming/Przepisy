  "title": "Yaki Mandu (Korean Dumplings)",
  "description": "Yaki mandu are fried Korean dumplings with a savory beef and veggie filling, served with a delicious dipping sauce for a crispy appetizer everyone will love.",
  "authors": [
    "Ivy Yapelli"
  ],
  "date_published": "2018-06-08T10:23:22-04:00",
  "date_modified": "2026-05-06T14:30:38-04:00",
  "prep_time": "PT30M",
