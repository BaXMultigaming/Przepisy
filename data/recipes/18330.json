  "ingredients": [
    "2 tablespoons butter",
    "2 (15 ounce) cans sliced potatoes, drained",
    "4.5 teaspoons Italian seasoning",
    "4.5 teaspoons paprika",
    "1 teaspoon garlic salt"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium heat. Stir in potatoes, Italian seasoning, paprika, and garlic salt. Cook, stirring occasionally, until potatoes are reddish brown and tender, about 12 minutes.",
