  "ingredients": [
    "1 (18.25 ounce) package chocolate cake mix",
    "3 eggs",
    "0.5 cup butter",
    "1 cup semisweet chocolate chips",
    "1 cup chopped walnuts",
    "4 cups confectioners' sugar",
    "1 (8 ounce) package cream cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 13x9 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the chocolate cake mix, 1 of the eggs, and the butter or margarine and mix until smooth. Pat mixture into the prepared pan. Sprinkle the semi sweet chocolate chips and the chopped nuts evenly over the cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together the confectioner's sugar, cream cheese, and the remaining 2 eggs until well blended. Pour over the semi-sweet chocolate chips and the chopped nuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for about 40 minutes. Let cake cool a little before cutting. Serve warm or cooled.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
