  "title": "Bourbon Apple Cider and Honey Glazed Pork Chops",
  "description": "Make pork chops with an apple, honey, and whiskey glaze, or just use the glaze itself to baste a special baked ham.",
  "authors": [
    "Tess DeFevers Ehling"
  ],
  "date_published": "2020-03-05T00:08:44-05:00",
