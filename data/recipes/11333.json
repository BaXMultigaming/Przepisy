  "ingredients": [
    "0.5 cup butter, softened",
    "0.75 cup white sugar",
    "0.66666698455811 cup packed brown sugar",
    "2 egg whites",
    "1.25 cups crunchy peanut butter",
    "1.5 teaspoons vanilla extract",
    "1 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "5 (2.1 ounce) bars chocolate-covered crispy peanut butter candy"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream the butter and the brown and white sugars together until light and fluffy. Add the egg whites and beat well. Beat in the peanut butter and the vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the flour, baking soda and salt. Add to the creamed mixture and mix well. Stir in the chopped candy bars. Shape dough into 1 1/2 inch balls and place on the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 10 to 12 minutes or until golden brown. Let cookies cool on wire racks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
