  "ingredients": [
    "1 (750 milliliter) bottle dry white wine",
    "1 onion, thinly sliced",
    "1 rib celery, sliced",
    "6 whole peppercorns",
    "1 bay leaf",
    "1 whole salmon, cleaned",
    "1 bunch fresh dill",
