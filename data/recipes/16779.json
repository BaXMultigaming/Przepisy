    "1 cup white sugar",
    "0.25 cup cocoa powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup water",
    "0.33333334326744 cup vegetable oil",
    "1 teaspoon vanilla extract",
    "1 teaspoon distilled white vinegar"
