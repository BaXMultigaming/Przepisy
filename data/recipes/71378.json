  "ingredients": [
    "0.75 cup Italian seasoned bread crumbs",
    "1 (1 ounce) package dry Ranch-style dressing mix",
    "2.5 tablespoons vegetable oil",
    "1 pound tilapia fillets",
    "2 teaspoons butter"
  ],
  "steps": [
    {
      "text": "Place bread crumbs in a bowl. In a shallow dish, mix dressing mix and oil to form a paste. Coat tilapia fillets with the paste, then dredge in bread crumbs to lightly coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a skillet over medium heat. Place fillets in the skillet, and cook 5 minutes on each side, or until golden brown and easily flaked with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
