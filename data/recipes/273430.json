    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 recipe unbaked pie crust",
    "0.25 cup white sugar",
    "1 tablespoon cornstarch",
    "1 (12 ounce) package frozen raspberries",
    "1.5 tablespoons water",
    "1.5 tablespoons lemon juice",
    "1 tablespoon butter",
    "0.5 teaspoon vanilla extract",
    "1.5 cups heavy cream",
    "1 (8 ounce) package cream cheese, softened",
    "0.75 cup powdered sugar",
    "1 tablespoon vanilla extract",
    "0.5 cup sour cream"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dTzS4nM1J9Nj97x5opWiSUvtJF4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273430-raspberry-cream-pie-VAT-005-step-01-106acd80f12d46e7b367b73abd9e3f4f.jpg"
      ],
      "image": "assets/images/273430/step_01.webp"
    },
    {
      "text": "Roll out pie crust and gently lay inside a 9-inch pie dish. Lightly press the dough into the corners and sides of the dish to help prevent shrinkage. Prick the bottom of the pie crust a few times with a fork. Line the bottom with foil or parchment and fill with dried beans or pie weights.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WyZ8Tm7BcFjZRYaDuQKFZzLHjf4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273430-raspberry-cream-pie-VAT-006-step-02-75979e360b7548688df2231d5c4f5519.jpg"
      ],
      "image": "assets/images/273430/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven for 20 minutes. Remove lining and beans or weights and continue baking until crust is golden brown, about 15 minutes more. Let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eJnm2JYnZGOLmbzuyr4iF7fU-x8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273430-raspberry-cream-pie-VAT-007-step-03-96fff80d97704299b6b976f93020c2e3.jpg"
      ],
      "image": "assets/images/273430/step_03.webp"
    },
    {
      "text": "Meanwhile, whisk sugar and cornstarch together in a medium saucepan. Stir in raspberries, water, and lemon juice. Bring to a boil, stirring constantly. Boil until thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FcpRk_Ao5zpgXNG74a3F3YSFvx0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273430-raspberry-cream-pie-VAT-008-step-04-f9d76e4400154371b6a016ce334fcc38.jpg"
      ],
      "image": "assets/images/273430/step_04.webp"
    },
    {
      "text": "Remove from heat; stir in butter and vanilla extract. Set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6HFssw19FW29-9zjsUUuxpFk3vM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273430-raspberry-cream-pie-VAT-009-step-05-03setaside-aa3edf13fd624a18ac2d50f67dc39740.jpg"
      ],
      "image": "assets/images/273430/step_05.webp"
    },
    {
      "text": "Pour heavy cream into the bowl of a stand mixer fitted with the whisk attachment. Beat on medium speed until stiff peaks form. Transfer to another bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KxPvi_q3clm2igVsyH1XL_WLTRs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273430-raspberry-cream-pie-VAT-010-step-06-01-59ceeb3409c0415ab2b1277f2bfd74bc.jpg"
      ],
      "image": "assets/images/273430/step_06.webp"
    },
    {
      "text": "Combine cream cheese, powdered sugar, and vanilla extract in the stand mixer bowl. Switch to the paddle attachment and beat until well combined, about 2 minutes. Fold in whipped cream and sour cream until evenly incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cT36tAgwblkBUdZWT9ze5zrI1Tg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273430-raspberry-cream-pie-VAT-011-step-07-02nohand-6444a289aad643e18c72a66ac8db9866.jpg"
      ],
      "image": "assets/images/273430/step_07.webp"
    },
    {
      "text": "Spread cream filling into the cooled pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/L3G6cT1RR5CY0rYe1nYHwh2kwwU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273430-raspberry-cream-pie-VAT-012-step-08-74403521d56241b1b3ab8c64f485ab6a.jpg"
      ],
      "image": "assets/images/273430/step_08.webp"
    },
    {
      "text": "Top with the cooled raspberry topping. Refrigerate pie until thoroughly chilled, 2 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Fq3kf9uYNarJ0g95FWhzMiAj394=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/273430-raspberry-cream-pie-VAT-013-step-09-23a90464dbbf4f7da1687c5ceb323e9f.jpg"
      ],
      "image": "assets/images/273430/step_09.webp"
    }
  ],
