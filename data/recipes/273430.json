  "title": "Raspberry Cream Pie",
  "description": "Filled with a fluffy cream cheese layer and topped with tart raspberry jam, this no-bake pie is the perfect way to end a summer meal.",
  "authors": [
    "The Sweet and Sour Baker"
  ],
  "date_published": "2020-06-19T00:36:55-04:00",
  "date_modified": "2026-03-18T14:10:17-04:00",
