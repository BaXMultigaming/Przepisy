  "ingredients": [
    "cooking spray",
    "0.75 cup chopped onion",
    "0.5 cup chopped zucchini",
    "0.75 cup chopped cauliflower",
    "2 tablespoons water",
    "10 large egg whites",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon cayenne pepper",
    "0.25 teaspoon salt",
    "0.25 teaspoon freshly ground black pepper",
    "0.25 cup shredded pepperjack cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat a skillet with cooking spray and place over medium heat; cook and stir onion and zucchini until tender, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cauliflower in a microwave-safe bowl and add water; cook in microwave until cauliflower is tender, about 3 minutes. Drain water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk egg whites, garlic powder, cayenne pepper, salt, and pepper together in a bowl; add zucchini-onion mixture, cauliflower, and pepperjack cheese. Pour egg mixture into a 10-inch round pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until quiche is set in the middle, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
