  "ingredients": [
    "2 pounds apples - peeled, cored and sliced",
    "2 cups water",
    "2 pounds tomatoes, sliced",
    "2 large onions, chopped",
    "2.5 cups malt vinegar",
    "0.75 cup white sugar",
    "0.5 cup sultana raisins",
    "5 teaspoons curry powder",
    "4 teaspoons salt",
    "1 tablespoon mustard seed",
    "1 teaspoon cayenne pepper",
    "1 clove garlic, chopped"
  ],
  "steps": [
    {
      "text": "Place apples and water in a large saucepan. Bring to a boil, reduce heat, and cook until apples are tender, stirring occasionally, about 25 minutes. Add more water as necessary to keep apples simmering.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add tomatoes, onions, vinegar, sugar, raisins, curry, salt, mustard seeds, cayenne, and garlic to the saucepan. Stir until sugar dissolves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring mixture to a boil. Reduce heat, and simmer until very thick, stirring occasionally, about 3 hours. Remove and discard mustard seed. Seal chutney in sterile containers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
