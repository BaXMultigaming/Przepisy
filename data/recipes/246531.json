  "ingredients": [
    "3 tablespoons butter",
    "0.25 cup minced onion",
    "1 clove garlic, minced",
    "3 pickled jalapeno pepper slices, minced",
    "2 tablespoons all-purpose flour",
    "1 cup milk",
    "0.25 (1 pound) loaf processed cheese food (such as Velveeta®)",
    "0.25 teaspoon pickled jalapeno pepper juice"
  ],
  "steps": [
    {
      "text": "Melt butter in a saucepan over medium-low heat. Add onion, garlic, and jalapeno; cook and stir until onion turns translucent, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour into onion mixture until vegetables are evenly coated. Pour in milk; cook and stir until mixture thickens slightly, 3 to 4 minutes. Add processed cheese food, stirring constantly, until melted and smooth, about 15 minutes more. Stir in pickled jalapeno juice.",
      "section": null,
      "name": null,
      "url": null,
