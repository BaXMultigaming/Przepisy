  "ingredients": [
    "0.5 cup extra virgin olive oil",
    "0.5 cup butter",
    "1 cup minced onion",
    "0.5 cup minced celery",
    "0.25 cup minced carrot",
    "1 pound ground veal",
    "1 pound ground pork",
    "0.5 pound ground beef",
    "0.25 cup finely chopped pancetta bacon",
    "0.5 cup milk",
    "2 cups tomato sauce",
    "2 cups beef broth"
  ],
  "steps": [
    {
      "text": "Heat olive oil and butter in a large saucepan over medium heat. Saute onion, celery and carrots until soft. Add veal, pork, beef and pancetta, and cook until evenly brown, 15 to 20 minutes. Pour in milk, and cook until liquid has evaporated, about 15 minutes. Stir in tomato sauce and beef broth. Cover, and simmer 2 1/2 hours.",
