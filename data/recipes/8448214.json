  "title": "Microwave Potato Chips",
  "description": "Chef John shows us how to make crispy, homemade potato chips in a microwave in this quick, easy, and budget-friendly recipe.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2022-08-05T09:00:00-04:00",
