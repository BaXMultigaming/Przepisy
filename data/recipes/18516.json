  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.5 cup white sugar",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "1 pinch salt",
    "0.5 cup fat free sour cream",
    "0.25 cup skim milk",
    "2 tablespoons applesauce",
    "1 egg",
    "0.5 teaspoon almond extract",
    "0.5 cup mulberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease 6 jumbo muffin cups or line with paper muffin liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, baking soda, and salt. In a medium bowl, mix together sour cream, milk, applesauce, egg, and almond extract. Stir in flour mixture until batter is smooth. Fold in mulberries. Spoon batter into prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes, until a toothpick inserted into center of a muffin comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
