  "ingredients": [
    "canola oil cooking spray",
    "0.5 cup water",
    "1 egg, beaten",
    "1.5 cups bread crumbs",
    "6 tablespoons grated Parmesan cheese, divided",
    "1 tablespoon dried oregano",
    "1 teaspoon dried basil",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon garlic powder",
    "6 skinless, boneless chicken breast halves",
    "2 cups spaghetti sauce",
    "1 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x13-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk water and egg together in a bowl until smooth. Combine bread crumbs, 2 tablespoons Parmesan cheese, oregano, basil, thyme, and garlic powder in a separate bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/41haWSA4H_LeAtUVb-tXGCn6KQw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Quick-Baked-Chicken-Parmesan-ddmfs-step-01-49109903abee40abb512dc4a72387856.jpg"
      ],
      "image": "assets/images/239507/step_02.webp"
    },
    {
      "text": "Dip each chicken breast in egg mixture, allowing excess egg to drip back into bowl. Coat each chicken breast in bread crumb mixture, shaking off excess.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ND9oj3Wq2T-3Ixj99FJN52l66Gk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Quick-Baked-Chicken-Parmesan-ddmfs-step-02-8c861d7a89b741f3adab13dba4df74c3.jpg"
      ],
      "image": "assets/images/239507/step_03.webp"
    },
    {
      "text": "Repeat dipping each coated chicken breast in egg mixture and the bread crumb mixture for a double-coating and place in the prepared baking dish. Spray breaded chicken breasts with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qHisRWnu0ux5ij_jleKA7HJhfxc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Quick-Baked-Chicken-Parmesan-ddmfs-step-03-a8c71afab6bc4b49be05ecfa932e06f9.jpg"
      ],
      "image": "assets/images/239507/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven for 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour spaghetti sauce over each chicken breast and top each with mozzarella cheese and remaining Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6INAAt5X2RQJSogTQwzhtJ4ThcY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/Quick-Baked-Chicken-Parmesan-ddmfs-step-04-2996c22e2d284e68b44947c0a005f570.jpg"
      ],
      "image": "assets/images/239507/step_06.webp"
    },
    {
      "text": "Continue baking until chicken is no longer pink in the center and the cheeses are melted, about 15 minutes more. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve over pasta.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6AoyWWCMKjDxDfNpXSxznq6ZurA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239507-quick-baked-chicken-parmesan-DDMFS-4x3-1811756bffbb4b02a9a6efbefde02423.jpg"
      ],
      "image": "assets/images/239507/step_08.webp"
    }
  ],
