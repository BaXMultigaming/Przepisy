  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "1 (3.4 ounce) package instant vanilla pudding mix",
    "2 tablespoons poppy seeds",
    "1 cup water",
    "0.5 cup vegetable oil",
    "4 eggs",
    "1 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together cake mix, pudding mix, and poppy seeds. Make a well in the center and pour in water, oil, eggs, and almond extract. Beat on low speed until blended. Scrape the bowl, then beat for 4 minutes on medium speed. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of the cake comes out clean, about 50 minutes. Let cool in pan for 10 minutes, then turn out onto a wire rack and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
