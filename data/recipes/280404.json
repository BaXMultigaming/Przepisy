  "ingredients": [
    "1 loaf bread",
    "3 extra large eggs",
    "0.5 cup milk",
    "0.5 teaspoon vanilla extract",
    "1 cup white sugar",
    "0.33333334326744 cup baking mix (such as Bisquick ®)",
    "1 teaspoon ground cinnamon",
    "3 tablespoons unsalted butter",
    "1 cup powdered sugar",
    "2 tablespoons milk, or more as needed",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice bread into 1-inch thick slices, then cut each slice into thirds, making sticks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, milk, and vanilla extract together in a shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, baking mix, and cinnamon together on a shallow plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip sticks quickly into egg mixture on all sides. Don't make them too wet. Coat with cinnamon and sugar mixture. Place on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden and crispy, turning once halfway through cooking, 15 to 20 minutes total.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While sticks are baking, melt butter for icing in a saucepan over medium heat. Remove from heat and add powdered sugar, milk, and vanilla extract. Stir until smooth, adding more milk if needed for drizzling consistency. Serve French toast sticks with icing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
