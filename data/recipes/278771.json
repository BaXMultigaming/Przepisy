  "ingredients": [
    "1 teaspoon extra-virgin olive oil",
    "0.25 cup packed light brown sugar",
    "4 tablespoons low-sodium soy sauce",
    "1 tablespoon grated fresh ginger",
    "1 tablespoon onion powder",
    "2 teaspoons sesame oil",
    "1 pinch red pepper flakes, or to taste",
    "18 ounces boneless skinless chicken breast, sliced",
    "1 tablespoon minced garlic",
    "0.5 teaspoon sea salt",
    "0.25 tablespoon chopped fresh ginger",
    "2 teaspoons reduced-sodium soy sauce",
    "1.5 teaspoons extra-virgin olive oil",
    "1 teaspoon rice vinegar",
    "1 teaspoon cider vinegar",
    "1 teaspoon honey",
    "0.5 lime, zested",
    "1.125 cups broccoli coleslaw mix",
    "0.25 cup chopped fresh cilantro",
    "1 green onion, chopped",
    "0.125 cup sour cream",
    "0.125 cup mayonnaise",
    "1 teaspoon garlic powder",
    "1 teaspoon onion powder",
    "0.5 teaspoon chile-garlic sauce (such as Sriracha®)",
    "0.5 lime, juiced",
    "4 low-carb flour tortillas (such as Mission® Carb Balance®)"
  ],
  "steps": [
    {
      "text": "Set a slow cooker to High and add 1 teaspoon olive oil. Whisk brown sugar, soy sauce, ginger, onion powder, sesame oil, and red pepper flakes together in a small mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken and garlic into the slow cooker, sprinkle with sea salt, and stir. Pour in soy sauce mixture and combine. Turn the slow cooker to Low and cook until chicken is no longer pink, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk ginger, soy sauce, 1 1/2 teaspoons oil, rice vinegar, cider vinegar, honey, and lime zest for slaw in a large mixing bowl. Add broccoli slaw mix, cilantro, and green onion. Toss to combine and chill in the refrigerator until serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sour cream, mayonnaise, garlic powder, onion powder, Sriracha, and lime juice into a small mixing bowl and whisk together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Wrap tortillas in foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven until warm, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place taco filling evenly on tortillas, top with broccoli slaw, and drizzle with sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
