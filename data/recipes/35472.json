  "ingredients": [
    "1 cup fresh or frozen raspberries",
    "0.5 cup chopped green bell pepper",
    "0.25 cup chopped jalapeno pepper",
    "3 cups white sugar",
    "0.75 cup apple cider vinegar",
    "0.33333334326744 (6 fluid ounce) container liquid pectin"
