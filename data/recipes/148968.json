  "ingredients": [
    "0.75 cup old-fashioned rolled oats",
    "0.5 teaspoon ground cinnamon, or to taste",
    "0.25 cup dried cranberries",
    "0.5 cup frozen blueberries",
    "0.25 teaspoon ground turmeric",
    "1 pinch ground ginger",
    "1 cup water",
    "0.25 cup orange juice, or as needed"
  ],
  "steps": [
    {
      "text": "Place the rolled oats, cinnamon, cranberries, and blueberries in a microwave safe bowl. Add the turmeric and ginger, if desired. Pour in the water, and stir to mix ingredients. Cook on High until water is absorbed, about 2 minutes. Stir in orange juice to desired consistency.",
