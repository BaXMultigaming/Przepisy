  "title": "Cream of Broccoli Soup",
  "description": "This tasty broccoli soup is a delightful contrast of textures with half of the broccoli puréed and the other half roughly chopped.",
  "authors": [
    "William Uncle Bill Anatooskin"
  ],
  "date_published": "1999-02-17T08:29:20-05:00",
