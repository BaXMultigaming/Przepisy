  "ingredients": [
    "1 (9 inch) prepared pie crust",
    "0.66666668653488 cup water",
    "0.33333334326744 cup pureed strawberries",
    "1 cup white sugar",
    "1 (3 ounce) package strawberry flavored Jell-O®",
    "2 tablespoons cornstarch",
    "0.25 teaspoon salt",
    "2 pints strawberries, cleaned and stemmed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (205 degrees C). Line pastry with a double layer of aluminum foil and a layer of pie weights or dried beans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edge of crust is golden, about 10 minutes. Carefully remove the foil and weights and bake until the crust has set, about 5 minutes more. Allow crust to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and pureed strawberries to a boil in a saucepan. Stir in sugar, gelatin, cornstarch, and salt until dissolved, 2 to 3 minutes, stirring constantly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange strawberries in pie crust and pour gelatin mixture over berries. Chill until gelatin is set or overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
