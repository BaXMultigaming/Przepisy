      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/579tIMCd9uQAA3nLOUhbOeaKIRI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12612-RhubarbAndStrawberryPie-mfs-Step5-3454-24d67a2ce2df4bfc95cfcf92ca859877.jpg"
      ],
      "image": "assets/images/12612/step_04.webp"
    },
    {
      "text": "Brush egg yolk on top of pie with a pastry brush.",
      "section": null,
      "name": null,
      "url": null,
