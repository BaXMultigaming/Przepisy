      "image": "assets/images/12612/step_05.webp"
    },
    {
      "text": "Sprinkle with sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-8FkQNM6s4MVF3EGF9Uprd2jWk0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12612-RhubarbAndStrawberryPie-mfs-Step7-3460-99709ba613924d639da007bef1e6e0cc.jpg"
