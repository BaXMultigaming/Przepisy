  "ingredients": [
    "1 cup white sugar",
    "0.5 cup all-purpose flour",
    "1 pound rhubarb, cut into 1/4 inch slices",
    "2 pints strawberries, hulled and quartered",
    "1 (14.1 ounce) package pastry for a double crust 9-inch pie",
    "2 tablespoons butter",
    "1 large egg yolk",
    "2 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and sugar together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/69iGG8j1aPZZohTG07PNT5mH1BQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12612-RhubarbAndStrawberryPie-mfs-Step1-3444-e1b280b02b1a4ae0aa1257126ffec6ec.jpg"
      ],
      "image": "assets/images/12612/step_02.webp"
    },
    {
      "text": "Add strawberries and chopped rhubarb. Toss with sugar and flour and let stand for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fCfwdbNNhd59Nmvq2YLnwqyMOrs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12612-RhubarbAndStrawberryPie-mfs-Step2-3447-5e84856185684f26b73339e3db3a6c47.jpg"
      ],
      "image": "assets/images/12612/step_03.webp"
    },
    {
      "text": "Pour filling into prepared pie crust. Dot top with butter, and cover with top crust. Seal edges of top and bottom crust with water.",
