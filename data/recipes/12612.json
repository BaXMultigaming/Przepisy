        "https://www.allrecipes.com/thmb/nymfiLMXVd06Xbrz_QmAP2010hM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/12612-RhubarbAndStrawberryPie-mfs-Step6-3457-90f0b8a5354a477dab860c9de4a48a3d.jpg"
