  "ingredients": [
    "1.5 cups graham cracker crumbs",
    "6 tablespoons butter, melted",
    "0.33333334326744 cup white sugar",
    "0.25 teaspoon pumpkin pie spice",
    "1 (12 fluid ounce) can 2% evaporated milk",
    "1 (5.1 ounce) package instant vanilla pudding mix",
    "1 (15 ounce) can pumpkin puree",
    "0.75 teaspoon pumpkin pie spice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs, butter, sugar, and ¼ teaspoon pumpkin pie spice in a bowl until evenly moistened; press into the bottom and up the sides of a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly browned, about 7 minutes. Cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk evaporated milk and pudding mix together in a bowl for 2 minutes; chill in the refrigerator for 5 minutes. Stir pumpkin purée and ¾ teaspoon pumpkin pie spice into pudding until well combined. Spread pumpkin pudding filling into cooled pie crust. Refrigerate until chilled, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
