  "ingredients": [
    "1 large head napa cabbage, shredded",
    "0.5 cup olive oil",
    "1 (3 ounce) package ramen noodles, crushed",
    "0.5 cup sesame seeds",
    "3 ounces blanched slivered almonds",
    "1 cup canola oil",
    "2 teaspoons soy sauce",
    "0.66666668653488 cup white sugar",
    "2 tablespoons balsamic vinegar",
    "6 tablespoons white wine vinegar"
  ],
  "steps": [
    {
      "text": "Place the cabbage in a large bowl, cover, and place in the refrigerator to chill for 30 minutes. Heat the olive oil in a skillet over medium heat, and cook and stir the ramen noodles, sesame seeds, and almonds until lightly browned; set aside to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare the dressing by mixing the canola oil, soy sauce, sugar, balsamic, and white vinegars in a blender until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "About 30 minutes before serving, toss the dressing and cabbage mixture together; chill. Just before serving, toss the noodle mixture with the cabbage mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
