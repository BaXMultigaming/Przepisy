  "ingredients": [
    "1 cup milk",
    "1 cup white sugar",
    "3 large eggs",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground ginger",
    "0.13 teaspoon ground cloves",
    "0.5 teaspoon salt",
    "3.5 cups pumpkin puree",
    "1 (15.25 ounce) package yellow cake mix",
    "1 cup chopped pecans",
    "0.75 cup butter, melted",
    "1 cup whipped heavy cream"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, sugar, eggs, cinnamon, ginger, cloves, salt, and pumpkin together in a large bowl. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle cake mix and pecans on top of mixture; drizzle melted butter over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned on top, about 1 hour. Serve with freshly whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
