  "ingredients": [
    "1 (10 ounce) package frozen unsweetened raspberries, thawed",
    "0.5 cup red currant jelly",
    "1 tablespoon cold water",
    "1.5 teaspoons cornstarch"
  ],
  "steps": [
    {
      "text": "Combine raspberries and jelly in a medium saucepan over medium heat; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir water and cornstarch together in a small bowl until cornstarch is dissolved; stir into raspberry mixture. Bring to a boil, stirring constantly; boil while stirring, about 1 minute. Cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press raspberry mixture through a sieve; discard seeds. Chill before serving, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
