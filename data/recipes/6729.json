  "title": "Maple Zucchini Bread",
  "description": "This maple zucchini bread recipe makes two deliciously moist zucchini-nut loaves enhanced by maple flavoring. Freeze one loaf or share with a friend.",
  "authors": [
    "Marian Collins"
  ],
  "date_published": "1998-06-20T10:40:08-04:00",
