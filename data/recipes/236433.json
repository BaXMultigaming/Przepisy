  "ingredients": [
    "2 pounds sirloin steak, pounded to 1/4-inch thickness and cut into 1 x 1 1/2-inch strips",
    "0.5 cup red wine",
    "0.25 cup all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon paprika",
    "0.5 teaspoon ground black pepper",
    "0.25 cup butter",
    "1 small onion, diced",
    "3 cloves garlic, minced",
    "2 cups canned sliced mushrooms",
    "1 (10 ounce) can beef broth",
    "0.5 cup water",
    "1 tablespoon Worcestershire sauce",
    "2 teaspoons red pepper flakes",
    "1 teaspoon prepared yellow mustard",
    "0.33333334326744 cup cream cheese",
    "0.33333334326744 cup sour cream",
    "2 cups hot cooked noodles"
  ],
  "steps": [
    {
      "text": "Combine steak and red wine in a bowl; marinate for 15 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, salt, paprika, and black pepper in a resealable plastic bag. Remove steak from marinade and shake off excess. Reserve and set aside red wine marinade. Add steak to flour mixture; shake to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium-high heat. Add steak, onion, and garlic; cook and stir until steak is browned and onion is softened and translucent, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir mushrooms, beef broth, water, reserved red wine marinade, Worcestershire sauce, red pepper flakes, and mustard into steak mixture until combined; bring to a boil. Reduce heat, cover skillet, and simmer until steak is very tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir cream cheese and sour cream into steak mixture; cook and stir until warmed through, 2 to 3 minutes. Serve over cooked noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
