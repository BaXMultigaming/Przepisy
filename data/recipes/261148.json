  "title": "Creamy Pasta Bake with Cherry Tomatoes and Basil",
  "description": "This creamy pasta bake is easy to make with penne, cherry tomatoes, basil, Parmesan, and mozzarella for a comforting weeknight vegetarian pasta dish.",
  "authors": [
    "Julian"
  ],
  "date_published": "2020-06-19T00:25:10-04:00",
