  "ingredients": [
    "1 head cauliflower",
    "1 egg, beaten",
    "0.5 cup plain bread crumbs",
    "0.5 teaspoon chili powder",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "1 pound shredded Colby-Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Use a knife to cut the stem out of the cauliflower head; it should look like a bowl when done. Dip cauliflower into the beaten egg. Dip outside in bread crumbs to cover, leaving space where stem was removed. Place into a deep oven-safe baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chili powder, cumin, onion powder, and garlic powder together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place Colby-Jack cheese in the empty \"bowl\" space of cauliflower. Sprinkle seasoning mix all over top of cheese and cauliflower.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cauliflower is tender, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
