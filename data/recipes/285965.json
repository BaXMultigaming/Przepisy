  "ingredients": [
    "2.5 cups biscuit baking mix, divided",
    "0.25 cup white sugar",
    "0.75 cup milk",
    "1 large egg",
    "2 cups sliced fresh strawberries",
    "0.5 cup brown sugar",
    "0.25 cup unsalted butter, softened"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a 9-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 cups biscuit mix with white sugar. Stir in milk and egg and beat with an electric mixer until well combined. Pour mixture into the prepared baking pan and spread sliced strawberries over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1/2 cup biscuit mix with brown sugar. Add softened butter and stir with a fork until crumbly. Spread topping over the strawberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
