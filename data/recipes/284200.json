  "ingredients": [
    "1 cup coconut jam",
    "0.5 cup light brown sugar",
    "4 tablespoons vegan butter",
    "3 tablespoons golden syrup",
    "3.5 cups oats",
    "0.25 cup coconut flakes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 10x7-inch glass pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine coconut jam, brown sugar, vegan butter, and golden syrup in a saucepan over medium-low heat. Cook until melted together, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, pulse oats in a food processor until finely ground.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add ground oats to the melted jam-sugar mixture; stir until coated. Spread mixture in the prepared pan. Sprinkle coconut flakes on top and press down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through, about 10 minutes. Remove from the oven and let cool completely, about 30 minutes, before cutting into 36 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
