  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "2 cups all-purpose flour",
    "2 tablespoons all-purpose flour",
    "1 tablespoon unsweetened cocoa powder",
    "2 teaspoons ground ginger",
    "1.5 teaspoons ground cinnamon",
    "1.5 teaspoons baking soda",
    "0.5 teaspoon fine salt",
    "0.25 teaspoon ground cloves",
    "0.125 teaspoon ground black pepper",
    "0.125 teaspoon cayenne pepper",
    "12 tablespoons unsalted butter, softened",
    "0.66 cup white sugar",
    "0.25 cup molasses",
    "0.5 teaspoon vanilla extract",
    "1 large egg",
    "1 cup powdered sugar",
    "4 teaspoons water, or as needed"
  ],
  "steps": [
    {
      "text": "Gather all the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YHGhe4I8KO17ClDWdhrX__-8RbU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8513071-gingerbread-snowflakes-ingredients-ee146201119b42a9baf67600e31150c4.jpg"
      ],
      "image": "assets/images/8513071/step_01.webp"
    },
    {
      "text": "Whisk 2 cups plus 2 tablespoons flour, cocoa powder, ground ginger, cinnamon, baking soda, salt, cloves, black pepper, and cayenne together in a large bowl until thoroughly mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TkVCw_ZkzqC2N3IGqzuLYBqylxU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8513071-gingerbread-snowflakes-step-01-02a54728d55f4efa9058103112378745.jpg"
      ],
      "image": "assets/images/8513071/step_02.webp"
    },
    {
      "text": "Cream together butter and sugar in a separate bowl with an electric mixer until pale yellow and creamy, about 2 minutes. Add molasses, vanilla, and egg. Whisk mixture until well blended. Add flour mixture to butter mixture and stir just until the flour disappears.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wKFXWM1Vn8ZPoJoN57YwoT6o_-M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8513071-gingerbread-snowflakes-step-02-A-eb24b73b9fa940b1bd50cef2f17a3919.jpg"
      ],
      "image": "assets/images/8513071/step_03.webp"
    },
    {
      "text": "Spread out a piece of plastic wrap on the counter and set dough on top. Wrap dough with plastic wrap while shaping it into a rectangle approximately 1-inch high by 4 to 5 inches wide. Refrigerate until dough is cold and firm, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tigw-ibuYGF2UUxn1obLialU4tA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8513071-gingerbread-snowflakes-step-02-B-b07c0c73b75543a79308b2b4eb0b33f0.jpg"
      ],
      "image": "assets/images/8513071/step_04.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a baking sheet with a Silpat mat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Pm9t1Pqi6xx3G7wbYuYsP3Cgbw8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8513071-gingerbread-snowflakes-step-03-5282616603154a77b46bf8908732417e.jpg"
      ],
      "image": "assets/images/8513071/step_05.webp"
    },
    {
      "text": "After the dough has chilled, slice across the block into 14 or 15 pieces about 3/8 inch thick. Each slice is then cut in half, and each half into 3 strips lengthwise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pz42e5gyk91iGQkPFmGAbabYZtc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8513071-gingerbread-snowflakes-step-04-289652ab40ae448582df7dfea5d0758b.jpg"
      ],
      "image": "assets/images/8513071/step_06.webp"
    },
    {
      "text": "Use 3 strips of the dough to form the 6-pointed star as shown and place onto the prepared baking sheet with space in between as they spread out.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AXUK3ivDG6_alblvj3A_BmTNK9o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8513071-gingerbread-snowflakes-step-05-c8505f89ec124c37a84442eb57496739.jpg"
      ],
      "image": "assets/images/8513071/step_07.webp"
    },
    {
      "text": "Bake in the preheated oven for about 12 minutes if you like the cookies to be chewy, or 15 minutes for crispy cookies. Remove from the oven and wait for 5 minutes before carefully transferring cookies to a wire rack. Allow to cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VwXfsSww6BwaVLgC0CuijCQOlH8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8513071-gingerbread-snowflakes-step-06-3f27770e2a57482f82f3e7cc76cb6f02.jpg"
      ],
      "image": "assets/images/8513071/step_08.webp"
    },
    {
      "text": "Mix together the powdered sugar and water until a ribbon is formed. Transfer the icing into a piping bag with a small round tip. Pipe snowflake designs onto the cooled cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gBBjLEYVyz70EdQLogrqPjk--xk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8513071-gingerbread-snowflakes-step-07-013590dd245f4076897242e1ac93890a.jpg"
      ],
      "image": "assets/images/8513071/step_09.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F9vbP54qp5K0_qI5IQU1WGwwGlI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-8513071-gingerbread-snowflakes-03-4x3-6c0885f02f0441f2bb2ec30721955685.jpg"
      ],
      "image": "assets/images/8513071/step_10.webp"
    }
  ],
