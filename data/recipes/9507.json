  "ingredients": [
    "1 cup raisins",
    "0.33329999446869 cup shredded carrots",
    "2 cups water",
    "1 cup all-purpose flour",
    "1 cup quick cooking oats",
    "1.5 teaspoons artificial sweetener",
    "0.5 teaspoon salt",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 cup margarine, softened",
    "0.25 cup egg substitute",
    "1 teaspoon vanilla extract",
    "0.33300000429153 cup pecans, coarsely chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 7x11 inch baking dish. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine raisins, carrots, and water in a medium saucepan. Bring to a boil, reduce heat and simmer for 10 minutes. Remove from heat and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a mixing bowl, combine flour, oatmeal, sugar substitute, salt, baking soda and cinnamon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a separate bowl, mix together the margarine, egg substitute, and vanilla. Add to the flour mixture and mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the raisin mixture and nuts, mix well and pour into baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 35 minutes or until toothpick inserted in middle comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
