  "title": "Ham and Chicken Casserole",
  "description": "A creamy noodle casserole made with cooked chicken, ham, celery, and cheese.",
  "authors": [
    "Jan Taylor"
  ],
  "date_published": "2000-02-07T12:44:49-05:00",
