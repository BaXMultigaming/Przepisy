  "ingredients": [
    "0.5 cup uncooked egg noodles",
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "1 cup milk",
    "0.5 cup cooked, cubed chicken breast meat",
    "0.5 cup cooked, diced ham",
    "0.25 cup chopped celery",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "3 ounces shredded Cheddar cheese",
    "1 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease a medium baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a saucepan of lightly salted water to a boil. Cook egg noodles in boiling water for 6 to 8 minutes, or until al dente. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium-low heat. Mix in flour, heating until bubbly. Slowly whisk in milk. Cook for 5 minutes, stirring constantly, or until thick and smooth. Remove the saucepan from heat. Mix in the noodles, chicken, ham, celery, salt, and pepper. Spoon the mixture into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 minutes in the preheated oven. Sprinkle with cheese and paprika, and continue baking for another 5 minutes. Serve hot!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
