  "ingredients": [
    "1 pound ground beef",
    "1 cup diced onion",
    "1 cup diced green bell pepper",
    "2 cloves garlic, minced",
    "0.25 cup medium salsa (such as Pace®)",
    "0.5 tablespoon Greek seasoning (such as Cavender's®)",
    "0.5 teaspoon ground black pepper",
    "kosher salt to taste",
    "1 (15 ounce) can Southwestern-style beans, undrained (such as Ranch Style®)"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes. Add onion and bell pepper and cook until onion is softened and translucent, about 5 minutes. Add garlic and cook until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add in salsa, Greek seasoning, pepper, and salt. Cook and stir until well combined, 2 to 3 minutes. Stir in beans. Bring to a boil, reduce heat, and simmer to desired thickness, about 20 minutes. Add water if sauce becomes too thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
