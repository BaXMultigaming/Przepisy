  "ingredients": [
    "1 egg",
    "6 slices bacon",
    "0.5 cup sliced onion",
    "0.25 cup white wine vinegar",
    "0.25 cup water",
    "4 teaspoons white sugar",
    "0.5 teaspoon salt",
    "8 cups leaf lettuce - rinsed, dried and torn into bite-size pieces",
    "8 radishes, thinly sliced"
  ],
  "steps": [
    {
      "text": "Place egg in a saucepan and cover with cold water. Bring water to a boil; cover, remove from heat, and let egg stand in hot water for 10 to 12 minutes. Remove from hot water, cool, peel and chop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium high heat until evenly brown. Drain, crumble and set aside. Reserve excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add onions to skillet with reserved grease and cook until tender. Add bacon, vinegar, water, sugar and salt. Stir and bring to boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place lettuce in a large bowl. Pour hot dressing over and toss well. Garnish with egg and radishes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
