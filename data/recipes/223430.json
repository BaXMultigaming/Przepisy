  "ingredients": [
    "1 (18.25 ounce) package angel food cake mix",
    "1.25 cups water",
    "4 eggs",
    "1 cup whole milk",
    "2 tablespoons brown sugar",
    "1 teaspoon ground cinnamon",
    "1 teaspoon vanilla extract",
    "1 pinch salt",
    "2 tablespoons butter, divided"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cake mix and water together in a bowl until moist; pour into a 10-inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is golden brown, cracked, and looks dry, 38 to 48 minutes. Set aside 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, milk, brown sugar, cinnamon, vanilla, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut cake into 12 slices. Dip each slice in the egg mixture to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt enough of the butter in a large skillet over medium heat to coat the cooking surface. Cook the cake slices in batches the skillet until golden brown, 2 to 3 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
