  "ingredients": [
    "1 recipe pastry for a 9 inch single crust pie",
    "2 eggs",
    "0.5 teaspoon ground cinnamon",
    "0.5 cup white sugar",
    "0.25 teaspoon salt",
    "2 cups half-and-half cream",
    "1 cup persimmon pulp",
    "2 tablespoons butter, melted",
    "1 teaspoon lemon juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Place a sheet pan on the lowest oven rack to preheat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine eggs, cinnamon, sugar, and salt. Whisk in cream, persimmon pulp, melted butter, and lemon juice. Pour into unbaked pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 10 minutes on preheated sheet pan. Reduce heat to 350 degrees F (175 degrees C), and bake an additional 30 minutes, or until center is almost set but still slightly jiggly. Cool completely before slicing. Serve with whipped cream, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
