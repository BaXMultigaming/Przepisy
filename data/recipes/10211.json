  "ingredients": [
    "3.25 cups crushed vanilla wafers",
    "0.75 cup confectioners' sugar",
    "0.25 cup unsweetened cocoa powder",
    "1.5 cups chopped walnuts",
    "3 tablespoons light corn syrup",
    "0.5 cup rum"
  ],
  "steps": [
    {
      "text": "Stir crushed vanilla wafers, 3/4 cup confectioners' sugar, cocoa, and nuts together in a large bowl. Blend in corn syrup and rum.",
