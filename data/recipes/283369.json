  "ingredients": [
    "1 tablespoon salted butter",
    "1 medium onion, chopped",
    "1 (32 fluid ounce) container chicken broth",
    "1 medium head cauliflower, chopped into small florets",
    "1 (16 ounce) package aged Cheddar cheese",
    "5 cups milk",
    "0.5 cup all-purpose flour",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a large pot over medium heat. Add onion; cook until softened, 3 to 5 minutes. Add chicken broth and cauliflower; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat slightly; simmer until cauliflower is tender, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, grate Cheddar cheese. Whisk milk and flour together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When cauliflower is tender, slowly add milk-flour mixture, stirring until combined. Simmer until soup thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, stir in Cheddar until melted and combined; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
