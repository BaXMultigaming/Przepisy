    "publisher-tested"
  ],
  "ingredients": [
    "3 cups all-purpose flour",
    "0.25 cup white sugar",
    "0.25 teaspoon ground cinnamon",
    "3 tablespoons shortening",
    "0.5 cup sweet Marsala wine",
    "2 tablespoons water",
    "1 tablespoon distilled white vinegar",
    "1 egg",
    "1 egg yolk",
    "1 egg white",
    "1 quart oil for frying, or as needed",
    "1 (32 ounce) container ricotta cheese",
    "0.5 cup confectioners' sugar",
    "4 ounces semisweet chocolate, chopped",
    "1 teaspoon lemon zest, or to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/TKhfxeS-gg9dVeWjRerzsH886tY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88849-cannoli-DDMFS-020-step-01-be471cbc1e884a5a9aeb2bb0121dfde0.jpg"
      ],
      "image": "assets/images/88849/step_01.webp"
    },
    {
      "text": "Mix flour, sugar, and cinnamon together in a medium bowl; cut in shortening until crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/P5_zihVpP4JMI868Csg7Doveta8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88849-cannoli-DDMFS-021-step-02-99c34c919e3e4f1f860bee8c649e07bc.jpg"
      ],
      "image": "assets/images/88849/step_02.webp"
    },
    {
      "text": "Make a well in the center; add Marsala wine, water, vinegar, egg, and egg yolk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yICTnqsH42Bo8Iu5FjjSas2-8Wc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88849-cannoli-DDMFS-022-step-03-12bac2e73c21423db08bca9280a348d7.jpg"
      ],
      "image": "assets/images/88849/step_03.webp"
    },
    {
      "text": "Mix with a fork until the dough becomes stiff; finish kneading by hand on a clean surface, adding a bit more water if needed for about 10 minutes. Cover with plastic wrap and refrigerate for 1 to 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RhFeRKsXSlqT-KRpPDjree6zFvY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88849-cannoli-DDMFS-023-step-04-28895235dd3b400eba467dbd29595dc2.jpg"
      ],
      "image": "assets/images/88849/step_04.webp"
    },
    {
      "text": "Divide cannoli dough into three balls; flatten each one just enough to get through the pasta machine. Roll 1 ball of dough through successively thinner settings until reach the thinnest setting. Dust lightly with flour if necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BR7QNhyYz9duydl7zoYr_1DzXvw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88849-cannoli-DDMFS-027-step-05-ab0b7ae98513439998c59326ad03cb70.jpg"
      ],
      "image": "assets/images/88849/step_05.webp"
    },
    {
      "text": "Place dough sheet on a lightly floured surface; cut out 4 to 5-inch circles using a cutter or large glass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UsSFdHz9L9gtOwVUQrTBB7KDkuY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88849-cannoli-DDMFS-029-step-06-21e13c369c80492caf1c1ed18ab2078e.jpg"
      ],
      "image": "assets/images/88849/step_06.webp"
    },
    {
      "text": "Lightly dust dough circles with flour. This will help you later in removing the shells from the tubes. Roll dough around cannoli tubes, sealing edges with a bit of egg white. Repeat with remaining dough balls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OJq75fi0ByfGXkKu695EXCQJoKc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88849-cannoli-DDMFS-031-step-07-8ab6bc6a98824425b97e172052b344bd.jpg"
      ],
      "image": "assets/images/88849/step_07.webp"
    },
    {
      "text": "Heat oil in a deep fryer or deep skillet to 375 degrees F (190 degrees C). Fry shells on the tubes in hot oil, a few at a time, until golden, 2 to 3 minutes; turn as needed using tongs. Remove shells carefully using tongs; place on a cooling rack set over paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FEGTETCzIh5QdticBN0ZerdzRyk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88849-cannoli-DDMFS-040-step-08-fbb8922915d043e7a7b4d0b5ac1afd79.jpg"
      ],
      "image": "assets/images/88849/step_08.webp"
    },
    {
      "text": "Cool just long enough that you can handle the tubes, then carefully twist tubes to remove shells. Using a tea towel may help you get a better grip. Wash or wipe off the tubes; use them for more shells. Place cooled shells in an airtight container for up to 2 months. You should only fill them up to 1 hour before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/f7mEQJpohmvKlBLdBtwXKdcvRD8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88849-cannoli-DDMFS-042-step-09-69f730a288414339872b43a87ad66e81.jpg"
      ],
      "image": "assets/images/88849/step_09.webp"
    },
    {
      "text": "Mix ricotta cheese and confectioners' sugar together in a large bowl until well combined; fold in chocolate and lemon zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hMQ7eqskPg5cNgToYZ-8Y_6Cxow=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88849-cannoli-DDMFS-045-step-10-e1eb4987e4694889b257c5556fa5707a.jpg"
      ],
      "image": "assets/images/88849/step_10.webp"
    },
    {
      "text": "Transfer filling mixture to a pastry bag; pipe into shells, filling from the center to one end, then repeating on the other side. Dust with confectioners' sugar to serve, if you like.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PNjosjjsOHJrj7F_xfY09PosrGI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88849-cannoli-DDMFS-094-step-11-cbd2715d437341d5ae162b76c64177a2.jpg"
      ],
      "image": "assets/images/88849/step_11.webp"
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mF2U10mqpcxfPS6iG0oIOXhsZio=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/88849-cannoli-DDMFS-111-4x3-03d470d2c9da43f4bf679695221a15b0.jpg"
      ],
      "image": "assets/images/88849/step_12.webp"
    }
  ],
