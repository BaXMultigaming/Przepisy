  "ingredients": [
    "2 tablespoons soy sauce",
    "2 tablespoons water",
    "1 teaspoon white sugar",
    "3 tablespoons vegetable oil",
    "5 cloves garlic, minced",
    "1.25 pounds large shrimp, peeled and deveined"
  ],
  "steps": [
    {
      "text": "Stir together soy sauce, water, and sugar in a small bowl.",
