  "ingredients": [
    "1 tablespoon olive oil",
    "2 cloves garlic, crushed",
    "1 yellow onion, chopped",
    "1 large carrot, chopped",
    "1 (10 ounce) can golden corn, drained",
    "salt and pepper to taste",
    "5 cups chicken broth",
    "1 (15.5 ounce) can white beans",
    "1 cup diced fresh tomatoes",
    "1 teaspoon dried thyme",
    "1 teaspoon dried summer savory",
    "1 teaspoon dried parsley"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yOvhJQ8o70Lo4iO7WN0KDISf4zY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-68361-white-bean-soup-step-01-77f0b98a4a3742f5be64a4fd90195750.jpg"
      ],
      "image": "assets/images/68361/step_01.webp"
    },
    {
      "text": "Heat oil in a large stockpot over medium-high heat. Sauté garlic and onion until tender, approximately 5 minutes. Stir in carrot and corn. Season with salt and pepper; cook for another 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DADetVHvVXNPxBxYhZokmmA3yVw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-68361-white-bean-soup-step-02-a114ba034ff949ab997127c3520d6faf.jpg"
      ],
      "image": "assets/images/68361/step_02.webp"
    },
    {
      "text": "Pour in chicken broth, beans, tomatoes, thyme, savory, and parsley. Bring to a low boil, reduce heat, cover and simmer for approximately one hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7Tn5ZrpH1xTe3PzVpFr8E2ti0tg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-68361-white-bean-soup-step-03-2f9affc8059a480889e1a925c5e7fd62.jpg"
      ],
      "image": "assets/images/68361/step_03.webp"
    },
    {
      "text": "Separate soup into 2 equal portions; allow to cool to room temperature. Once cooled, puree 1 portion in a blender or food processor until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FilKKJp7EEufJye3ClWmjWb1uOs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-68361-white-bean-soup-step-04-b052f931e06249a6b6d59e840a78ed05.jpg"
      ],
      "image": "assets/images/68361/step_04.webp"
    },
    {
      "text": "Return both batches to the stockpot; heat until warmed through. Adjust seasoning with salt and pepper as needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oQV4fcoavDoNmVEyxR3xQaRE_9k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-recipe-68361-white-bean-soup-step-05-0fff10f3ce7648b5ad26819409744071.jpg"
      ],
      "image": "assets/images/68361/step_05.webp"
    }
