  "ingredients": [
    "0.5 cup butter",
    "1 cup brown sugar",
    "2 refrigerated 9-inch pie crusts, divided",
    "5 Granny Smith apples, peeled and sliced",
    "1 cup white sugar",
    "2 teaspoons ground cinnamon",
    "2 teaspoons all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Place butter in a large cast-iron skillet; place in oven while preheating until melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar into melted butter in the skillet; return to oven until bubbling, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently place 1 pie crust on top of brown sugar mixture, without pressing down; arrange apple slices on top of crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, cinnamon, and flour in a bowl; sprinkle over apple slices. Place remaining 1 pie crust over apple slices; cut slits in top crust for ventilation. Seal top and bottom crusts together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top crust is lightly browned, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
