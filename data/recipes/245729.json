  "ingredients": [
    "3 tablespoons mayonnaise",
    "1 canned chipotle pepper, diced",
    "3 cooked pork cutlets",
    "3 naan breads",
    "2 tablespoons water",
    "3 slices Gouda cheese",
    "0.75 cup shredded lettuce",
    "3 green onions, chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mayonnaise with diced chipotle pepper in a small bowl; mix well to make chipotle mayonnaise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place pork cutlets and naan bread on separate baking sheets. Sprinkle water over naan bread.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat pork cutlets in the preheated oven until warmed through, about 5 minutes. Top each cutlet with 1 slice of cheese and continue to heat until cheese is melted, about 5 minutes. Remove from oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Warm naan in the preheated oven until softened, about 5 minutes. Remove from oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread chipotle mayonnaise over each naan bread; place a pork cutlet on top. Top with shredded lettuce and green onions; fold sides of naan over pork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
