  "ingredients": [
    "4 hard-boiled egg yolks",
    "3 large Egg, yolk, raw, fresh",
    "0.5 cup extra-virgin olive oil",
    "2 tablespoons Dijon mustard",
    "2 tablespoons sour cream",
    "1 teaspoon lemon juice, or to taste"
  ],
  "steps": [
    {
      "text": "Press hard-boiled egg yolks through a fine mesh sieve into a porcelain bowl. Add raw egg yolks and whisk until fluffy and creamy. Add oil, 1 tablespoon at a time, whisking constantly until consistency is like mayonnaise. Whisk in mustard, sour cream, and lemon juice.",
