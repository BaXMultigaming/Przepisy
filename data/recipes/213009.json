  "ingredients": [
    "1.5 teaspoons vegetable oil, or as needed",
    "3 large eggs",
    "0.5 cup half-and-half",
    "0.25 cup canned pumpkin purée",
    "1 teaspoon ground cinnamon",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon pumpkin pie spice",
    "0.25 cup finely chopped walnuts",
    "8 slices day-old bread"
  ],
  "steps": [
    {
      "text": "Lightly oil a skillet and heat over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, half-and-half, pumpkin purée, cinnamon, vanilla, and pumpkin pie spice together in a bowl; stir in walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip 1 bread slice into pumpkin mixture; soak. Add soaked bread slices to the hot skillet, in batches. Repeat with remaining bread slices, stirring pumpkin mixture to redistribute walnuts as necessary.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook batches until golden brown, about 3 minutes per side. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
