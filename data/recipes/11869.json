  "ingredients": [
    "1 cup creamy salad dressing (e.g. Miracle Whip)",
    "1 teaspoon dried dill weed",
    "0.5 teaspoon ground black pepper",
    "2 cups elbow macaroni",
    "1 cup broccoli florets",
    "1 cup chopped carrots",
    "1 cup sliced celery",
    "1 cup cucumber - peeled, seeded and chopped",
    "1 (5 ounce) can tuna, drained"
  ],
  "steps": [
    {
      "text": "Combine salad dressing, dill, and black pepper in a large bowl until well mixed. Stir in macaroni, broccoli, carrots, celery, cucumber, and tuna until well blended. Cover the bowl; refrigerate until ready to serve.",
