  "ingredients": [
    "2 cups small seashell pasta",
    "3.5 cups chopped poached chicken breast meat",
    "0.5 cup diced celery",
    "1 cup seedless green grapes, halved",
    "salt to taste",
    "0.25 teaspoon ground white pepper",
    "0.33333298563957 cup mayonnaise",
    "0.5 teaspoon curry powder",
    "0.25 teaspoon ground cumin",
    "2 tablespoons rice vinegar",
    "1 tablespoon white sugar"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta, and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine chicken, celery, grapes, cooked pasta, salt, and white pepper; mix well and reserve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, combine mayonnaise, curry powder, cumin, rice vinegar, and sugar; whisk ingredients together and toss with chicken mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover salad with plastic wrap and refrigerate for at least 2 to 4 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
