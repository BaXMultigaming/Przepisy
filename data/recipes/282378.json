  "ingredients": [
    "1 cup water",
    "0.75 cup unsalted butter",
    "0.75 cup canola oil",
    "4.5 ounces bittersweet chocolate, finely chopped",
    "3 cups all-purpose flour",
    "3 cups white sugar",
    "0.75 cup unsweetened cocoa powder",
    "2.5 teaspoons baking soda",
    "0.5 teaspoon salt",
    "3 large eggs, at room temperature",
    "0.75 cup buttermilk, at room temperature",
    "2 teaspoons pure vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line two 12-cup muffin tins with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, butter, oil, and chocolate in a large saucepan. Heat over medium heat until melted and fully combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, cocoa, baking soda, and salt together in a large bowl. Pour in hot chocolate mixture and whisk until combined. Whisk in eggs, one at a time. Whisk in buttermilk and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 17 to 22 minutes. Cool for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
