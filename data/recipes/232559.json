  "ingredients": [
    "2 teaspoons olive oil, or as needed",
    "0.25 cup chopped onion",
    "2 cloves garlic, minced",
    "1 pound ground beef",
    "12 ounces chorizo sausage",
    "1 (14 ounce) can diced tomatoes",
    "1 (14 ounce) can prepared chili",
    "1 (14 ounce) can butter beans",
    "0.75 cup tomato sauce",
    "1 tablespoon chili powder",
    "1 tablespoon salt-free seasoning blend (such as Mrs. Dash® Chipotle seasoning)",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a skillet over medium heat. Add onion and garlic; cook and stir until tender, about 5 minutes. Stir in ground beef and chorizo and cook, breaking meat apart while stirring, until no longer pink, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to a slow cooker and stir in diced tomatoes, chili, butter beans, tomato sauce, chili powder, seasoning blend, salt, and pepper. Cover and cook on High until flavors have blended, 3 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
