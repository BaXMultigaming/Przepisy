  "ingredients": [
    "1 tablespoon unsalted butter",
    "1 small yellow onion, finely chopped",
    "1 clove garlic, minced",
    "1 cup quinoa",
    "1.25 cups water",
    "5 (5 ounce) packages baby spinach",
    "1 tablespoon grated lemon zest",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan over medium heat; cook and stir onion and garlic until onion is softened, about 4 minutes. Add quinoa to onion mixture; cook and stir for about 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour water over quinoa mixture; bring to a boil. Reduce heat to medium, cover saucepan, and simmer until quinoa is tender and water is absorbed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir spinach and lemon zest into quinoa mixture; season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
