  "ingredients": [
    "1 (16 ounce) package baby carrots",
    "0.5 cup butter",
    "0.5 cup brown sugar",
    "3 tablespoons honey"
  ],
  "steps": [
    {
      "text": "Place carrots in a large pot and cover with salted water. Bring to a boil over high heat and cook until carrots are tender, about 15 minutes. Remove from the stove and drain carrots in a strainer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gEb04Jjv1aMB_l924uW1_Q0FeS0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/107344-sweet-baby-carrots-ddmfs-step-1-0173-3x4-f328f28c6e4e4a64bb959d131369061b.jpg"
      ],
      "image": "assets/images/107344/step_01.webp"
    },
    {
      "text": "Return the pot to the stove, add butter, and reduce the heat to medium-low. When butter is melted, stir in brown sugar and honey.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xqsR_MsjyIFDqAHt57hAECOHmJY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/107344-sweet-baby-carrots-ddmfs-step-2-0176-3x4-6aa722296ae84991918505f73934c7a7.jpg"
      ],
      "image": "assets/images/107344/step_02.webp"
    },
    {
      "text": "Add carrots and stir until evenly coated. Cook for 5 more minutes before serving.",
      "section": null,
      "name": null,
