    "0.25 cup seasoned bread crumbs",
    "0.25 cup finely diced onion",
    "2 egg whites, lightly beaten",
    "0.25 cup chopped fresh parsley",
    "1 clove garlic, peeled and minced",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper"
