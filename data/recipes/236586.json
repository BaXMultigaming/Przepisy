  "ingredients": [
    "1 (8 ounce) package penne pasta",
    "1 teaspoon olive oil",
    "1 onion, chopped",
    "3 cups chopped cooked chicken",
    "1 (14 ounce) can Italian-style diced tomatoes",
    "1 (10 ounce) package spinach",
    "1 (8 ounce) package cream cheese, softened",
    "1.5 cups shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil; add penne and cook, stirring occasionally, until tender yet firm to the bite, about 11 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a skillet over medium-high heat. Sauté onion in hot oil until tender, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix penne pasta, onion, chicken, diced tomatoes, spinach, and cream cheese together in a 9x13-inch baking dish until the cream cheese melts and coats everything. Sprinkle mozzarella cheese over the pasta mixture. Cover baking dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 minutes. Remove foil and continue baking until heated through and beginning to brown along the edges, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
