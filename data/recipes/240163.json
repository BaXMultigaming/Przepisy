  "ingredients": [
    "4 cups cold milk",
    "2 (3.9 ounce) packages instant chocolate pudding mix",
    "1 (14 ounce) package chocolate sandwich cookies (such as Oreo®), crushed",
    "1 baked pie crust",
    "1 (8 ounce) container frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Beat milk and pudding mix together in a large bowl with an electric mixer until thick and smooth, about 2 minutes. Add crushed cookies; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate pudding mixture until partially set, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pudding mixture into baked pie crust; top with whipped topping.",
