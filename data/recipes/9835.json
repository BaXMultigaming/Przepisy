  "ingredients": [
    "0.66666668653488 cup butter",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.75 cup chopped macadamia nuts",
    "6 ounces white chocolate, chopped"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (170 degrees C). Lightly grease baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter, sugars, egg, and vanilla at medium speed of electric mixer until fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "At low speed, gradually beat in flour, just until blended. By hand, stir in nuts and chocolate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by heaping tablespoonfuls, 2 1/2 inches apart, onto lightly greased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 17 minutes or until edges of cookies are lightly browned and tops look dry. Allow to cool on baking sheets five minutes, then remove to racks to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
