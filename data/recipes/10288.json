  "title": "Pepparkakor I",
  "description": "A traditional Swedish Christmas recipe, they are crispy, brown, and delicious plain or decorated. Different from your everyday gingersnap!",
  "authors": [
    "Kathy Seaberg"
  ],
  "date_published": "1997-10-02T10:37:20-04:00",
