  "ingredients": [
    "cooking spray (such as Pam®)",
    "0.5 cup milk",
    "2 large eggs",
    "2 cups baking mix (such as Bisquick ®)",
    "1 cup Parmesan cheese",
    "1 teaspoon garlic powder",
    "1 teaspoon hot paprika",
    "salt to taste",
    "2 pounds chicken tenders"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Coat a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and eggs in a small bowl. Combine baking mix, Parmesan cheese, garlic powder, paprika, and salt in a second bowl; mix well. Dunk chicken tenders in the egg mixture and then into the Parmesan mixture. Place onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crispy, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
