  "ingredients": [
    "1 1/4 cups white sugar",
    "1 cup all-purpose flour",
    "4 tablespoons cocoa powder",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.5 cup milk",
    "2 tablespoons melted butter",
    "1 teaspoon vanilla extract",
    "0.5 cup chopped pecans",
    "0.5 cup brown sugar",
    "1 cup hot water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift 3/4 cup white sugar, flour, 2 tablespoons cocoa powder, baking powder, and salt together in a bowl. Stir in milk, butter, and vanilla extract until just combined; fold in pecans. Pour batter into an 8x8-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine remaining 1/2 cup white sugar, brown sugar, and remaining 2 tablespoons cocoa powder in a bowl; sprinkle over batter. Pour hot water over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top cake layer is floating on bottom pudding layer, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
