  "ingredients": [
    "8 ounces macaroni",
    "1.5 cups milk",
    "1.5 teaspoons ground mustard",
    "1 teaspoon Worcestershire sauce",
    "0.75 teaspoon salt",
    "1 dash hot pepper sauce",
    "1.5 tablespoons butter",
    "3.5 cups shredded Cheddar cheese, divided",
    "0.5 cup bread crumbs",
    "2 tablespoons butter, melted",
    "0.5 teaspoon paprika"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 2 quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add macaroni and cook for 8 to 10 minutes or until al dente; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the milk in a small saucepan. Stir in mustard, Worcestershire sauce, salt, and hot sauce. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir 1 1/2 tablespoons butter and 3 cups cheese into the drained macaroni. Pour the hot milk mixture over the cheese and macaroni. Transfer to prepared baking dish. Sprinkle remaining 1/2 cup cheddar on top. Combine the bread crumbs with the melted butter, and spread over the top. Sprinkle with paprika.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes, and then place under the broiler for 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
