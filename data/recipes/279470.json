  "ingredients": [
    "2 (5 ounce) skin-on salmon fillets",
    "0.33333334326744 cup olive oil",
    "1 lemon, halved, divided",
    "0.33333334326744 cup chopped fresh parsley",
    "0.33333334326744 cup chopped fresh oregano",
    "0.25 cup chopped fresh basil",
    "4 cloves garlic, or more to taste, minced",
    "1 tablespoon kosher salt, divided",
    "6 lemon slices"
  ],
  "steps": [
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour oil into a medium bowl. Rinse salmon fillets and pat dry. Dip fillets into oil, being sure to coat both sides, and place skin-side down into the prepared baking pan. Squeeze as much juice as you can from 1 lemon half over the fillets. Coat both sides of salmon with parsley, oregano, basil, and garlic, and sprinkle with 1/2 of the kosher salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place under the preheated broiler and cook until center is light pink and edges are golden brown, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove fillets from the oven and immediately plate. Squeeze remaining lemon half over top and sprinkle with remaining kosher salt. Serve with lemon slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
