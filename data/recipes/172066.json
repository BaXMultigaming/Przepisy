  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup white sugar",
    "1 teaspoon baking powder",
    "1 pinch salt",
    "1 egg",
    "1 tablespoon melted butter",
    "0.5 cup milk",
    "4 cups sliced rhubarb",
    "2 cups white sugar",
    "1.5 cups boiling water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Whisk flour, 1/2 cup sugar, baking powder, and salt in a mixing bowl; set aside. Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat egg, butter, and milk in a bowl until smooth. Stir in flour mixture until moistened, then spread into the prepared baking dish. Stir together rhubarb, 2 cups sugar, and water; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until dough has set and rhubarb is bubbling, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
