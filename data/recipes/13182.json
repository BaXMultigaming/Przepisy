  "ingredients": [
    "2 pounds ground beef",
    "1 green bell pepper, chopped",
    "1 (29 ounce) can tomato sauce",
    "1 (29 ounce) can diced tomatoes",
    "2 cubes beef bouillon cube",
    "0.25 cup packed brown sugar",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "1 tablespoon soy sauce",
    "2 cups cooked white rice"
  ],
  "steps": [
    {
      "text": "Brown beef in a Dutch oven over medium high heat until browned; drain off any fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add green pepper and sauté for 3 minutes. Stir in tomato sauce, diced tomatoes with juice, bouillon cubes, brown sugar, salt, black pepper, and soy sauce. Reduce heat to low, cover and simmer for 30 to 45 minutes. Stir in rice and heat through.",
