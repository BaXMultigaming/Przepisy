  "ingredients": [
    "2.5 cups unbleached all-purpose flour",
    "1 cup rye flour",
    "1 teaspoon salt",
    "1.5 cups water, divided",
    "1 teaspoon brown sugar",
    "1 (.25 ounce) package active dry yeast",
    "2 tablespoons extra-virgin olive oil",
    "0.5 cup all-purpose flour for kneading dough, or as needed"
  ],
  "steps": [
    {
      "text": "Combine 2 1/2 cups all-purpose flour, rye flour, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour 1/2 cup water into a microwave-safe bowl. Microwave for 30 seconds. Stir brown sugar into water until dissolved; add yeast and stir. Let mixture stand until bubbling, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add yeast mixture to flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour remaining 1 cup water into a microwave-safe bowl. Microwave for 30 seconds. Stir olive oil into warm water; pour over flour mixture. Knead flour mixture, adding more all-purpose flour if dough is sticky, until dough is smooth and holds together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into a ball and place in a bowl. Cover bowl with a damp towel and let rise until doubled in volume, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Punch down dough and transfer to a floured work surface. Roll or shape dough into desired shape.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
