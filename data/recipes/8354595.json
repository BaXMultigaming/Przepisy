  "ingredients": [
    "nonstick cooking spray",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.75 cup white sugar",
    "0.5 cup unsalted butter, softened",
    "0.75 cup sour cream",
    "2 large eggs, at room temperature",
    "1 teaspoon vanilla extract",
    "3 medium ripe bananas, mashed",
    "2 cups strawberries, diced",
    "1 cup chopped nuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a 9x5-inch loaf pan with nonstick spray. Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, cinnamon, and salt together into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and butter together in a large bowl until lighter in color. Mix in sour cream, eggs, and vanilla. Add mashed bananas and mix until combined. Gradually mix in dry ingredients. Fold in strawberries and nuts. Pour into the prepared pan and set on the lined baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown and a toothpick inserted in the center comes out clean, 65 to 80 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
