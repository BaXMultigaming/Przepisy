  "ingredients": [
    "2 cups white sugar",
    "1.5 cups canola oil",
    "4 large eggs",
    "2 cups all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "2 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon vanilla extract",
    "3 cups grated zucchini",
    "1 cup chopped nuts",
    "6 tablespoons unsweetened cocoa powder",
    "0.25 cup melted butter",
    "2 cups confectioners' sugar",
    "0.25 cup milk",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk white sugar, oil, and eggs together in a bowl. Combine flour, ¼ cup cocoa powder, baking soda, cinnamon, and salt in a separate bowl; stir in egg mixture, then stir in 1 teaspoon vanilla. Fold in zucchini and nuts. Pour batter onto the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through, 25 to 30 minutes. Cool completely, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir 6 tablespoons cocoa powder and melted butter together in a bowl. Stir in confectioners' sugar, milk, and ½ teaspoon vanilla until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread frosting over cooled brownies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
