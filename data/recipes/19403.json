  "ingredients": [
    "8 ounces dry fettuccine pasta",
    "1 (8 ounce) package cream cheese",
    "0.75 cup grated Parmesan cheese",
    "0.5 cup margarine",
    "0.5 cup milk",
    "1 teaspoon garlic powder",
    "0.25 teaspoon dried basil",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Add pasta and cook until al dente, 8 to 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese, Parmesan, margarine, milk, garlic powder, and basil in a medium saucepan. Stir over low heat until smooth and creamy, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss sauce with pasta and sprinkle with nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
