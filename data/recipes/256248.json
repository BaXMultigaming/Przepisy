  "ingredients": [
    "1 tablespoon butter",
    "1 egg",
    "1 tablespoon brown sugar",
    "1 tablespoon white sugar",
    "2 teaspoons molasses",
    "0.5 teaspoon vanilla extract",
    "3 tablespoons whole wheat flour",
    "2 tablespoons wheat germ",
    "0.5 teaspoon ground ginger",
    "0.25 teaspoon ground cinnamon",
    "0.125 teaspoon baking soda",
    "1 pinch salt",
    "3 tablespoons confectioners' sugar",
    "1.5 teaspoons water"
  ],
  "steps": [
    {
      "text": "Place butter in a microwave-safe mug. Heat in the microwave until melted, 10 to 20 seconds. Whisk in egg, brown sugar, white sugar, molasses, and vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix whole wheat flour, wheat germ, ginger, cinnamon, baking soda, and salt together in a small bowl. Add to the mug; stir well until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the microwave in 40-second intervals until the top springs back when lightly pressed, about 1 minute 20 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk confectioners' sugar and water together in a small bowl to make icing. Invert cake onto a serving plate and drizzle icing on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
