  "ingredients": [
    "1 egg",
    "0.33333334326744 cup white sugar",
    "0.25 cup butter, softened",
    "1 cup all-purpose flour",
    "1 cup cornstarch",
    "0.5 cup powdered milk",
    "0.5 teaspoon baking powder",
    "1 dash salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together egg, white sugar, butter, flour, cornstarch, powdered milk, baking powder, and salt in a bowl. Knead for a few minutes to make a soft dough. Divide dough into 12 portions. Roll each portion into a ball and slightly flatten. Place on the prepared baking sheet 1 inch apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until light brown, about 10 minutes. Cool completely and store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
