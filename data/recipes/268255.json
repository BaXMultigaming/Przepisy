  "ingredients": [
    "0.5 cup milk",
    "1 egg",
    "1 cup gluten-free Italian bread crumbs",
    "1.5 pounds ground beef",
    "0.25 onion, minced",
    "1 sprig fresh parsley, chopped",
    "1 clove garlic, minced",
    "cooking spray",
    "1 (28 ounce) jar tomato sauce, or as needed"
  ],
  "steps": [
    {
      "text": "Beat milk and egg together in a large bowl. Mix in bread crumbs until a paste forms. Add ground beef, onion, parsley, and garlic; mix with your hands until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Coat a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop meat mixture using an ice cream scoop; roll into balls with dampened hands. Place meatballs on the prepared baking sheet",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until meatballs are no longer pink in centers and an instant-read thermometer inserted into centers reads at least 160 degrees F (70 degrees C), about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat tomato sauce in a saucepan over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add baked meatballs to sauce; simmer, uncovered, for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
