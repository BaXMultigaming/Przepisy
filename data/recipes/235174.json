  "ingredients": [
    "1.5 cups water",
    "1 (12 ounce) jar hot yellow peppers with brine",
    "1 cup white wine vinegar",
    "2 tablespoons pickling spice (such as McCormick®)",
    "1 tablespoon white sugar",
    "2 teaspoons salt",
    "1 teaspoon ground turmeric",
    "8 hard-boiled eggs, peeled"
  ],
  "steps": [
    {
      "text": "Stir water, peppers and brine, vinegar, pickling spice, sugar, salt, and turmeric together in a ½-gallon mason jar or container. Add eggs; seal container. Refrigerate for at least 2 days.",
