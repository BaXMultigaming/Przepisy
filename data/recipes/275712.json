  "ingredients": [
    "0.5 cup butter",
    "1 cup light brown sugar, packed",
    "2 tablespoons bourbon whiskey",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line an 8-inch square baking dish with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan over medium heat. Cook, stirring regularly, until butter turns brown and smells nutty, about 5 minutes, making sure it doesn't burn. Pour brown butter into a large bowl and allow to cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir brown sugar into browned butter and add bourbon. Mix in egg and vanilla extract until combined. Add flour and salt; stir until well combined. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top is dry and edges have started to pull away from the sides of the pan, 20 to 25 minutes. Remove from oven and cool on wire rack. Let cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
