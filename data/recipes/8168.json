  "ingredients": [
    "2 pounds ricotta cheese",
    "0.66666668653488 cup white sugar",
    "0.33333334326744 cup all-purpose flour",
    "6 eggs",
    "0.25 teaspoon ground cinnamon",
    "2 teaspoons orange zest",
    "2 teaspoons vanilla extract",
    "0.125 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 300 degrees F (150 degrees C). Set rack in the middle of the oven. Butter and flour a 9 1/2 inch springform pan, and tap out excess flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the ricotta in a large mixing bowl, and stir it as smooth as possible with a rubber spatula. Stir the sugar and flour together thoroughly into the ricotta. Stir in the eggs 1 at a time. Blend in the vanilla, cinnamon, orange zest, and salt. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the center of the oven for about 1 1/4 to 1 1/2 hours, until a light golden color. Make sure the center is fairly firm, and the point of a sharp knife inserted in the center comes out clean. Cool on a wire rack. It will sink slightly as it cools. Cover, and chill till serving time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
