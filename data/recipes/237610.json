  "ingredients": [
    "0.25 cup chicken broth",
    "2 tablespoons soy sauce",
    "1 tablespoon cornstarch",
    "1 tablespoon white sugar",
    "1 tablespoon white vinegar",
    "1 teaspoon cayenne pepper",
    "1 tablespoon vegetable oil",
    "1 pound skinless, boneless chicken thighs, cut into 3/4-inch pieces",
    "1 clove garlic, minced",
    "1 red bell pepper, cut into 3/4-inch pieces",
    "0.33333334326744 cup dry roasted peanuts",
    "2 green onions, sliced"
  ],
  "steps": [
    {
      "text": "Mix chicken broth, soy sauce, cornstarch, sugar, vinegar, and cayenne pepper together in a bowl until sauce is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a wok or large skillet over medium-high heat; saute chicken and garlic until chicken is no longer pink in the center, 5 to 10 minutes. Add red bell pepper and saute until slightly tender, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sauce into chicken chicken mixture and cook until thickened, about 1 minute. Stir peanuts into chicken mixture and garnish with green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
