  "ingredients": [
    "8 ounces candy corn",
    "0.5 cup creamy peanut butter",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Line a baking sheet with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place candy corn in a microwave-safe bowl; microwave on 50 percent power in 20-second increments, stirring each time, until melted, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir peanut butter into candy corn until smooth. Spread mixture on the prepared baking sheet; freeze until hardened, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate chips in a microwave-safe bowl; microwave on 50 percent power in 20-second increments, stirring each time, until melted, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread melted chocolate over candy corn mixture; return to freezer until hardened, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
