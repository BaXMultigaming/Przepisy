  "ingredients": [
    "1 (15 ounce) can chickpeas (garbanzo beans), rinsed and drained",
    "0.5 cup unsweetened dark cocoa powder",
    "0.5 cup white sugar",
    "3 tablespoons olive oil",
    "3 tablespoons creamy natural peanut butter",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "3 tablespoons water, or more if needed"
  ],
  "steps": [
    {
      "text": "Combine chickpeas, cocoa powder, sugar, olive oil, peanut butter, vanilla extract, and salt in a food processor; blend, scraping down sides as needed, until smooth. Begin adding water while processor is running and blend until desired consistency is reached.",
