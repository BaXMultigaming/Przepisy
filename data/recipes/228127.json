  "ingredients": [
    "1 large French baguette",
    "4 tablespoons extra-virgin olive oil, divided",
    "sea salt to taste",
    "5 large Roma tomatoes",
    "30 small slices fresh mozzarella cheese",
    "1 bunch fresh basil, leaves removed and coarsely chopped",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut baguette into 30 slices; brush slices with 2 tablespoons olive oil on both sides. Arrange on a baking sheet; sprinkle with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toast in the preheated oven until light golden brown and crisp, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, cut each tomato into 6 slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flip bread slices; top each with 1 slice each tomato and mozzarella. Sprinkle with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tomato is warmed through and mozzarella is melted, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer crostini to a serving platter; sprinkle with basil. Drizzle with remaining 2 tablespoons olive oil; sprinkle lightly with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
