  "ingredients": [
    "2 tablespoons olive oil, divided",
    "2 tablespoons finely grated Parmigiano-Reggiano cheese, divided",
    "3 cups chopped leeks",
    "1 pinch salt",
    "3 cloves garlic, minced",
    "2 cups cooked rice",
    "1.5 cups finely chopped cooked spinach, squeezed dry",
    "0.75 cup finely grated Parmigiano-Reggiano cheese",
    "2 large eggs, beaten",
    "1 teaspoon salt, or more to taste",
    "0.5 teaspoon freshly ground black pepper",
    "1 pinch cayenne pepper",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush a pie plate with 1 tablespoon olive oil; coat with 1 tablespoon Parmigiano-Reggiano cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining 1 tablespoon olive oil in a large skillet over medium heat. Add leeks and 1 pinch salt; cook and stir until leeks are soft and sweet, 5 to 10 minutes. Stir in garlic; cook until fragrant, about 1 minute. Transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rice, spinach, ¾ cup Parmigiano-Reggiano cheese, eggs, 1 teaspoon salt, black pepper, cayenne pepper, and nutmeg into leek mixture; transfer to the prepared pie plate and smooth the surface with a spatula. Sprinkle top with remaining 1 tablespoon Parmigiano-Reggiano cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until torta is lightly browned around the outside and firm to the touch, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
