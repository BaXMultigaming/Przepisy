  "ingredients": [
    "3 medium zucchini",
    "1 tablespoon olive oil",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "8 ounces cherry tomatoes, halved",
    "1 tablespoon extra-virgin olive oil",
    "1 tablespoon apple cider vinegar",
    "1 tablespoon chopped fresh mint"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill to high heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut zucchini into thin lengthwise planks; brush with olive oil and season with salt and black pepper. Arrange on grate without crowding.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill until tender and lightly charred, 2 to 3 minutes per side. Transfer to a rimmed plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together tomatoes, extra-virgin olive oil, apple cider vinegar, and mint in a bowl. Smash some of the tomatoes to release their juices. Stir once more and spoon over zucchini.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
