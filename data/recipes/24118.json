    "1 teaspoon white sugar",
    "0.5 teaspoon salt",
    "0.5 cup canola oil",
    "2 tablespoons milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
