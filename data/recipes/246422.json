  "ingredients": [
    "2.5 cups blanched almond flour",
    "1 cup pitted and chopped dates",
    "0.5 cup chopped dried cherries",
    "0.5 cup chopped walnuts",
    "2 tablespoons chia seeds, or more to taste",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon sea salt",
    "0.5 cup coconut oil",
    "1 egg",
    "2 tablespoons maple syrup",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine almond flour, dates, cherries, walnuts, chia seeds, baking soda, and sea salt in a large bowl; whisk to blend. Add coconut oil, egg, maple syrup, and vanilla extract; blend well with a spoon or fork until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop dough onto prepared baking sheets with a small cookie scoop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden, about 15 minutes. Turn off oven and let cookies sit with oven door closed, about 10 minutes more. Remove from oven and let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
