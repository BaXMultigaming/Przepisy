  "ingredients": [
    "1 tablespoon olive oil",
    "1 onion, chopped",
    "1 green bell pepper, chopped",
    "1 small jalapeno pepper, finely chopped",
    "1 pound hot Italian sausage",
    "1 pound ground beef",
    "1 tablespoon chili powder",
    "0.5 teaspoon cayenne pepper",
    "0.5 teaspoon salt",
    "2 (15 ounce) cans pinto beans, undrained",
    "1 (28 ounce) can diced tomatoes",
    "1 cup water"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large stock pot over medium heat; cook and stir onion, bell pepper, and jalapeno pepper until onion is translucent, about 10 minutes. Add sausage and ground beef; continue to cook and stir until meat is browned and crumbly, about 7 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season meat mixture with chili powder, cayenne pepper, and salt. Add pinto beans, tomatoes, and water and bring to a simmer over medium heat. Reduce heat to medium-low and continue to simmer for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
