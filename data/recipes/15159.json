  "ingredients": [
    "9 large potatoes, peeled and cubed",
    "8 ounces cream cheese, cut into cubes",
    "1 cup sour cream",
    "2 teaspoons onion salt",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "2 tablespoons butter, cut into small chunks"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 10 to 12 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer potatoes to a large mixing bowl and mash until smooth. Stir in cream cheese, sour cream, onion salt, salt, and pepper. Beat with an electric mixer until light and fluffy. Transfer mixture to the prepared casserole dish and dot with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until heated through, 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
