  ],
  "steps": [
    {
      "text": "Combine rhubarb, cherry pie filling, sugar, and tapioca in a large bowl. Let stand for 15 minutes. Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour filling into unbaked pie shell, and cover with pie crust. Brush top with milk, and sprinkle on sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pastry is golden and filling is bubbling, about 40 to 45 minutes.",
