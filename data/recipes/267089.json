  "ingredients": [
    "6 pounds pumpkin with fairly straight sides",
    "0.75 pound lean ground beef",
    "1 teaspoon oregano",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1 onion, diced",
    "2 large stalks celery, diced",
    "0.5 medium green bell pepper, diced",
    "2 pounds mozzarella cheese, cubed",
    "16 ounces tomato sauce",
    "1.5 cups water",
    "1 (15.25 ounce) can corn, drained",
    "6 large mushrooms, sliced",
    "0.75 cup instant rice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a rimmed baking sheet with heavy duty aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wash the pumpkin and cut off the top at an angle to form a lid that won't fall through. Clean out and discard seeds and string.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef, oregano, salt, and pepper in the hot skillet until browned and crumbly, 5 to 7 minutes. Add onion, celery, and bell pepper; cook 3 minutes. Add mozzarella cheese, tomato sauce, water, corn, mushrooms, and instant rice. Stir well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour mixture from the skillet into the pumpkin and replace lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for about 1 hour. When serving, scrape the insides of the pumpkin to get some of the soft flesh in each bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
