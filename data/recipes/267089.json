  "title": "Halloween Pumpkin Stew",
  "description": "Try this beefy, cheesy pumpkin stew this fall as a new Halloween dinner tradition for your family or at your Halloween party.",
  "authors": [
    "Melissa"
  ],
  "date_published": "2019-04-04T00:13:26-04:00",
