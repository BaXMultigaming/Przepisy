  "ingredients": [
    "3 pounds red potatoes, cut into chunks",
    "4 large hard-cooked eggs, chopped",
    "1 cup low-fat sour cream",
    "0.5 cup light mayonnaise",
    "0.33333334326744 celery stalk, chopped",
    "2 green onions, chopped",
    "1 dill pickle, chopped",
    "2 teaspoons Dijon mustard",
    "1 teaspoon white vinegar",
    "1 dash hot sauce",
    "1 tablespoon dried dill weed",
    "0.5 teaspoon garlic powder",
    "1 dash onion salt",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2clli-O1_eB-iLTV3P5xbDvK9yc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/87373-red-potato-salad-DDMFS-026-step-01-ddd113e7ad8e4072a01e9b548fde57cc.jpg"
      ],
      "image": "assets/images/87373/step_01.webp"
    },
    {
      "text": "Place potatoes in a pot with enough water to cover; bring to a boil. Cook until potatoes are easily pierced with a fork, about 10 minutes. Drain, then transfer to a large bowl to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/huuDVIsHg4TwA2ZCix2M4LcxkUA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/87373-red-potato-salad-DDMFS-026-step-02-cf07f494971a4f2f87c9a0528b12bfb2.jpg"
      ],
      "image": "assets/images/87373/step_02.webp"
    },
    {
      "text": "Mix together eggs, sour cream, mayonnaise, celery, green onions, pickle, mustard, vinegar, and hot sauce in a bowl. Season with dill weed, garlic powder, onion salt, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lK4QGkNeGT7Yc6P-17VFUgET-OU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/87373-red-potato-salad-DDMFS-026-step-03-1f90b98deb4d4a75a7ca23d702caddbf.jpg"
      ],
      "image": "assets/images/87373/step_03.webp"
    },
    {
      "text": "Pour over potatoes; gently toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Bsa2acpOjKDHrZHr_45DY5LIhtQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/87373-red-potato-salad-DDMFS-026-step-04-7339e65a20304634bc0a85ec94014b45.jpg"
      ],
      "image": "assets/images/87373/step_04.webp"
    },
    {
      "text": "Chill in the refrigerator for at least 3 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
