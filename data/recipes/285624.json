  "ingredients": [
    "0.5 pound morel mushrooms",
    "2 tablespoons olive oil",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon ground black pepper, or more to taste",
    "2 tablespoons finely chopped shallots",
    "1 teaspoon chopped fresh thyme",
    "2 tablespoons unsalted butter",
    "1 tablespoon chopped fresh parsley",
    "1 teaspoon lemon juice",
    "0.5 teaspoon lemon zest"
  ],
  "steps": [
    {
      "text": "Brush mushrooms clean. Trim ends and cut mushrooms in half lengthwise.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat until shimmering. Add mushrooms, salt, and 1/4 teaspoon pepper; stir gently with a spatula to evenly coat mushrooms with the oil. Cook, stirring often, until mushrooms begin to brown and soften, 4 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add shallots and thyme, then turn heat to medium. Cook, stirring often, until shallots soften and just begin to brown, about 4 minutes. Add butter, parsley, and lemon juice; stir to melt butter and blend ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat and sprinkle with lemon zest and additional black pepper if desired. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
