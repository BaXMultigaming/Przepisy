  "ingredients": [
    "2 cups all-purpose flour",
    "0.5 cup white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 (8 ounce) can crushed pineapple",
    "0.75 cup milk",
    "0.25 cup butter, melted",
    "1 egg, beaten",
    "0.33333334326744 cup packed brown sugar",
    "0.25 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease and flour 16 muffin cups or line with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together 2 cups flour, white sugar, baking powder, and salt in a large bowl; form a well in the center. Drain pineapple, reserving 1/4 cup juice; add juice to the well. Pour in milk, 1/4 cup melted butter, and beaten egg; mix just until blended. Portion batter into the prepared muffin cups. Spoon crushed pineapple over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together remaining 1/2 cup flour, brown sugar, remaining 1/4 cup melted butter, and cinnamon in a small bowl until well combined; sprinkle over crushed pineapple.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
