  "title": "Hot Pepper Jelly",
  "description": "This hot pepper jelly recipe made with bell peppers and jalapeños is a deliciously sweet and spicy treat served on cheese or whatever you like!",
  "authors": [
    "Wendy"
  ],
  "date_published": "1999-09-08T20:06:22-04:00",
