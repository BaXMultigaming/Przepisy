  "ingredients": [
    "4 clementines, peeled and segmented",
    "1 medium apples - peeled, cored and chopped",
    "1.5 cups white sugar",
    "2 large eggs",
    "0.5 cup unsalted butter, melted",
    "1 teaspoon vanilla extract",
    "1 cup whole wheat flour",
    "0.5 cup all-purpose flour",
    "1.5 teaspoons baking soda",
    "1 teaspoon salt",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a fluted tube pan (such as Bundt®).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Puree clementines and apple in a food processor or blender. Place in a large mixing bowl or on in the bowl of a stand mixer. Add sugar, eggs, melted butter, and vanilla. Mix well. Add whole wheat and all-purpose flours, baking soda, and salt. Blend and then add chocolate chips for a quick incorporation. Transfer to the prepared cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the center of the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
