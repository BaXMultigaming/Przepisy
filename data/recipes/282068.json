  "ingredients": [
    "1 cup milk",
    "1 large egg",
    "3 cups all-purpose flour",
    "2 tablespoons white sugar",
    "4.5 teaspoons baking powder",
    "0.75 teaspoon cream of tartar",
    "0.75 teaspoon salt",
    "0.75 cup cold margarine"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and egg together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, baking powder, cream of tartar, and salt together in a bowl. Add margarine and cut in with a pastry blender or 2 knives. Add milk-egg mixture and mix just enough to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Knead dough briefly, 5 to 7 times. Roll to a 1 1/2-inch thickness and cut out 14 biscuits.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 12 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
