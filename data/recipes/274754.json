  "ingredients": [
    "2 cups all-purpose flour",
    "0.75 cup cocoa powder",
    "1 tablespoon pumpkin pie spice",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "2.5 sticks butter, softened",
    "1 cup white sugar",
    "0.75 cup firmly packed brown sugar",
    "2 large eggs",
    "1 teaspoon vanilla extract",
    "1 (10 ounce) bag pumpkin spice-flavored candies (such as Hershey's® Pumpkin Spice Kisses)"
  ],
  "steps": [
    {
      "text": "Stir flour, cocoa, pumpkin pie spice, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, white sugar, and brown sugar in a large bowl. Beat with an electric mixer until light and fluffy. Add eggs and vanilla extract; beat well. Mix in flour mixture gradually.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chill cookie dough for 1 hour. Meanwhile, unwrap the candy kisses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line cookie sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into 1 1/2-inch balls. Flatten just enough to keep from rolling off the cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are set and starting to brown, 8 to 10 minutes. Slide parchment paper onto wire cooling racks. Firmly push a candy kiss into the center of each cookie. Let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
