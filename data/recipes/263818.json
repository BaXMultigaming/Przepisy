  "ingredients": [
    "1 sheet Reynolds Wrap® Heavy Duty Aluminum Foil",
    "2 graham cracker squares",
    "1 (4 ounce) bar chocolate, cut in half",
    "2 scoops mint-chocolate ice cream"
  ],
  "steps": [
    {
      "text": "Preheat the grill to medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold the Reynolds Wrap Aluminum Foil in half, making a rectangle, and place it onto the grill in the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the graham crackers onto the foil and place the chocolate squares on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Close the grill and cook for about 3 to 5 minutes until the chocolate has melted. Using a spatula, transfer the crackers to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop some ice cream over top of one of the crackers with chocolate, and then top with the other cracker and chocolate. Serve immediately.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
