  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "0.75 cup orange juice",
    "0.5 cup vodka",
    "0.25 cup vegetable oil",
    "3 eggs",
    "1 cup confectioners' sugar",
    "3 tablespoons orange juice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine cake mix, pudding mix, 3/4 cup orange juice, vodka, oil and eggs. Beat until smooth, and pour into Bundt pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 45 minutes, or until toothpick inserted into middle of cake comes out clean. Cool 10 minutes in pan, then turn out onto wire rack. Glaze with orange glaze.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Orange glaze: In a medium bowl, mix confectioners sugar with 3 tablespoons orange juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
