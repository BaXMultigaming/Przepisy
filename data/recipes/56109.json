  "ingredients": [
    "2.5 quarts water",
    "2 pounds dried pinto beans",
    "1 pound bacon, coarsely chopped",
    "1 medium onion, chopped",
    "1 medium ripe tomato, chopped",
    "1 fresh jalapeno pepper, chopped",
    "1 bunch fresh cilantro, chopped"
  ],
  "steps": [
    {
      "text": "Combine water and beans in a large pot; bring to a boil. Reduce heat; simmer for 3 hours, adding more water if necessary while beans cook.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a large skillet over medium heat until beginning to brown. Stir in onion; continue cooking until onion is tender. Stir in tomato and jalapeño; cook for 2 to 3 minutes. Off heat, stir in cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir bacon-onion mixture into beans; continue cooking until beans are soft, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
