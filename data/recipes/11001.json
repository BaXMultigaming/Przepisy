  "ingredients": [
    "1.75 cups graham cracker crumbs",
    "7 tablespoons butter, softened",
    "2 tablespoons white sugar",
    "5 eggs",
    "3 cups white sugar",
    "6 tablespoons all-purpose flour",
    "0.5 cup lemon juice",
    "0.33333298563957 cup confectioners' sugar for decoration"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine graham cracker crumbs, softened butter or margarine, and 2 tablespoons sugar. Press mixture onto bottom of a greased 9 x 13 inch baking pan. Bake for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, sugar, flour, and lemon juice. (If mixture is too thick, water may be added to thin it.) Pour the mixture over the hot graham cracker crust. Bake for 25 minutes, or until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dust the top with confectioners' sugar. After cooling, cut into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
