  "ingredients": [
    "1 pound chicken tenders",
    "1 teaspoon poultry seasoning",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "1 large egg, beaten",
    "1 cup corn flakes, crushed",
    "1 serving avocado oil cooking spray"
  ],
  "steps": [
    {
      "text": "Preheat the air fryer to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken with poultry seasoning, salt, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beaten egg onto a small rimmed plate. Place cornflakes onto a second rimmed plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken in beaten egg, then press in cornflakes to coat. Place in the air fryer basket and spray the tops with avocado oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 7 to 8 minutes. Flip chicken, spray again with avocado oil, and air fry for 3 to 5 minutes more. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
