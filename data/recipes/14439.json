  "ingredients": [
    "1.75 cups unsweetened pineapple juice",
    "1 cup white sugar",
    "2 eggs, beaten",
    "2 tablespoons all-purpose flour",
    "2.5 teaspoons salt, divided",
    "1 tablespoon lemon juice",
    "1 tablespoon vegetable oil",
    "1 (16 ounce) package acini di pepe pasta",
    "3 (11 ounce) cans mandarin oranges, drained",
    "2 (20 ounce) cans pineapple tidbits, drained",
    "1 (20 ounce) can crushed pineapple, drained",
    "1 (8 ounce) container frozen whipped topping, thawed",
    "1 cup miniature marshmallows",
    "1 cup shredded coconut"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OYKKdIVxQCD8I0iqh-OMcPg3hPY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14439-frog-eye-salad-DDMFS-step-01-1e9dba932e964b189b02e16de245c0a1.jpg"
      ],
      "image": "assets/images/14439/step_01.webp"
    },
    {
      "text": "Combine pineapple juice, sugar, eggs, flour, and 1/2 teaspoon salt in a saucepan. Stir and cook over medium heat until thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3DFeVizzP02aBg-68RqTwpSafnA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14439-frog-eye-salad-DDMFS-step-02-3ee24e8a005749a5b6b05453620ef583.jpg"
      ],
      "image": "assets/images/14439/step_02.webp"
    },
    {
      "text": "Remove from heat; stir in lemon juice. Let cool to room temperature, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7h3V0wA39B-0XS1h06gAi86jDNQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14439-frog-eye-salad-DDMFS-step-03-2922ea49646f4c419b5ac2e30df59940.jpg"
      ],
      "image": "assets/images/14439/step_03.webp"
    },
    {
      "text": "Bring a large pot of water to a boil; add oil and remaining 2 teaspoons salt. Add pasta and cook until al dente, 5 to 7 minutes. Drain and rinse under cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r2Sk7tKNrknr7NGNG-IlnWz8_ng=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14439-frog-eye-salad-DDMFS-step-04-3e2e205a2b3c45e7bdb169214b25a77c.jpg"
      ],
      "image": "assets/images/14439/step_04.webp"
    },
    {
      "text": "Combine cooked pasta, cooled egg mixture, mandarin oranges, pineapple tidbits, crushed pineapple, and whipped topping in a large bowl; mix well. Refrigerate until chilled, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hPrHp6YwPO7TgdY5lpnqyolig5o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14439-frog-eye-salad-DDMFS-step-05-485d5835b96c40029acffeaf60a9351b.jpg"
      ],
      "image": "assets/images/14439/step_05.webp"
    },
    {
      "text": "Before serving, add marshmallows and coconut; toss and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KNLE5NaAHbQl5WMfs852PnbTsXg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-14439-frog-eye-salad-DDMFS-beauty-4x3-670f06a1d1b44313a4369728929746d8.jpg"
      ],
