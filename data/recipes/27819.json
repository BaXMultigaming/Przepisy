  "ingredients": [
    "1 large red onion",
    "3 cloves garlic",
    "1 habanero pepper, seeded",
    "1 tablespoon fresh ginger root",
    "0.25 cup olive oil",
    "0.25 cup brown sugar",
    "3 tablespoons red wine vinegar",
    "3 tablespoons orange juice concentrate, thawed",
    "1 teaspoon soy sauce",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "0.5 cup chopped cilantro",
    "0.5 teaspoon salt and pepper to taste",
    "6 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "In a food processor, combine onion, garlic, habanero pepper, and ginger. Pulse until ingredients are minced. Blend in olive oil, brown sugar, vinegar, orange juice concentrate, soy sauce, cinnamon, nutmeg, cloves, cilantro, salt, and pepper. In a container, combine marinade with chicken. Cover, and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill chicken for 10 minutes per side, or until no longer pink and juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
