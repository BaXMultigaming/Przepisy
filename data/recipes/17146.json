  "ingredients": [
    "2 pounds skinless, boneless chicken breast meat",
    "2 tablespoons butter, melted",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "1 cup crushed potato chips"
  ],
  "steps": [
    {
      "text": "To Marinate: Put chicken breasts in a nonporous glass dish or bowl. Drizzle melted butter or margarine over chicken and season with salt and ground black pepper. Cover dish and refrigerate overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put potato chip crumbs in a shallow dish or bowl. Roll chicken in crumbs until well coated, then place in a lightly greased 9x13 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 375 degrees F (190 degrees C) for 45 minutes or until chicken juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
