  "ingredients": [
    "1 large kohlrabi bulb, peeled and cut into cubes",
    "6 small red potatoes",
    "2 teaspoons grated garlic scape",
    "0.5 cup shredded mozzarella cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring a small pot of lightly salted water to a boil. Add kohlrabi; cook until soft, about 15 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave potatoes until soft, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat kohlrabi, potatoes, and garlic scapes together in a bowl with an electric mixer until smooth; transfer to a 1-quart casserole dish. Top with cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese begins to brown, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
