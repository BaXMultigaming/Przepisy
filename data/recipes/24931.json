  "ingredients": [
    "3 cups all-purpose flour",
    "2 teaspoons baking soda",
    "0.5 teaspoon salt",
    "10 bananas, mashed",
    "0.75 cup butter, softened",
    "1 cup brown sugar",
    "3 eggs, beaten",
    "0.75 cup walnut halves or pieces",
    "0.25 cup pecan halves or pieces"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Lightly grease three 8x4 inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together flour, baking soda and salt. In a separate bowl, beat together bananas, butter, brown sugar and eggs. Stir banana mixture into flour mixture, just until combined. Fold in nuts. Pour batter into prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 to 45 minutes, until a toothpick inserted into the center of the loaf comes out clean. Let bread rest in pans for 10 minutes, ten remove loaves from pans and allow to cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
