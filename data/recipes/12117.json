  "ingredients": [
    "1 (8 ounce) package cream cheese, softened",
    "1 (14 ounce) can sweetened condensed milk",
    "0.33333334326744 cup lemon juice",
    "1 teaspoon vanilla extract",
    "1 (9 inch) prepared graham cracker crust",
    "1 (21 ounce) can light cherry pie filling"
  ],
  "steps": [
    {
      "text": "Beat cream cheese until light and fluffy. Gradually stir in sweetened condensed milk and continue mixing until smooth and combined. Add lemon juice and vanilla; mix well.",
