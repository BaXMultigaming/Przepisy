      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour filling into graham cracker crust. Refrigerate until set, 2 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Just before serving, spread cherry pie filling over the top.",
