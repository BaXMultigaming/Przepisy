  "ingredients": [
    "cooking spray",
    "3 medium zucchini, spiralized and cut into 6-inch pieces",
    "0.25 cup cornstarch",
    "2 large eggs, beaten",
    "1 cup panko bread crumbs",
    "0.25 cup grated Parmesan cheese",
    "2 teaspoons paprika",
    "1 teaspoon seasoning salt",
    "0.5 teaspoon cayenne pepper",
    "0.25 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Line 2 baking sheets with parchment paper and spray with nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine spiralized zucchini and cornstarch in a bowl and toss to combine. Place beaten eggs in a shallow dish. Stir panko bread crumbs, Parmesan cheese, paprika, seasoning salt, cayenne, and garlic powder together in a second shallow dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Working in batches, lightly dredge zucchini in the eggs, shaking off the excess before dredging in the bread crumb mixture. Spread zucchini out in a single layer on the prepared baking sheets. Spray the top of the zucchini with more nonstick cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until crispy and golden, 10 to 12 minutes. Serve hot and fresh.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
