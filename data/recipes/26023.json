  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 cup white sugar",
    "0.5 cup butter, softened",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "1 teaspoon baking soda",
    "1 pinch salt",
    "1 egg, lightly beaten",
    "1 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour an 11x7 inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix flour and sugar together. Cut in the butter until the mixture resembles coarse crumbs. Reserve 1/2 cup of this mixture as crumbs for top of cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To the remaining flour mixture stir in the cinnamon, cloves, baking soda and salt. Blend in egg and buttermilk. Pour batter into prepared pan. Sprinkle reserved crumb mixture over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 30 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
