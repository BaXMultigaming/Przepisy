  "ingredients": [
    "1 tablespoon butter",
    "1 small onion, chopped",
    "2 cups chicken broth",
    "1 small tomato, chopped",
    "3 cups loosely packed chopped kale",
    "1 cup canned white beans, rinsed and drained"
