  "ingredients": [
    "1 cup peanut butter",
    "0.5 cup white sugar",
    "0.33333334326744 cup packed brown sugar",
    "1 egg",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon baking soda",
    "0.5 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat peanut butter, white sugar, and brown sugar together in a large bowl with an electric mixer until smooth. Stir egg, vanilla extract, and baking soda into peanut butter mixture; stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop mixture by small rounded spoonfuls onto a baking sheet about 2 inches apart.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are flattened and golden, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
