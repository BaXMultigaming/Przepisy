  "ingredients": [
    "0.25 cup butter, divided",
    "1 sweet onion (such as Vidalia®), sliced into rings or crescents",
    "1 habanero pepper, seeded and diced",
    "2 teaspoons brown sugar",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat 2 tablespoons butter in a skillet over medium heat. Stir onion, habanero pepper, brown sugar, salt, and pepper into hot butter; cook and stir until onions turn translucent and soften, 5 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir 1 tablespoon butter into onion mixture and continue to cook and stir until onion caramelizes, 5 to 10 minutes. Remove onions from pan and top with remaining 1 tablespoon butter.",
