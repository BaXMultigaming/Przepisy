  "ingredients": [
    "cooking spray",
    "2 cups white sugar",
    "0.5 cup butter, softened",
    "1.3333333730698 cups coconut milk",
    "2 eggs",
    "3 cups all-purpose flour",
    "1.5 cups almond flour",
    "1 tablespoon baking powder",
    "2 teaspoons ground cinnamon",
    "3 cups grated coconut",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 2 loaf pans with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and butter in a large bowl; beat with an electric mixer until creamy. Beat in coconut milk and eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix all-purpose flour, almond flour, baking powder, and cinnamon together in a bowl. Stir into the butter mixture until batter is thoroughly blended. Fold in coconut and raisins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter evenly between the greased loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool completely before slicing, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
