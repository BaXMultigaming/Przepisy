  "ingredients": [
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "0.25 teaspoon salt",
    "0.5 cup packed brown sugar",
    "1 cup boiling water",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Melt butter in a medium saucepan. Add flour and salt and stir until smooth. Stir in brown sugar and cook over medium heat, stirring constantly, until the mixture bubbles and is lightly browned, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from heat. Stir in boiling water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to heat and bring to a boil, stirring constantly, until smooth and thickened. Stir in vanilla extract until well blended. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
