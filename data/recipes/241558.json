  "ingredients": [
    "2 sheets Reynolds® Parchment Paper",
    "0.5 cup butter, softened",
    "0.75 cup granulated sugar",
    "1 egg",
    "2 tablespoons finely shredded orange peel",
    "1 tablespoon finely shredded lemon peel",
    "1 teaspoon vanilla",
    "2 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.25 teaspoon salt",
    "0.33333334326744 cup milk",
    "2 tablespoons melted butter",
    "1 tablespoon orange juice, or as needed",
    "0.75 cup powdered sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. Line two cookie sheets with Reynolds® Parchment Paper; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the butter and sugar in a large bowl using an electric mixer about 2 minutes or until light and fluffy. Add the egg, orange peel, lemon peel, and vanilla and beat until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the flour, baking powder, and salt in a medium bowl. Add half of flour mixture to the butter mixture, beating until just combined. Add the milk. Beat about 10 seconds. Beat in the remaining flour mixture until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop tablespoon-size mounds of dough on prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 8 to 10 minutes or until set and the bottoms are browned. Transfer the cookies on the parchment paper to a wire rack; cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle with Citrus Glaze to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Citrus Glaze: In a small bowl combine melted butter and orange juice. Add powdered sugar; beat until smooth. If necessary, add more orange juice, 1/2 teaspoon at a time, to make drizzling consistency. Drizzle over cookies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
