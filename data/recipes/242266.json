  "ingredients": [
    "1 pound bacon, diced",
    "1 (32 ounce) package frozen bite-size potato nuggets (such as Tater Tots®)",
    "12 eggs",
    "0.5 cup milk",
    "1 pinch salt",
    "0.125 teaspoon ground black pepper",
    "2 cups shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z4Dm0VMKrQeIU5_bbeUpGoziqxU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242266-tater-tot-and-bacon-breakfast-casserole-DDMFS-step-01-0916-2547563ba5524aa19c501dd7b5c61119.jpg"
      ],
      "image": "assets/images/242266/step_01.webp"
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, 5 to 8 minutes. Drain bacon on paper towels.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0GobFwVe67_kQQv4CxiNreeV3bM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242266-tater-tot-and-bacon-breakfast-casserole-DDMFS-step-01-1-0917-98ac756de9744d939185b81a6506c8ec.jpg"
      ],
      "image": "assets/images/242266/step_02.webp"
    },
    {
      "text": "Spread bacon into the bottom of a 9x13-inch baking dish to cover. Spread potato nuggets over the bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9LNPBS_lrcP2a4dwfBRr6gcs8AM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242266-tater-tot-and-bacon-breakfast-casserole-DDMFS-step-02-0919-3fef130fa0934726b88909a29b4c71c9.jpg"
      ],
      "image": "assets/images/242266/step_03.webp"
    },
    {
      "text": "Beat eggs, milk, salt, and pepper together in a bowl; pour over the layer of potato nuggets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DD0J5-wnczmpHV5yIOjjU3VR18s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242266-tater-tot-and-bacon-breakfast-casserole-DDMFS-step-03-0923-5bcc2506e53643e8a7fe73b3b0d8c6b0.jpg"
      ],
      "image": "assets/images/242266/step_04.webp"
    },
    {
      "text": "Top with cheddar cheese and bake in the preheated oven until hot in the center, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Gx8uFr_5SBH_pkhJEkgI2k2fng0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242266-tater-tot-and-bacon-breakfast-casserole-DDMFS-step-04-0928-1627146496914b56b7d4e703abce0f0d.jpg"
      ],
      "image": "assets/images/242266/step_05.webp"
    },
    {
      "text": "Serve hot. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hMkYFrljFD2AngRXBXC9n5zDX6s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/242266-tater-tot-and-bacon-breakfast-casserole-DDMFS-4x3-0949-web-ad45516f699d433d9cca0a274db3193d.jpg"
      ],
      "image": "assets/images/242266/step_06.webp"
    }
