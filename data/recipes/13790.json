  "title": "Grandmother's Famous Cranberry Bread",
  "description": "Raisins are cranberries are baked into this orange scented loaf. This would be an ideal hostess gift, or simply enjoyed with afternoon tea.",
  "authors": [
    "Mim Harris"
  ],
  "date_published": "1998-11-24T00:16:54-05:00",
