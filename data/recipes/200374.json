  "ingredients": [
    "6 cups skim milk",
    "3 tablespoons unsweetened cocoa powder",
    "3 tablespoons white sugar",
    "1 teaspoon vanilla extract",
    "1 teaspoon cinnamon",
    "0.5 teaspoon chili powder",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Heat milk in a saucepan over medium-low heat until lukewarm; stir cocoa powder and sugar into warmed milk until dissolved. Add vanilla, cinnamon, chili powder, nutmeg, and cloves. Heat for 5 more minutes, stirring occasionally.",
