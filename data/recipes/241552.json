  "ingredients": [
    "2 cups flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "1.25 cups white sugar",
    "0.5 cup shortening",
    "2 egg, beaten",
    "1 cup mashed ripe banana",
    "1 teaspoon vanilla extract",
    "0.5 cup buttermilk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, and cinnamon together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and shortening together in a separate large bowl with an electric mixer until light and fluffy. Add eggs, one at a time, beating well after each addition. Beat in bananas and vanilla extract. Slowly beat in buttermilk, continually beating, until smooth. Add flour mixture, continue beating until smooth; pour into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour. Cool in the pan for 10 minutes before removing from the pan; transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
