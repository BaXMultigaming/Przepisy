  "ingredients": [
    "4 apples - peeled, cored, and sliced",
    "2 cups oats",
    "1 cup brown sugar",
    "1 teaspoon ground cinnamon",
    "0.25 cup butter",
    "0.5 cup honey",
    "1 teaspoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange apple slices in a 9-inch circular glass pie plate. Stir oats, sugar, and cinnamon together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave butter in 5-second increments until melted, about 20 seconds. Stir melted butter, honey, and oil into oat mixture; crumble over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 35 minutes. Cool on a wire cooling rack, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
