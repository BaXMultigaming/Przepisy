  "ingredients": [
    "2 cups butter",
    "2 cups white sugar",
    "9 large eggs",
    "0.25 cup white rum",
    "1 tablespoon lime juice",
    "1 tablespoon almond extract",
    "1 teaspoon vanilla extract",
    "1 grated zest of one lime",
    "2 pounds chopped dried mixed fruit",
    "2 cups red wine",
    "1 cup dark molasses",
    "2.5 cups all-purpose flour",
    "3 teaspoons baking powder",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground allspice",
    "0.5 teaspoon ground cinnamon",
    "1 pinch salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour two 9-inch round cake pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter and sugar into a large bowl; beat with an electric mixer until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pYZCfEN2-pjevbEKQOz49FUCd7I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46182_SharonsJamaicanFruitCake_ddmfs_Shot1_3x4_3974-ec171c9d73a040c496e35c4a8cceb738.jpg"
      ],
      "image": "assets/images/46182/step_02.webp"
    },
    {
      "text": "Beat in eggs; add rum, lime juice, almond extract, vanilla, and lime zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7S1YNDMjxLwHid_K8jQrB17vmII=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46182_SharonsJamaicanFruitCake_ddmfs_Shot3_3x4_3977-ec4a718ef0ab44ee94eea2825473cb24.jpg"
      ],
      "image": "assets/images/46182/step_03.webp"
    },
    {
      "text": "Stir in dried fruit, wine and molasses.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j7Awfur0eDU49hjCWXyVMV393uI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46182_SharonsJamaicanFruitCake_ddmfs_Shot4_3x4_3979-b20e165482734aa5a5e07fe90ba7cafc.jpg"
      ],
      "image": "assets/images/46182/step_04.webp"
    },
    {
      "text": "Sift flour, baking powder, nutmeg, allspice, cinnamon, and salt together in a large bowl; gently fold into fruit mixture. Pour batter evenly into the prepared pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ji7NOD1TLmKT0V8NP2k85ghAIxo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/46182_SharonsJamaicanFruitCake_ddmfs_Shot5_3x4_3982-40b692a5469d4680bb32016d6108a6f0.jpg"
      ],
      "image": "assets/images/46182/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 80 to 90 minutes. Let cool in the pan for 10 minutes, then turn out onto a wire rack and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
