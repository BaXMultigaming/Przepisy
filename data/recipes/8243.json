  "ingredients": [
    "1 (14 ounce) can sweetened condensed milk",
    "1 tablespoon water",
    "0.125 teaspoon salt",
    "2 (1 ounce) squares unsweetened chocolate",
    "0.5 teaspoon vanilla extract"
  ],
  "steps": [
