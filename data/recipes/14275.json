  "ingredients": [
    "7 cups cucumbers, peeled and thinly sliced",
    "1 teaspoon salt",
    "2 cups white sugar",
    "1 cup diced red onion",
    "1 cup chopped green bell pepper",
    "1 cup cider vinegar",
    "1 teaspoon celery seed"
  ],
  "steps": [
    {
      "text": "Combine cucumbers and salt in a large bowl; set aside for 1 hour. Do not drain mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, onion, bell pepper, vinegar, and celery seeds into cucumber mixture; mix well. Cover the bowl; refrigerate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
