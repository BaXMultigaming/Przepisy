  "ingredients": [
    "0.25 cup butter",
    "1 onion, chopped",
    "1 teaspoon salt",
    "ground black pepper to taste",
    "0.5 teaspoon dried basil",
    "4 teaspoons brown sugar",
    "5 tomatoes, sliced",
    "2 cups white bread cubes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9x13-inch casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sauté butter and onion in a medium saucepan over medium heat until onion is translucent, 3 to 4 minutes. Add salt, pepper, basil, brown sugar, and tomatoes; mix well. Stir in bread until well combined. Pour tomato-bread mixture into the prepared dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 35 minutes. Enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
