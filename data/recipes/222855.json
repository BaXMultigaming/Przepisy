  "ingredients": [
    "1 (16 ounce) package hot dogs, cut in quarters crosswise",
    "1 pound bacon, cut in quarters crosswise",
    "0.5 cup butter",
    "0.5 cup brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven's broiler and set the oven rack about 6 inches from the heat source.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap hot dog pieces in bacon pieces and secure with toothpicks. Arrange on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil the hot dog pieces until bacon is crisp, turning once or twice, 3 to 5 minutes per side. Transfer to a serving platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a saucepan and stir in brown sugar. Place over medium heat and bring to a boil, stirring until brown sugar has dissolved. Serve hot dog pieces with brown sugar sauce drizzled on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
