  "ingredients": [
    "8 ounces bow tie pasta",
    "1 tablespoon olive oil",
    "2 (6 ounce) fillets fresh salmon",
    "0.5 teaspoon kosher salt",
    "2 cups broccoli florets, cut into bite-size pieces",
    "1 pint grape tomatoes",
    "0.5 cup chicken broth",
    "4 cloves garlic, finely chopped",
    "0.5 cup crumbled reduced-fat feta cheese",
    "1 lemon, zested and juiced",
    "2 tablespoons coarsely chopped fresh dill",
    "0.25 teaspoon red pepper flakes"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook bow tie pasta at a boil, stirring occasionally, until tender yet firm to the bite, about 12 minutes. Drain. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat a large sauté pan over medium-high, 2 to 3 minutes. Add oil to the pan; season salmon with salt. Add salmon to the pan; cook until browned, 1 to 2 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add broccoli, tomatoes, broth, and garlic to the pan; break salmon up into bite-sized pieces as it cooks, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in pasta, feta, lemon zest, lemon juice, dill, and pepper flakes; toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
