  "ingredients": [
    "3 cups all-purpose flour",
    "3 tablespoons flax seeds",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon arrowroot powder",
    "1 cup unsweetened applesauce",
    "1 cup white sugar",
    "1 cup packed brown sugar",
    "0.75 cup vegetable oil",
    "2 teaspoons vanilla extract",
    "2.5 cups shredded zucchini"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 325 degrees F (165 degrees C). Grease and flour two 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/brC07qP94YQuNr9eULyOSmJE1PQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/109683-kingmans-vegan-zucchini-bread-DDMFS-28664-step-01-033cb709a4d045e089f4b174574cec8d.jpg"
      ],
      "image": "assets/images/109683/step_01.webp"
    },
    {
      "text": "Whisk flour, flax seeds, cinnamon, salt, baking soda, baking powder, and arrowroot together in a bowl until evenly blended; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ylKfzlMW2LTX70fcIRR9ru4mAdk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/109683-kingmans-vegan-zucchini-bread-DDMFS-28666-step-02-075e4e75e23c4f2cb06f8c01e71c2d45.jpg"
      ],
      "image": "assets/images/109683/step_02.webp"
    },
    {
      "text": "Whisk applesauce, white sugar, brown sugar, vegetable oil, and vanilla extract in a separate bowl until smooth. Fold in flour mixture and shredded zucchini until moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/58F4T3mRQz6l5VOYDcC_ShVzBZQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/109683-kingmans-vegan-zucchini-bread-DDMFS-28667-step-03-abdaa74462fc4ed39b3b2ba038712f6d.jpg"
      ],
      "image": "assets/images/109683/step_03.webp"
    },
    {
      "text": "Divide batter between the prepared loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/baRfzM8iKE9dUTWXgElSU9RRywo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/109683-kingmans-vegan-zucchini-bread-DDMFS-28728-step-04-68788a354c56424e96737a10baa43445.jpg"
      ],
      "image": "assets/images/109683/step_04.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 70 minutes. Cool briefly in the pans before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hbVyDnERnNVYaw2JDSis5m0JCVM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/109683-kingmans-vegan-zucchini-bread-DDMFS-28728-step-05-0d0280ac87de4580b907762265b24742.jpg"
      ],
