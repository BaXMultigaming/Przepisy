  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl combine sausage, beef, eggs, bread crumbs, onion, bell pepper, salt, pepper and garlic powder. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll out mixture flat, 8 inches by 8 inches square. Spread 1/2 can of soup over meatloaf, roll up and seal edges. Place in a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 30 minutes. Add remaining soup and bake for another 20 minutes.",
