  "ingredients": [
    "2 pears, peeled and sliced",
    "0.5 cup dry white wine",
    "0.25 cup water",
    "3 sweet potatoes, peeled and cubed",
    "1 cup evaporated milk",
    "0.25 teaspoon vanilla extract",
    "0.25 cup brown sugar",
    "2 tablespoons butter",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Place the pears, wine, and water in a small saucepan and bring to a boil over high heat. Turn heat to medium-low and simmer until pears are soft, about 5-10 minutes. Remove pears from wine and reserve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the sweet potatoes into a large pot and cover with water. Bring to a boil over high heat, then reduce heat to medium-low, cover, and simmer until tender, about 20 minutes. Drain and allow to potatoes to steam dry for a minute or two.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir the reserved pears, evaporated milk, vanilla, brown sugar, butter, cinnamon, and nutmeg into the sweet potatoes and mash until smooth. Transfer to a serving dish and serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
