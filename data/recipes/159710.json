  "ingredients": [
    "0.75 cup baking mix",
    "0.5 cup milk",
    "3 tablespoons butter, softened",
    "1 (1.5 ounce) package instant vanilla pudding mix",
    "1 egg",
    "1 (15 ounce) can canned peaches - drained with 3 tablespoons juice reserved",
    "8 ounces cream cheese",
    "0.5 cup sugar",
    "1 tablespoon sugar",
    "0.5 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter an 8-inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat baking mix, milk, butter, vanilla pudding mix, and egg together in a large bowl with an electric mixer for 2 minutes; pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Chop peaches; scatter over top of batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, ½ cup sugar, and reserved peach juice together in a medium bowl with an electric mixer until smooth; pour over peaches. Combine 1 tablespoon sugar and cinnamon in a small bowl; sprinkle over cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the center is set, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
