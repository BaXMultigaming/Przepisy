  "ingredients": [
    "1.5 pounds multi-colored new potatoes, halved",
    "2 tablespoons olive oil",
    "2 cloves garlic, minced",
    "1 teaspoon finely chopped fresh rosemary",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon lemon zest"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss potatoes, oil, garlic, rosemary, and salt together in a large bowl; arrange in a single layer in the air fryer basket without overcrowding (work in batches, if necessary).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
