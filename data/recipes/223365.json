  "ingredients": [
    "6 fresh peaches - peeled, pitted, and sliced",
    "0.5 cup white sugar",
    "0.25 cup butter, softened",
    "2 eggs",
    "0.5 cup milk",
    "1.5 cups all-purpose flour",
    "4 teaspoons baking powder",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a baking dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir peaches and ½ cup sugar together in a large bowl; place into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat remaining 1 cup sugar and butter together in a medium bowl until creamy; stir in eggs and milk to combine. Combine flour, baking powder, and salt in a separate bowl; stir into butter mixture until well combined. Pour batter evenly over peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until center is set and bounces back when lightly pressed, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
