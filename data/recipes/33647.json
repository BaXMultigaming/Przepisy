    "publisher-tested"
  ],
  "ingredients": [
    "9 ounces bittersweet chocolate, roughly chopped",
    "1 cup heavy cream",
    "1 tablespoon dark rum"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qyUjdpbCA-JvBX0cf3qg_9C4pG0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/33647-chocolate-ganache-DDMFS-Step-01-6e64f326225a48e380cdd0983c9d2e27.jpg"
      ],
      "image": "assets/images/33647/step_01.webp"
    },
    {
      "text": "Place chocolate in a medium mixing bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1oFyAoN9zcZF7v2ogrBoKK43cCo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/33647-chocolate-ganache-DDMFS-Step-02-6a7850b5bb0b473bb313a503a50f46f7.jpg"
      ],
      "image": "assets/images/33647/step_02.webp"
    },
    {
      "text": "Heat cream in a small saucepan over medium heat. Bring just to a boil, watching very carefully because if it boils for even a few seconds, it will boil out of the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5WrMtxOIxDkCESxrBZjiMCLPmLc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/33647-chocolate-ganache-DDMFS-Step-03-4e35af5c2f58437b8d611b205f513aa7.jpg"
      ],
      "image": "assets/images/33647/step_03.webp"
    },
    {
      "text": "As soon as the cream comes to a boil, pour it over the chocolate in the mixing bowl. Whisk until chocolate has melted and mixture is smooth, then stir in rum.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/giu0gvtq7trmPhmVC2SmgBeavlY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/33647-chocolate-ganache-DDMFS-Step-04-A-e86cc8a881004ccda6671b245cb68108.jpg"
      ],
      "image": "assets/images/33647/step_04.webp"
    },
    {
      "text": "To use ganache as a cake glaze, cool slightly, 5 to 10 minutes. Start pouring glaze at the center of the cake and work outward.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r10PAc89ZBLx6_BMZtCDICm6qN0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/33647-chocolate-ganache-DDMFS-Step-05-074ce318dc6d454caedb0e339b4d9ba5.jpg"
      ],
      "image": "assets/images/33647/step_05.webp"
    },
    {
      "text": "For a fluffy frosting or chocolate filling, allow it to cool until thick (up to 1 hour in the refrigerator), and then whip until light and fluffy. Apply it with a spatula like a conventional frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oJyMp3OpuK2M1i2n1NPFYFlbsOk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/33647-chocolate-ganache-DDMFS-Step-06-07a2212f66584838a1a9b1936dd63ce6.jpg"
      ],
      "image": "assets/images/33647/step_06.webp"
    }
  ],
