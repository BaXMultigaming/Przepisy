  "ingredients": [
    "2 (5 ounce) mahi mahi fillets",
    "1 tablespoon freshly squeezed lemon juice",
    "1 tablespoon olive oil",
    "2 teaspoons Cajun seasoning",
    "salt and ground black pepper to taste",
    "4 tablespoons mayonnaise",
    "1 teaspoon adobo sauce from chipotle peppers",
    "2 (2 ounce) whole wheat hamburger buns",
    "2 thick slices fresh tomato",
    "4 leaves romaine lettuce"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season mahi mahi fillets with lemon juice, olive oil, Cajun seasoning, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until white and flaky, about 4 minutes per side. An instant-read thermometer inserted into the center should read at least 137 degrees F (58 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, split and toast hamburger buns. Mix mayonnaise and adobo sauce together in a small bowl and spread on toasted buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place mahi mahi fillets on buns. Garnish with tomatoes and lettuce leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
