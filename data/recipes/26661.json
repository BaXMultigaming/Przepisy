  "ingredients": [
    "0.66666668653488 cup water",
    "0.33333334326744 cup uncooked white rice",
    "8 cabbage leaves",
    "1 pound lean ground beef",
    "0.25 cup chopped onion",
    "1 egg, slightly beaten",
    "1 (10.5 ounce) can condensed tomato soup, divided",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AY1tXEZ_G6Hvwk8b1pM13Z6n2cA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26661-Stuffed-Cabbage-Rolls-ddmfs-step-0-7c233b570e234b5ea6382a9f7fee9fce.jpg"
      ],
      "image": "assets/images/26661/step_01.webp"
    },
    {
      "text": "Bring water and rice to a boil in a saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KWSGY1YW7iBG3ct1U-_dj-_JTMQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-26661-Stuffed-Cabbage-Rolls-ddmfs-step-1-00e7aab79ce5426285b695101a1730da.jpg"
      ],
      "image": "assets/images/26661/step_02.webp"
    },
    {
      "text": "Reduce heat to low, cover, and simmer until rice is tender and liquid has been absorbed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eYYXmA60UZZvplbmSkU2ETv0UIs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-26661-Stuffed-Cabbage-Rolls-ddmfs-step-2-5b29e2edd06549fa94bc821743b34ae8.jpg"
      ],
      "image": "assets/images/26661/step_03.webp"
    },
    {
      "text": "Meanwhile, bring a large, wide saucepan of lightly salted water to a boil. Add cabbage leaves and cook for 2 to 4 minutes or until softened; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0jeOMhim-T8pTUCtSXyvseFLrls=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-26661-Stuffed-Cabbage-Rolls-ddmfs-step-3-30074bb172b8464180c262542b635d66.jpg"
      ],
      "image": "assets/images/26661/step_04.webp"
    },
    {
      "text": "Combine ground beef, 1 cup of cooked rice, onion, beaten egg, 2 tablespoons of tomato soup, salt, and pepper in a large bowl; mix thoroughly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XGa11ZDccnJZAIJGLqZ5_ka5PKA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-26661-Stuffed-Cabbage-Rolls-ddmfs-step-4-B-493c17f5aa3a4a5c968d996a2134c2f0.jpg"
      ],
      "image": "assets/images/26661/step_05.webp"
    },
    {
      "text": "Spoon about 2 tablespoons of beef mixture onto each cabbage leaf.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BMwEq8Qr9AhVZltm8HfGSM7czmo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-26661-Stuffed-Cabbage-Rolls-ddmfs-step-5-8a751a07e0fc4938b3f5c921bdf295f1.jpg"
      ],
      "image": "assets/images/26661/step_06.webp"
    },
    {
      "text": "Bring one end of the cabbage leaf over the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YW3QIPIrhAA1y7nIfuhPxXd0IRs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-26661-Stuffed-Cabbage-Rolls-ddmfs-step-6-a2fb2601881841ad9d1ba00ada092e95.jpg"
      ],
      "image": "assets/images/26661/step_07.webp"
    },
    {
      "text": "Roll and tuck in the ends to prevent the filling from falling out.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j723m5XHYB77wHw_3GSK4AvedWw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-26661-Stuffed-Cabbage-Rolls-ddmfs-step-7-fa8194cd14154ad58bd85bd4dacd02b9.jpg"
      ],
      "image": "assets/images/26661/step_08.webp"
    },
    {
      "text": "Arrange cabbage rolls seam-side down in a large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/v_yr_IhKMnkRXGcfqkJ2LPIOyLI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-26661-Stuffed-Cabbage-Rolls-ddmfs-step-8-8a5c531d8e04421c8593c42a150a2fea.jpg"
      ],
      "image": "assets/images/26661/step_09.webp"
    },
    {
      "text": "Pour remaining tomato soup over the rolls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0PxKeQSiYJNbuZTWvo1Lr9lGv8Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-26661-Stuffed-Cabbage-Rolls-ddmfs-step-9-f159944da8634549a3b75ab3221deea8.jpg"
      ],
      "image": "assets/images/26661/step_10.webp"
    },
    {
      "text": "Cover and bring to a boil. Reduce heat to low and simmer, basting with the sauce often, until beef is cooked through, about 40 minutes..",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E5lw2X5acnJF37TtXXsuFOohl0A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-26661-Stuffed-Cabbage-Rolls-ddmfs-step-10-19f529a4b92c4fe6b2968f16d55b329d.jpg"
      ],
      "image": "assets/images/26661/step_11.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JFRkj37psPn85tLXHPP6SKrsYDM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/26661-Stuffed-Cabbage-Rolls-PICS-Beauty-4x3-c907c4a2575d48518ecd7f091d3a8d10.jpg"
      ],
      "image": "assets/images/26661/step_12.webp"
    }
