  "ingredients": [
    "1 slice bacon",
    "1 teaspoon melted butter",
    "1 egg",
    "0.25 slice Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook bacon in a large, deep skillet over medium-high heat until evenly brown, but still flexible. Wrap bacon around the inside of a muffin cup. Place butter (or bacon grease) in the bottom of the muffin cup; crack egg into the muffin cup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 to 15 minutes. Place cheese over egg; continue cooking until cheese melts and egg is cooked.",
      "section": null,
      "name": null,
      "url": null,
