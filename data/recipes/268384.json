  "ingredients": [
    "1 (15 ounce) can plain pumpkin puree",
    "1 (14 ounce) can sweetened condensed milk",
    "2 eggs",
    "1 teaspoon maple-flavored extract",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground ginger",
    "0.25 teaspoon ground nutmeg",
    "1 (9 inch) prepared graham cracker crust",
    "0.33333334326744 cup packed brown sugar",
    "0.33333334326744 cup all-purpose flour",
    "0.5 teaspoon ground cinnamon",
    "3 tablespoons butter, cubed",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pumpkin, condensed milk, eggs, maple extract, 1/2 teaspoon cinnamon, salt, ginger, and nutmeg in a large bowl; mix well. Pour into graham cracker crust; smooth top with a spatula.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Reduce oven temperature to 350 degrees F (175 degrees C). Continue baking until filling is set, about 30 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine brown sugar, flour, and 1/2 teaspoon cinnamon in a bowl; cut in butter with a fork until coarse crumbs form. Stir in walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pie from oven; sprinkle evenly with walnut topping. Continue baking until topping is golden brown, about 10 minutes. Cool completely before slicing.",
      "section": null,
      "name": null,
      "url": null,
