  "ingredients": [
    "0.5 cup bacon fat",
    "0.75 cup all-purpose flour",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "4 cups whole milk, at room temperature, or more if needed"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FTtUx5w0dJxQRsN7odPNyFdFY8U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/65104-MomsCountryGravy-mfs-step1-0352-74af72b73b504cd7aa876996b5093fd4.jpg"
      ],
      "image": "assets/images/65104/step_01.webp"
    },
    {
      "text": "Melt bacon fat in a large skillet over medium heat. Stir in flour, salt, and pepper. Cook, whisking continuously until the roux becomes paste-like and light golden brown, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OgQ73ilTSkChLo_zizlxKmzXUl8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/65104-MomsCountryGravy-mfs-step3-0355-57d3d196be844f53bbdd599939b1efbe.jpg"
      ],
      "image": "assets/images/65104/step_02.webp"
    },
    {
      "text": "Gradually whisk 4 cups of milk into the flour mixture, and bring to a simmer over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aP3ZrhA3psjWylIOzuCXzQ7knZA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/65104-MomsCountryGravy-mfs-step4-0356-a601532d15f84dd9ba99af2073382e0c.jpg"
      ],
      "image": "assets/images/65104/step_03.webp"
    },
    {
      "text": "Cook and stir until gravy is heated through and smooth, 3 to 5 minutes, adding more milk if gravy is too thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3JKavkZQei36qtik2lJ0NyWwL6Q=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/65104-MomsCountryGravy-mfs-step4-0357-ad1c8329a108425585634082fd94bf5a.jpg"
      ],
      "image": "assets/images/65104/step_04.webp"
    },
    {
      "text": "Serve hot on a biscuit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0-8nY8XAC0jeQF1YcXfXz_70vt8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/65104-moms-country-gravy-DDMFS-4x3-c8a64e178c474710a4d0378487acc989.jpg"
