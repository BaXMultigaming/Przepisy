  "ingredients": [
    "1 cup all-purpose flour",
    "0.75 cup white sugar",
    "2 tablespoons unsweetened cocoa powder",
    "2 teaspoons baking powder",
    "0.25 teaspoon salt",
    "0.5 cup milk",
    "2 tablespoons vegetable oil",
    "1 teaspoon vanilla extract",
    "0.75 cup packed brown sugar",
    "0.25 cup unsweetened cocoa powder",
    "1.5 cups boiling water"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F ( 175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In ungreased 9 inch square pan, stir together flour, white sugar, cocoa, the baking powder, and salt. Mix in milk, oil, and vanilla with a fork until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread batter evenly in pan (batter will be thick). Sprinkle with brown sugar and 1/4 cup cocoa. Pour boiling water over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 40 minutes. Let stand 15 minutes, then spoon into dessert dishes or cut into squares. Invert each square onto dessert plate and spoon sauce over each serving. Top with ice cream or whipped topping, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
