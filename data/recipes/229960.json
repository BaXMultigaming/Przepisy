  "ingredients": [
    "1 (16 ounce) package linguine pasta",
    "2 tablespoons butter",
    "2 tablespoons extra-virgin olive oil",
    "2 shallots, finely diced",
    "2 cloves garlic, minced",
    "1 pinch red pepper flakes",
    "1 pound shrimp, peeled and deveined",
    "1 pinch kosher salt and freshly ground pepper",
    "0.5 cup dry white wine",
    "1 lemon, juiced",
    "0.25 cup finely chopped fresh parsley leaves",
    "1 teaspoon extra-virgin olive oil, or to taste"
  ],
  "steps": [
    {
      "text": "Gather ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W6oEBm_wBMizH--Clfr0jB_cLxA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229960-Shrimp-Scampi-with-Pasta-mfs-Steps-001-af8c0e33b7ee49b9ae9e6033cf7e3141.jpg"
      ],
      "image": "assets/images/229960/step_01.webp"
    },
    {
      "text": "Bring a large pot of salted water to a boil; cook linguine in boiling water until nearly tender, 6 to 8 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CdQ95qlNbunCh8Q3XFtd7eliX1s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229960-Shrimp-Scampi-with-Pasta-mfs-Steps-002-1527c724a9764773ba8d3e8531dd47d8.jpg"
      ],
      "image": "assets/images/229960/step_02.webp"
    },
    {
      "text": "Melt 2 tablespoons butter with 2 tablespoons olive oil in a large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vIBMHN79cQ4cmVZX7cam_czRDY0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229960-Shrimp-Scampi-with-Pasta-mfs-Steps-003-c2acd64018014cb2a3660fa85c37ba86.jpg"
      ],
      "image": "assets/images/229960/step_03.webp"
    },
    {
      "text": "Add shallots, garlic, and red pepper flakes; cook and stir until shallots are translucent, 3 to 4 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PToVtKLsiT3SQxrr_kSyek9zO2I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229960-Shrimp-Scampi-with-Pasta-mfs-Steps-005-24f43404573c4372b02d60a6f7f74778.jpg"
      ],
      "image": "assets/images/229960/step_04.webp"
    },
    {
      "text": "Season shrimp with kosher salt and black pepper. Add to the skillet; cook until pink, stirring occasionally, 2 to 3 minutes. Transfer shrimp to a plate; keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JLqhCU9WVnQayaGTVZiywlLN5FI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229960-Shrimp-Scampi-with-Pasta-mfs-Steps-008-28ed97e8fa6345458bc705b4286699c3.jpg"
      ],
      "image": "assets/images/229960/step_05.webp"
    },
    {
      "text": "Add white wine and lemon juice to the skillet; bring to a boil while scraping the browned bits of food off of the bottom of the skillet with a wooden spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xeVYfG4B_eycGMTdZfZchfTAgoA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229960-Shrimp-Scampi-with-Pasta-mfs-Steps-015-b0359ac038f948ba935190edde733d94.jpg"
      ],
      "image": "assets/images/229960/step_06.webp"
    },
    {
      "text": "Melt remaining 2 tablespoons butter in skillet; stir in 2 tablespoons olive oil and bring to a simmer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MkS1x9ZPdMscok292X3QKLm1JD8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229960-Shrimp-Scampi-with-Pasta-mfs-Steps-019-36a81807c03249a4923faf0f1668428d.jpg"
      ],
      "image": "assets/images/229960/step_07.webp"
    },
    {
      "text": "Toss linguine, shrimp, and parsley in butter mixture until coated; season with salt and black pepper. Drizzle with 1 teaspoon olive oil to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/WnXCe6YtZG0rCALpHYTVpwVzxjI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229960-Shrimp-Scampi-with-Pasta-mfs-Steps-028-79a14bcc249f4b18a78e7c696ed74ddc.jpg"
      ],
      "image": "assets/images/229960/step_08.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jiV_4f8vXFle1RdFLgd8-_31J3M=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229960-shrimp-scampi-with-pasta-DDMFS-4x3-e065ddef4e6d44479d37b4523808cc23.jpg"
      ],
      "image": "assets/images/229960/step_09.webp"
    }
  ],
