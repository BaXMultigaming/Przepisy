  "ingredients": [
    "6 cups whole milk",
    "0.75 cup Arborio rice",
    "0.75 cup white sugar, divided",
    "1 teaspoon vanilla extract",
    "0.25 teaspoon salt",
    "2 eggs",
    "2 egg yolks",
    "1 cup heavy whipping cream"
  ],
  "steps": [
    {
      "text": "Mix milk, rice, 1/2 of the sugar, vanilla extract, and salt together in a saucepan over medium-high heat. Bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend remaining sugar with whole eggs and yolks in a bowl to make a creamy custard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat of the milk mixture. Let simmer, uncovered, until thickened, 30 to 40 minutes. Fold in the custard. Heat until thickened again, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream in a chilled glass or metal bowl with an electric mixer until soft peaks form.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the milk and custard mixture from heat. Let cool, about 10 minutes. Fold in the whipped cream. Pour pudding into a serving dish, cover, and refrigerate until chilled, at least 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
