  "ingredients": [
    "4 red potatoes",
    "3 tablespoons olive oil, divided",
    "1 onion, chopped",
    "1 green bell pepper, seeded and chopped",
    "1 teaspoon salt",
    "0.75 teaspoon paprika",
    "0.25 teaspoon ground black pepper",
    "0.25 cup chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Add potatoes and cook until tender but still firm, about 15 minutes. Drain, cool, and cut into 1/2-inch cubes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KKzd90N2NmKWqPCbhxlrAzSZZ9s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20462-Home-Fried-Potatoes-ddmfs-4x3-step1-5af7d88284f7468fab855e7dc0583c72.jpg"
      ],
      "image": "assets/images/20462/step_01.webp"
    },
    {
      "text": "Heat 1 tablespoon oil over medium-high heat. Add onion and green pepper. Cook, stirring often, until soft; about 5 minutes. Transfer to a plate and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xgzN8fTHERhyVroutoR3sPYBHCk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20462-Home-Fried-Potatoes-ddmfs-4x3-step2-5f1f968b756d47b19c1d4cdcb6a71c16.jpg"
      ],
      "image": "assets/images/20462/step_02.webp"
    },
    {
      "text": "Pour remaining 2 tablespoons oil into the skillet over medium-high heat. Add potato cubes, salt, paprika, and black pepper. Cook, stirring occasionally, until potatoes are browned; about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fckjhoRrLrnnsgGSULJhJDxftEI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20462-Home-Fried-Potatoes-ddmfs-4x3-step4-8a970314bef44e628a4435261f373161.jpg"
      ],
      "image": "assets/images/20462/step_03.webp"
    },
    {
      "text": "Stir in onion-green pepper mix and parsley. Cook for another minute. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oBgyG8yD0CTY42CbjWBkVUA9V9o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/20462-Home-Fried-Potatoes-ddmfs-4x3-step5-9dc8e6be49434450ab4356b3bf394baa.jpg"
      ],
      "image": "assets/images/20462/step_04.webp"
    }
  ],
