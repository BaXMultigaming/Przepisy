  "ingredients": [
    "4 large baking potatoes",
    "4 tablespoons milk",
    "salt to taste",
    "2 tablespoons butter",
    "0.25 cup shredded mild Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Clean and scrub baking potatoes. Pierce skin with a fork once or twice. Bake at 350 degrees F (175 degrees C) for approximately 1 hour or until the potatoes are soft and firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let potatoes cool slightly. Cut baked potatoes in half and scoop out pulp within 1/4 inch of the shell edge. Mash the pulp with milk, salt and butter to taste. Stuff shells with mashed pulp mixture sprinkle tops with grated cheddar cheese. Place potatoes on a baking sheet and bake at 350 degrees F (175 degrees C) for 15 minutes or until cheese is melted and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
