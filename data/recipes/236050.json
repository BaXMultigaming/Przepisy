  "ingredients": [
    "0.25 cup butter",
    "1.5 cups small broccoli florets",
    "1 cup sliced fresh mushrooms",
    "0.5 cup shredded carrot",
    "0.25 cup chopped onion",
    "0.25 cup all-purpose flour",
    "0.5 teaspoon dried basil, crushed",
    "0.25 teaspoon black pepper",
    "3 cups milk",
    "1 cup half-and-half or light cream",
    "1.5 teaspoons Worcestershire sauce",
    "1.5 teaspoons instant chicken bouillon granules",
    "2 (6 ounce) packages Tyson® Grilled & Ready® Refrigerated Diced Chicken Breast"
  ],
  "steps": [
    {
      "text": "Melt butter in a large saucepan or Dutch oven over medium-high heat. Cook and stir broccoli, mushrooms, carrot, and onion in hot butter until vegetables are tender, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour, basil, and pepper until combined. Pour in milk and half-and-half all at once; add Worcestershire sauce and bouillon granules. Cook and stir until thickened and bubbly. Add chicken; continue cooking until heated through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
