  "title": "Chicken Chimichangas with Sour Cream Sauce",
  "description": "Green chiles and Monterey Jack cheese make these chimichangas special.",
  "authors": [
    "SSTRAWDER"
  ],
  "date_published": "2019-04-03T23:49:11-04:00",
  "date_modified": "2026-02-16T11:49:57-05:00",
