    "Mexican"
  ],
  "breadcrumbs": [],
  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "2 large skinless, boneless chicken breast halves",
    "3 cups water",
    "1 tablespoon chili powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground cumin",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion powder",
    "0.125 teaspoon cayenne pepper",
    "1 (7 ounce) can chopped green chilies, divided",
    "0.5 cup diced onion",
    "3 large cloves garlic, minced",
    "2 tablespoons butter",
    "2 tablespoons all-purpose flour",
    "1 cup water",
    "1 cube chicken bouillon",
    "0.5 cup sour cream",
    "salt and pepper to taste",
    "oil for frying",
    "8 (8 inch) flour tortillas",
    "8 ounces shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Place the chicken breasts into a large saucepan. Pour in the water, and season with chili powder, 1/2 teaspoon salt, cumin, 1/4 teaspoon black pepper, garlic powder, onion powder, and cayenne pepper. Bring to a simmer over high heat, then reduce heat to medium-low, and simmer 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sKp8kXiVM5SMmQTAhnFNhEGC9uo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214572-chicken-chimichangas-with-sour-cream-sauce-ddmfs-4x3-step2-0080-0ab72b82e2c1489f8a52d050120c3517.jpg"
      ],
      "image": "assets/images/214572/step_01.webp"
    },
    {
      "text": "After 15 minutes, stir in 4 ounces of green chiles, onion, and garlic; continue simmering until the liquid has reduced to 1 cup. Reserve remaining 3 ounces of chopped green chilies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the chicken, shred with two forks, and return to the onion mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q1FwDa0JEQz_SxUsSebPQ5AKzv4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214572-chicken-chimichangas-with-sour-cream-sauce-ddmfs-4x3-step3-0082-8ae50a3111994a04b3f750fb4b9f2da6.jpg"
      ],
      "image": "assets/images/214572/step_03.webp"
    },
    {
      "text": "Meanwhile, melt the butter in a small saucepan over medium heat. Stir in the flour, and cook for 1 minute. Whisk in the water and bouillon cube until the water has thickened and the bouillon cube has dissolved, about 4 minutes. Whisk in reserved 3 ounces of green chilies and the sour cream; season to taste with salt and pepper. Keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UyIv5fFo6_dKamHY0CCitI0gkjA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214572-chicken-chimichangas-with-sour-cream-sauce-ddmfs-4x3-step4-0083-a8b1bdd85ca84c0099eaac506697da13.jpg"
      ],
      "image": "assets/images/214572/step_04.webp"
    },
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a tortilla onto your work surface, then spoon about 1/3 cup of the chicken filling halfway between the bottom edge and the center of the tortilla. Flatten the filling into rectangle shape with the back of a spoon. Sprinkle about 1 ounce of the Monterey Jack cheese over the filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wbEOqe7XqZ4WFQZ5qTw87vvGxmQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214572-chicken-chimichangas-with-sour-cream-sauce-ddmfs-4x3-step5-0085-5698d0f092364db7a8243cc2f368c6e0.jpg"
      ],
      "image": "assets/images/214572/step_06.webp"
    },
    {
      "text": "Fold the bottom of the tortilla snugly over the filling, then fold in the left and right edges. Roll the chimichanga up to the top edge, forming a tight cylinder; secure the ends with wooden toothpicks. Repeat with the remaining ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wNOv4qHuYdweB3pnGHy-zk6eTRs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214572-chicken-chimichangas-with-sour-cream-sauce-ddmfs-4x3-step6-0087-e9cb49df125c4859847001482bd8daa9.jpg"
      ],
      "image": "assets/images/214572/step_07.webp"
    },
    {
      "text": "Cook the chimichangas, 2 at a time, in the hot oil until they are crisp and golden brown on both sides, about 1 minute per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain on a paper towel-lined plate, and remove toothpicks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/9c1b-DQ4Mnt3HqiYOgU_pE9Yacs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214572-chicken-chimichangas-with-sour-cream-sauce-ddmfs-4x3-step7-0088-1e31fdcec56345b7abc2205b270822c7.jpg"
      ],
      "image": "assets/images/214572/step_09.webp"
    },
    {
      "text": "Top with sour cream sauce to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/63liLu5ZpOac4PRcHzjrtKnfChs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/214572-chicken-chimichangas-with-sour-cream-sauce-DDMFS-4x3-a8e533ce663b48dc818049272eec5a66.jpg"
      ],
      "image": "assets/images/214572/step_10.webp"
    }
  ],
