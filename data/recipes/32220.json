  "ingredients": [
    "1 ripe avocado, sliced",
    "1 tablespoon lemon juice",
    "1 tablespoon butter",
    "1 large Vidalia onions, sliced into rings",
    "4 boneless, skinless chicken breast halves",
    "salt and pepper to taste",
    "4 hamburger buns",
    "4 tablespoons mayonnaise",
    "4 slices provolone cheese"
  ],
  "steps": [
    {
      "text": "Combine sliced avocado and lemon juice in a small bowl. Add water to cover; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly grease the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a large heavy skillet over medium-high heat. Sauté onions until browned and caramelized; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken with salt and pepper. Place on grill and cook until no longer pink and juices run clear, about 5 minutes on each side. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place buns on grill just long enough to toast them.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread buns with mayonnaise to taste, then layer with chicken, caramelized onion, provolone, and avocado.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
