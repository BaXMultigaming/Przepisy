  "ingredients": [
    "2 medium zucchini",
    "1 tablespoon unsalted butter",
    "1 tablespoon olive oil",
    "3 cloves garlic, minced",
    "2 tablespoons lemon juice",
    "0.25 teaspoon lemon-pepper seasoning",
    "0.25 teaspoon red pepper flakes",
    "1 pinch salt to taste",
    "1 teaspoon chopped fresh parsley",
    "0.5 teaspoon lemon zest"
  ],
  "steps": [
    {
      "text": "Use a spiralizer to cut zucchini into thick or thin ribbons, your preference.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add olive oil and garlic, and cook until the garlic is fragrant, about 1 minute. Add zucchini and toss to coat with the butter-garlic sauce. Saute until zucchini noodles are slightly softened or have reached desired tenderness, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in lemon juice, lemon-pepper, red pepper flakes, and salt, and remove from the heat. Garnish with a sprinkle of parsley and lemon zest, and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
