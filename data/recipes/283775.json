  "ingredients": [
    "1 (16 ounce) package egg noodles",
    "2 tablespoons mustard oil",
    "1 cup chopped onion",
    "3 green chile peppers, chopped",
    "1 tablespoon minced garlic",
    "1 tablespoon minced fresh ginger root",
    "1 tablespoon finely chopped lemongrass",
    "1 teaspoon ground cumin",
    "0.5 teaspoon ground turmeric",
    "1 large green bell pepper, chopped",
    "0.5 (8 ounce) package sliced fresh mushrooms",
    "2 cups vegetable broth",
    "0.5 cup chopped tomatoes",
    "0.5 cup plain yogurt",
    "4 teaspoons soy sauce",
    "1/2 teaspoon ajwain",
    "1 bay leaf",
    "salt and ground black pepper to taste",
    "1 (6 ounce) package fresh spinach",
    "1 tablespoon chopped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rapid boil. Add egg noodles and boil until tender yet firm to the bite, 7 to 9 minutes. Drain, rinse, and drain again. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the egg noodles cook, heat mustard oil in a saucepan over medium-high heat. Add onion and fry until light brown, about 5 minutes. Add chiles, garlic, ginger, lemongrass, cumin, and turmeric; sauté for 1 minute. Add bell pepper and mushrooms; stir-fry for 6 minutes. Add broth, tomatoes, yogurt, soy sauce, ajwain, bay leaf, salt, and pepper; cook until vegetables are tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add egg noodles and simmer for 3 minutes. Stir in spinach and cook for 1 to 2 minutes. Garnish with chopped cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
