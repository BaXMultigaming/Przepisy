  "ingredients": [
    "4 skinless, boneless chicken breast halves",
    "3 cloves crushed garlic",
    "3 tablespoons ground ginger",
    "1 tablespoon olive oil",
    "4 limes, juiced"
  ],
  "steps": [
    {
      "text": "Pound the chicken to 1/2 inch thickness. In a large resealable plastic bag combine the garlic, ginger, oil and lime juice. Seal bag and shake until blended. Open bag and add chicken. Seal bag and marinate in refrigerator for no more than 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from bag and grill or broil, basting with marinade, until cooked through and juices run clear. Dispose of any remaining marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
