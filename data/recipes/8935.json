  "title": "Easy Garlic Ginger Chicken",
  "description": "A brief marinade in garlic, ginger and lime juice leads to an intensely flavored chicken you can grill or broil.",
  "authors": [
    "Susan McFadden"
  ],
  "date_published": "1999-05-04T08:55:21-04:00",
