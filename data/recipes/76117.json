  "ingredients": [
    "0.5 cup butter",
    "1 (8 ounce) package whipped cream cheese",
    "1 cube chicken bouillon",
    "1 (10 ounce) package frozen corn kernels, thawed",
    "0.25 teaspoon white pepper",
    "0.125 teaspoon ground nutmeg",
    "salt to taste",
    "0.5 cup heavy cream",
    "0.5 cup shredded mozzarella cheese",
    "0.5 cup crushed buttery round crackers"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Lightly grease an 8-inch square casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter and cream cheese in a saucepan over medium heat; add chicken bouillon and stir to dissolve. Mix in corn and season with pepper, nutmeg, and salt. Stir in cream. Transfer mixture to the prepared casserole dish. Sprinkle with cheese and top with crackers.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
