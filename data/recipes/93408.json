  "ingredients": [
    "1 cup raw pumpkin seeds, rinsed and dried",
    "6 tablespoons white sugar, divided",
    "0.5 teaspoon pumpkin pie spice",
    "0.25 teaspoon salt",
    "1 tablespoon vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 250 degrees F (120 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pumpkin seeds on a baking sheet in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, stirring occasionally, until dry and toasted, about 45 minutes. Larger seeds may take longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 tablespoons white sugar, pumpkin pie spice, and salt in a medium bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add toasted pumpkin seeds; sprinkle with remaining ¼ cup sugar. Cook and stir with a wooden spoon until sugar melts, about 45 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour candied pumpkin seeds into bowl with spiced sugar; stir until coated. Cool completely before serving. Store in an airtight container at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
