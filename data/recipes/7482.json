  "ingredients": [
    "1.5 cups packed brown sugar",
    "0.25 cup butter, softened",
    "1 egg",
    "1 tablespoon vanilla extract",
    "2.3333332538605 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "4 cups chopped rhubarb",
    "1 cup sour cream",
    "0.33333334326744 cup white sugar",
    "0.5 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a (9x13-inch) glass baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat brown sugar and butter together in large bowl; beat in egg and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, baking soda, and salt together into a bowl; gradually stir into butter mixture. Fold in rhubarb and sour cream. Spoon batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar and nutmeg in a small bowl; sprinkle over batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
