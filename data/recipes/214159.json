  "title": "Homemade Mozzarella Sticks",
  "description": "Egg roll wrappers give these fried mozzarella sticks a pleasing crunch.",
  "authors": [
    "Lili Zimmermann"
  ],
  "date_published": "2019-04-02T02:53:16-04:00",
