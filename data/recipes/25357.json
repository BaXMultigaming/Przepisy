  "ingredients": [
    "2 cups fresh blueberries",
    "0.75 cup water, divided",
    "2 teaspoons lemon juice",
    "1.5 teaspoons unflavored gelatin",
    "3 tablespoons white sugar"
  ],
  "steps": [
    {
      "text": "In a heavy saucepan over medium-high heat, combine blueberries, 1/2 cup water, and lemon juice. Bring to a boil, then reduce the heat and simmer gently for about 8 minutes, stirring frequently.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, soak gelatin in 1/4 cup cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove blueberries from the heat and stir in gelatin and sugar. Pour into hot, sterilized jars and seal. Cool for 12 hours, then store in the refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
