  "ingredients": [
    "8 cups all-purpose flour",
    "1 cup butter, at room temperature",
    "3 tablespoons butter, at room temperature",
    "2 teaspoons ground nutmeg",
    "0.5 cup milk",
    "2 tablespoons milk",
    "1 cup vegetable oil"
