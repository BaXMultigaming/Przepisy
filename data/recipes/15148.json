  "ingredients": [
    "0.5 cup white sugar",
    "1 tablespoon cornstarch",
    "0.25 teaspoon ground cinnamon",
    "4 cups sliced fresh peaches",
    "1 teaspoon lemon juice",
    "1 cup all-purpose flour",
    "1 tablespoon white sugar",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon salt",
    "3 tablespoons shortening",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1/2 cup sugar, cornstarch, and cinnamon in a saucepan and whisk to mix. Stir in sliced peaches (see tip) and lemon juice, tossing until peaches are evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook filling over medium heat, stirring constantly, until mixture thickens and boils. Boil 1 minute. Pour mixture into an ungreased 2-quart casserole dish. Keep mixture hot in oven while you make the topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, 1 tablespoon sugar, baking powder, and salt in a medium bowl. Mix thoroughly, then cut in shortening (or butter) until mixture looks like fine crumbs. Add milk and stir until mixture is evenly moistened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove peach filling from oven and drop dough onto peaches in 6 equal-size spoonfuls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return cobbler to oven and bake until topping is golden brown, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
