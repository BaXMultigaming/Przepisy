  "ingredients": [
    "1 large egg, separated, divided",
    "1 (14.1 ounce) package pastry for 9-inch double-crust pie",
    "24 disposable mini pie pans",
    "2 large eggs",
    "1 (8 ounce) package cream cheese, softened",
    "1 cup pumpkin puree",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "1 teaspoon pumpkin pie spice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Beat egg white in a small bowl until slightly frothy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll each sheet of pastry out on a floured surface to roughly an 11-inch square. Use a 3-inch round cutter to cut 12 circles from each sheet of pastry. Fit a pastry crust into each mini pie pan; brush the edges with egg white.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the filling: Beat egg yolk and remaining 2 eggs in a medium bowl until combined. Add cream cheese, pumpkin puree, sugar, vanilla, and pumpkin pie spice; beat until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon about 2 tablespoons filling into each crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust edges are golden brown and filling is set, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove from the oven and allow to cool for 15 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
