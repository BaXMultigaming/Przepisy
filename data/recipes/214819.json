  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup whole wheat pastry flour",
    "1 teaspoon salt",
    "4.5 teaspoons baking powder",
    "2 eggs",
    "0.75 cup white sugar",
    "0.75 cup sucanat",
    "0.5 cup grapeseed oil",
    "1 cup half-and-half cream",
    "1.5 teaspoons rum flavored extract",
    "1 teaspoon vanilla extract",
    "1 lime, zested",
    "1 tablespoon minced fresh spearmint",
    "2 cups fresh blueberries",
    "1 tablespoon turbinado sugar"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C). Grease and flour 2 3x7-inch loaf pans. Whisk together the all-purpose flour, whole wheat flour, salt, and baking powder in a mixing bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat the eggs, sugar, sucanat, grapeseed oil, half-and-half cream, rum extract, vanilla extract, lime zest, and spearmint with an electric mixer in a large bowl until smooth. Stir in the flour mixture until just moistened, then stir in the blueberries, and pour into the prepared loaf pans. Sprinkle the tops evenly with the turbinado sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
