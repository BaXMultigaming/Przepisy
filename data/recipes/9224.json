  "ingredients": [
    "3 cups cooked and mashed sweet potatoes",
    "1 cup white sugar",
    "2 eggs",
    "0.5 cup butter",
    "0.5 teaspoon vanilla extract",
    "1 cup flaked coconut",
    "1 cup packed brown sugar",
    "0.33333298563957 cup all-purpose flour",
    "1 cup chopped pecans",
    "0.33333298563957 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix mashed sweet potatoes, white sugar, eggs, 1/2 cup butter, vanilla, and flaked coconut together in a bowl. Transfer into a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "With a fork, mix brown sugar, flour, pecans, and the remaining 1/3 cup of butter together. Sprinkle over sweet potato mixture. Bake in the preheated oven for 30 minutes.",
