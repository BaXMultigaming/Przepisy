  "ingredients": [
    "12 (6 inch) corn tortillas, quartered",
    "2 tablespoons canola oil",
    "1.5 teaspoons garlic salt",
    "1.5 teaspoons dried oregano",
    "1 teaspoon chili powder"
  ],
  "steps": [
    {
      "text": "Place a rack in the top third of the oven and preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange corn tortillas in a single layer, with no overlap, on a baking sheet. Brush tortillas with oil; sprinkle garlic salt, oregano, and chili powder on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, with the door slightly ajar, until crispy, about 7 minutes. Cool for 2 minutes before serving.",
