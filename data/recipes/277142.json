  "ingredients": [
    "2 cups all-purpose flour",
    "0.33333334326744 cup white sugar",
    "0.33333334326744 teaspoon salt",
    "0.66666668653488 cup margarine",
    "1.5 cups light corn syrup (such as Karo®)",
    "1 cup brown sugar",
    "4 eggs",
    "3 tablespoons margarine",
    "1.5 teaspoons vanilla extract",
    "0.125 teaspoon salt",
    "1.5 cups chopped pecans",
    "1 (11 ounce) package chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 10x15-inch jelly roll pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flour, white sugar, and salt together in a large bowl. Cut in 2/3 cup margarine until mixture resembles coarse crumbs. Press mixture into the bottom of the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While the crust is baking, prepare the filling by mixing corn syrup, brown sugar, eggs, margarine, vanilla extract, and salt together in a large bowl until smooth. Stir in pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove the crust from the oven and sprinkle with chocolate chips. Spread filling evenly over the chocolate chip covered crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 20 to 25 minutes. Cool completely before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
