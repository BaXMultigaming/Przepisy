  "ingredients": [
    "2 tablespoons olive oil",
    "2 stalks celery, chopped",
    "1 carrot, chopped",
    "0.5 yellow onion, chopped",
    "3 cloves garlic, chopped",
    "2 (15 ounce) cans black beans, undrained",
    "0.75 cup chicken broth",
    "0.25 cup orange juice",
    "2 teaspoons cayenne pepper",
    "1 teaspoon chili powder"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a Dutch oven or large saucepan over medium-high heat. Saute celery, carrot, onion, and garlic in hot oil until fragrant, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir black beans, chicken broth, orange juice, cayenne pepper, and chili powder with the vegetables in the pot; bring to a boil, reduce heat to medium-low, and simmer until the carrots are soft, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle about half the solids into a blender. Add enough liquid so the solids are completely submerged. Hold lid in place and pulse blender a few times before leaving on to puree. Return pureed mixture to pot and stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
