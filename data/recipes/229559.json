  "ingredients": [
    "2 large eggs",
    "0.66666668653488 cup milk",
    "2 teaspoons salt",
    "0.25 teaspoon ground black pepper",
    "3 slices bread, crumbled",
    "1.5 pounds ground beef",
    "1 onion, chopped",
    "1 cup shredded Cheddar cheese",
    "0.5 cup shredded carrot",
    "0.25 cup brown sugar",
    "0.25 cup ketchup",
    "1 tablespoon prepared yellow mustard"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/S_dwL1R52Ss2HUAj9dTQRhNUt98=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229559-Best-Ever-Meatloaf-ddmfs-071-step1-9795d084546d484d92ba16992314cc6d.jpg"
      ],
      "image": "assets/images/229559/step_01.webp"
    },
    {
      "text": "Whisk eggs, milk, salt, and ground black pepper in a large bowl. Add crumbled bread and stir until dissolved. Mix ground beef, onion, Cheddar cheese, and carrot into bread mixture; transfer mixture to a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sORKwz7nelUaXb6CaC6Gn_dAoa4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229559-Best-Ever-Meatloaf-ddmfs-073-step3-fa0783934a4245bb827cc5c6c3c1dc45.jpg"
      ],
      "image": "assets/images/229559/step_02.webp"
    },
    {
      "text": "Combine brown sugar, ketchup, and mustard in a small bowl; spread over the meat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nvCe3qQ06vuW9ZXabgK3BiR1B6A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/229559-Best-Ever-Meatloaf-ddmfs-075-step5-d6334c3b1a8b425c8677a639ac9e3571.jpg"
      ],
      "image": "assets/images/229559/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center, 60 to 75 minutes. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4mlb68WA9spYQV3D8WI3qgHrTiE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/2295590-Best-Ever-Meatloaf-ddmfs-083-4x3-1-6d7604c8b4204abd832a26ef85d0e58e.jpg"
      ],
      "image": "assets/images/229559/step_04.webp"
    }
