  "steps": [
    {
      "text": "In a large, nonreactive bowl, blend the soy sauce, olive oil, water, garlic, and pepper. Place beef tri-tip in the marinade. Cover and marinate in the refrigerator at least 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for high heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill beef slices 3 to 5 minutes per side or to desired doneness. Discard remaining marinade.",
