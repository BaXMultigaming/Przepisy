  "ingredients": [
    "1.5 pounds Brussels sprouts",
    "1 teaspoon salt",
    "4 tablespoons butter, melted",
    "4 tablespoons grated Parmesan cheese",
    "4 tablespoons dried bread crumbs",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon seasoning salt"
  ],
  "steps": [
    {
      "text": "Wash and trim Brussels sprouts. Cut an \"X\" about 1/8 inch deep in the stem of the sprouts (this helps cook the sprouts more evenly and quickly).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium-size pot, cover Brussels sprouts with water; add 1 teaspoon salt and bring to boil. Cover and simmer for 6 minutes or until tender; drain. Be careful not to overcook sprouts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place sprouts in a small casserole dish. Sprinkle 2 tablespoons of melted butter over the sprouts and mix well to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine Parmesan cheese, dried bread crumbs, garlic powder, black pepper, seasoning salt, and remaining butter and mix well; sprinkle mixture over sprouts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat sprouts under broiler (about 4 inches away from heat) for about 5 minutes or until crumb mixture is lightly browned. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
