  "ingredients": [
    "2 tablespoons butter, melted",
    "1 tablespoon Worcestershire sauce",
    "0.25 teaspoon ground red pepper",
    "0.25 teaspoon salt",
    "0.25 teaspoon garlic powder",
    "2 cups pecan halves",
    "1 tablespoon chili powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix butter, Worcestershire sauce, red pepper, salt, and garlic powder together in a medium bowl; stir in pecans. Add chili powder and gently toss to coat. Spread coated pecans on a medium baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake pecans in the preheated oven, checking and stirring every 8 to 10 minutes, until crispy around the edges, about 30 minutes, Best served warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
