  "ingredients": [
    "2 cups wild rice",
    "6 cups water",
    "4 cups chicken broth",
    "1 cup frozen corn kernels",
    "0.5 cup chopped green onions",
    "2 tablespoons red bell pepper, chopped",
    "2 tablespoons chopped green bell pepper",
    "1 tablespoon chopped fresh parsley",
    "1 teaspoon dried tarragon",
    "2 tablespoons cornstarch",
    "2 tablespoons water"
  ],
  "steps": [
    {
      "text": "In a medium sauce pan cook rice in 6 cups water until cooked through and tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large saucepan or stock pot combine broth, cooked rice, corn, green onions, red and green bell pepper, parsley and tarragon. Mix well and cook over medium heat until mixture boils. Reduce heat and simmer 5 minutes or until corn is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl, mix cornstarch and water. Add to soup mixture and cook for 5 minutes. Stir occasionally and serve once soup has thickened.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
