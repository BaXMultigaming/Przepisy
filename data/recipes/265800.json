  "ingredients": [
    "1 bunch fresh asparagus, trimmed",
    "0.5 cup pickled ginger, or to taste",
    "1 tablespoon olive oil, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place asparagus on a piece of heavy-duty aluminum foil large enough to wrap completely around asparagus; drizzle with oil and top with ginger. Seal foil into a packet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill about 5 minutes. Flip packet; cook until crisp-tender, about 5 minutes more (longer if you prefer well-done asparagus).",
      "section": null,
      "name": null,
