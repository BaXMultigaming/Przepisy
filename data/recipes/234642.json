  "ingredients": [
    "2 tablespoons coriander seeds, coarsely cracked",
    "0.5 cup firmly packed dark brown sugar",
    "0.25 cup soy sauce",
    "1 tablespoon lime juice",
    "2 cloves garlic, minced",
    "1 pinch ground ginger",
    "1.5 pounds flank steak"
  ],
  "steps": [
    {
      "text": "Place flank steak in the freezer for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk coriander, brown sugar, soy sauce, lime juice, garlic, and ground ginger together in a bowl until marinade is well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steak from freezer and slice thinly across the grain. Place steak in a large bowl, pour marinade over steak, and toss to coat. Cover bowl and marinate at room temperature for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set oven rack about 6 inches from the heat source and preheat the oven's broiler. Line bottom of a broiler pan with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lay steak slices in a single layer on the rack of the prepared broiler pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated broiler, brushing occasionally with marinade, until steak reaches desired doneness, 1 to 2 minutes for medium rare.",
      "section": null,
      "name": null,
      "url": null,
