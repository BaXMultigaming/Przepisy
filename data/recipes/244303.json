  "ingredients": [
    "3 cups fresh raspberries",
    "0.25 cup white sugar",
    "1.5 cups whole milk",
    "6 large eggs",
    "1.25 cups white sugar",
    "1 cup all-purpose flour",
    "2.5 tablespoons unsalted butter, room temperature",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon kosher salt",
    "0.25 cup coarse sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Butter a deep-dish pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread raspberries into the prepared pan and top with 1/4 cup white sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Blend milk, eggs, 1 1/4 cups white sugar, flour, unsalted butter, vanilla extract, and salt together in a blender until smooth and creamy; slowly pour over raspberries. Sprinkle coarse sugar over the floating raspberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until custard is raised in the middle and top is lightly browned, 45 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
