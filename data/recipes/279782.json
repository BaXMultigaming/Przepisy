  "steps": [
    {
      "text": "Fill a copper cup or mug with ice. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash 5 mint leaves in a cocktail shaker with a cocktail muddler. Add diced cucumber, ¼ cup blueberries, and 2 lime wedges; mash with the cocktail muddler until cucumber and blueberries are crushed and limes are juiced. Add ice and vodka; cover and shake until the outside of the shaker has frosted. Strain cocktail into the iced-filled copper cup; top with ginger beer.",
      "section": null,
