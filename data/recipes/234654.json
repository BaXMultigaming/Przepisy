  "ingredients": [
    "1 (15 ounce) can crushed pineapple",
    "1 cup white sugar",
    "2 eggs, beaten",
    "0.5 cup milk",
    "5 slices bread, cut into cubes",
    "1 teaspoon vanilla extract",
    "0.5 cup butter, melted",
    "ground cinnamon"
  ],
