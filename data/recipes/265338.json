    "publisher-tested"
  ],
  "ingredients": [
    "6 dried guajillo chile peppers, seeded",
    "4 dried chile de arbol peppers, stemmed and seeded",
    "2 dried ancho chiles, stemmed and seeded",
    "1 tablespoon olive oil, or as needed",
    "4 medium Roma tomatoes",
    "2 tablespoons white vinegar",
    "2 cloves garlic",
    "2 teaspoons ground black pepper",
    "4 whole cloves",
    "1 pinch ground cinnamon",
    "1 pinch ground cumin",
    "1 pinch ground thyme",
    "1 pinch dried marjoram",
    "1 pinch dried oregano",
    "1 pinch salt",
    "4 pounds beef chuck roast",
    "salt and freshly ground black pepper to taste",
    "18 corn tortillas",
    "1 large white onion, finely chopped",
    "1 bunch fresh cilantro, chopped",
    "1 cup shredded queso asadero (white Mexican cheese)"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fiInmbv3c5c1_QNr_DM6cyW8WwM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-265338-birria-de-res-tacos-beef-birria-tacos-VAT-4x3-ingredients-8e004a7456f24d69867abdfb40776cde.jpg"
      ],
      "image": "assets/images/265338/step_01.webp"
    },
    {
      "text": "Fill a pot with water; bring to a boil. Add guajillo, arbol, and ancho chile peppers; boil for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pxbkLlC8UnE1KbYW30hLT8huvNk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-265338-birria-de-res-tacos-beef-birria-tacos-VAT-4x3-step-02-1fb29803793145149227a3710f12c910.jpg"
      ],
      "image": "assets/images/265338/step_02.webp"
    },
    {
      "text": "Off heat, allow peppers to soak until cool. Drain; reserve ¼ cup cooking liquid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/L5bcvttE7EwWoNaYHiv8Cv3jSmw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-265338-birria-de-res-tacos-beef-birria-tacos-VAT-4x3-step-03-0bd78109be7243a4b1730cf3e5fef460.jpg"
      ],
      "image": "assets/images/265338/step_03.webp"
    },
    {
      "text": "Meanwhile, rinse beef; pat dry with paper towels. Cut beef into chunks if desired; season with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CEwwKgBUcVE9t9QE9XKmhnPaABQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-265338-birria-de-res-tacos-beef-birria-tacos-VAT-4x3-step-04-a303523dab2b4fcba5ad9fad1ec5ca7f.jpg"
      ],
      "image": "assets/images/265338/step_04.webp"
    },
    {
      "text": "Heat oil in a Dutch oven over medium-high heat. Add beef; cook until browned on all sides, about 10 minutes. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5LG9arBk0Y1LXemzy6SIOfZoQiE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-265338-birria-de-res-tacos-beef-birria-tacos-VAT-4x3-step-05-4e2269cea90a4365ba226ff4936f77a4.jpg"
      ],
      "image": "assets/images/265338/step_05.webp"
    },
    {
      "text": "While the beef is searing, line a heavy cast-iron grill pan or griddle with aluminum foil; place over high heat. Arrange tomatoes in a single layer on foil; grill until tomato skins burned on all sides and begins to peel, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uMJeH3DMCQ7F8YCUS97jENygyEY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-265338-birria-de-res-tacos-beef-birria-tacos-VAT-4x3-step-06-d1fbd15e0408495c94ddedc8d661ec66.jpg"
      ],
      "image": "assets/images/265338/step_06.webp"
    },
    {
      "text": "Place cooled chile peppers into a blender; add charred tomatoes, vinegar, garlic, 2 teaspoons black pepper, cloves, cinnamon, cumin, thyme, marjoram, oregano, and salt. Pour in reserved ¼ cup cooking liquid; blend until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I6PwNel9XqJ2G-9ibwlYOOwni9g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-265338-birria-de-res-tacos-beef-birria-tacos-VAT-4x3-step-07-3bf79b9a92b349d0b84a480cefa432bc.jpg"
      ],
      "image": "assets/images/265338/step_07.webp"
    },
    {
      "text": "Strain chile sauce through a mesh strainer; pour over browned beef in the Dutch oven, turning until completely covered with sauce. Cover the Dutch oven with a lid.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qJT7ARarju1F4qJmEALsb0ugHho=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-265338-birria-de-res-tacos-beef-birria-tacos-VAT-4x3-step-08-90808d8b1f6246a3a3eb52f58cecb435.jpg"
      ],
      "image": "assets/images/265338/step_08.webp"
    },
    {
      "text": "Bake in the preheated oven, basting beef every 45 minutes with sauce, until birria begins to fall apart, 3 to 4 hours. Remove the lid; bake, uncovered, until birria is crispy on top, about 20 minutes more. Remove from oven, cover with 2 layers of aluminum foil, and allow to rest in a warm area for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IsScJ_6AfS8JAA5GZdj3TK6oXYY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-265338-birria-de-res-tacos-beef-birria-tacos-VAT-4x3-step-09-b807db0ea8454e5ca534ba8588ace6f8.jpg"
      ],
      "image": "assets/images/265338/step_09.webp"
    },
    {
      "text": "Transfer beef to a cutting board; strain off any fat from sauce. Shred beef with two forks; return it to the pot and stir with sauce to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iTgCfenAGXUJ77itFIUxro31WYk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-265338-birria-de-res-tacos-beef-birria-tacos-VAT-4x3-step-10-4e1b558d4d134025ac14154d319f2f87.jpg"
      ],
      "image": "assets/images/265338/step_10.webp"
    },
    {
      "text": "Fill each tortilla with birria; top with Mexican cheese, chopped onion, and cilantro. Warm tortillas on a griddle, flipping until both sides crispy and cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7dj-6EywBaoPG7etY3ZITevR0Ek=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-265338-birria-de-res-tacos-beef-birria-tacos-VAT-4x3-step-11-261bef916f7a40aa8e0340b5f4aae12f.jpg"
      ],
      "image": "assets/images/265338/step_11.webp"
    },
    {
      "text": "Serve with extra sauce on the side for dipping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sYbmpNZhPVYvQA2yUWqjx1q42T0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/65338-Birria-de-Res-Tacos-ddmfs-4x3-2563-ca793a7c87c54af5ab600fd463ba2467.jpg"
      ],
      "image": "assets/images/265338/step_12.webp"
    }
  ],
