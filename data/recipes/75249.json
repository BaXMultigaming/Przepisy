    },
    {
      "text": "Add orange juice, lime juice, cilantro, salt, oregano, hot pepper sauce, cumin, lemon pepper, and black pepper. Blend until thoroughly incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour in olive oil; blend until smooth.",
