  "ingredients": [
    "12 eggs",
    "4 cups white sugar",
    "4 cups packed brown sugar",
    "1 tablespoon light corn syrup",
    "1 tablespoon vanilla extract",
    "1 teaspoon baking soda",
    "2 cups butter",
    "2 cups peanut butter",
    "18 cups rolled oats",
    "3 cups semisweet chocolate chips",
    "3 cups candy-coated milk chocolate pieces (such as M&M's®)"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat together the eggs, sugars, syrup, butter or margarine, vanilla, and peanut butter. Add the baking soda, and beat well. Stir in the oats, chocolate chips, and candies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place dough by tablespoonfuls on ungreased cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until edges are golden and cookies are set, about 12 minutes. Do not overbake!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
