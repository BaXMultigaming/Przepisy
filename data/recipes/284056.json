  "ingredients": [
    "1 tablespoon coconut oil",
    "1 small onion, minced",
    "2 cloves garlic, minced",
    "1.5 cups uncooked white rice",
    "1 teaspoon curry powder",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.125 teaspoon ground cayenne pepper",
    "12 ounces coconut milk",
    "1.5 cups chicken broth",
    "0.25 cup toasted flaked coconut"
  ],
  "steps": [
    {
      "text": "Heat coconut oil in a medium saucepan over medium-high heat. Add onion and garlic and saute until onion turns clear, 1 to 2 minutes. Add rice, curry powder, cinnamon, nutmeg, and cayenne pepper and stir constantly for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add coconut milk, chicken broth, and toasted coconut; bring to a boil. Reduce heat, cover, and simmer until all liquid is absorbed, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
