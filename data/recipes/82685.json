  "ingredients": [
    "2 tilapia fillets",
    "1 tablespoon oil from the jar of sun-dried tomatoes",
    "1 tablespoon lemon juice",
    "3 tablespoons sun-dried tomatoes packed in oil, drained and chopped",
    "2 tablespoons kalamata olives, pitted and chopped",
    "1 tablespoon capers, drained"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tilapia fillets in a baking dish; drizzle with oil and lemon juice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until fish flakes easily with a fork, 10 to 15 minutes; don't overcook.",
      "section": null,
