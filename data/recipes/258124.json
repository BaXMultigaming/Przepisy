  "ingredients": [
    "1.5 cups almond flour",
    "0.33333334326744 cup granular no-calorie sucralose sweetener (such as Splenda®)",
    "6 tablespoons butter, melted",
    "0.5 teaspoon ground cinnamon",
    "2 (8 ounce) packages cream cheese, softened",
    "2 (14 ounce) cans sweetened condensed milk",
    "0.75 cup freshly squeezed lemon juice",
    "2 teaspoons lemon zest, divided",
    "1 (8 ounce) container frozen whipped topping, thawed"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix almond flour, sucralose sweetener, butter, and cinnamon together in a large bowl. Press over the bottom and up the sides of a deep-dish pie plate to form a crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is firm, about 7 minutes. Let cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese in a bowl with an electric mixer until light and fluffy. Beat in sweetened condensed milk. Add lemon juice and 1 teaspoon lemon zest; beat until thoroughly blended. Pour filling into the cooled crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate until filling is set, about 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread whipped topping over lemon filling. Garnish with remaining 1 teaspoon lemon zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
