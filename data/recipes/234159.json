  "ingredients": [
    "1 cup pumpkin puree",
    "1 cup milk",
    "1 banana, sliced",
    "2 tablespoons brown sugar",
    "0.25 teaspoon ground cinnamon",
    "0.25 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Spoon pumpkin puree into a resealable bag and freeze, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove pumpkin from freezer and allow to soften at room temperature, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour milk into the blender; add pumpkin, banana, brown sugar, cinnamon, and vanilla extract. Blend until smooth, about 3 minutes.",
