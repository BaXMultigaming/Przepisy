  "ingredients": [
    "3 small zucchini, cut into french-fry shaped pieces",
    "salt to taste",
    "2 large eggs, beaten",
    "1 cup panko bread crumbs",
    "0.25 cup grated Parmesan cheese",
    "2 tablespoons Italian seasoning"
  ],
  "steps": [
