  "ingredients": [
    "1 tablespoon sesame oil",
    "0.5 teaspoon minced garlic",
    "1 pinch salt",
    "0.25 cup pine nuts",
    "2 cooked, boneless chicken breast halves, diced",
    "1 tablespoon peanut butter",
    "1 dash soy sauce",
    "3 pickled jalapeno pepper slices, chopped",
    "0.5 cup water"
  ],
  "steps": [
    {
      "text": "Heat the sesame oil in a skillet over medium heat. Stir in the garlic and salt. Cook and stir 1 minute, then stir in the pine nuts, and cook until golden, about 5 minutes. Add the diced chicken breast, and cook a few minutes to reheat. Stir in the peanut butter, soy sauce, and jalapeno pepper until the peanut butter has melted. Pour in the water, and bring to a simmer. Cook and stir until the sauce has thickened, about 5 minutes more.",
