  "ingredients": [
    "10 ounces all-purpose flour",
    "0.5 cup white sugar",
    "0.5 cup dark molasses",
    "2.5 teaspoons ground ginger, or more to taste",
    "1.25 teaspoons baking soda",
    "1 teaspoon ground cinnamon",
    "0.75 teaspoon salt",
    "0.33333334326744 cup vegetable oil",
    "1 egg, beaten",
    "0.33333334326744 cup boiling water",
    "Filling:",
    "2.5 cups confectioners' sugar",
    "1 (8 ounce) package cream cheese, room temperature",
    "0.25 cup butter, room temperature",
    "2 teaspoons heavy whipping cream, or as needed",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line a baking sheet with parchment paper or a silicone baking mat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, white sugar, molasses, ginger, baking soda, cinnamon, and salt together in a large bowl. Mix in vegetable oil and egg until combined. Pour in boiling water and whisk until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough in balls onto prepared baking sheet, about 1 inch apart, using a 1-ounce cookie scoop.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden, about 12 minutes. Allow to cool on the pan for about 5 minutes before transferring onto a rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat confectioners' sugar, cream cheese, butter, cream, and vanilla extract in the bowl of a stand mixer on low until combined. Increase speed to high and beat until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread about 2 teaspoons of filling onto the bottom of a cookie; top with another similarly sized cookie. Repeat with remaining cookies. Chill for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
