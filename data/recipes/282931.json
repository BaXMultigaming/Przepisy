  "ingredients": [
    "4 tablespoons salted butter",
    "3 large eggs",
    "1 cup almond flour",
    "1 teaspoon baking powder",
    "1 pinch ground nutmeg",
    "salt to taste",
    "1 cup almond milk",
    "2 (10 ounce) packages frozen chopped spinach, thawed and drained",
    "1 (16 ounce) package shredded Monterey Jack cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Melt butter in a 9x13-inch baking pan in oven while preheating.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a medium bowl. Combine flour, baking powder, nutmeg, and salt in another bowl; add to eggs, alternating with almond milk. Stir in spinach and Monterey Jack cheese; pour into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cool before cutting into 10 squares, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
