  "ingredients": [
    "1 tablespoon ground flax meal",
    "3 tablespoons water",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 teaspoon ground anise seeds",
    "0.5 cup almond butter",
    "0.33333334326744 cup brown sugar",
    "2 teaspoons anise extract",
    "2 tablespoons confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix ground flax and water in a bowl; let sit until thickened, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder, and ground anise seeds in a bowl; mix until well combined. Add flax mixture, almond butter, brown sugar, and anise extract; mix well until a soft dough forms. Shape into 2-inch balls and place on the prepared baking sheets. Flatten balls lightly with your hand.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bottom is lightly golden, 20 to 25 minutes. Dust with confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
