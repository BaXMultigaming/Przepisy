  "ingredients": [
    "4 cups Mission figs, stemmed",
    "2 cups honey",
    "1 cup water",
    "0.25 cup butter",
    "3 tablespoons lemon juice",
    "2 teaspoons ground cinnamon",
    "1.5 teaspoons vanilla extract",
    "1 teaspoon ground cloves",
    "1 teaspoon salt",
    "0.5 teaspoon grated fresh ginger",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Combine figs, honey, water, butter, lemon juice, cinnamon, vanilla extract, cloves, salt, and ginger in a pot; bring to a boil. Reduce heat; simmer until figs are soft, about 1 hour and 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Purée fig mixture with an immersion blender until jam reaches desired consistency; stir in walnuts. Continue cooking until flavors meld, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour jam into a container. Store in the refrigerator for up to one month.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
