  "ingredients": [
    "2 cloves garlic, minced",
    "4 anchovy fillets, chopped",
    "6 tablespoons butter, softened",
    "1 (8 ounce) package cream cheese, softened",
    "0.75 cup crumbled feta cheese",
    "0.25 cup sour cream",
    "1 tablespoon chopped fresh chives",
    "1 dash hot pepper sauce (e.g. Tabasco™), or to taste",
    "freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine the garlic, anchovies, butter, cream cheese, feta cheese, sour cream, chives, hot pepper sauce and pepper in the container of a food processor. Process until smooth. Transfer to a serving bowl, and serve with crackers, bread slices, or pita chips.",
