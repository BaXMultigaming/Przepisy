  ],
  "ingredients": [
    "1.5 pounds fresh strawberries",
    "1 cup white sugar",
    "1.5 teaspoons fresh lemon juice",
    "1 teaspoon vanilla bean paste",
    "3 tablespoons instant pectin"
  ],
  "steps": [
    {
      "text": "Wash, hull, and coarsely chop strawberries; transfer to a bowl. Mash with a potato masher until mostly smooth, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, lemon juice, and vanilla bean paste into strawberries; set aside until berries release some of their juice, about 30 minutes. Stir in pectin, 1 tablespoon at a time, stirring after each addition until well combined. Set aside to activate pectin, 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon jam into sterilized, wide-mouth, half-pint jars, leaving ½-inch headspace. Wipe the rims with a moist paper towel to remove any residue; loosely cover with clean lids. Freeze completely, about 5 hours. Tighten lids.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Store in the freezer for up to 1 year or in the refrigerator up to 1 month.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
