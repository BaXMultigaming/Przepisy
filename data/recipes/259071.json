  "ingredients": [
    "2 (13.5 ounce) cans coconut milk",
    "2.25 cups white sugar",
    "1.5 teaspoons vanilla extract",
    "0.5 teaspoon salt",
    "1 cup cornstarch",
    "0.75 cup water",
    "1 pinch ground cinnamon"
  ],
  "steps": [
    {
      "text": "Combine coconut milk, sugar, vanilla extract, and salt in a saucepan. Bring to a boil and cook for 6 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cornstarch and water in a bowl. Whisk until mixture has a uniform consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cornstarch-water mixture into the saucepan and whisk until mixture thickens into a pudding, about 2 minutes. Remove from heat and strain the mixture into a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the strained mixture into a mold, pan, or individual serving glasses. Smooth out the surface and allow to cool about 15 minutes. Refrigerate for at least 2 hours. Sprinkle with ground cinnamon before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
