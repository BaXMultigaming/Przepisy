  "ingredients": [
    "1.5 pounds sweet potatoes, peeled and chopped",
    "2 tablespoons soft, non-hydrogenated margarine",
    "0.25 teaspoon fresh ground pepper",
    "2 teaspoons Spectrum® Canola Oil",
    "1 (340 gram) package Yves Veggie Cuisine® Original Veggie Ground Round",
    "1 green pepper, chopped",
    "2 cloves garlic, minced",
    "1 tablespoon all-purpose flour",
    "1 cup Imagine® Low Sodium Organic Vegetable Broth",
    "1 cup combined, Yves Veggie Cuisine® sweet peas, Yves Veggie Cuisine® whole kernel Golden Corn and carrots"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In pot of boiling water, cook potatoes for about 15 minutes or until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain well and return to pot. Add margarine and half of the fresh ground pepper and mash until smooth; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a non-stick skillet, heat oil over medium heat. Cook ground round, green pepper and garlic, stirring for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour and cook, stirring, for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add stock to skillet; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add peas, corn, carrots, and remaining ground pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread mixture into 8-inch (2 L) square baking dish. Spread mashed potato over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for about 15 minutes or until bubbly around edges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
