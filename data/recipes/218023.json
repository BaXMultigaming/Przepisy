  "ingredients": [
    "5 cups fresh blackberries",
    "1 cup white sugar",
    "0.25 cup cold water",
    "2 tablespoons cornstarch",
    "1 cup all-purpose flour",
    "0.5 cup white sugar",
    "1 teaspoon baking powder",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.5 cup cold butter",
    "0.5 cup pecans, chopped",
    "0.5 cup rolled oats",
    "0.25 cup brown sugar",
    "0.33333334326744 cup hot water"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the blackberries in a large saucepan with 1 cup of sugar. Dissolve the cornstarch in the cold water, and stir into the berries. Bring to a simmer over medium-high heat, and cook until bubbly and thickened, 3 to 5 minutes. Pour the blackberries into a 9x13-inch baking dish; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk the flour with 1/2 cup sugar, baking powder, cinnamon, and salt in a mixing bowl. With a pastry cutter, cut in the cold butter until crumbly. Stir in the pecans, oats, and brown sugar until evenly blended. Stir in the hot water until evenly moistened. Drop the batter over the blackberries by the spoonful.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the top is golden brown and the berries are bubbly, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
