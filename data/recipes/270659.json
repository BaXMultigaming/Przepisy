  "ingredients": [
    "Cooking spray",
    "1 avocado, halved and pitted",
    "2 eggs",
    "Kosher salt and freshly cracked pepper, to taste",
    "2 slices Pure Farmland® Uncured Bacon, cooked, crumbled",
    "2 tablespoons grated Parmesan cheese",
    "1 tablespoon chopped fresh chives",
    "Smoked paprika, for garnish",
    "0.5 teaspoon Hot sauce of choice, for garnish"
  ],
  "steps": [
    {
      "text": "Preheat oven to 425 degrees F. Spray baking sheet or glass baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop about an additional 1 to 2 tablespoons out of avocados to create a well for eggs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place avocados flesh-side up on prepared baking sheet or glass pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently crack 1 egg into each avocado well, making sure to keep yolk intact. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 18 minutes, or until eggs are desired temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top with crumbled bacon, Parmesan cheese, and chopped chives. Garnish with paprika and hot sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
