  "ingredients": [
    "2 (250 g) packages PHILADELPHIA Brick Cream Cheese, softened",
    "0.5 cup sugar",
    "2 eggs",
    "12 OREO Cookies",
    "3 (1 ounce) squares BAKER'S Semi-Sweet Baking Chocolate",
    "1 cup thawed COOL WHIP Whipped Topping"
  ],
  "steps": [
    {
      "text": "Heat oven to 350 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and sugar in large bowl with mixer until well blended. Add eggs, 1 at a time, beating on low speed after each just until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 1 cookie in bottom of each of 12 paper-lined muffin cups. Fill with batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 20 minutes or until centres are almost set. Cool. Refrigerate 3 hours. Melt chocolate as directed on package; drizzle over cheesecakes. Top with COOL WHIP.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
