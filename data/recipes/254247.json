  "ingredients": [
    "1 pound ground beef",
    "1 onion, chopped",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 cup frozen corn",
    "1 tablespoon ketchup",
    "0.25 teaspoon black pepper",
    "2 cups prepared instant mashed potatoes",
    "0.75 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Cook and stir beef and onion in a large skillet over medium-high heat until beef is browned and crumbly, about 5 minutes; drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low. Stir condensed soup, corn, ketchup, and pepper into beef mixture; cook until heated through, about 2 minutes. Divide beef mixture into four 4-inch round baking pans; spread prepared mashed potatoes over beef mixture. Place the pans on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until potatoes are lightly browned, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set the oven rack about 6 inches from the heat source and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle cheese evenly over pies.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook under the preheated broiler until cheese is melted, about 2 minutes. Allow to cool for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
