  "ingredients": [
    "2 (12 ounce) packages cranberries",
    "0.75 cup brown sugar",
    "1 orange, zested and juiced",
    "1 cinnamon stick, broken in half"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
