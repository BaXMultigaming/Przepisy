  "ingredients": [
    "1 cup butter, softened",
    "0.5 teaspoon vanilla extract",
    "2 cups all-purpose flour",
    "8 tablespoons confectioners' sugar",
    "2 cups chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (180 degrees C). Line baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter with an electric mixer in a large bowl. Mix in vanilla, then gradually mix in flour and confectioners' sugar until incorporated. Mix in walnuts. Roll dough into small balls and place onto the prepared baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10-12 minutes. Remove from the oven and let cool completely, 20 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll cooled cookies in additional confectioners' sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
