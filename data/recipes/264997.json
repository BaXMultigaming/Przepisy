  "ingredients": [
    "4 pounds frozen chicken wings",
    "1 tablespoon paprika",
    "1 teaspoon chili powder",
    "1 teaspoon onion powder",
    "0.25 teaspoon cayenne pepper",
    "0.125 teaspoon salt",
    "0.125 teaspoon ground black pepper",
    "hickory wood chips, soaked",
    "1 (18 ounce) bottle barbecue sauce, or as needed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a rimmed baking sheet with parchment paper; place frozen chicken wings on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, mix paprika, chili powder, onion powder, cayenne pepper, salt, and black pepper together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Coat baked chicken wings with spice mixture. Place wings, unstacked, onto wire racks; place racks into the smoker with the hickory wood chips. Add wood chips according to the manufacturer's directions. Smoke until wings are no longer pink at the bone and the juices run clear, about 1 hour. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer smoked wings to a large bowl and toss with barbecue sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
