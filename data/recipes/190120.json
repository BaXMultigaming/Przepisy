  "ingredients": [
    "2 (6 ounce) cans sliced black olives, drained",
    "3 tablespoons capers",
    "0.5 cup minced onion",
    "1 clove garlic, minced",
    "2 tablespoons chopped fresh parsley",
    "0.25 cup grated Parmesan cheese",
    "2 tablespoons olive oil",
    "2 tablespoons balsamic vinegar",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.25 cup chopped red bell pepper"
  ],
  "steps": [
    {
      "text": "Place the olives in a food processor or blender; pulse the olives until slightly chopped; remove to a bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the capers, onion, garlic, parsley, Parmesan cheese, olive oil, balsamic vinegar, salt, black pepper, and about half of the red bell pepper in the food processor or blender; blend until finely chopped. Add to the olives and mix. Sprinkle remaining red pepper over the mixture.",
      "section": null,
