  "ingredients": [
    "0.25 cup soy sauce",
    "2 tablespoons water",
    "1 tablespoon sweet rice wine",
    "2 tablespoons white sugar",
    "2.5 teaspoons brown sugar",
    "1 clove garlic, minced",
    "0.75 teaspoon minced fresh ginger root",
    "0.75 teaspoon cornstarch",
    "1 pound baby carrots",
    "1 tablespoon toasted sesame seeds, or to taste"
  ],
  "steps": [
    {
      "text": "Whisk together soy sauce, water, rice wine, white sugar, brown sugar, garlic, ginger, and cornstarch in a multi-functional pressure cooker (such as Instant Pot). Add carrots and toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Close and lock the lid. Turn on Instant Pot and select high pressure according to manufacturer's instructions. Set timer for 2 minutes. Allow about 10 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Serve carrots sprinkled with toasted sesame seeds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
