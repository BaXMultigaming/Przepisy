  "ingredients": [
    "3 turkey drumsticks",
    "3 quarts water",
    "2 large onions, chopped",
    "4 carrots, chopped",
    "3 stalks celery, chopped",
    "4 cloves garlic, chopped",
    "1 tablespoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon ground dried sage",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon dried rosemary",
    "0.5 teaspoon celery salt",
    "2 cups uncooked egg noodles"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IjGz8F6SAUzazNKly289vx4FBaQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216109-old-mans-turkey-noodle-soup-VAT-step-01-c63608b0f4544d1ab6d9304df0633d39.jpg"
      ],
      "image": "assets/images/216109/step_01.webp"
    },
    {
      "text": "Place turkey drumsticks and water in a large soup pot and bring to a boil. Stir in onions, carrots, celery, garlic, salt, black pepper, sage, thyme, rosemary, and celery salt; reduce heat to a simmer. Cook until turkey meat is very tender, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/p4Y5wKjO7s_vXpfNv9zsEh7qgp4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216109-old-mans-turkey-noodle-soup-VAT-step-02-6652b983d13f4cef906ece71590e8c1d.jpg"
      ],
      "image": "assets/images/216109/step_02.webp"
    },
    {
      "text": "Remove drumsticks and allow to cool enough to handle. Remove meat from bones and tendons, chop meat, and return to soup. Discard bones.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/F7Xnv7VdwOulJ7x7k5w0xjrFyXY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216109-old-mans-turkey-noodle-soup-VAT-step-03-1393b1e4b8ba467da2c46e35973f639a.jpg"
      ],
      "image": "assets/images/216109/step_03.webp"
    },
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook egg noodles in boiling water until tender yet firm to the bite, about 5 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-5rXsqelJQKtIsom8S_slwGeQ9w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/216109-old-mans-turkey-noodle-soup-VAT-step-04-02a8efa0a4014701a1aae245ded13252.jpg"
      ],
      "image": "assets/images/216109/step_04.webp"
    },
    {
      "text": "Divide noodles among soup bowls and ladle turkey soup on top.",
