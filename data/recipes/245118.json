  "ingredients": [
    "2.5 cups all-purpose flour, divided",
    "1 tablespoon baking powder",
    "1 teaspoon white sugar",
    "0.25 cup shortening",
    "0.5 white chocolate, chopped",
    "0.33333334326744 cup blueberries",
    "0.5 teaspoon grated orange zest",
    "0.5 cup milk"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place 2 cups flour, baking powder, and sugar in the bowl of a food processor or blender; pulse a few times to combine. Add shortening; pulse until mixture has the consistency of fine crumbs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place flour mixture in a bowl; stir in white chocolate, blueberries, and orange zest. Stir milk into flour mixture gradually to form a smooth batter. Turn mixture out onto a floured board; sprinkle with remaining 1/2 cup flour. Knead a few times to incorporate flour and form a smooth dough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough out 1/2-inch thick; cut scones with a biscuit cutter to desired size. Place scones on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
