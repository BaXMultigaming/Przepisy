  "ingredients": [
    "0.5 cup butter, softened",
    "0.5 cup packed brown sugar",
    "0.25 cup white sugar",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 egg",
    "1.5 teaspoons vanilla extract",
    "1.3333333730698 cups all-purpose flour",
    "1 cup miniature semisweet chocolate chips",
    "0.33333334326744 cup finely chopped pecans, toasted"
  ],
  "steps": [
    {
      "text": "Cut a piece of parchment paper to fit an air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter in a large bowl with an electric mixer on medium to high speed for 30 seconds. Add brown sugar, white sugar, baking soda, and salt; beat on medium speed for 2 minutes, scraping bowl occasionally. Beat in egg and vanilla extract until combined. Add flour, beating in as much as you can. Stir in any remaining flour, chocolate chips, and pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop dough by teaspoonfuls 1 inch apart onto the parchment paper. Carefully transfer the parchment paper to the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn the air fryer to 300 degrees F (150 degrees C) and cook until golden brown and set, about 8 minutes. Remove parchment paper to a wire rack to cool. Repeat with remaining cookie dough.",
      "section": null,
      "name": null,
      "url": null,
