  "ingredients": [
    "3 tablespoons olive oil, divided",
    "1 onion, minced",
    "4 cloves garlic, minced",
    "1 tablespoon Italian seasoning",
    "1 pound medium ground beef",
    "1 pound lean ground pork",
    "2 eggs, beaten",
    "1 cup bread crumbs",
    "1 cup freshly grated Parmesan cheese",
    "1 cup milk",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Drizzle a large baking sheet with about 2 tablespoons olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat remaining olive oil in a small saute pan over medium heat. Cook and stir onion in the hot oil until translucent, 5 to 7 minutes. Add garlic and Italian seasoning; continue to saute until garlic is softened, 2 to 3 minutes. Remove from heat and allow to cool enough to handle.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine beef, pork, bread crumbs, Parmesan cheese, milk, onion mixture, salt, and pepper in a large bowl. Mix together using your hands as quickly as possible as overmixing can produce a tough meatball.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form 1 1/2-inch meatballs and place on the prepared sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until browned and no longer pink in the centers, about 30 minutes, turning them over after 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
