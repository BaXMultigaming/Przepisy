  "steps": [
    {
      "text": "Coat a large skillet with cooking spray. Add pork chops; brown over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flip chops; add onions. Layer sliced potatoes on top of chops; sprinkle with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine soup, water, and milk in a large glass measuring cup; pour into skillet. Add more water or milk to cover potatoes.",
