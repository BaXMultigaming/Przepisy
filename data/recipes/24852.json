  "ingredients": [
    "6 boneless pork chops",
    "1 large onion, chopped",
    "5 potatoes, peeled and sliced",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "0.5 (10.75 ounce) can water",
    "0.5 (10.75 ounce) can milk",
    "salt and pepper to taste"
