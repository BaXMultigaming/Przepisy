  "ingredients": [
    "cooking spray",
    "5 eggs, beaten",
    "2 Roma tomatoes, chopped and drained",
    "4 slices cooked bacon, crumbled",
    "1 tablespoon whipped cream cheese",
    "0.5 teaspoon dried parsley",
    "salt and ground black pepper to taste",
    "2 teaspoons basil pesto",
    "1 (14 ounce) package pre-baked pizza crust",
    "1 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray a medium skillet with cooking spray; warm over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs, tomato, bacon, cream cheese, parsley, salt, and pepper together in a bowl. Pour into the skillet; cook and stir until eggs are set, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread pesto evenly over pizza crust and layer on the egg mixture. Sprinkle Cheddar cheese on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and pizza is hot, 10 to 15 minutes. Cut and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
