  "ingredients": [
    "4 skinless, boneless chicken breasts",
    "0.25 cup soy sauce",
    "1 pinch garlic powder",
    "0.25 teaspoon dried sage",
    "3 green bell pepper, minced",
    "1 onion, chopped",
    "2 carrots, sliced thin",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Heat oil in a wok or large skillet over medium-high heat. Add chicken; cook and stir until browned.",
