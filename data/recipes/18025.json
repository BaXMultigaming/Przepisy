  "ingredients": [
    "2 cups pumpkin puree",
    "1.5 cups milk",
    "0.75 cup white sugar",
    "0.5 cup biscuit baking mix",
    "2 tablespoons butter, melted",
    "2 eggs, beaten",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground cloves",
    "1 teaspoon ground allspice",
    "2 teaspoons vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9 inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium mixing bowl, combine pumpkin, milk, sugar, baking mix, melted butter, eggs, allspice, cinnamon, cloves, and vanilla extract. Beat on medium speed 2 minutes, until mixture is smooth. Pour mixture into pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven for 50 to 55 minutes, until set in center. Allow to cool before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
