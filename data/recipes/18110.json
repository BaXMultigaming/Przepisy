  "ingredients": [
    "1 (1 ounce) package ranch dressing mix",
    "1 teaspoon garlic powder",
    "0.5 teaspoon dried dill weed",
    "0.5 cup vegetable oil",
    "1 (12 ounce) package oyster crackers"
  ],
  "steps": [
    {
      "text": "Mix together ranch dressing mix, garlic powder, dill and vegetable oil. Add crackers and mix gently until the crackers are coated with the mixture. Stir every 10 minutes for 1 hour. Store in an airtight jar.",
