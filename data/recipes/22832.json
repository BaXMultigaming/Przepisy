  "title": "Orange Juice Chicken",
  "description": "Chicken baked with an orange juice/mustard/brown sugar mixture which is then transformed into a light, tangy orange sauce.",
  "authors": [
    "Sherrie M"
  ],
  "date_published": "2000-10-12T12:29:54-04:00",
