  "steps": [
    {
      "text": "Combine mayonnaise, sour cream, and buttermilk in a large bowl. Stir in parsley, chives, dill, tarragon, garlic powder, onion powder, black pepper, cayenne pepper, salt, and Worcestershire sauce until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate for 4 hours to overnight. Season with salt and black pepper to taste.",
