  "ingredients": [
    "2 cups all-purpose flour",
    "0.33333334326744 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon lemon zest",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1 cup lemon yogurt",
    "0.25 cup melted butter",
    "1 large egg",
    "1 cup fresh blueberries",
    "0.5 cup confectioners' sugar",
    "1 tablespoon lemon juice",
    "0.5 teaspoon lemon zest"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, sugar, baking powder, 1 teaspoon lemon zest, baking soda, and salt in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together lemon yogurt, butter, and egg in a separate bowl. Stir yogurt mixture into flour mixture until just moistened. Fold blueberries into mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop batter by heaping tablespoons 2 inches apart on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir together confectioners' sugar, lemon juice, and 1/2 teaspoon lemon zest in a small bowl until glaze is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle glaze over warm scones and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
