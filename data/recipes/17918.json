  "ingredients": [
    "2.75 cups all-purpose flour",
    "1 tablespoon active dry yeast",
    "1 teaspoon salt",
    "1 teaspoon white sugar",
    "1 teaspoon garlic powder",
    "1 teaspoon dried oregano",
    "1 teaspoon dried thyme",
    "0.5 teaspoon dried basil",
    "1 pinch ground black pepper",
    "1 cup water",
    "1 tablespoon vegetable oil",
    "2 tablespoons olive oil",
    "1 cup mozzarella",
    "1 tablespoon grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Combine flour, yeast, salt, sugar, garlic powder, oregano, thyme, basil, and black pepper in a large bowl. Add water and vegetable oil, then mix until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UOBocVqle2PEyMXSYh07dpIKJfg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17918-focaccia-bread-ddmfs-step-2-41-951a475306cf4a3792573b9371351252.jpg"
      ],
      "image": "assets/images/17918/step_01.webp"
    },
    {
      "text": "Turn dough out onto a lightly floured surface and knead until smooth and elastic.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kq4bKHPmxKYGJwRrS5a3JCqZpVE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17918-focaccia-bread-ddmfs-step-3-43-dfb606143212433f8aa9ca50fd320eb7.jpg"
      ],
      "image": "assets/images/17918/step_02.webp"
    },
    {
      "text": "Lightly oil a large bowl; place the dough in the bowl and turn to coat with oil. Cover with a clean, damp cloth and let rise in a warm place for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/wAJprhTdYjsImrsPqZHItMfasUo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17918-focaccia-bread-ddmfs-step-5-03-6621e0bb8470477fa579416d9f9c238a.jpg"
      ],
      "image": "assets/images/17918/step_03.webp"
    },
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Lightly grease a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Punch dough down and place on prepared baking sheet. Pat into a 1/2 inch thick rectangle. Brush top with olive oil and sprinkle with mozzarella and Parmesan cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0nm0J6oHTrRYrJJpYkrkwZg8L4U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17918-focaccia-bread-ddmfs-step-7-85-14469ab76f5144699f435bd39e7e9f67.jpg"
      ],
      "image": "assets/images/17918/step_05.webp"
    },
    {
      "text": "Bake in the preheated until golden brown, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut into 12 pieces and serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PbZXnIA5pH0nPbJQvlO4XN4TyJg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/17918-focaccia-bread-DDMFS-4x3-6fd208e7c12b493fbfde9c643df714be.jpg"
