  "ingredients": [
    "1 medium baking potato",
    "1 teaspoon olive oil",
    "0.5 teaspoon salt",
    "2 teaspoons butter",
    "1 pinch freshly ground black pepper",
    "0.25 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Scrub the potato, and pierce the skin several times with a knife or fork. Rub the skin with olive oil, then with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the potato in the preheated oven, and bake until slightly soft and golden brown, about 90 minutes. You'll know the baked potato is done when you can stick a fork in the potato and it easily pierces through the skin. If the potato is still hard in the middle, keep baking it for a little longer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Slice the potato down the center, and serve with butter and black pepper. Sprinkle shredded Cheddar cheese over the top, if desired.",
      "section": null,
      "name": null,
      "url": null,
