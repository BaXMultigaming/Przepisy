  "ingredients": [
    "2 tablespoons vegetable oil",
    "1 small onion, minced",
    "1 pound chicken hearts, quartered lenghtwise",
    "0.5 pound button mushrooms, quartered or sliced",
    "salt and freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Cook and stir onion in hot oil until soft and translucent, 4 to 6 minutes. Add chicken hearts and cook, stirring constantly, until browned, about 3 minutes. Cover the skillet, reduce heat, and cook until hearts are no longer pink in the center, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add mushrooms and mix well. Cook, covered, for 5 more minutes. Season with salt and pepper.",
      "section": null,
