  "ingredients": [
    "2.5 cups all-purpose flour",
    "0.5 teaspoon salt",
    "1.25 cups confectioners' sugar",
    "1 cup butter, softened",
    "2 egg yolks",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Sift flour and salt together; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/j6hXrd6CC2X29Y5w2lfuVkqoAXE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25018-butter-rich-spritz-butter-cookies-VAT-step-02-b77edef6e90c4754b91ee2555a44db9b.jpg"
      ],
      "image": "assets/images/25018/step_01.webp"
    },
    {
      "text": "Beat confectioners' sugar and butter together in a medium bowl with an electric mixer until light and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/RYA7DvKkEOWNiASuJ27BerZAuLw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25018-butter-rich-spritz-butter-cookies-VAT-step-03-418744a91fe94a87b386a417e059a828.jpg"
      ],
      "image": "assets/images/25018/step_02.webp"
    },
    {
      "text": "Stir in egg yolks, vanilla extract, and almond extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Nc1JyrWzX4HKea2Qi_s4GCrtaqw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25018-butter-rich-spritz-butter-cookies-VAT-step-04-2-61a8050d9fe242f29a43d6bab9ddd329.jpg"
      ],
      "image": "assets/images/25018/step_03.webp"
    },
    {
      "text": "Gradually blend in sifted flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_bA3k5wcIVeKnDzN9obOddazuXg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25018-butter-rich-spritz-butter-cookies-VAT-step-05-2-f043f05e6b0c4a63bb529e1c165a3c6a.jpg"
      ],
      "image": "assets/images/25018/step_04.webp"
    },
    {
      "text": "Fill a cookie press with dough; press cookies about 1 ½ inches apart onto an ungreased cookie sheet. Decorate with colored sugar or sprinkles, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2GtWbCr8RnuWdXunOw4_9-wuzVc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-25018-butter-rich-spritz-butter-cookies-VAT-step-06-1-55864359a48549218fcdf65061e27125.jpg"
      ],
      "image": "assets/images/25018/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until edges are just set and bottoms are light golden, 6 to 8 minutes. Let cool on the baking sheet briefly before transferring to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
