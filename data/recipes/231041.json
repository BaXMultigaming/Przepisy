  "ingredients": [
    "0.25 cup olive oil",
    "0.25 cup lime juice",
    "1 tablespoon minced garlic",
    "salt and ground black pepper to taste",
    "2 skinless, boneless chicken breast halves"
  ],
  "steps": [
    {
      "text": "Mix olive oil, lime juice, garlic, salt, and black pepper in a bowl or resealable bag; add chicken. Marinate in the refrigerator, 3 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer chicken from marinade to a shallow baking pan. Discard remaining marinade. Season chicken breasts with salt and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until no longer pink in the center and the juices run clear, 25 to 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
