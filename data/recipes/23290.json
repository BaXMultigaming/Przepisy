  "ingredients": [
    "1 (.25 ounce) package active dry yeast",
    "2 teaspoons white sugar",
    "1 cup warm water (110 degrees F/45 degrees C)",
    "2 cups bread flour, plus more for dusting",
    "1 teaspoon salt",
    "2 tablespoons olive oil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir yeast, sugar, and warm water together in a small bowl. Let stand until foamy, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I-W4TT_ExxFP34xJsojy-RrcQZw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23290-pizza-dough-iii-VAT-step-01-70da45eef7734b0aaa7f0c513fad3587.jpg"
      ],
      "image": "assets/images/23290/step_02.webp"
    },
    {
      "text": "Stir 2 cups of bread flour and salt together in the bowl of a stand mixer. Add yeast mixture and 2 tablespoons of olive oil; beat with dough hook on medium speed until dough is soft and slightly tacky, about 8 minutes, adding up to 3 tablespoons more flour, 1 tablespoon at a time, mixing after each addition.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ATqBGMkkUXmibMenJTybAjnkoLs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23290-pizza-dough-iii-VAT-step-02-90200b2d6de64a04aa8332596198e492.jpg"
      ],
      "image": "assets/images/23290/step_03.webp"
    },
    {
      "text": "Cover and let rise at room temperature until doubled in volume, at least 1 hour or up to 2 hours. (Alternatively, cover and let rise in the refrigerator overnight.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kD8m1LR7Aa6PBAna3YfKikpyp_w=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23290-pizza-dough-iii-VAT-step-03-db9b3b10f29646d4b1dc795e29d4c4ec.jpg"
      ],
      "image": "assets/images/23290/step_04.webp"
    },
    {
      "text": "Preheat the oven to 475 degrees F (245 degrees C) with oven rack positioned in lower third. Turn dough out onto a lightly floured work surface. Shape into a round and roll into a thin crust. Place on a large parchment-lined baking sheet or pizza pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Y-6rXDjwBijzbBFm4U2vJlEMORU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23290-pizza-dough-iii-VAT-step-04-e384ffd801244f918fdb32588a8d1940.jpg"
      ],
      "image": "assets/images/23290/step_05.webp"
    },
    {
      "text": "Top with desired pizza sauce and toppings. Brush edges with remaining 1 tablespoon oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3mFm6V8B-zIL_9lSkSTeDLlMgSQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23290-pizza-dough-iii-VAT-step-05-58146fd3dc3148c0b825c7268c8be87d.jpg"
      ],
      "image": "assets/images/23290/step_06.webp"
    },
    {
      "text": "Bake in preheated oven until crust is golden and cheese is melted bubbly, about 12 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rhJO6JeW5Bzu_NkA6cmXPVLkidQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23290-pizza-dough-iii-VAT-step-06-e6d3a17e4b434f55a7c1ee3fa3e33e38.jpg"
      ],
      "image": "assets/images/23290/step_07.webp"
    },
    {
      "text": "Serve and enjoy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/kgZB2WpV5NUBsd0XPOkcOOV9SEY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/23290-pizza-dough-iii-VAT-Beauty-4x3-06192801c8fa48fe8afaadfea28f532b.jpg"
      ],
      "image": "assets/images/23290/step_08.webp"
    }
