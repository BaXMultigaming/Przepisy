  "keywords": [],
  "ingredients": [
    "2 pounds pork neck bones",
    "2 teaspoons kosher salt, plus more to taste",
    "1 teaspoon ground black pepper",
    "2 tablespoons olive oil, divided",
    "1.25 pounds Italian sausage links",
    "1.5 cups finely chopped white onion",
    "2 cloves garlic, minced",
    "2 (12 ounce) cans tomato paste",
    "1 (28 ounce) can tomato puree",
    "1 (28 ounce) can crushed tomatoes",
    "7 cups water",
    "1 tablespoon white sugar, or more to taste",
    "1 bay leaf",
    "1 tablespoon dried basil",
    "0.5 teaspoon dried oregano",
    "12 large cooked meatballs"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YkUILafjpRWTB0JC6pG544CMgj0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8309691-italian-sunday-sauce-VAT-step-01-f5415f9d9ca4462dae9950c06d7a7854.jpg"
      ],
      "image": "assets/images/8309691/step_01.webp"
    },
    {
      "text": "Sprinkle neck bones on all sides with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FSkza1Ikb1nsLUdWUASVXpSqAXA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8309691-italian-sunday-sauce-VAT-step-02-cd01ec809fa1430ea5c4171c7667aaad.jpg"
      ],
      "image": "assets/images/8309691/step_02.webp"
    },
    {
      "text": "Heat 4 teaspoons oil in a large, heavy-bottomed stockpot or Dutch oven over medium-high heat. Place neck bones in the pot and cook for 6 minutes, flipping halfway through. Transfer to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/D2uPXJA9wnz3gmGB9PED2AlvRP0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8309691-italian-sunday-sauce-VAT-step-03-52d71de96e53400db36bd9655786475c.jpg"
      ],
      "image": "assets/images/8309691/step_03.webp"
    },
    {
      "text": "Add sausage links to the drippings and brown for 3 minutes on each side, adding remaining oil as needed. Set aside with the pork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yUczXj8XAwa8vrj5p-946yT7d1s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8309691-italian-sunday-sauce-VAT-step-04-14d3fb5d1e0a4a5ba4dc353fa9fd35d7.jpg"
      ],
      "image": "assets/images/8309691/step_04.webp"
    },
    {
      "text": "Add onion to the drippings and season with salt. Cook, stirring often, until onion is soft and translucent, about 5 minutes. Add garlic and cook until fragrant, about 1 minute. Stir in tomato paste and cook for 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/YQi4T1w9AEZx_YMtFebSbaquzG8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8309691-italian-sunday-sauce-VAT-step-05-59d3b4fd84ba48d78004cf3835bc4384.jpg"
      ],
      "image": "assets/images/8309691/step_05.webp"
    },
    {
      "text": "Add tomato puree and crushed tomatoes, than add water and sugar; cook, stirring constantly, until smooth. Add bay leaf. Rub basil and oregano between your fingers to release the aroma and add to the sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/suKWNc7qNHNOxq8lx9wVfltUlbc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8309691-italian-sunday-sauce-VAT-step-06-e69356bda2bb49c3b3a9290618179bb3.jpg"
      ],
      "image": "assets/images/8309691/step_06.webp"
    },
    {
      "text": "Slice sausages into large chunks and return to the pot with the neck bones; bring to a simmer, stirring occasionally. Add meatballs, reduce heat to low, and simmer, stirring occasionally, for 4 to 6 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qjL9QJj8brLusLjYquI8cZBFrEQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8309691-italian-sunday-sauce-VAT-step-07-319763861a8c4b7ca6d7358ce60b042e.jpg"
      ],
      "image": "assets/images/8309691/step_07.webp"
    },
    {
      "text": "Remove neck bones and bay leaf. Remove any meat remaining on the bones, shred, and return to the sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ko1w5IEnxXQXFYg4tgMpV30sTIs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8309691-italian-sunday-sauce-VAT-step-08-28a7914e12fb48c8aa246611944bfc74.jpg"
      ],
      "image": "assets/images/8309691/step_08.webp"
    },
    {
      "text": "Serve and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OikZ5cv7kCzrZeBfMmllhpePrkU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/8309691-italian-sunday-sauce-VAT-Beauty-4x3-b0c4f030b961412f8a3702c826df7ffd.jpg"
      ],
      "image": "assets/images/8309691/step_09.webp"
    }
  ],
