  "ingredients": [
    "4 ears frozen corn on the cob",
    "2 teaspoons butter",
    "2 teaspoons garlic powder",
    "4 teaspoons minced garlic",
    "salt and ground black pepper to taste",
    "1 cup chopped whole kernel corn"
