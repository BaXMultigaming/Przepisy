  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "0.5 medium head cabbage, chopped",
    "4 large carrots, cubed",
    "1 sweet onion, minced",
    "4 stalks celery, cubed",
    "0.75 cup ketchup",
    "1.5 cups tomato-vegetable juice cocktail",
    "3 cups vegetable broth",
    "1 (14.5 ounce) can chicken broth",
    "1 (14.5 ounce) can peeled and diced tomatoes"
  ],
  "steps": [
    {
      "text": "Place chopped cabbage into an 8-quart soup pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave diced carrot in 2 tablespoons water for 6 minutes on high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave diced celery in 2 tablespoons water for 4 minutes on high.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add the microwaved vegetables to the pot. Add minced sweet onion, celery, and ketchup. Add juice cocktail, vegetable broth, chicken broth, and tomatoes. Fill each can with water, and add the water to the mixture. Cover, and bring to a boil. Continue boiling for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to simmer and cook for 2 to 3 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve with slices of a French baguette. Have salt, black pepper, and Tabasco available to season to taste at the table.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
