  "ingredients": [
    "1 cup brown sugar",
    "1 cup all-purpose flour",
    "0.75 cup quick-cooking oats",
    "0.5 cup butter, melted",
    "1 teaspoon ground cinnamon",
    "4 cups pitted tart red cherries",
    "1 cup water",
    "1 cup white sugar",
    "2 tablespoons cornstarch",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine brown sugar, flour, oats, butter, and cinnamon in a bowl until crumbly; press ½ crust mixture into the bottom of an 8x8-inch pan. Top crust with cherries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water, white sugar, cornstarch, and vanilla extract in a saucepan over medium heat; bring to a simmer. Cook and stir until sugar dissolves and syrup is clear, about 5 minutes. Pour syrup over cherries; top with remaining crust mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is brown and filling is bubbling, 30 to 35 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
