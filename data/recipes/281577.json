  "ingredients": [
    "1 pound chicken gizzards",
    "0.33333334326744 cup all-purpose flour",
    "1.5 teaspoons seasoned salt (such as LAWRY'S®)",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon paprika",
    "1 pinch cayenne pepper",
    "1 large egg, beaten",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Bring a large pot of water to a boil. Cook gizzards in boiling water for 30 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, seasoned salt, black pepper, garlic powder, paprika, and cayenne pepper in a shallow plastic container; snap the lid on and shake until well combined. Add gizzards to seasoned flour; snap the lid back on and shake until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place beaten egg in a small bowl. Dip each gizzard in beaten egg, then return to seasoned flour. Snap the lid on and shake one last time. Let sit for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat the air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place gizzards in the air fryer basket and coat the tops with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer for 4 minutes. Shake the basket and coat with more cooking spray to cover any chalky spots. Continue cooking for 4 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
