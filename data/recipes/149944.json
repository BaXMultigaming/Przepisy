  "ingredients": [
    "4 cups white sugar",
    "0.5 cup light brown sugar",
    "3 tablespoons corn syrup",
    "2 cups water",
    "1 teaspoon imitation maple flavor",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Place the white sugar, brown sugar, corn syrup, and water in a saucepan over medium-high heat. Bring mixture to a boil, reduce heat to medium, cover pan, and simmer 8 minutes. Stir in maple extract and vanilla. Cool completely, then pour into glass jars, cover, and refrigerate.",
