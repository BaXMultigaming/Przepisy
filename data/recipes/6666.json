  "ingredients": [
    "1.5 cups white sugar",
    "0.5 cup vegetable oil",
    "2 large eggs",
    "1.75 cups sifted all-purpose flour",
    "1 teaspoon baking soda",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "0.33333331346512 cup water",
    "1 cup cooked and mashed sweet potatoes",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar and oil in a large bowl; beat well. Add eggs and beat until well combined. Combine flour, baking soda, cinnamon, nutmeg, and salt in a separate bowl. Gradually stir flour mixture into egg mixture, alternating with water. Stir in sweet potatoes and chopped nuts. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
