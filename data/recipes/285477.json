  "ingredients": [
    "1 (11 ounce) package caramels, unwrapped",
    "3 tablespoons Almond Breeze Vanilla almondmilk",
    "0.75 cup vegan buttery sticks, melted",
    "1 (18.25 ounce) package German chocolate cake mix",
    "2 tablespoons all-purpose flour",
    "0.25 cup Almond Breeze Vanilla almondmilk",
    "0.66666668653488 cup miniature semisweet chocolate chips",
    "0.75 cup chopped walnuts",
    "0.5 teaspoon coarse sea salt"
  ],
  "steps": [
    {
      "text": "Heat oven to 350 degrees F. Grease a 13x9-inch baking pan. Line bottom with parchment paper; grease paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium microwave-safe bowl, combine caramels and 3 tablespoons almondmilk. Microwave on High 1 minute; stir. Microwave 1 minute longer and stir until melted; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine melted vegan sticks, cake mix, flour and 1/4 cup almondmilk. Mix well. Spread half of mixture in bottom of pan. Bake 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle chocolate chips over partially baked bars. Drizzle with caramel; top with nuts. Drop small dollops of remaining dough over the caramel. Bake 17 to 20 minutes or until set. Sprinkle with sea salt. Cool completely, about 2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
