  "ingredients": [
    "3 tablespoons butter, or more to taste",
    "1 small head cabbage, finely chopped",
    "3 hard-boiled eggs, peeled and chopped, or more to taste",
    "3 sprigs fresh dill, finely chopped, or to taste",
    "salt to taste",
    "2 sheets yeasted puff pastry",
    "1 egg, beaten"
  ],
  "steps": [
    {
      "text": "Melt butter in a large skillet over medium-low heat. Add cabbage and cook until softened but not browned, about 30 minutes. Remove from heat and let cool, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cooled cabbage with hard-boiled eggs and dill. Season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a pie plate with 1 sheet of puff pastry. Add cabbage filling, leaving some space around the edge. Cover with the second sheet of puff pastry and pinch edges together. Glaze the top with beaten egg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
