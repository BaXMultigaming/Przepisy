  "ingredients": [
    "5 whole green onions",
    "0.5 cup chopped fresh mint leaves",
    "1 tablespoon olive oil",
    "1 tablespoon lemon juice",
    "1 pinch crushed red pepper flakes, or to taste",
    "1 (7 ounce) container Greek-style yogurt",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Grind green onions, mint, olive oil, lemon juice, and red pepper flakes in a food processor to a coarse paste; transfer to a bowl. Add yogurt, salt, and black pepper; stir with a fork until blended.",
