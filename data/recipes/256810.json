  "ingredients": [
    "1 pound ground bison",
    "0.5 cup chopped onion",
    "1 (1.25 ounce) package McCormick® Hot Chili Seasoning Mix",
    "1 (14.5 ounce) can fire-roasted diced tomatoes",
    "1 (8 ounce) package processed cheese food (such as Velveeta ®), cut into cubes",
    "0.25 cup sour cream",
    "2 tablespoons finely chopped jalapeno peppers"
  ],
  "steps": [
    {
      "text": "Brown meat and onion in large skillet on medium-high heat, about 5 minutes. Drain fat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomatoes and seasoning mix. Bring to boil. Reduce heat; cover and simmer 5 minutes, stirring occasionally. Stir in cheese. Simmer 5 minutes or until cheese is melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon into serving bowl. Top with sour cream and jalapeno. Serve with tortilla chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
