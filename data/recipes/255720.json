  "ingredients": [
    "5 Cortland apples - peeled, cored, and sliced",
    "0.75 cup all-purpose flour",
    "0.75 cup rolled oats",
    "0.5 cup packed brown sugar",
    "0.75 teaspoon ground cinnamon",
    "0.75 teaspoon ground nutmeg",
    "0.5 cup butter at room temperature, cut into cubes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Grease a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fill pie plate with apples, creating a slight mound.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, oats, brown sugar, cinnamon, and nutmeg in a large bowl. Cut in butter with a pastry blender or knife and fork until mixture is crumbly; sprinkle over apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until apples are tender and bubbling and top is lightly golden brown, 45 to 55 minutes. Cool before slicing, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
