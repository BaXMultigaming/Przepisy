  "ingredients": [
    "6 cups Cinnamon Chex® cereal",
    "2 cups pecan halves",
    "0.25 cup butter",
    "0.33333334326744 cup packed brown sugar",
    "2 tablespoons light corn syrup",
    "2 (1.2 ounce) packages freeze-dried peach slices"
  ],
  "steps": [
    {
      "text": "In large microwavable bowl, place cereal and pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In 2-cup microwavable measuring cup, microwave butter, brown sugar and corn syrup uncovered on High 1 minute 30 seconds, stirring after 1 minute, until mixture is boiling; stir. Pour over cereal mixture, stirring until evenly coated. Microwave uncovered on High 5 minutes, stirring after every minute. Toss in peaches.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread on waxed paper. Cool 5 minutes. Store loosely covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
