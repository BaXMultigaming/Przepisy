  "ingredients": [
    "6 tablespoons unsalted butter",
    "1 medium apple - peeled, cored, and diced",
    "0.33333334326744 cup chopped onion",
    "1 tablespoon white sugar",
    "1 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "1 (16 ounce) can sweet potatoes, drained",
    "2 cups soft bread crumbs"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large skillet over medium heat. Add apple and onion; cover and cook until tender, 8 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in sugar, salt, and nutmeg; push to one side of the skillet. Add drained sweet potatoes to the empty side of the skillet; mash with a fork. Add bread crumbs and mix until all ingredients are combined. Transfer to a greased casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown on top, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
