  "ingredients": [
    "12 hard-cooked eggs, divided",
    "0.25 cup low-fat mayonnaise",
    "0.25 cup chopped fresh chives",
    "1 teaspoon Dijon mustard",
    "0.5 teaspoon celery salt",
    "0.5 teaspoon ground paprika",
    "0.5 teaspoon kosher salt",
    "0.5 teaspoon freshly ground black pepper"
  ],
  "steps": [
    {
      "text": "Peel and chop 8 eggs; place in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Peel remaining 4 eggs. Cut each in half to remove yolks, reserving them for another use. Chop whites and add to the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix in mayonnaise, chives, Dijon, celery salt, paprika, kosher salt, and pepper until salad is well combined.",
      "section": null,
