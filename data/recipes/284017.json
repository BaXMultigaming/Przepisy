  "ingredients": [
    "1 pound fresh green beans, trimmed",
    "1 large red bell pepper, thinly sliced",
    "1 large mango, thinly sliced",
    "2 medium shallots, thinly sliced",
    "0.25 cup crumbled feta cheese",
    "1 small red onion, minced",
    "0.25 cup white balsamic vinegar",
    "2 tablespoons white sugar",
    "1 tablespoon whole grain mustard",
    "1 tablespoon poppy seeds",
    "0.25 cup extra-virgin olive oil",
    "salt and freshly ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Bring a large pot of salted water to a boil. Add beans and boil until color changes to bright green, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain beans completely and run under cold water or submerge in a bowl with ice-cold water to stop the cooking process. Once cooled, drain completely and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bell pepper, mango, and shallots in a large salad bowl. Add green beans and feta cheese; toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine onion, balsamic vinegar, sugar, mustard, and poppy seeds together in a bowl. Drizzle in olive oil while whisking rapidly until dressing is smooth. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle about 1/4 cup vinaigrette over the salad and mix to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
