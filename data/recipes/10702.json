  "ingredients": [
    "0.66666668653488 cup butter",
    "0.33333334326744 cup white sugar",
    "2 egg yolks",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "1.5 cups all-purpose flour",
    "2 egg whites, lightly beaten",
    "0.75 cup finely chopped walnuts",
    "0.33333334326744 cup strawberry preserves"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease cookie sheets or line them with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, cream together butter and sugar until light and fluffy. Beat in egg yolks, vanilla, and salt. Gradually mix in flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Shape dough into 3/4-inch balls. Dip in lightly beaten egg whites, then roll in finely chopped walnuts. Place 1 inch apart on the prepared cookie sheets. Press down the centers of each with your thumb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 15 to 17 minutes, or until golden brown. Cool on baking sheet for 5 minutes, then remove to a wire rack to cool completely. Just before serving, fill centers of cookies with strawberry preserves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
