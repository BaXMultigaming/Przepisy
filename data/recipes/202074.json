  "ingredients": [
    "2 cups all-purpose flour",
    "1 cup white sugar",
    "2 teaspoons baking soda",
    "1 teaspoon vanilla extract",
    "0.25 cup unsweetened cocoa powder",
    "1 cup creamy salad dressing (such as Miracle Whip®)",
    "1 cup lukewarm water"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, baking soda, vanilla extract, cocoa powder, creamy salad dressing, and water in a large bowl. Pour into the greased baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 30 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
