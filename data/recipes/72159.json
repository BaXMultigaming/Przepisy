  "ingredients": [
    "6 cups quick cooking oats",
    "0.75 cup packed brown sugar",
    "1 teaspoon salt",
    "1.5 teaspoons baking powder",
    "6 eggs",
    "2 cups milk",
    "1.5 teaspoons vanilla extract",
    "0.66666668653488 cup canola oil",
    "0.5 cup coarsely chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C). Grease and flour a 9x13 inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, stir together the oats, brown sugar, salt and baking powder. In a separate medium bowl, stir together the eggs, milk, vanilla and canola oil. Pour the wet ingredients into the dry ingredients, and stir until well blended. Spoon into the prepared baking pan, and spread evenly. Sprinkle walnuts over the top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 30 minutes in the preheated oven, or until a knife inserted into the center comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
