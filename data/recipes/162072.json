  "title": "Irish Barmbrack",
  "description": "Barmbrack or brack is a moist Irish cake made with dried mixed fruit soaked in tea that’s traditionally eaten at Halloween but delicious anytime.",
  "authors": [
    "Brooke Elizabeth"
  ],
  "date_published": "2020-06-18T23:34:49-04:00",
