  ],
  "categories": [
    "Dessert",
    "Cake"
  ],
  "cuisines": [
    "Scottish"
  ],
  "regions": [
    "Scottish"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 cup raisins",
    "1 cup dried currants",
    "0.33333334326744 cup diced candies mixed fruit peel",
    "0.33333334326744 cup candied cherries, quartered",
    "2 tablespoons grated orange zest",
    "2 cups all-purpose flour, divided",
    "1 cup butter, softened",
    "1 cup white sugar",
    "4 large eggs",
    "1 ounce ground almonds",
    "1 teaspoon baking powder",
    "0.5 cup whole almonds",
    "1 tablespoon corn syrup"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 325 degrees F (165 degrees C). Line an 8x3-inch round pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/aqcvfV23LKgsMayod62I2deLpzA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7893-dundee-cake-VAT-step-01-b8088a34af2540d4830876ceff239edf.jpg"
      ],
      "image": "assets/images/7893/step_01.webp"
    },
    {
      "text": "Combine raisins, currants, citrus peel, cherries, and orange zest in a bowl. Dredge with 1/3 cup flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mlxTtLK1dqU-isjePUbci0NW59k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7893-dundee-cake-VAT-step-02-15f0d65bf7684561a6ecc1a84d1ec388.jpg"
      ],
      "image": "assets/images/7893/step_02.webp"
    },
    {
      "text": "Cream butter and sugar together until fluffy. Beat in eggs, one at a time, until light.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/11yw6YQ06E67cgUv0vGu0NzmlvE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7893-dundee-cake-VAT-step-03-5485fa5fab234e358c90249bb18d59fe.jpg"
      ],
      "image": "assets/images/7893/step_03.webp"
    },
    {
      "text": "Combine remaining 1 2/3 cups flour, ground almonds, and baking powder in a separate bowl. Fold into butter and egg mixture. Mix in fruit.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3Xyl8TQIjXaxHOYKamz8MorrKM4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7893-dundee-cake-VAT-step-04-496cd2a143204df7a6deca5cd259af87.jpg"
      ],
      "image": "assets/images/7893/step_04.webp"
    },
    {
      "text": "Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/iU3r_5Of5v7Vf_rF-yWCVIDvaQM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7893-dundee-cake-VAT-step-05-2acc1c1204424445af22acfbe1ce8e2d.jpg"
      ],
      "image": "assets/images/7893/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a wooden pick inserted into the center of the cake comes out clean, about 1 1/2 hours. Remove cake from pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/7wQ5l2xctn72nLi-HrQBtBmwT_s=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7893-dundee-cake-VAT-step-06-4456668fb47740419be3529be4e289fd.jpg"
      ],
      "image": "assets/images/7893/step_06.webp"
    },
    {
      "text": "Turn the oven up to 350 degrees F (175 degrees C). Toast almonds in the preheated oven until lightly browned, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/2YMI0cUXYqSRtZF3rCM81dx7rTg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7893-dundee-cake-VAT-step-07-fd3131974db04438a643526c04e5774c.jpg"
      ],
      "image": "assets/images/7893/step_07.webp"
    },
    {
      "text": "Heat corn syrup and brush over the top surface of the hot cake. Place almonds in whatever design you like. After cooling, the cake will not be sticky.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/IF0UknoqzfG5dy_lfe1LRHBFu5A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-7893-dundee-cake-VAT-step-08-01-7cc187a9472c48da866589a7cda7786f.jpg"
      ],
      "image": "assets/images/7893/step_08.webp"
    }
  ],
