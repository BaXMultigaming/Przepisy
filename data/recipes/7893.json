  "title": "Dundee Cake",
  "description": "A delicious Dundee cake packed with dried fruit, candied citrus peel, and orange zest; top with whole almonds for a Scottish Christmas favorite.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-06-13T14:06:51-04:00",
