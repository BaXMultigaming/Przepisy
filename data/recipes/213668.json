  "ingredients": [
    "4 large skinless, boneless chicken breast halves",
    "1 cup ketchup",
    "0.5 cup maple syrup",
    "2 tablespoons mustard",
    "2 tablespoons Worcestershire sauce",
    "2 teaspoons lemon juice",
    "0.5 teaspoon chili powder",
    "0.25 teaspoon garlic powder",
    "0.125 teaspoon cayenne pepper",
    "2 dashes hot pepper sauce, or to taste",
    "8 sandwich rolls, split"
  ],
  "steps": [
    {
      "text": "Place chicken breasts into the bottom of a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, stir together ketchup, maple syrup, mustard, Worcestershire sauce, lemon juice, chili powder, garlic powder, cayenne pepper, and hot sauce until mixture is well blended. Pour over chicken.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 6 hours. Shred chicken with 2 forks, then cook for 30 more minutes. Serve shredded chicken and sauce spooned into sandwich rolls.",
      "section": null,
      "name": null,
      "url": null,
