  "ingredients": [
    "5 large sweet potatoes, peeled and quartered",
    "0.75 cup packed brown sugar",
    "0.66666668653488 cup whole milk",
    "2 tablespoons butter, melted",
    "0.25 cup all-purpose flour",
    "1.3300000429153 cups pecans",
    "1 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Lightly grease a medium baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Boil the sweet potatoes in a large saucepan approximately 10 minutes, or until tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, mix together the sweet potatoes, brown sugar, milk, butter and flour. Transfer the mixture to the baking dish. Sprinkle with pecans and coconut.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 30 minutes in the preheated oven.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
