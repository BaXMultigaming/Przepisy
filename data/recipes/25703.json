  "ingredients": [
    "0.75 cup butter",
    "0.5 cup diced celery",
    "0.5 cup diced carrots",
    "0.5 cup diced onion",
    "0.75 cup all-purpose flour",
    "0.5 teaspoon ground dry mustard",
    "1 (14.5 ounce) can chicken broth",
    "5 ounces shredded Cheddar cheese",
    "5 ounces shredded Monterey Jack cheese",
    "0.5 cup grated Parmesan cheese",
    "1 (12 fluid ounce) can or bottle beer"
  ],
  "steps": [
    {
      "text": "In a large saucepan over medium high heat, melt butter. Cook celery, carrots and onion in butter until onion is translucent. Stir in flour and mustard to coat vegetables. Pour in chicken broth and simmer until slightly thickened. Puree mixture in a blender or food processor or using an immersion blender. Return to pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "When pureed mixture is hot, begin to stir in Cheddar, Monterey Jack and Parmesan, a little at a time, alternately with the beer, until all is fully incorporated and melted. Serve at once.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
