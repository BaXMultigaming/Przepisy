  "ingredients": [
    "8 fresh conch, shells removed",
    "0.5 lemon, juiced",
    "2 tablespoons olive oil",
    "2 cloves garlic, minced",
    "1 medium onion, diced",
    "1 green bell pepper, chopped",
    "1 red bell pepper, chopped",
    "0.75 cup diced celery",
    "1.5 cups chopped mushrooms",
    "1 (28 ounce) can stewed tomatoes",
    "1 tablespoon Worcestershire sauce",
    "0.33333334326744 cup ketchup",
    "0.25 teaspoon white sugar",
    "1 teaspoon red pepper flakes, or to taste",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Pound the conch meat with a mallet until tender. Chop into bite-size pieces. Place in a bowl, sprinkle with lemon juice, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oil in a skillet over medium heat, and cook the garlic, onion, green bell pepper, red bell pepper, celery, and mushrooms until tender. Mix in the tomatoes, Worcestershire sauce, ketchup, and sugar. Season with red pepper, salt, and pepper. Bring to a boil. Reduce heat to low, and simmer uncovered 20 minutes, stirring occasionally.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the conch meat into the skillet, and continue to cook 10 minutes. Do not overcook, or the conch will become tough.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
