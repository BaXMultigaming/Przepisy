  "ingredients": [
    "1 (8 ounce) package cream cheese",
    "0.5 cup butter",
    "0.5 cup milk",
    "1 (16 ounce) package frozen corn",
    "8 fresh jalapeno peppers, diced",
    "1 red bell pepper, diced"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt cream cheese and butter in a saucepan over medium-low heat; stir in milk until smooth and bubbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine frozen corn, jalapeños, and bell pepper in a medium-sized casserole dish; stir in cream cheese mixture until coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbly and lightly brown, 35 to 45 minutes.",
      "section": null,
