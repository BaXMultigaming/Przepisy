  "ingredients": [
    "1 pound ground beef",
    "0.5 pound bulk pork sausage",
    "0.75 cup bread crumbs",
    "0.5 onion, diced",
    "0.5 cup milk",
    "1 egg",
    "1 tablespoon chopped fresh parsley",
    "1.5 teaspoons salt",
    "1 teaspoon Worcestershire sauce",
    "0.125 teaspoon ground black pepper",
    "1 teaspoon vegetable oil, or as needed",
    "2 cups boiling water",
    "0.75 cup sour cream",
    "0.5 cup all-purpose flour",
    "1 teaspoon paprika",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Mix beef, sausage, bread crumbs, onion, milk, egg, parsley, salt, Worcestershire sauce, and pepper in a large bowl. Form into meatballs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium-high heat. Pan-fry meatballs in batches, turning as needed, until browned and heated through, 6 to 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix boiling water, sour cream, flour, paprika, and pepper together in a deep saucepan over low heat. Add the meatballs and let simmer until thickened and heated through, 15 to 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
