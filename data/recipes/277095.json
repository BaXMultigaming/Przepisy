  "ingredients": [
    "vegetable oil for frying",
    "2 cups bread crumbs",
    "0.25 cup chopped onion",
    "0.25 cup chopped fresh cilantro",
    "2 tablespoons diced garlic",
    "2 tablespoons soy sauce",
    "1 tablespoon sambal oelek",
    "0.5 teaspoon ground ginger",
    "0.5 teaspoon paprika",
    "0.25 teaspoon ground coriander",
    "1 pound ground chicken"
  ],
  "steps": [
    {
      "text": "Heat oil in a deep-fryer or large saucepan to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix bread crumbs, onion, cilantro, garlic, soy sauce, sambal oelek, ginger, paprika, and coriander together in a large mixing bowl until well combined. Add chicken and mix well by hand, kneading it into the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form mixture into golf ball-sized meatballs, about 1 1/2 inches round. Roll in your hands to ensure meatballs are well packed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry meatballs in the hot oil, working in batches if needed, until well browned and no longer pink in the centers, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
