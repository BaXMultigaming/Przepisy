        "https://www.allrecipes.com/thmb/6vVuRuXe6WA1Z4uhd1Mlpxt1aTA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_242191_EasyRhubarbCrisp_ddmfs_Step7_3x4_5458-6d059c04bc274b6abece4ef861ccc0d3.jpg"
