  "ingredients": [
    "1 cup all-purpose flour",
    "1 cup brown sugar",
    "0.75 cup oats",
    "0.5 cup melted butter",
    "1 teaspoon ground cinnamon",
    "4 cups diced rhubarb",
    "1 cup white sugar",
    "1 cup water",
    "2 tablespoons cornstarch",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
