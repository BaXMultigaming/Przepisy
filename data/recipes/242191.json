      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/m6wys3EGQU2j6wOQI72mH-tJEpQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_242191_EasyRhubarbCrisp_ddmfs_Step5_3x4_5455-62db478dd1f04867beb3fd7a7ba929b4.jpg"
      ],
      "image": "assets/images/242191/step_05.webp"
    },
    {
      "text": "Pour sugar mixture over rhubarb.",
