      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/C0vqhfc2ZX0zNJcEiK7Y0dsbB8g=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_242191_EasyRhubarbCrisp_ddmfs_Step3_3x4_5441-d840720d08374c6ca5a5c9ab5f0addd3.jpg"
      ],
      "image": "assets/images/242191/step_03.webp"
    },
    {
      "text": "Sprinkle rhubarb over oat mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jsDUC4V7j9GZti2XhVxfHEnrol8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM_242191_EasyRhubarbCrisp_ddmfs_Step4_3x4_5444-2d995fe895c14aca905b1fac3a499703.jpg"
      ],
      "image": "assets/images/242191/step_04.webp"
    },
    {
      "text": "Combine white sugar, water, cornstarch, and vanilla in a saucepan over medium heat; cook and stir until thick and clear, about 5 minutes.",
