  "ingredients": [
    "1 cup sour cream",
    "2 tablespoons fresh lemon juice",
    "2 teaspoons soy sauce",
    "2 teaspoons celery salt",
    "2 teaspoons garlic salt",
    "1 dash pepper",
    "8 skinless, boneless chicken breast halves",
    "1 (6 ounce) package herb-seasoned stuffing mix, crushed into crumbs",
    "0.5 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sour cream, lemon juice, soy sauce, celery salt, garlic salt, and pepper together in a medium bowl. Coat each chicken breast in sour cream mixture, then stuffing crumbs. Arrange chicken in the prepared baking dish. Drizzle with melted butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven, until the chicken is no longer pink and the juices run clear, 40 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
