  "ingredients": [
    "2 pounds fresh green beans, trimmed",
    "1 tablespoon olive oil",
    "0.5 teaspoon coarse salt",
    "1 tablespoon olive oil",
    "2 tablespoons red wine vinegar",
    "1.5 teaspoons Dijon mustard",
    "1 teaspoon white sugar",
    "0.5 teaspoon dried dill",
    "0.5 teaspoon coarse-ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine the green beans in a large bowl with 1 tablespoon olive oil and the coarse salt; toss to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roast the green beans in the preheated oven until cooked through, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1 tablespoon of olive oil, red wine vinegar, Dijon mustard, sugar, dill, and pepper together in a bowl; drizzle over the roasted green beans to serve.",
