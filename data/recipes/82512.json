  "ingredients": [
    "6 slices white bread, torn into small pieces",
    "2 mangos - peeled, seeded and diced",
    "0.25 cup white sugar",
    "3 eggs, lightly beaten",
    "2 cups milk",
    "1.5 teaspoons vanilla extract",
    "1.5 teaspoons ground cardamom",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Butter a 9x11 inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss together the pieces of bread and mango, and place in the prepared baking dish. In a medium bowl, whisk together the sugar, eggs, milk, vanilla and cardamom. Pour over the bread. Dot with small pieces of butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 45 to 50 minutes in the preheated oven, or until slightly puffed and golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
