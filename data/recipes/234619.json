  "ingredients": [
    "2 teaspoons vegetable oil",
    "1 large clove garlic, minced",
    "1 tablespoon minced fresh ginger root",
    "0.75 cup hot water",
    "0.25 cup peanut butter, or more to taste",
    "0.5 lemon, juiced",
    "2 tablespoons Thai-style sweet chili sauce",
    "2 tablespoons hoisin sauce",
    "1 tablespoon soy sauce",
    "1 pinch red pepper flakes, or more to taste"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a medium saucepan over medium heat. Cook and stir garlic and ginger in hot oil until fragrant, about 1 minute. Add hot water, peanut butter, and lemon juice to the saucepan; stir until smooth. Stir chili sauce, hoisin sauce, and soy sauce into the peanut butter mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low and cook sauce at a simmer until thickened, about 5 minutes. Add red pepper flakes; stir.",
