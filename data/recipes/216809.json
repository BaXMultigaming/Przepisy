  "ingredients": [
    "1 tablespoon butter",
    "4 cups sliced Brussels sprouts",
    "1.25 cups heavy cream",
    "0.25 cup freshly shredded Parmesan cheese",
    "1 clove garlic, minced",
    "salt and ground black pepper to taste",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Generously grease a 9x9-inch baking dish with butter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread Brussels sprouts into the prepared baking dish. Whisk cream, Parmesan cheese, garlic, salt, and black pepper together in a bowl until thoroughly combined; pour over Brussels sprouts. Sprinkle with nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover the dish with aluminum foil. Bake in the preheated oven until tender, about 1 hour. Remove foil; continue baking, uncovered, until top has browned, about 15 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
