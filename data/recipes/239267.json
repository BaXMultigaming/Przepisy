  "ingredients": [
    "1.5 pounds boneless chicken thighs, cut into bite-size pieces",
    "2 tablespoons chipotle chile-flavored olive oil",
    "2 tablespoons soy sauce",
    "0.5 teaspoon red pepper flakes",
    "1 tablespoon garlic-flavored olive oil, or more as needed",
    "1 cup sugar snap peas",
    "1 cup chopped onion",
    "0.5 cup chopped red bell pepper",
    "0.5 cup chopped orange bell pepper",
    "1 tablespoon minced garlic",
    "0.25 cup white wine",
    "1 teaspoon garlic pepper seasoning",
    "0.5 teaspoon ground ginger",
    "1 tablespoon cornstarch",
    "1 tablespoon water, or as needed",
    "1 cup sliced fresh mushrooms"
  ],
  "steps": [
    {
      "text": "Mix chicken, chipotle-flavored olive oil, soy sauce, and red pepper flakes together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat garlic-flavored olive oil in a wok or large skillet over medium heat; cook and stir snap peas, onion, bell peppers, and garlic until partially tender, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add chicken mixture, white wine, garlic pepper seasoning, and ground ginger; cook and stir until chicken is almost cooked through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk cornstarch and water together in a small bowl until dissolved; stir into pan. Add mushrooms; cook and stir until sauce is thickened and chicken is no longer pink in the center, about 5 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
