  "ingredients": [
    "1 tablespoon butter",
    "0.25 cup minced onion",
    "2 cloves garlic, minced",
    "1.5 teaspoons salt",
    "1.5 teaspoons freshly ground black pepper",
    "2 pounds extra-lean ground beef",
    "3 slices bread, toasted and crumbled",
    "7 buttery round crackers, crushed",
    "1 egg, lightly beaten",
    "3.5 tablespoons sour cream",
    "1.5 tablespoons Worcestershire sauce",
    "1 (15 ounce) can tomato sauce, divided",
    "0.25 cup milk, or as needed",
    "3 tablespoons ketchup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KvJEMTRvcGXy-x8V5w-hqZ3D6_o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74360-the-best-meatloaf-ive-ever-made-mfs-step-1-376-434effce2a5d482db29eb555083e25db.jpg"
      ],
      "image": "assets/images/74360/step_01.webp"
    },
    {
      "text": "Melt butter in a skillet over medium heat, and cook onion and garlic until onion is soft and translucent, about 5 minutes. Remove from heat, and season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/JUIo3CarCp1KEpkYhP2YBwcHEP4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74360-the-best-meatloaf-ive-ever-made-mfs-step-2-381-ce006d6c70da483882f5ff99ec9ed61b.jpg"
      ],
      "image": "assets/images/74360/step_02.webp"
    },
    {
      "text": "Combine onion and garlic mixture, beef, crumbled bread, crushed crackers, egg, sour cream, Worcestershire sauce, and 1/2 can tomato sauce in a large bowl. Mix until well combined. Gradually stir in milk, 1 teaspoon at a time, until mixture is moist, but not soggy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5j8agFMCz48gecspF9wAYO4AL0I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74360-the-best-meatloaf-ive-ever-made-mfs-step-3-384-b481f1908dde461ba4e204d6cb1d973c.jpg"
      ],
      "image": "assets/images/74360/step_03.webp"
    },
    {
      "text": "Transfer the mixture to a 5x9-inch loaf pan. Bake uncovered in the preheated oven for 40 minutes. Increase oven temperature to 400 degrees F (200 degrees C). Continue baking 15 minutes, to an internal temperature of 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qe59gC1twZ_vzIQrjyhmh5-SPwk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74360-the-best-meatloaf-ive-ever-made-mfs-step-5-398-813baf381aaf4973be2e4c37005c93a5.jpg"
      ],
      "image": "assets/images/74360/step_04.webp"
    },
    {
      "text": "Mix the remaining tomato sauce and ketchup in a small bowl. Pour over the top of the meatloaf, and continue baking for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/tGFE6neBsjfkuFk4YIrLXJsDWZI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74360-the-best-meatloaf-ive-ever-made-mfs-step-6-403-fe995085b47e487585e2c27b82187524.jpg"
      ],
      "image": "assets/images/74360/step_05.webp"
    },
    {
      "text": "Serve hot and enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8LNuEGvKhNAgij53nKb8u5Mp1Jg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/74360-the-best-meatloaf-ive-ever-made-DDMFS-4x3-787c1678e3db45d8893c42838dfd73d3.jpg"
      ],
      "image": "assets/images/74360/step_06.webp"
    }
