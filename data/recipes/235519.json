  "ingredients": [
    "4 sweet potatoes, peeled and cut into 1 1/2-inch thick rounds",
    "0.33333334326744 cup fresh thyme leaves",
    "3 tablespoons olive oil",
    "4 large garlic cloves, minced",
    "0.5 teaspoon kosher salt",
