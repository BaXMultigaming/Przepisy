  "ingredients": [
    "4 (4 ounce) fillets barramundi (Asian sea bass)",
    "1 tablespoon olive oil, or as needed",
    "1 cup dried bread crumbs",
    "0.5 teaspoon seafood seasoning (such as Old Bay®)",
    "0.5 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon lemon zest",
    "1 pinch dried thyme",
    "1 cup melted butter",
    "0.25 cup lemon juice",
    "0.25 cup white wine",
    "2 tablespoons chopped fresh basil, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Brush fish fillets with olive oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make topping: Mix together bread crumbs, seafood seasoning, garlic powder, onion powder, lemon zest, and thyme on a large plate until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press fillets into bread crumb mixture to coat all sides. Arrange coated fillets on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Flip fillets and continue baking until fish flakes easily with a fork, about 10 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make sauce: Stir together melted butter, lemon juice, white wine, and basil in a small bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle sauce over fish to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
