  "ingredients": [
    "2 (12 ounce) cans tuna, drained",
    "3 large hard-boiled eggs, chopped",
    "1 stalk celery, diced",
    "0.5 cup light creamy salad dressing (such as Miracle Whip Light®)",
    "2 tablespoons sweet pickle relish",
    "1 teaspoon prepared yellow mustard",
    "1 dash Worcestershire sauce"
  ],
  "steps": [
    {
      "text": "Combine tuna, eggs, and celery in a medium bowl. Stir in salad dressing, relish, mustard, and Worcestershire sauce until well combined.",
