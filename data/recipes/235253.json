  "ingredients": [
    "5 overripe Fuyu persimmons, mashed",
    "1 small Granny Smith apple, peeled and diced",
    "1 tablespoon brown sugar",
    "2 teaspoons ground cinnamon",
    "1 teaspoon freshly grated ginger",
