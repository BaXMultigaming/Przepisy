  "ingredients": [
    "1 teaspoon paprika",
    "0.25 teaspoon chili powder, or more to taste",
    "0.25 teaspoon salt",
    "0.13 teaspoon onion powder",
    "0.13 teaspoon garlic powder",
    "8 ounces frozen French fries (such as Ore-Ida®)",
    "1 teaspoon vegetable oil",
    "0.5 (15 ounce) jar nacho Cheddar cheese sauce (such as Rico's®)"
  ],
  "steps": [
    {
      "text": "Preheat an air fryer to 400 degrees F (200 degrees C) according to manufacturer's instructions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir paprika, chili powder, salt, onion powder, and garlic powder together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour fries into a large bowl. Drizzle vegetable oil over the fries; toss to coat. Sprinkle seasoning mixture over fries; toss until evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place seasoned fries in the basket of the preheated air fryer. Cook for 10 minutes. Shake the basket and cook until crisp; about 3 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, heat cheese sauce in a small saucepan over medium heat. Serve as a dipping sauce for the fries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
