  "keywords": [],
  "ingredients": [
    "0.5 cup unsalted butter",
    "0.75 cup chopped dried sweetened pineapple",
    "1 cup all-purpose flour",
    "1 cup yellow cornmeal",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 cup buttermilk",
    "2 large eggs"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a muffin pan with paper muffin liners, and lightly spray liners with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a heavy saucepan over medium heat until golden brown. Remove from heat and stir in pineapple. Set aside to steep for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cornmeal, baking soda, and salt until combined. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine buttermilk, eggs, and pineapple mixture in a large bowl. Whisk until smooth, about 1 minute. Add flour mixture to buttermilk mixture; whisk until just combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter evenly between the prepared muffin cups and bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, about 25 minutes. Cool in the pan for 5 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
