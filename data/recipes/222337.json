  "title": "Brown Butter Pineapple Corn Muffins",
  "description": "The perfect complement to a bowl of chili, these delicious brown butter corn muffins are elevated by dried pineapple in the batter.",
  "authors": [
    "John Mitzewich"
  ],
  "date_published": "2012-05-09T19:52:08-04:00",
  "date_modified": "2019-10-10T00:50:49-04:00",
