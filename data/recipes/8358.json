  "ingredients": [
    "5 apple - peeled, cored and sliced",
    "2 cups all-purpose flour",
    "0.5 teaspoon salt",
    "4 teaspoons ground cinnamon",
    "4 teaspoons baking powder",
    "4 eggs",
    "2 cups white sugar",
    "1 cup vegetable oil",
    "2 teaspoons vanilla extract",
    "1 cup chopped walnuts",
    "4 teaspoons white sugar",
    "1 teaspoon ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease and flour a 9x13-inch pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour, salt, cinnamon, and baking powder together; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs and sugar together in a large bowl with an electric mixer on high speed until light in color, about 2 to 3 minutes; beat in oil until combined. Add flour mixture and mix well. Add vanilla and fold in apples and nuts. Pour cake batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 4 teaspoons sugar with 1 teaspoon cinnamon in a small bowl; sprinkle over cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center of the cake comes out clean, about 50 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
