  "ingredients": [
    "1 pound cassava (yucca), peeled and shredded",
    "4 medium eggs",
    "1 cup creamy coconut milk",
    "1 cup white sugar",
    "0.75 cup vegetable oil",
    "0.25 teaspoon salt",
    "1.75 cups self-rising flour",
    "1.3333333730698 cups freshly grated coconut"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line a 9-inch square baking pan with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cassava, eggs, coconut milk, sugar, vegetable oil, and salt together well in a large bowl. Stir in flour and grated coconut. Pour into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 50 minutes. Cool and serve.",
