  "ingredients": [
    "2 racks baby back ribs, or more to taste",
    "0.66666668653488 cup maple syrup",
    "0.5 cup teriyaki sauce",
    "0.25 cup soy sauce",
    "5 teaspoons beef base",
    "4.5 teaspoons seasoned salt",
    "2 teaspoons salt",
    "1 teaspoon garlic powder",
    "0.5 teaspoon ground black pepper",
    "nonstick cooking spray",
    "0.5 cup barbecue sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Place ribs in a very large pot, cutting them in half, if necessary, to fit. Add maple syrup, teriyaki sauce, soy sauce, beef base, seasoned salt, salt, garlic powder, and pepper. Add enough water to cover ribs, stirring ingredients in the pan to combine. Bring to a low boil and cook for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Spray a large baking sheet or broiler pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ribs on the prepared baking sheet. Brush barbecue sauce on both sides of ribs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated oven until barbecue sauce starts to get bubbly and sticky, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
