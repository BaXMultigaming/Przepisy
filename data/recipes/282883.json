  "ingredients": [
    "1.75 cups semisweet chocolate chips",
    "0.5 cup sweetened condensed milk",
    "3 tablespoons whiskey (such as Jack Daniel's®)",
    "0.5 teaspoon vanilla extract",
    "0.125 teaspoon salt",
    "1 cup finely chopped pecans"
  ],
  "steps": [
    {
      "text": "Line a 5x7-inch baking dish with aluminum foil, leaving an overhang for easy removal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chocolate chips in a microwave-safe glass bowl; microwave in 15-second intervals until melted, stirring after each interval, 1 to 3 minutes. Stir in sweetened condensed milk, whiskey, vanilla, and salt until completely incorporated; stir in pecans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour fudge into the prepared baking dish; let set for 2 to 3 hours. Remove fudge from dish using foil overhang; cut into 24 squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
