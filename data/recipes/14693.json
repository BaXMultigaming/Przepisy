  "ingredients": [
    "1.25 pounds boneless pork loin, pounded thin",
    "0.5 cup all-purpose flour for coating",
    "salt and pepper to taste",
    "2 tablespoons butter",
    "0.25 cup honey",
    "0.25 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "In a shallow dish, mix together flour, salt and pepper. Dredge pork cutlets in the flour mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large skillet, melt butter over medium-high heat. Add chops, and brown both sides. Transfer to a warm plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix honey and pecans into the pan drippings. Heat through, stirring constantly. Pour sauce over cutlets.",
