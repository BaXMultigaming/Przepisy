  "ingredients": [
    "1 tablespoon olive oil",
    "1 pound carrots, sliced diagonally",
    "1 cup chopped celery",
    "0.5 medium yellow onion, chopped",
    "1 teaspoon dried oregano",
    "1 teaspoon Italian seasoning",
    "0.5 teaspoon seasoned salt",
    "salt and ground black pepper to taste",
    "2 cloves garlic, minced",
    "4 cups chicken broth, or to taste",
    "1 (8 ounce) package extra-wide egg noodles",
    "1 cooked rotisserie chicken - skinned, boned, and meat shredded"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/A7CPEOVkWqB6ibPwMxneN-uhqeo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275972-rotisserie-chicken-noodle-soup-VAT-step-01-98d81c119169418b9158f6a6e6872c48.jpg"
      ],
      "image": "assets/images/275972/step_01.webp"
    },
    {
      "text": "Heat oil into a Dutch oven over medium-high heat. Add carrots, celery, onion, oregano, Italian seasoning, both salts, and pepper; cook and stir until vegetables have softened, 6 to 8 minutes. Stir in garlic and cook until fragrant, about 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bkcxdxHa8v_Vn78dpro4lIDiEb0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275972-rotisserie-chicken-noodle-soup-VAT-step-02-e63bdea820d347a5bc27078c8b3ac8fa.jpg"
      ],
      "image": "assets/images/275972/step_02.webp"
    },
    {
      "text": "Add chicken broth and bring to a boil. Add egg noodles; cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yCiW05C3mXdR_ZEk__VbVuLVmXI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/275972-rotisserie-chicken-noodle-soup-VAT-step-03-69e8ed3f4d6848d78fbfbe29ed1bbacc.jpg"
      ],
      "image": "assets/images/275972/step_03.webp"
    },
    {
      "text": "Gently stir in shredded chicken and simmer until egg noodles are tender and chicken is heated through, 2 to 3 more minutes.",
      "section": null,
      "name": null,
      "url": null,
