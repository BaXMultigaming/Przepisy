  "ingredients": [
    "2 pounds veal",
    "1 cup all-purpose flour",
    "4 eggs",
    "1 tablespoon vegetable oil",
    "salt and pepper to taste",
    "4 cups bread crumbs",
    "0.125 cup oil for frying"
  ],
  "steps": [
    {
      "text": "Cut the veal into steaks, about as thick as your finger. Dredge in flour. In a shallow dish, beat the eggs with 1 tablespoon oil, salt and pepper. Coat the veal with egg mixture, then with bread crumbs.",
