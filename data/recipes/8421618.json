  "ingredients": [
    "2 pounds extra lean (at least 90%) ground beef",
    "1 large egg, beaten",
    "0.67 cup plain dry bread crumbs",
    "0.67 cup minced onion",
    "2 cloves garlic, minced",
    "1 tablespoon minced fresh rosemary",
    "0.25 cup minced fresh parsley",
    "1 tablespoon minced fresh oregano",
    "1 tablespoon minced fresh dill",
    "1 teaspoon ground coriander",
    "1.5 teaspoons kosher salt, or to taste",
    "1 teaspoon freshly ground black pepper, or to taste",
    "olive oil cooking spray",
    "chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a sheet pan with parchment paper or foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ground beef, egg, bread crumbs, onion, garlic, rosemary, parsley, oregano, dill, coriander, salt, and pepper in a large bowl. Mix using your hands until just blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form meat mixture into balls, about 1 1/2 inches diameter, and place onto the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spray meatballs with cooking spray, place in the preheated oven, and bake until the meatballs are browned and no longer pink in the center, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove meatballs from the oven and allow to cool slightly on a paper towel lined plate. Garnish with additional fresh parsley for serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
