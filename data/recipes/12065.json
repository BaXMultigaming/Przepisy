  "ingredients": [
    "3 tablespoons butter",
    "8 fluid ounces heavy whipping cream",
    "0.25 cup grated Parmesan cheese",
    "0.25 cup grated Romano cheese",
    "1 pinch ground nutmeg",
    "salt to taste",
    "1 egg yolk",
    "2 tablespoons grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Melt butter in a medium saucepan over medium heat. Mix in cream, stirring constantly. Add Parmesan cheese, Romano cheese, nutmeg, and salt; stir constantly until cheese has melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in egg yolk until well combined; simmer and stir over medium-low heat for 3 to 5 minutes. Garnish with additional grated Parmesan cheese, if desired.",
      "section": null,
      "name": null,
      "url": null,
