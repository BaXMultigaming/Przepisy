  "ingredients": [
    "6 yellow-fleshed sweet potatoes",
    "1 cup packed brown sugar",
    "0.5 cup butter",
    "0.5 cup water",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UTI_GE-uA9TIRxGFphlMDK0ihlg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24326-classic-candied-sweet-potatoes-VAT-step-01-eebbdf7ab0c943b190d00d2b7e14ccab.jpg"
      ],
      "image": "assets/images/24326/step_01.webp"
    },
    {
      "text": "Place a steamer basket in a large pot. Add 2-inches of water and bring to a boil. Add sweet potatoes to the steamer basket, cover, and cook until easily pierced with a fork, about 30 minutes. Drain and cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/yWJ5ewB02t18Ts-ZxfSnWxReQwA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24326-classic-candied-sweet-potatoes-VAT-step-02-a6266b7908524443a479c7923d6cab7b.jpg"
      ],
      "image": "assets/images/24326/step_02.webp"
    },
    {
      "text": "Peel and slice sweet potatoes into rounds; transfer to a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mpTsHd25Vz9BkiRyyXjdRFqMEXA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24326-classic-candied-sweet-potatoes-VAT-step-03-6b0237319e1e4d2a8f8fec83e126aa58.jpg"
      ],
      "image": "assets/images/24326/step_03.webp"
    },
    {
      "text": "Melt brown sugar, butter, water, and salt in a medium saucepan over medium heat until sugar dissolves and mixture is bubbly; pour over sweet potatoes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1d-6QS4y7ua9_1di1MlN5TSi3zU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24326-classic-candied-sweet-potatoes-VAT-step-04-6dafc24eee7e4b78b7da176bfb37b1a0.jpg"
      ],
      "image": "assets/images/24326/step_04.webp"
    },
    {
      "text": "Bake sweet potatoes in the preheated oven until golden and caramelized, about 1 hour, basting occasionally with brown sugar sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/r-SE2dQ1dWyey-QCcG7GvInOwaA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/24326-classic-candied-sweet-potatoes-VAT-step-05-db26075d09ce42bc9e93b9b315aaea7d.jpg"
      ],
      "image": "assets/images/24326/step_05.webp"
    }
  ],
