  "ingredients": [
    "1 teaspoon olive oil",
    "1 cup chopped onion",
    "4 cloves garlic, minced",
    "2 (14.5 ounce) cans peeled and diced tomatoes",
    "0.375 cup red wine",
    "2 tablespoons tomato paste",
    "1 tablespoon white sugar",
    "1 tablespoon chopped fresh basil",
    "1 tablespoon lemon juice",
    "1 teaspoon crushed red pepper flakes",
    "0.5 teaspoon Italian seasoning",
    "0.25 teaspoon ground black pepper",
    "2 tablespoons chopped fresh parsley"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet or saucepan over medium heat. Add onion and garlic; cook and stir until softened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GDlim18mJ26dpmk0HO4ghpzp5Xw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11839-ArrabbiataSauce-ddmfs-Step1-0861-6db42c002bc34342811d895b7d144b08.jpg"
      ],
      "image": "assets/images/11839/step_01.webp"
    },
    {
      "text": "Stir in diced tomatoes, wine, tomato paste, sugar, basil, lemon juice, red pepper flakes, Italian seasoning, and black pepper; bring to a boil. Reduce heat to medium and simmer, uncovered, for about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EtAzMEyULi-6EGx_WsqiyP6pmjg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11839-ArrabbiataSauce-ddmfs-Step2-0864-f050cb4d15594acfb51c16625e79a2a5.jpg"
      ],
      "image": "assets/images/11839/step_02.webp"
    },
    {
      "text": "Stir in parsley. Ladle sauce over hot cooked pasta of your choice.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cKuuSa-mhucjER_3SqM_x6c53W0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/11839-ArrabbiataSauce-ddmfs-Step-3-0866-931c7a20ef584ae889e191f26afa6651.jpg"
      ],
      "image": "assets/images/11839/step_03.webp"
    },
    {
      "text": "Serve hot and enjoy!",
