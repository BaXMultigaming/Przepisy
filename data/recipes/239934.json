  "ingredients": [
    "1.5 cups dried great Northern beans, rinsed",
    "2 large smoked neck bones",
    "2 (14 ounce) cans chicken broth",
    "0.5 teaspoon soul seasoning",
    "0.5 onion, finely chopped",
    "0.5 teaspoon white vinegar, or to taste",
    "1 pinch white sugar, or to taste",
    "1 dash hot sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/36QU3kwW10JNHZk1fTOFScd1uN0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239934-Slow-Cooker-Northern-White-Beans-dmfs-step01-4x3-1349-0fb66d6f93834001929eb614be9586b3.jpg"
      ],
      "image": "assets/images/239934/step_01.webp"
    },
    {
      "text": "Place beans into a large container and cover with several inches of cool water; let stand for 8 hours to overnight. Drain and rinse; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gA1YJevplllNpiOo0FwCmZQ2a1I=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239934-Slow-Cooker-Northern-White-Beans-dmfs-step02a-4x3-1352-69f1c8fc02eb41a9b385b482a145bd47.jpg"
      ],
      "image": "assets/images/239934/step_02.webp"
    },
    {
      "text": "Place neck bones in a slow cooker and pour chicken broth over bones; stir in soul seasoning.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qOY-4wyuhesjpoJMZ3bVgaYBTRc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239934-Slow-Cooker-Northern-White-Beans-dmfs-step03-4x3-1356-d34d1298e86d41f284cc6d9ef52bee4b.jpg"
      ],
      "image": "assets/images/239934/step_03.webp"
    },
    {
      "text": "Cook on High until meat falls off the bone, about 1 hour. Transfer bones and meat to a plate and shred meat from bones; discard bones.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/AyzDKw7QjMUIoLcp_ic9N33vIpU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239934-Slow-Cooker-Northern-White-Beans-dmfs-step04-4x3-1402-12e493276b4047ce86882bc8fce01123.jpg"
      ],
      "image": "assets/images/239934/step_04.webp"
    },
    {
      "text": "Stir beans, onion, vinegar, sugar, and hot sauce into the slow cooker; spread shredded meat over bean mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/-Yk67ER9fLL30GUxHXs3aLcq2i0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239934-Slow-Cooker-Northern-White-Beans-dmfs-step06-4x3-1411-9eca82cabdab4b99ac82cdce509ddcf4.jpg"
      ],
      "image": "assets/images/239934/step_05.webp"
    },
    {
      "text": "Cook on Low for 4 to 6 hours or High for 2 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OImODxoXMCmIRr5jTBcix-SiODM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/239934-Slow-Cooker-Northern-White-Beans-dmfs-4x3-13561463-42e44d6084e04db9b13d08e7e1bc6b44.jpg"
      ],
