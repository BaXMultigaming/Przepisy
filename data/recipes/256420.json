  "ingredients": [
    "0.66666668653488 cup white chocolate morsels",
    "0.25 teaspoon raspberry extract",
    "4 drops red food coloring"
  ],
  "steps": [
    {
      "text": "Melt white chocolate in a microwave-safe glass or ceramic bowl in 30-second intervals, stirring after each melting, 1 to 2 minutes. Stir in raspberry extract and red food coloring until evenly blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Line a baking sheet with parchment paper. Place melted chocolate mixture in a resealable plastic bag and snip off a corner; pipe onto the parchment paper in the shape of chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate chips until firm, about 5 minutes. Store in a resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
