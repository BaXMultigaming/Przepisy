  "ingredients": [
    "2 tablespoons olive oil, divided",
    "4 boneless pork loin chops, pounded thin",
    "1 large onion, sliced",
    "0.5 teaspoon sugar",
    "2 teaspoons chili powder",
    "0.5 teaspoon fennel seeds, crushed",
    "0.5 teaspoon red pepper flakes",
    "1 teaspoon dried oregano",
    "1 (8 ounce) can tomato sauce",
    "2 fluid ounces water",
    "1 teaspoon Worcestershire sauce",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Gather the ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the oil in a skillet over high heat, and quickly brown the pork chops on both sides. Transfer chops to platter, and keep warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce skillet heat to medium, and cook the onion until tender. Mix in the sugar, chili powder, fennel, red pepper flakes, and oregano. Stir in the tomato sauce, water, and Worcestershire sauce, and bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return the pork chops to the skillet. Cover, reduce heat to low, and cook 10 minutes. Remove cover, and continue cooking 15 minutes, or to desired doneness.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
