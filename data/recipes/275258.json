  "ingredients": [
    "aluminum foil",
    "6 chicken drumsticks",
    "3 tablespoons butter, melted",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon paprika",
    "0.25 teaspoon garlic powder",
    "0.25 teaspoon onion powder",
    "0.25 teaspoon dried basil",
    "0.25 teaspoon ground thyme",
    "0.25 teaspoon dried oregano",
    "0.25 teaspoon ground cumin",
    "0.25 teaspoon cayenne pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Line a baking pan with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pat drumsticks with paper towels until dry.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine baking powder, salt, black pepper, paprika, garlic powder, onion powder, basil, thyme, oregano, cumin and cayenne pepper in a medium bowl. Add melted butter and stir until combined. Add drumsticks and toss until fully coated. Place drumsticks into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until drumsticks are no longer pink at the bone and the juices run clear, 20 to 25 minutes. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
