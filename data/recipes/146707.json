  "ingredients": [
    "1 large egg white",
    "1 tablespoon water",
    "2.25 cups pecan halves",
    "0.5 cup white sugar",
    "1.5 teaspoons ground cinnamon",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 225 degrees F (110 degrees C). Lightly grease a rimmed baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/gzw2S4AUmi4tkPVebpNOVxeXkT4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/146707-old-fashion-roasted-pecans-ddmfs-Step1-0231-099510c1c830491db289998f9459d400.jpg"
      ],
      "image": "assets/images/146707/step_01.webp"
    },
    {
      "text": "Whisk egg white and water in a bowl until frothy. Fold in pecans to coat evenly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PgaXTfF9xpnhrDqB9a_kgsrIxtU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/146707-old-fashion-roasted-pecans-ddmfs-Step3-0237-399518243898467fada7db65f1994762.jpg"
      ],
      "image": "assets/images/146707/step_02.webp"
    },
    {
      "text": "Combine sugar, cinnamon, and salt in a shaker or cup with a lid. Dust pecans evenly with sugar mixture, then spread onto the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/QLV1ouVBhQ7qQuEWI0SvvZOeGK4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/146707-old-fashion-roasted-pecans-ddmfs-Step6-0246-d2299f785fff462caee2b17edc60ee19.jpg"
      ],
      "image": "assets/images/146707/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven, stirring every 15 minutes, until toasted and fragrant, about 1 hour. Cool pecans on the pan, then store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/sM453j9Z0wj-Vo3eGUvc_klUzOA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/146707-old-fashion-roasted-pecans-ddmfs-3X4-0287-1-6b1a67a5ddc04f5098819f2f9ea8411c.jpg"
      ],
      "image": "assets/images/146707/step_04.webp"
    }
