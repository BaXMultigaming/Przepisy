  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.75 cup brown sugar",
    "0.5 cup cold butter, diced",
    "0.5 teaspoon salt",
    "1 cup white sugar",
    "0.25 cup orange juice",
    "2 tablespoons instant tapioca",
    "1 teaspoon cinnamon",
    "6 cups fresh blueberries"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, brown sugar, cold butter, and salt in the bowl of a food processor; pulse into coarse crumbs. Set topping aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine white sugar, orange juice, tapioca, and cinnamon in a large bowl; stir in blueberries until completely coated. Spoon blueberry filling into a large baking dish; sprinkle topping over blueberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until topping is golden brown and filling bubbles, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
