  "ingredients": [
    "2 cups all-purpose flour",
    "2 cups white sugar, divided",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "1 (20 ounce) can crushed pineapple with juice",
    "2 large eggs, beaten",
    "0.75 cup butter",
    "0.5 cup evaporated milk",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, 1 1/2 cups sugar, baking soda, and salt together in a mixing bowl. Stir in undrained pineapple and eggs until well combined. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine butter, evaporated milk, remaining 1/2 cup sugar, and vanilla in a saucepan over medium-high heat. Bring to a boil and cook for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove cake from the oven and set on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour butter mixture over warm cake. Let cool for 30 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
