  "ingredients": [
    "2 tablespoons olive oil",
    "1 large white onion, chopped",
    "0.5 cup dry lentils",
    "3 tablespoons curry powder",
    "2 cloves garlic, minced",
    "1 teaspoon ground cumin",
    "1 pinch cayenne pepper",
    "1 (28 ounce) can crushed tomatoes",
    "1 (15 ounce) can garbanzo beans, drained and rinsed",
    "1 (8 ounce) can kidney beans, drained and rinsed",
    "0.5 cup raisins",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a large pot over medium heat. Add onion; cook until tender. Add lentils, curry powder, garlic, cumin, and cayenne pepper; cook, stirring constantly, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in tomatoes, garbanzo beans, kidney beans, and raisins; season with salt and black pepper. Reduce heat to low; simmer, stirring occasionally, for at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
