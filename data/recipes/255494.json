  "ingredients": [
    "cooking spray",
    "1 (15 ounce) can pumpkin puree",
    "1 (12 fluid ounce) can evaporated milk",
    "1.5 cups white sugar",
    "4 eggs",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 (15.25 ounce) package yellow cake mix",
    "2 cups chopped pecans",
    "0.75 cup butter, melted"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (165 degrees C). Grease a 9x13-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix pumpkin, evaporated milk, sugar, eggs, vanilla extract, cinnamon, and nutmeg together in a bowl; pour into the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sprinkle cake mix evenly over the pumpkin mixture; top with pecans. Drizzle melted butter on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
