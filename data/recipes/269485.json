  "ingredients": [
    "1 cup butter",
    "2 cups white sugar",
    "0.5 cup cocoa powder",
    "4 large eggs",
    "1 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 cup chopped pecans",
    "0.25 cup peanut butter chips",
    "0.25 cup caramel syrup"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease two mini muffin tins.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in a large saucepan over medium heat. Off heat, add sugar, cocoa powder, eggs, and vanilla extract, in that order; beat with an electric mixer until well blended. Add flour and baking powder; beat slowly, gradually increasing speed until batter is smooth. Fold in pecans and peanut butter chips; divide batter among mini muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into centers comes out clean, 20 to 30 minutes. Cool brownies for 10 minutes. Drizzle caramel syrup on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
