  "ingredients": [
    "nonstick cooking spray with flour",
    "2.3333332538605 cups all-purpose flour",
    "1 cup white sugar",
    "0.75 cup semisweet chocolate chips",
    "2 teaspoons baking powder",
    "0.75 teaspoon salt",
    "1 cup ricotta cheese",
    "2 large eggs, lightly beaten",
    "1.3333333730698 cups milk",
    "1 teaspoon vanilla extract",
    "0.25 cup canola oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray 18 cups of a muffin tin with nonstick cooking spray that contains flour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, sugar, chocolate chips, baking powder, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place ricotta cheese in a bowl and add eggs, 1 at a time, beating well after each addition. Whisk in milk and vanilla extract until blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold cheese mixture and canola oil into flour mixture until just blended. Spoon batter evenly into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center of a muffin comes out clean, 22 to 25 minutes. Remove muffins from the pan immediately and let cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
