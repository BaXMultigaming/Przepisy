  "ingredients": [
    "2 tablespoons olive oil",
    "1 yellow onion, diced",
    "1.25 pounds ground turkey",
    "1 cup ketchup",
    "1 tablespoon red wine vinegar",
    "1 tablespoon Worcestershire sauce",
    "1 tablespoon Dijon mustard",
    "1 tablespoon brown sugar",
    "1 tablespoon chili powder"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium heat. Add onion; cook until translucent, 5 to 7 minutes. Break ground turkey into small pieces; add to the skillet. Cook, breaking turkey into smaller pieces, until completely browned, 7 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ketchup, vinegar, Worcestershire sauce, Dijon mustard, brown sugar, and chili powder into turkey; simmer until mixture thickens, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
