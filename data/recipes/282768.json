    "0.25 cup grated Parmesan cheese",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly spray a baking sheet with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place mayonnaise in a large zip-top bag. Add cauliflower; seal bag and shake to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs and Parmesan cheese in another large zip-top bag. Add 1/2 of the coated cauliflower; seal bag and shake to coat. Spread in a single layer on the prepared baking sheet. Repeat with remaining cauliflower and bread crumb mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated until tender and golden brown, about 35 minutes.",
