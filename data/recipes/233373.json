        "https://www.allrecipes.com/thmb/sd3xQJiIPbjoY8YecFqxduteLW0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/233373-traditional-three-bean-salad-VAT-007-step-02-f74f5d7a8abe4cfbb3814ebcc90e17c2.jpg"
