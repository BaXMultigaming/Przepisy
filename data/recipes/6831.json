  "ingredients": [
    "1.125 cups water",
    "3 tablespoons honey",
    "1 tablespoon margarine",
    "1.5 teaspoons salt",
    "3 cups bread flour",
    "2 teaspoons active dry yeast",
    "4 tablespoons powdered buttermilk"
