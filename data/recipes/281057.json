  "ingredients": [
    "4 cups water",
    "0.5 pound dry pinto beans, sorted and rinsed",
    "2 small onions, quartered",
    "2 cloves garlic, crushed",
    "1 teaspoon ham base",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Bring water to a boil in a medium pot; add pinto beans, onions, garlic, ham base, and salt. Stir and return to a boil. Cover, turn off heat, and let stand for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to a boil; reduce heat and let simmer, uncovered, stirring occasionally, until beans are tender or have reached desired doneness, 40 to 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
