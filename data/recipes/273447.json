  "ingredients": [
    "cooking spray",
    "1 cup steel-cut oats",
    "1 cup milk",
    "1 cup wheat flour, sifted",
    "0.25 cup white sugar",
    "2 teaspoons baking powder",
    "1 teaspoon salt",
    "1 large egg",
    "3 tablespoons vegetable oil",
    "2 tablespoons pureed prunes"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with foil liners. Spray liners with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place oats into a bowl and add milk. Let stand 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, combine flour, sugar, baking powder, and salt in a separate bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together egg, oil, and prunes in a large mixing bowl. Add oat mixture and stir to combine. Stir in flour mixture just until blended. Spoon batter into the prepared muffin cups, filling each 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of a muffin comes out clean, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
