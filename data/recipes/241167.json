  "ingredients": [
    "1 lemon, sliced into thin rounds with the ends reserved",
    "3 tablespoons olive oil",
    "1.5 teaspoons minced garlic",
    "1.5 teaspoons minced onion",
    "salt and ground black pepper to taste",
    "1 filet steelhead trout"
  ],
  "steps": [
    {
      "text": "Lightly oil the grate of an outdoor grill. Arrange lemon slices on grate so they overlap slightly and form a shape slightly larger than your trout fillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the grill for medium heat to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a small skillet over medium-high heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add garlic and onion to skillet; sauté until garlic browns slightly, 2 to 3 minutes. Season with salt and black pepper; squeeze reserved lemon ends over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Gently lay trout fillet on lemons, skin-side-down. Brush garlic mixture over top of fillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook trout until flesh flakes easily with a fork, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
