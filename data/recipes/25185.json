  "ingredients": [
    "3 pounds skinless, boneless chicken breast meat - cut into bite-size pieces",
    "0.5 teaspoon olive oil",
    "3 cloves garlic, crushed",
    "0.5 cup water",
    "1 (10.75 ounce) can condensed cream of celery soup",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon salt",
    "0.5 teaspoon Italian-style seasoning",
    "1 apple - peeled, cored and cut into eighths",
    "3 small red potatoes, cut into eighths",
    "1 onion, cut into eighths",
    "1 (1.25 ounce) envelope dry onion gravy mix"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium high heat. Saute garlic and chicken until lightly browned.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place chicken and garlic in slow cooker; add water, soup, pepper, salt, seasoning, apple, potatoes, onion and gravy mix. Mix all together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set heat on Low setting and simmer slowly for 6 to 8 hours.",
      "section": null,
