  "ingredients": [
    "2 pounds lean ground beef",
    "1 cup pasta sauce",
    "0.5 cup Italian-style bread crumbs, or more as needed",
    "0.25 cup minced onion",
    "0.25 cup ketchup",
    "1 egg, beaten",
    "2 large cloves garlic, minced",
    "0.5 teaspoon oregano",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "1.5 cups shredded mozzarella cheese, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thoroughly mix beef, pasta sauce, bread crumbs, onion, ketchup, egg, garlic, oregano, salt, and ground black pepper together using your hands in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread 1/2 the meat mixture into the bottom of a loaf pan. Spread mozzarella cheese over the center of the meat. Spread remaining meat mixture over the cheese, pressing edges of meat together on the sides to seal in the cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until meat is no longer pink in the center, about 1 hour. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
