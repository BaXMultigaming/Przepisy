  "ingredients": [
    "1 (1 pound) loaf French bread, cut into 1/2 inch pieces",
    "1 mango - peeled, seeded and diced",
    "1 tablespoon fresh basil, minced",
    "1 cup grated Romano cheese"
  ],
  "steps": [
    {
      "text": "Preheat the broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Arrange French bread slices in a single layer on a large baking sheet. Broil in the preheated oven 1 to 2 minutes per side, until lightly toasted. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix mango and fresh basil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top each bread slice with equal amounts of the mango and basil mixture. Sprinkle with Romano cheese, adjusting the amount to taste.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return topped bread to broiler. Broil 2 to 3 minutes, or until the cheese is melted and lightly browned. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
