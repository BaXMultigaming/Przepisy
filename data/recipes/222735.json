  "title": "Spiderweb Pumpkin Cheesecake",
  "description": "This spooky pumpkin cheesecake has a chocolate wafer crust and a sour cream topping decorated with a chocolate \"web\".",
  "authors": [
    "treen9499"
  ],
  "date_published": "2020-06-18T23:49:48-04:00",
