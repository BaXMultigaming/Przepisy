  "ingredients": [
    "1.25 cups chocolate wafer crumbs",
    "0.25 cup butter, melted",
    "3 (8 ounce) packages cream cheese, softened",
    "0.75 cup white sugar",
    "3 eggs",
    "1.5 cups canned pumpkin pie filling",
    "1 tablespoon cornstarch",
    "1 cup sour cream",
    "2 (1 ounce) squares semisweet chocolate",
    "2 teaspoons vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chocolate wafer crumbs and melted butter in a bowl; press onto the bottom of a 9-inch springform pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese and sugar with an electric mixer in a large bowl until smooth. Beat in eggs, one at a time, until just blended. Stir in pumpkin pie filling and cornstarch; pour over chocolate wafer crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until center is just set, 50 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread sour cream over top of warm cheesecake; let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate and oil in a microwave-safe bowl in a microwave for 1 minute; stir until completely melted. Drizzle chocolate onto sour cream topping in a spiral pattern, starting from the center; draw a toothpick outward, from center to edges, through circles to form a web. Remove side of pan and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
