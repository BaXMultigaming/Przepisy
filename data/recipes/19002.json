  "ingredients": [
    "1 (14 ounce) can sweetened condensed milk",
    "0.5 cup cold milk",
    "1 tablespoon vanilla extract",
    "0.125 teaspoon salt",
    "1 pint heavy cream"
  ],
  "steps": [
    {
      "text": "Stir together condensed milk, cold milk, vanilla, and salt in a medium bowl. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat heavy cream in a large bowl with an electric mixer until stiff peaks form. Fold milk mixture into whipped cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into a shallow 2-quart dish, cover, and freeze for 4 hours, stirring once after 2 hours or when edges start to harden.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve or store in an airtight container for up to 10 days.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
