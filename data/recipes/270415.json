  "ingredients": [
    "1 tablespoon butter",
    "1 cup farro",
    "2 cups chicken stock",
    "2 tablespoons heavy whipping cream",
    "0.75 cup grated mozzarella cheese",
    "0.5 cup grated Parmesan cheese",
    "1 teaspoon Greek seasoning (such as Cavender's®)"
  ],
  "steps": [
    {
      "text": "Turn on a multi-functional pressure cooker (such as Instant Pot®) and select Saute function. Melt butter and stir in farro. Cook and stir for about 2 minutes. Pour in chicken stock and stir to combine. Change to Manual setting. Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 10 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure carefully using the quick-release method according to manufacturer's instructions, about 5 minutes. Unlock and remove the lid. Add cream, mozzarella cheese, Parmesan cheese, and Greek seasoning. Stir until melted.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
