  "ingredients": [
    "4 (1 ounce) squares semisweet chocolate",
    "0.33333334326744 cup sour cream",
    "1 cup chocolate cookie crumbs",
    "0.33333334326744 cup chocolate cookie crumbs",
    "0.33333334326744 cup confectioners' sugar",
