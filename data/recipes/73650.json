  "ingredients": [
    "1 (12 ounce) can refrigerated buttermilk biscuit dough",
    "2 cups chopped fresh rhubarb",
    "1 cup white sugar",
    "1 cup water",
    "0.5 cup butter, melted",
    "1.25 teaspoons vanilla extract",
    "0.25 teaspoon ground cinnamon, or to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Separate biscuits; flatten each into about a 3-inch circle. Place generous 1 tablespoon chopped rhubarb in center of each dough circle; wrap dough around rhubarb. Press edges together to seal; place dumplings, seam-sides down, in a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine sugar, water, butter, and vanilla extract in a bowl or large measuring cup: pour over dumplings. Sprinkle cinnamon over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until biscuits are golden brown, 35 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
