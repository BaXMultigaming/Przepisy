  "ingredients": [
    "1 cup white sugar",
    "0.5 cup unsalted butter, melted",
    "1 large egg",
    "1 cup all-purpose flour",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon baking soda",
    "1 cup peeled, cored, and diced tart apples (such as Granny Smith)",
    "1 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour an 8-inch square baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sugar, melted butter, and egg together in a large bowl. Mix in flour, cinnamon, and baking soda, then stir in apple and walnuts. Spread batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a small knife inserted in the center comes out clean, about 40 minutes. Cool completely before cutting into nine bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
