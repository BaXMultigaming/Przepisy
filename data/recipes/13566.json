  "ingredients": [
    "2 cups all-purpose flour",
    "0.75 cup white sugar",
    "1.5 teaspoons baking powder",
    "0.75 teaspoon salt",
    "0.5 teaspoon baking soda",
    "1 cup chopped cranberries",
    "0.5 cup chopped walnuts",
    "0.75 cup orange juice",
    "1 large egg",
    "2 tablespoons vegetable oil",
    "1 tablespoon orange zest"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x5-inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/42Qetnlt9g6EEK2k2tL7kYYahlQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13566-cranberry-nut-bread-DDMFS-step-01-653c8838c75a41e08a99a359ddc44aa5.jpg"
      ],
      "image": "assets/images/13566/step_01.webp"
    },
    {
      "text": "Combine flour, sugar, baking powder, salt, and baking soda in a large bowl. Add cranberries and walnuts; stir until well coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/B8VChyUZgJm1eAJlbyPKZww4D3c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13566-cranberry-nut-bread-DDMFS-step-02-9b97b14025554b92867e0c91ddcdb26e.jpg"
      ],
      "image": "assets/images/13566/step_02.webp"
    },
    {
      "text": "Mix together orange juice, egg, oil, and zest in a medium bowl until combined. Pour over flour mixture; stir until just blended. Spoon batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w05x1WFtZgwptRgwYo5zOyziO9U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13566-cranberry-nut-bread-DDMFS-step-03-dbc9141ce10f46b4b11f1570890b2c5d.jpg"
      ],
      "image": "assets/images/13566/step_03.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center of loaf comes out clean, about 50 minutes. Let cool in the pan briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LGINFr-9_L33xd8K4vtvrXefVwA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/13566-cranberry-nut-bread-DDMFS-step-04-d4735741657c488891ac96035800c5e2.jpg"
      ],
      "image": "assets/images/13566/step_04.webp"
    }
  ],
