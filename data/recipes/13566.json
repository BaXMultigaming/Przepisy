  "title": "Cranberry Nut Bread",
  "description": "This cranberry nut bread is moist and easy to make with fresh cranberries, walnuts, orange juice, and zest for a flavorful festive quick bread.",
  "authors": [
    "Karin Christian"
  ],
  "date_published": "1998-10-31T22:35:32-05:00",
