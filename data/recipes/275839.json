  "ingredients": [
    "1 loaf French bread, cut into 1-inch slices",
    "8 eggs",
    "2 cups half-and-half",
    "1 cup milk",
    "2 tablespoons white sugar",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon salt",
    "1 cup butter, softened",
    "1 cup packed brown sugar",
    "1 cup chopped toasted pecans",
    "2 teaspoons light corn syrup",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg"
  ],
  "steps": [
    {
      "text": "Grease a 9x13-inch baking pan; add bread slices in a row.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs, half-and-half, milk, white sugar, vanilla extract, 1/2 teaspoon cinnamon, 1/4 teaspoon nutmeg, and salt in a large bowl using an electric mixer until combined; pour over bread slices, making sure slices are evenly covered. Cover baking pan with aluminum foil; refrigerate, 8 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, brown sugar, pecans, corn syrup, 1 teaspoon cinnamon, and 1/2 teaspoon nutmeg in a bowl; spread over soaked bread slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and lightly golden, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
