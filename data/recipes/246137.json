  "ingredients": [
    "4 cups tapioca starch",
    "0.75 cup white sugar",
    "0.5 cup butter, softened",
    "2 eggs, beaten",
    "0.5 teaspoon ground cinnamon",
    "0.25 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Line 2 baking sheets with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tapioca flour in a large bowl. Add sugar, butter, eggs, cinnamon, and salt. Mix well until a soft dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pinch off a small piece of dough and roll out into a rope the length of a pencil on your work surface; coil tightly into a spiral. Repeat with remaining dough. Arrange spirals on baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked on the bottom but still pale on top, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
