  "ingredients": [
    "1 pound ground beef",
    "0.5 cup chopped onion",
    "1 tablespoon all-purpose flour",
    "0.5 teaspoon salt",
    "0.25 teaspoon paprika",
    "1 (10.75 ounce) can condensed cream of mushroom soup",
    "1 cup sour cream",
    "8 ounces egg noodles"
  ],
  "steps": [
    {
      "text": "In a large skillet over medium heat, sauté beef and onions for 10 minutes, or until meat is browned and onion is tender.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir in flour, salt, and paprika. Add condensed soup, mix well, and cook, uncovered, for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to low and add sour cream, stirring well and allowing to heat through. Cover and set this mixture aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook egg noodles according to package directions. Drain. Serve beef mixture over noodles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
