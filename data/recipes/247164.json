  "title": "Bacon Caramel",
  "description": "Bacon fat, simple syrup, and molasses are cooked together to make these addictive candy caramels with a spicy kick from red pepper flakes.",
  "authors": [
    "Amy Turner"
  ],
  "date_published": "2020-06-19T00:06:46-04:00",
