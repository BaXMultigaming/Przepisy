  "ingredients": [
    "5 turkey wings",
    "1 small onion, chopped",
    "1 teaspoon seasoned salt",
    "1 teaspoon poultry seasoning",
    "1 teaspoon ground black pepper",
    "1 teaspoon minced garlic",
    "1.5 cups water, divided",
    "1 (10.5 ounce) can cream of mushroom soup"
  ],
  "steps": [
    {
      "text": "Gather ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/oFMAkk2fIqNo4MDlarfhwNPtglM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-234510-easy-baked-turkey-wings-VAT-step-01-76e370eabbb14e36b9c2de9c7841897f.jpg"
      ],
      "image": "assets/images/234510/step_01.webp"
    },
    {
      "text": "Place turkey wings and onion in a casserole dish; sprinkle seasoned salt, poultry seasoning, black pepper, and garlic on both sides of each wing. Pour 1/2 cup water into the casserole dish and cover.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R1OYsWh5XCbjEtZvzjH69Td6YJY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-234510-easy-baked-turkey-wings-VAT-step-02-ea689f08c504426f8b1267d934604277.jpg"
      ],
      "image": "assets/images/234510/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until browned, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/R0_0XuQyOx3HozZn4mf8yRNJZW4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-234510-easy-baked-turkey-wings-VAT-step-03-4895a9065ac4426bb210c58af7bf9140.jpg"
      ],
      "image": "assets/images/234510/step_03.webp"
    },
    {
      "text": "Stir cream of mushroom soup and 1 cup water together in a bowl; pour over turkey wings in the casserole dish and return to the oven, uncovered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ER4vJtKP8NPqesSXXFc1eizHd74=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-234510-easy-baked-turkey-wings-VAT-step-04-4ecd6cd40a9040e6ab1c872cead13423.jpg"
      ],
      "image": "assets/images/234510/step_04.webp"
    },
    {
      "text": "Continue baking, uncovered, until golden brown, about 1 hour more. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/VefLOVznjq2WL0Ml1Qf21Lpad5E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-234510-easy-baked-turkey-wings-VAT-step-05-b1921799648b49e29d4cad5aa9d56636.jpg"
      ],
      "image": "assets/images/234510/step_05.webp"
    }
