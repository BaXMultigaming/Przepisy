  "ingredients": [
    "1 cup whole milk",
    "0.5 cup cottage cheese",
    "2 eggs, beaten",
    "1.5 tablespoons dried minced onion",
    "1 teaspoon salt",
    "0.5 teaspoon dried basil",
    "0.25 teaspoon dried parsley",
    "5 plum tomatoes, diced",
    "1 (9 inch) unbaked pie shell",
    "1.25 cups shredded Swiss cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, cottage cheese, eggs, onion, salt, basil, and parsley together in a large bowl. Spread tomatoes evenly in the pie shell; sprinkle with Swiss cheese. Pour egg mixture over tomatoes and cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set in center, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
