  "ingredients": [
    "1 cup sweet green pickle relish",
    "1 (5.5 ounce) can tomato paste",
    "2 tablespoons jarred roasted red peppers with garlic, finely chopped",
    "1 teaspoon white vinegar",
    "0.5 teaspoon white sugar",
    "6 drops liquid smoke flavoring",
    "1 pinch ground black pepper",
    "1 dash ground cinnamon"
  ],
  "steps": [
    {
      "text": "Mix relish, tomato paste, roasted red peppers, vinegar, sugar, liquid smoke, black pepper, and cinnamon together in a bowl. Spoon mixture into a clean glass jar and screw the lid on tightly. Store in the refrigerator.",
