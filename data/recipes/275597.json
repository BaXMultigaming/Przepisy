  "ingredients": [
    "1 cup pomegranate juice (such as POM® Wonderful)",
    "0.33333334326744 cup orange juice",
    "2 cloves garlic, minced",
    "4 teaspoons minced fresh ginger root",
    "1 tablespoon brown sugar",
    "1 teaspoon salt",
    "1 teaspoon freshly ground black pepper",
    "2 pounds uncooked medium shrimp, peeled and deveined"
  ],
  "steps": [
    {
      "text": "Combine pomegranate juice, orange juice, garlic, ginger, brown sugar, salt, and pepper in a small bowl; mix marinade until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place shrimp into a zip-top bag or deep glass bowl. Pour marinade over shrimp and stir well to coat. Marinate in the refrigerator for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Thread shrimp onto metal skewers and discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until shrimp are pink and slightly curled, about 3 minutes per side. Remove from the grill and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
