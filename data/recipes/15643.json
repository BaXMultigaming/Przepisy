  "ingredients": [
    "3 cups diced rhubarb",
    "1 cup white sugar",
    "3 tablespoons all-purpose flour",
    "1.5 cups all-purpose flour",
    "1 cup packed light brown sugar",
    "1 cup quick cooking oats",
    "1 cup butter"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C). Lightly grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place rhubarb in a large mixing bowl. Add white sugar and 3 tablespoons flour; stir well to coat and spread evenly in the bottom of the prepared baking dish. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 1 ½ cups flour, brown sugar, and oats in a separate mixing bowl; cut in butter until the mixture is crumbly. Sprinkle crumble mixture over rhubarb layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until rhubarb filling is bubbling and crumble on top is golden brown, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
