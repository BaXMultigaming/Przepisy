  "ingredients": [
    "1 (18.25 ounce) package yellow cake mix",
    "1 (3.5 ounce) package instant vanilla pudding mix",
    "4 eggs",
    "0.5 cup vegetable oil",
    "5 fluid ounces Galliano liqueur",
    "2 fluid ounces vodka",
    "0.5 cup orange juice",
    "1 cup confectioners' sugar"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour one 10 inch tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cake mix and pudding mix in a large bowl. Blend in eggs, vegetable oil, 4 ounces Galliano, 1 ounce vodka, and 4 ounces orange juice. Mix batter until smooth and thick and pour into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees for 45 minutes. Let cake cool in pan for 10 minutes then remove and place on cooling rack. Spoon glaze over cake while it is still warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Glaze: Combine the remaining 1 ounce Galliano, 1 ounce vodka, and 1ounce orange juice with the confectioner's sugar and blend until smooth. Spoon glaze over warm cake.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
