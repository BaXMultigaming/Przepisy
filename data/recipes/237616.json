  "ingredients": [
    "2 cups all-purpose flour",
    "2.75 cups white sugar, divided",
    "1 cup cold butter, cut into cubes",
    "7 tablespoons all-purpose flour",
    "1 cup heavy whipping cream",
    "3 eggs",
    "5 cups finely chopped rhubarb",
    "1 (8 ounce) package cream cheese, softened",
    "1 teaspoon vanilla extract",
    "1 (8 ounce) container frozen whipped topping (such as Cool Whip®), thawed"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine 2 cups flour and 1/4 cup sugar in a bowl. Cut butter into flour mixture until it resembles coarse crumbs; press into a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crust is lightly browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 2 cups sugar and 7 tablespoons flour together in a bowl; whisk in heavy whipping cream and eggs until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread rhubarb evenly over crust. Pour egg mixture over rhubarb.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bars are set, about 45 minutes. Cool to room temperature, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat cream cheese, remaining 1/2 cup sugar, and vanilla extract together in a bowl until smooth and creamy; fold in whipped topping. Spread cream cheese mixture over rhubarb layer; chill in refrigerator.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
