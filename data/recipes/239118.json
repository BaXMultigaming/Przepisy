  "ingredients": [
    "1 cup all-purpose flour",
    "0.25 cup white sugar",
    "0.5 cup cold butter",
    "2 eggs, beaten",
    "2 tablespoons melted butter",
    "1 cup brown sugar",
    "2 tablespoons all-purpose flour",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon vanilla extract",
    "1 cup raisins",
    "0.5 cup chopped pecans"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 1 cup flour and white sugar together in a bowl; cut 1/2 cup cold butter into flour mixture with a pastry blender until crumbly. Press flour mixture evenly into the bottom of a 9-inch square cake pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Remove to cool slightly, leaving oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs and 2 tablespoons melted butter together in a bowl; whisk in brown sugar, 2 tablespoons flour, baking powder, and vanilla extract. Stir raisins and pecans into egg mixture; pour over the base.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top springs back when touched, about 20 minutes. Cool completely before cutting into squares.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
