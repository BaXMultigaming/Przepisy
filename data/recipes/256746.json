  "ingredients": [
    "2 tablespoons butter",
    "1 tablespoon olive oil",
    "0.25 cup finely chopped onion",
    "1 large clove garlic, minced",
    "3 tablespoons all-purpose flour",
    "1 cup milk, or more as needed",
    "0.5 cup grated Parmesan cheese",
    "2 tablespoons minced fresh basil",
    "0.5 teaspoon chopped fresh oregano",
    "0.25 teaspoon salt",
    "0.125 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5MNR4QK8m4Lyud6aNr3ovUErIHI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256746-White-Pizza-Sauce-4x3-step-01-ad7bf558a76145fc848c3f1a02ee5730.jpg"
      ],
      "image": "assets/images/256746/step_01.webp"
    },
    {
      "text": "Heat butter and olive oil in a small saucepan over medium heat; stir in onion and garlic. Whisk in flour until lightly browned and onion is tender, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ZaIKs98P03-MPp4VrhQBoCj9H_k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256746-White-Pizza-Sauce-4x3-step-02-7057b29fb02040a7852e42e7c758f56a.jpg"
      ],
      "image": "assets/images/256746/step_02.webp"
    },
    {
      "text": "Add 1 cup milk, Parmesan cheese, basil, oregano, salt, and black pepper; cook, whisking continuously, until cheese is melted and sauce has thickened slightly, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bXobrcLsCrFoZMzW7lM7koObaDA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-256746-White-Pizza-Sauce-4x3-step-03-e27755d1c1bc4e8ba55a491a829008d5.jpg"
      ],
      "image": "assets/images/256746/step_03.webp"
    },
    {
      "text": "Add more milk if sauce is too thick. Remove from heat.",
