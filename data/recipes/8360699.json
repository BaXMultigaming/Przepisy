  "ingredients": [
    "1 tablespoon olive oil",
    "1.5 cups thinly sliced leeks",
    "2 cloves garlic, minced",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon ground turmeric",
    "0.75 teaspoon kosher salt, divided",
    "7 large eggs",
    "1 teaspoon baking powder",
    "0.5 cup chopped fresh Italian parsley",
    "0.333 cup chopped fresh cilantro",
    "3 tablespoons chopped fresh dill",
    "2 tablespoons lemon juice",
    "1 teaspoon lemon zest",
    "2 tablespoons butter"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in an 8-inch oven-safe skillet. Add leeks; cook until softened and translucent, about 5 minutes. Add garlic; cook until fragrant, about 30 seconds. Stir in pepper, cumin, turmeric, and 1/4 teaspoon salt and cook until fragrant, about 1 minute. Remove from the heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk eggs in a large bowl. Whisk in baking powder and remaining 1/2 teaspoon salt until combined. Fold in leek mixture, parsley, cilantro, dill, lemon juice, and lemon zest.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add butter to the skillet and transfer to the preheated oven. Heat until melted, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove skillet and swirl so butter evenly coats it. Add egg mixture. (Do not stir.)",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and bake until edges are set and middle is still slightly moist, 15 to 18 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Let cool in the skillet for 10 minutes before cutting into 8 slices.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
