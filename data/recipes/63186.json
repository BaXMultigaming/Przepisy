  "ingredients": [
    "1 cup peeled, chopped zucchini",
    "1.5 cups milk",
    "1 cup sweetened flaked coconut, divided",
    "0.66666668653488 cup sugar",
    "3 eggs",
    "1 teaspoon vanilla extract",
    "1 pinch salt",
    "1 (9 inch) unbaked pie crust",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Boil 1 inch water in a small saucepan over medium heat. Add zucchini; cover and cook until softened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place zucchini, milk, ¾ cup coconut, sugar, eggs, vanilla extract, and salt in a blender or the bowl of a food processor; blend until smooth. Pour into pie crust; sprinkle with remaining ¼ cup coconut and nutmeg.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 10 minutes. Reduce the oven temperature to 350 degrees F (175 degrees C); continue baking until a knife inserted in center comes out clean, about 50 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
