  "ingredients": [
    "2 tablespoons vegetable oil",
    "2 cups dry bread crumbs",
    "1 cup ranch-style salad dressing (such as Hidden Valley® Original Ranch®)",
    "4 skinless, boneless chicken breast halves - lightly pounded to an even thickness"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease baking sheet with vegetable oil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Put bread crumbs and ranch dressing into separate bowls.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Dip chicken into ranch dressing and press into bread crumbs to coat. Gently toss between your hands so any bread crumbs that haven't stuck can fall away. Arrange onto prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until no longer pink in the center and the juices run clear, about 30 minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
