  "ingredients": [
    "1 cup water",
    "2 tablespoons soy sauce",
    "0.5 teaspoon salt",
    "1 cup uncooked instant rice",
    "1 teaspoon vegetable oil",
    "0.5 onion, finely chopped",
    "0.5 cup green beans",
    "1 large egg, lightly beaten",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
