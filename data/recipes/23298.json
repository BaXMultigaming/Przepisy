      ],
      "image": "assets/images/23298/step_01.webp"
    },
    {
      "text": "Bring water, soy sauce, and salt to a boil in a medium saucepan. Stir in instant rice and remove from heat. Cover and let stand for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/qbPmd0PEVCRQfkF1pUptcSk475c=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-23298-egg-fried-rice-VAT-step-02-1-lid-on-8f3fef1bb11e4de189c5d02bbb0a2f37.jpg"
      ],
      "image": "assets/images/23298/step_02.webp"
    },
    {
      "text": "Heat oil in a medium skillet or wok over medium heat. Sauté onions and green beans or peas in hot oil for 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0AEd9bqwDADOiAvXUO5cz7N4ohc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-23298-egg-fried-rice-VAT-step-03-2spooninframe-c357b702363945e183185ad18770ca4a.jpg"
      ],
      "image": "assets/images/23298/step_03.webp"
    },
    {
      "text": "Pour in beaten egg and fry for 2 minutes, scrambling egg while it cooks.",
      "section": null,
      "name": null,
      "url": null,
