  "ingredients": [
    "1 (10.5 ounce) can condensed tomato soup",
    "1 teaspoon baking soda",
    "1 cup white sugar",
    "0.33333334326744 cup butter",
    "1 egg",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground cloves",
    "0.5 teaspoon salt",
    "1.5 cups self-rising flour",
    "1 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly grease a 10-inch square baking dish. Combine tomato soup and baking soda in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, butter, egg, cinnamon, cloves, and salt in a large bowl with an electric mixer until smooth. Mix in tomato soup and soda mixture; stir in flour and raisins. Pour cake batter into a greased baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
