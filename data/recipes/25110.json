  "title": "The Perfect Chocolate Chip Cookie",
  "description": "These are the perfect chocolate chip cookies! Made with vegetable oil instead of butter and they contain both almond and vanilla extracts!",
  "authors": [
    "Emily"
  ],
  "date_published": "2020-06-18T23:06:01-04:00",
