  "ingredients": [
    "0.25 cup cornstarch",
    "0.33333334326744 cup sugar",
    "2 cups milk",
    "2 eggs, lightly beaten",
    "2 tablespoons butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine cornstarch and sugar in a medium microwave safe bowl. Gradually whisk in milk.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on High until thickened and boiling, about 5 to 7 minutes, stirring every 2 minutes. Gradually beat half the hot cornstarch mixture into the eggs, then stir eggs back into remaining cornstarch mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Microwave on High until thickened and heated through, about 1 to 3 minutes, stirring every 45 seconds. Whisk in butter and vanilla. Serve warm.",
      "section": null,
