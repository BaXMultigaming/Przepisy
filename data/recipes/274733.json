  "ingredients": [
    "nonstick cooking spray",
    "3 pounds yellow squash, sliced",
    "1 (10.5 ounce) can condensed cream of mushroom soup",
    "1 (8 ounce) package shredded sharp Cheddar cheese",
    "1 cup mayonnaise",
    "0.5 cup chopped sweet onions",
    "1 large egg",
    "1 teaspoon salt",
    "0.5 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Spray a casserole dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine yellow squash, cream of mushroom soup, Cheddar cheese, mayonnaise, onion, egg, salt, and pepper in a bowl. Mix until well combined and transfer to the casserole dish and cover with foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cooked through and bubbly, about 45 minutes.",
