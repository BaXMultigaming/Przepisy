  "ingredients": [
    "1 (15.5 ounce) can garbanzo beans, drained",
    "1 (15 ounce) can kidney beans, drained",
    "1 lemon, zested and juiced",
    "1 medium tomato, chopped",
    "0.25 cup chopped red onion",
    "0.5 cup chopped fresh parsley",
    "1 teaspoon capers, rinsed and drained",
    "3 tablespoons extra virgin olive oil",
    "0.5 teaspoon salt, or to taste"
  ],
  "steps": [
    {
      "text": "In a large bowl, stir together the garbanzo beans, kidney beans, lemon juice and zest, tomato, onion, parsley, capers, olive oil and salt. Cover, and refrigerate for about 2 hours, stirring occasionally, before serving.",
