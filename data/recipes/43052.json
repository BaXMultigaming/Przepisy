  "ingredients": [
    "6 eggs",
    "2 teaspoons water",
    "1.5 teaspoons dried tarragon",
    "1.5 teaspoons dried marjoram",
    "1.5 teaspoons dried parsley",
    "1 teaspoon butter",
    "0.5 cup shredded Cheddar cheese"
  ],
  "steps": [
    {
