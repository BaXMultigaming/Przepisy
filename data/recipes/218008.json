  "ingredients": [
    "6 cups fresh blackberries",
    "1.5 cups white sugar",
    "1 teaspoon ground cinnamon",
    "0.25 teaspoon ground nutmeg",
    "1 (18.25 ounce) package yellow cake mix",
    "0.5 cup melted margarine"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a 9x13-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine blackberries, sugar, cinnamon, and nutmeg in a bowl until evenly blended. Spread evenly into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cake mix in a separate bowl. Mix in butter until crumbly; sprinkle evenly over top of berries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until the mixture is bubbly, and the topping is golden brown, 40 to 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
