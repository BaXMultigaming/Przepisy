  "ingredients": [
    "2 cups mashed sweet potatoes",
    "3 eggs, beaten",
    "1 cup evaporated milk",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "0.5 teaspoon salt",
    "1 (9 inch) unbaked deep dish pie crust"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix the sweet potatoes, eggs, evaporated milk, cinnamon, nutmeg, cloves and salt. Pour into the pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 50 minutes, or until a knife inserted in center comes out clean. Top with whipped topping or serve warm with vanilla ice cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
