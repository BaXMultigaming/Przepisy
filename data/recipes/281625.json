  "ingredients": [
    "1 (12 ounce) package dry fettuccine pasta",
    "1 (8 ounce) package cream cheese, softened",
    "1 cup mashed cooked butternut squash",
    "0.5 cup salted butter, cubed",
    "0.5 cup milk",
    "2 cloves garlic, minced",
    "0.125 teaspoon ground nutmeg",
    "0.66666668653488 cup grated Parmesan cheese",
    "1 tablespoon olive oil",
    "1 medium zucchini, quartered and sliced",
    "1 medium Squash, summer, yellow, raw",
    "6 medium fresh mushrooms, quartered",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Fill a large pot with lightly salted water and bring to a rolling boil. Cook fettuccine at a boil until tender yet firm to the bite, about 8 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While pasta cooks, combine cream cheese, butternut squash, butter, milk, garlic, and nutmeg in a large saucepan. Cook over medium heat, stirring often, until all ingredients are blended. Stir in Parmesan cheese and mix until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large saute pan over medium-high heat. Saute zucchini, yellow squash, and mushrooms until tender, 7 to 10 minutes. Season with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drain pasta, toss with vegetables on a large serving platter, and pour Alfredo sauce over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
