  "title": "Barbecue Pork Chops Medley",
  "description": "Tender pork chops cooked in individual foil packets with veggies and barbecue sauce make a quick and easy dinner.",
  "authors": [
    "Reynolds KitchensR"
  ],
  "date_published": "2012-05-25T20:41:33-04:00",
  "date_modified": "2022-02-11T13:47:39-05:00",
