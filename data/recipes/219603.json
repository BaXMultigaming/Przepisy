  "title": "Sweet Potato Cranberry Sauce Bread",
  "description": "Mashed sweet potatoes and cranberry sauce left over after Thanksgiving can be used up in this easy recipe for a moist delicious bread.",
  "authors": [
    "smileysdynamite"
  ],
  "date_published": "2020-06-18T23:46:51-04:00",
