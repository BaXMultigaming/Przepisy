  "keywords": [],
  "ingredients": [
    "1 cup cranberry sauce, or more to taste",
    "1 cup cooked and mashed sweet potatoes",
    "3 eggs",
    "0.75 cup white sugar",
    "0.5 cup vegetable oil",
    "0.5 cup brown sugar",
    "1 teaspoon vanilla extract",
    "3 cups all-purpose flour",
    "1 teaspoon ground nutmeg",
    "1 teaspoon ground allspice",
    "1 teaspoon baking soda",
    "0.5 teaspoon baking powder",
    "1 cup raisins, or more to taste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 4 mini loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cranberry sauce, sweet potatoes, eggs, white sugar, oil, brown sugar, and vanilla extract in a large bowl; beat with an electric mixer until smooth. Add flour, nutmeg, allspice, baking soda, and baking powder; mix well. Fold raisins into the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Divide batter evenly among the loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 45 minutes. Place loaf pans on a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
