  "ingredients": [
    "0.5 pound French green lentils, rinsed and drained",
    "2 cups water",
    "1 (15 ounce) can dark red kidney beans, drained and rinsed",
    "1 (14 ounce) can corn, drained",
    "0.25 cup chopped fresh parsley, or to taste",
    "0.33333334326744 cup olive oil",
    "0.33333334326744 cup balsamic vinaigrette",
    "1 tablespoon white sugar",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine lentils and water in a saucepan; bring to a boil. Cook lentils at a boil until tender, about 20 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix kidney beans, corn, and parsley in a bowl; add lentils and gently stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, balsamic vinaigrette, sugar, salt, and black pepper together in a separate bowl; drizzle over lentil mixture and gently stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover bowl with plastic wrap; refrigerate until lentils are completely chilled, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
