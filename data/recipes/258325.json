  "ingredients": [
    "1.25 cups all-purpose flour",
    "2 teaspoons baking powder",
    "0.75 teaspoon salt",
    "0.125 teaspoon baking soda",
    "3 tablespoons shortening",
    "0.33333334326744 cup milk",
    "0.33333334326744 cup sour cream"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking powder, salt, and baking soda together in a bowl; cut in shortening until mixture is crumbly. Add milk and sour cream; stir until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a floured work surface; knead 10 times. Roll dough out; cut into biscuits. Place biscuits on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until biscuits are lightly browned, about 10 minutes.",
