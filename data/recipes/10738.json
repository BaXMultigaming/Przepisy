  "ingredients": [
    "1 cup shortening",
    "1.5 cups white sugar",
    "2 eggs",
    "2.5 cups all-purpose flour",
    "2 teaspoons cream of tartar",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.25 cup white sugar",
    "2 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix the shortening , sugar, and eggs until creamy. Mix the flour, cream of tartar, baking soda and salt in another bowl. Blend the wet with the dry ingredients using a wooden spoon until well-blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll the dough into the size of small walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prepare the cinnamon and sugar mixture by mixing the cinnamon and sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll the cookie dough into the cinnamon and sugar mixture until coated and place onto an ungreased cookie sheet. Bake 6-10 minutes watching to make sure they don't burn. They should be very lightly brown and still soft looking on top. When they cool, they will crack a little on top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
