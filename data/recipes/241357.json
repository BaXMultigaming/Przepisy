  "ingredients": [
    "2 cups elbow macaroni",
    "1 pound ground beef",
    "2 tablespoons onion powder",
    "1 tablespoon garlic powder",
    "1 teaspoon salt",
    "1 teaspoon ground black pepper",
    "2 cups ketchup",
    "2 cups shredded Cheddar cheese",
    "1 cup bacon bits"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in boiling water until cooked through but firm to the bite, 8 minutes; drain and return pasta to the pot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir beef in the hot skillet until browned and crumbly, 5 to 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season browned beef with onion powder, garlic powder, salt, and pepper; add ketchup and stir. Bring mixture to a simmer, reduce heat to medium-low, and cook until the liquid thickens slightly, 5 to 10 minutes; pour over the pasta in the pot and stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir Cheddar cheese into the pasta mixture until melted; add bacon bits and stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
