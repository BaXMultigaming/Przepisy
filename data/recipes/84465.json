  "ingredients": [
    "0.25 cup vegetable oil",
    "0.5 cup milk",
    "1 egg",
    "1 lemon, zested and juiced",
    "1 cup all-purpose flour",
    "0.75 cup whole wheat flour",
    "0.5 teaspoon salt",
    "1 teaspoon baking powder",
    "0.5 cup white sugar",
    "0.25 cup packed brown sugar",
    "1 cup chopped fresh strawberries"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C). Line a muffin pan with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a bowl, lightly beat together the oil, milk, egg, and lemon juice. In a separate bowl, mix the lemon zest, all-purpose flour, whole wheat flour, salt, baking powder, white sugar, and brown sugar. Mix strawberries into the flour mixture. Stir in the oil mixture just until moist. Fill muffin cups about 3/4 full with the batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25 minutes in the preheated oven, or until a toothpick inserted in the center of a muffin comes out clean. Allow to cool 10 minutes before removing from the muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
