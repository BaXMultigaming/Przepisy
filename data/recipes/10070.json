  "ingredients": [
    "waxed paper",
    "0.5 cup butter",
    "4 cups miniature marshmallows",
    "1 teaspoon green food coloring, or as needed",
    "0.5 teaspoon almond extract",
    "0.5 teaspoon vanilla extract",
    "4 cups cornflakes cereal",
    "1 (2.25 ounce) package cinnamon red hot candies"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fvanoH0hHol_-tI_v9umtM1l4ow=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10070-christmas-cornflake-wreath-cookies-VAT-ingredients-4x3-40716fdb14d84a1fb31bc136161eb104.jpg"
      ],
      "image": "assets/images/10070/step_01.webp"
    },
    {
      "text": "Line a baking tray with waxed paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place marshmallows and butter in a microwave-safe bowl; microwave on high for 2 minutes. Stir, then microwave on high for 2 minutes more; stir.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/bCLIUq9UNV1hZez5T764WNyehsc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10070-christmas-cornflake-wreath-cookies-VAT-02-4x3-e8a079d965ca4a0dbcdb864eb868d057.jpg"
      ],
      "image": "assets/images/10070/step_03.webp"
    },
    {
      "text": "Mix in coloring, almond extract, and vanilla until the desired color is reached; gently stir in cornflakes to coat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5EBgMB3jpvB3eysrHvsHGWs3jYk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10070-christmas-cornflake-wreath-cookies-VAT-03-4x3-c7c8c42c867542218c040d5297d512ea.jpg"
      ],
      "image": "assets/images/10070/step_04.webp"
    },
    {
      "text": "Drop by tablespoonfuls onto the prepared tray and use lightly greased fingers to form wreath shapes; decorate with 3 red hots each.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/267RiGPQ0P8BJnJ-902Q-bGhMH0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10070-christmas-cornflake-wreath-cookies-VAT-05-4x3-5f97145814d24545b6dc2c4013e779aa.jpg"
      ],
      "image": "assets/images/10070/step_05.webp"
    },
    {
      "text": "Allow cookies to cool and set, about 15 minutes; store in an airtight container.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xijQJn5_mzn4GLQDOq-YBQF4lFw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10070-christmas-cornflake-wreath-cookies-VAT-hero-4x3-c4293420f6444e549d846e97bf2943c4.jpg"
