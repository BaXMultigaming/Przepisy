  "ingredients": [
    "6 (6 ounce) fillets halibut",
    "2 tablespoons olive oil",
    "2 tablespoons fresh lime juice",
    "0.5 teaspoon dried thyme",
    "0.5 teaspoon dried basil",
    "0.25 teaspoon dried oregano",
    "0.125 teaspoon dried rosemary"
  ],
  "steps": [
    {
      "text": "Place halibut fillets in a shallow baking dish. In a bowl, whisk together the olive oil, lime juice, thyme, basil, oregano, and rosemary. Pour marinade over fish, cover, and refrigerate 2 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat grill for medium heat. Adjust grate height to between 4 and 6 inches from heat source.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Lightly oil grill grate. Remove halibut from dish, and discard marinade. Cook for 5 minutes per side, or until fish can be easily flaked with a fork.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
