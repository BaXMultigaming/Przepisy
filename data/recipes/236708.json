  "ingredients": [
    "6 (4 ounce) boneless, skinless chicken breasts, trimmed of excess fat",
    "1 teaspoon freshly grated lemon peel",
    "0.25 cup fresh lemon juice",
    "2 teaspoons minced fresh garlic",
    "0.25 teaspoon salt",
    "2 tablespoons Mazola® Corn Oil",
    "0.5 cup loosely packed fresh basil leaves"
  ],
  "steps": [
    {
      "text": "Lightly pound chicken to an even 3/4-inch thickness. Pat chicken dry using paper towels and place in a large resealable plastic bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine lemon peel, lemon juice, garlic, salt, oil and basil in a blender or food processor. Pulse for 30 seconds or until well blended.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour the marinade over the chicken, seal the bag and turn to coat chicken thoroughly. Marinate in the refrigerator for at least 15 minutes to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat grill to medium-high heat or about 400 degrees F.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken from marinade and discard marinade.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Grill for 4 to 6 minutes per side or until cooked through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer to serving plate and garnish with additional basil, if desired.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
