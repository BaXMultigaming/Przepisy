  "ingredients": [
    "1 teaspoon butter",
    "4 pork chops",
    "salt and freshly ground black pepper to taste",
    "1.75 cups heavy whipping cream",
    "5 tablespoons all-purpose flour",
    "1.75 cups shredded Emmental cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees. Butter a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pound pork chops with a meat mallet until thin and rub lightly with salt and pepper. Place in the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir heavy cream and flour together in a small bowl and season with salt. Pour over pork. Sprinkle with Emmental cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until pork is cooked through and cheese is melted and slightly browned, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
