  "ingredients": [
    "0.66666668653488 cup white sugar",
    "4 eggs, separated",
    "2 tablespoons grapeseed oil",
    "2 tablespoons honey",
    "2 tablespoons milk",
    "1 cup all-purpose flour",
    "2 teaspoons green tea powder (matcha)"
  ],
  "steps": [
    {
      "text": "Preheat oven to 320 degrees F (160 degrees C). Grease a small loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar and egg whites together in a bowl using an electric mixer until stiff peaks form. Add egg yolk and mix well. Stir grapeseed oil, honey, and milk into egg mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour and green tea powder 2 times into a bowl; mix into egg mixture. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted in the center comes out clean, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
