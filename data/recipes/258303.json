  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Sift flour and baking powder together in a mixing bowl. Stir in lemon zest and salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add softened vegan margarine, canola oil, sugar, vanilla and Almond Breeze Almondmilk Vanilla. Mix well.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fold in blueberries and raspberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into muffin tin, and bake at 350 degrees F for 25 minutes or until toothpick comes out clean.",
      "section": null,
