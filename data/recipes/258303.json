  "ingredients": [
    "0.5 cup Almond Breeze Vanilla almondmilk",
    "2 cups Blue Diamond Almond Flour",
    "1 tablespoon baking powder",
    "1 lemon, zested",
    "0.5 teaspoon salt",
    "0.33333334326744 cup vegan margarine, softened",
    "0.33333334326744 cup canola oil",
    "1 cup sugar",
    "1 teaspoon vanilla",
