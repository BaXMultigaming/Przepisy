  "ingredients": [
    "1 pound ground beef",
    "2 (14.5 ounce) cans diced tomatoes",
    "2 cups cubed potatoes",
    "2 carrots, chopped",
    "1 onion, chopped",
    "4 teaspoons salt",
    "0.25 cup uncooked white rice",
    "0.125 teaspoon ground black pepper",
    "6 cups water"
  ],
  "steps": [
    {
      "text": "In a large saucepan over medium heat, saute the ground beef for 5 minutes, or until browned. Drain the excess fat and add the tomatoes with liquid, potatoes, carrots, onion, salt, rice, black pepper and water. Bring to a boil and reduce heat to low. Simmer for 1 hour and serve.",
