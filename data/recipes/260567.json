  "ingredients": [
    "1/4 cup shea butter",
    "3 tablespoons coconut oil",
    "1 tablespoon argan oil",
    "2 tablespoons aloe vera juice",
    "3 to 4 capsules vitamin E oil",
    "7 drops rosemary essential oil"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dxTiQK2LCnrJp4y8Ejg8az1F4M8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-260567-homemade-hair-growth-conditioner-ddmfs-step1-3x4-13511-dd4627b71c834c93a51a201e55b7c4bc.jpg"
      ],
      "image": "assets/images/260567/step_01.webp"
    },
    {
      "text": "Combine shea butter, coconut oil, and argan oil in the top of a double boiler over simmering water. Stir occasionally until melted, about 5 minutes. Remove from the heat and let cool slightly, about 5 minutes; don't let it solidify.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dJS7uDpZGeEE0se4FSov7fgQjJk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-260567-homemade-hair-growth-conditioner-ddmfs-step3-3x4-13522-cee36b9e58c9404db2c2acc5e083f85b.jpg"
      ],
      "image": "assets/images/260567/step_02.webp"
    },
    {
      "text": "Pour mixture into a food processor; process on high speed until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l9vJ8hdpPEZ0llk_pfhxx7EldWY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-260567-homemade-hair-growth-conditioner-ddmfs-step4-3x4-13525-3c5e699e8cf94b2296b2700c7e1b7017.jpg"
      ],
      "image": "assets/images/260567/step_03.webp"
    },
    {
      "text": "Pour aloe vera juice in slowly, with the processor running, and blend until creamy, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/_cUPYOPFBOUUpUEXWw6yNGA3msg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-260567-homemade-hair-growth-conditioner-ddmfs-step5-3x4-13540-6385e62dce33445bbfa1ccbd5453529a.jpg"
      ],
      "image": "assets/images/260567/step_04.webp"
    },
    {
      "text": "Add vitamin A oil and essential oil; blend until incorporated.",
