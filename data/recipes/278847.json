  "ingredients": [
    "cooking spray (such as Pam®)",
    "0.66666668653488 cup vegetable oil",
    "0.5 cup water",
    "2 eggs",
    "2 (20 ounce) packages double-chocolate brownie mix (such as Ghirardelli®)",
    "1 (16 ounce) jar apricot jam",
    "1 cup chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Grease a 9x13-inch baking pan generously with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix oil, water, and eggs together in a bowl. Stir in brownie mix until just moistened. Spread 2/3 of the batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While brownies are baking, warm apricot jam in a small saucepan over medium-low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove brownies from the oven and sprinkle chocolate chips over top. Spread warm jam over the entire surface. Drop spoonfuls of the remaining brownie batter over the surface of the jam.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return to the oven and continue to bake until edges are dry but brownies still look slightly underdone, 20 to 25 minutes. Remove from the oven and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
