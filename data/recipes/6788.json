    "publisher-tested"
  ],
  "ingredients": [
    "2 cups warm water (110 degrees F/45 degrees C)",
    "0.66666668653488 cup white sugar",
    "1.5 tablespoons active dry yeast",
    "0.25 cup vegetable oil",
    "1.5 teaspoons salt",
    "6 cups bread flour"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/EC_tl6645wiBMU33agLmhrEcExc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6788-Amish-White-Bread-ddmfs-step1-4x3.4998-4d3d60891b344626b216e1b01eacdc7c.jpg"
      ],
      "image": "assets/images/6788/step_01.webp"
    },
    {
      "text": "Dissolve sugar in warm water in a large bowl, and then stir in yeast. Allow to proof until yeast resembles a creamy foam, 5 to 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nKpdJBLtijsCKRldr7uuiIT5GyE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6788-Amish-White-Bread-ddmfs-step2-4x3.5010-5bbd39351f434443ae5280bdb164b343.jpg"
      ],
      "image": "assets/images/6788/step_02.webp"
    },
    {
      "text": "Mix oil and salt into the yeast. Mix in flour one cup at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rUo-VC158YABg_6ythuRSQuDXi0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6788-Amish-White-Bread-ddmfs-step3-4x3.5011-dcfac67c1a3041a38bebf8fa80526ed9.jpg"
      ],
      "image": "assets/images/6788/step_03.webp"
    },
    {
      "text": "Knead dough on a lightly floured surface until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zt6uVJpooQrtt2UGt_5BZVhcrmk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6788-Amish-White-Bread-ddmfs-step4-4x3.5017-a33383ccb7844e959fab9cc252e5bbf0.jpg"
      ],
      "image": "assets/images/6788/step_04.webp"
    },
    {
      "text": "Place in a well-oiled bowl, and turn dough to coat. Cover with a damp cloth. Allow to rise until doubled in bulk, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Es6uAYbP2u1cK8rhVte0L4S5juQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6788-Amish-White-Bread-ddmfs-step5-4x3.5020-ea1c6387048e442ab3113d077daec7ea.jpg"
      ],
      "image": "assets/images/6788/step_05.webp"
    },
    {
      "text": "Punch dough down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/PV0Q0Eg7djw3sQF8XvZcAzgn_F4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6788-Amish-White-Bread-ddmfs-step6-4x3.5047-adeb58c0df734c5c8673816550261d2f.jpg"
      ],
      "image": "assets/images/6788/step_06.webp"
    },
    {
      "text": "Knead for a few minutes, and divide in half. Shape into loaves, and place into two well-oiled 9x5-inch loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uYdxOl2_Grr_D4NOfoSYViCc398=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6788-Amish-White-Bread-ddmfs-step7-4x3.5054-0a0564dc07cd4e9585013bec7e5e536c.jpg"
      ],
      "image": "assets/images/6788/step_07.webp"
    },
    {
      "text": "Allow to rise until dough has topped the pans by one inch, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1-hCzTKw6bJPrvsvF8ZFOvyII_A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6788-Amish-White-Bread-ddmfs-step8-4x3.5091-122bb097955648ecb840dd5dc287424c.jpg"
      ],
      "image": "assets/images/6788/step_08.webp"
    },
    {
      "text": "Meanwhile, preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake the risen loaves in the preheated oven until golden brown for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CjzJwg2pACUzGODdxJL1BJDRx9Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/6788-amish-white-bread-DDMFS-4x3-6faa1e552bdb4f6eabdd7791e59b3c84.jpg"
      ],
      "image": "assets/images/6788/step_11.webp"
    }
  ],
