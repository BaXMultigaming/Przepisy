  "ingredients": [
    "1 cup butter, softened",
    "2 cups white sugar",
    "2 teaspoons ground cinnamon",
    "0.5 teaspoon salt",
    "3 eggs",
    "0.75 cup sour cream",
    "1 teaspoon vanilla extract",
    "2.5 cups all-purpose flour",
    "1 teaspoon baking powder",
    "1 (10 ounce) package cinnamon chips (such as HERSHEY'S®)",
    "3 tablespoons white sugar",
    "3 teaspoons ground cinnamon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease 4 mini loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the bread: Cream together sugar, butter, cinnamon, and salt with an electric mixer until fluffy, about 5 minutes. Add eggs and mix until combined. Add sour cream and vanilla, and mix until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and baking powder in a separate bowl. Add to egg mixture and mix well. Stir cinnamon chips into batter. Spoon batter into 4 mini loaf pans until 2/3 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the topping: Mix 3 tablespoons sugar and cinnamon together in a small bowl. Sprinkle topping evenly over the batter in each loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the centers come out clean, 35 to 38 minutes. Let cool completely before removing from the pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
