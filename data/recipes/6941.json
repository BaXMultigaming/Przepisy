  "title": "Zucchini Coconut Loaf",
  "description": "All the standard ingredients are here, including cinnamon, raisins and nuts. But a scoop of coconut and a whisper of nutmeg impart a rich, delicious aspect to this special loaf.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-08-31T15:30:11-04:00",
  "date_modified": "2024-08-08T15:55:08-04:00",
  "prep_time": "PT15M",
  "cook_time": "PT60M",
  "total_time": "PT85M",
  "yield": [
    "12",
    "1 -9x5x3 inch loaf"
  ],
  "categories": [
    "Bread"
  ],
  "cuisines": [
    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "1 egg",
    "0.5 cup vegetable oil",
    "1 cup white sugar",
    "1 cup grated zucchini",
    "0.5 teaspoon vanilla extract",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking powder",
    "1 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.75 teaspoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 cup flaked coconut",
    "0.5 cup chopped walnuts",
    "0.5 cup currants"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease one 9x5x3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In small pan boil one cup water. Add currants or raisins, and boil for two minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In mixing bowl beat egg, oil, and sugar. Stir in zucchini and vanilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In another bowl, measure flour, baking powder, soda, salt, cinnamon, nutmeg, coconut, walnuts, and currants or raisins. Stir to combine thoroughly. Pour all at once over batter in mixing bowl. Stir to moisten. Turn into greased 9x5x3 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 1 hour until an inserted toothpick comes out clean. Cool in pan 10 minutes. Turn out on rack. Cool and wrap.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
