  "ingredients": [
    "2 eggs",
    "1 cup all-purpose flour",
    "salt to taste",
    "black pepper to taste",
    "garlic powder to taste",
    "1 cup panko (Japanese bread crumbs)",
    "0.25 cup shredded Parmesan cheese",
    "6 razor clams, cleaned and dried",
    "0.33333334326744 cup vegetable oil for frying"
  ],
  "steps": [
    {
      "text": "Place a sheet of wax paper on a flat baking sheet sized to fit in your freezer. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs together in a bowl. Stir flour, salt, pepper, and garlic powder together in a second bowl. Mix panko and Parmesan cheese together in a third bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Flour clams well, shaking off any excess. Dip clams into eggs, then into panko mixture, pressing evenly onto clams. Place on the prepared baking sheet, cover with wax paper, and freeze until firm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a skillet over medium-high heat. Fry clams until lightly browned, about 1 minute on each side. Do not overcook. Place on paper towels to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
