  "ingredients": [
    "cooking spray",
    "0.5 cup ketchup",
    "0.5 cup packed brown sugar",
    "1.5 pounds ground beef",
    "0.75 cup crushed unsalted saltine crackers",
    "2 eggs",
    "0.75 medium onion, chopped",
    "3 cloves garlic, minced, or more to taste",
    "2 tablespoons Dijon mustard",
    "2 tablespoons Worcestershire sauce",
    "salt and pepper to taste",
    "6 slices bacon"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spread ketchup over the bottom of the loaf pan; spread brown sugar over ketchup.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together ground beef, crackers, eggs, onion, garlic, mustard, Worcestershire sauce, salt, and pepper in a large bowl until well combined. Form mixture into a loaf and place in the prepared pan. Lay bacon strips on top in a lattice or other pattern.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until juices run clear and bacon is cooked, about 1 hour. An instant-read thermometer inserted into the center of meatloaf should read at least 160 degrees F (71 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
