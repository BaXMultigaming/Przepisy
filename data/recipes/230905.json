  "ingredients": [
    "0.25 cup soy sauce",
    "0.25 cup extra-virgin olive oil",
    "2 tablespoons lemon juice",
    "2 teaspoons Asian (toasted) sesame oil",
    "2 teaspoons molasses",
    "1 teaspoon cayenne pepper, or more to taste",
    "6 thin slices fresh ginger, minced",
    "2 cloves garlic, minced",
    "2 1-inch-thick tuna steaks, thawed"
  ],
  "steps": [
    {
      "text": "Mix soy sauce, olive oil, lemon juice, sesame oil, molasses, cayenne pepper, ginger, and garlic together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tuna steaks in a large resealable plastic bag or airtight container; pour marinade over steaks, coat with marinade, and seal. Marinate steaks at room temperature for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a nonstick pan over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove steaks from marinade and discard any remaining marinade. Arrange steaks in the hot pan; gently shake the pan to avoid sticking. Cook for 1 1/2 minutes. Flip and cook 1 minute more.",
      "section": null,
      "name": null,
      "url": null,
