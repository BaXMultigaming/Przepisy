  "ingredients": [
    "1.5 cups all-purpose flour",
    "3 teaspoons baking powder",
    "1 teaspoon salt",
    "2 tablespoons margarine",
    "0.5 cup shredded sharp Cheddar cheese",
    "0.5 cup finely diced onion",
    "1 tablespoon margarine",
    "1 egg",
    "0.5 cup milk",
    "0.5 cup shredded sharp Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (205 degrees C). Grease one 8 inch round or one 8x8 inch square pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, baking powder and salt, cut in 2 tablespoons of the butter until mixture is crumbly. Stir in 1/2 cup of the grated cheese. Make a well in the center of the mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Fry the onion in 1 tablespoon of the butter or margarine until clear and golden. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a small bowl beat the egg and stir in the milk and the cooked onion. Pour egg mixture into the well in the flour mixture. Stir until just moistened. You will have a soft dough. Pat dough into the prepared pan. Sprinkle remaining 1/2 cup grated cheese over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 400 degrees F (205 degrees C) for 25 minutes. Serve hot. Makes about 6 servings.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
