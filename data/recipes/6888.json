  "title": "Savory Onion Bread",
  "description": "Cheddar cheese and sauteed onions team up wonderfully in this zesty quick bread that boasts a second helping of cheese on top.",
  "authors": [
    "Carol"
  ],
  "date_published": "1998-09-02T13:22:16-04:00",
