  "ingredients": [
    "1 medium head green cabbage, shredded",
    "2 green bell peppers, diced",
    "salt to taste",
    "1.5 cups sugar",
    "1 cup vinegar",
    "2 tablespoons celery seed"
  ],
  "steps": [
    {
      "text": "Toss cabbage and bell pepper together in a large bowl; season liberally with salt. Stir; allow to sit 45 minutes. Drain; return to the bowl.",
