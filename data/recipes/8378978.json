  "ingredients": [
    "1 pound ground bison",
    "1 tablespoon taco seasoning mix, or to taste",
    "2 (11 ounce) packages flour tortillas (street taco size)",
    "1 (8.5 ounce) package salad kit “fiesta lime”",
    "1 medium Roma tomato, seeded and diced",
    "2 tablespoons chopped fresh cilantro, or to taste",
    "0.33 cup shredded Oaxaca cheese"
  ],
  "steps": [
    {
      "text": "Heat a heavy skillet over medium-high heat. Add ground bison, season with taco seasoning, and cook until bison is browned throughout and crumbly, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat tortillas over a comal, or microwave for 30 seconds in a tortilla warming bag.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Assemble tortillas by adding 2 tablespoons cooked ground bison, 2 tablespoons chopped salad kit, cilantro, diced tomatoes, and Oaxaca cheese onto each tortilla.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle salad dressing from package on top of the assembled tacos. Enjoy!",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
