  "ingredients": [
    "1 cup water",
    "1 cup white sugar",
    "1 cinnamon stick",
    "0.5 teaspoon whole cloves",
    "1 lemon, juiced and zested",
    "3 lemon, juiced"
  ],
  "steps": [
    {
      "text": "Combine water, sugar, cinnamon stick, cloves, and lemon zest in a saucepan; cook and stir over medium heat until just boiling, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Reduce heat to medium-low and continue to cook until reduced to a thick syrup, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir lemon juice into the syrup; bring to a boil and cook 1 to 2 minutes more; strain into a bowl and refrigerate until chilled.",
      "section": null,
