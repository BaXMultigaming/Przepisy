  "ingredients": [
    "2 tablespoons vegetable oil, divided",
    "1 (16 ounce) package frozen potato and cheese filled pierogies",
    "0.25 pound bacon, diced",
    "0.5 small head cabbage, chopped",
    "1 large onion, thinly sliced",
    "2 medium tomatoes, chopped",
    "2 teaspoons white wine vinegar",
    "0.5 teaspoon white sugar",
    "0.5 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Heat 1 tablespoon oil in a large skillet over medium heat. Add frozen pierogies and cook, turning occasionally, until golden brown, about 8 minutes per side. Keep warm until ready to serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "At the same time, cook bacon in a large, deep skillet over medium-high heat until evenly browned, 7 to 10 minutes. Remove bacon to a paper towel-lined plate, reserving drippings in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add cabbage and onion to the bacon drippings. Stir, cover, and cook over medium heat for 10 minutes. Stir in tomatoes, remaining 1 tablespoon oil, vinegar, sugar, and salt. Add bacon and cook, uncovered, for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine pierogies with the cabbage mixture and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
