    "American"
  ],
  "breadcrumbs": [],
  "keywords": [
    "publisher-tested"
  ],
  "ingredients": [
    "1 (2 pound) package frozen hash brown potatoes, thawed",
    "1 pound pork sausage",
    "1 small onion, diced",
    "5 eggs",
    "0.5 cup milk",
    "0.5 teaspoon onion powder",
    "0.125 teaspoon garlic powder",
    "salt and ground black pepper to taste",
    "12 ounces shredded Cheddar cheese"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zV_H-At307ltW1SQtPixPTlaJ_U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-87013-hash-brown-and-egg-casserole-DDMFS-step-1-a2e320a3175f4433ac18f05630799c67.jpg"
      ],
      "image": "assets/images/87013/step_01.webp"
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a deep-sided 8x8-inch square pan; add hash brown potatoes and arrange in an even layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/lBQE3ruA-IHf9xkJrEozfgpA-Uo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-87013-hash-brown-and-egg-casserole-DDMFS-step-2-3d6f430003f54adf9a083dbca5201338.jpg"
      ],
      "image": "assets/images/87013/step_02.webp"
    },
    {
      "text": "Place sausage and onion in a large skillet over medium heat. Cook and stir until the sausage is browned and crumbled, about 10 minutes; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uGuuG-_rK_ey1F2dxznpucZ3QtA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-87013-hash-brown-and-egg-casserole-DDMFS-step-4-437a4c39b7e743cfb2c70a0599b48cab.jpg"
      ],
      "image": "assets/images/87013/step_03.webp"
    },
    {
      "text": "Meanwhile, whisk eggs, milk, onion powder, garlic powder, salt, and pepper together in a large bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/zKuX6nYr3jPjoZdaJN9nF6vjUuI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-87013-hash-brown-and-egg-casserole-DDMFS-step-3-e69cf89d792d4e11aa6249290bea0f3b.jpg"
      ],
      "image": "assets/images/87013/step_04.webp"
    },
    {
      "text": "Pour over the potatoes and sprinkle with 1/2 of the Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/esdA8oyb52VGdILjQWNUq7LOUTk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-87013-hash-brown-and-egg-casserole-DDMFS-step-5-bae8714491fa47f28e138f7f7dc9d7fb.jpg"
      ],
      "image": "assets/images/87013/step_05.webp"
    },
    {
      "text": "Add sausage mixture on top and sprinkle with remaining Cheddar. Cover with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vbeNVr5cg38i24irqW-lc7YdZq8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-87013-hash-brown-and-egg-casserole-DDMFS-step-6-353f7c6617e44045ad02397fd323558c.jpg"
      ],
      "image": "assets/images/87013/step_06.webp"
    },
    {
      "text": "Bake in the preheated oven for 1 hour. Remove foil; return casserole to the oven and bake until a knife inserted into the center comes out clean, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8UnyTLrEQjPqVRrkOfJTyJmiqXw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-87013-hash-brown-and-egg-casserole-DDMFS-step-7-7e8b40c5db4644528a2db4d70a79ead5.jpg"
      ],
      "image": "assets/images/87013/step_07.webp"
    },
    {
      "text": "Let stand for 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jgoDpSUF_FHFSsnzyhPv8-BMzJI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-87013-hash-brown-and-egg-casserole-DDMFS-4x3-965faecf07c34be6a99815e03a580baf.jpg"
      ],
      "image": "assets/images/87013/step_08.webp"
    }
  ],
