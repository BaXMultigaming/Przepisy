  "ingredients": [
    "cooking spray",
    "1 (20 ounce) can DOLE® Pineapple Slices",
    "0.25 cup packed brown sugar",
    "2 tablespoons margarine, melted",
    "8 maraschino cherries",
    "1 (9 ounce) package yellow cake mix",
    "0.5 cup cold water",
    "1 large egg"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease an 8-inch pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/biqLABvqc8cdQwDCuDcuL67BKC8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-232612-pineapple-upside-down-cake-from-dole-VAT-step-01-fc40f5caa4cd494babb7631345838158.jpg"
      ],
      "image": "assets/images/232612/step_01.webp"
    },
    {
      "text": "Drain pineapple slices; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Hub6IhcoGGUEQ9lloD7uoAbe7xQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-232612-pineapple-upside-down-cake-from-dole-VAT-step-02-e081c0f358364320a4fd56a332e3f313.jpg"
      ],
      "image": "assets/images/232612/step_02.webp"
    },
    {
      "text": "Stir brown sugar and melted butter together in the prepared pan; spread evenly over the bottom of the pan. Place pineapple slices in a single layer on brown sugar mixture. Place a cherry into the center of each pineapple slice and the center of the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/8x8-FvTANnIxpif0546y6W7L-0o=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-232612-pineapple-upside-down-cake-from-dole-VAT-step-03-ee17761ce7fe48e4826e650e05266fa9.jpg"
      ],
      "image": "assets/images/232612/step_03.webp"
    },
    {
      "text": "Beat cake mix, cold water, and egg together in a large bowl with an electric mixer on low speed for 30 seconds. Beat on medium speed for 3 to 4 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FIDUMDVtXh2oJvrgpM3rl1JkMb8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-232612-pineapple-upside-down-cake-from-dole-VAT-step-04-e6799b4e33454711b0cf5910919a9771.jpg"
      ],
      "image": "assets/images/232612/step_04.webp"
    },
    {
      "text": "Pour batter evenly over pineapple and cherries in the pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3Wv09rYGZxcwexINrIUIsSEngUA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-232612-pineapple-upside-down-cake-from-dole-VAT-step-05-fa50bd58cd6049c8a9f7ef9e6fcd6ebf.jpg"
      ],
      "image": "assets/images/232612/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 25 to 30 minutes. Cool in the pan for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/eOiuVDMLXaHNMLuRuW7rOWu6qnc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-232612-pineapple-upside-down-cake-from-dole-VAT-step-06-4ca22bb2b36740cda130f8756a2484bc.jpg"
      ],
      "image": "assets/images/232612/step_06.webp"
    },
    {
      "text": "Loosen edges and turn out onto a serving platter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nS4jc42xiWgd4hnMd7BWkyaS2F8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-232612-pineapple-upside-down-cake-from-dole-VAT-step-07-9cb9b9d330d245e4b648176eca63ec29.jpg"
