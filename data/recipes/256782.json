  "ingredients": [
    "0.5 cup water",
    "0.25 cup bourbon",
    "1 (.87 ounce) package McCormick® Onion Gravy Mix",
    "2 tablespoons butter",
    "1.5 cups finely chopped red onions",
    "1 cup sour cream",
    "0.5 cup mayonnaise",
    "2 tablespoons chopped green onions"
  ],
  "steps": [
    {
      "text": "Mix water, bourbon and Gravy Mix in small bowl until well blended. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt butter in large skillet on medium heat. Add onions; cook and stir 10 minutes or until softened and golden brown. Stir gravy mixture into skillet. Bring to boil. Reduce heat and simmer 5 minutes or until thickened. Remove from heat. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sour cream and mayonnaise in medium bowl. Stir in cooled onion mixture. Sprinkle with green onions. Refrigerate at least 1 hour. Serve with chicken fries or chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
