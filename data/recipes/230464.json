  "ingredients": [
    "2 teaspoons vegetable oil, or as needed",
    "1 cup all-purpose flour",
    "1 tablespoon white sugar",
    "1 teaspoon baking powder",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1.25 cups eggnog"
  ],
  "steps": [
    {
      "text": "Heat oil in a griddle or large skillet over medium heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, sugar, baking powder, baking soda, and salt together in a bowl. Stir eggnog into flour mixture until batter is smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour enough batter into the heated griddle to make a 4- to 5-inch circle. Cook until bubbles appear around edges and bottom is browned, about 5 minutes. Flip and cook until browned, about 5 more minutes. Repeat with remaining batter.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
