  "ingredients": [
    "0.25 pound cooked ham, coarsely chopped",
    "0.25 pound fresh broccoli, chopped",
    "1 bunch fresh green onions, chopped",
    "0.5 cup chopped fresh parsley",
    "1 cup shredded Swiss cheese",
    "2 tablespoons Dijon-style prepared mustard",
    "1 teaspoon lemon juice",
    "2 (8 ounce) packages refrigerated crescent rolls"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, toss together ham, chopped broccoli, onion, parsley, and Swiss cheese. Stir in lemon juice and Dijon-style mustard.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "On a 13-inch stone or baking sheet, arrange crescent triangles in a circle with bases overlapping in the center and pointing to the outside. There should be a 3-inch-diameter circle in the center. Spoon filling evenly over crescent rolls. Fold the point of each triangle over filling and tuck under base at the center. Filling will not be completely covered.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 to 30 minutes in the preheated oven, until golden brown. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
