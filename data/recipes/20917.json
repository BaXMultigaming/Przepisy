  "ingredients": [
    "6 slices bacon",
    "5 eggs",
    "0.5 cup milk",
    "3 cups frozen hash brown potatoes, thawed",
    "0.33333334326744 cup chopped green onions",
    "1.5 cups shredded Cheddar cheese, divided"
  ],
  "steps": [
    {
      "text": "Place bacon in a large, deep skillet. Cook over medium-high heat until evenly brown. Drain, crumble, and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 7x11-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat together eggs and milk. Stir in bacon, hash browns, green onions, and 1 cup shredded Cheddar cheese. Pour into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 25 to 35 minutes, or until a knife inserted in the center comes out clean. Sprinkle remaining Cheddar cheese on top, and continue baking for 3 to 4 minutes, or until cheese is melted. Remove from the oven, and let sit 5 minutes before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
