        "https://www.allrecipes.com/thmb/3k8bnrdY584aehJt4DuWMGA7_ag=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/14297-asian-coleslaw-VAT-step-03-ba3965e087b948ce88547f5b2725ab2a.jpg"
