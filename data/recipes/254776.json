  "ingredients": [
    "1 serving cooking spray",
    "3 cups all-purpose flour",
    "2 teaspoons ground cinnamon",
    "1 teaspoon baking soda",
    "1 teaspoon salt",
    "0.25 teaspoon baking powder",
    "0.25 teaspoon ground cloves",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground ginger",
    "3 eggs",
    "1.5 cups white sugar",
    "0.5 cup brown sugar",
    "1 cup vegetable oil",
    "1 orange, zested",
    "2 cups grated zucchini",
    "1 cup mixed dried fruit",
    "0.25 cup poppy seeds",
    "1 cup confectioners' sugar",
    "0.25 cup orange juice"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Coat an 8x12-inch baking pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, cinnamon, baking soda, salt, baking powder, cloves, nutmeg, and ginger together in a bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl with an electric mixer until smooth; beat in white sugar and brown sugar until incorporated. Mix in vegetable oil; gradually beat in flour mixture until batter is smooth. Stir in orange zest; fold in zucchini, dried fruit, and poppy seeds. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into center comes out clean, 45 to 55 minutes. Cool in the pan, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix confectioners' sugar and orange juice together in a small bowl; set glaze aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Prick cake all over with a fork; drizzle glaze on top. Cool cake completely before serving, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
