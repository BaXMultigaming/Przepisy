  "ingredients": [
    "1 (38 ounce) package frozen cooked meatballs, thawed",
    "1 cup ketchup",
    "0.75 cup packed brown sugar",
    "3 tablespoons vinegar",
    "1 tablespoon Worcestershire sauce",
    "0.5 teaspoon dry mustard",
    "0.25 teaspoon ground cloves",
    "1 teaspoon garlic salt",
    "1 beef bouillon cube"
  ],
  "steps": [
    {
      "text": "Preheat oven to 325 degrees F (160 degrees C). Place meatballs in a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in preheated oven until warmed through, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine ketchup, brown sugar, vinegar, Worcestershire sauce, mustard, cloves, garlic salt, and beef bouillon cube in a saucepan; bring to a boil, stirring often. Reduce heat to low and simmer for 5 minutes. Pour sauce over meatballs; cover dish with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Continue baking in oven until meatballs are hot, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
