  "ingredients": [
    "4 fresh tomatoes",
    "10 fresh jalapeno peppers, halved lengthwise and seeded",
    "1 (12 fluid ounce) bottle Mexican beer",
    "0.5 cup water, or as needed",
    "1 clove garlic",
    "1 slice onion",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Place tomatoes and jalapeños in a saucepan; pour in beer and enough water to cover tomatoes and jalapeños. Simmer over medium heat until soft; remove from heat and let cool slightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer tomatoes and jalapeños to a blender; add garlic and onion. Pulse until well blended, adding some of the cooking liquid to help with blending if necessary. Taste and season with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
