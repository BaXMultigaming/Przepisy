  "ingredients": [
    "1 large avocado - peeled, pitted, and mashed",
    "1 cup heavy whipping cream",
    "1 tablespoon lime juice",
    "1 tablespoon chopped cilantro",
    "1 tablespoon chopped onion",
    "0.5 serrano pepper, seeded and deveined, or to taste",
    "1 small clove garlic",
    "1 teaspoon salt",
    "0.125 teaspoon white sugar"
  ],
  "steps": [
    {
      "text": "Blend avocado, cream, lime juice, cilantro, onion, serrano pepper, garlic, salt, and sugar in a blender until smooth. Chill for 1 hour before using.",
