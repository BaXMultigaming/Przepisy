  "ingredients": [
    "1 serving cooking spray",
    "2 cups almond flour",
    "1 tablespoon ground cinnamon",
    "1 teaspoon baking soda",
    "2 eggs",
    "0.5 cup water",
    "1 teaspoon almond extract",
    "0.25 cup agave syrup",
    "2 ripe bananas, mashed",
    "0.5 teaspoon vanilla bean paste"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Spray loaf pan with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix together almond flour, ground cinnamon, and baking soda in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat two eggs in a bowl. Mix in water, almond extract, agave syrup, mashed bananas, and vanilla bean paste. Add banana mixture to almond flour mixture; mix until no dry areas are visible. Pour batter into the prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake banana bread in the preheated oven until brown and crisp around the edges, about 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
