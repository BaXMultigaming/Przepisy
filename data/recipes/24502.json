  "ingredients": [
    "1 teaspoon sesame oil",
    "1 cup chopped onion",
    "0.25 cup chopped green onion",
    "0.5 cup chopped celery",
    "1 cup bean sprouts",
    "0.25 teaspoon cornstarch",
    "0.5 pound shrimp, peeled, deveined and roughly chopped",
    "2 tablespoons soy sauce",
    "1 teaspoon salt",
    "8 eggs, well beaten"
  ],
  "steps": [
    {
      "text": "In a skillet over medium heat, heat sesame oil and lightly fry the onions, celery and sprouts. Stir in cornstarch and add shrimp, soy sauce and salt. Stir until well blended. Remove from heat and transfer to a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return the pan to the heat, and add the beaten eggs. Fry the eggs while stirring gently. Return the vegetable and shrimp mixture to the pan while the eggs are still liquid. Finish frying until eggs are fully cooked.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
