  "ingredients": [
    "cooking spray",
    "2 tablespoons water",
    "2 tablespoons flaxseed meal",
    "1 cup applesauce",
    "1 cup loosely packed brown sugar",
    "0.33333334326744 cup vegetable oil",
    "0.25 cup almond milk",
    "2 cups pumpkin puree",
    "2.5 cups whole wheat flour",
    "1.5 teaspoons baking powder",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon sea salt",
    "0.5 teaspoon ground cardamom",
    "0.25 teaspoon ground cloves",
    "1 dash ground nutmeg"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease 2 loaf pans with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine water and flaxseed meal in a small bowl. Let stand until thickened, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir flaxseed mixture, applesauce, brown sugar, vegetable oil, and almond milk together in a bowl. Add pumpkin puree.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix whole wheat flour, baking powder, baking soda, cinnamon, salt, cardamom, cloves, and nutmeg together in a bowl. Blend in applesauce mixture. Divide batter between loaf pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out mostly clean, 35 to 40 minutes. Cool in the pans for 10 minutes before inverting onto a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
