  "ingredients": [
    "2 tablespoons white wine",
    "1 tablespoon cider vinegar",
    "1 teaspoon dried tarragon",
    "0.5 teaspoon dried minced onion",
    "0.25 teaspoon ground black pepper",
    "0.5 cup butter",
    "3 egg yolks",
    "2 tablespoons lemon juice",
    "0.5 teaspoon salt",
    "1 pinch cayenne pepper"
  ],
  "steps": [
    {
      "text": "Combine wine, vinegar, tarragon, onion, and black pepper in a skillet; bring to a boil and cook until almost all the liquid is evaporated, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place butter in a microwave-safe bowl and heat in microwave until fully melted, 30 seconds to 1 minute.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tarragon mixture, egg yolks, lemon juice, salt, and cayenne pepper in a blender; pulse until combined, 5 to 10 seconds. Remove the small hole cover from lid; stream butter into egg mixture while blender is running until sauce is completely blended and smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
