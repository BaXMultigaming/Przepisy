  "ingredients": [
    "1 pound ground turkey",
    "1 medium red bell pepper, chopped",
    "1 medium green bell pepper, chopped",
    "1 medium onion, chopped",
    "1.5 cups water",
    "1 (8 ounce) jar taco sauce",
    "1 (1 ounce) package taco seasoning mix",
    "1 (15 ounce) can corn, drained",
    "1 (15 ounce) can baby lima beans, drained"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Cook and stir turkey in the hot skillet until browned and crumbly, 5 to 7 minutes. Add peppers and onion; cook and stir until soft, about 5 minutes. Pour in water, taco sauce, and taco seasoning. Stir together. Reduce heat to a simmer and cook about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add corn and lima beans to pan and stir. Let simmer until lima beans are tender and heated through, about 5 minutes more.",
