  "ingredients": [
    "1 (12 ounce) package frozen mixed berries",
    "4 small apples - peeled, cored, and chopped",
    "3 tablespoons cornstarch",
    "1 teaspoon vanilla extract",
    "1 cup all-purpose flour",
    "0.75 cup rolled oats",
    "0.5 cup white sugar",
    "1 teaspoon ground cinnamon",
    "1 cup solid coconut oil"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine frozen mixed berries, apples, cornstarch, and vanilla extract in a bowl and transfer to a baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, oats, sugar, and cinnamon in a bowl. Mix in coconut oil with your fingers until you have a crumbly dough. Sprinkle over the fruit in the baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crumble is lightly browned on top, about 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
