  "ingredients": [
    "0.5 pound new potatoes, quartered",
    "0.33333334326744 pound fresh green beans - rinsed, trimmed and blanched",
    "1 (5 ounce) can tuna",
    "0.5 onion, thinly sliced",
    "0.25 cup pitted nicoise olives",
    "0.25 cup chopped fresh parsley",
    "0.5 pound mixed salad greens",
    "1 cup lemon vinaigrette",
    "3 hard-cooked eggs, quartered",
    "3 roma (plum) tomatoes, thinly sliced",
    "4 anchovy filets",
    "1 tablespoon capers"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
