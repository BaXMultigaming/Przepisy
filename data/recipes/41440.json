  "ingredients": [
    "1.3333300352097 cups all-purpose flour",
    "0.33333298563957 cup lard",
    "0.25 teaspoon salt",
    "1 egg",
    "1 teaspoon vinegar"
  ],
  "steps": [
    {
      "text": "Combine flour and salt in a medium bowl. Use a pastry blender to cut in the lard, until it resembles small peas. Lightly stir in the egg and vinegar with a fork. If the dough does not stick together enough to pull away from the sides of the bowl, stir in a little cold water, about 1 teaspoon at a time.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form dough into a ball, wrap in plastic wrap, and refrigerate for at least 30 minutes before using.",
