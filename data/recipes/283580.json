  "ingredients": [
    "1 cup blanched almond flour",
    "0.125 teaspoon baking soda",
    "1 pinch salt",
    "0.5 cup coconut milk",
    "1 large egg, at room temperature",
    "2 tablespoons coconut oil, melted",
    "2 tablespoons raw honey",
    "1 teaspoon vanilla extract",
    "0.25 cup blueberries",
    "0.25 cup chopped nuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper liners or use a silicone muffin tin.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix almond flour, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk coconut milk, egg, coconut oil, honey, and vanilla together in a separate bowl. Add dry ingredients and mix together with a rubber spatula; do not overmix. Gently fold in blueberries and nuts. Pour into the prepared muffin cups.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, 20 to 25 minutes. Cool in the tin for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
