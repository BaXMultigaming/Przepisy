  "ingredients": [
    "1 all-beef hot dog",
    "1 poppy seed hot dog roll",
    "1 tablespoon yellow mustard",
    "1 tablespoon sweet green pickle relish",
    "1 tablespoon chopped onion",
    "4 tomato wedges",
    "1 dill pickle spear",
    "2 sport peppers",
    "1 dash celery salt"
  ],
  "steps": [
    {
      "text": "Bring a pot of water to a boil over high heat. Reduce heat to low, place hot dog in water, and cook until warmed through, about 5 minutes. Remove hot dog from water and set aside.",
      "section": null,
      "name": null,
      "url": null,
