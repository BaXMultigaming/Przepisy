  "ingredients": [
    "1.5 cups all-purpose flour",
    "1 teaspoon baking soda",
    "0.25 teaspoon salt",
    "5 tablespoons hot water",
    "0.25 cup cocoa powder",
    "2 large overripe bananas, mashed",
    "0.5 cup Greek yogurt",
    "0.5 cup butter, melted",
    "0.5 cup brown sugar",
    "2 eggs, beaten",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease a loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, baking soda, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk hot water and cocoa powder in a large bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine mashed bananas, Greek yogurt, butter, brown sugar, eggs, and vanilla extract in another large bowl; mix well. Fold in flour mixture until thoroughly combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix half of the banana mixture into the cocoa mixture until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Spoon banana mixture and cocoa mixture into the prepared pan, alternating between the two.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
