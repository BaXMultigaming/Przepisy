  "ingredients": [
    "1 egg",
    "3 tablespoons shortening or bacon fat",
    "1.125 cups buttermilk",
    "1.25 cups cornmeal",
    "2 tablespoons sugar",
    "0.25 cup all-purpose flour",
    "0.5 teaspoon baking soda",
    "1 tablespoon baking powder",
    "1 teaspoon salt",
    "1 cup crushed pork cracklin's"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 450 degrees F (220 degrees C). Grease a 9x9 inch square baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, mix together the egg, shortening and buttermilk. In a separate bowl, stir together the cornmeal, sugar, flour, baking soda, baking powder and salt. Stir the dry ingredients into the wet ingredients until smooth, then stir in the pork cracklin's. Pour the batter into the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake for 25 to 30 minutes in the preheated oven, until center is set and the top is slightly brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
