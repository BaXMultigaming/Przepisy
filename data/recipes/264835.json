  "ingredients": [
    "6 blackberries, plus more for garnish",
    "1.5 teaspoons honey",
    "1.5 fluid ounces spiced rum",
    "1.5 cups crushed ice"
  ],
  "steps": [
    {
      "text": "Muddle blackberries and honey in a cocktail shaker until berries are mashed. Add spiced rum and 1 cup ice. Shake until well chilled. Pour into an old-fashioned glass. Mound with remaining 1/2 cup ice. Garnish with additional blackberries and serve with a straw.",
