  "ingredients": [
    "0.5 cup butter",
    "3 tablespoons white sugar",
    "2 tablespoons golden syrup",
    "2 cups rolled oats",
    "5 tablespoons raisins",
    "1 (5 ounce) milk chocolate, melted"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly butter a baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine butter, sugar, and golden syrup in a saucepan over low heat. Mix until butter has melted and sugar has dissolved. Remove from heat. Add 2 cups oats and raisins. Mix until oats are well coated. Pour mixture into the prepared pan; flatten down with the back of a spoon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown on top, 10 to 20 minutes. Let flapjack cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Melt chocolate in a microwave-safe glass or ceramic bowl in 15-second intervals, stirring after each interval, 1 to 3 minutes. Pour over the cooled flapjack. Let cool until chocolate is set.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
