  "ingredients": [
    "2 pounds ground beef",
    "1 large onion, chopped",
    "1 small head cabbage, chopped",
    "2 (14.5 ounce) cans diced tomatoes",
    "1 (8 ounce) can tomato sauce",
    "0.5 cup water",
    "2 cloves garlic, minced",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper"
