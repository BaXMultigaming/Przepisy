  "ingredients": [
    "0.75 cup white sugar",
    "0.66666668653488 cup vegetable oil",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "0.5 teaspoon salt",
    "2 teaspoons baking powder",
    "0.33333334326744 cup purple yam powder, or more to taste",
    "2 cups all-purpose flour"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Line a baking sheet with parchment paper or grease lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix sugar, oil, eggs, vanilla extract, salt, baking powder, purple yam powder, and flour, in this order, in a large bowl until dough is well blended. Drop tablespoons of dough onto the baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies look firm, 8 to 10 minutes. Cool for at least 5 minutes before gently transferring to a wire rack.",
