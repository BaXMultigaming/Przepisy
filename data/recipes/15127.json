  "title": "Green Bean Cheddar Chicken",
  "description": "A smooth Cheddar sauce coats chicken, green beans, and bacon in this make-ahead casserole.",
  "authors": [
    "Marilyn G."
  ],
  "date_published": "1999-05-04T17:58:27-04:00",
