  "ingredients": [
    "2.5 pounds ground turkey",
    "0.5 cup chopped onion",
    "0.5 cup chopped green bell pepper",
    "0.5 cup chopped tomato",
    "1 cup no-salt-added ketchup",
    "7 tablespoons barbeque sauce",
    "2 tablespoons prepared yellow mustard",
    "1 tablespoon vinegar",
    "0.5 teaspoon celery seed",
    "0.5 teaspoon ground black pepper",
    "0.5 teaspoon red pepper flakes, or to taste",
    "8 hamburger bun, split and toasted"
  ],
  "steps": [
    {
      "text": "Heat a nonstick skillet over medium heat. Cook and stir turkey, onion, bell pepper, and tomato in the hot skillet until turkey is crumbly and no longer pink, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir ketchup, barbeque sauce, mustard, vinegar, celery seed, black pepper, and red pepper flakes into turkey in the skillet. Reduce heat to low and simmer, stirring occasionally, for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve turkey mixture on toasted hamburger buns.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
