  "ingredients": [
    "2 (8 ounce) packages cream cheese, softened",
    "1 stick butter",
    "1 cup milk",
    "4 tablespoons all-purpose flour",
    "3 (15.25 ounce) cans whole kernel corn, drained",
    "3 canned jalapeno peppers, chopped, or to taste",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease a casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cream cheese and butter in a microwave-safe bowl. Microwave on high until melted, 1 to 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour cream cheese mixture into a large skillet; add milk and flour. Cook, stirring occasionally, over medium heat until mixture thickens, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine corn and jalapeño peppers in a bowl; add to cream cheese sauce. Season with salt and mix well. Pour into the prepared casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
