  "ingredients": [
    "1 tablespoon vegetable oil",
    "1 pound ground beef",
    "5 medium potatoes, peeled and cubed",
    "1 (14.5 ounce) can stewed tomatoes",
    "1 cup chopped green chile peppers",
    "0.5 cup chopped onion",
    "2 cups water",
    "salt and ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Heat oil in a large stockpot over medium-high heat. Crumble beef into the pot and cook, stirring frequently, until well-browned, 7 to 10 minutes. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Return the pot to the stove and add potatoes, tomatoes, chile peppers, and onion to the beef. Pour in water, stir to combine, and bring to a boil. Reduce heat and simmer until flavors have blended, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season with salt and pepper before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
