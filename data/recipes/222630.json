  "ingredients": [
    "0.75 cup milk",
    "0.25 cup lemon juice",
    "2 eggs",
    "0.5 cup vegetable oil",
    "2 cups all-purpose flour",
    "1.25 cups white sugar",
    "1 tablespoon baking powder",
    "0.5 teaspoon salt",
    "1 cup cranberries, halved",
    "0.33333334326744 cup toasted slivered almonds"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/soneXG1T81KEkWCqhg1BMUsNcm8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222630-lemon-cranberry-muffins-DDMFS-step-1-BG-2828-03d9bb6998524d518281401fe2b9c610.jpg"
      ],
      "image": "assets/images/222630/step_01.webp"
    },
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Grease a 12-cup muffin tin or line cups with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk and lemon juice together in a jug to make sour milk; whisk in eggs and oil until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BPSUHGqh7GlD5al4ATUMWcSFEUc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222630-lemon-cranberry-muffins-DDMFS-step-3-BG-2834-ecc9e74fcf88494e8a5ff5d7965c99a0.jpg"
      ],
      "image": "assets/images/222630/step_03.webp"
    },
    {
      "text": "Stir flour, sugar, baking powder, and salt together in a large bowl, making a well in the center; pour milk mixture into well and stir just until batter is combined; fold in cranberries.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xmBDbBBdLdmRe8iNDY4A1dEPyUo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222630-lemon-cranberry-muffins-DDMFS-step-6-BG-2842-adaa006f6a184732b687a0f0fdec002e.jpg"
      ],
      "image": "assets/images/222630/step_04.webp"
    },
    {
      "text": "Spoon batter into the prepared muffin cups, filling each 2/3 full; sprinkle with almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xv5vdy1NeiFuydSDmpsgwm_P2vU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222630-lemon-cranberry-muffins-DDMFS-step-7-BG-2849-3e2edf5c102f4b2280acb07836a0b867.jpg"
      ],
      "image": "assets/images/222630/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until tops spring back when lightly pressed, about 18 to 20 minutes. Cool in the tin for 5 minutes. Transfer to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/G0amXliGJcTcg61S0dsWQRUc4i8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/222630-lemon-cranberry-muffins-DDMFS-step-8-BG-2887-b1fdc70351364494aa607e60efebbe0d.jpg"
      ],
      "image": "assets/images/222630/step_06.webp"
    }
