  "ingredients": [
    "8 slices bacon",
    "4 ounces shredded Swiss cheese",
    "1.5 cups milk",
    "4 large eggs, beaten",
    "0.5 cup all-purpose flour",
    "0.25 cup finely chopped onion",
    "2 tablespoons butter, melted",
    "1 teaspoon salt"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Lightly grease a 9-inch pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/KC5Sr0txP5nQpwxrJgri0-QDRK0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21551-quick-quiche-VAT-step-01-edb2daedfb9a42ee8a5aa9779128fbf7.jpg"
      ],
      "image": "assets/images/21551/step_01.webp"
    },
    {
      "text": "Place bacon in a large skillet and cook over medium-high heat, turning occasionally, until evenly browned, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Q5p_ebfpzYgDv6iuURrcIM-lU1Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21551-quick-quiche-VAT-step-02-54b86b2387c54da8b95bdbe886894c85.jpg"
      ],
      "image": "assets/images/21551/step_02.webp"
    },
    {
      "text": "Drain bacon slices on paper towels. Crumble and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/J_lXmPXzXG7s241f8_apDgXwPsM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21551-quick-quiche-VAT-step-03-b2bacf0051df4e678bd7c3ce4383639a.jpg"
      ],
      "image": "assets/images/21551/step_03.webp"
    },
    {
      "text": "Cover bottom of prepared pie pan with shredded cheese and crumbled bacon.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XrTtm83bkM1yDWBSwYBDykaYq58=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21551-quick-quiche-VAT-step-04-28a2e4abbe854519944af5c135d01a37.jpg"
      ],
      "image": "assets/images/21551/step_04.webp"
    },
    {
      "text": "Whisk together milk, eggs, flour, onion, butter, and salt in a large bowl until smooth. Pour mixture over cheese and bacon in pie pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LrapzXoq7cK-9ybd2fHS9enQZP4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21551-quick-quiche-VAT-step-05-1-7909bc3fdf9a4f30a6e24faf699652f0.jpg"
      ],
      "image": "assets/images/21551/step_05.webp"
    },
    {
      "text": "Bake quiche in the center of the preheated oven until golden brown and firm in the center, about 35 minutes. Serve hot or cold.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/k0_PGrg5pu5oNry9C4rMkOm2t0k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ALR-21551-quick-quiche-VAT-step-06-6da40ce9d183491fb935c8a6ca06bf0e.jpg"
      ],
      "image": "assets/images/21551/step_06.webp"
    }
