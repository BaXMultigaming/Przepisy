  "ingredients": [
    "1.5 cups vegetable oil",
    "1 (1 ounce) package ranch dressing mix",
    "1 (16 ounce) package saltine crackers"
  ],
  "steps": [
    {
      "text": "Place oil and ranch dressing mix into a 2-gallon resealable plastic bag; seal the bag and shake until well combined. Add crackers and shake until crackers are evenly coated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set crackers aside to absorb coating, about 3 hours, shaking the bag every 30 minutes. Enjoy as a snack or with a dip.",
      "section": null,
