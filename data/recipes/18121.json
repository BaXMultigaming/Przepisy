  "title": "Pistachio Cake",
  "description": "This moist pistachio cake made with real pistachio butter, cake mix, and pistachio pudding is topped with a sweet glaze for a delightful dessert.",
  "authors": [
    "Marcia"
  ],
  "date_published": "2000-03-21T10:09:50-05:00",
  "date_modified": "2026-03-23T10:13:03-04:00",
  "prep_time": "PT20M",
