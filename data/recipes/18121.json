    "American"
  ],
  "regions": [
    "American"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "cooking spray",
    "all-purpose flour, for pan",
    "3/4 cup pistachios, toasted",
    "1 (15.25 ounce) package yellow cake mix",
    "1 (3.4 ounce) package instant pistachio pudding mix",
    "1.5 cups water",
    "4 large eggs",
    "0.25 cup vegetable oil",
    "7 drops green food coloring",
    "1/2 teaspoon pistachio extract",
    "1 cup confectioners' sugar",
    "1/4 cup heavy cream",
    "1 teaspoon vanilla extract",
    "chopped pistachios for garnish"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 10-inch Bundt or tube pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/c6b9jmVnD4kkqomjx0YWGTVlnIU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/pistachio-cake-iii-VAT-005-step-01-f7ebb185bf374b8abfe5376d664d7074.jpg"
      ],
      "image": "assets/images/18121/step_01.webp"
    },
    {
      "text": "Process pistachios in a food processor until nuts become smooth and creamy, 7 to 10 minutes, stopping to scrape down sides of bowl as needed. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/g_rsmTHqsMAaT8MyIXdkhVOq2bw=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/pistachio-cake-iii-VAT-006-step-02-abae6b175aee47d4b4b7b098952bd12c.jpg"
      ],
      "image": "assets/images/18121/step_02.webp"
    },
    {
      "text": "Whisk cake mix and pudding mix together in a large bowl, create a well in the center.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w8Jr5f2H3GQ-UDe77Jy6WQ9LMLo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/pistachio-cake-iii-VAT-003-2x1-298b8c23919040dbb9f51adcdfeb3a3f.jpg"
      ],
      "image": "assets/images/18121/step_03.webp"
    },
    {
      "text": "Add water, eggs, oil, processed pistachios, green food coloring, and pistachio extract into center of well. Whisk together until fully combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/5fwtAxmxZyJi6cLazeBZuNLV1xo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/pistachio-cake-iii-VAT-008-step-04-64fb7c2d319542539b0ada6b28b0d417.jpg"
      ],
      "image": "assets/images/18121/step_04.webp"
    },
    {
      "text": "Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ueX_ugYXdtnQXdWuaUhNK8J1khA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/pistachio-cake-iii-VAT-009-step-05-907df8ab493b4fa09f19349ed84b77a0.jpg"
      ],
      "image": "assets/images/18121/step_05.webp"
    },
    {
      "text": "Bake in the preheated oven until cake springs back when lightly pressed, or a toothpick inserted in the center comes out clean, 50 to 55 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Lxtg1MFhwtqTqcc0q1giSbNoRNo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/pistachio-cake-iii-VAT-010-step-06-586563b569ad458a9781eea2ea7a49a0.jpg"
      ],
      "image": "assets/images/18121/step_06.webp"
    },
    {
      "text": "Cool in the pan for 15 minutes. Turn out onto a wire rack and cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/MFpCi8h1mdbjDyWVz0ejq0CBlRQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/pistachio-cake-iii-VAT-011-step-07-123d97f769a9467b9c7ff239bb345013.jpg"
      ],
      "image": "assets/images/18121/step_07.webp"
    },
    {
      "text": "To make the glaze: Whisk together powdered sugar, heavy cream, and vanilla extract in a small bowl until fully combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/nvIt7ZgT5emB2s_X5JFIBP1X3_k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/pistachio-cake-iii-VAT-012-step-08-161b98ecec514b44a7adca4ae0d1d4be.jpg"
      ],
      "image": "assets/images/18121/step_08.webp"
    },
    {
      "text": "Spoon glaze evenly over cooled cake, garnish with chopped pistachios, slice and serve.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/I8qqr3Kp2yFUgzHKa56seSpYaT4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/pistachio-cake-iii-VAT-013-step-09-7aa0f65da9ad4f219e27eef7bdb23b40.jpg"
      ],
      "image": "assets/images/18121/step_09.webp"
    }
  ],
