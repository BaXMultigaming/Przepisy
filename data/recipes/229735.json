  "ingredients": [
    "1 (8 ounce) package cream cheese, cut into cubes",
    "0.5 cup butter",
    "1 (15 ounce) can black beans, drained",
    "1 (8 ounce) can diced italian-style tomatoes, drained",
    "1 (11 ounce) can Mexican-style corn with red and green peppers, drained",
    "1 (10 ounce) can white shoepeg corn, drained",
    "1 cup shredded Cheddar cheese, divided",
    "0.5 cup diced jalapeno peppers"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place cream cheese and butter in a 8x8-inch casserole dish. Heat in microwave in 2-minute intervals until melted; stir until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix black beans, tomatoes, Mexican-style corn, and white corn into the cream cheese mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake casserole in the preheated oven until bubbling, about 20 minutes. Stir 1/2 cup Cheddar cheese into casserole until incorporated; top with jalapeno peppers and remaining 1/2 cup Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until cheese topping is melted and bubbling, 3 to 5 more minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
