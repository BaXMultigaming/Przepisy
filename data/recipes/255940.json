  "ingredients": [
    "2 tablespoons warm water",
    "1 (.25 ounce) package active dry yeast",
    "0.75 cup buttermilk",
    "0.25 cup vegetable oil",
    "2.5 cups all-purpose flour",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "1.5 cups brown sugar, divided",
    "10 tablespoons butter, melted and divided",
    "1 teaspoon ground cinnamon",
    "2 tablespoons molasses"
  ],
  "steps": [
    {
      "text": "Mix water and yeast together in a bowl. Let stand until yeast softens and begins to form a creamy foam, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk buttermilk and oil into the yeast mixture. Stir in flour, salt, and baking soda until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a floured work surface; knead until smooth and elastic, about 10 minutes. Let dough rest for 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk 3/4 cup brown sugar, 4 tablespoons melted butter, and cinnamon together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough out into a 12-inch long rectangle about 1/4-inch thick. Spread cinnamon mixture evenly on top. Roll up lengthwise into a log; cut into 1-inch slices using a serrated knife.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk remaining 3/4 cup brown sugar, 6 tablespoons melted butter, and molasses together in a small bowl. Pour into a greased 9x13-inch baking pan. Arrange dough slices on top. Cover and let rise at room temperature for 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until golden brown on top, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
