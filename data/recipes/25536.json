  "ingredients": [
    "1 quart oil for deep frying",
    "1 (8 ounce) package cream cheese, softened",
    "2 (6 ounce) cans crabmeat, drained and flaked",
    "0.5 teaspoon garlic powder",
    "0.25 teaspoon paprika",
    "2 tablespoons water chestnuts, drained and chopped",
    "1 (14 ounce) package wonton wrappers"
  ],
  "steps": [
    {
      "text": "Heat oil to 375 degrees F (190 degrees C) in a large, heavy saucepan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese, crabmeat, water chestnuts, garlic powder, and paprika together in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place about 1 teaspoon cream cheese mixture in the center of each wonton wrapper. Moisten wrapper edges with water, fold over the mixture, and pinch to seal.",
