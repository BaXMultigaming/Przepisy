  "ingredients": [
    "1.25 cups fusilli pasta",
    "0.25 cup extra-virgin olive oil",
    "0.25 cup red wine vinegar",
    "2 tablespoons minced fresh dill",
    "3 cloves garlic, minced",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "2 (4 ounce) cans sliced mushrooms, drained",
    "1 cup arugula",
    "0.75 cup shredded Gruyere cheese",
    "0.5 cup diced red onion"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook fusilli pasta in the boiling water, stirring occasionally until cooked through but firm to the bite, 12 minutes. Drain and rinse under cold water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk olive oil, vinegar, dill, garlic, salt, and black pepper together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine cooked pasta, mushrooms, arugula, Gruyere cheese, and onion together in a large bowl. Pour dressing over pasta mixture; toss to coat. Cover bowl with plastic wrap and refrigerate pasta salad at least 2 hours before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
