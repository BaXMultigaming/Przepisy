  "ingredients": [
    "0.25 cup all-purpose flour",
    "0.25 cup white sugar",
    "2 tablespoons cocoa powder",
    "1 pinch ground cinnamon",
    "1 pinch salt",
    "0.25 cup water",
    "2 tablespoons canola oil",
    "1 splash vanilla extract"
  ],
  "steps": [
    {
      "text": "Stir flour, sugar, cocoa powder, cinnamon, and salt together in a microwave-safe mug. Stir water, oil, and vanilla extract into flour mixture with a fork until smooth.",
