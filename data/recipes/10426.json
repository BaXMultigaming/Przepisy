  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.66666668653488 cup packed brown sugar",
    "0.5 teaspoon baking powder",
    "0.5 teaspoon salt",
    "0.25 teaspoon baking soda",
    "0.5 cup butter, softened",
    "1 teaspoon vanilla extract",
    "2 egg yolks",
    "3 cups miniature marshmallows",
    "0.66666668653488 cup corn syrup",
    "0.25 cup butter",
    "2 teaspoons vanilla extract",
    "2 cups peanut butter chips",
    "2 cups crisp rice cereal",
    "2 cups salted peanuts"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, combine flour, brown sugar, baking powder, salt, baking soda, 1/2 cup butter or margarine, 1 teaspoon vanilla and egg yolks. Mix on low speed with an electric mixer until crumbly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press firmly into bottom of 13 x 9 inch pan. Bake 12- 15 minutes until golden brown.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Immediately sprinkle marshmallows over top and return to oven for 2 - 2 1/2 minutes. Let cool while preparing topping.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Topping: In a large saucepan over low heat combine corn syrup, 1/4 cup butter or margarine, 2 teaspoons vanilla and peanut butter chips until smoothly melted, stirring constantly. Remove from heat and stir in cereal and nuts. Immediately spoon over marshmallows, spreading to cover. Refrigerate until firm. Cut into 36 bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
