  "ingredients": [
    "2 tablespoons white sugar",
    "0.25 cup packed brown sugar",
    "0.25 cup unsalted butter, softened",
    "2 tablespoons grated orange zest",
    "0.25 cup orange juice",
    "1 teaspoon ground cinnamon",
    "8 slices white bread",
    "2 ounces dark chocolate, grated",
    "1 cup milk",
    "1 cup heavy cream",
    "3 eggs"
  ],
  "steps": [
    {
      "text": "Mix together the white and brown sugars in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour half the sugar mixture into a separate mixing bowl and blend with butter, orange zest, and orange juice, and cinnamon. Spread the butter mixture on one side of each slice of bread. Cut each slice of bread in half diagonally. Arrange the bread triangles in an overlapping fashion in an 8x8 inch baking dish with the buttered side down.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place the remaining sugar, grated chocolate, milk, cream, and eggs into a blender, and blend until thoroughly mixed. Pour the chocolate mixture over the bread, making sure to evenly cover the bread. Cover and refrigerate the prepared dish for 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat an oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake the bread pudding until golden brown and set, 30 to 40 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
