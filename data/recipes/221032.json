  "title": "Tart Lemon Drop Jelly Shots",
  "description": "These tart gelatin shooters are made with a sweet, fresh lemon syrup and lemon-flavored vodka for a tasty 21-and-over treat.",
  "authors": [
    "RainbowJewels"
  ],
  "date_published": "2020-06-18T23:48:15-04:00",
