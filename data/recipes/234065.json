  "ingredients": [
    "12 small eggs",
    "3 cups white vinegar",
    "0.25 cup white sugar",
    "1 tablespoon salt",
    "2 cloves garlic",
    "1 bay leaf"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HHajbKoOrzPTcK8w7VFO1YrwDJY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234065-classic-pickled-eggs-ddmfs-step-01-3187-23d4728da0d946a9afd5e86f12c3c25b.jpg"
      ],
      "image": "assets/images/234065/step_01.webp"
    },
    {
      "text": "Place eggs in a saucepan and cover with water. Bring to a boil, remove from heat, and let eggs stand in hot water for 15 minutes. Remove eggs from hot water, cool under cold running water, and peel. Discard hot water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6-fcPcGBdpllLDf1MS8im7rj2TA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234065-classic-pickled-eggs-ddmfs-step-02-3194-58ddfbcfc53a4a718c32a11439c4f1df.jpg"
      ],
      "image": "assets/images/234065/step_02.webp"
    },
    {
      "text": "Bring vinegar, sugar, and salt to a boil in the same saucepan until sugar is dissolved. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/XPePaQ_mqMqKGD7uyDcO6a_hwS0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234065-classic-pickled-eggs-ddmfs-step-03-3195-df428f3ce8af4d29b37cd518476069c1.jpg"
      ],
      "image": "assets/images/234065/step_03.webp"
    },
    {
      "text": "Place peeled eggs, garlic, and bay leaf in a 1-quart mason jar; top with vinegar mixture. Seal the jar and refrigerate for at least 1 week before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mP3WacK6_IEyMFj6thI-xN2P4Uc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/234065-classic-pickled-eggs-ddmfs-step-04-3200-34aea83e70a940f4bd9b7bd6b1dcfcfe.jpg"
      ],
      "image": "assets/images/234065/step_04.webp"
    }
  ],
