  "ingredients": [
    "1 cup jasmine rice",
    "2 cups water",
    "1 tablespoon ghee (clarified butter)",
    "1 dried red chile pepper, broken in half",
    "1 teaspoon black mustard seeds",
    "0.5 teaspoon ground turmeric",
    "4 fresh curry leaves",
    "1 pinch asafoetida powder",
    "0.25 cup milk",
    "1 cup plain yogurt",
    "salt to taste"
  ],
  "steps": [
    {
      "text": "Bring rice and water to a boil in a saucepan over high heat. Reduce heat to medium-low, cover, and simmer until the rice is tender, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat the ghee in a small skillet over medium heat. Add the broken chile pepper, and cook until fragrant, about 30 seconds. Stir in the black mustard seeds, and cook until they begin to pop, about 30 seconds more. Remove from the heat, and stir in the turmeric, curry leaves, and asafoetida powder.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk the milk, yogurt, and spice ghee together in a large bowl until smooth. Fold in the rice until well mixed. Season to taste with salt, then allow to cool to room temperature before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
