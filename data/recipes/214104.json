  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Lightly coat a 9x9-inch baking dish with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix 1 cup flour, 2 tablespoons sugar, and melted butter together in a bowl until well combined; pat into the bottom of the prepared baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake crust in the preheated oven until very lightly browned, about 25 minutes; cool slightly. Increase the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir rhubarb, 1 1/4 cups sugar, milk, beaten egg yolks, 2 tablespoons flour together in a bowl until thoroughly combined; pour over crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven until set, 40 to 45 minutes. Serve warm.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
