  "ingredients": [
    "1 cup all-purpose flour",
    "0.5 cup butter, melted",
    "2 tablespoons white sugar",
    "2.5 cups diced rhubarb",
    "1.25 cups white sugar",
    "0.33333334326744 cup milk",
    "3 egg yolks, beaten",
