  "ingredients": [
    "3.75 cups cubed white bread",
    "1.5 cups cubed whole wheat bread",
    "1 pound ground turkey sausage",
    "1 cup chopped onion",
    "0.75 cup chopped celery",
    "2.5 teaspoons dried sage",
    "1.5 teaspoons dried rosemary",
    "0.5 teaspoon dried thyme",
    "1 Golden Delicious apple, cored and chopped",
    "0.75 cup dried cranberries",
    "0.33333334326744 cup minced fresh parsley",
    "1 cooked turkey liver, finely chopped",
    "0.75 cup turkey stock",
    "4 tablespoons unsalted butter, melted"
  ],
  "steps": [
    {
      "text": "Gather the ingredients. Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jqoGc9wFhYUCvFpUiKj2IALlCtU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13651-awesome-sausage-apple-and-cranberry-stuffing-ddmfs-step-01-350d426ecbc94dedb0c661a44c23d7c2.jpg"
      ],
      "image": "assets/images/13651/step_01.webp"
    },
    {
      "text": "Spread white and whole wheat bread cubes in a single layer on a large baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rmozatlhRos6BSpuWimtxBikka8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13651-awesome-sausage-apple-and-cranberry-stuffing-ddmfs-step-02-c8291bd7614d4a99a0abe9173fe91c7f.jpg"
      ],
      "image": "assets/images/13651/step_02.webp"
    },
    {
      "text": "Bake in the preheated oven until evenly toasted, 5 to 7 minutes. Transfer toasted bread cubes to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hAM7qrakMJi7l1Tw1pgmU7qYvPc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13651-awesome-sausage-apple-and-cranberry-stuffing-ddmfs-step-03-5109d7fc755f4fc79b6bf8a4cec81c94.jpg"
      ],
      "image": "assets/images/13651/step_03.webp"
    },
    {
      "text": "Cook sausage and onions in a large skillet over medium heat, stirring and breaking up lumps, until evenly browned, 6 to 8 minutes. Add celery, sage, rosemary, and thyme; cook and stir until flavors blend, about 2 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Jjt2t_RhO-VIodpqIATiieMzKlE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13651-awesome-sausage-apple-and-cranberry-stuffing-ddmfs-step-04-b377c460f08d4322848ddc9cc1e31ef1.jpg"
      ],
      "image": "assets/images/13651/step_04.webp"
    },
    {
      "text": "Pour sausage mixture over bread in bowl. Mix in chopped apple, dried cranberries, parsley, and liver. Drizzle with turkey stock and melted butter; mix lightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OcukTW3qy1oAX6KUFUCMo9kuKSQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13651-awesome-sausage-apple-and-cranberry-stuffing-ddmfs-step-05-ddbc8153c2694012869b9511ecb745e5.jpg"
      ],
      "image": "assets/images/13651/step_05.webp"
    },
    {
      "text": "Allow stuffing to cool completely before loosely stuffing a turkey.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W8wbC8kCSY16RCI1G8e-fZVIH1A=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/ar-13651-awesome-sausage-apple-and-cranberry-stuffing-ddmfs-4x3-2024c805936d4c129f4a416badbec704.jpg"
      ],
