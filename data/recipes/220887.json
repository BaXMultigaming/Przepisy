  "ingredients": [
    "3.5 pounds potatoes, peeled and cubed",
    "0.5 cup butter",
    "0.5 cup half-and-half cream, or more if needed",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.25 teaspoon garlic powder"
  ],
  "steps": [
    {
      "text": "Place potatoes in a large pot and cover with salted water; bring to a boil. Reduce heat to medium-low and simmer until tender, 20 to 25 minutes. Drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash potatoes with a potato masher or an electric mixer on low in a bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter and half-and-half in a small saucepan over medium heat until butter is melted and half-and-half is warmed, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mash or beat butter mixture, salt, black pepper, and garlic powder into mashed potatoes until potatoes are light and fluffy. Stir additional half-and-half, 1 tablespoon at a time, into potatoes for creamier consistency.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
