  "ingredients": [
    "3 cups all-purpose flour",
    "1 cup chopped suet",
    "1 cup raisins",
    "1 cup dark corn syrup",
    "1 cup water",
    "2 teaspoons salt, divided",
    "1 teaspoon baking soda",
    "1 teaspoon ground cinnamon",
    "1 teaspoon baking powder",
    "0.5 teaspoon nutmeg",
    "0.25 teaspoon ground cloves",
    "2 cups milk",
    "1 cup white sugar",
    "2 tablespoons cornstarch",
    "1 tablespoon butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Combine flour, suet, raisins, corn syrup, water, 1 teaspoon salt, baking soda, cinnamon, baking powder, nutmeg, and cloves in a large bowl; mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer pudding batter into a large mold or double boiler and steam over 1 inch of hot, but not boiling, water. Steam until a toothpick inserted comes out clean, about 1 to 1 ½ hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To make the sauce: Combine milk, sugar, cornstarch, butter, and remaining 1 teaspoon salt in a medium saucepan. Warm over medium heat, stirring constantly until mixture thickens; stir in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve pudding warm topped with warm sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
