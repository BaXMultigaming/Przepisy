  "ingredients": [
    "3 cups milk",
    "0.75 cup white sugar",
    "1 cup cold water",
    "6 tablespoons cornstarch",
    "1 cup heavy whipping cream",
    "1 tablespoon rose water",
    "2 cardamom pods, crushed"
  ],
  "steps": [
    {
      "text": "Combine milk and sugar together in a saucepan; bring to a boil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk water and cornstarch together in a bowl until smooth; stir into boiling milk. Cook milk mixture over medium heat until thickened to the consistency of cake batter, 15 to 20 minutes. Remove saucepan from heat and stir cream, rose water, and cardamom into milk mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Refrigerate milk mixture until completely cooled, 2 to 4 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
