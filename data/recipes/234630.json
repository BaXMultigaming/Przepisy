  "ingredients": [
    "cooking spray",
    "2 pounds bacon, cut in half lengthwise",
    "2 (3 ounce) packages thin breadsticks (such as Alessi®)",
    "2 cups brown sugar"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C). Line 2 baking sheets with aluminum foil or parchment paper; coat with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Wrap 1 bacon strip around each breadstick, leaving about 1 inch uncovered on each end; place onto the prepared baking sheets. Sprinkle brown sugar evenly over bacon-wrapped breadsticks.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bacon is crisp and browned, 50 to 60 minutes. Transfer to a piece of parchment paper or waxed paper coated with cooking spray; cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
