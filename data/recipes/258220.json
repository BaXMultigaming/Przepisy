  "ingredients": [
    "1 cup vegetable oil for frying, or as needed",
    "4 (3.5 inch square) wonton wrappers, cut into strips",
    "1 (16 ounce) package pizza dough",
    "6 ounces cream cheese, softened",
    "6 tablespoons chopped green onions, divided",
    "0.25 cup shredded Parmesan cheese, divided",
    "4 ounces frozen crab meat, thawed",
    "4 ounces shredded mozzarella cheese",
    "2 tablespoons sweet chili sauce"
  ],
  "steps": [
    {
      "text": "Heat vegetable oil in a deep skillet over medium-high heat; fry wonton strips until crisp, 2 to 4 minutes. Transfer to a paper towel-lined plate to drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat oven to 450 degrees F (230 degrees C). Spread pizza dough onto a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until slightly brown, about 7 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix cream cheese, 1/4 cup green onions, 2 tablespoons Parmesan cheese, and crab together in a bowl; spread onto the pizza crust. Top with mozzarella cheese, remaining Parmesan cheese, fried wonton strips, and remaining green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is browned and melted, about 8 minutes. Drizzle sweet chile sauce over top.",
