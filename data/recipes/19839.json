  "total_time": "PT320M",
  "yield": [
    "96",
    "12 (1-pint) jars"
  ],
  "categories": [
    "Condiment"
  ],
  "cuisines": [
    "Southern"
  ],
  "regions": [
    "Southern"
  ],
  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "12.5 pounds green tomatoes, chopped",
    "8 large onions, chopped",
    "10 green bell peppers, chopped",
    "3 teaspoons salt",
    "6 chopped green chile peppers",
    "1 quart distilled white vinegar",
    "1.75 cups white sugar",
    "0.5 cup prepared horseradish",
    "1 tablespoon ground cinnamon",
    "1 tablespoon ground allspice",
    "0.25 teaspoon ground cloves"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NyQnd5Fhz7TTt4ptADWTtOu7HcY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19839-chow-chow-VAT-step-01-01064055473a421fa82915e693c501b0.jpg"
      ],
      "image": "assets/images/19839/step_01.webp"
    },
    {
      "text": "Combine green tomatoes, onions, bell peppers and salt in a large stockpot; mix well, cover, and refrigerate for 4 hours to overnight.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/dwX-4rwrFc1CDgGQ3Z8sh-QcmBM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19839-chow-chow-VAT-step-02-a279e0c04e024a22a9f90887f894ebd1.jpg"
      ],
      "image": "assets/images/19839/step_02.webp"
    },
    {
      "text": "Drain green tomato mixture; add hot chile peppers, vinegar, sugar, and horseradish. Wrap cinnamon, allspice, and cloves in cheesecloth or a porous bag; add to tomato mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mvIooXx5vkRpAZrta86VooWUhXY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19839-chow-chow-VAT-step-03-04687255c6fc41229fdc4c58c91902ed.jpg"
      ],
      "image": "assets/images/19839/step_03.webp"
    },
    {
      "text": "Bring tomato mixture to the boil over medium heat and simmer until vegetables are tender, stirring often, about 15 minutes. Remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GYZXCeiKGwTopuThsaem29MmCxI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19839-chow-chow-VAT-step-04-f86ccb19c9a64909b07eee94bf5464dd.jpg"
      ],
      "image": "assets/images/19839/step_04.webp"
    },
    {
      "text": "Pack relish into hot, sterilized jars, filling to within 1/4 inch of the top. Run a clean knife or thin spatula around the insides of the jars to remove any air bubbles. Wipe rims with a moist paper towel to remove any residue. Top with lids and screw rings on tightly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/fLjgohaGjRmeK-Uh75yl7b0x29U=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19839-chow-chow-VAT-step-05-2ffc936620324f169ad681cb703e5eeb.jpg"
      ],
      "image": "assets/images/19839/step_05.webp"
    },
    {
      "text": "Place a rack in the bottom of a large stockpot and fill halfway with water. Bring to a boil and lower jars 2 inches apart into the boiling water using a holder. Pour in more boiling water to cover jars by at least 1 inch. Bring to a rolling boil, cover, and process for 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4cMs1h_wzfMbasT8NuSPMzZy_pc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19839-chow-chow-VAT-step-06-997245d3398c42e0b108b81c44897973.jpg"
      ],
      "image": "assets/images/19839/step_06.webp"
    },
    {
      "text": "Remove the jars from the stockpot and let rest, several inches apart, for 12 to 24 hours. Press the center of each lid with a finger to ensure the lid does not move up or down. Remove the rings for storage and store in a cool, dark area for up to 1 year.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/rE_fijqPPD0629YRl2pvQ-Gtz4E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19839-chow-chow-VAT-step-07-45bee35bff0d457580004da70a2e5208.jpg"
      ],
      "image": "assets/images/19839/step_07.webp"
    },
    {
      "text": "Store any opened jars of chow chow in the refrigerator for up to 3 months.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Ih2dE_cGshqwC5VTVqYH6U14jxo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/19839-chow-chow-VAT-step-08-cf91a14f94c344869ccd9668a6c2608d.jpg"
      ],
      "image": "assets/images/19839/step_08.webp"
    }
  ],
