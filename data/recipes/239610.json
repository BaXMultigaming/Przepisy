  "ingredients": [
    "8 pounds apples - peeled, cored, and sliced",
    "1 cup white sugar",
    "1 cup brown sugar",
    "1 tablespoon ground cinnamon",
    "0.5 teaspoon ground nutmeg",
    "0.5 teaspoon ground cloves",
    "0.25 teaspoon salt",
    "2 teaspoons water, or more as needed",
    "1 tablespoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Place apples in a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir white sugar, brown sugar, cinnamon, nutmeg, cloves, and salt together in a bowl; pour over apples. Add enough water to moisten apples.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low, overnight or 10 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir vanilla extract into apples. Cook, uncovered, for 2 hours more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
