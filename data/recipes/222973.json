  ],
  "ingredients": [
    "2 cups all-purpose flour",
    "salt and ground black pepper to taste",
    "2 large eggs, beaten",
    "1 pound thin-sliced chicken breast cutlets",
    "2 tablespoons vegetable oil, or as needed",
    "0.5 cup butter",
    "2 cups chicken broth",
    "0.25 cup lemon juice",
    "2 tablespoons all-purpose flour",
    "4 sprigs fresh parsley",
    "1 medium lemon, cut into wedges"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/vDJCfm7jl3JIA8X5Wmd6M8PaUHc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-222973-easy-after-work-chicken-francaise-step-01-c90cde5e7abc46b7aa78059c6d36c0f4.jpg"
      ],
      "image": "assets/images/222973/step_01.webp"
    },
    {
      "text": "Whisk 2 cups flour, salt, and pepper together in a shallow bowl. Whisk eggs in a separate shallow bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/CyRNcysoRKOqw2EzaWkfbPHKveU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-222973-easy-after-work-chicken-francaise-step-02-a984c0519669472eba69832d12153b6c.jpg"
      ],
      "image": "assets/images/222973/step_02.webp"
    },
    {
      "text": "Dredge chicken in flour; shake off excess. Dip into beaten egg. Lift up so excess egg drips back into the bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/29GTSsRiMQ9sHRxVUyeRMTRh3DA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-222973-easy-after-work-chicken-francaise-step-03-2874b0156bdc4a9f923d54a58819b5bd.jpg"
      ],
      "image": "assets/images/222973/step_03.webp"
    },
    {
      "text": "Heat oil in a large skillet over medium heat. Pan-fry chicken until golden brown, 2 ½ to 3 ½ minutes per side; transfer to a plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/jIoNTnrYNrVRxSoB33LN3Z-mVvM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-222973-easy-after-work-chicken-francaise-step-04-72f13ee04a2a42f68761cb1eaf79e82e.jpg"
      ],
      "image": "assets/images/222973/step_04.webp"
    },
    {
      "text": "Melt butter in the same skillet over medium-low heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/W89TRK6wtksAHidbNu3T-qrJoLc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-222973-easy-after-work-chicken-francaise-step-05-dc2c81a608924dbbb39ddcd20e9cb6f3.jpg"
      ],
      "image": "assets/images/222973/step_05.webp"
    },
    {
      "text": "Whisk in 2 tablespoons flour and stir until the mixture becomes light golden brown, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/hidnjUeuleO_JhScBLD8C6Vbvs4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-222973-easy-after-work-chicken-francaise-step-06-9b912e83edfc433f9d42ae53c048255a.jpg"
      ],
      "image": "assets/images/222973/step_06.webp"
    },
    {
      "text": "Gradually whisk chicken broth and lemon juice into flour mixture, and bring to a simmer. Cook and stir until thick and smooth, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ey3ZCP6co3ucac0FRsKG5m_qJc0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-222973-easy-after-work-chicken-francaise-step-07-defa7b547fba42478e0ef4c17af1d529.jpg"
      ],
      "image": "assets/images/222973/step_07.webp"
    },
    {
      "text": "Return chicken to the skillet. Continue simmering until chicken is no longer pink in the center, 10 to 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/U9_1WDBOVPPW8IVtbdKJREgERuM=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-222973-easy-after-work-chicken-francaise-step-08-3a0c6ad741d143c595e018b7ab22bc94.jpg"
      ],
      "image": "assets/images/222973/step_08.webp"
    },
    {
      "text": "Garnish with parsley and serve with lemon wedges.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/w5q_4KPt-3-qEOLGpJFC0FyCsY8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-222973-easy-after-work-chicken-francaise-step-09-1cd8fcde0fa34084b0bca81438653b04.jpg"
      ],
      "image": "assets/images/222973/step_09.webp"
    }
  ],
