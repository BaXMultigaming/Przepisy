  "ingredients": [
    "1 (5 ounce) can chunk chicken, drained and flaked",
    "1 (14 ounce) can artichoke hearts, drained and chopped",
    "1 (.7 ounce) package dry Italian-style salad dressing mix",
    "1 (8 ounce) container sour cream",
    "0.25 cup mayonnaise",
    "1 cup Havarti cheese",
    "0.25 cup finely shredded Parmesan cheese",
    "0.25 cup sliced almonds"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a medium bowl, blend chicken, artichoke, Italian-style dressing mix, sour cream, mayonnaise, 1/2 cup Havarti, and Parmesan. Transfer to a small baking dish. Top with remaining Havarti and almonds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake 25 minutes in the preheated oven, or until bubbly and lightly browned.",
