  "ingredients": [
    "1 egg",
    "1 cup vegetable oil",
    "2 cups cider vinegar",
    "3 tablespoons salt",
    "1 tablespoon poultry seasoning",
    "1 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Whisk egg in a medium bowl; gradually drizzle in oil while continuing to whisk until well combined and emulsified. Whisk in vinegar, salt, poultry seasoning, and black pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set some sauce aside for basting while grilling; refrigerate until ready to use. Pour remaining sauce into a shallow baking dish; add chicken and toss to coat with marinate. Cover the dish; marinate in the refrigerator, 4 hours to overnight.",
      "section": null,
      "name": null,
