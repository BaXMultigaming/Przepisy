  "ingredients": [
    "1.75 cups all-purpose flour",
    "2.5 teaspoons baking powder",
    "0.75 teaspoon salt",
    "0.5 teaspoon cayenne pepper",
    "1 teaspoon garlic powder",
    "0.5 teaspoon onion powder",
    "1 teaspoon Italian seasoning",
    "1.5 cups shredded Cheddar cheese",
    "0.5 cup half-and-half cream",
    "0.5 cup milk",
    "0.33333334326744 cup vegetable oil"
  ],
  "steps": [
    {
      "text": "Preheat an oven to 400 degrees F (200 degrees C). Lightly grease a 9x5 inch loaf pan and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour, baking powder, salt, cayenne pepper, garlic powder, onion powder, Italian seasoning, and Cheddar cheese together in a large bowl. Whisk in half-and-half cream, milk, and vegetable just until blended. Pour batter into the prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, 35 to 40 minutes. Cool in the pans for 10 minutes before removing to cool completely on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
