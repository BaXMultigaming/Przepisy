  "ingredients": [
    "2 large eggs",
    "0.5 cup all-purpose flour",
    "0.5 cup white sugar",
    "0.5 cup packed brown sugar",
    "1 cup butter, melted",
    "1 cup semisweet chocolate chips",
    "1 cup chopped pecans",
    "1 (9 inch) pie shell"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large mixing bowl, beat eggs until light and foamy. Add flour, white sugar, and brown sugar; beat until well blended. Blend in melted butter. Stir in chocolate chips and nuts. Pour into pie shell.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 1 hour.",
