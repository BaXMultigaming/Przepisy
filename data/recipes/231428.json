  "ingredients": [
    "0.75 cup all-purpose flour",
    "0.25 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon baking soda",
    "0.25 teaspoon baking powder",
    "0.5 cup white sugar",
    "0.25 cup vegetable oil",
    "1 large egg",
    "1 cup grated zucchini",
    "0.25 cup raisins"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Line a 12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk flour, salt, nutmeg, baking soda, and baking powder together in a medium bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat sugar, oil, and egg together in a large bowl with an electric mixer until well mixed; fold in zucchini and raisins, then stir in flour mixture until combined. Spoon batter into the prepared muffin cups, filling each about ⅔ full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until muffins are golden and the tops spring back when lightly pressed, about 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
