  "ingredients": [
    "1.125 cups butter, softened",
    "1.25 cups white sugar",
    "1.25 teaspoons vanilla sugar",
    "2 tablespoons grated lemon zest",
    "1 tablespoon white sugar",
    "1 teaspoon salt",
    "5 eggs",
    "2 cups all-purpose flour",
    "1 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour one 10 inch loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix grated lemon rind with 1 tablespoon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar with vanilla sugar and lemon rind until the mixture becomes white and fluffy. Add eggs one at a time mixing after each one.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and baking powder together and then carefully fold into the butter and egg mixture. Pour batter into prepared loaf pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake cake for 60 to 75 minutes or until a knife inserted in the middle comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
