  "ingredients": [
    "2 cups chopped green tomato",
    "2 cups peeled and chopped tart green apples",
    "1 cup firmly packed brown sugar",
    "0.5 cup chopped raisins",
    "3 tablespoons cider vinegar",
    "1 tablespoon butter",
    "1 teaspoon ground cinnamon",
    "0.5 teaspoon salt",
    "0.25 teaspoon ground nutmeg",
    "0.25 teaspoon ground cloves",
    "1 pastry for a 9-inch double-crust pie"
  ],
  "steps": [
    {
      "text": "Combine tomatoes, apples, brown sugar, raisins, vinegar, butter, cinnamon, salt, nutmeg, and cloves in a large saucepan over medium-low heat; cook and stir until bubbling and slightly reduced in volume, about 25 minutes. Cool filling slightly, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the oven to 450 degrees F (230 degrees C). Press 1 pie crust in a 9-inch pie plate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour filling into pie crust; top with remaining pie crust. Crimp crust edges together to seal.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 15 minutes. Decrease the oven temperature to 375 degrees F (190 degrees C); continue baking until golden brown, 20 to 25 minutes more.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
