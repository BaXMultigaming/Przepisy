  "ingredients": [
    "1 pastry for 9-inch double crust pie",
    "3 cups sliced ripe tomatillos",
    "3 cups sliced strawberries",
    "0.25 cup instant tapioca",
    "1.5 cups white sugar",
    "1 teaspoon lemon juice, or more to taste",
    "3 tablespoons butter, sliced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 400 degrees F (200 degrees C). Press 1 pie crust into a 9-inch pie dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir tomatillos, strawberries, tapioca, sugar, and lemon juice together in a bowl; let stand, stirring occasionally, until sugar is dissolved, about 15 minutes. Spoon tomatillo-strawberry mixture into the prepared pie crust. Scatter butter slices over filling.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover pie with second pie crust and pinch edges together to seal. Cut slits into top crust for ventilation. Place pie on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until top crust is golden brown and filling is bubbling, about 50 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
