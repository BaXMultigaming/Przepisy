  "breadcrumbs": [],
  "keywords": [],
  "ingredients": [
    "4 cups all-purpose flour",
    "1 cup fed sourdough starter",
    "0.75 cup lukewarm milk",
    "0.75 cup white sugar",
    "1 teaspoon instant yeast",
    "0.5 cup butter, melted and cooled",
    "1 egg, at room temperature",
    "0.5 teaspoon salt",
    "0.5 cup butter, melted and cooled",
    "1 cup brown sugar, or more to taste",
    "3 tablespoons ground cinnamon",
    "0.5 pound confectioners' sugar",
    "1 (4 ounce) package softened cream cheese",
    "0.25 cup softened butter",
    "1 teaspoon vanilla extract"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/6vo9o2znmF3mjheQ7VAYcb0-C8k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259165-rorys-guaranteed-rise-sourdough-cinnamon-rolls-VAT-005-step-01-1-ca652484df1846c2bb140d8431367fc3.jpg"
      ],
      "image": "assets/images/259165/step_01.webp"
    },
    {
      "text": "To make the rolls: Combine 1 cup flour, starter, milk, white sugar, and yeast in the bowl of a stand mixer fitted with the dough hook. Let stand until spongy and bubbling, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/mz0aePCFDbJSr3IpEVYC_r21eQY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259165-rorys-guaranteed-rise-sourdough-cinnamon-rolls-VAT-006-step-02-1-aa08a70337fd4c82a483f7461b4247be.jpg"
      ],
      "image": "assets/images/259165/step_02.webp"
    },
    {
      "text": "Add 1/2 cup butter, egg, and salt; stir to combine. Beat in remaining 3 cups flour, 1 cup at at time, until a soft, slightly sticky dough forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/DRE3cVil5fUIvA_SVHXZMuZ_wjU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259165-rorys-guaranteed-rise-sourdough-cinnamon-rolls-VAT-007-step-03-1-8d5c70f0aeef40158981ddaa26dbe087.jpg"
      ],
      "image": "assets/images/259165/step_03.webp"
    },
    {
      "text": "Transfer dough to a floured work surface; knead until dough comes together, 3 to 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/N9-dU-VUid3lVsvN3_-Vy2xWnhU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259165-rorys-guaranteed-rise-sourdough-cinnamon-rolls-VAT-008-step-04-1-69dbd8a07ca744c1b59317c3058a4683.jpg"
      ],
      "image": "assets/images/259165/step_04.webp"
    },
    {
      "text": "Place in a greased bowl. Cover with plastic wrap; let rise until doubled in volume, about 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/BDX2Swp_chmLGN3HMMgbsrOFQYA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259165-rorys-guaranteed-rise-sourdough-cinnamon-rolls-VAT-009-step-05-1-f6880a50461444078f54faf4e636c854.jpg"
      ],
      "image": "assets/images/259165/step_05.webp"
    },
    {
      "text": "Punch down dough and turn onto the floured surface. Roll into a square 1/4- to 1/3-inch thick.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/pC6OEGjTEXpYsIrFUEphDlR1ajg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259165-rorys-guaranteed-rise-sourdough-cinnamon-rolls-VAT-010-step-06-1-4609cf89ee3247baa6e0d30241e34bd1.jpg"
      ],
      "image": "assets/images/259165/step_06.webp"
    },
    {
      "text": "Spread 1/2 cup butter on top; sprinkle brown sugar and cinnamon on top. Tightly roll up dough; pinch seam together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/GWCrCiGEOBp8ZPBpMFxPUZomoD8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259165-rorys-guaranteed-rise-sourdough-cinnamon-rolls-VAT-011-step-07-01rolled-1-f2172a4f7ab44fd48a762cf6f6899f92.jpg"
      ],
      "image": "assets/images/259165/step_07.webp"
    },
    {
      "text": "Trim edges and cut log into 8 equal pieces using a sharp knife. Grease a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FQJgaJhW0vO-aJaGCBvVOLy-s1k=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259165-rorys-guaranteed-rise-sourdough-cinnamon-rolls-VAT-012-step-08-1-0079831454614f0e88bf173ea274ac09.jpg"
      ],
      "image": "assets/images/259165/step_08.webp"
    },
    {
      "text": "Place rolls in the prepared pan. Cover with plastic wrap; let rise until not quite doubled in volume, about 45 minutes. Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/OXLlL21eZkxpC7d6tvmDokymHYc=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259165-rorys-guaranteed-rise-sourdough-cinnamon-rolls-VAT-013-step-09-1-9e72f4b0c1314e7994cf43593c07064b.jpg"
      ],
      "image": "assets/images/259165/step_09.webp"
    },
    {
      "text": "Bake in the preheated oven until golden brown, about 35 minutes. Cool for 20 minutes before frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/olM1GcLDkkuahiOpTlncNdLYSxQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259165-rorys-guaranteed-rise-sourdough-cinnamon-rolls-VAT-015-step-11-1-d780734a6e724fa8ae9c24e6bf120122.jpg"
      ],
      "image": "assets/images/259165/step_10.webp"
    },
    {
      "text": "To make the frosting: Mix confectioners' sugar, cream cheese, 1/4 cup butter, and vanilla extract until frosting smooth and fluffy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FvfQV_5dyshrPO1-2oL7cxHj3Xg=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259165-rorys-guaranteed-rise-sourdough-cinnamon-rolls-VAT-016-step-12-01mixerinframe-1-054b2e0d2a6b4fda9597d0d0355f6aa2.jpg"
      ],
      "image": "assets/images/259165/step_11.webp"
    },
    {
      "text": "Top cooled rolls with frosting.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/z7Xuyw5ADRWNMtw6p8-XRfqsqn4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/259165-rorys-guaranteed-rise-sourdough-cinnamon-rolls-VAT-017-step-13-1-78ab7835e173485a93f30d7891b7b3dc.jpg"
      ],
      "image": "assets/images/259165/step_12.webp"
    }
  ],
