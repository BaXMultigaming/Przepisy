  "ingredients": [
    "3 large egg whites",
    "1 cup white sugar",
    "0.5 teaspoon distilled white vinegar",
    "0.5 teaspoon vanilla extract",
    "1 pinch salt",
    "2 cups semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 300 degrees F (150 degrees C). Grease baking sheets or line them with parchment paper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whip egg whites in a clean mixing bowl to soft peaks. Gradually add sugar, vinegar, vanilla, and salt while whipping to stiff peaks. Fold in chocolate chips. Drop by spoonfuls onto the prepared cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are dry, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
