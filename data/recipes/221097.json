  "ingredients": [
    "2 cups water",
    "1 cup uncooked white rice",
    "0.5 cup vegetable oil",
    "0.25 cup lemon juice",
    "0.25 cup wine vinegar",
    "1 tablespoon chopped fresh chives",
    "1 tablespoon chopped fresh tarragon",
    "1 teaspoon white sugar",
    "0.5 teaspoon salt",
    "0.5 cup toasted slivered almonds",
    "0.5 cup raisins",
    "0.5 cup mandarin orange segments, drained and coarsely chopped",
    "0.5 cup finely chopped onion",
    "0.5 cup finely chopped celery",
    "0.5 cup finely chopped green bell pepper",
    "0.5 cup green peas"
  ],
  "steps": [
    {
      "text": "Bring water and rice to a boil in a saucepan over high heat. Reduce heat to medium-low, cover, and simmer until rice is tender and liquid has been absorbed, 20 to 25 minutes. Cool rice for at least 30 minutes, stirring several times; transfer to a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk oil, lemon juice, vinegar, chives, tarragon, sugar, and salt together in a separate bowl until sugar and salt dissolve; pour over rice and stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir almonds, raisins, Mandarin oranges, onion, celery, bell pepper, and peas into rice mixture; toss to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover and refrigerate until chilled, at least 1 hour.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
