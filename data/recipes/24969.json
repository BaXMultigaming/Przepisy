  "ingredients": [
    "2 eggs",
    "1 cup white sugar",
    "0.66670000553131 cup vegetable oil",
    "1.5 cups all-purpose flour",
    "0.5 teaspoon baking soda",
    "0.25 teaspoon salt",
    "1.5 teaspoons ground cinnamon",
    "1 (15 ounce) can carrots, drained and pureed",
    "1 (20 ounce) can crushed pineapple, drained",
    "1 cup chopped walnuts",
    "1 cup flaked coconut"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C). Grease and flour a 9x13 inch pan. Sift together the flour, baking soda, salt and cinnamon. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "In a large bowl, beat eggs, sugar and oil until smooth. Beat in flour mixture. Stir in pureed carrots, pineapple, walnuts and coconut. Pour batter into prepared pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven for 30 to 40 minutes, or until a toothpick inserted into the center of the cake comes out clean. Allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
