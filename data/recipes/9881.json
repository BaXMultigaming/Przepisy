  "ingredients": [
    "1 cup sifted all-purpose flour",
    "0.33333334326744 cup packed brown sugar",
    "0.5 cup butter",
    "18 maraschino cherries, halved",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (180 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour and sugar. Cut butter into flour as for pie crust.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press mixture into an 8 x 8 inch pan. Bake for 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "While warm, cut into 36 squares. Place squares in pan lined with wax paper. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a cherry half on center of each, cut side down. Melt chocolate over low heat. Cover cherry with a spoonful of melted chocolate. Chill for a few minutes in refrigerator until chocolate is firm.",
      "section": null,
      "name": null,
      "url": null,
