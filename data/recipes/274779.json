  "ingredients": [
    "2 (10 inch) flour tortillas",
    "1 tablespoon butter",
    "4 medium eggs",
    "1 cup shredded mild Cheddar cheese",
    "1 Hass avocado - peeled, pitted, and sliced",
    "1 small tomato, chopped",
    "1 small bunch fresh cilantro, chopped, or to taste",
    "1 pinch salt and ground black pepper to taste",
    "1 dash hot sauce, or to taste"
  ],
  "steps": [
    {
      "text": "Place tortillas on a microwave-safe plate. Place shredded Cheddar cheese in the center of each tortilla, towards 1 end. Microwave on high power to melt cheese, 20 to 30 seconds.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a skillet over medium heat. Whisk eggs together in a bowl. Pour into the skillet; cook and stir until eggs are set, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place eggs over melted cheese on tortillas; top each with avocado, tomato, and cilantro. Season with salt and pepper. Top with hot sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
