  "title": "Easy Pumpkin Pie Bars",
  "description": "These pumpkin pie bars have all the flavor of a pumpkin pie and are much less work.",
  "authors": [
    "Rose Marie"
  ],
  "date_published": "2020-06-18T23:57:02-04:00",
