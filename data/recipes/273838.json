  "ingredients": [
    "0.5 cup strawberries, hulled and sliced",
    "1 teaspoon white sugar",
    "1 (6 inch) flour tortilla",
    "1 teaspoon butter, melted",
    "1 teaspoon cinnamon sugar, or to taste",
    "10 chocolate candy melts",
    "1 scoop vanilla ice cream",
    "1 teaspoon chocolate sprinkles"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir strawberries and sugar together in a small bowl; set aside until needed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place tortilla inside a small oven-proof bowl so that it forms a cup. Brush the inside of the tortilla with melted butter; lightly sprinkle with cinnamon sugar.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until crisp, 10 to 12 minutes. Carefully remove from the bowl and cool on a wire rack.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, place candy melts in a single layer on a saucer. Microwave for about 1 minute. Dip the top of the taco cup in the chocolate just so the edges are covered. Let cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Scoop ice cream into the taco cup. Top with strawberries and their juices. Garnish with chocolate sprinkles.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
