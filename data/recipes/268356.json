  "ingredients": [
    "2 sticks unsalted butter, softened",
    "0.66666668653488 cup white sugar",
    "1 egg",
    "1 tablespoon vanilla extract",
    "2.5 cups all-purpose flour",
    "0.5 teaspoon salt",
    "1 (12.5 fl oz) can dulce de leche",
    "1 cup shredded coconut",
    "0.75 cup pecans, toasted and chopped"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Thoroughly grease an 8x8-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar in a large bowl with an electric mixer until combined and creamy. Add egg and vanilla extract; beat until incorporated. Scrape down sides of the bowl; beat again. Combine flour and salt; stir into butter mixture until a dough ball forms.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Press ⅔ dough into bottom of the prepared baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until set and light brown, about 20 minutes; keep oven on.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour dulce de leche over crust, trying to keep edges mostly bare.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add coconut and pecans to remaining ⅓ dough; stir until incorporated. Crumble mixture over dulce de leche, pressing lightly over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake until lightly browned, about 15 minutes. Cool completely before cutting into bars.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
