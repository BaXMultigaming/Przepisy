  "ingredients": [
    "8 carrots, chopped",
    "2 cups vegetable broth",
    "1 (14 ounce) can coconut milk",
    "1 onion, chopped",
    "4 cloves garlic, peeled",
    "1 tablespoon red curry paste",
    "2 teaspoons salt",
    "1 teaspoon ground black pepper",
    "2 tablespoons chopped cilantro"
  ],
  "steps": [
    {
      "text": "Combine carrots, vegetable broth, coconut milk, onion, garlic, curry paste, salt, and pepper in a multi-functional pressure cooker (such as Instant Pot®). Close and lock the lid. Select high pressure according to manufacturer's instructions; set timer for 15 minutes. Allow 10 to 15 minutes for pressure to build.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Release pressure using the natural-release method according to manufacturer's instructions, 10 to 40 minutes. Unlock and remove lid. Blend soup with an immersion blender until smooth and creamy, about 3 minutes. Serve in bowls and sprinkle with fresh cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
