  "title": "Red Velvet Cake",
  "description": "This classic red velvet cake recipe uses buttermilk for moist and tender results. Frost with a fluffy white icing for a crowd-favorite dessert.",
  "authors": [
    "Eleanor Johnson"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
