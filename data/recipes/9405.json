  "ingredients": [
    "1 cup uncooked white rice",
    "2 cups water",
    "3 eggs, beaten",
    "2 cups milk",
    "0.5 cup white sugar",
    "1 teaspoon vanilla extract",
    "0.5 teaspoon salt",
    "0.33333334326744 cup raisins",
    "1 pinch ground nutmeg"
  ],
  "steps": [
    {
      "text": "Combine rice and 2 cups water in a 3-quart saucepan. Bring to a boil; reduce heat, cover, and simmer until tender and water is absorbed, about 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/coYxj9L6Nd4qFdk4Tz-0Fwt8zJo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9405-baked-rice-pudding-DDMFS-step-3-5170e559ac1d425c9eda798aae61a3cf.jpg"
      ],
      "image": "assets/images/9405/step_01.webp"
    },
    {
      "text": "Preheat the oven to 325 degrees F (165 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix egg yolks, half-and-half, sugar, vanilla extract, and salt together in a large bowl until combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/UJQV746AkMu9sTt_iya1unQt1mA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9405-baked-rice-pudding-DDMFS-step-5-6408b198bc684ee7906fd7e8d72a1e9d.jpg"
      ],
      "image": "assets/images/9405/step_03.webp"
    },
    {
      "text": "Stir in cooked rice and raisins. Transfer into a 10x6x2-inch baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/LdKWxvFltMiyDteCK-is_ZOU9zo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-9405-baked-rice-pudding-DDMFS-step-7-ddf755223f4443dda2d852155b4759b8.jpg"
      ],
      "image": "assets/images/9405/step_04.webp"
    },
    {
      "text": "Bake uncovered in the preheated oven for 40 minutes; stirring halfway through, until the pudding is set but still creamy and a knife inserted near the center comes out mostly clean. Sprinkle with nutmeg and let cool slightly before serving warm.",
