  "ingredients": [
    "1 (1.5 pound) package small yellow-fleshed potatoes",
    "3 pounds skin-on, boneless chicken thighs",
    "3 small apples, peeled and diced",
    "0.5 medium sweet onion, diced",
    "1 cup chicken broth",
    "0.5 cup honey",
    "0.33333334326744 cup applesauce",
    "1 clove garlic, minced",
    "1 teaspoon salt",
    "0.5 teaspoon ground cinnamon",
    "0.5 teaspoon ground cumin",
    "0.25 teaspoon ground black pepper"
  ],
  "steps": [
    {
      "text": "Chop any large potatoes in half.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place potatoes in the bottom of a slow cooker. Add chicken thighs on top of potatoes, and spread apples and onion over top.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix chicken broth, honey, applesauce, garlic, salt, cinnamon, cumin, and pepper together in a bowl; pour over chicken mixture.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook until chicken is no longer pink at the bone and the juices run clear, 4 to 6 hours on Low, or about 3 hours on High. An instant-read thermometer inserted near the bone should read 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Set an oven rack about 6 inches from the heat source and preheat the oven's broiler. Line a baking sheet with aluminum foil.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Remove chicken thighs from the slow cooker and place, skin-side up, on the prepared baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven until skin is crisp, 3 to 5 minutes. Serve with potatoes, apples, onions, and sauce.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
