  "ingredients": [
    "1.25 cups whole wheat flour",
    "2 teaspoons bran",
    "2 teaspoons baking powder",
    "0.5 teaspoon salt",
    "1 cup milk, or more as needed",
    "1 large egg",
    "1 tablespoon honey",
    "cooking spray"
  ],
  "steps": [
    {
      "text": "Mix flour, bran, baking powder, and salt together in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk milk, egg, and honey together in different bowl. Slowly blend wet ingredients into dry ingredients until lightly mixed; do not overmix or it will make the pancakes less fluffy. Let sit for 5 minutes so wheat and bran can really absorb the wet ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat a griddle or skillet to medium heat and coat lightly with cooking spray.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Ladle approximately 2 tablespoons batter onto the hot skillet for each pancake, working in batches if necessary. Cook until pancakes are slightly bubbly, about 1 minute. Flip and cook until golden brown on the other side, 2 to 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
