  "steps": [
    {
      "text": "Preheat an oven to 425 degrees F (220 degrees C). Grease a baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Season chicken with salt and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine bread crumbs and Parmesan cheese in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat olive oil in a small saucepan over low heat, about 1 minute. Add garlic; stir and remove from heat. Coat chicken in the oil and dip into the bread crumb mixture. Transfer coated chicken to the prepared baking pan.",
