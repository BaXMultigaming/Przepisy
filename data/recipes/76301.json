  "ingredients": [
    "2 pounds ground beef",
    "1 cup sour cream",
    "0.5 cup dry bread crumbs",
    "1 (1 ounce) envelope dry onion soup mix",
    "0.125 teaspoon pepper"
  ],
  "steps": [
    {
      "text": "Mix ground beef, sour cream, bread crumbs, onion soup mix, and pepper in a large bowl with your hands until thoroughly combined. Cover and refrigerate until flavors have blended, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, preheat an outdoor grill for medium heat and lightly oil the grate.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Form beef mixture into eight patties.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on the preheated grill until no longer pink in the center, 6 to 8 minutes per side. An instant-read thermometer inserted into the center should read at least 160 degrees F (70 degrees C) for medium.",
      "section": null,
      "name": null,
      "url": null,
