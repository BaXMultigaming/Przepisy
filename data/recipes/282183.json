  "ingredients": [
    "4 cups all-purpose flour",
    "2 cups old-fashioned oats",
    "2 teaspoons baking soda",
    "2 teaspoons ground cinnamon",
    "1 teaspoon salt",
    "1.5 cups unsalted butter, softened",
    "2 cups firmly packed brown sugar",
    "1 cup white sugar",
    "1 large egg",
    "1 teaspoon vanilla extract",
    "1 (16 ounce) can solid-pack pumpkin (such as Libby's®)",
    "1 cup semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Lightly grease 2 cookie sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine flour, oats, baking soda, cinnamon, and salt in a bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream butter in a large bowl with an electric mixer. Gradually add brown and white sugars; beat until light and fluffy. Mix in egg and vanilla extract until well combined. Add flour mixture in 3 batches, alternating with pumpkin, mixing well after each addition. Stir in chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop medium spoonfuls of dough 2 inches apart onto the prepared baking sheets and spread into pumpkin shapes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cookies are slightly firm and lightly browned, 20 to 25 minutes; do not overbake. Cool on the baking sheet briefly before removing to a wire rack to cool completely.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
