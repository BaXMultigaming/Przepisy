  "ingredients": [
    "1 tablespoon olive oil, or more if needed",
    "0.5 onion, chopped",
    "2 cloves garlic",
    "2 pounds lean ground beef",
    "0.5 cup Mexican-style hot tomato sauce (such as El Pato Salsa de Chile Fresco®)",
    "0.5 cup ketchup",
    "3 tablespoons brown sugar",
    "3 tablespoons Worcestershire sauce",
    "2 tablespoons mustard",
    "2 tablespoons cider vinegar",
    "0.5 teaspoon chili powder"
  ],
  "steps": [
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add onion and garlic; sauté until browned, 5 to 7 minutes. Add ground beef; cook and stir until beef is completely browned, 7 to 10 minutes. Drain and discard grease from the skillet. Transfer beef mixture to a slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir hot tomato sauce, ketchup, brown sugar, Worcestershire sauce, mustard, vinegar, and chili powder into beef mixture. Cover the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook on Low for 2 hours (or on High for 1 hour).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
