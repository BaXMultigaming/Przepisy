  "ingredients": [
    "3 tablespoons water",
    "2 tablespoons white sugar",
    "2.25 cups frozen diced watermelon",
    "0.75 cup prepared lemonade",
    "0.25 cup lime juice",
    "1 cup tequila",
    "0.5 cup orange-flavored liqueur (such as Cointreau®)"
  ],
  "steps": [
    {
      "text": "Boil water and sugar together in a small pot until sugar has dissolved into a syrup. Remove from heat and let cool briefly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine syrup, watermelon, lemonade, and lime juice in a blender; blend until smooth. Pour in tequila and orange-flavored liqueur. Blend until combined.",
