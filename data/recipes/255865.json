  "ingredients": [
    "2 pounds lean stew beef",
    "0.125 teaspoon salt",
    "2 cups diced onion",
    "4 cloves garlic, minced",
    "1 (13.5 ounce) can coconut milk",
    "0.75 cup beef broth",
    "3 tablespoons red curry paste",
    "2 jalapeno chile peppers, seeded and minced",
    "2 tablespoons lime juice",
    "2 tablespoons peanut oil",
    "1 tablespoon brown sugar",
    "8 water",
    "4 cups jasmine rice",
    "2 cups baby spinach",
    "0.5 cup fresh basil leaves"
  ],
  "steps": [
    {
      "text": "Heat a large skillet over medium-high heat. Add beef; cook and stir until browned, about 2 minutes per side. Drain excess grease. Transfer beef to a 4-quart slow cooker and sprinkle with salt.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook onions and garlic in the same skillet over medium-high heat until tender, about 5 minutes. Add to the slow cooker.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir coconut milk, beef broth, red curry paste, jalapeños, lime juice, peanut oil, and brown sugar into the slow cooker until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cover slow cooker. Cook on Low until flavors combine, 6 to 10 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring water and rice to a boil in a large saucepan. Reduce heat to medium-low, cover, and simmer until rice is tender and water is absorbed, 20 to 25 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, stir spinach into the slow cooker; cook until wilted, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Serve beef mixture over rice; garnish with basil leaves.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
