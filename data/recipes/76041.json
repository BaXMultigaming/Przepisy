  "ingredients": [
    "1 (8 ounce) package cream cheese, room temperature",
    "1 tablespoon lemon juice",
    "1 teaspoon finely grated lemon zest",
    "1 carrot, peeled and grated",
    "0.5 cup raisins",
    "0.33333334326744 cup coarsely chopped trail mix",
