  "ingredients": [
    "0.5 cup Shamrock Farms® Premium Sour Cream",
    "0.5 cup Shamrock Farms® Heavy Whipping Cream",
    "1 (10 ounce) package frozen chopped spinach, thawed and well drained",
    "1 (6.5 ounce) jar marinated artichoke hearts, drained and coarsely chopped",
    "1 cup shredded mozzarella cheese",
    "0.5 cup grated Parmesan cheese",
    "1 clove garlic, minced, or more to taste",
    "0.25 teaspoon salt",
    "1 (8 ounce) loaf French bread, sliced"
  ],
  "steps": [
    {
      "text": "Preheat oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Combine all ingredients in a mixing bowl. Gently fold together until well mixed.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pour into a greased 8-inch or 9-inch pie plate or baking dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the oven for 25 to 35 minutes, or until slightly browned and bubbly. Toast bread slices in the oven for the last 10 minutes of the baking time.",
      "section": null,
      "name": null,
      "url": null,
