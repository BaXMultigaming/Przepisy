  "ingredients": [
    "1 cup shortening",
    "2 cups white sugar",
    "3 cups all-purpose flour",
    "4 eggs",
    "1 cup milk",
    "4 teaspoons baking powder",
    "1 teaspoon vanilla extract",
    "1 teaspoon almond extract"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C) Grease and flour three 9 inch round pans. Sift flour and baking powder together, and set aside. In a separate bowl, add vanilla and almond extract to milk and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cream shortening and sugar until light and fluffy. Add eggs one at a time, beating well with each addition. Add flour mixture alternately with milk. Mix until smooth and divide into three 9 inch round pans.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake at 350 degrees F (175 degrees C) for 25 to 30 minutes, or until toothpick inserted into cake comes out clean.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
