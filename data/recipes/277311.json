  "ingredients": [
    "2 tablespoons olive oil",
    "1 onion, chopped",
    "3 cloves garlic, minced",
    "2 pounds assorted tomatoes, chopped",
    "0.5 cup Pinot Grigio wine",
    "0.5 cup water",
    "3 ounces tomato paste",
    "0.25 cup chopped fresh basil leaves",
    "2 teaspoons white sugar",
    "1.5 teaspoons crushed red pepper flakes",
    "1 teaspoon dried oregano",
    "1 teaspoon salt",
    "0.25 teaspoon ground black pepper",
    "0.5 cup grated Parmesan cheese"
  ],
  "steps": [
    {
      "text": "Heat olive oil in a large stockpot over medium heat. Add onion; cook and stir until soft, about 5 minutes. Add garlic; cook and stir until fragrant but not brown, about 2 minutes. Stir in tomatoes, wine, water, tomato paste, basil, sugar, pepper flakes, oregano, salt, and black pepper. Cover, bring to a simmer, and cook, stirring occasionally, for 45 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Off heat, purée soup with an immersion blender until smooth, or purée in batches in a blender; return soup to heat. Stir in Parmesan cheese; cook until heated through, about 3 minutes more. Serve hot.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
