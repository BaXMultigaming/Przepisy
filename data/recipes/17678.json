  "ingredients": [
    "2 cups unbleached all-purpose flour",
    "2 tablespoons unsweetened cocoa powder",
    "1.5 teaspoons baking soda",
    "0.5 teaspoon salt",
    "0.5 cup butter",
    "1.5 cups white sugar",
    "2 eggs",
    "2 teaspoons vanilla extract",
    "2 cups unsweetened applesauce",
    "1 cup semisweet chocolate chips",
    "0.5 cup chopped walnuts"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C). Grease and flour a 9x13-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together flour, cocoa powder, baking soda, and salt in a medium bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat butter and sugar together in a large bowl with an electric mixer on medium speed until light and fluffy. Beat in eggs, one at a time, then beat in vanilla extract.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add flour mixture alternately with applesauce, beginning and ending with the flour mixture. Beat just until combined. Spread batter evenly in the prepared pan. Sprinkle with chocolate chips and walnuts.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until a toothpick inserted into the center comes out clean, about 35 minutes. Let cake cool completely in the pan on a wire rack before serving.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
