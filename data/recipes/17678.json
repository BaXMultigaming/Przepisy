  "title": "Chocolate Applesauce Cake",
  "description": "This incredibly moist chocolate applesauce cake is topped with chocolate chips and walnuts before baking, so there’s no need for frosting.",
  "authors": [
    "Karen Dunn"
  ],
  "date_published": "2000-03-25T21:13:22-05:00",
