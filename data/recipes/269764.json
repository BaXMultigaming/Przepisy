  "ingredients": [
    "1.5 cups all-purpose flour",
    "0.25 cup unsweetened cocoa powder",
    "1.5 teaspoons baking powder",
    "0.5 teaspoon baking soda",
    "0.5 teaspoon salt",
    "0.5 cup white sugar",
    "0.5 cup canola oil",
    "0.25 cup milk",
    "1 egg",
    "1 teaspoon vanilla extract",
    "2 large very ripe bananas, mashed",
    "0.75 mini semisweet chocolate chips"
  ],
  "steps": [
    {
      "text": "Gather all ingredients. Preheat the oven to 350 degrees F (175 degrees C). Line a12-cup muffin tin with paper liners.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/NSYINPmlCwDFHD1SU3vnZ6oSXwo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-269764-chocolate-banana-muffins-DDMFS-4x3-step-1-fc181b1bf34943b886834c0f26d45da7.jpg"
      ],
      "image": "assets/images/269764/step_01.webp"
    },
    {
      "text": "Combine flour, cocoa, baking powder, baking soda, and salt together in a large bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Vb4B4U70_P0CXbLP1hGgDXmkaNI=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-269764-chocolate-banana-muffins-DDMFS-4x3-step-2-1924a494338640c29a1c2d7386ba7703.jpg"
      ],
      "image": "assets/images/269764/step_02.webp"
    },
    {
      "text": "Whisk sugar, oil, milk, egg, and vanilla extract together in a separate bowl until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Z17n5alJxMuqPIgVTVOrTA0cLls=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-269764-chocolate-banana-muffins-DDMFS-4x3-step-3-9a632619ab35493cb0daca1a9eaa0575.jpg"
      ],
      "image": "assets/images/269764/step_03.webp"
    },
    {
      "text": "Stir into flour mixture until just moistened. Fold in bananas and chocolate chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/uW_a8lw2SX6JlkfT1oNfT4V6lWY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-269764-chocolate-banana-muffins-DDMFS-4x3-step-4-dc846bfcabc14872b81514fc11208187.jpg"
      ],
      "image": "assets/images/269764/step_04.webp"
    },
    {
      "text": "Divide batter among the muffin cups, filling each about 3/4 full.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/E9FX2qmcVOgEbJPRaeGvot356UA=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/AR-269764-chocolate-banana-muffins-DDMFS-4x3-step-5-0df16ad7f41c45409e203ea508af2c96.jpg"
