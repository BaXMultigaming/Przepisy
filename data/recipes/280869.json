  "ingredients": [
    "1 (18 ounce) package tortilla chips",
    "0.5 pound cooked pulled pork",
    "1 tablespoon reduced-sodium soy sauce",
    "0.5 teaspoon Chinese five-spice powder",
    "1 cup shredded Cheddar cheese",
    "0.25 cup sour cream",
    "2 teaspoons water",
    "0.5 teaspoon wasabi paste",
    "2 cups shredded cabbage with carrot",
    "0.25 cup sliced green onion",
    "0.25 cup snipped fresh cilantro"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 425 degrees F (220 degrees C). Arrange chips on a foil-lined 10x15-inch baking pan.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Toss pork, soy sauce, and five-spice powder together in a bowl. Top chips with pork mixture and Cheddar cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until cheese is melted and pork is heated through, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir sour cream, water, and wasabi paste together in a small bowl.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Top nachos with coleslaw mix, green onion, and cilantro. Drizzle with wasabi sour cream.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
