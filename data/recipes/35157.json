  "ingredients": [
    "1 cup finely chopped fresh pineapple",
    "0.5 cup diced red bell pepper",
    "0.5 cup diced green bell pepper",
    "1 cup frozen corn kernels, thawed",
    "1 (15 ounce) can black beans, drained and rinsed",
    "0.25 cup chopped onions",
    "2 green chile peppers, chopped",
    "0.25 cup orange juice",
    "0.25 cup chopped fresh cilantro",
    "0.5 teaspoon ground cumin",
    "salt and pepper to taste"
  ],
  "steps": [
    {
      "text": "In a large bowl, toss together pineapple, bell peppers, corn, black beans, onions, chile peppers, orange juice, and cilantro. Season with cumin, salt, and pepper. Cover and chill in the refrigerator until ready to serve.",
