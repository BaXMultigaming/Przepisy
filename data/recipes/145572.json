  "ingredients": [
    "3 tablespoons oyster sauce",
    "2 tablespoons fish sauce",
    "1 teaspoon white sugar",
    "0.5 cup peanut oil for frying",
    "6 large cloves garlic clove, crushed",
    "2 serrano peppers, crushed",
    "1 pound boneless, skinless chicken breast, cut into thin strips",
    "1 red bell pepper, thinly sliced",
    "1 onion, thinly sliced",
    "4 cups cooked jasmine rice, chilled",
    "2 cups sweet Thai basil",
    "1 cucumber, sliced",
    "0.5 cup cilantro sprigs"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HgxDfqz1UcY197fCmYZ7oWddeps=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-145572-ThaiSpicyBasilChickenFriedRice-ddmfs-Step1-3x4-6435-7025678312e741eb90eaadf4f1697273.jpg"
      ],
      "image": "assets/images/145572/step_01.webp"
    },
    {
      "text": "Whisk together oyster sauce, fish sauce, and sugar in a small bowl; set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FRrJxE2TL111k0pt5o_qKHPyR8E=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-145572-ThaiSpicyBasilChickenFriedRice-ddmfs-Step2-3x4-6437-5e11314b1bad46b7af11d22869a878d3.jpg"
      ],
      "image": "assets/images/145572/step_02.webp"
    },
    {
      "text": "Heat oil in a wok over medium-high heat until oil begins to smoke. Add garlic and Serrano peppers, stirring quickly.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/cAH2RbMeLYiGJtWtkE2G6Xybjs4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-145572-ThaiSpicyBasilChickenFriedRice-ddmfs-Step3-3x4-6440-010be5cb82de4b4d82d8eec92e3f34bc.jpg"
      ],
      "image": "assets/images/145572/step_03.webp"
    },
    {
      "text": "Stir in chicken, bell pepper, onion, and oyster sauce mixture; cook until chicken is no longer pink in the center and the juices run clear.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/0oG954_OGbnXUMuZawpvAM9tSXk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-145572-ThaiSpicyBasilChickenFriedRice-ddmfs-Step4-3x4-6453-617a230995c84899b0afe34befb6eb17.jpg"
      ],
      "image": "assets/images/145572/step_04.webp"
    },
    {
      "text": "Increase heat to high and stir in chilled rice; stir quickly until sauce is well blended with rice. Use the back of a spoon to break up any rice sticking together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/1HhxfLHTiCd53fPzywELJYeBIt0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-145572-ThaiSpicyBasilChickenFriedRice-ddmfs-Step5-3x4-6459-b528f0f553a8474b88bf6cd4688347d3.jpg"
      ],
      "image": "assets/images/145572/step_05.webp"
    },
    {
      "text": "Remove the wok from heat. Stir in basil leaves. Garnish with sliced cucumber and cilantro.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FoC4v7oMsEK8m2astm8AF8uj4yo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/RM-145572-ThaiSpicyBasilChickenFriedRice-ddmfs-3x4-6479-bf3154d3e39e4505b269a1c32b5abfba.jpg"
      ],
