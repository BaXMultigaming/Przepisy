  "ingredients": [
    "4 baking potatoes",
    "1 pound ground beef",
    "0.25 cup chopped onion",
    "1 clove garlic, minced",
    "1 teaspoon salt",
    "1 teaspoon chili powder",
    "0.5 teaspoon ground cumin",
    "0.5 teaspoon red pepper flakes",
    "2 tablespoons butter, or as needed",
    "1 cup shredded Cheddar cheese",
    "0.5 cup sour cream",
    "0.5 cup salsa"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Pierce the skin of the potatoes with a fork. Place potatoes on a baking sheet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until soft, about 1 1/2 hours.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a large skillet over medium heat. Mix ground beef with onion, garlic, salt, chili powder, cumin, and red pepper flakes. Cook in the hot skillet until beef is browned and crumbled, about 10 minutes. Add water as needed to prevent beef from sticking to skillet. Drain and discard grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut baked potatoes open. Spread butter inside and top each with the taco meat mixture, 1/4 cup cheese, 2 tablespoons sour cream, and 2 tablespoons salsa.",
