  "ingredients": [
    "1 (16 ounce) can pork and beans, drained",
    "1 (15 ounce) can kidney beans, drained",
    "1 (15 ounce) can butter beans, drained",
    "1 (15 ounce) can lima beans, drained",
    "0.5 pound bacon, cut into small pieces",
    "1 large onion, chopped",
    "2 cloves garlic, chopped",
    "0.75 cup brown sugar",
    "0.5 cup ketchup",
    "0.5 cup vinegar",
    "0.25 cup molasses",
    "1 teaspoon dry mustard"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add pork and beans, kidney beans, butter beans, and lima beans to a 2-quart casserole dish.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat a saucepan over medium heat. Add bacon, onion, and garlic; cook and stir until bacon browned, about 10 minutes. Drain excess grease.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk brown sugar, ketchup, vinegar, molasses, and mustard into bacon mixture; simmer until cooked through, about 20 minutes. Pour sauce over beans; stir to combine.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until bubbling, 1 hour 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
