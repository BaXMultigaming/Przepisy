  "ingredients": [
    "1 cup water",
    "1 cup distilled white vinegar",
    "0.5 onion, diced",
    "1 head cabbage, cored and shredded",
    "0.75 teaspoon sea salt",
    "0.5 teaspoon celery seed",
    "0.5 teaspoon onion powder",
    "0.5 teaspoon garlic powder",
    "ground black pepper to taste"
  ],
  "steps": [
    {
      "text": "Combine water, ½ cup vinegar, and onion in a pot over high heat. Add cabbage, salt, celery seeds, onion powder, garlic powder, and black pepper, then pour remaining ½ cup vinegar over top.",
