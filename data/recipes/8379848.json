  "title": "Pan-Fried Chicken Breast with Mushroom Gravy",
  "description": "An easy recipe for pan-fried chicken breast cooked in a tasty mushroom gravy with white wine. Serve with rice or potatoes and a vegetable.",
  "authors": [
    "FrackFamily5 CACT"
  ],
  "date_published": "2022-04-15T10:22:32-04:00",
