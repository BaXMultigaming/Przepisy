  "ingredients": [
    "4 (5 ounce) chicken breasts",
    "1 teaspoon onion powder",
    "0.5 teaspoon salt",
    "0.5 teaspoon freshly ground black pepper",
    "3 tablespoons olive oil",
    "1 (8 ounce) package sliced fresh mushrooms",
    "2 cloves garlic, sliced",
    "0.75 cup water",
    "0.25 cup dry white wine",
    "1 (1.25 ounce) envelope dry chicken gravy mix"
  ],
  "steps": [
    {
      "text": "Sprinkle both sides of the chicken breasts with onion powder, salt, and pepper.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat oil in a large skillet over medium-high heat. Add chicken and cook until golden brown, about 5 minutes per side.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add garlic and mushrooms and cook until mushrooms have released their liquid and are reduced in size, about 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Stir together water, white wine, and gravy packet in a small bowl and pour into the skillet.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bring liquid to a simmer, cover, reduce heat to medium, and cook for 5 minutes. Turn chicken breasts and continue cooking until chicken is no longer pink in the center and the juices run clear, about 5 more minutes. An instant-read thermometer inserted into the center should read at least 165 degrees F (74 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
