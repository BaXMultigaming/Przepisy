  "ingredients": [
    "3 tablespoons butter",
    "3 tablespoons chopped red bell pepper",
    "2 tablespoons chopped green onion",
    "1 cup crabmeat, drained and flaked",
    "salt and pepper to taste",
    "2 tablespoons white wine",
    "3 large eggs",
    "1 cup half-and-half cream",
    "1 (9 inch) pie shell, partially baked",
    "0.5 cup shredded Swiss cheese"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 375 degrees F (190 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Heat butter in a large skillet over medium heat. Sauté red bell pepper and green onion in hot butter until soft. Stir in crabmeat; season with salt and pepper. Add wine and cook for 1 minute. Remove from heat and allow to cool.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Beat eggs in a large bowl until light. Whisk in half-and-half and crab mixture. Pour into partially baked pie crust and sprinkle with Swiss cheese.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until puffed and golden brown, 25 to 30 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
