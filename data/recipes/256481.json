  "keywords": [],
  "ingredients": [
    "3 sweet potatoes, peeled and chopped",
    "3 cups self-rising flour",
    "0.5 teaspoon salt",
    "6 tablespoons butter",
    "1 cup white sugar",
    "1 cup raisins",
    "1 teaspoon ground cinnamon",
    "1 teaspoon ground nutmeg",
    "0.25 teaspoon ground allspice"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F (175 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Place a steamer insert into a saucepan and fill with water to just below the bottom of the steamer. Bring water to a boil. Add sweet potato, cover, and steam until tender, 8 to 10 minutes. Strain into a bowl and mash until smooth.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Mix flour and salt together in a large bowl. Cut in butter with a pastry blender or a fork until mixture is crumbly. Stir in sugar, raisins, cinnamon, nutmeg, and allspice. Add 3 cups mashed sweet potatoes; mix until dough comes together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Turn dough out onto a floured work surface; divide in half. Pat each half into a circle the size of a large dinner plate. Cut each circle into 8 wedges. Transfer wedges to two 10x15-inch baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Bake in the preheated oven until lightly browned, about 20 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
