  "ingredients": [
    "6 bamboo skewers, soaked in water 20 minutes",
    "parchment paper",
    "1 (6.5 ounce) package corn bread mix",
    "0.66666668653488 cup milk",
    "1 egg",
    "1 teaspoon white sugar",
    "8 hot dogs, cut in half"
  ],
  "steps": [
    {
      "text": "Cut soaked bamboo skewers in thirds. Cut a piece of parchment paper to fit the bottom of the air fryer basket.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Preheat the air fryer to 400 degrees F (200 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Whisk together corn bread mix, milk, egg, and sugar in a bowl until smooth; pour into a tall glass.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Insert a skewer into each hot dog piece. Remove the basket of the air fryer and place cut parchment paper on the bottom of the basket. Dunk 4 hot dogs in the glass with the batter and place on top of the parchment paper alternating direction of the stick ends.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cook in the preheated air fryer without flipping for 8 minutes or until desired brownness. Transfer to a plate and repeat with remaining hot dogs.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
