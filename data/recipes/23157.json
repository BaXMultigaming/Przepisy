  "ingredients": [
    "1 (12 pound) whole turkey",
    "salt and ground black pepper to taste",
    "2 tablespoons all-purpose flour",
    "5 stalks celery, cut into 1-inch pieces",
    "2 large onions, quartered",
    "1 large turkey bag"
  ],
