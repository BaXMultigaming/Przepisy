  "ingredients": [
    "8 ounces shredded vegan Cheddar cheese",
    "0.75 cup water, divided",
    "1 (10 ounce) can diced tomatoes and green chiles (such as RO*TEL®)",
    "0.5 cup canned Mexican-style black beans",
    "1 tablespoon pickled jalapeno slices"
