    "publisher-tested"
  ],
  "ingredients": [
    "4 eggs, separated",
    "0.66666698455811 cup white sugar, divided",
    "0.875 cup all-purpose flour",
    "0.5 teaspoon baking powder"
  ],
  "steps": [
    {
      "text": "Preheat the oven to 400 degrees F (205 degrees C). Line two 17x12-inch baking sheets with parchment paper. Fit a large pastry bag with a plain 1/2-inch round tip.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/ugEWB6xCgQvIKLL54yiSK6N-IDk=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10434-ladyfingers-VAT-step-01-d2c8038117d44fada58ce70d5cb64e0c.jpg"
      ],
      "image": "assets/images/10434/step_01.webp"
    },
    {
      "text": "Beat egg whites in a large bowl with an electric mixer on high speed until soft peaks form. Add 2 tablespoons sugar and continue beating until stiff and glossy.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/3R25YKwozS_y0FZbREejPtI3xZE=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10434-ladyfingers-VAT-step-02-33611bf024584029b743f2db292cecbe.jpg"
      ],
      "image": "assets/images/10434/step_02.webp"
    },
    {
      "text": "Beat egg yolks and remaining sugar in a separate bowl until thick and pale yellow, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/50Pwa2IOEUD0IPXCbqBxuf-xu6Y=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10434-ladyfingers-VAT-step-03-53a4e1504d694d2283a7dc19cde6b841.jpg"
      ],
      "image": "assets/images/10434/step_03.webp"
    },
    {
      "text": "Fold half of the beaten egg whites into the yolk mixture. Sift flour and baking powder over the mixture and fold gently until nearly combined. Add the remaining egg whites and fold just until incorporated.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Bx1qJP5DTL6YanYRFp-OMJP-EgY=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10434-ladyfingers-VAT-step-04-c53c42cc55eb4e34a6ddee8e2358f7cf.jpg"
      ],
      "image": "assets/images/10434/step_04.webp"
    },
    {
      "text": "Transfer the batter to the prepared pastry bag. Pipe 3-inch-long “fingers,” spacing them about 1 inch apart on the baking sheets.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/xVpKE7XiCUZJgMXkySpKfaPH-u4=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10434-ladyfingers-VAT-step-05-2e9bb83f5ecf4f73ac1500675b2799c2.jpg"
      ],
      "image": "assets/images/10434/step_05.webp"
    },
    {
      "text": "Bake in preheated oven until firm to the touch and just golden, about 8 minutes. Cool completely on the baking sheets before using or storing.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/FWT-Ji5vhSkUABmEsB4t412DCW0=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/10434-ladyfingers-VAT-step-06-5dc2a57ebbca44deaf1b3bab87a2a042.jpg"
      ],
      "image": "assets/images/10434/step_06.webp"
    }
  ],
