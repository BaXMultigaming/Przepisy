  "ingredients": [
    "1 pound ground Italian sausage",
    "1.5 teaspoons red pepper flakes",
    "1 large white onion, diced",
    "4 strips bacon, diced",
    "2 teaspoons garlic puree",
    "10 cups water",
    "5 cubes chicken bouillon",
    "1 pound russet potatoes, diced",
    "1 cup heavy whipping cream",
    "0.25 bunch kale, chopped"
  ],
  "steps": [
    {
      "text": "Gather all ingredients.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/Bicc1gI6vZt99se3lcafAEwO3Ww=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255253-OG-ZuppaToscanoSoup-ddmfs-step-1-103571-4x3-210f4c7cb97347e3a2e544a8523e9864.jpg"
      ],
      "image": "assets/images/255253/step_01.webp"
    },
    {
      "text": "Combine sausage and red pepper flakes in a skillet over medium heat; cook and stir until sausage is brown and crumbly, 7 to 10 minutes. Drain excess fat; transfer sausage to a bowl and set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HDxuMClqOopjCCWuLFt6td1MxU8=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255253-OG-ZuppaToscanoSoup-ddmfs-step-2-103591-4x3-9ea53f6bb624454f96a0216ba2fe0b6b.jpg"
      ],
      "image": "assets/images/255253/step_02.webp"
    },
    {
      "text": "Cook onion, bacon, and garlic in the same skillet over medium-low heat until bacon is crisp and onions are soft, 10 to 15 minutes. Set aside.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/4Vigt9BcvlyL4spFJOd5CJrnZVU=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255253-OG-ZuppaToscanoSoup-ddmfs-step-3-103601-4x3-288894bc2f6943fdb485107ac864a65b.jpg"
      ],
      "image": "assets/images/255253/step_03.webp"
    },
    {
      "text": "Combine water and chicken bouillon in a large pot; bring to a boil. Stir in potatoes; cook until soft, about 15 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/HfmWFgExx8Dy2R0o5HalhOS8-Vo=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255253-OG-ZuppaToscanoSoup-ddmfs-step-4-103611-4x3-38006b0cc9034a18ba1a10264c4603b4.jpg"
      ],
      "image": "assets/images/255253/step_04.webp"
    },
    {
      "text": "Pour in cream; simmer until heated through, about 2 minutes. Add sausage, onion mixture, and kale; cook and stir until flavors combine, about 10 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": [
        "https://www.allrecipes.com/thmb/l_KZbjdwqA5_ojog7IiZCir_Qog=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/255253-OG-ZuppaToscanoSoup-ddmfs-step-5-103618-4x3-6c16e3debd924550a8110149a7ad3e16.jpg"
      ],
      "image": "assets/images/255253/step_05.webp"
    }
  ],
