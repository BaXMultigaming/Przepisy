  "ingredients": [
    "4 cups all-purpose flour",
    "0.5 cup white sugar",
    "1 cup butter",
    "2 eggs",
    "1 (.25 ounce) package active dry yeast",
    "0.5 cup warm water",
    "1.5 cups packed brown sugar",
    "1 cup butter",
    "1 teaspoon ground cinnamon",
    "6 tablespoons dark corn syrup"
  ],
  "steps": [
    {
      "text": "Dissolve the yeast in the warm water.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Cut 1cup of the butter into the flour. Mix in the sugar, eggs and yeast mixture. Mix well and set aside to rise for 30 to 60 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Roll dough into balls and bake in a pizelle iron.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "To Make Filling: In a saucepan boil the brown sugar, 1 cup of the butter, cinnamon and dark corn syrup until it reaches the soft ball stage (234-240 degrees F 112 -115 degrees C).",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Split waffles in half and spread cut sides with the warm filling. Then put the halves back together.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
