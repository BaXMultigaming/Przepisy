  "ingredients": [
    "0.5 cup real mayonnaise",
    "0.25 cup sour cream",
    "2 tablespoons prepared horseradish",
    "2 teaspoons ketchup",
    "0.25 teaspoon ground paprika",
    "0.25 teaspoon salt",
    "0.25 teaspoon cayenne pepper",
    "2 drops hot sauce, or to taste",
    "1 pinch dried oregano",
    "1 pinch ground black pepper"
