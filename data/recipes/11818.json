  "ingredients": [
    "1 (16 ounce) package elbow macaroni",
    "1 medium green bell pepper, chopped",
    "0.75 cup chopped celery",
    "1 (6 ounce) can small shrimp, drained",
    "1 (5 ounce) can tuna, drained and flaked",
    "0.25 cup chopped onion",
    "4 tablespoons Catalina salad dressing",
    "3 tablespoons mayonnaise, or to taste",
    "1.5 tablespoons sweet pickle relish",
    "1 pinch garlic salt"
  ],
  "steps": [
    {
      "text": "Bring a large pot of lightly salted water to a boil. Cook elbow macaroni in the boiling water, stirring occasionally, until tender yet firm to the bite, about 8 minutes; drain. Run macaroni under cold water to chill; drain.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Transfer cooked pasta to a large bowl. Add bell pepper, celery, shrimp, tuna, onion, Catalina dressing, mayonnaise, relish, and garlic salt; mix until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
