  "ingredients": [
    "8 (1 ounce) squares semi-sweet chocolate",
    "3 tablespoons butter or margarine",
    "1 (14 ounce) can EAGLE BRAND® Sweetened Condensed Milk",
    "2 cups biscuit baking mix",
    "1 egg",
    "1 teaspoon vanilla extract",
    "1 cup peanut butter chips"
  ],
  "steps": [
    {
      "text": "Preheat oven to 350 degrees F. In large saucepan, over low heat, melt chocolate and butter with sweetened condensed milk; remove from heat.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add biscuit mix, egg and vanilla; with mixer, beat until smooth and well blended. Let mixture cool to room temperature. Stir in peanut butter chips.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drop by rounded teaspoonfuls onto ungreased baking sheets. Bake 6 to 8 minutes or until tops are lightly crusted. Cool. Store leftovers tightly covered at room temperature.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
