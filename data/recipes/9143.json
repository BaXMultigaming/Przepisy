  "title": "Harvest Rice Dish",
  "description": "This harvest rice dish recipe combines wild rice, brown rice, slivered almonds, mushrooms, and dried cranberries that are simmered in chicken broth.",
  "authors": [
    "Allrecipes Member"
  ],
  "date_published": "2008-06-30T19:10:59-04:00",
