  "ingredients": [
    "0.5 cup diced onion",
    "0.5 cup diced carrot",
    "1.5 tablespoons canola oil",
    "5 cups cooked and cooled rice",
    "0.5 teaspoon kosher salt",
    "0.25 teaspoon ground black pepper",
    "0.75 cup frozen peas",
    "2 cloves garlic, minced",
    "1 tablespoon soy sauce",
    "4 large eggs",
    "2 medium green onions, chopped",
    "0.25 cup mayonnaise",
    "1 tablespoon Sriracha",
    "2 teaspoons rice vinegar"
  ],
  "steps": [
    {
      "text": "Set an oven rack in the center of the oven and preheat the oven's broiler.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Make the fried rice: Toss onion and carrot with oil on a rimmed baking sheet until coated; arrange in a single layer.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Broil in the preheated oven for 5 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add rice, salt, and pepper to the sheet pan and toss to coat. Continue to broil until rice is just golden, 8 to 10 minutes, stirring halfway through.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Add frozen peas, garlic, and soy sauce; toss to evenly coat and spread in an even layer. Use the back of a spoon to form four indentations in the rice mixture. Crack an egg into each indentation. Broil until egg whites are set, about 3 minutes.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Meanwhile, make the Sriracha mayo: Stir mayonnaise, Sriracha, and rice vinegar together in a small bowl until well combined.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    },
    {
      "text": "Drizzle Sriracha mayo over fried rice and sprinkle with green onions.",
      "section": null,
      "name": null,
      "url": null,
      "image_sources": []
    }
  ],
