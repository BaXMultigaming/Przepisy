  "title": "Low Sugar Oatmeal Raisin Cookie",
  "description": "A tasty oatmeal raisin cookie that uses a sugar substitute instead of sugar. Great for people on special diets.",
  "authors": [
    "Judy Sommavilla"
  ],
  "date_published": "1999-04-13T15:34:59-04:00",
